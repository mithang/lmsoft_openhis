
<div class="toolbar">
    <div class="btn-group">
        <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
    </div>
</div>
<div class="search">
    <table>
        <tr>
            <td>
                <div class="input-group" style="width:200px;">
                    @* QA-phase2 (SETT-13): without a first option, framework-ui's
                       bindSelect renders the vendor hard-coded "No results
                       found" option when the org tree comes back empty. A
                       default first option makes it render this placeholder
                       instead (and it is kept as the placeholder when data
                       loads). Vendor file itself is untouched. *@
                    <select id="OrganizeId" name="OrganizeId" class="form-control"><option value="">==Vui lòng chọn==</option></select>
                </div>
            </td>
        </tr>
    </table>
</div>
<script type="text/javascript">
    $("#OrganizeId").bindSelect({
        url: "/SystemManage/Organize/GetChildTreeSelectJson",
    });
    $("#OrganizeId").change(function () {
        if ($("table#gridList").length > 0) {
            //Xóa các dòng đã chọn
            $("#gridList").resetSelection();
        }
        $("#btn_search").trigger('click');
    });
</script>
        <div class="rd-sett-groups">
            <section class="rd-sett-group">
                <h3>Nghiệp vụ thu phí / quyết toán</h3>
                <ul>
                    <li class="rd-sett-tile"><a href="/BusinessManage/Refund/Index">Hoàn phí</a></li>
                    <li class="rd-sett-tile"><a href="/OutpatientManage/OutpatCharge/ChargeIndex">Thu phí ngoại trú</a></li>
                    <li class="rd-sett-tile"><a href="/OutpatientManage/OutBook/Index">Đặt lịch khám</a></li>
                    <li class="rd-sett-tile"><a href="/HospitalizationManage/BookkeepInHos/Index">Ghi sổ nội trú</a></li>
                    <li class="rd-sett-tile"><a href="/HospitalizationManage/DischargeSettle/Index">Quyết toán ra viện</a></li>
                    <li class="rd-sett-tile"><a href="/HospitalizationManage/Settlement/Index">Quyết toán</a></li>
                    <li class="rd-sett-tile"><a href="/NonTreatmentItemManage/NonTreatmentItem/Bookkeeping">Ghi sổ hạng mục không điều trị</a></li>
                    <li class="rd-sett-tile"><a href="/DaySettleManage/DaySettle/ApplicationIndex">Quyết toán ngày</a></li>
                    <li class="rd-sett-tile"><a href="/DaySettleManage/DaySettle/DzrIndex">Đối chiếu sổ sách ngày</a></li>
                    <li class="rd-sett-tile"><a href="/FeeConfirmManage/FeeConfirm/Index">Xác nhận phí</a></li>
                    <li class="rd-sett-tile"><a href="/PayManage/MicroPay/MicroPayQuery">Thanh toán vi mô</a></li>
                </ul>
            </section>

            <section class="rd-sett-group">
                <h3>Bệnh nhân</h3>
                <ul>
                    <li class="rd-sett-tile"><a href="/PatientManage/PatientCenter/Index">Trung tâm bệnh nhân</a></li>
                    <li class="rd-sett-tile"><a href="/PatientManage/PatientInHosList/Index">Danh sách bệnh nhân nội trú</a></li>
                    <li class="rd-sett-tile"><a href="/PatientManage/HospiterRes/Index">Tiếp nhận nội trú</a></li>
                </ul>
            </section>

            <section class="rd-sett-group">
                <h3>Báo cáo / truy vấn / DRG / BHYT</h3>
                <ul>
                    <li class="rd-sett-tile"><a href="/ReportManage/Report/ChargeTypeQuery">Báo cáo theo loại phí</a></li>
                    <li class="rd-sett-tile"><a href="/ReportManage/Echarts/PerformanceIndicator">Biểu đồ chỉ số hiệu suất</a></li>
                    <li class="rd-sett-tile"><a href="/DeanInquiryManage/BusinessRanking/Index">Xếp hạng kinh doanh</a></li>
                    <li class="rd-sett-tile"><a href="/DRGManage/DRGUpload/Index">Upload DRG</a></li>
                    <li class="rd-sett-tile"><a href="/JGManage/JGUpload/Index">Upload JG</a></li>
                    <li class="rd-sett-tile"><a href="/InsuranceManage/CommercialInsurance/Index">Bảo hiểm thương mại</a></li>
                    <li class="rd-sett-tile"><a href="/KnowledgeBaseManage/MedicalInsurance/Index">Cơ sở tri thức BHYT</a></li>
                    <li class="rd-sett-tile"><a href="/KPI/MedicalOrg/Index">KPI tổ chức y tế</a></li>
                    <li class="rd-sett-tile"><a href="/TherapeutistManage/TherapistAdvice/Index">Y lệnh trị liệu</a></li>
                    <li class="rd-sett-tile"><a href="/IssueTreatRecord/ComfirmIssue/Index">Xác nhận phát hành hồ sơ điều trị</a></li>
                </ul>
            </section>

            <section class="rd-sett-group">
                <h3>Hệ thống / kỹ thuật</h3>
                <ul>
                    <li class="rd-sett-tile"><a href="/SystemManage/Area/Index">Danh mục khu vực</a></li>
                    <li class="rd-sett-tile"><a href="/SystemManage/Organize/Index">Danh mục tổ chức</a></li>
                    <li class="rd-sett-tile"><a href="/SystemSecurity/DbBackup/Index">Sao lưu cơ sở dữ liệu</a></li>
                    <li class="rd-sett-tile"><a href="/SystemSecurity/ServerMonitoring/Index">Giám sát máy chủ</a></li>
                    <li class="rd-sett-tile"><a href="/SiteManage/SiteStatistics/Index">Thống kê site</a></li>
                    <li class="rd-sett-tile"><a href="/HighchartsManage/Highcharts/Sample1">Ví dụ biểu đồ</a></li>
                    <li class="rd-sett-tile"><a href="/ExampleManage/BarCode/Index">Ví dụ mã QR</a></li>
                </ul>

    //điều trịđiều trịlậpnghịcộtbảng
    function gridzljy() {
        var $gridzljy = $("#gridzljy");
        $gridzljy.jqGrid({
            datatype: 'local',
            data: kflocaldata,
            height: $(window).height() - 230,
            //altRows: true,//cáchthực hiệnđổimàu
            shrinkToFit: true, //true:theosoví dụđầubắt đầuhóacộtrộngđộ false:Sử dụngcolModelchỉđịnhcủarộngđộ
            autowidth: true,
            rownumbers: true, //làkhônghiển thịhiển thịthứ tựsố
            multiselect: true,
            editurl: "clientArray", //sửa dòng không gửi dữ liệu lên máy chủ
            unwritten: false,
            colModel: [
                { label: 'jyId', name: 'jyId', width: 120, align: 'center', hidden: true },
                {
                    label: 'itemCode', name: 'itemCode', width: 120, editwidth: '100%', align: 'center', editable: true, hidden: true
                },
                {
                    label: '<span class="required">*</span>Tên khoản mục', name: 'itemName', width: 400, editwidth: '100%', align: 'center', editrules: { required: true }, editable: true, autocomplete: 'off'
                },
                { label: '<span class="required">*</span>Tần suất', name: 'pcmc', width: 100, editwidth: '100%', align: 'center', editrules: { required: true }, editable: true },
                { label: '<span class="required"></span>Vị trí', name: 'bw', width: 100, editwidth: '100%', align: 'center', editable: true },
                { label: 'pc', name: 'pc', editwidth: '100%', align: 'center', editable: true, hidden: true },
                {
                    label: '<span class="required">*</span>Lượng điều trị mỗi lần', name: 'mczll', width: 100, editwidth: '100%', align: 'center', editrules: { required: true }, editable: true, editrules: { integer: true, minValue: 1 }, editoptions: {
                        dataEvents: [
                                {
                                    type: 'change',
                                    fn: function (e) {
                                        var cellval = $(this).val();
                                        if (cellval.replace(/(^\s*)|(\s*$)/g, "") == "") {
                                            $.modalAlert("Số lượng là trống,Vui lòng xác nhận.", 'warning');
                                            return;
                                        }
                                        if (isNaN(cellval)) {
                                            $.modalAlert("Số lượng:Vui lòng điền chữ số", 'warning');
                                            $(this).val('')
                                            return;
                                        }
                                        var row = $(e.target).closest('tr.jqgrow');
                                        var rowid = row.attr('id');
                                    }
                                }
,
                                {
                                    type: 'keyup',
                                    fn: function (e) {
                                        var cellval = $(this).val();
                                        if (cellval.replace(/(^\s*)|(\s*$)/g, "") == "") {
                                            $.modalAlert("Số lượng là trống,Vui lòng xác nhận.", 'warning');
                                            return;
                                        }
                                        if (isNaN(cellval)) {
                                            $.modalAlert("Số lượng:Vui lòng điền chữ số", 'warning');
                                            $(this).val('')
                                            return;
                                        }
                                        var row = $(e.target).closest('tr.jqgrow');
                                        var rowid = row.attr('id');

                                    }
                                }
                        ]
                    }
                },
                { label: '<span class="required"></span>Số lượng', name: 'sl', width: 100, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: '<span class="required">*</span>Khoa thực hiện', name: 'zxksmc', width: 100, editwidth: '100%', align: 'center', editrules: { required: true }, editable: true },
                { label: 'zxksdm', name: 'zxksdm', editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: '<span class="required"></span>Dặn dò', name: 'bz', width: 400, editwidth: '100%', align: 'center', editable: true },
                { label: 'Thao tác', name: 'action', width: 100, align: 'center' }
            ],
            editinputwidthborder: false, //làkhôngcầncầnbênkhung Mặc định làtrue
            editinputborderradius: false, //làkhôngcầncầnbênkhungtròngóc mặc địnhtrue(cótròngóc)
            pager: "#gridzljyPager",

                        <th class="formTitle dv-lable">Số giấy tờ:</th>
                        <td class="formValue" style="width:120px;">
                            <label id="zjh"></label>
                        </td>
                    </tr>
                </tbody>
                <tbody class="dispTbody" style="display:none;">
                    <tr>
                        
                        <th class="formTitle dv-lable">Số điện thoại:</th>
                        <td class="formValue" colspan="2">
                            <label id="phone"></label>
                        </td>
                        <th class="formTitle dv-lable">Ngày sinh:</th>
                        <td class="formValue" colspan="2">
                            <label id="csny"></label>
                        </td>
                        <th class="formTitle zy dv-lable">Ngày nhập viện:</th>
                        <td class="formValue zy " >

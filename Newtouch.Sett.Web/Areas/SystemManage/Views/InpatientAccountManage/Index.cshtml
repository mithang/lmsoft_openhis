</div>
<div class="gridPanel">
    <table id="ReceiptPanel"></table>
</div>
<!--Thanh công cụ nút-->
<div class="toolbar toolbarfloat">
    <a id="acc_addMoney" class="btn btn-primary" onclick="sjPrint()"><i class="fa fa-plus"></i> In bổ sung</a>
    <a id="acc_addMoney" class="btn btn-primary" onclick="PayDeposit()"><i class="fa fa-plus"></i> nạp tiền</a>
    <a id="acc_reMoney" class="btn btn-primary" onclick="Refund()"><i class="fa fa-minus"></i> Rút tiền</a>
    <a id="acc_reMoney" class="btn btn-primary" onclick="RefundOverAccount()"><i class="fa fa-minus"></i> Hoàn toàn bộ số dư</a>
    <a class="btn btn-primary" onclick="RefreshAccount()"><span class="glyphicon glyphicon-refresh"> Làm mới Tài khoản</span></a>
</div>
<style>
    #yeCon {
        padding-left: 25px;
        color: red;
    }
</style>

<script>
    var reqzhxz = $.request("zhxz");
    var patid = "";
    var zyh = "";
    $(function () {
        if (!reqzhxz) {
            reqzhxz = "";
        }
        else if (reqzhxz == "zy") {
            reqzhxz = '@((int)EnumXTZHXZ.ZYYJKZH)';
            $("#zhxz").val(reqzhxz);


        }
        else if (reqzhxz == "mz") {
            reqzhxz = '@((int)EnumXTZHXZ.MZYJKZH)';
            $("#zhxz").val(reqzhxz);

        }
        $("#receipt").click(function () {
            showReceiptPanel(); //Bật cửa sổ số chứng từ
        });

        //Liên kết lớp nổi chọn mục điều trị
        $('#keyword').newtouchBatchFloatingSelector({
            width: 500,
            height: 200,
            caption: "Chọn bệnh nhân",
            clickautotrigger: true,
            url: "/PatientManage/HospiterRes/PatYjjSearchInfo",
            ajaxparameters: function ($thisinput) {
                var keyword = $thisinput.val().trim();
                return "keyword=" + keyword+"&type="+$.request("zhxz");
            },
            itemdbclickhandler: function ($thistr, $thisinput) {
                patid = $thistr.attr("data-patid");
                zyh = $thistr.attr("data-zyh");
                $("#zyh").val(zyh);
                GetQuerypatientInfoAjax(patid,zyh);
            },
            colModel: [
                { label: 'Khóa chính', name: 'patid', hidden: true },
                { label: 'Số hồ sơ bệnh án', name: 'blh', width: 100, align: 'left', hidden: true },
                { label: 'Số nhập viện', name: 'zyh', width: 90, align: 'center' },
                { label: 'Đang nằm viện dấu hiệu', name: 'zybz', width: 100, align: 'center' },
                { label: 'Họ tên', name: 'xm', width: 120, align: 'center' },
                { label: 'Năm sinh', name: 'csny', hidden: true, width: 100, align: 'center' },
                {
                    label: 'Giới tính', name: 'xb', width: 70, align: 'center', formatter: function (cellvalue) {
                        return $.getGender(cellvalue);
                    }
                },
                { label: 'Tuổi', name: 'nl', align: 'center', width: 80 },
                //{ label: 'Tuổi', name: 'nlshow', width: 80, align: 'left', formatter: function (cellvalue, a, b) {
                //        return getAgeFromBirthTime({ begin: b.csny }).text;
                //    }
                //},
                { label: 'brly', name: 'brly', align: 'left', hidden: true },
                { label: 'zjh', name: 'zjh', align: 'left', hidden: true },
                { label: 'brxz', name: 'brxz', align: 'left', hidden: true },
                { label: 'kh', name: 'kh', align: 'left', hidden: true },
                { label: 'phone', name: 'phone', align: 'left', hidden: true },
                { label: 'dy', name: 'dy', align: 'left', hidden: true },
                { label: 'zjlx', name: 'zjlx', align: 'left', hidden: true },
                { label: 'sycs', name: 'sycs', align: 'left', hidden: true },
                { label: 'dybh', name: 'dybh', align: 'left', hidden: true },
                { label: 'lxr', name: 'lxr', align: 'left', hidden: true },
                { label: 'lxrgx', name: 'lxrgx', align: 'left', hidden: true },
                { label: 'lxrdh', name: 'lxrdh', align: 'left', hidden: true },

            ]
        });
        gridListData([]);
        $(window).resize(function () {
            initLayout("formPat2");
        });

        $("#ddlzffs").newtouchBindSelect({
            id: "xjzffs",
            text: "xjzffsmc",
            datasource: function () {
                //Duyệt nguồn dữ liệu
                var resultObjArr = new Array();
                $.each(top.clients.SysForCashPayList, function (idx, val) {
                    if (val.zhxz == 'a') {
                        resultObjArr.push(val);
                    }
                });
                return resultObjArr;
            }
        });

        GetSJPZH();

    });


    function GetQuerypatientInfoAjax(patid,zyh) {
        $.najax({
            type: "POST",
            url: "@Url.Action("PatAccountInfo")",
            data: { zyh: zyh, zhxz: $("#zhxz").val() },
            dataType: "json",
            cache: false,
            alertbierror: false,
            success: function (ajaxresp) {
                $('#gridList').jqGrid("clearGridData");
                $("#yeCon").text("Số dư tài khoản：0.00đồng");
                $("#txtmoney").val("");
                $.loading(false);
                var accPayInfoList = ajaxresp.data.accPayInfoList;
                var patInfo = ajaxresp.data.patInfo;
                if (patInfo != "[]") {
                    setPatInfoModel(ajaxresp.data.patInfo);
                }
                if (accPayInfoList.length > 0) {
                    gridListData(ajaxresp.data.accPayInfoList);
                }
            },
            errorCallback: function (rtnval) {
                if (rtnval.message == "缺少账户") {
                    $.modalConfirm("Không tìm thấy bệnh nhân này tạm ứng Tài khoản，Có hay không Tạo mới", function (f) {
                        if (f) {
                            $.najax({
                                type: "POST",
                                url: "/SystemManage/InpatientAccountManage/AddReserveAccount",
                                data: { patid:patid,zyh: zyh, zhxz: $("#zhxz").val() },
                                dataType: "json",
                                cache: false,
                                alertbierror: false,
                                success: function (res) {
                                    GetQuerypatientInfoAjax(patid,zyh);
                                    $('#gridList').jqGrid("clearGridData");
                                    $("#yeCon").text("Số dư tài khoản：0.00đồng");
                                    $("#txtmoney").val("");
                                    //ClearMoney();
                                    //$('#yeCon').val("0.00");
                                }
                            });
                        }
                    })
                } else {
                    $.modalAlert(rtnval.message,"warning");
                }
            }
        });
    }

    //Bật cửa sổ lấy số chứng từ
    function showReceiptPanel() {
        var cardNo = $("#keyword").val();
        if (cardNo) {
            $.modalOpen({
                id: "ReceiptPanel",
                title: "Chọn Số chứng từ",
                url: "/PatientManage/AccountManage/ChooseReceipt?t=" + Math.random(),
                width: "300px",
                height: "200px",
                callBack: function (iframeId) {
                    top.frames[iframeId].ReceiptConfirm();
                }//hàm gọi lại khi nhấn xác nhận trên cửa sổ
            });
        } else {
            $.modalAlert("Vui lòng chọn bệnh nhân", 'warning');
            $("#keyword").focus();
        }
    }

    //Lấy hiển thị giao diện thông tin cơ bản bệnh nhân
    function setPatInfoModel(patModel) {
        $("#xb").html($.getGender(patModel.xb));
        $("#csny").html((patModel.csny && patModel.csny.length >= 10 ? patModel.csny.substring(0, 10) : ""));
        $("#zjh").html(patModel.zjh);
        $("#xm").html(patModel.xm);
        $("#nlshow").html( patModel.nl);
        $("#blh").val(patModel.blh);
        $("#patid").val(patModel.patid);
        $("#phone").html(patModel.phone);
        $("#bje").html(patModel.bje);
        $("#hiddenzjlx").val(patModel.zjlx);
        $("#brxzmc").val(patModel.brxz);
        $("#zhCode").val(patModel.zhCode);
        $("#zhxz").val(patModel.zhxz);
        $("#keyword").val(patModel.zyh);
    }

    //Danh sách thu chi tài khoản
    function gridListData(mydata) {
        $('#gridList').jqGrid("clearGridData");
        var $gridList = $("#gridList");
        var zhye = "0.00";
        if (mydata != [] && mydata.length > 0) {
            zhye = mydata[0].zhye.toFixed(2);
        }
        $("#zhye").val(zhye); //valuegán giá trị
        var captionCon = "Bảng thu chi tài khoản";
        captionCon += '<label style="height: 7px; width: 36px; background-color:#DDDDFF; border: 1px solid #ddd;margin-left: 40px;"></label> nạp tiền ' ;
        captionCon += '<label style="height: 7px; width: 36px; background-color:#ACD6FF; border: 1px solid #ddd;margin-left: 40px;"></label> Rút tiền ';
        captionCon += "<span id='ye Con'>Số dư tài khoản：" + zhye + "đồng</span>";
        $gridList.dataNewGrid({
            height: $(window).height() - 330,
            autowidth: false,
            width: $("#formPat2").width() - 10,
            caption: captionCon,
            colModel: [
                { label: 'Số tiền thu chi', name: 'szje', width: 105, formatter: "number",align: 'center' },
                { label: 'Số tiền tài khoản', name: 'zhye', width: 105, formatter: "number", align: 'center' },
                { label: 'Số chứng từ', name: 'pzh', width: 105, align: 'center' },
                { label: 'Nhân viên thu chi', name: 'Creator', width: 105, align: 'center' },
                { label: 'Phương thức thanh toán/hoàn tiền', name: 'xjzffsmc', width: 105, align: 'center' },
                { label: 'Ngày thu chi', name: 'CreateTime', width: 125, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Ghi chú', name: 'memo', width: 105, align: 'center' },
                { label: 'Mã đơn hàng', name: 'outTradeNo', width: 125, align: 'center' },
                {
                    label: 'Tính chất thu chi', name: 'szxz', width: 105, align: 'center',
                    formatter: function (val) {
                        return $.enum.getDescByValue("EnumSZXZ", val)
                    }
                }, { label: 'Id', name: 'Id', hidden: true },
            ], gridComplete: function () {
                var ids = $gridList.getDataIDs();
                for (i = 0; i < ids.length; i++) {
                    var rowData = $gridList.getRowData(ids[i]);
                    if (rowData && rowData.szxz == "nạp tiền" || rowData.szxz == "Hoàn trả quyết toán nhập viện") {
                        $gridList.find('tr[id="' + ids[i] + '"]').css("background-color", "#DDDDFF");
                    } else if (rowData && (rowData.szxz == "Rút tiền" || rowData.szxz == "quyết toán nhập viện" || rowData.szxz == "Hoàn số dư" )) {
                        $gridList.find('tr[id="' + ids[i] + '"]').css("background-color", "#ACD6FF");
                    }
                }
            },
            onSelectRow: function (rowid, status) {
                btn_edit();
            }
        }, mydata);

        if (mydata.length > 0) {
            $('.ui-jqgrid-bdiv').find(".unwritten").remove();
        }
        $("#yeCon").text("Số dư tài khoản：" + zhye + "đồng");
    }

    var patid,
        zh,
        zhxz,
        zffsbh,
        zffsmc,
        zfmoney,
        pzh;
    //Xét nạp tiền và hoàn tiền
    function CheckDeposit() {
        patid = $("#patid").val();
        zyh = $("#zyh").val();
        zh = $('#zhCode').val();
        zhxz = $('#zhxz').val();
        if (!!!patid || !!!zyh) {
            $.modalAlert("Thiếu thông tin cơ bản của bệnh nhân", 'warning');
            return false;
        }
        var reg = /^(-?\d+)(\.\d+)?$/;
        zfmoney = $("#txtmoney").val();
        var ddlzffs = $("#ddlzffs option:selected");//lấy khoản đã chọn
        zffsbh = ddlzffs.val();//lấy giá trị của khoản đã chọn
        zffsmc = ddlzffs.text();//lấy văn bản của khoản đã chọn
        pzh = $("#txtlpzh").val();
        if (zffsbh == -1 || zffsmc == "") {
            $.modalAlert("Thiếu phương thức thanh toán", 'warning');
            return false;
        }
        if (zfmoney == "" || zfmoney == undefined) {
            $.modalAlert("Thiếu số tiền thanh toán", 'warning');
            return false;
        } else {
            if (!reg.test(zfmoney)) {
                $.modalAlert("Định dạng số tiền không đúng", 'warning');
                return false;
            }
        }
        if (pzh == "" || pzh == undefined) {
            $.modalAlert("Thiếu số chứng từ", 'warning');
            return false;
        }
        return true;
    }


    //Nạp tiền kiểm tra ở giao diện số tiền và đã chọn loại thanh toán chưa
    function PayDeposit() {
        zfmoney = $("#txtmoney").val();
        if (parseFloat(zfmoney) < 0 || zfmoney == "" || isNaN(zfmoney) == true) {
            $.modalAlert("Thiếu số tiền thanh toán(Số tiền không thể thấp hơn 0 đồng)", 'warning');
            return false;
        }
        if (CheckDeposit()) {
            if ($('#ddlzffs option:selected').val() == '13') {
                if (CheckPayOK()) {

                }
            } else {
                 PayDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid, zh, zhxz);
            }
        }
    }

    //Nạp tiền tạm ứng
    function PayDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid, zh, zhxz, outTradeNo) {
        $.loading(true, "Đang yêu cầu dữ liệu...");
        $.najax({
            type: "POST",
            url: "/SystemManage/InpatientAccountManage/PayDepositPost",
            data: {
                zffsbh: zffsbh, zffsmc: zffsmc,zyh:zyh,
                zfje: zfmoney, pzh: pzh, zh: zh,
                zhxz: zhxz, patid: patid, szxz:@Html.Raw((int)EnumSZXZ.cz), memo: $("#memo").val(), outTradeNo: outTradeNo
            },
            dataType: "json",
            cache: false,
            success: function (resdata) {
                if (resdata != null && resdata.data.flag) {
                    $.loading(false);
                    $.modalMsg("Nạp tiền thành công", 'success');
                    ClearMoney(); //Xóa trống
                    getZhInfo(zh); //Bản ghi thu chi tài khoản

                    var reqzhxz=$.request("zhxz")=='zy'?'Nhập viện':'Ngoại trú'
                    var orgId = '@curOpr.OrganizeId';
                    var uri = '@Html.Raw(reportUrl)' + "?tempCode=04" + "&systemCode=" + '@Html.Raw(ReportSystemCode)'+ "&szid=" + resdata.data.szId + "&patId=" + patid + "&orgId=" + orgId;
                    window.open(uri, "_blank", "height=500, width=1195,top=100, left=50, toolbar =no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no");
                }
            }, errorCallback: function (rtnval) {
                if (rtnval.message == "当前收据号已使用！") {
                    GetSJPZH();
                }
                $.modalAlert(rtnval.message, "warning");
            }
        });

    }


    //Xóa trống
    function ClearMoney() {
        $('#gridList').jqGrid("clearGridData");
        //Xóa ô nhập số tiền
        $("#txtmoney").val("");
        $('#zhye').val("0.00");
        $("#memo").val("");
        //Lấy số chứng từ
        GetSJPZH();
        GetQuerypatientInfoAjax(patid,zyh);
    }

    //Lấy số chứng từ
    function GetSJPZH() {
        $.najax({
            type: "POST",
            url: "/PatientManage/AccountManage/GetReceipt",
            data: {},
            dataType: "json",
            cache: false,
            success: function (resdata) {
                if (resdata != null && resdata.data != "") {
                    $("#txtlpzh").val(resdata.data);
                    return resdata.data;
                } else {
                    $("#txtlpzh").val("");
                    return "";
                }
            }
        });
    }
    var gridIMoney = "";//Số tiền thu chi đang chọn
    var gridIpzh = ""; //Số chứng từ đang chọn
    var gridId = "";//đang chọn hiện tạiId，Căn cứ đã hoàn hay chưa
    var RefundOutTradeNo = ""; //khitrướcchọntrongcủađặtphiếusố
    //Sự kiện nhấn
    function btn_edit() {
        var szje = $("#gridList").jqGridRowValue().szje;
        var pzh = $("#gridList").jqGridRowValue().pzh;
        gridId = $("#gridList").jqGridRowValue().Id;
        RefundOutTradeNo = $("#gridList").jqGridRowValue().outTradeNo;
        gridIMoney = szje;
        gridIpzh = pzh;
        if (parseFloat(gridIMoney) > 0) {
            $("#txtmoney").val('-' + szje);
        } else {
            return;
        }
        $("#txtlpzh").val(pzh);
    }

    //In bù biên lai nạp tiền
    function sjPrint()
    {
        var pzh = $("#txtlpzh").val();
        //if (gridIpzh == "" || pzh != gridIpzh) {
        //    $.modalAlert("vui lòngchọnchọnmộtdòngbổ sunggiá trịrõchi tiết", 'warning');
        //    return false;
        //}

        var reqzhxz=$.request("zhxz")=='zy'?'Nhập viện':'Ngoại trú'
        var orgId = '@curOpr.OrganizeId';
        var uri = '@Html.Raw(reportUrl)' + "?tempCode=04" + "&systemCode=" + '@Html.Raw(ReportSystemCode)'+ "&szid=" + gridId + "&patId=" + patid + "&orgId=" + orgId;
        window.open(uri, "_blank", "height=500, width=1195,top=100, left=50, toolbar =no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no");

    }


    //Rút tiền
    function Refund() {
        var money = $("#txtmoney").val();
        var pzh = $("#txtlpzh").val();
        var zhye = $("#zhye").val();
        zyh = $("#zyh").val();
        if (zyh) {
            $.modalAlert("Thông tin bệnh nhân không được để trống", 'warning');
        }
        if (parseFloat(money) == 0) {
            $.modalAlert("Rút tiền Số tiền không thể là0đồng", 'warning');
            return false;
        }
        else if ((parseFloat(money) > 0 && parseFloat(zhye) - parseFloat(money) < 0) ||
            (parseFloat(money) < 0 && parseFloat(zhye) + parseFloat(money) < 0)) {
            $.modalAlert("Số dư tài khoản hiện tại không đủ", 'warning');
            return false;
        }

        if (CheckDeposit()) {
            ReturnDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid,zh, zhxz);
        }
    }

    function ReturnDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid,zh, zhxz) {
        $.loading(true, "Đang yêu cầu dữ liệu...");
        $.najax({
            type: "POST",
            url: "/SystemManage/InpatientAccountManage/ReturnDepositPost",
            data: {
                zffsbh: zffsbh, zffsmc: zffsmc, zfje: zfmoney,zyh:$("#zyh").val(),
                pzh: pzh, zh: zh, zhxz: zhxz, patid: patid, szxz:@Html.Raw(((int)EnumSZXZ.qk)), memo: $("#memo").val()
            },
            dataType: "json",
            cache: false,
            success: function (resdata) {
                if (resdata != null && resdata.data) {
                    $.loading(false);
                    $.modalMsg("Hoàn tiền Thành công", 'success');
                    ClearMoney();
                    //Gọi danh sách thu chi tài khoản
                    getZhInfo(zh);

                }
            }
        });
    }


    //Hoàn toàn bộ số dư
    function RefundOverAccount() {
        debugger;
        patid = $("#patid").val();
        zh = $('#zhCode').val();
        zhxz = $('#zhxz').val();
        var zhye = $("#zhye").val();
        if (!!!patid) {
            $.modalAlert("Thiếu thông tin cơ bản của bệnh nhân", 'warning');
            return false;
        }
        if (parseFloat(zhye) <= 0) {
            $.modalAlert("hiện tại Tài khoản Không có Số dư có thể hoàn", 'warning');
            return false;
        }
        var reg = /^(-?\d+)(\.\d+)?$/;
        zfmoney = "-" +$("#zhye").val();
        //zfmoney = $("#txtmoney").val();
        var ddlzffs = $("#ddlzffs option:selected");//lấy khoản đã chọn
        zffsbh = ddlzffs.val();//lấy giá trị của khoản đã chọn
        zffsmc = ddlzffs.text();//lấy văn bản của khoản đã chọn
        if (zffsbh == -1 || zffsmc == "") {
            $.modalAlert("Thiếu phương thức thanh toán", 'warning');
            return false;
        }
        $.loading(true, "Đang yêu cầu dữ liệu...");
        $.najax({
            type: "POST",
            url: "/SystemManage/InpatientAccountManage/RefundAccount",
            data: {
                zffsbh: zffsbh, zffsmc: zffsmc, zfje: zfmoney,zyh:$("#zyh").val(),
                zh: zh, patid: patid, szxz:@Html.Raw(((int)EnumSZXZ.tye)), memo: $("#memo").val(), outTradeNo: RefundOutTradeNo
            },
            dataType: "json",
            cache: false,
            success: function (resdata) {
                if (resdata != null && resdata.data) {
                    $.loading(false);
                    ClearMoney();
                    //Gọi danh sách thu chi tài khoản
                    getZhInfo(zh);
                    $.modalMsg("Hoàn toàn bộ thành công", 'success');
                }
            }
        });
    }

    function RefreshAccount() {
        GetQuerypatientInfoAjax($("#patid").val(),$("#zyh").val());
    }

    //Tra cứu tài khoản
    function getZhInfo() {
        $.loading(true, "Đang yêu cầu dữ liệu...");
        $.najax({
            type: "POST",
            url: "/SystemManage/InpatientAccountManage/GetBasicZhInfoJson",
            data: { zh: zh },
            dataType: "json",
            cache: false,
            success: function (resdata) {
                if (resdata != null && resdata.data) {
                    $.loading(false);
                    gridListData(resdata.data);
                }
            }
        });
    }

</script>
<script type="text/javascript">
    //Thanh toán di động
    var payingOrFailed = null;  //trueđang thanh toán hoặc thanh toán thất bại
    function CheckPayOK() {

        var payMoney = 0;
        var alipayMoney = 0;
        var wechatMoney = 0;

        var djjesszffs = $('#ddlzffs option:selected').val();

        if (djjesszffs == 13) {
            payMoney = $("#txtmoney").val();
        } else {
            if (djjesszffs == '10') {
                alipayMoney = $("#txtmoney").val();
            }
            else if (djjesszffs == '11') {
                wechatMoney = $("#txtmoney").val();

            }
            payMoney = alipayMoney + wechatMoney
        }

        if (payMoney <= 0) {
            //Không cần thanh toán di động
            payingOrFailed = null;
            return true;
        }

        if ((payingOrFailed === null || payingOrFailed === true) && payMoney > 0) {
            payMoney = parseFloat(payMoney).toFixed(2);
            var out_trade_no = (new Date()).getTime().toString();   //làkhôngcóVấn đề？
            ToPay(out_trade_no, 'tạm ứng nạp tiền', payMoney, djjesszffs);
            payingOrFailed = true;
        }
        return !(payingOrFailed === true); //đang thanh toán trả vềtrue，nếu không thì trả vềfalse
    }
    //khởi tạo thanh toán
    function ToPay(out_trade_no, subject, total_amount, djjesszffs) {
        var title = 'Thanh toán bằng mã thanh toán-' + (subject.length <= 15 ? subject : subject.substring(0, 12) + "...");
        var url = "/PayManage/MicroPay/MicroPay";
        url += '?out_trade_no=' + out_trade_no;
        url += '&subject=' + subject;
        url += '&total_amount=' + total_amount;
        url += '&djjesszffs=' + djjesszffs;
        url += '&patid=' + patid;
        $.modalOpen({
            id: "ToPay",
            title: title,
            url: url,
            width: "400px",
            height: "210px",
            callBack: function (iframeId) {
                top.frames[iframeId].AcceptClick(function (data) {
                    //pay success callback
                    PaySuccessHandle(data);
                });
            }
        });
    }
    //thanh toán thành công-kế tiếptiếp tụcnêunộpkếttính
    var outTradeNo;
    function PaySuccessHandle(data) {
        payingOrFailed = false;

        outTradeNo = data.outTradeNo;


        PayDepositPost(zffsbh, zffsmc, $("#txtmoney").val(), pzh, patid, zh, zhxz, outTradeNo);
    }


</script>




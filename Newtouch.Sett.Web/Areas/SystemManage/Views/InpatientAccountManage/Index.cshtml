<!--Danh sách thu chi-->
<form id="formPat2">
    <div class="gridPanel" style="margin-top:10px;border-radius:5px;">
        <table id="gridList" rel="formPat2"></table>
    </div>
</form>
<!--Nạp/hoàn tiền tạm ứng-->
<div class="panel panel-default" style="margin-top:10px;">
    <div class="panel-heading navb-bg">
        Tiền tạm ứng
    </div>
    <div style="padding: 2px;padding-right:20px;">
        <table class="form">
            <tr>
                <th class="formTitle">Phương thức thanh toán：</th>
                <td class="formValue">
                    <select id="ddlzffs" name="zffs" class="form-control required"></select>
                </td>
                <th class="formTitle"><span class="required">*</span>Số tiền：</th>
                <td class="formValue">
                    <input id="txtmoney" name="txtmoney" type="text" class="form-control required" placeholder="Vui lòng nhập số tiền" />
                </td>
                <th class="formTitle">Số chứng từ：</th>
                <td class="formValue">
                    <input type="text" id="txtlpzh" class="form-control newtouch_Readonly" style="width: 49.5%;display: inline;" value="" />
                    <a id="receipt" class="btn btn-primary" onclick=""><i class="fa"></i>Số chứng từ</a>

            </div>
            <table class="form" style="margin-left: 10px;">
                <tr>
                    <th class="formTitle"><span style="color:red">*</span><label id="lbl_kh">Số nhập viện/Họ tên：</label> </th>
                    <td class="formValue" colspan="2">
                        <input type="text" id="keyword" name="keyword" class="form-control" placeholder="Ít nhất1ký tự" />
                    </td>
                    <td class="formTitle">
                        Họ tên：
                    </td>
                    <td class="formValue">
                        <label id="xm"></label>
                    </td>
                    <td class="formTitle">Giới tính：</td>
                    <td class="formValue">
                        <label id="xb"></label>
                    </td>
                    <td class="formTitle">Tuổi：</td>
                    <td class="formValue">
                        <label id="nlshow"></label>
                    </td>
                    <td class="formTitle">

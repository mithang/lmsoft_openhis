
@{
    ViewBag.Title = "Selector";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<script>
    var organizeId = $.request("organizeId");
    var keyValue = $.request("keyValue");
    var isShowEmpty = $.request("isShowEmpty");
    var isExpand = $.request("isExpand");
    var callbackType = $.request("callbackType");
    var single = $.request("single");
    var fromDialog = $.request("fromDialog");
    var cacheTime = $.request("cacheTime");
    var initIdSelected = $.request("initIdSelected");
    $(function () {
        initControl();
    })
    function initControl() {
        $("#staffTree").treeview({
            height: 400,
            slimscroll: false,
            showcheck: true,
            url: "/SystemManage/SysChargeItem/GetChargeItemSelecotrTree",
            param: { organizeId: organizeId, isExpand: isExpand, callbackType: callbackType, single: single, fromDialog: fromDialog, cacheTime: cacheTime, initIdSelected: initIdSelected }
        });
    }
    function submitForm() {
        var treeSeleData;
        if (callbackType == 'json') {
            treeSeleData = $("#staffTree").getCheckedNodeObjArray();
            if (single == 'true' && treeSeleData.length != 1) {
                $.modalAlert('Vui lòng đã chọn một', 'warning');
                return;
            }
        }
        else {
            treeSeleData = $("#staffTree").getCheckedNodes();
            if (single == 'true' && treeSeleData.length != 1) {
                $.modalAlert('Vui lòng đã chọn một', 'warning');
                return;
            }
            treeSeleData = String(treeSeleData);
        }

        if (false) {

        }
        else if (fromDialog) {
            //Hành vi mặc định,callbacktrước đóDialogphương pháp
            top.top.window.frames[fromDialog].staffTreeCallback(treeSeleData);
        }
        else {
            //Hành vi mặc định,callbackPhương thức của trang trước
            $.currentWindow().window.staffTreeCallback(treeSeleData);
        }
    }
</script>
<div>
    <div id="staffTree"></div>
</div>


@using NewtouchHIS.Lib.Framework.Operator;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
    var opeator = OperatorProvider.GetCurrent();
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
            @if (opeator.IsAdministrator || opeator.IsRoot || true)
            {
                <a class="btn btn-primary dropdown-toggle" data-toggle="dropdown"><span class="caret"></span></a>
                <ul class="dropdown-menu pull-right">
                    <li><a onclick="btn_template()" href="javascript:void(0)">cấu hình Mẫu Quản lý</a></li>
                </ul>
            }
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-pencil-square-o"></i>Xóa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_sync()"><i class="fa fa-pencil-square-o"></i>đồng bộ</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="cấu hình Tên/cấu hình Mã" style="width: 200px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
    @*<div style="float:right;padding-right:100px;">
        <a title="Xem tất cả mục cấu hình" onclick="btn_ShowAllConfig()" style="cursor:pointer;color:blue;text-decoration:underline;">Xem tất cả mục cấu hình</a>
    </div>*@
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    @*<div id="gridPager"></div>*@
</div>

<script>
    $(function () {
        gridList();

    })


    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            postData: { keyword: $("#txt_keyword").val() },
            url: "/SystemManage/SysConfig/GetGridJson",
            height: $(window).height() - 128,
            colModel: [
                 { label: "Khóa chính", name: "Id", hidden: true, key: true },
                { label: "Hiệu lực", name: "zt", width: 80, align: "center", formatter: function (cellvalue) { return cellvalue == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
                  { label: "Tên", name: "Name", width: 200, align: 'left'},
                  { label: 'Mã', name: 'Code', width: 150, align: 'left' },
                  { label: 'Value', name: 'Value', width: 150, align: 'left' },
                  { label: 'Giải thích', name: 'Memo', width: 200, align: 'left' },
                    { label: 'Sắp xếp', name: 'px', width: 40, align: 'left' },
                { label: 'Người tạo', name: 'CreatorCode', width: 100, align: 'left' },
                { label: 'Thời gian tạo mới', name: 'CreateTime', width: 130, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Cuối cùng Sửa', name: 'LastModifierCode', width: 100, align: 'left' },
                { label: 'Cuối cùng Sửa Thời gian', name: 'LastModifyTime', width: 130, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
            ],
        });
        $("#btn_search").click(function () {
            $("#gridList").jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword").val() },
            }).trigger('reloadGrid');
        });
    }

    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "Thêm mới cấu hình",
            url: "/SystemManage/SysConfig/Form",
            width: "550px",
            height: "570px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                });
            }
        });
    }

    function btn_edit() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một dòng thông tin", 'warning');
            return;
        }
        $.modalOpen({
            id: "Form",
            title: "Sửa cấu hình",
            url: "/SystemManage/SysConfig/Form?keyValue=" + keyValue,
            width: "550px",
            height: "570px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                });
            }
        });
    }

    //Xóa
    function btn_delete() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một dòng thông tin", 'warning');
            return;
        }
        var IsA='@opeator.IsAdministrator';
        var IsR='@opeator.IsRoot';
        if (IsA == "False" && IsR == "False")
        {
            if ($("#gridList").jqGridRowValue().Value == "")
            {
                // == ""? khôngtốt
                $.modalAlert("này Mẫu cấu hình không có thể xóa", 'warning');
                return;
            }
        }
        $.deleteForm({
            url: "/SystemManage/SysConfig/DeleteForm",
            param: { keyValue: keyValue },
            success: function () {
                $("#gridList").resetSelection();
                $("#gridList").trigger("reloadGrid");
            }
        });
    }
    function btn_sync() {
        $.modalConfirm("xác nhận cần đồng bộ nơi có hệ thống Tham số không？", function (r) {
            if (r) {
                $.loading(true, 'dữ liệu đồng bộ trong...');
                $.najax({
                    url: "/Home/SyncSysConfigParams",
                    type: "POST",
                    data: {orgId: '@(opeator.OrganizeId)'},
                    dataType: "json",
                    async: false,
                    success: function (data) {
                        $.modalAlert(data.message, data.state);
                        $('#btn_search').trigger('click');
                        $.loading(false);
                    }
                });
            } else {

            }
        });
    }
    

    function btn_ShowAllConfig() {
        $.modalOpen({
            id: "Form",
            title: "Xem nơi có cấu hình mục",
            url: "/SystemManage/SysConfig/ConfigsPreviewIndex",
            width: "850px",
            height: "570px",
            btn: null
        });
    }

    function btn_template()
    {
        $.modalOpen({
            id: "Template",
            title: "cấu hình Mẫu",
            url: "/SystemManage/SysConfig/TemplateIndex",
            width: "900px",
            height: "500px",
            btn: null,
        });

    }

</script>

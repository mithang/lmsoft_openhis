@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<form id="form">
    <div style="padding-top: 20px; margin-right: 30px;">
        <table class="form">
            <tr>
                <td class="formTitle"><span class="required">*</span>Mã：</td>
                <td class="formValue">
                    <input id="Code" name="Code" type="text" class="form-control required" placeholder="Vui lòng nhập mã" />
                </td>
            </tr>
            <tr>
                <td class="formTitle"><span class="required">*</span>Mã bên thứ ba：</td>
                <td class="formValue">
                    <input id="TTCode" name="TTCode" type="text" class="form-control required" placeholder="Vui lòng nhập Mã bên thứ ba" />
                </td>
            </tr>
            <tr>
                <td class="formTitle"><span class="required">*</span>Mã định danh bên thứ ba：</td>
                <td class="formValue">
                    <input id="TTMark" name="TTMark" type="text" class="form-control required" placeholder="Vui lòng nhập Mã bên thứ ba" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Giải thích：</th>
                <td class="formValue">
                    <input id="Description" name="Description" type="text" class="form-control" placeholder="" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Thứ tự:</th>
                <td class="formValue">
                    <input id="px" name="px" type="text" class="form-control" placeholder="" />
                </td>
            </tr>
            <tr>
                <th class="formTitle" style="height: 35px;">Trạng thái:</th>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Hiệu lực</label>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</form>
<script>
    var keyValue = $.request("keyValue");
    $(function () {
        initControl();

        if (!!keyValue) {
            $.ajax({
                url: "/SystemManage/TTCataloguesComparison/GetMainFormJson",
                data: { keyValue: keyValue },
                dataType: "json",
                async: false,
                success: function (data) {
                    $("#form").formSerialize(data);
                }
            });
        }
    });

    function initControl() {

    }

    function AcceptClick(callBack) {
        if (!$('#form').formValid()) {
            return false;
        }
        var postData = $("#form").formSerialize();
        $.submitForm({
            url: "/SystemManage/TTCataloguesComparison/MainSubmitForm?keyValue=" + keyValue,
            param: postData,
            success: function () {
                callBack();
                $.modalClose();
            }
        })
    }
</script>

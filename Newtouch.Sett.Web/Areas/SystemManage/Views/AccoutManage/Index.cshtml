@using NewtouchHIS.Lib.Framework.Operator;
@{
    ViewBag.Title = "tạm ứng Quản lý";
    Layout = "~/Views/Shared/_Index.cshtml";
    //Liên kết báo cáo biên lai nạp tiền tạm ứng
    var yjjReportUrl = SysConfigReader.OrgReportLink("yjjsjdy");
    var curOpr = OperatorProvider.GetCurrent();
    var reportUrl = "";
    var ReportSystemCode = "";
}
<form id="form1">
    <div class="rows" style="margin-bottom: 1%;" id="basicInfo">
        <div class="panel panel-default" style="margin-bottom:0;">
            <div class="panel-heading navb-bg">
                Thông tin cơ bản của bệnh nhân
            </div>
            <table class="form" style="margin-left: 10px;">
                <tr>
                    <th class="formTitle"><span style="color:red">*</span><label id="lbl_kh">Số hồ sơ bệnh án/Họ tên：</label> </th>
                    <td class="formValue" colspan="2">
                        <input type="text" id="keyword" name="keyword" class="form-control" placeholder="Ít nhất1ký tự" />
                    </td>
                    <td class="formTitle">
                        Họ tên：
                    </td>
                    <td class="formValue">
                        <label id="xm"></label>
                    </td>
                    <td class="formTitle">Giới tính：</td>
                    <td class="formValue">
                        <label id="xb"></label>
                    </td>
                    <td class="formTitle">Tuổi：</td>
                    <td class="formValue">
                        <label id="nlshow"></label>
                    </td>
                    <td class="formTitle">
                        <label id="zjlx">Số CMND/CCCD：</label>
                        <input hidden="hidden" id="hiddenzjlx" />
                    </td>
                    <td class="formValue" colspan="2">
                        <label id="zjh"></label>
                    </td>
                </tr>
                <tr>
                    <td class="formTitle">Điện thoại di động：</td>
                    <td class="formValue"><label id="phone"></label></td>
                    <td class="formTitle"></td>
                    <td class="formValue"></td>
                    <td class="formTitle"></td>
                    <td class="formValue">
                        <input type="hidden" id="brxzmc" />
                        <input type="text" hidden value="" id="patid" name="patid" />
                        <input type="text" hidden value="" id="zhCode" name="zhCode" />
                        <input type="text" hidden value="" id="zhxz" name="zhxz" />
                        <input type="text" hidden id="zhye" name="zhye" value="">
                    </td>
                    <td class="formTitle"></td>
                    <td class="formValue"></td>
                    <td class="formValue"><input type="hidden" id="patid" /></td>
                </tr>
            </table>
        </div>
    </div>
</form>
<!--Danh sách thu chi-->
<form id="formPat2">
    <div class="gridPanel" style="margin-top:10px;border-radius:5px;">
        <table id="gridList" rel="formPat2"></table>
    </div>
</form>
<!--Nạp/hoàn tiền tạm ứng-->
<div class="panel panel-default" style="margin-top:10px;">
    <div class="panel-heading navb-bg">
        Tiền tạm ứng
    </div>
    <div style="padding: 2px;padding-right:20px;">
        <table class="form">
            <tr>
                <th class="formTitle">Phương thức thanh toán：</th>
                <td class="formValue">
                    <select id="ddlzffs" name="zffs" class="form-control required"></select>
                </td>
                <th class="formTitle"><span class="required">*</span>Số tiền：</th>
                <td class="formValue">
                    <input id="txtmoney" name="txtmoney" type="text" class="form-control required" placeholder="Vui lòng nhập số tiền" />
                </td>
                <th class="formTitle">Số chứng từ：</th>
                <td class="formValue">
                    <input type="text" id="txtlpzh" class="form-control newtouch_Readonly" style="width: 49.5%;display: inline;" value="" />
                    <a id="receipt" class="btn btn-primary" onclick=""><i class="fa"></i>Số chứng từ</a>
                </td>
                <th class="formTitle"></th>
                <td class="formValue"></td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="ReceiptPanel"></table>
</div>
<!--Thanh công cụ nút-->
<div class="toolbar toolbarfloat">
    <a id="acc_addMoney" class="btn btn-primary" onclick="sjPrint()"><i class="fa fa-plus"></i> In bổ sung</a>
    <a id="acc_addMoney" class="btn btn-primary" onclick="PayDeposit()"><i class="fa fa-plus"></i> nạp tiền</a>
    <a id="acc_reMoney" class="btn btn-primary" onclick="Refund()"><i class="fa fa-minus"></i> Hoàn tiền</a>
    <a id="acc_reMoney" class="btn btn-primary" onclick="RefundAccount()"><i class="fa fa-minus"></i> Hoàn toàn bộ số dư</a>
    <a class="btn btn-primary" onclick="newtouch_globalevent_f5()"><span class="glyphicon glyphicon-refresh"> Làm mới</span></a>
</div>
<style>
    #yeCon {
        padding-left: 25px;
        color: red;
    }
</style>

<script>
    var reqzhxz = $.request("zhxz");
    var patid = "";
    $(function () {
        if (!reqzhxz) {
            reqzhxz = "";
        }
        else if (reqzhxz == "zy") {
            reqzhxz = '@((int)EnumXTZHXZ.ZYYJKZH)';
            $("#zhxz").val(reqzhxz);
        }else if (reqzhxz == "mz") {
            reqzhxz = '@((int)EnumXTZHXZ.MZYJKZH)';
            $("#zhxz").val(reqzhxz);

        }
        $("#receipt").click(function () {
            showReceiptPanel(); //Bật cửa sổ số chứng từ
        });

        //Liên kết lớp nổi chọn mục điều trị
        $('#keyword').newtouchBatchFloatingSelector({
            width: 500,
            height: 200,
            caption: "Chọn bệnh nhân",
            clickautotrigger: true,
            url: "/PatientManage/HospiterRes/PatYjjSearchInfo",
            ajaxparameters: function ($thisinput) {
                var keyword = $thisinput.val().trim();
                return "keyword=" + keyword+"&type="+$.request("zhxz");
            },
            itemdbclickhandler: function ($thistr, $thisinput) {
                patid = $thistr.attr("data-patid");
                GetQuerypatientInfoAjax(patid);
            },
            colModel: [
               { label: 'Khóa chính', name: 'patid', hidden: true },
                { label: 'Số hồ sơ bệnh án', name: 'blh', width: 80, align: 'left' },

                { label: 'Họ tên', name: 'xm', width: 100, align: 'left' },
                { label: 'Năm sinh', name: 'csny', hidden: true, width: 100, align: 'left' },
                {
                    label: 'Giới tính', name: 'xb', width: 70, align: 'left', formatter: function (cellvalue) {
                        return $.getGender(cellvalue);
                    }
                },
                { label: 'Tuổi', name: 'nlshow', width: 100, align: 'left', formatter: function (cellvalue, a, b) {
                    return getAgeFromBirthTime({ begin: b.csny }).text;
                }
                },
                 { label: 'Số nhập viện', name: 'zyh', width: 60, align: 'left' },
                { label: 'brly', name: 'brly', align: 'left', hidden: true },
                { label: 'zjh', name: 'zjh', align: 'left', hidden: true },
                { label: 'brxz', name: 'brxz', align: 'left', hidden: true },
                { label: 'kh', name: 'kh', align: 'left', hidden: true },
                { label: 'phone', name: 'phone', align: 'left', hidden: true },
                { label: 'dy', name: 'dy', align: 'left', hidden: true },
                { label: 'zjlx', name: 'zjlx', align: 'left', hidden: true },
                { label: 'sycs', name: 'sycs', align: 'left', hidden: true },
                { label: 'dybh', name: 'dybh', align: 'left', hidden: true },
                { label: 'lxr', name: 'lxr', align: 'left', hidden: true },
                { label: 'lxrgx', name: 'lxrgx', align: 'left', hidden: true },
                { label: 'lxrdh', name: 'lxrdh', align: 'left', hidden: true },
            ]
        });
        gridListData([]);
        $(window).resize(function () {
            initLayout("formPat2");
        });

        $("#ddlzffs").newtouchBindSelect({
            id: "xjzffs",
            text: "xjzffsmc",
            datasource: function () {
                //Duyệt nguồn dữ liệu
                var resultObjArr = new Array();
                $.each(top.clients.SysForCashPayList, function (idx, val) {
                    if (val.zhxz == 'a') {
                        resultObjArr.push(val);
                    }
                });
                return resultObjArr;
            }
        });
        GetSJPZH();
    });

    function GetQuerypatientInfoAjax(patid) {
        $.najax({
            type: "POST",
            url: "@Url.Action("PatAccountInfo")",
            data: { patid: patid, zhxz: $("#zhxz").val() },
            dataType: "json",
            cache: false,
            alertbierror: false,
            success: function (ajaxresp) {
                $.loading(false);
                var accPayInfoList = ajaxresp.data.accPayInfoList;
                var patInfo = ajaxresp.data.patInfo;
                if (patInfo != "[]") {
                    setPatInfoModel(ajaxresp.data.patInfo);
                }
                if (accPayInfoList.length > 0) {
                    gridListData(ajaxresp.data.accPayInfoList);
                }
            },
            errorCallback: function (rtnval) {
                if (rtnval.message == "缺少账户") {
                    $.modalConfirm("Không tìm thấy bệnh nhân này tạm ứng Tài khoản，Có hay không Tạo mới", function (f) {
                        if (f) {
                            $.najax({
                                type: "POST",
                                url: "/PatientManage/AccountManage/AddReserveAccount",
                                data: { patid: patid, zhxz: $("#zhxz").val() },
                                dataType: "json",
                                cache: false,
                                alertbierror: false,
                                success: function (res) {
                                    GetQuerypatientInfoAjax(patid);
                                    $('#gridList').jqGrid("clearGridData");
                                }
                            });
                        }
                    })
                } else {
                    $.modalAlert(rtnval.message,"warning");
                }
            }
        });
    }

    //Bật cửa sổ lấy số chứng từ
    function showReceiptPanel() {
        var cardNo = $("#keyword").val();
        if (cardNo) {
            $.modalOpen({
                id: "ReceiptPanel",
                title: "Chọn Số chứng từ",
                url: "/PatientManage/AccountManage/ChooseReceipt?t=" + Math.random(),
                width: "300px",
                height: "200px",
                callBack: function (iframeId) {
                    top.frames[iframeId].ReceiptConfirm();
                }//hàm gọi lại khi nhấn xác nhận trên cửa sổ
            });
        } else {
            $.modalAlert("Vui lòng chọn bệnh nhân", 'warning');
            $("#keyword").focus();
        }
    }

    //Lấy hiển thị giao diện thông tin cơ bản bệnh nhân
    function setPatInfoModel(patModel) {
        $("#xb").html($.getGender(patModel.xb));
        $("#csny").html((patModel.csny && patModel.csny.length >= 10 ? patModel.csny.substring(0, 10) : ""));
        $("#zjh").html(patModel.zjh);
        $("#xm").html(patModel.xm);
        $("#nlshow").html(getAgeFromBirthTime({ begin: patModel.csny }).text);
        $("#blh").val(patModel.blh);
        $("#patid").val(patModel.patid);
        $("#phone").html(patModel.phone);
        $("#hiddenzjlx").val(patModel.zjlx);
        $("#brxzmc").val(patModel.brxz);
        $("#zhCode").val(patModel.zhCode);
        $("#zhxz").val(patModel.zhxz);
        $("#keyword").val(patModel.blh);
    }

    //Danh sách thu chi tài khoản
    function gridListData(mydata) {
        $('#gridList').jqGrid("clearGridData");
        var $gridList = $("#gridList");
        var zhye = "0.00";
        if (mydata != [] && mydata.length > 0) {
            zhye = mydata[0].zhye.toFixed(2);
        }
        $("#zhye").val(zhye); //valuegán giá trị
        var captionCon = "Bảng thu chi tài khoản";
        captionCon += '<label style="height: 7px; width: 36px; background-color:#DDDDFF; border: 1px solid #ddd;margin-left: 40px;"></label> nạp tiền ' ;
        captionCon += '<label style="height: 7px; width: 36px; background-color:#ACD6FF; border: 1px solid #ddd;margin-left: 40px;"></label> Rút tiền ';
        captionCon += "<span id='ye Con'>Số dư tài khoản：" + zhye + "đồng</span>";
        $gridList.dataNewGrid({
            height: $(window).height() - 330,
            autowidth: false,
            width: $("#formPat2").width() - 10,
            caption: captionCon,
            colModel: [
                { label: 'Số tiền thu chi', name: 'szje', width: 105, formatter: "number",align: 'center' },
                { label: 'Số tiền tài khoản', name: 'zhye', width: 105, formatter: "number", align: 'center' },
                { label: 'Số chứng từ', name: 'pzh', width: 105, align: 'center' },
                { label: 'Nhân viên thu chi', name: 'Creator', width: 105, align: 'center' },
                { label: 'Phương thức thanh toán', name: 'xjzffsmc', width: 105, align: 'center' },
                { label: 'Ngày thu chi', name: 'CreateTime', width: 125, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                {
                    label: 'Tính chất thu chi', name: 'szxz', width: 105, align: 'center',
                    formatter: function (val) {
                        return $.enum.getDescByValue("EnumSZXZ", val)
                    }
                }, { label: 'Id', name: 'Id', hidden: true },
                 { label: 'tId', name: 'tId', hidden: true },
            ], gridComplete: function () {
                var ids = $gridList.getDataIDs();
                for (i = 0; i < ids.length; i++) {
                    var rowData = $gridList.getRowData(ids[i]);
                    if (rowData && rowData.szxz=="充值") {
                        $gridList.find('tr[id="' + ids[i] + '"]').css("background-color", "#DDDDFF");
                    } else if (rowData && rowData.szxz == "取款") {
                        $gridList.find('tr[id="' + ids[i] + '"]').css("background-color", "#ACD6FF");
                    }
                }
            },
            onSelectRow: function (rowid, status) {
                btn_edit();
            }
        }, mydata);

        if (mydata.length > 0) {
            $('.ui-jqgrid-bdiv').find(".unwritten").remove();
        }
        $("#yeCon").text("Số dư tài khoản：" + zhye + "đồng");
    }

    var patid,
        zh,
        zhxz,
        zffsbh,
        zffsmc,
        zfmoney,
        pzh;
    //Xét nạp tiền và hoàn tiền
    function CheckDeposit() {
        patid = $("#patid").val();
        zh = $('#zhCode').val();
        zhxz = $('#zhxz').val();
        if (!!!patid) {
            $.modalAlert("Thiếu thông tin cơ bản của bệnh nhân", 'warning');
            return false;
        }
        var reg = /^(-?\d+)(\.\d+)?$/;
        zfmoney = $("#txtmoney").val();
        var ddlzffs = $("#ddlzffs option:selected");//lấy khoản đã chọn
        zffsbh = ddlzffs.val();//lấy giá trị của khoản đã chọn
        zffsmc = ddlzffs.text();//lấy văn bản của khoản đã chọn
        pzh = $("#txtlpzh").val();
        if (zffsbh == -1 || zffsmc == "") {
            $.modalAlert("Thiếu phương thức thanh toán", 'warning');
            return false;
        }
        if (zfmoney == "" || zfmoney == undefined) {
            $.modalAlert("Thiếu số tiền thanh toán", 'warning');
            return false;
        } else {
            if (!reg.test(zfmoney)) {
                $.modalAlert("Định dạng số tiền không đúng", 'warning');
                return false;
            }
        }
        if (pzh == "" || pzh == undefined) {
            $.modalAlert("Thiếu số chứng từ", 'warning');
            return false;
        }
        return true;
    }

    //Nạp tiền kiểm tra ở giao diện số tiền và đã chọn loại thanh toán chưa
    function PayDeposit() {
        zfmoney = $("#txtmoney").val();
        if (parseFloat(zfmoney) < 0 || zfmoney == "" || isNaN(zfmoney) == true) {
            $.modalAlert("Thiếu số tiền thanh toán", 'warning');
            return false;
        }
        if (CheckDeposit()) {
            PayDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid, zh, zhxz);
        }
    }

    //Nạp tiền tạm ứng
    function PayDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid,zh, zhxz) {
        $.loading(true, "Đang yêu cầu dữ liệu...");
        $.najax({
            type: "POST",
            url: "/PatientManage/AccountManage/PayDepositPost",
            data: {
                zffsbh: zffsbh, zffsmc: zffsmc,
                zfje: zfmoney, pzh: pzh, zh: zh,
                zhxz: zhxz,patid: patid,szxz:@Html.Raw((int)EnumSZXZ.cz)
            },
            dataType: "json",
            cache: false,
            success: function (resdata) {
                if (resdata != null && resdata.data.flag) {
                    $.loading(false);
                    $.modalMsg("Nạp tiền thành công", 'success');
                    ClearMoney(); //Xóa trống
                    getZhInfo(zh); //Bản ghi thu chi tài khoản

                    var reqzhxz=$.request("zhxz")=='zy'?'Nhập viện':'Ngoại trú'
                    var orgId = '@curOpr.OrganizeId';
                    //var uri = '@Html.Raw(yjjReportUrl)' + "&patId=" + patid +"&szid="+resdata.data.szId;
                    var uri = '@reportUrl' + "?tempCode=03" + "&systemCode=" + '@Html.Raw(ReportSystemCode)'+ "&hospitalCode=" + orgId + "&szId=" + resdata.data.szId;
                    window.open(uri, "_blank", "height=500, width=1195,top=100, left=50, toolbar =no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no");
                }
            }, errorCallback: function (rtnval) {
                if (rtnval.message = "Số biên lai hiện tại đã được sử dụng！") {
                    GetSJPZH();
                }
                $.modalAlert(rtnval.message, "warning");
            }
        });
    }


    //Xóa trống
    function ClearMoney() {
        $('#gridList').jqGrid("clearGridData");
        //Xóa ô nhập số tiền
        $("#txtmoney").val("");
        $('#zhye').val("0.00");
        //Lấy số chứng từ
        GetSJPZH();
        GetQuerypatientInfoAjax(patid);
    }

    //Lấy số chứng từ
    function GetSJPZH() {
        $.najax({
            type: "POST",
            url: "/PatientManage/AccountManage/GetReceipt",
            data: {},
            dataType: "json",
            cache: false,
            success: function (resdata) {
                if (resdata != null && resdata.data != "") {
                    $("#txtlpzh").val(resdata.data);
                    return resdata.data;
                } else {
                    $("#txtlpzh").val("");
                    return "";
                }
            }
        });
    }
    var gridIMoney = "";//Số tiền thu chi đang chọn
    var gridIpzh = ""; //Số chứng từ đang chọn
    var gridId = "";//đang chọn hiện tạiId
    var gridtId="";//đang chọn hiện tạiId，Căn cứ đã hoàn hay chưa
    //Sự kiện nhấn
    function btn_edit() {
        var szje = $("#gridList").jqGridRowValue().szje;
        var pzh = $("#gridList").jqGridRowValue().pzh;
        gridId = $("#gridList").jqGridRowValue().Id;
        gridtId = $("#gridList").jqGridRowValue().tId;
        gridIMoney = szje;
        gridIpzh = pzh;
        if (parseFloat(gridIMoney) > 0) {
            $("#txtmoney").val('-' + szje);
        } else {
            return;
        }
        $("#txtlpzh").val(pzh);
    }

    //In bù biên lai nạp tiền
    function sjPrint()
    {
        var pzh = $("#txtlpzh").val();
        if (gridIpzh == "" || pzh != gridIpzh) {
            $.modalAlert("Vui lòng chọn một nạp tiền chi tiết", 'warning');
            return false;
        }

        //var reqzhxz=$.request("zhxz")=='zy'?'Nội trú':'Ngoại trú'
        var orgId = '@curOpr.OrganizeId';
        //var uri = '@Html.Raw(yjjReportUrl)'+"&patId=" + patid + "&szid="+gridId;//+"&type=" + reqzhxz
        var uri = '@reportUrl' + "?tempCode=03" + "&systemCode=" + '@Html.Raw(ReportSystemCode)'+ "&hospitalCode=" + orgId + "&szId=" + gridId;
        window.open(uri, "_blank", "height=500, width=1195,top=100, left=50, toolbar =no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no");
    }

    //Hoàn tiền
    function Refund() {
        var money = $("#txtmoney").val();
        var pzh = $("#txtlpzh").val();
        var zhye = $("#zhye").val();
        if (parseFloat(money) > 0) {
            $.modalAlert("Vui lòng chọn một nạp tiền chi tiết", 'warning');
            return false;
        }
        if (gridIpzh == "" || pzh != gridIpzh) {
            $.modalAlert("Vui lòng chọn một nạp tiền chi tiết", 'warning');
            return false;
        }
        if (gridtId!="") {
            $.modalAlert("Khoản nạp tiền này đã được hoàn lại, vui lòng kiểm tra", 'warning');
            return false;
        }
        if (gridIMoney != money.substring(1, money.length)) {
            $.modalAlert("nạp tiền Số tiền và Hoàn tiền Số tiền không nhất quán，Vui lòng kiểm tra", 'warning');
            return false;
        }
        if (parseFloat(money) + parseFloat(zhye) < 0) {
            $.modalAlert("Số dư tài khoản hiện tại không đủ", 'warning');
            return false;
        }

        if (CheckDeposit()) {
            ExitDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid,zh, zhxz,@Html.Raw(((int)EnumSZXZ.cz)));
        }
    }

    //Hoàn toàn bộ số dư
    function RefundAccount() {
        patid = $("#patid").val();
        zh = $('#zhCode').val();
        zhxz = $('#zhxz').val();
        var money = $("#txtmoney").val();
        var zhye = $("#zhye").val();
        if (!!!patid) {
            $.modalAlert("Thiếu thông tin cơ bản của bệnh nhân", 'warning');
            return false;
        }
        if (parseFloat(zhye) < 1) {
            $.modalAlert("Số dư tài khoản hiện tại không đủ", 'warning');
            return false;
        }
        var reg = /^(-?\d+)(\.\d+)?$/;
        zfmoney = "-" +$("#zhye").val();
        var ddlzffs = $("#ddlzffs option:selected");//lấy khoản đã chọn
        zffsbh = ddlzffs.val();//lấy giá trị của khoản đã chọn
        zffsmc = ddlzffs.text();//lấy văn bản của khoản đã chọn
        if (zffsbh == -1 || zffsmc == "") {
            $.modalAlert("Thiếu phương thức thanh toán", 'warning');
            return false;
        }
        $.loading(true, "Đang yêu cầu dữ liệu...");
        $.najax({
            type: "POST",
            url: "/PatientManage/AccountManage/RefundAccount",
            data: {
                zffsbh: zffsbh, zffsmc: zffsmc, zfje: zfmoney,
                zh: zh, patid: patid, szxz:@Html.Raw(((int)EnumSZXZ.qk))
            },
            dataType: "json",
            cache: false,
            success: function (resdata) {
                if (resdata != null) {
                    $.loading(false);
                    ClearMoney();
                    //Gọi danh sách thu chi tài khoản
                    getZhInfo(zh);
                    $.modalMsg("Hoàn toàn bộ thành công", 'success');
                }
            }
        });
    }

    //Hoàn tiền
    function ExitDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid,zh, zhxz) {
        $.loading(true, "Đang yêu cầu dữ liệu...");
        $.najax({
            type: "POST",
            url: "/PatientManage/AccountManage/ExitDepositPost",
            data: {
                zffsbh: zffsbh, zffsmc: zffsmc, zfje: zfmoney,
                pzh: pzh, zh: zh, zhxz: zhxz, patid: patid,szxz:@Html.Raw(((int)EnumSZXZ.qk))
            },
            dataType: "json",
            cache: false,
            success: function (resdata) {
                if (resdata != null && resdata.data) {
                    $.loading(false);
                    $.modalMsg("Hoàn tiền Thành công", 'success');
                    ClearMoney();
                    //Gọi danh sách thu chi tài khoản
                    getZhInfo(zh);

                }
            }
        });
    }

    //Tra cứu tài khoản
    function getZhInfo() {
        $.loading(true, "Đang yêu cầu dữ liệu...");
        $.najax({
            type: "POST",
            url: "/PatientManage/AccountManage/GetBasicZhInfoJson",
            data: { zh: zh },
            dataType: "json",
            cache: false,
            success: function (resdata) {
                if (resdata != null && resdata.data) {
                    $.loading(false);
                    gridListData(resdata.data);
                }
            }
        });
    }
</script>

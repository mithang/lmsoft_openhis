
@{
    ViewBag.Title = "PrescriptionForm";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<style>
    .table-responsive {
        border: 0px solid #ddd;
    }
</style>

<form>
    <div style="border-bottom:1px solid rgb(221, 221, 221);">
        <table class="form">
            <tr>
                <th class="formTitle">Số hồ sơ bệnh án:</th>
                <td class="formValue">
                    <input id="blh" name="blh" type="text" class="form-control" placeholder="Vui lòng nhập số hồ sơ bệnh án" />
                </td>
                <th class="formTitle">Họ tên:</th>
                <td class="formValue">
                    <input id="xm" name="xm" type="text" class="form-control" placeholder="Vui lòng nhập Họ tên" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Giờ bắt đầu:</th>
                <td class="formValue">
                    <input id="kssj" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("01/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                </td>
                <th class="formTitle">Giờ kết thúc:</th>
                <td  class="formValue">
                    <input id="jssj" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                </td>
                <td class="formValue">
                    <input type="button" id="btn_search" class="btn btn-primary" style="margin-left: 60px;" value="Tra cứu" />
                </td>
            </tr>
        </table>
    </div>
    <!--thông tin đơn thuốc Bao gồm số thẻ Số bệnh án Họ tên -->
    <div id="prediv" class="gridPanel" style="margin-top:1%; margin-left:1%">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>

<script>

    //cái trước đówindowđối tượng
    var prevWindow;

    var from = $.request("from");
    if (!!from) {
        prevWindow = top.top.frames[from];
    }
    else {
        prevWindow = $.currentWindow();
    }

    $(function () {
        var obj = new Object;
        obj.blh = $.request("blh");
        obj.kssj = $.request("kssj");
        obj.jssj = $.request("jssj");
        var searInfo = new preSearchInfo();
        //Nạp dữ liệu
        searInfo.init(obj);

        //Tra cứu
        $("#btn_search").click(function () {
            $("#gridList").jqGrid('setGridParam', {
                postData: { blh: $("#blh").val(), xm: $("#xm").val(), kssj: $("#kssj").val(), jssj: $("#jssj").val(), r: Math.random() },
            }).trigger('reloadGrid');
        });
    });

    var preSearchInfo = (function () {
        //Tải danh sách
        var loadGrid = function (data) {
            var $gridList = $("#gridList");
            $gridList.newtouchLocalDataGrid({
                height: $(window).height() - 200,
                //autowidth: false,
                //width: $("#prediv").width() - 2,
                //url: "///?"+ Math.random(),
                //postData: { blh: $("#blh").val(), xm: $("#xm").val() },
                caption: 'Danh sách đơn thuốc',
                unwritten: false,
                colModel: [
                    { label: 'Số đơn thuốc', name: 'cfh', width: 150, align: 'left' },
                    { label: 'Số tiền', name: 'je', width: 120, align: 'left' },
                    { label: 'Bác sĩ', name: 'ys', width: 100, align: 'left' },
                    { label: 'Thời gian lập', name: 'CreateTime', width: 120, align: 'left' }
                ],
                pager: "#gridPager",
                sortname: 'CreateTime desc',
                viewrecords: true
            });

            $("#gridList").newtouchLocalDataGrid(null, mydata);
        };

        var mydata = [
               {
                   cfh: 'R20170417170000323', je: '90.00', ys: 'Ngô Phiên', CreateTime: '2017-10-01 11:23:55'
               },
               {
                   cfh: 'R20170417180000324', je: '90.00', ys: 'Tưởng Triều Phượng', CreateTime: '2017-10-10 11:23:55'
               },
               {
                   cfh: 'R20170503140000325', je: '90.00', ys: 'Ninh Bình Phương', CreateTime: '2017-10-21 11:23:55'
               }
        ];
     
        var myPreSearchInfo = function (data) {

        }
        //Tải sự kiện
        myPreSearchInfo.prototype.init = function (data) {
            if (!!!data.blh) {
                $("#blh").val("");
            } else {
                $("#blh").val(data.blh);
            }
            if (!!!data.kssj) {
                $("#kssj").val("");
            } else {
                $("#kssj").val(data.kssj);
            }
            if (!!!data.jssj) {
                $("#jssj").val("");
            } else {
                $("#jssj").val(data.jssj);
            }

            loadGrid(data);
        };

        return myPreSearchInfo;
    }());

    //jqGrid Nhấp đúp để chọn một dòng
    function btn_edit() {
        PreSearchConfirm();
    }

    //xác nhận Gọi từ trang chính
    function PreSearchConfirm() {
        DbClickGrid();
    }

    //nhấn đúp
    function DbClickGrid() {
        var $gridList = $("#gridList");
        var patId = $gridList.jqGridRowValue().patId;
        var cfh = $gridList.jqGridRowValue().cfh;
        var obj = new Object();
        obj.patId = patId;
        obj.cfh = cfh;
        if (!!!obj.cfh) {
            $.modalMsg("Vui lòng chọn một Số đơn thuốc", "warning");
            return;
        }
        prevWindow.getPatInfoAjax(obj);

        //đóng cửa sổ
        ReceiptCancle();
    }

    //Hủy
    function ReceiptCancle() {
        $.modalClose();
    }


</script>





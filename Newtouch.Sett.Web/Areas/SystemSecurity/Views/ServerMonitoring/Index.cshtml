@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}
@*<script src="~/Content/js/echarts/echarts.js"></script>*@
@* QA-phase2 (SETT-08): echarts lives on the static host (js/echarts/),
   not under the app's wwwroot/Content — the old ~/Content paths 404'd,
   so `echarts` was never defined and no chart rendered. *@
<script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/echarts/echarts-all.js")"></script>
<script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/echarts/infographic.js")"></script>
<script>
    $(function () {
        loadGaugeIIS();
        loadGaugeCPU();
        loadGaugeRAM();
       loadChart();
    })
    function loadGaugeIIS() {
        var myChart = echarts.init(document.getElementById('maina'));
        option = {
            series: [
                {
                    name: 'Chỉ số nghiệp vụ',
                    type: 'gauge',
                    splitNumber: 10,       // Số đoạn chia,Mặc định là5
                    axisLine: {            // Đường trục tọa độ
                        lineStyle: {       // thuộc tínhlineStyleĐiều khiển kiểu đường kẻ
                            color: [[0.2, '#228b22'], [0.8, '#48b'], [1, '#ff4500']],
                            width: 10
                        }
                    },
                    axisTick: {            // Dấu nhỏ trục tọa độ
                        splitNumber: 10,   // Mỗi bảnsplitChia nhỏ thành mấy đoạn
                        length: 12,        // thuộc tínhlengthĐiều khiển độ dài đường kẻ
                        lineStyle: {       // thuộc tínhlineStyleĐiều khiển kiểu đường kẻ
                            color: 'auto'
                        }
                    },
                    axisLabel: {           // Nhãn văn bản trục tọa độ,Xem chi tiếtaxis.axisLabel
                        textStyle: {       // Các thuộc tính còn lại mặc định dùng kiểu văn bản toàn cục,Xem chi tiếtTEXTSTYLE
                            color: 'auto'
                        }
                    },
                    splitLine: {           // Đường phân cách
                        show: true,        // Hiển thị mặc định,thuộc tínhshowĐiều khiển hiển thị hay không
                        length: 30,         // thuộc tínhlengthĐiều khiển độ dài đường kẻ
                        lineStyle: {       // thuộc tínhlineStyle（Xem chi tiếtlineStyle）Điều khiển kiểu đường kẻ
                            color: 'auto'
                        }
                    },

                    detail: {
                        formatter: '{value}%',
                        textStyle: {       // Các thuộc tính còn lại mặc định dùng kiểu văn bản toàn cục,Xem chi tiếtTEXTSTYLE
                            color: 'auto',
                            fontWeight: 'bolder',
                            fontSize: 20
                        }
                    },
                    data: [{ value: 50 }]
                }
            ]
        };
        myChart.setOption(option);
    }
    function loadGaugeCPU() {
        var myChartCUP = echarts.init(document.getElementById('mainb'), infographicTheme());
        optionCUP = {
            series: [
                {
                    name: 'Chỉ số nghiệp vụ',
                    type: 'gauge',
                    splitNumber: 10,       // Số đoạn chia,Mặc định là5
                    axisLine: {            // Đường trục tọa độ
                        lineStyle: {       // thuộc tínhlineStyleĐiều khiển kiểu đường kẻ
                            color: [[0.2, '#228b22'], [0.8, '#48b'], [1, '#ff4500']],
                            width: 10
                        }
                    },
                    axisTick: {            // Dấu nhỏ trục tọa độ
                        splitNumber: 10,   // Mỗi bảnsplitChia nhỏ thành mấy đoạn
                        length: 12,        // thuộc tínhlengthĐiều khiển độ dài đường kẻ
                        lineStyle: {       // thuộc tínhlineStyleĐiều khiển kiểu đường kẻ
                            color: 'auto'
                        }
                    },
                    axisLabel: {           // Nhãn văn bản trục tọa độ,Xem chi tiếtaxis.axisLabel
                        textStyle: {       // Các thuộc tính còn lại mặc định dùng kiểu văn bản toàn cục,Xem chi tiếtTEXTSTYLE
                            color: 'auto'
                        }
                    },
                    splitLine: {           // Đường phân cách
                        show: true,        // Hiển thị mặc định,thuộc tínhshowĐiều khiển hiển thị hay không
                        length: 30,         // thuộc tínhlengthĐiều khiển độ dài đường kẻ
                        lineStyle: {       // thuộc tínhlineStyle（Xem chi tiếtlineStyle）Điều khiển kiểu đường kẻ
                            color: 'auto'
                        }
                    },

                    detail: {
                        formatter: '{value}%',
                        textStyle: {       // Các thuộc tính còn lại mặc định dùng kiểu văn bản toàn cục,Xem chi tiếtTEXTSTYLE
                            color: 'auto',
                            fontWeight: 'bolder',
                            fontSize: 20
                        }
                    },
                    data: [{ value: 50 }]
                }
            ]
        };
        myChartCUP.setOption(optionCUP);
        clearInterval(timeTicket);
        var timeTicket = setInterval(function () {
            optionCUP.series[0].data[0].value = (Math.random() * 100).toFixed(2) - 0;
            myChartCUP.setOption(optionCUP, true);
        }, 2000)
    }
    function loadGaugeRAM() {
        var myChart = echarts.init(document.getElementById('mainc'));
        option = {
            series: [
                {
                    name: 'Chỉ số nghiệp vụ',
                    type: 'gauge',
                    splitNumber: 10,       // Số đoạn chia,Mặc định là5
                    axisLine: {            // Đường trục tọa độ

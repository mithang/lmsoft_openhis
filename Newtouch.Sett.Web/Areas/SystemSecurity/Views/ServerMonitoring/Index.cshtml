                            color: [[0.2, '#228b22'], [0.8, '#48b'], [1, '#ff4500']],
                            width: 10
                        }
                    },
                    axisTick: {            // Dấu nhỏ trục tọa độ
                        splitNumber: 10,   // Mỗi bảnsplitChia nhỏ thành mấy đoạn
                        length: 12,        // thuộc tínhlengthĐiều khiển độ dài đường kẻ
                        lineStyle: {       // thuộc tínhlineStyleĐiều khiển kiểu đường kẻ
                            color: 'auto'
                        }
                    },
                    axisLabel: {           // Nhãn văn bản trục tọa độ,Xem chi tiếtaxis.axisLabel
                        textStyle: {       // Các thuộc tính còn lại mặc định dùng kiểu văn bản toàn cục,Xem chi tiếtTEXTSTYLE
                            color: 'auto'
                        }
                    },
                    splitLine: {           // Đường phân cách
                        show: true,        // Hiển thị mặc định,thuộc tínhshowĐiều khiển hiển thị hay không
                        length: 30,         // thuộc tínhlengthĐiều khiển độ dài đường kẻ
                        lineStyle: {       // thuộc tínhlineStyle（Xem chi tiếtlineStyle）Điều khiển kiểu đường kẻ
                            color: 'auto'
                        }
                    },

                    detail: {
                        formatter: '{value}%',
                        textStyle: {       // Các thuộc tính còn lại mặc định dùng kiểu văn bản toàn cục,Xem chi tiếtTEXTSTYLE
                            color: 'auto',
                            fontWeight: 'bolder',
                            fontSize: 20
                        }
                    },
                    data: [{ value: 50 }]
                }
            ]
        };
        myChart.setOption(option);
    }
    function loadChart() {
        var myChart = echarts.init(document.getElementById('maind'));
        option = {
            tooltip: {
                trigger: 'axis'
            },
            legend: {
                data: ['Tỷ lệ sử dụng IIS', 'Tỷ lệ sử dụng CPU', 'Tỷ lệ sử dụng RAM']
            },

            xAxis: {
                type: 'category',
                boundaryGap: false,
                data: ['Thứ hai', 'Thứ ba', 'Thứ tư', 'Thứ năm', 'Thứ sáu', 'Thứ bảy', 'Chủ nhật']
            },
            yAxis: {
                type: 'value'
            },
            series: [
                {
                    name: 'Tỷ lệ sử dụng IIS', type: 'line',
                    data: [1720, 8132, 2101, 3134, 490, 5230, 6210]
                },
                {
                    name: 'Tỷ lệ sử dụng CPU', type: 'line',
                    data: [2620, 4182, 5191, 4234, 2290, 1330, 9310]
                },
                {
                    name: 'Tỷ lệ sử dụng RAM', type: 'line',
                    data: [2320, 1822, 7791, 23344, 22790, 5530, 5110]
                }
            ]
        };

        myChart.setOption(option);
    }
</script>

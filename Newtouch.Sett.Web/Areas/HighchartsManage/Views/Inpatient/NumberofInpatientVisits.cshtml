
@{
    ViewBag.Title = "Nhập viện Số người xuất viện So sánh";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/highcharts/highcharts.js")"></script>
<script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/highcharts/modules/exporting.js")"></script>
<script>
    $(function () {
        loadChart();
    });

    function loadChart() {
        var OutpatientList = [];
        var InpatientList = [];
        $.ajax({
            url: "/HighchartsManage/Inpatient/GetInpatientVisitNum?r=" + Math.random(),
            dataType: "json",
            async: false,
            success: function (data) {
                if (data.data) {
                    OutpatientList = data.data.OutpatientList;
                    InpatientList = data.data.InpatientList
                } else {
                    for (var i = 0; i < 12; i++) {
                        OutpatientList.push([0]);
                        InpatientList.push([0]);
                    }
                }
            }
        })
        $('#salarychart').highcharts({
            chart: {
                type: 'column'
            },
            title: {
                text: 'Nhập viện Số người xuất viện So sánh'
            },
            xAxis: {
                categories: [
                    'một tháng',
                    'hai tháng',
                    'ba tháng',
                    'bốn tháng',
                    'năm tháng',
                    'sáu tháng',
                    'bảy tháng',
                    'tám tháng',
                    'chín tháng',
                    'mười tháng',
                    'mười một tháng',
                    'mười hai tháng'
                ]
            },
            yAxis: {
                title: {
                    text: 'Đơn vị (người)'
                }
            },
            tooltip: {
                headerFormat: '<span style="font-size:10px">{point.key}</span><table>',
                pointFormat: '<tr><td style="color:{series.color};padding:0">{series.name}: </td>' +
                '<td style="padding:0"><b>{point.y}người</b></td></tr>',
                footerFormat: '</table>',
                shared: true,
                useHTML: true
            },
            plotOptions: {
                column: {
                    pointPadding: 0.2,
                    borderWidth: 0
                }
            },
            series: [{
                name: "Thêm mới Số người",
                data: [
                        OutpatientList[0].num, OutpatientList[1].num, OutpatientList[2].num, OutpatientList[3].num, OutpatientList[4].num, OutpatientList[5].num, OutpatientList[6].num, OutpatientList[7].num, OutpatientList[8].num, OutpatientList[9].num, OutpatientList[10].num, OutpatientList[11].num
                ]
            }, {
                name: "Số người xuất viện",
                data: [
                           InpatientList[0].num, InpatientList[1].num, InpatientList[2].num, InpatientList[3].num, InpatientList[4].num, InpatientList[5].num, InpatientList[6].num, InpatientList[7].num, InpatientList[8].num, InpatientList[9].num, InpatientList[10].num, InpatientList[11].num
                ]
            }]
        });
    }
</script>
<div class="rows" style="margin-bottom: 1%; overflow: hidden;">
    <div style="float: left; width: 98%;">
        <div style="height: 500px;border: 1px solid #e6e6e6; background-color: #fff;">
            <div class="panel panel-default">
                <div class="panel-body" style="padding-bottom: 0px;">
                    <div id="salarychart" style="height: 500px; width: 100%; padding-right: 10px;"></div>
                </div>
            </div>
        </div>

    </div>
</div>
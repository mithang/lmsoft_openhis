@{
    ViewBag.Title = "ConfirmForm";
    Layout = "~/Views/Shared/_Form.cshtml";
    //nhập việnviệnkếttínhcó thểbằngdùngtrướcnộptiền
    var withYjj = SysConfigReader.Bool("InpatientSettWithAdvanceAccount");
    //
    var relatedFPH = SysConfigReader.Bool("Inpatient_SettPage_RelatedFPH");
    //Có vớiCPOElẫn nhauthôngnhậnmiệng
    var interfaceWithCPOE = SysConfigReader.Bool("HOSP_INTERFACE_WITH_CPOE", false).Value;
}

<div class="panel panel-default" style="margin-top:10px;width:560px;margin-left:10px">
    <div class="panel-heading navb-bg" style="height:13px;">
        Thu phí thông tin
    </div>
    <div style="height:auto;">
        <table class="form">
            <tr>
                <th class="formTitle">Số nhập viện：</th>
                <td class="formValue">
                    <label id="lblZyh"></label>
                </td>
                @if (relatedFPH == true)
                {
                    <th class="formTitle"><span style="color:red">*</span>Số hóa đơn：</th>
                    <td class="formValue">
                        <label id="txtfph"></label>
                        <div style="position:absolute;top:5px;right:20px;">
                            <input type="button" class="btn btn-default btn-md" style="margin-left:6px;" value="Chọn số hóa đơn" onclick="ShowInvoicePanel()" />
                        </div>
                    </td>
                }
                else
                {
                    <th class="formTitle"></th>
                    <td class="formValue"></td>
                }
            </tr>
            <tr>
                <th class="formTitle">Ngày nhập viện：</th>
                <td class="formValue">
                    <label id="lblRyrq"></label>
                </td>
                <th class="formTitle"><span style="color:red">*</span>Ngày xuất viện：</th>
                <td class="formValue">
                    <input id="cyrq" type="text" class="form-control  form-an input-wdatepicker" style="float: left; margin-left: 5px; width:90%" value="" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Số tiền phải thu：</th>
                <td class="formValue">
                    ￥<label id="yingshoukuan"></label>
                </td>
            </tr>
            <tr id="trYjjzf" style="display:none;">
                <th class="formTitle">Số dư tạm ứng：</th>
                <td class="formValue">
                    ￥<label id="yjjye"></label>
                </td>
                <td class="formValue">
                    <div class="ckbox">
                        <input id="ckyjjzfyeqt" type="checkbox"><label for="ckyjjzfyeqt">Hoàn toàn bộ số dư</label>
                    </div>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Phương thức thanh toán：</th>
                <td class="formValue">
                    <select id="zffs1" class="form-control  form-an" style="width:90%">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <th class="formTitle">Thu tiền：</th>
                <td class="formValue">
                    <input type="text" id="zfje1" class="form-control form-an" style="width:90%" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Phương thức thanh toán：</th>
                <td class="formValue">
                    <select id="zffs2" class="form-control form-an" style="width:90%">
                        <option value="">==Có thể chọn==</option>
                    </select>
                </td>
                <th class="formTitle">Thu tiền：</th>
                <td class="formValue">
                    <input type="text" id="zfje2" class="form-control form-an" style="width:90%" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Tổng số tiền thực thu：</th>
                <td class="formValue">￥<label id="hjssk">0.00</label></td>
            </tr>
            <tr>
                <th class="formTitle">Tiền thừa：</th>
                <td class="formValue">￥<label id="zhaoling">0.00</label></td>
            </tr>
        </table>
    </div>
</div>

<script>
    var zyh = $.request("zyh");
    var ryrq = $.request("ryrq");
    var cyrq = $.request("cyrq");
    if (!!cyrq) {
        cyrq = $.getDate({ date: cyrq });   //Định dạng
    }
    var interfaceWithCPOE = '@(interfaceWithCPOE)';
    //Số dư tạm ứng
    var yjjye = 0;
    var withYjj = '@(withYjj)';
    //kếttínhtổngtiềnmức
    var zje = parseFloat($.request("zje"));
    //thanh toán phải thu Khoản phải thu khi quyết toán（zje = Được BHYT chi trả + Khoản phải thu khi quyết toán + v.v.）
    var orglxjzfys = parseFloat($.request("xjzfys"));
    //Khi có chiết khấu thì không bằng original
    var xjzfys = orglxjzfys;    //khi có chiết khấu sẽ không bằng nhau

    $(function () {
        if (!!zyh) {
            $('#lblZyh').html(zyh);
        }
        if (!!ryrq) {
            $('#lblRyrq').html(ryrq);
        }
        if (!!cyrq) {
            $('#cyrq').val(cyrq);
            if (interfaceWithCPOE == 'True') {
                $('#cyrq').attr("disabled", "disabled");
            }
        }
        else {
            //Ngược lại mặc định gán ngày hôm nay
            $('#cyrq').val($.getDate());
        }

        if (!!xjzfys || xjzfys == 0) {
            $('#yingshoukuan').html(xjzfys.toFixed(2));
            $('#zfje1').val(xjzfys.toFixed(2));
            $('#hjssk').html(xjzfys.toFixed(2));
            $('#zhaoling').html('0.00');
        }

        if (withYjj == 'True') {
            $.najax({
                url: "/PatientManage/AccountManage/GetZhyeByPatid?patid=" + $.request("patid"),
                cache: false,
                async: false,
                alertbierror: false,
                success: function (zhyeData) {
                    if (zhyeData && zhyeData.data) {
                        yjjye = zhyeData.data;
                    }
                }
            });
        }

        if (yjjye) {
            $('#trYjjzf').show();
            $('#yjjye').html(parseFloat(yjjye).toFixed(2));
        }

        //Phương thức thanh toán tiền mặt1
        $("#zffs1").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                $.each(top.clients.SysForCashPayList, function (key, value) {
                    if (!yjjye && value.xjzffs == '3') {
                        return; //tài khoản hiện tại không có số dư tạm ứng，thì không hiển thị phương thức thanh toán này
                    }
                    var sele = false;
                    if (!!yjjye && yjjye >= xjzfys) {
                        if (value.xjzffs == '3') {
                            sele = true;
                        }
                    }
                    else if (value.xjzffsmc == "现金") {
                        sele = true;
                    }
                    if (sele) {
                        $('#zffs1').append('<option value="' + value.xjzffs + '" selected=true>' + value.xjzffsmc + '</option>');
                    }
                    else {
                        $('#zffs1').append('<option value="' + value.xjzffs + '">' + value.xjzffsmc + '</option>');
                    }
                });
                return resultObjArr;
            }
        });

        //Phương thức thanh toán tiền mặt2
        $("#zffs2").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                $.each(top.clients.SysForCashPayList, function (key, value) {
                    if (value.xjzffs == '3') {
                        return; //không hiển thị phương thức thanh toán này
                    }
                    $('#zffs2').append('<option value="' + value.xjzffs + '">' + value.xjzffsmc + '</option>');
                });
                return resultObjArr;
            }
        });

        $("#ckyjjzfyeqt").click(function () {
            if ($('#ckyjjzfyeqt').is(':checked')) {
                //phương thức thanh toán tạm ứng，‘Hoàn toàn bộ số dư’
                if (!!yjjye && yjjye >= xjzfys) {
                    //
                    $("#zffs1").val('3').trigger('change');
                    $('#zfje1').val(yjjye.toFixed(2));
                    //
                    $('#zfje2').val('').trigger('change');
                    //
                    hjsskZhaolingCal();
                }
            }
        });

        initFPH();
    });

    function AcceptClick(callBack) {
        //điềnviếtcủathuphíngàykỳ v.v.
        var obj = getPostData();
        if (obj) {
            $.najax({
                url: "/HospitalizationManage/DischargeSettle/SaveSettle",
                dataType: "json",
                data: { zyh: zyh, expectedcyrq: obj.cyrq, fph: obj.fph, feeRelated: obj },
                type: "POST",
                success: function (data) {
                    callBack();
                    $.modalAlert("Lưu thành công", 'success');
                    $.modalClose();
                }
            });
        }
    }

    function getPostData() {
        if (ryrq == "" || !ryrq) {
            $.modalAlert('Thiếu ngày nhập viện', 'warning');
            return false;
        }
        var cyrq = $('#cyrq').val();
        if (cyrq == "" || !cyrq) {
            $.modalAlert('Thiếu ngày xuất viện', 'warning');
            return false;
        }
        if (cyrq < ryrq) {
            $.modalAlert("Ngày xuất viện nhỏ hơn Ngày nhập viện,Vui lòng xác nhận。", 'warning');
            return;
        }
        if ($.getDate() < cyrq) {
            $.modalAlert('Ngày xuất viện Lỗi', 'warning');
            return false;
        }
        var fph = $('#txtfph').html();
        var zffs1 = $('#zffs1').val();
        !(!!zffs1 || zffs1 == '0') ? $('#zfje1').val('') : undefined;
        var zfje1 = $('#zfje1').val();
        zfje1 = (!!zffs1 || zffs1 == '0') && !!parseFloat(zfje1) ? parseFloat(zfje1) : 0;
        if (zffs1 == '3' && yjjye) {
            if (!(zfje1 == yjjye || zfje1 <= xjzfys)) {
                $.modalAlert("Số tiền thanh toán tài khoản tạm ứng bất thường", "error");
                return false;
            }
        }
        //
        var zffs2 = $('#zffs2').val();
        !(!!zffs2 || zffs2 == '0') ? $('#zfje2').val('') : undefined;
        var zfje2 = $('#zfje2').val();
        zfje2 = (!!zffs2 || zffs2 == '0') && !!parseFloat(zfje2) ? parseFloat(zfje2) : 0;
        //
        var hjssk = $('#hjssk').html();
        hjssk = !!parseFloat(hjssk) ? parseFloat(hjssk) : 0;
        var zhaoling = $('#zhaoling').html();
        zhaoling = !!parseFloat(zhaoling) ? parseFloat(zhaoling) : 0;
        //
        if ($('#txtfph').length == 0) {
            fph = null;
        }
        else {
            if (!fph) {
                $.modalAlert('Vui lòng chọn số hóa đơn', 'warning');
                return false;
            }
        }
        //
        if (hjssk != zfje1 + zfje2) {
            $.modalAlert("Số tiền thu bất thường", "error");
            return false;
        }
        if (hjssk != xjzfys + zhaoling || zhaoling < 0) {
            $.modalAlert("Số tiền thừa bất thường", "error");
            return false;
        }
        return {
            fph: fph, cyrq: cyrq
            , zffs1: zffs1, zfje1: zfje1, zffs2: zffs2, zfje2: zfje2
            , zje: zje, orglxjzfys: orglxjzfys, xjzfys: xjzfys
            , ssk: hjssk, zhaoling: zhaoling
        };
    }

    //common start

    //vào trang，Nạp số hóa đơn
    function initFPH() {
        if (!($("#txtfph").length == 1)) {
            return;
        }
        $.najax({
            url: "/OutpatientManage/OutpatientReg/GetInvoice?r=" + Math.random(),
            dataType: "text",
            cache: false,
            success: function (data) {
                $("#txtfph").html(data);
            }
        });
    }

    //Bật cửa sổ số hóa đơn
    function ShowInvoicePanel() {
        $.modalOpen({
            id: "InvoiceNoPanel",
            title: "Chọn số hóa đơn",
            url: "/OutpatientManage/OutpatientReg/ChooseInvoice?from=ConfirmFeeForm",
            width: "300px",
            height: "200px",
            callBack: function (iframeId) {
                top.frames[iframeId].checkFPH();//hàm gọi lại khi nhấn xác nhận trên cửa sổ
            }
        });
    }

    //
    $('#zfje1,#zfje2').keyup(function () {
        hjsskZhaolingCal();
        if ($('#ckyjjzfyeqt').is(':checked')) {
            $('#ckyjjzfyeqt').trigger('click');
        }
    });
    $('#zfje1,#zfje2').change(function () {
        hjsskZhaolingCal();
        if ($('#ckyjjzfyeqt').is(':checked')) {
            $('#ckyjjzfyeqt').trigger('click');
        }
    });

    //tính theo thanh toán phải thu、Phương thức thanh toán Tính tổng thực thu、Tiền thừa
    function hjsskZhaolingCal() {
        if (!$('#zffs1').val() && $('#zfje1').val() != 0) {
            //chưa chọn phương thức thanh toán，Số tiền tương ứng phải đặt thành0.00
            $('#zfje1').val('0.00');
        }
        var zfje1 = $('#zfje1').val();
        if (!zfje1) {
            zfje1 = '0.00';
        }
        if (!$('#zffs2').val() && $('#zfje2').val() != 0) {
            //chưa chọn phương thức thanh toán，Số tiền tương ứng phải đặt thành0.00
            $('#zfje2').val('0.00');
        }
        var zfje2 = $('#zfje2').val();
        if (!zfje2) {
            zfje2 = '0.00';
        }
        var hjssk = parseFloat(zfje1) + parseFloat(zfje2);  //tổng thực thu của nhiều phương thức thanh toán
        $('#hjssk').html(hjssk.toFixed(2));
        $('#zhaoling').html(parseFloat(hjssk - xjzfys).toFixed(2));
    }

    //common end
</script>
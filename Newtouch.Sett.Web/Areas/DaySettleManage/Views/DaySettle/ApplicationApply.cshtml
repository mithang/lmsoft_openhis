@using NewtouchHIS.Lib.Framework.Operator;

@{
	ViewBag.Title = "ApplicationApply";
	Layout = "~/Views/Shared/_Index.cshtml";
	var opr = OperatorProvider.GetCurrent();
}

<form name="form1">
	<div class="panel panel-default">
		<table class="form">
			<tr>
				<th class="formTitle" id="thCZRQ">Ngày quyết toán:</th>
				<td class="formValue" colspan="2">
					<input id="ksrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:20%; float:left;" value="@DateTime.Now.ToString("01/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
					<span style="margin-left:2%;float:left;">—</span>
					<input id="jsrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width :20%;float:left;margin-left:2%;" value="@DateTime.Now.ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />

					<text style="margin-left:2%">Có hay không khác địa phương:</text>
					<text></text>
					<input type="radio" name="sfyd" value="Không" checked />
					<label>Cục bộ</label>
					<input type="radio" name="sfyd" value="Có" />
					<label>khác địa phương</label>
					<input type="button" id="btn_tj" class="btn btn-primary btn-md" style="margin-right:10px;width:40px;" value="Thống kê" />
					<input type="button" id="btn_sq" class="btn btn-primary btn-md" style="margin-right:10px;width:40px;" value="Đăng ký" />
					@*<input type="button" id="btn_gb" class="btn btn-primary btn-md" style="margin-right:10px;width:80px;" value="Đề nghị hủy bỏ" />*@
				</td>
				<td class="formValue"></td>
			</tr>
		</table>
	</div>



	<div style="background-color: #fff;">
		<table id="gridJSList"></table>
	</div>
	<div style="background-color: #fff; margin-top:5px;">
		<table id="gridJSMXList"></table>
	</div>
	<div class="gridPanel">
		<table id="gridJSList"></table>
		<div id="gridPager"></div>
	</div>



	@* đáybộbảngđịnh dạng *@
	<div style="background-color: #fff;">
		<table id="gridJSList1"></table>
	</div>
	<div style="background-color: #fff; margin-top:5px;">
		<table id="gridJSMXList1"></table>
	</div>
	<div class="gridPanel">
		<table id="gridJSList1"></table>
		<div id="gridPager1"></div>
	</div>



</form>


<script>
    $(function () {
        //Nạp lại khi thay đổi kích thước cửa sổ trình duyệtjqGridChiều rộng
        $(window).resize(function () {
            initLayout("MyTabGrid");
        });

        gridJSListData();

    });

    function gridJSListData() {
        var gridSort = 'CreateTime asc';
        var $gridJsList = $("#gridJSList");
        $gridJsList.dataGrid({
            //postData: getSearchPostData(),
            height: 500,
            url: "",
            colModel: [
				{
					label: 'Trạng thái đăng ký', name: 'sqzt', width: 100, align: 'left', formatter: function (val, a, b) {
						if (val == "1") {
							return "Đã Đăng ký"
						} else {
							return "Chưa Đăng ký"
						}
					} },
				{ label: 'Loại quyết toán', name: 'qslb', hidden: true, align: 'left' },
				{ label: 'Loại quyết toán', name: 'qslbmc', width: 100, align: 'left' },
                { label: 'Loại bảo hiểm Loại', name: 'xzlx', width: 100, align: 'left' },
                { label: 'Có hay không khác địa phương', name: 'sfyd', width: 100, align: 'left' },
				{ label: 'Ngày bắt đầu', name: 'ksrq', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
				{ label: 'Ngày kết thúc', name: 'jsrq', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Tổng chi phí', name: 'zfy', width: 100, align: 'left' },
                { label: 'Tổng số tiền quỹ thanh toán', name: 'jjzfze', width: 100, align: 'left' },
                { label: 'Thanh toán tài khoản cá nhân', name: 'gzzf', width: 100, align: 'left' },
                { label: 'Tổng chi phí được BHYT công nhận', name: 'ybrkfyze', width: 100, align: 'left' },
                { label: 'Tổng số tiền mặt thanh toán', name: 'xjzfze', width: 100, align: 'left' },
                { label: 'Quyết toán lượt người', name: 'qsrc', width: 100, align: 'left' },
                { label: 'Năm tháng quyết toán', name: 'qsny', width: 100, align: 'left' },
                { label: 'Số tiền khai báo ngoại trú', name: 'mzsbje', width: 100, align: 'left' },
                { label: 'Số tiền khai báo nội trú', name: 'zysbje', width: 100, align: 'left' },
				{ label: 'Quỹ chung bảo hiểm y tế cơ bản cho người lao động thành thị', name: 'czzgtcjj', width: 100, align: 'left' },
				{ label: 'Quỹ tài khoản cá nhân bảo hiểm y tế cơ bản cho người lao động thành thị', name: 'czzgzhjj', width: 100, align: 'left' },
				{ label: 'Quỹ trợ cấp y tế công chức', name: 'gywbzjj', width: 100, align: 'left' },
				{ label: 'Quỹ trợ cấp chi phí y tế lớn', name: 'deylbzjj', width: 100, align: 'left' },
				{ label: 'Quỹ bảo đảm y tế cho cán bộ nghỉ hưu', name: 'lxrybzjj', width: 100, align: 'left' },
				{ label: 'Quỹ trợ cấp y tế cho quân nhân khuyết tật cấp 1 đến 6', name: 'cjbzjj', width: 100, align: 'left' },
				{ label: 'Quỹ bảo hiểm y tế bổ sung doanh nghiệp', name: 'qybzyljj', width: 100, align: 'left' },
				{ label: 'Quỹ bảo hiểm y tế cơ bản cho cư dân thành thị và nông thôn', name: 'cxjmjbyljj', width: 100, align: 'left' },
				{ label: 'Quỹ bảo hiểm y tế bệnh nặng cho cư dân thành thị và nông thôn', name: 'cxjmdbyljj', width: 100, align: 'left' },
				{ label: 'Quỹ cứu trợ y tế', name: 'yljzjj', width: 100, align: 'left' },
            ],
            //pager: "#gridPager",
            //sortname: gridSort,
			viewrecords: true,
			footerrow: true,
			userDataOnFooter: true,
			loadComplete: function () {

				var gridData = $("#gridJSList").jqGrid('getGridParam', 'data');

				$("#gridJSList").jqGrid('footerData', 'set', { name: "count", count: gridData.length });

			},
            onSelectRow_page: function (rowid) {
                //console.log(rowid);
            },
            gridComplete: function (gridJszbList) {
                //jszbList = null;
                //if (gridJszbList && gridJszbList.rows) {
                //    jszbList = gridJszbList.rows;
                //}
            }
        });

        //Sự kiện tra cứu
        $("#btn_tj").click(function () {
			$('#gridJSList').jqGrid("clearGridData");//xóa chi tiết trước
            $gridJsList.jqGrid('setGridParam', {
				postData: { ksrq: $("#ksrq").val(), jsrq: $("#jsrq").val(), sfyd: $('input:radio[name="sfyd"]:checked').val() },
                url: '/MedicalInsuranceLiquidation/LiquidationApplication/GetQssq',
                //page: 1,
            }).trigger('reloadGrid');
        });
	}

	$("#btn_sq").click(function () {

		var seleRowid = $("#gridJSList").jqGrid("getGridParam", "selrow");
		if (!(seleRowid)) {
			$.modalAlert("Vui lòng chọn một dòng thông tin", 'warning');
			return;
		}

		var rowData = $("#gridJSList").jqGrid('getRowData', seleRowid);
		var ksrq = $("#ksrq").val();
		var jsrq = $("#jsrq").val();

		var predata = {
			hisId: "0",
			operatorId: '@(opr.rygh)',
			operatorName:'@(opr.UserName)',
			clr_type: rowData.qslb,
			clr_way: "",
			setlym: rowData.qsny,
			psntime: rowData.qsrc,
			medfee_sumamt: rowData.zfy,
			med_sumfee: rowData.ybrkfyze,
			fund_appy_sum: rowData.jjzfze,
			cash_payamt: rowData.xjzfze,
			acct_pay: rowData.gzzf,
			begndate: ksrq,
			enddate: jsrq,
			sfyd: rowData.sfyd
		};

		$.ajax({
			type: "POST",
			url: "http://127.0.0.1:33333/api/YiBao/ReconciliationDetail_3203",
			data: predata,
			dataType: "json",
			async: false,
			success: function (data) {
				var refinfo = eval('(' + data + ')');
				console.log(refinfo);
				if (refinfo.infcode == "0") {
					$.modalAlert("Gửi quyết toán thành công!", 'warning');
					$("#btn_tj").click();
				} else {
					$.modalAlert(refinfo.err_msg,'warning');
				}

			}
		});
	});



</script>
@using NewtouchHIS.Lib.Framework.Operator;

@{
	ViewBag.Title = "ApplicationFallbackIndex";
	Layout = "~/Views/Shared/_Index.cshtml";
	var opr = OperatorProvider.GetCurrent();
}

<form name="form1">
	<div class="panel panel-default">
		<table class="form">
			<tr>
				<th class="formTitle" id="thCZRQ">Ngày quyết toán:</th>
				<td class="formValue" colspan="2">
					<input id="ksrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:20%; float:left;" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
					<span style="margin-left:2%;float:left;">—</span>
					<input id="jsrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width :20%;float:left;margin-left:2%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
					<text style="margin-left:2%;color:cornflowerblue">Nhắc nhở: thống kê theo ngày quyết toán!</text>
					<input type="button" id="btn_search_cx" class="btn btn-primary btn-md" style="margin-left:10px;width:40px;" value="Tra cứu" />
					<input type="button" id="btn_search_td" class="btn btn-primary btn-md" style="margin-left:10px;width:50px;" value="Hủy quyết toán" />
					@*<input type="button" id="btn_search_gb" class="btn btn-primary btn-md" style="margin-left:10px;width:60px;" value="Đóng" />*@
				</td>
				<td class="formValue"></td>
			</tr>
		</table>
	</div>
	<div style="background-color: #fff;">
		<table id="gridJSList"></table>
	</div>
	<div style="background-color: #fff; margin-top:5px;">
		<table id="gridJSMXList"></table>
	</div>
	<div class="gridPanel">
		<table id="gridJSList"></table>
		<div id="gridPager"></div>
	</div>


</form>

<script>
    $(function () {
        //Nạp lại khi thay đổi kích thước cửa sổ trình duyệtjqGridChiều rộng
        $(window).resize(function () {
            initLayout("MyTabGrid");
        });

        //Bản ghi chính quyết toán
        gridJSListData();
    });

    function gridJSListData() {
        var gridSort = 'CreateTime asc';
        var $gridJsList = $("#gridJSList");
        $gridJsList.dataGrid({
            //postData: getSearchPostData(),
            height: 500,
            url: "",
            colModel: [
                { label: 'Số kỳ quyết toán', name: 'qsqh', width: 100, align: 'left' },
                { label: 'Loại quyết toán', name: 'qslb', width: 100, align: 'left' },
                { label: 'Tên loại quyết toán', name: 'qslbmc', width: 100, align: 'left' },
                { label: 'Loại bảo hiểm Loại', name: 'xzlx', width: 100, align: 'left' },
                { label: 'Có hay không khác địa phương', name: 'sfyd', width: 100, align: 'left' },
                { label: 'Số giao dịch quyết toán', name: 'qslsh', width: 100, align: 'left' },
                { label: 'Tổng chi phí', name: 'zfy', width: 100, align: 'left' },
                { label: 'Tổng số tiền khai báo quỹ', name: 'jjsbze', width: 100, align: 'left' },
                { label: 'Tổng số tiền thanh toán tài khoản cá nhân', name: 'gzzfze', width: 100, align: 'left' },
                { label: 'Tổng số tiền mặt cá nhân thanh toán', name: 'grxjzfze', width: 100, align: 'left' },
                { label: 'Quyết toán lượt người', name: 'qsrc', width: 100, align: 'left' },
                { label: 'Ngày bắt đầu', name: 'ksrq', width: 100, align: 'left' },
                { label: 'Kết thúc như kỳ', name: 'jsrq', width: 100, align: 'left' },
                { label: 'Ngày đăng ký quyết toán', name: 'qssqrq', width: 100, align: 'left' },
                { label: 'Người đăng ký quyết toán', name: 'qssqr', width: 100, align: 'left' },
                { label: 'Cơ sở y tế Mã', name: 'yljgdm', width: 100, align: 'left' },
                { label: 'Cơ sở y tế Tên', name: 'yljgmc', width: 100, align: 'left' },
                { label: 'Tên cơ quan thực hiện quyết toán', name: 'qsjbjgmc', width: 100, align: 'left' },
                { label: 'Mã cơ quan thực hiện quyết toán', name: 'qsjbjgbm', width: 100, align: 'left' },
                { label: 'Ngoại trú lượt người', name: 'mzrc', width: 100, align: 'left' },
                { label: 'Nhập viện lượt người', name: 'zyrc', width: 100, align: 'left' },
                { label: 'Ngoại trú Tổng chi phí', name: 'mzzfy', width: 100, align: 'left' },
                { label: 'Nhập viện Tổng chi phí', name: 'zyzfy', width: 100, align: 'left' },
                { label: 'Số tiền khai báo ngoại trú', name: 'mzsbje', width: 100, align: 'left' },
                { label: 'Số tiền khai báo nội trú', name: 'zysbje', width: 100, align: 'left' },
				{ label: 'Quỹ chung bảo hiểm y tế cơ bản cho người lao động thành thị', name: 'czzgtcjj',   align: 'left' },
				{ label: 'Quỹ chung bảo hiểm y tế cơ bản cho người lao động thành thị lượt người', name: 'czzgtcjjrc',   align: 'left' },
				{ label: 'Quỹ tài khoản cá nhân bảo hiểm y tế cơ bản cho người lao động thành thị', name: 'czzgzhjj',   align: 'left' },
				{ label: 'Quỹ tài khoản cá nhân bảo hiểm y tế cơ bản cho người lao động thành thị lượt người', name: 'czzgzhjjrc',   align: 'left' },
				{ label: 'Quỹ trợ cấp y tế công chức', name: 'gywbzjj',   align: 'left' },
				{ label: 'Quỹ trợ cấp y tế công chức lượt người', name: 'gywbzjjrc',   align: 'left' },
				{ label: 'Quỹ trợ cấp chi phí y tế lớn', name: 'deylbzjj',   align: 'left' },
				{ label: 'Quỹ trợ cấp chi phí y tế lớn lượt người', name: 'deylbzjjrc',   align: 'left' },
				{ label: 'Quỹ bảo đảm y tế cho cán bộ nghỉ hưu', name: 'lxrybzjj',   align: 'left' },
				{ label: 'Quỹ bảo đảm y tế cho cán bộ nghỉ hưu lượt người', name: 'lxrybzjjrc',   align: 'left' },
				{ label: 'Quỹ trợ cấp y tế cho quân nhân khuyết tật cấp 1 đến 6', name: 'cjbzjj',   align: 'left' },
				{ label: 'Quỹ trợ cấp y tế cho quân nhân khuyết tật cấp 1 đến 6lượt người', name: 'cjbzjjrc',   align: 'left' },
				{ label: 'Quỹ bảo hiểm y tế bổ sung doanh nghiệp', name: 'qybzyljj',   align: 'left' },
				{ label: 'Quỹ bảo hiểm y tế bổ sung doanh nghiệp lượt người', name: 'qybzyljjrc',   align: 'left' },
				{ label: 'Quỹ bảo hiểm y tế cơ bản cho cư dân thành thị và nông thôn', name: 'cxjmjbyljj',   align: 'left' },
				{ label: 'Quỹ bảo hiểm y tế cơ bản cho cư dân thành thị và nông thôn lượt người', name: 'cxjmjbyljjrc',   align: 'left' },
				{ label: 'Quỹ bảo hiểm y tế bệnh nặng cho cư dân thành thị và nông thôn', name: 'cxjmdbyljj',   align: 'left' },
				{ label: 'Quỹ bảo hiểm y tế bệnh nặng cho cư dân thành thị và nông thôn lượt người', name: 'cxjmdbyljjrc',   align: 'left' },
				{ label: 'Quỹ ưu đãi', name: 'yfjj',   align: 'left' },
				{ label: 'Quỹ ưu đãi lượt người', name: 'yfjjrc',   align: 'left' },
				{ label: 'Quỹ sinh sản', name: 'syjj',   align: 'left' },
				{ label: 'Quỹ sinh sản lượt người', name: 'syjjrc',   align: 'left' },
				{ label: 'Quỹ khác', name: 'qtjj',   align: 'left' },
				{ label: 'Quỹ khác lượt người', name: 'qtjjrc',   align: 'left' },
				{ label: 'Quỹ Nhị Ất', name: 'eyjj',   align: 'left' },
				{ label: 'Quỹ Nhị Ất lượt người', name: 'eyjjrc',   align: 'left' },
                { label: 'Tổng các quỹ', name: 'gxjjzh', width: 100, align: 'left' },
            ],
            //pager: "#gridPager",
            //sortname: gridSort,
            viewrecords: true,
            onSelectRow_page: function (rowid) {
                console.log(rowid);
            },
            gridComplete: function (gridJszbList) {
                //jszbList = null;
                //if (gridJszbList && gridJszbList.rows) {
                //    jszbList = gridJszbList.rows;
                //}
            }
        });

        //Sự kiện tra cứu
        $("#btn_search_cx").click(function () {
			$('#gridJSList').jqGrid("clearGridData");//xóa chi tiết trước
            $gridJsList.jqGrid('setGridParam', {
                postData: { ksrq: $("#ksrq").val(), jsrq: $("#jsrq").val() },
                url: '/MedicalInsuranceLiquidation/LiquidationApplication/GetQsht',
                //page: 1,
            }).trigger('reloadGrid');
        });
	}


	$("#btn_search_td").click(function() {
		var seleRowid = $("#gridJSList").jqGrid("getGridParam", "selrow");
		if (!(seleRowid)) {
			$.modalAlert("Vui lòng chọn một dòng thông tin", 'warning');
			return;
		}

		var rowData = $("#gridJSList").jqGrid('getRowData', seleRowid);
		var ksrq = $("#ksrq").val();
		var jsrq = $("#jsrq").val();

		var predata = {
			hisId: "0",
			operatorId: '@(opr.rygh)',
			operatorName:'@(opr.UserName)',
			clr_type: rowData.qslb,
			clr_way: "",
			setlym: 0,
			psntime: "",
			medfee_sumamt: 0 ,
			med_sumfee: 0,
			fund_appy_sum: 0,
			cash_payamt: 0,
			acct_pay: 0,
			begndate: ksrq,
			enddate: jsrq,
			sfyd: "",
			clr_appy_evt_id: rowData.qslsh
		};

		$.ajax({
			type: "POST",
			url: "http://127.0.0.1:33333/api/YiBao/ReconciliationDetail_3204",
			data: predata,
			dataType: "json",
			async: false,
			success: function (data) {
				var refinfo = eval('(' + data + ')');
				console.log(refinfo);
				if (refinfo.infcode == "0") {
					$.modalAlert("hoàn đơn Thành công！".err_msg, 'warning');
					$("#btn_search_cx").click();
				} else {
					$.modalAlert(refinfo.err_msg, 'warning');
				}

			}
		});
	});

</script>
    function histoshanghaiybjzlx(jzpzlx)
    {
        if (jzpzlx=="0") {//thẻ từ
            return "0";
        }
        if (jzpzlx == "2") {//thẻ bảo đảm
            return "1";
        }
        if (jzpzlx == "3") {//chứng từ điện tử
            return "3";
        }
        if (jzpzlx == "4") {//CMND/CCCD
            return "2";
        }
        return "";
    }
    function shanghaiV5(regInfo)
    {
        setTimeout(function() {
            if (!MxscHisData()) {
                return;
            }
            $.loading(true, 'Đang quyết toán BHYT,Vui lòng chờ...');
            setTimeout(function () {
                var jsstate = true;

                shanghaiV5Ghjs(regInfo);
                if (MZJS.ybjyFeeReturn == null) {
                    jsstate = false;
                }
                if (!jsstate) {
                    var errMsg = "<p>" + MZJS.msg + "</p>";
                    $.loading(false);
                    if (errMsg.length > 0) {
                        $.modalAlert(errMsg, 'error');
                    }
                    return;

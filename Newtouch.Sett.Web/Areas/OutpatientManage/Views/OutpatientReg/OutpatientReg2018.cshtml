<div style="margin-top:40px;">
    <div class="gridPanel">
        <table id="registedList"></table>
    </div>
</div>
<script lang="javascript">
    var openYbSett = '@openYbSett' === 'True'; //cấu hình công tắc:bệnh nhân BHYT có dùng quy trình giao dịch BHYT không
    var ybSettOnce = '@ybSettOnce' === 'True'; //cấu hình công tắc:bệnh nhân BHYT có quyết toán một lần không
    var openCSReport = '@openCSReport';
    var IsOpenPdjhxt = '@IsOpenPdjhxt';
    var IsOpenSfzYbJz='@IsOpenSfzYbJz';
    var IsOpenybghjs='@IsOpenybghjs'; //sau đăng ký khám BHYT có tiếp tục giao dịch BHYT không
    var isYbjyjz; //lần khám hiện tại có đi theo giao dịch BHYT không
    var isAppointment=false; //có phải hẹn đăng ký khám không
    var yyGhpbid=null;//hẹn đăng ký khám
    var fyyGhpbId=null;//đăng ký khám không hẹn trước
    var QueueNo=null;//số thứ tự hẹn
    var OutDate=null;//ngày khám theo hẹn
    var dqyyks=null;//khoa đã hẹn đăng ký khám
    var readcardIframe = $.request("readcard");
    var OrgXzhq="@ViewBag.Xzqh"; //mã phân vùng tính chất khu vực nơi cơ quan đặt trụ sở xác định có dùng khác địa phương không
    newtouch_globalconfig.f4opions = { justinner: true };

    $(function () {
        if(readcardIframe)
        {
            $("#readCard").hide();
        }

        //khung nổi bệnh nhân
        $('#blh').newtouchBatchFloatingSelector({
            width: 500,
            height: 200,
            caption: "Chọn bệnh nhân",
            minlength: 1,
            url: "@Url.Action("PatSearchInfo")",
            ajaxparameters: function ($thisinput) {
                var keyword = $thisinput.val().trim();
                return "keyword=" + keyword;
            },
            itemdbclickhandler: function ($thistr, $thisinput) {
                GetQueryFphAjax({ blh: $thistr.attr('data-blh') });
            },
            colModel: [
                { label: 'Khóa chính', name: 'patid', hidden: true },
                { label: 'Số hồ sơ bệnh án', name: 'blh', width: 130, align: 'center' },
                { label: 'Họ tên', name: 'xm', width: 120, align: 'center' },
                { label: 'Năm sinh', name: 'csny', hidden: true, width: 100, align: 'center' },
                {
                    label: 'Giới tính', name: 'xb', width: 70, align: 'center', formatter: function (cellvalue) {
                        return $.getGender(cellvalue);
                    }
                },
                {
                    label: 'Tuổi', name: 'nlshow', width: 100, align: 'center', formatter: function (cellvalue, a, b) {
                        return getAgeFromBirthTime({ begin: b.csny }).text;
                    }
                },
                { label: 'brly', name: 'brly', hidden: true },
                { label: 'zjh', name: 'zjh', hidden: true },
                { label: 'kh', name: 'kh', hidden: true },
                { label: 'zjlx', name: 'zjlx', hidden: true },
                { label: 'sycs', name: 'sycs', hidden: true },
                { label: 'lxr', name: 'lxr', hidden: true },
                { label: 'lxrgx', name: 'lxrgx', hidden: true },
                { label: 'lxrdh', name: 'lxrdh', hidden: true },
            ]
        });

        //tính chất chi phí
        $("#brxzmc").newtouchBatchFloatingSelector({
            height: 250,
            width: 400,
            clickautotrigger: true,
            filter: function (keyword) {
                debugger
                //duyệtdữ liệunguồn,dùngkeywordđể lọc rakết quả
                var resultObjArr = new Array();
                $.each(top.window.clients.sysPatientNatureList, function (idx, val) {
                    resultObjArr.push(val);
                });
                return resultObjArr;
            },
            caption: "Tính chất chi phí",
            colModel: [
                { label: 'Mã số', name: 'brxzbh', widthratio: 25 },
                { label: 'Mã', name: 'brxz', widthratio: 25 },
                { label: 'Tên', name: 'brxzmc', widthratio: 25 },
                { label:'brxzlb',name:'brxzlb',hidden:true},
                { label: 'Phiên âm', name: 'py', widthratio: 25 }
            ],
            itemdbclickhandler: function ($thistr) {
                if (patModel && patModel.patid) {
                    $("#brxzmc").attr("data-brxzmc", $thistr.attr('data-brxzmc'))
                        .attr("data-brxz", $thistr.attr('data-brxz')).attr("data-brxzlb", $thistr.attr('data-brxzlb'));
                    $("#brxzmc").val($thistr.attr('data-brxzmc'));

                    //hss 2019.7.19 khi cùng một bệnh nhân tồn tại nhiều loại giao dịch,theo chính sách hoàn trảtảisố thẻ
                    $.ajax({
                        type: "POST",
                        url: "/PatientManage/HospiterRes/GetkhInfoBybrxz",
                        data: { patid: $('#patid').val(), brxz: $("#brxzmc").attr("data-brxz") },
                        dataType: "json",
                        async: false,
                        success: function (r) {
                            if (!!r.data && !!r.data.CardNo) {
                                $("#CardTypeName").html('(' + r.data.CardTypeName + ')');
                                $("#kh").html(r.data.CardNo);
                            }
                        }
                    });
                    return;
                }
                else {
                    $("#brxzmc").attr("data-brxzmc", '').attr("data-brxz", '');
                    $("#brxzmc").val('');
                    $.modalAlert("Chưa chọn bệnh nhân", "warning");
                }
            }
        });

        $('#sel_mzlx').bindSelect();

        //khởi tạo hộp thả xuống lý do khám mặc địnhthườngđã chọntrạng thái
        $('#jzyy').itemDetailsBindSelect({ itemtype: 'MedicalVisitReason' });
        var jzyydefaultSelVal = null;
        $.each($('#jzyy option'), function () {
            if ($(this).text() == 'Thường') {
                jzyydefaultSelVal = $(this).attr('value');
            }
        });
        if (jzyydefaultSelVal) {
            $('#jzyy').val(jzyydefaultSelVal).trigger('change');
        }

        //khoa
        $("#txtkschoose").newtouchBatchFloatingSelector({
            height: 200,
            width: 300,
            clickautotrigger: true,
            filter: function (keyword) {
                //duyệtdữ liệunguồn,dùngkeywordđể lọc rakết quả
                var resultObjArr = new Array();
                $.each(top.window.clients.sysDepartList, function (idx, val) {
                    if (((val.py && val.py.toLowerCase().indexOf(keyword) >= 0)
                        || (val.Name && val.Name.indexOf(keyword) >= 0)
                        || keyword.trim() == "") && (val.zlks == "1" || val.zlks == undefined || val.zlks == null)) {
                       resultObjArr.push(val);
                    }
                });
                return resultObjArr;
            },
            caption: "Khoa",
            colModel: [
                { label: 'Mã số', name: 'Code', widthratio: 30 },
                { label: 'Tên', name: 'Name', widthratio: 50 },
                { label: 'Phiên âm', name: 'py', hidden: true }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#txtkschoose").attr("data-label", $thistr.find("td:eq(0)").html());
                $("#txtkschoose").val($thistr.find('td:eq(1)').html());
                return;
            },
        });
        gridList();
    });



    function gridList() {
        var $gridList = $("#registedList");
        $gridList.dataGrid({
            url: "/OutpatientManage/OutpatientReg/GetCurrentDayRegListJson",
            height: $(window).height() - 345,
            caption: 'Đã đăng ký khám trong ngày',
            postData: {},
            colModel: [
                { label: 'ghnm', name: 'ghnm', key: true, hidden: true },
                { label: 'Khoa', name: 'ksmc', width: 60, align: 'left' },
                { label: 'Bác sĩ', name: 'ysmc', width: 50, align: 'left' },
                { label: 'Số hồ sơ bệnh án', name: 'blh', width: 80, align: 'left' },
                { label: 'Số khám ngoại trú', name: 'mzh', width: 100, align: 'left' },
                { label: 'Họ tên', name: 'xm', width: 50, align: 'left' },
                { label: 'Số giấy tờ', name: 'zjh', width: 130, align: 'left' },
                {
                    label: 'Giới tính', name: 'xb', width: 40, align: 'left',
                    formatter: function (val) {
                        return $.getGender(val);
                    }
                },
                {
                    label: 'Đăng ký khámTrạng thái', name: 'ghzt', width: 60, align: 'left',
                    formatter: function (val) {
                        if (val == '0') {
                            return 'Chờ quyết toán';
                        }
                        else if (val == '1') {
                            return 'Đã quyết toán';
                        }
                        else if (val == '2') {
                            return 'Đã hoàn';
                        }
                        else {
                            return '';
                        }
                    }
                },
                {
                    label: 'khámTrạng thái', name: 'jzbz', width: 60, align: 'left',
                    formatter: function (cellvalue, options, rowObject) {
                        if (rowObject.ghzt=="2") {
                            return 'Đã hủy số';
                        }
                        return $.enum.getDescByValue("EnumOutpatientJzbz", cellvalue);
                    }
                },
                { label: 'Tính chất chi phí', name: 'brxzmc', width: 80, align: 'left' },
                { label: 'Đầu tiênChẩn đoán', name: 'zdmc', width: 100, align: 'left' },
                {
                    label: 'Ngày đăng ký khám', name: 'ghrq', width: 100, align: 'left',
                    formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' }
                },
                {
                    label: 'Thời gian thao tác đăng ký khám', name: 'CreateTime', width: 120, align: 'left',
                    formatter: "date", formatoptions: { srcformat: 'Y-m-d h:i:s', newformat: 'Y-m-d H:i:s' }
                },
                { label: 'Số thứ tự khám', name: 'jzxh', width: 80, align: 'left' },
            ],
        });
        window.reloadGrid = function () {
            $gridList.jqGrid('setGridParam', {
                postData: {},
            }).trigger('reloadGrid');
        };
    }

    //đăng ký miễn thẻ/tạo mới
    function btn_NocardRes(t) {
        if(t!=null&&t===1)
        {
            localStorage.removeItem("patientform");
        }
        $.modalOpen({
                id: "Form",
            title: "Làm thẻ thông hành",
            url: "/PatientManage/HospiterRes/PatientBasic?T=" + new Date()+"&readbz="+t,
            width: "1050px",
            height: "450px",
            callBack: function (iframeId) {
                //top.frames[iframeId].submitForm();
                $.currentWindow(iframeId).AcceptClick(function (obj){
                    if(obj.CardType==='2')
                    {
                        if(IsOpenSfzYbJz!=="ON")
                        {
                            $.modalAlert("Chưa bật cấu hình động khám theo CMND khi BHYT tắt!", 'warning');
                            $.modalClose("Form");
                            return;
                        }
                        //CMND/CCCDgọiBHYTgiao diện
                        //...
                    }
                    GetQueryFphAjax(obj);
                    $.modalClose("Form");
                });
                }
            });
        }

    //bật tra cứu bệnh nhân
    function GetPatSerarchView(blh) {
        $.modalOpen({
            id: "patSearch",
            title: "Tra cứu bệnh nhân",
            url: "/OutpatientManage/OutpatientAccounting/SysPatEntitiesblhView?t=" + Math.random() + "&blh=" + blh,
            width: "700px",
            height: "600px",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //trong sự kiện cửa sổ bật lên
            }
        });
    }


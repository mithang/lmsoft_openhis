    function getRegInfo() {
        var regInfo = {};
        regInfo.patid = $("#patid").val();
        if (!regInfo.patid) {
            $.modalAlert("Vui lòng chọn trước thông tin bệnh nhân", 'warning');
            return false;
        }
        regInfo.kh = $("#kh").html();
        if (!regInfo.kh) {
            $.modalAlert("Thiếu thông tin số thẻ", 'warning');
            return false;
        }
        regInfo.brxz = $('#brxzmc').attr('data-brxz');
        regInfo.brxzmc = $('#brxzmc').attr('data-brxzmc');
        regInfo.brxzlb = $('#brxzmc').attr('data-brxzlb');
        if (!(!!regInfo.brxz || regInfo.brxz == '0')) {
            $.modalAlert("Thiếu tính chất chi phí", 'warning');
            return false;
        }
        //xác định chọn tính chất chi phí
        //tự chi trả không điBHYT
        //BHYTtự chi trả điBHYT  //BHYTbệnh nhân có thẻ cũng có thể chọn‘tự chi trả’
        if (patModel.brxz !== regInfo.brxz && regInfo.brxzlb != '0' && '@IsOpenYbgh' === 'True') {
            if (patModel.brxzmc == 'Tự chi trả' || patModel.brxzmc == 'BHYT tự chi trả') {
                $.modalAlert("Chỉ được chọn" + patModel.brxzmc + "Tính chất", 'warning');
                return false;
            }
            else if (regInfo.brxzmc != 'BHYT tự chi trả') {
                $.modalAlert("Chọn tính chất chi phí sai", 'warning');
                return false;
            }
        }
        regInfo.mjzbz = $("#sel_mzlx").val();
        regInfo.jzyy = $("#jzyy").val();
        regInfo.ks = $("#txtghks").val();
        regInfo.ksmc = $("#txtghksmc").html();
        regInfo.ys = $("#txtghysgh").val();
        regInfo.ysmc = $("#txtghysmc").html();
        if(yyghModel)
        {
            regInfo.ghly = yyghModel.ghly ? "4":"0";
            regInfo.yyghId=yyghModel.BookId ? yyghModel.BookId:null;
        }
        else{
            regInfo.ghly ="0";

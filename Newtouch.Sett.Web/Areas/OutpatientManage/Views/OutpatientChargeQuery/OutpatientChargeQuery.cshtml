@{
    ViewBag.Title = "OutpatienChargeQuery";
    Layout = "~/Views/Shared/_Index.cshtml";

    var curOpr = OperatorProvider.GetCurrent();

    string regReportUrl = "";
    string chargeReportUrl = "";
    string ZFinvoiceReportUrl = "";
    string invoicePrintMethod = null; //ActiveX
    string OutpatientChargeDetail = "";
    if (SysConfigReader.Bool("Outpatient_Register_PrintAble") == true)
    {
        //đăng ký khámliên kết báo cáo hóa đơn
        regReportUrl = SysConfigReader.OrgReportLink("NewOutpatientRegister");
        OutpatientChargeDetail = SysConfigReader.OrgReportLink("OutpatientChargeDetail");
        invoicePrintMethod = invoicePrintMethod ?? SysConfigReader.String("Outpatient_ChargeFeeInvoice_PrintMethod");
    }
    if (SysConfigReader.Bool("Outpatient_ChargeFee_PrintAble") == true)
    {
        //liên kết báo cáo hóa đơn thu phí
        chargeReportUrl = SysConfigReader.OrgReportLink("NewOutpatientCharge");
        //liên kết báo cáo phiếu thu phí(tự chi trả)
        ZFinvoiceReportUrl = SysConfigReader.OrgReportLink("ZFOutpatientRegister");
        OutpatientChargeDetail = SysConfigReader.OrgReportLink("OutpatientChargeDetail");
        invoicePrintMethod = invoicePrintMethod ?? SysConfigReader.String("Outpatient_ChargeFeeInvoice_PrintMethod");
    }
    var useSfrqFilter = SysConfigReader.Bool("Outpatient_ChargeQuery_UseSfrqFilter");
    var opr = OperatorProvider.GetCurrent();
    //BHYTđịa phương trực thuộc,phân biệt hệ thống sẽ thực hiện ở đâuBHYTlogic
    var medicalInsurance = SysConfigReader.String("Outpatient_MedicalInsurance");
    var reportUrl = "";
    var ReportSystemCode = "";
}
<style>
    .form .formTitle {
        position: relative;
        left: 0px;
        text-align: right;
        white-space: nowrap;
        font-weight: normal;
        width: 70px;
        padding-right: 15px;
    }
</style>
@Html.Partial("_YibaoCommonView")
<form name="form1">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form">
            <tr>
                <th class="formTitle">Số bệnh án/Họ tên:</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="txtxm" name="txtxm" />
                </td>
                <th class="formTitle">Số hóa đơn:</th>
                <td class="formValue" colspan="2">
                    <input type="text" class="form-control" id="txtfph" name="txtfph" style="width:40%; float:left;" />
                    <span style="margin-left:0%;float:left;">đến</span>
                    <input type="text" class="form-control" id="txtjsfph" name="txtjsfph" style="width:40%; float:left;" />
                </td>
                <th class="formTitle">Số giao dịch trung tâm:</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="txtzxlsh" value="" />
                </td>
                <th class="formTitle">Thu phínhân viên:</th>
                <td class="formValue">
                    <div class="row">
                        <div class="col-md-9">
                            <input type="text" class="form-control" id="txtsyy" value="" />
                        </div>
                        <div class="col-md-3" style="text-align:right;">
                            <input type="button" class="btn btn-default btn-md" style="width:45px" id="btnsyy" value="Tra cứu" />
                        </div>
                    </div>
                </td>
                <td style="width:20px"></td>
                <th class="formTitle" id="thCZRQ">Ngày thao tác:</th>
                <td class="formValue" colspan="3">
                    <input id="txtCreateTimestart" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:42%; float:left;" value="@DateTime.Now.ToString("01/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                    <span style="margin-left:0%;float:left;">—</span>
                    <input id="txtCreateTimeEnd" type="text" class="form-control input-wdatepicker formClearIgnore" style="width :41%;float:left;margin-left:2%;" value="@DateTime.Now.ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                </td>
                <td class="formValue">
                    <input type="button" id="btn_search" class="btn btn-primary btn-md" style="margin-left:10px;width:40px;" value="Tra cứu" />
                </td>
            </tr>
            <tr></tr>
        </table>
    </div>
    <div class="gridPanel">
        <table id="gridJSList"></table>
        <div id="gridPager"></div>
    </div>

    <ul id="myTab" class="nav nav-tabs">
        <li class="active"><a href="#newyj" data-toggle="tab">Chi tiết truy vấn phân loại</a></li>
        <li><a href="#yj" data-toggle="tab">Chi tiết quyết toán ngoại trú</a></li>
        <content style="float:right;margin-right:45px ;width:70% ;" id="ctmx">
            <table class="form" id="tbcfmx" style="display:none">
                <tr>
                    <th class="formTitle">Số đơn thuốc:</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="txtcfh" name="txtcfh" readonly="readonly" style="border:0px;color:#aaa" />
                    </td>
                    <th class="formTitle">Bác sĩ:</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="txtys" name="txtys" readonly="readonly" style="border:0px;color:#aaa" />
                    </td>
                    <th class="formTitle">Khoa:</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="txtks" name="txtks" readonly="readonly" style="border:0px;color:#aaa" />
                    </td>
                    <th class="formTitle">Tổng số tiền:</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="txtzje" name="txtzje" readonly="readonly" style="border:0px;color:#aaa" />
                    </td>
            </table>
        </content>
    </ul>
    <div class="tab-content" style="margin-top:0%">
        <div class="tab-pane fade in active" id="newyj">
            <div class="rows" style="float:left;width:25%;">
                <table id="gridleftList"></table>
            </div>
            <div class="rows" style="float:left;width:74%;margin-left:5px;">
                <table id="gridrightList" style="float:left;width:93.5%;margin-left:5px;"></table>
            </div>

        </div>
        <div class="tab-pane fade" ;style="background-color: #fff; width:100%" id="yj">
            <table id="gridJSMXList"></table>
        </div>
    </div>
    @*<div style="background-color: #fff; margin-top:5px;">
            <table id="gridJSMXList"></table>
            @*<div id="gridJSMXListPager"></div>
        </div>*@
</form>

<script>
    $(function () {
        //khi cửa sổ trình duyệt đổi kích thước thì tải lạitảijqGridcủarộng
        $(window).resize(function () {
            initLayout("MyTabGrid");
        });
        //quyết toánbản ghi chính
        gridJSListData();
    });

    //quẹt thẻ
    function SK() {
        $.modalAlert("Chức năng đang được phát triển", 'warning');
        return false;
    }

    var medicalInsurance = '@(medicalInsurance)';
    //cấu hình:ngàylọc kỳ là theo thu phíngàykỳ,hay thời gian thao tác thu phí
    var useSfrqFilter = '@(useSfrqFilter)' == 'True';
    //đăng ký khám ngoại trúquyết toántra cứu
    function gridJSListData() {
        var gridSort = 'CreateTime asc';
        if (useSfrqFilter) {
            $('#thCZRQ').html('Ngày chi phí:');
            gridSort = 'sfrq asc';
        }
        //
        var $gridJsList = $("#gridJSList");
        $gridJsList.dataGrid({
            postData: getSearchPostData(),
            height: 150,
            url: "/OutpatientManage/OutpatientChargeQuery/SelectRegChargeQuery",
            colModel: [
                { label: 'jsnm', name: 'jsnm', width: 60, hidden: true, align: 'left' },
                 {
                     label: 'Loại quyết toán', name: 'jslx', width: 60, align: "left",
                     formatter: function (val) {
                         return $.enum.getDescByValue("EnumJslx", val);
                     }
                 },
                { label: 'Số bệnh án', name: 'blh', width: 60, align: 'left' },
                { label: 'Họ tên', name: 'xm', width: 80, align: 'left' },
                { label: 'Tính chất chi phí', name: 'brxzmc', width: 90, align: 'left' },
                { label: 'Số hóa đơn', name: 'fph', width: 80, align: 'left' },
                { label: 'Số quyết toán BHYT', name: 'zxlsh', width: 140, align: 'left' },

                {
                    label: 'Số tiền quyết toán', name: 'jszje', width: 70, align: 'left', formatter: function (cellvalue) {
                        return cellvalue ? cellvalue.toFixed(2) : "0.00";
                    }
                },
                {
                    label: 'Số tiền thanh toán', name: 'jsxjzf', width: 70, align: 'left', formatter: function (cellvalue) {
                        return cellvalue ? cellvalue.toFixed(2) : "0.00";
                    }
                },
                {
                    label: 'Ngày chi phí', name: 'sfrq', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' }
                },
                { label: 'Nhân viên thu phí', name: 'CreatorName', width: 80, align: 'left' },
                { label: 'Bác sĩ', name: 'jzys', width: 80, align: 'left' },
                {
                    label: 'Thời gian thao tác', name: 'CreateTime', width: 120, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }
                },
                { label: 'Hoàn phínhân viên', name: 'tCreatorCode', align: 'left', hidden: true },
                {
                    label: "Thao tác", name: "", width: 90, align: 'left',
                    formatter: function (cellvalue, options, rowobject) {
                        if (!(rowobject.jszje == 0)) {
                            var str = "";
                            if (medicalInsurance=="guian") {
                                str += '<a class="btn btn-default" title="Chi tiết biên lai" style="width: 20%;" onclick="printMxData(\'' + rowobject.jsnm + '\')">Chi tiết biên lai</a>  <a class="btn btn-default" title="hóa đơnIn bổ sung" style="width: 26%;" onclick="printguianFp(\'' + rowobject.jsnm + '\')">hóa đơnIn bổ sung</a>';
                            } else {
                                if ((!!regReportUrl && rowobject.jslx == '0') || (!!chargeReportUrl && rowobject.jslx == '2')) {
                                    str += '<a class="btn btn-default" title="Chi tiết biên lai" style="width: 90%;" onclick="printFp(\'' + rowobject.jsnm + '\',\'' + rowobject.jslx + '\',\'' + rowobject.brxzmc + '\')">Biên lai</a>';
                                    //str += '<a class="btn btn-default" title="in chi tiết" style="width: 38%;" onclick="printFpdymx(\'' + rowobject.jsnm + '\')">in chi tiết</a>';
                                    //str += '<a class="btn btn-default" title="xuất phiếu điện tử" style="width: 10%;" onclick="openInvoice(\'' + rowobject.mzh + '\',\'' + rowobject.jsnm + '\')">xuất hóa đơn</a>';
                                    //str += '<a class="btn btn-default" title="tra cứu in hóa đơn" style="width: 10%;" onclick="queryInvoice(\'' + rowobject.jsnm + '\')">in vé</a>';
                                    //str += '<a class="btn btn-default" title="in phiếu hóa đơn" style="width: 12%;" onclick="printReceipt(\'' + rowobject.mzh + '\',\'' + rowobject.jsnm + '\')">in phiếu nhỏ</a>';

                                }
                                else {
                                    //khôngthìkhông in
                                }
                                //if (rowobject.zxlsh != null ) {
                                //    str += '<a class="btn btn-default" title="inBHYTquyết toánđơn" style="width: 22%;" onclick="printybjsd(\'' + rowobject.zxlsh + '\')">BHYTquyết toánđơn</a>';
                                //}
                                if (!!!rowobject.fph) {
                                    //tài vụ có thể in bổ sung
                                    if ('@(invoicePrintMethod)' == 'ActiveX') {
                                        //nút in bổ sung tài vụ
                                        str += '&nbsp;<a class="btn btn-default" title="In tài chính" style="width: 20%;" onclick="axFpBuda(\'' + rowobject.jsnm + '\')">In bổ sung tài chính</a>';
                                    }
                                }
                            }

                            return str;
                        }
                        else {
                            //khôngthìkhông in
                            return '';
                        }
                    }
                },
            ],
            pager: "#gridPager",
            sortname: gridSort,
            viewrecords: true,
            onSelectRow_page: function (rowid) {
                btn_selectrow();
            },
            gridComplete: function (gridJszbList) {
                jszbList = null;
                if (gridJszbList && gridJszbList.rows) {
                    jszbList = gridJszbList.rows;
                }
            }
        });
        //chú thích
        $("#btn_search").click(function () {
            $('#gridJSMXList').jqGrid("clearGridData");//xóa chi tiết trước
            $('#gridleftList').jqGrid("clearGridData");//xóa chi tiết trước
            $('#gridrightList').jqGrid("clearGridData");//xóa chi tiết trước
            $("#tbcfmx").attr("style", "display:none;");
            $gridJsList.jqGrid('setGridParam', {
                postData: getSearchPostData(),
                url: '/OutpatientManage/OutpatientChargeQuery/SelectRegChargeQuery',
                page: 1,
            }).trigger('reloadGrid');
        });
    }

    var jszbList = null;

    function getSearchPostData() {
        var kh = "";//$("#txtkh").val();
        var fph = $("#txtfph").val();
        var jsfph = $("#txtjsfph").val();
        var xm = $("#txtxm").val();
        var syy = $("#txtsyy").val();
        var zxlsh = $("#txtzxlsh").val();
        var createTimestart = useSfrqFilter ? null : $("#txtCreateTimestart").val();
        var createTimeEnd = useSfrqFilter ? null : $("#txtCreateTimeEnd").val();
        var sfrqTimestart = useSfrqFilter ? $("#txtCreateTimestart").val() : null;
        var sfrqTimeEnd = useSfrqFilter ? $("#txtCreateTimeEnd").val() : null;
        return {
            kh: kh, fph: fph, xm: xm, syy: syy, CreateTimestart: createTimestart, CreateTimeEnd: createTimeEnd
, sfrqTimestart: sfrqTimestart, sfrqTimeEnd: sfrqTimeEnd, zxlsh: zxlsh
        };
    };
    function uniq(dataList, byName) {
        var result = [];
        var tem = {};
        for (var i = 0; i < dataList.length; i++) {
            if (!tem[dataList[i][byName]]) {
                result.push(dataList[i]);
                tem[dataList[i][byName]] = 1;
            }
        }
        return result;
    }

    //sự kiện nhấn
    var jsmxarrlist;
    function btn_selectrow() {
        //mỗi lần nhấn,xóa chi tiết dòng trước trước vàtổng cộng
        $('#gridleftList').jqGrid("clearGridData");
        $('#gridJSMXList').jqGrid("clearGridData");
        $('#gridrightList').jqGrid("clearGridData");
        $("#tbcfmx").attr("style", "display:none;");
        $.najax({
            type: "POST",
            url: "/OutpatientManage/OutpatientChargeQuery/GetRecordsByJsnm",
            data: { jsnm: $("#gridJSList").jqGridRowValue().jsnm },
            dataType: "json",
            success: function (ajaxresp) {
                $("#table_HJ").remove();

                $('#gridJSMXList').newtouchLocalDataGrid(null, ajaxresp.data.ghRecordsDetails);
                jsmxarrlist = ajaxresp.data.ghRecordsDetails;
                var fldata = uniq(ajaxresp.data.ghRecordsDetails,"dlmc");
                $('#gridleftList').newtouchLocalDataGrid(null, fldata);
                //độngtảithông tin tổng cộng
                afterCompleteFunction();
                //$("#HjDiv").append("<table class='form' id='table_HJ'>");
                $("#table_HJ").append(" <tr>");
                //tảiphía dưới trangcủatổng cộng nhóm chi phí lớn
                //for (i = 0; i < ajaxresp.data.dlhj.length; i++) {
                //    $("#table_HJ").append("<th class='formTitle'>" + ajaxresp.data.dlhj[i].dlmc + "</th>");
                //    $("#table_HJ").append("<td class='formValue'><label>" + ajaxresp.data.dlhj[i].jehj.toFixed(2) + "</label></td>");
                //}
                //$("#table_HJ").append(" </tr>");
                //$("#table_HJ").append(" </table>");
            }
        });
    }

    $('#gridleftList').newtouchLocalDataGrid({
        height: $(window).height() - 370,
        unwritten: false,
        colModel: [
            { label: 'Loại', name: 'dlmc', width: 70 },
            { label: 'Số hóa đơn', name: 'fph', width: 80, align: 'left' },
            {
                label: 'Trạng thái', name: 'jszt', width: 60, align: 'left', formatter: function (cellvalue) {
                    return cellvalue=="2" ? "Đã hoàn" : "Đã quyết toán";
                }
            },
        ],
        onSelectRow: function (rowid, status) {

            $('#gridrightList').jqGrid("clearGridData");
            var gridId = $("#gridleftList").jqGridRowValue().dlmc;
            var fllist = jsmxarrlist.filter(item => item.dlmc == gridId)
            $('#gridrightList').newtouchLocalDataGrid(null, fllist);
            $("#tbcfmx").attr("style", "display:block;");
            $("#txtcfh").val(fllist[0].cfh);
            $("#txtys").val(fllist[0].ysmc);
            $("#txtks").val(fllist[0].ksmc);
            let sum=0;
            var dds = fllist.map(function (item) {
                sum += item.je;
            });
            $("#txtzje").val(sum);
        }
    })

    $('#gridrightList').newtouchLocalDataGrid({
        height: $(window).height() - 370,
        unwritten: false,
        colModel: [
            { label: 'Tên chi phí', name: 'ypmc', width: 130 },
            { label: 'Quy cách', name: 'gg', width: 80 },
            { label: 'Đơn vị', name: 'dw', width: 70, align: 'left' },
            { label: 'Đơn giá', name: 'dj', width: 70, align: 'left' },
            { label: 'Số lượng', name: 'sl', width: 70, align: 'left' },
            { label: 'Số tiền', name: 'je', width: 70, align: 'left' },
            {
                label: 'Tỷ lệ tự chi trả', name: 'zfbl', width: 70, align: 'left', formatter: function (cellvalue) {
                    return cellvalue.toFixed(3);
                }
            },
            { label: 'Cách dùng', name: 'pc', width: 70, align: 'left' },
        ]
    })

    //ngoại trúkhámquyết toánchi tiết jGridkhai báo
    $('#gridJSMXList').newtouchLocalDataGrid({
        height: $(window).height() - 370,
        //caption: "ngoại trúkhámquyết toánchi tiết",
        unwritten: false,
        colModel: [
            { label: 'jsmxnm', name: 'jsmxnm', hidden: true, key: true },
            { label: 'Số đơn thuốc', name: 'cfh', width: 130 },
            { label: 'Mã khoản mục', name: 'sfxm', width: 100, align: 'left', hidden: true },
            { label: 'Tên khoản mục', name: 'ypmc', width: 220, align: 'left' },
            { label: 'Nhóm chi phí lớn', name: 'dlmc', width: 80, align: 'left' },
            { label: 'Đơn vị', name: 'dw', width: 50, align: 'left' },
            {
                label: 'Đơn giá', name: 'dj', width: 60, align: 'left', formatter: function (cellvalue) {
                    return cellvalue ? cellvalue.toFixed(4) : "0.00";
                }
            },
            { label: 'Số lượng tính phí', name: 'sl', width: 60, align: 'left' },
            {
                label: 'Số tiền tính phí', name: 'je', width: 80, align: 'left', formatter: function (cellvalue) {
                    return cellvalue ? cellvalue.toFixed(2) : "0.00";
                }
            },
            { label: 'Số lượng lập', name: 'klsl', width: 60, align: 'left' },
            {
                label: 'Số tiền lập', name: 'klje', width: 80, align: 'left', formatter: function (cellvalue) {
                    return cellvalue ? cellvalue.toFixed(2) : "0.00";
                }
            },
            { label: 'Số lượng đã hoàn', name: 'ytsl', width: 60, align: 'left' },
            {
                label: 'Số tiền đã hoàn', name: 'ytje', width: 80, align: 'left', formatter: function (cellvalue) {
                    return cellvalue ? cellvalue.toFixed(2) : "0.00";
                }
            },
            { label: 'Bác sĩ kê đơn', name: 'ysmc', width: 70, align: 'left' }

        ],
        gridComplete: function (gridJszbList) {
            $("#gbox_gridJSMXList").attr("style", $(window).width());
        },
        pager: "#gridJSMXListPager",
        sortname: 'ypmc asc',
        viewrecords: true,

    });

    //đã hoàn/in lại màu nềnlàmàu đỏ
    function afterCompleteFunction() {
        var ids = $("#gridJSMXList").getDataIDs();
        for (i = 0; i < ids.length; i++) {
            var rowData = $("#gridJSMXList").getRowData(ids[i]);
            if (rowData.ytje > 0) {
                $("#gridJSMXList tr[id=" + ids[i] + "]").find("td").css("background-color", "rgb(255,228,196)"); //255,218,185
            }
        }
    }


    //người thao tác
    $("#btnsyy").click(function () {
        $.modalOpen({
            id: "FormOutpatSFCZYUsers",
            title: "ChọnThao tácnhân viên",
            url: "/SystemManage/User/Selector?from=mzshoufeicaozuoyuan&organizeId=" + '@curOpr.OrganizeId' + "&isExpand=true&callbackType=json&single=true",
            width: "300px",
            height: "400px",
            callBack: function (iframeId) {
                top.frames[iframeId].AcceptClick(function (data) {
                    userStaffTreeCallback(data);
                });
            }
        });
    });
    //phương thức gọi lại cây nhân viên người dùng
    function userStaffTreeCallback(data) {
        $("#txtsyy").val(data[0].Code);
    }

    var regReportUrl = '@Html.Raw(regReportUrl)';
    var chargeReportUrl = '@Html.Raw(chargeReportUrl)';
    var OutpatientChargeDetail = '@Html.Raw(OutpatientChargeDetail)';
    var ZFinvoiceReportUrl = '@Html.Raw(ZFinvoiceReportUrl)';

    function printFp(jsnm, jslx, brxz) {
        //inHISbiên lai(hiện tại không phải hóa đơn)
        var uri;
        var orgId = '@(ViewBag.OrgId)';
        uri = '@reportUrl' + "?tempCode=02" + "&systemCode=" + '@Html.Raw(ReportSystemCode)' + "&hospitalCode=" + orgId + "&jsnm=" + jsnm;
        if (jslx == 0) {
            uri = '@reportUrl' + "?tempCode=01" + "&systemCode=" + '@Html.Raw(ReportSystemCode)' + "&hospitalCode=" + orgId + "&jsnm=" + jsnm;
        }
        if (uri) {
            window.open(uri,
                "_blank",
                "height=500, width=1195,top=100, left=50, toolbar =no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no");
        }
    };





    function printguianFp(jsnm) {

        var uri;
        uri = chargeReportUrl + "&jsnm=" + jsnm ;
        if (uri) {
            window.open(uri,
                "_blank",
                "height=500, width=1195,top=100, left=50, toolbar =no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no");
        }
    }

    function printMxData(jsnm) {
        var uri;
        uri = OutpatientChargeDetail + "&jsnm=" + jsnm;
        if (uri) {

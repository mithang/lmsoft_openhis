            if (!!data.jfbId) {//xác định có dữ liệu mới thêm không
                data.czlx = "1";//sửa
            }
            //kiểm trakhoản trùng

            //trước tiên tạixmtìm trong mảng
            var matchedIndex;
            if (editingNewid) {
                matchedIndex = -1;
                var dj = "0.00";
                var sl = 0;
                for (var ii = 0; ii < newxmList.length; ii++) {
                    if (newxmList[ii].newid === data.newid) {
                        matchedIndex = ii;
                        dj = newxmList[ii].dj;
                        sl = newxmList[ii].sl;
                    }
                }
                if (matchedIndex === -1) {
                    return; //có lẽ là bất thường
                }
                newxmList.remove(matchedIndex);   //gỡ khoản này

                if (!data.czlx == "1" || data.czlx == "0") {//dữ liệu mới thêm và dữ liệu đã sửa trực tuyến nhưng chưa lưu,cần trừ số tiền trước
                    //thêm mớidữ liệu,tạm thời chưa lưu vàodữ liệukho,cầncầntrừ trướcsửatrướctổng số tiền,sau đócộng tổng số tiền sau khi sửa
                    wqrje = (parseFloat(wqrje) - (parseFloat(dj) * parseFloat(sl))).toFixed(2);//trừ số tiền trước khi sửa
                }
                //newxmList.unshift(data);   //thêm dưới dạng khoản mới    //”đầu mảng“
                newxmList.push(data);
                wqrje = (parseFloat(wqrje) + parseFloat(data.dj) * parseFloat(data.sl)).toFixed(2);//cộng tổng số tiền sau khi sửa
                $('#wqrje').html(wqrje);
            }
            else {  //editingJzjhmxId
                matchedIndex = -1;
                for (var ii = 0; ii < oldxmList.length; ii++) {
                    if (oldxmList[ii].jzjhmxId === data.jzjhmxId) {
                        matchedIndex = ii;
                    }
                }
                if (matchedIndex === -1) {
                    return; //có lẽ là bất thường
                }
                oldxmList.remove(matchedIndex);   //gỡ khoản này
                //oldxmList.unshift(data);   //thêm dưới dạng khoản mới    //”đầu mảng“
                oldxmList.push(data);
            }

            //đưa lạixmmảng hiển thị vàogrid
            fillDataToGrid();
            $('#sfxmmc').val('');
            $('#sfxmCode').val('');
            $('#sfdlCode').val('');
            $('#sfdlmc').val('');
            $('#yzlx').val('');
            $('#dw').html('');
            $('#czlx').val('');
            $('#jfbId').val('');
            if ('@(ViewBag.sfxm_dj)' === 'ON') {
                $('#dj').val('0.00')
            } else {
                $('#dj').html('0.00');
            }
            $('#duration').val('');
            $('#ttbz').removeAttr('checked');
            $('#sl').val('');
            $('#zje').html('0.00');

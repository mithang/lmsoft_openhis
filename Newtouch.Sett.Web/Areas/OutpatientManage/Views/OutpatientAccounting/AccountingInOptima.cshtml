@{
    ViewBag.Title = "Ngoại trúghi sổ";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<style>
    .toolbar {
        width: 45% !important;
        margin: 8px 30px 12px;
    }

    .btn-group {
        float: right;
        font-size: 12px;
        font-weight: 200;
    }
</style>
<div class="rows" style="float:left;width:24%;margin-left:1%;">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg" style="height:23px;">
            Thông tin bệnh nhân<strong id="sycs" style='text-decoration:none;'></strong>
            <div class="btn-group" data-toggle="buttons" id="status">
                <label class="btn btn-default active" style="z-index:100">
                    <input type="radio" value="1" name="qrzt" checked="checked" />Chưa xác nhận
                </label>
                <label class="btn btn-default" style="z-index:100">
                    <input type="radio" value="2" name="qrzt" />Đã xác nhận
                </label>
            </div>
        </div>
        <div style="height:35px; display:none;" id="searchDiv">
            <table class="form" style="margin-left:10px">
                <tr>
                    <td class="formValue">
                        <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:35%; float:left;" value="@DateTime.Now.ToString(" yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        <span style="margin-left:5px;float:left;">—</span>
                        <input id="jssj" type="text" class="form-control input-wdatepicker" style="width: 35%; float: left; margin-left: 5px;" value="@DateTime.Now.ToString(" yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        <button id="btn_search" type="button" class="btn  btn-default" style="margin-left:10px;"><i class="fa fa-search"></i></button>
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <div class="gridPanel" style="margin-top:-12px;width:273px;">
        <table id="gridList"></table>
    </div>
</div>
<div class="rows" style="float:left;width:74%;margin-left:1%;">
    <form class="rows" style="margin-bottom: 1%;" id="formPat1">
        <div class="panel panel-default">
            <div class="panel-heading navb-bg">
                Thông tin cơ bản<strong id="sycs" style='text-decoration:none;'></strong>
            </div>
            <div style="padding: 2px;padding-right:20px;" id="divPatInfo">
                <table class="form">
                    <tr>
                        <th class="formTitle"><label id="lbl_type">Ngoại trú/Số nhập viện:</label></th>
                        <td class="formValue">
                            @*<input type="text" class="form-control" id="mzh" name="mzh" />*@
                            <label id="mzh"></label>
                            <label id="czlx" hidden="hidden"></label>@*Loại thao tác Thêm mới0/Sửa1/Xóa2*@
                            <label id="clzt" hidden="hidden"></label> @*Thêm thủ công0/Chưa xác nhận1/Đã xác nhận2*@
                            <label id="jfbId" hidden="hidden"></label>
                            <input type="hidden" class="btn btn-default btn-md btn-default-color" style="width: 25px;" id="btnsyy" value="Tra cứu" onclick="GetPatSerarchView($('#mzh').val());" />
                            <input type="hidden" id="brxz" />
                        </td>
                        <th class="formTitle">Họ tên:</th>
                        <td class="formValue">
                            <label id="xm" style="width: 150%"></label>
                        </td>
                        <th class="formTitle">Giới tính:</th>
                        <td class="formValue">
                            <label id="xb"></label>
                        </td>
                        <th class="formTitle">Tuổi:</th>
                        <td class="formValue">
                            <label id="nlshow"></label>
                        </td>
                    </tr>
                    <tbody class="dispTbody" style="display:none;">
                        <tr>
                            <td class="formTitle">Số giấy tờ:</td>
                            <td class="formValue">
                                <label id="zjh"></label>
                            </td>
                            <td class="formTitle">Số điện thoại:</td>
                            <td class="formValue seWidth">
                                <label id="phone"></label>
                            </td>
                            <th class="formTitle">Ngày sinh:</th>
                            <td class="formValue seWidth">
                                <label id="csny"></label>
                            </td>
                            <th class="formTitle" hidden>Người giới thiệu:</th>
                            <td class="formValue">
                                <label id="jsr" hidden></label>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="fa_icontoggle"><i class="fa fa-angle-double-down icontoggle" style="color:rgb(0, 160, 233);cursor:pointer;"></i></div>
            </div>
        </div>
    </form>
    <div class="rows" style="margin-bottom: 1%;">
        <div class="panel panel-default" style="margin-bottom:0;">
            <div class="panel-heading navb-bg" id="divPanelJzxm">
                Khoản mục ghi sổ
            </div>
            <div id="divSLMX" style="padding: 2px;padding-right:20px;">
                <table class="form">
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Khoản thu phí:</th>
                        <td class="formValue">
                            <input id="sfxmmc" type="text" class="form-control form-an" />
                            <input id="sfxmCode" type="text" style="display:none;" class="form-control" />
                            <!-- Loại y lệnh 1Thuốc 2Khoản thu phí -->
                            <input id="yzlx" type="text" style="display:none;" class="form-control" />
                            <input id="sfdlCode" type="text" style="display:none;" class="form-control" />
                            <input id="sfdlmc" type="text" style="display:none;" class="form-control" />
                        </td>
                        <th class="formTitle"><span class="required" style="display:inline">*</span>Thời lượng đơn vị(phút):</th>
                        <td class="formValue">
                            <input id="duration" type="text" class="form-control form-an" value="" />
                        </td>
                        <th class="formTitle">Đơn vị:<label id="dw"></label></th>
                        <td class="formValue"></td>
                    </tr>
                    <tr>
                        <th class="formTitle">Đơn giá(đồng):</th>
                        <td class="formValue" id="input1"></td>
                        <th class="formTitle"><span class="required">*</span>Số lượng:</th>
                        <td class="formValue">
                            <input id="sl" type="text" class="form-control form-an" />
                        </td>
                        <th class="formTitle"></th>
                        <td class="formValue">
                            <div class="ckbox">
                                <input id="ttbz" name="ttbz" type="checkbox"><label for="ttbz">Trị liệu nhóm</label>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Loại phục hồi chức năng:</th>
                        <td class="formValue formDdlSelectorTd">
                            <select id="kflb" name="kflb" class="form-control">
                                <option value="">==Vui lòng chọn==</option>
                            </select>
                        </td>
                        <td class="formTitle"><span class="required">*</span>Ngày trị liệu:</td>
                        <td class="formValue">
                            <input id="jzsj" type="text" class="form-control input-wdatepicker form-an formClearIgnore"
                                   onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" />
                            <span style="color: red; display: none">￥</span><a id="zje" style="display: none">0.00</a>
                            <input type="hidden" id="IsBlh" value="@ViewBag.IsBlh" />
                        </td>
                        <th class="formTitle"><span class="required">*</span>Kỹ thuật viên trị liệu:</th>
                        <td class="formValue">
                            <input id="zlsList" type="text" class="form-control form-an" />
                        </td>
                        @*
                            <th class="formTitle">Ghi chú:</th>
                            <td class="formValue">
                                <input id="bz" type="text" class="form-control form-an form-an-end" />
                            </td>*@
                    </tr>
                </table>
            </div>
        </div>
    </div>
    <strong style="text-decoration:none;float:left;padding-left:10px;">
        trangTổng số tiền:<span style='color:red;' id="ymzje"></span>đồng,ChưaLưuSố tiền:<span style='color:red;' id="wqrje"></span>đồng
    </strong>
    @Html.Partial("_MiddleButtonsView", new Newtouch.Sett.Web.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 2, 3, 6, 9 },
    F2Text = "Thêm",
    F3Text = "Sửa",
    F6Text = "Xóa",
    F9Text = "Hủy sửa",
    F9Hidden = true
})
    <div>
        <table id="gridMX"></table>
    </div>
    @Html.Partial("_BottomButtonsView", new Newtouch.Sett.Web.Models.BottomButtonViewModel()
{
    ShowKeyList = new[] { 4, 7, 8, 10 },
    F7Text = "Mẫu",
    F8Text = "Gửi",
    F10Text = "Xem báo cáo"
})
    <table style="width: 55%;position: relative;bottom:37px">
        <tr>
            <td>
                <label style="height:7px;width:25px;background-color:#f2dede; border:1px solid #ddd"></label>
            </td>
            <td>Biểu thị ghi sổ chưa xác nhận</td>
            <td>
                <label style="height:7px;width:25px;background-color:#d9edf7; border:1px solid #ddd"></label>
            </td>
            <td>Biểu thị ghi sổ lịch sử</td>
            @*
                <td>
                    <label style="height:7px;width:25px;background-color:#6ff3ad; border:1px solid #ddd"></label>
                </td>
                <td>Biểu thị ghi sổ đồng bộ lịch sử</td>*@
            <td>
                <label style="height:7px;width:25px;background-color:#6ff3ad; border:1px solid #ddd"></label>
            </td>
            <td>Biểu thịSửaghi sổ lịch sử</td>
            <td>
                <label style="height:7px;width:25px;background-color:white;  border:1px solid #ddd"></label>
            </td>
            <td>Biểu thị ghi sổ mới</td>
        </tr>
    </table>
</div>
<script type="text/javascript">
    var patientType;
    var clzt;
    var Del_xmlist = [];//đã xóalist
    var editingNewid = null;    //dòng đang sửa
    var ksrq = "";
    var jsrq = "";
    var ymzje = "0.00";//khoản thu phílisttổng số tiền
    var wqrje = "0.00";//tổng số tiền khoản thu phí chưa lưu
    $('#wqrje').html(wqrje);
    $("#btn_search").click(function () {
        if ($('#kssj').val() && $('#jssj').val() && ($('#kssj').val() > $('#jssj').val())) {
            $.modalAlert("Ngày bắt đầu không được lớn hơn ngày kết thúc", 'warning');
            return;
        }
        ksrq = $("#kssj").val();
        jsrq = $("#jssj").val();
        if ($('#status input:radio:checked').val() == "2" && ksrq == "" && jsrq == "") {
            $.modalAlert("Ngày bắt đầu và ngày kết thúc không được cùng trống", 'warning');
            return;
        }
        $("#gridList").jqGrid('setGridParam', {
            postData: { type: $('#status input:radio:checked').val() || "2", kssj: ksrq, jssj: jsrq },
        }).trigger('reloadGrid');
    });
    gridList();

    $("input[name='qrzt']").off().on("change", function () {
        var $dstnDiv = $("#searchDiv");
        if ($(this).val() == "2") {
            $("#kssj").val($.getDate());
            $("#jssj").val($.getDate());
            ksrq = $("#kssj").val();
            jsrq = $("#jssj").val();
            $dstnDiv.show();

        } else {
            $("#kssj").val('');
            $("#jssj").val('');
            $dstnDiv.hide();
            //$("#gridPanel").css("margin-top", "-15px");
        }
        addpatientmzh();
        $("#gridList").jqGrid('setGridParam', {
            postData: { type: $(this).val() || "1", kssj: $("#kssj").val(), jssj: $("#jssj").val() },
        }).trigger('reloadGrid');
    });
    //tảiloại phục hồi chức năng
    $("#kflb").bindSelect({
        url: "/Com/GetSelectItemsDetailListByItemCode?code=RehabTreatmentMethod",
    });

    var Editing_ysList = [];
    //mặc địnhlàhiện tại
    var default_Editing_ysList = [{ id: '@(ViewBag.CurYsStaffId)', gh: '@(ViewBag.CurYs)', Name: '@(ViewBag.CurYsmc)', ks: '@(ViewBag.CurKs)', ksmc: '@(ViewBag.CurKsmc)' }]; //kỹ thuật viên trị liệu trong vùng sửa
    $("#input1").html('@(ViewBag.sfxm_dj)' === 'ON' ? " <input id='dj' type='text' class='form-control form-an' />" : " <label id='dj'></label>");
    $('#btn_bottombutton_f3').attr('disabled', 'disabled');
    $('#btn_bottombutton_f6').attr('disabled', 'disabled');
    $("#jzsj").val($.getDate());


    patInfoObj = {}, //thông tin cá nhânObjectđối tượng

    setDefaultYsList();

    var respblh;
    //theosố hồ sơ bệnh ánlấythông tin cơ bản bệnh nhân
    function searchPatInfo(admsnum, type) {
        $.loading(true, "Đang yêu cầu dữ liệu...");
        if ($('#status input:radio:checked').val() == "2") {//đã xác nhận
            if (type == 'Nhập viện') {
                $("#lbl_type").html("Số nhập viện:");
                patientType = "Nhập viện";
            } else if (type == 'Ngoại trú') {
                $("#lbl_type").html("Số khám ngoại trú:");
                patientType = "Ngoại trú";
            } else {
                return;
            }
            $.ajax({
                type: "POST",
                url: "/OutpatientManage/OutpatientAccounting/GetpatientInfoInOptima",
                data: { admsnum: admsnum, type: type, kssj: ksrq, jssj: jsrq },
                dataType: "json",
                cache: true,
                async: true,
                success: function (ajaxresp) {
                    if (ajaxresp.state === 'success') {
                        funcDoPageClear(); //xóa
                        respblh = ajaxresp.data.OutpatAccInfoDto.mzh;
                        setPatInfoModel(ajaxresp.data.OutpatAccInfoDto); //gán thông tin cơ bản cá nhân

                        clzt = "2";//$("#gridList").jqGridRowValue().wqrzt > 0 ? "1" : "2";
                        if (ajaxresp.data.OptimAccInfoDto && ajaxresp.data.OptimAccInfoDto.length > 0) {
                            newxmList = ajaxresp.data.OptimAccInfoDto;   //thêm dưới dạng khoản mới //”đầu mảng“
                            fillDataToGrid();
                        }
                    } else if (ajaxresp.state === 'error') {
                        newtouch_event_f4();
                        FreeCardReg();
                        $.loading(false);
                    }
                },
                complete: function () {
                    $.loading(false);
                }
            });
        } else if ($('#status input:radio:checked').val() == "1") {//chưa xác nhận
            clzt = "1";
            setTimeout('loadSyncedTreatmentRecord("' + admsnum + '","' + type + '");', 50);
        }

    }

    function funcDoPageClear() {
        //$("#gridMX").newtouchLocalDataGrid(null, oldxmList);
        $("#sycs").html('');
        clzt = "";
        $("#jzsj").val($.getDate());
    }

    //thêm mớibệnh nhân
    function FreeCardReg() {
        $.modalOpen({
            id: "Form",
            title: "Đăng ký không cần thẻ",
            url: "/PatientManage/HospiterRes/PatientBasic",
            width: "1000px",
            height: "824px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    function fillInfo(rep) {
        setPatInfoModel(rep);
    }

    //khởi tạo thông tin bệnh nhân
    function setPatInfoModel(patModel) {
        $('#formPat1').formSerialize(patModel);
        $("#xb").html($.getGender(patModel.xb));
        $("#csny").html((patModel.csny && patModel.csny.length >= 10 ? patModel.csny.substring(0, 10) : ""));
        $("#zjh").html(patModel.zjh);
        $("#jsr").html(patModel.jsr);
        $("#xm").html(patModel.xm);
        $("#nlshow").html(getAgeFromBirthTime({ begin: patModel.csny }).text);
        $("#phone").html(patModel.phone);
        if (patModel.sycs) {
            $('#sycs').html("&nbsp&nbsp&nbsp&nbspBHYT còn lại<span style='color:red'>" + patModel.sycs + "</span>lần");
        }
        $("brxz").val(patModel.brxz);
        $("#mzh").html(patModel.mzh);
        //tảithông tin bệnh nhân
        patInfoObj.xm = patModel.xm; //họ tên
        patInfoObj.xb = patModel.xb; //giới tính
        patInfoObj.csny = patModel.csny;
        patInfoObj.patid = patModel.patid; //mã nội bộ bệnh nhân
        patInfoObj.blh = patModel.blh; //số hồ sơ bệnh án
        patInfoObj.zjh = patModel.zjh; //số giấy tờ
        patInfoObj.jsr = patModel.jsr; //người giới thiệu
        patInfoObj.brxz = patModel.brxz;//tính chất bệnh nhân
        patInfoObj.mzh = patModel.mzh;//số khám ngoại trú
        var type = patModel.zjlx;
        switch (type) {
            case "1":
                type = "CMND/CCCD";
                break;
            case "2":
                type = "Hộ chiếu";
                break;
            case "3":
                type = "Chứng minh sĩ quan";
                break;
            default:
                type = "Khác";
                break;
        }
        $("#zjlx").html(type);
        patInfoObj.zjlx = patModel.zjlx; //loại giấy tờ
    }

    //khai báo khoản mụcchi tiết grid
    $("#gridMX").newtouchLocalDataGrid({
        height: $(window).height() - 363,
        unwritten: false,
        colModel: [
            { label: "newid", name: "newid", width: 80, align: "left", hidden: true },
            { label: "Khoản thu phí", name: "sfxmCode", width: 80, align: "left", hidden: true },
            { label: "Loại y lệnh", name: "yzlx", width: 150, align: "left", hidden: true },
            { label: "Khoản thu phí", name: "sfxmmc", width: 150, align: "left" },
            { label: "Loại", name: "sfdlCode", align: "left", hidden: true },
            { label: "Trị liệu theo nhóm", name: "ttbz", align: "left", hidden: true },
            { label: "Loại", name: "sfdlmc", width: 100, align: "left" },
            { label: "Đơn vị", name: "dw", width: 70, align: "left" },
            { label: "Thời lượng đơn vị", name: "duration", width: 70, align: "left" },
            {
                label: "Đơn giá(đồng)", name: "dj", width: 70, align: "left",
                formatter: function (val) {
                    return val > 0 ? parseInt(val).toFixed(4) : "0.0000";
                }
            },
            { label: "Số lượng", name: "sl", width: 100, align: "left" },
            {
                label: "Kỹ thuật viên trị liệu", name: "ysList", width: 120, align: "left", formatter: function (cellvalue) {
                    return getYsNamesByList(cellvalue);
                }
            },
            { label: "Tổng số tiền(đồng)", name: "zje", width: 70, align: "left" },
            { label: "Ghi chú", name: "bz", hidden: true, width: 100, align: "left" },
            {
                label: "ghi sổNgày", name: "jzsj", width: 100, align: "left", formatter: function (cellvalue) {
                    return cellvalue.length > 10 ? cellvalue.substring(0, 10) : cellvalue;
                }
            },
            { label: "Loại phục hồi chức năng", name: "kflb", width: 50, align: "left", hidden: true },
            { label: "clzt", name: "clzt", hidden: true },
             { label: "jfbId", name: "jfbId", hidden: true },
              { label: "czlx", name: "czlx", hidden: true }
        ],
        ondblClickRow: function (rowid) {
            gridEditRow(rowid);
        },
        onSelectRow: function (rowid) {
            var data = $("#gridMX").jqGrid('getRowData', rowid);
            $('#btn_bottombutton_f2').removeAttr('disabled');
            $('#btn_bottombutton_f3').removeAttr('disabled');
            $('#btn_bottombutton_f6').removeAttr('disabled');
        },
        gridComplete: function (data) {
            var ids = $("#gridMX").jqGrid('getDataIDs');
            for (var i = 0; i < ids.length; i++) {
                var rowData = $("#gridMX").jqGrid('getRowData', ids[i]);
                if (rowData) {
                    if (rowData.jfbId && rowData.jfbId != '') {//đã xác nhận
                        if (rowData.czlx == "1") {//sửa
                            $('#gridMX tr[id="' + ids[i] + '"]').css("background-color", "#6ff3ad");
                        } else {
                            $('#gridMX tr[id="' + ids[i] + '"]').css("background-color", "#d9edf7");
                        }
                    } else {
                        if (rowData.clzt == "1") {//chưa xác nhận
                            $('#gridMX tr[id="' + ids[i] + '"]').css("background-color", "#f2dede");
                        }
                    }

                }
            }
        }
    });

    //kỹ thuật viên trị liệu nàytháng ghi sổ giới hạn trên nhắc nhở
    function refreshZlsJzjeInfo() {
        var gh = null;
        var ks = null;
        if (Editing_ysList && Editing_ysList.length == 1) {
            gh = Editing_ysList[0].gh;
            ks = Editing_ysList[0].ks
        } else {
            $('#divPanelJzxm').html("Khoản mục ghi sổ");
        }
        if (gh) {
            $.najax({
                type: "GET",
                url: "/HospitalizationManage/BookkeepInHos/GetStaffjfjeInfo?gh=" + gh + "&ks=" + ks,
                loading: true,
                success: function (ajaxresp) {
                    if (ajaxresp.data.jfjesx) {
                        jfXm_jfjesx = ajaxresp.data.jfjesx;
                        jfXm_yjfzje = ajaxresp.data.yjfzje;
                        Tips();
                    }
                }
            });
        }
    }
    var jfXm_jfjesx;
    var jfXm_yjfzje;
    //điền
    function Tips() {
        var html = "Khoản mục ghi sổ";
        if (jfXm_jfjesx) {
            html += "<strong style='text-decoration:none;'>&nbsp;&nbsp;&nbsp;&nbsp;Tổng số tiền đã tính phí（Tháng hiện tại）:<span style='color:red;'>" + jfXm_yjfzje + "</span>đồng,Giới hạn trên（Tháng hiện tại）:<span style='color:red;'>" + jfXm_jfjesx + "</span>đồng</strong>";
        }
        $('#divPanelJzxm').html(html);
    }


    //gắn kỹ thuật viên trị liệuchọn cây
    $('#zlsList').focus(function () {
        if ($(this).hasClass('form-an-cur') && Editing_ysList.length > 0) {
            return; //vừa tự động nhảy từ nút trước đó sang
        }
        var initIdSelected = "";
        $.each(Editing_ysList, function () {
            initIdSelected += this.id + ",";
        })

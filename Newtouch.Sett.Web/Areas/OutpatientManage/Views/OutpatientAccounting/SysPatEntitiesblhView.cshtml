
@{
    ViewBag.Title = "Tra cứu thông tin bệnh nhân khi đăng ký nhập viện";
    Layout = "~/Views/Shared/_Form.cshtml";
    var from = (ViewBag.from as string) ?? "";
}
<style>
    .table-responsive {
        border: 0;
    }

    .ui-jqgrid .ui-jqgrid-pager .ui-pager-table {
        width: 90%;
    }
</style>

<div class="topPanel" style="border-bottom:1px solid rgb(221, 221, 221);margin-bottom: 1%;">
    <div class="search">
        <table class="form">
            <tr>
                <th class="formTitle" style="width:50px">Số hồ sơ bệnh án:</th>
                <td class="formValue">
                    <input id="txt_blh" name="txt_blh" type="text" class="form-control form-an" placeholder="Vui lòng nhập số hồ sơ bệnh án" />
                </td>
                <th class="formTitle" style="width:50px">Họ tên:</th>
                <td class="formValue">
                    <input id="txt_xm" name="txt_xm" type="text" class="form-control form-an form-an-end" placeholder="Vui lòng nhậpHọ tênhoặc phiên âm đầu" />
                </td>
                <th class="formTitle" style="width:50px">Số giấy tờ:</th>
                <td class="formValue" style="width:150px">
                    <input id="txt_zjh" name="txt_zjh" type="text" class="form-control form-an form-an-end" placeholder="Vui lòng nhập CMND/CCCD" />
                </td>
                <td style="padding-left: 10px;">
                    <button type="button" id="btn_search" class="btn btn-primary btn-md">&nbsp;Tra cứu&nbsp;</button>
                </td>
            </tr>
        </table>
    </div>
</div>
<!--Thông tin bệnh nhân Bao gồm số hồ sơ bệnh án  Họ tên -->
<form id="formPatSer" style="margin:2px;margin-top:10px;">
    <div class="gridPanel">
        <table id="patGridList" rel="formPatSer"></table>
        <div id="gridPager" style="padding-right:20%"></div>
    </div>
</form>

<script>
    //cái trước đówindowđối tượng
    var prevWindow;
    if ('@(from)' !== '') {
        prevWindow = top.top.frames['@(from)'];
    }
    else {
        prevWindow = $.currentWindow();
    }

    $(function () {

        var obj = new Object;
        obj.blh = $.request("blh");
        var searInfo = new PatSearchInfo();
        //tảidữ liệu
        searInfo.init(obj);

        $('#txt_xm').keyupEnterEvent(function () {
            $('#btn_search').trigger('click');
        });

        //tra cứu
        $("#btn_search").click(function () {
            $("#patGridList").jqGrid('setGridParam', {
                postData: {
                    blh: $("#txt_blh").val(), xm: $("#txt_xm").val(), zjh: $("#txt_zjh").val()
                },
                page: 1,
                url: "@Url.Action("PatSearchInfo")"
            }).trigger('reloadGrid');
        });
    });
    var PatSearchInfo = (function () {
        //tảidanh sách
        var loadGrid = function (data) {
            var $gridList = $("#patGridList");
            $gridList.dataGrid({
                height: $(window).height() - 200,
                autowidth: false,
                width: $("#formPatSer").width() - 2,
                url: "@Url.Action("PatSearchInfo")",
                postData: { blh: $("#txt_blh").val(), xm: $("#txt_xm").val(), zjh: $("#txt_zjh").val() },
                caption: 'Thông tin bệnh nhânDanh sách',
                colModel: [
                    { label: 'Khóa chính', name: 'patid', hidden: true },
                    { label: 'Số hồ sơ bệnh án', name: 'blh', width: 50, align: 'left' },
                    { label: 'Họ tên', name: 'xm', width: 70, align: 'left' },
                    { label: 'Năm sinh', name: 'csny', hidden: true, width: 120, align: 'left' },
                    {
                        label: 'Giới tính', name: 'xb', width: 45, align: 'left', formatter: function (cellvalue) {
                            return $.getGender(cellvalue);
                        }
                    },
                    {
                        label: 'Tuổi', name: 'nlshow', width: 45, align: 'left', formatter: function (cellvalue, options, rowObject) {
                            return getAgeFromBirthTime({ begin: rowObject.csny }).text;
                        }
                    },
                    { label: 'Số giấy tờ', name: 'zjh', width: 150, align: 'left' },
                    { label: 'Số thẻ', name: 'kh', width: 80, align: 'left' },
                    { label: 'Loại thẻ', name: 'CardTypeName', width: 80, align: 'left' },
                    { label: 'Tính chất bệnh nhân', name: 'brxzmc', width: 60, align: 'left' },
                    { label: 'CardType', name: 'CardType', width: 80, align: 'left', hidden: true, },
                    { label: 'CardId', name: 'CardId', width: 80, align: 'left', hidden: true, },
                     { label: '', name: 'CreateTime', hidden: true }
                ],
                pager: "#gridPager",
                sortname: 'CreateTime desc',
                viewrecords: true
            });
        };

        var myPatSearchInfo = function (data) {

        }

        //tảisự kiện
        myPatSearchInfo.prototype.init = function (data) {
            if (data.blh === "null") {
                $("#txt_xm").val("");
            } else {
                $("#txt_xm").val(data.blh);
            }
            loadGrid(data);
        };
        return myPatSearchInfo;
    }());

    //jqGrid nhấn đúpđã chọndòng nào đó
    function btn_edit() {
        PatSearchConfirm();
    }

    function PatDbGrid() {
        var $gridList = $("#patGridList");
        var blh = $gridList.jqGridRowValue().blh;
        var obj = new Object();
        obj.blh = blh;
        obj.nlshow = $gridList.jqGridRowValue().nlshow;
        obj.xm = $gridList.jqGridRowValue().xm;
        obj.patid = $gridList.jqGridRowValue().patid;
        obj.startTime = $.currentWindow().$("#ks").val();
        obj.endTime = $.currentWindow().$("#js").val();
        obj.CardId = $gridList.jqGridRowValue().CardId;
        prevWindow.GetQueryFphAjax(obj);
        //đóng cửa sổ
        ReceiptCancle();
    }
    //xác nhận trang chínhgọi
    function PatSearchConfirm() {
        PatDbGrid();
    }

    //hủy
    function ReceiptCancle() {
        $.modalClose();
    }
</script>



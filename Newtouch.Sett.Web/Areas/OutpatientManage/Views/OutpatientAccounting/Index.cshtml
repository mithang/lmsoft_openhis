    //phân tíchbác sĩmảng,lấybác sĩchuỗi tên
    function getYsNamesByList(ysList) {
        if (ysList) {
            //phân tíchkỹ thuật viên trị liệu[{},{}]lấychuỗi
            var str = "";
            $.each(ysList, function () {
                str += this.Name + ',';
            });
            if (str.length > 0) {
                str = str.substring(0, str.length - 1);
            }
            return str;
        }
        return "";
    }

    //phần tử trong trang,tínhtổng số tiền
    function reCalcZjeFromTxt() {
        var resultZje = "0.00";
        var txtDj = '@(ViewBag.sfxm_dj)' === 'ON' ? $("#dj").val() : $("#dj").html();
        var txtSl = $('#sl').val();
        if (txtDj && txtSl) {
            if (!isNaN(txtDj) && !isNaN(txtSl)) {
                resultZje = roundingBy4she6ru5chengshuang((parseFloat(txtDj) * parseFloat(txtSl)), 2);
            }
        }
        $('#zje').html(resultZje);
    }


    //kiểm trađang sửacủadữ liệu(chờ gửi)củatính đầy đủ
    function checkEditingRowData(rowData) {
        if (!rowData.ysList || rowData.ysList.length === 0) {
            $.modalAlert("Vui lòng chọn kỹ thuật viên trị liệu", 'warning');
        }
        else if (!rowData.sfxmCode || !rowData.sfxmmc || !rowData.yzlx || !rowData.sfdlCode || !rowData.sfdlmc) {
            $.modalAlert("Vui lòng chọn khoản thu phí", 'warning');
        }
        else if (rowData.dw === "") {
            $.modalAlert("Thiếu thông tin đơn vị của khoản mục", 'warning');
        }
        else if (rowData.yzlx === '2' && (rowData.duration === "" || rowData.duration === "" || isNaN(rowData.duration))) {
            $.modalAlert("Vui lòng điền thời lượng đơn vị của khoản mục", 'warning');
        }
        else if (rowData.dj === "" || isNaN(rowData.dj)) {
            $.modalAlert("Thiếu thông tin đơn giá của khoản mục", 'warning');
        }
        else if (rowData.jzsj === "") {
            $.modalAlert("Vui lòng điềnNgày trị liệu", 'warning');
        }
        else if (rowData.sl === "" || isNaN(rowData.sl)) {
            $.modalAlert("Vui lòng điền số lượng", 'warning');
        } else if (rowData.kflb == "") {
            $.modalAlert("Vui lòng chọn loại phục hồi chức năng", 'warning');
        }
        else {
            return true;
        }
        return false;
    }


    //F6xóa khỏi danh sách
    function newtouch_event_f6() {
        //lấygridhiện tạiđã chọncủadòng đó
        var rowid = $('#gridMX').jqGrid('getGridParam', 'selrow');
        if (rowid) {
            //yêu cầu xóanàydòng

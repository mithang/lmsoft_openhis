    //sửanút
    function newtouch_event_f3() {
        if (editingNewid && editingJzjhmxId) {
            $.modalConfirm("Chương trình bất thường,Trang sẽ tự động làm mới", function (flag) {
                location.href = location.href;
            });
            return; //lỗi chương trình
        }
        if (editingNewid || editingJzjhmxId) {
            //gửisửa
            var data = getEditRowData();
            if (!(checkEditingRowData(data))) {    //dữ liệu có đầy đủ không,kiểm tra các mục bắt buộc
                return;
            }

            data.newid = editingNewid;
            data.jzjhmxId = editingJzjhmxId;

            //kiểm trakhoản trùng

            //trước tiên tạixmtìm trong mảng
            var matchedIndex;
            if (editingNewid) {
                matchedIndex = -1;
                for (var ii = 0; ii < newxmList.length; ii++) {
                    if (newxmList[ii].newid === data.newid) {
                        matchedIndex = ii;
                    }
                }
                if (matchedIndex === -1) {
                    return; //có lẽ là bất thường
                }
                newxmList.remove(matchedIndex);   //gỡ khoản này
                newxmList.unshift(data);   //thêm dưới dạng khoản mới    //”đầu mảng“
            }
            else {  //editingJzjhmxId
                matchedIndex = -1;
                for (var ii = 0; ii < oldxmList.length; ii++) {
                    if (oldxmList[ii].jzjhmxId === data.jzjhmxId) {
                        matchedIndex = ii;
                    }
                }
                if (matchedIndex === -1) {
                    return; //có lẽ là bất thường
                }
                oldxmList.remove(matchedIndex);   //gỡ khoản này
                oldxmList.unshift(data);   //thêm dưới dạng khoản mới    //”đầu mảng“
            }

            //đưa lạixmmảng hiển thị vàogrid
            fillDataToGrid();

            $('#sfxmmc').val('');
            $('#sfxmCode').val('');
            $('#sfdlCode').val('');
            $('#sfdlmc').val('');
            $('#yzlx').val('');
            $('#dw').html('');
            //$('#dj').html('');
            if ('@(ViewBag.sfxm_dj)' === 'ON') {
                $('#dj').val('0.00')
            } else {
                $('#dj').html('0.00');
            }
            $('#duration').val('');
            $('#ttbz').removeAttr('checked');
            $('#sl').val('');
            $('#zje').html('0.00');
            $("#kflb").val("RTM_PT").trigger("change");
            editingNewid = null;    //dòng đang sửa
            editingJzjhmxId = null;    //dòng đang sửa

            bottomButtonsReset();
            //$('#sfxmmc').trigger('focus');
        }
        else {
            //lấygridhiện tạiđã chọncủadòng đó
            var seleId = $('#gridMX').jqGrid('getGridParam', 'selrow');
            if (seleId) {
                //yêu cầusửanàydòng
                gridEditRow(seleId);
            }
        }
    }


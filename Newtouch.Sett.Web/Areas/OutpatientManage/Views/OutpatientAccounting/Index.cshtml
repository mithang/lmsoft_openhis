                        return; //dòng này đang ở trạng thái sửa,không thể xóa
                    }

                    var matchedIndex = -1;
                    for (var ii = 0; ii < newxmList.length; ii++) {
                        if (newxmList[ii].newid === rowData.newid) {
                            matchedIndex = ii;
                        }
                    }

                    if (matchedIndex === -1) {
                        return; //có lẽ là bất thường
                    }

                    newxmList.remove(matchedIndex);   //gỡ khoản này

                    //đưa lạixmmảng hiển thị vàogrid
                    fillDataToGrid();
                    bottomButtonsReset();
                    //không ảnh hưởng đến các cái khác
                }
            }
        }
    }


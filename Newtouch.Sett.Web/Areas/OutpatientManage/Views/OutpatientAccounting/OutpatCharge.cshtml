
@{
    ViewBag.Title = "OutpatCharge";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    .form .formTitle {
        width: 87px;
    }

    .toolbar {
        width: 45% !important;
        margin: 10px 30px 12px;
    }
</style>
<div class="rows" style="float:left;width:25%;">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form" style="width:95%">
            <tr>
                <th class="formTitle">Ngày bắt đầu:</th>
                <td class="formValue">
                    <input id="ksrq" type="text" class="form-control input-wdatepicker form-an formClearIgnore"
                           onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy'})" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Ngày kết thúc:</th>
                <td class="formValue">
                    <input id="jsrq" type="text" class="form-control input-wdatepicker form-an formClearIgnore"
                           onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy'})" />
                </td>
            </tr>
            <tr>
                <td class="formValue" id="btn_">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary" style="width: 50px; margin-left: 105px;" value="Tra cứu" />
                </td>
            </tr>
        </table>
    </div>
    <div class="gridPanel">
        <table id="gridList"></table>
    </div>
</div>
<div class="rows" style="float:left;width:74%;margin-left:1%;">
    <form class="rows" style="margin-bottom: 1%;" id="formPat1">
        <div class="panel panel-default">
            <div class="panel-heading navb-bg">
                Thông tin cơ bản
            </div>
            <div style="padding: 2px;padding-right:20px;" id="divPatInfo">
                <table class="form">
                    <tr>
                        <th class="formTitle"><span class="required">*</span><label id="lbl_mzh">Số khám ngoại trú:</label></th>
                        <td class="formValue">
                            <input type="text" class="form-control" id="mzh" name="mzh" />
                            <label id="blh" hidden="hidden"></label>
                            <label id="xmnm" hidden="hidden"></label>
                            <label id="czlx" hidden="hidden"></label>@*Loại thao tác Thêm mới0/Sửa1/Xóa2*@
                        <td class="formValue" colspan="1">
                            <input type="button" class="btn btn-default btn-md btn-default-color" id="btnsyy" value="Tra cứu" onclick="GetPatSerarchView($('#mzh').val());" />
                            <input type="hidden" id="brxz" />
                        </td>
                        <th class="formTitle">Họ tên:</th>
                        <td class="formValue">
                            <label id="xm" style="width: 150%"></label>
                        </td>
                        <th class="formTitle">Giới tính:</th>
                        <td class="formValue">
                            <label id="xb"></label>
                        </td>
                        <th class="formTitle">Tuổi:</th>
                        <td class="formValue">
                            <label id="nlshow"></label>
                        </td>
                    </tr>
                    <tbody class="dispTbody" style="display:none;">
                        <tr>
                            <td class="formTitle">Số giấy tờ:</td>
                            <td class="formValue" colspan="2">
                                <label id="zjh"></label>
                            </td>
                            <td class="formTitle">Số điện thoại:</td>
                            <td class="formValue seWidth">
                                <label id="phone"></label>
                            </td>
                            <th class="formTitle">Ngày sinh:</th>
                            <td class="formValue seWidth">
                                <label id="csny"></label>
                            </td>
                            <th class="formTitle" hidden>Thời gian khám:</th>
                            <td class="formValue" colspan="2" hidden>
                                <label id="ghsj"></label>
                            </td>
                            <th class="formTitle" hidden>Người giới thiệu:</th>
                            <td class="formValue">
                                <label id="jsr" hidden></label>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="fa_icontoggle"><i class="fa fa-angle-double-down icontoggle" style="color:rgb(0, 160, 233);cursor:pointer;"></i></div>
            </div>
        </div>
    </form>
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading navb-bg">
            Khoản mục ghi sổ<strong id="sycs" style='text-decoration:none;'></strong>
        </div>
        <div id="divSLMX" style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle"><span class="required">*</span>Khoản thu phí:</th>
                    <td class="formValue">
                        <input id="sfxmmc" type="text" class="form-control form-an" />
                        <input id="sfxmCode" type="text" style="display:none;" class="form-control" />
                        <!-- Loại y lệnh 1Thuốc 2Khoản thu phí -->
                        <input id="yzlx" type="text" style="display:none;" class="form-control" />
                        <input id="sfdlCode" type="text" style="display:none;" class="form-control" />
                        <input id="sfdlmc" type="text" style="display:none;" class="form-control" />
                        <input id="zfbl" type="text" style="display:none;" class="form-control" />
                        <input id="zfxz" type="text" style="display:none;" class="form-control" />
                    </td>
                    <th class="formTitle"><span class="required" style="display:inline">*</span>Thời lượng đơn vị(phút):</th>
                    <td class="formValue">
                        <input id="duration" type="text" class="form-control form-an" value="" />
                    </td>
                    <th class="formTitle">Đơn vị:<label id="dw"></label></th>
                    <td class="formValue">
                        <div class="ckbox" style="float: right; padding-right: 0px;">
                            <input id="ttbz" name="ttbz" type="checkbox"><label for="ttbz">Trị liệu nhóm</label>
                        </div>
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Đơn giá(đồng):</th>
                    <td class="formValue" id="input1"></td>
                    <th class="formTitle"><span class="required">*</span>Số lượng:</th>
                    <td class="formValue">
                        <input id="sl" type="text" class="form-control form-an" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Kỹ thuật viên trị liệu:</th>
                    <td class="formValue">
                        <input id="zlsList" type="text" class="form-control form-an" />
                    </td>
                </tr>
                <tr>
                    <td class="formTitle"><span class="required">*</span>Ngày trị liệu:</td>
                    <td class="formValue">
                        <input id="jzsj" type="text" class="form-control input-wdatepicker form-an"
                               onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy'})" />
                        <span style="color: red; display: none">￥</span><a id="zje" style="display: none">0.00</a>
                        <input type="hidden" id="IsBlh" value="@ViewBag.IsBlh" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Loại phục hồi chức năng:</th>
                    <td class="formValue formDdlSelectorTd">
                        <select id="kflb" name="kflb" class="form-control">
                            <option value="">==Vui lòng chọn==</option>
                        </select>
                    </td>
                    <th class="formTitle">Ghi chú:</th>
                    <td class="formValue">
                        <input id="bz" type="text" class="form-control form-an form-an-end" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <strong style="text-decoration:none;float:left;padding-left:10px;line-height: 30px;">
        trangTổng số tiền:<span style='color:red;' id="ymzje">0.00</span>đồng,ChưaLưuSố tiền:<span style='color:red;' id="wqrje">0.00</span>đồng
    </strong>
    @Html.Partial("_MiddleButtonsView", new Newtouch.Sett.Web.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 2, 3, 6, 9 },
    F2Text = "Thêm",
    F3Text = "Sửa",
    F6Text = "Xóa",
    F9Text = "Hủy sửa",
    F9Hidden = true
})
    <div>
        <table id="gridMX"></table>
    </div>
    <table style="width:380px;height:20px; margin-top:10px;margin-left:10px; float:left; color:#274b6d">
        <tr>
            <td>
                <label style="height:7px;width:25px;background-color:#d9edf7; border:1px solid #ddd"></label>
            </td>
            <td>Biểu thị ghi sổ lịch sử</td>
            <td>
                <label style="height:7px;width:25px;background-color:#6ff3ad; border:1px solid #ddd"></label>
            </td>
            <td>Biểu thịSửaghi sổ lịch sử</td>
            <td>
                <label style="height:7px;width:25px;background-color:white;  border:1px solid #ddd"></label>
            </td>
            <td>Biểu thị ghi sổ mới</td>
        </tr>
    </table>
    @Html.Partial("_BottomButtonsView", new Newtouch.Sett.Web.Models.BottomButtonViewModel()
{
    ShowKeyList = new[] { 4, 7, 8, 10 },
    F7Text = "Mẫu",
    F8Text = "Gửi",
    F10Text = "Xem báo cáo"
})
</div>
<script>
    var Del_xmlist = [];//đã xóalist
    patInfoObj = {};//thông tin cá nhânObjectđối tượng
    var respblh;//xác thực số hồ sơ bệnh án
    var oldxmList = [];   //khoản đã gửi trước đâyList
    var newxmList = [];   //khoản mớiList
    var editingJzjhmxId = null;    //dòng đang sửa
    var editingNewid = null;    //dòng đang sửa
    var Editing_ysList = []; //kỹ thuật viên trị liệu trong vùng sửa
    var default_Editing_ysList;
    var ymzje = "0.00";//khoản thu phílisttổng số tiền
    var wqrje = "0.00";//tổng số tiền khoản thu phí chưa lưu
    $(function () {
        $("#ksrq").val($.getDate());
        $("#jsrq").val($.getDate());
        gridList();

        //tảiloại phục hồi chức năng
        $("#kflb").bindSelect({
            url: "/Com/GetSelectItemsDetailListByItemCode?code=RehabTreatmentMethod",
        });
        $("#kflb").val("RTM_PT").trigger("change");

        $("#lbl_mzh").html('@(ViewBag.IsBlh)' === "ON" ? "Số hồ sơ bệnh án:" : "Số khám ngoại trú:");
        $("#input1").html('@(ViewBag.sfxm_dj)' === 'ON' ? " <input id='dj' type='text' class='form-control form-an' />" : " <label id='dj'></label>");
        $('#btn_bottombutton_f3').attr('disabled', 'disabled');
        $('#btn_bottombutton_f6').attr('disabled', 'disabled');
        $("#jzsj").val($.getDate());

        //mặc địnhlàhiện tại
        default_Editing_ysList = [{ id: '@(ViewBag.CurYsStaffId)', gh: '@(ViewBag.CurYs)', Name: '@(ViewBag.CurYsmc)', ks: '@(ViewBag.CurKs)', ksmc: '@(ViewBag.CurKsmc)' }]; //kỹ thuật viên trị liệu trong vùng sửa

        setDefaultYsList();

        var keyValue = sessionStorage.getItem("mzh");
        if (!!keyValue) {
            addpatientmzh();
            $("#btn_search").trigger("click");
            searchPatInfo("OFF", keyValue);
            sessionStorage.removeItem("mzh")
        }

    });

    //khai báo khoản mụcchi tiết grid
    $("#gridMX").newtouchLocalDataGrid({
        height: $(window).height() - 353,
        unwritten: false,
        colModel: [
            { label: "newid", name: "newid", width: 80, align: "left", hidden: true },
            { label: "Khoản thu phí", name: "sfxmCode", width: 80, align: "left", hidden: true },
            { label: "Loại y lệnh", name: "yzlx", width: 150, align: "left", hidden: true },
            { label: "Khoản thu phí", name: "sfxmmc", width: 150, align: "left" },
            { label: "Loại", name: "sfdlCode", align: "left", hidden: true },
            { label: "Trị liệu theo nhóm", name: "ttbz", align: "left", hidden: true },
            { label: "Loại", name: "sfdlmc", width: 100, align: "left" },
            { label: "Đơn vị", name: "dw", width: 70, align: "left" },
            { label: "Thời lượng đơn vị", name: "duration", width: 70, align: "left" },
            {
                label: "Đơn giá(đồng)", name: "dj", width: 70, align: "left",
                formatter: function (val) {
                    return val > 0 ? parseInt(val).toFixed(4) : "0.0000";
                }
            },
            { label: "Số lượng", name: "sl", width: 100, align: "left" },
            {
                label: "Kỹ thuật viên trị liệu", name: "ysList", width: 120, align: "left", formatter: function (cellvalue) {
                    return getYsNamesByList(cellvalue);
                }
            },
            { label: "Tổng số tiền(đồng)", name: "zje", width: 70, align: "left", formatoptions: { decimalPlaces: 2, defaultValue: '0.00' } },
            { label: "Ghi chú", name: "bz", width: 100, align: "left" },
            {
                label: "Ngày trị liệu", name: "jzsj", width: 100, align: "left", formatter: function (val) {
                    if (val) {
                        return val.length > 9 ? val.substring(0, 10) : "";
                    }
                    return "";
                }
            },
            { label: "Loại phục hồi chức năng", name: "kflb", width: 50, align: "left", hidden: true },
            { label: "Mã nội bộ khoản mục", name: "xmnm", hidden: true },
            { label: "", name: "czlx", hidden: true },
            { label: "", name: "zfbl", hidden: true },
            { label: "", name: "zfxz", hidden: true }
        ],
        ondblClickRow: function (rowid) {
            gridEditRow(rowid);
        },
        onSelectRow: function (rowid) {
            $('#btn_bottombutton_f3').removeAttr('disabled');
            $('#btn_bottombutton_f6').removeAttr('disabled');
        },
        gridComplete: function (data) {
            var ids = $("#gridMX").jqGrid('getDataIDs');
            for (var i = 0; i < ids.length; i++) {
                var rowData = $("#gridMX").jqGrid('getRowData', ids[i]);
                if (rowData && rowData.xmnm) {
                    if (rowData.xmnm != '') {//chưa xác nhận
                        if (rowData.czlx == "1") {//sửa
                            $('#gridMX tr[id="' + ids[i] + '"]').css("background-color", "#6ff3ad");//.addClass('complete');
                        } else {
                            $('#gridMX tr[id="' + ids[i] + '"]').css("background-color", "#d9edf7");//.addClass('info');
                        }
                    }
                }
            }
        }
    });
    function gridList() {
        if ($("#ksrq").val() == "" && $("#jsrq").val() == "") {
            $.modalAlert("Ngày bắt đầu và ngày kết thúc không được cùng trống", 'warning');
            return;
        }
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/OutpatientManage/OutpatientAccounting/GetRegisterGridJson",
            postData: { begindate: $("#ksrq").val(), enddate: $("#jsrq").val() },
            height: $(window).height() - 195,
            colModel: [
                { label: 'Số hồ sơ bệnh án', name: 'blh', width: 60, align: 'left' },
                { label: 'Họ tên', name: 'xm', width: 50, align: 'left' },
                {
                    label: 'Tổng chi phí', name: 'zje', width: 50, align: 'left', formatter: function (val) {
                        return val > 0 ? parseInt(val).toFixed(2) : "0.00";
                    }
                },
                { label: 'Số khám ngoại trú', name: 'mzh', width: 100, align: 'left', key: true },
                 {
                     label: 'Ngày đăng ký khám', name: 'ghrq', width: 80, align: 'left', formatter: function (val) {
                         return val.length > 9 ? val.substring(0, 10) : "";
                     }
                 }
            ],
            rowNum: '10',
            viewrecords: true,
            ondblClickRow: function (rowid) {
                gridEditRegisterRow(rowid);
            },
        });
        $("#btn_search").click(function () {
            if ($("#ksrq").val() == "" && $("#jsrq").val() == "") {
                $.modalAlert("Ngày bắt đầu và ngày kết thúc không được cùng trống", 'warning');
                return;
            }
            if ($('#ksrq').val() && $('#jsrq').val() && ($('#ksrq').val() > $('#jsrq').val())) {
                $.modalAlert("Ngày bắt đầu không được lớn hơn ngày kết thúc", 'warning');
                return;
            }
            $gridList.jqGrid('setGridParam', {
                postData: { begindate: $("#ksrq").val(), enddate: $("#jsrq").val() }
            }).trigger('reloadGrid');
        });
    }
    //nhấn đúp bên tráilist
    function gridEditRegisterRow() {
        var keyValue = $("#gridList").jqGridRowValue().mzh;
        if (!!keyValue) {
            addpatientmzh();
            searchPatInfo("OFF", keyValue);
        }
    }

    //làm mới thông tin cơ bản bệnh nhânvàđang ghicủaghi sổ,ghi sổ lịch sử
    function addpatientmzh() {
        $("#gridMX").clearGridData();
        $('#xm,#xb,#nlshow,#jsr,#zjlx,#zjh,#csny,#sycs,#ghsj').html('');

        $('#sfxmmc').val('');
        $('#sfxmCode').val('');
        $('#sfdlCode').val('');
        $('#sfdlmc').val('');
        $('#zfbl').val('');
        $('#zfxz').val('');
        $('#dw').html('');
        //$('#dj').html('');
        if ('@(ViewBag.sfxm_dj)' === 'ON') {
            $('#dj').val('0.0000')
        } else {
            $('#dj').html('0.0000');
        }
        $('#yzlx').val('');
        $('#duration').val('');
        $('#sl').val('');
        $('#zje').html('0.00');
        $('#ttbz').removeAttr('checked');
        $("#kflb").val("RTM_PT").trigger("change");
        $('#xmnm').val('');
        $("#czlx").val('');
        $('#mzh').val('');
        wqrje = '0.00';
        ymzje = '0.00';
        $("#wqrje").html(wqrje);
        $("#ymzje").html(ymzje);
        oldxmList = [];   //khoản đã gửi trước đâyList
        newxmList = [];   //khoản mớiList
        var Editing_ysList = [];
        var Del_xmlist = [];//đã xóalist
        editingNewid = null;    //dòng đang sửa
        patInfoObj = {};//thông tin cá nhânObjectđối tượng
        bottomButtonsReset();
    }

    //số hồ sơ bệnh ánnhấn Enter
    $("#mzh").keydown(function (event) {
        var keyword = $.trim($("#mzh").val());
        if (event.keyCode === 13) {
            setTimeout(function () {
                if (keyword == null || keyword == undefined || keyword == "") {
                    $.modalAlert("Vui lòng nhập số hồ sơ bệnh án hợp lệ", 'warning');
                    return false;
                } else {
                    searchPatInfo('@(ViewBag.Isblh)', keyword);
                }
            }, 0);
            event.preventDefault ? event.preventDefault() : (event.returnValue = false);
        }
    });

    //theosố hồ sơ bệnh ánlấythông tin cơ bản bệnh nhân
    function searchPatInfo(IsBlh, keyword) {
        $.loading(true, "Đang yêu cầu dữ liệu...");
        $.ajax({
            type: "POST",
            url: "/OutpatientManage/OutpatientAccounting/GetpatientAccountInfo",
            data: { IsBlh: IsBlh, mzh: keyword },
            dataType: "json",
            cache: true,
            async: true,
            success: function (ajaxresp) {
                if (ajaxresp.state === 'success') {
                    $("#gridMX").clearGridData();
                    oldxmList = [];   //khoản đã gửi trước đâyList
                    newxmList = [];   //khoản mớiList
                    funcDoPageClear(); //xóa
                    if (ajaxresp.data.length > 1) {
                        GetPatSerarchView(keyword);
                    } else {
                        if (!!ajaxresp.data.OutpatAccInfoDto) {
                            respblh = ajaxresp.data.OutpatAccInfoDto.mzh;
                            setPatInfoModel(ajaxresp.data.OutpatAccInfoDto); //gán thông tin cơ bản cá nhân
                        }
                        if ((!!ajaxresp.data.OptimAccInfoDto) && ajaxresp.data.OptimAccInfoDto.length > 0) {
                            newxmList = ajaxresp.data.OptimAccInfoDto;
                        }
                        fillDataToGrid();
                    }

                } else if (ajaxresp.state === 'error') {
                    $.modalAlert("Tra cứu thất bại", 'error');
                }
            },
            complete: function () {
                $.loading(false);
            }
        });
    }


    //tra cứu
    function GetQueryFphAjax(obj) {
        searchPatInfo("OFF", obj.mzh);
    }

    function funcDoPageClear() {
        $("#gridMX").newtouchLocalDataGrid(null, oldxmList);
        $("#sycs").html('');
    }

    //điền thông tin cơ bản bệnh nhân
    function fillInfo(rep) {
        setPatInfoModel(rep);
    }

    //khởi tạo thông tin bệnh nhân
    function setPatInfoModel(patModel) {
        $('#formPat1').formSerialize(patModel);

        $("#mzh").val('@(ViewBag.IsBlh)' === "ON" ? patModel.blh : patModel.mzh);
        $("#blh").html('@(ViewBag.IsBlh)' === "ON" ? patModel.mzh : patModel.blh);
        $("#xb").html($.getGender(patModel.xb));
        $("#csny").html((patModel.csny && patModel.csny.length >= 10 ? patModel.csny.substring(0, 10) : ""));
        $("#zjh").html(patModel.zjh);
        $("#jsr").html(patModel.jsr);
        $("#xm").html(patModel.xm);
        $("#nlshow").html(getAgeFromBirthTime({ begin: patModel.csny }).text);
        $("#phone").html(patModel.phone);
        $("#jzsj").val(patModel.ghrq && patModel.ghrq.length >= 10 ? patModel.ghrq.substring(0, 10) : "");
        if (patModel.sycs) {
            $('#sycs').html("&nbsp&nbsp&nbsp&nbspBảo hiểm còn lại<span style='color:red'>" + patModel.sycs + "</span>lần");
        }
        $("#brxz").val(patModel.brxz);
        //tảithông tin bệnh nhân
        patInfoObj.xm = patModel.xm; //họ tên
        patInfoObj.xb = patModel.xb; //giới tính
        patInfoObj.csny = patModel.csny;
        patInfoObj.patid = patModel.patid; //mã nội bộ bệnh nhân
        patInfoObj.blh = patModel.blh; //số hồ sơ bệnh án
        patInfoObj.zjh = patModel.zjh; //số giấy tờ
        patInfoObj.jsr = patModel.jsr; //người giới thiệu
        patInfoObj.brxz = patModel.brxz;//tính chất bệnh nhân
        patInfoObj.mzh = patModel.mzh;//số khám ngoại trú
        patInfoObj.ghsj = patModel.ghsj;//ngày trị liệu
        var type = patModel.zjlx;
        switch (type) {
            case "1":
                type = "CMND/CCCD";
                break;
            case "2":
                type = "Hộ chiếu";
                break;
            case "3":
                type = "Chứng minh sĩ quan";
                break;
            default:

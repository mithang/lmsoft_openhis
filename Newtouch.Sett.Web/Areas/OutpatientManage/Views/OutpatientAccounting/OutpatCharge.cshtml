    //phân tíchbác sĩmảng,lấybác sĩchuỗi tên
    function getYsNamesByList(ysList) {
        if (ysList) {
            //phân tíchkỹ thuật viên trị liệu[{},{}]lấychuỗi
            var str = "";
            $.each(ysList, function () {
                str += this.Name + ',';
            });
            if (str.length > 0) {
                str = str.substring(0, str.length - 1);
            }
            return str;
        }
        return "";
    }

    //phần tử trong trang,tínhtổng số tiền
    function reCalcZjeFromTxt() {
        var resultZje = "0.00";
        var txtDj = '@(ViewBag.sfxm_dj)' === 'ON' ? $("#dj").val() : $("#dj").html();
        var txtSl = $('#sl').val();
        if (txtDj && txtSl) {
            if (!isNaN(txtDj) && !isNaN(txtSl)) {
                resultZje = roundingBy4she6ru5chengshuang((parseFloat(txtDj) * parseFloat(txtSl)), 2);
            }
        }
        $('#zje').html(resultZje);
    }



    //chọn mẫu
    function GetTemplate() {
        var yslist = "";
        var zlslist = $("#zlsList").val();
        if (!zlslist) {
            $.modalAlert("Vui lòng chọn kỹ thuật viên trị liệu", 'warning');
            return;
        }
        if (!Editing_ysList || Editing_ysList.length === 0) {
            $.modalAlert("Vui lòng chọn kỹ thuật viên trị liệu", 'warning');
            return;
        }
        if (!$("#jzsj").val()) {
            $.modalAlert("Vui lòng chọn ngày trị liệu", 'warning');
            return;
        }
        $.each(Editing_ysList, function (idx, val) {
            yslist += val.ks + ",";
        });
        yslist = yslist.substring(0, yslist.length - 1);
        if (yslist && zlslist) {
            $.modalOpen({
                id: "Form",
                title: "Cửa sổ mẫu khoản thu phí",
                url: "/HospitalizationManage/BookkeepInHos/ChargeItemTemplate?keyValue=" + yslist,
                width: "700px",
                height: "530px",
                callBack: function (iframeId) {
                    var data = top.frames[iframeId].submitForm();
                    $.each(data, function (idx, val) {
                        val.newid = Math.random().toString() + new Date().getMilliseconds();   //newid()
                        val.zje = roundingBy4she6ru5chengshuang((parseFloat(val.dj) * parseFloat(val.sl)), 2); //val.sl * val.dj;
                        val["sfxmCode"] = val["sfxm"];
                        val["sfdlCode"] = val["dl"];
                        val["sfdlmc"] = val["dlmc"];
                        val.yzlx = 2;
                        val.ysList = Editing_ysList;
                        val.bz = $("#bz").val();
                        val.jzsj = $("#jzsj").val();
                        val.xmnm = "";
                        newxmList.unshift(val);   //thêm dưới dạng khoản mới //”đầu mảng“
                        wqrje = roundingBy4she6ru5chengshuang(parseFloat(wqrje) + parseFloat(val.zje), 2);
                    });
                    $('#wqrje').html(wqrje);
                    editingNewid = null;    //?vào trạng thái sửa,sau đó nhấn thêm？
                    //đưa lạixmmảng hiển thị vàogrid
                    fillDataToGrid();
                    top.top.window.frames['Form'].$.modalClose();   //đóng nó
                }
            });
        } else {
            $.modalAlert("Vui lòng chọn kỹ thuật viên trị liệu！", 'warning');
        }
    }


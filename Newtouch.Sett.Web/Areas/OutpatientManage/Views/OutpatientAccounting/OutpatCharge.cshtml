    function reCalcZje(xm) {
        if (xm) {
            if (xm.tdxmList && xm.tdxmList.length > 0) {
                //cóthay thếkhoản mục,dùng nó để tínhtổng số tiền
                xm.zje = 0;
                $.each(xm.tdxmList, function () {
                    xm.zje += this.dj * this.sl;
                });
            }
            else {
                xm.zje = roundingBy4she6ru5chengshuang((parseFloat(xm.dj) * parseFloat(xm.sl)), 2);//xm.dj * xm.sl; //tính phí bằng khoản trị liệu
                ymzje = (parseFloat(ymzje) + parseFloat(xm.zje)).toFixed(2);
            }
        }
    }


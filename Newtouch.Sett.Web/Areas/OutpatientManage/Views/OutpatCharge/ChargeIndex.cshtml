
@{
    ViewBag.Title = "ChargeIndex";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control form-control-focus" placeholder="Vui lòng nhập số thẻ" style="width: 200px;">
                    </div>
                </td>
                <td style="padding-left:12px;">
                    <div class="btn-group" id="btnKeywordTypeGourp" style="margin-top:0;">
                        <button type="button" data-keywordtype="kh" class="btn active btn-restore">&nbsp;thẻ&nbsp;&nbsp;số&nbsp;</button>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<form name="form1" id="formPat1">
    <div class="panel panel-default" style="margin-top:10px;">
        <div class="panel-heading navb-bg">
            Thu phí
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle"><span class="required">*</span>Số thẻ:</th>
                    <td class="formValue">
                        <input type="text" class="form-control newtouch_Readonly" id="kh" name="kh" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Số khám ngoại trú:</th>
                    <td class="formValue">
                        <input type="text" class="form-control newtouch_Readonly" id="mzh" name="mzh" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Số hồ sơ bệnh án:</th>
                    <td class="formValue">
                        <input type="text" class="form-control newtouch_Readonly" id="blh" name="blh" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Số hóa đơn:</th>
                    <td class="formValue">
                        <input type="text" id="txtfph" class="form-control  formClearIgnore newtouch_Readonly" style="width: 50%;display: inline;" />
                        <input type="button" class="btn btn-default btn-md" value="Số hóa đơn " onclick="ShowInvoicePanel()" />
                    </td>
                </tr>
            </table>
        </div>
        <hr />
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle"><span class="required">*</span>Họ tên:</th>
                    <td class="formValue">
                        <input type="text" class="form-control newtouch_Readonly" id="xm" name="xm" />
                    </td>
                    <th class="formTitle">Giới tính:</th>
                    <td class="formValue">
                        <input type="text" class="form-control newtouch_Readonly" id="xb" name="xb" />
                    </td>
                    <th class="formTitle">Ngày sinh:</th>
                    <td class="formValue">
                        <input type="text" class="form-control newtouch_Readonly" id="csny" name="csny" />
                    </td>
                    <th class="formTitle">Khám lần đầu/tái khám:</th>
                    <td class="formValue">
                        <input type="text" class="form-control newtouch_Readonly" id="fzbz" name="fzbz" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle"><span class="required">*</span>Tính chất bệnh nhân:</th>
                    <td class="formValue">
                        <input type="text" class="form-control newtouch_Readonly" id="brxzmc" name="brxzmc" />
                    </td>
                </tr>
            </table>
        </div>
        <hr />
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle"><span class="required">*</span>Đăng ký khám:</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="mzgh" name="mzgh" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Bác sĩ:</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="ys" name="ys" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Khoa:</th>
                    <td class="formValue">
                        <input type="text" class="form-control newtouch_Readonly" id="ks" name="ks" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Đơn giá:</th>
                    <td class="formValue">
                        <input type="text" class="form-control newtouch_Readonly" id="dj" name="dj" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle"><span class="required">*</span>Khoản thu phí:</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="sfxm" name="sfxm" placeholder="Vui lòng nhập chính xácTra cứuđiều kiện" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Số lượng:</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="sl" name="sl" />
                    </td>
                    <th class="formTitle">Số nhóm:</th>
                    <td class="formValue">
                        <input type="text" class="form-control formClearIgnore" id="czh" name="czh" />
                    </td>
                    <th class="formTitle">Đơn vị:</th>
                    <td class="formValue">
                        <input type="text" class="form-control newtouch_Readonly" id="dw" name="dw" />
                    </td>

                </tr>
            </table>
        </div>
    </div>

</form>
<form id="tabGrid">
    <div>
        <div class="gridPanel">
            <table id="listGrid" rel="tabGrid"></table>
        </div>
    </div>
</form>
<div class="panel-heading" id="panelZje">
    <div style="margin-left:40%;">
        <table>
            <tbody>
                <tr>
                    <th class="formTitle">
                        Số đơn thuốc hiện tại:
                    </th>
                    <td class="formValue"><label id="lbldqcfh" style="padding-right:20px;"></label></td>
                    <th class="formTitle">
                        Số tiền đơn thuốc hiện tại:
                    </th>
                    <td class="formValue"><label id="lbldqxmje">0.00</label>đồng</td>
                    <th class="formTitle">
                        Tổng số tiền đơn thuốc:
                    </th>
                    <td class="formValue"><label id="lblzje">0.00</label>đồng</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<!--Thu phí ngoại trú-->
@Html.Partial("ChargeAddPay")
<div style="clear:both;"></div>
<!--Thanh công cụ nút-->
<div class="toolbar toolbarfloat">
    <a class="btn btn-primary" onclick="newtouch_globalevent_f4()"><i class="fa fa-close"></i> F4:Xóa</a>
    <a class="btn btn-primary" onclick="ChangeCF()"><i class="fa fa-edit"></i>Đổi đơn</a>
    <a class="btn btn-primary" onclick="newtouch_globalevent_f8()"><i class="fa fa-save"></i> F8:Lưu</a>
    <a class="btn btn-primary" onclick="ItemPlate()"><i class="fa "></i>Mẫu</a>
    <a class="btn btn-primary" onclick="DeleteGrid()"><i class="fa fa-delete"></i>Xóa</a>
</div>

<script>
    $(function () {
        localStorage.clear();
        loadPage();
        //khi cửa sổ trình duyệt đổi kích thước thì tải lạitảijqGridcủarộng
        $(window).resize(function () {
            initLayout("tabGrid");
        });
        var txtKeyword = document.getElementById('txt_keyword');
        txtKeyword.addEventListener('keydown', function (event) {
            event = event || window.event;
            if (event.keyCode === 13) {
                var keyword = $.trim($("#txt_keyword").val());
                searchPatInfo(keyword);
            }
        });

        //số thẻnhấn Enter
        $("#kh").keyup(function (event) {
            var keyword = $.trim($("#kh").val());
            if (event.keyCode === 13) {
                if (keyword == null) {
                    $.modalAlert("Vui lòng nhập số thẻ hợp lệ", 'warning');
                    return false;
                } else {
                    searchPatInfo(keyword);
                }
            }
        });

        //khoản thu phíbindlớp nổi
        loadYpItemData();

        //đăng ký khámnhấn Enter
        bindGHSource(mzghData);

        //bác sĩbinglớp nổi
        bindDoctors();

        GetNewCFH(); //lấy số đơn thuốc mới

        //khoanhấn Enter
        $("#ks").keyup(function (event) {
            var ks = $("#ks").val();
            if (event.keyCode === 13) {
                if (ks == null) {
                    $.modalAlert("Khoa không được trống", 'warning');
                    return false;
                } else {
                    //thêm thông tin nhậpcủaxác định
                    AddData_Check();
                }
            }
        });

        //số nhómnhấn Enter
        $("#czh").keyup(function (event) {
            if ($(this).hasClass('form-an-cur')) {
                return; //vừa tự động nhảy từ nút trước đó sang
            }
            if (event.keyCode == 13) {
                //thêm thông tin nhậpcủaxác định
                AddData_Check();
            }
        });

        //số tiền thanh toánnhấn Enter
        $("#txtmoney").keyup(function (event) {
            if (event.keyCode == 13) {
                zfje = $("#txtmoney").val();  //số tiền thanh toán
                ysk = $("#txtysk").val(); //số tiền phải thu
                zl = parseFloat(zfje) - parseFloat(ysk);
                zl = zl.toFixed(2);
                $("#txtzl").val(zl);
            }
        });

        //chọn tất cả
        $("#tabGrid input[type=checkbox]:eq(0)").bind("click", function () {
            grid_checkedit();
            if ($(this)[0].checked == true) {
                //đã chọn
            }
        });

    });

    //khởi tạo trangtxtysk
    function loadPage() {
        GetInvoiceListByEmpCode(); //lấy số hóa đơn
        $('#listGrid').jqGrid("clearGridData");//xóa dữ liệu trước
        gridListData([]); //tảijqGrid

        //số thành nhóm
        $("#czh").val(0);
        //lấyngàykỳ
        $("#txtzfrq").val($.getDate);
        //khởi tạo số tiềnlà0
        $("#lbldqxmje,#lblzje").text("0.00");
        $("#lbldqcfh").text("");
        $("#txtysk,#txtzl").val("0.00");
        $("#mzgh,#ys").removeAttr("disabled").css("background-color", "white");
        myCFData = [];
        myCFCount = 0;
        localStorage.removeItem("brxzData");
    }

    var mzghData = [], //dữ liệu đăng ký khám ngoại trú
        mzghDocVo = null, //đăng ký khám ngoại trú-khoa chuyên gia
        myCFData = [],    //tập hợp dữ liệu danh sách đơn thuốc
        myCFCount = 0,   //số dòng danh sách đơn thuốc
        iszhbrxz = false, //xác định tính chất bệnh nhân có phải là tính chất kết hợp không
        zh_sbrxz = "", //đầu、tính chất bệnh nhân cuối
        zh_sbrxzmc = "",
        zh_mbrxz = "",
        zh_mbrxzmc = "",
        zh_sbrxzbh = 0,
        zh_mbrxzbh = 0,
        lsCfh = "",     //số đơn thuốc tạm thời
        sfxmbh = "",   //khoản thu phíintmã số loại
        sfxmcbh = "",   //khoản thu phícharmã số loại
        sfxmzfbl = "",  //tỷ lệ tự chi trả khoản thu phí
        sfxmdlmc = "",  //tên nhóm lớn khoản thu phí
        sfxmdl = "",    //nhóm lớn khoản thu phí
        sfxmzfxz = "",  //tính chất tự chi trả khoản thu phí
        sfxmtype = "",  //loại khoản thu phí（ví dụ:khoản mục đăng ký khám、khoản mục loại đơn thuốc、xét nghiệm、kiểm tra）
        sfxmypgg = "", //quy cách thuốc
        sfxmNbdl = "", //nhóm lớn bảo hiểm nông nghiệp
        sfxmYbdm = "", //mã BHYT
        sfxmkeyword = "", //điều kiện nhập khoản thu phí đã lưu
        //ysksbh = "", //bác sĩkhoamã số
        mzgh = "", //đăng ký khám
        ks = "", //khoaCODE
        ysbh = "", //mã bác sĩ
        ys = "", //bác sĩCODE
        lsysbh = "", //dùng khi đăng ký khám là số chuyên gia
        ghnm = "", //mã nội bộ đăng ký khám
        brxz = "", //tính chất bệnh nhân
        patInfoObj = {}, //thông tin cá nhânObjectđối tượng
        mzYbjylx = 0,//loại giao dịch BHYT
        mjzbz = "", //dấu hiệu khám ngoại trú/cấp cứu
        stateSave = true,//xác định dữ liệu có thay đổi không
        isYbbr = false,//có phải bệnh nhân BHYT không
        isNdzdbxm = false,//có phải khoản bệnh nặng urê huyết không
        isPtdbxz = false,//có phải bệnh nặng thường không
        lsCzh = "",//số thành nhóm
        yfCode = "",//mã nhà thuốc
        ypbzdm = "",//mã đóng gói
        sfxmfwf = "", //phí dịch vụ khoản thu phí
        cffwf = new Object(),  //dữ liệu máy chủ trả về về phí dịch vụ khoản thu phí đơn thuốc
        jeNum = 0, //số tiền khoản mục hiện tại （bao gồm phí dịch vụ）
        dqzje = 0, //tổng số tiền hiện tại
        cfzje = 0, //tổng số tiền đơn thuốc
        dqcfhList = [], //lưu số đơn thuốc hiện tại
        messCFXM = "", //thông tin lỗi thuốc giống nhau
        kh = "";//số thẻ

    //lấy số hóa đơn
    function GetInvoiceListByEmpCode() {
        $.najax({
            url: "/OutpatientManage/OutpatientReg/GetInvoice?r=" + Math.random(),  //chú ý
            dataType: "text",
            async: false,
            success: function (data) {
                $("#txtfph").val(data);
                fph = data;
            }
        });
    }

    //bật lênsố hóa đơncủacửa sổ
    function ShowInvoicePanel() {
        $.modalOpen({
            id: "InvoiceNoPanel",
            title: "Chọn số hóa đơn",
            url: "/OutpatientManage/OutpatientReg/ChooseInvoice?r=" + Math.random(),
            width: "300px",
            height: "200px",
            callBack: function (iframeId) {
                top.frames[iframeId].checkFPH();//hàm gọi lại khi nhấn xác nhận trên cửa sổ
            }
        });
    }

    //theosố thẻlấythông tin cơ bản bệnh nhân
    function searchPatInfo(keyword) {
        if (keyword === '') {
            return false;
        }
        kh = keyword;
        $.najax({
            type: "POST",
            url: "/OutpatientManage/OutpatCharge/ChargeIndex",
            data: { kh: keyword, brxz: "" },
            dataType: "json",
            success: function (ajaxresp) {
                funcDoPageClear();//xóa
                var mzghbrxzData = ajaxresp.data.patInfo.brxzList;
                if (mzghbrxzData && mzghbrxzData.length && mzghbrxzData.length > 1) {
                    //bật lên nhiềutính chất bệnh nhâncủacửa sổ
                    bindBrxz();
                }
                else if (mzghbrxzData == null)//chỉ có một tính chất bệnh nhân
                {
                    setPatInfoModel(ajaxresp.data.patInfo); //gán thông tin cơ bản cá nhân
                    mzghData = ajaxresp.data.ghItemList; //gắn thông tin đăng ký khám
                    mzghDocVo = ajaxresp.data.ghDocVo; //thông tin chuyên gia
                }
            },
            errorCallback: function (ajaxresp) {
                window.newtouch_globalevent_f4(); //xóa
            }
        });
    };

    //xóathao tác
    var funcDoPageClear = function () {
        loadPage();
    };

    //khởi tạo thông tin bệnh nhân
    function setPatInfoModel(patModel) {
        $('#formPat1').formSerialize(patModel);
        $("#xb").val($.getGender(patModel.xb));
        $("#csny").val((patModel.csny && patModel.csny.length >= 10 ? patModel.csny.substring(0, 10) : ""));
        $("#fzbz").val(patModel.fzbz == "1" ? "Tái khám" : "Khám đầu tiên");
        brxz = patModel.brxz;
        //tảithông tin bệnh nhân
        patInfoObj.kh = patModel.kh;  //số thẻ bệnh nhân
        patInfoObj.xm = patModel.xm; //họ tên
        patInfoObj.xb = patModel.xb; //giới tính
        patInfoObj.csny = patModel.csny;
        patInfoObj.patid = patModel.patid; //mã nội bộ bệnh nhân
        patInfoObj.brxz = patModel.brxz;  //tính chất bệnh nhân
        patInfoObj.brxzbh = patModel.brxzbh; //mã tính chất bệnh nhân
        patInfoObj.brxzmc = $("#brxzmc").val();
        patInfoObj.blh = patModel.blh; //số hồ sơ bệnh án
        patInfoObj.zjh = patModel.zjh; //số giấy tờ
        patInfoObj.zjlx = patModel.zjlx; //loại giấy tờ
    }

    //tảitính chất bệnh nhân
    function bindBrxz() {
        localStorage.setItem("brxzData", JSON.stringify(mzghbrxzData));
        $.modalOpen({
            id: "BrxzForm",
            title: "Cửa sổ tính chất bệnh nhân",
            url: "/OutpatientManage/OutpatCharge/ChargeBrxzDialog?r=" + Math.random(),
            width: "300px",
            height: "350px",
            callBack: function (iframeId) {

            }
        });
    }

    //saumáy theotính chất bệnh nhânvàsố thẻajaxtra cứu nhân viêndữ liệu
    function getChargeInfoAjax(patobj) {
        var cardNo = $("#txt_keyword").val();
        $.najax({
            type: "POST",
            url: "/OutpatientManage/OutpatCharge/ChargeIndex?r=" + Math.random(),
            data: { kh: cardNo, brxz: patobj.brxz },
            dataType: "json",
            success: function (ajaxresp) {
                funcDoPageClear();//xóa
                setPatInfoModel(ajaxresp.data.patInfo); //gán thông tin cơ bản cá nhân
                mzghData = ajaxresp.data.ghItemList; //gắn thông tin đăng ký khám
                mzghDocVo = ajaxresp.data.ghDocVo; //thông tin chuyên gia
            },
            errorCallback: function (err) {
                $.loading(false);
                newtouch_globalevent_f4(); //xóa
            },
            complete: function () {
                $.loading(false);
            }
        });
    }


    //tảiđăng ký khámdữ liệu
    function bindGHSource() {
        $("#mzgh").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 200,
            width: 600,
            filter: function () {
                return mzghData;
            },
            caption: "Chọn đăng ký khám",
            colModel: [
                { label: 'Tài nguyên', name: 'gh_ks', widthratio: 25 },
                { label: 'ghnm', name: 'ghnm', widthratio: 25, hidden: true },
                { label: 'ks', name: 'ks', widthratio: 25, hidden: true },
                { label: 'ts', name: 'ys', widthratio: 25, hidden: true },
                { label: 'mjzbz', name: 'mjzbz', widthratio: 25, hidden: true },
                { label: 'dbxm', name: 'dbxm', widthratio: 25, hidden: true },
                { label: 'fzbz', name: 'fzbz', widthratio: 25, hidden: true },
                { label: 'Đăng ký khám', name: 'ghName', widthratio: 25 },
                { label: 'Khoa', name: 'ksName', widthratio: 15 },
                { label: 'Ngày đăng ký khám', name: 'CreateTime', widthratio: 35 }
            ],
            itemdbclickhandler: function ($thistr) {
                //gán giá trị
                $("#mzgh").val($thistr.attr("data-ghName"));
                $("#ks").val($thistr.attr("data-ksName"));
                $("#fzbz").val($thistr.attr("data-fzbz") === "1" ? "Tái khám" : "Khám đầu tiên");

                ghnm = $thistr.attr("data-ghnm");
                //ysksbh = $thistr.attr("data-ksbh");
                mzgh = $thistr.attr("data-ghName");
                ks = $thistr.attr("data-ks");
                mjzbz = $thistr.attr("data-mjzbz");
                var lsys = $thistr.attr("data-ys");

                // QA-phase2 (SETT-05): same null guard as ChargeAddPay —
                // doctorInHosBookkeep is absent from the standalone clients
                // bootstrap, so $.each(undefined) would throw on use.
                $.each((top.window.clients && top.window.clients.doctorInHosBookkeep) || [], function (idx, val) {
                    if (val.ks === ks && val.StaffGh === lsys) {
                        ys = val.StaffGh;
                        $("#ys").val(val.StaffName);
                    }
                });
                if (mzghDocVo != null && mzghDocVo.ry) {
                    $("#ys").val(mzghDocVo.rymc);
                    ys = mzghDocVo.gh;
                    if (mjzbz !== "2") {
                        //ysksbh = mzghDocVo.ksbh;
                        ks = mzghDocVo.ks;
                    }
                }
            }
        });
    }

    //tảibác sĩthông tin
    function bindDoctors() {
        ///bác sĩ
        $("#ys").newtouchFloatingSelector({
            height: 300,
            width: 500,
            filter: function (keyword) {
                if (ghnm == "") {
                    $modelAlert("Đăng ký khám không được trống", "warning");
                    return false;
                }
                if (!keyword) {
                    return false;
                }
                //duyệtdữ liệunguồn,dùngkeywordđể lọc rakết quả
                var resultObjArr = new Array();//
                // QA-phase2 (SETT-05): null guard, see ChargeAddPay note.
                $.each((top.window.clients && top.window.clients.doctorInHosBookkeep) || [], function (idx, val) {
                    if ($.trim(keyword).length == 0 || (val.py && val.py.toUpperCase().indexOf(keyword.toUpperCase()) >= 0) || (val.rymc && val.rymc.indexOf(keyword.toLowerCase()) >= 0) || (val.gh && val.gh.indexOf(keyword.toLowerCase()) >= 0) || (val.kspy && val.kspy.indexOf(keyword.toUpperCase()) >= 0)) {
                        if (ghnm && val.ks == ks) {
                            resultObjArr.push(val);
                        }
                    }
                });
                return resultObjArr;

            },
            caption: "Đối chiếu bác sĩ - khoa",
            colModel: [
                { label: 'Tên nhân viên', name: 'rymc', widthratio: 25 },
                { label: 'rygh', name: 'rygh', widthratio: 25, hidden: true },
                { label: 'ry', name: 'ry', widthratio: 25, hidden: true },
                { label: 'Tên khoa', name: 'ksmc', widthratio: 25 },
                //{ label: 'ksbh', name: 'ksbh', widthratio: 25, hidden: true },
                { label: 'ks', name: 'ks', widthratio: 25, hidden: true }

            ],
            itemdbclickhandler: function ($thistr) {
                $("#ys").val($thistr.attr("data-rymc"));

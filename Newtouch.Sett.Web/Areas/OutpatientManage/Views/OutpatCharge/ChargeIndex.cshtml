        obj.czh = $("#czh").val(); //số nhóm
        obj.yfdm = yfCode;
        obj.ypbzdm = ypbzdm;
        obj.fwfdj = sfxmfwf; //phí dịch vụ khoản thu phí
        obj.nbdl = sfxmNbdl;
        obj.ybdm = sfxmYbdm;
        //nếu đã thêmkhoản mụchoặcthuốc  xác định hiện tạimã sốlàkhôngđã tồn tại
        if (myCFData) {
            for (var i = 0; i < myCFData.length; i++) {
                if (myCFData[i].sfxmbh === sfxmbh) {
                    $.modalAlert("Thuốc hiện tại đã tồn tại,hoặc khoản mục hiện tại đã tồn tại", 'warning');

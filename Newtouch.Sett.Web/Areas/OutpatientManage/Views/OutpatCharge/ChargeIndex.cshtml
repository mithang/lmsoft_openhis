        checkedAll();
        clearItemXM();
    }

    //xác định làkhônggiống nhauthuốcnhập cùng một đơn thuốc
    function cheYPEqual(sfxmcbh, yfCode) {
        var res = "";
        var cflength = myCFData.length;
        if (cflength > 0) {
            for (var i = 0; i < cflength; i++) {
                var obj = myCFData[i];
                if (obj.cfh !== "") { //thuốc
                    if (lsCfh !== "" && lsCfh === obj.cfh) {
                        if (yfCode === obj.yfdm) {
                            if (sfxmcbh === obj.sfxmcbh) {
                                res = "Đơn thuốc hiện tại đã có thuốc đã chọn,Xác nhận thêm nữa không？";
                            }
                        }
                        else {
                            res = "error";
                        }
                    }
                }
                else {
                    if (sfxmcbh === obj.sfxmcbh) {
                        res = "Hiện tại đã có khoản mục đã chọn,Xác nhận thêm nữa không？";
                    }
                }
            }
        }
        return res;
    }


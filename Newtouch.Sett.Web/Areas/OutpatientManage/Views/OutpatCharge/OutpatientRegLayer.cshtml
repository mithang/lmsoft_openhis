@{
    ViewBag.Title = "Đăng ký khám ngoại trú";
    Layout = "~/Views/Shared/_Form.cshtml";

    var opr = OperatorProvider.GetCurrent();
    var zlxmzhconf = SysConfigReader.String("EnableZlxmGroup"); //bật tổ hợp khoản trị liệu
    var zhxmCode = SysConfigReader.String("mzsf_mfgh_sfxmzh"); //thu phí ngoại trú_đăng ký khám miễn phí_tổ hợp khoản thu phí
}
<table class="form" style="margin: 5px 10px 5px 0;width:98%;">
    <tr>
        <th class="formTitle">Lý do khám:</th>
        <td class="formValue">
            <select id="jzyy" name="jzyy" class="form-control">
                <option value="">==Vui lòng chọn==</option>
            </select>
        </td>
        <th class="formTitle"><span class="required">*</span>Loại khám ngoại trú:</th>
        <td class="formValue formDdlSelectorTd">
            <select id="sel_mzlx" class="form-control required" data-EnumType="EnumOutPatientType">
                <option value="">Vui lòng chọn</option>
            </select>
        </td>
        <th class="formTitle"><span class="required">*</span>Khoa:</th>
        <td class="formValue">
            <input type="text" class="form-control" id="txtkschoose" />
        </td>
    </tr>
    <tr>
        <th class="formTitle"><span class="required">*</span>Lịch trực đăng ký khám:</th>
        <td class="formValue">
            <input type="text" class="form-control" id="txtghpbchoose" />
        </td>
        <th class="formTitle">Loại bệnh đặc biệt:</th>
        <td class="formValue">
            <select id="sel_tsbbz" name="sel_tsbbz" class="form-control"></select>
        </td>
        <td></td>
        <td></td>
    </tr>
    <tr>
        <th class="formTitle">Tính chất chi phí:</th>
        <td class="formValue">
            <label id="brxzmc" name="brxzmc"></label>
            <input type="hidden" id="grbh" />
            <input type="hidden" id="cbdbm" />
        </td>
        <td class="formTitle">Khoa đăng ký khám:</td>
        <td class="formValue">
            <input type="hidden" id="txtghpbId" />
            <input type="hidden" id="txtghks" />
            <label id="txtghksmc"></label>
        </td>
        <td class="formTitle">Bác sĩ:</td>
        <td class="formValue">
            <input type="hidden" id="txtghysgh" />
            <label id="txtghysmc"></label>
        </td>
    </tr>
    <tr>
        <td class="formTitle">Số thẻ:</td>
        <td class="formValue">
            <label id="CardTypeName"></label>
            <label id="kh"></label>
        </td>
        <td class="formTitle">Phí đăng ký khám: </td>
        <td class="formValue">
            <input type="hidden" id="txtghfxm" />
            <label id="newghf"></label>
        </td>
        <th class="formTitle">Phí chẩn trị:</th>
        <td class="formValue">
            <input type="hidden" id="txtzlxm" />
            <label id="newzlf"></label>
        </td>
    </tr>
    <tr>
        <th class="formTitle">Tổng số tiền:</th>
        <td class="formValue">
            <label id="newtotalfees"></label>
        </td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
    </tr>
</table>
<script>
    var blh = $.request("blh");
    var fyyGhpbId = null;//đăng ký khám không hẹn trước

    //theosố hồ sơ bệnh ántìm kiếmtrả vềthông tin cơ bản
    function GetOutpatientBasicInfo() {
        $.najax({
            url: "/PatientManage/HospiterRes/GetOutpatientBasicInfo",
            data: { blh: blh },
            dataType: "json",
            async: false,
            success: function (rep) {
                patModel = rep.data;
                $("#CardTypeName").html('(' + patModel.CardTypeName + ')');
                $("#kh").html(patModel.kh);
                $("#grbh").val(patModel.grbh);
                $("#cbdbm").val(patModel.cbdbm);
                $("#brxzmc").attr("data-brxzmc", "Tự chi trả");
                $("#brxzmc").attr("data-brxz", "0");
                $("#brxzmc").html("Tự chi trả");
            }
        });
    }
    GetOutpatientBasicInfo();

    $('#sel_mzlx').bindSelect();

    //khởi tạo hộp thả xuống lý do khám mặc địnhthườngđã chọntrạng thái
    $('#jzyy').itemDetailsBindSelect({ itemtype: 'MedicalVisitReason' });
    var jzyydefaultSelVal = null;
    $.each($('#jzyy option'), function () {
        if ($(this).text() == 'Thường') {
            jzyydefaultSelVal = $(this).attr('value');
        }
    });
    if (jzyydefaultSelVal) {
        $('#jzyy').val(jzyydefaultSelVal).trigger('change');
    }

    //khoa
    $("#txtkschoose").newtouchBatchFloatingSelector({
        height: 200,
        width: 300,
        clickautotrigger: true,
        filter: function (keyword) {
            //duyệtdữ liệunguồn,dùngkeywordđể lọc rakết quả
            var resultObjArr = new Array();
            $.each(top.window.clients.sysDepartList, function (idx, val) {
                if ((val.py && val.py.toLowerCase().indexOf(keyword) >= 0)
                    || (val.Name && val.Name.indexOf(keyword) >= 0)
                    || keyword.trim() == "") {
                    resultObjArr.push(val);
                }
            });
            return resultObjArr;
        },
        caption: "Khoa",
        colModel: [
            { label: 'Mã số', name: 'Code', widthratio: 30 },
            { label: 'Tên', name: 'Name', widthratio: 50 },
            { label: 'Phiên âm', name: 'py', hidden: true }
        ],
        itemdbclickhandler: function ($thistr) {
            $("#txtkschoose").attr("data-label", $thistr.find("td:eq(0)").html());
            $("#txtkschoose").val($thistr.find('td:eq(1)').html());
            return;
        },
    });

    var ghpbUrl = "";
    var colModel = [];
    ScheduleList();
    function ScheduleList() {
        if (@zlxmzhconf == 1) {
            //thu phí tổ hợp khoản
            ghpbUrl = "/OutpatientManage/OutpatientReg/GetNewRegSchedulebyGroupList";
            colModel = [
                { label: 'Lịch trực', name: 'Title', widthratio: 20 },
                { label: 'Khoa đăng ký khám', name: 'ksmc', widthratio: 15 },
                { label: 'Khoản mục đăng ký khám', name: 'sfxmmc', widthratio: 20 },
                { label: 'Tổ hợp khoản mục chẩn trị', name: 'zlxmmc', widthratio: 15 },
                { label: 'Bác sĩ', name: 'rymc', widthratio: 10 },
                { label: 'Khoảng thời gian', name: 'PeriodDesc', widthratio: 20 },
                { label: 'RegType', name: 'RegType', hidden: true },
                { label: 'ks', name: 'ks', hidden: true },
                { label: 'gh', name: 'gh', hidden: true },
                { label: 'ghlx', name: 'ghlx', hidden: true },
                { label: 'zlxm', name: 'zlxm', hidden: true },
                { label: 'ghpbId', name: 'ghpbId', hidden: true },
            ];
        }
        else {
            ghpbUrl = "/OutpatientManage/OutpatientReg/GetRegScheduleList";
            colModel = [
                { label: 'Khoa đăng ký khám', name: 'ksmc', widthratio: 25 },
                { label: 'Bác sĩ', name: 'rymc', widthratio: 20 },
                { label: 'Khoản mục đăng ký khám', name: 'sfxmmc', widthratio: 25 },
                { label: 'Khoản mục chẩn trị', name: 'zlxmmc', widthratio: 25 },
                { label: 'ks', name: 'ks', hidden: true },
                { label: 'gh', name: 'gh', hidden: true },
                { label: 'ghlx', name: 'ghlx', hidden: true },
                { label: 'zlxm', name: 'zlxm', hidden: true },
                { label: 'ghpbId', name: 'ghpbId', hidden: true },
            ];
        }
    }

    //đăng ký khámlớp nổi lịch trực
    $("#txtghpbchoose").newtouchBatchFloatingSelector({
        height: 230,
        width: 700,
        clickautotrigger: true,
        id: 'regSchedule',
        url: ghpbUrl,
        ajaxmethod: 'POST',
        ajaxreqdata: function () {
            return {
                pbks: $("#txtkschoose").val(),
                keyword: $("#txtghpbchoose").val(),
                mzlx: $("#sel_mzlx").val(),
                withFees: false
            };
        },
        caption: "Lịch trực đăng ký khám",
        colModel: colModel,
        itemdbclickhandler: function ($thistr) {
            if (!patModel) {
                $.modalAlert("Chưa chọn bệnh nhân", "warning");
                return;
            }
            fyyGhpbId = $thistr.attr('data-ghpbId');
            ghpbchooseBind($thistr);
            return;
        }
    });

    function ghpbchooseBind($thistr) {
        if ($("#sel_mzlx").val() === "") {
            $("#sel_mzlx").val($thistr.attr('data-RegType')).trigger('change');
        }
        $("#txtghpbchoose").val($thistr.attr('data-Title'));
        //khoản mục đăng ký khámCode
        $("#txtghfxm").val($thistr.attr('data-ghlx'));
        $("#txtghpbId").val('');
        //chẩn trịkhoản mụcCode
        $("#txtzlxm").val($thistr.attr('data-zlxm'));
        $("#txtghks").val($thistr.attr('data-ks'));
        $("#txtghksmc").html($thistr.attr('data-ksmc'));
        $("#txtghysgh").val($thistr.attr('data-gh'));
        $("#txtghysmc").html($thistr.attr('data-rymc'));
        //
        $("#newghf").html('');
        $("#newzlf").html('');
        $("#newtotalfees").html('');
        //lấyđăng ký khámphí phí chẩn trị phí thẻ từ phí làm thẻ
        if ('@zlxmzhconf' == 1) {
            GHFeesGroup(function (feesList) {
                $("#txtghpbId").val($thistr.attr('data-ghpbId'));   //đặt ở đây,phía sau dùng để xác định đã chọn lịch trực thành công chưa
                $("#newghf").html(parseFloat(feesList.ghf).toFixed(2));
                $("#newzlf").html(parseFloat(feesList.zlf).toFixed(2));
                $("#newtotalfees").html(parseFloat(feesList.totalfees).toFixed(2));
            });
        }
        else {
            GHFees(function (feesList) {
                $("#txtghpbId").val($thistr.attr('data-ghpbId'));   //đặt ở đây,phía sau dùng để xác định đã chọn lịch trực thành công chưa
                $("#newghf").html(parseFloat(feesList.ghf).toFixed(2));
                $("#newzlf").html(parseFloat(feesList.zlf).toFixed(2));
                $("#newtotalfees").html(parseFloat(feesList.totalfees).toFixed(2));
            });
        }
    }

    //lấyđăng ký khámchi phí tổ hợp
    function GHFeesGroup(funcSuccCallback) {
        $.najax({
            url: "/OutpatientManage/OutpatientReg/GetOutpatientFeesbyGroup",
            dataType: "json",
            data: { ghlx: $("#txtghfxm").val(), zlxm: $("#txtzlxm").val(), isCkf: false, isGbf: false },
            type: "POST",
            success: function (data) {
                if (funcSuccCallback) {
                    var feesList = {};
                    feesList.ghf = data.ghfPrice;
                    feesList.zlf = data.zlfPrice;
                    feesList.totalfees = data.totalfees;
                    funcSuccCallback(feesList);
                }
            }
        });
    }

    //lấyđăng ký khámchi phí
    function GHFees(funcSuccCallback) {
        $.najax({
            url: "/OutpatientManage/OutpatientReg/GetOutpatientFees",
            dataType: "json",
            data: { ghlx: $("#txtghfxm").val(), zlxm: $("#txtzlxm").val(), isCkf: false, isGbf: false },
            type: "POST",
            success: function (data) {
                if (funcSuccCallback) {
                    var feesList = {};
                    feesList.ghf = data.ghfPrice;
                    feesList.zlf = data.zlfPrice;
                    feesList.totalfees = data.totalfees;
                    funcSuccCallback(feesList);
                }
            }
        });
    }

    $('#sel_mzlx').change(function () {
        $("#txtghpbchoose").val('');
        $("#txtghpbId").val("");
        $("#newghf").html('');
        $("#newzlf").html('');
        $("#newtotalfees").html('');
        cq_fillTsbbz();
    });

    function cq_fillTsbbz() {
        $("#sel_tsbbz").empty();

        var brxz = $('#brxzmc').attr('data-brxz');
        var mzlx = $('#sel_mzlx').val();
        $("#sel_tsbbz").append("<option value=''></option>");
        if (mzlx == "10" || mzlx == "11" || mzlx == "8") {
            $.ajax({
                type: "POST",
                url: "/OutpatientManage/OutpatCharge/GetMzbzml",
                data: { mllx: mzlx },
                dataType: "json",
                async: false,
                success: function (ajaxresp) {
                    $.each(ajaxresp, function () {
                        var option = "<option value='" + this.mtbbzmldm + "'>" + this.mtbbzflmc + "</option>";
                        $("#sel_tsbbz").append(option);
                    });
                }
            });
        }
        if ((!!brxz && brxz != "0") && (mzlx == "4" || mzlx == "5" || mzlx == "6" || mzlx == "7" || mzlx == "10")) {
            var rybh = $("#grbh").val();
            var list = cq_fetchTsbbz(rybh);
            if ($.isArray(list) && list.length > 0) {
                $.each(list, function (index, value) {
                    var prefix = value.opsp_dise_name;
                    var d = prefix.indexOf("Bệnh hiểm nghèo");
                    var option = "<option value='" + value.opsp_dise_code + "'>" + value.opsp_dise_name + "</option>";
                    if (mzlx == "5" && prefix.indexOf("Bệnh hiểm nghèo") != -1) {
                        $("#sel_tsbbz").append(option);
                    }
                    else if ((mzlx == "4" || mzlx == "6" || mzlx == "7") && prefix.indexOf("Bệnh hiểm nghèo") == -1) {
                        $("#sel_tsbbz").append(option);
                    }
                    else if (mzlx == "10" && prefix.indexOf("Đa kháng thuốc") != -1) {
                        $("#sel_tsbbz").append(option);
                    }
                    else if (mzlx == "11" && prefix.indexOf("(Trẻ em)") != -1) {
                        $("#sel_tsbbz").append(option);
                    }
                });
            }
        }
    }
    function cq_fetchTsbbz(rybh) {
        var bzList = [];
        var tsbData = { psn_no: rybh, peratorId: '@(opr.rygh)', operatorId: '@(opr.rygh)', operatorName: '@(opr.UserName)', insuplc_admdvs: $("#cbdbm").val() };
        $.ajax({
            type: "POST",
            url: "http://127.0.0.1:33333/api/YiBao/SlowDisease_5301",
            dataType: "json",
            data: tsbData,
            async: false,
            success: function (data) {
                var TbMzReg = eval('(' + data + ')');
                if (TbMzReg) {
                    if (TbMzReg.infcode == "0" && !!TbMzReg.output.feedetail) {
                        bzList = TbMzReg.output.feedetail;
                    }
                    else {
                        $.modalAlert("Bệnh nhân này không có hồ sơ bệnh đặc biệt" + TbMzReg.err_msg, 'error');
                    }
                }
            },
            error: function () {
                $.modalAlert("Dịch vụ【Lấy thông tin phê duyệt bệnh đặc biệt BHYT】Không thể truy cập", 'warning');
            }
        });
        return bzList;
    }

    //gửi
    function AcceptClick(callback) {
        mzyyghId = "";
        var regInfo = getRegInfo();
        if (!regInfo) {
            return;
        }

        var result = ConfirmFee(regInfo);
        callback(result);
    }

    var MZJS = {};
    MZJS.jzxx = null;
    MZJS.ghdata = null;
    MZJS.msg = "";

    MZJS.clear = function () {
        MZJS.jzxx = null;
        MZJS.qzjzxh = "";
        MZJS.qzmzh = "";
        MZJS.ysxx = null;
        MZJS.regInfo = null;
        MZJS.msg = "";
        MZJS.mxxx = null;
        MZJS.ybjyFeeReturn = null;
    };

    //xác nhận số tiền
    function ConfirmFee( regInfo) {
        MZJS.clear();
        $.najax({
            url: "/OutpatientManage/OutpatientReg/GetNewMzhJzxh",
            data: { patid: regInfo.patid, ghpbId: regInfo.ghpbId, ks: regInfo.ks, ys: regInfo.ys, mjzbz: regInfo.mjzbz, QueueNo: "", OutDate: null, isYbjy: false },
            dataType: "json",
            async: false,
            success: function (rep) {
                MZJS.qzjzxh = rep.data.jzxh;
                MZJS.qzmzh = rep.data.mzh;
                MZJS.ysxx = rep.data.ysxx;
                MZJS.regInfo = regInfo;
            },
            alertbierror: false,
            errorCallback: function (rep) {
                var themsg = "Tạo số khám ngoại trú thất bại";
                if (rep && rep.message) {
                    themsg += "." + rep.message;
                }
                $.modalAlert(themsg, 'error');
                return;
            }
        });
        //bệnh nhân tự chi trảquyết toán
        /* khởi tạo đối tượng ngữ cảnh */
        return SaveMethod({ qzjzxh: MZJS.qzjzxh, qzmzh: MZJS.qzmzh });
    }

    //lưu và thực hiện cụ thể
    function SaveMethod(elseJsonObj) {
        var regInfo = getRegInfo();
        if (!!!regInfo) {
            return;
        }
        var ret = null;
	    var medicalReg;
        $.najax({
            url: "../OutpatientReg/Save",
            dataType: "json",
            loadingtext: "ĐangHISĐăng ký khám,Vui lòng chờ…",
            data: {
                patid: regInfo.patid, kh: regInfo.kh,
                mjzbz: regInfo.mjzbz, ks: regInfo.ks, ys: regInfo.ys,
                ksmc: regInfo.ksmc, ysmc: regInfo.ysmc,
                ghly: regInfo.ghly, jzyy: regInfo.jzyy,
                ghxm: regInfo.ghxm,
                ghpbId: regInfo.ghpbId,
                zlxm: regInfo.zlxm,
                fph: "",
                sfrq: $.getDate(),
                isCkf: regInfo.isCkf, isGbf: regInfo.isGbf,
                feeRelated: {
                    fph: "",
                    sfrq: $.getDate(),
                    ecToken: "",
                    ecToken: "",
                    zje: 0,
                    ssk: null,
                    zhaoling: 0,
                    yjjzfje: 0,
                    djjess:0
                },
                brxz: regInfo.brxz,
                qzjzxh: elseJsonObj.qzjzxh,
                qzmzh: elseJsonObj.qzmzh,
                ybjsh: elseJsonObj.ybjsh,
                mzyyghId: regInfo.yyghId,//mzyyghId,
                jzid:elseJsonObj.jzid,
                bzbm:regInfo.bzbm,
                bzmc:regInfo.bzmc,
                jzlx:elseJsonObj.jzlx
            },
            type: "POST",
            async: false,
            success: function (ajaxresp) {
                ret = ajaxresp.data;
            },
            alertbierror: false,
            errorCallback: function (rep) {
                $.xhrSuccessDataExCheckHandle(rep, true);
            }
        });
        return ret;
    }

    function getRegInfo() {
        var regInfo = {};
        regInfo.patid = patModel.patid;
        if (!regInfo.patid) {
            $.modalAlert("Vui lòng chọn trước thông tin bệnh nhân", 'warning');
            return false;
        }
        regInfo.kh = $("#kh").html();
        if (!regInfo.kh) {
            $.modalAlert("Thiếu thông tin số thẻ", 'warning');
            return false;
        }
        regInfo.brxz = $('#brxzmc').attr('data-brxz');
        regInfo.brxzmc = $('#brxzmc').attr('data-brxzmc');
        if (!(!!regInfo.brxz || regInfo.brxz == '0')) {
            $.modalAlert("Thiếu tính chất chi phí", 'warning');
            return false;
        }

        //xác định chọn tính chất chi phí
        //tự chi trả không điBHYT
        //BHYTtự chi trả điBHYT  //BHYTbệnh nhân có thẻ cũng có thể chọn‘tự chi trả’
        if (patModel.brxz !== regInfo.brxz && regInfo.brxzmc != 'Tự chi trả') {
            if (patModel.brxzmc == 'Tự chi trả' || patModel.brxzmc == 'BHYT tự chi trả') {
                $.modalAlert("Chỉ được chọn" + patModel.brxzmc + "Tính chất", 'warning');
                return false;
            }
            else if (regInfo.brxzmc != 'BHYT tự chi trả') {
                $.modalAlert("Chọn tính chất chi phí sai", 'warning');
                return false;
            }
        }

        regInfo.mjzbz = $("#sel_mzlx").val();
        regInfo.jzyy = $("#jzyy").val();
        regInfo.ks = $("#txtghks").val();
        regInfo.ksmc = $("#txtghksmc").html();
        regInfo.ys = $("#txtghysgh").val();
        regInfo.ysmc = $("#txtghysmc").html();
        regInfo.ghly = "0";//không xử lý hẹn đăng ký khám
        regInfo.ghxm = $("#txtghfxm").val();
        regInfo.zlxm = '@zhxmCode';//khoản tổ hợp
        regInfo.isCkf = false;
        regInfo.isGbf = false;
        regInfo.ghpbId = $("#txtghpbId").val();
        regInfo.ghf = $("#newghf").html();
        regInfo.zlf = $("#newzlf").html();
        regInfo.totalfees = $("#newtotalfees").html();
        regInfo.zjlx = patModel.zjlx;
        regInfo.zjh = patModel.zjh;
        regInfo.blh = $("#blh").val();
        regInfo.cblb = patModel.cblb;
        regInfo.xzlx = patModel.xzlx;
        regInfo.grbh = $("#grbh").val();
        //regInfo.ecToken = $("#ecToken").val();
        //regInfo.cbdbm = $("#cbdbm").val();
        if (!!!regInfo.ghpbId) {
            $.modalAlert("Vui lòng chọn lịch trực", 'warning');
            return false;
        }
        var bzInfo = cq_getCurrentTsbbz();
        if (!bzInfo.rs) {
            $.modalAlert("Vui lòng chọn loại bệnh đặc biệt", 'warning');
            return false;
        }
        else {
            regInfo.bzbm = bzInfo.ryzd;
            regInfo.bzmc = bzInfo.ryzdmc;
        }
        regInfo.zje = !!parseFloat(regInfo.totalfees) ? parseFloat(regInfo.totalfees) : 0;
        if (regInfo.zje < 0) {
            $.modalAlert("Số tiền đăng ký khám bất thường", 'warning');
            return false;
        }
        return regInfo;
    }

    function cq_getCurrentTsbbz() {
        var info = { rs: true, ryzd: "", yllb: "12", ryzdmc: "" };
        var brxz = $('#brxzmc').attr('data-brxz');
        var mzlx = $('#sel_mzlx').val();
        if ((!!brxz && brxz != "0") && (mzlx == "4" || mzlx == "5" || mzlx == "6" || mzlx == "7" || mzlx == "8" || mzlx == "10" || mzlx == "11")) {
            var bzbm = $("#sel_tsbbz").val();
            var bzmc = $("#sel_tsbbz").find("option:selected").text();

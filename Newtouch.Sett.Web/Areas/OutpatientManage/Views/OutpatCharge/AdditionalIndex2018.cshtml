    var newinputxmList;  //nhập mới
    var cfnmList;  //đơn thuốc đã tồn tại trên máy chủ
    var extxmnmList;  //khoản tính phí đã tồn tại trên máy chủ

    //chờ gửi sắp xếp tính phí
    function waitSubmitItems() {
        var xmzje = '0.00';
        newinputxmList = [];  //nhập mới
        cfnmList = [];  //đơn thuốc đã tồn tại trên máy chủ
        extxmnmList = [];  //khoản tính phí đã tồn tại trên máy chủ
        $.each(gridMxList, function (i, item) {
            if (item.newid != null) {
                newinputxmList.push(item);    //nhập mới
            }
            else if (!!item.cfnm) {
                var cfnmExist = false;
                for (var iiiii = 0; iiiii < cfnmList.length; iiiii++) {
                    if (cfnmList[iiiii] == item.cfnm) {
                        cfnmExist = true;
                        break;
                    }
                }
                if (!cfnmExist) {
                    cfnmList.push(item.cfnm);
                }
            }
            else if (!!item.xmnm) {
                extxmnmList.push(item.xmnm);
            }
            xmzje = roundingBy4she6ru5chengshuang(parseFloat(item.zje) + parseFloat(xmzje), 2);
        });
        return xmzje;
    }


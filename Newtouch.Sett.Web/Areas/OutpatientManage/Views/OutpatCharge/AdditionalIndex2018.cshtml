    var patModel = null;

    //hàm gọi lại hộp tra cứu bệnh nhân
    function GetQueryFphAjax(obj) {
        newtouch_event_f4();
        $.loading(true, "Đang yêu cầu thông tin bệnh nhân,Vui lòng chờ...");
        $.ajax({
            type: "POST",
            url: "/OutpatientManage/OutpatCharge/GetpatientAccountInfo",
            data: obj,
            dataType: "json",
            cache: false,
            async: true,
            success: function (ajaxresp) {
                if (ajaxresp.state === 'success' && ajaxresp.data && ajaxresp.data.OutpatAccInfoDto) {
                    if (ajaxresp.data.OutpatAccInfoDto && !!!ajaxresp.data.OutpatAccInfoDto.brxz) {
                        $.modalAlert("Thông tin bệnh nhân bất thường,Thiếu tính chất chi phí", 'warning');
                        return false;
                    }
                    if (ajaxresp.data.OutpatAccInfoDto && !!!ajaxresp.data.OutpatAccInfoDto.CardTypeName) {
                        $.modalAlert("Loại thẻ bệnh nhân bất thường", 'warning');
                        return false;
                    }
                    //gán thông tin cơ bản cá nhân
                    patModel = ajaxresp.data.OutpatAccInfoDto;
                    //đặt lại làkhôngphải quyết toán toàn bộ
                    isYbjyjz = openYbSett && (patModel.brxz != '0' && patModel.brxz != 'yb3' && patModel.brxz != 'yb6' && patModel.brxz != 'yb25');
                    setPatInfoModel(ajaxresp.data.OutpatAccInfoDto);
                    respmzh = patModel.mzh;
                    //liệt kê trực tiếptất cảchưa thu phí
                    setTimeout('loadAllUnsetted("' + patModel.mzh + '")', 50);
                }
                else if (ajaxresp.state === 'error') {
                    $.modalAlert("Không lấy được bản ghi khám chưa thu phí", 'warning');
                }
            },
            complete: function () {
                $.loading(false);
            }
        });
    }

    //khởi tạo thông tin bệnh nhân
    function setPatInfoModel(patModel) {
        $('#rightPart').formSerialize(patModel);
        $("#mzh").val(patModel.mzh);
        $("#blh").html(patModel.blh);
        $("#xb").html($.getGender(patModel.xb));
        $("#csny").html((patModel.csny && patModel.csny.length >= 10 ? patModel.csny.substring(0, 10) : ""));
        $("#zjh").html(patModel.zjh);
        $("#xm").html(patModel.xm);
        $("#nlshow").html(getAgeFromBirthTime({ begin: patModel.csny }).text);
        $("#phone").html(patModel.phone);
        $("#brxzmc").html(patModel.brxzmc);
        $("#jiuzhenbiaozhi").html($.enum.getDescByValue('EnumOutpatientJzbz', patModel.jiuzhenbiaozhi));
        //tảithông tin bệnh nhân
        patInfoPostObj.xm = patModel.xm; //họ tên
        patInfoPostObj.xb = patModel.xb; //giới tính
        patInfoPostObj.csny = patModel.csny;
        patInfoPostObj.patid = patModel.patid; //mã nội bộ bệnh nhân
        patInfoPostObj.blh = patModel.blh; //số hồ sơ bệnh án
        patInfoPostObj.zjh = patModel.zjh; //số giấy tờ
        patInfoPostObj.brxz = patModel.brxz;//tính chất bệnh nhân
        patInfoPostObj.mzh = patModel.mzh;//số khám ngoại trú
        patInfoPostObj.brxzmc = patModel.brxzmc; //tên tính chất bệnh nhân
        patInfoPostObj.jiuzhenbiaozhi = patModel.jiuzhenbiaozhi; //dấu hiệu khám
        patInfoPostObj.ghnm = patModel.ghnm;//mã nội bộ đăng ký khám
        patInfoPostObj.ys = patModel.ys;//bác sĩ
    }

    //kiểm trađang sửacủadữ liệu(chờ gửi)củatính đầy đủ
    function checkEditingRowData(rowData) {
        if (true) {
            //thông thường,số lượng
            if (!((/^(\+|-)?\d+$/).test(rowData.sl)) || rowData.sl < 1) {
                $.modalAlert("Số lượng phải lớn hơn0số nguyên", 'warning');
                return;
            }
            if (!!!rowData.sl || isNaN(rowData.sl)) {
                $.modalAlert("Thiếu số lượng", 'warning');
                return;
            }
        }
        if (!rowData.sfxmCode || !rowData.sfxmmc || !rowData.yzlx || !rowData.sfdlCode || !rowData.sfdlmc) {
            $.modalAlert("Vui lòng chọn khoản thu phí", 'warning');
        }
        else if (!!!rowData.dw) {
            $.modalAlert("Thiếu thông tin đơn vị của khoản mục", 'warning');
        }
        else if (!((/^(([1-9][0-9]*\.[0-9][0-9]*)|([0]\.[0-9][0-9]*)|([1-9][0-9]*)|([0]{1}))$/).test(rowData.dj))) {
            $.modalAlert("Đơn giá phải không nhỏ hơn0số", 'warning');
        }
        else if (rowData.dj == "" || isNaN(rowData.dj)) {
            $.modalAlert("Thiếu thông tin đơn giá của khoản mục", 'warning');
        }
        else {
            return true;
        }
        return false;
    }


@using NewtouchHIS.Lib.Framework.Operator;
@{
    ViewBag.Title = "Ghi bổ sung phí ngoại trú";
    Layout = "~/Views/Shared/_Index.cshtml";
    //thuốctra cứu,thuốclàkhôngliên kếtnhà thuốctồn kho
    var isMedicineSearchRelatedKC = (ViewBag.ISMedicineSearchRelatedKC as bool?) ?? false;
    //làkhôngvàBHYTgiao dịch
    var openYbSett = SysConfigReader.Bool("Outpatient_ChargeFee_OpenYbSett");
    var opr = OperatorProvider.GetCurrent();
}
<style>
    #leftPart {
        float: left;
        width: 24%;
    }

        #leftPart .btn-group {
            float: right;
            font-size: 12px;
            font-weight: 200;
        }

    #rightPart {
        float: left;
        width: 75%;
        padding-left: 7px;
    }
</style>
@Html.Partial("_YibaoCommonView")
<script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/validate/jquery.validate.min.js")"></script>
<div id="leftPart" class="rows">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form" style="width:95%">
            <tr>
                <th class="formTitle">&nbsp;&nbsp; <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>&nbsp;&nbsp;Họ tên/Số hồ sơ bệnh án:</th>
                <td class="formValue">
                    <input id="keyword" type="text" class="form-control" />
                </td>
            </tr>
        </table>
    </div>
    <div class="gridPanel">
        <table id="gridPatList"></table>
    </div>
</div>
<div id="rightPart" class="rows">
    <div id="dv_baseInfoAndItem">
        <div class="panel panel-default">
            <div class="panel-heading navb-bg">
                Thông tin cơ bản
            </div>
            <table class="form">
                <tr>
                    <th class="formTitle"><span class="required">*</span><label id="lbl_mzh">Số khám ngoại trú:</label></th>
                    <td class="formValue" style="width: 100px;">
                        <input type="text" class="form-control" id="mzh" name="mzh" />
                    </td>
                    @*<th class="formTitle" style="width: 40px">
                        <input type="button" class="btn btn-default btn-md btn-default-color" id="btkhsr" style="margin-left:0px; float: left"  value="Nhập số thẻ" onclick="GetPatSbkh();">
                    </th>*@
                    <td class="formValue" >
                        <input type="button" class="btn btn-default btn-md btn-default-color" id="btnsyy" value="Tra cứu" onclick="GetPatSerarchView($('#mzh').val());" />
                    </td>
                    <th class="formTitle">Họ tên:</th>
                    <td class="formValue" style="width: 50px">
                        <label id="xm"></label>
                    </td>
                    <th class="formTitle">Giới tính:</th>
                    <td class="formValue">
                        <label id="xb"></label>
                    </td>
                    <th class="formTitle">Tuổi:</th>
                    <td class="formValue">
                        <label id="nlshow"></label>
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Tính chất chi phí:</th>
                    <td class="formValue">
                        <label id="brxzmc"></label>
                    </td>
                    <th class="formTitle">Dấu hiệu khám:</th>
                    <td class="formValue">
                        <label id="jiuzhenbiaozhi"></label>
                    </td>
                </tr>
                <tbody class="dispTbody" style="display: none;">
                    <tr>
                        <td class="formTitle">Số giấy tờ:</td>
                        <td class="formValue" colspan="2">
                            <label id="zjh"></label>
                        </td>
                        <td class="formTitle">Số điện thoại:</td>
                        <td class="formValue">
                            <label id="phone"></label>
                        </td>
                        <th class="formTitle">Ngày sinh:</th>
                        <td class="formValue">
                            <label id="csny"></label>
                        </td>
                    </tr>
                </tbody>
            </table>
            <div class="fa_icontoggle" style="width: 100%;">
                <i class="fa fa-angle-double-down icontoggle" style="color: rgb(0, 160, 233); cursor: pointer;"></i>
            </div>
        </div>
        @*Gỡ biểu tượng con mắt*@
        <i id="expandIcon" class="fa" style="text-align: center; width: 100%;">Mở thu phí khoản mục</i>
        @*<i id="expandIcon" class="fa fa-eye" aria-hidden="true" style="font-size: large; text-align: center; width: 100%;"></i>*@
        <div class="panel panel-default" id="singleItemDiv" hidden>
            <div class="panel-heading navb-bg">
                @*Gỡ biểu tượng con mắt*@
                @*<i id="singleItemIcon" class="fa fa-eye-slash" style="font-size:larger;"></i>*@
                Thu phí khoản mục&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                <i id="singleItemIcon" class="fa">(Đóng)</i>
            </div>
            <form id="form1">
                <label id="cfh" hidden="hidden"></label>
                <input id="zfbl" type="text" style="display:none;" class="form-control" />
                <input id="zfxz" type="text" style="display:none;" class="form-control" />
                @Html.Partial("originalCharge");
            </form>
        </div>

        @Html.Partial("_MiddleButtonsView", new Newtouch.Sett.Web.Models.BottomButtonViewModel()
   {
       ShowKeyList = new int[] { 2, 3, 6, 9 },
       F2Text = "Thêm",
       F3Text = "Sửa",
       F6Text = "Xóa",
       F9Text = "Hủy sửa",
       F9Hidden = true
   })
    </div>
    <div class="gridPanel">
        <table id="gridFeeList"></table>
    </div>
    @Html.Partial("_BottomButtonsView", new Newtouch.Sett.Web.Models.BottomButtonViewModel()
{
    ShowKeyList = new[] { 4, 8 },
    F8Text = "Lưu tính phí",
})
</div>
<script>
    var openYbSett = '@openYbSett' === 'True'; //cấu hình công tắc:bệnh nhân BHYT có dùng quy trình giao dịch BHYT không
    var isYbjyjz; //lần khám hiện tại có đi theo giao dịch BHYT không
    //
    var leftdata = [];//nguồn dữ liệu bên trái
    var respmzh; //xác thực số khám ngoại trú(chưa đổi)
    var editingNewid = null; //dòng đang sửa
    var patInfoPostObj = {}; //thông tin cá nhânObjectđối tượng cần gửi lên máy chủ
    var lastcfh; //số đơn thuốc dùng ở dòng trước(khoản mở ở giữa không tính là lần trước)
    var currentNewPreNo;
    $(function () {
        $("#gridFeeList").newtouchLocalDataGrid(null, []);
        $("#input1").html('@(ViewBag.sfxm_dj)' === 'ON'
            ? " <input id='dj' type='text' class='form-control form-an' />"
            : " <label id='dj'></label>");
        hideEditBotton();
        $(".fa_icontoggle").click(function () {
            if ($(this).find("i").hasClass("fa-angle-double-down")) {
                $("#gridFeeList").setGridHeight($(window).height() - 245);
            }
            else {
                $("#gridFeeList").setGridHeight($(window).height() - 265);
            }
        });
        $('#expandIcon:visible').trigger('click');
        //
        initGridPatList();
        //khôngthìkhông nhìn thấyloadinghiệu quả
        setTimeout("gridPatList()", 50);
    });

    //phần tử trong trang,tínhtổng số tiền số lượngphiên bản
    function reCalcZjeFromsl() {
        var resultZje = "0.00";
        var txtDj = '@(ViewBag.sfxm_dj)' === 'ON' ? $("#dj").val() : $("#dj").html();
        var txtSl = $('#sl').val();
        if (txtDj && txtSl) {
            if (!isNaN(txtDj) && !isNaN(txtSl)) {
                resultZje = roundingBy4she6ru5chengshuang((parseFloat(txtDj) * parseFloat(txtSl)), 2);
            }
        }
        $('#zje').html(resultZje);
    }

    ///ẩn nút sửa
    function hideEditBotton() {
        $('#btn_bottombutton_f2,#btn_bottombutton_f3,#btn_bottombutton_f6').hide();
    }
    //hiển thị nút sửa
    function showEditBotton() {
        $('#btn_bottombutton_f3').attr('disabled', 'disabled');
        $('#btn_bottombutton_f6').attr('disabled', 'disabled');
        $('#btn_bottombutton_f2,#btn_bottombutton_f3,#btn_bottombutton_f6').show();
    }

    //mở rộngkhoản mụcbảng nhập tính phí
    $('#expandIcon').click(function () {
        $(this).hide();
        $('#singleItemDiv').show();
        $('#form1').show();
        showEditBotton();
        $("#gridFeeList").setGridHeight($(window).height() - $("#dv_baseInfoAndItem").outerHeight(true) - 89);
    });

    //ẩnkhoản mụcbảng nhập tính phí
    $('#singleItemIcon').click(function () {
        $('#singleItemDiv').hide();
        $('#form1').show().hide();
        $('#expandIcon').show();
        hideEditBotton();
        $("#gridFeeList").setGridHeight($(window).height() - $("#dv_baseInfoAndItem").outerHeight(true) - 89);
    });

    //gridPatListcấu trúc
    function initGridPatList() {
        $("#gridPatList").newtouchLocalDataGrid({
            height: $(window).height() - 125,
            unwritten: false,
            rownumbers: false,
            colModel: [
                { label: 'Số hồ sơ bệnh án', name: 'blh', width: 60, align: 'left' },
                { label: 'Họ tên', name: 'xm', width: 70, align: 'left' },
                { label: 'Số khám ngoại trú', name: 'mzh', width: 100, align: 'left' },
                { label: 'patid', name: 'patid', hidden: true },
                { label: 'py', name: 'py', hidden: true }
            ],
            ondblClickRow: function (rowid) {
                var rowData = $("#gridPatList").jqGrid('getRowData', rowid);
                var mzh = rowData.mzh;
                //tính phí
                GetQueryFphAjax({ mzh: mzh });
            },
            gridComplete: function () {

            }
        });
    }

    //làm mới danh sách bệnh nhân
    function gridPatList() {
        $.najax({
            type: "GET",
            url: "/OutpatientManage/OutpatientReg/GetCurrentDayRegListJson",
            loading: true,
            loadingtext: "Đang tải danh sách bệnh nhân,Vui lòng chờ...",
            success: function (ajaxresp) {
                leftdata = ajaxresp;
                var $gridPatList = $("#gridPatList");
                $gridPatList.resetSelection();
                $gridPatList.clearGridData();
                $gridPatList.newtouchLocalDataGrid({ posttofirst: false }, leftdata);
            }
        });
    }

    //tảitất cảchưa thu phí
    function loadAllUnsetted(mzh) {
        $.najax({
            type: "POST",
            url: "/OutpatientManage/OutpatCharge/GetAllUnSettedListByMzh?mzh=" + mzh,
            dataType: "json",
            cache: false,
            async: true,
            loadingtext: "Đang yêu cầu thông tin chi phí,Vui lòng chờ...",
            success: function (ajaxresp) {
                FillgridFeeList(ajaxresp);
            }
        });
    }

    $("#gridFeeList").newtouchLocalDataGrid({
        height: $(window).height() - 225,
        unwritten: false,
        colModel: [
            { label: "newid", name: "newid", align: "left", hidden: true },
            {
                label: "Loại", name: "yzlx", width: 50, align: "left", formatter: function (cellvalue) {
                    if (cellvalue == "1") {
                        return "Thuốc"
                    }
                    else if (cellvalue == "2") {
                        return "Khoản mục";
                    }
                    else {
                        return "error";
                    }
                }
            },
            { name: "cfnm", hidden: true },
            { label: "Số đơn thuốc", name: "cfh", width: 130, align: "left" },
            { name: "xmnm", hidden: true },
            { label: "Tên khoản mục", name: "sfxmmc", width: 170, align: "left" },
            { name: "sfxmCode", align: "left", hidden: true },
            { label: "Loại", name: "sfdlCode", width: 50, align: "left", hidden: true },
            { name: "sfdlmc", hidden: true },
            { label: "Tổng số lượng tính phí", name: "sl", width: 70, align: "left" },
            { label: "Đơn vị", name: "dw", width: 40, align: "left" },
            {
                label: "Đơn giá(đồng)", name: "dj", width: 80, align: "left", formatter: "number"
, formatoptions: { decimalPlaces: 4, defaultValue: '0.0000' }
            },
            {
                label: "Số tiền(đồng)", name: "zje", width: 80, align: "left", formatoptions: { decimalPlaces: 2, defaultValue: '0.00' }
            },
            { label: "jl", name: "jl", hidden: true },
            { label: "jldw", name: "jldw", hidden: true },
            { label: "zfbl", name: "zfbl", hidden: true },
            { label: "zfxz", name: "zfxz", hidden: true }
        ],
        onSelectRow: function (rowid) {
            $('#btn_bottombutton_f3').removeAttr('disabled');
            $('#btn_bottombutton_f6').removeAttr('disabled');
        },
        ondblClickRow: function (rowid) {
            var rowData = $("#gridFeeList").jqGrid('getRowData', rowid);
            sfxmgridDbclickRow(rowData);
        }
    });
    //trị liệukhoản mục lớp nổi
    var searchTypePart1 = "yp";
    var searchTypePart2 = "sfxm";
    if ('@(isMedicineSearchRelatedKC ? "true" : "")' == 'true') {
        searchTypePart1 += '.kc';
    }
    $('#sfxmmc').sfxmFloatingSelector({
        djDecimalPlaces: 4,
        searchType: searchTypePart1 + "," + searchTypePart2,
        leftshift: 100, //lệch trái toàn bộ
        ajaxparameters: function ($thisinput) {
            return "keyword=" + $.trim($thisinput.val()) + "&mzzybz=1&dllb=2";
        },
        itemdbclickhandler: function ($thistr, $thisinput) {
            if (!patModel) {
                $.modalAlert("Chưa chọn bệnh nhân", "warning");
                return;
            }
            if ($thistr.attr('data-yzlx') == '1') {
                $.modalAlert("Không hỗ trợ nhập mới tại đây<br/>Thuốc chỉ được bác sĩ kê đơn", 'warning');
                return;
            }
            if ($thisinput.attr('id') === 'sfxmmc') {
                if ($thistr.attr('data-yzlx') === "1") {
                    //thuốc
                    $('#jldw').html($thistr.attr('data-jldw'));
                    $('#jl').val('');
                }

                Container($thistr.attr('data-yzlx'));
                $('#yzlx').val($thistr.attr('data-yzlx'));
                $('#sfxmmc').val($thistr.attr('data-sfxmmc'));
                $('#sfxmCode').val($thistr.attr('data-sfxmCode'));
                $('#sfdlCode').val($thistr.attr('data-sfdlCode'));
                $('#sfdlmc').val($thistr.attr('data-sfdlmc'));
                var djVal = parseFloat($thistr.attr('data-dj')).toFixed(4);
                '@(ViewBag.sfxm_dj)' === 'ON' ? $('#dj').val(djVal) : $('#dj').html(djVal);
                $('#dw').html($thistr.attr('data-dw'));
                $('#zfbl').val($thistr.attr('data-zfbl'));
                $('#zfxz').val($thistr.attr('data-zfxz'));
            }
        }
    });

    //thêm
    function newtouch_event_f2() {
        if (editingNewid) {
            return; //đang ở trạng thái sửa,không được nhấn nút thêm   cầndisablexử lý
        }

        if (!patInfoPostObj.mzh) {
            $.modalAlert("Thiếu thông tin cơ bản của bệnh nhân", 'warning');
            return;
        }
        if (patInfoPostObj.mzh !== respmzh) {
            $.modalAlert("Lỗi:Trong quá trình nhập liệu,Thay đổi số khám ngoại trú", 'warning');
            return;
        }

        var data = getEditRowData();
        if (!(CheckreAdddata(data) && checkEditingRowData(data))) {    //dữ liệu có đầy đủ không,kiểm tra các mục bắt buộc
            return;
        }
        var addgoon = function () {
            //kiểm trakhoản trùng

            if (!(CheckreAdddata(data) && checkEditingRowData(data))) {    //dữ liệu có đầy đủ không,kiểm tra các mục bắt buộc
                return;
            }
            reCalcZjeFromsl();
            data.zje = $('#zje').html();
            data.newid = Math.random().toString() + new Date().getMilliseconds();   //newid()
            gridMxList.unshift(data);   //thêm dưới dạng khoản mới //”đầu mảng“

            //đưa lạixmmảng hiển thị vàogrid
            fillDataToGrid();
            Clearjzxm();
        }

        if (data && parseFloat(data.dj) < '0') {
            $.modalAlert("Đơn giá phải không nhỏ hơn0số", 'warning');
            return;
        }
        else if (data && parseFloat(data.dj) == '0') {
            $.modalConfirm("Đơn giá là0,Xác nhận có thêm không", function (flag) {
                if (!flag) {
                    return;
                }
                else {
                    addgoon();
                }
            });
        }
        else {
            addgoon();
        }
    }

    //sửa
    function newtouch_event_f3() {
        if (editingNewid) {
            var data = getEditRowData();
            if (!(checkEditingRowData(data))) {
                //dữ liệu có đầy đủ không,kiểm tra các mục bắt buộc
                return;
            }
            reCalcZjeFromsl();
            data.zje = $('#zje').html();
            updategoon = function () {

                data.newid = editingNewid;
                //kiểm trakhoản trùng

                //trước tiên tạixmtìm trong mảng
                if (editingNewid) {
                    var matchedIndex = -1;
                    for (var ii = 0; ii < gridMxList.length; ii++) {
                        if (gridMxList[ii].newid == data.newid) {
                            matchedIndex = ii;
                            break;
                        }
                    }
                    if (matchedIndex == -1) {
                        return; //có lẽ là bất thường
                    }
                    gridMxList.remove(matchedIndex);   //gỡ khoản này
                    gridMxList.unshift(data);   //thêm dưới dạng khoản mới    //”đầu mảng“
                }

                //đưa lạixmmảng hiển thị vàogrid
                fillDataToGrid();
                Clearjzxm();

                editingNewid = null;    //dòng đang sửa

                middleButtonsReset();
            }
            if (data && parseFloat(data.dj) < '0') {
                $.modalAlert("Đơn giá phải không nhỏ hơn0số", 'warning');
                return;
            }
            else if (data && parseFloat(data.dj) == '0') {
                $.modalConfirm("Đơn giá là0,Xác nhận có sửa không", function (flag) {
                    if (!flag) {
                        return;
                    }
                    else {
                        updategoon();
                    }
                });
            }
            else {
                updategoon();
            }
        }
        else {
            $('#btn_bottombutton_f2').attr('disabled', 'disabled');
            //lấygridhiện tạiđã chọncủadòng đó
            var seleId = $('#gridFeeList').jqGrid('getGridParam', 'selrow');
            if (seleId) {
                //yêu cầusửanàydòng
                gridEditRow(seleId);
            }
            else {
                return;
            }
        }
    }

    //F4xóa
    function newtouch_event_f4() {
        isYbjyjz = null;
        gridMxList = [];
        patInfoPostObj = {};    //thông tin cá nhânObjectđối tượng cần gửi lên máy chủ
        editingNewid = null;    //dòng đang sửa
        patModel = null;
        lastcfh = "";//số đơn thuốc sửa lần cuối
        respmzh = "";//xác thực số khám ngoại trú(chưa đổi)
        $("#gridFeeList").clearGridData();
        $('#xm,#xb,#nlshow,#jsr,#zjlx,#zjh,#csny,#phone,#brxzmc,#jiuzhenbiaozhi').html('');
        $("#zje").html('0.00');
        $('#mzh').val('');
        $('#newPre').removeAttr('checked');
        currentNewPreNo = "";
        Clearjzxm();
        middleButtonsReset();
    };

    //xóa
    function newtouch_event_f6() {
        //lấygridhiện tạiđã chọncủadòng đó
        var rowid = $('#gridFeeList').jqGrid('getGridParam', 'selrow');
        //yêu cầu xóanàydòng
        if (rowid) {
            var rowData = $("#gridFeeList").jqGrid('getRowData', rowid);
            if (rowData) {
                if (!!rowData.newid) {
                    //xóa chưa gửicủadữ liệu
                    if (gridMxList.length > 0) {
                        for (var jj = (gridMxList.length - 1) ; jj >= 0 ; jj--) {
                            if (gridMxList[jj].newid == rowData.newid) {
                                gridMxList.remove(jj);   //gỡ
                            }
                        }
                    }
                }
                else {
                    //khoản mụccó thể xóa？
                    $.modalAlert('Không thể sửa hoặc xóa chi tiết này', 'warning');
                    return;
                }
            }
            //đưa lạixmmảng hiển thị vàogrid
            fillDataToGrid();
        }
    }

    //lấychi tiết
    function getEditRowData() {
        var tempCfh = "";
        if ($('#yzlx').val() == "1") {
            //thuốc
            var rowid = $('#gridFeeList').jqGrid('getGridParam', 'selrow');//xác định có đơn thuốc nào được chọn không
            if (rowid) {
                var rowData = $("#gridFeeList").jqGrid('getRowData', rowid);
                if (!rowData.newid || !rowData.cfh) {
                    //chọncủađơn thuốc không được thêm chi tiết,đơn thuốc mới
                    $("[id ='newPre']:checkbox").prop("checked", "checked");
                    $('#newPre').trigger("change");
                    tempCfh = currentNewPreNo;
                }
                else {
                    //dùngđã chọnbản ghi đócủasố đơn thuốc
                    tempCfh = rowData.cfh;
                }
            }
            else {
                //xác định làkhôngsố đơn thuốc mới
                if ($('#newPre').is(':checked')) {
                    //đơn thuốc mới
                    tempCfh = currentNewPreNo
                }
                else {
                    //đơn thuốc cũ
                    if ($('#cfh').val()) {
                        //bản ghi vùng sửa hiện tại đãcósố đơn thuốc
                        tempCfh = $('#cfh').val();
                    }
                    else if (lastcfh) {
                        //số đơn thuốc dùng ở dòng trước(khoản mở ở giữa không tính là lần trước)
                        tempCfh = lastcfh
                    }
                    else {
                        //lần đầu mặc định đơn thuốc mới
                        $("[id ='newPre']:checkbox").prop("checked", "checked");
                        $('#newPre').trigger("change");
                        tempCfh = currentNewPreNo;
                    }
                }
            }
        }
        var data = {
            cfh: tempCfh,
            sfxmCode: $('#sfxmCode').val(),

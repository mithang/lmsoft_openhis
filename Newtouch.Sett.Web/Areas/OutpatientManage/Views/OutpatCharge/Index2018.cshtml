                if (!!rowData.cfnm) {
                    if (settOnce == true) {
                        $.modalAlert('Không thể xóa chi tiết này', 'warning');
                        return;
                    }
                    if (rowData.cflx == '1' && rowData.yzlx == 'Khoản mục') {
                        if (gridMxList.length > 0) {
                            for (var jj = (gridMxList.length - 1); jj >= 0; jj--) {
                                if (gridMxList[jj].cflx == '1' && gridMxList[jj].yzlx == '2') {
                                    deletelist.push(rowData);
                                    gridMxList.remove(jj);   //gỡ
                                }
                            }
                        }
                    } else {
                        //xóa hết dưới cùng một đơn thuốc
                        if (gridMxList.length > 0) {
                            for (var jj = (gridMxList.length - 1); jj >= 0; jj--) {
                                if (gridMxList[jj].cfnm == rowData.cfnm) {
                                    gridMxList.remove(jj);   //gỡ
                                }
                            }
                        }
                    }

                }
                else if (!!rowData.xmnm) {
                    if (settOnce == true) {
                        $.modalAlert('Không thể xóa chi tiết này', 'warning');
                        return;
                    }
                    if (gridMxList.length > 0) {
                        for (var jj = (gridMxList.length - 1) ; jj >= 0 ; jj--) {
                            if (gridMxList[jj].xmnm == rowData.xmnm) {
                                gridMxList.remove(jj);   //gỡ
                            }
                        }
                    }

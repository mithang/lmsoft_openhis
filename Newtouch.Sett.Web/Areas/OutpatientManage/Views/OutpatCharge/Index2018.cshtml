                /* đặt lại đối tượng ngữ cảnh quyết toán */
                MZJS.reset();

                $.loading(true, 'Đang cập nhật thông tin khám，Vui lòng chờ...');
                if (openAllCfSettPz === 'True')
                    AllCfSett(xmzje);
                else
                    SingleCfSett();

            } catch (e) {
                $.modalConfirm("Quyết toán BHYT lỗi：" + e.message + "! Có chuyển sang quyết toán tự chi trả không？",
                    function(flag) {
                        if (!flag) {
                            return;
                        } else {
                            zfSubmit(xmzje);
                        }
                    });
            }
        }
        else {

                /* khởi tạo số tiền đơn thuốc của đối tượng ngữ cảnh */
                MZJS.reset();
                while (MZJS.moveNext()) {
                    MZJS.waitSubmitItems();
                }
                //xmzje = MZJS.getTotalXmzje();

            /* gọi Trùng KhánhHISquyết toán */
            CQHisSubmit(xmzje);
        }
    }
    function SingleCfSett()
    {
        setTimeout(function () {
            if (!Ybjzgh())
                return;
            CQjzdj();
            if (MZJS.jzxx == null) {
                return;
            }
            $.loading(true, 'Đang quyết toán BHYT，Vui lòng chờ...');
            setTimeout(function () {
                var jsstate = true;

                /* hủy tất cả chi tiết đã tải lên chờ quyết toán */
                if (!CQmxcx()) {
                    return;
                }

                /* quyết toán với BHYT từng đơn thuốc một */
                while (MZJS.moveNext()) {
                    MZJS.waitSubmitItems();
                    CQmxsc();
                    if (MZJS.current().error == 1) {
                        continue;
                    }
                    if (MZJS.current().mxxx == null) {
                        jsstate = false;
                        break;
                    }
                    CQybjs();
                    if (MZJS.current().ybjyFeeReturn == null) {
                        jsstate = false;
                        break;
                    }
                }

                /* đảo quyết toán BHYT */
                if (!jsstate) {
                    var errMsg = "<p>" + MZJS.current().msg + "</p>";
                    for (var m = MZJS.index; m >= 0; m--) {
                        if (MZJS.cfList[m].error != 0) {
                            continue;
                        }
                        var ret = CQybjs_cz(MZJS.cfList[m].ybjyFeeReturn, { cfh: MZJS.cfList[m].cfh, xmzje: MZJS.cfList[m].xmzje });
                        if (!ret.rs) {
                            errMsg = errMsg + "<p>" + ret.msg + "</p>";
                        }
                    }
                    $.loading(false);
                    if (errMsg.length > 0) {
                        $.modalAlert(errMsg, 'error');
                    }
                    return;
                }

                $.loading(false);

                /* xác nhận thu phí vàHIScổng vào quyết toán */
                CQybjs_confirm();
            }, 50);
        }, 50);
    }
    function AllCfSett(xmzje)
    {
        setTimeout(function () {
            if (!Ybjzgh())
                return;
            CQjzdj();
            if (MZJS.jzxx == null) {
                return;
            }
            $.loading(true, 'Đang quyết toán BHYT，Vui lòng chờ...');

            setTimeout(function () {
                var jsstate = true;
                /* hủy tất cả chi tiết đã tải lên chờ quyết toán */
                if (!CQmxcx()) {
                    return;
                }
                CQmxsc();
                if (MZJS.mxxx == null) {
                    jsstate = false;

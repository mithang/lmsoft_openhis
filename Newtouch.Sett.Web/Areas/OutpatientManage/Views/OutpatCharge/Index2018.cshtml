    //kiểm trađang sửacủadữ liệu（chờ gửi）củatính đầy đủ
    function checkEditingRowData(rowData) {
        if ('@orginal' == 'True' || ('@orginal' == 'False' && rowData.yzlx == "1")) {
            //thông thường，số lượng
            if (!((/^(\+|-)?\d+$/).test(rowData.sl)) || rowData.sl < 1) {
                $.modalAlert("Số lượng phải lớn hơn0số nguyên", 'warning');
                return;
            }
            if (!!!rowData.sl || isNaN(rowData.sl)) {
                $.modalAlert("Thiếu số lượng", 'warning');
                return;
            }
        }
        else if ('@orginal' == 'False' && rowData.yzlx == "2") {
            //không thông thường，lượng trị liệu mỗi lần
            if (!!!rowData.jjcl || isNaN(rowData.jjcl)) {
                $.modalAlert("Thiếu chiến lược định giá của khoản mục", 'warning');
                return;
            }
            else if (!!!rowData.dwjls || isNaN(rowData.dwjls)) {
                $.modalAlert("Thiếu số lượng đo đơn vị của khoản mục", 'warning');
                return;
            }
            else if (rowData.yzlx == '2' && (!!!rowData.zll || isNaN(rowData.zll))) {
                $.modalAlert("Thiếu lượng trị liệu mỗi lần của khoản mục", 'warning');
                return;
            }
            else if (!((/^(\+|-)?\d+$/).test(rowData.zll)) || rowData.zll < 1) {
                $.modalAlert("Lượng trị liệu mỗi lần phải lớn hơn0số nguyên", 'warning');
                return;
            }
            else if (parseInt(rowData.dwjls) > parseInt(rowData.zll)) {
                $.modalAlert("Lượng trị liệu mỗi lần không được nhỏ hơn số lượng đo mỗi lần", 'warning');
                return;
            } else if (!((/^(\+|-)?\d+$/).test(rowData.zlcs)) || rowData.zlcs < 1) {
                $.modalAlert("Số lần trị liệu phải lớn hơn0số nguyên", 'warning');
                return;
            }
        }
        if (!rowData.sfxmCode || !rowData.sfxmmc || !rowData.yzlx || !rowData.sfdlCode || !rowData.sfdlmc) {
            $.modalAlert("Vui lòng chọn khoản thu phí", 'warning');
        }
        else if (!!!rowData.dw) {
            $.modalAlert("Thiếu thông tin đơn vị của khoản mục", 'warning');
        }
        else if (!((/^(([1-9][0-9]*\.[0-9][0-9]*)|([0]\.[0-9][0-9]*)|([1-9][0-9]*)|([0]{1}))$/).test(rowData.dj))) {
            $.modalAlert("Đơn giá phải không nhỏ hơn0số", 'warning');
        }
        else if (rowData.dj == "" || isNaN(rowData.dj)) {
            $.modalAlert("Thiếu thông tin đơn giá của khoản mục", 'warning');
        }
        else {
            return true;
        }
        return false;
    }


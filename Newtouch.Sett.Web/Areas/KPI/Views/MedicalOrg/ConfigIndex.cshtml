
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div style="margin:5px 100px 0 5px;color:#666;">
    Giải thích thuật toán (cấu hình)：<span style="color:red;">1</span>) 'Nhóm thu phí lớn + Khoản thu phí' không thể trùng lặp cấu hình；<span style="color:red;">2</span>) Tỷ lệ và số tiền cố định là hai cách, ít nhất phải cấu hình một loại, nếu đều cấu hình thì lấy tổng
</div>
<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="nhóm lớn Mã/nhóm lớn Tên/Khoản mục Mã/Tên khoản mục" style="width: 220px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script>
    $(function () {
        gridList()
    })
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            postData: { keyword: $("#txt_keyword").val() },
            url: "/KPI/MedicalOrg/GetConfigGridJson",
            height: $(window).height() - 120,
            colModel: [
                 { label: "Khóa chính", name: "Id", hidden: true, key: true },
                 { label: "Hiệu lực", name: "zt", width: 60, align: "center", formatter: function (cellvalue) { return cellvalue == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
                 { label: "Nhóm thu phí lớn Tên", name: "sfdlmc", width: 100, align: 'left' },
                 { label: "Khoản thu phí Mã", name: "sfxmCode", width: 100, align: 'left' },
                 { label: "Tên hạng mục thu phí", name: "sfxmmc", width: 150, align: 'left' },
                 { label: "Chi phí cố định khoản mục", name: "xmgdcb", width: 90, align: 'left', formatter: function (cellvalue, options, rowObject) { if (!!cellvalue) { return cellvalue; } else { if (!!rowObject.sfxmCode && !!!rowObject.blhgdje) return 0; else return ""; } } },
                 { label: "Tỷ lệ", name: "bl", width: 70, align: 'left', formatter: function (cellvalue) { if (!!cellvalue || cellvalue == 0) { return cellvalue + "%" } else { return ""; } } },
                 { label: 'Số tiền cố định', name: 'blhgdje', width: 100, align: 'left', formatter: function (cellvalue) { if (!!cellvalue) { return cellvalue; } else { return ""; } } },
                 { label: 'Ghi chú', name: 'bz', width: 300, align: 'left' },
                { label: 'Sắp xếp', name: 'px', width: 40, align: 'left' },
                { label: 'Người tạo', name: 'CreatorCode', width: 100, align: 'left' },
                { label: 'Thời gian tạo mới', name: 'CreateTime', width: 130, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Cuối cùng Sửa', name: 'LastModifierCode', width: 100, align: 'left' },
                { label: 'Cuối cùng Sửa Thời gian', name: 'LastModifyTime', width: 130, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
            ],
        });
        $("#btn_search").click(function () {
            $("#gridList").jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword").val() },
            }).trigger('reloadGrid');
        });
    }

    //回车事件
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "Thêm mới cấu hình",
            url: "/KPI/MedicalOrg/ConfigForm",
            width: "500px",
            height: "570px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                });
            }
        });
    }

    function btn_edit() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một dòng thông tin", 'warning');
            return;
        }
        $.modalOpen({
            id: "Form",
            title: "Sửa cấu hình",
            url: "/KPI/MedicalOrg/ConfigForm?keyValue=" + keyValue,
            width: "500px",
            height: "570px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                });
            }
        });
    }

</script>


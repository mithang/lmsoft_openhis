
@{
    ViewBag.Title = "Tra cứu bảo hiểm thuốc";
    Layout = "~/Views/Shared/_Form.cshtml";
    var reportUrl = "";
    var ReportSystemCode = "";
}

<div class="rows">
    <div class="panel panel-default">
        <table class="form">
            <tr>
                <th class="formTitle">Ngày bắt đầu:</th>
                <td class="formValue">
                    <input id="ksrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px"
                           onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy' })"
                           onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })"
                           value="@DateTime.Now.ToString("01/MM/yyyy")" />
                </td>
                <th class="formTitle">Ngày kết thúc:</th>
                <td class="formValue">
                    <input id="jsrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px"
                           onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy' })"
                           onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })"
                           value="@DateTime.Now.ToString("dd/MM/yyyy")" />
                </td>
                <th class="formTitle">Tính chất chi phí:</th>
                <td class="formValue">
                    <select id="yblb" class="form-control">
                        @* value là khóa param của proc RPT_SETT_医保业务报表 (自费/城保/居保/全部医保/全部) — KHÔNG dịch value, chỉ label tiếng Việt; dịch value sẽ làm báo cáo trả 0 dòng. *@
                        <option value="自费">Tự chi trả</option>
                        <option value="城保">Bảo hiểm thành phố</option>
                        <option value="居保">BHYT dân cư</option>
                        <option value="全部医保">Tất cả BHYT</option>
                        <option value="全部">Tất cả</option>
                    </select>
                </td>
                <th class="formTitle"></th>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
            </tr>
        </table>
    </div>
</div>


<div class="ui-layout" id="layout" style="height:100%;width:100%;">
    <iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
            scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
</div>




<script type="text/javascript">
    var isHospAdministrator = '@(ViewBag.IsHospAdministrator)';
    var curUserCode = '@(ViewBag.CurUserCode)';
    var OrgId = '@(ViewBag.OrgId)';
    var reportServerHOST = '@(ViewBag.ReportServerHOST)';
    //$("#sfdl").bindSelect({
    //    url: "/Report/GetSFDLCodeSelectJson",
    //    param: {},
    //    dataType: "json",
    //});
    function submit() {
        if ($('#ksrq').val().length == 0 || $('#jsrq').val().length == 0) {
            $.modalAlert("Vui lòng chọn khoảng thời gian", "error");
            return;
        }
        var url = getUrl();
        $("#iframerightiframerightiframerightttt").attr('src', url);
    }

    $("#iframerightiframerightiframerightttt").load(function () {
        $.loading(false);
    });

    $(function () {
        var h = $(window).height() - 55
        $('#layout iframe').css('height', h);

    });

    //Làm mới danh sách
    function refReport() {
        $("#btn_search").trigger('click');
    }

    function getUrl() {
        var srcUrl2 = '@Html.Raw(reportUrl)' + "?tempCode=1225" + "&systemCode=" + '@Html.Raw(ReportSystemCode)' + "&hospitalCode=" + OrgId + "&kssj=" + $('#ksrq').val() + "&jssj=" + $('#jsrq').val() + "&yblb=" + $('#yblb').val();
        return srcUrl2;
    }

</script>
 
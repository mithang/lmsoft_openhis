@using NewtouchHIS.Lib.Framework.Operator;
@{
    ViewBag.Title = "Bảng chi tiết xuất kho";
    Layout = "~/Views/Shared/_Form.cshtml";
    //Liên kết báo cáo
    var reportUrl = "";
    var ReportSystemCode = "";
    var opr = OperatorProvider.GetCurrent();
}

<div class="rows">
    <div class="panel panel-default">
        <table class="form">
            <tr>
                <th class="formTitle">Ngày bắt đầu:</th>
                <td class="formValue">
                    <input id="kssj" type="text" class="form-control input-wdatepicker form-an"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" value="@(DateTime.Now.ToString("yyyy-MM-01"))" />
                </td>
                <th class="formTitle">Ngày kết thúc:</th>
                <td class="formValue">
                    <input id="jssj" type="text" class="form-control input-wdatepicker form-an"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" value="@(DateTime.Now.ToString("yyyy-MM-dd"))" />
                </td>
                <th class="formTitle">nhà thuốc/kho thuốc:</th>
                <td class="formValue">
                    <select id="yfbm" class="form-control">
                        <option value="">Tất cả</option>
                        <option value="00000020">Kho thuốc tây</option>
                        <option value="00000021">trong kho thuốc</option>
                        <option value="00000019">Nhà thuốc tây</option>
                        <option value="00000018">trong nhà thuốc</option>
                    </select>
                </td>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
                <td class="formValue"></td>
            </tr>
        </table>
    </div>
</div>

<div class="ui-layout" id="layout" style="height:100%;width:100%;">
    <iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
            scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
</div>
<script type="text/javascript">


    function submit() {

        if ($('#kssj').val().length == 0) {
            $.modalAlert("Thiếu Giờ bắt đầu", "error");
            return;
        }
        if ($('#jssj').val().length == 0) {
            $.modalAlert("Thiếu Giờ kết thúc", "error");
            return;
        }
        if ($('#kssj').val() > $('#jssj').val()) {
            $.modalAlert("Thời gian bắt đầu không được lớn hơn thời gian kết thúc", "error");
            return;
        }
        var url = '@Html.Raw(reportUrl)' + "?tempCode=1326" + "&systemCode=" + '@Html.Raw(ReportSystemCode)';
        url += "&ksrq=" + $('#kssj').val() + ' 00:00:00';
        url += "&jsrq=" + $('#jssj').val() + ' 23:59:59';
        url += "&yfbm=" + $('#yfbm').val();
        url += "&orgId=" + '@Html.Raw(opr.OrganizeId)';
        @*var url = getUrl();
        var usercode = '@ViewBag.usercode';
        url += "&kssj=" + $('#kssj').val();
        url += "&jssj=" + $('#jssj').val();*@
        setTimeout("$.loading(true, 'Đang yêu cầu trang báo cáo...');", 10);
        $("#iframerightiframerightiframerightttt").attr('src', url);
    }

    $("#iframerightiframerightiframerightttt").load(function () {
        $.loading(false);
    });

    $(function () {
        var h = $(window).height() - 55
        $('#layout iframe').css('height', h);

        setTimeout(function () { submit(); }, 100);
    });

    function getUrl() {
        var srcUrl = '@Html.Raw(reportUrl)';

        //Lấy kiểu tùy chỉnh
        if (true) {
            if (srcUrl.indexOf('&rc:Stylesheet') == -1) {
                srcUrl += "&rc:Stylesheet=MyStyleSheet";
            }
        }

        return srcUrl;
    }

</script>
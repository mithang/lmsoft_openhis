
@{
	ViewBag.Title = "";
	Layout = "~/Views/Shared/_Form.cshtml";
}

<div class="rows">
	<div class="panel panel-default">
		<table class="form">
			<tr>
				<th class="formTitle">Ngày bắt đầu：</th>
				<td class="formValue">
					<input id="kssj" type="text" class="form-control input-wdatepicker form-an" 
						   onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" value="@(DateTime.Now.ToString("yyyy-MM-01"))" />
				</td>
				<th class="formTitle">Ngày kết thúc：</th>
				<td class="formValue">
					<input id="jssj" type="text" class="form-control input-wdatepicker form-an" 
						   onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" value="@(DateTime.Now.ToString("yyyy-MM-dd"))" />
				</td>
				<th class="formTitle" style="left: 20px;">Tên khoa：</th>
				<td class="formValue" >
					<select id="depa" class="form-control" >
						<option value="">Tất cả</option>
					</select>
				</td>
				<th class="formTitle" >nhóm lớn Tên：</th>
				<td class="formValue" >
					<select id="dlmc" class="form-control">
						<option value="">Tất cả</option>
					</select>
				</td>
			</tr>
			<tr>
				<th class="formTitle">Họ tên：</th>
				<td class="formValue">
					<input id="xm" name="xm" type="text" autocomplete="off" class="form-control" />
				</td>
				<th class="formTitle">Số nhập viện/Số khám ngoại trú：</th>
				<td class="formValue">
					<input id="zyh" name="zyh" type="text" autocomplete="off" class="form-control" />
				</td>
				<th class="formTitle" style="padding-left: 30px;">Tên hạng mục thu phí：</th>
				<td class="formValue">
					<input id="sfxmmc" name="sfxmmc" type="text" autocomplete="off" class="form-control" />
				</td>
				<th class="formTitle">Có hay không Ngoại trú：</th>
				<td class="formValue">
					<select id="sfmz" class="form-control">
						<option value="">Tất cả</option>
						<option value="2">Ngoại trú</option>
						<option value="1">Nhập viện</option>
					</select>
				</td>
				<th class="formTitle"></th>
				<td class="formValue" style="padding-left:20px;">
					<input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
				</td>
				<td class="formValue"></td>
			</tr>
		</table>
	</div>
</div>





<div class="ui-layout" id="layout" style="height:100%;width:100%;">
	<iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
			scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
</div>

<script type="text/javascript">
	var reportServerHOST = '@(ViewBag.ReportServerHOST)';
    var organId = '@(ViewBag.OrgId)';
	function submit() {
		if ($('#kssj').val().length == 0) {
			$.modalAlert("Thiếu Giờ bắt đầu", "error");
			return;
		}
		if ($('#jssj').val().length == 0) {
			$.modalAlert("Thiếu Giờ kết thúc", "error");
			return;
		}
		var url = getUrl();
		url += "&OrganizeId=" + organId;
		url += "&kssj=" + $('#kssj').val();
		url += "&jssj=" + $.getDate({ date: $('#jssj').val() }) + ' 23:59:59';
		url += "&ksmc=" + $('#depa').val();
		url += "&dlmc=" + $('#dlmc').val();
		url += "&xm=" + $('#xm').val();
		url += "&zyh=" + $('#zyh').val();
		url += "&sfxmmc=" + $('#sfxmmc').val();
		url += "&sfmz=" + $('#sfmz').val();
        setTimeout("$.loading(true, 'Đang yêu cầu trang báo cáo...');", 10);
        $("#iframerightiframerightiframerightttt").attr('src', url);
    }

    $("#iframerightiframerightiframerightttt").load(function () {
        $.loading(false);
	});

    $(function () {
        var h = $(window).height() - 65
        $('#layout iframe').css('height', h);
		init();
    });

    //Làm mới danh sách
    function refReport() {
        $("#btn_search").trigger('click');
    }

    function getUrl() {
        var reportServerHOST = '@(ViewBag.ReportServerHOST)';
		reportServerHOST += "ReportServer/Pages/ReportViewer.aspx?%2fHIS.Report.1%2f医保数据落地明细";
		//ReportServer/Pages/ReportViewer.aspx?%2fHIS.Report.1%2fChi tiết bệnh viện ứng trước&rs:Command=Render
        //Lấy kiểu tùy chỉnh
        if (true) {
            if (reportServerHOST.indexOf('&rc:Stylesheet') == -1) {
                reportServerHOST += "&rc:Stylesheet=MyStyleSheet";
            }
        }
        return reportServerHOST;
    }
</script>

<script type="text/javascript">
	function init() {
		//Hộp chọn liên kết trị liệu sư
		$("#depa").bindSelect({
			id: "Code",
			text: "Name",
			url: "/OutpatientManage/OutpatientRegSchedule/GetSysDepartmentList",
			dropdownAutoWidth: true
		});

		$('#depa').change(function () {
			submit();
		});
		//Hộp chọn liên kết tên loại lớn
		$("#dlmc").bindSelect({
			id: "dlcode",
			text: "dlmc",
			url: "/ReportManage/Report/GetDlMc",
			dropdownAutoWidth: true
		});

		$('#dlmc').change(function () {
			submit();
		});
	}
</script>
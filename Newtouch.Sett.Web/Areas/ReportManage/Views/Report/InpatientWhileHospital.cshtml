
@{
    ViewBag.Title = "InpatientWhileHospital";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<style>
    div[id$='_oReportDiv'] {
        background: red;
    }
</style>
<div class="rows">
    <div class="panel panel-default">
        <table class="form">
            <tr>
                <th class="formTitle">Khoa:</th>
                <td class="formValue">
                    <select id="depa" class="form-control">
                        <option value="">
                            Tất cả
                        </option>
                    </select>
                </td>
                <th class="formTitle">Ngày bắt đầu:</th>
                <td class="formValue">
                    <input id="kssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px"
                           onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy' })"
                           onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy', onpicked: function () { refReport(); } })"
                           value="@DateTime.Now.AddDays(-7).ToString("dd/MM/yyyy")" />
                </td>
                <th class="formTitle">Ngày kết thúc:</th>
                <td class="formValue">
                    <input id="jssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px"
                           onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy' })"
                           onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy', onpicked: function () { refReport(); } })"
                           value="@DateTime.Now.ToString("dd/MM/yyyy")" />
                </td>
                <th class="formTitle"></th>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
                <th></th>
                <td></td>
                <th></th>
                <td></td>
                <th></th>
                <td></td>
            </tr>
        </table>
    </div>
</div>
<div class="ui-layout" id="layout" style="height:100%;width:100%;">
    <iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
            scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
</div>
<script type="text/javascript">
    var reportServerHOST = '@(ViewBag.ReportServerHOST)';
    var orgId = '@(ViewBag.OrgId)';
    //var uri = '/ReportServer/Pages/ReportViewer.aspx?%2FHIS.Report.1%2F%E9%97%A8%E8%AF%8A%E8%B4%B9%E7%94%A8%E6%8A%A5%E8%A1%A8&rs:Command=Render';
    var uri = '/ReportServer/Pages/ReportViewer.aspx?%2FHIS.Report.1%2F%E4%BD%8F%E9%99%A2%E5%85%A8%E9%99%A2%E7%BB%9F%E8%AE%A1%E8%A1%A8&rs:Command=Render';
    function submit() {
        if ($('#kssj').val().length == 0) {
            $.modalAlert("Thiếu Giờ bắt đầu", "error");
            return;
        }
        if ($('#jssj').val().length == 0) {
            $.modalAlert("Thiếu Giờ kết thúc", "error");
            return;
        }
        if ($('#kssj').val() > $('#jssj').val()) {
            $.modalAlert("Thời gian bắt đầu không được lớn hơn thời gian kết thúc", "error");
            return;
        }
        var url = getUrl();

        url += "&kssj=" + $('#kssj').val();
        url += "&jssj=" + $('#jssj').val();
        url += "&depa=" + $('#depa').val();

        setTimeout("$.loading(true, 'Đang yêu cầu trang báo cáo...');", 10);
        $("#iframerightiframerightiframerightttt").attr('src', url);
    }

    $("#iframerightiframerightiframerightttt").load(function () {
        $.loading(false);
    });

    $(function () {
        var h = $(window).height() - 55;
        $('#layout iframe').css('height', h);
    });

    function getUrl() {
        if (uri.StartWith('/')) {
            uri = uri.substr(1);
        }
        var srcUrl = uri;
        srcUrl = reportServerHOST + srcUrl;

        //Lấy kiểu tùy chỉnh
        if (true) {
            if (srcUrl.indexOf('&rc:') == -1) {
                srcUrl += "&rc:Stylesheet=MyStyleSheet";
            }
        }
        if (true) {
            if (srcUrl.indexOf('&rs:') == -1) {
                srcUrl += "&rs:";
            }
            else {
                srcUrl += "&";
            }
            srcUrl += "orgId=";
            srcUrl += orgId;
        }
        return srcUrl;
    }

    $('#depa').change(function () {
       
        $('#btn_search').trigger("click");
    });
</script>
<script type="text/javascript">
    function funcOrganizeIdChange() {
        orgId = $("#OrganizeId").val();
        //Hộp chọn liên kết trị liệu sư
        $("#depa").bindSelect({
            id: "Code",
            text: "Name",
            url: "/OutpatientManage/OutpatientRegSchedule/GetSysDepartmentList",
            dropdownAutoWidth: true
        });
        submit();
    }
</script>
@Html.Partial("_ReportOrganizeIdDDLSearchView")



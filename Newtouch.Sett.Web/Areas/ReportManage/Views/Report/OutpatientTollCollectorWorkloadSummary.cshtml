@{
    ViewBag.Title = "";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<div class="rows">
    <div class="panel panel-default">
        <table class="form">
            <tr>
                <th class="formTitle">Ngày bắt đầu:</th>
	            <td class="formValue">
		            <input id="kssj" type="text" class="form-control input-wdatepicker form-an" style="width: 140px;"
		                   onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy HH:mm:ss'})" value="@(DateTime.Now.ToString("01/MM/yyyy 00:00:00"))" />
	            </td>
	            <td></td>
                <th class="formTitle" style="padding-right:5px;">Ngày kết thúc:</th>
	            <td class="formValue">
		            <input id="jssj" type="text" class="form-control input-wdatepicker form-an" style="width:140px"
		                   onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy HH:mm:ss' })" value="@(DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss"))" />
	            </td>
	            <td></td>
                <th class="formTitle">Khoa:</th>
                <td class="formValue">
                    <select id="depa" class="form-control">
                        <option value="">Tất cả</option>
                    </select>
                </td>
                <th class="formTitle">Nhân viên thao tác:</th>
                <td class="formValue">
                    <div class="row">
                        <div class="col-md-9">
                            <input type="text" class="form-control" id="txtsyy" value="" />
                        </div>
                        <div class="col-md-3" style="text-align:right;">
                            <input type="button" class="btn btn-default btn-md" style="width:45px" id="btnsyy" value="Tra cứu" />
                        </div>
                    </div>
                </td>
                <th class="formTitle"></th>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
                <td class="formValue"></td>
            </tr>
        </table>
    </div>
</div>

<div class="ui-layout" id="layout" style="height:100%;width:100%;">
    <iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
            scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
</div>

<script type="text/javascript">
    var reportServerHOST = '@(ViewBag.ReportServerHOST)';
    var orgId = '@(ViewBag.OrgId)';
    var isHospAdministrator = '@(ViewBag.IsHospAdministrator)';
    var curUserCode = '@(ViewBag.CurUserCode)';
    
    


    var uri = 'ReportServer/Pages/ReportViewer.aspx?%2FHIS.Report.1%2F%E9%97%A8%E8%AF%8A%E6%94%B6%E8%B4%B9%E5%91%98%E5%B7%A5%E4%BD%9C%E9%87%8F%E7%BB%9F%E8%AE%A1&rs:Command=Render';


    function submit() {

        if ($('#kssj').val().length == 0) {
            $.modalAlert("Thiếu Giờ bắt đầu", "error");
            return;
        }
        if ($('#jssj').val().length == 0) {
            $.modalAlert("Thiếu Giờ kết thúc", "error");
            return;
        }
        if ($('#kssj').val() > $('#jssj').val()) {
            $.modalAlert("Thời gian bắt đầu không được lớn hơn thời gian kết thúc", "error");
            return;
        }
        var url = getUrl();

        url += "&kssj=" + $('#kssj').val();
        url += "&jssj=" + $('#jssj').val();
        url += "&sfry=" + $("#txtsyy").val();

        setTimeout("$.loading(true, 'Đang yêu cầu trang báo cáo...');", 10);
        $("#iframerightiframerightiframerightttt").attr('src', url);
        
    }

    $("#iframerightiframerightiframerightttt").load(function () {
        $.loading(false);
    });

    $(function () {
        var h = $(window).height() - 55
        $('#layout iframe').css('height', h);
        init();

        setTimeout(function () { submit(); }, 100);
    });

    function getUrl() {
        if (uri.StartWith('/')) {
            uri = uri.substr(1);
        }
        var srcUrl = uri;
        srcUrl = reportServerHOST + srcUrl;

        //Lấy kiểu tùy chỉnh
        if (true) {
            if (srcUrl.indexOf('&rc:') == -1) {
                srcUrl += "&rc:Stylesheet=MyStyleSheet";
            }
        }
        if (true) {
            if (srcUrl.indexOf('&rs:') == -1) {
                srcUrl += "&rs:";
            }
            else {
                srcUrl += "&";
            }
            srcUrl += "orgId=";
            srcUrl += orgId;
        }
        return srcUrl;
    }

</script>
<script type="text/javascript">
    function init() {
        //Người thao tác
        $("#btnsyy").click(function () {
            $.modalOpen({
                id: "FormUsers",
                title: "Chọn Nhân viên thao tác",
                url: "/SystemManage/User/Selector?from=mzshoufeicaozuoyuan&organizeId=" + orgId + "&isExpand=true&callbackType=json&single=true",
                width: "300px",
                height: "400px",
                callBack: function (iframeId) {
                    top.frames[iframeId].AcceptClick(function (data) {
                        userStaffTreeCallback(data);
                    });
                }
            });
        });
        //phương thức gọi lại cây nhân viên người dùng
        function userStaffTreeCallback(data) {
            $("#txtsyy").val(data[0].Code);
        }

    }
</script>
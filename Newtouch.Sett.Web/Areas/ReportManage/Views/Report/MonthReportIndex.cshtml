
@{
    ViewBag.Title = "MonthReportIndex";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<div class="rows">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form">
            <tr>
                <th class="formTitle">Năm:</th>
                <td class="formValue">
                    <select id="year" name="year">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <th class="formTitle">Tháng:</th>
                <td class="formValue">
                    <select id="month" name="month">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
                <td class="formValue"></td>
                <td class="formValue"></td>
                <td class="formValue"></td>
            </tr>
        </table>
    </div>
</div>
<div id="divNavNew" class="rows hide">
    <div class="panel panel-default">
        <div class="panel-body">
            <span id="span"></span>Báo cáo cố định vẫn chưa được tạo,Nhấn<a id="btnToNewReport" class="text-primary">Tạo Mới báo cáo</a>
        </div>
        <div></div>
    </div>
</div>

<div class="gridPanel">
    <table id="gridList"></table>
</div>

@Html.Partial("_BottomButtonsView", new Newtouch.Sett.Web.Models.BottomButtonViewModel
{
    ShowKeyList = new[] { 6, 7, 9 },
    F6Text = "Tạo báo cáo",
    F7Text = "Xuất Excel",
    F9Text = "Tạo lại",
})

<script type="text/javascript">
    window.newtouch_globalconfig.f4opions = {
        container: "#aaaaaaaaaaaaaaaaaaaa"  //None
    };

    var details = [];
    var isregenerate = false;

    $('#year').select2({ minimumResultsForSearch: -1 });
    $('#month').select2({ minimumResultsForSearch: -1 });

    function initGridList(dlColArr) {
        var colModelArr = [
                {
                    label: "Loại bệnh nhân", name: "patientType", width: 60, align: "left", formatter: function (cellvalue) {
                        return cellvalue == "outpatient" ? "Ngoại trú" : (cellvalue == "inpatient" ? "Nhập viện" : "");
                    }
                },
                { label: "Số hồ sơ bệnh án", name: "blh", width: 80, align: "left" },
                {
                    label: "Số nhập viện/Số khám ngoại trú", name: "zyhmzh", width: 120, align: "left", formatter: function (cellvalue) {
                        return cellvalue === "0" ? "" : cellvalue;
                    }
                },
                { label: "Tên bệnh nhân", name: "brxm", width: 80, align: "left" },
        ];
        if (dlColArr && dlColArr.length && dlColArr.length > 0) {
            $.each(dlColArr, function () {
                colModelArr.push(this);
            });
        }
        //khai báo Chi tiết mục grid
        $("#gridList").newtouchLocalDataGrid({
            height: $(window).height() - 190,
            unwritten: false,
            colModel: colModelArr,
            caption: 'tháng báo cáo',
        });
    }
    initGridList();

    $('#btn_search').click(function () {
        newtouch_event_f4();
        var year = $('#year').val();
        var month = $('#month').val();
        if (year && month) {
            $.najax({
                url: '/ReportManage/Report/MonthReportConfirmedData',
                data: { year: year, month: month },
                loading: true,
                success: function (ajaxresp) {
                    if (!!ajaxresp.data && ajaxresp.data && ajaxresp.data.length > 0) {
                        $('#divNavNew').addClass('hide');
                        //báo cáobảngđãsinhthànhqua trìnhhiệncủa
                        formatRespData(ajaxresp.data);
                        //báo cáobảngsinhthànhngàykỳ
                        var caption = year + 'năm' + $.zeroPrefixInteger(month, 2) + 'tháng tháng báo cáo';
                        caption += '(Ngày tạo báo cáo đã cố định: ' + $.getDate({ date: new Date(ajaxresp.data[0].CreateTime) });
                        caption += ' Chi phí Tổng cộng:';
                        caption += getFeeTotal(ajaxresp.data).toFixed(2);
                        caption += ')';
                        $("#gridList").setCaption(caption);

                        $('#btn_bottombutton_f9').removeAttr('disabled');   //Tạo lại nút Có thể thao tác
                        $('#btn_bottombutton_f7').removeAttr('disabled');   //XuấtExcel Có thể thao tác
                    }
                    else {
                        $('#span').html(year + 'năm' + $.zeroPrefixInteger(month, 2) + 'tháng');
                        $('#divNavNew').removeClass('hide');
                    }
                }
            });
        }
    });

    $('#year, #month').change(function () {
        if (details && details.length && details.length > 0) {
            $('#btn_search').trigger('click');
        }
        else {
            newtouch_event_f4();
        }
    });

    $('#btnToNewReport').click(function () {
        newtouch_event_f4();
        loadRealTimeData();
    });

    function loadRealTimeData() {
        var year = $('#year').val();
        var month = $('#month').val();
        if (year && month) {
            $.najax({
                url: '/ReportManage/Report/MonthReportRealTimeData',
                data: { year: year, month: month },
                loading: true,
                success: function (ajaxresp) {
                    if (!!ajaxresp.data && ajaxresp.data.length && ajaxresp.data.length > 0) {
                        formatRespData(ajaxresp.data);

                        var caption = year + 'năm' + $.zeroPrefixInteger(month, 2) + 'tháng tháng báo cáo';
                        caption += '(Tổng chi phí vẫn chưa cố định: ';
                        caption += getFeeTotal(ajaxresp.data).toFixed(2);
                        caption += ')';
                        $("#gridList").setCaption(caption);

                        $('#btn_bottombutton_f6').removeAttr('disabled');   //Tạo báo cáo nút Có thể thao tác
                    }
                    else {
                        //Lấy dữ liệu thất bại
                        $.modalAlert("Chưa lấy được bất kỳ chi phí nào của tháng hiện tại<br/>Tạo báo cáo thất bại", 'error');
                    }
                },
                error: function () {
                    //Lấy dữ liệu thất bại
                    $.modalAlert("Chương trình xảy ra bất thường<br/>Tạo báo cáo thất bại", 'error');
                }
            });
        }
    }

    function newtouch_event_f4() {
        details = null;
        isregenerate = false;
        $('#divNavNew').addClass('hide');
        $('.gridPanel').html('<table id="gridList"></table>');  //xóa trướcgridnội dung
        initGridList();
        $('#btn_bottombutton_f6').attr('disabled', 'disabled');
        $('#btn_bottombutton_f9').attr('disabled', 'disabled');
        $('#btn_bottombutton_f7').attr('disabled', 'disabled');
    }
    $('#btn_bottombutton_f6').attr('disabled', 'disabled');
    $('#btn_bottombutton_f9').attr('disabled', 'disabled');
    $('#btn_bottombutton_f7').attr('disabled', 'disabled');

    function formatRespData(data) {
        details = data;
        var dlColArr = [];
        $.each(data, function () {
            var isContains = false;
            if (this.dl) {
                for (var iiii = 0; iiii < dlColArr.length ; iiii++) {
                    if (dlColArr[iiii].name == this.dl) {
                        isContains = true;
                        break;
                    }
                }
                if (!isContains) {
                    dlColArr.push({
                        label: this.dlmc, name: this.dl, width: 80, align: "left", formatter: "number"
                    });
                }
            }
        });
        $('.gridPanel').html('<table id="gridList"></table>');  //xóa trướcgridnội dung
        initGridList(dlColArr);
        //trìnhhiệnsốdữ liệu
        //xử lýdata đến Mục tiêuĐịnh dạng(Có cột loại lớn)
        $("#gridList").newtouchLocalDataGrid({ posttofirst: false, actions: 'addRowData' }, formatDlData(data));
        //trìnhhiệndatatrongbổ sungkhácnàomộtthực hiện
        var buchaRow = $.jsonWhere(data, function (v) {
            return !!v.bz && !!v.dlje;    //nàylàmộtbổ sungkhácghighi
        });
        if (buchaRow && buchaRow.length && buchaRow.length == 1) {
            buchaRow = buchaRow[0];
            //Chèn vàogridListDòng cuối cùng
            $("#gridList").newtouchLocalDataGrid({ posttofirst: false, actions: 'addRowData' }, [
                { zyhmzh: 'Bù chênh lệch: ' + buchaRow.dlje.toFixed(2), brxm: 'Điều chỉnh lý do:' + buchaRow.bz }]);
            var $tds = $('#gridList tr:last td:visible:gt(3)').not(':first');
            var tdslength = $tds.length;
            $('#gridList tr:last td:visible:eq(4)').attr('colspan', (tdslength + 1));
            $tds.remove();
        }
        //nàythánghợptính:
        //Chèn vàogridListDòng cuối cùng
        $("#gridList").newtouchLocalDataGrid({ posttofirst: false, actions: 'addRowData' }, [
            { zyhmzh: 'Tháng này Chi phí Tổng cộng:' + getFeeTotal(data).toFixed(2) }]);
        var $tds = $('#gridList tr:last td:visible:gt(2)').not(':first');
        var tdslength = $tds.length;
        $('#gridList tr:last td:visible:eq(3)').attr('colspan', (tdslength + 1));
        $tds.remove();
    }

    //resp data to data
    //xử lýdata đến Mục tiêuĐịnh dạng(Có cột loại lớn)
    function formatDlData(data) {
        var respData = [];
        $.each(data, function () {
            if (this.dl) {
                for (var iiii = 0; iiii < respData.length ; iiii++) {
                    if (respData[iiii].patientType === this.patientType
                        && respData[iiii].blh === this.blh
                        && respData[iiii].zyhmzh === this.zyhmzh
                        && respData[iiii].brxm === this.brxm) {
                        respData[iiii][this.dl] = this.dlje;
                        return; //return, màkhônglàcontinue
                    }
                }
                var newPatientData = { patientType: this.patientType, blh: this.blh, zyhmzh: this.zyhmzh, brxm: this.brxm };
                newPatientData[this.dl] = this.dlje;
                respData.push(newPatientData);
            }
        });
        return respData;
    }

    //F6Tạo báo cáo Cố định Điều chỉnh nổilớptrangmặt
    function newtouch_event_f6() {
        var year = $('#year').val();
        var month = $('#month').val();
        if (!details || !details.length || details.length == 0) {
            $.modalAlert("Chưa Lấy đến Chi phí", 'error');
            return;
        }
        $.modalOpen({
            id: "MonthReportDataConfirmPreview",
            title: year + 'năm' + $.zeroPrefixInteger(month, 2) + 'tháng' + 'báo cáo xác nhận',
            url: '/ReportManage/Report/MonthReportDataConfirmPreview?year=' + year + '&month=' + month + '&isregenerate=' + isregenerate + '&calcZje='
                + getFeeTotal(details),
            width: "450px",
            height: "350px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitMonthReport();
            }
        });
    };

    //F9 vui lòngyêu cầunặngmớisinhthànhbáo cáobảng
    function newtouch_event_f9() {
        $.modalConfirm("xác nhận Tạo lại", function (flag) {
            if (flag) {
                isregenerate = true;
                $('#btn_bottombutton_f9').attr('disabled', 'disabled');   //trước tiên để nódisabled
                $('#btn_bottombutton_f7').attr('disabled', 'disabled');    //trước tiên để nódisabled
                loadRealTimeData();
            }
        });
    }

    function getFeeTotal(data) {
        var total = 0;
        $.each(data, function () {
            total = $.addNum(total, this.dlje);
        });
        return total;
    }

    function init() {
        //Khởi tạo hộp chọn năm tháng
        var date = new Date;
        //Năm
        $("#year").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.yearArr && top.clients.yearArr.length) {
                    $.each(top.clients.yearArr, function () {
                        resultObjArr.push({ id: this, text: this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: 1900 + date.getYear(),
        });
        //Tháng
        $("#month").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.monthArr && top.clients.monthArr.length) {
                    $.each(top.clients.monthArr, function () {
                        resultObjArr.push({ id: this, text: parseInt(this) < 10 ? "0" + this : this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: date.getMonth() + 1,
        });

    }
    init();
</script>

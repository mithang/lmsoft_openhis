                { label: 'Tiền mặt quỹ chung theo đoạn', name: 'tcdxj', width: 60, align: 'left' },
                { label: 'Tài khoản quỹ chung theo đoạn', name: 'tcdzh', width: 60, align: 'left' },
                { label: 'Thanh toán từ quỹ chung', name: 'tczj', width: 60, align: 'left' },

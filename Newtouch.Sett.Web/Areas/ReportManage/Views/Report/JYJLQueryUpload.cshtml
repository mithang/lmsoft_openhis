
@{
    ViewBag.Title = "JYJLQueryUpload";
    Layout = "~/Views/Shared/_Form.cshtml";
    var reportUrl = "";
    var ReportSystemCode = "";
}
<div class="rows">
	<div class="panel panel-default">
		<table class="form">
			<tr>
				<th class="formTitle">Ngày bắt đầu：</th>
				<td class="formValue">
					<input id="ksrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px"
						   onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
						   onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
						   value="@DateTime.Now.ToString("yyyy-MM-01")" />
				</td>
				<th class="formTitle">Ngày kết thúc：</th>
				<td class="formValue">
					<input id="jsrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px"
						   onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
						   onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
						   value="@DateTime.Now.ToString("yyyy-MM-dd")" />
				</td>
				<th class="formTitle"></th>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" onclick="jyjlsearch();" class="btn btn-primary btn-md" value="phát sinh" style="width:55px" />
                    <input type="button" id="btn_searchtotxt" onclick="searchtotxt();" class="btn btn-primary btn-md" value="tải lên" style="width:55px" />
                    <input type="button" id="btn_searchhztotxt" onclick="searchhztotxt();" class="btn btn-primary btn-md" value="tổng hợp phát sinh" style="width:55px" />
                </td>
			</tr>
		</table>
	</div>
</div>
<div class="ui-layout" id="layout" style="height:100%;width:100%;">
    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</div>

<script>
    $(function () {
       gridList();
	});
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/ReportManage/Report/GetJyjlData",
            height: $(window).height()-200,
            postData: getpostData(),
            colModel: [
                { label: 'Số giao dịch', name: 'lsh', width: 60, align: 'left' },
                { label: 'Cơ sở Mã', name: 'jgdm', width: 60, align: 'left' },
                { label: 'Số thẻ', name: 'kh', width: 60, align: 'left' },
                { label: 'Tài khoản dấu hiệu', name: 'zhbz', width: 60, align: 'left' },
                { label: 'Loại bệnh nhân', name: 'brlx', width: 60, align: 'left' },
                { label: 'khám Số lần', name: 'jzcs', width: 60, align: 'left' },
                { label: 'giao dịch Thời gian', name: 'jysj', width: 60, align: 'left' },
                { label: 'Loại quyết toán', name: 'jslx', width: 60, align: 'left' },
                { label: 'giao dịch Tổng chi phí', name: 'jyzfy', width: 60, align: 'left' },

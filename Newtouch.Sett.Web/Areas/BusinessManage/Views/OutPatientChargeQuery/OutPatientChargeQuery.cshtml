@using NewtouchHIS.Lib.Framework.Operator;

@{
    ViewBag.Title = "OutPatienChargeQuery";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<form name="form1">
    <div class="panel panel-default" style="margin-top:10px;">
        <div class="panel-heading">
            thu phí đăng ký khám Tra cứu
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle">Số thẻ:</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="txtkh" name="txtkh" />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-default btn-md" value=". . ." onclick="" />
                    </td>
                    <th class="formTitle">Số hóa đơn：</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="txtfph" name="txtfph" />
                    </td>
                    <th class="formTitle">Họ tên：</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="txtxm" name="txtxm" />
                    </td>
                    <th></th>
                    <td class="formValue" rowspan="2">
                        <input type="button" id="btn_search" class="btn btn-default btn-md" style="width:50px; height:45px;" value="Tra cứu" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Thu ngân:</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="txtsyy" name="txtsyy" value=@OperatorProvider.GetCurrent().UserCode />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-default btn-md" value=". . ." onclick="" />
                    </td>
                    <th class="formTitle">Ngày thu phí：Từ</th>
                    <td class="formValue">
                        <input size="16" type="text" readonly class="form_datetime form-control" id="txtCreateTimestart">
                    </td>
                    <th class="formTitle">Đến：</th>
                    <td class="formValue">
                        <input size="16" type="text" readonly class="form_datetime form-control" id="txtCreateTimeEnd">
                    </td>
                </tr>
            </table>
        </div>
    </div>
        <div>
            <ul class="nav nav-tabs">
                <li class="active"><a href="#">Quyết toán ngoại trú</a></li>
            </ul>
            <div style="background-color: #fff;width:99%;">
                <table id="gridJSList" ></table>
            </div>
        </div>
        <div style="margin-top: 10px;">
            <ul class="nav nav-tabs">
                <li class="active"><a href="#">Chi tiết quyết toán ngoại trú</a></li>
            </ul>
            <div style="background-color: #fff;">
                <table id="gridJSMXList"></table>
            </div>
        </div>
        <div class="panel panel-default" style="margin-top:10px;">
            <div class="panel-heading">
                Tổng cộng
            </div>
            <div id="HjDiv" style="padding: 2px;padding-right:20px;"></div>
        </div>
    <div class="gridPanel">
        <table id="gridJSList"></table>
        <div id="gridPager"></div>
    </div>
</form>


<script>
    $(function () {
        gridJSListData();
        //nhấn Enter
        enterEvent();
    })
    $(".form_datetime").datetimepicker({
        //defaultDate: new Date(),
        format: 'yyyy-mm-dd',
        minView: 2,
        autoclose: true
    });
    //ngoại trúkhámtreosốkếttínhtratra cứu
    function gridJSListData() {
        var $gridJSList = $("#gridJSList");
        $gridJSList.dataGrid({
            height: 150,
            url: "/BusinessManage/OutPatientChargeQuery/SelectRegChargeQuery",
            colModel: [
                { label: 'Số thẻ', name: 'kh', width: 80, align: 'left' },
                { label: 'Họ tên', name: 'xm', width: 80, align: 'left' },
                { label: 'mã nội bộ đăng ký khám', name: 'ghnm', hidden:true, align: 'left' },
                { label: 'Số hóa đơn', name: 'fph', width: 100, align: 'left' },
                { label: 'Thu phí nhân viên', name: 'CreatorCode', width: 100, align: 'left' },
                { label: 'Ngày thu phí', name: 'CreateTime', width: 150, align: 'left' },
                { label: 'Chuyên khoa đăng ký khám', name: 'sfxmmc', width: 150, align: 'left' },
                { label: 'Bác sĩ', name: 'ys', width: 80, align: 'left' },
                { label: 'JSNM', name: 'jsnm', hidden: true, align: 'left' },
                {
                    label: 'hoàn', name: 'isreturned', width: 60, align: 'left', formatter: function (cellvalue)
                    {
                        return cellvalue == "1" ? "Có" : "Không";
                    }
                },
                {
                    label: 'In lại', name: 'isxfph', width: 60, align: 'left', formatter: function (cellvalue)
                    {
                        return cellvalue == "1" ? "Có" : "Không";
                    }
                },
                { label: 'Hoàn phí nhân viên', name: 'tCreatorCode', width: 80, align: 'left' },
                { label: 'color', name: 'isRed', hidden: true, align: 'left' }

            ],
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords: true,

            ////sự kiện nhấn
            //onSelectRow: function ()
            //{
            //    debugger;
            //    //Mỗi lần nhấn đúp，xóa chi tiết dòng trước trước Và tổng cộng
            //    $('#gridJSMXList').jqGrid("clearGridData");
            //    $("#table_HJ").remove();
            //    $.ajax({
            //        type: "POST",
            //        url: "/BusinessManage/OutPatientChargeQuery/GetRecordsByJsnm",
            //        data: { jsnm: $("#gridJSList").jqGridRowValue().jsnm },
            //        dataType: "json",
            //        success: function (ajaxresp) {
            //            if (ajaxresp.state == 'success') {
            //                $('#gridJSMXList').newtouchLocalDataGrid(null, ajaxresp.data.ghRecordsDetails);
            //                //Tải động thông tin tổng cộng
            //                $("#HjDiv").append("<table class='form' id='table_HJ'>")
            //                $("#table_HJ").append(" <tr>");
            //                //Tải tổng cộng loại chi phí lớn ở dưới trang
            //                for (i = 0; i < ajaxresp.data.dlhj.length; i++) {
            //                    $("#table_HJ").append("<th class='formTitle'>" + ajaxresp.data.dlhj[i].dlmc + "</th>");
            //                    $("#table_HJ").append("<td class='formValue'><label>" + ajaxresp.data.dlhj[i].jehj + "</label></td>");
            //                }
            //                $("#table_HJ").append(" </tr>");
            //                $("#table_HJ").append(" </table>");
            //            }
            //        }
            //    });
            //},
            //Grid thêmtảixongthànhsauđiềudùng
            gridComplete: function () {
                 afterCompleteFunction();
            },
        });
        $("#btn_search").click(function () {
            $gridJSList.jqGrid('setGridParam', {
                postData: { kh: $("#txtkh").val(), fph: $("#txtfph").val(), xm: $("#txtxm").val(), syy: $("#txtsyy").val(), CreateTimestart: $("#txtCreateTimestart").val(), CreateTimeEnd: $("#txtCreateTimeEnd").val() },
            }).trigger('reloadGrid');
        });

    }

    //Đã hoàn/In lại Màu nền là đỏ 
    function afterCompleteFunction()
    {
        var ids = $("#gridJSList").getDataIDs();
        for (i = 0; i < ids.length; i++) {
            var rowData = $("#gridJSList").getRowData(ids[i]);
            if (rowData.isRed == "1")
            {
                $("#" + ids[i]).find("td").css("background-color", "rgb(244, 120, 110)");
            }
        }
    }

    //đôinhấnviệchạng
    function btn_edit()
    {
        ////Mỗi lần nhấn đúp，xóa chi tiết dòng trước trước Và tổng cộng
        $('#gridJSMXList').jqGrid("clearGridData");
        $("#table_HJ").remove();
        $.ajax({
            type: "POST",
            url: "/BusinessManage/OutPatientChargeQuery/GetRecordsByJsnm",
            data: { jsnm: $("#gridJSList").jqGridRowValue().jsnm },
            dataType: "json",
            success: function (ajaxresp) {
                if (ajaxresp.state == 'success') {
                    $('#gridJSMXList').newtouchLocalDataGrid(null, ajaxresp.data.ghRecordsDetails);
                    //Tải động thông tin tổng cộng
                    $("#HjDiv").append("<table class='form' id='table_HJ'>")
                    $("#table_HJ").append(" <tr>");
                    //Tải tổng cộng loại chi phí lớn ở dưới trang
                    for (i = 0; i < ajaxresp.data.dlhj.length; i++) {
                        $("#table_HJ").append("<th class='formTitle'>" + ajaxresp.data.dlhj[i].dlmc + "</th>");
                        $("#table_HJ").append("<td class='formValue'><label>" + ajaxresp.data.dlhj[i].jehj + "</label></td>");
                    }
                    $("#table_HJ").append(" </tr>");
                    $("#table_HJ").append(" </table>");
                }
            }
        });
    }

    //Chi tiết quyết toán ngoại trú jGridkhai báo
    $('#gridJSMXList').newtouchLocalDataGrid({
        height: 100,
        unwritten: false,
        sortable: false,
        colModel: [
            { label: 'Số đơn thuốc', name: 'chufanghao',width:150, key: true },
            { label: 'Mã khoản mục', name: 'sfxm', width: 150, align: 'left' },
            { label: 'Tên khoản mục', name: 'ypmc', width: 150, align: 'left' },
            { label: 'Đơn vị', name: 'danwei', width: 150, align: 'left' },
            { label: 'Khoản mục nhóm lớn', name: 'dlmc', width: 150, align: 'left' },
            { label: 'Đơn giá', name: 'dj', width: 150, align: 'left' },
            { label: 'Số lượng', name: 'sl', width: 150, align: 'left' },
            { label: 'Số tiền', name: 'je', width: 150, align: 'left' }

        ]
    });

    //nhấn Enter nhảyđếndướimộtcáiđiều khiểnhạng
    function enterEvent()
    {
        //quayxephím
        $("#txtkh").keypress(function (e) {
            if (e.keyCode == 13) {
                if ($("#txtkh").val().trim().length == 28) {
                    $("#txtkh").val().substring(0, 10);
                }
                $("#txtfph").focus();
            }

        });
        $("#txtfph").keypress(function (e) {
            if (e.keyCode == 13) {
                $("#txtxm").focus();
            }
        });
        $("#txtxm").keypress(function (e) {
            if (e.keyCode == 13) {
                $("#txtsyy").focus();
            }
        });
        $("#txtsyy").keypress(function (e) {
            if (e.keyCode == 13) {
                $("#txtCreateTimestart").focus();
            }
        });
        $("#txtCreateTimestart").keypress(function (e) {
            if (e.keyCode == 13) {
                $("#txtCreateTimeEnd").focus();
            }
        });
        $("#txtCreateTimeEnd").keypress(function (e) {
            if (e.keyCode == 13) {
                $("#btn_search").focus();
            }
        });
        $("#btn_search").keypress(function (e) {
            if (e.keyCode == 13) {
                gridJSListData();
            }
        });
    }

</script>



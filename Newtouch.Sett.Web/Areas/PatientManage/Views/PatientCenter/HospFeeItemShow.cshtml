@{

    Layout = "~/Views/Shared/_Form.cshtml";
}
<form>
    <div class="topPanel" style="border-bottom:1px solid rgb(221, 221, 221);margin-bottom: -1%;">
        <table class="form">
            <tr>
                <td style="width:2%">
                    <div class="toolbar" style="margin-top: 1%;">
                        <div class="btn-group">
                            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
                        </div>
                    </div>
                </td>
                <th class="formTitle">Tìm kiếm mục：</th>
                <td class="formValue">
                    <input id="dlCode" name="dlCode" type="text" class="form-control" placeholder="Theo Khoản mục Mã Tên khoản mục hoặc mã viết tắt" />
                </td>

                <td style="padding-left:20px;" class="formValue">
                    <input type="button" id="btn_search" style="margin-left:3%; width:35%; margin-top:-2%;" class="btn btn-primary" value="Tra cứu" />
                </td>
            </tr>
        </table>
    </div>
    <div class="gridPanel" style="margin-top:1%">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>


<script>
    var zyh = $.request("zyh");
    var dlCode = $.request("dlCode");
    $(function () {
        gridInit();
        $("#btn_search").click(function () {
            $("#gridList").jqGrid('setGridParam', {
                postData: { keyword: $("#dlCode").val() },
            }).trigger('reloadGrid');
        });
    });

    function gridInit() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            postData: { zyh: zyh, group: "2", sfdl: dlCode },
            url: "/PatientManage/PatientCenter/GetFeeInfobySfdl",
            height: $(window).height() - 120,
            colModel: [
                { label: 'Nhóm thu phí lớn', name: 'dlmc', align: 'center', width: 100 },
                { label: 'thuộc tính', name: 'zfxz', align: 'center', width: 40 },
                { label: 'Tên khoản mục', name: 'sfxmmc', align: 'left', width: 150 },
                { label: 'Quy cách', name: 'gg', align: 'center', width: 60 },
                { label: 'Đơn vị', name: 'jfdw', align: 'center', width: 60 },
                {
                    label: 'Đơn giá', name: 'dj', align: 'center', width: 60, formatter: "number"
                    , formatoptions: { decimalPlaces: 4, defaultValue: '0.0000' }
                },
                { label: 'Số lượng', name: 'sl', align: 'center', width: 30 },
                { label: 'zyh', name: 'zyh', align: 'center', hidden: true, },
                {
                    label: 'Chi phí', name: 'je', align: 'center', width: 60, formatter: "number"
                    , formatoptions: { decimalPlaces: 2, defaultValue: '0.0000' }
                },
                { label: 'Có tự phí hay không', name: 'zzfbz', align: 'center', width: 80 },
                { label: 'sfxm', name: 'sfxm', align: 'center', hidden: true, },
                //{ label: 'Ngày tính giá', name: 'tdrq', align: 'center', width: 100 },

            ],
            //pager: "#gridPager",
            //sortname: 'sfxmmc',
            viewrecords: true,
            //rowNum:100,
            ondblClickRow: function (rowIndex, s) {
                getItemsbySfxm(rowIndex);
            }
        });
    }

    function getItemsbySfxm(id) {
        var rowData = $("#gridList").jqGrid('getRowData', id);
        var smxm = rowData.sfxm + "|" + rowData.dj;
        if (!!rowData) {
            $.modalOpen({
                id: "mxcx",
                title: "Chi tiết mục",
                url: "/PatientManage/PatientCenter/HospFeeItemDetailShow?sfxm=" + smxm + "&zyh=" + zyh,
                width: "800px",
                height: "600px",
                btn: null,
                callBack: function (iframeId) {
                }
            });
        }
    }
</script>
                    savedata.cs_shi = $(this).find(" select[name='city'] option:selected").text().replace(' - Vui lòng chọn - ', '');
                    savedata.cs_xian = $(this).find(" select[name='area'] option:selected").text().replace(' - Vui lòng chọn - ', '');

                else if (e.id.indexOf('_HKDZ') != -1) {
                    savedata.hu_sheng = $(this).find(" select[name='province'] option:selected").text().replace(' - Vui lòng chọn - ', '');
                    savedata.hu_shi = $(this).find(" select[name='city'] option:selected").text().replace(' - Vui lòng chọn - ', '');
                    savedata.hu_xian = $(this).find(" select[name='area'] option:selected").text().replace(' - Vui lòng chọn - ', '');
                }
                else if (e.id.indexOf('_JJLXRDZ') != -1) {
                    savedata.jjlxr_sheng = $(this).find(" select[name='province'] option:selected").text().replace(' - Vui lòng chọn - ', '');

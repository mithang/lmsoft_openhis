<script type="text/javascript">
    var openYbSett = '@openYbSett' === 'True'; //cấu hình công tắc:bệnh nhân BHYT có dùng quy trình giao dịch BHYT không
    var ybSettOnce = '@ybSettOnce' === 'True'; //cấu hình công tắc:bệnh nhân BHYT có quyết toán một lần không
    var medicalInsurance = '@medicalInsurance';//cấu hình địa phương BHYT:phân biệt khu vực BHYT của bệnh viện
    //Đọc thẻ
    function readCard() {
        var cardInfo;
        var yibaoCardInfo;
        var cqcardInfo;
        var cqyibaoCardInfo;
        if (medicalInsurance === "changshu") {
            yibaoCardInfo = $.yibao.GetCardInfo($('#readCardCardType').val()); //đọc thẻ BHYT, trả về thông tin danh tính thẻ
            $.loading(false);
            if (yibaoCardInfo && yibaoCardInfo.Code === 0) {
                cardInfo = yibaoCardInfo.Data;
                yibaoCardInfo.readCardCardType = $('#readCardCardType').val();
                localStorage.setItem("patientform", JSON.stringify(yibaoCardInfo));
                //thẻ đã đọc được
                //Số thẻ Loại thẻ    //Số BHXH Tạm thời làm số thẻ hệ thống
                GetQueryFphAjax({ blh: null, kh: cardInfo.DAC001, zjh: null, cardType: ybkCardType }, function () {
                    if (patModel) {
                        //Gán giá trị đối chiếu tính chất bệnh nhân Mặc định dùng tính chất chi phí mới nhất còn phải chopatModel.brxz patModel.brxzmc
                        var ybfyxzCompResult = $.CataComparison.getItemByTT('yibao', 'AKE556', cardInfo.AKE556);
                        if (!ybfyxzCompResult.Name) {
                            $.modalAlert("Tính chất chi phí.Ánh xạ danh mục đối chiếu thất bại", 'error');
                            return;
                        }
                        patModel.brxz = ybfyxzCompResult.Code;
                        patModel.brxzmc = ybfyxzCompResult.Name;
                        $("#brxzmc").attr("data-brxzmc", ybfyxzCompResult.Name)
                            .attr("data-brxz", ybfyxzCompResult.Code);
                        $("#brxzmc").val(ybfyxzCompResult.Name);
                    }
                });
            }
            else {
                $.modalAlert(yibaoCardInfo.ErrorMsg, 'error');
                return;
            }
        }
        else if (medicalInsurance === "guian") { //quýany tếbảo hiểm
            if ($('#readCardCardType').val() === "04") {
                //= $.guianyibao.Identification(); //đọc thẻ BHYT, trả về thông tin danh tính thẻ
                var payoptype = { "prm_payoptype": "04" };
                $.ajax({
                    url: "http://127.0.0.1:12345/api/YiBao/Identification",
                    data: payoptype,
                    dataType: "json",
                    async: false,
                    success: function (data) {
                        yibaoCardInfo = eval('(' + data + ')');
                    }
                });
                $.loading(false);
                if (yibaoCardInfo) {
                    if (yibaoCardInfo.Code === 0) {
                        cardInfo = yibaoCardInfo.Data; //đối tượng phản hồi BHYT
                        if (cardInfo.prm_ykc023 === "1") {
                            $.modalAlert("Hiện đang ở trạng thái nằm viện, không cho phép quẹt thẻ ngoại trú", 'error');
                            return;
                        }
                        yibaoCardInfo.readCardCardType = $('#readCardCardType').val();
                        yibaoCardInfo.kh = cardInfo.prm_aac001;
                        localStorage.setItem("patientform", JSON.stringify(yibaoCardInfo));
                        GetQueryFphAjax({ blh: null, kh: cardInfo.prm_aac001, zjh: null, cardType: ybkCardType },
                            function () {
                                if (patModel) {
                                    //Gán giá trị đối chiếu tính chất bệnh nhân Mặc định dùng tính chất chi phí mới nhất còn phải chopatModel.brxz patModel.brxzmc
                                    var ybfyxzCompResult = {
                                        Code: '1',
                                        Name: 'BHYT thường'
                                    };
                                    //$.CataComparison.getItem('yibao', 'xt_brxz', "1"); //cố địnhđịnhlày tếbảo hiểm,chỉcóy tếbảo hiểmquẹtthẻ(1,BHYT)
                                    if (!ybfyxzCompResult.Name) {
                                        $.modalAlert("Tính chất chi phí.Ánh xạ danh mục đối chiếu thất bại", 'error');
                                        return;
                                    }
                                    patModel.brxz = ybfyxzCompResult.Code;
                                    patModel.brxzmc = ybfyxzCompResult.Name;
                                    $("#brxzmc").attr("data-brxzmc", ybfyxzCompResult.Name)
                                        .attr("data-brxz", ybfyxzCompResult.Code);
                                    $("#brxzmc").val(ybfyxzCompResult.Name);
                                }
                            });
                        $("#txtybye").html(cardInfo.prm_akc087);
                    } else {
                        $.modalAlert("Quẹt thẻ thất bại:" + yibaoCardInfo.ErrorMsg, 'error');
                    }
                } else {
                    $.modalAlert("Quẹt thẻ lấy thông tin BHYT thất bại! Nguyên nhân thất bại: trung tâm BHYT không trả về thông tin, vui lòng thử lại!", 'error');
                }
            } else if ($('#readCardCardType').val() === "03") {
                try {
                    //= $.guianyibao.ReadIdCard(); //Đọc thẻ CMND/CCCD, trả về thông tin danh tính thẻ
                    $.ajax({
                        url: "http://127.0.0.1:12345/api/YiBao/ReadIdCard",
                        data: {},
                        dataType: "json",
                        async: false,
                        success: function (data) {
                            cardInfo = eval('(' + data + ')');
                        }
                    });
                    $.loading(false);
                    if (cardInfo) {
                        if (cardInfo.Code === 0) {
                            cardInfo.readCardCardType = $('#readCardCardType').val();
                            GetQueryFphAjax({ blh: null, kh: null, zjh: cardInfo.cardId, cardType: xnkCardType },
                                function () {
                                    if (patModel) {
                                        patModel.brxz = "0";
                                        patModel.brxzmc = "Tự chi trả";
                                        $("#brxzmc").attr("data-brxzmc", "Tự chi trả")
                                            .attr("data-brxz", "0");
                                        $("#brxzmc").val("Tự chi trả");
                                    }
                                });
                        } else {
                            $.modalAlert("Quẹt CMND/CCCD thẻ Thất bại：" + cardInfo.ErrorMsg, 'error');
                        }
                    } else {
                        $.modalAlert("Quẹt CMND/CCCD thẻ Lấy thông tin thất bại", 'error');
                    }
                } catch (err) {
                    $.modalAlert("Quẹt CMND/CCCD thẻ Thất bại Thất bại, Vui lòng thao tác lại" + err, 'error');
                }
            } else if ($('#readCardCardType').val() === "06") {
                //hợp tác nông thôn mới
                $.loading(false);
                $.modalOpen({
                    id: "Form",
                    title: "Gia đình Tham gia bảo hiểm Tham số nhập",
                    url: "/PatientManage/HospiterRes/XNHfamilyrequestParForm",
                    width: "450px",
                    height: "224px",
                    callBack: function (iframeId) {
                        top.frames[iframeId].submitForm(function (jrespdata) {
                            if (!!jrespdata && jrespdata.length > 0) {
                                jrespdata.readCardCardType = $('#readCardCardType').val();
                                localStorage.setItem("jrespdata", JSON.stringify(jrespdata));
                                $.modalOpen({
                                    id: "XNHParticipantsList",
                                    title: "Gia đình Tham gia bảo hiểm người Danh sách",
                                    url: "/PatientManage/HospiterRes/XNHParticipantsList",
                                    width: "850px",
                                    height: "424px"
                                });
                            }
                        });
                    }
                });
            }
        }
        else if (medicalInsurance === "chongqing") {
            if ($('#readCardCardType').val() === "04" || $('#readCardCardType').val() === "07") {
                //= $.guianyibao.Identification(); //đọc thẻ BHYT, trả về thông tin danh tính thẻ
                GetReadCardInfo(null,false);
            }
        }
        else {

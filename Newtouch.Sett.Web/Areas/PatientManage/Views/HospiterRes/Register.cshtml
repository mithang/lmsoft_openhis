                    //làthânphầnchứngđọcthẻ，chưa từng đăng ký
                    $.modalConfirm("Thẻ chưa đăng ký，Có tạo đăng ký mới không", function (flag) {
                        if (flag) {
                            //$('#noCardRes').trigger('click');
                            btn_NocardRes();
                        }
                    });
                }
                else {
                    $.xhrSuccessDataExCheckHandle(rep, true);
                }
            }
        });

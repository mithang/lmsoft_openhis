            if (zffs === "sm")//Chứng từ điện tử
            {
                payoptype.mdtrt_cert_type = "01";
                if (sbytj == "Y") {
                    url = "http://127.0.0.1:33333/api/YiBao/CardecInfo_1162";
                } else {
                    url = "http://127.0.0.1:33333/api/YiBao/CardecInfo_1162A";
                }
            }
            if (zffs === "sfz") {//CMND/CCCD
                payoptype.mdtrt_cert_type = "02";
                payoptype.mdtrt_cert_no = patsfz;
                payoptype.psn_name = patName;
                url = "http://127.0.0.1:33333/api/YiBao/CardecInfo_1163";
            }
            if (zffs === "ck") {//thẻ từ BHYT
                payoptype.mdtrt_cert_type = "00";
                payoptype.mdtrt_cert_no = patsfz;
                url = "http://127.0.0.1:33333/api/YiBao/CardecInfo_1101";
            }
            if (zffs === "sl") {//Quét khuôn mặt
                payoptype.mdtrt_cert_type = "02";
                url = "http://127.0.0.1:33333/api/YiBao/CardecInfo_1164";
            }
            @*if ('@YB_Jzpzl' != 'ON') {
                if (zffs === "sm") {
                    url = "http://127.0.0.1:33333/api/YiBao/CardecInfo_1162";
                }
                if (ydsfz.length > 0) {
                    payoptype.mdtrt_cert_no = ydsfz;
                    payoptype.mdtrt_cert_type = "02";
                    url = "http://127.0.0.1:33333/api/YiBao/CardecInfo_1101";
                }
                if (zffs === "ck") {
                    payoptype.mdtrt_cert_type = "00";
                    payoptype.mdtrt_cert_no = khxx;
                    url = "http://127.0.0.1:33333/api/YiBao/CardecInfo_1101";
                }
            }*@
            $.ajax({
                type: "POST",
                url: url,
                dataType: "json",
                data: payoptype,
                async: false,
                success: function (data) {
                    yibaoCardInfo = eval('(' + data + ')');
                }
            });
            $.loading(false);
            debugger;
            if (yibaoCardInfo) {
                if (yibaoCardInfo.infcode == "0" || yibaoCardInfo.infcode == 0) {
                    if ('@YB_Jzpzl' === 'ON') {
                        var cardecinfo = yibaoCardInfo.output.cardecinfo;
                        switch (cardecinfo.mdtrt_cert_type) {
                            case "01"://Chứng từ điện tử
                                zffs = '3';
                                payoptype.mdtrt_cert_type = "01";
                                payoptype.mdtrt_cert_type = cardecinfo.mdtrt_cert_type;
                                break;
                            case "02"://CMND/CCCD
                                zffs = '4';
                                break;
                            case "03"://thẻ BHXH
                                zffs = '2';
                                /* sbkobj.sbkh = cardecinfo.mdtrt_cert_no;*/
                                payoptype.mdtrt_cert_type = cardecinfo.mdtrt_cert_type;
                                break;
                        }
                    }
                    cardInfo1 = yibaoCardInfo.output.baseinfo; //thông tin cơ bản BHYT
                    if (yibaoCardInfo.output.insuinfo.length > 1) {
                        for (var i = 0; i < yibaoCardInfo.output.insuinfo.length; i++) {
                            if (yibaoCardInfo.output.insuinfo[i].paus_insu_date)

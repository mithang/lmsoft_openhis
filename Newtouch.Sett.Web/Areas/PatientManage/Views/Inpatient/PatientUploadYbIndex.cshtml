        sxGridJSListData()
    });
    //
    $('#btn_zfsc').click(function () {
        zfUploadData($('#zfscsel').val());
    });

    function zfUploadData(upobj) {
        var zflx = $("#zflxscsel").val();
        var hisId = '';
       
        var seleRow;
        if (zflx === 'mz') {
            seleRow = $("#mzzfgridList").jqGridRowValue();
            hisId = seleRow.mzh;
        } else if (zflx === 'zy') {
            seleRow = $("#zyzfgridList").jqGridRowValue();
            hisId = seleRow.zyh;
        }
        if (!!!seleRow) {
            $.modalAlert("Vui lòng chọn một dòng dữ liệu", "warning");
            return;
        }
        var isBrxzOk = seleRow.brxzmc !== 'Tu chi tra';
        if (isBrxzOk) {
            $.modalAlert("Lỗi:Chọn của Có Không phải Tự chi trả", "warning");
            return;
        }
        var dbscobj = { jsnm: seleRow.jsnm, hisId: hisId, operatorId: '@(opr.rygh)', operatorName: '@(opr.UserName)', orgId: '@(opr.OrganizeId)', cplt_flag: "1" };
         var upUrl;
         switch (upobj) {
            case '4201':
                 upUrl = "http://127.0.0.1:33333/api/YiBao/PostSelfPayPatientFee_4201";
                 $.modalAlert("này giao diện Tạm lúc Không có dùng", "warning");
                 return
                break;
            case '4201A':
                 upUrl = "http://127.0.0.1:33333/api/YiBao/PostSelfPayPatientFee_4201A";
                 if (seleRow.sfyb == '已上传') {
                     $.modalAlert("Dữ liệu này đã tải lên,Không cần tải lên lặp lại", "warning");
                     return;
                 }
                break;
            case '4202':
                 upUrl = "http://127.0.0.1:33333/api/YiBao/PostSelfPayPatientFee_4202";
                 if (seleRow.sfyb == '已上传') {
                     $.modalAlert("Dữ liệu này đã tải lên,Không cần tải lên lặp lại", "warning");
                     return;
                 }
                break;
            case '4203':
                 upUrl = "http://127.0.0.1:33333/api/YiBao/PostSelfPayPatientFee_4203";
                 if (seleRow.sfyb !== '已上传') {
                     $.modalAlert("này dữ liệu Tạm Chưa tải lên,Vui lòng tải lên sau sau đó Gửi", "warning");
                     return;
                 }
                break;
            case '4204':
                 upUrl = "http://127.0.0.1:33333/api/YiBao/PostSelfPayPatientFee_4204";
                 if (seleRow.sfyb !== '已上传') {
                     $.modalAlert("này dữ liệu Tạm Chưa tải lên Không thể Xóa", "warning");
                     return;
                 }
                break;
            case '4205':
                 upUrl = "http://127.0.0.1:33333/api/YiBao/PostSelfPayPatientFee_4205";
                 if (seleRow.sfyb == '已上传') {
                     $.modalAlert("Dữ liệu này đã tải lên,Không cần tải lên lặp lại", "warning");
                     return;
                 }
                break;
            case '4206':
                 upUrl = "http://127.0.0.1:33333/api/YiBao/PostSelfPayPatientFee_4206";
                 if (seleRow.sfyb !== '已上传') {
                     $.modalAlert("này dữ liệu Tạm Chưa tải lên Không thể Xóa", "warning");
                     return;
                 }
                break;
        }
        $.loading("dữ liệu tải lên trong,Vui lòng chờ một chút");
        $.ajax({
            type: "POST",
            url: upUrl,
            data: dbscobj,
            dataType: "json",
            async: false,
            success: function (data) {
                var tfReturn = eval('(' + data + ')');
                if (tfReturn) {
                    if (tfReturn.infcode == "0") {
                        if (upobj == "4202") {
                            if (seleRow.sfyb == '已上传') {
                                $.modalAlert("Dữ liệu này đã tải lên,Không cần tải lên lặp lại", "warning");
                                return;
                            }
                            PostSelfPayPatientFee_4201A(dbscobj)
                        } else {
                            $.loading(false);
                            $.modalAlert("Số nhập viện/Số khám ngoại trú là:" + hisId + ",Tải lên thành công", 'warning');
                        }
                       
                    }
                    else {
                        $.loading(false);
                        $.modalAlert("Số nhập viện/Số khám ngoại trú-" + hisId +"Tải lên thất bại:" + tfReturn.err_msg, 'error');
                    }
                }
            }, error: function (request, error, ex) {
                $.loading(false);
                $.modalAlert("Dịch vụ BHYT【" + upobj + "】Không thể truy cập:[" + ex + "]", 'error');
            }
        });
        sxGridJSListData()
    }

    function PostSelfPayPatientFee_4201A(dbscobj) {
        $.ajax({
            type: "POST",
            url: 'http://127.0.0.1:33333/api/YiBao/PostSelfPayPatientFee_4201A',
            data: dbscobj,
            dataType: "json",
            async: false,
            success: function (data) {
                var tfReturn = eval('(' + data + ')');
                if (tfReturn) {
                    if (tfReturn.infcode == "0") {
                        $.loading(false);
                        $.modalAlert("Số nhập viện/Số khám ngoại trú là:" + dbscobj.hisId + ",Tải lên thành công", 'warning');
                    }
                    else {
                        $.loading(false);
                        $.modalAlert("Số nhập viện/Số khám ngoại trú-" + dbscobj.hisId + "Tải lên thất bại:" + tfReturn.err_msg, 'error');
                    }
                }
            }, error: function (request, error, ex) {
                $.loading(false);
                $.modalAlert("Dịch vụ BHYT【4201A】Không thể truy cập:[" + ex + "]", 'error');
            }
        });
    }
</script>
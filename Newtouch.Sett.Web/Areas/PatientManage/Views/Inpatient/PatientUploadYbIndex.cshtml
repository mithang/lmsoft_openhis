<script>
    $(function () {
        initControl();
        gridList();
    })
    function gridList() {
        if ($("#ksmc").val() == "") {
            $("#ksmc").attr("data-label", "");
        }
        if ($("#bqmc").val() == "") {
            $("#bqmc").attr("data-label", "");
        }
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/PatientManage/Inpatient/GridInPatientGridJson",
            height: $(window).height() - 188,
            postData: {
                keyword: $("#txt_keyword").val(), zybz: $("#zybz").val(), ryrqkssj: $("#ryrqkssj").val(),
                yrqjssj: $("#ryrqjssj").val(), ksmc: $("#ksmc").attr("data-label"), bqmc: $("#bqmc").attr("data-label")
            },
            colModel: [
                { label: 'Số nhập viện', name: 'zyh', width: 50, align: 'left', key: true },
                {
                    label: 'Đang nằm viện dấu hiệu', name: 'zybz', width: 60, align: 'left', formatter: function (cellvalue) {
                        return $.enum.getDescByValue("EnumZYBZ", cellvalue);
                    }
                },
                { label: 'Số hồ sơ bệnh án', name: 'blh', hidden: true },
                { label: 'Có tải lên hay không', name: 'issc', width: 60, align: 'left' },
                { label: 'Họ tên', name: 'xm', width: 60, align: 'left' },
                { label: 'Giới tính', name: 'sexValue', width: 40, align: 'left' },
                {
                    label: 'Tuổi', name: 'nlshow', width: 40, align: 'left', formatter: function (cellvalue, a, b) {
                        return getAgeFromBirthTime({ begin: b.csny }).text;
                    }
                },
                { label: 'Khoa bệnh', name: 'bqmc', width: 80, align: 'left' },
                { label: 'Dân tộc', name: 'mzmc', width: 50, align: 'left', hidden: true },
                { label: 'Điện thoại', name: 'lxrdh', width: 80, align: 'left', hidden: true },
                { label: 'Năm sinh', name: 'csny', width: 80, align: 'left', hidden: true },
                { label: 'Số giấy tờ', name: 'zjh', width: 120, align: 'left' },
                { label: 'brxz', name: 'brxz', width: 80, align: 'left', hidden: true },
                { label: 'CardType', name: 'CardType', width: 80, align: 'left', hidden: true },
                { label: 'cbdbm', name: 'cbdbm', width: 80, align: 'left', hidden: true },
                { label: 'Tính chất chi phí', name: 'brxzmc', width: 80, align: 'left' },
                {
                    label: 'Nhập viện Trạng thái', name: 'rybq', width: 50, align: 'left', hidden: true, formatter: function (cellvalue) {
                        return $.enum.getDescByValue("EnumWzjb", cellvalue);
                    }
                },
                { label: 'chẩn đoán đầu tiên', name: 'zzdmc', width: 100, align: 'left' },
                { label: 'Ngày nhập viện', name: 'ryrq', width: 80, align: 'left' },
                { label: 'Ngày xuất viện', name: 'cyrq', width: 80, align: 'left' },
                { label: 'Đã phát sinh phí', name: 'zyfy', width: 80, align: 'left' },
                { label: 'setl_id', name: 'setl_id', hidden: true },
                { label: 'psn_no', name: 'psn_no', hidden: true },
                { label: 'mdtrt_id', name: 'mdtrt_id', hidden: true },
                { label: 'tạm ứng phí', name: 'yjj', width: 50, align: 'left' },
                { label: 'jzh', name: 'jzh', width: 80, align: 'left', hidden: true },

                {
                    label: 'Cuối cùng Thời gian cập nhật', name: 'UpdateTime', width: 80, align: 'left',
                    formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }
                },
            ],
            pager: "#gridPager",
            sortname: 'ryrq,UpdateTime',
            viewrecords: true
        });
        $("#btn_search").click(function () {
            if ($("#ksmc").val() == "") {
                $("#ksmc").attr("data-label", "");
            }
            if ($("#bqmc").val() == "") {
                $("#bqmc").attr("data-label", "");
            }
            $gridList.jqGrid('setGridParam', {
                postData: {
                    keyword: $("#txt_keyword").val(), zybz: $("#zybz").val(), ryrqkssj: $("#ryrqkssj").val(),
                    yrqjssj: $("#ryrqjssj").val(), ksmc: $("#ksmc").attr("data-label"), bqmc: $("#bqmc").attr("data-label")
                },
            }).trigger('reloadGrid');
        });
    }

    //sự kiện nhấn Enter
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    $('#zybz').change(function () {
        $('#btn_search').trigger('click');
    });

    function initControl() {

    }
</script>
<script type="text/javascript">
    var medicalInsurance = '@medicalInsurance';
    var zyh = '';
    var kh = "";
    var jzh = '';
    $('#btn_ybsc').click(function () {
        uploadData($('#ybscsel').val());
    });

    function uploadData(upobj) {
        var seleRow = check();
        if (!!!seleRow) {
            return;
        }
        var isBrxzOk = seleRow.brxz == '0';
        if (isBrxzOk) {
            $.modalAlert("Lỗi:Đã chọn là không phải BHYT", "warning");
            return;
        }
        var zyh = seleRow.zyh;
        var cbdbm = seleRow.cbdbm;
        var dbscobj = { mdtrt_id: seleRow.mdtrt_id, psn_no: seleRow.psn_no, hisId: zyh, operatorId: '@(opr.rygh)', operatorName: '@(opr.UserName)', orgId: '@(opr.OrganizeId)', insuplc_admdvs: cbdbm };
        var upUrl;
        switch (upobj) {
            case '4101':
                upUrl = "http://127.0.0.1:33333/api/YiBao/PostMedicalSettlement_4101_V2";
                break;
            case '4401':
                upUrl = "http://127.0.0.1:33333/api/YiBao/PostMedicalRcord_4401";
                //upUrl = "http://127.0.0.1:33333/api/YiBao/PostUploadMedicalRcord";
                break;
            case '4402':
                upUrl = "http://127.0.0.1:33333/api/YiBao/PostDoctorAdvice_4402";
                break;
            case '4501':
                upUrl = "http://127.0.0.1:33333/api/YiBao/PostClinicalExamination_4501";
                break;
            case '4502':
                upUrl = "http://127.0.0.1:33333/api/YiBao/PostClinicalExamination_4502";
                break;
            case '4503':
                upUrl = "http://127.0.0.1:33333/api/YiBao/PostPathologyCheck_4503";
                break;
            case '4504':
                upUrl = "http://127.0.0.1:33333/api/YiBao/PostPathologyCheck_4504";
                break;
            case '4505':
                upUrl = "http://127.0.0.1:33333/api/YiBao/PostPathologyCheck_4505";
                break;
            case "4506":
                upUrl = "http://127.0.0.1:33333/api/YiBao/PostPathologyCheck_4506";
                break;
            case "4601":
                upUrl = "http://127.0.0.1:33333/api/YiBao/PostPathologyCheck_4601";
                break;
            case "4602":
                upUrl = "http://127.0.0.1:33333/api/YiBao/PostPathologyCheck_4602";
                break;
            case '4701':
                upUrl = "http://127.0.0.1:33333/api/YiBao/PostMedicalRecords_4701";
                break;
        }
        $.loading("dữ liệu tải lên trong,Vui lòng chờ một chút");
        $.ajax({
            type: "POST",
            url: upUrl,
            data: dbscobj,
            dataType: "json",
            async: false,
            success: function (data) {
                var tfReturn = eval('(' + data + ')');
                if (tfReturn) {
                    if (tfReturn.infcode == "0") {
                        $.loading(false);
                        $.modalAlert("Số nhập viện là:" + zyh + ",Tải lên thành công", 'warning');
                    }
                    else {
                        $.loading(false);
                        $.modalAlert("Số nhập viện-"+zyh+"Tải lên thất bại:" + tfReturn.err_msg, 'error');
                    }
                }
            }, error: function (request, error, ex) {
                $.loading(false);
                $.modalAlert("Dịch vụ BHYT【" + upobj + "】Không thể truy cập:[" + ex + "]", 'error');
            }
        });
    }

    function check() {
        var seleRow = $("#gridList").jqGridRowValue();
        var zyh = seleRow.zyh;
        if (!!!zyh) {
            $.modalAlert("Chưa chọn bản ghi nào", "warning");
            return;
        }
        //if (seleRow.zybz == 'Đã xuất viện') {
        //    $.modalAlert("Bệnh nhân đã xuất viện", "error");
        //    return;
        //}
        else if (seleRow.zybz == '作废记录') {
            $.modalAlert("Bản ghi đã hủy", "error");
            return;
        }
        if (!medicalInsurance) {
            $.modalAlert("Thiếu cấu hình nơi khám BHYT", "error");
            return;
        }
        return seleRow;
    }

    ///Khoa
    $("#ksmc").newtouchBatchFloatingSelector({
        height: 200,
        width: 300,
        clickautotrigger: true,
        filter: function (keyword) {

            //Duyệt nguồn dữ liệu,dùngkeywordđể lọc ra kết quả
            var resultObjArr = new Array();
            $.each(top.window.clients.sysDepartList, function (idx, val) {
                if ((val.py && val.py.toLowerCase().indexOf(keyword) >= 0)
                        || (val.Name && val.Name.indexOf(keyword) >= 0)
                    || keyword.trim() == "") {
                    resultObjArr.push(val);
                }
            });
            return resultObjArr;

        },
        caption: "Khoa",
        colModel: [
            { label: 'Mã số', name: 'Code', widthratio: 30 },
            { label: 'Tên', name: 'Name', widthratio: 50 },
            { label: 'Phiên âm', name: 'py', hidden: true }
        ],
        itemdbclickhandler: function ($thistr) {
            $("#ksmc").attr("data-label", $thistr.find("td:eq(0)").html());
            $("#ksmc").val($thistr.find('td:eq(1)').html());
            return;
        },
    });
    ///Khoa bệnh
    $("#bqmc").newtouchBatchFloatingSelector({
        height: 200,
        width: 300,
        clickautotrigger: true,
        filter: function (keyword) {
            //Duyệt nguồn dữ liệu,dùngkeywordđể lọc ra kết quả
            var resultObjArr = new Array();
            var ks = $("#ksmc").attr("data-label");
            var bqlist = top.window.clients.sysWardDeptRelation.filter((item) => item.ks == ks);
            $.each(bqlist, function (idx, val) {
                if ((val.bqpy && val.bqpy.toLowerCase().indexOf(keyword.toLowerCase()) >= 0)
                    || (val.bqmc && val.bqmc.indexOf(keyword) >= 0)
                    || keyword.trim() == "") {
                    resultObjArr.push(val);
                }
            });
            return resultObjArr;

        },
        caption: "Khoa bệnh",
        colModel: [
            {
                label: 'Mã số', name: 'bq', widthratio: 25
            },
            {
                label: 'Tên', name: 'bqmc', widthratio: 50
            }
        ],
        itemdbclickhandler: function ($thistr) {
            $("#bqmc").attr("data-label", $thistr.find("td:eq(0)").html());
            $("#bqmc").val($thistr.find('td:eq(1)').html());
            return;
        },
    });

    /*Logic tải lên bệnh nhân tự phí*/

    // ngoại trúkhámvànhập việnviệnđốiphảicủachọnhạng
    var mzOptions = [
        { value: '4205', text: '【4205】Tải lên thông tin y tế ngoại trú của bệnh nhân tự phí' },
        { value: '4206', text: '【4206】Xóa thông tin y tế ngoại trú của bệnh nhân tự phí' },
        { value: '4203', text: '【4203】Hoàn thành tải lên thông tin khám và chi tiết phí của bệnh nhân tự trả' },
        { value: '4201', text: '【4201】Tải lên thông tin chi tiết phí bệnh nhân tự trả (đã bỏ)' }
    ];

    var zyOptions = [
        //{ value: '4201A', text: '【4201A】tựphíbệnhngườinhập việnviệnphídùngrõchi tiếtthông tintintrênchuyển' },
        { value: '4202', text: '【4202】Bệnh nhân tự phí Nhập viện khám và Thông tin chẩn đoán tải lên' },
        { value: '4204', text: '【4204】Bệnh nhân tự phí Chi tiết phí nhập viện Xóa' },
        { value: '4203', text: '【4203】Hoàn thành tải lên thông tin khám và chi tiết phí của bệnh nhân tự trả' },
        { value: '4201', text: '【4201】Tải lên thông tin chi tiết phí bệnh nhân tự trả (đã bỏ)' }
    ];
    // căndữ liệuchọntrongcủagiá trịđộngtrạng tháihơnmớichọnhạng
    function updateZfscselOptions(options) {
        var zfscsel = document.getElementById('zfscsel');
        zfscsel.innerHTML = ''; // xóarỗnghiệncóchọnhạng

        options.forEach(function (option) {
            var opt = document.createElement('option');
            opt.value = option.value;
            opt.text = option.text;
            zfscsel.appendChild(opt);
        });
    }

    // giám sátnghengoại trúkhám/nhập việnviệnchọnchọnkhungcủađổihóa
    document.getElementById('zflxscsel').addEventListener('change', function () {
        var selectedValue = this.value;
        if (selectedValue === 'mz') {
            updateZfscselOptions(mzOptions);
        } else if (selectedValue === 'zy') {
            updateZfscselOptions(zyOptions);
        }
        gridJSListData()
    });

    $(function () {
        // đầubắt đầumặc địnhnhậnchọnchọnngoại trúkhám
        updateZfscselOptions(mzOptions);
        gridJSListData()
    })


    //đượclấycộtbảngcủatratra cứudònghạng
    function getSearchPostData() {
        var zflx = $("#zflxscsel").val();
        var xm = $("#txtxm").val();
        var createTimestart = $("#zfjskssj").val() + ' 00:00:00';
        var createTimeEnd = $("#zfjsjssj").val() + ' 23:59:59';
        if (zflx === 'mz') {
            return { xm: xm, CreateTimestart: createTimestart, CreateTimeEnd: createTimeEnd };
        } else if (zflx === 'zy') {
            return { keyword: xm, jsksrq: createTimestart, jsjsrq: createTimeEnd };
        }

    };

    //tratra cứukếttínhthông tintincộtbảng
    function gridJSListData() {
        var zflx = $("#zflxscsel").val();
        var gridSort = 'CreateTime asc';
        if (zflx === 'mz') {
            $('.zyzfgridPanel').hide();  // ẩn zyzfgridPanel
            $('.mzzfgridPanel').show();
            var $gridJsList = $("#mzzfgridList");
            $gridJsList.dataGrid({
                postData: getSearchPostData(),
                height: $(window).height() - 188,
                url: "/OutpatientManage/OutpatientChargeQuery/SelectZFRegChargeQuery",
                colModel: [
                    { label: 'jsnm', name: 'jsnm', hidden: true, align: 'left' },
                    {
                        label: 'Loại quyết toán', name: 'jslx', width: 120, align: "left",
                        formatter: function (val) {
                            return $.enum.getDescByValue("EnumJslx", val);
                        }
                    },

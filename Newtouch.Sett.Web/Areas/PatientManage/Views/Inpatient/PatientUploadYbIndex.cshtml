    function sxGridJSListData() {
        var zflx = $("#zflxscsel").val();;
        if (zflx === 'mz') {
            var $gridJsList = $("#mzzfgridList");
            $gridJsList.jqGrid('setGridParam', {
                postData: getSearchPostData(),
                page: 1,
            }).trigger('reloadGrid');
        } else if (zflx === 'zy') {
            var $gridJsList = $("#zyzfgridList");
            $gridJsList.jqGrid('setGridParam', {
                postData: getSearchPostData(),
                page: 1,
            }).trigger('reloadGrid');
        }
    }

    //Tra cứu

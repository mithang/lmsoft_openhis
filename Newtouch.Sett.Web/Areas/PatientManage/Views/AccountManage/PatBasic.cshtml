                        <input type="text" class="form-control newtouch_Readonly"  disabled id="bq" name="bq" value="">
                    </td>
                    <th class="formTitle">Ngày nhập viện</th>
                    <td class="formValue">
                        <input type="text" class="form-control newtouch_Readonly"  id="ryrq" name="ryrq" value="">

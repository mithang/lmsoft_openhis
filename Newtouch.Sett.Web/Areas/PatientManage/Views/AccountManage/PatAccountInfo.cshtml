@{
    ViewBag.Title = "PatAccountInfo";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<div class="topPanel" style="margin-bottom: 1%;">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control form-control-focus" placeholder="Vui lòng nhập số thẻ, Số nhập viện, Họ tên" style="width: 200px;">
                    </div>
                </td>
                <td style="padding-left:12px;">
                    <div class="btn-group" id="btnKeywordTypeGourp" style="margin-top:0;">
                        <button type="button" data-keywordtype="kh" class="btn active btn-default">&nbsp;thẻ&nbsp;số&nbsp;</button>
                        <button type="button" data-keywordtype="zyh" class="btn btn-default">Số nhập viện</button>
                        <button type="button" data-keywordtype="xm" class="btn btn-default">&nbsp;Họ&nbsp;Tên&nbsp;</button>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>

<!--Thông tin cơ bản-->
@Html.Partial("PatBasic")  
<!--Danh sách thu chi-->
<form id="formPat2"> 
        <div class="gridPanel" style="margin-top:10px;border-radius:5px;">
            <table id="gridList" rel="formPat2"></table>
        </div> 
</form>
<!--Nạp/hoàn tiền tạm ứng-->
@Html.Partial("AccAddPay")
<!--Thanh công cụ nút-->
<div class="toolbar toolbarfloat">
    <a id="acc_addMoney" class="btn btn-primary" onclick="PayDeposit()"><i class="fa fa-plus"></i> nạp tiền</a>
    <a id="acc_reMoney" class="btn btn-primary" onclick="Refund()"><i class="fa fa-minus"></i> Hoàn tiền</a>
    <a class="btn btn-primary" onclick="newtouch_globalevent_f5()"><span class="glyphicon glyphicon-refresh"> Chọn Tài khoản</span></a>
</div>
<style>
    #yeCon{
        padding-left:25px;
        color:red; 
    }
</style>

<script>
    $(function () {
        $('#btnKeywordTypeGourp').on('click', '.btn', function () {
            if (!$(this).hasClass('active')) {
                $(this).siblings('.btn').removeClass('btn-restore').removeClass('active').addClass('btn-default');
                $(this).removeClass('btn-default').addClass('btn-restore active');
            }
        });
        //tìmtìmkhung
        var txt_keyword = document.getElementById('txt_keyword');
        txt_keyword.addEventListener('keydown', function (event) {
            event = event || window.event;
            if (event.keyCode == 13) {
                searchPatInfo();
            }
        });

        gridListData([]);
        $(window).resize(function () {
            initLayout("formPat2");
        });
    });
     

    //nhấn Enter\Sự kiện tra cứu
    function searchPatInfo() {
        $.loading(true, "Đang yêu cầu dữ liệu..."); 
        var keyword = $.trim($("#txt_keyword").val());
        if (keyword == "") {
            $.modalAlert("Vui lòng nhập Hiệu lực Số nhập viện, Số thẻ, hoặc Họ tên", 'warning');
            return false;
        }
        var zyh = null;
        var kh = null;
        var xm = null;
        if ($('#btnKeywordTypeGourp .btn.active').attr('data-keywordtype') == 'kh') {
            kh = keyword;
        }
        else if ($('#btnKeywordTypeGourp .btn.active').attr('data-keywordtype') == 'zyh') {
            zyh = keyword;
        }
        else {
            xm = keyword;
        }
       
        var patobj = new Object();
        patobj.kh = kh;
        patobj.zyh = zyh;
        patobj.xm = xm;
        getPatInfoAjax(patobj);
    }

    //sauđàiajaxtratra cứungườiviênsốdữ liệu
    function getPatInfoAjax(patobj) { 
        $.najax({
            type: "POST",
            url: "/PatientManage/AccountManage/PatAccountInfo",
            data: { zyh: patobj.zyh, kh: patobj.kh, xm: patobj.xm },
            dataType: "json",
            cache: false,
            success: function (ajaxresp) {
                $.loading(false);
                var patInfoList = ajaxresp.data.patInfoList;
                if (patInfoList && patInfoList.length > 0) {
                    if (patInfoList.length == 1) {
                        setPatInfoModel(ajaxresp.data.patInfo);
                        gridListData(ajaxresp.data.accPayInfoList);
                    } else {
                        //bậtrathêmtảichọnchọnngườiviêncủagiớimặtcửa sổmiệng
                        GetPatSerarchView(patobj.zyh, patobj.xm, patInfoList);
                    }
                }
            },
            error: function (err) {
                $.loading(false);
            },
            complete: function () {
                $.loading(false);
            }
        });
    }


    //Lấy hiển thị giao diện thông tin cơ bản bệnh nhân
    function setPatInfoModel(patModel) { 
        $('#formPat1').formSerialize(patModel);
        //đượclấymạngtrangtrongcủaphiếuchọntheonút,chọnchọncủa nótrongname=angel,value=0của,đểcủa nóchọntrong
        //$("input[type=radio][name=xb][value=" + patmodel[idname] + "]").attr("checked", 'checked');
        $("#xb").val($.getGender(patModel.xb));
        $("#zhsyr").val(patModel.xm);//nơicóngười
        $("#ryrq").val((patModel.ryrq && patModel.ryrq.length >= 10 ? patModel.ryrq.substring(0, 10) : ""));
        var nl = !(patModel.csny == null || undefined) ? GetAgeByCsny(patModel.csny) : "";
        $("#nl").val(nl);
        $("#txt_keyword").val("");
    }

    //Danh sách thu chi tài khoản
    function gridListData(mydata) { 
        $('#gridList').jqGrid("clearGridData");
        var $gridList = $("#gridList");
        var zhye = 0;
        if (mydata != [] && mydata.length > 0) {
            zhye = mydata[0].zhye;
            //zhye = zhye.toFixed(2);
        } 
        $("#zhye").val(zhye); //valuegán giá trị
        var captionCon = "Bảng thu chi tài khoản";
        captionCon += "<span id='ye Con'>Số dư tài khoản:" + zhye + "đồng</span>"; 
        $gridList.dataNewGrid({
            height: 150, 
            autowidth: false,
            width: $("#formPat2").width() - 10,
            caption: captionCon,
            colModel: [
                { label: 'Khóa chính', name: 'patid', hidden: true, key: true },
                { label: 'Số tiền thu chi', name: 'szje', width: 105, align: 'left'},
                //{
                //    label: 'Số tiền thu chi', name: 'szje', width: 105, align: 'left', formatter: function (cellvalue) {
                //        return cellvalue ? cellvalue.toFixed(2) : "0.00";
                //      }
                //},
                {   label: 'Số tiền tài khoản', name: 'zhye', width: 105, align: 'left'},
                //{
                //    label: 'Số tiền tài khoản', name: 'zhye', width: 105, align: 'left', formatter: function (cellvalue) {
                //        return cellvalue ? cellvalue.toFixed(2) : "0.00";
                //    }
                //},
                { label: 'Số chứng từ', name: 'pzh', width: 105, align: 'left' },
                { label: 'Nhân viên thu chi', name: 'CreatorUserName', width: 105, align: 'left' },
                { label: 'Phương thức thanh toán', name: 'xjzffsmc', width: 105, align: 'left' },
                { label: 'Ngày thu chi', name: 'CreateTime', width: 200, align: 'left' },
                { label: 'Tính chất thu chi', name: 'szxz', width: 105, align: 'left' }
            ]
        }, mydata);
        
        if (mydata.length>0) {
            $('.ui-jqgrid-bdiv').find(".unwritten").remove();
        }
        $("#yeCon").text("Số dư tài khoản:" + zhye + "đồng");
    }

    var patid,
        zyh,
        zh,
        zhxz,
        zhbh,
        zffsbh,
        zffsmc,
        zfmoney,
        pzh;
    //Xét nạp tiền và hoàn tiền
    function CheckDeposit() { 
        patid = $("#patid").val();
        zyh = $("#zyh").val();
        zh = $("#zh").val();
        zhxz = $("#zhxz").val();
        zhbh = $("#zhbh").val();
        if (zyh == "" || patid == "" || zh == "" || zhbh == "" || zhxz == "") {
            $.modalAlert("Thông tin cơ bản bệnh nhân không được là trống", 'warning');
            return false;
        }
        //var reg = /(^[1-9]([0-9]+)?(\.[0-9]{1,2})?$)|(^(0){1}$)|(^[0-9]\.[0-9]([0-9])?$)/;
        var reg = /^(-?\d+)(\.\d+)?$/;
        zfmoney = $("#txtmoney").val();
        var ddlzffs = $("#ddlzffs option:selected");//lấy khoản đã chọn
        zffsbh = ddlzffs.val();//lấy giá trị của khoản đã chọn
        zffsmc = ddlzffs.text();//lấy văn bản của khoản đã chọn
        //pzh = $("#lblpzh").text();
        pzh = $("#txtlpzh").val();
        if (zffsbh == -1 || zffsmc == "") { 
            $.modalAlert("Phương thức thanh toán bắt buộc chọn", 'warning');
            return false;
        }
        if (zfmoney == "" || zfmoney == undefined) {
            $.modalAlert("Số tiền thanh toán bắt buộc nhập", 'warning');
            return false;
        } else {
            if (!reg.test(zfmoney)) {  
                $.modalAlert("Vui lòng nhập đúng định dạng số tiền", 'warning');
                return false;
            }
        }
        if (pzh == "" || pzh == undefined) { 
            $.modalAlert("Số chứng từ bắt buộc chọn", 'warning');
            return false;
        }
        return true;
    }

    //Nạp tiền kiểm tra ở giao diện số tiền và đã chọn loại thanh toán chưa
    function PayDeposit() { 
        zfmoney = $("#txtmoney").val();
        if(parseFloat(zfmoney)<0)
        {
            $.modalAlert("Số tiền thanh toán bắt buộc nhập", 'warning'); 
            return false;
        }
        if (CheckDeposit())
        {
            PayDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid, zyh, zh, zhxz, zhbh); 
        }
    }

    //Nạp tiền tạm ứng
    function PayDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid, zyh, zh, zhxz, zhbh)
    {
        $.loading(true, "Đang yêu cầu dữ liệu...");
        $.najax({
            type: "POST",
            url: "/PatientManage/AccountManage/PayDepositPost",
            data: { zffsbh: zffsbh, zffsmc: zffsmc, zfje: zfmoney, pzh: pzh, zhbh: zhbh, zh: zh,zhxz:zhxz, patid: patid, zyh: zyh },
            dataType: "json",
            cache: false,
            success: function (resdata) {
                if (resdata!=null && resdata.data)
                {
                    $.loading(false);
                    $.modalAlert("Nạp tiền thành công", 'success'); 
                    ClearMoney(); //Xóa trống
                    getZhInfo(zh); //Bản ghi thu chi tài khoản
                }
            },
            errorCallback: function (err) { 
                //$.modalAlert("Nạp tiền thất bại", 'error');
                $.loading(false);
            },
            complete: function () {
                $.loading(false);
            }
        }); 
    }
 

    //Xóa trống
    function ClearMoney() {
        $('#gridList').jqGrid("clearGridData");
        //Xóa ô nhập số tiền
        $("#txtmoney").val("");
        //Ngày chứng từ
        var d = new Date();
        var date = d.getFullYear() + "-" + (d.getMonth() + 1) + "-" + d.getDate();
        $("#txtpzrq").val(date);
        //Lấy số chứng từ
        GetSJPZH();
    }

    //Lấy số chứng từ
    function GetSJPZH() {
        $.ajax({
            type: "POST",
            url: "/PatientManage/AccountManage/GetReceipt",
            data: { },
            dataType: "json",
            cache: false,
            success: function (resdata) {
                if (resdata != null && resdata.data != "") {
                    $("#txtlpzh").val(resdata.data);
                    return resdata.data;
                } else {
                    $("#txtlpzh").val("");
                    return "";
                }
            }
        });
    }

    //tra cứu nhân viên
    function GetPatSerarchView(zyh, xm, infoList) {
        var encodexm = encodeURI(encodeURI(xm));
        if (infoList) {
            $.modalOpen({
                id: "patSearch",
                title: "Tra cứu bệnh nhân",
                url: "/PatientManage/AccountManage/PatSearchView?t=" + Math.random() + "&zyh=" + zyh + "&xm=" + encodexm,
                width: "700px",
                height: "600px",
                callBack: function (iframeId) { 
                    top.frames[iframeId].PatDbGrid(); //trong sự kiện cửa sổ bật lên
                }//hàm gọi lại khi nhấn xác nhận trên cửa sổ
            });
        } else {
            $.modalAlert("Vui lòng nhập số nhập viện hoặc Họ tên", 'warning');
            $("#txt_keyword").focus();
        }
    }

    var gridIMoney = "";//Số tiền thu chi đang chọn
    var gridIpzh = ""; //Số chứng từ đang chọn
    //điểmnhấnđôinhấnviệchạng
    function btn_edit() {
        var szje = $("#gridList").jqGridRowValue().szje;
        var pzh = $("#gridList").jqGridRowValue().pzh;
        gridIMoney = szje;
        gridIpzh = pzh;
        if (parseFloat(gridIMoney)>0)
        {
            $("#txtmoney").val(-szje);
        } else
        {
            gridIMoney = -szje;
            $("#txtmoney").val(szje);
        }
        //$("#lblpzh").text(pzh);
        $("#txtlpzh").val(pzh);
    }

    //Hoàn tiền
    function Refund()
    { 
        var money = $("#txtmoney").val();
        //var pzh = $("#lblpzh").text();
        var pzh = $("#txtlpzh").val();
        var zhye = $("#zhye").val();
        if(parseFloat(money)+parseFloat(gridIMoney)<0){ 
            $.modalAlert("Hoàn tiền Số tiền Không thể lớn hơn hiện tại nạp tiền Số tiền", 'warning');
            return false;
        }
        if (parseFloat(money) + parseFloat(zhye) < 0) {
            $.modalAlert("Số dư tài khoản hiện tại không đủ", 'warning'); 
            return false;
        }
        if (parseFloat(money) > 0)
        {
            $.modalAlert("Nếu hoàn tiền, vui lòng chọn một chi tiết thu chi", 'warning'); 
            return false;
        } 
        if (gridIpzh == "" || pzh != gridIpzh)
        {
            $.modalAlert("Nếu hoàn tiền, vui lòng chọn một chi tiết thu chi", 'warning'); 
            return false; 
        }
        if (CheckDeposit())
        { 
            ExitDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid, zyh, zh, zhxz, zhbh);
        }
    }


    //Hoàn tiền
    function ExitDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid, zyh, zh, zhxz, zhbh) {
        $.loading(true, "Đang yêu cầu dữ liệu...");
        $.najax({
            type: "POST",
            url: "/PatientManage/AccountManage/ExitDepositPost",
            data: { zffsbh: zffsbh, zffsmc: zffsmc, zfje: zfmoney, pzh: pzh, zhbh: zhbh, zh: zh, zhxz: zhxz, patid: patid, zyh: zyh },
            dataType: "json",
            cache: false,
            success: function (resdata) {
                if (resdata != null && resdata.data) {
                    $.loading(false); 
                    $.modalAlert("Hoàn tiền Thành công", 'success');
                    ClearMoney();
                    //Gọi danh sách thu chi tài khoản
                    getZhInfo(zh);
                    
                }
            },
            errorCallback: function (err) { 
                $.loading(false);
            },
            complete: function () {
                $.loading(false);
            }
        });
    }

    //Tra cứu tài khoản
    function getZhInfo() {
        //GetBasicZhInfoJson
        $.loading(true, "Đang yêu cầu dữ liệu...");
        $.najax({
            type: "POST",
            url: "/PatientManage/AccountManage/GetBasicZhInfoJson",
            data: {zh: zh},
            dataType: "json",
            cache: false,
            success: function (resdata) { 
                if (resdata != null && resdata.data) {
                    $.loading(false);
                    gridListData(resdata.data);
                }
            },
            errorCallback: function (err) {
                $.loading(false);
            },
            complete: function () {
                $.loading(false);
            }
        });
    }



    //nặngmớitratra cứu
    function searchPatInfoAgin() {
        //Gọi danh sách thu chi tài khoản
        var obj = new Object();
        obj.zyh = $("#zyh").val();
        obj.kh = $("#kh").val();
        obj.xm = $("#xm").val();
        getPatInfoAjax(obj); //nặngmớiđiềudùngtratra cứu
    }
</script>

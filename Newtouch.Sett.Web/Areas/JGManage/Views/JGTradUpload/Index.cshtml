@using NewtouchHIS.Lib.Framework.Operator;

@{
    Layout = "~/Views/Shared/_Index.cshtml";
    var opr = OperatorProvider.GetCurrent();
    
}


<style>
    @@media screen and (min-width:600px) {
        #btn_ {
            width: 160px;
        }

        .form .formTitle {
            width: 55px;
        }

        .form .formValue {
            width: 100px;
        }
    }

    @@media screen and (min-width:1000px) {
        .form .formTitle {
            width: 25px;
        }

        .form .formValue {
            width: 60px;
        }
    }
</style>
<form>
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form">
            <tr>
                <th class="formTitle">Giờ bắt đầu：</th>
                <td class="formValue" style="width:150px;">
                    <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; float:left;" value="@DateTime.Now.AddMonths(-1).ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    <span style="margin-left:1%;float:left">—</span>
                    <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:43%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                </td>
                <th class="formTitle" style="width:70px;padding-right:12px;">tải lên trường hợp：</th>
                <td class="formValue">
                    <select id="scqk" name="scqk" class="form-control">
                        <option value="">==Vui lòng chọn==</option>
                        <option value="0" selected="selected">Đã tải lên</option>
                        <option value="1">Tải lên thất bại</option>
                        <option value="2">Chưa tải lên</option>
                    </select>
                </td>
                <th class="formTitle" style="width:70px;padding-right:12px;">giao dịch Loại：</th>
                <td class="formValue" style="width:140px">
                    <select id="trad" name="trad" class="form-control">
                        <option value="">==Vui lòng chọn==</option>
                        <option value="JG10001">【JG10001】Thêm thông tin hàng hóa</option>
                        <option value="JG10004">【JG10004】Tải lên dữ liệu chi tiết nhập/xuất kho</option>
                        <option value="JG10010">【JG10010】Tải lên dữ liệu tồn kho hàng hóa ban đầu</option>
                        <option value="JG10012">【JG10012】Tải lên dữ liệu đăng ký khám và quyết toán phòng khám</option>
                        <option value="JG10013">【JG10013】khám nơi hoàn quyết toán</option>
                        <option value="JG40001">【JG40001】Tải lên dữ liệu phiếu treo</option>
                        <option value="JG40003">【JG40003】Quyết toán dữ liệu phiếu treo</option>
                    </select>
                </td>
                @*<th class="formTitle">Số nhập viện：</th>
                <td class="formValue">
                    <input id="zyh" name="zyh" type="text" autocomplete="off" class="form-control" />
                </td>*@
                <td class="formValue">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary form-an" style="width: 50px; margin-left: 40px;" value="Tra cứu" />

                </td>
                <th class="formTitle" colspan="2">
                        <input type="button" id="btn_upload" class="btn btn-md btn-primary form-an" style="width: 50px; margin-left: 40px;" value="tải lên" />
                    </th>*

                <th class="formTitle"></th>
                <td class="formValue"></td>
            </tr>
        </table>
    </div>
    <div id="gridqt" class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
    <div id="gridyp" class="gridPanel">
        <table id="gridListYp"></table>
        <div id="gridPagerYp"></div>
    </div>
    <div id="gridsqsz" class="gridPanel">
        <table id="gridListsqsz"></table>
        <div id="gridPagersqsz"></div>
    </div>
</form>
<script>
    $(function () {
       // gridList();
        gridListYp();
        //gridListsqsz();
        var $gridList = $("#gridList");
        var $gridListYp = $("#gridListYp");
        var $gridListsqsz = $("#gridListsqsz");
        $("#gridyp").css('display', 'none');
        $("#gridsqsz").css('display', 'none');
        $("#btn_search").click(function () {
            if ($('#trad').val() == "JG10001" || $('#trad').val() == "JG10004" || $('#trad').val() == "JG10010" || $('#trad').val() == "JG10012" || $('#trad').val() == "JG10001" || $('#trad').val() == "JG10001") {
                $("#gridqt").css("display", "none");
                $("#gridsqsz").css("display", "none");
                $("#gridyp").css("display", "block");
                $gridListYp.jqGrid('setGridParam', {
                    postData: getSearchPostDataYp(),
                    page: 1,
                }).trigger('reloadGrid');
            }
            else if ($('#trad').val() == "3101" || $('#trad').val() == "3102") {
                $("#gridyp").css("display", "none");
                $("#gridsqsz").css("display", "block");
                $("#gridqt").css("display", "none");
                $gridListsqsz.jqGrid('setGridParam', {
                    postData: getSearchPostDatasqsz(),
                    page: 1,
                }).trigger('reloadGrid');
            }
            else {
                $("#gridyp").css("display", "none");
                $("#gridsqsz").css("display", "none");
                $("#gridqt").css("display", "block");
                $gridList.jqGrid('setGridParam', {
                    postData: getSearchPostData(),
                    page: 1,
                }).trigger('reloadGrid');
            }

        });
        //$("#zyh").keyupEnterEvent(function () {
        //    $("#btn_search").trigger("click");
        //});
    });

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/JGManage/JGTradUpload/GetGridJson",
            postData: getSearchPostData(),
            height: $(window).height() - 128,
            colModel: [
                { label: 'patId', name: 'patId', width: 100, align: 'left', hidden: true },
                //{ label: 'Chọn', name: 'patId', width: 160, align: 'left' },
                { label: 'tải lên trường hợp', name: 'scqk', width: 160, align: 'left' },
                { label: 'tải lên Ngày', name: 'scrq', width: 160, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }},
                { label: 'Lỗi thông tin', name: 'errorMsg', width: 160, align: 'left' },
                { label: 'Số nhập viện', name: 'zyh', width: 160, align: 'left' },
                { label: 'Họ tên', name: 'xm', width: 160, align: 'left' },
                { label: 'Số CMND/CCCD', name: 'sfzh', width: 160, align: 'left' },
                { label: 'BHYT khám ID', name: 'mdtrt_id', width: 160, align: 'left' },
                { label: 'BHYT quyết toán ID', name: 'setl_id', width: 160, align: 'left' },
                { label: 'Ngày nhập viện', name: 'ryrq', width: 160, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }},
                { label: 'Ngày xuất viện', name: 'cyrq', width: 160, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }},
                { label: 'Trang đầu hồ sơ bệnh án Ngày', name: 'basyrq', width: 160, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }},
                { label: 'Ngày quyết toán', name: 'jsrq', width: 160, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Khoa', name: 'ksmc', width: 160, align: 'left' },
                { label: 'Tên bác sĩ', name: 'ysmc', width: 160, align: 'left' },

            ],
            viewrecords: true,
            multiselect: true,
			ondblClickRow: function (rowid) {
				//$.modalAlert(rowid, 'warning');
				SelGetrow(rowid);
            },
        });
    }
    function gridListYp() {
        var $gridListYp = $("#gridListYp");
        $gridListYp.dataGrid({
            url: "/JGManage/JGTradUpload/GetGridJsonYp",
            postData: getSearchPostData(),
            height: $(window).height() - 128,
            colModel: [
                { label: 'Giao dịch BHYT', name: 'mlbm_id', hidden:true},
                { label: 'Tên thuốc', name: 'ypmc', width: 160, align: 'left' },
                { label: 'Số lô', name: 'pch', width: 160, align: 'left' },
                { label: 'tải lên trường hợp', name: 'scqk', width: 60, align: 'left' },
                { label: 'tải lên Ngày', name: 'scrq', width: 160, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Lỗi thông tin', name: 'errorMsg', width: 160, align: 'left' },
            ],
            viewrecords: true,
            multiselect: true,
            //onSelectRow: function (rowid) {
            //    $("#" + $.jgrid.jqID(rowid) + "_mdtrt_id").focus();
            //},
        });
    }
    function gridListsqsz() {
        var $gridListsqsz = $("#gridListsqsz");
        $gridListsqsz.dataGrid({
            url: "/DRGManage/DRGTradUpload/GetGridJsonsqsz",
            postData: getSearchPostData(),
            height: $(window).height() - 128,
            colModel: [
                { label: 'Số nhập viện', name: 'zyh', width: 50, align: 'left' },
                { label: 'Tên bệnh nhân', name: 'xm', width: 50, align: 'left' },
                { label: 'Loại y lệnh', name: 'yzlx', width: 50, align: 'left' },
                { label: 'y lệnh số', name: 'yzh', width: 160, align: 'left' },
                { label: 'Tên khoản mục', name: 'xmmc', width: 200, align: 'left' },
                { label: 'Số lượng', name: 'sl', width: 60, align: 'left' },
                { label: 'Chẩn đoán thông tin', name: 'zdmc', width: 100, align: 'left' },
                { label: 'Khoa', name: 'ks', width: 60, align: 'left' },
                { label: 'tải lên Ngày', name: 'scrq', width: 160, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Lỗi thông tin', name: 'errorMsg', width: 160, align: 'left' },
            ],
            viewrecords: true,
            multiselect: true,
            //onSelectRow: function (rowid) {
            //    $("#" + $.jgrid.jqID(rowid) + "_mdtrt_id").focus();
            //},
        });
    }
    //Điều kiện tra cứu
    function getSearchPostData() {
        var kssj = $("#kssj").val();
        var jssj = $("#jssj").val()+" 23:59:59";
        var scqk = $("#scqk option:selected").text();
        var zyh = $("#zyh").val();
        var tradiNumber = $("#trad").val();
        return { kssj: kssj, jssj: jssj, scqk: scqk, zyh: zyh, tradiNumber: tradiNumber };

    }
    //Điều kiện tra cứu 3501-3506
    function getSearchPostDataYp() {
        var kssj = $("#kssj").val();
        var jssj = $("#jssj").val() + " 23:59:59";
        var scqk = $("#scqk option:selected").text();
        var tradiNumber = $("#trad").val();
        return { kssj: kssj, jssj: jssj, scqk: scqk, tradiNumber: tradiNumber };

    }
    //Điều kiện tra cứu 3101 3102
    function getSearchPostDatasqsz() {
        var kssj = $("#kssj").val();
        var jssj = $("#jssj").val() + " 23:59:59";
        var zyh = $("#zyh").val();
        var scqk = $("#scqk option:selected").text();
        var tradiNumber = $("#trad").val();
        return { kssj: kssj, jssj: jssj, scqk: scqk, zyh: zyh, tradiNumber: tradiNumber };

    }
    //tải lên
    $('#btn_upload').click(function () {
        var seleRow = check();
        // Lấy dữ liệu cần tải lên
        var orgId = '@(opr.OrganizeId)';
        var operatorId = '@(opr.rygh)';
        var operatorName = '@(opr.UserName)';
        var crkId = seleRow.length > 1 ? "" : seleRow[0].mlbm_id;
        if ($("#scqk").val() === '0') {
            $.modalAlert("Vui lòng không chọn dữ liệu đã tải lên", 'warn');
            return;
        }
        if (!!!seleRow) {
            return;
        }
        if (seleRow.length > 1) {
            // Bật hộp xác nhận，Xác nhận tải lên
            $.modalConfirm("Chọn nhiều dòng dữ liệu sẽ tải lên toàn bộ!!", function(f) {
                if (f){
                    uploadData(orgId, operatorId, operatorName, crkId);
                }
            });
        } else {
            // Chọn một dòng dữ liệu，Tải lên trực tiếp
            uploadData(orgId, operatorId, operatorName, crkId);
        }
        function uploadData(orgId, operatorId, operatorName, crkId) {
            var tradiNumber = $("#trad").val();
            var data;
            var upUrl;
            // theotradiNumberđể chọn giao diện khác nhau
            switch (tradiNumber) {
                case 'JG10001':
                    upUrl = "http://127.0.0.1:33333/api/YiBao/RegulatoryDataUpload_JG10001";
                    data = {
                        "orgId": orgId,
                        "operatorId": operatorId,
                        "operatorName": operatorName,
                        "crkId": crkId
                    };
                    break;
                case 'JG10004':
                    upUrl = "http://127.0.0.1:33333/api/YiBao/RegulatoryDataUpload_JG10004";
                    data = {
                        "orgId": orgId,
                        "operatorId": operatorId,
                        "operatorName": operatorName,
                        "crkId": crkId
                    };
                    break;
                case 'JG10010':
                    upUrl = "http://127.0.0.1:33333/api/YiBao/RegulatoryDataUpload_JG10010";
                    data = {
                        "orgId": orgId,
                        "operatorId": operatorId,
                        "operatorName": operatorName,
                        "crkId": crkId
                    };
                    break;
                case 'JG10012':
                    upUrl = "http://127.0.0.1:33333/api/YiBao/RegulatoryDataUpload_JG10012";
                    data = {
                        "orgId": orgId,
                        "operatorId": operatorId,
                        "operatorName": operatorName,
                        "crkId": crkId
                    };
                    break;
                case 'JG10013':
                    upUrl = "http://127.0.0.1:33333/api/YiBao/RegulatoryDataUpload_JG10013";
                    data = {
                        "orgId": orgId,
                        "operatorId": operatorId,
                        "operatorName": operatorName,
                        "medins_setl_id": crkId
                    };
                    break;
                case 'JG40001':
                    upUrl = "http://127.0.0.1:33333/api/YiBao/RegulatoryDataUpload_JG40001";
                    data = {
                        "orgId": orgId,
                        "operatorId": operatorId,
                        "operatorName": operatorName,
                    };
                    break;
                case 'JG40003':
                    upUrl = "http://127.0.0.1:33333/api/YiBao/RegulatoryDataUpload_JG40003";
                    data = {
                        "orgId": orgId,
                        "operatorId": operatorId,
                        "operatorName": operatorName
                    };
                    break;
                default:
                    $.modalAlert("không hợp lệ của tải lên Loại", 'error');
                    return;
            }

            // Gửi yêu cầu tải lên
            $.najax({
                url: upUrl,
                dataType: "json",
                data: data,
                type: "POST",
                success: function(response) {
                    $.modalAlert("Tải lên thành công", 'success');
                    $.modalClose();
                },
                error: function(error) {
                    $.modalAlert("Tải lên thất bại，Vui lòng thử lại", 'error');
                }
            });
        }

    });

    function check() {
        //Lấy dòng đã chọn
        var seleRow = $("#gridListYp").jqGridRowValue();
        var setl_id = seleRow.setl_id;
        if (seleRow.length==0) {
            $.modalAlert("Chưa chọn bản ghi nào", "error");
            return;
        }
        return seleRow;

        //var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        //if (selRowIds.length == 0) {
        //    $.modalAlert("Vui lòng chọn trước thông tin cần tải lên", 'warning');
        //    return;
        //}

        ////Lấy tất cả các dòngId，Duyệt để hộp chỉnh sửa ở trạng thái lưu
        //var rowIds = $("#gridList").jqGrid('getDataIDs');
        //return selRowIds;
    }

	function SelGetrow(rowid) {
		//Lấy dòng đã chọn
		var rowData = $("#gridList").jqGrid('getRowData', rowid);
		console.log("dòng đã chọn", rowData)
		//var setl_id = rowData.setl_id;
		if (rowData.patId == null) {
			$.modalAlert("Chưa chọn bản ghi nào", "error");
			return;
		}
		if ($('#trad').val() == "4402" || $('#trad').val() == "4501" || $('#trad').val() == "4502") {
			$.modalOpen({
				id: "Deliitem",
				async: false,
				title: "chi tiết trang",
				url: "/DRGManage/DRGTradUpload/From?zyh=" + rowData.zyh + "&types=" + $('#trad').val(),
				width: "1000px",
				height: "550px",
				callBack: function (iframeId) {
					$.modalClose("From");
				}
			});
		}

	}

    //Liên kết lớp nổi chọn số nhập viện
    $('#zyh').newtouchBatchFloatingSelector({
        width: 500,
        height: 200,
        caption: "Chọn bệnh nhân",
        clickautotrigger: true,
        url: "/ReportManage/Report/GetInpatientcryrq",
        ajaxparameters: function ($thisinput) {
            var keyword = $thisinput.val().trim();
            var zyh = $("#zyh").val();
            return "zyh=" + zyh;
        },
        itemdbclickhandler: function ($thistr, $thisinput) {
            if (!!$thistr.attr('data-zyh')) {
                //if ($thistr.attr('data-ryrq') !== "" && $thistr.attr('data-ryrq') !== undefined && $thistr.attr('data-ryrq') !== null) {
                //    $('#ksrq').val($.getDate({ date: $thistr.attr('data-ryrq') }));
                //}
                //if ($thistr.attr('data-cyrq') !== "" && $thistr.attr('data-cyrq') !== undefined && $thistr.attr('data-cyrq') !== null) {
                //    $('#jsrq').val($.getDate({ date: $thistr.attr('data-cyrq') }));
                //} else {
                //    $('#jsrq').val($.getDate());
                //}
                $('#zyh').val($thistr.attr('data-zyh'));
                //submit();
            }
        },
        colModel: [
            { label: 'Số nhập viện', name: 'zyh', width: 100 },
            { label: 'cyrq', name: 'cyrq', hidden: true },
            { label: 'ryrq', name: 'ryrq', hidden: true },
            { label: 'Đang ở viện dấu hiệu', name: 'zybz', width: 100, align: 'left' },
            { label: 'Họ tên', name: 'xm', width: 120, align: 'left' },
            { label: 'Năm sinh', name: 'csny', hidden: true, width: 100, align: 'left' },
            {
                label: 'Giới tính', name: 'xb', width: 50, align: 'left', formatter: function (cellvalue) {
                    return $.getGender(cellvalue);
                }
            },
            {
                label: 'Tuổi', name: 'nlshow', width: 50, align: 'left', formatter: function (cellvalue, a, b) {
                    return getAgeFromBirthTime({ begin: b.csny }).text;
                }
            }
        ]
    });
</script>


@{
    ViewBag.Title = "Phân tích chi phí nội trú";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<head>
    <meta charset="utf-8">
    <script src="~/Content/js/echarts.min.js"></script>

    <style>
        .banner {
            width: 16.3%;
            height: 80px;
            text-align: center;
        }
        .banner_title {
            padding-top:5px;
            height: 30%;
            font-size: 15px;
            font-weight: bold;
        }
        .banner_data {
            width: 100%;
            height: 30%;
            font-weight: bold;
            font-size: 18px;
        }
        .banner_down {
            display: flex;
            justify-content: space-around;
            font-size: 15px;
        }
        /*Viền*/
        .bk {
            background-color: #ffffff;
        }
        /*Phông chữ*/
        .font {
            font-weight: bold;
            text-align: center;
        }
        .down_border {
            border-bottom: 1px solid #e6e6e6;
        }
        .ui-jqgrid .ui-jqgrid-bdiv {
            overflow-x: hidden;
        }
    </style>

</head>

<div>
    <div class="panel panel-default">
        <table class="form">
            <tr>
                <th class="formTitle" id="xzsjtext">Loại:</th>
                <td class="formValue" style="width:150px">
                    <select id="dateType" class="form-control" onchange="updateSjType()">
                        <option value="1">năm</option>
                        <option value="2">tháng</option>
                        <option value="3">ngày</option>
                    </select>
                </td>
                <th class="formTitle" id="xzsjtext">Thời gian:</th>
                <td class="formValue" style="width:150px">
                    <input id="rSJ" type="text" class="form-control input-wdatepicker" @*onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })"*@>
                </td>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
            </tr>
        </table>
    </div>

    <div id="main_div" style="display:flex;flex-direction:column;justify-content:space-between;flex-wrap:wrap;">
        <div>
            <div class="panel-heading down_border" style="background-color:#ffffff;">
                <i class="fa fa-line-chart fa-lg" style="margin-right:5px;"></i>Phân tích toàn bộ chi phí nội trú
            </div>
            <div style="display:flex;justify-content:space-between;color:#ffffff;">
                <div class="banner" style="background-color: #fc8675;">
                    <div class="banner_title">Nhập viện Tổng chi phí(đồng)</div>
                    <div class="banner_data" id="zfy">
                    </div>
                    <div class="banner_down">
                        <p id="zfy_tb">0</p>
                        <p id="zfy_hb">0</p>
                    </div>
                </div>
                <div class="banner" style="background-color: #65cea7;">
                    <div class="banner_title">Thuốc phí(đồng)</div>
                    <div class="banner_data" id="ypf">
                        
                    </div>
                    @*<div  class="banner_down">
                        <p ></p>
                        <p ></p>
                    </div>*@
                </div>

                <div class="banner" style="background-color: #f3ce85;">
                    <div class="banner_title" >Vật tư tiêu hao phí(đồng)</div>
                    <div class="banner_data" id="hcf">
                    </div>
                    @*<div  class="banner_down">
                        <p >+2.35%so với tháng trước</p>
                        <p >+1.22%so với cùng kỳ</p>
                    </div>*@
                </div>

                <div class="banner" style="background-color: #00c0ef">
                    <div class="banner_title">Phí chẩn trị dùng(đồng)</div>
                    <div class="banner_data" id="zlf">
                    </div>
                    @*<div  class="banner_down">
                        <p >+2.35%so với tháng trước</p>
                        <p >+1.22%so với cùng kỳ</p>
                    </div>*@
                </div>

                <div class="banner" style="background-color: #60A7D0;">
                    <div class="banner_title">Số người xuất viện</div>
                    <div class="banner_data" id="cyrs">
                    </div>
                    <div  class="banner_down">
                        <p id="cyrs_tb"></p>
                        <p id="cyrs_hb"></p>
                    </div>
                </div>

                <div class="banner" style="background-color:#72B63F">
                    <div class="banner_title">Chi phí nội trú bình quân mỗi lượt</div>
                    <div class="banner_data" id="jczyfy">
                    </div>
                    <div  class="banner_down">
                        <p id="jczyfy_tb"></p>
                        <p id="jczyfy_hb"></p>
                    </div>
                </div>

            </div>
        </div>

        <div style="width:100%;height:30%" class="bk">
            <div style="text-align:left;">
                <div class="panel-heading down_border">
                    <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>Khoa Chi phí Phân tích
                </div>
                <table id="gridJSListksfyfx"></table>
            </div>

        </div>
        <div class="panel-heading down_border" style="background-color:#ffffff;">
            <i class="fa fa-pie-chart fa-lg" style="margin-right:5px;"></i>Phân tích chi phí bệnh nhân xuất viện
        </div>
        <div style="display:flex;flex-direction:row;justify-content: space-between;width:100%;height:50%">
            <div style="width:49.8%;height:100%;margin-bottom:2px" class="bk">
                <table id="gridJSListcyhzfyfx"></table>
            </div>
            <div id="main" style="width:49.8%;height:100%;" class="bk"></div>
        </div>
    </div>
</div>
<script>

    var myDate = new Date();
    $(function () {

        $('#main_div').height($(window).height() - 60);
        //Mặc định đặt loại thời gian là tháng
        $("#dateType").val("2");
        $('#rSJ').attr('onfocus', "WdatePicker({ dateFmt: 'yyyy-MM' })");
        $('#rSJ').val(myDate.getFullYear() + "-" + (parseInt(myDate.getMonth()) + 1));

        getData();//banner
        gridJSListData();
        initEcharts();
    });
    function submit() {
        getData();//banner
        $("#gridJSListksfyfx").jqGrid('setGridParam', {
            postData: getSearchData(),
        }).trigger('reloadGrid');
        $("#gridJSListcyhzfyfx").jqGrid('setGridParam', {
            postData: getSearchData(),
        }).trigger('reloadGrid');
        
        initEcharts();
    }
    //Đổi loại thời gian
    function updateSjType() {
        $('#rSJ').val("");
        let dateType = $("#dateType").val();
        if (dateType == "1") {//năm
            $('#rSJ').attr('onfocus', "WdatePicker({ dateFmt: 'yyyy' })");
            $('#rSJ').val(myDate.getFullYear());
        }
        if (dateType == "2") {//tháng
            $('#rSJ').attr('onfocus', "WdatePicker({ dateFmt: 'yyyy-MM' })");
            $('#rSJ').val(myDate.getFullYear() + "-" + (parseInt(myDate.getMonth()) + 1));
        }
        if (dateType == "3") {//ngày
            $('#rSJ').attr('onfocus', "WdatePicker({ dateFmt: 'dd/MM/yyyy' })");
            $('#rSJ').val(myDate.getFullYear() + "-" + (parseInt(myDate.getMonth()) + 1) + "-" + myDate.getDate());
        }
    }
    //Lấy số ngày trong tháng theo năm tháng
    function getDaysInMonth(year, month) {
        return new Date(year, month, 0).getDate();
    }
    //Ghép tham số yêu cầu
    function getSearchData() {
        let ksrq = '';
        let jsrq = '';
        let dateType = $("#dateType").val();
        let nowDate = $("#rSJ").val();
        if (dateType == "1") {//năm
            ksrq = nowDate + "-" + "01-01 00:00:00";
            jsrq = nowDate + "-" + "12-31 23:59:59";
        }
        if (dateType == "2") {//tháng
            let array = nowDate.split("-");
            ksrq = array[0] + "-" + array[1] + "-01 00:00:00";
            let days = getDaysInMonth(array[0], array[1]);
            jsrq = array[0] + "-" + array[1] + "-" + days + " 23:59:59";
        }
        if (dateType == "3") {//ngày
            ksrq = nowDate + " 00:00:00";
            jsrq = nowDate + " 23:59:59";
        }
        return { ksrq: ksrq, jsrq: jsrq, rtype: dateType };
    }
    //Tiêu đề
    function getData() {
        $.ajax({
            type: "Post",
            url: "/DeanInquiryManage/InpatientCostAnalysis/GetTitleData",
            dataType: "json",
            data: getSearchData(),
            success: function (ajaxresp) {
                if ($("#dateType").val() == "2") {
                    document.getElementById('zfy').innerText = ajaxresp.zfy;
                    document.getElementById('zfy_hb').innerText = "So với kỳ trước" + ajaxresp.zfy_hb;
                    document.getElementById('zfy_tb').innerText = "So với cùng kỳ" + ajaxresp.zfy_tb;
                    document.getElementById('ypf').innerText = ajaxresp.ypf;
                    document.getElementById('hcf').innerText = ajaxresp.hcf;
                    document.getElementById('zlf').innerText = ajaxresp.zlf;
                    document.getElementById('cyrs').innerText = ajaxresp.cyrs;
                    document.getElementById('cyrs_hb').innerText = "So với kỳ trước" + ajaxresp.cyrs_hb;
                    document.getElementById('cyrs_tb').innerText = "So với cùng kỳ" + ajaxresp.cyrs_tb;
                    document.getElementById('jczyfy').innerText = ajaxresp.jczyfy;
                    document.getElementById('jczyfy_hb').innerText = "So với kỳ trước" + ajaxresp.jczyfy_hb;
                    document.getElementById('jczyfy_tb').innerText = "So với cùng kỳ" + ajaxresp.jczyfy_tb;
                }
                else {
                    document.getElementById('zfy').innerText = ajaxresp.zfy;
                    document.getElementById('zfy_hb').innerText = "";
                    document.getElementById('zfy_tb').innerText = "";
                    document.getElementById('ypf').innerText = ajaxresp.ypf;
                    document.getElementById('hcf').innerText = ajaxresp.hcf;
                    document.getElementById('zlf').innerText = ajaxresp.zlf;
                    document.getElementById('cyrs').innerText = ajaxresp.cyrs;
                    document.getElementById('cyrs_hb').innerText = "";
                    document.getElementById('cyrs_tb').innerText = "";
                    document.getElementById('jczyfy').innerText = ajaxresp.jczyfy;
                    document.getElementById('jczyfy_hb').innerText = "";
                    document.getElementById('jczyfy_tb').innerText = "";
                }
            }
        });
    }

    function gridJSListData()
    {
        var gridSort = 'CreateTime asc';
        var $gridJsList = $("#gridJSListksfyfx");
        $gridJsList.dataGrid({
            height: 150,
            autowidth: true,//nếushrinkToFitlàtruevà đã đặtwidthGiá trị,thì chiều rộng mỗi cột sẽ theowidthco giãn theo tỷ lệ；
            shrinkToFit: true, //nếu đặt thànhtrue,thìGridchiều rộng sẽ tự tính lại theo chiều rộng của vùng chứa cha.**
            url: "/DeanInquiryManage/InpatientCostAnalysis/ZYFYFX_KSFYFXDTO",
            postData: getSearchData(),
            colModel: [
                { label: 'Khoa nhập viện', name: 'zyks',align: 'left' },
                { label: 'Tổng chi phí nội trú(đồng)', name: 'zfy',align: 'left' },
                { label: 'Thuốc phí(đồng)', name: 'ypf',align: 'left' },
                { label: 'Tỷ trọng thuốc(%)', name: 'ypf_zb',align: 'left' },
                { label: 'Vật tư tiêu hao phí(đồng)', name: 'hcf',align: 'left' },
                { label: 'Tỷ trọng vật tư tiêu hao(%)', name: 'hcf_zb',align: 'left' },
                { label: 'xét nghiệm kiểm tra phí(đồng)', name: 'jyjcf',align: 'left' },
                { label: 'trị liệu phí(đồng)', name: 'zlf',align: 'left' },
                { label: 'Khác(đồng)', name: 'qt',align: 'left' }
            ],
            sortname: gridSort,
            viewrecords: true
        });

        var gridSort = 'CreateTime asc';
        var $gridJsList = $("#gridJSListcyhzfyfx");
        $gridJsList.dataGrid({
            height: $(window).height() * 0.5 - 100,
            autowidth: true,//nếushrinkToFitlàtruevà đã đặtwidthGiá trị,thì chiều rộng mỗi cột sẽ theowidthco giãn theo tỷ lệ；
            shrinkToFit: true, //nếu đặt thànhtrue,thìGridchiều rộng sẽ tự tính lại theo chiều rộng của vùng chứa cha.**
            url: "/DeanInquiryManage/InpatientCostAnalysis/GetCYHZFYFData",
            postData: getSearchData(),
            colModel: [
                { label: 'Phân loại chi phí bình quân mỗi lượt', name: 'cjfyfl', align: 'left' },
                { label: 'Số tiền(đồng)', name: 'je', align: 'left' },
                { label: 'Tỷ trọng(%)', name: 'zb', align: 'left' }
            ],
            sortname: gridSort,
            viewrecords: true,
            onSelectRow_page: function (rowid) {
            },
            gridComplete: function (gridJszbList) {

            },
            ondblClickRow: function (row) {
            }
        });

    }


    function initEcharts() {
        $.ajax({
            type: "Post",
            url: "/DeanInquiryManage/InpatientCostAnalysis/GetCYHZFYFTJData",
            data: getSearchData(),
            dataType: "json",
            success: function (ajaxresp) {
                var arr = [];
                arr.push('product')
                for (var i = 0; i < ajaxresp.length; i++) {
                    arr.push(ajaxresp[i].nf);
                }
                //nặngmớinhómlắpsốdữ liệu,nơilýkhôngcó thểphản ánhchiếubánhbiểu đồcủahỏivấn đề
                let stat1 = [];
                stat1.push(arr)
                if (ajaxresp.length > 0) {
                    stat1.push(['Tổng chi phí bình quân mỗi lượt', ajaxresp[0].Tổng chi phí bình quân mỗi lượt, ajaxresp[1].Tổng chi phí bình quân mỗi lượt, ajaxresp[2].Tổng chi phí bình quân mỗi lượt, ajaxresp[3].Tổng chi phí bình quân mỗi lượt, ajaxresp[4].Tổng chi phí bình quân mỗi lượt, ajaxresp[5].Tổng chi phí bình quân mỗi lượt, ajaxresp[6].Tổng chi phí bình quân mỗi lượt]);
                    stat1.push(['Phí thuốc bình quân mỗi lượt', ajaxresp[0].Phí thuốc bình quân mỗi lượt, ajaxresp[1].Phí thuốc bình quân mỗi lượt, ajaxresp[2].Phí thuốc bình quân mỗi lượt, ajaxresp[3].Phí thuốc bình quân mỗi lượt, ajaxresp[4].Phí thuốc bình quân mỗi lượt, ajaxresp[5].Phí thuốc bình quân mỗi lượt, ajaxresp[6].Phí thuốc bình quân mỗi lượt]);
                    stat1.push(['Phí vật tư tiêu hao bình quân mỗi lượt', ajaxresp[0].Phí vật tư tiêu hao bình quân mỗi lượt, ajaxresp[1].Phí vật tư tiêu hao bình quân mỗi lượt, ajaxresp[2].Phí vật tư tiêu hao bình quân mỗi lượt, ajaxresp[3].Phí vật tư tiêu hao bình quân mỗi lượt, ajaxresp[4].Phí vật tư tiêu hao bình quân mỗi lượt, ajaxresp[5].Phí vật tư tiêu hao bình quân mỗi lượt, ajaxresp[6].Phí vật tư tiêu hao bình quân mỗi lượt]);
                    stat1.push(['Phí xét nghiệm kiểm tra bình quân mỗi lượt', ajaxresp[0].Phí xét nghiệm kiểm tra bình quân mỗi lượt, ajaxresp[1].Phí xét nghiệm kiểm tra bình quân mỗi lượt, ajaxresp[2].Phí xét nghiệm kiểm tra bình quân mỗi lượt, ajaxresp[3].Phí xét nghiệm kiểm tra bình quân mỗi lượt, ajaxresp[4].Phí xét nghiệm kiểm tra bình quân mỗi lượt, ajaxresp[5].Phí xét nghiệm kiểm tra bình quân mỗi lượt, ajaxresp[6].Phí xét nghiệm kiểm tra bình quân mỗi lượt]);
                    stat1.push(['Phí điều trị bình quân mỗi lượt', ajaxresp[0].Phí điều trị bình quân mỗi lượt, ajaxresp[1].Phí điều trị bình quân mỗi lượt, ajaxresp[2].Phí điều trị bình quân mỗi lượt, ajaxresp[3].Phí điều trị bình quân mỗi lượt, ajaxresp[4].Phí điều trị bình quân mỗi lượt, ajaxresp[5].Phí điều trị bình quân mỗi lượt, ajaxresp[6].Phí điều trị bình quân mỗi lượt]);
                    stat1.push(['Phí khác bình quân mỗi lượt', ajaxresp[0].Phí khác bình quân mỗi lượt, ajaxresp[1].Phí khác bình quân mỗi lượt, ajaxresp[2].Phí khác bình quân mỗi lượt, ajaxresp[3].Phí khác bình quân mỗi lượt, ajaxresp[4].Phí khác bình quân mỗi lượt, ajaxresp[5].Phí khác bình quân mỗi lượt, ajaxresp[6].Phí khác bình quân mỗi lượt]);
                }
                var myChart = echarts.init(document.getElementById('main'));
                window.addEventListener('resize', function () {
                    myChart.resize();
                });
                option = {
                    legend: {
                        orient: 'vertical',
                        bottom: 'bottom'
                    },
                    tooltip: {
                        trigger: 'axis',
                        showContent: false
                    },
                    dataset: {
                        source: stat1
                    },
                    xAxis: { type: 'category' },
                    yAxis: { gridIndex: 0 },
                    grid: { top: '55%' },
                    series: [
                        {
                            type: 'line',
                            smooth: true,
                            seriesLayoutBy: 'row',
                            emphasis: { focus: 'series' }
                           
                        },
                        {
                            type: 'line',
                            smooth: true,
                            seriesLayoutBy: 'row',
                            emphasis: { focus: 'series' }
                        },
                        {
                            type: 'line',
                            smooth: true,
                            seriesLayoutBy: 'row',
                            emphasis: { focus: 'series' }
                        },
                        {
                            type: 'line',
                            smooth: true,
                            seriesLayoutBy: 'row',
                            emphasis: { focus: 'series' }
                        },
                        {
                            type: 'line',
                            smooth: true,
                            seriesLayoutBy: 'row',
                            emphasis: { focus: 'series' }
                        },
                        {
                            type: 'line',
                            smooth: true,
                            seriesLayoutBy: 'row',
                            emphasis: { focus: 'series' }
                        },
                        {
                            type: 'pie',
                            id: 'pie',
                            radius: '30%',
                            center: ['50%', '25%'],
                            emphasis: {
                                focus: 'self'
                            },
                            label: {
                                 //formatter: '{b}: {@("@")2012} ({d}%)'
                                formatter: "{b}: {@('@')" + ajaxresp[0].nf+"} ({d}%)"
                            }, 
                            encode: {
                                itemName: 'product',
                                value: ajaxresp[0].nf,
                                tooltip: ajaxresp[0].nf
                            }
                        }
                    ]
                };
                
                myChart.on('updateAxisPointer', function (event) {
                    const xAxisInfo = event.axesInfo[0];
                    if (xAxisInfo) {
                        const dimension = xAxisInfo.value + 1;
                        myChart.setOption({
                            series: {
                                id: 'pie',
                                label: {
                                    formatter: '{b}: {@("@")[' + dimension + ']} ({d}%)'
                                },
                                encode: {
                                    value: dimension,
                                    tooltip: dimension
                                }
                            }
                        });
                    }
                });
                myChart.setOption(option);
            }
        })
    }
</script>

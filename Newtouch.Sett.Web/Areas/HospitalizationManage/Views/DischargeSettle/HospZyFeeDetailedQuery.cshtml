@{
    ViewBag.Title = "SimulateForm";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<div class="gridPanel" style="margin-top:1%">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>
<script>
	var zyh = $.request("zyh");
	var sfxmCode = $.request("sfxmCode");
    $(function () {
        gridInit();

        $(window).resize(function () {
            $("#gridList").setGridWidth($(window).width());
        })

    });
  

    function gridInit() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
			postData: { zyh: zyh, sfxmCode: sfxmCode },
            url: "/HospitalizationManage/DischargeSettle/GetZyDetailedQuery",
            height: $(window).height() - 80,
            colModel: [
                { label: 'Nhóm phí', name: 'dlmc', align: 'center', width: 60 },
                { label: 'thuộc tính', name: 'zfxz', align: 'center', width:40 },
                { label: 'Tên thuốc', name: 'sfxmmc', align: 'left', width: 150 },
                { label: 'Quy cách', name: 'gg', align: 'center', width: 60 },
                { label: 'Đơn vị', name: 'jfdw', align: 'center', width: 50 },
                {
                    label: 'Đơn giá', name: 'dj', align: 'center', width: 50,formatter: "number"
                    , formatoptions: { decimalPlaces: 2, defaultValue: '0.0000' } },
                { label: 'Số lượng', name: 'sl', align: 'center', width: 30 },
                { label: 'zyh', name: 'zyh', align: 'center', hidden: true, },
                {
                    label: 'phí', name: 'je', align: 'center', width: 30, formatter: "number"
                    , formatoptions: { decimalPlaces: 2, defaultValue: '0.0000' }
                },
                { label: 'Có tự phí hay không', name: 'zzfbz', align: 'center', width: 50 },
                { label: 'Ngày tính giá', name: 'tdrq', align: 'center', width: 70 },
                { label: 'Có tải lên hay không', name: 'tdrq', align: 'center', width: 100 },
			],
            pager: "#gridPager",
            sortname: 'sfxmmc',
            viewrecords: true,
        });
	}
</script>
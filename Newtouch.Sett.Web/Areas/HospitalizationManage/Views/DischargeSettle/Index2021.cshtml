                    gzyb_Cybl.prm_akc190 = rep.prm_akc190; //Số hiệu khám
                    gzyb_Cybl.prm_aac001 = rep.prm_aac001; //Số thẻ
                    gzyb_Cybl.prm_aka130 = rep.prm_aka130; //Loại thanh toán
                    gzyb_Cybl.prm_akc195 = "9"; //Lý do xuất viện (1、Khỏi bệnh；2、Đỡ hơn；3、Tử vong；4Chuyển viện;5quyết toán giữa kỳ bệnh tâm thần(Chỉquyết toán giữa kỳ khoán ngày bệnh tâm thần sử dụng);9 Khác)
                    gzyb_Cybl.prm_akc194 = patModel.cyrq.replace('T', ' '); //Ngày xuất viện
                    gzyb_Cybl.prm_akc196 = patModel.cyzdicd10; //Chẩn đoán xuất viện
                    gzyb_Cybl.prm_ykc015 = patModel.ksmc; //Khoa xuất viện(Khoalàtrongvăn,Không thể làm mã)
                    gzyb_Cybl.prm_ykc016 = patModel.cw; //Giường xuất viện
                    gzyb_Cybl.prm_ykc017 = '@(opr.UserName)'; //Tên người xử lý
                    //gzyb_Cybl.prm_ykc018 = curTime; //Thời gian xử lý xuất viện
                    gzyb_Cybl.prm_ykc018 = $.getTime(); //Thời gian xử lý xuất viện
                    $.najax({
                        url: "/Com/GetSysNowDate",
                        data: { format: "yyyy-MM-dd HH:mm:ss" },
                        dataType: 'text',
                        async: false,
                        success: function (strTime) {
                            gzyb_Cybl.prm_ykc018 = strTime; //Thời gian xử lý xuất viện
                        }
                    });
                    gzyb_Cybl.prm_yab003 = rep.prm_yab003; //trung tâm chi nhánhSố hiệu
                    gzyb_Cybl.prm_ykd065 = ""; //Mã chẩn đoán phụ xuất viện
                    gzyb_Cybl.prm_ykd018 = ""; //Mã chẩn đoán bệnh xuất viện thứ nhất
                    gzyb_Cybl.prm_ykd019 = ""; //Mã chẩn đoán bệnh xuất viện thứ hai
                    gzyb_Cybl.prm_ykd020 = ""; //Mã chẩn đoán bệnh xuất viện thứ ba
                    gzyb_Cybl.prm_ykd021 = ""; //Mã chẩn đoán bệnh xuất viện thứ tư
                    gzyb_Cybl.prm_ykd022 = ""; //Mã chẩn đoán bệnh xuất viện thứ năm
                    gzyb_Cybl.prm_ykd023 = ""; //Mã chẩn đoán bệnh xuất viện thứ sáu
                    gzyb_Cybl.prm_ykd024 = ""; //Mã chẩn đoán bệnh xuất viện thứ bảy
                    gzyb_Cybl.prm_ykd025 = ""; //Mã chẩn đoán bệnh xuất viện thứ tám
                    gzyb_Cybl.prm_ykb065 = rep.prm_ykb065; //Bảo hiểm xã hộiphương pháp
                   // var gzyb_CyblOut;// = $.guianyibao.ZyCybl(JSON.stringify(gzyb_Cybl)); //Gọi giao diện làm thủ tục xuất viện
                    $.ajax({
                        type: "POST",
                        url: "http://127.0.0.1:12345/api/YiBao/ZyCybl",
                        contentType: 'application/json',
                        data: JSON.stringify(gzyb_Cybl),
                        dataType: "json",
                        async: false,
                        success: function (data) {
                            gzyb_CyblOut = eval('(' + data + ')');
                        }
                    });
                    if (gzyb_CyblOut) {
                        if (gzyb_CyblOut.Code != 0) {
                            $.loading(false);
                            $.modalAlert("Làm thủ tục xuất viện BHYTThất bại：" + gzyb_CyblOut.ErrorMsg, 'error');
                            return;
                        }
                        else{
                            isSuccess = true;
                        }
                    } else {
                        $.loading(false);
                        $.modalAlert("Lấy thông tin phản hồi làm thủ tục xuất viện BHYT thất bại", 'error');
                        return;
                    }
                } else {
                    $.loading(false);
                    $.modalAlert("Không thể lấy thông tin BHYT làm thủ tục nhập viện", 'error');
                    return;
                }
            }
        });

        $.loading(false);
        //
        if (isSuccess && funcSuccCallback) {
            setTimeout(function () {
                funcSuccCallback(gzyb_CyblOut);
            }, 50);
        }
    }
</script>
<script type="text/javascript">
    //
    function readCard() {
         if (medicalInsurance == "chongqing") {
             GetReadCardInfo(null);
        }
    }
    //Đọc thẻ
    function GetReadCardInfo(sbkobj) {
         var cardInfo1;
        var cardInfo2;
        var cardInfo3;
        var yibaoCardInfo;
        var patsbkh = null;

        var url = "http://127.0.0.1:33333/api/YiBao/CardecInfo_1161";
        var payoptype = { "mdtrt_cert_type": $('#readCardCardType').val(), "operatorId": '@(opr.rygh)', "operatorName": '@(opr.UserName)', "businessType": "01101", "officeId": "0201", "officeName": "Nội khoa" };
        if ($('#readCardCardType').val() === "02") {
            payoptype.mdtrt_cert_no = sbkobj.sbkh;
            url = "http://127.0.0.1:33333/api/YiBao/CardecInfo_1101";
        }
        else if ($('#readCardCardType').val() === "01") {
            url = "http://127.0.0.1:33333/api/YiBao/CardecInfo_1162";
        }
        $.ajax({
            type: "POST",
            url: url,
            dataType: "json",
            data: payoptype,
            async: false,
            success: function (data) {
                yibaoCardInfo = eval('(' + data + ')');
            }
        });
        $.loading(false);
        if (yibaoCardInfo) {
            if (yibaoCardInfo.infcode == "0") {
                if (!yibaoCardInfo || !yibaoCardInfo.output.baseinfo || !yibaoCardInfo.output.insuinfo[0]) {
                    $.modalAlert("Đọc thẻ thất bại:" + yibaoCardInfo.err_msg, 'error');
                    return;
                }
                var ybklx = $('#readCardCardType').val();
                cardInfo1 = yibaoCardInfo.output.baseinfo; //BHYTquỹnàythông tin
                if (yibaoCardInfo.output.insuinfo.length > 1) {
                    for (var i = 0; i < yibaoCardInfo.output.insuinfo.length; i++) {
                        if (yibaoCardInfo.output.insuinfo[i].paus_insu_date)
                            continue;
                        else {
                            cardInfo2 = yibaoCardInfo.output.insuinfo[i];
                            break;
                        }
                    }
                } else
                    cardInfo2 = yibaoCardInfo.output.insuinfo[0];//Thông tin tham gia bảo hiểm
                //cardInfo2 = yibaoCardInfo.output.insuinfo[0];//Thông tin tham gia bảo hiểm
                if (ybklx !== "02") {
                    cardInfo3 = yibaoCardInfo.output.cardecinfo;//Thông tin thẻ
                    cqPatInfo.ecToken = cardInfo3.ecToken;
                    cqPatInfo.sbkh = cardInfo3.cardno;
                }

                cqPatInfo.xm = cardInfo1.psn_name;
                cqPatInfo.sfzh = cardInfo1.certno;
                cqPatInfo.xzqh = cardInfo2.insuplc_admdvs;
                cqPatInfo.cblb = cardInfo2.psn_type;
                cqPatInfo.xzlx = cardInfo2.insutype;
                cqPatInfo.grbh = cardInfo1.psn_no;
                cqPatInfo.ybklx = ybklx;
                cqPatInfo.jslx = "2";
                yibaoCardInfo.readCardCardType = ybkCardType;
                yibaoCardInfo.kh = ybklx == "03" ? cardInfo3.cardno : null;
                yibaoCardInfo.qtjz = ybklx != "03" ? cardInfo1.certno : null;
                //yibaoCardInfo.kh = ybklx=="01"?cardInfo1.certno:(ybklx=="02" ? cardInfo1.certno:cardInfo3.cardno) ;
                //Số hiệu BHXH Tạm thời làm số thẻ hệ thống
                ybIsReadCard = true;
                ajaxLoadDataResult({ kh: yibaoCardInfo.kh, sfz: yibaoCardInfo.qtjz, cardType: ybkCardType });
            } else {
                $.modalAlert("Quẹt thẻ thất bại:" + yibaoCardInfo.err_msg, 'error');
            }
        } else {
            $.modalAlert("Quẹt thẻ lấy thông tin BHYT thất bại！Lý do thất bại：Trung tâm BHYT không trả về thông tin，Vui lòng thử lại！", 'error');
        }
    }

    $('#readCard i').click(function () {
        if (false) {
            $.modalAlert("v.v.trường hợpKhông thểKích hoạt đọc thẻ", 'warning');
            return;
        }
        setTimeoutReadCard();
    })
    //Kích hoạt đọc thẻ
    function setTimeoutReadCard() {
        $.loading(true, 'Đang đọc thẻ，Vui lòng đợi…');
        setTimeout("readCard();", 50);
    }
    /*****************************************Nông thôn mới****************************************/
    //Dữ liệu trả về danh sách người tham gia nông thôn mới đã chọn
    function GetSelectedpatient(obj) {
        if (!!obj) {
            obj.readCardCardType = $('#readCardCardType').val();
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetZyhByGrbm")",
                data: { xnhgrbm: obj.xnhgrbm, sfjs: "0" },
            dataType: "json",
            async: false,
            success: function (resp) {
                if (!!resp.data) {
                    ajaxLoadDataResult({ zyh: resp.data });
                }
                else {
                    $.modalAlert("Mã cá nhân nông thôn mới【" + obj.xnhgrbm+"】khôngcóTruy vấntớiđãRa khoa、Bệnh nhân nhập viện chờquyết toán,Vui lòng xác nhận bệnh nhân này đã ra khoa！", 'warning');
                    return;
                     }
            }
         });
        }
    }
</script>
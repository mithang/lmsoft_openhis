<script>
    var medicalInsurance = '@medicalInsurance';
    var defaultPayMethod = "@(defaultPayMethod)";
    var SettPayBalance='@(SettPayBalance)';
    var sfyxdzzf = '@(sfyxdzzf)';
    var zyh = $.request("zyh");
    var ryrq = $.request("ryrq");
    var cyrq = $.request("cyrq");
    var ztjs = $.request("ztjs");
    var patid = $.request("patid");
    if (!!cyrq) {
        cyrq = $.getDate({ date: cyrq });   //Định dạng
    }

    ///quyết toán giữa kỳ
    if (ztjs) {
        //$('.ztjsyc').hide();

    }
    var interfaceWithCPOE = '@(interfaceWithCPOE)';
    //Số dưtạm ứng
    var yjjye = 0;
    var withYjj = '@(withYjj)';
    var yjjzffs = "";
    //Tổng số tiềnquyết toán
    var zje = ovpraseFloat($.request("zje"));
    //thanh toánphảithu Số phải thu khiquyết toán(zje = Được báo + Số phải thu khiquyết toán + v.v.)
    var orglxjzfys = ovpraseFloat($.request("xjzfys"));
    //Khi có chiết khấu thì không bằng original
    var xjzfys = orglxjzfys;    //Khi có chiết khấu thì sẽ không bằng

    //Liên quan BHYT
    var ybjyFeeReturn;
    var isYbjy = $.request("isYbjy");
    var brxz = $.request("brxz");
    var brxzmc = $.request("brxzmc");
    var strdyjylsh = "";//SốDòng chảy tài khoảnkhấu trừ,BHYT Trùng Khánh,làcập nhậtkhấu trừlưuBảngcủajsnm
    var xnhjyFeeReturn;
    var isXnhjy = $.request("isXnhjy");
    var cqPatInfo = JSON.parse(sessionStorage.getItem('cqPatInfo'));
    var zhdyList = "";
    if (isYbjy == 'true') {
        ybjyFeeReturn = JSON.parse(sessionStorage.getItem('ybjyFeeReturn'));
        if (!!ybjyFeeReturn) {
            if (!medicalInsurance) {
                $.modalAlert("Chương trình chưa cấu hình động nơi BHYT,Vui lòng cấu hình rồi thử lại", 'warning');
                $.modalClose();
            }
            if (cqPatInfo.ybVer === "gjyb")
	        {
                $('#divQHDYbFee').show();
                $('#divShYbV5Fee').remove();
	            var mzjzje = 0.000;//Số tiền cứu trợ dân chính
	            var xjzfje = 0.000;//Số tiền thanh toán tiền mặt BHYT
	            var zfxjzf = 0.000;//khôngThanh toán tiền mặt BHYTSố tiền

	            //Số tiền thanh toán tiền mặt BHYT
	            xjzfje = ovpraseFloat(ybjyFeeReturn.psn_cash_pay) ;
	            //khôngBHYTTiền mặtSố tiền
	            zfxjzf = ovpraseFloat(ybjyFeeReturn.his_hisfyze) -
			        ovpraseFloat(ybjyFeeReturn.ybzje);
	            //Tính thanh toán tiền mặt
	            var calc_xjzf = ovpraseFloat(ybjyFeeReturn.psn_cash_pay) +
			        ovpraseFloat(ybjyFeeReturn.his_hisfyze) -
			        ovpraseFloat(ybjyFeeReturn.ybzje);
	            ybjyFeeReturn.calc_xjzf = calc_xjzf;
	            //
	            zje = ovpraseFloat(ybjyFeeReturn.his_hisfyze);
	            orglxjzfys = ovpraseFloat(ybjyFeeReturn.calc_xjzf);
	            xjzfys = orglxjzfys;    //Khi có chiết khấu thì sẽ không bằng


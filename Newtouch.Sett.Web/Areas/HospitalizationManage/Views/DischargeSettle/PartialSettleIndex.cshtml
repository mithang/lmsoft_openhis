            success: function (data) {
                if (!!!data) {
                    msg = "HISdịch vụ(lấySố hóa đơn)Thông tin trả về trống";
                    return;
                }
                if (data.indexOf("{") >= 0 || data.indexOf("<") >= 0) {
                    msg = "HISdịch vụ(lấySố hóa đơn)Nội dung trả về lỗi：" + data;
                    return;
                }
                rs = true;
                fph = data;
            },
            error: function (request, error, ex) {
                msg = "HISdịch vụ(lấySố hóa đơn)không thể truy cập：[" + ex + "]";
            }
        });

        return { rs: rs, fph: fph, msg: msg };

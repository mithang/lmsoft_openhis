@*2020Bản quyết toán giữa kỳ*@
@using Newtouch.Sett.Domain;
@{
    ViewBag.Title = "PartialSettleIndex";
    Layout = "~/Views/Shared/_Form.cshtml";

    //Có giao dịch với BHYT hay không
    var openYbSett = SysConfigReader.Bool("Inpatient_Sett_OpenYbSett");
    //Nơi quản lý BHYT,phân biệt hệ thốngsẽthực hiệnở đâuLogic BHYT
    var medicalInsurance = SysConfigReader.String("Inpatient_MedicalInsurance");

    //thu phí thành côngSaulàkhôngTrực tiếpInBiên lai
    var autoPrintFP = SysConfigReader.Bool("Inpatient_Sett_AutoPrint");
    //Báo cáo biên lailiên kết
    var invoiceReportUrl = SysConfigReader.OrgReportLink("NewInpatientSett");

    var opr = NewtouchHIS.Lib.Framework.Operator.OperatorProvider.GetCurrent();
    var yesterday = DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd 23:59:59");
}

@Html.Partial("_YibaoCommonView")
<div class="rows" style="margin-bottom: 1%;">
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading navb-bg">
            Thông tin bệnh nhân nhập viện
        </div>
        <table class="form" style="width:96%;">
            <tbody>
                <tr>
                    <th class="formTitle">Mã nhập viện:</th>
                    <td class="formValue">
                        <input class="form-control" type="text" id="zyh" value="" />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-default btn-md btn-default-color" title="Chọn bệnh nhân nhập viện" style="" id="zy_btnsyy" value="Truy vấn" onclick="GetPatSerarchView();">
                    </td>
                    <td class="formValue" style="width: 130px">
                        @if (openYbSett == true)
                        {
                            <div id="readCard" style="color: orangered;">
                                <input type="button"  id="btkhsr" value="Nhập số giấy tờ" class="form-control" style="border-color:#00a0e9; margin-left: 0px;margin-top: 2px; height: 22px;width:44px;padding-left:0px; float: left;vertical-align:central;" onclick="GetPatSbkh()" />
                                <i class="fa fa-id-card" style="font-size: 27px; float: left; vertical-align: central;" title="Đọc thẻ"></i>
                                <select id="readCardCardType" class="form-control" style="width: 36px; height: 26px; padding: 0px; float: left; vertical-align: central;">
                                    @if (openYbSett == true)
                                    {
                                        <option value="03">Thẻ BHXH</option>
                                    }
                                    <option value="01">Thẻ BHXH (điện tử)</option>
                                    <option value="02">CMND/CCCD</option>
                                </select>
                            </div>
                        }
                    </td>
                    <th class="formTitle" style="width: 50px">Thời gian bắt đầu:</th>
                    <td class="formValue" style="width:143px;">
                        <label id="startTime"></label>
                    </td>
                    <th class="formTitle">Thời gian kết thúc:</th>
                    <td class="formValue" style="width:143px;">
                        <input id="endTime" type="text" class="form-control input-wdatepicker form-an formClearIgnore"
                               onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss', onpicked: function () { thenreload(); } })" value="@(System.DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd 23:59:59"))" />
                    </td>
                    <th class="formTitle">Họ tên:</th>
                    <td class="formValue">
                        <label id="zy_xm" style="min-width:100px"></label>
                    </td>
                    <th class="formTitle">Giới tính:</th>
                    <td class="formValue">
                        <label id="zy_xb"></label>
                    </td>
                </tr>
            </tbody>
            <tbody class="dispTbody" style="display:none;">
                <tr>
                    <th class="formTitle"></th>
                    <td class="formValue" colspan="3">
                        <label></label>
                    </td>
                    
                    <th class="formTitle">Tuổi:</th>
                    <td class="formValue">
                        <label id="zy_nl"></label>
                    </td>
                    <th class="formTitle">Chẩn đoán nhập viện:</th>
                    <td class="formValue">
                        <label id="zy_ryzd"></label>
                    </td>
                    <th class="formTitle">Ngày sinh:</th>
                    <td class="formValue" >
                        <label id="zy_csny" style="min-width:100px"></label>
                    </td>
                    <th class="formTitle">Ngày nhập viện:</th>
                    <td class="formValue">
                        <label id="zy_ryrq" style="min-width:100px"></label>
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="fa_icontoggle"><i class="fa fa-angle-double-down icontoggle" style="color:rgb(0, 160, 233);cursor:pointer;"></i></div>
    </div>
</div>
<ul id="myTab" class="nav nav-tabs">
    <li class="active"><a href="#wj" data-toggle="tab">Phí chưaquyết toán</a></li>
    <li><a href="#yj" data-toggle="tab">Lịch sử đãquyết toán</a></li>
</ul>
<div id="myTabContent" class="tab-content">
    <div class="tab-pane fade in active" id="wj">
        <div class="gridPanel">
            <table id="gridList"></table>
        </div>
    </div>
    <div class="tab-pane fade" id="yj">
        <div class="gridPanel">
            <table id="gridList2"></table>
        </div>
        <div style="margin:3px 0;">
            <span style="color:red;font-weight:bold;">*.Giới hạn chức năng hủylàHủy bỏDanh sáchtrongquyết toán gần nhất</span>
        </div>
    </div>
</div>

<div class="rows" style="margin-bottom: 1%;margin-top: 1%;">
    <div class="panel panel-default" style="margin-bottom:0;padding:10px;">
        <table class="form" style="width:96%;">
            <tbody>
                <tr>
                    <th class="formTitle">Phí chưaquyết toán:</th>
                    <td class="formValue" style="width:100px;">
                        <label id="lblSumje" style="color:red;font-weight: bold;font-size: large;"></label>
                    </td>
                    <th class="formTitle" style="width:105px;">Thời gian kết thúcquyết toán lần trước:</th>
                    <td class="formValue">
                        <label id="lastValidMidwaySettTime"></label>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
@Html.Partial("_BottomButtonsView", new Newtouch.Sett.Web.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 6,7, 8 },
    F8Text = "Xác nhậnthu phí",
    F6Text = "Hủyquyết toán",
    F7Text = "Chuyểnquyết toán xuất viện",
    F6Hidden = true,
    F7Hidden = true,
    F8Hidden = true,
})
<script type="text/javascript">


    var openYbSett = '@openYbSett' === 'True'; //Cấu hình công tắc:Bệnh nhân BHYT có sử dụng quy trình giao dịch BHYT hay không
    var isYbjyjz; //Lần khám hiện tại có giao dịch BHYT hay không
    var medicalInsurance = '@medicalInsurance';
    var curTime = $.getDate() + " 23:59:59";

    var ybkCardType = "@((int)EnumCardType.YBJYK)";//Loại thẻ BHYT
    var xnkCardType = "@((int)EnumCardType.XNK)";//Loại thẻ ảo
    var ybCommonBackReturnData;//Hủy kết quảquyết toán gần nhất BHYT
    var ybIsReadCard = false;
    var zyh;
    var cqPatInfo = {};

    //Thông qualsMã nhập việnchuyển qua
    var fromzyh = sessionStorage.getItem('zyh');
    var defaultShow = sessionStorage.getItem('defaultShow');
    if (fromzyh) {
        $('#zyh').val(fromzyh);
        zyh = fromzyh;
        sessionStorage.removeItem('zyh');
    }
    if (defaultShow) {
        sessionStorage.removeItem('defaultShow');
    }

    $(function () {
        initgridList1();
        initgridList2();
        $('#myTab li:eq(1) a').tab('show'); //sẽKích hoạtgrid2Nạp kiểu hiển thị

        if (!(defaultShow === 'yj')) {
            setTimeout("$('#myTab li:eq(0) a').tab('show');", 200); //Hiển thị phí chưaquyết toán
        }
    });

    function initgridList1() {
        if ($('#startTime').val() > $('#endTime').val()) {
            $.modalAlert("Thời gian bắt đầu không được lớn hơn thời gian kết thúc", "warning");
            return;
        }
        $('#gridList').dataGrid({
            unwritten: false,
            url: "/HospitalizationManage/BookkeepInHos/GetUnSettedFeeItemListJson",
            postData: { zyh: zyh, endTime: $("#endTime").val() },
            height: $(window).height() - 290,
            sortable: false,
            colModel: [
                { label: "Tên mụcthu phí", name: "sfxmmc", width: 180, align: "left" },
                {
                    label: "Số lượng", name: "sl", width: 80, align: "left", formatter: "number"
                    , formatoptions: { decimalPlaces: 2, defaultValue: '0.00' }
                },
                {
                    label: "Tổng số tiền", name: "zje", width: 80, align: "left", formatter: "number"
                        , formatoptions: { decimalPlaces: 2, defaultValue: '0.00' }
                },
            ],
            gridComplete: function (data) {
                var sumje = 0;
                if (data&&data.length > 0) {
                    $.each(data, function () {
                        sumje += this.zje;
                    });
                    if (sumje != 0) {
                        $('#lblSumje').html(sumje.toFixed(2));
                    }
                    else {
                        $('#lblSumje').html('');
                    }
                }
                jszje = sumje.toFixed(2);
            }
        });
    }

    var flagIsFirstInitGrid2 = true;
    $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
        var targetHref = $(e.target).attr('href');
        $('#btn_bottombutton_f6,#btn_bottombutton_f7,#btn_bottombutton_f8').hide();
        if (targetHref && targetHref.indexOf('yj') != -1) {
            $('#btn_bottombutton_f6,#btn_bottombutton_f7').show();
            if (flagIsFirstInitGrid2) {
                flagIsFirstInitGrid2 = false;
            }
            reloadGrid2();
        }
        else {
            $('#btn_bottombutton_f8').show();
        }
    })

    function initgridList2() {
        $('#gridList2').dataGrid({
            unwritten: false,
            height: $(window).height() - 310,
            sortable: false,
            colModel: [
                { label: "jsnm", name: "jsnm", align: "left", hidden: true },
                { label: "Mã nhập viện", name: "zyh", align: "left", hidden: true },
                {
                    label: "Số tiền quyết toán", name: "zje", width: 180, align: "left", formatter: "number"
                    , formatoptions: { decimalPlaces: 2, defaultValue: '0.00' }
                },
                {
                    label: "Thời gian bắt đầuquyết toán", name: "jsksrq", width: 240, align: "left",
                    formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }
                },
                {
                    label: "Thời gian kết thúcquyết toán", name: "jsjsrq", width: 240, align: "left",
                    formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }
                },
                { label: "Nhân viênquyết toán", name: "CreatorCode", width: 140, align: "left" },
                {
                    label: "Thời gianquyết toán", name: "CreateTime", width: 240, align: "left",
                    formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }
                }
            ],
        });
    }

    function thenreload() {
        //Nạp phí chưaquyết toán
        reloadGrid();
        reloadLastValidMidwaySettTime();

        var targetHref = $('#myTab li.active a').attr('href');
        if (targetHref && targetHref.indexOf('yj') != -1) {
            reloadGrid2();  //Hiện tại đãquyết toán
        }
    }

    function reloadGrid() {
        if ($("#startTime").val() > $("#endTime").val()) {
            $.modalAlert("Thời gian bắt đầu không được lớn hơn thời gian kết thúc", "warning");
            return;
        }
        $("#gridList").jqGrid('setGridParam', {
            postData: { zyh: zyh, endTime: $("#endTime").val() },
        }).trigger('reloadGrid');

    }

    function reloadGrid2() {
        $("#gridList2").jqGrid('setGridParam', {
            postData: { zyh: zyh },
            url:"/HospitalizationManage/BookkeepInHos/GetMidwaySettedListJson"
        }).trigger('reloadGrid');

    }

    function reloadLastValidMidwaySettTime() {
        //cập nhật‘Thời gian kết thúcquyết toán cuối cùng’
        $('#lastValidMidwaySettTime').html('');
        if (!!zyh) {
            $.najax({
                url: "/HospitalizationManage/BookkeepInHos/GetLastValidMidwaySettTimeJson?zyh=" + zyh,
                success: function (ajaxresp) {
                    if (ajaxresp.data) {
                        $('#lastValidMidwaySettTime').html($.getTime({ date: ajaxresp.data }));
                        $('#startTime').html($.getTime({ date: ajaxresp.data }));
                    }
                },
            });
        }
    }

    //Truy vấn bệnh nhân
    function GetPatSerarchView() {
        $.modalOpen({
            id: "patSearch",
            title: "Truy vấn bệnh nhân",
            url: "/PatientManage/AccountManage/PatSearchView?brzybzType=" + '@((int)EnumZYBZ.Bqz + "," + (int)EnumZYBZ.Djz)' + "&t=" + Math.random() + "&zyh=" + zyh,
            width: "700px",
            height: "600px",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //tạiBật lênsự kiện cửa sổ
                //Gọi truy vấn số thẻ và mã nhập viện
            }//Hàm gọi lại khi nhấn xác nhận tại cửa sổ
        });

    }

    //Nhập tay số thẻ BHXH
    function GetPatSbkh() {
        $.modalOpen({
            id: "sbkhInput",
            title: "Nhập số thẻ",
            url: "/OutpatientManage/OutpatientReg/OutPatientSbkhInput?t=" + Math.random(),
            width: "300px",
            height: "150px",
            callBack: function (iframeId) {
                top.frames[iframeId].PatSbkhData();
            }
        });
    }
    //Bệnh nhân đã chọn callback
    function getPatInfoAjax(selePatInfo) {
        $('#endTime').val('@(yesterday)'); //update endTime
        $('#zyh').val(selePatInfo.zyh);
        zyh = selePatInfo.zyh;
        ajaxLoadDataResult({ zyh: selePatInfo.zyh});
    }

    var patModel = null;
    var jszje = 0.00;
    //Nạp thông tin cơ bản nhập viện
    function ajaxLoadDataResult(obj, funcSuccCallback) {
        $('#startTime').html('');   //chỉcóchuyển đổiMã nhập việncủalúcchờ,mớichuyển đổiNgày bắt đầu
            $.najax({
                type: "POST",
                data: obj,
                url: "/HospitalizationManage/DischargeSettle/GetPartialInpatientSettleStatusDetail",
                dataType: "json",
                success: function (ajaxresp) {
                    $('#lblSumje').text('0.00');
                    patModel = ajaxresp.data.InpatientSettPatInfo
                    cqPatInfo.zymzh = patModel.zyh;//Mã nhập viện
                    setPatInfoModel();

                    thenreload();

                    isYbjyjz = openYbSett && patModel.brxz == '1' && patModel.CardType == "@((int)Newtouch.Sett.Domain.EnumCardType.YBJYK)";

                },
                errorCallback: function (err) {
                    newtouch_event_f4();
                    $('#zyh').trigger('focus');
                }
            });
    }

    //Khởi tạo thông tin bệnh nhân
    function setPatInfoModel() {
        zyh = patModel.zyh;
        $('#zyh').val(patModel.zyh);
        $('#zy_xm').html(patModel.xm);
        $('#zy_xb').html($.getGender(patModel.xb));
        $('#zy_nl').html(getAgeFromBirthTime({ begin: patModel.csny }).text);
        $('#zy_ryzd').html(patModel.ryzdmc);
        $('#zy_csny').html(patModel.csny ? patModel.csny.substring(0, 10) : '');
        $('#zy_ryrq').html(patModel.ryrq ? patModel.ryrq.substring(0, 10) : '');

        //$('#startTime').html(patModel.ryrq ? patModel.ryrq.substring(0, 10) : '');
        $('#startTime').html(patModel.ryrq ? patModel.ryrq.replace('T',' '): '');
    }


    function hisSubmit(isYbjyjz, ybjyFeeReturn) {
        var zyh = patModel.zyh;
        var ryrq = $.getDate({ date: patModel.ryrq });
        var zje = ovpraseFloat(jszje).toFixed(2);
        //
        var widthpx = "600px";
        var heightpx = "400px";
        var hzjslx = "0";//0Tự phí  1BHYT  8bảo hiểm nông nghiệp
        if (isYbjyjz && ybjyFeeReturn) {
            sessionStorage.setItem('ybjyFeeReturn', JSON.stringify(ybjyFeeReturn));
            sessionStorage.setItem('cqPatInfo', JSON.stringify(cqPatInfo));
            widthpx = "700px";
            heightpx = "500px";
            hzjslx = "1";
            ybjyFeeReturn.cqtczf = ybjyFeeReturn.hifp_pay;
            ybjyFeeReturn.zhzf = ybjyFeeReturn.acct_pay;
            ybjyFeeReturn.cqxjzf = ybjyFeeReturn.psn_cash_pay;
            ybjyFeeReturn.gwybz = ybjyFeeReturn.cvlserv_pay;
            ybjyFeeReturn.delpje = ybjyFeeReturn.hifob_pay;
            ybjyFeeReturn.dbzddyljgdz = ybjyFeeReturn.hosp_part_amt;
            ybjyFeeReturn.zhye = ybjyFeeReturn.balc;
            ybjyFeeReturn.jylsh = ybjyFeeReturn.setl_id;
            ybjyFeeReturn.zxjssj = ybjyFeeReturn.setl_time;
        }

        var openUrl = "/HospitalizationManage/DischargeSettle/ConfirmForm?zyh=" + zyh;
        openUrl += "&ryrq=" + (!!ryrq ? ryrq : '');
        openUrl += "&zje=" + (!!zje ? ovpraseFloat(zje).toFixed(2) : '');
        openUrl += "&xjzfys=" + (!!zje ? ovpraseFloat(zje).toFixed(2) : '');
        openUrl += "&patid=" + patModel.patId;
        openUrl += "&isXnhjy=";
        openUrl += "&isYbjy=" + (!!isYbjyjz) + "&brxz=" + patModel.brxz + "&brxzmc=" + patModel.brxzmc+ "&ztjs=" + true,
            $.modalOpen({
                id: "ConfirmFeeForm",
                title: "quyết toán giữa kỳ",
                url: openUrl,
                width: widthpx,
                height: heightpx,
                callBack: function (iframeId) {
                    top.frames[iframeId].AcceptClick(function (feeRelated, outTradeNo) {
                        var startTime = $('#startTime').html();
                        if (!!!startTime) {
                            $.modalAlert("chưachỉ địnhThời gian bắt đầuquyết toán", 'error');
                            return;
                        }
                        if (!!!zyh) {
                            $.modalAlert("Vui lòng chọn bệnh nhân nhập viện", 'error');
                            return;
                        }
                        var thisSettEndTime = $('#endTime').val();
                        if (!!!thisSettEndTime) {
                            $.modalAlert("chưachỉ địnhThời gian kết thúcquyết toán", 'error');
                            return;
                        }

                        if ($("#startTime").val() > $("#endTime").val()) {
                            $.modalAlert("Thời gian bắt đầu không được lớn hơn thời gian kết thúc", "warning");
                            return;
                        }

                        var allLine = $("#gridList").jqGrid('getRowData_AllLine', null, true);
                        if (!!!allLine || allLine.length == 0) {
                            $.modalAlert("Không có phí chưaquyết toán", 'error');
                            return;
                        }
                       
                        //Gửi
                        var postData = { zyh: zyh, startTime: startTime, endTime: thisSettEndTime, fph: feeRelated.fph, feeRelated: feeRelated, ybfeeRelated: ybjyFeeReturn, jslx: hzjslx, outTradeNo: outTradeNo };
                        $.submitForm({
                            type: "POST",
                            url: "/HospitalizationManage/DischargeSettle/PartialSettleSave",
                            param: postData,
                            success: function (ajaxresp) {
                                var message = "";
                                sessionStorage.setItem('zyh', zyh);

                                $.modalMsg("quyết toán thành công" + message, 'success');
                                $.modalClose("ConfirmFeeForm");
                                newtouch_event_f4();
                                //In hóa đơn
                                if (ajaxresp.data && ajaxresp.data.jsnm) {
                                    if ('@(autoPrintFP)' == 'True') {
                                        //báo cáoIn
                                        var uri = '@Html.Raw(invoiceReportUrl)' + "&jsnm=" + ajaxresp.data.jsnm;
                                        window.open(uri, "_blank", "height=500, width=1195,top=100, left=50, toolbar =no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no");

                                    }
                                }
                            }
                        });
                    });
                },
                cancelCallBack: function (iframeId) {
                    //Hủyquyết toán xuất viện,Làm thủ tục xuất việnhoàn trả
                    if (isYbjyjz) {
                        //if (medicalInsurance == "chongqing") {
                            var cqybjyDenySettleReturn;
                            var payoptype = { hisId:zyh,'setl_id': ybjyFeeReturn.setl_id, 'operatorId': '@(opr.rygh)', 'operatorName': '@(opr.UserName)', 'mdtrt_id': ybjyFeeReturn.mdtrt_id, 'psn_no': cqPatInfo.grbh, "insuplc_admdvs": cqPatInfo.xzqh };
                            $.ajax({
                                type: "POST",
                                url: "http://127.0.0.1:33333/api/YiBao/HospitaUpSettlement_2305",
                                dataType: "json",
                                data: payoptype,
                                async: false,
                                success: function (data) {
                                    cqybjyDenySettleReturn = eval('(' + data + ')');
                                }
                            });
                            if (cqybjyDenySettleReturn.infcode !== "0") {
                                $.modalAlert('Đảo ngược quyết toán nhập viện thất bại:' + cqybjyDenySettleReturn.ErrorMsg + '【lúc nàyBHYTđã quyết toán thành công,Vui lòng liên hệ nhà phát triển HIS xử lý】', 'error');
                            }

                            $.loading(false);
                        //}
                    }
                }
            });
    }

    function newtouch_event_f4() {
        $('#zyh').val('');
        sessionStorage.removeItem('zyh');
        $('#startTime').html('');

        $('#endTime').val('@(yesterday)');
        $('#zy_xm').html('');
        $('#zy_xb').html('');
        $('#zy_nl').html('');
        $('#zy_ryzd').html('');
        $('#zy_csny').html('');
        $('#zy_ryrq').html('');
        patModel = null;
        jszje = 0.00;
        flagIsFirstInitGrid2 = true;
        $('#myTab li:eq(1) a').tab('show'); //sẽKích hoạtgrid2Nạp kiểu hiển thị
        $('#lblSumje').text('0.00');
        $('#gridList').jqGrid("clearGridData");

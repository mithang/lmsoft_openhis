    //Gạch đỏ chứng từ
    function refundPrintInvoiceReq(mzh, jsnm) {
        var requestJson = { "BusinessName": "Gạch đỏ hóa đơn", "paySerialNo": mzh, "paySettlementNo": jsnm, "Operator": "@(opr.UserName)", "Reason": "Hủyquyết toán xuất viện và gạch đỏ" };

            data: { zyh: zyh },
            dataType: 'json',
            async: false,
            success: function (rep) {
                if (rep) {
                    var gzyb_Cyblcx = new Object();
                    gzyb_Cyblcx.prm_akc190 = rep.prm_akc190;//Số hiệu khám
                    gzyb_Cyblcx.prm_aka130 = rep.prm_aka130;//Loại thanh toán
                    gzyb_Cyblcx.prm_ykc141 = '@(opr.UserName)';//Tên người xử lý
                    //gzyb_Cyblcx.prm_aae036 = curTime;//Thời gian xử lý
                    gzyb_Cyblcx.prm_aae036 = $.getTime();//Thời gian xử lý
                    $.najax({
                        url: "/Com/GetSysNowDate",
                        data: { format: "dd/MM/yyyy HH:mm:ss" },
                        dataType: 'text',
                        async: false,
                        success: function (strTime) {
                            gzyb_Cyblcx.prm_aae036 = strTime; //Thời gian xử lý
                        }
                    });
                    gzyb_Cyblcx.prm_yab003 = rep.prm_yab003;//trung tâm chi nhánhSố hiệu
                    gzyb_Cyblcx.prm_aac001 = rep.prm_aac001;//Số thẻ
                    gzyb_Cyblcx.prm_ykb065 = rep.prm_ykb065;//Bảo hiểm xã hộiphương pháp
                    var gzyb_CyblcxOut;// = $.guianyibao.ZyCyblht(gzyb_Cyblcx); //Gọi giao diện làm thủ tục xuất viện
                    $.ajax({
                        type: "POST",
                        url: "http://127.0.0.1:12345/api/YiBao/ZyCyblht",
                        contentType: 'application/json',
                        data: JSON.stringify(gzyb_Cyblcx),
                        dataType: "json",
                        async: false,
                        success: function (data) {
                            gzyb_CyblcxOut = eval('(' + data + ')');
                        }
                    });
                    if (gzyb_CyblcxOut) {
                        if (gzyb_CyblcxOut.Code != 0) {
                            $.loading(false);
                            $.modalAlert(gzyb_CyblcxOut.ErrorMsg, "error");
                            return;
                        }
                    } else {
                        $.loading(false);
                        $.modalAlert("Không thể lấy thông tin phản hồi hủy làm thủ tục xuất viện BHYT", "error");
                        return;
                    }
                } else {
                    $.loading(false);
                    $.modalAlert("Không thể lấy thông tin BHYT làm thủ tục nhập viện", "error");
                    return;
                }
            }
        });

        $.loading(false);
        //
        if (funcSuccCallback) {
            setTimeout(function () {
                funcSuccCallback();
            }, 50);
        }
    }
</script>

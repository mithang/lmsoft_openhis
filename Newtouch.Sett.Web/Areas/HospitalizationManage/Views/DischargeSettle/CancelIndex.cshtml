        newtouch_globalevent_f4();
        zyh = null;
        jsnm = null
        ybjsh = null;
    };

    //GửiHủyquyết toán
    function newtouch_event_f8() {
        if (!zyh) {
            $.modalAlert("Mã nhập việnlàtrống,Vui lòng xác nhận", 'warning');
            return;
        }
        if (!jsnm) {
            $.modalAlert("Lỗi,Thiếu mãquyết toán", 'warning');
            return;
        }
        if (isYbjyjz) {
            if (!isybdk) {
                $.modalAlert("Hủyquyết toán bệnh nhân BHYT,Vui lòng đọc thẻ trước！", 'warning');
                return;
            }
            $.ajax({
                type: "GET",
                url: "/HospitalizationManage/DischargeSettle/GetCancelSettInfo?jsnm=" + jsnm,
                dataType: "json",
                async: false,
                success: function (canceldata) {
                    if (canceldata.state == "error") {
                        $.modalAlert("Lấy thông tin hủyquyết toán của bệnh nhân BHYT thất bại:" + canceldata.message, 'warning');
                        return;
                    }
                    if (cqPatInfo.ybVer == "shanghaiV5") {
                        var DenySettleReturn;
                        var payoptype = {
                            hisId: zyh, 'operatorId': '@(opr.rygh)', 'operatorName': '@(opr.UserName)',
                            'carddata': cqPatInfo.carddata, 'cardtype': cqPatInfo.cardtype, "insuplc_admdvs": cqPatInfo.xzqh,
                            'sflx': "2", 'translsh': canceldata.setl_id, 'totalexpense': "", 'cxly': "1", "xsywlx": "1"
                        };
                        $.ajax({
                            type: "POST",
                            url: "http://127.0.0.1:33333/api/FifthPhaseYiBao/ybInterface_SK01",
                            dataType: "json",
                            data: payoptype,
                            async: false,
                            success: function (data) {
                                DenySettleReturn = eval('(' + data + ')');
                            }
                        });
                        if (DenySettleReturn.xxfhm === "P001") {
                            shybhisSubmit(DenySettleReturn.xxnr.translsh);
                        } else {
                            $.modalAlert('Đảo ngược quyết toán nhập viện thất bại:' + DenySettleReturn.fhxx + '【lúc nàyBHYTđã quyết toán thành công,Vui lòng liên hệ nhà phát triển HIS xử lý】', 'success');
                        }
                    } else {
                        if (canceldata) {
                            $.ajax({
                                type: "POST",
                                url: "http://127.0.0.1:33333/api/YiBao/HospitaUpSettlement_2305",
                                dataType: "json",
                                data: canceldata,
                                async: false,
                                success: function (data) {
                                    cqybjyDenySettleReturn = eval('(' + data + ')');
                                }
                            });
                            if (cqybjyDenySettleReturn.infcode == "0" || cqybjyDenySettleReturn.infcode == 0) {
                                $.ajax({
                                    type: "POST",
                                    url: "http://127.0.0.1:33333/api/YiBao/HospitaUpOutMdtrtinfo_2405",
                                    dataType: "json",
                                    data: canceldata,
                                    async: false,
                                    success: function (data) {
                                        var cxcyReturn = eval('(' + data + ')');
                                        if (cxcyReturn.infcode != '0') {
                                            $.modalAlert('【2305】Hủyquyết toán thành côngnhưng【2405】Hủy xuất việnThất bại:' + cxcyReturn.err_msg + '【Vui lòng liên hệ nhà phát triển HIS xử lý】', 'success');
                                        }
                                        else {
                                            hisSubmit(true, cqybjyDenySettleReturn.output.setlinfo);
                                        }
                                    }
                                });

                            } else {
                                $.modalAlert('Đảo ngược quyết toán nhập viện thất bại:' + cqybjyDenySettleReturn.err_msg, 'warning');
                                return;
                            }
                        } else {
                            $.modalAlert('Hủyquyết toán thất bại,Bảngquyết toáncqyb_OutPut05trongkhông cóLầnquyết toánBHYTlưuDữ liệu:Mãquyết toán' + jsnm, 'warning');
                            return;
                        }
                        $.loading(false);
                    }
                }
            });
        }
        else {
            hisSubmit();
        }
    }


    //Tính theo thanh toánphảithu、Phương thức thanh toán Tính tổng thực thu、Tiền thừa
    function hjsskZhaolingCal() {
        if (!$('#zffs1').val() && $('#zfje1').val() != 0) {
            //Chưa chọnPhương thức thanh toán，đối vớiphảiSố tiềncầnđặtlà0.00
            $('#zfje1').val('0.00');
        }


@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<div class="panel panel-default" style="margin-bottom:0;">
    <div class="panel-heading navb-bg">
        Truy vấn hoàn phí nhập viện
    </div>
    <div style="padding: 2px;padding-right:20px;">
        <table class="form" style="width:100%;">
            <tr>
                <td class="formTitle">Mã nhập viện:</td>
                <td class="formValue">
                    <input id="zyh" type="text" class="form-control " placeholder="Vui lòng nhập mã nhập viện">
                </td>
                <td class="formTitle">Tên bệnh nhân:</td>
                <td class="formValue">
                    <input class="form-control newtouch_Readonly" type="text" id="brxm" value="" />
                </td>

                <td class="formTitle">Tên mục:</td>
                <td class="formValue">
                    <input class="form-control" type="text" id="sfxm" value="" />
                </td>
                <td class="formTitle">Khoa thực hiện:</td>
                <td class="formValue">
                    <input class="form-control" type="text" id="zxks" value="" />
                </td>
                <td class="formTitle"></td>
                <td class="formValue" rowspan="2">
                    <button id="BtnQuery" class="btn btn btn-default btn-md dropdown-text" style="width:50px;">Truy vấn</button>
                </td>
            </tr>

        </table>
    </div>
</div>

<br />
<form id="tabGrid">
    <div class="gridPanel">
        <table id="refundGridList" rel="tabGrid"></table>
    </div>
    <br />
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading navb-bg">
            Hoàn phí
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form" style="width:96%;" id="tslTable">
                <tr>
                    <td class="formTitle">Số lượng hoàn:</td>
                    <td class="formValue">
                        <input class="form-control" type="text" id="tsl" value="" />
                        <input class="form-control" type="hidden" id="bianhao" value="" />
                        <input class="form-control" type="hidden" id="IsYP" value="" />
                    </td>
                    <td class="formTitle"></td>
                    <td class="formValue"></td>
                    <td class="formTitle"></td>
                    <td class="formValue"></td>
                    <td class="formTitle"></td>
                    <td class="formValue"></td>
                </tr>
            </table>
        </div>
    </div>

    <br />
    <div class="gridPanel">
        <table id="gridListDetail" rel="tabGrid"></table>
    </div>
</form>
@Html.Partial("_BottomButtonsView", new Newtouch.Sett.Web.Models.BottomButtonViewModel()
{
    ShowKeyList = new[] { 4, 8 },
    F8Text = "Gửi"
})
<script>
    $(function () {
        //Nạp lại khi thay đổi kích thước cửa sổ trình duyệtjqGridChiều rộng
        $(window).resize(function () {
            initLayout("tabGrid");
        });

        var txt_keyword = document.getElementById('zyh');
        txt_keyword.addEventListener('keydown', function (event) {
            event = event || window.event;
            if (event.keyCode == 13) {
                GetPatInfo();
            }
        });


        $("#detailTable").hide();

        initControl();
        gridListData([]);
        gridListDetail([]);
        $("#acc_reMoney").click(function () {
            newtouch_globalevent_f4();
            newtouch_event_f4();
        });


        $("#tuifeiQuery").click(function () {
            if (checkTSL()) {
                return false;
            }
        });
        $("#gridListDetail").children().children().click(function () {
            $(this).clone(true).appendTo($("#gridListDetail").children());//Sao chép nút đang nhấp hiện tại,vàsẽnóđuổithêmtớiulTrong phần tử,khiThêmTham sốlúcSao chépnócủasự kiện

        });
        function GetPatInfo() {
            var zyh = $("#zyh").val();
            $.najax({
                type: "POST",
                url: "@Url.Action("GetPatInfoByZyh")",
                data: {
                    zyh: zyh,
                    time: new Date()
                },
                cache: false,
                dataType: "json",
                success: function (ajaxresp) {
                    $("#brxm").val(ajaxresp.data);
                    $("#BtnQuery").click();
                },
                errorCallback: function (err) {
                },
                complete: function () {
                    isLoadingIIII = false;
                    $.loading(false);
                }
            });
        }
        $("#BtnQuery").click(function () {
            $('#gridListDetail').jqGrid("clearGridData");

            var zyh = $("#zyh").val();

            if (zyh.length > 0) {

                var brxm = $("#brxm").val();
                var yrh = $("#yrh").val();
                var zxks = $("#zxks").val();
                var xmmc = $("#sfxm").val();
                $.loading(true, "Đang yêu cầu dữ liệu...");
                $.najax({
                    type: "POST",
                    url: "@Url.Action("BtnQuery")",
                    data: {
                        zyh: zyh,
                        brxm: brxm,
                        yrh: yrh,
                        zxks: zxks,
                        xmmc: xmmc
                    },
                    dataType: "json",
                    cache: false,
                    success: function (ajaxresp) {
                        $("#tslTable").css("display", "");
                        $('#refundGridList').jqGrid("clearGridData");
                        gridListData(ajaxresp.data);
                    },
                    errorCallback: function (err) {
                    },
                    complete: function () {
                        isLoadingIIII = false;
                        $.loading(false);
                    }
                });

            } else {
                $.modalAlert("Mã nhập viện không được để trống！", "error");
            }

        });

      
    });

      //Nhấn hoàn phí để trả về kết quả hoàn phí
    function newtouch_event_f8() {
        if (checkTSL()) {
                $.modalConfirm("Bạn có chắc muốn hoàn phí không?？", function (flag) {
                    if (flag) {
                        $.loading(true, "Đang yêu cầu dữ liệu...");
                        $.najax({
                            type: "POST",
                            url: "@Url.Action("btnTuiFei")",
                            data: {
                                cxzyjfbbh: $("#bianhao").val(),
                                is_sfxm: $("#IsYP").val(),
                                refundNum: $("#tsl").val()

                            },
                            dataType: "json",
                            cache: false,
                            success: function (ajaxresp) {
                                $('#gridListDetail').jqGrid("clearGridData");
                                $.modalAlert("Hoàn phí thành công！", "success");
                                $("#BtnQuery").click();
                                $("#tsl").val(""); //Xóa số lượng hoàn
                            },
                            error: function (err) {
                                $.loading(false)
                            },
                            complete: function () {
                                isLoadingIIII = false;
                                $.loading(false);
                            }
                        });
                        return true;
                    }
                }, false);
            }

    }
        function checkTSL() {
            var sl = $("#refundGridList").jqGridRowValue().SL;
            var tem = $("#tsl").val();
            if (parseInt(sl) < parseInt(tem)) {
                $.modalAlert("Số lượng hoàn không được lớn hơn số lượng đã nộp！", "error");
                return false;
            }
            if (sl==undefined || tem == "" || parseInt(tem) < 0) {
                $.modalAlert("Tạm thời không có số lượng có thể hoàn！", "error");
                return false;
            }
            return true;

        }
        //Nạp dữ liệu chi tiếtthu phí đang chọn

        function GetDetail() {
            $.loading(true, "Đang yêu cầu dữ liệu...");
            var data = $("#refundGridList").jqGridRowValue();

            $.najax({
                type: "GET",
                url: "@Url.Action("Detail")",
                data: {
                    zyh: data.ZYH,
                    xsebh: data.XSEBH,
                    sfxm: data.SFXM,
                    CreateTime: data.CreateTime,
                    is_sfxm: data.IS_SFXM
                },
                dataType: "json",
                cache: false,
                success: function (ajaxresp) {
                    $("#bianhao").val(ajaxresp.data[0].JFBBH);
                    $("#IsYP").val(data.IS_SFXM);
                    $('#gridListDetail').jqGrid("clearGridData");
                    gridListDetail(ajaxresp.data);
                    return;
                },
                errorCallback: function (err) {

                },
                complete: function () {
                    isLoadingIIII = false;
                    $.loading(false);
                }
            });
        }

        //Danh sáchthu phíSự kiện nhấp chuột
        function btn_selectrow() {
            $.loading(true, "Đang yêu cầu dữ liệu...");
            var data = $("#refundGridList").jqGridRowValue();

            $.najax({
                type: "GET",
                url: "@Url.Action("Detail")",
                data: {
                    zyh: data.ZYH,
                    xsebh: data.XSEBH,
                    sfxmbh: data.SFXMBH,
                    CreateTime: data.CreateTime,
                    is_sfxm: data.IS_SFXM
                },
                dataType: "json",
                cache: false,
                success: function (ajaxresp) {
                    $("#bianhao").val(ajaxresp.data[0].JFBBH);
                    $("#IsYP").val(data.IS_SFXM);
                    $('#gridListDetail').jqGrid("clearGridData");
                    gridListDetail(ajaxresp.data);
                    return;

                },
                error: function (err) {
                    $.loading(false);
                },
                complete: function () {
                    isLoadingIIII = false;
                    $.loading(false);
                }
            });
        }


        function gridListDetail(mydata) {
            var $gridList = $("#gridListDetail");
            $gridList.dataNewGrid({
                height: 100,
                autowidth:false,
                width: $("#tabGrid").width() - 20,
                caption: "Nhật ký thao tác",
                colModel: [
                    { label: 'CXZYJFBBH', name: 'CXZYJFBBH', hidden: true, key: true },
                    { label: 'JFBBH', name: 'JFBBH', hidden: true, key: true },
                    {
                        label: 'nộp hồ sơNgày', name: 'CreateTime', width: 150, align: 'left'
                    },
                    { label: 'Tên mục', name: 'SFXMMC', width: 300, align: 'left' },
                    { label: 'Số hiệu mục',name:'SFXMCode',hidden:true},
                    { label: 'Đơn vị tính phí', name: 'JFDW', width: 100, align: 'left' },
                    { label: 'Số lượng', name: 'SL', width: 100, align: 'left' },
                    { label: 'Số lượng hoàn', name: 'RETURN_SL', width: 100, align: 'left' }
                ], sortname: 'CreateTime asc'
            }, mydata);
            if (mydata.length > 0) {
                $('.ui-jqgrid-bdiv').find(".unwritten").remove();
            }
        }
        function gridListData(mydata) {
            var $gridList = $("#refundGridList");
            $gridList.dataNewGrid({
                height: 100,
                autowidth: false,
                width: $("#tabGrid").width() - 20,
                caption: "Danh sáchthu phí",
                colModel: [
                    { label: 'ZYH', name: 'ZYH', hidden: true, key: true },
                    { label: 'XSEBH', name: 'XSEBH', hidden: true, key: true },
                    { label: 'SFXM', name: 'SFXM', hidden: true, key: true },
                    { label: 'IS_SFXM', name: 'IS_SFXM', hidden: true, key: true },

                    {
                        label: 'nộp hồ sơNgày', name: 'CreateTime', width: 150, align: 'left'
                    },
                    { label: 'Tên mục', name: 'SFXMMC', width: 300, align: 'left' },
                    { label: 'Đơn vị', name: 'JFDW', width: 100, align: 'left' },
                    { label: 'Số lượng', name: 'SL', width: 100, align: 'left' },
                    { label: 'Đơn giá', name: 'DJ', width: 100, align: 'left' }

                ]
            }, mydata);
            if (mydata.length > 0) {
                $('.ui-jqgrid-bdiv').find(".unwritten").remove();
            }
        }
        function newtouch_event_f4() {
            $('#refundGridList').jqGrid("clearGridData");   //Xóa tất cả các dòng
            $('#gridListDetail').jqGrid("clearGridData");
        }


        //Nạp mụcthu phí,Bác sĩdướihộp chọncủagiá trị
        function initControl() {
            ///Mụcthu phí
            $("#sfxm").sfxmFloatingSelector({
                djDecimalPlaces: 4,
                ajaxparameters: function ($thisinput) {
                    return "dllb=1,2&mzzybz=1&keyword=" + $.trim($thisinput.val());
                },
                itemdbclickhandler: function ($thistr) {
                    $("#sfxm").val($thistr.attr("data-sfxmmc"));
                }
            });

            ///Khoa
            $("#zxks").newtouchBatchFloatingSelector({
                height: 170,
                width: 250,
                clickautotrigger: true,
                filter: function (keyword) {
                    //Duyệt nguồn dữ liệu,dùngkeywordđếnLọcraKết quả
                    var resultObjArr = new Array();
                    $.each(top.window.clients.sysDepartList, function (idx, val) {
                        if ((val.py && val.py.indexOf(keyword.toLowerCase()) >= 0)
                            || (val.Name && val.Name.indexOf(keyword) >= 0)
                            || keyword.trim() == "") {
                            resultObjArr.push(val);
                        }
                    });
                    return resultObjArr;
                },
                caption: "Khoa",
                colModel: [
                    { label: 'Số hiệu', name: 'Code', widthratio: 50 },
                    { label: 'Tên', name: 'Name', widthratio: 20 },
                    { label: 'Pinyin', name: 'py', hidden: true }
                ],
                itemdbclickhandler: function ($thistr) {
                    $("#zxks").attr("data-label", $thistr.find("td:eq(0)").html());
                    $("#zxks").val($thistr.find('td:eq(1)').html());
                    return;
                },
            });
        }
</script>

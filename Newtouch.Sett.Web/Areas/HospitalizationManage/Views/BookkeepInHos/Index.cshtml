    function newtouch_event_f9() {
        clearJZInfo();

        editingNewid = null;    //Đang sửa đổicủaDòng

        $("#gridList").resetSelection();

        bottomButtonsReset();

        //setTimeout("$('#sfxmmc').trigger('focus');$('#sfxmmc').trigger('click');", 100);
    }

</script>
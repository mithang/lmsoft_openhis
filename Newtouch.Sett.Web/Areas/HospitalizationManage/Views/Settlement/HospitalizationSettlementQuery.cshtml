                top.frames[iframeId].checkFPH();//Hàm gọi lại khi nhấn xác nhận tại cửa sổ
            }
        });

    }

    var tempJSNM;
    //In bổ sung，Đã chọn số hóa đơn mới
    function chooseFPHSuccessCallback(fph) {
        //cập nhậtquyết toánBản ghicủaSố hóa đơnlàmớiSố hóa đơn
        $.najax({
            type: "POST",
            url: "/HospitalizationManage/Settlement/UpdateSettInvoiceNo",
            data: { jsnm: tempJSNM, fph: fph-1 },
            dataType: "json",
            success: function (data) {
                //In
                printFp(zyhs,tempJSNM,"N");
            }
        });
    }

    function printybjsd(setlId) {
    $.loading(true, 'Đang truy vấn chứng từquyết toán BHYT nhập viện，Vui lòng đợi...');

    var inputp0001 = { "mzzy_lx": "2", "setlId": setlId, "operatorId": '@curOpr.UserCode', "operatorName": '@curOpr.UserName'  };
   //  var inputp0001 = { "mzzy_lx": "2", "setlId": setlId, "operatorId": "000000", "operatorName": "admin" };
    $.ajax({
        type: "POST",
        url: "http://127.0.0.1:33333/api/YiBao/Print_P0001",
        dataType: "json",
        data: inputp0001,
        async: false,
        success: function (data) {
            if (data.code == "0") $.loading(false);
            else {
                $.loading(false);
                isuccer = false;
                $.modalAlert('mởPhiếuquyết toán BHYTThất bại[' + data.mes + ']', 'error');
                return;
            }
        },
        error: function (request, error, ex) {
            $.loading(false);
            isuccer = false;
            $.modalAlert('Gọi giao diện BHYTP0001Thất bại！Vui lòng kiểm tra chương trình giao diện BHYT đã chạy chưa。[' + ex + ']', 'error');
            return;
        }
    });
}
</script>

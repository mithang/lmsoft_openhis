    //Lập hóa đơn
    function openInvoice(zyh, jsnm) {
        var requestJson = { "BusinessName": "Lập hóa đơn", "paySerialNo": zyh, "paySettlementNo": jsnm, "type": "nhập viện", "PlaceCode": "003" };//Điểm lập hóa đơn tạm ghi cố định003
        $.ajax({
            type: "POST",
            url: "http://127.0.0.1:33333/api/YiBao/InvoicePost",
            dataType: "json",
            data: requestJson,
            async: false,
            success: function (data) {
                if (data.code == "0") {
                    $.loading(true, 'Đang lập hóa đơn điện tử，Vui lòng đợi...');
                    setTimeout(function () {
                        window.open(data.data.pictureUrl,
                            "_blank",
                            "height=1000, width=1195,top=100, left=50, toolbar =no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no");
                        $.loading(false);
                    }, 3000);
                }
                else {
                    $.loading(false);
                    isuccer = false;
                    $.modalAlert('Lập chứng từ thất bại[' + data.mes + ']', 'error');
                    return;
                }
            },
            error: function (request, error, ex) {
                $.loading(false);
                isuccer = false;
                $.modalAlert('Lập chứng từ bất thường[' + ex + ']', 'error');
                return;
            }
        });
    }
    //In phiếu
    function printReceipt(zyh, jsnm) {
        $.loading(true, 'Đang in phiếu hóa đơn điện tử，Vui lòng đợi...');
        var requestJson = { "BusinessName": "In phiếu", "paySerialNo": zyh, "paySettlementNo": jsnm, "type": "nhập viện", "PlaceCode": "003" };//Điểm lập hóa đơn tạm ghi cố định003
        $.ajax({
            type: "POST",
            url: "http://127.0.0.1:33333/api/YiBao/InvoicePost",
            dataType: "json",
            data: requestJson,
            async: false,
            success: function (data) {
                if (data.code == "0") $.loading(false);
                else {
                    $.loading(false);
                    isuccer = false;
                    $.modalAlert('In phiếu chứng từThất bại[' + data.mes + ']', 'error');
                    return;
                }
            },
            error: function (request, error, ex) {
                $.loading(false);
                isuccer = false;
                $.modalAlert('In phiếu chứng từThất bại[' + ex + ']', 'error');
                return;
            }
        });
    }

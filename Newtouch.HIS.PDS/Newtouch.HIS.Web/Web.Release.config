<?xml version="1.0" encoding="utf-8"?>

<!-- có đóng khiến dùng web.config thông tin chi tiết về chuyển đổi, vui lòng truy cập http://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    trong ví dụ dưới đây, "SetAttributes"chuyển đổi sẽ thay đổi 
    "connectionString"của giá trị, chỉ khi"Match"bộ định vị 
    tìm thấy giá trị"MyDB"của thuộc tính"name"giờ khiến dùng"ReleaseSQLServer".
    
    <connectionStrings>
      <add name="MyDB" 
        connectionString="Data Source=ReleaseSQLServer;Initial Catalog=MyReleaseDB;Integrated Security=True" 
        xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
    </connectionStrings>
  -->
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <!--
      
      trong ví dụ dưới đây, "Replace"chuyển đổi sẽ thay thế 
      web.config toàn bộ tệp <customErrors> phần.
      vui lòng chú ý, do 
      tại <system.web> dưới nút chỉ có một customErrors phần, do đó không cần sử dụng"xdt:Locator"thuộc tính.
      
      <customErrors defaultRedirect="GenericError.htm"
        mode="RemoteOnly" xdt:Transform="Replace">
        <error statusCode="500" redirect="InternalError.htm"/>
      </customErrors>
    -->
  </system.web>
</configuration>
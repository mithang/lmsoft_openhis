<?xml version="1.0" encoding="utf-8"?>
<appSettings>
	<!-- ================== 1: cấu hình liên quan đến hệ thống phát triển ================== -->
	<!-- thời gian duy trì trạng thái đăng nhập (đơn vị: phần)-->
	<add key="LoginStatusKeepMinute" value="120" />
	<!--kích hoạt IP lọc -->
	<add key="IsIPFilter" value="false" />
	<!-- trang domain (lồng trang miền khác, và thực thi js cần đặt thành cùng một miền)-->
	<add key="Document_Domain" value="localhost"/>

	<!-- khi đăng nhập có hiển thị mã xác minh không -->
	<add key="Is_CheckChkCode" value="false"/>
	<!-- ================== 2: cấu hình tham số phần mềm hệ thống ================== -->
	<!-- liên hệ chúng tôi -->
	<add key="Contact" value="www.newtouch.cn" />
	<!-- phiên bản phần mềm -->
	<add key="Version" value="1.0" />

	<!-- Reids bộ nhớ đệm của key tiền tố Cache Basic -->
	<add key="Reids_Cache_Prefix" value="$C_PDS$"/>

	<!-- tổ chức cấp cao nhất Id -->
	<add key="Top_OrganizeId" value="d8ee85f8-d8d1-4b5c-bd9e-1761f44242d8"/>
	<!-- ứng dụng Id -->
	<add key="AppId" value="PDS"/>

	<!--kích hoạt người dùng liên kết bộ phận nhà thuốc (bộ phận nhà thuốc mà người dùng cần thao tác sau khi đăng nhập) -->
	<add key="Is_UserYfbmRelated" value="true" />

	<!-- trang tĩnh của Host mạng công cộng ip-->
  	<add key="SiteStaticHost" value="http://127.0.0.1:8011/"/>

	<!-- hệ thống quyết toán API của Host -->
	<add key="SiteSettAPIHost" value="http://localhost:7002/"/>
	<!-- hệ thống phối hợp y tế API của Host -->
	<add key="SiteCisAPIHost" value="http://localhost:7003/"/>

	<!-- Base hệ thống API của Host -->
	<add key="SiteBaseAPIHost" value="http://localhost:7001/"/>

	<!-- dịch vụ nhật ký của Url trường đã bỏ-->
	<add key="His.Log.URL" value="http://61.172.179.30:17008/"/>


	<add key="vs:EnableBrowserLink" value="false"/>

	<!-- lấy pyCfBeforDaysAgo ngày trước bắt đầu đơn thuốc xếp thuốc -->
	<add key="pyCfBeforDaysAgo" value="-7"/>

	<!-- thống kê biểu đồ tròn trang chủ dlCode -->
	<add key="sybttjdl" value="08,09,10"/>

	<!-- dịch vụ báo cáo cũ,trường đã bỏ -->
	<add key="ReportServer.HOST" value="http://61.172.179.30:17037/"/>

	<!-- lấy ngày thực hiện điều chỉnh giá tại tjypDaysAgo trong ngày của thuốc điều chỉnh giá -->
	<add key="tjypDaysAgo" value="-31"/>
	<!--  ActiveReports địa chỉ dịch vụ-->
	<add key="ReportUrl" value="http://localhost:8013/"/>
	<add key="ReportSystemCode"  value="PDS"/>

	<add key="OrganizeCodeSd" value="77370296000"/>
	<add key="HospitalName" value="his测试医院"/>
	<!--hệ thống dược thành phố người dùng đã đăng ký của tên người dùng-->
	<add key="PurchaseUser" value="mdwg001"/>
	<!--hệ thống dược thành phố người dùng đã đăng ký của mật khẩu đăng nhập-->
	<add key="PurchasePwd" value="zs9g6fr25tqd"/>

	<!-- AlipayConstants cấu hình end -->
	<add key="Token_ApiManage" value="API.Manage"/>
	<!--trung tâm chứng thực API mạng công cộng ip-->
	<add key="SiteTokenAPIHost" value="http://127.0.0.1:8015/"/>
	<!--thống nhất API mạng công cộng ip-->
	<add key="SiteConmonAPIHost" value="http://127.0.0.1:8016/"/>
	<!--trường đã bỏ-->
	<add key="OuterMediaMeettingAPIHost" value="https://127.0.0.1:17015/"/>
</appSettings>
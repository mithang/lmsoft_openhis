<?xml version="1.0" encoding="utf-8"?>
<appSettings>
  <!-- ================== 1: cấu hình liên quan đến hệ thống phát triển ================== -->
  <!-- thời gian duy trì trạng thái đăng nhập (đơn vị: phần)-->
  <add key="LoginStatusKeepMinute" value="120" />
  <!--kích hoạt IP lọc -->
  <add key="IsIPFilter" value="false" />
  <!-- trang domain (lồng trang miền khác, và thực thi js cần đặt thành cùng một miền)-->

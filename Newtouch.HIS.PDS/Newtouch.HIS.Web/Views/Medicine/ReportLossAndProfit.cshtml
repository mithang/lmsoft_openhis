@using Newtouch.Infrastructure;
@using Newtouch.Common.Operator;
@{
	ViewBag.Title = "ReportLossAndProfit";
	Layout = "~/Views/Shared/_Index.cshtml";
}
<input hidden id="OrganizeId" value="@OperatorProvider.GetCurrent().OrganizeId">
<form id="form1">
	<div class="panel panel-default" style="margin-top:10px;">
		<div class="panel-heading">
			thông tin lãi/lỗ
		</div>
		<div style="padding: 2px;padding-right:20px;">
			<table class="form">
				<tr>
					<th class="formTitle">số chứng từ: </th>
					<td class="formValue">
						<input type="text" id="txtSYDH" class="form-control newtouch_Readonly" />
					</td>
					<th class="formTitle">tình hình lãi/lỗ: </th>
					<td style="padding-left:12px;">
						<div class="btn-group" id="btnLossAndProfitTypeGourp" style="margin-top:0;">
							<button type="button" id="btnLoss" data-keywordtype="Loss" class="btn active btn-restore">báo hỏng</button>
							<button type="button" id="btnProfit" data-keywordtype="Profit" class="btn btn-default">báo thừa</button>
						</div>
					</td>
					<th class="formTitle">lãi/lỗ tổng mức(đồng): </th>
					<td class="formValue">
						<input type="text" id="txtSYZE" class="form-control newtouch_Readonly" />
					</td>
					<th></th>
					<td></td>
				</tr>
			</table>
		</div>
		<div class="panel-heading">
			thông tin thuốc
		</div>
		<div id="divYPXX" style="padding: 2px;padding-right:20px;">
			<table class="form">
				<tr>
					<th class="formTitle"><span class="required">*</span>mã thuốc: </th>
					<td class="formValue">
						<input id="editRowId" value="" style="display:none;" />
						<input type="text" id="txtYPCODE" class="form-control" />
					</td>
					<th class="formTitle">tên thuốc: </th>
					<td class="formValue">
						<input type="text" id="txtYPMC" class="form-control newtouch_Readonly" />
					</td>
					<th class="formTitle">số lô: </th>
					<td class="formValue">
						<input type="text" id="txtPH" class="form-control newtouch_Readonly" />
					</td>
					<th class="formTitle">lô: </th>
					<td class="formValue">
						<input type="text" id="txtPC" class="form-control newtouch_Readonly" />
					</td>
				</tr>
				<tr>
					<th class="formTitle">hạn sử dụng: </th>
					<td class="formValue">
						<input id="txtYXQ" type="text" class="form-control input-wdatepicker newtouch_Readonly" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
					</td>
					<th class="formTitle">quy cách: </th>
					<td class="formValue">
						<input type="text" id="txtYPGG" class="form-control newtouch_Readonly" />
					</td>
					<th class="formTitle" id="thXYKCDW">tồn kho hiện có: </th>
					<td class="formValue">
						<input type="text" id="txtXYKC" class="form-control newtouch_Readonly" />
						<input id="hidden_kcsl" type="text" hidden="hidden" />
					</td>
					<th class="formTitle">nhà sản xuất: </th>
					<td class="formValue">
						<input type="text" id="txtSCCJ" class="form-control newtouch_Readonly" />
					</td>
				</tr>
				<tr>
					<th class="formTitle" id="thPFJDW">giá bán buôn: </th>
					<td class="formValue">
						<input type="text" id="txtPFJ" class="form-control newtouch_Readonly" />
					</td>
					<th class="formTitle" id="thPFZEDW">tổng tiền bán buôn(đồng): </th>
					<td class="formValue">
						<input type="text" id="txtPFZE" class="form-control newtouch_Readonly" />
					</td>
					<th class="formTitle" id="thLSJDW">giá bán lẻ: </th>
					<td class="formValue">
						<input type="text" id="txtLSJ" class="form-control newtouch_Readonly" />
					</td>
					<th class="formTitle" id="thLSZEDW">tổng tiền bán lẻ(đồng): </th>
					<td class="formValue">
						<input type="text" id="txtLSZE" class="form-control newtouch_Readonly" />
					</td>
				</tr>
			</table>
		</div>
		<div class="panel-heading">
			đơn cái thông tin lãi/lỗ
		</div>
		<div id="divDGSYXX" style="padding: 2px;padding-right:20px;">
			<table class="form">
				<tr>
					<th class="formTitle" id="thSYSLDW" style="width: 80px;"><span class="required">*</span>số lượng lãi/lỗ: </th>
					<td class="formValue">
						<div class="row">
							<div hidden id="div_sy" class="col-md-4">
								<input id="txtBMSL" type="text" class="form-control" onkeyup="SYSL_change(this)" />
							</div>
							<div hidden id="div_dw" class="col-md-2" style="padding: 3px 1px;">
								<span id="bmdw"></span>
							</div>
							<div class="col-md-4">
								<input id="txtZXSL" type="text" class="form-control" onkeyup="SYSL_change(this)" />
							</div>
							<div class="col-md-2" style="padding: 3px 1px;">
								<span id="zxdw"></span>
							</div>
						</div>
					</td>
					<th class="formTitle">lãi/lỗ nguyên nhân: </th>
					<td class="formValue">
						<select id="ddlSYYY" class="form-control"></select>
					</td>
					<th class="formTitle" style="width: 60px;">ghi chú: </th>
					<td class="formValue">
						<input type="text" id="txtRemark" class="form-control" />
					</td>
					<th class="formTitle"><span class="required">*</span>người chịu trách nhiệm công số: </th>
					<td class="formValue">
						<input type="text" id="txtZRRGH" class="form-control" />
						<input type="text" id="txtZRRMC" hidden />
					</td>
				</tr>
			</table>
		</div>
	</div>
</form>
@Html.Partial("_MiddleButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
	ShowKeyList = new int[] { 3, 6 },
	F3Text = "thêm",
	F6Text = "xóa",
})
<div style="background-color: #fff;width:99%;">
	<table id="gridSYXX"></table>
</div>
@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
	ShowKeyList = new int[] { 7, 8 },
	F7Text = "lãi/lỗ mới",
	F8Text = "gửi"
})
<script>
    window.newtouch_globalconfig.f4opions = {
        container: "#divYPXX"
    };
    var Sysl = 0;

    $(function () {
        gridSYXX();//thông tin lãi/lỗ
        initialSYDH();//tải lãi/lỗ số phiếu
        initialSYYY();//tải nguyên nhân lãi/lỗ
    });

    $('#btnLossAndProfitTypeGourp').on('click', '.btn', function () {
        if (!$(this).hasClass('active')) {
            $(this).siblings('.btn').removeClass('btn-restore').removeClass('active').addClass('btn-default');
            $(this).removeClass('btn-default').addClass('btn-restore active');
        }
        initialSYYY();
    });

    //tải lãi/lỗ số phiếu
    function initialSYDH() {
        $.najax({
            url: "/Medicine/initialSYDH?r=" + Math.random(),
            dataType: "text",
            async: false,
            success: function (data) {
                $("#txtSYDH").val(data);
            }
        });
    }

    //tải nguyên nhân lãi/lỗ
    function initialSYYY() {
        $("#ddlSYYY").empty();
        var sylx = "";
        if ($('#btnLossAndProfitTypeGourp .btn.active').attr('data-keywordtype') === 'Loss') {
            sylx = "0";//0 báo hỏng, 1 báo thừa
        } else {
            sylx = "1";
        }
        $("#ddlSYYY").bindSelect({
            url: "/Medicine/GetLossProfitReasonListByType?sylx=" + sylx + "&&r=" + Math.random(),
            id: "syyyId",
            text: "syyy"
        });
    }

    //người chịu trách nhiệm
    $("#txtZRRGH").newtouchBatchFloatingSelector({
        clickautotrigger: true,
        height: 200,
        width: 300,
        id: 'initialZRR',
        url: '/Medicine/GetZRRList',
        ajaxmethod: 'Get',
        ajaxreqdata: function () {
            var reqData = {};
            reqData.keyword = $("#txtZRRGH").val();
            return reqData;
        },
        caption: "người chịu trách nhiệm",
        colModel: [
            { label: 'công số', name: 'gh', widthratio: 25 },
            { label: 'tên', name: 'Name', widthratio: 25 },
            { label: 'phiên âm', name: 'py', widthratio: 25 }
        ],
        itemdbclickhandler: function ($thistr) {
            $("#txtZRRGH").val($thistr.attr('data-gh'));
            $("#txtZRRMC").val($thistr.attr('data-name'));
            return;
        }
    });

    //mã thuốc
    $("#txtYPCODE").newtouchBatchFloatingSelector({
        clickautotrigger: true,
        height: 200,
        width: 1130,
        id: 'initialYPCODE',
        url: '/Medicine/SelectLossAndProfitMedicineList',
        ajaxmethod: 'Get',
        ajaxreqdata: function () {
            var reqData = {};
            reqData.inputCode = $("#txtYPCODE").val();
            return reqData;
        },
        caption: "thông tin thuốc",
        colModel: [
            { label: 'loại', name: 'yplb', width: 50 },
            { label: 'tên', name: 'ypmc', width: 200, align: 'left' },
            { label: 'tồn kho', name: 'xykcstr', width: 70, align: 'right' },
            { label: 'quy cách', name: 'ypgg', width: 150, align: 'center' },
            { label: 'hạn sử dụng', name: 'yxq', width: 80 },
            { label: 'số lô', name: 'ph', width: 110, align: 'center' },
            { label: 'lô', name: 'pc', width: 140, align: 'center' },
            { label: 'nhà sản xuất', name: 'sccj', width: 220, align: 'center' },
            { label: 'trạng thái', name: 'ypzt', width: 50 },
            { label: 'giá nhập', name: 'jj', hidden: true },
            { label: 'giá bán lẻ', name: 'lsj', hidden: true },
            { label: 'giá bán buôn', name: 'pfj', hidden: true },
            { label: 'giá bán lẻ kho thuốc', name: 'Yklsj', hidden: true },
            { label: 'giá bán buôn kho thuốc', name: 'Ykpfj', hidden: true },
            { label: 'mã', name: 'ypCode', hidden: true },
            { label: 'hệ số chuyển đổi', name: 'zhyz', hidden: true },
            { label: 'kcsl', name: 'kcsl', hidden: true },
            { label: 'zxdw', name: 'zxdw', hidden: true },
            { label: 'đơn vị', name: 'djdw', hidden: true }
        ],
        itemdbclickhandler: function ($thistr) {
            var djdw = $thistr.attr('data-djdw');
            var zxdw = $thistr.attr('data-zxdw');
            $("#txtYPCODE").attr('data-djdw', djdw).attr('data-zhyz', $thistr.attr('data-zhyz')).val($thistr.attr('data-ypCode'));
            $("#txtYPCODE").attr('data-jj', $thistr.attr('data-jj'));
            $("#txtYPMC").val($thistr.attr('data-ypmc'));
            $("#txtYPGG").val($thistr.attr('data-ypgg'));
            $("#txtPH").val($thistr.attr('data-ph'));
            $("#txtPC").val($thistr.attr('data-pc'));
            $("#txtYXQ").val($thistr.attr('data-yxq'));
            $("#txtSCCJ").val($thistr.attr('data-sccj'));
            $("#txtXYKC").attr('data-kcsl', $thistr.attr('data-kcsl')).val($thistr.attr('data-xykcstr'));
            $("#hidden_kcsl").val($thistr.attr('data-kcsl'));
            $("#thXYKCDW").text('tồn kho hiện có: ');
            $("#txtPFJ").val(parseFloat($thistr.attr('data-pfj')).toFixed(4)).attr("data-Ykpfj", $thistr.attr('data-Ykpfj'));
            $("#thPFJDW").text('giá bán buôn(đồng/' + zxdw + ')：');
            $("#txtLSJ").val(parseFloat($thistr.attr('data-lsj')).toFixed(4)).attr("data-Yklsj", $thistr.attr('data-Yklsj'));;
            $("#thLSJDW").text('giá bán lẻ(đồng/' + zxdw + ')：');
            $("#thSYSLDW").text('số lượng lãi/lỗ: ');
            $("#txtBMSL").val('');
            $("#txtZXSL").val('');
            if (djdw === zxdw) {
                $("#zxdw").html(zxdw);
                $("#div_sy").hide();
                $("#div_dw").hide();
            } else {
                $("#bmdw").html(djdw);
                $("#zxdw").html(zxdw);
                $("#div_sy").show();
                $("#div_dw").show();
            }
            return;
        }
    });

    //thông tin lãi/lỗ
    function gridSYXX() {
        var $gridSyxx = $("#gridSYXX");
        $gridSyxx.dataGrid({
            unwritten: false,
            height: $(window).height() - document.getElementById('gridSYXX').offsetTop - 85,
            colModel: [
                { label: 'tình hình lãi/lỗ', name: 'syqk', width: 70, align: 'left' },
                { label: 'mã thuốc', name: 'ypdm', width: 70, align: 'left' },
                { label: 'tên thuốc', name: 'ypmc', width: 100, align: 'left' },
                { label: 'quy cách', name: 'ypgg', width: 100, align: 'left' },
                { label: 'số lượng lãi/lỗ', name: 'sl', width: 100, align: 'left' },
                { label: 'đơn vị', name: 'dw', width: 100, align: 'left' },
                { label: 'tồn kho hiện có', name: 'xykc', width: 100, align: 'left' },
                { label: 'số lô', name: 'ph', width: 100, align: 'left' },
                { label: 'lô', name: 'pc', width: 100, align: 'left' },
                { label: 'hệ số chuyển đổi', name: 'zhyz', width: 100, align: 'left' },
                { label: 'hạn sử dụng', name: 'yxq', width: 100, align: 'left' },
                { label: 'nhà sản xuất', name: 'sccj', width: 100, align: 'left' },
                { label: 'giá bán buôn', name: 'pfj', width: 100, align: 'left' },
                { label: 'giá bán lẻ', name: 'lsj', width: 100, align: 'left' },
                { label: 'nguyên nhân lãi/lỗ', name: 'syyymc', width: 100, align: 'left' },
                { label: 'ghi chú', name: 'remark', width: 100, align: 'left' },
                { label: 'người chịu trách nhiệm', name: 'zrr', width: 100, align: 'left' },
                { label: 'số chứng từ', name: 'djh', width: 100, align: 'left' },
                { label: 'Jj', name: 'Jj', hidden: true },
                { label: 'Yklsj', name: 'Yklsj', hidden: true },
                { label: 'Ykpfj', name: 'Ykpfj', hidden: true },
                { label: 'nguyên nhân lãi/lỗ', name: 'syyy', hidden: true },
                { label: 'số lượng tồn kho', name: 'kcsl', hidden: true },
                { label: 'số lượng lãi/lỗ', name: 'sysl', hidden: true },
                { label: 'giá bán buôn đơn vị', name: 'pfjdw', hidden: true },
                { label: 'giá bán lẻ đơn vị', name: 'lsjdw', hidden: true },
                { label: 'lsze', name: 'lsze', hidden: true },
                { label: 'người chịu trách nhiệm', name: 'zrrmc', hidden: true },
                { label: 'pfze', name: 'pfze', hidden: true }

            ],
            ondblClickRow: function (rowid) {
                //if (rowid) {
                //    var getRowData = $("#gridSYXX").jqGrid('getRowData', rowid);
                //    if (getRowData) {
                //        if (getRowData.syqk === "báo hỏng") {  //báo hỏng
                //            if (!$("#btnLoss").hasClass('active')) {
                //                $("#btnProfit").removeClass('btn-restore').removeClass('active');
                //                $("#btnLoss").addClass('btn-restore active');
                //            }
                //        } else {   //báo thừa
                //            if (!$("#btnProfit").hasClass('active')) {
                //                $("#btnLoss").removeClass('btn-restore').removeClass('active');
                //                $("#btnProfit").addClass('btn-restore active');
                //            }
                //        }
                //        $("#txtYPCODE").attr("data-zhyz", getRowData.zhyz).val(getRowData.ypdm);
                //        $("#txtYPMC").val(getRowData.ypmc);
                //        $("#txtYPGG").val(getRowData.ypgg);
                //        $("#txtPH").val(getRowData.ph);
                //        $("#txtPC").val(getRowData.pc);
                //        $("#txtYXQ").val(getRowData.yxq);
                //        $("#txtSCCJ").val(getRowData.sccj);
                //        $("#txtXYKC").val(getRowData.xykc);
                //        $("#thXYKCDW").val(getRowData.xykcdw);
                //        $("#txtLSJ").val(getRowData.lsj);
                //        $("#thLSJDW").val(getRowData.lsjdw);
                //        $("#txtPFJ").val(getRowData.pfj);
                //        $("#thPFJDW").val(getRowData.pfjdw);
                //        $("#thSYSLDW").val(getRowData.sysldw);
                //        $("#txtLSZE").val(getRowData.lsze);
                //        $("#txtPFZE").val(getRowData.pfze);
                //        $("#hidden_kcsl").val(getRowData.kcsl);
                //        $('#editRowId').val(rowid);
                //        $('#txtRemark').val(getRowData.remark);
                //        $("#ddlSYYY").val(getRowData.syyy);
                //    }
                //}
            }
        });
    }

    //xác định button
    function newtouch_event_f3() {
        //kiểm tra chi tiết
        if (!CheckDetailData()) {
            return false;
        }
        var syqkstr = "";
        var sysl = Sysl;//cuối cùng lưu đến lãi/lỗ bảng

        //đánh giá báo hỏng báo thừa
        if ($('#btnLossAndProfitTypeGourp .btn.active').attr('data-keywordtype') === 'Loss') {
            syqkstr = "báo hỏng",
                sysl = sysl * (-1);
        } else {
            syqkstr = "báo thừa";
        }

        var data = [{
            syqk: syqkstr,
            ypdm: $("#txtYPCODE").val(),
            ypmc: $("#txtYPMC").val(),
            ypgg: $("#txtYPGG").val(),
            sccj: $("#txtSCCJ").val(),
            ph: $("#txtPH").val(),
            pc: $("#txtPC").val(),
            yxq: $("#txtYXQ").val(),
            sysl: sysl,//cuối cùng lưu đến lãi/lỗ bảng
            sl: Sysl,//trang trên hiển thị số lượng lãi/lỗ
            dw: $("#zxdw").text(),
            xykc: $("#txtXYKC").val(),
            pfj: $("#txtPFJ").val(),
            Ykpfj: parseFloat($("#txtPFJ").attr("data-Ykpfj")),
            pfjdw: $("#thPFJDW").val(),
            pfze: $("#txtPFZE").val(),
            lsj: $("#txtLSJ").val(),
            Yklsj: parseFloat($("#txtLSJ").attr("data-Yklsj")),
            lsjdw: $("#thLSJDW").val(),
            lsze: $("#txtLSZE").val(),
            Jj: parseFloat($("#txtYPCODE").attr("data-jj")),
            syyymc: $("#ddlSYYY").find("option:selected").text(),
            syyy: $("#ddlSYYY").val(),
            zhyz: $("#txtYPCODE").attr("data-zhyz"),
            zrrmc: $("#txtZRRMC").val(),
            zrr: $("#txtZRRGH").val(),
            djh: $("#txtSYDH").val(),
            kcsl: $("#hidden_kcsl").val(),
            remark: $("#txtRemark").val()
        }];

        if ($('#editRowId').val()) {            //là sửa đổi
            $('#gridSYXX').jqGrid("delRowData", $('#editRowId').val()); //trước tiên remove xóa dòng đó
        }

        //kiểm tra mục trùng lặp
        var isRepeatedAdd = false;
        $.each($("#gridSYXX").getDataIDs(), function () {
            var rowData = $("#gridSYXX").jqGrid('getRowData', this);
            if (rowData.ypdm === data[0].ypdm && rowData.ph === data[0].ph && rowData.pc === data[0].pc) {
                isRepeatedAdd = true;
            }
        });

        if (isRepeatedAdd) {
            $.modalAlert("không được thêm trùng lặp", 'warning');
            return false;
        }

        $("#gridSYXX").newtouchLocalDataGrid(null, data);
        //tính lãi/lỗ tổng mức
        ComputeRKZE();
        $("#btnLoss").attr("disabled", "disabled").css("background-color", "rgb(238, 238, 238)");
        $("#btnProfit").attr("disabled", "disabled").css("background-color", "rgb(238, 238, 238)");
        ClearYPXX();
    }

    //xóa
    function newtouch_event_f6() {
        var delRowid = $("#gridSYXX").jqGrid('getGridParam', 'selrow');
        if (!delRowid) {
            $.modalAlert("chưa chọn dòng", 'warning');
            return;
        }
        $('#gridSYXX').jqGrid('delRowData', delRowid);
    }

    //lưu
    function newtouch_event_f8() {
        var syxx = $("#gridSYXX").jqGrid('getRowData_AllLine');
        if (syxx == null || syxx.length <= 0) {
            $.modalAlert("vui lòng trước tiên thêm báo hỏng báo thừa thông tin", 'warning');
            return;
        }
        $.najax({
            url: "/Medicine/SubmitReportLossAndProfit",
            type: "POST",
            data: { syxx: syxx },
            dataType: "json",
            success: function (data) {
                $.modalMsg("lưu thành công", 'success', 1000);
                newtouch_event_f7();//lãi/lỗ mới: mới số chứng từ chính dữ liệu xóa sạch chi tiết xóa sạch
                $('#gridSYXX').jqGrid("clearGridData");//xóa sạch Grid
				$("#txtSYZE").val("");//xóa sạch lãi/lỗ tổng mức
				window.open("/Report/PrintReport?type=báo hỏng báo thừa in bảng&param=syIds=" + data.message +"|OrganizeId=" + $("#OrganizeId").val(),"height=500, width=1195, top=100, left=50, toolbar=no, menubar=no, scrollbar=yes, resizeble=no, location=no, status=no");
            }
        });
    }

    //mới lãi/lỗ
    function newtouch_event_f7() {
        initialSYDH();//đổi số phiếu
        $("#btnLoss").removeAttr("disabled").removeAttr("style");
        $("#btnProfit").removeAttr("disabled").removeAttr("style");
    }

    //số lượng lãi/lỗ keyup sự kiện
    function SYSL_change(obj) {
        if ($("#txtYPCODE").val() === "") {
            return false;
        }
        obj.value = obj.value.replace(/\D/g, '');
        var bmsl = $.trim($("#txtBMSL").val());
        var zxsl = $.trim($("#txtZXSL").val());
        if (bmsl === "" && zxsl === "") {
            return false;
        }
        bmsl = bmsl === '' ? 0 : bmsl;
        zxsl = zxsl === '' ? 0 : zxsl;
        if ($("#div_sy").is(":hidden")) {   //đơn giá đơn vị(bộ phận hiện tại của đơn vị) sl/zhyz
            Sysl = parseFloat(zxsl);
        } else {
            Sysl = parseFloat(bmsl) * parseFloat($("#txtYPCODE").attr('data-zhyz')) + parseFloat(zxsl);
        }
        var pfj = parseFloat($("#txtPFJ").val());
        var lsj = parseFloat($("#txtLSJ").val());

        $("#txtPFZE").val((pfj * Sysl).toFixed(4));
        $("#txtLSZE").val((lsj * Sysl).toFixed(4));
    }

    //tính lãi/lỗ tổng mức
    function ComputeRKZE() {
        var syze = 0;
        var count = $("#gridSYXX").getGridParam('records');
        if (count > 0) {
            var rowIDS = $("#gridSYXX").getDataIDs();
            for (var i = 0; i < rowIDS.length; i++) {
                var getRow_lsze = $("#gridSYXX").getRowData(rowIDS[i]).lsze;
                syze = parseFloat(syze) + parseFloat(getRow_lsze);
            }
            //lãi/lỗ số tiền
            $("#txtSYZE").val(syze.toFixed(4));
        } else {
            $("#txtSYZE").val('');
        }
    }

    //xóa thông tin thuốc
    function ClearYPXX() {
        //xóa sạch
        newtouch_globalevent_f4();
        $("#ddlSKDW").empty();
        $("#txtSYSL").val("");
        $("#txtZXSL").val("");
        $("#txtBMSL").val("");
        $("#txtYXQ").val($.getDate());
    }

    //kiểm tra chi tiết
    function CheckDetailData() {
        if ($("#txtYPCODE").val() == "") {
            $.modalAlert("mã thuốc là trống", 'warning');
            return false;
        }
        if ($("#txtYPMC").val() == "") {
            $.modalAlert("tên thuốc là trống", 'warning');
            return false;
        }
        if ($("#txtPC").val() === "") {
            $.modalAlert("lô là trống", 'warning');
            return false;
        }
        if ($("#txtBMSL").val() == "" && $("#txtZXSL").val() == "") {
            $.modalAlert("số lượng lãi/lỗ trống", 'warning');
            return false;
        }
        if (Sysl <= 0) {
            $.modalAlert("số lượng lãi/lỗ nên lớn hơn 0", 'warning');
            return false;
        }
        if ($('#btnLossAndProfitTypeGourp .btn.active').attr('data-keywordtype') == 'Loss') {
            if (Sysl > parseFloat($("#txtXYKC").attr('data-kcsl'))) {   //ngược lại, trực tiếp so sánh số lượng (số lượng đơn vị nhỏ nhất)
                $.modalAlert("báo hỏng số lượng nên nhỏ hơn tồn kho hiện có", 'warning');
                return false;
            }
        }
        if ($("#ddlSYYY").val() == "") {
            $.modalAlert("lãi/lỗ nguyên nhân trống", 'warning');
            return false;
        }
        if ($("#txtZRRGH").val() == "") {
            $.modalAlert("người chịu trách nhiệm công số là trống", 'warning');
            return false;
        }
        if ($("#txtZRRMC").val() == "") {
            $.modalAlert("người chịu trách nhiệm tên là trống", 'warning');
            return false;
        }
        return true;
    }
</script>

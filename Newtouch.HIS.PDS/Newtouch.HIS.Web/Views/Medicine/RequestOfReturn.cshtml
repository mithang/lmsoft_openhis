@using Newtouch.Infrastructure
@{
    ViewBag.Title = "RequestOfReturn";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    .inline {
        width: 80%;
        display: inline;
    }

    .PriceInline {
        width: 70%;
        display: inline;
    }
</style>
<form id="form1">
    <div class="panel panel-default" style="margin-bottom:10px;">
        <div class="panel-heading">
            trả thuốc thông tin
        </div>
        <table class="form" style="width:98%;border:0">
            <tr>
                <td class="formTitle">số phiếu trả thuốc: </td>
                <td class="formValue"><input type="text" id="tydh" name="tydh" class="form-control newtouch_Readonly" /></td>
                <td class="formTitle"><span class="required">*</span>bộ phận trả thuốc: </td>
                <td class="formValue">
                    <input type="text" id="tybm" name="tybm" class="form-control" placeholder="vui lòng chọn bộ phận trả thuốc" />
                </td>
                <td class="formTitle"><span class="required">*</span>trả thuốc ngày: </td>
                <td class="formValue">
                    <input type="text" id="tyrq" name="tyrq" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                </td>
                <td class="formTitle"><span class="required">*</span>trả thuốc phương thức: </td>
                <td class="formValue">
                    <select class="form-control" id="fyfs" name="fyfs" onchange="ValidateForm()">
                        <option value="">==vui lòng chọn==</option>
                        <option value="1">bình thường xuất kho</option>
                        <option value="2">在途出库</option>
                        <option value="3">制剂出库</option>
                        <option value="4">赠送出库</option>
                        <option value="99">药事退货</option>
                    </select>
                </td>
            </tr>
        </table>
    </div>
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading">
            thông tin thuốc
        </div>
        <table class="form" style="width:98%;border:0;" id="form2">
            <tr>
                <td class="formTitle">mã thuốc: </td>
                <td class="formValue">
                    <input type="hidden" id="newid" name="newid" class="form-control" />
                    <input type="text" id="srm" name="srm" class="form-control newtouch_Readonly" />
                </td>
                <td class="formTitle">lô: </td>
                <td class="formValue">
                    <input type="text" id="pc" name="pc" class="form-control newtouch_Readonly" />
                </td>
                <td class="formTitle">hạn sử dụng: </td>
                <td class="formValue">
                    <input type="text" id="yxq" name="yxq" class="form-control newtouch_Readonly" />
                </td>
                <td class="formTitle">số lượng trả thuốc: </td>
                <td class="formValue">
                    <div class="row">
                        <div class="col-md-8">
                            <input id="tysl" name="tysl" type="text" class="form-control newtouch_Readonly" />
                        </div>
                        <div class="col-md-4">
                            <select id="ty_dw" class="form-control newtouch_Readonly" style="background-color:rgb(238,238,238)"></select>
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td class="formTitle">tên thuốc: </td>
                <td class="formValue"><input type="text" id="ypmc" class="form-control newtouch_Readonly" /></td>
                <td class="formTitle">quy cách: </td>
                <td class="formValue"><input type="text" id="gg" class="form-control newtouch_Readonly" /></td>
                <td class="formTitle">số lượng có thể trả: </td>
                <td class="formValue">
                    <input type="text" id="kykc" class="form-control newtouch_Readonly inline" />
                    <label id="kykc_dw"></label>
                </td>
                <td class="formTitle">nhà sản xuất: </td>
                <td class="formValue"><input type="text" id="sccj" class="form-control newtouch_Readonly" /></td>
            </tr>
            <tr>
                <td class="formTitle">giá bán buôn: </td>
                <td class="formValue">
                    <input type="text" id="pfj" class="form-control newtouch_Readonly PriceInline" />
                    <label id="pf_dw">đồng/lọ</label>
                </td>
                <td class="formTitle">giá bán lẻ: </td>
                <td class="formValue">
                    <input type="text" id="lsj" class="form-control newtouch_Readonly PriceInline" />
                    <label id="ls_dw">đồng/lọ</label>
                </td>
                <td class="formTitle">tiền bán buôn: </td>
                <td class="formValue">
                    <input type="text" id="pfje" class="form-control newtouch_Readonly inline" />
                    <label>đồng</label>
                </td>
                <td class="formTitle">tiền bán lẻ: </td>
                <td class="formValue">
                    <input type="text" id="lsje" class="form-control newtouch_Readonly inline" />
                    <label>đồng</label>
                </td>
            </tr>
        </table>
        <input type="hidden" id="ph" />
        <input type="hidden" id="ypdm" />
        <input type="hidden" id="zxsl" />
        <input type="hidden" id="zhyz" />
        <input type="hidden" id="yplb" />
        <input type="hidden" id="ykdw" />
        <input type="hidden" id="zxdw" />
    </div>
</form>
@Html.Partial("_MiddleButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 2, 3, 6, 9 },
    F2Text = "thêm",
    F3Text = "sửa",
    F6Text = "xóa",
    F9Text = "hủy sửa",
    F9Hidden = true
})
<div class="gridPanel" style="margin-top:10px">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>
@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
    ShowKeyList = new int[] { 7, 8 },
    F7Text = "mới trả thuốc đơn",
    F8Text = "trả thuốc"
})
<script type="text/javascript">
    var dtdw;
    var globalpc;
    var newxmList = [];   //hạng mục mới List
    var editingNewid = null;    //dòng đang sửa
    var dw = "";

    $(function () {
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });
        init();
        fillDataToGrid();
    });
    
    //khởi tạo
    function init() {
        GetDjh();
        bottomButtonsReset();
        $("#ty_dw").change(function () {
            dw = $(this).find("option:selected").text();
        });
        ///khởi tạo mã nhập
        $("#srm").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 350,
            width: 1100,
            url: "/DrugStorage/SelectDepartmentMedicineList",
            ajaxmethod: 'POST',
            ajaxreqdata: function () {
                var reqData = {};
                reqData.rkbm = $("#tybm").val();
                reqData.keyword = $.trim($("#srm").val());
                return reqData;
            },
            caption: "mã nhập",
            colModel: [
            { label: 'loại', name: 'yplb', width: 50 },
            { label: 'mã', name: 'ypCode', width: 100 },
            { label: 'tên', name: 'ypmc', width: 200, align: 'left' },
            { label: 'quy cách', name: 'gg', width: 100, align: 'left' },
            { label: 'tồn kho', name: 'xykcstr', width: 70 },
            { label: 'đơn vị', name: 'ykdw', width: 60 },
            { label: 'nhà sản xuất', name: 'sccj', width: 200, align: 'left' },
            { label: 'số giấy phép', name: 'pzwh', width: 150, align: 'left' },
            { label: 'giá bán lẻ', name: 'lsj', width: 70 },
            { label: 'giá bán buôn', name: 'pfj', width: 70 },
            { label: 'bzs', name: 'bzs', hidden: true },
            { label: 'zxdw', name: 'zxdw', hidden: true },
            { label: 'xykc', name: 'xykc', hidden: true }
            ],
            itemdbclickhandler: function ($thistr) {
                var ykdw = $thistr.attr('data-ykdw');
                $("#ypdm").val($thistr.attr('data-ypCode'));
                $("#ypmc").val($thistr.attr('data-ypmc'));
                $("#srm").val($thistr.attr('data-ypCode'));
                $("#gg").val($thistr.attr('data-gg'));
                $("#sccj").val($thistr.attr('data-sccj'));
                $("#pf_dw").html("đồng/" + ykdw);
                $("#ls_dw").html("đồng/" + ykdw);
                //$("#ph").val($thistr.attr('data-ph'));
                //$("#pc").val($thistr.attr('data-pc'));
                //$("#kykc").val($thistr.attr('data-bzdwsl'));
                $("#kykc_dw").html(ykdw);
                $("#lsj").val($thistr.attr('data-lsj'));
                $("#pfj").val($thistr.attr('data-pfj'));
                //$("#yxq").val($thistr.attr('data-yxq'));
                //$("#zxsl").val($thistr.attr('data-zxsl'));
                //$("#zhyz").val($thistr.attr('data-zhyz'));
                $("#yplb").val($thistr.attr('data-yplb'));
                $("#ty_dw").find("option").remove();
                $("#ykdw").val(ykdw);
                $('#ty_dw').append('<option value="ykdw">' + ykdw + '</option>');
                $("#tysl").val("");
                $("#pc").val("");
                var list = new Array();
                list.push({ id: 'pc' });
                readonly(list, 2)

                //khởi tạo lô thuốc
                $("#pc").newtouchBatchFloatingSelector({
                    height: 300,
                    width: 560,
                    clickautotrigger: true,
                    url: "/DrugStorage/HandOutMedicinesrmList",
                    ajaxmethod: 'POST',
                    ajaxreqdata: function () {
                        var reqData = {};
                        reqData.keyword = $.trim($("#ypdm").val());
                        reqData.ckbm = '@Constants.CurrentYfbm.yfbmCode';
                        return reqData;
                    },
                    caption: "lô",
                    colModel: [
                        //{ label: 'tên thuốc', name: 'ypmc', width: 100, align: 'left' },
                        { label: 'lô', name: 'pc', width: 150, align: 'left' },
                        { label: 'số lô', name: 'ph', width: 150, align: 'left' },                        
                        { label: 'tồn kho', name: 'bzdwsl', width: 100, align: 'left' },
                        { label: 'hạn sử dụng', name: 'yxq', width: 150, formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' }, align: 'left' },
                        { label: 'hệ số chuyển đổi', name: 'zhyz', hidden: true },
                        { label: 'đơn vị bộ phận', name: 'bmdw', hidden: true },
                        { label: 'mã thuốc', name: 'ypdm', hidden: true },
                        { label: 'nhỏ nhất tồn kho', name: 'zxsl', hidden: true },
                        { label: 'đơn vị nhỏ nhất', name: 'zxdw', hidden: true },
                        { label: 'hệ số', name: 'bzs', hidden: true },
                        { label: 'đơn vị đóng gói', name: 'bzdw', hidden: true },
                        { label: 'số khả dụng tối đa sau khi quy đổi sang đơn vị bộ phận', name: 'bmdwsl', hidden: true }
                    ],
                    itemdbclickhandler: function ($thistr) {
                        $("#ph").val($thistr.attr('data-ph'));
                        $("#pc").val($thistr.attr('data-pc'));
                        $("#kykc").val($thistr.attr('data-bzdwsl'));
                        $("#yxq").val($thistr.attr('data-yxq'));
                        $("#zxsl").val($thistr.attr('data-zxsl'));
                        $("#zhyz").val($thistr.attr('data-zhyz'));
                        $("#tysl").val("");
                    }
                });
                globalpc = [];
                return;
            }
        });
        ///khởi tạo bộ phận trả thuốc
        $("#tybm").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 200,
            width: 400,
            url: "/Pharmacy/RequisitionFybmSele",
            ajaxmethod: 'POST',
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = $.trim($("#tybm").val());
                return reqData;
            },
            caption: "bộ phận trả thuốc",
            colModel: [
                { label: 'mã nhà thuốc', name: 'yfbmCode', widthratio: 25 },
                { label: 'tên nhà thuốc', name: 'yfbmmc', widthratio: 25 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#tybm").val($thistr.find('td:eq(0)').html());
                return;
            }
        });
        $("#gridList").newtouchLocalDataGrid({
            height: $(window).height() - 350,
            unwritten: false,
            colModel: [
                { label: "loại thuốc", name: "yplb", width: 60, align: 'left' },
                { label: 'tên thuốc', name: 'ypmc', width: 100, align: 'left' },
                { label: 'quy cách', name: 'gg', width: 60, align: 'left' },
                { label: 'số lô', name: 'ph', width: 100, align: 'left' },
                { label: 'lô', name: 'pc', width: 100, align: 'left' },
                { label: 'hạn sử dụng', name: 'yxq', width: 70, align: 'left' },
                { label: 'nhà sản xuất', name: 'sccj', width: 100, align: 'left' },
                { label: 'tồn kho', name: 'kykc', width: 55, align: 'right' },
                { label: 'số lượng trả thuốc', name: 'tysl', width: 55, align: 'right' },
                { label: 'đơn vị', name: 'dw', width: 40, align: 'left' },
                { label: 'giá bán buôn', name: 'pfj', width: 60, align: 'right' },
                { label: 'giá bán lẻ', name: 'lsj', width: 60, align: 'right' },
                { label: 'tổng giá bán buôn', name: 'pfje', width: 70, align: 'right' },
                { label: 'tổng giá bán lẻ', name: 'lsje', width: 70, align: 'right' },
                { label: 'mã nhập', name: 'srm', hidden: true },
                { label: "newid", name: "newid", hidden: true },
                { label: "khóa chính", name: "ypdm", hidden: true, key: true },
                { label: "deptdw", name: "deptdw", hidden: true },
                { label: "ykdw", name: "ykdw", hidden: true },
                { label: "bzs", name: "bzs", hidden: true },
                { label: "zhyz", name: "zhyz", hidden: true }
            ],
            ondblClickRow: function (rowid) {
                gridEditRow(rowid);
            },
            onSelectRow: function (rowid) {
                $('#btn_bottombutton_f3').removeAttr('disabled');
                $('#btn_bottombutton_f6').removeAttr('disabled');
            }
        });
        $("#tysl").blur(function () {//tính tổng giá bán buôn và tổng giá bán lẻ
            var tysl = Number($("#tysl").val());
            var pfje = Number($("#pfj").val()).toFixed(2);
            var lsje = Number($("#lsj").val()).toFixed(2);
            $("#pfje").val((tysl * pfje).toFixed(2));
            $("#lsje").val((tysl * lsje).toFixed(2));
        });
    }

    ///tạo số chứng từ
    function GetDjh() {
        $.ajax({
            url: "/DrugStorage/InitDjh",
            data: { djmc: 'phiếu phát thuốc nội bộ', r: Math.random() },
            dataType: "json",
            async: false,
            cache: false,
            success: function (res) {
                if (res.state === "success") {
                    $("#tydh").val(res.data);
                }
                else {
                    $.modalAlert(res.message, 'error');
                }
            }
        });
    }

    //fill data to grid
    function fillDataToGrid() {
        $("#gridList").resetSelection();
        $('#gridList').jqGrid("clearGridData");
        $("#gridList").newtouchLocalDataGrid(null, newxmList);
    }

    //kiểm tra trước đó có hay không đã tồn tại thêm thuốc
    function CheckExistPC() {
        var ypdm = $("#ypdm").val();
        var pc = $("#pc").val();
        var ph = $("#ph").val();
        for (var i = 0; i < newxmList.length; i++) {
            if (newxmList[i]["ypdm"] === ypdm && newxmList[i]["pc"] === pc && newxmList[i]["ph"] === ph) {
                $.modalAlert("lô thuốc này đã được đăng ký, không cho phép thêm mới!", 'warning');
                return false;
            }
        }
        return true;
    }

    //yêu cầu chỉnh sửa dòng
    function gridEditRow(rowid) {
        if (rowid) {
            var rowData = $("#gridList").jqGrid('getRowData', rowid);
            if (rowData) {
                var rowDataArr = $.jsonWhere(newxmList, function (v) {
                    return v && v.newid === rowData.newid;
                });
                if (!rowDataArr || rowDataArr.length === 0) {
                    return; //tại sao không tìm thấy
                }
                rowData = rowDataArr[0];  //đạt rowData.newidlấy dữ liệu dòng đó từ mảng đối tượng
                if (true) { //&&có thể chỉnh sửa
                    //Tuần tự hóa vào vùng chỉnh sửa
                    var data = {};
                    data = JSON.stringify(rowData);
                    $("#form1").formSerialize(JSON.parse(data));
                    $('#btn_bottombutton_f6').attr('disabled', 'disabled');
                    $('#btn_bottombutton_f9').show();
                    $('#btn_bottombutton_f2').attr('disabled', 'disabled');
                    editingNewid = rowData.newid;    //dòng đang sửa
                }
            }
        }
    }

    //thêm
    function newtouch_event_f2() {
        if (editingNewid) {
            return; //đang ở sửa trạng thái, có không thể nhấp thêm nút của   cần disable xử lý
        }
        if (!(checkEditingRowData() && CheckExistPC())) {    //dữ liệu có đầy đủ không, kiểm tra mục bắt buộc
            return;
        }
        var data = getEditRowData();
        data.newid = Math.random().toString() + new Date().getMilliseconds();   //newid()
        editingNewid = null;    //?chuyển sang trạng thái sửa, sau đó nhấp thêm?
        newxmList.unshift(data);   //thêm dưới dạng mục mới //"đầu mảng"
        fillDataToGrid();//tải lại xm mảng hiển thị thành grid
        clearMedicineInfo();//xóa thông tin thuốc
    }
    
    //sửa
    function newtouch_event_f3() {
        if (editingNewid) {
            //gửi sửa
            var data = getEditRowData();
            if (!(checkEditingRowData())) {    //dữ liệu có đầy đủ không, kiểm tra mục bắt buộc
                return;
            }
            //kiểm tra mục trùng lặp
            //trước tiên tại xm tìm thấy trong mảng
            if (editingNewid) {
                var matchedIndex = -1;
                for (var ii = 0; ii < newxmList.length; ii++) {
                    if (newxmList[ii].newid === data.newid) {
                        matchedIndex = ii;
                        break;
                    }
                }
                if (matchedIndex === -1) {
                    return; //có lẽ là ngoại lệ
                }
                newxmList.remove(matchedIndex);   //xóa mục này
                newxmList.unshift(data);   //thêm dưới dạng mục mới    //"đầu mảng"
            }
            fillDataToGrid();//tải lại xm mảng hiển thị thành grid
            clearMedicineInfo();//xóa thông tin thuốc
            bottomButtonsReset();//đặt lại nút
        } else {
            //lấy grid dòng hiện đang được chọn
            var seleId = $('#gridList').jqGrid('getGridParam', 'selrow');
            if (seleId) {
                //yêu cầu sửa dòng này
                gridEditRow(seleId);
            }
        }
    }

    //xóa
    function newtouch_event_f6() {
        var rowid = $("#gridList").jqGrid("getGridParam", "selrow");
        if (rowid) {
            var rowData = $("#gridList").jqGrid('getRowData', rowid);
            if (rowData) {
                if (rowData.newid === editingNewid) {
                    $.modalAlert("dòng này đang ở trạng thái chỉnh sửa, không thể xóa", 'warning');
                    return; //dòng này đang ở trạng thái chỉnh sửa, không thể xóa
                }
                var matchedIndex = -1;
                for (var ii = 0; ii < newxmList.length; ii++) {
                    if (newxmList[ii].newid === rowData.newid) {
                        matchedIndex = ii;
                    }
                }
                if (matchedIndex === -1) {
                    return; //có lẽ là ngoại lệ
                }
                newxmList.remove(matchedIndex);   //xóa mục này
                fillDataToGrid();//tải lại xm mảng hiển thị thành grid
                bottomButtonsReset();
            }
        }
    }

    //mới trả thuốc đơn
    function newtouch_event_f7() {
        //vô hiệu hóa trả thuốc thông tin
        var list = new Array();
        list.push({ id: 'tybm' });
        list.push({ id: 'tyrq' });
        list.push({ id: 'fyfs' });
        readonly(list, 2);
        //mở khóa thông tin thuốc
        var list2 = new Array();
        list2.push({ id: 'srm' });
        list2.push({ id: 'pc' });
        list2.push({ id: 'yxq' });
        list2.push({ id: 'tysl' });
        list2.push({ id: 'ty_dw' });
        readonly(list2, 1);
        $("#gridList").clearGridData();
        init();
        $("#tyrq").val($.getDate());
        $("#tybm").val("");
        $("#fyfs").val("");

        newtouch_globalevent_f4(null, {
            container: "#form2",
            inner: false
        });
        newxmList = [];   //hạng mục mới List
        editingNewid = null;    //dòng đang sửa
        bottomButtonsReset();
    }
    
    //trả thuốc
    function newtouch_event_f8() {
        if (newxmList.length === 0) {
            $.modalAlert("thông tin thuốc không thể trống!", 'warning');
            return;
        }
        var par = new Object();

        par["xtYpLsNbfymxk"] = newxmList;
        par["tydh"] = $("#tydh").val();
        par["fyfs"] = $("#fyfs").val();
        par["tybm"] = $("#tybm").val();
        if (newxmList && par["tybm"] && par["tydh"] && par["fyfs"]) {
            $.najax({
                type: "POST",
                url: "/Medicine/ExecHandOutMedicine",
                data: par,
                dataType: "json",
                success: function (res) {
                    if (res.state === "success") {
                        newtouch_event_f7();
                        $.modalMsg('trả thuốc thành công', 'success', 1000);
                    } else {
                        $.modalAlert(res.message, 'error');
                    }
                }
            });
        }
    }

    ////hủy sửa
    //function newtouch_event_f8() {
    //    clearMedicineInfo();
    //    editingNewid = null; //dòng đang sửa
    //    $("#gridList").resetSelection();
    //    bottomButtonsReset();
    //}

    //nút đặt lại
    function bottomButtonsReset() {
        $('#btn_bottombutton_f2').removeAttr('disabled');
        $('#btn_bottombutton_f3').attr('disabled', 'disabled');
        $('#btn_bottombutton_f6').attr('disabled', 'disabled');
        $('#btn_bottombutton_f9').hide();
    }

    //xóa thông tin thuốc
    function clearMedicineInfo() {
        newtouch_globalevent_f4(null, {
            container: "#form2",
            inner: false
        });
        $("#pc").find("option").remove();
        $("#yxq").find("option").remove();
        editingNewid = null;

    }

    //lấy dữ liệu đối tượng của miền chỉnh sửa
    function getEditRowData() {
        var newData = $("#form1").formSerialize();
        newData["dw"] = $("#ty_dw").find("option:selected").text();
        var tysl = Number($("#tysl").val());
        var zhyz = Number($("#zhyz").val());
        newData["tysl"] = tysl;
        if ($("#ty_dw").val() === "zxdw") {
            newData["fysl"] = tysl / zhyz;
        } else {
            newData["fysl"] = tysl;
        }
        return newData;
    }

    //kiểm tra trả thuốc thông tin
    function validatelyInfo() {
        //đánh giá mục bắt buộc
        var validator = $('#form1').validate();
        validator.settings = {
            rules: {
                tybm: { required: true },
                tyrq: { required: true },
                fyfs: { required: true }
            },
            messages: {
                tybm: { required: "退药部门必须填写" },
                tyrq: { required: "trả thuốc ngày bắt buộc chọn" },
                fyfs: { required: "trả thuốc phương thức bắt buộc chọn" }
            },
            showErrors: function (errorMap, errorList) {
                if (!$.isEmptyObject(errorList)) {
                    $.modalAlert(errorList[0].message, 'warning');
                }
            }
        };
        if (!validator.form()) {
            return false;
        }
        return true;
    }

    //kiểm tra đang chỉnh sửa của dữ liệu (chờ gửi)tính đầy đủ của
    function checkEditingRowData() {
        if (validatelyInfo()) {
            var validator = $('#form1').validate();
            validator.settings = {
                rules: {
                    tysl: { required: true, isIntGtZero: true },
                    srm: { required: true },
                    pc: { required: true },
                    yxq: { required: true }
                },
                messages: {
                    tysl: { required: "退药数量必须填写", isIntGtZero: "số lượng trả thuốc bắt buộc có lớn hơn 0 số nguyên" },
                    srm: { required: "药品代码必须填写" },
                    pc: { required: "lô không thể trống" },
                    yxq: { required: "hạn sử dụng không thể trống" }
                },
                showErrors: function (errorMap, errorList) {
                    if (!$.isEmptyObject(errorList)) {
                        $.modalAlert(errorList[0].message, 'warning');
                    }
                }
            };
            if (!validator.form()) {
                return false;
            }
            var zxdwsl = 0;
            var tysl = Number($("#tysl").val());
            var zxsl = Number($("#zxsl").val());
            var pfj = Number($("#pfj").val()).toFixed(2);
            var lsj = Number($("#lsj").val()).toFixed(2);
            var zhyz = Number($("#zhyz").val());
            dtdw = $("#ty_dw").find("option:selected").text();
            //1. kiểm tra số lượng trả thuốc
            if ($("#ty_dw").val() === "zxdw") {
                $("#pfje").val((pfj / zhyz * tysl).toFixed(2));
                $("#lsje").val((lsj / zhyz * tysl).toFixed(2));
                zxdwsl = tysl;
            } else {
                $("#pfje").val((tysl * pfj).toFixed(2));
                $("#lsje").val((tysl * lsj).toFixed(2));
                zxdwsl = tysl * zhyz;
            }
            if (zxdwsl > zxsl) {
                $.modalAlert("退货数量不大于可用库存数量!", 'warning');
                $("#tysl").val("");
                $("#tysl").focus();
                return false;
            }
            return true;
        }
        return false;
    }

    function changeval(type) {
        globalpc = globalpc || [];
        var t = type === 'pc' ? 'yxq' : 'pc';
        var val = $("#" + type).val();
        for (var i = 0; i < globalpc.length; i++) {
            if (globalpc[i][type] === val) {
                $('#' + t).val(globalpc[i][t]);
                return;
            }
        }
    }
    
    //vô hiệu hóa phần mềm
    function readonly(list, type) {
        if (list && list.length > 0) {
            for (var i = 0; i < list.length; i++) {
                if (type === 1) {//vô hiệu hóa
                    $("#" + list[i]["id"]).addClass('newtouch_Readonly').attr("disabled", "disabled").css("background-color", "rgb(238,238,238)");
                } else {//kích hoạt
                    $("#" + list[i]["id"]).removeClass("newtouch_Readonly").removeAttr("disabled").css("background-color", "");
                }

            }
        }
    }

    function ValidateForm() {
        var tybm = $("#tybm").val();
        var tyrq = $("#tyrq").val();
        var fyfs = $("#fyfs").find("option:selected").text();;
        if (!(tybm || tyrq) || fyfs === "==请选择==") {
            return false;
        }
        //vô hiệu hóa lĩnh thuốc thông tin
        var list = new Array();
        list.push({ id: 'tybm' });
        list.push({ id: 'tyrq' });
        list.push({ id: 'fyfs' });
        readonly(list, 1);
        //mở khóa thông tin thuốc
        var list2 = new Array();
        list2.push({ id: 'srm' });
        //list2.push({ id: 'pc' });
        list2.push({ id: 'yxq' });
        list2.push({ id: 'tysl' });
        list2.push({ id: 'ty_dw' });
        readonly(list2, 2);
        return true;
    }
</script>

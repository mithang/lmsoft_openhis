
@{
    ViewBag.Title = "RepercussionIndex";//trả thuốc nội trú
    Layout = "~/Views/Shared/_Index.cshtml";
}
<link href="@SiteUrl.GetStaticResourceScriptUrl("js/wdtree/tree.css")" rel="stylesheet" />
<script src="@SiteUrl.GetStaticResourceScriptUrl("js/wdtree/tree.js")"></script>

<input hidden id="OrganizeId" value="@ViewBag.OrganizeId">
<style>
    .dv-left-tree {
        overflow-y: auto;
        border-radius: 4px;
        background: white;
    }

    .dv-left-title {
        padding: 6px 10px;
        border-bottom: 1px solid transparent;
        border-top-left-radius: 3px;
        border-top-right-radius: 3px;
        border-color: #ddd;
        background-color: white;
    }
</style>
<div style="float:left;width:20%;">
    <div class="dv-left-title">danh sách bệnh nhân</div>
    <div class="dv-left-tree" id="BqTreeList"></div>
</div>

<div style="float:left;width:79.5%;margin-left:0.5%;">
    <div class="rows">
        <form id="form1">
            <div class="panel panel-default">
                <div class="panel-heading">
                    điều kiện tra cứu
                </div>
                <div style="padding: 2px;padding-right:20px;">
                    <input type="hidden"  id="Fyzt" value="2" />
                    <table class="form">
                        <tr>
                            <th class="formTitle">họ tên bệnh nhân: </th>
                            <td class="formValue">
                                <input id="patientName" type="text" class="form-control" placeholder="họ tên" />
                            </td>
                            <th class="formTitle">thuốc: </th>
                            <td class="formValue">
                                <input id="ypmc" type="text" class="form-control" placeholder="thuốc" />
                            </td>
                            <th class="formTitle">số giường: </th>
                            <td class="formValue">
                                <input id="cw" type="text" class="form-control" placeholder="số giường" />
                            </td>
                        </tr>
                        <tr>
                            <th class="formTitle">trạng thái phát thuốc: </th>
                            <td class="formValue formDdlSelectorTd">
                                <select id="sel_fybz" class="form-control">
                                    <option value="2">chưa trả thuốc</option>
                                    <option value="3">đã trả thuốc</option>
                                </select>
                            </td> 
                            <th class="formTitle">thời gian bắt đầu: </th>
                            <td class="formValue">
                                <input id="Kssj" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({dateFmt:'yyyy-MM-dd'})" />
                            </td>
                            <th class="formTitle">thời gian kết thúc: </th>
                            <td class="formValue">
                                <input id="Jssj" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({dateFmt:'yyyy-MM-dd'})" />
                            </td>
                            <td class="formValue" style="text-align: right;">
                                <input type="button" id="btn_search" class="btn btn-md btn-primary" style="width:50px; margin-left:40px;" value="tra cứu" />
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </form>
    </div>

    <div class="gridPanel">
        <table id="dispenseMedicinGridList"></table>
        <div id="gridPager"></div>
    </div>
</div>

@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
    ShowKeyList = new int[] { 6 ,7 , 8 },
    F6Text = "trả thuốc",
    F7Text = "chi tiết in",
    F8Text = "in tổng hợp"
})

<script type="text/javascript">
    var ThisbqCode = "";//khởi tạo khu bệnh Code
    var ThisbrCode = "";//khởi tạo bệnh nhân Code
    var globalData = [];
    $(".toolbar").css("width", 350);
    $(function () {
        //gắn khu bệnh
        bqGridList();
        //gắn thông tin chi tiết phát thuốc của bệnh nhân
        dispenseMedicinGridList(null, null);
    });
    
    //gắn khu bệnh và bệnh nhân
    function bqGridList() {
        $("#BqTreeList").treeview({
            height: $(window).height() - 35,
            slimscroll: false,
            showcheck: true,
            url: "/HospitalizationPharmacy/GetZYTYBRGridJson",
            param: {},
            oncheckboxclick: function (item, s) {
                getOrderExecutionList(item, s);
            }
        });
    }

    function getOrderExecutionList(item, s) {
        var patlist = $("#BqTreeList").getCheckedNodeObjArray();
        var patlistFath = "";
        var patzyh = "";

        //nút cha hiện đang được chọn
        var len = 0;
        var single = 0; //có phải là một nút con duy nhất không

        if (item != null && item.Ex1 == "p") {
            patlistFath = item.ChildNodes;
            len = patlistFath.length;
        }
        else if (item != null && item.Ex1 == "c") {
            patlistFath = item;
            len = 1;
            single = 1;
        }

        //nút được chọn
        for (var i = 0; i < patlist.length; i++) {
            if (patlist[i].Ex1 == "c") {
                patzyh += patlist[i].value + ",";
            }
        }

        if (s == 1) {
            if (single == 0) {
                for (var j = 0; j < len; j++) {
                    if (patlistFath[j].Ex1 == "c") {
                        patzyh += patlistFath[j].value + ",";
                    }
                }
            }
            else if (patlistFath.Ex1 == "c") {
                patzyh += patlistFath.value;
            }
        }
        else if (s == 0) {
            if (single == 0) {
                for (var j = 0; j < len; j++) {
                    if (patlistFath[j].Ex1 == "c" && patlistFath[j].checkstate == 1) {
                        patzyh = patzyh.replace(patlistFath[j].value + ",", "");
                    }
                }
            }
            else if (patlistFath.Ex1 == "c") {
                patzyh = patzyh.replace(patlistFath.value + ",", "");
            }
        }

        ThisbrCode = patzyh;//lưu bệnh nhân được nhấp code
        //tải lại thông tin chi tiết phát thuốc của bệnh nhân
        $("#btn_search").click();
    }

    //chọn liên đới tất cả nút con
    function checkAllSon(node) {
        $('#BqTreeList').treeview('checkNode', node.nodeId, { silent: true });
        if (node.nodes != null && node.nodes.length > 0) {
            for (var i in node.nodes) {
                checkAllSon(node.nodes[i]);
            }
        }
    }
    //bỏ chọn liên đới tất cả nút con
    function uncheckAllSon(node) {
        $('#BqTreeList').treeview('uncheckNode', node.nodeId, { silent: true });
        if (node.nodes != null && node.nodes.length > 0) {
            for (var i in node.nodes) {
                uncheckAllSon(node.nodes[i]);
            }
        }
    }

    //thông tin chi tiết phát thuốc của người dùng
    function dispenseMedicinGridList(BQ, BR) {
        var $gridBRXXDrugsList = $("#dispenseMedicinGridList");
        $gridBRXXDrugsList.dataGrid({
            url: '/HospitalizationPharmacy/GetZYFYDBGridJson',
            height: $(window).height() - document.getElementById('dispenseMedicinGridList').offsetTop - 150,
            multiselect: true,
            postData: {
                Bq: BQ, Zyh: BR,
                Kssj: $("#Kssj").val(),
                Jssj: $("#Jssj").val(),
                patientName: $("#patientName").val(),
                cw: $("#cw").val(),
                ypCode: $("#ypmc").val(),
                yzxz: $("#sel_yzxz").val(),
                Fyzt: '2'
            },
            onSelectRow_page: function (rowid, status) {
                addglobadata(status, rowid);
            },
            colModel: [
                { label: "khóa chính", name: 'Id', hidden: true, key: true },
                { label: "mã thuốc", name: 'ypCode', hidden: true },
                { label: "y lệnh ID", name: 'zxId', hidden: true },
                { label: "số nội trú", name: 'zyh', hidden: true },
                { label: "tổ chức", name: 'OrganizeId', hidden: true },
                { label: "thuốc lô", name: 'pc', hidden: true },
                { label: "thuốc số lô", name: 'ph', hidden: true },
                { label: 'họ tên', name: 'patientName', width: 80, align: 'left' },
                { label: 'số giường', name: 'cw', width: 60, align: 'left' },
                { label: 'thuốc', name: 'ypmc', width: 100, align: 'left' },
                { label: 'quy cách', name: 'ypgg', width: 100, align: 'left' },
                { label: 'tần suất', name: 'pcmc', width: 50, align: 'left' },
                { label: 'số nhóm', name: 'zh', width: 50, align: 'left' },
                { label: 'số lượng sử dụng', name: 'yl', width: 60, align: 'left' },
                { label: 'đơn vị sử dụng', name: 'yldw', width: 60, align: 'left' },
                { label: 'thực phát số lượng', name: 'sl', width: 60, align: 'left' },
                { label: 'đơn vị phát thực tế', name: 'zycldw', width: 60, align: 'left' },
                { label: 'tính chất y lệnh', name: 'yzxzmc', width: 80, align: 'left' },                
                { label: 'tạo nhà sản xuất', name: 'ycmc', width: 100, align: 'left' },
                { label: 'cách dùng', name: 'zlff', width: 60, align: 'left' },
                { label: 'đơn giá', name: 'dj', width: 60, align: 'left' },
                { label: 'số tiền', name: 'je', width: 60, align: 'left' },
                { label: 'phát thuốc người thao tác', name: 'LastModifierCode', width: 100, align: 'left' },
                { label: 'thời gian phát thuốc', name: 'LastModifyTime', width: 120, align: 'left' },
                { label: 'đã đề nghị trả thuốc', name: 'sqtyzt', width: 120, align: 'left' }
            ],
            gridComplete: function () {
                var ids = $("#dispenseMedicinGridList").getDataIDs();
                for (var i = 0; i < ids.length; i++) {
                    var rowData = $("#dispenseMedicinGridList").getRowData(ids[i]);
                    if (rowData.sqtyzt == "是") {
                        $('#' + ids[i]).find("td").css("background-color", "#C6E2FF");
                    }
                }
            },
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            caption: "đã phát thuốc danh sách",
            viewrecords: true
        });
        //tra cứu
        $("#btn_search").click(function () {
            $gridBRXXDrugsList.jqGrid('setGridParam', {
                postData: {
                    Bq: ThisbqCode, Zyh: ThisbrCode,
                    Kssj: $("#Kssj").val(),
                    Jssj: $("#Jssj").val(),
                    patientName: $("#patientName").val(),
                    cw: $("#cw").val(),
                    ypCode: $("#ypmc").val(),
                    yzxz: $("#sel_yzxz").val(),
                    Fyzt: $("#sel_fybz").val(),
                    sqtybz: "1"
                },
            }).trigger('reloadGrid');
        });
    }

    //Ghép hộp chọn nhiều trả thuốc
    function addglobadata(status, rowid) {
        var data = $("#dispenseMedicinGridList").getRowData(rowid);
        var i = globalData.length;
        if (status) {//Thêm dòng hiện tại
            globalData.push(data);
        } else {
            if (i > 0) {
                for (var j = 0; j < globalData.length; j++) {
                    if (globalData[j].yszyzid == rowid) {
                        globalData.splice(j, 1); //loại bỏ hiện tại dòng
                    }
                }
            }
        }
    }

    // trả thuốc
    function newtouch_event_f6() {
        globalData = []//Hủy chọn nhiều, xóa giá trị gốc
        var ids = $("#dispenseMedicinGridList").jqGrid('getGridParam', 'selarrrow');
        for (var i = 0; i < ids.length; i++) {
            var data = $("#dispenseMedicinGridList").getRowData(ids[i]);
            if (data.sqtyzt == '否') {
                $.modalAlert("chưa đề nghị trả thuốc,禁止退药!", 'warning');
                return;
            }
            globalData.push(data);
        }
        if (globalData == [] || globalData.length <= 0) {
            $.modalAlert("trả thuốc thất bại,không có thông tin thuốc!", 'warning');
            return;
        }
        $.modalConfirm("xác định tiến hành trả thuốc không?", function (flag) {
            if (flag) { 
                var par = {};
                var medicineList = [];
                for (var i = 0; i < globalData.length; i++) {
                    var obj = new Object();
                    obj["Id"] = globalData[i].Id;
                    obj["zxId"] = globalData[i].zxId;
                    obj["OrganizeId"] = globalData[i].OrganizeId;
                    obj["ypCode"] = globalData[i].ypCode;
                    obj["tysl"] = globalData[i].sl;
                    obj["yppc"] = globalData[i].pc;
                    obj["ypph"] = globalData[i].ph;
                    obj["zyh"] = globalData[i].zyh;
                    medicineList.push(obj);
                }
                par["ModelBQBRYZZXTYInfoVO"] = medicineList;
                par["type"] = 3;//trả thuốc
                $.ajax({
                    type: "POST",
                    url: "/HospitalizationPharmacy/ZYBQTYOperate",
                    data: par,
                    dataType: "text",
                    success: function (res) {
                        if (res == "退药成功") {
                            $.modalAlert("trả thuốc thành công!", 'success');
                            //tải lại y lệnh thông tin phát thuốc
                            $("#dispenseMedicinGridList").trigger("reloadGrid");
                        } else {
                            $.modalAlert(res, 'error');
                        }                
                    }
                });
            } else
                return false;
        }, false);
    }

    //in chi tiết
    function newtouch_event_f7() {
        var startTime = $("#Kssj").val();
        var endTime = $("#Jssj").val();
        var OrganizeId = $("#OrganizeId").val();
        window.open("/Report/PrintReport?type=ZYTY_Detail&param=startTime=" + startTime + "|endTime=" + endTime + "|OrganizeId=" + OrganizeId, "height=500, width=1195, top=100, left=50, toolbar=no, menubar=no, scrollbar=yes, resizeble=no, location=no, status=no");
    }

    //in tổng hợp
    function newtouch_event_f8() {
        var startTime = $("#Kssj").val();
        var endTime = $("#Jssj").val();
        var OrganizeId = $("#OrganizeId").val();
        window.open("/Report/PrintReport?type=ZYTY_Summary&param=startTime=" + startTime + "|endTime=" + endTime + "|OrganizeId=" + OrganizeId, "height=500, width=1195, top=100, left=50, toolbar=no, menubar=no, scrollbar=yes, resizeble=no, location=no, status=no");
    }
</script>
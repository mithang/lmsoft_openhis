
@{
    ViewBag.Title = "trả thuốc nội trú";
    Layout = "~/Views/Shared/_Index.cshtml";
    var reportUrl = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("ReportUrl");
}
<link href="@SiteUrl.GetStaticResourceScriptUrl("js/wdtree/tree.css")" rel="stylesheet" />
<script src="@SiteUrl.GetStaticResourceScriptUrl("js/wdtree/tree.js")"></script>

<input hidden id="OrganizeId" value="@ViewBag.OrganizeId">
<style>
    .dv-left-tree {
        overflow-y: auto;
        border-radius: 4px;
        background: #ffffff;
    }

    .dv-left-title {
        padding: 6px 10px;
        border-bottom: 1px solid transparent;
        border-top-left-radius: 3px;
        border-top-right-radius: 3px;
        border-color: #ddd;
        background-color: #ffffff;
    }

    .form-control {
        padding: 0 3px;
    }
    .scan-input {
        border: 2px solid #007bff;
        padding: 5px;
    }
</style>
<div style="float:left;width:20%;">
    <div class="dv-left-title">danh sách bệnh nhân</div>
    <div class="dv-left-tree" id="BqTreeList"></div>
</div>

<div style="float:left;width:79.5%;margin-left:0.5%;">
    <form id="form1">
        <div class="panel panel-default">
            <div class="panel-heading">
                điều kiện tra cứu
            </div>
            <div style="padding: 2px;">
                <input type="hidden" id="Fyzt" value="2" />
                <table class="form">
                    <tr>
                        <th class="formTitle" style="width: 80px;">tên thuốc: </th>
                        <td class="formValue">
                            <input id="ypmc" type="text" class="form-control" placeholder="tên thuốc" />
                        </td>
                        <th class="formTitle" style="width: 80px;">trạng thái phát thuốc: </th>
                        <td class="formValue formDdlSelectorTd" style="width: 90px;">
                            <select id="sel_fybz" class="form-control">
                                <option value="2">chưa trả thuốc</option>
                                <option value="3">đã trả thuốc</option>
                            </select>
                        </td>
                        <th class="formTitle" style="width: 75px; padding-right: 0px;"><span class="required">*</span>thời gian bắt đầu: </th>
                        <td class="formValue">
                            <input id="Kssj" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("yyyy-MM-dd 00:00:00")" onfocus="WdatePicker({dateFmt:'yyyy-MM-dd HH:mm:ss'})" />
                        </td>
                        <th class="formTitle" style="width: 40px;padding-right: 0;"><span class="required">*</span>đến: </th>
                        <td class="formValue">
                            <input id="Jssj" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.AddHours(2).ToString("yyyy-MM-dd HH:mm:ss")" onfocus="WdatePicker({dateFmt:'yyyy-MM-dd HH:mm:ss'})" />
                        </td>
                        <td class="formTitle" style="width: 45px;">
                            <input type="button" id="btn_search" class="btn btn-primary btn-md" value="tra cứu" />
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </form>
    <div class="gridPanel" id="dv_bybtach" style="display: none;">
        <table id="dispenseMedicinGridListByBatch"></table>
    </div>
    <div class="gridPanel" id="dv_nobtach">
        <table id="dispenseMedicinGridListNoBatch"></table>
    </div>
    @Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
    {
        ShowKeyList = new[] { 6 },
        F6Text = "trả thuốc"
    })
    <div class="ckbox" style="margin-left: 0.5%;margin-top: 10px;">
        <input id="autoPrint" name="autoPrint" type="checkbox"><label for="autoPrint">tự động in chi tiết</label>
    </div>
    <div class="ckbox" style="margin-left: 0.5%;margin-top: 10px;">
        <input id="dispenseByBatch" name="dispenseByBatch" type="checkbox"><label for="dispenseByBatch">theo lô trả thuốc</label>
    </div>
    <div class="ckbox" style="margin-top: 10px;">
        <input id="autoPrintSum" name="autoPrintSum" type="checkbox"  @ViewBag.returnDrugAutoPrint><label for="autoPrintSum">in tổng hợp</label>
    </div>
</div>
<script type="text/javascript">
    var ThisbqCode = "";//khởi tạo khu bệnh Code
    var ThisbrCode = "";//khởi tạo bệnh nhân Code
    var globalData = [];
    $(".toolbar").css("width", 250);
    var $dispenseMedicinGridListByBatch = $("#dispenseMedicinGridListByBatch");
    var $dispenseMedicinGridListNoBatch = $("#dispenseMedicinGridListNoBatch");
    var tyzyh = [];
    $(function () {
        //gắn khu bệnh
        bqGridList();
        //gắn thông tin chi tiết phát thuốc của bệnh nhân
        dispenseMedicinGridList(null);
        //tra cứu
        $("#btn_search").click(function () {
            if ($("#dispenseByBatch").is(":checked")) {
                //theo lô
                $dispenseMedicinGridListByBatch.jqGrid("clearGridData");
                $dispenseMedicinGridListByBatch.jqGrid('setGridParam', {
                    postData: {
                        Zyh: ThisbrCode,
                        fybz: $("#sel_fybz").val(),
                        Kssj: $("#Kssj").val(),
                        Jssj: $("#Jssj").val(),
                        ypmc: $("#ypmc").val()
                    }
                }).trigger('reloadGrid');
            } else {
                //không theo lô
                $dispenseMedicinGridListNoBatch.jqGrid("clearGridData");
                $dispenseMedicinGridListNoBatch.jqGrid('setGridParam', {
                    postData: {
                        Zyh: ThisbrCode,
                        fybz: $("#sel_fybz").val(),
                        Kssj: $("#Kssj").val(),
                        Jssj: $("#Jssj").val(),
                        ypmc: $("#ypmc").val()
                    }
                }).trigger('reloadGrid');
            }
        });

        $("#dispenseByBatch").click(function() {
            if ($("#dispenseByBatch").is(":checked")) {
                //theo lô
                $("#dv_bybtach").show();
                $("#dv_nobtach").hide();

            } else {
                //không theo lô
                $("#dv_bybtach").hide();
                $("#dv_nobtach").show();
            }
            $("#btn_search").trigger("click");
        });

        $("#autoPrintSum").change(function (e) {
            if ($('#autoPrintSum').is(':checked')) {
                $('#autoPrint').attr('checked', false);
            }
        });
        $("#autoPrint").change(function (e) {
            if ($('#autoPrint').is(':checked')) {
                $('#autoPrintSum').attr('checked', false);
            }
        });

        // quét mã truy xuất thuốc
        $dispenseMedicinGridListByBatch.on('keydown', '.scan-input', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();

                const inputField = $(this);
                const row = inputField.closest('tr');

                // có tách lẻ không
                const sfcl = parseInt(row.find('.sfcl').val(), 10);
                var maxEntries = 1;
                if (sfcl === 1) {
                    maxEntries = 1
                } else {
                    maxEntries = parseInt(row.find('.quantity').text(), 10);
                }

                const entries = inputField.val().split(',').filter(entry => entry.trim() !== '').length;

                if (inputField.val() && !inputField.val().endsWith(',')) {
                     inputField.val(removeDuplicates(inputField.val()));
                }

                if (entries >= maxEntries) {
                    $.modalMsg("đã đạt số lượng mục quét mã tối đa của dòng này!", "warning", 1500);
                    inputField.val(inputField.val().split(',').filter(entry => entry.trim() != "").slice(0, maxEntries).join(',') + ",");
                }
            }
        });

        $dispenseMedicinGridListNoBatch.on('keydown', '.scan-input', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();

                const inputField = $(this);
                const row = inputField.closest('tr');

                // có tách lẻ không
                const sfcl = parseInt(row.find('.sfcl').val(), 10);
                var maxEntries = 1;
                if (sfcl === 1) {
                    maxEntries = 1
                } else {
                    maxEntries = parseInt(row.find('.quantity').text(), 10);
                }

                const entries = inputField.val().split(',').filter(entry => entry.trim() !== '').length;

                if (inputField.val() && !inputField.val().endsWith(',')) {
                     inputField.val(removeDuplicates(inputField.val()));
                }

                if (entries >= maxEntries) {
                    $.modalMsg("đã đạt số lượng mục quét mã tối đa của dòng này!", "warning", 1500);
                    inputField.val(inputField.val().split(',').filter(entry => entry.trim() != "").slice(0, maxEntries).join(',') + ",");
                }
            }
        });
    });

    function removeDuplicates(str){
        const arr = str.split(',')
        const uniqueArr = [...new Set(arr)]
        return uniqueArr.join(',')+','
    }

    //gắn sự kiện phím Enter
    $(document).keyup(function (event) {
        if (event.keyCode === 13) {
            //$("#btn_search").trigger("click");
        }
    });

    //gắn khu bệnh và bệnh nhân
    function bqGridList() {
        $("#BqTreeList").treeview({
            height: $(window).height() - 35,
            slimscroll: false,
            showcheck: true,
            url: "/HospitalizationPharmacy/GetZytybrGridJsonV2",
            param: {},
            oncheckboxclick: function (item, s) {
                getOrderExecutionList(item, s);
            }
        });
    }

    function getOrderExecutionList(item, s) {
        var patlist = $("#BqTreeList").getCheckedNodeObjArray();
        var patlistFath = "";
        var patzyh = "";

        //nút cha hiện đang được chọn
        var len = 0;
        var single = 0; //có phải là một nút con duy nhất không

        if (item != null && item.Ex1 === "p") {
            patlistFath = item.ChildNodes;
            len = patlistFath.length;
        }
        else if (item != null && item.Ex1 === "c") {
            patlistFath = item;
            len = 1;
            single = 1;
        }
        //nút được chọn
        for (var i = 0; i < patlist.length; i++) {
            if (patlist[i].Ex1 == "c") {
                patzyh += patlist[i].value + ",";
            }
        }
        if (s == 1) {
            if (single == 0) {
                for (var j = 0; j < len; j++) {
                    if (patlistFath[j].Ex1 == "c") {
                        patzyh += patlistFath[j].value + ",";
                    }
                }
            }
            else if (patlistFath.Ex1 == "c") {
                patzyh += patlistFath.value;
            }
        }
        else if (s == 0) {
            if (single == 0) {
                for (var j = 0; j < len; j++) {
                    if (patlistFath[j].Ex1 == "c" && patlistFath[j].checkstate == 1) {
                        patzyh = patzyh.replace(patlistFath[j].value + ",", "");
                    }
                }
            }
            else if (patlistFath.Ex1 == "c") {
                patzyh = patzyh.replace(patlistFath.value + ",", "");
            }
        }

        ThisbrCode = patzyh;//lưu bệnh nhân được nhấp code
        //tải lại thông tin chi tiết phát thuốc của bệnh nhân
        $("#btn_search").click();
    }

    //chọn liên đới tất cả nút con
    function checkAllSon(node) {
        $('#BqTreeList').treeview('checkNode', node.nodeId, { silent: true });
        if (node.nodes != null && node.nodes.length > 0) {
            for (var i in node.nodes) {
                checkAllSon(node.nodes[i]);
            }
        }
    }
    //bỏ chọn liên đới tất cả nút con
    function uncheckAllSon(node) {
        $('#BqTreeList').treeview('uncheckNode', node.nodeId, { silent: true });
        if (node.nodes != null && node.nodes.length > 0) {
            for (var i in node.nodes) {
                uncheckAllSon(node.nodes[i]);
            }
        }
    }

    //init jqrid
    function dispenseMedicinGridList() {
        dispenseMedicinGridListByBatch();//theo lô
        dispenseMedicinGridListNoBatch();//không theo lô
    }

    //thông tin chi tiết phát thuốc của người dùng theo thực hiện lô
    function dispenseMedicinGridListByBatch() {
        $dispenseMedicinGridListByBatch.dataGrid({
            url: '/HospitalizationPharmacy/GetReturnDrugDetail',
            height: $(window).height() - 200,
            postData: {
                Zyh: "",
                fybz: $("#sel_fybz").val(),
                Kssj: $("#Kssj").val(),
                Jssj: $("#Jssj").val(),
                ypmc: $("#ypmc").val()
            },
            colModel: [
                { label: 'họ tên', name: 'patientName', width: 70, align: 'left' },
                { label: 'số giường', name: 'cw', width: 60, align: 'left' },
                { label: 'thuốc', name: 'ypmc', width: 100, align: 'left' },
                { label: 'số lượng trả', name: 'tysl', width: 60, align: 'left', editable: true, editwidth: "85%", classes: "quantity" },
                { label: 'đơn vị', name: 'bmdw', width: 45, align: 'center' },
                { label: 'có thể trả số', name: 'slStr', width: 80, align: 'left' },
                {
                    label: '<span class="required">*</span>mã truy xuất', name: 'zsm', width: 80, align: 'center',
                    formatter: function (cellvalue, options) {
                        return "<input name=\"zsm\" id=\"sel_zsm_" + options.rowId + "\" rowid=" + options.rowId + " class=\"scan-input editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" />";
                    }
                },
                {
                    label: '<span class="required">*</span>có tách lẻ không', name: 'sfcl', width: 80, align: 'center',
                    formatter: function (cellvalue, options) {
                        return "<select name=\"sfcl\" id=\"sel_sfcl_" + options.rowId + "\" rowid=" + options.rowId + " class=\"sfcl editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" ><option value=\"1\">có</option><option value=\"2\">không</option></select>";
                    }
                },
                { label: "lô", name: 'pc', width: 100, align: 'center' },
                { label: "số lô", name: 'ph', width: 100, align: 'center' },
                { label: 'quy cách', name: 'ypgg', width: 100, align: 'left' },
                { label: 'liều lượng', name: 'ylStr', width: 60, align: 'left' },
                { label: 'số nhóm', name: 'zh', width: 50, align: 'left' },
                { label: 'tính chất y lệnh', name: 'yzxzmc', width: 80, align: 'left' },
                { label: 'tạo nhà sản xuất', name: 'ycmc', width: 100, align: 'left' },
                { label: "số phiếu đề nghị trả thuốc", name: 'applyNo', width: 100, align: 'center' },
                { label: 'đơn giá', name: 'djStr', hidden: true },
                { label: 'số tiền', name: 'je', hidden: true },
                { label: 'số lượng có thể trả', name: 'sl', hidden: true },
                { label: "mã thuốc", name: 'ypCode', hidden: true },
                { label: "yzId", name: 'yzId', hidden: true },
                { label: "zxId", name: 'zxId', hidden: true },
                { label: "hệ số chuyển đổi", name: 'zhyz', hidden: true },
                { label: "chi tiết đề nghị trả thuốc ID", name: 'rdbdId', hidden: true },
                { label: "số nội trú", name: 'zyh', hidden: true }
            ],
            gridComplete: function () {
                EnableInlineEditBox($dispenseMedicinGridListByBatch);
            },
            caption: "cần trả thuốc danh sách",
            viewrecords: true
        });
    }

    function dispenseMedicinGridListNoBatch() {
        $dispenseMedicinGridListNoBatch.dataGrid({
            url: '/HospitalizationPharmacy/GetReturnDrugDetailNoBatch',
            height: $(window).height() - 200,
            postData: {
                Zyh: "",
                fybz: $("#sel_fybz").val(),
                Kssj: $("#Kssj").val(),
                Jssj: $("#Jssj").val(),
                ypmc: $("#ypmc").val()
            },
            colModel: [
                { label: 'họ tên', name: 'patientName', width: 70, align: 'left' },
                { label: 'số giường', name: 'cw', width: 60, align: 'center' },
                { label: 'thuốc', name: 'ypmc', width: 100, align: 'left' },
                { label: 'số lượng trả', name: 'tyslStr', width: 70, align: 'right' },
                { label: 'tối đa có thể trả', name: 'slStr', width: 70, align: 'right' },
                {
                    label: '<span class="required">*</span>mã truy xuất', name: 'zsm', width: 80, align: 'center',
                    formatter: function (cellvalue, options) {
                        return "<input name=\"zsm\" id=\"sel_zsm_" + options.rowId + "\" rowid=" + options.rowId + " class=\"scan-input editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" />";
                    }
                },
                {
                    label: '<span class="required">*</span>có tách lẻ không', name: 'sfcl', width: 80, align: 'center',
                    formatter: function (cellvalue, options) {
                        return "<select name=\"sfcl\" id=\"sel_sfcl_" + options.rowId + "\" rowid=" + options.rowId + " class=\"sfcl editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" ><option value=\"1\">có</option><option value=\"2\">không</option></select>";
                    }
                },
                { label: 'quy cách', name: 'ypgg', width: 100, align: 'center' },
                { label: 'liều lượng', name: 'ylStr', width: 60, align: 'right' },
                { label: 'số nhóm', name: 'zh', width: 50, align: 'center' },
                { label: 'tính chất y lệnh', name: 'yzxzmc', width: 80, align: 'center' },
                { label: 'tạo nhà sản xuất', name: 'ycmc', width: 100, align: 'left' },
                { label: "số phiếu đề nghị trả thuốc", name: 'applyNo', width: 120, align: 'center' },
                { label: "lô", name: 'pc', hidden: true },
                { label: "số lô", name: 'ph', hidden: true },
                { label: 'đơn vị', name: 'bmdw', width: 45, hidden: true },
                { label: 'đơn giá', name: 'djStr', hidden: true },
                { label: 'số tiền', name: 'je', hidden: true },
                { label: 'số lượng có thể trả', name: 'sl', hidden: true, classes: "quantity" },
                { label: 'đề nghị trả thuốc số (đơn vị nhỏ nhất)', name: 'tysl', hidden: true },
                { label: "mã thuốc", name: 'ypCode', hidden: true },
                { label: "yzId", name: 'yzId', hidden: true },
                { label: "zxId", name: 'zxId', hidden: true },
                { label: "hệ số chuyển đổi", name: 'zhyz', hidden: true },
                { label: "chi tiết đề nghị trả thuốc ID", name: 'rdbdId', hidden: true },
                { label: "số nội trú", name: 'zyh', hidden: true }
            ],
            gridComplete: function () {
                EnableInlineEditBox($dispenseMedicinGridListNoBatch);
            },
            caption: "cần trả thuốc danh sách",
            viewrecords: true
        });
    }

    //bật hộp chỉnh sửa trong dòng
    function EnableInlineEditBox(jgr) {
        var rowIds = jgr.jqGrid('getDataIDs'); //Grid sau khi tải xong thì bật chỉnh sửa trong dòng   1.trước tiên lấy tất cả các dòng Id  2.duyệt và gọi editRow phương thức
        for (var i = 0; i < rowIds.length; i++) {
            jgr.jqGrid('editRow',
                rowIds[i],
                true,
                null,
                null,
                null,
                null,
                function (callbackRowId) { //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.
                });
        }
    }

    // trả thuốc
    function newtouch_event_f6() {
        var jqr = null;
        if ($("#dispenseByBatch").is(":checked")) {
            //theo lô
            jqr = $dispenseMedicinGridListByBatch;
        } else {
            //không theo lô
            jqr = $dispenseMedicinGridListNoBatch;
        }
        var ids = jqr.jqGrid('getDataIDs'); //lấy tất cả các dòng Id, duyệt để hộp chỉnh sửa ở trạng thái đã lưu
        if (ids == null || ids.length === 0) {
            $.modalMsg('vui lòng tra cứu trả thuốc chi tiết', 'warning', 2000);
            return false;
        }
        var tymx = [];
        tyzyh = [];
        for (var i = 0; i < ids.length; i++) {
            jqr.saveRow(ids[i], null, null, null, function (callbackRowId) { }, null, null);
            var rowData = jqr.jqGrid('getRowData', ids[i]);
            if (!rowData) {
                return false;
            }
            if (rowData.tysl.replace(/(^\s*)|(\s*$)/g, "") === "" ||
                rowData.tysl === "" ||
                isNaN(rowData.tysl) ||
                rowData.tysl < 0) {
                $.modalAlert("【" + rowData.ypmc + "】số lượng trả thuốc phải là số tự nhiên, vui lòng xác nhận.", "warning");
                EnableInlineEditBox(jqr); //bật hộp chỉnh sửa trong dòng
                return false;
            }
            if (parseInt(rowData.tysl) > parseInt(rowData.sl)) {
                $.modalAlert("【" + rowData.ypmc + "】số lượng trả thuốc không được vượt quá" + rowData.slStr + "。", "warning");
                EnableInlineEditBox(jqr); //bật hộp chỉnh sửa trong dòng
                return false;
            }
            if (parseInt(rowData.sl) > 0) {
                const rowid = ids[i]
                //mã truy xuất
                var zsm = $("#sel_zsm_" + rowid).val()
                //có tách lẻ không
                var sfclValue = Number($("#sel_sfcl_" + rowid).val());

                // kiểm tra số lượng mã truy xuất. nếu tách lẻ thì chọn có, chỉ cần quét một cái, nếu không thì cần quét mã tương ứng với số lượng nhập kho
                const zsmLength = $("#sel_zsm_" + rowid).val().split(',').filter(entry => entry.trim() !== '').length
                var maxZsmLength = 1
                if (sfclValue === 1) {
                    maxZsmLength = 1
                } else {
                    maxZsmLength = parseInt(rowData.sl)
                }
                if (zsmLength != 0 && zsmLength != maxZsmLength) {
                    $.modalMsg("mục" + rowData.ypmc + "số lượng không khớp với số lượng mã truy xuất!", "warning", 1500);
                    return false;
                }


                tymx.push({
                    "applyNo": rowData.applyNo,
                    "rdbdId": rowData.rdbdId,
                    "yzId": rowData.yzId,
                    "zxId": rowData.zxId,
                    "ph": rowData.ph,
                    "pc": rowData.pc,
                    "ypCode": rowData.ypCode,
                    "ypmc": rowData.ypmc,
                    "sl": rowData.tysl,
                    "zhyz": rowData.zhyz,
                    "zyh": rowData.zyh,
                    "zsm": zsm,
                    "sfcl": sfclValue,
                });

                if (!tyzyh.find((item) => item.zyh == rowData.zyh)) {
                    tyzyh.push({ "zyh": rowData.zyh });
                }

            }
        }

        $.modalConfirm("xác định tiến hành trả thuốc không?", function (flag) {
            if (!flag) return false;
            $.najax({
                type: "POST",
                url: "/HospitalizationPharmacy/ExecuteReturnDrug",
                data: { tyParams: tymx },
                alerterror: false,
                success: function (res) {
                    if (res.state === "success") {
                        if ($("#autoPrint").is(":checked")) {
                            printRpDetail(res.data);
                        }
                        else if ($("#autoPrintSum").is(":checked")) {
                            printRpSummary(res.data);
                        }
                        $.modalMsg('trả thuốc thành công', 'success', 2000);
                        bqGridList(); //gắn khu bệnh
                        jqr.trigger("reloadGrid");
                    } else {
                        $.modalAlert(res.message, 'error');
                        EnableInlineEditBox(jqr); //bật hộp chỉnh sửa trong dòng
                    }
                }
            });
        }, false);
    }

    //in chi tiết
    function printRpDetail(rdNo) {
        var systemCode = "PDS";//mã hệ thống của báo cáo
        for (var i = 0; i < tyzyh.length; i++) {
            var uri = '@reportUrl' + "?tempCode=64" + "&hospitalCode=" + '@ViewBag.OrganizeId' + "&OrganizeId=" + '@ViewBag.OrganizeId' + "&systemCode=" + systemCode + "&yfbmCode=" + '@ViewBag.yfbmCode' + "&yzIds=" + "&zxIds=" + "&czIds=" + "&zyh=" + tyzyh[0].zyh + "&operateType=2" + "&rdNo=" + rdNo;
            window.open(uri);
        }
    }

    function printRpSummary(rdNo) {
        var systemCode = "PDS";//mã hệ thống của báo cáo
        var uri = '@reportUrl' + "?tempCode=66" + "&hospitalCode=" + '@ViewBag.OrganizeId' + "&systemCode=" + systemCode + "&yfbmCode=" + '@ViewBag.yfbmCode' + "&yzIds= &zxIds=&operateType=2&kssj=&jssj=" + "&rdNo=" + rdNo + "&czIds=";
        window.open(uri);
    }
</script>
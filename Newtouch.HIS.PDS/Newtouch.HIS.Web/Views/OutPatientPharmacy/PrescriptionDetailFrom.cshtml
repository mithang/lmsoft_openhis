
@{
    ViewBag.Title = "PrescriptionDetailFrom";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<div class="gridPanel" style="margin-top:10px;">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>
<script>
    var cfh = $.request("cfh");
    $(function () {
        gridInit();
    });
    function gridInit() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            postData: { cfh: cfh},
            url: '/OutPatientPharmacy/GetMzcfGridDetailJson',
            height: $(window).height() - 100,
            colModel: [
                { label: 'số ngoại trú', name: 'mzh', align: 'center', width: 100 },
                { label: 'họ tên', name: 'xm', align: 'center', width: 60 },
                { label: 'mở đơn thời gian', name: 'kssj', align: 'left', width: 50,hidden:true },
                { label: 'mã thuốc', name: 'ypcode', align: 'center', width: 90 },
                { label: 'tên thuốc', name: 'ypmc', align: 'center', width: 120 },
                { label: 'đơn vị', name: 'dw', align: 'center', width: 60 },
                 { label: 'số lượng', name: 'sl', align: 'center', width: 50 },
                {
                    label: 'đơn giá', name: 'dj', align: 'center', width: 50, formatter: "number"
                    , formatoptions: { decimalPlaces: 2, defaultValue: '0.0000' }
                },
                {
                    label: 'chi phí', name: 'je', align: 'center', width: 60, formatter: "number"
                    , formatoptions: { decimalPlaces: 2, defaultValue: '0.0000' }
                },
                { label: 'liều dùng', name: 'mcjl', align: 'center', width: 60 },
                { label: 'quy cách', name: 'gg', align: 'center', width: 100 },
                { label: 'tần suất', name: 'pcmc', align: 'center', width: 60 },

            ],
            pager: "#gridPager",
            sortname: 'kssj',
            viewrecords: true,
        });
    }
</script>


            <div id="gridPatientsPager" rel="form1"></div>
        </div>
    </div>
    <div id="dv_right" style="float: left; width: 79.5%; margin-left: 0.5%;">
        <div class="panel" id="dv_rightTop">
            <div class="panel-default panel-heading">
                <span style="font-weight: bold;">thông tin đơn thuốc</span>
                <span class="glyphicon glyphicon-menu-up" aria-hidden="true" style="float: right;"></span>
            </div>
            <div id="dv_cfInfo">
                <ul>
                    <li>
                        <span class="formTitle">họ tên: </span>
                        <label id="lab_name" type="text" value=""></label>
                    </li>
                    <li>
                        <span class="formTitle">tuổi: </span>
                        <label id="lab_nl" type="text" value=""></label>
                    </li>
                    <li>
                        <span class="formTitle">bác sĩ: </span>
                        <label id="lab_ysmc" type="text" value=""></label>
                    </li>
                    <li>
                        <span class="formTitle ">số thẻ: </span>
                        <label id="lab_cardNo" type="text" value=""></label>
                    </li>
                    <li>
                        <span class="formTitle">tổng số tiền: </span>
                        <label id="lab_zje" type="text" value=""></label>
                    </li>
                    <li>
                        <span class="formTitle">tính chất bệnh nhân: </span>
                        <label id="lab_brxzmc" type="text" value=""></label>
                    </li>
                    <li>
                        <span class="formTitle">khoa: </span>
                        <label id="lab_ksmc" type="text" value=""></label>
                    </li>
                    <li>
                        <span class="formTitle">số hóa đơn: </span>
                        <label id="lab_fph" type="text" value=""></label>
                    </li>
                    <li>
                        <span class="formTitle">số đơn thuốc: </span>
                        <label id="lab_cfh" type="text" value=""></label>
                    </li>
                </ul>
            </div>
        </div>
        <div id="dv_cfmx" style="overflow-x: auto; width: 100%; margin-top: 5px;">
            <table id="gridCfmx"></table>
        </div>
        <div class="ckbox" style="float:left;margin:10px 10px 12px;">
            <input id="autoprint" name="autoprint" type="checkbox"checked><label for="autoprint">tự động in</label>
        </div>
        @Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
   {
       ShowKeyList = new[] { 6, 8, 9, 10 },
       F6Text = "phát thuốc",
      // F7Text = "phát thuốc toàn bộ",

    //phát thuốc
    function newtouch_event_f6() {
        var id = $gridPatients.jqGrid("getGridParam", "selrow");
        if (!id) {
            $.modalAlert("vui lòng chọn thông tin bệnh nhân!", 'warning');
            return;
        }

        $.modalConfirm("xác định phát thuốc không?", function (flag) {
            if (!flag) return;
          
            var patient = new Array();
            var cfmx = $gridCfmx.getDataIDs();
            for (var i = 0; i < cfmx.length; i++) {
                var rowdata = $gridCfmx.jqGrid("getRowData", cfmx[i]);
                const rowid = cfmx[i]
                //mã truy xuất
                var zsm = $("#sel_zsm_" + rowid).val()
                //có tách lẻ không
                var sfclValue = Number($("#sel_sfcl_" + rowid).val());

                // kiểm tra số lượng mã truy xuất. nếu tách lẻ thì chọn có, chỉ cần quét một cái, nếu không thì cần quét mã tương ứng với số lượng nhập kho
                const zsmLength = $("#sel_zsm_" + rowid).val().split(',').filter(entry => entry.trim() !== '').length
                var maxZsmLength = 1
                if (sfclValue === 1) {
                    maxZsmLength = 1
                } else {
                    maxZsmLength = parseInt(rowdata.sl)
                }
                if (zsmLength != 0 && zsmLength != maxZsmLength) {
                    $.modalAlert("mục" + rowdata.ypmc + "số lượng không khớp với số lượng mã truy xuất!", 'warning');
                    return false;
                }

                patient.push({
                    "CardNo": $gridPatients.jqGrid('getRowData', id).CardNo,
                    "xm": $gridPatients.jqGrid('getRowData', id).xm,
                    "cfh": rowdata.cfh,
                    "cfnm": rowdata.cfnm,
                    "zsm": rowdata.ypCode + '/' + zsm +'/'+ sfclValue + '/' + rowdata.pc + '/' + rowdata.ph
                    //"sfcl": sfclValue,
                    //"ypdm": rowdata.ypCode
                });
            }
            if (patient.length <= 0) {
                $.modalAlert("未找到有效的发药信息!", 'warning');
                return;
            }
            $.najax({
                type: "POST",
                url: "/OutPatientPharmacy/ExecAllDeliveryDrug",
                dataType: "json",
                data: { patients: patient },
                success: function (res) {
                    if (res.state === "success") {
                        printRpDetailV2(res.data);
                        $.modalMsg('phát thuốc thành công', 'success', 1000);
                        $gridPatients.trigger("reloadGrid");
                        $gridCfmx.jqGrid("clearGridData");
                        cleanCfInfo();

                    } else {
                        $.modalAlert(res.message, Error);
                    }
                }
            });
            //printInfusionCards(0);
            //printAtomizationCards(0);
            //printDrugUsage(0);
        }
        );
    }
    //phát thuốc toàn bộ
    function newtouch_event_f7() {
        var pats = new Array();
        var gridPatients = $gridPatients.jqGrid('getRowData_AllLine', null, true);//param2:mặc định tất cả các dòng; param3: true quay lại object
        var cfmx = $gridCfmx.getDataIDs();
        $(gridPatients).each(function () {
			for (var i = 0; i < cfmx.length; i++) {
                var rowdata = $gridCfmx.jqGrid("getRowData", cfmx[i]);
                const rowid = cfmx[i]
                //mã truy xuất
                var zsm = $("#sel_zsm_" + rowid).val()
                //có tách lẻ không
                var sfclValue = Number($("#sel_sfcl_" + rowid).val());

                // kiểm tra số lượng mã truy xuất. nếu tách lẻ thì chọn có, chỉ cần quét một cái, nếu không thì cần quét mã tương ứng với số lượng nhập kho
                const zsmLength = $("#sel_zsm_" + rowid).val().split(',').filter(entry => entry.trim() !== '').length
                var maxZsmLength = 1
                if (sfclValue === 1) {
                    maxZsmLength = 1
                } else {
                    maxZsmLength = parseInt(rowdata.sl)
                }
                if (zsmLength != 0 && zsmLength != maxZsmLength) {
                    $.modalMsg("mục" + rowdata.ypmc + "số lượng không khớp với số lượng mã truy xuất!", "warning", 1500);
                    return false;
                }
				pats.push({
					"CardNo": this.CardNo,
					"xm": this.xm,
					"ShowSfsj": this.ShowSfsj,
					"cfh": rowdata.cfh,
                    "cfnm": rowdata.cfnm,
                    "zsm": zsm,
                    "sfcl": sfclValue,
                    "ypdm": rowdata.ypCode
                });
			}
        });
        if (pats.length <= 0) {
            $.modalAlert("未找到有效的发药信息!", 'warning');
            return;
        }
        $.modalConfirm("xác định phát thuốc toàn bộ không?", function (flag) {
            if (!flag) return;
            //printInfusionCards(0);
            //printAtomizationCards(0);
            //printDrugUsage(0);
            $.najax({
                type: "POST",
                url: "/OutPatientPharmacy/ExecAllDeliveryDrug",
                data: { patients: pats },
                dataType: "json",
                success: function (res) {
                    if (res.state === "success") {
                        printRpDetailV2(res.data);
                        $.modalMsg('phát thuốc thành công', 'success', 1000);
                        $gridPatients.trigger("reloadGrid");
                        $gridCfmx.jqGrid("clearGridData");
                        cleanCfInfo();
                    } else  $.modalAlert(res.message, Error);
                },
                error: function (res) {
                    $.modalAlert(res.message, Error);
                }
            });

@{
    ViewBag.Title = "ra nhập kho đơn tra cứu";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script src='http://localhost:8000/CLodopfuncs.js?name=CLODOPA'></script>

<body>
    <div id="b_fyd" style="text-align:center">
        <style>
            #b_fyd {
                font-size: 14px;
            }

            .dv-title {
                position: relative;
                margin: 0 auto;
                padding: 20px 0 10px 0;
                width: 600px;
            }

            .span-dj-title {
                font-size: 24px;
                font-weight: 800;
            }

            .span-dj-no {
                position: absolute;
                float: right;
                right: 0;
                bottom: 0;
                margin-left: 5px;
            }

            .dv-patientInfo {
                margin: 0 auto;
                width: 600px;
                padding: 0 5px;
                border: 0;
            }

            ul {
                list-style: none;
                border: 0;
                padding: 0;
                margin: 0;
                width: 100%;
            }

                ul li {
                    float: left;
                    margin-right: 20px;
                    padding: 5px 0;
                }

            .dv-content {
                margin: 0 auto;
                width: 600px;
            }

                .dv-content table {
                    width: 100%;
                    border: 2px solid #000;
                }

            th {
                border: 1px solid #000;
                text-align: center;
                padding: 5px 0;
            }

            td {
                text-align: left;
                padding: 5px;
                font-size: 12px;
            }

            .td-lsj, .td-sl, .td-zje {
                text-align: right;
            }

            .td-hj {
                font-weight: 700;
                text-align: right;
                border: 1px solid #ccc;
            }

            .dv-end {
                margin: 0 auto;
                width: 600px;
                padding: 0 5px;
                border: 0;
            }
            .dv-end table{
                width:100%;
            }
        </style>
        <div class="dv-title">
            <span class="span-dj-title">发药清单</span>
            <span class="span-dj-no">
                <span style="font-weight:600;">No:</span>
                <span id="span_no">123123123123</span>

                    <th style="width:100px;">quy cách</th>
                    <th style="width:90px;">đơn giá</th>
                    <th style="width:60px;">số lượng</th>
                    <th style="width:70px;">số tiền</th>
                </tr>
                <tr>
                    <td class="td-cfh">CF001231123</td>
                    <td class="td-mc">Amoxicillin</td>
                    <td class="td-gg">2g*10 viên</td>
                    <td class="td-lsj">18.00 đồng/hộp</td>
                    <td class="td-sl">2</td>
                    <td class="td-zje">36.00</td>
                </tr>
                <tr>
                    <td class="td-cfh">CF001231123</td>
                    <td class="td-mc">Amoxicillin</td>
                    <td class="td-gg">2g*10 viên</td>
                    <td class="td-lsj">18.00 đồng/hộp</td>
                    <td class="td-sl">2</td>
                    <td class="td-zje">36.00</td>
                </tr>
                <tr>
                    <td class="td-cfh">CF001231123</td>
                    <td class="td-mc">Amoxicillin</td>
                    <td class="td-gg">2g*10 viên</td>
                    <td class="td-lsj">18.00 đồng/hộp</td>
                    <td class="td-sl">2</td>
                    <td class="td-zje">36.00</td>
                </tr>
                <tr>
                    <td class="td-cfh">CF001231123</td>
                    <td class="td-mc">Amoxicillin</td>
                    <td class="td-gg">2g*10 viên</td>
                    <td class="td-lsj">18.00 đồng/hộp</td>
                    <td class="td-sl">2</td>
                    <td class="td-zje">36.00</td>
                </tr>
                <tr>
                    <td colspan="5" class="td-hj">tổng cộng: </td>
                    <td class="td-hj">144.00</td>
                </tr>
            </table>
        </div>
        <div class="dv-end clearfix">
            <table>
                <tr>
                    <td><span>配药员: </span><span>张爱玲</span></td>
                    <td><span>phát thuốc viên: </span><span>李丽华</span></td>
                    <td><span>duyệt viên: </span><span>吴昊</span></td>
                    <td><span>医师: </span><span>隋季</span></td>
                </tr>
                <tr>
                    <td colspan="3"><span style="margin-right:20px;">chú: 药品当面点清, 一旦发出不得退药!</span></td>
                    <td>
                        <span>xếp thuốc ngày: </span>
                        <span>2018-12-20</span>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</body>
<input type="button" id="btn_print" value="in" />
<script>
    $(function () {
        $("#btn_print").click(function () {
            print();
        });
    });
    function print() {
        var strHTML = $("#b_fyd").prop("outerHTML");
        LODOP.PRINT_INITA(1, 1, 770, 660, "");
        LODOP.ADD_PRINT_TEXT(10, 60, 300, 200, "");
        LODOP.ADD_PRINT_HTM(30, 5, "100%", "80%", strHTML);
        LODOP.PRINT();
    }
</script>

@{
    ViewBag.Title = "PriceAdjustmentHistory";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<form id="form1">
    <div class="panel panel-default">
        <div class="panel-heading">
            điều kiện lọc
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle">từ khóa</th>
                    <td class="formValue">
                        <input type="text" id="txtINPUTCODE" class="form-control" placeholder="mã thuốc phiên âm tên" />
                    </td>
                    <th class="formTitle">thời gian thực hiện</th>
                    <td class="formValue">
                        <input id="txtStartTime" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.AddDays(-31).ToString("yyyy-MM-dd 00:00:00")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                    </td>
                    <th class="formTitle">đến</th>
                    <td class="formValue">
                        <input id="txtEndTime" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                    </td>
                    <td class="formValue">
                        <input type="button" id="btn_search" class="btn btn-primary btn-md" value="tra cứu" style="width:55px;margin-left:30%;" />
                    </td>
                </tr>
            </table>
        </div>       
    </div>
    <div class="gridPanel" style="margin-top:10px;">
        <table id="gridYPInfoList"></table>
        <div id="gridPager" rel="form1"></div>
    </div>
</form>

<script>
    $(function () {
        gridYPInfoList();
    });

    function gridYPInfoList() {
        var $gridYPInfoList = $("#gridYPInfoList");
        $gridYPInfoList.dataGrid({
            url: "/DrugStorage/SelectMedicineAdjustPriceHistoryInfoList",
            height: $(window).height() - document.getElementById('gridYPInfoList').offsetTop - 85,
            colModel: [
                { label: 'mã thuốc', name: 'ypcode', width: 100, align: 'left' },
                { label: 'tên thuốc', name: 'ypmc', width: 100, align: 'left' },
                { label: 'quy cách thuốc', name: 'ypgg', width: 100, align: 'left' },
                { label: 'đơn vị định giá', name: 'djdw', width: 100, align: 'left' },
                { label: 'mới giá bán buôn', name: 'pfj', width: 100, align: 'left' },
                { label: 'mới giá bán lẻ', name: 'lsj', width: 100, align: 'left' },
                { label: 'giá bán buôn gốc', name: 'ypfj', width: 100, align: 'left' },
                { label: 'giá bán lẻ gốc', name: 'ylsj', width: 100, align: 'left' },
                { label: 'thuộc tính thuốc', name: 'tssxmc', width: 100, align: 'left' },
                { label: 'liều dùng', name: 'jl', width: 100, align: 'left' },
                { label: 'đơn vị liều dùng', name: 'jldw', width: 100, align: 'left' },
                { label: 'kho thuốc số lượng đóng gói', name: 'bzs', width: 100, align: 'left' },
                { label: 'kho thuốc đơn vị đóng gói', name: 'bzdw', width: 100, align: 'left' },
                { label: 'số tách lẻ ngoại trú', name: 'mzcls', width: 100, align: 'left' },
                { label: 'đơn vị tách lẻ ngoại trú', name: 'mzcldw', width: 100, align: 'left' },
                { label: 'số tách lẻ nội trú', name: 'zycls', width: 100, align: 'left' },
                { label: 'đơn vị tách lẻ nội trú', name: 'zycldw', width: 100, align: 'left' },
                { label: 'tỷ lệ tự chi trả', name: 'zfbl', width: 100, align: 'left' },
                { label: 'tính chất tự chi trả', name: 'zfxz', width: 100, align: 'left' },
                { label: 'dạng bào chế', name: 'jxmc', width: 100, align: 'left' },
                { label: 'nhà sản xuất', name: 'ycmc', width: 100, align: 'left' },
                { label: 'trạng thái', name: 'mzzybz', width: 100, align: 'left' },
                { label: 'ghi sổ loại', name: 'jzlx', width: 100, align: 'left' },
                { label: 'mặc định hạn bảo quản', name: 'mrbzq', width: 100, align: 'left' },
                { label: 'thực hiện tệp', name: 'tzwj', width: 100, align: 'left' },
                { label: 'người thao tác', name: 'zxry', width: 100, align: 'left' },
                { label: 'điều chỉnh thời gian', name: 'tzsj', width: 150, align: 'left', formatter: 'date', formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
            ],
            multiselect: false,
            pager: "#gridPager",
            sortname: 'zxsj desc',
            viewrecords: true,

        });

        $("#btn_search").click(function () {
            if ($("#txtStartDate").val() > $("#txtEndDate").val()) {
                $.modalAlert("ngày bắt đầu muộn hơn ngày kết thúc", 'warning');
                return;
            }

            $gridYPInfoList.jqGrid('setGridParam', {
                postData: getSearchPostData(), url: '/DrugStorage/SelectMedicineAdjustPriceHistoryInfoList',
            }).trigger('reloadGrid');
        });
    }
    //điều kiện tra cứu
    function getSearchPostData() {
        var inputCode = $("#txtINPUTCODE").val();
        var startTime = $("#txtStartTime").val();
        var endTime = $("#txtEndTime").val();
        return { inputCode: inputCode, startTime: startTime, endTime: endTime };
    };
</script>




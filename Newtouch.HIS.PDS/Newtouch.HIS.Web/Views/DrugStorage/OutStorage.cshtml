
@{
    ViewBag.Title = "OutStorage";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    .req {
        color: red;
    }
</style>
<form id="form1">
    <div class="panel panel-default">
        <div class="panel-heading">
            xuất kho thông tin
        </div>
        <div style="padding-right:10px;">
            <table class="form">
                <tr>
                    <th class="formTitle">xuất kho đơn số: </th>
                    <td class="formValue">
                        <input id="txtCKDH" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle"><span class="req">*</span>số hóa đơn: </th>
                    <td class="formValue">
                        <input id="txtFPH" type="text" class="form-control" onchange="ChangeFPH()" placeholder="số hóa đơn" />
                    </td>
                    <th class="formTitle">xuất kho phương thức: </th>
                    <td class="formValue">
                        <select id="ddlCKFS" class="form-control required"></select>
                    </td>
                    <th class="formTitle">ngày lập hóa đơn: </th>
                    <td class="formValue">
                        <input id="txtKPRQ" type="text" class="form-control input-wdatepicker newtouch_Readonly" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">mã nhà cung cấp: </th>
                    <td class="formValue">
                        <input id="txtGYSCODE" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">tên nhà cung cấp: </th>
                    <td class="formValue">
                        <input id="txtGYSMC" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">xuất kho tổng mức(đồng): </th>
                    <td class="formValue">
                        <input id="txtCKZE" type="text" class="form-control newtouch_Readonly" />
                    </td>
                </tr>
            </table>
        </div>
        <div class="panel-heading">
            chi tiết thuốc
        </div>
        <div id="divYPMX" style="padding-right:10px;">
            <table class="form">
                <tr>
                    <th class="formTitle"><span class="req">*</span>mã thuốc: </th>
                    <td class="formValue">
                        <input id="editRowId" value="" style="display:none;" />
                        <input id="txtSRM" type="text" class="form-control" placeholder="mã tên phiên âm tên hàng hóa" />
                    </td>

                    <th class="formTitle" id="txtCKSLDW"><span class="req">*</span>số lượng xuất kho: </th>
                    <td class="formValue">
                        <div class="row">
                            <div class="col-md-8">
                                <input id="txtCKSL" type="text" class="form-control" onchange="CKSL_Leave()" />
                            </div>
                            <div class="col-md-4">
                                <select id="ddlCKDW" class="form-control required" onchange="CKSL_Leave()"></select>
                                <input id="kxdw" hidden="hidden" />
                            </div>
                        </div>
                    </td>
                    <th class="formTitle"><span class="req">*</span>xuất kho số tiền(đồng): </th>
                    <td class="formValue">
                        <input id="txtCKJE" type="text" class="form-control" onchange="CKJE_Leave()" />
                    </td>
                    <th class="formTitle">lý do trả hàng: </th>
                    <td class="formValue">
                        <input id="txtTHYY" type="text" class="form-control" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">xử lý kết quả: </th>
                    <td class="formValue">
                        <input id="txtCLJG" type="text" class="form-control" />
                    </td>
                    <th class="formTitle">hạn sử dụng: </th>
                    <td class="formValue">
                        <input id="txtYXQ" type="text" class="form-control input-wdatepicker newtouch_Readonly" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    </td>
                    <th class="formTitle">tồn kho khả dụng: </th>
                    <td class="formValue">
                        <input id="txtKYKC" type="text" class="form-control newtouch_Readonly" />
                        <input id="hidden_kcsl" type="text" hidden="hidden" />
                    </td>
                    <th class="formTitle">quy cách: </th>
                    <td class="formValue">
                        <input id="txtGG" type="text" class="form-control newtouch_Readonly" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">tên thuốc: </th>
                    <td class="formValue">
                        <input id="txtYPMC" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle" id="thPFJDW">giá bán buôn(đồng): </th>
                    <td class="formValue">
                        <input id="txtPFJ" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle" id="thLSJDW">giá bán lẻ(đồng): </th>
                    <td class="formValue">
                        <input id="txtLSJ" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle" id="thJJDW">xuất kho đơn giá(đồng): </th>
                    <td class="formValue">
                        <input id="txtCKDJ" type="text" class="form-control newtouch_Readonly" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">tỷ lệ chiết khấu(%): </th>
                    <td class="formValue">
                        <input id="txtKL" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle" id="thPFZEDW">tiền bán buôn(đồng): </th>
                    <td class="formValue">
                        <input id="txtPFZE" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle" id="thLSZEDW">tiền bán lẻ(đồng): </th>
                    <td class="formValue">
                        <input id="txtLSZE" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">số giấy phép: </th>
                    <td class="formValue">
                        <input id="txtPZWH" type="text" class="form-control newtouch_Readonly" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">số lô: </th>
                    <td class="formValue">
                        <input id="txtPH" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">lô: </th>
                    <td class="formValue">
                        <input id="txtPC" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">ngày sản xuất: </th>
                    <td class="formValue">
                        <input id="txtscrq" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">hệ số chuyển đổi: </th>
                    <td class="formValue">
                        <input id="txtzhyz" type="text" class="form-control newtouch_Readonly" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</form>

@Html.Partial("_MiddleButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 2, 3, 6 },
    F2Text = "thêm",
    F3Text = "sửa",
    F6Text = "xóa"
})

<div class="gridPanel">
    <table id="gridCKMX"></table>
    <div id="gridPager" rel="form1"></div>
</div>

@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 7, 8 },
    F7Text = "mới xuất kho",
    F8Text = "xuất kho"
})

<script>
    window.newtouch_globalconfig.f4opions = {
        container: "#divYPMX"
    };

    $(function () {
        //tải lại khi thay đổi kích thước cửa sổ trình duyệt jqGrid chiều rộng
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });
        initialCKFS();//tải xuất kho phương thức
        initialCKDH();//tải xuất kho đơn số
        gridCKMX([]);
    });

    //xuất kho phương thức
    function initialCKFS() {
        $("#ddlCKFS").bindSelect({
            url: "/MedicineStorageIOMode/MedicineStorageIOModeList?crkbz=1",
        });
    }

    //tải xuất kho đơn số
    function initialCKDH() {
        $.najax({
            url: "/DrugStorage/initialCKDH?r=" + Math.random(),
            dataType: "text",
            async: false,
            success: function (data) {
                $("#txtCKDH").val(data);
            }
        });
    }

    //số hóa đơn
    $("#txtFPH").newtouchBatchFloatingSelector({
        clickautotrigger: true,
        height: 300,
        width: 550,
        id: 'initialFPH',
        url: '/DrugStorage/SelectMedicineListByFPH',
        ajaxmethod: 'POST',
        ajaxreqdata: function () {
            var reqData = {};
            reqData.fph = $("#txtFPH").val();
            return reqData;
        },
        caption: "hóa đơn thông tin",
        colModel: [
            { label: 'số hóa đơn', name: 'fph', width: 110 },
            { label: 'ngày lập hóa đơn', name: 'kprq', width: 80 },
            { label: 'mã nhà cung cấp', name: 'gysCode', width: 100 },
            { label: 'tên nhà cung cấp', name: 'gysmc', width: 180, align: 'left' }
        ],
        itemdbclickhandler: function ($thistr) {
            $("#txtFPH").val($thistr.attr('data-fph'));
            $("#txtKPRQ").val($thistr.attr('data-kprq'));
            $("#txtGYSCODE").val($thistr.attr('data-gysCode'));
            $("#txtGYSMC").val($thistr.attr('data-gysmc'));
            return;
        }

    });

    //mã nhập
    $("#txtSRM").newtouchBatchFloatingSelector({
        clickautotrigger: true,
        height: 350,
        width: 1080,
        id: 'initialSRM',
        url: '/DrugStorage/SelectDepartmentMedicineList2',
        ajaxmethod: 'POST',
        inputtextcheck: function () {
            if ($("#txtFPH").val().replace(/(^\s*)|(\s*$)/g, "") === "") {   //loại bỏ khoảng trắng hai đầu
                $.modalAlert("vui lòng trước tiên chọn số hóa đơn", 'warning');
                return false;
            }
            return true;
        },
        ajaxreqdata: function () {
            var reqData = {};
            reqData.keyword = $("#txtSRM").val();
            reqData.fph = $("#txtFPH").val();
            reqData.gyscode = $("#txtGYSCODE").val();
            return reqData;
        },
        caption: "thông tin thuốc",
        colModel: [
            { label: 'loại', name: 'yplb', width: 60, align: 'center' },
            { label: 'tên', name: 'ypmc', width: 190, align: 'left' },
            { label: 'tồn kho', name: 'kykcstr', width: 100, align: 'center' },
            { label: 'quy cách', name: 'gg', width: 100, align: 'left' },
            { label: 'số lô', name: 'ph', width: 150, align: 'left' },
            { label: 'lô', name: 'pc', width: 150, align: 'left' },
            { label: 'nhập kho đơn giá', name: 'jj', width: 70, align: 'center' },
            { label: 'tỷ lệ chiết khấu', name: 'kl', width: 60, align: 'center' },
            { label: 'nhà sản xuất', name: 'sccj', width: 190, align: 'left' },
            { label: 'đơn vị', name: 'ykdw', hidden: true },
            { label: 'mã', name: 'ypCode', hidden: true },
            { label: 'ngày sản xuất', name: 'scrq', hidden: true },
            { label: 'số giấy phép', name: 'pzwh', hidden: true },
            { label: 'hạn sử dụng', name: 'yxq', hidden: true },
            { label: 'giá bán lẻ', name: 'lsj', hidden: true },
            { label: 'giá bán buôn', name: 'pfj', hidden: true },
            { label: 'zhyz', name: 'zhyz', hidden: true },
            { label: 'kcsl', name: 'kcsl', hidden: true },
            { label: 'kcId', name: 'kcId', hidden: true },
            { label: 'zxdw', name: 'zxdw', hidden: true },
            { label: 'bzs', name: 'bzs', hidden: true },
            { label: 'kykc', name: 'kykc', hidden: true }  //tồn kho khả dụng
        ],
        itemdbclickhandler: function ($thistr) {
            //$("#txtzhyz").val($thistr.attr('data-zhyz'));
            $("#txtzhyz").val($thistr.attr('data-bzs'));
            $("#txtSRM").attr('data-yplb', $thistr.attr('data-yplb')).attr('data-zhyz', $thistr.attr('data-bzs')).val($thistr.attr('data-ypCode'));
            $("#txtYPMC").attr('data-ykdw', $thistr.attr('data-ykdw')).attr('data-sccj', $thistr.attr('data-sccj')).val($thistr.attr('data-ypmc'));
            $("#thPFJDW").text("giá bán buôn(đồng/" + $thistr.attr('data-ykdw') + "):");
            $("#thLSJDW").text("giá bán lẻ(đồng/" + $thistr.attr('data-ykdw') + "):");
            //$("#thJJDW").text("giá nhập(đồng/" + $thistr.attr('data-ykdw') + "):");
            $("#txtGG").val($thistr.attr('data-gg'));
            $("#txtKYKC").attr('data-kcId', $thistr.attr('data-kcId')).attr('data-kykc', $thistr.attr('data-kykc')).val($thistr.attr('data-kykcstr'));
            $("#ddlCKDW").empty();
            var ykdw;
            if ($thistr.attr('data-ykdw') === $thistr.attr('data-zxdw')) {
                ykdw = $thistr.attr('data-ykdw');
                $("#ddlCKDW").append('<option value="ykdw">' + $thistr.attr('data-ykdw') + '</option>');   //đơn vị xuất kho
            } else {
                //ykdw = $thistr.attr('data-ykdw') + "," + $thistr.attr('data-zxdw');
                ykdw = $thistr.attr('data-ykdw');
                $("#ddlCKDW").append('<option value="ykdw">' + $thistr.attr('data-ykdw') + '</option>');
                //$("#ddlCKDW").append('<option value="zxdw">' + $thistr.attr('data-zxdw') + '</option>');
            }
            $("#kxdw").val(ykdw);   //đơn vị có thể chọn
            $("#txtYXQ").val($thistr.attr('data-yxq'));
            $("#txtPFJ").val($thistr.attr('data-pfj'));
            $("#txtLSJ").val($thistr.attr('data-lsj'));
            //$("#txtCKDJ").val($thistr.attr('data-jj'));
            $("#txtPZWH").val($thistr.attr('data-pzwh'));
            $("#txtPH").val($thistr.attr('data-ph'));
            $("#txtPC").val($thistr.attr('data-pc'));
            $("#hidden_kcsl").val($thistr.attr('data-kcsl'));
            $("#txtscrq").val($thistr.attr('data-scrq'));
            return;
        }

    });

    //số hóa đơn thay đổi, chi tiết thuốc div xóa sạch
    function ChangeFPH() {
        CleanInput();
    }

    //tải chi tiết
    function gridCKMX(mydata) {
        var $gridCkmx = $("#gridCKMX");
        $gridCkmx.newtouchLocalDataGrid({
            height: $(window).height() - 435,
            unwritten: false,
            colModel: [
                { label: 'loại', name: 'yplb', width: 60, align: 'left' },
                { label: 'số hóa đơn', name: 'fph', width: 80, align: 'left' },
                { label: 'tên thuốc', name: 'ypmc', width: 180, align: 'left' },
                { label: 'quy cách', name: 'gg', width: 80, align: 'left' },
                { label: 'số lượng', name: 'tusl', width: 70, align: 'left' },
                { label: 'đơn vị', name: 'dw', width: 60, align: 'left' },
                { label: 'tồn kho khả dụng', name: 'kykc', width: 80, align: 'left' },
                { label: 'số lô', name: 'ph', width: 120, align: 'left' },
                { label: 'lô', name: 'pc', width: 120, align: 'left' },
                { label: 'hạn sử dụng', name: 'yxq', width: 70, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'xuất kho đơn giá', name: 'jj', width: 100, align: 'left' },
                { label: 'giá bán buôn', name: 'pfj', width: 80, align: 'left' },
                { label: 'giá bán lẻ', name: 'lsj', width: 80, align: 'left' },
                {
                    label: 'xuất kho số tiền', name: 'zje', width: 80, align: 'left'
                    //formatter: function (val) {
                    //    return val.toFixed(4);
                    //}
                },
                { label: 'tỷ lệ chiết khấu', name: 'kl', width: 80, align: 'left' },
                { label: 'ngày lập hóa đơn', name: 'kprq', width: 70, align: 'left' },
                { label: 'số giấy phép', name: 'pzwh', width: 100, align: 'left' },
                { label: 'nhà sản xuất', name: 'sccj', width: 180, align: 'left' },
                { label: 'mã thuốc', name: 'ypdm', hidden: true },
                { label: 'Sl', name: 'Sl', hidden: true },
                { label: 'Thyy', name: 'Thyy', hidden: true },
                { label: 'Cljg', name: 'Cljg', hidden: true },
                { label: 'pfze', name: 'pfze', hidden: true },
                { label: 'lsze', name: 'lsze', hidden: true },
                { label: 'Ckzhyz', name: 'Ckzhyz', hidden: true },
                { label: 'kcId', name: 'kcId', hidden: true },
                { label: 'kxdw', name: 'kxdw', hidden: true },   //đơn vị có thể chọn
                { label: 'Ckbmkc', name: 'Ckbmkc', hidden: true }

            ],
            ondblClickRow: function (rowid) {
                gridDbclickRow(rowid);
            }
        }, mydata);
    }

    //nhấp đúp
    function gridDbclickRow(rowid) {
        if (rowid) {
            var getRowData = $("#gridCKMX").jqGrid('getRowData', rowid);
            if (getRowData) {
                $("#txtSRM").val(getRowData.ypdm);
                $("#txtFPH").val(getRowData.fph);
                $("#txtYPMC").val(getRowData.ypmc);
                $("#txtGG").val(getRowData.gg);

                var result = getRowData.kxdw.split(',');
                $("#ddlCKDW").empty();
                var sl;
                if (result[0] === getRowData.dw) {
                    $("#ddlCKDW").append('<option selected="selected" value="ykdw">' + result[0] + '</option>');
                    //$("#ddlCKDW").append('<option value="zxdw" >' + result[1] + '</option>');
                    sl = parseInt(getRowData.Sl);
                } else {
                    $("#ddlCKDW").append('<option value="ykdw">' + result[0] + '</option>');
                    //$("#ddlCKDW").append('<option selected="selected" value="zxdw" >' + result[1] + '</option>');
                    sl = parseInt(getRowData.Sl) * parseInt(getRowData.Ckzhyz);
                }
                $("#txtCKSL").val(sl);
                $("#txtKYKC").val(getRowData.kykc);
                $("#txtPH").val(getRowData.ph);
                $("#txtPC").val(getRowData.pc);
                $("#txtYXQ").val(getRowData.yxq);
                $("#txtCKDJ").val(getRowData.ckdj);
                $("#txtPFJ").val(getRowData.pfj);
                $("#txtLSJ").val(getRowData.lsj);
                $("#txtCKJE").val(getRowData.zje);
                $("#txtKL").val(getRowData.kl);
                $("#txtKPRQ").val(getRowData.kprq);
                $("#txtPZWH").val(getRowData.pzwh);
                $("#txtPFZE").val(getRowData.pfze);
                $("#txtLSZE").val(getRowData.lsze);
                $("#txtPFZE").val(getRowData.pfze);
                $("#txtLSZE").val(getRowData.lsze);
                $("#hidden_kcsl").val(parseInt(getRowData.Ckbmkc) * parseInt(getRowData.Ckzhyz));

                $('#editRowId').val(rowid);
            }
        }
    }

    //mới xuất kho
    function newtouch_event_f7() {
        initialCKDH();//đổi số phiếu
        EnabledSysBasicInfo();//kích hoạt
        CleanInput();//xóa chi tiết
    }

    //tải bằng phím Enter grid
    $('#txtCLJG').keydownEnterEvent(function () {
        if ($('#editRowId').val()) {            //là sửa đổi
            newtouch_event_f3();    //mô phỏng nút sửa nhấp
        }
        else {
            newtouch_event_f2();    //mô phỏng xác nhận nút nhấp
        }
    });

    //lấy chi tiết
    function getEditRowData() {
        var sl;
        if ($("#ddlCKDW").find("option:selected").text() === $("#txtYPMC").attr('data-ykdw')) {
            sl = parseInt($("#txtCKSL").val());
        } else {
            sl = parseInt($("#txtCKSL").val()) / parseInt($("#txtSRM").attr('data-zhyz'));
        }
        var ckbmkc = parseInt(parseInt($("#hidden_kcsl").val()) / parseInt($("#txtSRM").attr('data-zhyz')));
        return [{
            yplb: $("#txtSRM").attr('data-yplb'),
            fph: $("#txtFPH").val(),
            ypdm: $("#txtSRM").val(),
            ypmc: $("#txtYPMC").val(),
            gg: $("#txtGG").val(),
            Sl: sl,   //số lượng lưu cuối cùng vào cơ sở dữ liệu
            tusl: $("#txtCKSL").val(),   //đăng xuất số lượng
            dw: $("#ddlCKDW").find("option:selected").text(),
            kxdw: $("#kxdw").val(),
            kykc: $("#txtKYKC").val(),
            ph: $("#txtPH").val(),
            pc: $("#txtPC").val(),
            yxq: $("#txtYXQ").val(),
            jj: $("#txtCKDJ").val(),
            pfj: $("#txtPFJ").val(),
            lsj: $("#txtLSJ").val(),
            zje: $("#txtCKJE").val(),
            kl: $("#txtKL").val(),
            kprq: $("#txtKPRQ").val(),
            pzwh: $("#txtPZWH").val(),
            sccj: $("#txtYPMC").attr('data-sccj'),
            Thyy: $("#txtTHYY").val(),
            Cljg: $("#txtCLJG").val(),
            Ckzhyz: $("#txtSRM").attr('data-zhyz'),
            pfze: $("#txtPFZE").val(),
            lsze: $("#txtLSZE").val(),
            kcId: $("#txtKYKC").attr('data-kcId'),
            Ckbmkc: ckbmkc
        }];
    }

    //thêm nút
    function newtouch_event_f2() {
        //kiểm tra dữ liệu
        if (!CheckData()) {
            return false;
        }
        //lấy chi tiết
        var data = getEditRowData();
        //kiểm tra mục trùng lặp
        var isRepeatedAdd = false;
        $.each($("#gridCKMX").getDataIDs(), function () {
            var rowData = $("#gridCKMX").jqGrid('getRowData', this);
            if (rowData.ypdm === data[0].ypdm && rowData.ph === data[0].ph && rowData.pc === data[0].pc) {
                isRepeatedAdd = true;
            }
        });

        if (isRepeatedAdd) {
            $.modalAlert("không được thêm trùng lặp", 'warning');
            return false;
        }
        $("#gridCKMX").newtouchLocalDataGrid(null, data);
        ComputeCKZE();//tính xuất kho số tiền
        DisableControls();//vô hiệu hóa
        CleanInput();//xóa chi tiết
    }

    //nút sửa
    function newtouch_event_f3() {
        if ($('#editRowId').val()) {
            //kiểm tra dữ liệu
            if (!CheckData()) {
                return false;
            }
            //lấy chi tiết
            var data = getEditRowData();

            $('#gridCKMX').jqGrid("delRowData", $('#editRowId').val()); //trước tiên remove xóa dòng đó
            //kiểm tra mục trùng lặp
            var isRepeatedAdd = false;
            $.each($("#gridCKMX").getDataIDs(), function () {
                var rowData = $("#gridCKMX").jqGrid('getRowData', this);
                if (rowData.ypdm === data[0].ypdm && rowData.ph === data[0].ph && rowData.pc === data[0].pc) {
                    isRepeatedAdd = true;
                }
            });
            if (isRepeatedAdd) {
                $.modalAlert("thêm trùng lặp", 'warning');
                return false;
            }
            $("#gridCKMX").newtouchLocalDataGrid(null, data);
            ComputeCKZE();//tính xuất kho số tiền
            DisableControls();//vô hiệu hóa
            CleanInput();//xóa chi tiết
        }
        else {
            //lấy grid dòng hiện đang được chọn
            var seleId = $('#gridCKMX').jqGrid('getGridParam', 'selrow');
            if (seleId) {
                //yêu cầu sửa dòng này
                gridDbclickRow(seleId);
            }
        }
        CleanInput();
    }

    //xóa
    function newtouch_event_f6() {
        var delRowid = $("#gridCKMX").jqGrid('getGridParam', 'selrow');
        if (!delRowid) {
            $.modalAlert("chưa chọn dòng", 'warning');
            return;
        }
        $('#gridCKMX').jqGrid('delRowData', delRowid);
        ComputeCKZE();//tính tổng tiền nhập kho
        //kích hoạt
        //EnabledSysBasicInfo();
        CleanInput();
    }

    //xuất kho
    function newtouch_event_f8() {
        var crkdj = Object();
        crkdj.pdh = $("#txtCKDH").val();
        crkdj.rkbm = $("#txtGYSCODE").val();
        crkdj.crkfsdm = $("#ddlCKFS").val();
        var djmx = $("#gridCKMX").jqGrid('getRowData_AllLine');
        if (djmx == null || djmx.length <= 0) {
            $.modalAlert("vui lòng trước tiên thêm xuất kho thông tin", 'warning');
            return;
        }
        $.najax({
            url: "/DrugStorage/SaveOutStorageInfo",
            dataType: "json",
            data: { crkdj: crkdj, crkdjmx: djmx },
            type: "POST",
            async: false,
            success: function (res) {
                if (res.state === "success") {
                    $.modalAlert("xuất kho thành công", 'success');
                    newtouch_event_f7();//ra nhập kho: mới số chứng từ chính dữ liệu xóa sạch chi tiết xóa sạch
                    $('#gridCKMX').jqGrid("clearGridData");//xóa sạch Grid
                } else {
                    $.modalAlert(res.message, 'error');
                }

            }
        });
    }

    //xóa sạch inputthẻ
    function CleanInput() {
        $("#txtSRM").val("");
        $("#txtCKSL").val("");
        $("#txtKYKC").val("");
        $("#txtPH").val("");
        $("#txtPC").val("");
        $("#txtCKDJ").val("");
        $("#txtPFJ").val("");
        $("#txtLSJ").val("");
        $("#txtCKJE").val("");
        $("#txtKL").val("");
        //$("#txtKPRQ").val("");
        $("#txtPZWH").val("");
        $("#txtPFZE").val("");
        $("#txtLSZE").val("");
        $("#txtPFZE").val("");
        $("#txtLSZE").val("");
        $("#hidden_kcsl").val("");
        $('#editRowId').val("");
        $("#ddlCKDW").empty();
        //$("#txtFPH").val("");
        //$("#txtGYSMC").val("");
        //$("#txtCKZE").val("");
        $("#txtTHYY").val("");
        $("#txtYXQ").val("");
        $("#txtzhyz").val("");
        $("#txtGG").val("");
        $("#txtYPMC").val("");
        $("#txtCLJG").val("");
    }

    //số lượng mất tiêu điểm,tính tiền bán buôn tiền bán lẻ
    function CKSL_Leave() {
        if ($("#txtCKSL").val() === "") {
            return false;
        }
        if (isNaN($("#txtCKSL").val())) {
            $.modalAlert("lỗi định dạng số lượng", 'warning');
            return false;
        }
        var Sl;
        var pfj = parseFloat($("#txtPFJ").val());
        var lsj = parseFloat($("#txtLSJ").val());
        if ($("#ddlCKDW").find("option:selected").text() === $("#txtYPMC").attr('data-ykdw')) {    //nếu chọn của có thể trả đơn vị: đơn vị kho thuốc số lượng=nhập số lượng, tiền bán buôn=số lượng*giá bán buôn, tiền bán lẻ=số lượng*giá bán lẻ
            Sl = parseFloat($("#txtCKSL").val());
        } else {   //có thể trả đơn vị: đơn vị nhỏ nhất, số lượng=nhập số lượng/hệ số chuyển đổi, tiền bán buôn=số lượng*giá bán buôn, tiền bán lẻ=số lượng*giá bán lẻ
            Sl = window.roundingBy4she6ru5chengshuang(parseFloat($("#txtCKSL").val()) / parseFloat($("#txtSRM").attr('data-zhyz')), 4);
        }

        $("#thPFZEDW").text("tổng tiền bán buôn(đồng/" + $("#ddlCKDW").find("option:selected").text() + "):");
        $("#thLSZEDW").text("tổng tiền bán lẻ(đồng/" + $("#ddlCKDW").find("option:selected").text() + "):");
        $("#txtPFZE").val((pfj * Sl).toFixed(4));
        $("#txtLSZE").val((lsj * Sl).toFixed(4));
        CKJE_Leave();//Tính lại đơn giá xuất kho
        ComputeKL();//tính tỷ lệ chiết khấu
        return false;
    }

    //xuất kho số tiền mất tiêu điểm,tính xuất kho đơn giá
    function CKJE_Leave() {
        if (isNaN($("#txtCKJE").val())) {
            $.modalAlert("出库金额格式错误", 'warning');
            return false;
        }
        if ($("#txtCKJE").val() === "") {
            return false;
        }
        if ($("#txtCKSL").val() === "") {
            return false;
        }
        var Sl;
        if ($("#ddlCKDW").find("option:selected").text() === $("#txtYPMC").attr('data-ykdw')) {    //nếu chọn của có thể trả đơn vị: đơn vị kho thuốc số lượng=nhập số lượng

            Sl = parseFloat($("#txtCKSL").val());
        } else {   //có thể trả đơn vị: đơn vị nhỏ nhất, số lượng=nhập số lượng/hệ số chuyển đổi
            Sl = window.roundingBy4she6ru5chengshuang(parseFloat($("#txtCKSL").val()) / parseFloat($("#txtSRM").attr('data-zhyz')), 4);
        }

        var ckje = parseFloat($("#txtCKJE").val());
        var jj = (Sl === 0 ? 0 : window.roundingBy4she6ru5chengshuang((ckje / Sl), 4));
        $("#txtCKDJ").val(parseFloat(jj).toFixed(4));

        ComputeKL();
    }

    //tính tỷ lệ chiết khấu
    function ComputeKL() {
        if ($("#txtCKDJ").val() === "") {
            return;
        }
        var pfj = parseFloat($("#txtPFJ").val());
        var jj = parseFloat($("#txtCKDJ").val());

        $("#txtKL").val(window.roundingBy4she6ru5chengshuang(pfj * 100 / jj, 4));  //làm tròn 5 bỏ 6 vào
    }

    //tính xuất kho tổng mức
    function ComputeCKZE() {
        var ckze = 0;
        var count = $("#gridCKMX").getGridParam('records');
        if (count > 0) {
            var rowIds = $("#gridCKMX").getDataIDs();
            for (var i = 0; i < rowIds.length; i++) {
                var getRowZje = $("#gridCKMX").getRowData(rowIds[i]).zje;
                ckze = parseFloat(ckze) + parseFloat(getRowZje);
            }
            //xuất kho số tiền
            $("#txtCKZE").val(ckze);
        } else {
            $("#txtCKZE").val('');
        }
    }

    //kiểm tra dữ liệu
    function CheckData() {
        if ($("#txtSRM").val() === "") {
            $.modalAlert("mã thuốc là trống", 'warning');
            return false;
        }
        if ($("#txtYPMC").val() === "") {
            $.modalAlert("tên thuốc là trống", 'warning');
            return false;
        }
        if ($("#txtCKSL").val() <= 0) {
            $.modalAlert("số lượng xuất kho cần lớn hơn 0", 'warning');
            return false;
        }
        if (!IsNum($("#txtCKJE").val()) || $("#txtCKJE").val() === "") {
            $.modalAlert("xuất kho số tiền là lớn hơn 0 của số", 'warning');
            return false;
        }
        if ($("#ddlCKDW").find("option:selected").text() === $("#txtYPMC").attr('data-ykdw')) {   //đơn vị kho thuốc Sl/zhyz
            var kykcsl = parseFloat($("#txtKYKC").attr('data-kykc')) / parseFloat($("#txtSRM").attr('data-zhyz'));
            if (parseFloat($("#txtCKSL").val()) > kykcsl) {   //so sánh số lượng (số lượng đơn vị nhỏ nhất)
                $.modalAlert("số lượng xuất kho lớn hơn tồn kho khả dụng", 'warning');
                return false;
            }
        } else {
            if (parseFloat($("#txtCKSL").val()) > parseFloat($("#txtKYKC").attr('data-kykc'))) {   //ngược lại, trực tiếp so sánh số lượng (số lượng đơn vị nhỏ nhất)
                $.modalAlert("số lượng xuất kho lớn hơn tồn kho khả dụng", 'warning');
                return false;
            }
        }
        return true;
    }

    function IsNum(value) {
        var patrn = /^(-)?\d+(\.\d+)?$/;
        if (patrn.exec(value) == null || value === "") {
            return false;
        } else {
            return true;
        }
    }

    //vô hiệu hóa
    function DisableControls() {
        $("#txtFPH").attr("disabled", "disabled").css("background-color", "rgb(238, 238, 238)");
        $("#ddlCKFS").attr("disabled", "disabled").css("background-color", "rgb(238, 238, 238)");
    }

    //kích hoạt
    function EnabledSysBasicInfo() {
        $("#txtFPH").removeAttr("disabled").removeAttr("style");
        $("#ddlCKFS").removeAttr("disabled").removeAttr("style");
    }
</script>

@using Newtouch.Infrastructure;
@using Newtouch.HIS.Web.Core.Extensions;
@{
    ViewBag.Title = "ApplyDelivery";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<style>
    .txt-ffsl {
        height: 18px;
        line-height: 20px;
        margin: 3px !important;
        width: 80px;
    }

    .form-control {
        padding: 0 3px;
    }
</style>

<form id="form1" style="overflow-x: hidden;">
    <div class="panel panel-default" style="margin-bottom: 5px;">
        <div class="panel-heading">thông tin lọc</div>
        <table class="form">
            <tr>
                <td class="formTitle">số phiếu lĩnh: </td>
                <td class="formValue"><input type="text" id="sldh" name="sldh" class="form-control" placeholder="vui lòng nhập số phiếu lĩnh" /></td>
                <td class="formTitle">bộ phận lĩnh: </td>
                <td class="formValue"><input type="text" id="slbm" name="slbm" class="form-control" placeholder="vui lòng nhập bộ phận lĩnh" /></td>
                <th class="formTitle" style="width: 75px;padding-right: 0;">ngày: </th>
                <td class="formValue" style="width:130px;">
                    <input id="txtStartDate" type="text" class="form-control input-wdatepicker " value="@DateTime.Now.AddDays(-31).ToString("yyyy-MM-dd 00:00")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm' })" />
                </td>
                <th class="formTitle" style="width: 35px;padding-right: 0;">đến: </th>
                <td class="formValue" style="width:130px;">
                    <input id="txtEndDate" type="text" class="form-control input-wdatepicker " value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm' })" />
                </td>
                <td class="formTitle">trạng thái phát thuốc: </td>
                <td class="formValue">
                    @Html.DropDownList("ffzt", EnumSLDDeliveryStatus.None.ToDescSelectList((int)EnumSLDDeliveryStatus.None), "tất cả", new { @class = "form-control" })
                </td>
                <td class="formTitle">
                    <input type="button" class="btn btn-primary btn-md" value="tra cứu" id="btn_search" />
                </td>
            </tr>
        </table>
    </div>
    <div id="dv_right" style="float: left; margin-left: 305px;">
        <table id="MedicineGridList"></table>
        <div id="gridPager2" rel="form1"></div>
        @Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
   {
       ShowKeyList = new[] { 8 },
       F8Text = "phát thuốc"
   })
    </div>
    <div id="dv_left" class="panel panel-default" style="float: left; width:300px; margin-left:-100%;">
        <table id="parentgridList"></table>
        <div id="gridPager1" rel="form1"></div>
    </div>
</form>
<script>
    var globalData = [];
    var medicineData = [];
    var lastRowId;
    var fymx = $(window).width() - $("#dv_left").width() - 5;
    var $MedicineGridList = $("#MedicineGridList");

    $(function () {
        initLayout();
        $(window).resize(function () {
            initLayout();
        });
        gridList();
        medicineGridList([]);
    });

    //tự thích ứng
    function initLayout() {
        $("#dv_right").width(fymx);
    }

    function gridList() {
        var $gridList = $("#parentgridList");
        $gridList.dataGrid({
            caption: "thông tin lĩnh",
            url: "/DrugStorage/RequestInfo",
            height: $(window).height() - 190,
            postData: $("#form1").formSerialize(),
            colModel: [
                {
                    label: 'trạng thái phát thuốc', name: 'ffzt', width: 50, align: 'left',
                    formatter: function (cellvalue) {
                        switch (cellvalue) {
                        case @((int)EnumSLDDeliveryStatus.None): return "chưa phát";
                        case @((int)EnumSLDDeliveryStatus.Part): return "đã phát một phần";
                        case @((int)EnumSLDDeliveryStatus.All): return "đã toàn phát";
                        case @((int)EnumSLDDeliveryStatus.Abandon): return "đã chấm dứt";
                        }
                    }
                },
                { label: "số phiếu lĩnh", name: "Sldh", width: 120, align: 'left' },
                { label: 'bộ phận lĩnh', name: 'Slbm', width: 55, align: 'left' },
                { label: 'thời gian lĩnh', name: 'CreateTime', width: 85, align: 'left', formatter: 'date', formatoptions: { srcformat: 'y-m-d H:i', newformat: 'y-m-d H:i' } },
                { label: 'tên bộ phận nhà thuốc', name: 'yfbmmc', width: 100, align: 'left' },
                {
                    label: 'chấm dứt', name: '', width: 40, align: 'center', formatter: function (cellvalue, options, rowObject) {//AbandonZT(" + arguments[1].rowId + ")
                        if (rowObject.ffzt === @((int)EnumSLDDeliveryStatus.Abandon)||rowObject.ffzt === @((int)EnumSLDDeliveryStatus.All)) {
                            return "";
                        }
                        return "<input type=\"button\" class=\"btn btn-default btn-md\" value=\"chấm dứt\" onclick=\"btn_Abandon('" + arguments[1].rowId + "'," + rowObject.ffzt + ");\" />";
                    }
                },
                { label: "khóa chính", name: "sldId", hidden: true, key: true },
                { label: "ffzt", name: "ffzt", hidden: true }
            ],
            pager: "#gridPager1",
            sortname: 'ffzt ,CreateTime desc',
            multiselect: true,
            viewrecords: false,
            beforeRequest: function () {
                $("#gridPager1_left").hide();
                $("#gridPager1_right").hide();
            },
            onSelectRow_page: function (rowid, status) {
                if (!status) {
                    var newMedicineData = [];
                    for (var i = 0; i < medicineData.length; i++) {
                        if (medicineData[i].sldId !== rowid) {
                            newMedicineData.push(medicineData[i]);
                        }
                    }
                    medicineData = [];
                    medicineData = newMedicineData;

                    if (medicineData.length === 0) {
                        $(".unwritten").show();
                    } else {
                        $(".unwritten").hide();
                    }
                    $MedicineGridList.jqGrid("clearGridData");
                    $MedicineGridList.newtouchLocalDataGrid(null, medicineData);
                    return;
                }
                var data = $("#parentgridList").jqGrid('getRowData', rowid);
                var sldId = data.sldId;
                if (data.ffzt === '@((int)EnumSLDDeliveryStatus.Abandon)') {
                    $("#jqg_parentgridList_" + rowid).hide();
                    $.modalAlert("nên dòng bản ghi đã chấm dứt", "warning");
                    return;
                } else if (data.ffzt === '@((int)EnumSLDDeliveryStatus.All)') {
                    $("#jqg_parentgridList_" + rowid).hide();
                    $.modalAlert("nên dòng bản ghi đã toàn phát thuốc", "warning");
                    return;
                }
                $.najax({
                    type: "Get",
                    url: "/DrugStorage/RequestMedicineInfo?sldId=" + sldId,
                    dataType: "json",
                    success: function (res) {
                        if (res != null && res.length > 0) {
                            for (var k = 0; k < res.length; k++) {
                                res[k].Slbm = data.Slbm;
                                medicineData.push(res[k]);
                            }
                            if (medicineData.length === 0) {
                                $(".unwritten").show();
                            } else {
                                $(".unwritten").hide();
                            }
                            $MedicineGridList.jqGrid("clearGridData");
                            $MedicineGridList.newtouchLocalDataGrid(null, medicineData);
                        }
                    }
                });
            }
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: $("#form1").formSerialize()
            }).trigger('reloadGrid');
            medicineData = [];
            $MedicineGridList.jqGrid("clearGridData");
            $MedicineGridList.trigger("reloadGrid");
        });
    }

    //chấm dứt
    function btn_Abandon(id, zt) {
        if (zt === @((int)EnumSLDDeliveryStatus.None) || zt === @((int)EnumSLDDeliveryStatus.Part)) {
            $.najax({
                url: "/DrugStorage/Abandonzt?id=" + id,
                dataType: "json",
                cache: false,
                success: function (res) {
                    if (res.state === "success") {
                        $.modalMsg("chấm dứt thành công!", 'success', 1000);
                    }
                    $("#parentgridList").resetSelection();
                    $("#parentgridList").trigger("reloadGrid");
                    $MedicineGridList.jqGrid("clearGridData");
                    $(".unwritten").show();
                }
            });
        }
    }

    function delpbj(arr, obj) {
        for (var i = 0; i < arr.length; i++) {
            if (arr[i].sldmxId === obj.sldmxId) {
                arr.splice(i, 1);
            }
        }
    }

    function medicineGridList() {
        $MedicineGridList.newtouchLocalDataGrid({
            autoScroll: true,
            caption: "thông tin thuốc",
            height: $(window).height() - 220,
            editurl: "clientArray",  //chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            colModel: [
                {
                    label: 'hiện tại phát số lượng', name: 'fysl', width: 55, align: 'center', editable: true, editwidth:"88%",
                    editrules: { integer: true }
                },
                { label: 'đơn vị', name: 'bzdw', width: 40, align: 'center' },
                { label: 'số lượng đã phát', name: 'yfslStr', width: 55, align: 'right' },
                { label: 'số lượng lĩnh', name: 'Sl', width: 55, align: 'right' },
                { label: 'tồn kho hiện có', name: 'kc', width: 80, align: 'center' },
                { label: 'tên thuốc', name: 'ypmc', width: 110, align: 'left' },
                { label: 'quy cách', name: 'ypgg', width: 80, align: 'left' },
                { label: 'nhà sản xuất', name: 'ycmc', width: 110, align: 'left' },
                { label: 'giá bán buôn', name: 'Pfj', width: 50, align: 'right' },
                { label: 'giá bán lẻ', name: 'Lsj', width: 50, align: 'right' },
                { label: 'tổng tiền bán buôn', name: 'Pjze', width: 50, align: 'right' },
                { label: 'tổng tiền giá lẻ', name: 'lsje', width: 50, align: 'right' },
                { label: "sldmxId", name: "sldmxId", hidden: true },
                { label: 'mã thuốc', name: 'Ypdm', hidden: true },
                { label: 'bộ phận lĩnh', name: 'Slbm', hidden: true },
                { label: 'hệ số chuyển đổi (đơn vị đóng gói)', name: 'zhyz', hidden: true },
                { label: 'số lượng lĩnh', name: 'Slsl', hidden: true },
                { label: 'số lượng đã phát', name: 'yfsl', hidden: true },
                { label: 'số lượng tồn kho', name: 'kcsl', hidden: true },
                { label: 'phiếu lĩnh ID', name: 'sldId', hidden: true }
            ],
            onSelectRow: function (rowid, status) {
                if (rowid && lastRowId && rowid !== lastRowId) {   //&&: tương đương với true/fase(đánh giá có hay không có giá trị)
                    $MedicineGridList.saveRow(lastRowId, function (result) {
                        // return false; //kiểm tra nhập nội dung có hay không hợp lệ, hủy lưu quay lại false    //không hiệu lực v.v. sửa chữa
                    }); //trước tiên lưu ở chỉnh sửa trạng thái của đó một dòng    //function checksave
                }
                //$("#" + rowid + "_fysl").attr("width", 50);
                lastRowId = rowid;
                $MedicineGridList.jqGrid('editRow', rowid, true, null, function (result) {
                    //return false; //kiểm tra nhập nội dung có hay không hợp lệ, hủy lưu quay lại false    //không hiệu lực v.v. sửa chữa
                }, null, null, function () {
                });
            },
            pager: "#gridPager2",
            sortname: 'ypmc desc',
            viewrecords: true
        });
    }

    //phát thuốc
    function newtouch_event_f8() {
        $MedicineGridList.saveRow(lastRowId, null, null, null, function (callbackRowId) {
        }, null, null);
        var kcInfoJsonSave = $MedicineGridList.jqGrid('getRowData_AllLine');
        var par = {};
        if (kcInfoJsonSave === [] || kcInfoJsonSave.length === 0) {
            $.modalAlert("phát thuốc thất bại,không có thông tin thuốc!", 'error');
            return false;
        }
        var dic = [];
        var json = kcInfoJsonSave;
        var flag = true;
        $.each(json, function (idx, obj) {
            var fysl = parseInt(obj.fysl) * parseInt(obj.zhyz);
            if (fysl > 0) {
                var maxfysl = parseInt(obj.Slsl) - parseInt(obj.yfsl);
                if (fysl - maxfysl > 0) {
                    $.modalAlert("【" + obj.ypmc + "】phát số lượng không có thể lớn hơn" + maxfysl / parseInt(obj.zhyz) + "！", 'warning');
                    flag = false;
                    $MedicineGridList.jqGrid('editRow', obj.jqRowId, true, null, function (result) {
                        //return false; //kiểm tra nhập nội dung có hay không hợp lệ, hủy lưu quay lại false    //không hiệu lực v.v. sửa chữa
                    }, null, null, function () { });
                    return false;
                } else if (parseInt(obj.kcsl) < fysl) {
                    $.modalAlert("【" + obj.ypmc + "】库存不足!", 'warning');
                    flag = false;
                    $MedicineGridList.jqGrid('editRow', obj.jqRowId, true, null, function (result) {
                        //return false; //kiểm tra nhập nội dung có hay không hợp lệ, hủy lưu quay lại false    //không hiệu lực v.v. sửa chữa
                    }, null, null, function () { });
                    return false;
                }
                var b = false;
                for (var i = 0; i < dic.length; i++) {
                    if (dic[i].key === obj.Slbm) {
                        dic[i].value.push(obj);
                        b = true;
                        break;
                    }
                }
                if (!b) {
                    dic.push({ 'key': obj.Slbm, 'value': [obj] });
                }
            }
        });
        if (!flag) return false;
        par["xtYpLsNbfymxk"] = dic;
        par["type"] =@((int)EnumDanJuLX.shenlingfayao);//phiếu lĩnh phát thuốc
        par["fyfs"] = @((int)EnumFyfs.Zcck);//bình thường xuất kho
        $.najax({
            type: "POST",
            url: "/DrugStorage/ExecHandOutMedicineByReq",
            data: par,
            dataType: "json",
            success: function (res) {
                medicineData = [];
                if (res.state === "success") {
                    $.modalMsg('phát thuốc thành công', 'success', 1000);
                    $("#parentgridList").resetSelection();
                    $("#parentgridList").trigger("reloadGrid");
                    $('#parentgridList').jqGrid("clearGridData");

                    $MedicineGridList.resetSelection();
                    $MedicineGridList.trigger("reloadGrid");
                    $MedicineGridList.jqGrid("clearGridData");
                } else if (res.state === "error") {
                    $.modalAlert(res.message, 'error');
                }
            }
        });
    }

</script>


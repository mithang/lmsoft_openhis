@{
    Layout = "~/Views/Shared/_Form.cshtml";
}
<script>
    $(function () {
        var storage = window.localStorage;
        var json = storage.getItem("mList");
        var jsonObj = JSON.parse(json);
        gridlist(jsonObj);
    });

    function gridlist(mList) {
        $("#gridlist").dataGrid({
            autoScroll: true,
            caption: "thông tin thuốc",
            height: 200,
            colModel: [
                { label: 'mã thuốc', name: 'ypCode', width: 50, align: 'left' },
                { label: "khóa chính", name: "sldmxId", hidden: true, key: true },
                { label: 'số phiếu lĩnh', name: 'sldh', width: 50, align: 'left', hidden: true, },
                 { label: 'phiên âm', name: 'py', width: 50, align: 'left', hidden: true, },
                 { label: 'số lô', name: 'Ph', width: 100, align: 'left' },
                 { label: 'số lô', name: 'pc', hidden: true, width: 50, align: 'left' },
                 { label: 'ngày hiệu lực', name: 'Yxrq', width: 120, align: 'left' },
                 { label: 'nhà sản xuất', name: 'ycmc', width: 100, align: 'left' },
                 { label: 'đơn vị', name: 'bzdw', width: 50, align: 'left' },
                { label: 'tên thuốc', name: 'ypmc', width: 150, align: 'left' },
                { label: 'giá bán buôn', name: 'Pfj', width: 50, align: 'left' },
                { label: 'giá bán lẻ', name: 'lsj', width: 50, align: 'left' },
                { label: 'số lượng lĩnh', name: 'Sl', width: 50, align: 'left' },
                { label: 'đã cấp phát số lượng', name: 'yfsl', align: 'left' },
                { label: 'cấp phát số lượng', name: 'ffsl', align: 'left' },
                { label: 'tổng tiền bán buôn', name: 'Pjze', width: 50, align: 'left' },
                 { label: 'tổng tiền giá lẻ', name: 'Ljze', width: 50, align: 'left' },
                 { label: 'hệ số chuyển đổi', name: 'Zhyz', align: 'left', hidden: true, }
            ],
            pager: "#gridPager",
            sortname: 'sldmxId desc',
            viewrecords: true
        });
        if (mList.length > 0) {
            $('.ui-jqgrid-bdiv').find(".unwritten").remove();
            for (var i = 0; i < mList.length; i++) {
                jQuery("#gridlist").jqGrid('addRowData', i + 1, mList[i]);
            }
            $("#gridList").trigger("reloadGrid");
        }
    }
</script>

<div class="gridPanel">
    <div style="margin-bottom:10px">
        <table id="gridlist"></table>
        <div id="gridPager" rel="form1"></div>
    </div>
</div>
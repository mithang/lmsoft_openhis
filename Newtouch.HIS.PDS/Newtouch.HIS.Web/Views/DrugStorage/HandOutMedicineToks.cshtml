    //kiểm tra đang chỉnh sửa của dữ liệu (chờ gửi)tính đầy đủ của
    function checkEditingRowData() {
        var validator = $('#form1').validate();
        validator.settings = {
            rules: {
                lybm: { required: true },
                lybmmc: { required: true },
                fyfs: { required: true },
                srm: { required: true },
                fysl: { required: true }
            },
            messages: {
                lybm: { required: "bộ phận lĩnh thuốc bắt buộc phải điền" },
                lybmmc: { required: "bộ phận lĩnh thuốc bắt buộc phải điền" },
                fyfs: { required: "phương thức phát thuốc bắt buộc chọn" },
                srm: { required: "mã thuốc không thể trống" },
                fysl: { required: "số lượng phát thuốc bắt buộc là đang số" }
            },
            showErrors: function (errorMap, errorList) {
                if (!$.isEmptyObject(errorList)) {
                    $.modalAlert(errorList[0].message, 'warning');
                }
            }
        };
        if (!validator.form()) {
            return false;
        }
        var bmsl = Number($("#fysl").val());
        var maxsl = Number($("#maxsl").val());
        if (bmsl > maxsl) {
            $("#fysl").val("");
            $("#fysl").focus();
            $.modalAlert("số lượng tối đa của lô này không được vượt quá " + maxsl + " ！", 'warning');
            return false;
        }
        else if (bmsl <= 0) {
            $.modalAlert("số lượng phát thuốc bắt buộc là đang số", 'warning');
        }
        return true;
    }

    function changeval(type) {
        globalpc = globalpc || [];
        var t = type === 'pc' ? 'yxq' : 'pc';
        var val = $("#" + type).val();
        for (var i = 0; i < globalpc.length; i++) {
            if (globalpc[i][type] === val) {
                $('#' + t).val(globalpc[i][t]);
                return;
            }
        }
    }


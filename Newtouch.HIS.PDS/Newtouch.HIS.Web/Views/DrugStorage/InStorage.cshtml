
@{
    ViewBag.Title = "InStorage";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    .req {
        color: red;
    }
</style>
<div id="all" style="position:fixed;top:0px;bottom:0px;">
    <form id="form1" style="overflow:auto;height:50%">
        <div class="panel panel-default" >
            <div class="panel-heading">
                nhập kho thông tin
            </div>
            <div style="padding: 2px;padding-right:10px;">
                <table class="form">
                    <tr>
                        <th class="formTitle">nhập kho đơn số: </th>
                        <td class="formValue">
                            <input id="txtRKDH" type="text" class="form-control newtouch_Readonly" />
                        </td>
                        <th class="formTitle"><span class="req">*</span>mã nhà cung cấp: </th>
                        <td class="formValue">
                            <input id="txtGYSCODE" type="text" class="form-control" onchange="ChangeGYSCODE()" placeholder="mã tên phiên âm" />
                        </td>
                        <th class="formTitle">tên nhà cung cấp: </th>
                        <td class="formValue">
                            <input id="txtGYSMC" type="text" class="form-control newtouch_Readonly" />
                        </td>
                        <th class="formTitle">ngày nhập kho: </th>
                        <td class="formValue">
                            <input id="txtRKRQ" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">phương thức nhập kho: </th>
                        <td class="formValue formDdlSelectorTd">
                            <select id="ddlRKFS" class="form-control required"></select>
                        </td>
                        <th class="formTitle">nhập kho tổng mức(đồng): </th>
                        <td class="formValue">
                            <input id="txtRKZE" type="text" class="form-control newtouch_Readonly" />
                        </td>
                    </tr>
                </table>
            </div>
            <div class="panel-heading">
                chi tiết thuốc
            </div>
            <div id="divYPMX" style="padding-right:10px;">
                <table class="form">
                    <tr>
                        <th class="formTitle"><span class="req">*</span>mã thuốc: </th>
                        <td class="formValue">
                            <input id="txtSRM" type="text" class="form-control" placeholder="mã tên phiên âm tên hàng hóa" />
                        </td>
                        <th class="formTitle"><span class="req">*</span>số lượng nhập kho: </th>
                        <td class="formValue">
                            <div class="row">
                                <div class="col-md-8">
                                    <input id="txtRKSL" type="text" class="form-control" onchange="RKSL_Leave()" />
                                </div>
                                <div class="col-md-4">
                                    <select id="ddlRKDW" class="form-control required" onchange="RKSL_Leave()"></select>
                                    <input id="kxdw" hidden="hidden" />
                                </div>
                            </div>
                        </td>
                        <th class="formTitle"><span class="req">*</span>số lô: </th>
                        <td class="formValue">
                            <input id="txtPH" type="text" class="form-control" />
                        </td>
                        <th class="formTitle"><span class="req">*</span>tổng tiền giá nhập: </th>
                        <td class="formValue">
                            <input id="txtJJZE" type="text" class="form-control" onchange="JJZE_Leave()" style="width: 75%;float: left;" />
                            <span style="float: left;line-height:24px;margin-left: 5px;">(đồng)</span>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">số hóa đơn: </th>
                        <td class="formValue">
                            <input id="txtFPH" type="text" class="form-control" />
                            <input id="editRowId" value="" style="display:none;" />
                        </td>
                        <th class="formTitle">ngày lập hóa đơn: </th>
                        <td class="formValue">
                            <input id="txtKPRQ" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        </td>
                        <th class="formTitle">hạn sử dụng: </th>
                        <td class="formValue">
                            <input id="txtYXQ" type="text" class="form-control input-wdatepicker" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" onblur="updatePC()" />
                        </td>
                        <th class="formTitle">ngày sản xuất: </th>
                        <td class="formValue">
                            <input id="txtSCRQ" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">nghiệm thu kết quả: </th>
                        <td class="formValue">
                            <input id="txtYSJG" type="text" class="form-control" />
                        </td>
                        <th class="formTitle">giao diện: </th>
                        <td class="formValue">
                            <input id="txtWG" type="text" class="form-control" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">tên thuốc: </th>
                        <td class="formValue">
                            <input id="txtYPMC" type="text" class="form-control newtouch_Readonly" />
                        </td>
                        <th class="formTitle" id="thPFJDW">giá bán buôn(đồng): </th>
                        <td class="formValue">
                            <input id="txtPFJ" type="text" class="form-control newtouch_Readonly" />
                        </td>
                        <th class="formTitle" id="thLSJDW">giá bán lẻ(đồng): </th>
                        <td class="formValue">
                            <input id="txtLSJ" type="text" class="form-control newtouch_Readonly" />
                        </td>
                        <th class="formTitle" id="thJJDW">giá nhập(đồng): </th>
                        <td class="formValue">
                            <input id="txtJJ" type="text" class="form-control newtouch_Readonly" />
                        </td>
                    </tr>
                    <tr>

                        <th class="formTitle">tỷ lệ chiết khấu(%): </th>
                        <td class="formValue">
                            <input id="txtKL" type="text" class="form-control newtouch_Readonly" />
                        </td>
                        <th class="formTitle" id="thPFZEDW">tổng tiền bán buôn(đồng): </th>
                        <td class="formValue">
                            <input id="txtPFZE" type="text" class="form-control newtouch_Readonly" />
                        </td>
                        <th class="formTitle" id="thLSZEDW">tổng tiền bán lẻ(đồng): </th>
                        <td class="formValue">
                            <input id="txtLSZE" type="text" class="form-control newtouch_Readonly" />
                        </td>
                        <th class="formTitle">số giấy phép: </th>
                        <td class="formValue">
                            <input id="txtPZWH" type="text" class="form-control newtouch_Readonly" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">tồn kho hiện có: </th>
                        <td class="formValue">
                            <input id="txtXYKC" type="text" class="form-control newtouch_Readonly" />
                            <input id="hidden_kcsl" type="text" hidden="hidden" />
                        </td>
                        <th class="formTitle">quy cách: </th>
                        <td class="formValue">
                            <input id="txtGG" type="text" class="form-control newtouch_Readonly" />
                        </td>
                        <th class="formTitle">lô: </th>
                        <td class="formValue">
                            <input id="txtPC" type="text" class="form-control newtouch_Readonly" />
                        </td>
                        <th class="formTitle">nhà sản xuất: </th>
                        <td class="formValue">
                            <input id="txtSCCJ" type="text" class="form-control newtouch_Readonly" />
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </form>
        @Html.Partial("_MiddleButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new[] { 2, 3, 6 },
    F2Text = "thêm",
    F3Text = "sửa",
    F6Text = "xóa"
})

        <div style="background-color: #fff;width:99%;">
            <table id="gridRKMX"></table>
        </div>

        @Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 7, 8 },
    F7Text = "đặt lại",
    F8Text = "đề nghị nhập kho"
})
</div>
<script>
    window.newtouch_globalconfig.f4opions = {
        container: "#divYPMX"
    };
    $(function () {
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
            $("#gridRKMX").setGridHeight($("#form1").height()-110);
        });
        gridRKMX([]);
        initialRKFS();//tải phương thức nhập kho
        initialYPGYS();//đăng ký thuốc nhà cung cấp của lớp nổi
        initialRKDH();//tải nhập kho đơn số
        $('#txtYXQ').val(Getyxq($("#txtSCRQ").val()));
    });

    //phương thức nhập kho
    function initialRKFS() {
        $("#ddlRKFS").bindSelect({
            url: "/MedicineStorageIOMode/MedicineStorageIOModeList?crkbz=0",
        });
    }

    //thuốc nhà cung cấp
    function initialYPGYS() {
        $("#txtGYSCODE").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            url: '/Medicine/MedicineSupplierList',
            height: 200,
            width: 500,
            caption: "thuốc nhà cung cấp",
            colModel: [
                { label: 'gysId', name: 'gysId', hidden: true },
                { label: 'mã nhà cung cấp', name: 'gysCode', widthratio: 40 },
                { label: 'tên nhà cung cấp', name: 'gysmc', widthratio: 40 }
            ],
            ajaxparameters: function () {
                return "keyword=" + $("#txtGYSCODE").val();
            },
            itemdbclickhandler: function ($thistr) {
                $("#txtGYSCODE").val($thistr.attr('data-gysCode'));
                $("#txtGYSMC").val($thistr.attr('data-gysmc'));
            }
        });
    }

    //tải nhập kho đơn số
    function initialRKDH() {
        $.najax({
            url: "/DrugStorage/initialRKDH?r=" + Math.random(),
            dataType: "text",
            async: false,
            success: function (data) {
                $("#txtRKDH").val(data);
            }
        });
    }

    //mã nhập
    $("#txtSRM").newtouchBatchFloatingSelector({
        clickautotrigger: true,
        height: 300,
        width: 1100,
        id: 'initialSRM',
        url: '/DrugStorage/SelectDepartmentMedicineList',
        ajaxmethod: 'POST',
        ajaxreqdata: function () {
            var reqData = {};
            reqData.keyword = $("#txtSRM").val();
            return reqData;
        },
        caption: "thông tin thuốc",
        colModel: [
            { label: 'loại', name: 'yplb', width: 50 },
            { label: 'mã', name: 'ypCode', width: 100 },
            { label: 'tên', name: 'ypmc', width: 200, align: 'left' },
            { label: 'quy cách', name: 'gg', width: 100, align: 'left' },
            { label: 'tồn kho', name: 'xykcstr', width: 70 },
            { label: 'đơn vị', name: 'ykdw', width: 60 },
            { label: 'nhà sản xuất', name: 'sccj', width: 200, align: 'left' },
            { label: 'số giấy phép', name: 'pzwh', width: 150, align: 'left' },
            { label: 'giá bán lẻ', name: 'lsj', width: 70 },
            { label: 'giá bán buôn', name: 'pfj', width: 70 },
            { label: 'bzs', name: 'bzs', hidden: true },
            { label: 'zxdw', name: 'zxdw', hidden: true },
            { label: 'xykc', name: 'xykc', hidden: true }
        ],
        itemdbclickhandler: function ($thistr) {
            $("#txtSRM").attr('data-yplb', $thistr.attr('data-yplb'))
                .attr('data-bzs', $thistr.attr('data-bzs'))
                .val($thistr.attr('data-ypCode'));
            $("#txtYPMC").attr('data-ykdw', $thistr.attr('data-ykdw'))
                .val($thistr.attr('data-ypmc'));
            $("#thPFJDW").text("giá bán buôn(đồng/" + $thistr.attr('data-ykdw') + "):");
            $("#thLSJDW").text("giá bán lẻ(đồng/" + $thistr.attr('data-ykdw') + "):");
            $("#thJJDW").text("giá nhập(đồng/" + $thistr.attr('data-ykdw') + "):");
            $("#txtGG").val($thistr.attr('data-gg'));
            $("#txtXYKC").val($thistr.attr('data-xykcstr'));
            $("#hidden_kcsl").val($thistr.attr('data-xykc'));
            $("#ddlRKDW").empty();
            var kxdw;
            //if ($thistr.attr('data-ykdw') === $thistr.attr('data-zxdw')) {
            //    kxdw = $thistr.attr('data-ykdw');
            //    $("#ddlRKDW").append('<option >' + $thistr.attr('data-ykdw') + '</option>'); //đơn vị xuất kho
            //} else {
            //    kxdw = $thistr.attr('data-ykdw') + "," + $thistr.attr('data-zxdw');
            //    $("#ddlRKDW").append('<option >' + $thistr.attr('data-ykdw') + '</option>');
            //    $("#ddlRKDW").append('<option >' + $thistr.attr('data-zxdw') + '</option>');
            //}
            $("#ddlRKDW").append('<option >' + $thistr.attr('data-ykdw') + '</option>');   //đơn vị xuất kho
            $("#kxdw").val(kxdw);   //đơn vị có thể chọn

            $("#txtSCCJ").val($thistr.attr('data-sccj'));
            $("#txtPZWH").val($thistr.attr('data-pzwh'));
            $("#txtLSJ").val(parseFloat($thistr.attr('data-lsj')).toFixed(4));
            $("#txtPFJ").val(parseFloat($thistr.attr('data-pfj')).toFixed(4));
            var date = new Date();
            var hours = date.getHours().toString();
            if (hours.length === 1) {
                hours = "0" + hours;
            }
            var minutes = date.getMinutes().toString();
            if (minutes.length === 1) {
                minutes = "0" + minutes;
            }
            var milliseconds = date.getMilliseconds().toString();
            if (milliseconds.length === 1) {
                milliseconds = milliseconds + "00";
            }
            else if (milliseconds.length === 2) {
                milliseconds = milliseconds + "0";
            }
            var currentTime = hours + minutes + milliseconds;
            $("#txtPC").val($("#txtYXQ").val().replace(/-/g, "").toString() + currentTime);

            return;
        }

    });

    //nhà cung cấp code thay đổi, chi tiết thuốc div xóa sạch
    function ChangeGYSCODE() {
        ClearRKMX();
    }

    //nhập kho chi tiết
    function gridRKMX(mydata) {
        var $gridRkmx = $("#gridRKMX");
        $gridRkmx.newtouchLocalDataGrid({
            height: $("#form1").height() - 110,
            unwritten: false,
            colModel: [
                { label: 'loại thuốc', name: 'yplb', width: 70, align: 'left' },
                { label: 'số hóa đơn', name: 'fph', width: 80, align: 'left' },
                { label: 'mã thuốc', name: 'ypdm', width: 70, align: 'left' },
                { label: 'tên thuốc', name: 'ypmc', width: 110, align: 'left' },
                { label: 'quy cách', name: 'gg', width: 80, align: 'left' },
                { label: 'số lượng', name: 'rksl', width: 60, align: 'left' },
                { label: 'đơn vị', name: 'dw', width: 60, align: 'left' },
                { label: 'số lô', name: 'ph', width: 100, align: 'left' },
                { label: 'lô', name: 'pc', width: 100, align: 'left' },
                { label: 'hạn sử dụng', name: 'yxq', width: 70, align: 'left' },
                { label: 'giá bán buôn', name: 'pfj', width: 70, align: 'left' },
                { label: 'giá bán lẻ', name: 'lsj', width: 70, align: 'left' },
                { label: 'giá nhập', name: 'jj', width: 70, align: 'left' },
                { label: 'giá nhập số tiền', name: 'zje', width: 80, align: 'left' },
                { label: 'tỷ lệ chiết khấu', name: 'kl', width: 55, align: 'left' },
                { label: 'tồn kho hiện có', name: 'rkbmkcstr', width: 70, align: 'left' },
                { label: 'ngày lập hóa đơn', name: 'kprq', width: 75, align: 'left' },
                { label: 'giao diện', name: 'wg', width: 100, align: 'left' },
                { label: 'số giấy phép', name: 'pzwh', width: 100, align: 'left' },
                { label: 'nhà sản xuất', name: 'sccj', width: 100, align: 'left' },
                { label: 'ngày sản xuất', name: 'scrq', width: 70, align: 'left' },
                { label: 'pfze', name: 'pfze', hidden: true, align: 'left' },
                { label: 'lsze', name: 'lsze', hidden: true, align: 'left' },
                { label: 'Rkzhyz', name: 'Rkzhyz', hidden: true, align: 'left' },
                { label: 'Ysjg', name: 'Ysjg', hidden: true, align: 'left' },
                { label: 'rkbmkc', name: 'rkbmkc', hidden: true },
                { label: 'sl', name: 'sl', hidden: true }, //số lượng lưu cuối cùng vào cơ sở dữ liệu
                { label: 'kxdw', name: 'kxdw', hidden: true }  //đơn vị có thể chọn
            ],
            ondblClickRow: function (rowid) {
                gridDbclickRow(rowid);
            }
        }, mydata);
    }

    //nhấp đúp
    function gridDbclickRow(rowid) {
        if (rowid) {
            var getRowData = $("#gridRKMX").jqGrid('getRowData', rowid);
            if (getRowData) {
                $("#txtSRM").val(getRowData.ypdm);
                $("#txtFPH").val(getRowData.fph);
                $("#txtYPMC").val(getRowData.ypmc);
                $("#txtGG").val(getRowData.gg);
                $("#txtRKSL").val(getRowData.sl);
                $("#txtPH").val(getRowData.ph);
                $("#txtPC").val(getRowData.pc);
                $("#txtYXQ").val(Getyxq(getRowData.scrq));
                $("#txtPFJ").val(getRowData.pfj);
                $("#txtLSJ").val(getRowData.lsj);
                $("#txtJJ").val(getRowData.jj);
                $("#txtKL").val(getRowData.kl);
                //var result = getRowData.kxdw.split(',');
                $("#ddlRKDW").empty();
                //if (result[0] === getRowData.dw) {
                //    $("#ddlRKDW").append('<option selected="selected">' + result[0] + '</option>');
                //    $("#ddlRKDW").append('<option >' + result[1] + '</option>');
                //} else {
                //    $("#ddlRKDW").append('<option >' + result[0] + '</option>');
                //    $("#ddlRKDW").append('<option selected="selected">' + result[1] + '</option>');
                //}
                $("#ddlRKDW").append('<option >' + getRowData.dw + '</option>');

                $("#txtXYKC").val(getRowData.rkbmkcstr);
                $("#txtKPRQ").val(getRowData.kprq);
                $("#txtWG").val(getRowData.wg);
                $("#txtPZWH").val(getRowData.pzwh);
                $("#txtSCCJ").val(getRowData.sccj);
                $("#txtSCRQ").val(getRowData.scrq);
                $("#txtJJZE").val(getRowData.zje);
                $("#txtPFZE").val(getRowData.pfze);
                $("#txtLSZE").val(getRowData.lsze);
                $("#txtYSJG").val(getRowData.Ysjg);
                $("#hidden_kcsl").val(getRowData.rkbmkc);

                $('#editRowId').val(rowid);
            }
        }
    }

    //đặt lại
    function newtouch_event_f7() {
        initialRKDH(); //đổi số phiếu
        $("#txtGYSCODE").val("");
        $("#txtGYSMC").val("");
        $("#txtRKZE").val("");
        EnabledSysBasicInfo();//kích hoạt
        ClearRKMX();//xóa chi tiết
        $('#gridRKMX').jqGrid("clearGridData");
    }

    //tải bằng phím Enter grid
    $('#txtWG').keydownEnterEvent(function () {
        if ($('#editRowId').val()) {            //là sửa đổi
            newtouch_event_f3();    //mô phỏng nút sửa nhấp
        }
        else {
            newtouch_event_f2();    //mô phỏng xác nhận nút nhấp
        }
    });

    //lấy chi tiết
    function getEditRowData() {
        var count = $("#gridRKMX").getGridParam('records');
        if (count < 1) {
            //kiểm tra dữ liệu chính
            if (!CheckMainData()) {
                return false;
            }
        }
        //kiểm tra chi tiết
        if (!CheckDetailData()) {
            return false;
        }

        var sl;
        if ($("#ddlRKDW").find("option:selected").text() === $("#txtYPMC").attr('data-ykdw')) {
            sl = parseFloat($("#txtRKSL").val());
        } else {
            sl = parseFloat($("#txtRKSL").val() / parseFloat($("#txtSRM").attr('data-bzs'))); //nếu chọn của nhập kho đơn vị: đơn vị kho thuốc,thì sl là số lượng nhập kho/hệ số chuyển đổi, sau đó lưu vào cơ sở dữ liệu
        }
        var data = [{
            yplb: $("#txtSRM").attr('data-yplb'),
            fph: $("#txtFPH").val(),
            ypdm: $("#txtSRM").val(),
            ypmc: $("#txtYPMC").val(),
            gg: $("#txtGG").val(),
            sl: sl,   //số lượng lưu cuối cùng vào cơ sở dữ liệu
            rksl: $("#txtRKSL").val(),   //trang trên của số lượng nhập kho
            dw: $("#ddlRKDW").find("option:selected").text(),
            kxdw: $("#kxdw").val(),
            ph: $("#txtPH").val(),
            pc: $("#txtPC").val(),
            yxq: $("#txtYXQ").val(),
            pfj: $("#txtPFJ").val(),
            lsj: $("#txtLSJ").val(),
            jj: $("#txtJJ").val(),
            zje: $("#txtJJZE").val(),
            kl: $("#txtKL").val(),
            rkbmkcstr: $("#txtXYKC").val(),
            kprq: $("#txtKPRQ").val(),
            wg: $("#txtWG").val(),
            pzwh: $("#txtPZWH").val(),
            sccj: $("#txtSCCJ").val(),
            scrq: $("#txtSCRQ").val(),
            pfze: $("#txtPFZE").val(),
            lsze: $("#txtLSZE").val(),
            Rkzhyz: $("#txtSRM").attr('data-bzs'),
            Ysjg: $("#txtYSJG").val(),
            rkbmkc: $("#hidden_kcsl").val()

        }];
        return data;
    }


    //thêm nút
    function newtouch_event_f2() {
        if ($("#txtYXQ").val() <= $("#txtSCRQ").val()) {
            $.modalMsg("hạn sử dụng nên muộn hơn thuốc của ngày sản xuất", "warning", 1500);
            return false;
        }
        var count = $("#gridRKMX").getGridParam('records');
        if (count < 1) {
            //kiểm tra dữ liệu chính
            if (!CheckMainData()) {
                return false;
            }
        }
        //kiểm tra chi tiết
        if (!CheckDetailData()) {
            return false;
        }
        //lấy chi tiết
        var data = getEditRowData();
        //kiểm tra mục trùng lặp
        var isRepeatedAdd = false;
        $.each($("#gridRKMX").getDataIDs(), function () {
            var rowData = $("#gridRKMX").jqGrid('getRowData', this);
            if (rowData.ypdm === data[0].ypdm && rowData.ph === data[0].ph || rowData.pc === data[0].pc) {
                isRepeatedAdd = true;
            }
        });

        if (isRepeatedAdd) {
            $.modalMsg("không được thêm trùng lặp", "warning", 1000);
            return false;
        }
        $("#gridRKMX").newtouchLocalDataGrid(null, data);
        //tính nhập kho số tiền
        ComputeRKZE();
        //vô hiệu hóa
        DisableControls();
        ClearRKMX();
    }

    //nút sửa
    function newtouch_event_f3() {
        if ($("#txtYXQ").val() <= $("#txtSCRQ").val()) {
            $.modalMsg("hạn sử dụng nên muộn hơn thuốc của ngày sản xuất", "warning", 1500);
            return false;
        }
        if ($('#editRowId').val()) {
            var count = $("#gridRKMX").getGridParam('records');
            if (count < 1) {
                //kiểm tra dữ liệu chính
                if (!CheckMainData()) {
                    return false;
                }
            }
            //kiểm tra chi tiết
            if (!CheckDetailData()) {
                return false;
            }
            //lấy chi tiết
            var data = getEditRowData();
            $('#gridRKMX').jqGrid("delRowData", $('#editRowId').val()); //trước tiên remove xóa dòng đó
            //kiểm tra mục trùng lặp
            var isRepeatedAdd = false;
            $.each($("#gridRKMX").getDataIDs(), function () {
                var rowData = $("#gridRKMX").jqGrid('getRowData', this);
                if (rowData.ypdm === data[0].ypdm && rowData.ph === data[0].ph && rowData.pc === data[0].pc) {
                    isRepeatedAdd = true;
                }
            });

            if (isRepeatedAdd) {
                $.modalAlert("không được thêm trùng lặp", 'warning');
                return false;
            }
            $("#gridRKMX").newtouchLocalDataGrid(null, data);
            //tính nhập kho số tiền
            ComputeRKZE();
            //vô hiệu hóa
            DisableControls();
            ClearRKMX();
        }
        else {
            //lấy grid dòng hiện đang được chọn
            var seleId = $('#gridRKMX').jqGrid('getGridParam', 'selrow');
            if (seleId) {
                //yêu cầu sửa dòng này
                gridDbclickRow(seleId);
            }
        }
    }

    //xóa
    function newtouch_event_f6() {
        var delRowid = $("#gridRKMX").jqGrid('getGridParam', 'selrow');
        if (!delRowid) {
            $.modalMsg("chưa chọn dòng", "warning", 1500);
            return;
        }
        $('#gridRKMX').jqGrid('delRowData', delRowid);
        //tính tổng tiền nhập kho
        ComputeRKZE();
        //xóa sạch
        //$("#txtGYSCODE").val("");
        //$("#txtGYSMC").val("");
        //kích hoạt
        EnabledSysBasicInfo();
    }

    //nhập kho
    function newtouch_event_f8() {
        var crkdj = Object();
        crkdj.pdh = $("#txtRKDH").val();
        crkdj.ckbm = $("#txtGYSCODE").val();
        crkdj.crkfsdm = $("#ddlRKFS").val();
        var djmx = $("#gridRKMX").jqGrid('getRowData_AllLine');
        if (djmx == null || djmx.length <= 0) {
            $.modalAlert("vui lòng trước tiên thêm nhập kho thông tin", 'warning');
            return;
        }
        $.najax({
            url: "/DrugStorage/SaveInStorageInfo",
            dataType: "json",
            data: { crkdj: crkdj, crkdjmx: djmx },
            type: "POST",
            async: false,
            success: function (data) {
                if (data.state === 'success') {
                    $.modalMsg("nhập kho đề nghị đã gửi", "success", 1000);
                    newtouch_event_f7();//mới nhập kho: mới số chứng từ chính dữ liệu xóa sạch chi tiết xóa sạch
                    $('#gridRKMX').jqGrid("clearGridData");//xóa sạch Grid
                }
                else {
                    $.newtouchAlert(data);
                }
            }
        });

    }

    //số lượng mất tiêu điểm,tính tiền bán buôn tiền bán lẻ
    function RKSL_Leave() {
        if ($("#txtRKSL").val() === "") {
            return false;
        }
        if (isNaN($("#txtRKSL").val())) {
            $.modalAlert("lỗi định dạng số lượng", 'warning');
            return false;
        }
        var sl;
        var pfj = parseFloat($("#txtPFJ").val());
        var lsj = parseFloat($("#txtLSJ").val());
        if ($("#ddlRKDW").find("option:selected").text() === $("#txtYPMC").attr('data-ykdw')) {
            sl = parseFloat($("#txtRKSL").val());
        } else {
            sl = roundingBy4she6ru5chengshuang(parseFloat($("#txtRKSL").val()) / parseFloat($("#txtSRM").attr('data-bzs')), 4);
        }

        $("#thPFZEDW").text("tổng tiền bán buôn(đồng/" + $("#ddlRKDW").find("option:selected").text() + "):");
        $("#thLSZEDW").text("tổng tiền bán lẻ(đồng/" + $("#ddlRKDW").find("option:selected").text() + "):");
        $("#txtPFZE").val((pfj * sl).toFixed(4));
        $("#txtLSZE").val((lsj * sl).toFixed(4));

        //tính lại đơn giá nhập kho
        JJZE_Leave();
        //tính tỷ lệ chiết khấu
        ComputeKL();
    }

    //tổng tiền giá nhập mất tiêu điểm, tính nhập kho đơn giá
    function JJZE_Leave() {
        if (isNaN($("#txtJJZE").val())) {
            $.modalAlert("lỗi định dạng tổng tiền giá nhập", 'warning');
            return false;
        }
        if ($("#txtJJZE").val() === "") {
            return false;
        }
        if ($("#txtRKSL").val() === "") {
            return false;
        }
        var sl;
        if ($("#ddlRKDW").find("option:selected").text() === $("#txtYPMC").attr('data-ykdw')) {    //nếu chọn của có thể trả đơn vị: đơn vị kho thuốc số lượng=nhập số lượng
            sl = parseFloat($("#txtRKSL").val());
        } else {   //có thể trả đơn vị: đơn vị nhỏ nhất, số lượng=nhập số lượng/hệ số chuyển đổi
            sl = roundingBy4she6ru5chengshuang(parseFloat($("#txtRKSL").val()) / parseFloat($("#txtSRM").attr('data-bzs')), 4);
        }
        var jjze = parseFloat($("#txtJJZE").val());
        var jj = (sl === 0 ? 0 : roundingBy4she6ru5chengshuang((jjze / sl), 4));
        $("#txtJJ").val(parseFloat(jj).toFixed(4));

        ComputeKL();
    }

    //tính tỷ lệ chiết khấu
    function ComputeKL() {
        if ($("#txtJJ").val() === "") {
            return;
        }
        var pfj = parseFloat($("#txtPFJ").val());
        var jj = parseFloat($("#txtJJ").val());

        $("#txtKL").val(roundingBy4she6ru5chengshuang((pfj * 100 / jj), 2));  //làm tròn 5 bỏ 6 vào
    }

    //tính tổng tiền nhập kho
    function ComputeRKZE() {
        var rkze = 0;
        var count = $("#gridRKMX").getGridParam('records');
        if (count > 0) {
            var rowIds = $("#gridRKMX").getDataIDs();
            for (var i = 0; i < rowIds.length; i++) {
                var getRowZje = $("#gridRKMX").getRowData(rowIds[i]).zje;
                rkze = parseFloat(rkze) + parseFloat(getRowZje);
            }
            //nhập kho số tiền
            $("#txtRKZE").val(rkze.toFixed(4));
        } else {
            $("#txtRKZE").val('');
        }
    }

    //khi hạn sử dụng thay đổi, lô thuốc cũng thay đổi theo
    function updatePC() {
        var date = new Date();
        var hours = date.getHours().toString();
        if (hours.length === 1) {
            hours = "0" + hours;
        }
        var minutes = date.getMinutes().toString();
        if (minutes.length === 1) {
            minutes = "0" + minutes;
        }
        var milliseconds = date.getMilliseconds().toString();
        if (milliseconds.length === 1) {
            milliseconds = milliseconds + "00";
        }
        else if (milliseconds.length === 2) {
            milliseconds = milliseconds + "0";
        }
        var currentTime = hours + minutes + milliseconds;
        $("#txtPC").val($("#txtYXQ").val().replace(/-/g, "").toString() + currentTime);
    }

    //kiểm tra dữ liệu chính
    function CheckMainData() {
        if ($("#txtRKDH").val() === "") {
            $.modalMsg("nhập kho đơn số là trống", "warning", 1000);
            return false;
        }
        if ($("#txtGYSCODE").val() === "") {
            $.modalMsg("mã nhà cung cấp là trống", "warning", 1000);
            return false;
        }
        if ($("#txtGYSMC").val() === "") {
            $.modalMsg("tên nhà cung cấp là trống", "warning", 1000);
            return false;
        }
        return true;
    }

    //kiểm tra dữ liệu chi tiết
    function CheckDetailData() {
        //var reg2 = /(^[1-9]([0-9]+)?(\.[0-9]{1,2})?$)|(^(0){1}$)|(^[0-9]\.[0-9]([0-9])?$)/;//số tiền
        //if ($("#ddlRKFS").val() !== "2") {
        //    if ($("#txtFPH").val() == "") {
        //        $.modalAlert("số hóa đơn là trống", 'warning');
        //        return false;
        //    }
        //}
        if ($("#txtSRM").val() === "") {
            $.modalMsg("mã thuốc là trống!", "warning", 1000);
            return false;
        }
        if ($("#txtYPMC").val() === "") {
            $.modalMsg("tên thuốc là trống!", "warning", 1000);
            return false;
        }
        var reg = /^[1-9]\d*$/;//lớn hơn 0 số nguyên
        if (!reg.test($("#txtRKSL").val())) {
            $.modalMsg("số lượng nhập kho bắt buộc là lớn hơn 0 số nguyên!", "warning", 1000);
            return false;
        }
        var reg2 = /^\d+(?:\.\d{0,2})?$/;
        if (!reg2.test($("#txtJJZE").val())) {
            $.modalMsg("tổng tiền giá nhập vui lòng nhập đúng định dạng số tiền!", "warning", 1000);
            return false;
        }
        if ($("#txtPH").val() === "") {
            $.modalMsg("số lô là trống!", "warning", 1000);
            return false;
        }
        return true;
    }

    //xóa chi tiết
    function ClearRKMX() {
        newtouch_globalevent_f4();
        $("#ddlRKDW").empty();
        $("#txtKPRQ").val($.getDate());
        $("#txtSCRQ").val($.getDate());
        $("#txtYXQ").val(Getyxq($("#txtSCRQ").val()));

    }

    //vô hiệu hóa
    function DisableControls() {
        $("#txtGYSCODE").attr("disabled", "disabled").css("background-color", "rgb(238, 238, 238)");
        $("#txtRKRQ").attr("disabled", "disabled").css("background-color", "rgb(238, 238, 238)");
        $("#ddlRKFS").attr("disabled", "disabled").css("background-color", "rgb(238, 238, 238)");
    }

    //kích hoạt
    function EnabledSysBasicInfo() {
        $("#txtGYSCODE").removeAttr("disabled").removeAttr("style");
        $("#txtRKRQ").removeAttr("disabled").removeAttr("style");
        $("#ddlRKFS").removeAttr("disabled").removeAttr("style");
    }

    //hạn sử dụng mặc định tăng 12 tháng
    function Getyxq(scrq) {
        var s = scrq.split('-');
        var year = Number($('#txtSCRQ').val().split('-')[0]) + 1;
        return year + "-" + s[1] + "-" + s[2];
    }
</script>

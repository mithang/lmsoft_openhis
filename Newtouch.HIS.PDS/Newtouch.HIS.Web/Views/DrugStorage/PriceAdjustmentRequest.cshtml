
@{
    ViewBag.Title = "PriceAdjustmentRequest";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<form id="form1">
    <div class="panel panel-default">
        <div class="panel-heading">
            điều kiện lọc
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle">từ khóa</th>
                    <td class="formValue">
                        <input type="text" id="txtINPUTCODE" class="form-control" placeholder="mã thuốc phiên âm tên" />
                    </td>
                    <td class="formValue" colspan="3">
                        <input type="button" id="btn_search" class="btn btn-primary btn-md" value="tra cứu" style="width:55px" />
                        <span style="color: red; margin-left:10px;">chú: không có pháp tra cứu đã đề nghị điều chỉnh giá nhưng chưa thực hiện của thuốc</span>
                    </td>
                </tr>
            </table>
        </div>       
    </div>
    <div class="gridPanel" style="margin-top:10px">
        <div class="gridPanel">
            <table id="gridYPInfoList"></table>
            <div id="gridPager" rel="form1"></div>
        </div>
    </div>
    <div class="gridPanel" style="margin-top:10px">
        <div class="panel-heading">
            điều chỉnh giá chi tiết
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle"><span class="required">*</span>giá bán buôn</th>
                    <td class="formValue">
                        <input type="text" id="txtPFJ" class="form-control" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>giá bán lẻ</th>
                    <td class="formValue">
                        <input type="text" id="txtLSJ" class="form-control" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>thực hiện tệp</th>
                    <td class="formValue">
                        <input type="text" id="txtZXWJ" class="form-control" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>thời gian thực hiện</th>
                    <td class="formValue">
                        <input id="txtZXSJ" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" onfocus="WdatePicker({ minDate: '%y-%M-#{%d+1}' })" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">giá bán buôn gốc</th>
                    <td class="formValue">
                        <input type="text" id="txtYPFJ" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">giá bán lẻ gốc</th>
                    <td class="formValue">
                        <input type="text" id="txtYLSJ" class="form-control newtouch_Readonly" />
                        <input type="text" id="hidden_ypCode" hidden />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</form>

@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 6 },
    F6Text = "đề nghị"
})

<script>
    var $gridYpInfoList;
    $(function () {
        gridYPInfoList();
        $("#btn_search").click(function () {
            SearchYP();
        });
        $("#txtINPUTCODE").bind("keyup", function () {
            if (event.keyCode === 13) {
                SearchYP();
            }
        });
    });

    function gridYPInfoList() {
        $gridYpInfoList = $("#gridYPInfoList");
        $gridYpInfoList.dataGrid({
            postData: getSearchPostData(),
            url: "/DrugStorage/SelectAdjustPriceMedicineInfoList",
            height: $(window).height() - 310,
            colModel: [
                { label: "mã thuốc", name: "ypCode", width: 80, align: 'left' },
                { label: 'tên thuốc', name: 'ypmc', width: 120, align: 'left' },
                { label: 'quy cách thuốc', name: 'ypgg', width: 120, align: 'left' },
                { label: 'đơn vị định giá', name: 'djdw', width: 80, align: 'left' },
                {
                    label: 'giá bán buôn', name: 'pfj', width: 100, align: 'left',
                    formatter: function (val) {
                        return val.toFixed(4);
                    }
                },
                {
                    label: 'giá bán lẻ', name: 'lsj', width: 100, align: 'left',
                    formatter: function (val) {
                        return val.toFixed(4);
                    }
                },
                { label: 'thuộc tính thuốc', name: 'yptssxmc', width: 80, align: 'left' },
                { label: 'loại thuốc', name: 'yplb', width: 80, align: 'left' },
                { label: 'liều dùng', name: 'jl', width: 80, align: 'left' },
                { label: 'đơn vị liều dùng', name: 'jldw', width: 80, align: 'left' },
                { label: 'kho thuốc số lượng đóng gói', name: 'bzs', width: 80, align: 'left' },
                { label: 'kho thuốc đơn vị đóng gói', name: 'bzdw', width: 80, align: 'left' },
                { label: 'số tách lẻ ngoại trú', name: 'mzcls', width: 80, align: 'left' },
                { label: 'đơn vị tách lẻ ngoại trú', name: 'mzcldw', width: 80, align: 'left' },
                { label: 'số tách lẻ nội trú', name: 'zycls', width: 80, align: 'left' },
                { label: 'đơn vị tách lẻ nội trú', name: 'zycldw', width: 80, align: 'left' },
                { label: 'tỷ lệ tự chi trả', name: 'zfbl', width: 80, align: 'left' },
                { label: 'tính chất tự chi trả', name: 'zfxz', width: 80, align: 'left' },
                { label: 'dạng bào chế', name: 'jxmc', width: 100, align: 'left' },
                { label: 'nhà sản xuất', name: 'ycmc', width: 150, align: 'left' },
                { label: 'trạng thái', name: 'zt', width: 80, align: 'left' },
                { label: 'ghi sổ loại', name: 'jzlx', width: 100, align: 'left' },
                { label: 'mặc định hạn bảo quản', name: 'mrbzq', width: 80, align: 'left' }
            ],
            multiselect: false,
            pager: "#gridPager",
            sortname: 'ypCode desc',
            viewrecords: true,
            onSelectRow_page: function (rowid) {
                if (rowid) {
                    $("#txtPFJ").val('');
                    $("#txtLSJ").val('');
                    var getRowData = $("#gridYPInfoList").jqGrid('getRowData', rowid);
                    if (getRowData) {
                        $("#txtYPFJ").val(getRowData.pfj);
                        $("#txtYLSJ").val(getRowData.lsj);
                        $("#hidden_ypCode").val(getRowData.ypCode);
                    }
                }
            }
        });
    }

    function SearchYP() {
        $gridYpInfoList.jqGrid('setGridParam', {
            postData: getSearchPostData(), url: '/DrugStorage/SelectAdjustPriceMedicineInfoList',
        }).trigger("reloadGrid");
    }

    //điều kiện tra cứu
    function getSearchPostData() {
        var inputCode = $("#txtINPUTCODE").val();
        return { inputCode: inputCode };
    };

    //gửi đề nghị
    function newtouch_event_f6() {
        //kiểm tra dữ liệu
        if (!CheckData()) {
            return false;
        }
        $.najax({
            url: "/DrugStorage/SubmitRequuest",
            dataType: "json",
            data: { ypCode: $("#hidden_ypCode").val(), pfj: $("#txtPFJ").val(), lsj: $("#txtLSJ").val(), ypfj: $("#txtYPFJ").val(), ylsj: $("#txtYLSJ").val(), tzwj: $("#txtZXWJ").val(), zxsj: $("#txtZXSJ").val() },
            type: "POST",
            async: "false",
            success: function (data) {
                $.modalAlert("đề nghị gửi thành công", 'success');
                $("#txtPFJ").val('');
                $("#txtLSJ").val('');
                $("#txtZXWJ").val('');
                $("#txtZXSJ").val('');
                $("#txtYPFJ").val('');
                $("#txtYLSJ").val('');
                $.loading(false);
            },
            errCallback: function (err) {
                $.loading(false);
            }
        });
    }


    //kiểm tra dữ liệu
    function CheckData() {
        //Kiểm tra định dạng
        if ($("#txtYPFJ").val() === "") {
            $.modalAlert("vui lòng chọn thuốc tiến hành điều chỉnh giá!", 'warning');
            return false;
        }
        if ($("#txtPFJ").val() === "") {
            $.modalAlert("giá bán buôn không thể trống!", 'warning');
            return false;
        }
        if ($("#txtLSJ").val() === "") {
            $.modalAlert("giá bán lẻ không thể trống!", 'warning');
            return false;
        }
        if (isNaN($("#txtPFJ").val()) || isNaN($("#txtLSJ").val())) {
            $.modalAlert("批发价或零售价格式错误,请填写数字!", 'warning');
            return false;
        }        
        if ($("#txtZXWJ").val() === "") {
            $.modalAlert("thực hiện tệp không thể trống!", 'warning');
            return false;
        }
        if ($("#txtZXSJ").val() === "") {
            $.modalAlert("thời gian thực hiện không thể trống!", 'warning');
            return false;
        }
        if ($("#txtPFJ").val() === $("#txtYPFJ").val() && $("#txtLSJ").val() === $("#txtYLSJ").val()) {
            $.modalAlert("批发价和零售价不能与原价相同!", "warning");
            return false;
        }
        return true;
    }
</script>

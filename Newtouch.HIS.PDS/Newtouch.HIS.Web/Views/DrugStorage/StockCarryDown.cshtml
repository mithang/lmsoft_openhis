
@{
    ViewBag.Title = "tồn kho kết chuyển";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<form id="form1">
    <div class="panel panel-default">
        <div class="panel-heading">
            kết chuyển
        </div>
        <div>
            <table class="form">
                <tr>
                    <th class="formTitle">lịch sử kết chuyển: </th>
                    <td class="formValue">
                        <select id="lsjz" class="form-control"></select>
                    </td>
                    <th class="formTitle">mã nhập: </th>
                    <td class="formValue">
                        <input id="txtSRM" type="text" class="form-control" placeholder="phiên âm/thuốc tên/mã thuốc" />
                    </td>
                    <td class="formValue" colspan="3">
                        <input type="button" id="btn_search" class="btn btn-primary" value="tra cứu" style="margin-left:10px;" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel">
        <table id="gridDrugsList"></table>
        <div id="gridPager" rel="form1"></div>
    </div>
    @Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
    ShowKeyList = new[] { 8 },
    F8Text = "kết chuyển hiện tại"
})
</form>
<script>
    $(function () {
        //tải lại khi thay đổi kích thước cửa sổ trình duyệt jqGrid chiều rộng
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });
        GetlsjzSel();//lấy lịch sử thời gian kết chuyển
        gridDrugsList();//thông tin thuốc
    });

    //gắn sự kiện phím Enter
    $(document).keyup(function (event) {
        if (event.keyCode === 13) {
            $("#btn_search").trigger("click");
        }
    });

    //lấy lịch sử thời gian kết chuyển
    function GetlsjzSel() {
        $("#lsjz").html("");
        $("#lsjz").bindSelect({
            url: "/DrugStorage/GetlsjzDateTime",
            id: "key",
            text: "value"
        });
    }

    //thực hiện kết chuyển hiện tại
    function newtouch_event_f8() {
        //lấy cuối cùng một lần thời gian kết chuyển
        var lastCarryTime;
        $.najax({
            type: "Get",
            url: "/DrugStorage/QueryLastCarryTime?r=" + Math.random(),
            dataType: "json",
            success: function (ajaxresp) {
                if (ajaxresp != null) {
                    if (ajaxresp.state === "success") {
                        lastCarryTime = ajaxresp.data;
                        var msg = ajaxresp.data === "" ? "bạn có chắc kết chuyển không?" : ("最近一次结转时间为: " + lastCarryTime + ",bạn có chắc kết chuyển không?")
                        $.modalConfirm(msg,
                            function (flag) {
                                if (flag) {
                                    $.najax({
                                        url: "/DrugStorage/CarryOverMedicine",
                                        type: "POST",
                                        dataType: "json",
                                        success: function (ajaxresp) {
                                            if (ajaxresp.state === 'success') {
                                                $.modalAlert("kết chuyển thành công", 'success');
                                                GetlsjzSel();//làm mới kết chuyển ngày
                                                $("#btn_search").trigger('click');
                                            }
                                            else {
                                                $.newtouchAlert(ajaxresp);
                                            }
                                        }
                                    });

                                } else {
                                    return false;
                                }
                            }, true);
                    } else {
                        $.modalAlert(ajaxresp.message, "error");
                    }
                } else {
                    $.modalAlert("lấy thời gian kết chuyển lần trước thất bại", "error");
                }
            }
        });
    }

    //thông tin thuốc
    function gridDrugsList() {
        var captionCon = "tổng cộng&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span id='yeCon'>trang hiện tại tổng tiền giá bán buôn: " + "" + "đồng&nbsp;&nbsp;&nbsp;&nbsp;tổng tiền bán lẻ: " + "" + "đồng</span>";
        var $gridDrugsList = $("#gridDrugsList");
        $gridDrugsList.dataGrid({
            postData: getSearchPostData(),
            height: $(window).height() - 230,
            url: "/DrugStorage/SelectCarryDownMedicineList",
            caption: captionCon,
            colModel: [
                { label: 'tên thuốc', name: 'ypmc', width: 180, align: 'left' },
                { label: 'mã thuốc', name: 'ypdm', width: 65, align: 'left' },
                { label: 'quy cách', name: 'gg', width: 70, align: 'left' },
                { label: 'số lượng kết chuyển', name: 'jzslstr', width: 60, align: 'right' },
                { label: 'đơn vị', name: 'dw', width: 50, align: 'center' },
                { label: 'lô', name: 'pc', width: 110, align: 'left' },
                { label: 'nhà sản xuất', name: 'sccj', width: 150, align: 'left' },
                {
                    label: 'giá bán buôn', name: 'pfj', width: 70, align: 'right', formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0";
                    }
                },
                {
                    label: 'giá bán lẻ', name: 'lsj', width: 70, align: 'right', formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0";
                    }
                },
                {
                    label: 'tổng tiền bán buôn', name: 'pfze', width: 90, align: 'right', formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(2) : "0";
                    }
                },
                {
                    label: 'tổng tiền bán lẻ', name: 'lsze', width: 90, align: 'right', formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(2) : "0";
                    }
                },
                { label: 'số lượng kết chuyển', name: 'jzsl', hidden: true }
            ],
            multiselect: false,
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords: true,
            loadComplete: function (data) {
                ComputePjzeAndLsze();//tính thanh tiêu đề trong của tổng tiền giá bán buôn và tổng tiền bán lẻ
            }
        });

        //tra cứu
        $("#btn_search").click(function () {
            $gridDrugsList.jqGrid('setGridParam', {
                postData: getSearchPostData()
            }).trigger('reloadGrid');
        });
    }

    //điều kiện tra cứu
    function getSearchPostData() {
        var jzsj = $("#lsjz").find("option:selected").text();
        var keyWork = $("#txtSRM").val();
        return { jzsj: jzsj, keyWork: keyWork };
    };

    //tính thanh tiêu đề trong của tổng tiền giá bán buôn và tổng tiền bán lẻ
    function ComputePjzeAndLsze() {
        var titlePjze = 0;
        var titleLsze = 0;
        var count = $("#gridDrugsList").getGridParam('records');
        if (count > 0) {
            var rowIds = $("#gridDrugsList").getDataIDs();
            for (var i = 0; i < rowIds.length; i++) {
                var getRowPjze = $("#gridDrugsList").getRowData(rowIds[i]).pfze;
                var getRowLsze = $("#gridDrugsList").getRowData(rowIds[i]).lsze;
                titlePjze += parseFloat(getRowPjze);
                titleLsze += parseFloat(getRowLsze);
            }
            titlePjze = window.roundingBy4she6ru5chengshuang(titlePjze, 2);
            titleLsze = window.roundingBy4she6ru5chengshuang(titleLsze, 2);
            $("#yeCon").text("tổng tiền giá bán buôn: " + titlePjze + "đồng;tổng tiền giá lẻ: " + titleLsze + "đồng");
            $.loading(false);
        }
    }
</script>
<script type="text/javascript">
    $('#renewpwd').keyupEnterEvent(function () {
        var newpwd = $.trim($('#newpwd').val());
        var renewpwd = $.trim($('#renewpwd').val());
        if (!!!newpwd || !!!renewpwd) {
            return false;
        }
        if (newpwd != renewpwd) {
            return false;
        }
        btn_submitPwd();
    });
	
    function btn_submitPwd() {
        var newpwd = $.trim($('#newpwd').val());
        var renewpwd = $.trim($('#renewpwd').val());
        if (!!!newpwd || !!!renewpwd) {
            $.modalAlert("vui lòng điền mật khẩu", "error");
            return false;
        }
        if (newpwd != renewpwd) {
            $.modalAlert("mật khẩu nhập hai lần không khớp", "error");//độ phức tạp mật khẩu chưa đủ
            return false;
        }
        var ret = /^(?![0-9]+$)(?![a-zA-Z]+$)[0-9A-Za-z]{6,16}$/;
        if (newpwd && !ret.test(newpwd)) {
            $.modalAlert("độ phức tạp mật khẩu chưa đủ<br/>6-16 vị, bắt buộc bao gồm chữ cái dữ liệu", "error");//độ phức tạp mật khẩu chưa đủ
            return false;
        }
        $.ajax({
            url: "/User/SubmitPersonalPassword",
            data: { newpwd: newpwd, renewpwd: renewpwd },
            type: "post",
            dataType: "json",
            success: function (data) {
                if (data.state == "success") {
                    $.modalAlert("đặt lại mật khẩu thành công.", "success");
                    location.href = location.href;
                } else {
                    $.modalAlert("đặt lại mật khẩu thất bại.", "error");
                    location.href = location.href;s
                }
            }
        });
    }
</script>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="topPanel">
    @Html.Partial("_OrganizeIdDDLToolbarSearchView")
    <div class="toolbar">
        <div class="btn-group">
            <a id="NF-add" class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>tạo mới</a>
        </div>
        <div class="btn-group">
            <a id="NF-edit" class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>sửa</a>
        </div>
        <div class="btn-group">
            <a id="NF-edit" class="btn btn-primary" onclick="btn_xy()"><i class="fa fa-pencil-square-o"></i>限用</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td class="formTitle">còn hiệu lực trạng thái: </td>
                <td class="input-group" id="zttd" style="margin-top:13px;">
                    <select id="zt" name="zt" class="form-control">
                        <option value="" selected="selected">tất cả</option>
                        <option value="0">không hiệu lực</option>
                        <option value="1">còn hiệu lực</option>
                    </select>
                </td>
                <td></td>
                <td class="formTitle" style="padding-left:20px;">phân loại thuốc: </td>
                <td class="input-group">
                    <input type="text" id="ypflMc" name="ypflMc" class="form-control" />
                    <input type="text" style="display:none;" id="ypflCode" name="ypflCode" class="form-control" />
                </td>
                <td>
                    <div class="input-group" style="padding-left:30px;margin-bottom:5px;">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="tên/mã/chữ cái đầu phiên âm" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>
    var valkeyword = "";
    $(function () {
        initControl();
        gridList();
    });

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/SysMedicine/GetGridJson",
            height: $(window).height() - 130,
            postData: { keyword: $("#txt_keyword").val(), organizeId: $("#OrganizeId").val(), zt: $("#zt").val(), ypflCode: $("#ypflMc").val() == "" ? "" : $("#ypflCode").val()},
            colModel: [
                { label: "khóa chính", name: "ypId", hidden: true, key: true },
                {
                    label: 'đồng bộ', name: 'isSynch', width: 40, hidden: true, align: 'left',
                    formatter: function (cellvalue, options, rowObject) {
                        if (cellvalue === '0') {
                            var $row = JSON.stringify(rowObject).replace(/\"/g, "'");
                            return '<a class="btn btn-default btn-xs" onclick="YibaoUpload(' + $row + ')"><span class="glyphicon glyphicon-refresh"></span></a>';
                        }
                        else if (cellvalue === '1') {
                            return '<a class="btn btn-default btn-xs disabled"><span class="glyphicon glyphicon-refresh"></span></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                { label: "mã thuốc", name: "ypCode", width: 100, align: 'left' },
                { label: 'tên thuốc', name: 'ypmc', width: 150, align: 'left' },
                { label: "mã BHYT", name: "ybdm", width: 100, align: 'left' },
                { label: "quốc gia BHYT tên", name: "gjybmc", width: 100, align: 'left' },
                { label: "mã BHYT quốc gia", name: "gjybdm", width: 100, align: 'left' },
                { label: "mã BHYT nông thôn mới", name: "xnhybdm", width: 100, align: 'left', hidden: true },
                { label: 'quy cách thuốc', name: 'ypgg', width: 70, align: 'center' },
                { label: 'tên hàng hóa', name: 'spm', width: 100, align: 'left', hidden: true },
                { label: 'chữ cái đầu phiên âm', name: 'py', width: 100, align: 'left', hidden: true },
                {
                    label: "tính chất tự chi trả", name: "zfxz", width: 60, align: 'left', formatter: function (cellVallue) {
                        return cellVallue == 0 ? "được báo" : (cellVallue == 1 ? "tự chi trả" : (cellVallue == 2 ? "tự chi trả theo loại" : (cellVallue == 3 ? "hoàn toàn tự lo" : (cellVallue == 4 ? "A loại" : (cellVallue == 5 ? "B loại" : (cellVallue == 6 ? "loại C" : ""))))));
                    }
                },
                {
                    label: "giá bán lẻ", name: "lsj", width: 60, align: 'left', formatter: "number"
                    , formatoptions: { decimalPlaces: 4, defaultValue: '0.0000' }
                },
                { label: 'đơn vị đóng gói', name: 'bzdw', width: 80, align: 'left' },
                { label: 'số tách lẻ ngoại trú', name: 'mzcls', width: 70, align: 'left' },
                { label: 'đơn vị tách lẻ ngoại trú', name: 'mzcldw', width: 70, align: 'left' },
                { label: 'số tách lẻ nội trú', name: 'zycls', width: 70, align: 'left' },
                { label: 'đơn vị tách lẻ nội trú', name: 'zycldw', width: 80, align: 'left' },
                { label: 'đơn vị định giá', name: 'djdw', width: 50, align: 'left' },
                { label: 'tỷ lệ tự chi trả', name: 'zfbl', width: 50, align: 'left' },
                { label: 'nhóm lớn', name: 'sfdlMc', width: 50, align: 'left' },
                { label: 'tên nhà máy dược', name: 'ycmc', width: 80, align: 'left' },
                { label: 'thuốc đóng gói mã', name: 'ypbzdm', width: 80, align: 'left' },
                {
                    label: 'cờ ngoại trú/nội trú', name: 'mzzybz', width: 80, align: 'left',
                    formatter: function (cellvalue) {
                        if (cellvalue == "0") {
                            return "chung";
                        } else if (cellvalue == "1") {
                            return "ngoại trú";
                        } else if (cellvalue == "2") {
                            return "nội trú";
                        } else {
                            return "khác";
                        }
                    }
                },
                {
                    label: 'BHYT giá giới hạn', name: 'cxjje', width: 80, align: 'left',
                    formatter: function (cxjje) {
                        if (cxjje == 0 || cxjje == null) {
                            return "0.00";
                        } else {
                            return cxjje;
                        }
                    }
                },
                { label: "còn hiệu lực", name: "zt", width: 60, align: "center", formatter: function (cellvalue) { return cellvalue == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
                { label: 'người tạo', name: 'CreatorCode', width: 60, align: 'left' },
                { label: 'thời gian tạo', name: 'CreateTime', width: 80, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'sửa đổi lần cuối', name: 'LastModifierCode', width: 60, align: 'center' },
                { label: 'thời gian sửa đổi lần cuối', name: 'LastModifyTime', width: 80, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'sắp xếp', name: 'px', width: 40, align: 'left' }
            ],
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords: true
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword").val(), organizeId: $("#OrganizeId").val(), zt: $("#zt").val(), ypflCode: $("#ypflMc").val() == "" ? "" : $("#ypflCode").val() },
                page: 1,
            }).trigger('reloadGrid');
        });
    }

    //sự kiện Enter
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    });

    function initControl() {
        //phân loại thuốc
        $('#ypflMc').newtouchFloatingSelector({
            width: 300,
            height: 300,
            caption: "phân loại thuốc",
            url: '/SysMedicine/GetListSelectJson',
            clickautotrigger: true,
            ajaxparameters: function () {
                return "keyword=" + $.trim($('#ypflMc').val());
            },
            itemdbclickhandler: function ($thistr) {
                $('#ypflCode').val($thistr.attr('data-ypflCode'));
                $('#ypflMc').val($thistr.attr('data-ypflmc'));
            },
            colModel: [{ label: 'mã', name: 'ypflCode', hidden: true },
            { label: 'tên', name: 'ypflmc', widthratio: 50 },
            { label: 'chữ cái đầu phiên âm', name: 'py', widthratio: 50 }
            ]
        });
    }

    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "hệ thống thuốc thêm",
            url: "/SysMedicine/SysMedicineAdd?orgId=" + $('#OrganizeId').val(),
            width: "1300px",
            height: "800px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_edit() {
        var keyValue = $("#gridList").jqGridRowValue().ypId;
        if (!!!keyValue) {
            $.modalAlert("vui lòng chọn một bản ghi", 'warning');
            return;
        }
        $.modalOpen({
            id: "SysMedicineAdd",
            title: "sửa hệ thống thuốc",
            url: "/SysMedicine/SysMedicineAdd?keyValue=" + keyValue,
            width: "1300px",
            height: "800px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_xy() {
        debugger;
        var seleRowid = jQuery("#gridList").jqGrid("getGridParam", "selrow");
        if (!(seleRowid)) {
            $.modalAlert("vui lòng chọn một bản ghi", 'warning');
            return;
        }
        var xmdm = $("#gridList").jqGridRowValue().ypCode;
        var xmmc = encodeURIComponent($("#gridList").jqGridRowValue().ypmc);
        xmmc = xmmc.replace(/%/g, '%25');
        var title = "【" + $("#gridList").jqGridRowValue().ypmc + "】" + "的限用";
        $.modalOpen({
            id: "Form",
            title: title,
            url: "/SysMedicine/YbbxblForm?xmdm=" + xmdm + "&xmmc=" + xmmc,
            width: "600px",
            height: "550px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();

            }
        });
    }

    //thuốc đồng bộ BHYT
    function YibaoUpload(row) {
        $.najax({
            url: "/SysMedicine/YibaoUploadApi",
            type: "POST",
            data: { ypId: row.ypId, flag: row.zt },
            dataType: "json",
            async: false,
            success: function (data) {
                $.modalAlert(data.message, data.state);
                $('#btn_search').trigger('click');
            }
        });
    }
</script>

@using Newtouch.Infrastructure

@{
    ViewBag.Title = "RequisitionForm";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<form id="form1">
    <div class="panel panel-default" style="margin-top:5px;">
        <div class="panel-heading">
            thông tin lĩnh
        </div>
        <div>
            <table class="form">
                <tr>
                    <th class="formTitle">số phiếu lĩnh: </th>
                    <td class="formValue">
                        <input id="txtSldh" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">bộ phận phát thuốc: </th>
                    <td class="formValue">
                        <input id="txtfybm" type="text" class="form-control" />
                    </td>
                    <th class="formTitle">tên bộ phận</th>
                    <td class="formValue"><input id="txtfybmmc" type="text" class="form-control newtouch_Readonly" /></td>
                    <th class="formTitle" style="visibility:hidden;"></th>
                    <td class="formValue" style="visibility:hidden;"></td>
                </tr>
            </table>
        </div>
        <div class="panel-heading">
            thông tin thuốc
        </div>
        <div id="divSLMX" style="padding-right:10px;">
            <table class="form">
                <tr>
                    <th class="formTitle">mã thuốc: </th>
                    <td class="formValue">
                        <input id="editRowId" value="" style="display:none;" />
                        <input id="ypCode" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">số lượng lĩnh<span id="spanSlslDw"></span>: </th>
                    <td class="formValue">
                        <input id="lqdw" value="" style="display:none;" />
                        <input id="slsl" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle" id="thRKSLDW">tên thuốc: </th>
                    <td class="formValue">
                        <input id="ypmc" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">quy cách: </th>
                    <td class="formValue">
                        <input id="ypgg" type="text" class="form-control newtouch_Readonly" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">nhà sản xuất: </th>
                    <td class="formValue">
                        <input id="ycmc" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <!-- mục tiêu kho thuốc của tồn kho -->
                    <th class="formTitle">số lượng có thể lĩnh: </th>
                    <td class="formValue">
                        <input id="klslandDw" type="text" class="form-control newtouch_Readonly inline" style="width:120px; display: inline;" />
                        <label id="spanklslDw"></label>
                    </td>
                    <th class="formTitle">kho thuốc hệ số chuyển đổi: </th>
                    <td class="formValue">
                        <input id="ykzhyz" type="text" class="form-control newtouch_Readonly" />
                        <input id="bbmzhyz" type="text" style="display:none;" />
                    </td>
                    <td colspan="2"></td>
                </tr>
                <tr>
                    <th class="formTitle">giá bán buôn(đồng): </th>
                    <td class="formValue">
                        <input id="pfj" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">tổng tiền bán buôn(đồng): </th>
                    <td class="formValue">
                        <input id="pfjze" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">giá bán lẻ(đồng): </th>
                    <td class="formValue">
                        <input id="lsj" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">tổng tiền bán lẻ(đồng): </th>
                    <td class="formValue">
                        <input id="lsjze" type="text" class="form-control newtouch_Readonly" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</form>

@Html.Partial("_MiddleButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 2, 3, 9 },
    F2Text = "thêm",
    F3Text = "sửa",
    F9Text = "xóa"
})

<div>
    <table id="gridSLMX"></table>
</div>

@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new[] { 4, 7, 8 },
    F7Text = "phiếu lĩnh mới"
})

<script>
    window.newtouch_globalconfig.f4opions = { container: '#divSLMX' }; //đóng 回车 Next

    $(function () {
        $(window).resize(function () { //tải lại khi thay đổi kích thước cửa sổ trình duyệt jqGrid chiều rộng
            window.initLayout("MyTabGrid");
        });
        funcNewSLD();   //trang tải giờ New một cái
    });

    //phiếu lĩnh mới
    function funcNewSLD() {
        $.najax({
            type: "POST",
            url: "/Pharmacy/RequisitionGetNewDjh",
            dataType: "text",
            success: function (data) {
                $('#txtSldh').val(data);
            }
        });
    };

    //bộ phận phát thuốc lớp nổi
    $("#txtfybm").newtouchBatchFloatingSelector({
        url: '/Pharmacy/RequisitionFybmSele',
        height: 200,
        width: 300,
        caption: "bộ phận phát thuốc",
        clickautotrigger: true,
        ajaxreqdata: function () {
            var reqData = {};
            reqData.keyword = $.trim($("#txtfybm").val());
            return reqData;
        },
        colModel: [
            { label: 'bộ phận mã', name: 'yfbmCode', widthratio: 40 },
            { label: 'tên bộ phận', name: 'yfbmmc', widthratio: 60 }
        ],
        itemdbclickhandler: function ($thistr) {
            $("#txtfybm").val($thistr.attr('data-yfbmCode')).nfnAddReadonly();
            $("#txtfybmmc").val($thistr.attr('data-yfbmmc'));
            //放开下方的药品输入区
            $("#ypCode,#slsl").nfnRemoveReadonly();
            $('#editRowId').val('');
        },
        itemdbclickhandleComplete: function () {
            $('#ypCode').trigger('focus'); //focus đến số lượng lĩnh
        }
    });

    //mã thuốc (thuốc)lớp nổi
    $("#ypCode").newtouchFloatingSelector({
        url: "/DrugStorage/GetValidMedicinesrmList",
        height: 350,
        width: 850,
        clickautotrigger: true,
        caption: "thông tin thuốc",
        ajaxparameters: function () {
            return "srm=" + $('#ypCode').val() + "&ypYfbmCode=" + $("#txtfybm").val();
        },
        colModel: [
            { label: 'loại', name: 'dlmc', width: 70 },
            { label: 'tên thuốc', name: 'ypmc', width: 200, align: 'left' },
            { label: 'quy cách', name: 'gg', width: 110, align: 'center' },
            { label: 'tồn kho', name: 'slStr', width: 100, align: 'center' },
            { label: 'giá bán lẻ', name: 'lsj', width: 60, align: 'center' },
            { label: 'giá bán buôn', name: 'pfj', width: 60, align: 'center' },
            { label: 'nhà sản xuất', name: 'sccj', width: 190, align: 'left' },
            { label: 'bzdw', name: 'bzdw', hidden: true },
            { label: 'bzdwsl', name: 'bzdwsl', hidden: true },
            { label: 'hệ số chuyển đổi', name: 'zhyz', hidden: true },
            { label: 'đơn vị', name: 'bmdw', hidden: true },
            { label: 'mã thuốc', name: 'ypdm', hidden: true },
            { label: 'lô', name: 'pc', hidden: true },
            { label: 'nhỏ nhất tồn kho', name: 'zxsl', hidden: true },
            { label: 'đơn vị kho thuốc', name: 'zxdw', hidden: true },
            { label: 'hệ số', name: 'bzs', hidden: true },
            { label: 'số khả dụng tối đa sau khi quy đổi sang đơn vị bộ phận', name: 'bmdwsl', hidden: true }
        ],
        itemdbclickhandler: function ($thistr) {
            //bộ phận lĩnh, không bộ phận phát thuốc)
            $.najax({
                url: "/DrugStorage/CheckRkbmOwnMedicine?yp=" + $thistr.attr('data-ypdm') + "&rkbm=@Constants.CurrentYfbm.yfbmCode",
                dataType: "json",
                type: "Get",
                success: function (res) {
                    if (res.state === 'success') {
                        $("#ypCode").val($thistr.attr('data-ypdm'));
                        $("#slsl").val('');
                        $("#ypmc").val($thistr.attr('data-ypmc'));
                        $("#ypgg").val($thistr.attr('data-gg'));
                        $("#ycmc").val($thistr.attr('data-sccj'));
                        $("#klslandDw").val($thistr.attr('data-bzdwsl'));  //số lượng có thể lĩnh
                        $("#spanSlslDw").html('(' + $thistr.attr('data-bzdw') + ')'); //đơn vị số lượng lĩnh
                        $("#spanklslDw").html($thistr.attr('data-bzdw'));
                        $("#pfj").val($thistr.attr('data-pfj'));
                        $("#pfjze").val('');
                        $("#lsj").val($thistr.attr('data-lsj'));
                        $("#lsjze").val('');
                        $('#ykzhyz').val($thistr.attr('data-bzs'));
                        $("#bbmzhyz").val($thistr.attr('data-bzs'));   //kho thuốc hệ số chuyển đổi
                        $("#lqdw").val($thistr.attr('data-bzdw'));   //đơn vị số lượng lĩnh
                    }else {
                        $.modalAlert(res.message, 'error');
                    }
                }
            });
        },
        itemdbclickhandleComplete: function () {
            $('#slsl').trigger('focus');    //focus đến số lượng lĩnh
        }
    });

    //khai báo chi tiết phiếu lĩnh grid
    $("#gridSLMX").newtouchLocalDataGrid({
        height: $(window).height() - 335,
        unwritten: false,
        colModel: [
            { label: 'mã thuốc', name: 'ypCode', width: 100, align: 'left' },
            { label: 'tên thuốc', name: 'ypmc', width: 110, align: 'left' },
            { label: 'quy cách', name: 'ypgg', width: 110, align: 'left' },
            { label: 'số lượng có thể lĩnh', name: 'klslandDw', width: 80, align: 'left' },
            { label: 'tồn kho hiện có', name: 'xykcslandDw', width: 80, align: 'left', hidden: true },
            { label: 'số lượng lĩnh', name: 'slsl', width: 70, align: 'left' }, //nhà thuốc số lượng
            { label: 'đơn vị', name: 'lqdw', width: 60, align: 'left' },   //nhà thuốc đơn vị
            { label: 'nhà sản xuất', name: 'ycmc', width: 180, align: 'left' },
            { label: 'giá bán buôn', name: 'pfj', width: 70, align: 'left' },
            { label: 'giá bán lẻ', name: 'lsj', width: 70, align: 'left' },
            { label: 'tổng tiền bán buôn', name: 'pfjze', width: 80, align: 'left' },
            { label: 'tổng tiền bán lẻ', name: 'lsjze', width: 80, align: 'left' },
            { label: 'kho thuốc hệ số chuyển đổi', name: 'ykzhyz', hidden: true },
            { label: 'bzdw', name: 'bzdw', hidden: true },
            { label: 'này bộ phận hệ số chuyển đổi', name: 'bbmzhyz', hidden: true }
        ],
        ondblClickRow: function (rowid) {
            gridDbclickRow(rowid);
        }
    });

    //đã chọn thuốc nhấp đúp sửa
    function gridDbclickRow(rowid) {
        if (rowid) {
            var rowData = $("#gridSLMX").jqGrid('getRowData', rowid);
            if (rowData) {
                $("#ypCode").val(rowData.ypCode);
                $("#slsl").val(rowData.slsl);
                $("#ypmc").val(rowData.ypmc);
                $("#ypgg").val(rowData.ypgg);
                $("#ycmc").val(rowData.ycmc);
                $("#klslandDw").val(rowData.klslandDw);
                $("#xykc").val(rowData.xykc);
                $("#xykcslandDw").val(rowData.xykcslandDw);
                $("#pfj").val(rowData.pfj);
                $("#pfjze").val(rowData.pfjze);
                $("#lsj").val(rowData.lsj);
                $("#lsjze").val(rowData.lsjze);
                $('#ykzhyz').val(rowData.ykzhyz);
                $('#bbmzhyz').val(rowData.bbmzhyz);
                $('#editRowId').val(rowid);
                $("#lqdw").val(rowData.lqdw);
                $("#spanklslDw").html(rowData.bzdw);
                $('#ypCode').trigger('focus');
            }
        }
    }

    //số lượng lĩnh sự kiện
    $('#slsl').keyup(function () {
        if (this.value.length === 1) {
            this.value = this.value.replace(/[^1-9]/g, '');
        }
        else {
            this.value = this.value.replace(/\D/g, '');
        }
        $("#pfjze").val('');
        $("#lsjze").val('');
        var slslVal = $(this).val();
        if (slslVal && !isNaN(slslVal)) {
            slslVal = parseInt(slslVal);
        }
        var pfjVal = $('#pfj').val();
        if (pfjVal && !isNaN(pfjVal)) {
            pfjVal = parseFloat(pfjVal);
        }
        var lsjVal = $('#lsj').val();
        if (lsjVal && !isNaN(lsjVal)) {
            lsjVal = parseFloat(lsjVal);
        }
        if (!(isNaN(slslVal)) && !(isNaN(pfjVal)) && !(isNaN(lsjVal))) {
            $("#pfjze").val(roundingBy4she6ru5chengshuang(slslVal * pfjVal, 2));
            $("#lsjze").val(roundingBy4she6ru5chengshuang(slslVal * lsjVal, 2));
        }
    }).blur(function () {
        if (isNaN($(this).val())) {
            $("#pfjze").val('');
            $("#pfjze").val('');
        }
    });

    //số lượng lĩnh input của sự kiện Enter
    $('#slsl').keydownEnterEvent(function () {
        if ($('#editRowId').val()) {            //là sửa đổi
            newtouch_event_f3();    //mô phỏng nút sửa nhấp
        }
        else {
            newtouch_event_f2();    //mô phỏng xác nhận nút nhấp
        }
    });


    //là thuốc Grid组装数据
    function getEditRowData() {
        var data = [{
            ypCode: $('#ypCode').val(),
            ypmc: $('#ypmc').val(),
            ypgg: $('#ypgg').val(),
            klslandDw: $('#klslandDw').val(),   //số lượng có thể lĩnh
            xykcslandDw: $('#xykcslandDw').val(),
            slsl: $('#slsl').val(),
            lqdw: $('#lqdw').val(),
            ycmc: $('#ycmc').val(),
            pfj: $('#pfj').val(),
            lsj: $('#lsj').val(),
            pfjze: $('#pfjze').val(),
            lsjze: $('#lsjze').val(),
            ykzhyz: $('#ykzhyz').val(),
            bbmzhyz: $('#bbmzhyz').val(),
            bzdw: $('#spanklslDw').html()
        }];
        return data;
    }

    //清楚
    function newtouch_event_f4() {
        $("#lqdw").val("");   //đơn vị số lượng lĩnh
        $("#spanSlslDw").html('');
        $('#spanklslDw').html("");
        $('#gridSLMX').jqGrid("clearGridData"); //清除明细的grid
    }

    //thêm nút
    function newtouch_event_f2() {
        var data = getEditRowData();
        if (!checkInputVal(data)) {
            return;
        }
        
        //kiểm tra mục trùng lặp
        var isRepeatedAdd = false;
        $.each($("#gridSLMX").getDataIDs(), function () {
            var rowData = $("#gridSLMX").jqGrid('getRowData', this);
            if (rowData.ypCode === data[0].ypCode) {
                isRepeatedAdd = true;
            }
        });
        if (isRepeatedAdd) {
            $.modalAlert("thêm trùng lặp", 'warning');
            return;
        }

        $("#gridSLMX").newtouchLocalDataGrid(null, data);
        $('#divSLMX input').val('');    //中间明细块 tất cả input đặt lại
        $("#spanSlslDw").html('');
        $("#spanklslDw").html("");
        $("#lqdw").val("");
        $('#ypCode').val('').trigger('focus');
    }

    //检查输入合法性
    function checkInputVal(data) {
        if (!data[0].ypCode) {
            $.modalAlert("药品代码必填", 'warning');
            return false;
        }
        if (!data[0].slsl) {
            $.modalAlert("申领数必填", 'warning');
            return false;
        }
        if (!data[0].ypgg) {
            $.modalAlert("quy cách không thể trống", 'warning');
            return false;
        }
        if (!data[0].pfjze || !data[0].lsjze) {
            $.modalAlert("tổng giá bán buôn và tổng giá bán lẻ không thể trống", 'warning');
            return false;
        }
        return true;
    }

    //nút sửa
    function newtouch_event_f3() {
        if ($('#editRowId').val()) {
            //lưu rowId của nội dung
            var data = getEditRowData();
            if (!checkInputVal(data)) {
                return;
            }
            $('#gridSLMX').jqGrid("delRowData", $('#editRowId').val()); //trước tiên remove xóa dòng đó
            //kiểm tra mục trùng lặp
            var isRepeatedAdd = false;
            $.each($("#gridSLMX").getDataIDs(), function () {
                var rowData = $("#gridSLMX").jqGrid('getRowData', this);
                if (rowData.ypCode == data[0].ypCode) {
                    isRepeatedAdd = true;
                }
            });
            if (isRepeatedAdd) {
                $.modalAlert("thêm trùng lặp", 'warning');
                return;
            }
            $("#gridSLMX").newtouchLocalDataGrid(null, data);
            $('#divSLMX input').val('');    //中间明细块 tất cả input đặt lại
            $("#spanSlslDw").html('');
            $('#spanklslDw').html("");
            $("#lqdw").val("");
            $('#ypCode').val('').trigger('focus');
        }
        else {
            //lấy grid dòng hiện đang được chọn
            var seleId = $('#gridSLMX').jqGrid('getGridParam', 'selrow');
            if (seleId) {
                //yêu cầu sửa dòng này
                gridDbclickRow(seleId);
            }
            else {
                return;
            }
        }
    }

    //phiếu lĩnh mới
    function newtouch_event_f6() {
        if ($("#gridSLMX").getDataIDs().length !== 0) {
            $.modalConfirm("danh sách trong tồn tại chưa lưu của chi tiết phiếu lĩnh<br/>确认放弃保存", function (flag) {
                if (flag) {
                    newtouch_event_f7(flag);
                }
            });
            return;
        }
        newtouch_event_f7();
    }

    //phiếu lĩnh mới
    function newtouch_event_f7() {
        newtouch_globalevent_f4();
        $('#txtfybm').val('');
        $('#txtfybmmc').val('');
        $('#editRowId').val('');    //không có đang sửa của đó một dòng
        $('#gridSLMX').jqGrid("clearGridData");
        funcNewSLD();
        $("#txtfybm").nfnRemoveReadonly();
        $("#ypCode,#slsl").nfnAddReadonly();
    }

    //lưu
    function newtouch_event_f8() {
        if ($("#gridSLMX").getDataIDs().length === 0) {
            $.modalAlert("không có chi tiết dữ liệu", 'warning');
            return;
        }
        var postData = {};
        postData.sldh = $('#txtSldh').val();
        postData.fybmCode = $('#txtfybm').val();
        postData.slmxList = $("#gridSLMX").jqGrid('getRowData_AllLine', false, true);    //lấy chọn trong dòng của Json dữ liệu
        $.najax({
            type: "POST",
            url: "/Pharmacy/SubmitRequisition",
            data: postData,
            dataType: "json",
            success: function (ajaxresp) {
                if (ajaxresp.state === 'success') {
                    $.modalMsg('申领单发送成功', 'success', 1000);
                    newtouch_event_f7();
                }
                else {
                    $.newtouchAlert(ajaxresp);
                    return;
                }
            }
        });
    }

</script>
@using Newtouch.Infrastructure;
@using Newtouch.HIS.Web.Core.Extensions;
@{
    ViewBag.Title = "RequisitionSearchIndex";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    .gridPanel {
        margin-bottom: 5px;
    }
</style>
<form id="form1">
    <div class="panel panel-default" style="margin-bottom:5px;">
        <div class="panel-heading">
            điều kiện tra cứu
        </div>
        <div>
            <table class="form">
                <tr>
                    <th class="formTitle">ngày: </th>
                    <td class="formValue">
                        <input id="txtStartDate" type="text" class="form-control input-wdatepicker " style="width:149px;" value="@DateTime.Now.ToString("yyyy-MM-dd 00:00")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm' })" />
                    </td>
                    <th class="formTitle">đến: </th>
                    <td class="formValue">
                        <input id="txtEndDate" type="text" class="form-control input-wdatepicker " style="width:149px;" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm' })" />
                    </td>
                    <th class="formTitle">số phiếu lĩnh: </th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="txtSLDH" />
                    </td>
                    <th class="formTitle">trạng thái cấp phát: </th>
                    <td class="formValue">
                        @Html.DropDownList("ddlFfzt", EnumSLDDeliveryStatus.None.ToDescSelectList(), "tất cả", new { @class = "form-control" })
                    </td>
                    <td class="formValue">
                        <input type="button" id="btn_search" class="btn btn-md btn-primary" style="width:50px; margin-left:40px; " value="tra cứu" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel">
        <table id="gridDJMainRecords"></table>
        <div id="gridPager" rel="form1"></div>
    </div>
    <div>
        <table id="gridDJMXInfo"></table>
    </div>
</form>

<script>
    $(function () {
        //tải lại khi thay đổi kích thước cửa sổ trình duyệt jqGrid chiều rộng
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });

        gridDJMainRecords();
    });

    //phiếu lĩnh chính bản ghi
    function gridDJMainRecords() {
        var $gridDjMainRecords = $("#gridDJMainRecords");
        $gridDjMainRecords.dataGrid({
            postData: getSearchPostData(),
            height: 165,
            url: "/Pharmacy/RequisitionGridJson",
            colModel: [
                { label: 'sldId', name: 'sldId', hidden: true, align: 'left' },
                { label: 'số phiếu lĩnh', name: 'Sldh', width: 150, align: 'left' },
                //{ label: 'bộ phận lĩnh', name: 'slbmmc', width: 80, align: 'left' },
                { label: 'bộ phận phát thuốc', name: 'ckbmmc', width: 80, align: 'left' },
                { label: 'thời gian lĩnh', name: 'CreateTime', width: 150, align: 'left', formatter: 'date', formatoptions: { srcformat: 'y-m-d H:i', newformat: 'y-m-d H:i' }},
                {
                    label: 'trạng thái phát thuốc', name: 'ffzt', width: 50, align: 'left',
                    formatter: function (cellvalue) {
                        switch (cellvalue) {
                            case 0: return "chưa cấp phát";
                            case 1: return "đã cấp phát một phần";
                            case 2: return "đã cấp phát tất cả";
                            case 3: return "đã chấm dứt";
                        }
                    }
                },
            ],
            unwritten: false,
            multiselect: false,
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords: true,
            onSelectRow_page: function (rowId) {
                btn_selectrow(rowId);
            },
            gridComplete: function () {
                var ids = $gridDjMainRecords.getDataIDs();
                for (var i = 0; i < ids.length; i++) {
                    var rowData = $gridDjMainRecords.getRowData(ids[i]);
                    if (rowData.ffzt === "0") {
                        //
                    }
                    else if (rowData.ffzt === 1) {
                        $('#' + ids[i]).find("td").addClass("bg-info");
                    }
                    else if (rowData.ffzt === 2) {
                        $('#' + ids[i]).find("td").addClass("bg-success");
                    }
                    else if (rowData.ffzt === 3) {
                        $('#' + ids[i]).find("td").addClass("bg-danger");
                    }
                }
            }
        });

        $("#btn_search").click(function () {
            $('#gridDJMXInfo').jqGrid("clearGridData");
            $gridDjMainRecords.jqGrid('setGridParam', {
                postData: getSearchPostData()
            }).trigger('reloadGrid');
        });
        $("#btn_search").trigger('click');
    }
    function getSearchPostData() {
        var startDate = $("#txtStartDate").val();
        var endDate = $("#txtEndDate").val();
        var sldh = $("#txtSLDH").val();
        var ffzt = $("#ddlFfzt").val();
        var from = "query";
        return { startDate: startDate, endDate: endDate, sldh: sldh, ffzt: ffzt, from: "query" };
    };

    //sự kiện nhấp chuột
    function btn_selectrow(rowId) {
        //mỗi lần nhấp, trước tiên xóa chi tiết sau đó tải lại chi tiết của tất cả các dòng đã chọn
        $('#gridDJMXInfo').jqGrid("clearGridData");
        $.najax({
            type: "POST",
            url: "/Pharmacy/RequisitionDetailList",
            data: { sldId: $("#gridDJMainRecords").jqGrid('getRowData', rowId).sldId },
            dataType: "json",
            success: function (ajaxresp) {
                if (ajaxresp.state === 'success') {
                    $('#gridDJMXInfo').newtouchLocalDataGrid(null, ajaxresp.data);
                }
                else {
                    $.newtouchAlert(ajaxresp);
                    return;
                }
            }
        });
    }

    //chi tiết phiếu lĩnh
    $('#gridDJMXInfo').newtouchLocalDataGrid({
        height: $(window).height() - 380,
        caption: "chi tiết phiếu lĩnh",
        unwritten: false,
        sortable: false,
        colModel: [
            { label: 'tên thuốc', name: 'ypmc', width: 150, align: 'left' },
            { label: 'số lô', name: 'ph', width: 100, align: 'left' },
            { label: 'lô', name: 'pc', hidden: true, width: 50, align: 'left' },
            { label: 'ngày hiệu lực', name: 'Yxrq', width: 120, align: 'left', formatter: 'date', formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
            { label: 'số lượng lĩnh', name: 'slsl', width: 120, align: 'left' },
            { label: 'đơn vị số lượng lĩnh', name: 'slsldw', width: 120, align: 'left' },
            { label: 'số lượng đã phát', name: 'yfsl', width: 120, align: 'left' },
            { label: 'số lượng đã phát đơn vị', name: 'yfsldw', width: 120, align: 'left' }
        ]
    });

</script>

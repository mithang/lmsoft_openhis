@using Newtouch.Common.Operator;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        @if (OperatorProvider.GetCurrent().IsRoot)
        {
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>tạo mới</a>
            </div>
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>sửa</a>
            </div>
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-pencil-square-o"></i>xóa</a>
            </div>
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_authorg()"><i class="fa fa-plus"></i>cơ quan ủy quyền</a>
            </div>
        }
        @if (OperatorProvider.GetCurrent().IsRoot || OperatorProvider.GetCurrent().IsAdministrator)
        {
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_modulebutton()"><i class="fa fa-gavel"></i>nút menu</a>
            </div>
        }
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="tên" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script>
    $(function () {
        gridList();
    })
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            treeGrid: true,
            treeGridModel: "adjacency",
            ExpandColumn: "EnName",
            url: "/Module/GetTreeGridJson",
            height: $(window).height() - 96,
            colModel: [
                { label: "khóa chính", name: "Id", hidden: true, key: true },
                { label: 'tên', name: 'Name', width: 200, align: 'left' },
                { label: 'tên tiếng Anh', name: 'EnName', width: 200, align: 'left' },
                { label: 'kết nối', name: 'UrlAddress', width: 260, align: 'left' },
                {
                    label: 'mục tiêu', name: 'Target', width: 100, align: 'center',
                    formatter: function (cellvalue) {
                        if (cellvalue == "expand") {
                            return "không có trang";
                        } else if (cellvalue == "iframe") {
                            return "trang khung";
                        } else if (cellvalue == "open") {
                            return "trang bật lên";
                        } else if (cellvalue == "blank") {
                            return "cửa sổ mới";
                        }
                    }
                },
                {
                    label: "是否开放", name: "IsOpenToOrg", width: 100, align: "center",
                    formatter: function (cellvalue) {
                        return cellvalue == 1 ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>";
                    }
                },
                { label: 'giới thiệu', name: 'Description', width: 300, align: 'left' },
                { label: "còn hiệu lực", name: "zt", width: 80, align: "center", formatter: function (cellvalue) { return cellvalue == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
                { label: 'người tạo', name: 'CreatorCode', width: 100, align: 'left' },
                { label: 'thời gian tạo', name: 'CreateTime', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'sửa đổi lần cuối', name: 'LastModifierCode', width: 100, align: 'left' },
                { label: 'thời gian sửa đổi lần cuối', name: 'LastModifyTime', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'sắp xếp', name: 'px', width: 40, align: 'left' }
            ]
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword").val() },
            }).trigger('reloadGrid');
        });
    }

    //sự kiện Enter
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "thêm mới menu",
            url: "/Module/Form",
            width: "700px",
            height: "440px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_edit() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("vui lòng chọn một bản ghi", 'warning');
            return;
        }
        $.modalOpen({
            id: "Form",
            title: "sửa menu",
            url: "/Module/Form?keyValue=" + keyValue,
            width: "700px",
            height: "440px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_delete() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("vui lòng chọn một bản ghi", 'warning');
            return;
        }
        $.deleteForm({
            url: "/Module/DeleteForm",
            param: { keyValue: keyValue },
            success: function () {
                $.currentWindow().$("#gridList").resetSelection();
                $.currentWindow().$("#gridList").trigger("reloadGrid");
            }
        })
    }
    function btn_modulebutton() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("vui lòng chọn một bản ghi", 'warning');
            return;
        }
        $.modalOpen({
            id: "modulebutton",
            title: "nút menu",
            url: "/ModuleButton/Index?moduleId=" + keyValue,
            width: "750px",
            height: "440px",
            btn: null,
        });
    }

    function btn_authorg() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("vui lòng chọn một bản ghi", 'warning');
            return;
        }
        $.modalOpen({
            id: "Form",
            title: "cơ quan ủy quyền",
            url: "/Module/Organizes?keyValue=" + keyValue,
            width: "350px",
            height: "550px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
</script>
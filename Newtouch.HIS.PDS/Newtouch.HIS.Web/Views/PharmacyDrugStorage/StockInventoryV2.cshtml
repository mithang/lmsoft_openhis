@{
    ViewBag.Title = "StockInventory";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<input hidden id="yfbmcode" value="@ViewBag.bmCode">
<input hidden id="OrganizeId" value="@ViewBag.OrganizeId">
<style>
    .dv-panel {
        width: 100%;
        position: fixed;
        height: 100%;
    }

    #btn_search {
        width: 50px;
        margin-left: 40px;
    }

    .dv-index {
        position: absolute;
        top: 50%;
        left: 50%;
        margin-left: -230px;
        margin-top: -50px;
    }

        .dv-index div {
            float: left;
            width: 200px;
            height: 50px;
            background-color: #00a0ea;
            -moz-border-radius: 5px;
            -webkit-border-radius: 5px;
            line-height: 50px;
            text-align: center;
            font-size: 18px;
            font-weight: bold;
            color: white;
            margin-right: 30px;
            cursor: pointer;
            -webkit-box-shadow: #666 3px 4px 8px;
            -moz-box-shadow: #666 3px 4px 8px;
            box-shadow: #666 3px 4px 8px;
        }

    .dv-content-step {
        width: 100%;
        display: none;
    }

    .dv-navigation {
        height: 45px;
        margin-bottom: 5px;
    }

    .dv-backIndex {
        float: left;
        line-height: 45px;
        margin-left: 10px;
    }

    .progress_bar {
        margin-left: 100px;
        padding: 10px 0 10px;
    }

        .progress_bar li {
            width: 180px;
            float: left;
            text-align: center;
            position: relative;
            line-height: 30px;
            list-style: none;
            border-top: 6px solid #f5f5f5;
        }

            .progress_bar li i {
                position: absolute;
                left: 50%;
                margin-left: -10px;
                top: -14px;
                height: 18px;
                width: 18px;
                border: 2px solid white;
                border-radius: 10px;
                background-color: #f5f5f5;
            }

        .progress_bar .completeLi {
            color: #ff9813;
            border-top-color: #ff9813;
        }

        .progress_bar .completePoint {
            background-color: #ff9813;
        }

    .dv-SearchHistory {
        overflow-x: auto;
        display: none;
    }

    .dv-pd {
        overflow-x: auto;
        display: none;
    }

    .dv-pd-btn {
        display: none;
    }

    .form-control {
        padding: 0 3px;
    }
</style>
<div class="dv-panel">
    <div class="dv-index">
        <div id="dv_index_startPd">bắt đầu kiểm kê</div>
        <div id="dv_search">tra cứu</div>
    </div>
    <div class="dv-content-step">
        <div class="panel panel-default dv-navigation">
            <div class="dv-backIndex"><input type="button" id="btn_backIndex" class="btn btn-primary" value="quay về trang chủ" /></div>
            <ol class="progress_bar">
                <li id="dv_startPd"><i></i><label>bắt đầu kiểm kê</label></li>
                <li id="dv_savePd"><i></i><label>lưu</label></li>
                <li id="dv_endPd"><i></i><label>kết thúc kiểm kê</label></li>
                <li id="dv_completePd"><i></i><label>hoàn thành</label></li>
            </ol>
        </div>
        <div class="panel panel-default" style="margin-bottom:5px;">
            <div class="panel-heading">
                điều kiện tra cứu
            </div>
            <table class="form">
                <tr>
                    <th class="formTitle" style="width: 70px;">ngày: </th>
                    <td class="formValue" colspan="2">
                        <select id="ddlRQ" class="form-control"></select>
                    </td>
                    <th class="formTitle">từ khóa: </th>
                    <td class="formValue" style="width: 115px;">
                        <input id="txtSRM" type="text" class="form-control" placeholder="phiên âm tên thuốc" />
                    </td>
                    <th class="formTitle">trạng thái thuốc: </th>
                    <td class="formValue" style="width: 55px;">
                        <select id="ddlYPZT" name="ddlYPZT" class="form-control">
                            <option value="-1">tất cả</option>
                            <option value="1">kích hoạt</option>
                            <option value="0">ngừng sử dụng</option>
                        </select>
                    </td>
                    <th class="formTitle" style="display:none">loại thuốc: </th>
                    <td class="formValue" style="display:none">
                        <select id="ddlYPLB" class="form-control">
                            <option value="">tất cả</option>
                        </select>
                    </td>
                    <th class="formTitle">hiển thị tồn kho: </th>
                    <td class="formValue">
                        <select id="ddlKCXS" name="ddlKCXS" class="form-control">
                            <option value="-1">tất cả</option>
                            <option value="0">hiển thị tồn kho bằng 0</option>
                            <option value="1">không hiển thị số lượng lý thuyết bằng 0</option>
                            <option value="2">không hiển thị số lượng thực tế bằng 0</option>
                            <option value="4">không hiển thị khi cả hai đều bằng 0</option>
                        </select>
                    </td>
                    <td class="formValue">
                        <input type="button" id="btn_search" class="btn btn-primary" value="tra cứu" />
                    </td>
                </tr>
            </table>
        </div>
        <div class="dv-SearchHistory">
            <table id="gridKCInfoHistory"></table>
            <div id="gridPagerHistory" rel="form1"></div>

        </div>
        <div class="dv-pd">
            <table id="gridKCInfo"></table>
            <div id="gridPager" rel="form1"></div>

        </div>
        <div id="button_1" class="dv-pd-btn">
            @Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
       {
           ShowKeyList = new[] { 8, 3, 7, },
           //F2Text = "bắt đầu",
           F3Text = "kết thúc",
           F7Text = "hủy"
       })
        </div>
        <div id="button_2" class="dv-pd-btn">
            @Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
       {
           ShowKeyList = new[] { 10, 6, 9, },
           F10Text = "nhóm lớn chi tiết",
           F6Text = "dạng bào chế chi tiết",
           F9Text = "chi tiết kiểm kê"
       })
        </div>
    </div>
</div>

<script>
    var $gridKCInfo = $("#gridKCInfo");
    var $gridKCInfoHistory = $("#gridKCInfoHistory");
    var lastRowId;
    var ObjArr_Load = new Array();
    var searchType = 0;//0:lịch sử tra cứu 1: bắt đầu kiểm kê
    $(function () {
        $(window).resize(function () {//tải lại khi thay đổi kích thước cửa sổ trình duyệt jqGrid chiều rộng
            window.initLayout("MyTabGrid");
        });
        InitialPd();
        $("#btn_search").click(function () {//gắn tra cứu
            Search();
        });

        $("#dv_search").click(function () {//xem lịch sử
            $(".dv-content-step").show();
            $(".dv-index").hide();
            $(".dv-pd").hide();
            $("#button_1").hide();
            $("#button_2").show();
            $(".dv-SearchHistory").show();
            searchType = 0;
            Search();
        });
        $("#dv_index_startPd").click(function () {//bắt đầu kiểm kê
            $(".dv-content-step").show();
            $(".dv-index").hide();
            $(".dv-pd").show();
            $("#button_1").show();
            $("#button_2").hide();
            $(".dv-SearchHistory").hide();
            searchType = 1;
            newtouch_event_f2();
        });
        $("#btn_backIndex").click(function () {//quay lại
            $(".dv-content-step").hide();
            $(".dv-index").show();
            searchType = 0;
        });

    });

    //khởi tạo kiểm kê
    function InitialPd() {
        GetPDSJ();//lấy ngày kiểm kê
        gridKCInfoHistory();
        gridKCInfo();
    }

    //thông tin tồn kho
    function gridKCInfo() {
        $gridKCInfo.dataGrid({
            caption: "thuốc kiểm kê thông tin (<lable style='color:#ff0000;'>(thực)số bộ phận: số đơn vị bộ phận thực tế; (thực)số nhỏ nhất: số đơn vị nhỏ nhất thực tế!请将部门数与最小数组合使用</lable>)",
            postData: getSearchPostData(),
            height: $(window).height() - 270,
            url: "",
            editurl: "clientArray",  //chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            colModel: [
                { label: 'tên thuốc', name: 'ypmc', width: 120, align: 'left' },
                { label: 'quy cách', name: 'ypgg', width: 80, align: 'left' },
                { label: 'số lượng lý thuyết', name: 'llsl', width: 80, align: 'left' },
                { label: '(thực)số bộ phận', name: 'deptSjsl', width: 70, align: 'center', editable: true, editwidth: "90%" },
                { label: 'đơn vị', name: 'deptdw', width: 40, align: 'left' },
                { label: '(thực)số nhỏ nhất', name: 'minSjsl', width: 70, align: 'center', editable: true, editwidth: "90%" },
                { label: 'đơn vị', name: 'zxdw', width: 40, align: 'left' },
                { label: 'hệ số', name: 'zhyz', width: 40, align: 'left' },
                { label: 'số lô', name: 'ph', width: 100, align: 'center' },
                { label: 'lô', name: 'pc', width: 100, align: 'left' },
                { label: 'hạn sử dụng', name: 'yxq', width: 80, align: 'left' },
                { label: 'giá bán buôn', name: 'pfj', width: 60, align: 'left' },
                { label: 'giá bán lẻ', name: 'lsj', width: 60, align: 'left' },
                { label: 'tiền bán buôn(lý thuyết)', name: 'llpfje', width: 70, align: 'left' },
                { label: 'tiền bán lẻ(lý thuyết)', name: 'lllsje', width: 70, align: 'left' },
                { label: 'tiền bán buôn(thực)', name: 'sjpfje', width: 70, align: 'left' },
                { label: 'tiền bán lẻ(thực)', name: 'sjlsje', width: 70, align: 'left' },
                { label: 'nơi sản xuất', name: 'ycmc', width: 120, align: 'left' },
                { label: 'phiên âm', name: 'py', width: 100, align: 'left' },
                { label: 'pdmxId', name: 'pdmxId', hidden: true },
                { label: 'số lượng lý thuyết', name: 'llsl_zxbz', hidden: true },
                { label: 'mã thuốc', name: 'ypCode', hidden: true },
                { label: 'số lượng thực tế(đóng gói theo bộ phận)', name: 'sjslstr', hidden: true },
                { label: 'CreateTime', name: 'CreateTime', hidden: true }
            ],
            multiselect: false,
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            sortable: true,
            viewrecords: true,
            gridComplete: function () {
                afterCompleteFunction();
                window.initLayout("MyTabGrid");
            },
            onSelectRow: function (rowid) {
                $("#" + $.jgrid.jqID(rowid) + "_sjsl").focus();
            },
            onSelectRow_page: function (rowid) {
                if (rowid && lastRowId && rowid !== lastRowId) {   //&&: tương đương với true/fase(đánh giá có hay không có giá trị)
                    $gridKCInfo.saveRow(lastRowId, null, null, null, function (callbackRowId) {//trước tiên lưu ở chỉnh sửa trạng thái của đó một dòng
                        GetYfbmYpComplexYpSlandDw(callbackRowId);//thay đổi số lượng theo đơn vị bộ phận hiện tại
                    }, null, null);
                }
                lastRowId = rowid;
                $gridKCInfo.jqGrid('editRow', rowid, true, null, null, null, null, function (callbackRowId) {
                    GetYfbmYpComplexYpSlandDw(callbackRowId);//thay đổi số lượng theo đơn vị bộ phận hiện tại
                    lastRowId = undefined;  //Gọi lại
                });
            }
        });
    }

    //thông tin tồn kho tra cứu
    function gridKCInfoHistory() {
        $gridKCInfoHistory.dataGrid({
            caption: "lịch sử kiểm kê thông tin",
            postData: getSearchPostData(),
            height: $(window).height() - 270,
            url: "",
            editurl: "clientArray",  //chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            colModel: [
                { label: 'tên thuốc', name: 'ypmc', width: 120, align: 'left' },
                { label: 'quy cách', name: 'ypgg', width: 70, align: 'left' },
                { label: 'số lượng lý thuyết', name: 'llsl', width: 70, align: 'left' },
                { label: 'số thực tế', name: 'sjslstr', width: 70, align: 'left' },
                { label: 'số lô', name: 'ph', width: 100, align: 'center' },
                { label: 'lô', name: 'pc', width: 100, align: 'left' },
                { label: 'hạn sử dụng', name: 'yxq', width: 80, align: 'left' },
                { label: 'giá bán buôn', name: 'pfj', width: 60, align: 'left' },
                { label: 'giá bán lẻ', name: 'lsj', width: 60, align: 'left' },
                { label: 'tiền bán buôn(lý thuyết)', name: 'llpfje', width: 70, align: 'left' },
                { label: 'tiền bán lẻ(lý thuyết)', name: 'lllsje', width: 70, align: 'left' },
                { label: 'tiền bán buôn(thực)', name: 'sjpfje', width: 70, align: 'left' },
                { label: 'tiền bán lẻ(thực)', name: 'sjlsje', width: 70, align: 'left' },
                { label: 'đơn vị', name: 'deptdw', width: 50, align: 'left' },
                { label: 'nơi sản xuất', name: 'ycmc', width: 120, align: 'left' },
                { label: 'phiên âm', name: 'py', width: 100, align: 'left' },
                { label: 'số lượng', name: 'deptSjsl', hidden: true },
                { label: 'số lượng lý thuyết', name: 'llsl_zxbz', hidden: true },
                { label: 'pdmxId', name: 'pdmxId', hidden: true },
                { label: 'zhyz', name: 'zhyz', hidden: true },
                { label: 'mã thuốc', name: 'ypCode', hidden: true },
                { label: 'số lượng thực tế(đóng gói theo bộ phận)', name: 'sjslstr', hidden: true },
                { label: 'số lượng thực tế(đơn vị nhỏ nhất)', name: 'minSjsl', hidden: true },
                { label: 'đơn vị nhỏ nhất', name: 'zxdw', hidden: true },
                { label: 'CreateTime', name: 'CreateTime', hidden: true }
            ],
            gridComplete: function () {
                window.initLayout("MyTabGrid");
            },
            multiselect: false,
            pager: "#gridPagerHistory",
            sortname: 'CreateTime desc',
            viewrecords: true
        });
    }

    //tra cứu
    function Search() {
        if (searchType === 0) {
            $gridKCInfoHistory.jqGrid('setGridParam',
                {
                    url: "/PharmacyDrugStorage/SelectInventoryInfoList?r=" + Math.random(),
                    postData: getSearchPostData()
                }).trigger('reloadGrid');
            $.UpdateProgressbar.clean();
        } else {
            $gridKCInfo.jqGrid('setGridParam',
                {
                    url: "/PharmacyDrugStorage/SelectInventoryInfoList?r=" + Math.random(),
                    postData: getSearchPostData()
                }).trigger('reloadGrid');
        }
    }

    //điều kiện tra cứu
    function getSearchPostData() {
        var pdsj = $("#ddlRQ").val();
        var pdId = $("#ddlRQ option:selected").attr('data-pdId');
        var srm = $("#txtSRM").val();
        var ypzt = $("#ddlYPZT").val();
        var kcxs = $("#ddlKCXS").val();
        if (!pdsj && !pdId) {
            return false;
        }
        if (kcxs === "" || kcxs == null) {
            kcxs = -1;
        }
        return { pdsj: pdsj, pdId: pdId, srm: srm, ypzt: ypzt, yplb: "", kcxs: kcxs };
    };

    //tải dữ liệu tra cứu lần đầu
    function afterCompleteFunction() {
        var rowIds = $("#gridKCInfo").jqGrid('getDataIDs');//Grid sau khi tải xong thì bật chỉnh sửa trong dòng   1.trước tiên lấy tất cả các dòng Id  2.duyệt và gọi editRow phương thức
        for (var i = 0; i < rowIds.length; i++) {
            ObjArr_Load.push($("#gridKCInfo").jqGrid('getRowData', rowIds[i]));
            $("#gridKCInfo").jqGrid('editRow', rowIds[i], true, null, null, null, null, function (callbackRowId) {     //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.
            });
        }
    }

    //lấy thời gian kiểm kê
    function GetPDSJ() {
        $.najax({
            type: "GET",
            url: "/PharmacyDrugStorage/GetPDDateDropdownList",
            dataType: "json",
            success: function (ajaxresp) {
                //trước tiên xóa sạch, sau đó điền
                $("#ddlRQ").empty();
                for (var i = 0; i < ajaxresp.data.length; i++) {
                    $("#ddlRQ").append('<option data-pdId=' + ajaxresp.data[i].pdId + '>' + ajaxresp.data[i].pdsj + '</option>');
                }
            }
        });

    }

    //nhập đơn vị nhỏ nhất dưới của số lượng, thay đổi số lượng theo đơn vị bộ phận hiện tại
    function GetYfbmYpComplexYpSlandDw(callbackRowId) {
        var rowData = $("#gridKCInfo").jqGrid('getRowData', callbackRowId);
        $.najax({
            type: "POST",
            url: "/PharmacyDrugStorage/GetYfbmYpComplexYpSlandDw",
            dataType: "json",
            data: { sl: rowData.sjsl, ypCode: rowData.ypCode },
            success: function (ajaxresp) {
                $('#gridKCInfo').jqGrid('setCell', callbackRowId, 'sjslstr', ajaxresp);
            }
        });
    }

    //bắt đầu kiểm kê
    function newtouch_event_f2() {
        $.najax({
            type: "POST",
            url: "/PharmacyDrugStorage/StartInventory",
            dataType: "json",
            success: function (ajaxresp) {
                if (ajaxresp != null && ajaxresp.data != null) {
                    $("#ddlRQ").append('<option data-pdId=' + ajaxresp.data.pdId + ' selected="selected">' + ajaxresp.data.pdsj + '</option>');
                }
                Search();
                $.UpdateProgressbar.update(1);
            }
        });
    }

    //lưu
    function newtouch_event_f8() {
        var rowIds = $("#gridKCInfo").jqGrid('getDataIDs');//lấy tất cả các dòng Id, duyệt để hộp chỉnh sửa ở trạng thái đã lưu
        //đánh giá số lượng trả
        for (var i = 0; i < rowIds.length; i++) {
            $("#gridKCInfo").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);
            var rowData = $("#gridKCInfo").jqGrid('getRowData', rowIds[i]);
            if (!rowData) {
                return false;
            }
            if ((rowData.deptSjsl.replace(/(^\s*)|(\s*$)/g, "") === "" && rowData.minSjsl.replace(/(^\s*)|(\s*$)/g, "") === "") ||
                (rowData.deptSjsl < 0 && rowData.minSjsl < 0) ||
                (isNaN(rowData.deptSjsl) && isNaN(rowData.minSjsl)) ||
                (rowData.deptSjsl === "" && rowData.minSjsl === "")) {
                $.modalAlert("hạng mục (" + rowData.ypmc + ")số lượng thực tế phải là số tự nhiên, vui lòng xác nhận.", "warning");
                EnableInlineEditBox();//bật hộp chỉnh sửa trong dòng
                return false;
            }
        }
        var kcInfoJsonSave = $("#gridKCInfo").jqGrid('getRowData_AllLine');
        var objArrSave = new Array();
        $.each(kcInfoJsonSave, function () {//khi lưu thì Grid đặt dòng dữ liệu vào mảng mới
            objArrSave.push(this);
        });
        var resultObjArr = new Array();
        //so sánh với mảng tải khi tải trang, đặt dòng dữ liệu đã sửa vào resultObjArr trong, gửi cho backend
        for (var i = 0; i < objArrSave.length; i++) {
            if (objArrSave[i].deptSjsl !== ObjArr_Load[i].deptSjsl || objArrSave[i].minSjsl !== ObjArr_Load[i].minSjsl) {
                resultObjArr.push({ pdmxId: objArrSave[i].pdmxId, sjsl: CalculationMinUnitNum(objArrSave[i].deptSjsl, objArrSave[i].minSjsl, objArrSave[i].zhyz) });
                //resultObjArr.push({ pdmxId: objArrSave[i].pdmxId, sjsl: CalculationMinUnitNumNoOpen(objArrSave[i].deptSjsl, objArrSave[i].zhyz) });
            }
        }
        if (resultObjArr.length === 0) {
            $.modalAlert("không có cần lưu của dữ liệu", 'warning');
            $("#btn_search").trigger("click");
            $.UpdateProgressbar.update(2);
            return false;
        }
        $.najax({
            type: "POST",
            url: "/PharmacyDrugStorage/SaveInventoryInfo",
            dataType: "json",
            data: { resultObjArr: JSON.stringify(resultObjArr), pdId: $("#ddlRQ option:selected").attr('data-pdId') },
            success: function (ajaxresp) {
                $.modalAlert("lưu thành công", 'success');
                $("#btn_search").trigger("click");
                $.UpdateProgressbar.update(2);
            },
            error: function (ajaxresp) {
                $.modalAlert(ajaxresp.message, Error);
            }
        });
    }

    //quy đổi tồn kho thành số đơn vị nhỏ nhất  tách lẻ
    function CalculationMinUnitNum(deptNum, minNum, zhyz) {
        return parseInt(deptNum) * parseInt(zhyz) + parseInt(minNum);
    }

    //quy đổi tồn kho thành số đơn vị nhỏ nhất  không tách lẻ
    function CalculationMinUnitNumNoOpen(deptNum, zhyz) {
        return parseInt(deptNum) * parseInt(zhyz);
    }

    //bật hộp chỉnh sửa trong dòng
    function EnableInlineEditBox() {
        var rowIds = $("#gridKCInfo").jqGrid('getDataIDs');//Grid sau khi tải xong thì bật chỉnh sửa trong dòng   1.trước tiên lấy tất cả các dòng Id  2.duyệt và gọi editRow phương thức
        for (var i = 0; i < rowIds.length; i++) {
            $("#gridKCInfo").jqGrid('editRow', rowIds[i], true, null, null, null, null, function (callbackRowId) {     //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.
            });
        }
    }

    //kết thúc kiểm kê
    function newtouch_event_f3() {
        $.najax({
            type: "POST",

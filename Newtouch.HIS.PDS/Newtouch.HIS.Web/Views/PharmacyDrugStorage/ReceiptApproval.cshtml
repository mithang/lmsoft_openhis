@using Newtouch.Infrastructure;
@using Newtouch.HIS.Web.Core.Extensions;
@{
    ViewBag.Title = "ReceiptApproval";
    Layout = "~/Views/Shared/_Index.cshtml";
    var djlxItemStrs = "1,2,3,4,5,6"; //enum tương ứng EnumDanJuLX
    if (Constants.CurrentYfbm.yfbmjb == "2")  //nhà thuốc
    {
        djlxItemStrs = "3,4,6"; //có thể duyệt trực tiếp phát thuốc, phát thuốc theo phiếu lĩnh, khoa phát thuốc
    }
    else   //kho thuốc
    {
        djlxItemStrs = "1,2,5";  //có thể duyệt thuốc nhập kho, xuất kho trực tiếp, trả lại thuốc phát nội bộ
    }
}
<style>
    #btn_search {
        height: 45px;
        width: 45px;
        background-color: #fff;
        color: #00a9ea;
        font-weight: bolder;
    }

    input[name=fph] {
        padding: 2px;
    }
</style>
<form id="form1">
    <div class="panel panel-default">
        <div class="panel-heading">
            điều kiện tra cứu
        </div>
        <div>
            <table class="form">
                <tr>
                    <th class="formTitle">số chứng từ: </th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="txtPDH" />
                    </td>
                    <th class="formTitle">ngày: </th>
                    <td class="formValue">
                        <input id="txtStartDate" type="text" class="form-control input-wdatepicker " value="@DateTime.Now.AddMonths(-2).ToString("yyyy-MM-dd 00:00:00")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                    </td>
                    <th class="formTitle">đến: </th>
                    <td class="formValue">
                        <input id="txtEndDate" type="text" class="form-control input-wdatepicker " value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                    </td>
                    <td class="formTitle" rowspan="2">
                        <input type="button" id="btn_search" class="btn btn-md btn-primary" value="tra cứu" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">số hóa đơn: </th>
                    <td class="formValue">
                        <input id="txtFPH" type="text" class="form-control " />
                    </td>
                    <th class="formTitle">trạng thái duyệt: </th>
                    <td class="formValue">
                        @Html.DropDownList("ddlSHZT", EnumDjShzt.WaitingApprove.ToDescSelectList(), "tất cả", new { @class = "form-control" })
                    </td>

                    <th class="formTitle">loại chứng từ: </th>
                    <td class="formValue">
                        @Html.DropDownList("ddlDJLX", EnumDanJuLX.yaopinruku.ToSomeDescSelectList(djlxItemStrs), "tất cả", new { @class = "form-control" })
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel">
        <table id="gridDJMainRecords"></table>
        <div id="gridPager" rel="form1"></div>
    </div>
    <div style="margin-top:5px;">
        <table id="gridDJMXInfo"></table>
    </div>
</form>

@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 6, 7, 8 },
    F6Text = "duyệt",
    F7Text = "không đạt",
    F8Text = "hủy bỏ"
})
<script>
    $(function () {
        //tải lại khi thay đổi kích thước cửa sổ trình duyệt jqGrid chiều rộng
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
            $("#gridDJMainRecords").setGridHeight(($(window).height() - 300) / 2);
            $("#gridDJMXInfo").setGridHeight(($(window).height() - 300) / 2);
        });
        Init();
        gridDJMainRecords();
    });

    //khởi tạo
    function Init() {
        $('#ddlSHZT').val('@((int)EnumDjShzt.WaitingApprove)');//.bindSelect();
        var djlx = getQueryString("djlx");
        if (djlx != null) {
            $("#ddlDJLX").val(djlx);
        }
    }

    //bản ghi chính của chứng từ
    function gridDJMainRecords() {
        var $gridDjMainRecords = $("#gridDJMainRecords");
        $gridDjMainRecords.dataGrid({
            postData: getSearchPostData(),
            height: ($(window).height() - 300) / 2,
            url: "/PharmacyDrugStorage/SelectReceiptMainInfo?from=approval",
            colModel: [
                {
                    label: 'trạng thái duyệt', name: 'shzt', width: 60, align: 'left', formatter: function (val) {
                        return val === "0" ? "chưa duyệt" : (val === "1" ? "đã đạt" : (val === "2" ? "chưa đạt" : (val === "3" ? "đã hủy" : "")));
                    }
                },
                { label: 'loại chứng từ', name: 'djlxmc', width: 80, align: 'left' },
                { label: 'số chứng từ', name: 'pdh', width: 130, align: 'left' },
                { label: 'bộ phận xuất kho', name: 'ckbmmc', width: 100, align: 'left' },
                { label: 'nhà cung cấp', name: 'gysmc', width: 100, align: 'left' },
                { label: 'bộ phận nhập kho', name: 'rkbmmc', width: 100, align: 'left' },
                { label: 'phương thức nhập/xuất kho', name: 'crkfsmc', width: 90, align: 'left' },
                { label: 'thời gian thao tác', name: 'czsj', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:s', newformat: 'Y-m-d H:s' } },
                { label: 'giá bán buôn số tiền', name: 'pjze', width: 80, align: 'right', formatter: function (val) { return val.toFixed(2); }},
                { label: 'giá bán lẻ số tiền', name: 'ljze', width: 80, align: 'right', formatter: function (val) { return val.toFixed(2); }},
                { label: 'tổng tiền giá nhập', name: 'zje', width: 80, align: 'right', formatter: function (val) { return val.toFixed(2); }},
                { label: 'chênh lệch giá mua bán', name: 'jxcj', width: 80, align: 'right', formatter: function (val) { return val.toFixed(2); }},
                { label: 'crkId', name: 'crkId', hidden: true },
                { label: 'djlx', name: 'djlx', hidden: true },

            ],
            unwritten: false,
            multiselect: false,
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords: true,
            onSelectRow_page: function (rowId) {
                btn_selectrow(rowId);
            }
        });

        $("#btn_search").click(function () {
            $('#gridDJMXInfo').jqGrid("clearGridData");

            $gridDjMainRecords.jqGrid('setGridParam', {
                postData: getSearchPostData(),
            }).trigger('reloadGrid');
        });
        $("#btn_search").trigger('click');
    }
    function getSearchPostData() {
        var shzt = $("#ddlSHZT").val();
        var qsrj = $("#txtStartDate").val();
        var jsrj = $("#txtEndDate").val();
        var pdh = $("#txtPDH").val();
        var fph = $("#txtFPH").val();
        var djlx = $("#ddlDJLX").val();
        return { qsrj: qsrj, jsrj: jsrj, pdh: pdh, fph: fph, djlx: djlx, shzt: shzt };
    };

    //sự kiện nhấp chuột
    function btn_selectrow(rowId) {
        //mỗi lần nhấp, trước tiên xóa chi tiết sau đó tải lại chi tiết của tất cả các dòng đã chọn
        $('#gridDJMXInfo').jqGrid("clearGridData");
        $.najax({
            type: "POST",
            url: "/PharmacyDrugStorage/SelectReceipDetailInfo",
            data: { crkId: $("#gridDJMainRecords").jqGrid('getRowData', rowId).crkId, djlx: $("#gridDJMainRecords").jqGrid('getRowData', rowId).djlx },
            dataType: "json",
            success: function (ajaxresp) {
                $('#gridDJMXInfo').newtouchLocalDataGrid(null, ajaxresp);
                //if (ajaxresp.state === 'success') {
                //    $('#gridDJMXInfo').newtouchLocalDataGrid(null, ajaxresp.data);
                //}
                //else {
                //    $.modalMsg("lấy chi tiết thất bại", "error", 1000);
                //}
            }
        });
    }

    //chi tiết chứng từ
    $('#gridDJMXInfo').newtouchLocalDataGrid({
        height: ($(window).height() - 300) / 2,
        caption: "chi tiết chứng từ",
        unwritten: false,
        sortable: false,
        colModel: [
            { label: 'số thứ tự chi tiết nhập/xuất kho', name: 'crkmxId', hidden: true, width: 100, align: 'left' },
            {
                label: 'số hóa đơn', name: 'fph', width: 90, align: 'left',
                formatter: function (cellvalue, options) { return cellvalue === "" || cellvalue === null ? "<input type=\"text\" name=\"fph\" rowid=" + options.rowId + " role=\"textbox\" class=\"editable inline-edit-cell form-control\" style=\"width: 90%; height: 99%;\" onblur=\"UpdateFph(this)\">" : cellvalue; }
            },
            { label: 'loại thuốc', name: 'yplbmc', width: 60, align: 'left' },
            { label: 'tên thuốc', name: 'ypmc', width: 110, align: 'left' },
            { label: 'số lượng', name: 'sl', width: 55, align: 'left' },
            { label: 'đơn vị', name: 'dw', width: 50, align: 'left' },
            { label: 'quy cách', name: 'gg', width: 70, align: 'left' },
            { label: 'số lô', name: 'ph', width: 90, align: 'left' },
            { label: 'lô', name: 'pc', width: 90, align: 'left' },
            { label: 'nhà sản xuất', name: 'sccj', width: 110, align: 'left' },
            { label: '批价金额', name: 'pjze', width: 60, align: 'left', formatter: function (val) { return val.toFixed(2); }},
            { label: 'không giá số tiền', name: 'ljze', width: 60, align: 'left', formatter: function (val) { return val.toFixed(2); }},
            { label: 'giá nhập', name: 'jj', width: 60, align: 'left', formatter: function (val) { return val.toFixed(2); } },
            { label: 'tổng tiền giá nhập', name: 'zje', width: 60, align: 'left', formatter: function (val) { return val.toFixed(2); }},
            { label: 'chênh lệch giá mua bán', name: 'jxcj', width: 60, align: 'left', formatter: function (val) { return val.toFixed(2); } },
            { label: 'tỷ lệ chiết khấu', name: 'kl', width: 50, align: 'left' },
            { label: 'phiên âm', name: 'py', width: 100, align: 'left', hidden: true },
            { label: 'số lượng', name: 'slanddw', width: 60, align: 'left', hidden: true }
        ],
        gridComplete: function () {//phương thức thực thi sau khi jqGrid tải xong
        },
    });

    //bổ sung số hóa đơn
    function UpdateFph(obj) {
        var fph = $(obj).val();
        var crkmxId = $("#gridDJMXInfo").getRowData($(obj).attr("rowid")).crkmxId;
        if (fph != "") {
            $.modalConfirm("bạn có chắc muốn đổi số hóa đơn thành" + fph + "không?", function (flag) {
                if (flag)
                {
                    $.najax({
                        url: "/PharmacyDrugStorage/UpdateFph",
                        type: "POST",
                        data: { crkmxId: crkmxId,fph: fph },
                        dataType: "json",
                        success: function (data) {
                            if (data.state === 'success') {
                                $.modalMsg("đổi số hóa đơn thành công", "success", 1000);
                            }
                            else {
                                $.newtouchAlert(data);
                            }
                        }
                    });
                }
            })

        }
    }
    //duyệt
    function newtouch_event_f6() {
        submitReceiptApproval(@((int)EnumDjShzt.Approved));
    }

    //chưa đạt
    function newtouch_event_f7() {
        submitReceiptApproval(@((int)EnumDjShzt.Rejected));
    }

    //hủy bỏ
    function newtouch_event_f8() {
        submitReceiptApproval(@((int)EnumDjShzt.Cancelled));
    }

    //cập nhật đơn chứng trạng thái duyệt, gửi đến máy chủ
    function submitReceiptApproval(dstnShzt) {
        var selRowData = $("#gridDJMainRecords").jqGridRowValue();
        if (!selRowData || !selRowData.crkId || !selRowData.djlx) {
            $.modalAlert('vui lòng chọn một dòng đơn chứng', 'error');
            return;
        }
        if (selRowData.crkId && selRowData.djlx) {
            var postData = { crkId: selRowData.crkId, djlx: selRowData.djlx, shzt: dstnShzt };
            $.najax({
                url: "/PharmacyDrugStorage/SubmitReceiptApproval",
                data: postData,
                type: 'POST',
                dataType: 'json',
                success: function (ajaxresp) {
                    if (ajaxresp.state === 'success') {
                        $.newtouchAlert(ajaxresp);
                    }
                    else {
                        $.newtouchAlert(ajaxresp);
                        return;
                    }
                },
                complete: function () {
                    $("#btn_search").trigger('click');
                }
            });
        }
    }

    //lấy url trong của tham số
    function getQueryString(name) {
        // khớp tham số đích
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
        var result = window.location.search.substr(1).match(reg); // đối với querystringkhớp tham số đích
        if (result != null) {
            return decodeURIComponent(result[2]);
        } else {
            return null;
        }
    }
</script>


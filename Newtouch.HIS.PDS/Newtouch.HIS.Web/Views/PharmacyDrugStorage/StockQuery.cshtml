@using Newtouch.Infrastructure;
@using Newtouch.HIS.Web.Core.Extensions;
@{
    ViewBag.Title = "InventoryQuery";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    .i-showMore {
        float: right;
        margin-top: -8px;
        font-size: 2.5rem;
        margin-left: 10px;
    }

    #btn_search {
        width: 45px;
        font-weight: bolder;
    }

    #btn_print {
        width: 45px;
        background-color: #fff;
        color: #00a9ea;
        font-weight: bolder;
    }
</style>
<input hidden id="yfbmcode" value="@ViewBag.bmCode">
<input hidden id="OrganizeId" value="@ViewBag.OrganizeId">
<form id="form1">
    <div class="panel panel-default" style="margin-bottom:5px;">
        <div class="panel-heading">
            điều kiện tra cứu
        </div>
        <div>
            <table class="form">
                <tr>
                    <th class="formTitle">từ khóa: </th>
                    <td class="formValue" style="width:150px;">
                        <input id="txtINPUTCODE" type="text" class="form-control" placeholder="tên thuốc mã phiên âm" />
                    </td>
                    <th class="formTitle">trạng thái tồn kho: </th>
                    <td class="formValue" style="width:80px;">
                        @Html.DropDownList("ddlKCZT", EnumKCZT.Disabled.ToDescSelectList(), "tất cả", new { @class = "form-control" })
                    </td>
                    <th class="formTitle">này bộ phận trạng thái: </th>
                    <td class="formValue" style="width:80px;">
                        @Html.DropDownList("ddlBBMZT", BenBuMenZT.Control.ToDescSelectList(), "tất cả", new { @class = "form-control" })
                    </td>
                    <td class="formValue">
                        <div class="ckbox ckmargin">
                            <input id="chk_NoShow0KC" type="checkbox" /><label for="chk_NoShow0KC">không hiển thị không tồn kho</label>
                        </div>
                    </td>
                    <td class="formTitle" style="width:150px;">
                        <input type="button" id="btn_search" class="btn btn-md btn-primary" value="tra cứu" />
                        <input type="button" id="btn_print" class="btn btn-md btn-primary" value="in" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="panel panel-default" style="margin-bottom: 5px;">
        <div class="panel-heading">
            <span>tổng lượng thuốc&nbsp;&nbsp;&nbsp;trang hiện tại&nbsp;&nbsp;</span>
            <span id='yeCon'>tổng tiền giá bán buôn: " + "đồng; tổng tiền giá lẻ: " + "đồng</span>
            <i class='fa fa-angle-down fa-2x i-showMore' onclick="mainShowMore()" aria-hidden='true'></i>
        </div>
        <div class="gridPanel" id="div-main">
            <table id="gridYPZL"></table>
            <div id="gridPager" rel="form1"></div>
        </div>
    </div>
    <div class="panel panel-default" style="margin-bottom: 5px;">
        <div class="panel-heading">
            <span>chi tiết thuốc</span>
            <i class='fa fa-angle-up fa-2x i-showMore' onclick="detailShowMore()" aria-hidden='true'></i>
        </div>
        <div class="gridPanel" id="div-detail">
            <table id="gridYPMXInfo"></table>
        </div>
    </div>
</form>
<script>
    var $gridYpzlData = $("#gridYPZL");
    var $gridkcmxData = $("#gridYPMXInfo");
    $(function () {
        $(window).resize(function () {//tải lại khi thay đổi kích thước cửa sổ trình duyệt jqGrid chiều rộng
            window.initLayout("MyTabGrid");
        });
        gridYPZLData();

        //in đơn nút sự kiện
        $("#btn_print").click(function () {
            var is0kc = $("#chk_NoShow0KC").is(":checked") ? "0" : "-1";
            var kczt = $("#ddlKCZT").val() == '' ? "-1" : $("#ddlKCZT").val();
            var bmzt = $("#ddlBBMZT").val() == '' ? "-1" : $("#ddlBBMZT").val();
            window.open("/Report/PrintReport?type=StockQuery&param=bmcode=" + $("#yfbmcode").val() + "|OrganizeId=" + $("#OrganizeId").val() + "|key=" + $("#txtINPUTCODE").val() + "|kczt=" + kczt + "|bmzt=" + bmzt + "|Show0Kc=" + is0kc, "height=500, width=1195, top=100, left=50, toolbar=no, menubar=no, scrollbar=yes, resizeble=no, location=no, status=no");
        });
    });

    $(document).keyup(function (event) {
        if (event.keyCode == 13) {
            $("#btn_search").trigger("click");
        }
    });

    //Kéo giãn bản ghi chính
    function mainShowMore() {
        var nodeM = $("#div-main");
        var nodeD = $("#div-detail");
        if (nodeM.is(':hidden')) {
            $("#gridYPZL").setGridHeight(150);
            $("#gridYPMXInfo").setGridHeight($(window).height() - 400);
            $("#div-main").show(500);
            $("#div-detail").show(500);
        } else if (nodeM.is(':visible') && nodeD.is(':visible')) {
            $("#gridYPZL").setGridHeight($(window).height() - 220);
            $("#div-main").show(500);
            $("#div-detail").hide(500);
        }
    }

    //Kéo giãn bản ghi chi tiết
    function detailShowMore() {
        var nodeM = $("#div-main");
        var nodeD = $("#div-detail");
        if (nodeD.is(':hidden')) {
            $("#gridYPZL").setGridHeight(150);
            $("#gridYPMXInfo").setGridHeight($(window).height() - 400);
            $("#div-main").show(500);
            $("#div-detail").show(500);
        } else if (nodeM.is(':visible') && nodeD.is(':visible')) {
            $("#gridYPMXInfo").setGridHeight($(window).height() - 190);
            $("#div-main").hide(500);
            $("#div-detail").show(500);
        }
    }

    //bản ghi chính của chứng từ
    function gridYPZLData() {
        $gridYpzlData.dataGrid({
            postData: getSearchPostData(),
            height: 150,
            url: "/PharmacyDrugStorage/SelectStockTotal",
            colModel: [
                { label: 'ypbmCode', name: 'yfbmCode', hidden: true, align: 'left' },
                { label: 'tên khoa', name: 'deptName', width: 65, align: 'left' },
                { label: 'tên thuốc', name: 'ypmc', width: 150, align: 'left' },
                { label: 'mã thuốc', name: 'ypCode', width: 65, align: 'left' },
                { label: 'phiên âm', name: 'py', width: 100, align: 'left' },
                { label: 'số lượng tồn kho', name: 'Kcslstr', width: 70, align: 'right' },
                {
                    label: 'giá bán buôn', name: 'pfj', width: 60, align: 'right',
                    formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0.00";
                    }
                },
                {
                    label: 'giá bán lẻ', name: 'lsj', width: 60, align: 'right',
                    formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0.00";
                    }
                },
                {
                    label: 'tổng tiền giá bán buôn', name: 'pjze', width: 70, align: 'right',
                    formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(2) : "0.00";
                    }
                },
                {
                    label: 'tổng tiền giá lẻ', name: 'ljze', width: 70, align: 'right',
                    formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(2) : "0.00";
                    }
                },
                { label: 'quy cách', name: 'gg', width: 80, align: 'left' },
                { label: 'nhà sản xuất tên', name: 'ycmc', width: 150, align: 'left' },
                { label: 'số sổ sách', name: 'zcxh', hidden: true }

            ],
            multiselect: false,
            pager: "#gridPager",
            sortname: 'ypCode desc',
            viewrecords: true,
            onSelectRow_page: function (rowid) {
                btn_selectrow();
            },
            loadComplete: function (data) {
                //tính tổng tiền giá bán buôn và tổng tiền giá lẻ trong thanh tiêu đề
                ComputePjzeAndLjze();
            }

        });

        $("#btn_search").click(function () {
            $("#yeCon").text("tổng tiền giá bán buôn: __ đồng;tổng tiền giá lẻ: __ đồng");
            //mỗi lần tra cứu trước tiên xóa sạch Grid
            $('#gridYPZL').jqGrid("clearGridData");
            $('#gridYPMXInfo').jqGrid("clearGridData");

            $gridYpzlData.jqGrid('setGridParam', {
                postData: getSearchPostData(), url: '/PharmacyDrugStorage/SelectStockTotal'
            }).trigger('reloadGrid');            
            ComputePjzeAndLjze();//tính tổng tiền giá bán buôn và tổng tiền giá lẻ trong thanh tiêu đề
        });
    }
    //điều kiện tra cứu
    function getSearchPostData() {
        var inputCode = $("#txtINPUTCODE").val();
        var kczt = $("#ddlKCZT").val();
        var bbmzt = $("#ddlBBMZT").val();
        var noShow0Kc = $("#chk_NoShow0KC").is(":checked");
        return { inputCode: inputCode, tybz: kczt, zt: bbmzt, noShow0KC: noShow0Kc };
    };

    //tính tổng tiền giá bán buôn và tổng tiền giá lẻ trong thanh tiêu đề
    function ComputePjzeAndLjze() {
        var titlePjze = 0;
        var titleLjze = 0;
        var count = $("#gridYPZL").getGridParam('records');
        if (count > 0) {
            var rowIds = $("#gridYPZL").getDataIDs();
            for (var i = 0; i < rowIds.length; i++) {
                var getRowPjze = $("#gridYPZL").getRowData(rowIds[i]).pjze;
                var getRowLjze = $("#gridYPZL").getRowData(rowIds[i]).ljze;
                titlePjze += parseFloat(getRowPjze);
                titleLjze += parseFloat(getRowLjze);
            }
            $("#yeCon").text("tổng tiền giá bán buôn: " + titlePjze.toFixed(2) + "đồng;tổng tiền giá lẻ: " + titleLjze.toFixed(2) + "đồng");
        }
    }

    //sự kiện nhấp chuột
    function btn_selectrow() {
        //mỗi lần nhấp, trước tiên xóa chi tiết sau đó tải lại chi tiết của tất cả các dòng đã chọn
        $gridkcmxData.jqGrid("clearGridData");
        $gridkcmxData.jqGrid('setGridParam', {
            postData: { ypCode: $("#gridYPZL").jqGridRowValue().ypCode, yfbmCode: $("#gridYPZL").jqGridRowValue().yfbmCode },
            url: '/PharmacyDrugStorage/SelectStockDetail'
        }).trigger('reloadGrid');            
    }

    //chi tiết thuốc
    $gridkcmxData.dataGrid({
        height: $(window).height() - 400,
        unwritten: false,
        colModel: [
            { label: 'tên khoa', name: 'deptName', width: 65, align: 'left' },
            { label: 'số lượng tồn kho', name: 'kcslstr', width: 70, align: 'right' },
            { label: 'số lượng đóng băng', name: 'djslstr', width: 80, align: 'right' },
            {
                label: 'giá nhập', name: 'jj', width: 60, align: 'right',
                formatter: function (cellvalue) {
                    return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0.00";
                }
            },
            {
                label: 'giá bán buôn', name: 'pfj', width: 60, align: 'right',
                formatter: function (cellvalue) {
                    return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0.00";
                }
            },
            {
                label: 'giá bán lẻ', name: 'lsj', width: 60, align: 'right',
                formatter: function (cellvalue) {
                    return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0.00";
                }
            },
            {
                label: 'tổng tiền giá lẻ', name: 'ljze', width: 70, align: 'right',
                formatter: function (cellvalue) {
                    return cellvalue ? parseFloat(cellvalue).toFixed(2) : "0.00";
                }
            },
            {
                label: 'tổng tiền giá bán buôn', name: 'pjze', width: 70, align: 'right',
                formatter: function (cellvalue) {
                    return cellvalue ? parseFloat(cellvalue).toFixed(2) : "0.00";
                }
            },
            { label: 'số lô', name: 'ph', width: 110, align: 'center' },
            { label: 'lô', name: 'pc', width: 110, align: 'center' },
            { label: 'hạn sử dụng', name: 'yxq', width: 70, align: 'center' },
            { label: 'hệ số chuyển đổi', name: 'zhyz', width: 50, align: 'center' },
            { label: 'kiểm soát cờ', name: 'kzbz', width: 60, align: 'center' },
            { label: 'số lượng đóng băng', name: 'djsl', hidden: true },
            { label: 'vị trí kho', name: 'ypkw', hidden: true }
        ],
        sortname: 'yxq asc',
    });
</script>



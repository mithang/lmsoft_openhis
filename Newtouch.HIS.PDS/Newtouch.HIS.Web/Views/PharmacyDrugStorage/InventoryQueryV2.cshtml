
@{
    ViewBag.Title = "kiểm kê tra cứu";
    Layout = "~/Views/Shared/_Index.cshtml";
    var reportUrl = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("ReportUrl");
}

<style>
    #btn_search {
        float: left;
        margin-left: 25px;
        margin-right: 10px;
        width: 45px;
        font-weight: bolder;
    }

    #btn_print {
        width: 45px;
        background-color: #fff;
        color: #00a9ea;
        font-weight: bolder;
        float: left;
    }

    #btn_backIndex {
        float: left;
    }
    .scan-input {
        border: 2px solid #007bff;
        padding: 5px;
    }
</style>
<form id="form1">
    <div class="panel panel-default" style="margin-bottom:5px;">
        <div class="panel-heading">điều kiện tra cứu</div>
        <table class="form">
            <tr>
                <th class="formTitle" style="width: 50px;">ngày: </th>
                <td class="formValue" colspan="2">
                    <select id="ddlRQ" class="form-control"></select>
                </td>
                <th class="formTitle" style="width: 65px;">từ khóa: </th>
                <td class="formValue" style="width: 115px;">
                    <input id="txtSRM" type="text" class="form-control" placeholder="phiên âm tên thuốc" />
                </td>
                <th class="formTitle">trạng thái thuốc: </th>
                <td class="formValue" style="width: 55px;">
                    <select id="ddlYPZT" name="ddlYPZT" class="form-control">
                        <option value="-1">tất cả</option>
                        <option value="1">kích hoạt</option>
                        <option value="0">ngừng sử dụng</option>
                    </select>
                </td>
                <th class="formTitle" style="display:none">loại thuốc: </th>
                <td class="formValue" style="display:none">
                    <select id="ddlYPLB" class="form-control">
                        <option value="">tất cả</option>
                    </select>
                </td>
                <th class="formTitle">hiển thị tồn kho: </th>
                <td class="formValue">
                    <select id="ddlKCXS" name="ddlKCXS" class="form-control">
                        <option value="-1">tất cả</option>
                        <option value="0">hiển thị tồn kho bằng 0</option>
                        <option value="1">không hiển thị số lượng lý thuyết bằng 0</option>
                        <option value="2">không hiển thị số lượng thực tế bằng 0</option>
                        <option value="4">không hiển thị khi cả hai đều bằng 0</option>
                    </select>
                </td>
                <td class="formValue" style="width: 160px;">
                    <input type="button" id="btn_search" class="btn btn-primary" value="tra cứu" />
                    <input type="button" id="btn_backIndex" class="btn btn-primary" value="quay về trang chủ" style="float:right;" />
                </td>
            </tr>
        </table>
    </div>
    <div>
        <table id="gridKCInfoHistory"></table>
        <div id="gridPagerHistory" rel="form1"></div>
    </div>
    <input hidden id="yfbmcode" value="@ViewBag.bmCode">
    <input hidden id="OrganizeId" value="@ViewBag.OrganizeId">
    @Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
    {
        ShowKeyList = new[] { 10, 6, 9, 8 },
        F10Text = "nhóm lớn chi tiết",
        F6Text = "dạng bào chế chi tiết",
        F9Text = "chi tiết kiểm kê",
        F8Text = "lưu mã truy xuất"
    })
</form>
<script language="javascript">
    var $gridKCInfoHistory = $("#gridKCInfoHistory");
    $(function () {
        $("#btn_backIndex").click(function () {//quay lại
            $.loading("trang chuyển trang trong");
            window.location.href = "StockInventoryV3";
        });
        InitialPd();
        $gridKCInfoHistory.on('keydown', '.scan-input', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();

                var inputField = $(this);
                const row = inputField.closest('tr');

                // có tách lẻ không
                const sfcl = parseInt(row.find('.sfcl').val(), 10);
                var maxEntries = 1;
                if (sfcl === 1) {
                    maxEntries = 1
                } else {
                    maxEntries = parseInt(row.find('.quantity').text(), 10);
                }

                if (inputField.val() && !inputField.val().endsWith(',')) {
                    inputField.val(removeDuplicates(inputField.val()));
                }

                const entries = removeDuplicates(inputField.val()).split(',').filter(entry => entry.trim() !== '').length;

                if (entries >= maxEntries) {
                    $.modalMsg("đã đạt số lượng mục quét mã tối đa của dòng này!", "warning", 1000);
                    inputField.val(removeDuplicates(inputField.val()).split(',').filter(entry => entry.trim() != "").slice(0, maxEntries).join(',') + ",");
                }
            }
        });
    });

    function removeDuplicates(str){
        const arr = str.split(',')
        const uniqueArr = [...new Set(arr)]
        return uniqueArr.join(',')+','
    }

    //gắn sự kiện phím Enter
    $(document).keyup(function (event) {
//         if (event.keyCode === 13) {
//             $("#btn_search").trigger("click");
//         }
    });



    //khởi tạo kiểm kê
    function InitialPd() {
        gridKCInfoHistory();
        GetPDSJ();//lấy ngày kiểm kê
    }

    //thông tin tồn kho tra cứu
    function gridKCInfoHistory() {
        $gridKCInfoHistory.dataGrid({
            caption: "lịch sử kiểm kê thông tin",
            postData: getSearchPostData(),
            height: $(window).height() - 250,
            url: "",
            editurl: "clientArray",  //chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            colModel: [
                { label: 'mã thuốc', name: 'ypCode', width: 80, align: 'left' },
                { label: 'tên thuốc', name: 'ypmc', width: 120, align: 'left' },
                { label: 'quy cách', name: 'ypgg', width: 70, align: 'left' },
                { label: 'số lượng lý thuyết', name: 'llsl', width: 70, align: 'left' },
                { label: 'số thực tế', name: 'sjslstr', width: 70, align: 'left' },
                { label: 'số lượng lãi/lỗ', name: 'pdscy', width: 70, align: 'left' },
                {
                    label: '<span class="required">*</span>mã truy xuất', name: 'zsm', width: 80, align: 'center',
                    formatter: function (cellvalue, options) {
                        if (!cellvalue) {
                            cellvalue = ""
                        }
                        return "<input name=\"zsm\" type=\"text\" value=\"" + cellvalue + "" + "\" id=\"sel_zsm_" + options.rowId + "\" rowid=" + options.rowId + " class=\"scan-input editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" />";
                    }
                },
                {
                    label: '<span class="required">*</span>có tách lẻ không', name: 'sfcl', width: 80, align: 'center',
                    formatter: function (cellvalue, options) {
                        if (!cellvalue) {
                            cellvalue = 1
                        }
                        let html = `<select name="sfcl" id="sel_sfcl_${options.rowId}" rowid="${options.rowId} " class="sfcl editable inline-edit-cell form-control" style="padding:0; border-radius: 0px; border: 0px;" ><option value="1" ${cellvalue === 1 ? "selected" : ""}>是</option><option value="2" ${cellvalue !== 1 ? "selected" : ""}>否</option></select>`
                        return html
                    }
                },
                { label: 'kiểm kê thực tế số tiền', name: 'spje', width: 70, align: 'left' },
                { label: 'trước kiểm kê số tiền', name: 'pqje', width: 70, align: 'left' },
                { label: 'lãi/lỗ số tiền', name: 'ykje', width: 70, align: 'left' },
                { label: '盘点零售价差异', name: 'pdlsjcy', width: 70, align: 'left' },
                { label: '盘点进价差异', name: 'pdpfjcy', width: 70, align: 'left' },
                { label: 'số lô', name: 'ph', width: 100, align: 'center' },
                { label: 'lô', name: 'pc', width: 100, align: 'left' },
                { label: 'hạn sử dụng', name: 'yxq', width: 80, align: 'left' },
                { label: 'giá nhập', name: 'jj', width: 60, align: 'left' },
                { label: 'giá bán lẻ', name: 'lsj', width: 60, align: 'left' },
                { label: 'giá nhập số tiền(lý thuyết)', name: 'llpfje', width: 70, align: 'left' },
                { label: 'tiền bán lẻ(lý thuyết)', name: 'lllsje', width: 70, align: 'left' },
                { label: 'giá nhập số tiền(thực)', name: 'sjpfje', width: 70, align: 'left' },
                { label: 'tiền bán lẻ(thực)', name: 'sjlsje', width: 70, align: 'left' },
                { label: 'đơn vị', name: 'deptdw', width: 50, align: 'left' },
                { label: 'nơi sản xuất', name: 'ycmc', width: 120, align: 'left' },
                { label: 'phiên âm', name: 'py', width: 100, align: 'left' },
                { label: 'số lượng', name: 'deptSjsl', hidden: true, classes: 'quantity' },
                { label: 'số lượng lý thuyết', name: 'llsl_zxbz', hidden: true },
                { label: 'pdmxId', name: 'pdmxId', hidden: true },
                { label: 'zhyz', name: 'zhyz', hidden: true },
                { label: 'số lượng thực tế(đóng gói theo bộ phận)', name: 'sjslstr', hidden: true },
                { label: 'số lượng thực tế(đơn vị nhỏ nhất)', name: 'minSjsl', hidden: true },
                { label: 'đơn vị nhỏ nhất', name: 'zxdw', hidden: true },
                { label: 'CreateTime', name: 'CreateTime', hidden: true }
            ],
            gridComplete: function () {
                window.initLayout("MyTabGrid");
            },
            multiselect: false,
            onPaging: function () {
                savePdsPage();
            },
            pager: "#gridPagerHistory",
            sortname: 'CreateTime desc',
            viewrecords: true,
            footerrow: true, //thống kê dữ liệu
            gridComplete:completeMethod
        });
        $("#btn_search").click(function () {//gắn tra cứu
            $gridKCInfoHistory.jqGrid('setGridParam',
                {
                    postData: getSearchPostData(),
                    url: "/PharmacyDrugStorage/SelectInventoryInfoList"
                }).trigger('reloadGrid');
        });
        function completeMethod() {
            var sum_pdscy = $(this).getCol('pdscy', false, 'sum');//số lượng lãi/lỗ
            var sum_spje = $(this).getCol('spje', false, 'sum');//kiểm kê thực tế số tiền
            var sum_pqje = $(this).getCol('pqje', false, 'sum');//trước kiểm kê số tiền
            var sum_ykje = $(this).getCol('ykje', false, 'sum');//lãi/lỗ số tiền
            $(this).footerData('set', { "sjslstr": 'tổng cộng', pdscy: sum_pdscy, spje: sum_spje, pqje: sum_pqje, ykje: sum_ykje}, false);
        }
    }

    //điều kiện tra cứu
    function getSearchPostData() {
        var pdsj = $("#ddlRQ").val();
        var pdId = $("#ddlRQ option:selected").attr('data-pdId');
        var srm = $("#txtSRM").val();
        var ypzt = $("#ddlYPZT").val();
        var kcxs = $("#ddlKCXS").val();
        if (!pdsj && !pdId) {
            return false;
        }
        if (kcxs === "" || kcxs == null) {
            kcxs = -1;
        }
        return { pdsj: pdsj, pdId: pdId, srm: srm, ypzt: ypzt, yplb: "", kcxs: kcxs };
    };

    //lấy thời gian kiểm kê
    function GetPDSJ() {
        $.najax({
            type: "GET",
            url: "/PharmacyDrugStorage/GetPDDateDropdownList",
            dataType: "json",
            success: function (ajaxresp) {
                //trước tiên xóa sạch, sau đó điền
                $("#ddlRQ").empty();
                for (var i = 0; i < ajaxresp.data.length; i++) {
                    $("#ddlRQ").append('<option data-pdId=' + ajaxresp.data[i].pdId + '>' + ajaxresp.data[i].pdsj + '</option>');
                }
                $("#btn_search").trigger("click");
            }
        });
    }

    //nhóm lớn chi tiết in
    function newtouch_event_f10() {
        var srm = $("#txtSRM").val();
        var ypzt = $("#ddlYPZT").val();
        var kcxs = $("#ddlKCXS").val();
        var pdId = $("#ddlRQ option:selected").attr('data-pdId');
        var yfbm = $("#yfbmcode").val();
        var OrganizeId = $("#OrganizeId").val();
        var uri = '@reportUrl' + "?tempCode=55&systemCode=PDS" + "&hospitalCode=" + OrganizeId + "&srm=" + srm + "&ypzt=" + ypzt + "&kcxs=" + kcxs + "&pdId=" + pdId + "&yfbm=" + yfbm;
        window.open(uri);
        //window.open("/Report/PrintReport?type=StockInventoryDl&param=srm=" + srm + "|ypzt=" + ypzt + "|kcxs=" + kcxs + "|pdId=" + pdId + "|yfbm=" + yfbm + "|OrganizeId=" + OrganizeId, "height=500, width=1195, top=100, left=50, toolbar=no, menubar=no, scrollbar=yes, resizeble=no, location=no, status=no");
    }

    //dạng bào chế chi tiết in
    function newtouch_event_f6() {
        var srm = $("#txtSRM").val();
        var ypzt = $("#ddlYPZT").val();
        var kcxs = $("#ddlKCXS").val();
        var pdId = $("#ddlRQ option:selected").attr('data-pdId');
        var yfbm = $("#yfbmcode").val();
        var OrganizeId = $("#OrganizeId").val();
        var uri = '@reportUrl' + "?tempCode=56&systemCode=PDS" + "&hospitalCode=" + OrganizeId + "&srm=" + srm + "&ypzt=" + ypzt + "&kcxs=" + kcxs + "&pdId=" + pdId + "&yfbm=" + yfbm;
        window.open(uri);
        //window.open("/Report/PrintReport?type=StockInventoryJx&param=srm=" + srm + "|ypzt=" + ypzt + "|kcxs=" + kcxs + "|pdId=" + pdId + "|yfbm=" + yfbm + "|OrganizeId=" + OrganizeId, "height=500, width=1195, top=100, left=50, toolbar=no, menubar=no, scrollbar=yes, resizeble=no, location=no, status=no");
    }

    //in chi tiết kiểm kê
    function newtouch_event_f9() {
        var srm = $("#txtSRM").val();
        var ypzt = $("#ddlYPZT").val();
        var kcxs = $("#ddlKCXS").val();
        var pdId = $("#ddlRQ option:selected").attr('data-pdId');
        var yfbm = $("#yfbmcode").val();
        var OrganizeId = $("#OrganizeId").val();
        var uri = '@reportUrl' + "?tempCode=57&systemCode=PDS" + "&hospitalCode=" + OrganizeId + "&srm=" + srm + "&ypzt=" + ypzt + "&kcxs=" + kcxs + "&pdId=" + pdId + "&yfbm=" + yfbm;
        window.open(uri);
        //window.open("/Report/PrintReport?type=StockInventoryV2&param=srm=" + srm + "|ypzt=" + ypzt + "|kcxs=" + kcxs + "|pdId=" + pdId + "|yfbm=" + yfbm + "|OrganizeId=" + OrganizeId, "height=500, width=1195, top=100, left=50, toolbar=no, menubar=no, scrollbar=yes, resizeble=no, location=no, status=no");
    }

    function newtouch_event_f8() {
        console.log("F8")
        savePdsPage()
    }

    // 保存追朔码
    function savePdsPage() {
   
        var rowIds = $gridKCInfoHistory.jqGrid('getDataIDs');//lấy tất cả các dòng Id, duyệt để hộp chỉnh sửa ở trạng thái đã lưu

        var kcInfoJsonSave = $gridKCInfoHistory.jqGrid('getRowData_AllLine');
        var objArrSave = new Array();
        $.each(kcInfoJsonSave, function () {//khi lưu thì Grid đặt dòng dữ liệu vào mảng mới
            //mã truy xuất
            var zsm = $("#sel_zsm_" + this.jqRowId).val();
            //có tách lẻ không
            var sfcl = parseInt($("#sel_sfcl_" + this.jqRowId).val(), 10);
            this.zsm = zsm
            this.sfcl = sfcl
            if (zsm != "") {
                objArrSave.push(this);
            }
        });
        var resultObjArr = new Array();
        //so sánh với mảng tải khi tải trang, đặt dòng dữ liệu đã sửa vào resultObjArr trong, gửi cho backend
        for (var i = 0; i < objArrSave.length; i++) {
                // kiểm tra số lượng mã truy xuất. nếu tách lẻ thì chọn có, chỉ cần quét một cái, nếu không thì cần quét mã tương ứng với số lượng nhập kho
                const zsmLength = objArrSave[i].zsm.split(',').filter(entry => entry.trim() !== '').length
            var maxZsmLength = 1
                if (objArrSave[i].sfcl === 1) {
                    maxZsmLength = 1
                } else {
                    maxZsmLength = objArrSave[i].deptSjsl
                }

                if (zsmLength != 0 && zsmLength != maxZsmLength) {
                    $.modalMsg("mục" + objArrSave[i].ypmc + "số lượng không khớp với số lượng mã truy xuất!", "warning", 1500);
                    return false;
                }

                resultObjArr.push({ pdmxId: objArrSave[i].pdmxId, zsm: objArrSave[i].zsm, sfcl: objArrSave[i].sfcl });
        }
        console.log(resultObjArr)
        if (resultObjArr.length === 0) {
        }
        else {
            $.najax({
               type: "POST",
               url: "/PharmacyDrugStorage/SaveInventoryZsmInfo",
               dataType: "json",
               data: { resultObjArr: JSON.stringify(resultObjArr), pdId: $("#ddlRQ option:selected").attr('data-pdId') },
               success: function (ajaxresp) {
                   //$("#btn_search").trigger("click");
                   $.modalAlert("lưu thành công", 'success');
               },
               error: function (ajaxresp) {
                   $.modalAlert(ajaxresp.message, Error);
               }
            });
        }
    };

</script>
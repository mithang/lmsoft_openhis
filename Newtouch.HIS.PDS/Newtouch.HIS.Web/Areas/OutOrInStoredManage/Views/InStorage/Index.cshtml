    //nhập mua hàng đơn quay lại sự kiện
    function GetQueryAjax(obj, funcSuccCallback) {
        var cgId = obj.cgId;
        //khởi tạo danh sách dữ liệu
        $.najax({
            type: "Get",
            url: "/OutOrInStoredManage/Purchase/QueryPurchaseStorebyId",
            data: { cgId: cgId },
            dataType: "json",
            success: function (ajaxresp) {
                if(ajaxresp.length>0)
                {
                    $("#fyfs option[value='2']").prop("selected", true);//mua thuốc nhập kho
                    $("#fyfs").trigger('change');
                    $("#gysCode").val(ajaxresp[0].yqbm);
                    $("#gysmc").val(ajaxresp[0].yqmc);
                    var ids = $("#gridList").getDataIDs();
                    var index=0;//không trống dòng số
                    $.each(ids,function(rowid,column){
                        if($("#" +column + "_ypmc").val()){
                            index++;
                        } 
                    });
                    var num=ids.length-index;//trống dòng số=tổng dòng số-không trống dòng số
                    if(num<ajaxresp.length) //bổ sung dòng trống
                    {
                        for(var i=0;i<ajaxresp.length-num;i++){
                            $("#gridList").jqGrid("addRowData", undefined, { operate: GetOperatehtml() }, "last");
                        }
                        filldata(ajaxresp,index,obj.ddbh);
                    }
                    else{//điền trực tiếp
                        $.each(ids,function(index,column){
                            if(!$("#" +column + "_ypmc").val()){
                                filldata(ajaxresp,index,obj.ddbh);
                                return false;
                            } 
                        });
                        
                    }
                }
            }
        });
    }


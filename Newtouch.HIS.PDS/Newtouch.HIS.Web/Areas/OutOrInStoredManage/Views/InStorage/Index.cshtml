    //kiểm tra giá trị số
    function Validately(rowData, rowid) {
        if ($("#gysCode").val() === "" || $("#gysmc").val() === "") {   //loại bỏ khoảng trắng hai đầu
            $.modalMsg("vui lòng chọn nhà cung cấp", "error", 1000);
            return false;
        }
        if (rowData.ypmc === "") {
            $.modalMsg('bắt buộc chọn thuốc', 'error', 1000);
            return false;
        }
        var reg = /^[1-9]\d*$/;//lớn hơn 0 số nguyên
        if (!reg.test(rowData.sl)) {
            $.modalMsg("số lượng phải lớn hơn 0 số nguyên!", "warning", 1500);
            return false;
        }
        var reg2 = /^\d+(?:\.\d{0,2})?$/;
        if (!reg2.test(rowData.jjze)) {
            $.modalMsg("tổng tiền giá nhập vui lòng nhập đúng định dạng số tiền!", "warning", 1500);
            return false;
        }
        if (rowData.ph === "") {
            $.modalMsg("số lô không thể trống!", "warning", 1000);
            return false;
        }
        var sfclValue = Number($("#sel_sfcl_" + rowid).val());
        // kiểm tra số lượng mã truy xuất. nếu tách lẻ thì chọn có, chỉ cần quét một cái, nếu không thì cần quét mã tương ứng với số lượng nhập kho
        const zsmLength = $("#sel_zsm_" + rowid).val().split(',').filter(entry => entry.trim() !== '').length
        var maxZsmLength = 1
        if (sfclValue === 1) {
            maxZsmLength = 1
        } else {
            maxZsmLength = rowData.sl
        }

        if (zsmLength != 0 && zsmLength != maxZsmLength) {
            $.modalMsg("mục" + rowData.ypmc + "số lượng không khớp với số lượng mã truy xuất!", "warning", 1500);
            return false;
        }

        return true;
    }



@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "nhập kho từ bên ngoài";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    .inline {
        width: 80%;
        display: inline;
    }

    .PriceInline {
        width: 70%;
        display: inline;
    }

    #dv-detail table th {
        border: solid 1px #ddd;
        vertical-align: middle;
    }

    #dv-detail .ui-jqgrid-labels, #dv-detail .jqgrow .ui-row-ltr {
        height: 30px;
        vertical-align: middle;
    }

    #dv-detail table td {
        border: solid 1px #ddd;
        vertical-align: middle;
    }

    #dv-detail input[role=textbox] {
        padding: 2px 2px;
    }

    .input-wdatepicker-native {
        height: auto;
        width: 90px;
        border: 0;
        box-shadow: none;
        border-radius: 0;
        padding: 6px 6px;
        text-align: left;
    }

    #gridList .ckbox label {
        margin-top: 24px;
    }
    .scan-input {
        border: 2px solid #007bff;
        padding: 5px;
    }
</style>
<form id="form1">
    <div class="panel panel-default" style="margin-bottom:10px;">
        <div class="panel-heading">nhập kho thông tin</div>
        <table class="form">
            <tr>
                <th class="formTitle">nhập kho đơn: </th>
                <td class="formValue">
                    <input type="text" id="djh" name="djh" class="form-control newtouch_Readonly" />
                </td>
                <th class="formTitle"><span class="required">*</span>nhà cung cấp: </th>
                <td class="formValue">
                    <input type="text" id="gysmc" name="gysmc" class="form-control" placeholder="vui lòng chọn nhà cung cấp" autocomplete="off" />
                    <input type="hidden" id="gysCode" />
                </td>
                <th class="formTitle"><span class="required">*</span>phương thức nhập kho: </th>
                <td class="formValue">
                    <select class="form-control" id="fyfs" name="fyfs"></select>
                </td>
                <th class="formTitle">nhập kho tổng mức(đồng): </th>
                <td class="formValue">
                    <input id="txtRKZE" type="text" class="form-control newtouch_Readonly" />
                </td>
                <th class="formTitle">
                    <input type="button" id="btn_add" class="btn btn-md btn-primary" value="thêm" />
                    <input type="button" id="btn_import" class="btn btn-md btn-primary" value="mua hàng đơn nhập" />
                </th>
            </tr>
        </table>
    </div>
    <div id="dv-detail">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>
@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
    ShowKeyList = new[] { 7, 8 },
    F7Text = "đặt lại",
    F8Text = "gửi"
})
<script type="text/javascript">

    var $gridList = $("#gridList");
    $(function () {
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });
        init();
        InitGys();
        $("#fyfs").bindSelect({ url: "/DrugStorage/GetCrkfs?crkbz=0", id: "crkfsCode", text: "crkfsmc" });
        $("#btn_add").click(function () {
            $("#gridList").jqGrid("addRowData", undefined, { operate: GetOperatehtml() }, "last");
        });
        InitBackspaceKeyForGys();

        $gridList.on('keydown', '.scan-input', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();

                const inputField = $(this);
                const row = inputField.closest('tr');

                // có tách lẻ không
                const sfcl = parseInt(row.find('.sfcl').val(), 10);
                var maxEntries = 1;
                if (sfcl === 1) {
                    maxEntries = 1
                } else {
                    maxEntries = parseInt(row.find('.quantity input').val(), 10);
                }

                
                const entries = inputField.val().split(',').filter(entry => entry.trim() !== '').length;

                if (inputField.val() && !inputField.val().endsWith(',')) {
                    inputField.val(removeDuplicates(inputField.val()));
                }

                if (entries >= maxEntries) {
                    $.modalMsg("đã đạt số lượng mục quét mã tối đa của dòng này!", "warning", 1000);
                    inputField.val(inputField.val().split(',').filter(entry => entry.trim() != "").slice(0, maxEntries).join(',') + ",");
                }
            }
        });
    });

    function removeDuplicates(str){
        const arr = str.split(',')
        //const uniqueArr = [...new Set(arr)]
        //return uniqueArr.join(',')+','
        return arr.join(',')+','
    }

     //theo backspace phím xóa tất cả
    function InitBackspaceKeyForGys(id) {
        $("#gysmc").keydown(function (e) {
            e = window.event ? window.event : e;
            var keyCode = e.which ? e.which : e.keyCode;
            if (keyCode === 8) {//tab
                $("#gysmc").val("");
                $("#gysCode").val("");
            }
        });
    }

    //theo backspace phím xóa tất cả
    function InitBackspaceKey(id) {
        $("#" + id).keydown(function (e) {
            var e = window.event ? window.event : e;
            var keyCode = e.which ? e.which : e.keyCode;
            if (keyCode === 8) {//tab
                $("#" + id).val("");
            }
        });
    }

    //khởi tạo
    function init() {
        GetDjh();
        InitJqGrid();
        $("#gridList").jqGrid("addRowData", undefined, { operate: GetOperatehtml() }, "last");
    }

    //khởi tạo chi tiết xuất kho
    function InitJqGrid() {
        $gridList.newtouchLocalDataGrid({
            data: [],
            height: $(window).height() - document.getElementById('gridList').offsetTop - 85,
            rownumbers: true,  //có hiển thị số thứ tự không
            multiselect: true,
            editurl: "clientArray",  //chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            unwritten: false,
            colModel: [
                { label: 'thao tác', name: 'operate', width: 50, align: 'center' },
                { label: '<span class="required">*</span>tên thuốc', name: 'ypmc', width: 105, align: 'center', editable: true, editwidth: "100%" },
                { label: "quốc gia BHYT mã", name: "gjybdm", width: 75, align: 'center', editable: true, editwidth: "100%" },
                { label: "loại thuốc", name: "dlmc", width: 75, align: 'center', editable: true, editwidth: "100%" },
                { label: '<span class="required">*</span>số lượng', name: 'sl', width: 45, align: 'center', editable: true, editwidth: "100%", classes:'quantity' },
                {
                    label: 'đơn vị', name: 'dw', width: 50, align: 'center',
                    formatter: function (cellvalue, options) {
                        return "<select name=\"dw\" id=\"sel_dw_" + options.rowId + "\" rowid=" + options.rowId + " class=\"editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" ></select>";
                    }
                },
                {
                    label: '<span class="required">*</span>mã truy xuất', name: 'zsm', width: 80, align: 'center',
                    formatter: function (cellvalue, options) {
                        return "<input name=\"zsm\" id=\"sel_zsm_" + options.rowId + "\" rowid=" + options.rowId + " class=\"scan-input editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" />";
                    }
                },
                {
                    label: '<span class="required">*</span>có tách lẻ không', name: 'sfcl', width: 80, align: 'center',
                    formatter: function (cellvalue, options) {
                        return "<select name=\"sfcl\" id=\"sel_sfcl_" + options.rowId + "\" rowid=" + options.rowId + " class=\"sfcl editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" ><option value=\"2\">không</option><option value=\"1\">có</option></select>";
                    }
                },
                { label: '<span class="required">*</span>tổng tiền giá nhập', name: 'jjze', width: 80, align: 'center', editable: true, editwidth: "100%" },
                { label: '<span class="required">*</span>số lô', name: 'ph', width: 80, align: 'center', editable: true, editwidth: "100%" },
                { label: 'hóa đơn', name: 'fph', width: 80, align: 'center', editable: true, editwidth: "100%" },
                {
                    label: 'ngày sản xuất', name: 'scrq', width: 100, hidden: true, editable: true, align: 'center',
                    formatter: function (cellvalue, options) {
                        return "<input id=\"scrq_" + options.rowId + "\" type=\"text\"  hidden=\"hidden\" class=\"form-control input-wdatepicker input-wdatepicker-native\" value=\"\" onfocus=\"WdatePicker({ dateFmt: 'yyyy-MM-dd' })\" />";
                    }
                },
                {
                    label: 'hạn sử dụng', name: 'yxq', width: 100, align: 'center',
                    formatter: function (cellvalue, options) {
                        return "<input id=\"yxq_" + options.rowId + "\" type=\"text\" class=\"form-control input-wdatepicker input-wdatepicker-native\" value=\"@DateTime.Now.AddYears(1).ToString("yyyy-MM-dd")\" onfocus=\"WdatePicker({ dateFmt: 'yyyy-MM-dd' })\" />";
                    }
                },
                {
                    label: 'ngày lập hóa đơn', name: 'kprq', width: 100, align: 'center',
                    formatter: function (cellvalue, options) {
                        return "<input id=\"kprq_" + options.rowId + "\" type=\"text\" class=\"form-control input-wdatepicker input-wdatepicker-native\" value=\"@DateTime.Now.ToString("yyyy-MM-dd")\" onfocus=\"WdatePicker({ dateFmt: 'yyyy-MM-dd' })\" />";
                    }
                },
                { label: 'giá bán buôn', name: 'pfj', width: 75, align: 'center', editable: true, editwidth: "100%" },
                { label: 'tổng tiền giá bán buôn', name: 'pfjze', width: 80, align: 'center', editable: true, editwidth: "100%" },
                { label: 'đơn giá bán lẻ', name: 'lsjdjdw', width: 75, align: 'center', editable: true, editwidth: "100%" },
                { label: 'tổng tiền bán lẻ', name: 'lsze', width: 80, align: 'center', editable: true, editwidth: "100%" },
                { label: 'tỷ lệ chiết khấu', name: 'kl', width: 60, align: 'center', editable: true, editwidth: "100%" },
                { label: 'tồn kho', name: 'slStr', width: 70, align: 'center', editable: true, editwidth: "100%" },
                { label: 'quy cách', name: 'gg', width: 80, align: 'center', editable: true, editwidth: "100%" },
                { label: 'nhà sản xuất', name: 'sccj', width: 105, align: 'center', editable: true, editwidth: "100%" },
                { label: 'bzs', name: 'bzs', hidden: true, editable: true },
                { label: 'kykc', name: 'kykc', hidden: true, editable: true },
                { label: 'ypdm', name: 'ypdm',hidden: true, editable: true },
                { label: 'lsj', name: 'lsj', hidden: true, editable: true },
                { label: 'jj', name: 'jj', hidden: true, editable: true },//giá nhập  và sl cùng đơn vị
                { label: 'zxdwlsj', name: 'zxdwlsj', hidden: true, editable: true },
                { label: 'ykpfj', name: 'ykpfj',hidden: true, editable: true },
                { label: 'yklsj', name: 'yklsj', hidden: true, editable: true },
                { label: 'zxdwjj', name: 'zxdwjj', hidden: true, editable: true }
            ],
            editinputwidthborder: false,    //có cần viền không mặc định là true
            editinputborderradius: false,   //có cần bo tròn viền không mặc định true (có bo tròn)
            gridComplete: function () {
                var ids = $("#gridList").getDataIDs();
                var lastRowoid = ids[ids.length - 1];
                EnableInlineEditBox(lastRowoid);
            }
            
        });
    }

    //bật chỉnh sửa trong dòng
    function EnableInlineEditBox(rowid) {
        debugger
        if (rowid != null && rowid !== "") {
            $("#gridList").jqGrid('editRow', rowid, false, initInlineFunc);//mở chế độ chỉnh sửa
            $("#jqg_gridList_" + rowid).trigger("click");
        }
        else {
            var ids = $("#gridList").getDataIDs();
            $.each(ids, function () {
                //mở chế độ chỉnh sửa
                $("#gridList").jqGrid('editRow', String(this), false, initInlineFunc);
            });
        }
    }

    //khởi tạo lớp nổi
    function initInlineFunc(rowid) {
        debugger
        //một số cột chỉ đọc
        $("#" + rowid + "_ypmc").attr('autocomplete', 'off');
        $("#" + rowid + "_dlmc").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_gjybdm").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_slStr").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_gg").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_sccj").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_lsj").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_lsjdjdw").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_lsze").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_kl").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_pfjze").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_pfj").css('background-color', '#f6f7fb').attr('readonly', 'true');
        var ids = $("#gridList").getDataIDs();
        var lastRowoid = ids[ids.length - 1];
        var fph=$("#" + ids[ids.length - 2] + "_fph").val();
        if(fph)
            $("#" + rowid + "_fph").val(fph);        
        InitSrm(rowid + "_ypmc", rowid);//lớp nổi thuốc
        InitTabKey("kprq_" + rowid, rowid);//chỗ nhập ngày lập hóa đơn tab chuyển trang
        JJZE_Leave(rowid + "_jjze", rowid);//tổng tiền giá nhập thay đổi
        InitBackspaceKey("yxq_" + rowid);
    }

    //thêm chi tiết
    function addItem(obj) {
        var ids = $("#gridList").getDataIDs();
        var lastRowoid = ids[ids.length - 1];
        var dataRow = {
            operate: GetOperatehtml()
        };
        $("#gridList").jqGrid("addRowData", undefined, dataRow, "after", lastRowoid);
        ComputeRKZE();
    }

    //xóa chi tiết
    function deleteItem(obj) {
        var selRowId = $(obj).parent().parent().attr("id");
        if (!!selRowId) {
            $("#gridList").jqGrid("delRowData", selRowId);
            var ids = $("#gridList").getDataIDs();
            var lastRowoid = ids[ids.length - 1];
            EnableInlineEditBox(lastRowoid);
            ComputeRKZE();
        }
    }

    //lấy nút thao tác html
    function GetOperatehtml() {
        return "<i class='fa fa-plus-square-o' style='font-size: large; color: #09a3ea;vertical-align: middle;' onclick='addItem(this);'></i>&nbsp;&nbsp;&nbsp;<i class='fa fa-minus-square-o' style='font-size: large; color: #09a3ea;vertical-align: middle;' onclick='deleteItem(this);'></i>";
    }

    //tập hợp dữ liệu gửi đi
    function AssembleData(rowData, rowid) {
        //var zxdwjj = Number(rowData.zxdwjj);
        var ykpfj = Number(rowData.ykpfj);
        var yklsj = Number(rowData.yklsj);
        var zhyz = Number($("#sel_dw_" + rowid).find("option:selected").attr("data-zhyz"));
        var rkdw = $("#sel_dw_" + rowid).find("option:selected").text();
        //var sl = Number(rowData.sl)
        var bzs = Number(rowData.bzs);
        var pfj = parseFloat(ykpfj / bzs * zhyz);
        var lsj = parseFloat(yklsj / bzs * zhyz);
        var yxq = $("#yxq_" + rowid).val();
        var scrq = $("#scrq_" + rowid).val();
        var kprq = $("#kprq_" + rowid).val();
        var pfjze = parseFloat(rowData.pfjze).toFixed(4);
        //mã truy xuất
        var zsm = $("#sel_zsm_"+rowid).val()
        //có tách lẻ không
        var sfcl = $("#sel_sfcl_"+rowid).val()
        return {
            ypdm: rowData.ypdm,
            pfj: isNaN(pfj) ? 0 : pfj.toFixed(4),
            lsj: isNaN(lsj) ? 0 : lsj.toFixed(4),
            jj: rowData.jj,
            ykpfj: rowData.ykpfj,
            yklsj: rowData.yklsj,
            zje: rowData.jjze,
            sl: rowData.sl,
            Rkbmkc: rowData.kykc,
            Rkzhyz: $("#sel_dw_" + rowid).find("option:selected").attr("data-zhyz"),
            sccj: rowData.sccj,
            yxq: yxq,
            scrq: scrq,
            kprq: kprq,
            kl: rowData.kl,
            fph: rowData.fph,
            ph: rowData.ph,
            rkdw: rkdw,
            ckdw: "",
            pfjze: pfjze,
            zsm: zsm,
            sfcl: sfcl,

        };
    }

    //chuyển đổi đơn vị
    function ChangeDw(rowid) {
        $("#sel_dw_" + rowid).change(function () {
            CalculationLsze(rowid);
            ComputeKL();//tính tỷ lệ chiết khấu
            PfjZe(rowid);
        });
    }

    //khởi tạo sự kiện kiểm tra tồn kho khi nhập
    function InitKcCheck(rowid) {
        $("#" + rowid + "_sl").blur(function () {
            if (CheckKc(rowid)) {
                CalculationLsze(rowid);
                ComputeKL(rowid);//tính tỷ lệ chiết khấu
                PfjZe(rowid);
            }
        });
    }
    //tính tổng tiền giá bán buôn
    function PfjZe(rowid) {
        var sl = Number($("#" + rowid + "_sl").val());
        var ykpfj = parseFloat($("#" + rowid + "_ykpfj").val());
        var zhyz = Number($("#sel_dw_" + rowid).find("option:selected").attr("data-zhyz"));
        var bzs = Number($("#" + rowid + "_bzs").val());
        var pfj = parseFloat(ykpfj / bzs * zhyz);
        $("#" + rowid + "_pfjze").val((pfj * sl).toFixed(2));
        
    }
    //sự kiện kiểm tra tồn kho
    function CheckKc(rowid) {
        var reg = /^[1-9]\d*$/;//lớn hơn 0 số nguyên
        if (!reg.test($("#" + rowid + "_sl").val())) {
            $.modalMsg("số lượng phải lớn hơn 0 số nguyên!", "warning", 1500);
            $("#" + rowid + "_sl").val("");
            return false;
        }
        return true;
    }

    //tính tổng tiền bán lẻ
    function CalculationLsze(rowid) {
        var zhyz = Number($("#sel_dw_" + rowid).find("option:selected").attr("data-zhyz"));
        var sl = Number($("#" + rowid + "_sl").val());
        var zxdwlsj = Number($("#" + rowid + "_zxdwlsj").val());
        $("#" + rowid + "_lsze").val((zhyz * sl * zxdwlsj).toFixed(2));
    }

    //tổng tiền giá nhập mất tiêu điểm, tính nhập kho đơn giá
    function JJZE_Leave(id, rowid) {
        $("#" + id).change(function () {
            if ($("#" + rowid +"_jjze").val() === "") {
                return false;
            }
            if ($("#" + rowid +"_sl").val() === "") {
                return false;
            }
            var reg2 = /^\d+(?:\.\d{0,2})?$/;
            if (!reg2.test($("#" + rowid + "_jjze").val())) {
                $.modalMsg("tổng tiền giá nhập vui lòng nhập đúng định dạng số tiền!", "warning", 1500);
                return false;
            }
            var sl = Number($("#" + rowid + "_sl").val());
            var jjze = parseFloat($("#" + rowid + "_jjze").val());
            var jj = (sl === 0 ? 0 : parseFloat(jjze / sl));
            $("#" + rowid + "_jj").val(jj.toFixed(4));
            ComputeKL(rowid);
            ComputeRKZE();
        });
    }

    //tính tỷ lệ chiết khấu
    function ComputeKL(rowid) {
        if ($("#" + rowid +"_jj").val() === "") {
            return;
        }
        var ykpfj = parseFloat($("#" + rowid +"_ykpfj").val());
        var zhyz = Number($("#sel_dw_" + rowid).find("option:selected").attr("data-zhyz"));
        var bzs = Number($("#" + rowid +"_bzs").val());
        var pfj = parseFloat(ykpfj / bzs * zhyz);
        var jj = parseFloat($("#" + rowid + "_jjze").val());
        var sl = Number($("#" + rowid + "_sl").val());
        $("#" + rowid + "_kl").val(parseFloat(jj/sl/pfj * 100).toFixed(2));  //làm tròn 5 bỏ 6 vào
    }

    //tính tổng tiền nhập kho
    function ComputeRKZE() {
        var rkze = 0;
        var ids = $("#gridList").getDataIDs();
        for (var i = 0; i < ids.length; i++) {
            var tmp = parseFloat($("#" + ids[i] + "_jjze").val());
            rkze = rkze + (isNaN(tmp) ? 0 : tmp);
        }
        $("#txtRKZE").val(rkze.toFixed(2));
    }

    //khởi tạo mã nhập
    function InitSrm(id, rowid) {
        $("#" + id).newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 350,
            width: 1080,
            url: "/StorageManage/DrugStockSearch/DrugAndStockSearch",
            ajaxmethod: 'Get',
            inputtextcheck: function () {
                if ($("#gysCode").val() === "" || $("#gysmc").val() === "") {
                    $.modalMsg("vui lòng chọn nhà cung cấp trong lớp nổi", "error", 1000);
                    return false;
                }
                return true;
            },
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = $.trim($("#" + id).val());
                return reqData;
            },
            colModel: [
                { label: 'loại', name: 'dlmc', width: 60 },
                { label: 'mã', name: 'ypdm', width: 100 },
                { label: 'tên', name: 'ypmc', width: 200, align: 'left' },
                { label: 'quy cách', name: 'gg', width: 110, align: 'left' },
                { label: 'tồn kho', name: 'slStr', width: 90, align: 'center' },
                { label: 'đơn giá bán lẻ', name: 'lsjdjdw', width: 120, align: 'center' },//giá bán lẻ theo đơn vị bộ phận
                { label: 'số giấy phép', name: 'pzwh', width: 150, align: 'center' },
                { label: 'nhà sản xuất', name: 'sccj', width: 200, align: 'left' },
                { label: 'pfj', name: 'pfj', hidden: true },//giá bán buôn theo đơn vị bộ phận
                { label: 'lsj', name: 'lsj', hidden: true },//giá bán lẻ theo đơn vị bộ phận
                { label: 'ykpfj', name: 'ykpfj', hidden: true },
                { label: 'yklsj', name: 'yklsj', hidden: true },
                { label: 'bzs', name: 'bzs', hidden: true },
                { label: 'bzdw', name: 'bzdw', hidden: true },
                { label: 'dw', name: 'dw', hidden: true },//đơn vị bộ phận

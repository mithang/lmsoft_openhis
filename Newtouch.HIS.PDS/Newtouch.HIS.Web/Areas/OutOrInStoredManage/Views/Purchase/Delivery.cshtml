
@using Newtouch.Infrastructure
@{
    ViewBag.Title = "配货单获取验收";
    Layout = "~/Views/Shared/_Index.cshtml";

}

<script src="~/Content/js/index.js"></script>

<form id="form1">
    <div class="panel panel-default" style="margin-bottom:10px;">
        <div class="panel-heading">phân phối thông tin</div>
        <table class="form">
            <tr>
                <th class="formTitle "><span class="required">*</span>doanh nghiệp dược chọn: </th>
                <td class="formValue">
                    <input type="text" id="yq" name="yq" class="form-control" placeholder="vui lòng chọn doanh nghiệp dược" autocomplete="off" style="width:60%" />
                    <input type="hidden" id="yqbm" />
                </td>

                <th class="formTitle">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary" value="lấy chi tiết" />
                    <input type="button" id="btn_accept" class="btn btn-md btn-primary" value="nghiệm thu chi tiết" />
                </th>
                <td></td>
            </tr>
        </table>
    </div>
    <div id="dv-detail">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>

<script type="text/javascript">

    $(function () {
        InitFloat();

        //gridList();
    });


    //khởi tạo lớp nổi
    function InitFloat() {
        //doanh nghiệp dược
        $("#yq").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 200,
            width: 400,
            url: "/Medicine/MedicineSupplierList",
            ajaxmethod: 'Get',
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = $.trim($("#yq").val());
                return reqData;
            },
            colModel: [
                { label: 'mã doanh nghiệp dược', name: 'gysCode', widthratio: 30 },
                { label: 'doanh nghiệp dược', name: 'gysmc', widthratio: 70 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#yqbm").val($thistr.attr('data-gysCode'));
                $("#yq").val($thistr.attr('data-gysmc'));
                return;
            }
        });
    }

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/OutOrInStoredManage/Purchase/GetDeliveryGridJson",
            height: $(window).height() - 200,
            postData: { qybm: $("#yqbm").val(), psmxbh: '' },
            colModel: [
                { label: 'phân phối số phiếu', name: 'PSDH', width: 80, align: 'left' },
                { label: 'mã doanh nghiệp dược', name: 'YQBM', width: 80, align: 'left' },
                { label: 'mã điểm phân phối', name: 'PSDBM', width: 80, align: 'left' },
                { label: 'phân phối đơn ngày tạo', name: 'CJRQ', width: 100, align: 'left' },
                { label: 'phân phối chi tiết số hiệu', name: 'PSMXBH', width: 140, align: 'left' },
                { label: 'phân phối đơn dòng mã', name: 'PSDTM', width: 100, align: 'left' },
                {
                    label: '装箱类型', name: 'ZXLX', width: 100, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 1) return '多品规货品拼箱配送';
                        else if (cellvalue == 2) return '整箱为同一品规的货品';
                        else if (cellvalue == 3) return '同一次配送的同一品规货品分布在多箱内';
                    }
                },
                {
                    label: 'loại mua hàng', name: 'CGLX', width: 80, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 1) return 'BHYT phạm vi đấu thầu';
                        else if (cellvalue == 2) return 'BHYT phạm vi chưa đấu thầu';
                        else if (cellvalue == 3) return 'đấu thầu trong phạm vi BHYT không trúng thầu';
                        else if (cellvalue == 4) return 'niêm yết mạng trong phạm vi BHYT';
                        else if (cellvalue == 5) return 'niêm yết mạng trong phạm vi tự chi trả';
                        else if (cellvalue == 6) return '市量价挂钩集中采购';
                        else if (cellvalue == 9) return 'khác';
                    }
                },
                {
                    label: 'loại hàng hóa', name: 'SPLX', width: 60, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 1) return 'thuốc loại';
                        else if (cellvalue == 2) return 'loại vật tư y tế tiêu hao';
                        else if (cellvalue == 3) return 'loại thiết bị y tế';
                        else if (cellvalue == 9) return 'khác';
                    }
                },
                {
                    label: 'loại thuốc', name: 'YPLX', width: 100, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 1) return '生物制剂';
                        else if (cellvalue == 2) return 'trong thành thuốc';
                        else if (cellvalue == 3) return '中药饮片';
                        else if (cellvalue == 4) return '自制制剂';
                        else if (cellvalue == 5) return '免疫用疫苗';
                        else if (cellvalue == 6) return '实验室检验化验用药品或试剂';
                        else if (cellvalue == 7) return '医学检查用药品或试剂';
                        else if (cellvalue == 8) return '化学药品';
                        else if (cellvalue == 9) return 'khác';
                    }
                },
                { label: 'mã thống nhất hàng hóa', name: 'ZXSPBM', width: 190, align: 'left' },
                { label: '产品名', name: 'CPM', width: 120, align: 'left' },
                { label: 'dạng bào chế thuốc', name: 'YPJX', width: 80, align: 'left' },
                { label: 'quy cách', name: 'GG', width: 80, align: 'left' },
                {
                    label: 'chất liệu đóng gói', name: 'BZDWXZ', width: 100, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 1) return '商品最小零售单位';
                        else if (cellvalue == 2) return '大包装简包装';
                    }
                },
                { label: 'đơn vị đóng gói tên', name: 'BZDWMC', width: 80, align: 'left' },
                { label: 'dùng thuốc tên đơn vị', name: 'YYDWMC', width: 80, align: 'left' },
                { label: '包装内含数量', name: 'BZNHSL', width: 80, align: 'left' },
                { label: '生产企业名称', name: 'SCQYMC', width: 150, align: 'left' },
                { label: 'số lô sản xuất', name: 'SCPH', width: 80, align: 'left' },
                { label: 'ngày sản xuất', name: 'SCRQ', width: 80, align: 'left' },
                { label: 'ngày hiệu lực', name: 'YXRQ', width: 80, align: 'left' },
                { label: '计划单号', name: 'JHDH', width: 80, align: 'left' },
                { label: 'số đơn hàng bán', name: 'XSDDH', width: 90, align: 'left' },
                { label: 'liên kết đơn hàng chi tiết số hiệu', name: 'DDMXBH', width: 160, align: 'left' },
                { label: 'số thứ tự', name: 'SXH', width: 80, align: 'left' },
                { label: 'phân phối số lượng', name: 'PSL', width: 80, align: 'left' },
            ],

            multiselect: false,

            pager: "#gridPager",
            sortname: 'PSDH',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                //btn_selectrow(rowid);
            },
            gridComplete: function () {
                var ids = $("#gridList").getDataIDs();
                var num = ids.length - 1;
                for (i = 0; i <= num; i++) {
                    //var lastRowoid = ids[ids.length - 1];
                    var lastRowoid = ids[i];
                    EnableInlineEditBox(lastRowoid);
                }
            }
        });
        $("#btn_search").click(function () {
            $('#gridList').jqGrid("clearGridData");
            $gridList.jqGrid('setGridParam', {
                postData: { qybm: $("#yq").val(), psmxbhcxtj: '' },
            }).trigger('reloadGrid');
        });
    }


    //bật chỉnh sửa trong dòng
    function EnableInlineEditBox(rowid) {
        $("#gridList").jqGrid('editRow', rowid, false, initInlineFunc);//mở chế độ chỉnh sửa
        $("#jqg_gridList_" + rowid).trigger("click");
    }

    //khởi tạo lớp nổi
    function initInlineFunc(rowid) {
        $("#" + rowid + "_PSYSLXXXXXXX").parent().next().children('select').append('<option value="1">预验收</option><option value="2">thực nghiệm thu</option>');//nghiệm thu loại
    }

    //lấy chi tiết
    $('#btn_search').click(function () {
        if ($("#yq").val() == "" || $("#yq").val() == null) {
            $.modalAlert("vui lòng chọn nhà cung cấp", 'warning');
            return;
        }
        gridList();
    });

    //nghiệm thu chi tiết
    $('#btn_accept').click(function () {
        var rowData = $("#gridList").jqGridRowValue();
        if (rowData == null) {
            $.modalAlert("vui lòng chọn cần nghiệm thu của chứng từ", 'warning');
            return;
        }
        var postData = {
            YQBM: rowData.YQBM,
            PSMXBH: rowData.PSMXBH,
            PSDTM: rowData.PSDTM,
            ZXSPBM: rowData.ZXSPBM,
            PSL: rowData.PSL,
            SCPH: rowData.SCPH,
            YSJG: "1",  //0 nghiệm thu không đạt 1 nghiệm thu đạt
            YSJGBZ: rowData.YSJGBZ,
        }

        $.submitForm({
            url: "/OutOrInStoredManage/Purchase/DeliveryAccept",
            param: postData,
            success: function () {
                $.modalMsg('nghiệm thu thành công', 'success');
                $.modalClose();
            }
        });
    });


</script>



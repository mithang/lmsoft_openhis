<form id="form1">
    <div class="panel panel-default" style="margin-bottom:10px;">
        <div class="panel-heading">hóa đơn thông tin</div>
        <table class="form">
            <tr>
                <th class="formTitle "><span class="required">*</span>doanh nghiệp dược: </th>
                <td class="formValue">
                    <input type="text" id="yq" name="yq" class="form-control" placeholder="vui lòng chọn doanh nghiệp dược" autocomplete="off" style="width:60%"/>
                    <input type="hidden" id="yqbm" />
                </td>

                <th class="formTitle">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary" value="lấy chi tiết" />
                    <input type="button" id="btn_accept" class="btn btn-md btn-primary" value="nghiệm thu chi tiết" />
                </th>
                <td></td>
            </tr>
        </table>
    </div>
    <div id="dv-detail">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>

<script type="text/javascript">

    $(function () {
        InitFloat();

        //gridList();
    });


    //khởi tạo lớp nổi
    function InitFloat() {

        //doanh nghiệp dược
        $("#yq").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 200,
            width: 400,
            url: "/Medicine/MedicineSupplierList",
            ajaxmethod: 'Get',
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = $.trim($("#yq").val());
                return reqData;
            },
            colModel: [
                { label: 'mã doanh nghiệp dược', name: 'gysCode', widthratio: 30 },
                { label: 'doanh nghiệp dược', name: 'gysmc', widthratio: 70 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#yqbm").val($thistr.attr('data-gysCode'));
                $("#yq").val($thistr.attr('data-gysmc'));
                return;
            }
        });


    }

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/OutOrInStoredManage/Purchase/GetBillGridJson",
            height: $(window).height() - 200,
            postData: { yqbm: $("#yqbm").val(), fpmxbh: '1' },
            colModel: [
            
                { label: 'số hóa đơn', name: 'FPH', width: 80, align: 'left' ,key:true,},
                { label: 'hóa đơn ngày', name: 'FPRQ', width: 80, align: 'left' },
                { label: 'hóa đơn bao gồm thuế tổng số tiền', name: 'FPHSZJE', width: 100, align: 'left' },
                { label: 'mã doanh nghiệp dược', name: 'YQBM', width: 80, align: 'left' },
                { label: 'mã bệnh viện', name: 'YYBM', width: 100, align: 'left' },
                { label: 'mã điểm phân phối', name: 'PSDBM', width: 100, align: 'left' },
                { label: '带量采购标志', name: 'DLSGBZ', width: 80, align: 'left' },
                { label: 'hóa đơn ghi chú', name: 'FPBZ', width: 60, align: 'left' },
                {
                    label: 'có hay không không có phân phối hóa đơn', name: 'SFWPSFP', width: 90, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 0) return 'không';
                        else if (cellvalue == 1) return 'có';
                    }
                },
                { label: 'không có phân phối hóa đơn mô tả', name: 'WPSFPSM', width: 80, align: 'left' },
                { label: 'hóa đơn chi tiết số hiệu', name: 'FPMXBH', width: 140, align: 'left' },
                {
                    label: 'loại hàng hóa', name: 'SPLX', width: 60, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 1) return 'thuốc loại';
                        else if (cellvalue == 2) return 'loại vật tư y tế tiêu hao';
                        else if (cellvalue == 3) return 'loại thiết bị y tế';
                        else if (cellvalue == 9) 'khác';
                    }
                },
                {
                    label: '是否冲红', name: 'SFCH', width: 60, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 0) return 'không';
                        else if (cellvalue == 1) return 'có';
                    }
                },
                { label: 'mã thống nhất hàng hóa', name: 'ZXSPBM', width: 120, align: 'left' },
                { label: 'số lô sản xuất', name: 'SCPH', width: 60, align: 'left' },
                { label: 'ngày sản xuất', name: 'SCRQ', width: 60, align: 'left' },
                { label: 'hàng hóa số lượng', name: 'SPSL', width: 60, align: 'left' },
                { label: 'liên kết chi tiết số hiệu', name: 'GLMXBH', width: 120, align: 'left' },
                { label: 'số đơn hàng bán', name: 'XSDDH', width: 120, align: 'left' },
                { label: 'số thứ tự', name: 'SXH', width: 60, align: 'left' },
                { label: 'ngày hiệu lực', name: 'YXRQ', width: 60, align: 'left' },
                { label: '无税单价', name: 'WSDJ', width: 60, align: 'left' },
                { label: 'bao gồm thuế đơn giá', name: 'HSDJ', width: 60, align: 'left' },
                { label: '税率', name: 'SL', width: 60, align: 'left' },
                { label: '税额', name: 'SE', width: 60, align: 'left' },
                { label: 'bao gồm thuế số tiền', name: 'HSJE', width: 60, align: 'left' },
                { label: 'giá bán buôn', name: 'PFJ', width: 60, align: 'left' },
                { label: 'giá bán lẻ', name: 'LSJ', width: 60, align: 'left' },
                { label: 'thuốc số giấy phép', name: 'PZWH', width: 120, align: 'left' },

            ],

            multiselect: false,

            pager: "#gridPager",
            sortname: 'FPH',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                //btn_selectrow(rowid);
            }
        });
        $("#btn_search").click(function () {
            $('#gridDJMXInfo').jqGrid("clearGridData");
            $gridList.jqGrid('setGridParam', {
                postData: { kssj: $("#kssj").val(), jssj: $("#jssj").val() },
            }).trigger('reloadGrid');
        });
    }

    //lấy chi tiết
    $('#btn_search').click(function () {
        if ($("#yq").val() == "" || $("#yq").val() == null) {
            $.modalAlert("vui lòng chọn doanh nghiệp dược", 'warning');
            return ;
        }
        gridList();
    });


    //nghiệm thu chi tiết
    $('#btn_accept').click(function () {
        var rowData = $("#gridList").jqGridRowValue();
        if (rowData == null || rowData.length==0) {
            $.modalAlert("vui lòng chọn cần nghiệm thu của chứng từ", 'warning');
            return;
        }
        //var psmxbh = rowData.PSMXBH;
        //var hctbdm = rowData.HCTBDM;
        //var scph = rowData.SCPH;
        //var pssl = rowData.PSSL
        $.modalOpen({
            id: "Form",
            title: "hóa đơn nghiệm thu",
            url: "/OutOrInStoredManage/Purchase/BillForm?FPH=" + rowData.FPH + "&YQBM=" + rowData.YQBM + "&FPHSZJE=" + rowData.FPHSZJE,
            width: "350px",
            height: "150px",
            callBack: function (iframeId) {
                //nghiệm thu
                top.frames[iframeId].SubmitForm();
                //chi tiết hóa đơn được ghi nhận
                $.najax({
                    type: "POST",
                    url: "/OutOrInStoredManage/Purchase/BillDetailInsert",
                    data: { entity: rowData },
                    dataType: "json",
                    success: function (res) {
                        if (res.state == "success") {
                            $.modalMsg("发票落地成功!", 'success');
                            //$('#gridDJMXInfo').jqGrid("clearGridData");

                            $('#btn_search').trigger('click');
                        } else {
                            $.modalMsg("发票落地失败: " + res.message, 'warning');
                        }
                    }
                });
            }
        });
    });




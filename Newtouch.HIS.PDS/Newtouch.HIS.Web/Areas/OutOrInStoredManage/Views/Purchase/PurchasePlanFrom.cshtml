
@using Newtouch.Infrastructure
@{
    ViewBag.Title = "dược khoa-采购计划单药品录入";
    Layout = "~/Views/Shared/_Index.cshtml";

}
<style>
    .inline {
        width: 80%;
        display: inline;
    }

    .PriceInline {
        width: 70%;
        display: inline;
    }

    #dv-detail table th {
        border: solid 1px #ddd;
        padding: 0;
        vertical-align: middle;
    }

    #dv-detail .ui-jqgrid-labels, #dv-detail .jqgrow .ui-row-ltr {
        height: 30px;
        vertical-align: middle;
    }


    #dv-detail table td {
        border: solid 1px #ddd;
        padding: 0;
        vertical-align: middle;
    }

    #dv-detail input[role=textbox] {
        padding: 2px 2px;
    }

    #gridList .ckbox label {
        margin-top: 24px;
    }
</style>
<form id="form1">
    <div class="panel panel-default" style="margin-bottom:10px;">
        <div class="panel-heading">thông tin phát thuốc</div>
        <table class="form">
            <tr>
                <th class="formTitle"><span class="required">*</span>loại đơn hàng: </th>
                <td class="formValue" id="ddlxtd">
                    <select id="ddlx" name="ddlx" class="form-control required">
                        <option value="1">thông thường mua hàng</option>
                        <option value="2">khẩn cấp mua hàng</option>
                    </select>
                </td>
                <th class="formTitle "><span class="required">*</span>nhà cung cấp: </th>
                <td class="formValue">
                    <input type="text" id="yq" name="yq" class="form-control" placeholder="vui lòng chọn nhà cung cấp" autocomplete="off" />
                    <input type="hidden" id="yqbm" />
                </td>
                <th class="formTitle">
                    <input type="button" id="btn_add" class="btn btn-md btn-primary" value="thêm" />
                </th>
                <td></td>
            </tr>
        </table>
    </div>
    <div id="dv-detail">
        <table id="gridList"></table>
    </div>
</form>
<script type="text/javascript">

    var $gridList = $("#gridList");
    var cgId = $.request("keyValue");//mua hàng Id;

    $(function () {
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });
        //khởi tạo
        init();
        //mua hàng đơn chứng sửa
        if (cgId != null && cgId != "") {
            $.najax({
                type: "Get",
                url: "/OutOrInStoredManage/Purchase/QueryPurchasebyId",
                data: { cgId: cgId },
                dataType: "json",
                success: function (ajaxresp) {
                    if (ajaxresp !== null) {
                        $("#ddlx").val(ajaxresp[0].ddlx);
                        $("#yqbm").val(ajaxresp[0].gysCode);
                        $("#yq").val(ajaxresp[0].gysName);
                    }
                }
            });
            $.najax({
                type: "Get",
                url: "/OutOrInStoredManage/Purchase/QueryPurchaseDetailbyId",
                data: { cgId: cgId },
                dataType: "json",
                success: function (ajaxresp) {
                    if (ajaxresp !== null && ajaxresp.length != 0) {
                        for (var i = 0; i < ajaxresp.length; i++) {
                            ajaxresp[i].operate = GetOperatehtml();
                            ajaxresp[i].dlmc = ajaxresp[i].yplb;
                            $("#gridList").jqGrid("addRowData", undefined, ajaxresp[i], "last");
                            $("#jqg" + (i + 1) + "_sccj").val(ajaxresp[i].sccj);
                            $("#jqg" + (i + 1) + "_ypmc").val(ajaxresp[i].ypmc);
                            $("#jqg" + (i + 1) + "_ypdm").val(ajaxresp[i].ypCode);
                            $("#jqg" + (i + 1) + "_zxspdm").val(ajaxresp[i].zxspdm);
                            $("#jqg" + (i + 1) + "_cgdj").val(ajaxresp[i].cgdj);
                            $("#jqg" + (i + 1) + "_cgsl").val(ajaxresp[i].cgsl);
                            $("#jqg" + (i + 1) + "_cgjldw").val(ajaxresp[i].cgjldw);
                            $("#jqg" + (i + 1) + "_ybgg").val(ajaxresp[i].ggbz);
                            $("#sel_dw_jqg" + (i + 1)).append('<option value="dw" data-dw="' + ajaxresp[i].dw + '" selected>' + ajaxresp[i].dw + '</option>');
                            //$("#jqg" + (i + 1) + "_cglx").append('<option value="' + ajaxresp[i].cglx + '" selected>' + ajaxresp[i].cglxmc  + '</option>');
                            $("#jqg" + (i + 1) + "_cglx").val(ajaxresp[i].cglxmc);
                            $("#jqg" + (i + 1) + "_pfze").val((ajaxresp[i].cgdj * ajaxresp[i].cgsl).toFixed(2));
                            InitKcCheck("jqg" + (i + 1));
                        }
                    }
                }
            });
        } else {
            $("#gridList").jqGrid("addRowData", undefined, { operate: GetOperatehtml() }, "last");
        }
    });

    //khởi tạo
    function init() {
        InitJqGrid();

        //nhà cung cấp
        $("#yq").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 200,
            width: 400,
            url: "/Medicine/MedicineSupplierList",
            ajaxmethod: 'Get',
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = $.trim($("#yq").val());
                return reqData;
            },
            colModel: [
                { label: 'mã', name: 'gysCode', widthratio: 30 },
                { label: 'tên', name: 'gysmc', widthratio: 70 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#yqbm").val($thistr.attr('data-gysCode'));
                $("#yq").val($thistr.attr('data-gysmc'));
                return;
            }
        })
        //thêm dòng nút
        $("#btn_add").click(function () {
            $("#gridList").jqGrid("addRowData", undefined, { operate: GetOperatehtml() }, "last");
        });
    }

    //thêm chi tiết phát thuốc
    function addItem(obj) {
        var ids = $("#gridList").getDataIDs();
        var lastRowoid = ids[ids.length - 1];
        var dataRow = {
            operate: GetOperatehtml(),
        };
        $("#gridList").jqGrid("addRowData", undefined, dataRow, "after", lastRowoid);
    }

    //xóa chi tiết phát thuốc
    function deleteItem(obj) {
        var selRowId = $(obj).parent().parent().attr("id");
        if (!!selRowId) {
            $("#gridList").jqGrid("delRowData", selRowId);
            var ids = $("#gridList").getDataIDs();
            var lastRowoid = ids[ids.length - 1];
            EnableInlineEditBox(lastRowoid);
        }
    }

    //lấy nút thao tác html
    function GetOperatehtml() {
        return "<i class='fa fa-plus-square-o' style='font-size: large; color: #09a3ea;vertical-align: middle;' onclick='addItem(this);'></i>&nbsp;&nbsp;&nbsp;<i class='fa fa-minus-square-o' style='font-size: large; color: #09a3ea;vertical-align: middle;' onclick='deleteItem(this);'></i>";
    }

    //khởi tạo chi tiết xuất kho
    function InitJqGrid() {
        $gridList.newtouchLocalDataGrid({
            data: [],
            height: $(window).height() - document.getElementById('gridList').offsetTop - 85,
            rownumbers: true,  //có hiển thị số thứ tự không
            shrinkToFit: true,
            multiselect: true,
            editurl: "clientArray",  //chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            unwritten: false,
            colModel: [
                { label: 'thao tác', name: 'operate', width: 50, align: 'center' },
                {
                    label: 'số thứ tự', name: 'sxh', width: 51, align: 'center',hidden:true, formatter: function (cellvalue, options, cell) {
                        var rowId = options.rowId;
                        var sxh = rowId.replace("jqg", "");
                        return sxh;
                    } },
                { label: '<span class="required">*</span>tên thuốc', name: 'ypmc', width: 150, align: 'center', editable: true, editwidth: "100%" },
                { label: "mã thuốc", name: "ypdm", width: 75, align: 'center', editable: true, editwidth: "100%" },
                { label: 'đơn giá mua hàng', name: 'cgdj', width: 75, align: 'center', editable: true, editwidth: "100%" },
                { label: '<span class="required">*</span>số lượng mua', name: 'cgsl', width: 70, align: 'center', editable: true, editwidth: "100%" },
                { label: '<span class="required">*</span>đơn vị', name: 'dw', width: 50, align: 'center', formatter: function (cellvalue, options) { return "<select name=\"dw\" id=\"sel_dw_" + options.rowId + "\" rowid=" + options.rowId + " class=\"editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" ></select>"; } },
                { label: 'tổng mức', name: 'pfze', width: 80, align: 'center', editable: true, editwidth: "100%" },
                { label: 'quy cách', name: 'ybgg', width: 100, align: 'center', editable: true, editwidth: "100%" },
                { label: 'splxxxxxxx', name: 'splxxxxxxx', editwidth: '', align: 'center', editable: true, hidden: true },
                {
                    label: '<span class="required">*</span>loại hàng hóa', name: 'splx', width: 80, align: 'center', editable: true, editwidth: "100%", edittype: "select", editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    var $thisval = $(this).val();

                                    $("#" + rowid + "_splxxxxxxx").val($thisval);
                                }
                            }
                        ]
                    }
                },
                { label: 'ghi chú giải thích', name: 'bzsm', width: 70, align: 'center', editable: true, editwidth: "100%" },
                { label: 'nhà sản xuất', name: 'sccj', width: 200, align: 'center', editable: true, editwidth: "100%" },
                { label: 'pc', name: 'pc', hidden: true },
                { label: 'ph', name: 'ph', hidden: true },
                { label: 'bzs', name: 'bzs', hidden: true, editable: true },
                { label: 'kykc', name: 'kykc', hidden: true, editable: true },
                { label: 'pfj', name: 'pfj', hidden: true, editable: true },
                { label: 'lsj', name: 'lsj', hidden: true, editable: true },
                { label: 'zxdwlsj', name: 'zxdwlsj', hidden: true, editable: true },
                { label: 'ykpfj', name: 'ykpfj', hidden: true, editable: true },
                { label: 'yklsj', name: 'yklsj', hidden: true, editable: true },
                { label: 'zxdwjj', name: 'zxdwjj', hidden: true, editable: true },
                { label: 'zxspbm', name: 'zxspbm', hidden: true, editable: true }
            ],
            editinputwidthborder: false,    //có cần viền không mặc định là true
            editinputborderradius: false,   //có cần bo tròn viền không mặc định true (có bo tròn)
            gridComplete: function () {
                var ids = $("#gridList").getDataIDs();
                var lastRowoid = ids[ids.length - 1];
                EnableInlineEditBox(lastRowoid);
            }
        });
    }
    //bật chỉnh sửa trong dòng
    function EnableInlineEditBox(rowid) {
        $("#gridList").jqGrid('editRow', rowid, false, initInlineFunc);//mở chế độ chỉnh sửa
        $("#jqg_gridList_" + rowid).trigger("click");
    }

    //khởi tạo lớp nổi
    function initInlineFunc(rowid) {
        //một số cột chỉ đọc
        $("#" + rowid + "_ypdm").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_gg").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_ph").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_yxq").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_sccj").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_lsj").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_pfze").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_ybgg").css('background-color', '#f6f7fb').attr('readonly', 'true');
        InitSrm(rowid + "_ypmc", rowid)//lớp nổi thuốc
        InitTabKey("sel_dw_" + rowid, rowid);//đơn vị tab xuống dòng
        $("#" + rowid + "_splxxxxxxx").parent().next().children('select').append('<option value="1">thuốc loại</option><option value="2">loại thiết bị vật tư y tế tiêu hao</option><option value="9">khác</option>');//loại hàng hóa

    }

    //tab phím ra phát
    function InitTabKey(id, rowid) {
        $("#" + id).keydown(function (e) {
            e = window.event ? window.event : e;
            var keyCode = e.which ? e.which : e.keyCode;
            if (keyCode === 9) {//tab
                $(this).parent().parent().find(".fa-plus-square-o").trigger("click");
            }
        });
    }

    //Khởi tạo mã nhập khung thuốc
    function InitSrm(id, rowid) {
        $("#" + id).newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 350,
            width: 1200,
            url: "/StorageManage/DrugStockSearch/DrugAndStockSearch",
            ajaxmethod: 'Get',
            inputtextcheck: function () {
                if ($("#yqbm").val() === "" || $("#yq").val() === "") {
                    $.modalMsg("vui lòng chọn nhà cung cấp trong lớp nổi", "error", 1000);
                    return false;
                }
                return true;
            },
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = $.trim($("#" + id).val());
                return reqData;
            },
            colModel: [
                { label: 'loại', name: 'dlmc', width: 60 },
                { label: 'mã', name: 'ypdm', width: 80 },
                { label: 'tên', name: 'ypmc', width: 200, align: 'left' },
                { label: 'quy cách', name: 'gg', width: 90, align: 'left' },
                { label: 'tồn kho', name: 'slStr', width: 80, align: 'center' },
                { label: 'đơn giá bán lẻ', name: 'lsjdjdw', width: 100, align: 'center' },//giá bán lẻ theo đơn vị bộ phận
                { label: 'đơn giá bán buôn', name: 'pfjdjdw', width:100,align:'center'},
                { label: 'pfj', name: 'pfj', hidden: true },//giá bán buôn theo đơn vị bộ phận
                { label: 'lsj', name: 'lsj', hidden: true },//giá bán lẻ theo đơn vị bộ phận
                { label: 'ykpfj', name: 'ykpfj', hidden: true },
                { label: 'yklsj', name: 'yklsj', hidden: true },
                { label: 'số giấy phép', name: 'pzwh', width: 150, align: 'center' },
                { label: 'nhà sản xuất', name: 'sccj', width: 200, align: 'left' },
                { label: 'mã BHYT quốc gia', name: 'gjybdm', width: 110, hidden: true, align: 'left' },//mã BHYT quốc gia
                { label: 'bzs', name: 'bzs', hidden: true },
                { label: 'bzdw', name: 'bzdw', hidden: true },
                { label: 'dw', name: 'dw', hidden: true },//đơn vị bộ phận
                { label: 'zhyz', name: 'zhyz', hidden: true },
                { label: 'zxdw', name: 'zxdw', hidden: true },
                { label: 'zxdwlsj', name: 'zxdwlsj', hidden: true },
            ],
            itemdbclickhandler: function ($thistr) {
                $("#" + rowid + "_ypdm").val($thistr.attr('data-ypdm'));
                $("#" + rowid + "_ypmc").val($thistr.attr('data-ypmc'));
                $("#" + rowid + "_ybgg").val($thistr.attr('data-gg'));
                $("#" + rowid + "_sccj").val($thistr.attr('data-sccj'));
                $("#" + rowid + "_lsj").val($thistr.attr('data-lsj'));
                $("#" + rowid + "_lsjdjdw").val($thistr.attr('data-lsjdjdw'));
                $("#" + rowid + "_cgdj").val($thistr.attr('data-ykpfj'));
                $("#" + rowid + "_yklsj").val($thistr.attr('data-yklsj'));
                $("#" + rowid + "_ykpfj").val($thistr.attr('data-ykpfj'));
                $("#" + rowid + "_zhyz").val($thistr.attr('data-zhyz'));
                $("#" + rowid + "_bzs").val($thistr.attr('data-bzs'));
                $("#" + rowid + "_zxdwlsj").val($thistr.attr('data-zxdwlsj'));
                $("#" + rowid + "_zxspbm").val($thistr.attr('data-gjybdm'));
                initDw($thistr, rowid);
                $("#" + rowid + "_sl").val("");
                $("#" + rowid + "_lsze").val("");
                $("#sel_dw_" + rowid).trigger("change");
                InitKcCheck(rowid);
            }
        });
    }
  
    //khởi tạo đơn vị
    function initDw($thistr, rowid) {
        $("#sel_dw_" + rowid).empty();
        $("#sel_dw_" + rowid).append('<option value="bzdw" data-zhyz="' + $thistr.attr('data-bzs') + '" selected>' + $thistr.attr('data-bzdw') + '</option>');
        //if ($thistr.attr('data-dw') !== $thistr.attr('data-bzdw')) {
        //    $("#sel_dw_" + rowid).append('<option value="bmdw" data-zhyz="' + $thistr.attr('data-zhyz') + '" selected>' + $thistr.attr('data-dw') + '</option>');
        //}
        //if ($thistr.attr('data-zxdw') !== $thistr.attr('data-bzdw') && $thistr.attr('data-dw') != $thistr.attr('data-zxdw')) {
        //    $("#sel_dw_" + rowid).append('<option value="zxdw" data-zhyz="1" selected>' + $thistr.attr('data-zxdw') + '</option>');
        //}
    }

    //khởi tạo nhập kiểm tra sự kiện
    function InitKcCheck(rowid) {
        $("#" + rowid + "_cgsl").blur(function () {
            var reg = /^[1-9]\d*$/;//lớn hơn 0 số nguyên
            if (!reg.test($("#" + rowid + "_cgsl").val())) {
                $.modalMsg("số lượng phải lớn hơn 0 số nguyên!", "warning", 1500);
                return false;
            }
            CalculationLsze(rowid);
        });
        $("#" + rowid + "_cgdj").blur(function () {
            var reg = /^[1-9]\d*$/;//lớn hơn 0 số nguyên
            if (!reg.test($("#" + rowid + "_cgdj").val())) {
                $.modalMsg("采购单据请输入正确的金额格式!", "warning", 1500);
                return false;
            }
            CalculationLsze(rowid);
        });
    }

    //tính tổng tiền bán lẻ
    function CalculationLsze(rowid) {
        var sl = Number($("#" + rowid + "_cgsl").val());
        var cgdj = Number($("#" + rowid + "_cgdj").val());
        $("#" + rowid + "_pfze").val((sl * cgdj).toFixed(2));
    }

    //tập hợp dữ liệu gửi đi
    function AssembleDataPurchase(rowData, rowid) {
        return {
            sxh: rowData.sxh,
            cglx: rowData.cglxxxxxxx == "" || !rowData.cglxxxxxxx ? '1' : rowData.cglxxxxxxx,
            splx: rowData.splxxxxxxx == "" || !rowData.splxxxxxxx ? '1' : rowData.splxxxxxxx,
            zxspbm: rowData.zxspbm,
            cgjldw: rowData.cgjldwwwwwww == "" || !rowData.cgjldwwwwwww ? '1' : rowData.cgjldwwwwwww,
            ggbz: rowData.ybgg,
            cgsl: rowData.cgsl,
            cgdj: rowData.cgdj,
            zje: rowData.pfze,
            yqbm: $("#yqbm").val(),//mã doanh nghiệp dược
            dcpsbs: rowData.dcpsbsssssss == "" || !rowData.dcpsbsssssss ? '0' : rowData.dcpsbsssssss,
            bzsm: rowData.bzsm,
            py: '',
            dw: $("#sel_dw_" + rowid).find("option:selected").text(),
            //dw: $(rowData.dw).text(),
            ypName: rowData.ypmc,
            ypCode: rowData.ypdm,
            OrganizeId: '',
        }
    }

    //lưu
    function newtouch_event_f8() {
        debugger;
        var list = [];
        var validationFailedArr = [];
        $.each($("#gridList").find("input[type=checkbox]:checked"), function () {
            var rowid = $(this).parent().parent().parent().attr("id");
            $("#gridList").saveRow(rowid, null, null, null, function (callbackRowId) { }, null, null);
            var rowData = $("#gridList").jqGrid('getRowData', rowid);
            if (!Validately(rowData, rowid)) {
                validationFailedArr.push(rowid);
                return;
            }
            list.push(AssembleDataPurchase(rowData, rowid));
        });
        if (validationFailedArr.length > 0) {
            for (var i = 0; i < validationFailedArr.length; i++) {
                $("#gridList").jqGrid('editRow', validationFailedArr[i], false, initInlineFunc);//mở chế độ chỉnh sửa
            }
            return;
        }
        if (list.length === 0) {
            $.modalMsg("vui lòng chọn dữ liệu cần sửa!", 'warning', 1000);
            return;
        }
        var par = new Object();
        par["cgmx"] = list; //mua hàng chi tiết
        par["psdbm"] = $("#psd").val()? $("#psd").val():'01';//mã điểm phân phối 
        par["ddlx"] = $("#ddlx").val();//loại đơn hàng
        //par["zwdhrq"] = $("#zwdhrq").val();//ngày giao hàng muộn nhất
        par["gysCode"] = $("#yqbm").val();//mã doanh nghiệp dược
        par["gysName"] = $("#yq").val();//doanh nghiệp dược tên
        par["jls"] = list.length//số bản ghi
        par["yybm"] = "001";//mã bệnh viện
        //par["ddbh"] = " ";//số đơn hàng thêm mới:trống   sửa/thu hồi:số đơn hàng
        //par["yyjhdh"] = "test";//số phiếu kế hoạch bệnh viện do hệ thống tạo
        //par["ddzt"] = "1";//1 đã lưu 2 đã gửi báo cáo 3 đã nghiệm thu
        par["ddsj"] = new Date();//thời gian đơn hàng
        par["czlx"] = 1;//loại thao tác 1 thêm mới 3 hủy bỏ
        $.najax({
            type: "POST",
            url: "/OutOrInStoredManage/Purchase/SubmitPurchase",
            data: { cgEntity: par, cgmxList: list, keyValue: cgId },
            dataType: "json",
            success: function (res) {
                if (res.state === "success") {
                    $.currentWindow().$("#gridList").resetSelection();
                    $.currentWindow().$("#gridList").trigger("reloadGrid");
                    $.modalMsg('chứng từ nhập thành công!', 'success', 1000);
                    $.modalClose("PurchasePlanForm");
                } else {
                    $.modalAlert(res.message, 'error');
                }
            }
        });
    }

    //kiểm tra giá trị số
    function Validately(rowData, rowid) {
        if (rowData.ypmc === "") {
            $.modalMsg('bắt buộc chọn thuốc', 'warning', 1000);
            return false;
        }
        var reg2 = /^\d+(?:\.\d{0,2})?$/;
        if (!reg2.test(rowData.cgdj)) {
            $.modalMsg("采购价请输入正确的金额格式!", "warning", 1500);
            return false;
        }
        var reg = /^[1-9]\d*$/;//lớn hơn 0 số nguyên
        if (!reg.test(rowData.cgsl)) {
            $.modalMsg("số lượng phải lớn hơn 0 số nguyên!", "warning", 1500);
            return false;
        }
        return true;
    }

    function AcceptClick(callBack) {
        newtouch_event_f8();
    }

</script>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<div>
    请为医疗机构维护一个<span style="color:red;">bệnh viện quản lý viên</span>vai trò, mã<span style="color:red; margin-left:5px;">HospAdministrator</span>
</div>
<div class="topPanel">
    @Html.Partial("_OrganizeIdDDLToolbarSearchView")
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>tạo mới</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>sửa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-trash-o"></i>xóa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_users()"><i class="fa fa-pencil-square-o"></i>vai trò người dùng</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="tên/mã" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>
    $(function () {
        gridList();
    })
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/SystemManage/SysRole/GetGridJson",
            height: $(window).height() - 135,
            postData: { keyword: $("#txt_keyword").val(), OrganizeId: $("#OrganizeId").val() },
            colModel: [
                { label: "khóa chính", name: "Id", hidden: true, key: true },
                { label: "còn hiệu lực", name: "zt", width: 80, align: "center", formatter: function (cellvalue) { return cellvalue == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
                { label: 'tên', name: 'Name', width: 150, align: 'left' },
                { label: 'mã', name: 'Code', width: 100, align: 'left' },
                { label: 'ghi chú', name: 'Description', width: 300, align: 'left' },
                    { label: 'sắp xếp', name: 'px', width: 40, align: 'left' },
                { label: 'người tạo', name: 'CreatorCode', width: 100, align: 'left' },
                { label: 'thời gian tạo', name: 'CreateTime', width: 130, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'sửa đổi lần cuối', name: 'LastModifierCode', width: 100, align: 'left' },
                { label: 'thời gian sửa đổi lần cuối', name: 'LastModifyTime', width: 130, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
            ],
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords: true,
            rowNum: '10',
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword").val(), OrganizeId: $("#OrganizeId").val() },
            }).trigger('reloadGrid');
        });
    }

    //sự kiện Enter
    $('#txt_keyword').keydownEnterEvent(function() {
        $('#btn_search').trigger('click');
    });

    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "thêm mới vai trò",
            url: "/SystemManage/SysRole/Form?orgId=" + $('#OrganizeId').val(),
            width: "550px",
            height: "530px",
            btn: null
        });
    }

    function btn_edit() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("vui lòng chọn một bản ghi", 'warning');
            return;
        }
        $.modalOpen({
            id: "Form",
            title: "sửa vai trò",
            url: "/SystemManage/SysRole/Form?keyValue=" + keyValue,
            width: "550px",
            height: "530px",
            btn: null
        });
    }

    function btn_delete() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("vui lòng chọn một bản ghi", 'warning');
            return;
        }
        $.deleteForm({
            url: "/SystemManage/SysRole/DeleteForm",
            param: { keyValue: $("#gridList").jqGridRowValue().Id },
            success: function() {
                $.currentWindow().$("#gridList").trigger("reloadGrid");
            }
        });
    }
    function btn_users() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("vui lòng chọn một bản ghi", 'warning');
            return;
        }
        $.modalOpen({
            id: "FormRoleUsers",
            title: "vai trò người dùng",
            url: "/SystemManage/SysUser/Selector?from=rolerelatioinuser&callbackType=json&keyValue=" + keyValue + "&isContansChildOrg=false&organizeId=" + $('#OrganizeId').val(),
            width: "650px",
            height: "570px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function (data) {
                    userStaffTreeCallback(data);
                });
            }
        });
    }

    //phương thức gọi lại cây nhân viên người dùng
    function userStaffTreeCallback(data) {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            return;
        }
        var arr = new Array();
        $.each(data, function () {
            arr.push({ First: this.value, Second: this.Ex3 });  //First:UserId  Second:OrganizeId
        });
        if (keyValue) {
            $.submitForm({
                url: "/SystemManage/SysRole/SubmitRoleUser?roleId=" + keyValue,
                param: { userList: arr },
                success: function () {
                    $("#gridList").trigger("reloadGrid");
                }
            });
        }
    }

</script>


@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "phát thuốc nội trú thống kê";
    Layout = "~/Views/Shared/_Index.cshtml";
    var reportUrl = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("ReportUrl");
}
<style>
    #btn_print {
        background-color: #fff;
        color: #00a9ea;
        font-weight: bolder;
    }
</style>
<form id="form1">
    <div class="panel panel-default">
        <div class="panel-heading">tìm kiếm</div>
        <div>
            <table class="form">
                <tr>
                    <th class="formTitle ">ngày thống kê:</th>
                    <td class="formValue">
                        <input id="startTime" type="text" class="form-control input-wdatepicker " value="@DateTime.Now.ToString("yyyy-MM-dd 00:00:00")" on onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                    </td>
                    <th class="formTitle">đến: </th>
                    <td class="formValue">
                        <input id="endTime" type="text" class="form-control input-wdatepicker " value="@DateTime.Now.AddHours(1).ToString("yyyy-MM-dd HH:mm:ss")" on onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                    </td>
                    <th class="formTitle">khu bệnh: </th>
                    <td class="formValue formDdlSelectorTd">
                        <select id="bqmc" class="form-control">
                            <option value="">tất cả</option>
                        </select>
                    </td>
                    <th class="formTitle">thuốc định vị: </th>
                    <td class="formValue">
                        <input id="keyword" type="text" class="form-control" />
                        <input id="ypcode" type="hidden" />
                    </td>
                    <td class="formTitle">
                        <input type="button" id="btn_search" class="btn btn-primary" value="tra cứu" style="margin-left:10px;" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="ui-layout" id="dv_layout" style="width: 100%; height: 100%;">
        <iframe class="ui-layout-center" style="width:100%; height: 100%;" id="if_data" name="if_data" scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
    </div>
</form>
<script>
    //khởi tạo mã nhập
    function InitSrm() {
        //mã thuốc
        $("#keyword").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 200,
            width: 1130,
            url: '/Medicine/SelectLossAndProfitMedicineList',
            ajaxmethod: 'Get',
            ajaxreqdata: function () {
                var reqData = {};
                reqData.inputCode = $("#keyword").val();
                return reqData;
            },
            caption: "thông tin thuốc",
            colModel: [
                { label: 'loại', name: 'yplb', width: 50 },
                { label: 'tên', name: 'ypmc', width: 200, align: 'left' },
                { label: 'tồn kho', name: 'xykcstr', width: 70, align: 'right' },
                { label: 'quy cách', name: 'ypgg', width: 150, align: 'center' },
                { label: 'hạn sử dụng', name: 'yxq', width: 80 },
                { label: 'số lô', name: 'ph', width: 110, align: 'center' },
                { label: 'lô', name: 'pc', width: 140, align: 'center' },
                { label: 'nhà sản xuất', name: 'sccj', width: 220, align: 'center' },
                { label: 'trạng thái', name: 'ypzt', width: 50 },
                { label: 'giá nhập', name: 'jj', hidden: true },
                { label: 'giá bán lẻ', name: 'lsj', hidden: true },
                { label: 'giá bán buôn', name: 'pfj', hidden: true },
                { label: 'giá bán lẻ kho thuốc', name: 'Yklsj', hidden: true },
                { label: 'giá bán buôn kho thuốc', name: 'Ykpfj', hidden: true },
                { label: 'mã', name: 'ypCode', hidden: true },
                { label: 'hệ số chuyển đổi', name: 'zhyz', hidden: true },
                { label: 'kcsl', name: 'kcsl', hidden: true },
                { label: 'zxdw', name: 'zxdw', hidden: true },
                { label: 'đơn vị', name: 'djdw', hidden: true }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#ypcode").val($thistr.attr('data-ypCode'));
                $("#keyword").val($thistr.attr('data-ypmc'));
                return;
            }
        });

        $("#bqmc").bindSelect({ //tập hợp thông tin khu bệnh
            url: "/HospitalizationPharmacy/GetBQSelectJson",
            id: "bqCode",
            text: "bqmc"
        });
    }

    $(function () {
        InitSrm();

        $('#if_data').css('height', $(window).height() - 85);
        //tra cứu
        $("#btn_search").click(function () {

            if ($("#keyword").val() == "") {
                $("#ypcode").val("");
            }
            var orgId='@ViewBag.OrganizeId';
            var url = '@reportUrl' + "?tempCode=67&systemCode=PDS" + "&orgId=" + orgId + "&yfbmCode=" + '@Constants.CurrentYfbm.yfbmCode'
                + "&kssj=" + $('#startTime').val() + "&jssj=" + $('#endTime').val() + "&bqCode=" + $("#bqmc").val() + "&searchCondition=" + $("#ypcode").val();
            @*var url =
                "../../Report/PrintReport?type=zyfytj&param=orgId=@ViewBag.OrganizeId|yfbmCode=@Constants.CurrentYfbm.yfbmCode" +
                    "|kssj=" +
                    $('#startTime').val() +
                    "|jssj=" +
                    $('#endTime').val() +
                    "|bqCode=" +
                    $("#bqmc").val() +
                    "|searchCondition=" +
                    $("#ypcode").val();*@
            $("#if_data").attr('src', url);
        });
        $("#btn_search").trigger("click");
    });

</script>
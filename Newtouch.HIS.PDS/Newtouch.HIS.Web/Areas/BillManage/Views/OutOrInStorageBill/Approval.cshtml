@using Newtouch.Tools;
@using Newtouch.Infrastructure;
@using Newtouch.HIS.Web.Core.Extensions;
@{
    ViewBag.Title = "chứng từ nhập/xuất kho duyệt";
    Layout = "~/Views/Shared/_Index.cshtml";

    var djlxItemStrs = Constants.CurrentYfbm.yfbmjb != "1" ?
        new[] {
(int) EnumDanJuLX.zhijiefayao,
(int) EnumDanJuLX.shenlingfayao,
(int) EnumDanJuLX.neibufayaotuihui,
(int) EnumDanJuLX.keshifayao
            }
            : new[] {
(int) EnumDanJuLX.yaopinruku,
(int) EnumDanJuLX.waibucuku,
(int) EnumDanJuLX.neibufayaotuihui,
(int) EnumDanJuLX.keshifayao
            };
}
<script src="~/Content/js/bootstrap-multiselect.js"></script>
<link href="~/Content/js/bootstrap-multiselect.css" rel="stylesheet" />
<style>
    #btn_search {
        height: 45px;
        width: 45px;
        background-color: #fff;
        color: #00a9ea;
        font-weight: bolder;
    }

    .showbotton {
        display: none;
        position: fixed;
        bottom: 5px;
        right: 0;
        z-index: 9999;
        background-color: #ccc;
        width: 50px;
        height: 44px;
        filter: alpha(Opacity=90);
        -moz-opacity: 0.9;
        opacity: 0.9;
        cursor: pointer;
        border-radius: 100px 0 0 100px;
    }

    #TabGrid {
        width: 100%;
        position: fixed;
        bottom: 50px;
        right: 0;
        z-index: 8888;
        background-color: #253443;
        filter: alpha(Opacity=92);
        -moz-opacity: 0.92;
        opacity: 0.92;
        box-shadow: 0px 2px 10px #909090;
    }

        #TabGrid > * {
            filter: alpha(Opacity=92);
            -moz-opacity: 0.92;
            opacity: 0.92;
        }

    input[name=fph] {
        padding: 2px;
    }
</style>
<form id="form1">
    <div class="panel panel-default" id="dv_search">
        <div class="panel-heading">điều kiện tra cứu</div>
        <div>
            <table class="form">
                <tr>
                    <th class="formTitle">trạng thái duyệt: </th>
                    <td class="formValue">
                        @Html.DropDownList("ddlSHZT", EnumDjShzt.WaitingApprove.ToDescSelectList(), "tất cả", new { @class = "form-control" })
                    </td>
                    <th class="formTitle">ngày: </th>
                    <td class="formValue">
                        <input id="txtStartDate" type="text" class="form-control input-wdatepicker " value="@DateTime.Now.ToString("yyyy-MM-01 00:00:00")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                    </td>
                    <th class="formTitle">đến: </th>
                    <td class="formValue">
                        <input id="txtEndDate" type="text" class="form-control input-wdatepicker " value="@DateTime.Now.AddHours(1).ToString("yyyy-MM-dd 23:59:59")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                    </td>
                    <th class="formTitle">số hóa đơn: </th>
                    <td class="formValue">
                        <input id="txtFPH" type="text" class="form-control " />
                    </td>
                    <td class="formTitle" rowspan="2">
                        <input type="button" id="btn_search" class="btn btn-md btn-primary" value="tra cứu" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">số chứng từ: </th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="txtPDH" />
                    </td>
                    <th class="formTitle">loại chứng từ: </th>
                    <td class="formValue">
                        @Html.DropDownList("ddlDJLX", EnumDanJuLX.yaopinruku.ToSomeDescSelectList(String.Join(",", djlxItemStrs)), "tất cả", new { @class = "form-control" })
                    </td>
                    <th class="formTitle">nhà cung cấp: </th>
                    <td class="formValue">
                        <select id="selgys" name="selgys" class="form-control" multiple="multiple"></select>
                    </td>
                    <th class="formTitle">tổng tiền giá nhập: </th>
                    <td class="formValue">
                        <input type="text" id="jjze" name="jjze" class="form-control newtouch_Readonly" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel">
        <table id="gridDJMainRecords"></table>
        <div id="gridPager" rel="form1"></div>
    </div>
</form>
<div id="TabGrid">
    <ul class="nav nav-tabs navb-bg" role="tablist" id="myTab">
        <li role="presentation" class="active">
            <a href="#dv_djmx" id="linkSearch" role="tab" data-toggle="tab">chi tiết chứng từ</a>
        </li>
        <li style="float:right">
            <span class="hiding glyphicon glyphicon-chevron-right btn-lg"></span>
        </li>
    </ul>
    <div id="dv_djmx" style="">
        <table id="gridDJMXInfo"></table>
    </div>
</div>
<div class="showbotton">
    <span class="glyphicon glyphicon-chevron-left btn-lg"></span>
</div>
@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 3, 6, 7, 8 },
    F3Text = "duyệt",
    F6Text = "hàng loạt duyệt",
    F7Text = "không đạt",
    F8Text = "thu hồi duyệt"
})
<script>
    $(function () {
        //tải lại khi thay đổi kích thước cửa sổ trình duyệt jqGrid chiều rộng
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });
        $('#ddlSHZT').val('0');
        //điều khiển ẩn/hiện hộp tìm kiếm
        $(".hiding,.rows,#dv_search,.toolbar").click(function () {
            TabGridHide();
        });
        $(".showbotton").click(function () {
            $(".showbotton").animate({ width: 'hide' }, "fast", function () {
                $("#TabGrid").animate({ left: '0px' }, "slow");
            });
        });
        TabGridHide();
        gridDJMainRecords();
        BindGys();
    });

    //gắn nhà cung cấp
    function BindGys() {
        $.najax({
            type: "Get",
            url: "/Medicine/MedicineSupplierList?keyword=",
            dataType: "json",
            success: function (ajaxresp) {
                if (ajaxresp !== null) {
                    $("#selgys").html("");
                    for (var i = 0; i < ajaxresp.length; i++) {
                        $("#selgys").append("<option value='" + ajaxresp[i].gysCode + "'>" + ajaxresp[i].gysmc + "</option>");
                    }
                    $('#selgys').multiselect({
                        buttonWidth: '100%',
                        includeSelectAllOption: true,
                        enableClickableOptGroups: true,
                        enableCollapsibleOptGroups: true,
                        selectAllText: "chọn tất cả",
                        nonSelectedText: "chưa chọn",
                        allSelectedText: "chọn tất cả"
                    });
                }
            }
        });
    }

    //ẩn hộp tìm kiếm và hiển thị mũi tên
    function TabGridHide() {
        var tabGridwith = $("#TabGrid").width() + 200;
        if ($(".showbotton").is(":hidden")) {
            $("#TabGrid").animate({ left: tabGridwith }, "slow", function () {
                $(".showbotton").animate({ width: 'show' }, "fast");
            });
        }
    }

    //bản ghi chính của chứng từ
    function gridDJMainRecords() {
        var $gridDjMainRecords = $("#gridDJMainRecords");
        $gridDjMainRecords.dataGrid({
            height: $(window).height() - 230,
            postData: getSearchPostData(),
            url: "/PharmacyDrugStorage/SelectReceiptMainInfoV2?from=approval",
            colModel: [
                {
                    label: 'trạng thái duyệt', name: 'shzt', width: 55, align: 'left', formatter: function (val) {
                        switch (val) {
                        case '@((int)EnumDjShzt.WaitingApprove)':
                            return "@EnumDjShzt.WaitingApprove.GetDescription()";
                        case '@((int)EnumDjShzt.Approved)':
                            return "@EnumDjShzt.Approved.GetDescription()";
                        case '@((int)EnumDjShzt.Cancelled)':
                            return "@EnumDjShzt.Cancelled.GetDescription()";
                        case '@((int)EnumDjShzt.Rejected)':
                            return "@EnumDjShzt.Rejected.GetDescription()";
                        default:
                            return "";
                        }
                    }
                },
                {
                    label: 'loại chứng từ', name: 'djlx', width: 80, align: 'left', formatter: function (val) {
                        switch (val) {
                        case @((int)EnumDanJuLX.zhijiefayao):
                            return "@EnumDanJuLX.zhijiefayao.GetDescription()";
                        case @((int)EnumDanJuLX.keshifayao):
                            return "@EnumDanJuLX.keshifayao.GetDescription()";
                        case @((int)EnumDanJuLX.neibufayaotuihui):
                            return "@EnumDanJuLX.neibufayaotuihui.GetDescription()";
                        case @((int)EnumDanJuLX.shenlingfayao):
                            return "@EnumDanJuLX.shenlingfayao.GetDescription()";
                        case @((int)EnumDanJuLX.waibucuku):
                            return "@EnumDanJuLX.waibucuku.GetDescription()";
                        case @((int)EnumDanJuLX.yaopinruku):
                            return "@EnumDanJuLX.yaopinruku.GetDescription()";
                        default:
                            return "";
                        }
                    }
                },
                { label: 'số chứng từ', name: 'pdh', width: 130, align: 'center' },
                { label: 'xuất kho kho', name: 'ckbmmc', width: 100, align: 'left' },
                { label: 'nhà cung cấp', name: 'gysmc', width: 100, align: 'left' },
                { label: 'nhập kho kho', name: 'rkbmmc', width: 100, align: 'left' },
                { label: 'phương thức nhập/xuất kho', name: 'crkfsmc', width: 70, align: 'left' },
                { label: 'tổng tiền bán buôn', name: 'pjze', width: 80, align: 'right', formatter: function (val) { return val.toFixed(2); }, hidden: true },
                { label: 'tổng tiền bán lẻ', name: 'ljze', width: 80, align: 'right', formatter: function (val) { return val.toFixed(2); }, hidden: true },
                { label: 'tổng tiền giá nhập', name: 'zje', width: 80, align: 'right', formatter: function (val) { return val.toFixed(2); } },
                { label: 'chênh lệch giá mua bán', name: 'jxcj', width: 70, align: 'right', formatter: function (val) { return val.toFixed(2); }, hidden: true},
                { label: 'gửi thời gian', name: 'czsj', width: 100, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:s', newformat: 'Y-m-d H:s' } },
                { label: 'thời gian nhập kho', name: 'Rksj', width: 100, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:s', newformat: 'Y-m-d H:s' } },
                { label: 'thời gian xuất kho', name: 'Cksj', width: 100, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:s', newformat: 'Y-m-d H:s' } },
                { label: 'crkId', name: 'crkId', hidden: true },
                { label: 'djlx', name: 'djlx', hidden: true, align: 'left' },
                { label: 'jjzje', name: 'jjzje', hidden: true, align: 'left' }
            ],
            unwritten: false,
            multiselect: false,
            pager: "#gridPager",
            sortname: 'czsj desc',
            viewrecords: true,
            gridComplete: function() {
                ComputeJJze();
            },
            ondblClickRow: function (rowid, iRow, iCol, e) {
                btn_selectrow(rowid);
            }
        });

        $("#btn_search").click(function () {
            $('#gridDJMXInfo').jqGrid("clearGridData");
            $gridDjMainRecords.jqGrid('setGridParam', {
                postData: getSearchPostData(),
                url: "/PharmacyDrugStorage/SelectReceiptMainInfoV2?from=approval"
            }).trigger('reloadGrid');
        });
    }

    //tập hợp điều kiện tra cứu
    function getSearchPostData() {
        var shzt = $("#ddlSHZT").val();
        var qsrj = $("#txtStartDate").val();
        var jsrj = $("#txtEndDate").val();
        var pdh = $("#txtPDH").val();
        var djlx = $("#ddlDJLX").val();
        var fph = $("#txtFPH").val();
        var gys = $("#selgys").val();
        return { qsrj: qsrj, jsrj: jsrj, pdh: pdh, djlx: djlx, shzt: shzt, gys: gys, fph: fph};
    };

    //sự kiện nhấp chuột
    function btn_selectrow(rowId) {
        $('#gridDJMXInfo').jqGrid("clearGridData");//mỗi lần nhấp, trước tiên xóa chi tiết sau đó tải lại chi tiết của tất cả các dòng đã chọn
        $.najax({
            type: "Get",
            url: "/BillManage/OutOrInStorageBill/QueryOutOrInStorageBillDetail",
            data: { crkId: $("#gridDJMainRecords").jqGrid('getRowData', rowId).crkId, djlx: $("#gridDJMainRecords").jqGrid('getRowData', rowId).djlx },
            dataType: "json",
            success: function (ajaxresp) {
                if (ajaxresp !== null) {
                    $('#gridDJMXInfo').newtouchLocalDataGrid(null, ajaxresp);
                }
                $(".showbotton").click().trigger("click");
            }
        });
    }

    //chi tiết chứng từ
    $('#gridDJMXInfo').newtouchLocalDataGrid({
        height: $(window).height() - 240,
        unwritten: false,
        sortable: false,
        colModel: [
            { label: 'số thứ tự chi tiết nhập/xuất kho', name: 'crkmxId', hidden: true, width: 100, align: 'left' },
            {
                label: 'số hóa đơn', name: 'fph', width: 90, align: 'center',
                formatter: function (cellvalue, options) { return cellvalue === "" || cellvalue === null ? "<input type=\"text\" name=\"fph\" rowid=" + options.rowId + " role=\"textbox\" class=\"editable inline-edit-cell form-control\" style=\"width: 90%; height: 99%;\" onblur=\"UpdateFph(this)\">" : cellvalue; }
            },
            { label: 'loại thuốc', name: 'yplbmc', width: 60, align: 'left' },
            { label: 'tên thuốc', name: 'ypmc', width: 110, align: 'left' },
            { label: 'số lượng', name: 'slanddw', width: 60, align: 'right' },
            { label: 'quy cách', name: 'gg', width: 80, align: 'left' },
            { label: 'mã truy xuất', name: 'zsm', width: 60, align: 'right' },
            { label: 'có tách lẻ không', name: 'sfcl', width: 60, align: 'right' },
            { label: 'số lô', name: 'ph', width: 90, align: 'center' },
            { label: 'lô', name: 'pc', width: 100, align: 'center' },
            { label: 'hạn sử dụng', name: 'yxq', width: 70, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
            { label: 'giá nhập đơn giá', name: 'jjdwdj', width: 90, align: 'right' },
            { label: 'tổng tiền bán buôn', name: 'pjze', width: 70, align: 'right', formatter: function (val) { return val.toFixed(2); } },
            { label: 'tổng tiền bán lẻ', name: 'ljze', width: 70, align: 'right', formatter: function (val) { return val.toFixed(2); } },
            { label: 'tổng tiền giá nhập', name: 'zje', width: 70, align: 'right', formatter: function (val) { return val.toFixed(2); } },
            { label: 'chênh lệch giá mua bán', name: 'jxcj', width: 60, align: 'right', formatter: function (val) { return val.toFixed(2); } },
            { label: 'nhà sản xuất', name: 'sccj', width: 150, align: 'left' },
            { label: 'lý do trả hàng', name: 'thyy', width: 80, align: 'left' },
            { label: 'giá nhập đơn giá', name: 'jj', hidden: true }
        ]
    });

    //tính tổng tiền giá nhập
    function ComputeJJze() {
        var t = 0;
        var count = $("#gridDJMainRecords").getGridParam('records');
        if (count > 0) {
            var rowIds = $("#gridDJMainRecords").getDataIDs();
            t = $("#gridDJMainRecords").getRowData(rowIds[0]).jjzje;
            $("#jjze").val(t);
        } else {
            $("#jjze").val('');
        }
    }

    //duyệt
    function newtouch_event_f3() {
        submitReceiptApproval('@((int)EnumDjShzt.Approved)');
    }

    //hàng loạt duyệt
    function newtouch_event_f6() {
        var ids = $("#gridDJMainRecords").jqGrid('getDataIDs'); //lấy tất cả các dòng Id, duyệt để hộp chỉnh sửa ở trạng thái đã lưu
        if (ids == null || ids.length === 0) {
            $.modalMsg('vui lòng tra cứu cần duyệt của đơn chứng', 'warning', 2000);
            return false;
        }
        var shdj = [];
        for (var i = 0; i < ids.length; i++) {
            var selRowData = $("#gridDJMainRecords").jqGrid('getRowData', ids[i]);
            if (selRowData.crkId && selRowData.djlx) {
                var item = {
                    crkId: selRowData.crkId,
                    djlx: selRowData.djlx,
                    shzt: '@((int)EnumDjShzt.Approved)'
                };
                shdj.push(item);
            }
        }
        if (shdj.length === 0) {
            $.modalMsg('không tìm thấy chứng từ đáp ứng yêu cầu duyệt', 'warning', 2000);
            return false;
        }

        $.modalConfirm("xác định hàng loạt duyệt không?duyệt hàng loạt chỉ áp dụng cho chứng từ của trang đang hiển thị!",
            function(flag) {
                if (!flag) return false;
                $.najax({
                    url: "/OutOrInStorageBill/SubmitReceiptApprovalBatch",
                    data: { param: shdj },
                    type: 'POST',
                    dataType: 'json',
                    success: function (ajaxresp) {
                        if (ajaxresp.state === 'success') {
                            $.modalMsg("thao tác thành công", 'success', 1500);
                        }
                        else {
                            $.modalMsg("thao tác thất bại", 'error', 1500);
                            $.newtouchAlert(ajaxresp);
                        }
                        return;
                    },
                    complete: function () {
                        $("#btn_search").trigger('click');
                    }
                });
            });
    }

    //chưa đạt
    function newtouch_event_f7() {
        submitReceiptApproval('@((int)EnumDjShzt.Rejected)');
    }

    //hủy bỏ
    function newtouch_event_f8() {
        submitReceiptApproval('@((int)EnumDjShzt.Cancelled)');
    }

    //cập nhật đơn chứng trạng thái duyệt, gửi đến máy chủ
    function submitReceiptApproval(dstnShzt) {
        var selRowData = $("#gridDJMainRecords").jqGridRowValue();
        if (!selRowData || !selRowData.crkId || !selRowData.djlx) {
            $.modalAlert('vui lòng chọn một dòng đơn chứng', 'error');
            return;
        }
        if (selRowData.crkId && selRowData.djlx) {
            $.najax({
                url: "/OutOrInStorageBill/SubmitReceiptApproval",
                data: { crkId: selRowData.crkId, djlx: selRowData.djlx, shzt: dstnShzt },
                type: 'POST',
                dataType: 'json',
                success: function (ajaxresp) {
                    if (ajaxresp.state === 'success') {
                        $.modalMsg("thao tác thành công", 'success', 1500);
                    }
                    else {
                        $.modalMsg("thao tác thất bại", 'error', 1500);
                        $.newtouchAlert(ajaxresp);
                    }
                    return;
                },
                complete: function () {
                    $("#btn_search").trigger('click');
                }
            });
        }
    }


    //bổ sung số hóa đơn
    function UpdateFph(obj) {
        var fph = $(obj).val();
        var crkmxId = $("#gridDJMXInfo").getRowData($(obj).attr("rowid")).crkmxId;
        if (fph !== "") {
            $.modalConfirm("bạn có chắc muốn đổi số hóa đơn thành" + fph + "không?",
                function(flag) {
                    if (flag) {
                        $.najax({
                            url: "/PharmacyDrugStorage/UpdateFph",
                            type: "POST",
                            data: { crkmxId: crkmxId, fph: fph },
                            dataType: "json",
                            success: function(data) {
                                if (data.state === 'success') {
                                    $.modalMsg("đổi số hóa đơn thành công", "success", 1000);
                                } else {
                                    $.newtouchAlert(data);
                                }
                            }
                        });
                    }
                });

        }
    }
</script>
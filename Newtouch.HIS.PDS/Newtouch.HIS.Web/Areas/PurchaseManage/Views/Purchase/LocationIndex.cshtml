
@using Newtouch.Infrastructure
@{
    ViewBag.Title = "điểm phân phối";
    Layout = "~/Views/Shared/_Index.cshtml";

}


<form id="form1">
    <div id="dv-detail">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>

    <div class="panel panel-default">
        <input type="button" id="btn_delete" class="btn btn-info" style="width:7%;display:inline-block;float:right;margin-left:20px;margin-top:30px;" value="hủy bỏ" />
        <input type="button" id="btn_submit" class="btn btn-info" style="width:7%;display:inline-block;float:right;margin-left:20px;margin-top:30px;" value="gửi báo cáo" />
        <input type="button" id="btn_edit" class="btn btn-info" style="width:7%;display:inline-block;float:right;margin-left:20px;margin-top:30px;" value="sửa" />
        <input type="button" id="btn_add" class="btn btn-info" style="width:7%;display:inline-block;float:right;margin-left:20px;margin-top:30px;" value="tạo mới" />
        <input type="button" id="btn_search" class="btn btn-info" style="width:7%;float:right;margin-left:20px;margin-top:30px;" value="làm mới" />
    </div>

</form>

<script type="text/javascript">

    $(function () {
        gridList();
    });

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/PurchaseManage/Purchase/GetLocationGridJson",
            height: $(window).height() - 150,
            colModel: [
                { label: 'Id', name: 'Id', width: 140, align: 'left',hidden:true },
                { label: 'mã điểm phân phối', name: 'psdbm', width: 140, align: 'left' },
                { label: 'điểm phân phối tên', name: 'psdmc', width: 140, align: 'left' },
                { label: 'phân phối địa chỉ', name: 'psdz', width: 140, align: 'left' },
                { label: 'liên hệ người họ tên', name: 'lxrxm', width: 80, align: 'left' },
                { label: 'liên hệ điện thoại', name: 'lxdh', width: 80, align: 'left' },
                { label: 'mã bưu chính', name: 'yzbm', width: 80, align: 'left' },
                { label: 'ghi chú thông tin', name: 'bzxx', width: 80, align: 'left' },
                {
                    label: 'điểm phân phối trạng thái', name: 'psdzt', width: 120, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 1) return 'đã lưu';
                        else if (cellvalue == 2) return 'đã gửi báo cáo';
                        else if (cellvalue == 3) return 'đã hủy';
                        else return '';
                    }
                },
                { label: 'thời gian tạo', name: 'CreateTime', width: 80, align: 'left', hidden: true},
                { label: 'người tạo', name: 'CreateCode', width: 80, align: 'left',hidden:true },
            ],
            multiselect: true,
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                //btn_selectrow(rowid);
            },
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: { },
            }).trigger('reloadGrid');
        });
    }



    //tạo mới
    $('#btn_add').click(function () {
        $.modalOpen({
            id: "Form",
            title: "điểm phân phối",
            url: "/PurchaseManage/Purchase/LocationForm",
            width: "25%",
            height: "55%",
            callBack: function (iframeId) {
                top.frames[iframeId].SubmitForm();
                //$.modalClose("Form");
                $('#btn_search').trigger('click');
            }
        });
    });

    //sửa
    $('#btn_edit').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');

        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("vui lòng chọn cần sửa của điểm phân phối", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("chỉ có thể chọn một cái điểm phân phối tiến hành sửa", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        if (rowData.psdzt != "已保存") {
            $.modalAlert("chọn trong của điểm phân phối không có đã lưu trạng thái, không thể sửa", 'warning');
            return;
        }
        $.modalOpen({
            id: "Form",
            title: "điểm phân phối",
            url: "/PurchaseManage/Purchase/LocationForm?keyValue=" + rowData.Id,
            width: "25%",
            height: "55%",
            callBack: function (iframeId) {
                top.frames[iframeId].SubmitForm();
                //$.modalClose("Form");
                $('#btn_search').trigger('click');
            }
        });
    });

    //gửi
    $('#btn_submit').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("vui lòng chọn cần gửi báo cáo của điểm phân phối", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("chỉ có thể chọn một cái điểm phân phối tiến hành gửi báo cáo", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        $.najax({
            type: "POST",
            url: "/PurchaseManage/Purchase/LocationUpload",
            data: { Id: rowData.Id, psdzt: 2, czlx: "1" }, //psdzt 1 đã lưu 2 đã gửi báo cáo 3 đã hủy //loại thao tác: 1 thêm mới 3 hủy bỏ
            dataType: "json",
            success: function (res) {
                if (res.state == "success") {
                    $.modalMsg("điểm phân phối gửi báo cáo thành công!", 'success');
                    $('#btn_search').trigger('click');
                } else {
                    $.modalMsg("điểm phân phối gửi báo cáo thất bại: " + res.message, 'warning');
                }
            }
        });
    });

    //hủy bỏ
    $('#btn_delete').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("vui lòng chọn cần hủy bỏ của điểm phân phối", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("chỉ có thể chọn một cái điểm phân phối tiến hành hủy bỏ", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        if (rowData.psdzt == "已作废" ) {
            $.modalAlert("nên điểm phân phối đã hủy", 'warning');
            return;
        }
        $.najax({
            type: "POST",
            url: "/PurchaseManage/Purchase/LocationDelete",
            data: { Id: rowData.Id, psdzt: 3,czlx:"3" }, //psdzt 1 đã lưu 2 đã gửi báo cáo 3 đã hủy //loại thao tác: 1 thêm mới 3 hủy bỏ
            dataType: "json",
            success: function (res) {
                if (res.state == "success") {
                    $.modalMsg("điểm phân phối hủy bỏ thành công!", 'success');
                    $('#btn_search').trigger('click');
                } else {
                    $.modalMsg("điểm phân phối hủy bỏ thất bại: " + res.message, 'warning');
                }
            }
        });
    });


</script>



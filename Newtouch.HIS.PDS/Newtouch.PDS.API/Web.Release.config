<?xml version="1.0" encoding="utf-8"?>

<!-- Liên quan đến việc sử dụng Web.config Để biết thông tin chi tiết về chuyển đổi, vui lòng truy cập https://go.microsoft.com/fwlink/?LinkId=301874 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Trong ví dụ dưới đây，“SetAttributes”Chuyển đổi sẽ thay đổi
    “connectionString”Giá trị, chỉ khi“Match”Bộ định vị tìm thấy giá trị“MyDB”của
    đặc tính“name”Dùng khi“ReleaseSQLServer”。

    <connectionStrings>
      <add name="MyDB"
        connectionString="Data Source=ReleaseSQLServer;Initial Catalog=MyReleaseDB;Integrated Security=True"
        xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
    </connectionStrings>
  -->
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <!--
      Trong ví dụ sau đây，"Replace" Chuyển đổi sẽ thay thế Web.config Của tệp
      toàn bộ <customErrors> mục.
      Xin lưu ý, vì tại <system.web> Dưới nút chỉ có một
       customErrors mục, vì vậy không cần dùng "xdt:Locator" Thuộc tính。

      <customErrors defaultRedirect="GenericError.htm"
        mode="RemoteOnly" xdt:Transform="Replace">
        <error statusCode="500" redirect="InternalError.htm"/>
      </customErrors>
    -->
  </system.web>
</configuration>

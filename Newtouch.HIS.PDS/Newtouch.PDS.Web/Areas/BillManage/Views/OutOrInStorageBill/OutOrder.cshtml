	//Tạo số chứng từ
	function GetDjh() {
		$.ajax({
			url: "/StorageManage/DrugStockSearch/GetCrkDjh",
			data: { crkId: crkId },
			dataType: "json",
			async: false,
			cache: false,
			success: function (res) {
				if (res != null) {
					$("#djh").val(res.djh);
					$("#gysCode").val(res.gyscode);
					$("#gysmc").val(res.gysmc);
				}
				else {
					$.modalAlert(res.message, 'error');
				}
			}
		});
	}



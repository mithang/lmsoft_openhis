@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "Bảng phân tích giá thuốc";
    Layout = "~/Views/Shared/_Index.cshtml";
    //Liên kết báo cáo
    var reportUrl = SysConfigReader.OrgReportLink();
    var reportUrlNew = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("ReportUrl");
}

<form id="form1">
    <div class="panel panel-default">
        <div class="panel-heading">Tìm kiếm</div>
        <div>
            <table class="form">
                <tr>
                    <th class="formTitle ">Ngày thống kê:</th>
                    <td class="formValue">
                        <input id="kssj" type="text" class="form-control input-wdatepicker " value="@DateTime.Now.ToString("yyyy-MM-dd 00:00:00")" on onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                    </td>
                    <th class="formTitle">Đến：</th>
                    <td class="formValue">
                        <input id="jssj" type="text" class="form-control input-wdatepicker " value="@DateTime.Now.AddHours(1).ToString("yyyy-MM-dd HH:mm:ss")" on onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                    </td>
                    <th class="formTitle">Định vị thuốc：</th>
                    <td class="formValue">
                        <input id="keyword" type="text" class="form-control" />
                        <input id="ypcode" type="hidden" />
                    </td>
                    <td class="formTitle">
                        <input type="button" id="btn_search" class="btn btn-primary" value="Tra cứu" style="margin-left:10px;"  />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="ui-layout" id="layout" style="height:100%;width:100%;">
        <iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
                scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
    </div>
</form>


<script>

    $(function () {

        //Mã thuốc
        $("#keyword").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 200,
            width: 1130,
            url: '/Medicine/SelectLossAndProfitMedicineList',
            ajaxmethod: 'Get',
            ajaxreqdata: function () {
                var reqData = {};
                reqData.inputCode = $("#keyword").val();
                return reqData;
            },
            caption: "Thông tin thuốc",
            colModel: [
                { label: 'Loại', name: 'yplb', width: 50 },
                { label: 'Tên', name: 'ypmc', width: 200, align: 'left' },
                { label: 'Tồn kho', name: 'xykcstr', width: 70, align: 'right' },
                { label: 'Quy cách', name: 'ypgg', width: 150, align: 'center' },
                { label: 'Hạn sử dụng', name: 'yxq', width: 80 },
                { label: 'Số lô', name: 'ph', width: 110, align: 'center' },
                { label: 'Lô', name: 'pc', width: 140, align: 'center' },
                { label: 'Nhà sản xuất', name: 'sccj', width: 220, align: 'center' },
                { label: 'Trạng thái', name: 'ypzt', width: 50 },
                { label: 'Giá nhập', name: 'jj', hidden: true },
                { label: 'Giá bán lẻ', name: 'lsj', hidden: true },
                { label: 'Giá bán buôn', name: 'pfj', hidden: true },
                { label: 'Giá lẻ kho thuốc', name: 'Yklsj', hidden: true },
                { label: 'Giá bán buôn kho thuốc', name: 'Ykpfj', hidden: true },
                { label: 'Mã', name: 'ypCode', hidden: true },
                { label: 'Hệ số chuyển đổi', name: 'zhyz', hidden: true },
                { label: 'kcsl', name: 'kcsl', hidden: true },
                { label: 'zxdw', name: 'zxdw', hidden: true },
                { label: 'Đơn vị', name: 'djdw', hidden: true }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#ypcode").val($thistr.attr('data-ypCode'));
                $("#keyword").val($thistr.attr('data-ypmc'));
                return;
            }
        });


    });

    $("#btn_search").click(function () {
        debugger
        if ($('#kssj').val() > $('#jssj').val()) {
            $.modalAlert("Thời gian bắt đầu không được lớn hơn thời gian kết thúc", "error");
            return;
        }
        var orgId = '@ViewBag.OrgId';
        var url = '@reportUrlNew' + "?tempCode=52&systemCode=PDS" + "&hospitalCode=" + orgId;
        //var url = getUrl();
        url += "&orgId=" + orgId + "&kssj=" + $('#kssj').val() + "&jssj=" + $('#jssj').val() + "&ypcode=" + $("#ypcode").val();


        setTimeout("$.loading(true, 'Đang yêu cầu trang báo cáo...');", 10);
        $("#iframerightiframerightiframerightttt").attr('src', url);
    });

    @*function submit() {
        debugger
        if ($('#kssj').val() > $('#jssj').val()) {
            $.modalAlert("Thời gian bắt đầu không được lớn hơn thời gian kết thúc", "error");
            return;
        }
        var orgId = '@ViewBag.OrgId';

        var url = getUrl();
        url += "&orgId=" + orgId + "&kssj=" + $('#kssj').val() + "&jssj=" + $('#jssj').val() + "&ypcode=" + $("#ypcode").val();
        setTimeout("$.loading(true, 'Đang yêu cầu trang báo cáo...');", 10);
        $("#iframerightiframerightiframerightttt").attr('src', url);
    }*@
    $("#iframerightiframerightiframerightttt").load(function () {
        $.loading(false);
    });
    $(function () {
        var h = $(window).height() - 55
        $('#layout iframe').css('height', h);
    });

    //Làm mới danh sách
    function refReport() {
        $("#btn_search").trigger('click');
    }

    function getUrl() {
        debugger
        var reportServerHOST = '@(ViewBag.ReportServerHOST)';
        reportServerHOST += "/Pages/ReportViewer.aspx?%2fNewtouch.HIS.Bill%2fYPDrugComparison";
        //Lấy kiểu tùy chỉnh
        if (true) {
            if (reportServerHOST.indexOf('&rc:Stylesheet') == -1) {
                reportServerHOST += "&rc:Stylesheet=MyStyleSheet";
            }
        }

        return reportServerHOST;
    }

</script>




@{
    ViewBag.Title = "Xuất kho trực tiếp-Tra cứu hóa đơn";
    Layout = "~/Views/Shared/_Form.cshtml";
    var from = (ViewBag.from as string) ?? "";
}
<style>
    .table-responsive {
        border: 0;
    }

    .ui-jqgrid .ui-jqgrid-pager .ui-pager-table {
        width: 90%;
    }
</style>

<div class="topPanel" style="border-bottom:1px solid rgb(221, 221, 221);margin-bottom: 1%;">
    <div class="search">
        <table class="form">
            <tr>
                <th class="formTitle">Số hóa đơn:</th>
                <td class="formValue">
                    <input id="fph" name="fph" type="text" class="form-control form-an" placeholder="Vui lòng nhập số hóa đơn" />
                </td>
                <th class="formTitle">Thời gian nhập kho:</th>
                <td class="formValue" colspan="3">
                    <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; margin-top:10px;float:left;" value="@DateTime.Now.ToString("yyyy-MM-01 00:00:00")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy HH:mm:ss' })" />
                    <span style="margin-left:1%;float:left">—</span>
                    <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:43%; margin-top:10px;float:left;margin-left:1%;" value="@DateTime.Now.ToString("dd/MM/yyyy 23:59:59")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy HH:mm:ss' })" />
                </td>
                <td style="padding-left: 20px;">
                    <button type="button" id="btn_search" class="btn btn-primary btn-md">&nbsp;Tra cứu&nbsp;</button>
                </td>
            </tr>
        </table>
    </div>
</div>
<form id="formPatSer">
    <div class="gridPanel">
        <table id="GridList" rel="formPatSer"></table>
        <div id="gridPager" style="padding-right:2%"></div>
    </div>
</form>

<script>
    //Cái trướcwindowĐối tượng
    var prevWindow = $.currentWindow();

    $(function () {
        gridList();
    });

    function gridList() {
        var $gridList = $("#GridList");
        $gridList.dataGrid({
            url: "/OutOrInStoredManage/DeliveryDirect/GetRkFphData",
            height: $(window).height()-150,
            postData: { kssj: $("#kssj").val(), jssj: $("#jssj").val(), fph: $("#fph").val(), djlx: 1},
            colModel: [
                { label: 'Số chứng từ', name: 'Pdh', width: 120, align: 'left' },
                { label: 'pc', name: 'pc', width: 100, align: 'left', hidden: true },
                { label: 'Rkbm', name: 'Rkbm', width: 100, align: 'left', hidden:true },
                { label: 'Khoa nhập kho', name: 'Rkmc', width: 80, align: 'left' },
                {
                    label: 'Thời gian nhập kho', name: 'Rksj', width: 120, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:m:s', newformat: 'Y-m-d H:m:s' }
                },
                { label: 'Số hóa đơn', name: 'Fph', width: 120, align: 'left' },
                { label: 'Ckbm', name: 'Ckbm', width: 100, align: 'left', hidden: true },
                { label: 'Nhà cung cấp', name: 'Ckmc', width: 100, align: 'left' },
                { label: 'Tổng số tiền hóa đơn', name: 'Zje', width: 80, align: 'left' },
            ],
            multiselect: false,
            pager: "#gridPager",
            sortname: 'CreateTime',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                SearchConfirm();
            }
        });

        $("#btn_search").click(function () {
            $("#GridList").jqGrid('setGridParam', {
                postData: {
                    kssj: $("#kssj").val(), jssj: $("#jssj").val(), fph: $("#fph").val(), djlx: "1"
                },
                page: 1,
                url: "/OutOrInStoredManage/DeliveryDirect/GetRkFphData",
            }).trigger('reloadGrid');
        });
    }

    //jqGrid Nhấp đúp để chọn một dòng
    function btn_edit() {
        SearchConfirm();
    }

    function BillDbGrid() {
        var obj = new Object();
        obj.pc = $("#GridList").jqGridRowValue().pc;
        obj.fph = $("#GridList").jqGridRowValue().Fph;
        prevWindow.GetQueryAjax(obj);
        //Đóng cửa sổ
        ReceiptCancle();
    }
    //Xác định Gọi từ trang chính
    function SearchConfirm() {
        BillDbGrid();
    }

    //Hủy
    function ReceiptCancle() {
        $.modalClose();
    }
</script>



                // label: 'Trạng thái hóa đơn', name: 'fpzt', width: 100, align: 'left', formatter: function (cellvalue) {
                // if (cellvalue == 0) return 'Chưa nhập kho';
                // else if (cellvalue == 1) return 'Đã nhập kho';
                // else return '';
                // }
                //},
            ],

            multiselect: false,

            pager: "#gridPager",
            sortname: 'CreateTime',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                SearchConfirm();
            }
        });
    }

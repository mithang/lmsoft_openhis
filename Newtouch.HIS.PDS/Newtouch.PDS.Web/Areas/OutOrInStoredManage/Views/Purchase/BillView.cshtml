
@{
    ViewBag.Title = "Tra cứu hóa đơn";
    Layout = "~/Views/Shared/_Form.cshtml";
    var from = (ViewBag.from as string) ?? "";
}
<style>
    .table-responsive {
        border: 0;
    }

    .ui-jqgrid .ui-jqgrid-pager .ui-pager-table {
        width: 90%;
    }
</style>

<div class="topPanel" style="border-bottom:1px solid rgb(221, 221, 221);margin-bottom: 1%;">
    <div class="search">
        <table class="form">
            <tr>

                <th class="formTitle">Số hóa đơn:</th>
                <td class="formValue">
                    <input id="txt_fph" name="txt_fph" type="text" class="form-control form-an" placeholder="Vui lòng nhập số hóa đơn" />
                </td>
                <th class="formTitle">Thời gian đơn hàng:</th>
                <td class="formValue" colspan="3">
                    <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; margin-top:10px;float:left;" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                    <span style="margin-left:1%;float:left">—</span>
                    <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:43%; margin-top:10px;float:left;margin-left:1%;" value="@DateTime.Now.ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                </td>
                @*<th class="formTitle">Trạng thái nhập kho:</th>
                <td class="formValue formDdlSelectorTd">
                    <select id="fpzt" name="fpzt" class="form-control required">
                        <option value="9" selected="selected">Tất cả</option>
                        <option value="0">Chưa nhập kho</option>
                        <option value="1">Đã nhập kho</option>
                    </select>
                </td>*@
                <td style="padding-left: 20px;">
                    <button type="button" id="btn_search" class="btn btn-primary btn-md">&nbsp;Tra cứu&nbsp;</button>
                </td>
            </tr>
        </table>
    </div>
</div>

<form id="formPatSer" style="margin:2px;margin-top:10px;">
    <div class="gridPanel">
        <table id="GridList" rel="formPatSer"></table>
        <div id="gridPager" style="padding-right:20%"></div>
    </div>
</form>

<script>
    //Cái trướcwindowĐối tượng
    var prevWindow;
    if ('@(from)' !== '') {
        prevWindow = top.top.frames['@(from)'];
    }
    else {
        prevWindow = $.currentWindow();
    }

    $(function () {

        var obj = new Object;
        //obj.ddbh = $.request("ddbh");
        var searInfo = new gridList();
        //Tải dữ liệu
        //searInfo.init(obj);

        //Truy vấn
        $("#btn_search").click(function () {
            $("#GridList").jqGrid('setGridParam', {
                postData: {
                    kssj: $("#kssj").val(), jssj: $("#jssj").val(), fph: $("#fph").val(),fpzt:"9"
                },
                page: 1,
                url: "/OutOrInStoredManage/Purchase/GetBillStoreGridJson",
            }).trigger('reloadGrid');
        });
    });

    function gridList() {
        var $gridList = $("#GridList");
        $gridList.dataGrid({
            url: "/OutOrInStoredManage/Purchase/GetBillStoreGridJson",
            height: $(window).height() - 200,
            postData: { kssj: $("#kssj").val(), jssj: $("#jssj").val(), fph: $("#fph").val(), fpzt: "9"},
            colModel: [

                { label: 'Id', name: 'Id', hidden: true },
                { label: 'Số hóa đơn', name: 'fph', width: 100, align: 'left' },
                { label: 'Mã công ty dược', name: 'yqbm', width: 100, align: 'left' },
                { label: 'Tổng số tiền hóa đơn bao gồm thuế', name: 'fphszje', width: 100, align: 'left' },

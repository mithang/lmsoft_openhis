
@using Newtouch.Infrastructure;
@using Newtouch.HIS.Web.Core.Extensions;
@{
    ViewBag.Title = "Nền tảng công khai - Quản lý mua hàng";
    Layout = "~/Views/Shared/_Index.cshtml";
}


<!DOCTYPE html>
<style>
    .showbotton {
        display: none;
        position: fixed;
        bottom: 5px;
        right: 0;
        z-index: 9999;
        background-color: #ccc;
        width: 50px;
        height: 44px;
        filter: alpha(Opacity=90);
        -moz-opacity: 0.9;
        opacity: 0.9;
        cursor: pointer;
        border-radius: 100px 0 0 100px;
    }

    #TabGrid {
        width: 100%;
        position: fixed;
        bottom: 10px;
        right: 0;
        z-index: 8888;
        background-color: #253443;
        filter: alpha(Opacity=92);
        -moz-opacity: 0.92;
        opacity: 0.92;
        box-shadow: 0px 2px 10px #909090;
    }

        #TabGrid > * {
            filter: alpha(Opacity=92);
            -moz-opacity: 0.92;
            opacity: 0.92;
        }
</style>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>PrepareMedicineApply</title>
</head>
<body>

    <form>
        <div class="panel panel-default">
            <table class="form">
                <tr>
                    
                    <th class="formTitle">Thời gian đơn hàng：</th>
                    <td class="formValue" colspan="3">
                        <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; float:left;" value="@DateTime.Now.AddMonths(-6).ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        <span style="margin-left:1%;float:left">—</span>
                        <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:43%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    </td>
                    <td class="formValue title">
                        <input type="button" id="btn_search" class="btn btn-primary" style="width:36%;margin-left: 10%;" value="Tra cứu" />
                    </td>

                </tr>

            </table>
        </div>
        <div class="gridPanel">
            <table id="gridList"></table>
            <div id="gridPager"></div>
        </div>
        <div id="TabGrid">
            <ul class="nav nav-tabs navb-bg" role="tablist" id="myTab">
                <li role="presentation" class="active">
                    <a href="#dv_djmx" id="linkSearch" role="tab" data-toggle="tab">Chi tiết chứng từ</a>
                </li>
                <li style="float:right">
                    <span class="hiding glyphicon glyphicon-chevron-right btn-lg"></span>
                </li>
            </ul>
            <div id="dv_djmx" style="">
                <table id="gridDJMXInfo"></table>
            </div>
        </div>
        <div class="showbotton">
            <span class="glyphicon glyphicon-chevron-left btn-lg"></span>
        </div>
        <div class="panel panel-default">
            <input type="button" id="btn_delete" class="btn btn-info" style="width:7%;display:inline-block;float:right;margin-left:20px;margin-top:30px;" value="Hủy bỏ" />
            <input type="button" id="btn_receive" class="btn btn-info" style="width:7%;display:inline-block;float:right;margin-left:20px;margin-top:30px;" value="Nghiệm thu" />
            <input type="button" id="btn_submit" class="btn btn-info" style="width:7%;display:inline-block;float:right;margin-left:20px;margin-top:30px;" value="Gửi báo cáo" />
            <input type="button" id="btn_edit" class="btn btn-info" style="width:7%;display:inline-block;float:right;margin-left:20px;margin-top:30px;" value="Sửa" />
            <input type="button" id="btn_add" class="btn btn-info" style="width:7%;display:inline-block;float:right;margin-left:20px;margin-top:30px;" value="Tạo mới" />
            <input type="button" id="btn_test" class="btn btn-info" style="width:7%;display:none;float:right;margin-left:20px;margin-top:30px;" value="Kiểm tra trả hàng" />
            <input type="button" id="btn_writeTest" class="btn btn-info" style="width:7%;display:none;float:right;margin-left:20px;margin-top:30px;" value="Kiểm tra điền báo" />
            <input type="button" id="btn_sureTest" class="btn btn-info" style="width:7%;display:none;float:right;margin-left:20px;margin-top:30px;" value="Xác nhận kiểm tra" />

        </div>
    </form>
</body>
</html>


<script>

    var reportServerHOST = '@(ViewBag.ReportServerHOST)';
    var orgId = '@(ViewBag.OrgId)';
    $(function () {
        initControl();
        gridList();
        //Điều khiển ẩn/hiện hộp tìm kiếm
        $(".hiding,.rows,#dv_search,.toolbar").click(function () {
            TabGridHide();
        });
        $(".showbotton").click(function () {
            $(".showbotton").animate({ width: 'hide' }, "fast", function () {
                $("#TabGrid").animate({ left: '0px' }, "slow");
            });
        });
        TabGridHide();
    })

    //Ẩn hộp tìm kiếm và hiển thị mũi tên
    function TabGridHide() {
        var tabGridwith = $("#TabGrid").width() + 200;
        if ($(".showbotton").is(":hidden")) {
            $("#TabGrid").animate({ left: tabGridwith }, "slow", function () {
                $(".showbotton").animate({ width: 'show' }, "fast");
            });
        }
    }

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/OutOrInStoredManage/Purchase/GetPurchaseGridJson",
            height: $(window).height() - 200,
            postData: {  kssj: $("#kssj").val(), jssj: $("#jssj").val() ,ddzt:0},
            colModel: [
                
                { label: 'cgId', name: 'cgId', hidden: true },
                { label: 'Thời gian đơn hàng', name: 'ddsj', width: 120, align: 'left' },
                {
                    label: 'Điểm phân phối', name: 'psdbm', width: 120, align: 'left', formatter: function (cellvalue) {
                        return "上海明德五官科医院";
                    }
                },
                {
                    label: 'Loại đơn hàng', name: 'ddlx', width: 120, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 1) return 'Đơn hàng tự đặt của bệnh viện';
                        else if (cellvalue == 2) return 'Đơn hàng kho thuốc ủy thác';
                        else if (cellvalue == 3) return 'Đơn hàng thuốc đặc biệt';
                        else return '';
                    }
                },
                { label: 'Số đơn hàng', name: 'ddbh', width: 120, align: 'left' },
                { label: 'Số kế hoạch của bệnh viện', name: 'yyjhdh', width: 120, align: 'left' },
                { label: 'Ngày giao hàng muộn nhất', name: 'zwdhrq', width: 120, align: 'left' },
                {
                    label: 'Trạng thái đơn hàng', name: 'ddzt', width: 120, align: 'left', formatter: function (cellvalue) {
                        //if (cellvalue == 1) return 'Lưu';
                        //else if (cellvalue == 3) return 'Gửi';
                        //else if (cellvalue == 5) return 'Thu hồi';
                        //else if (cellvalue == 7) return 'Hủy bỏ';

                        if (cellvalue == 1) return 'Đã lưu';
                        else if (cellvalue == 2) return 'Đã gửi báo cáo';
                        else if (cellvalue == 3) return 'Đã nghiệm thu';
                        else return '';
                    }
                },
                { label: 'Số bản ghi chi tiết', name: 'jls', width: 120, align: 'left' },
                //{
                //    label: "Thao tác", name: "", align: "center", width: 150,
                //    formatter: function (cellvalue, options, rowobject) {
                //        return '<input type="button" id="btn_rpt" onclick="rptdjmx(\'' + rowobject.Id + '\')" class="btn btn-info" style="width:100px;display:inline-block;"  value="Phiếu inchi tiết chứng từ"/>'
                //    }
                //},
                { label: 'yfbm', name: 'yfbm', hidden: true },
                { label: 'bqbm', name: 'bqbm', hidden: true },

            ],

            multiselect: true,

            pager: "#gridPager",
            sortname: 'CreateTime',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                btn_selectrow(rowid);
            }
        });
        $("#btn_search").click(function () {
            $('#gridDJMXInfo').jqGrid("clearGridData");
            $gridList.jqGrid('setGridParam', {
                postData: {  kssj: $("#kssj").val(), jssj: $("#jssj").val() },
            }).trigger('reloadGrid');
        });
    }

    function rptdjmx(byid) {
        window.open(reportServerHOST + "/ReportServer/Pages/ReportViewer.aspx?%2fNewtouch.Report.1%2f科室备药退回单&rs:Command=Render&rc:Stylesheet=MyStyleSheetBlankPage&byId=" + byid + "&orgId=" + orgId, "_blank", "height=500, width=1195,top=100, left=50, toolbar =no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no");
    }

    //Sự kiện Enter
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    //Sự kiện nhấp chuột
    function btn_selectrow(rowId) {
        $('#gridDJMXInfo').jqGrid("clearGridData");//Mỗi lần nhấp，Xóa chi tiết trước Sau đó tải lại chi tiết của tất cả các dòng đã chọn
        $.najax({
            type: "Get",
            url: "/OutOrInStoredManage/Purchase/QueryPurchaseDetailbyId",
            data: { cgId: $("#gridList").jqGrid('getRowData', rowId).cgId },
            dataType: "json",
            success: function (ajaxresp) {
                if (ajaxresp !== null) {
                    $('#gridDJMXInfo').newtouchLocalDataGrid(null, ajaxresp);
                }
                $(".showbotton").click().trigger("click");
            }
        });
    }
    //Chi tiết chứng từ
    $('#gridDJMXInfo').newtouchLocalDataGrid({
        height: $(window).height() - 200,
        unwritten: false,
        sortable: false,
        colModel: [
            { label: 'Số thứ tự', name: 'sxh', width: 60, align: 'left' },
            { label: 'Tên thuốc', name: 'ypmc', width: 180, align: 'left' },
            { label: 'Mã thuốc', name: 'ypCode', width: 60, align: 'right' },
            { label: 'Mã thống nhất hàng hóa', name: 'zxspbm', width: 150, align: 'right' },
            { label: 'Đơn giá mua', name: 'cgdj', width: 60, align: 'right' },
            { label: 'Số lượng mua', name: 'cgsl', width: 60, align: 'right' },
            { label: 'Đơn vị', name: 'dw', width: 80, align: 'left' },
            { label: 'Quy cách BHYT', name: 'ggbz', width: 90, align: 'center' },
            { label: 'Loại mua hàng', name: 'cglxmc', width: 90, align: 'right' },
            { label: 'Loại hàng hóa', name: 'splxmc', width: 60, align: 'right' },
            { label: 'Đơn vị đo mua', name: 'cgjldwmc', width: 100, align: 'right' },
            { label: 'Phân phối nhiều lần', name: 'dcpsbsmc', width: 60, align: 'right' },
            { label: 'Ghi chú giải thích', name: 'bzsm', width: 60, align: 'right' },
            //{ label: 'Hạn dùng', name: 'yxq', width: 70, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
        ]
    });

    function initControl() {

    }

    //Tạo mới
    $('#btn_add').click(function () {
        $.modalOpen({
            id: "Form",
            title: "Mua thuốc",
            url: "/OutOrInStoredManage/Purchase/Form",
            width: "95%",
            height: "95%",
            callBack: function (iframeId) {

                $.currentWindow(iframeId).AcceptClick(function () {
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                    $.modalClose("Form");
                    //$('#btn_search').trigger('click');
                });
            }
        });
    });

    //Sửa
    $('#btn_edit').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');

        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn chứng từ cần sửa", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("Chỉ được chọn một chứng từ để sửa", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        if (rowData.ddzt != "已保存") {
            $.modalAlert("Chứng từ đã chọn không phải trạng thái đã lưu，Không thể sửa", 'warning');
            return;
        }
        $.modalOpen({
            id: "Form",
            title: "Mua thuốc",
            url: "/OutOrInStoredManage/Purchase/Form?keyValue=" + rowData.cgId,
            width: "95%",
            height: "95%",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                    $.modalClose("Form");
                    //$('#btn_search').trigger('click');
                });
            }
        });
    });

    //Gửi
    $('#btn_submit').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn chứng từ cần gửi", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("Chỉ được chọn một chứng từ để gửi", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        //if (rowData.thzt != "Lưu") {
        //    $.modalAlert("Chứng từ đã chọn không ở trạng thái đã lưu，Không thể gửi", 'warning');
        //    return;
        //}
        //var postData = rowData;
        //var postData = {
        //    Id: rowData.Id,
        //    OrganizeId: orgId,
        //    djh: rowData.djh,
        //    thzt: "2",
        //    yfbm: rowData.yfbm,
        //    ksbm: rowData.ksbm,
        //    bqbm: rowData.bqbm,
        //    thyy: rowData.thyy,
        //    zt: "1",
        //    CreatorCode: rowData.CreatorCode,
        //    CreateTime: rowData.CreateTime

        //}
        $.najax({
            type: "POST",
            url: "/OutOrInStoredManage/Purchase/PurchaseUpload",
            data: { cgId: rowData.cgId, ddzt: 2 },
            dataType: "json",
            success: function (res) {
                if (res.state == "success") {
                    $.modalMsg("Gửi chứng từ thành công！", 'success');
                    //$('#gridDJMXInfo').jqGrid("clearGridData");

                    $('#btn_search').trigger('click');
                } else {
                    $.modalMsg("Gửi chứng từ thất bại：" + res.message, 'warning');
                }
            }
        });
    });

    //Nghiệm thu
    $('#btn_receive').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn chứng từ cần nghiệm thu", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("Chỉ được chọn một chứng từ để nghiệm thu", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        if (rowData.ddzt != "已传报") {
            $.modalAlert("Chứng từ đã chọn không phải trạng thái đã báo cáo，không thể nghiệm thu", 'warning');
            return;
        }
        $.najax({
            type: "POST",
            url: "/OutOrInStoredManage/Purchase/PurchaseStateUpdate",
            data: { cgId: rowData.cgId ,ddzt:3},
            dataType: "json",
            success: function (res) {
                if (res.state == "success") {
                    $('#btn_search').trigger('click');
                    $.modalAlert("Chứng từ nghiệm thu thành công！", 'success');
                } else {
                    $.modalAlert("Chứng từ nghiệm thu thất bại：" + res.message, 'warning');
                }
            }
        });
    });

    //Hủy bỏ
    $('#btn_delete').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn chứng từ cần hủy bỏ", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("Chỉ được chọn một chứng từ để hủy bỏ", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        if (rowData.ddzt != "已保存") {
            $.modalAlert("Vui lòng chọn chứng từ đã lưu để hủy bỏ", 'warning');
            return;
        }
        $.najax({
            type: "POST",
            url: "/OutOrInStoredManage/Purchase/PurchaseDelete",
            data: { cgId: rowData.cgId },
            dataType: "json",
            success: function (res) {
                if (res) {
                    $('#btn_search').trigger('click');
                    $.modalMsg(res.message, 'success');
                }
            }
        });
    });

    //Kiểm tra trả hàng
    $('#btn_test').click(function () {
        $.najax({
            type: "POST",
            url: "/Purchase/PurchaseReturnUpload",
            data: { thId: '', ddzt: 4 },
            dataType: "json",
            success: function (res) {
                if (res.state == "success") {
                    $('#btn_search').trigger('click');
                    $.modalAlert("Chứng từ trả hàng thành công！", 'success');
                } else {
                    $.modalAlert("Chứng từ trả hàng thất bại：" + res.message, 'warning');
                }
            }
        });
    });

    //Kiểm tra điền báo
    $('#btn_writeTest').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn chứng từ cần gửi", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("Chỉ được chọn một chứng từ để gửi", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        $.najax({
            type: "POST",
            url: "/OutOrInStoredManage/Purchase/PurchaseUploadWriteTest",
            data: { cgId: rowData.cgId, ddzt: 2 },
            dataType: "json",
            success: function (res) {
                if (res.state == "success") {
                    $.modalMsg("Gửi chứng từ thành công！", 'success');
                    //$('#gridDJMXInfo').jqGrid("clearGridData");

                    $('#btn_search').trigger('click');
                } else {
                    $.modalMsg("Gửi chứng từ thất bại：" + res.message, 'warning');
                }
            }
        });
    });
    //Xác nhận kiểm tra
    $('#btn_sureTest').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn chứng từ cần gửi", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("Chỉ được chọn một chứng từ để gửi", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        $.najax({
            type: "POST",
            url: "/OutOrInStoredManage/Purchase/PurchaseUploadSureTest",
            data: { cgId: rowData.cgId, ddzt: 2 },
            dataType: "json",
            success: function (res) {
                if (res.state == "success") {
                    $.modalMsg("Gửi chứng từ thành công！", 'success');
                    //$('#gridDJMXInfo').jqGrid("clearGridData");

                    $('#btn_search').trigger('click');
                } else {
                    $.modalMsg("Gửi chứng từ thất bại：" + res.message, 'warning');
                }
            }
        });
    });


</script>

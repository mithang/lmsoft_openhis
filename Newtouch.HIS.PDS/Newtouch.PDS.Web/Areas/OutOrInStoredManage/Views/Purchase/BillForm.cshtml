
@using Newtouch.Infrastructure.Enum
@{
    ViewBag.Title = "Nghiệm thu hóa đơn";
    Layout = "~/Views/Shared/_Form.cshtml";

}

<form id="form1">
    <div class="container" style="padding:0;">
        <div class="tab-content" style="margin-top:10px;padding-right:10px;">
            <div role="tabpanel" class="tab-pane fade in active">
                <table class="form">
                    <tr>
                        <th class="formTitle">Tổng số tiền hóa đơn bao gồm thuế：</th>
                        <td class="formValue" style="width:70px;padding-right:50px;">
                            <input id="FPHSZJE" name="FPHSZJE" type="text" class="form-control" placeholder="" />
                        </td>
                    </tr>

                </table>
            </div>
        </div>
    </div>
</form>


<script lang="javascript">
    var FPH = $.request("FPH");
    var YQBM = $.request("YQBM");
    var FPHSZJE = $.request("FPHSZJE");
    $("#FPHSZJE").val(FPHSZJE);



    //Lưu
    function SubmitForm() {
        if (!DataValidate()) {
            return;
        }
        var postData = $("#form1").formSerialize();
        postData.FPH = FPH;
        postData.YQBM = YQBM;
        postData.FPHSZJE = $("#FPHSZJE").val();

        $.submitForm({
            url: "/OutOrInStoredManage/Purchase/BillAccept",
            param: postData,
            success: function () {
                $.modalMsg('Nghiệm thu thành công', 'success');
                $.modalClose();
                callback();
            }
        });
    }

    //Kiểm tra dữ liệu
    function DataValidate() {
        if ($("#FPHSZJE").val() === "") {
            $.modalAlert("Tổng số tiền hóa đơn bao gồm thuế là bắt buộc", 'warning');
            return false;
        }
        return true;
    }


</script>
<form id="form1">
    <div class="panel panel-default" style="margin-bottom:10px;">
        <div class="panel-heading">Thông tin hóa đơn</div>
        <table class="form">
            <tr>
                <th class="formTitle "><span class="required">*</span>Công ty dược：</th>
                <td class="formValue">
                    <input type="text" id="yq" name="yq" class="form-control" placeholder="Vui lòng chọn công ty dược" autocomplete="off" style="width:60%"/>
                    <input type="hidden" id="yqbm" />
                </td>

                <th class="formTitle">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary" value="Lấy chi tiết" />
                    <input type="button" id="btn_accept" class="btn btn-md btn-primary" value="Nghiệm thu chi tiết" />
                </th>
                <td></td>
            </tr>
        </table>
    </div>
    <div id="dv-detail">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>

<script type="text/javascript">

    $(function () {
        InitFloat();

        //gridList();
    });


    //初始化浮层
    function InitFloat() {

        //药企
        $("#yq").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 200,
            width: 400,
            url: "/Medicine/MedicineSupplierList",
            ajaxmethod: 'Get',
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = $.trim($("#yq").val());
                return reqData;
            },
            colModel: [
                { label: 'Mã công ty dược', name: 'gysCode', widthratio: 30 },
                { label: 'Công ty dược', name: 'gysmc', widthratio: 70 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#yqbm").val($thistr.attr('data-gysCode'));
                $("#yq").val($thistr.attr('data-gysmc'));
                return;
            }
        });


    }

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/OutOrInStoredManage/Purchase/GetBillGridJson",
            height: $(window).height() - 200,
            postData: { yqbm: $("#yqbm").val(), fpmxbh: '1' },
            colModel: [
            
                { label: 'Số hóa đơn', name: 'FPH', width: 80, align: 'left' ,key:true,},
                { label: 'Ngày hóa đơn', name: 'FPRQ', width: 80, align: 'left' },
                { label: 'Tổng số tiền hóa đơn bao gồm thuế', name: 'FPHSZJE', width: 100, align: 'left' },
                { label: 'Mã công ty dược', name: 'YQBM', width: 80, align: 'left' },
                { label: 'Mã bệnh viện', name: 'YYBM', width: 100, align: 'left' },
                { label: 'Mã điểm phân phối', name: 'PSDBM', width: 100, align: 'left' },
                { label: 'Cờ mua theo lượng', name: 'DLSGBZ', width: 80, align: 'left' },
                { label: 'Ghi chú hóa đơn', name: 'FPBZ', width: 60, align: 'left' },
                {
                    label: 'Có phải không có hóa đơn phân phối không', name: 'SFWPSFP', width: 90, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 0) return 'Không';
                        else if (cellvalue == 1) return 'Có';
                    }
                },
                { label: 'Ghi chú không có hóa đơn phân phối', name: 'WPSFPSM', width: 80, align: 'left' },
                { label: 'Số chi tiết hóa đơn', name: 'FPMXBH', width: 140, align: 'left' },
                {
                    label: 'Loại hàng hóa', name: 'SPLX', width: 60, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 1) return 'Loại thuốc';
                        else if (cellvalue == 2) return 'Loại vật tư y tế';
                        else if (cellvalue == 3) return 'Loại thiết bị y tế';
                        else if (cellvalue == 9) 'Khác';
                    }
                },
                {
                    label: 'Có đảo đỏ không', name: 'SFCH', width: 60, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 0) return 'Không';
                        else if (cellvalue == 1) return 'Có';
                    }
                },
                { label: 'Mã thống nhất hàng hóa', name: 'ZXSPBM', width: 120, align: 'left' },
                { label: 'Số lô sản xuất', name: 'SCPH', width: 60, align: 'left' },
                { label: 'Ngày sản xuất', name: 'SCRQ', width: 60, align: 'left' },
                { label: 'Số lượng hàng hóa', name: 'SPSL', width: 60, align: 'left' },
                { label: 'Số chi tiết liên quan', name: 'GLMXBH', width: 120, align: 'left' },
                { label: 'Số đơn hàng bán', name: 'XSDDH', width: 120, align: 'left' },
                { label: 'Số thứ tự', name: 'SXH', width: 60, align: 'left' },
                { label: 'Ngày hiệu lực', name: 'YXRQ', width: 60, align: 'left' },
                { label: 'Đơn giá chưa thuế', name: 'WSDJ', width: 60, align: 'left' },
                { label: 'Đơn giá bao gồm thuế', name: 'HSDJ', width: 60, align: 'left' },
                { label: 'Thuế suất', name: 'SL', width: 60, align: 'left' },
                { label: 'Số tiền thuế', name: 'SE', width: 60, align: 'left' },
                { label: 'Số tiền bao gồm thuế', name: 'HSJE', width: 60, align: 'left' },
                { label: 'Giá bán buôn', name: 'PFJ', width: 60, align: 'left' },
                { label: 'Giá bán lẻ', name: 'LSJ', width: 60, align: 'left' },
                { label: 'Số văn bản phê duyệt thuốc', name: 'PZWH', width: 120, align: 'left' },

            ],

            multiselect: false,

            pager: "#gridPager",
            sortname: 'FPH',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                //btn_selectrow(rowid);
            }
        });
        $("#btn_search").click(function () {
            $('#gridDJMXInfo').jqGrid("clearGridData");
            $gridList.jqGrid('setGridParam', {
                postData: { kssj: $("#kssj").val(), jssj: $("#jssj").val() },
            }).trigger('reloadGrid');
        });
    }

    //获取明细
    $('#btn_search').click(function () {
        if ($("#yq").val() == "" || $("#yq").val() == null) {
            $.modalAlert("Vui lòng chọn công ty dược", 'warning');
            return ;
        }
        gridList();
    });


    //Nghiệm thu chi tiết
    $('#btn_accept').click(function () {
        var rowData = $("#gridList").jqGridRowValue();
        if (rowData == null || rowData.length==0) {
            $.modalAlert("Vui lòng chọn chứng từ cần nghiệm thu", 'warning');
            return;
        }
        //var psmxbh = rowData.PSMXBH;
        //var hctbdm = rowData.HCTBDM;
        //var scph = rowData.SCPH;
        //var pssl = rowData.PSSL
        $.modalOpen({
            id: "Form",
            title: "Nghiệm thu hóa đơn",
            url: "/OutOrInStoredManage/Purchase/BillForm?FPH=" + rowData.FPH + "&YQBM=" + rowData.YQBM + "&FPHSZJE=" + rowData.FPHSZJE,
            width: "350px",
            height: "150px",
            callBack: function (iframeId) {
                //Nghiệm thu
                top.frames[iframeId].SubmitForm();
                //发票明细落地
                $.najax({
                    type: "POST",
                    url: "/OutOrInStoredManage/Purchase/BillDetailInsert",
                    data: { entity: rowData },
                    dataType: "json",
                    success: function (res) {
                        if (res.state == "success") {
                            $.modalMsg("Hóa đơn cập nhật thành công！", 'success');
                            //$('#gridDJMXInfo').jqGrid("clearGridData");

                            $('#btn_search').trigger('click');
                        } else {
                            $.modalMsg("Hóa đơn cập nhật thất bại：" + res.message, 'warning');
                        }
                    }
                });
            }
        });
    });




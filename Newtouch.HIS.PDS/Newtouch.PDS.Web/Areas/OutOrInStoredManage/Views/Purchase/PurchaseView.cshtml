
@{
    ViewBag.Title = "Tra cứu đơn mua hàng";
    Layout = "~/Views/Shared/_Form.cshtml";
    var from = (ViewBag.from as string) ?? "";
}
<style>
    .table-responsive {
        border: 0;
    }

    .ui-jqgrid .ui-jqgrid-pager .ui-pager-table {
        width: 90%;
    }
</style>

<div class="topPanel" style="border-bottom:1px solid rgb(221, 221, 221);margin-bottom: 1%;">
    <div class="search">
        <table class="form">
            <tr>
                <th class="formTitle">Thời gian đơn hàng:</th>
                <td class="formValue" colspan="2">
                    <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; margin-top:10px;float:left;" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                    <span style="margin-left:1%;float:left">—</span>
                    <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:43%; margin-top:10px;float:left;margin-left:1%;" value="@DateTime.Now.ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                </td>
                <th class="formTitle">Số đơn hàng:</th>
                <td class="formValue">
                    <input id="yyjhdh" name="yyjhdh" type="text" class="form-control form-an" placeholder="Vui lòng nhập số đơn hàng" />
                </td>
                <th class="formTitle">Số hóa đơn:</th>
                <td class="formValue">
                    <input id="ddbh" name="ddbh" type="text" class="form-control form-an" placeholder="Vui lòng nhập số hóa đơn" />
                </td>

                <td style="padding-left: 5px;">
                    <button type="button" id="btn_search" class="btn btn-primary btn-md">&nbsp;Tra cứu&nbsp;</button>
                </td>
            </tr>
        </table>
    </div>
</div>
<!--Thông tin bệnh nhân Gồm số hồ sơ bệnh án Họ tên -->
<form id="formPatSer" style="margin:2px;margin-top:10px;">
    <div class="gridPanel">
        <table id="GridList" rel="formPatSer"></table>
        <div id="gridPager" style="padding-right:20%"></div>
    </div>
</form>

<script>
    //Cái trướcwindowĐối tượng
    var prevWindow;
    if ('@(from)' !== '') {
        prevWindow = top.top.frames['@(from)'];
    }
    else {
        prevWindow = $.currentWindow();
    }

    $(function () {
        gridList();
        //Truy vấn
        $("#btn_search").click(function () {
            $("#GridList").jqGrid('setGridParam', {
                postData: {
                    kssj: $("#kssj").val(), jssj: $("#jssj").val(), ddzt: 2, yyjhdh: $("#yyjhdh").val(), gysCode: "", ddbh: $("#ddbh").val()
                },
                page: 1,
                url: "/OutOrInStoredManage/Purchase/GetPurchaseGridJson",
            }).trigger('reloadGrid');
        });
    });

    function gridList() {
        var $gridList = $("#GridList");
        $gridList.dataGrid({
            url: "/OutOrInStoredManage/Purchase/GetPurchaseGridJson",
            height: $(window).height() - 130,
            postData: { kssj: $("#kssj").val(), jssj: $("#jssj").val(), ddzt: 2, yyjhdh: $("#yyjhdh").val(), gysCode: "", ddbh: $("#ddbh").val(),ddyy:"1" },//ddyy:Dấu hiệu tham Số khi trích dẫn nhập kho thuốc
            colModel: [

                { label: 'cgId', name: 'cgId', hidden: true },
                { label: 'Thời gian đơn hàng', name: 'ddsj', width: 110, align: 'left' },
                {
                    label: 'Điểm phân phối', name: 'psdbm', width: 120,hidden: true , align: 'left', formatter: function (cellvalue) {
                        return "";
                    }
                },
                {
                    label: 'Loại đơn hàng', name: 'ddlx', width: 80, align: 'center', formatter: function (cellvalue) {
                        if (cellvalue == 1) return 'Mua thường xuyên';
                        else if (cellvalue == 2) return 'Mua khẩn cấp';
                        else return '';
                    }
                },

                { label: 'Số đơn mua hàng', name: 'yyjhdh', width: 120, align: 'center' },
                { label: 'Ngày giao hàng muộn nhất', name: 'zwdhrq', hidden: true ,width: 60, align: 'left' },
                {
                    label: 'Trạng thái đơn hàng', name: 'ddzt', width: 60, align: 'left', hidden: true, formatter: function (cellvalue) {
                        if (cellvalue == 1) return 'Chờ duyệt';
                        else if (cellvalue == 2) return 'Đã duyệt';
                        else if (cellvalue == 3) return 'Đã hủy';
                        else return '';
                    }
                },
                { label: 'Số bản ghi chi tiết', name: 'jls', width: 80, align: 'center' },
                { label: 'Số tiền chứng từ', name: 'zje', width: 80, align: 'center' },
                { label: 'fph', name: 'fph', width: 80, align: 'center',hidden:true},
                 {
                     label: 'Số hóa đơn', name: 'ddbh', width: 100, align: 'center',
                     formatter: function (cellvalue, options) { return cellvalue === "" || cellvalue === null ? "<input type=\"text\" name=\"fph\" rowid=" + options.rowId + " role=\"textbox\" class=\"editable inline-edit-cell form-control\" style=\"width: 100%; height: 99%;\" onblur=\"UpdateFph(this)\">" : cellvalue; }
                 },
                { label: 'Nhà cung cấp', name: 'gysName', width: 200, align: 'left' },
                { label: 'yfbm', name: 'yfbm', hidden: true },
                { label: 'bqbm', name: 'bqbm', hidden: true },

            ],
            multiselect: false,
            pager: "#gridPager",
            sortname: 'ddsj desc',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                SearchConfirm();
            }
        });
    }

    //jqGrid Nhấp đúp để chọn một dòng
    function btn_edit() {
        SearchConfirm();
    }

    function PurchaseDbGrid() {
        var $gridList = $("#GridList");
        var cgId = $gridList.jqGridRowValue().cgId;
        var obj = new Object();
        obj.cgId = cgId;
        obj.ddsj = $gridList.jqGridRowValue().ddsj;
        obj.czlx = $gridList.jqGridRowValue().czlx;
        obj.yybm = $gridList.jqGridRowValue().yybm;
        obj.psdbm = $gridList.jqGridRowValue().psdbm;
        obj.ddlx = $gridList.jqGridRowValue().ddlx;
        obj.ddbh = $gridList.jqGridRowValue().fph;
        obj.yyjhdh = $gridList.jqGridRowValue().yyjhdh;
        obj.zwdhrq = $gridList.jqGridRowValue().zwdhrq;
        obj.jls = $gridList.jqGridRowValue().jls;
        obj.ddzt = $gridList.jqGridRowValue().ddzt;
        if (obj.ddbh != "") {
            prevWindow.GetQueryAjax(obj);
            //Đóng cửa sổ
            ReceiptCancle();
        } else {
            $.modalMsg("Số hóa đơn trống,vui lòng bổ sung số hóa đơn!", "success", 1000);
        }

    }
    //Xác định Gọi từ trang chính
    function SearchConfirm() {
        PurchaseDbGrid();
    }

    //Hủy
    function ReceiptCancle() {
        $.modalClose();
    }
    //Bổ sung số hóa đơn
    function UpdateFph(obj) {
        var fph = $(obj).val();
        var cgId = $("#GridList").getRowData($(obj).attr("rowid")).cgId;
        var rowid = $(obj).attr("rowid");
        $("#GridList").jqGrid('setCell', rowid, 'fph', fph);
        if (fph !== "") {
            $.modalConfirm("Bạn có chắc muốn đổi số hóa đơn thành " + fph + " không?",
                function (flag) {
                    if (flag) {
                        $.najax({
                            url: "/OutOrInStoredManage/Purchase/UpdateFph",
                            type: "POST",
                            data: { cgId: cgId, ddbh: fph },
                            dataType: "json",
                            success: function (data) {
                                if (data.state === 'success') {
                                    $.modalMsg("Đổi số hóa đơn thành công", "success", 1000);
                                } else {
                                    $.modalMsg(data.message, "warning", 1000);
                                }
                            }
                        });
                    }
                });

        }
    }
</script>



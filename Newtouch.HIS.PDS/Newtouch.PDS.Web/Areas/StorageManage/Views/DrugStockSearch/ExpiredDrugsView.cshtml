	function newtouch_event_f3() {
		var key = $("#txtINPUTCODE").val();
        var gpyf = $("#sel_gqrq").val();

        var srcUrl = '@reportUrl' + "?tempCode=1004&systemCode=PDS" + "&hospitalCode=" + orgId + "&yfbmCode=" + yfbmCode + "&time=" + new Date().format('yyyy-MM-dd');
        window.open(srcUrl);

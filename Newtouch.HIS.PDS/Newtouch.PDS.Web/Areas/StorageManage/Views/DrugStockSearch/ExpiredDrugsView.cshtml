    //            }
    //        },
    //        { label: '冻结数量', name: 'djsl', hidden: true },
    //        { label: 'ypdm', name: 'ypdm', hidden: true },
    //        { label: '转化因子', name: 'zhyz', hidden: true},
    //        { label: '库位', name: 'ypkw', hidden: true }
    //    ],
    //    multiselect: false,
    //    pager: "#gridMxPager",

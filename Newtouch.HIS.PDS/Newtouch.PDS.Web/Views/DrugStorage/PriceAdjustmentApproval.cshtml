
@{
    ViewBag.Title = "PriceAdjustmentApproval";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<form id="form1">
    <div class="panel panel-default">
        <div class="panel-heading">
            Điều kiện lọc
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle">Từ khóa</th>
                    <td class="formValue">
                        <input type="text" id="txtINPUTCODE" class="form-control" placeholder="Mã thuốc Pinyin Tên" />
                    </td>
                    <th class="formTitle">Trạng thái duyệt</th>
                    <td class="formValue">
                        <select id="ddlSHZT" class="form-control" onchange="DisableControls(this)">
                            <option value="-1">Tất cả</option>
                            <option value="0" selected>Chưa duyệt</option>
                            <option value="1">Đã duyệt</option>
                            <option value="2">Đã từ chối</option>
                            <option value="3">Đã thu hồi</option>
                        </select>
                    </td>
                    <td class="formValue">
                        <input type="button" id="btn_search" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px;margin-left:30%;" />
                    </td>
                    <th></th>
                    <td></td>
                </tr>
            </table>
        </div>        
    </div>
    <div class="gridPanel" style="margin-top:10px">
        <div class="gridPanel">
            <table id="gridXSHYPInfoList"></table>
            <div id="gridPager" rel="form1"></div>
        </div>
    </div>
</form>
<div style="float:left;margin:10px 30px 12px;">
    <span style="background-color:#EECBAD">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> Đã hết hạn
</div>
@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
    ShowKeyList = new int[] { 2, 3, 6, 7, },
    F2Text = "Duyệt",
    F3Text = "Từ chối",
    F6Text = "Thu hồi",
    F7Text = "Thực hiện"
})

<script>
    $(function () {
        gridXSHYPInfoList();
    });

    function gridXSHYPInfoList() {
        var $gridXshypInfoList = $("#gridXSHYPInfoList");
        $gridXshypInfoList.dataGrid({
            url: '/DrugStorage/SelectMedicineAdjustPriceApprovalInfoList',
            postData: getSearchPostData(),
            height: $(window).height() - 210,
            colModel: [
                { label: "Trạng thái duyệt", name: "shzt", width: 80, align: 'left' },
                { label: 'Cờ thực hiện', name: 'zxbz', width: 80, align: 'left' },
                { label: 'Mã thuốc', name: 'ypCode', width: 80, align: 'left' },
                { label: 'Tên thuốc', name: 'ypmc', width: 120, align: 'left' },
                { label: 'Quy cách thuốc', name: 'ypgg', width: 120, align: 'left' },
                { label: 'Đơn vị định giá', name: 'djdw', width: 80, align: 'left' },
                { label: 'Giá bán buôn gốc', name: 'ypfj', width: 80, align: 'left' },                
                { label: 'Giá lẻ gốc', name: 'ylsj', width: 80, align: 'left' },
                { label: 'Giá bán buôn mới', name: 'pfj', width: 80, align: 'left' },
                { label: 'Giá lẻ mới', name: 'lsj', width: 80, align: 'left' },
                { label: 'Thuộc tính thuốc', name: 'yptssxmc', width: 80, align: 'left' },
                { label: 'Loại thuốc', name: 'yplb', width: 80, align: 'left' },
                { label: 'Liều dùng', name: 'jl', width: 80, align: 'left' },
                { label: 'Đơn vị liều', name: 'jldw', width: 80, align: 'left' },
                { label: 'Số lượng đóng gói', name: 'bzs', width: 80, align: 'left' },
                { label: 'Đơn vị đóng gói', name: 'bzdw', width: 80, align: 'left' },
                { label: 'Số lẻ ngoại trú', name: 'mzcls', width: 80, align: 'left' },
                { label: 'Đơn vị lẻ ngoại trú', name: 'mzcldw', width: 80, align: 'left' },
                { label: 'Số lẻ nội trú', name: 'zycls', width: 80, align: 'left' },
                { label: 'Đơn vị lẻ nội trú', name: 'zycldw', width: 80, align: 'left' },
                { label: 'Tỷ lệ tự trả', name: 'zfbl', width: 80, align: 'left' },
                { label: 'Tính chất tự trả', name: 'zfxz', width: 80, align: 'left' },
                { label: 'Tên dạng bào chế', name: 'jxmc', width: 80, align: 'left' },
                { label: 'Nhà sản xuất', name: 'ycmc', width: 150, align: 'left' },
                { label: 'Trạng thái', name: 'zt', width: 80, align: 'left' },
                { label: 'Loại ghi sổ', name: 'jzlx', width: 80, align: 'left' },
                { label: 'Số lượng đóng gói mặc định', name: 'mrbzq', width: 80, align: 'left' },
                { label: 'Tệp điều chỉnh', name: 'tzwj', width: 80, align: 'left' },
                { label: 'Thời gian thực hiện', name: 'zxsj', width: 160, align: 'left' },
                {
                    label: 'Có hết hạn không', name: 'Isgq', width: 80, align: 'left',
                    formatter: function (val) {
                        return val === "true" ? "Đã hết hạn" : "";
                    }
                }
            ],
            multiselect: true,
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords: true,
            onSelectRow_page: function (rowid) {
                if (rowid) {
                    $("#btn_bottombutton_f2").nfnRemoveReadonly();
                    $("#btn_bottombutton_f3").nfnRemoveReadonly();
                    $("#btn_bottombutton_f6").nfnRemoveReadonly();
                    $("#btn_bottombutton_f7").nfnRemoveReadonly();

                    var isHasWSH = false;
                    var isHasYSH = false;
                    var isHasYJJ = false;
                    var isHasYCX = false;

                    var rowsData = $("#gridXSHYPInfoList").jqGrid("getRowData_AllLine", true);
                    var rowsDataArray = rowsData;
                    for (var i = 0; i < rowsDataArray.length; i++) {
                        if (rowsDataArray[i].shzt === "未审核") {
                            isHasWSH = true;
                        }
                        if (rowsDataArray[i].shzt === "已审核") {
                            isHasYSH = true;
                        }
                        if (rowsDataArray[i].shzt === "已拒绝") {
                            isHasYJJ = true;
                        }
                        if (rowsDataArray[i].shzt === "已撤销" || rowsDataArray[i].zxbz === '已执行') {
                            isHasYCX = true;
                        }
                    }

                    if (isHasWSH) {
                        $("#btn_bottombutton_f7").nfnAddReadonly();
                    }
                    if (isHasYSH) {
                        $("#btn_bottombutton_f2").nfnAddReadonly();
                        $("#btn_bottombutton_f3").nfnAddReadonly();
                        $("#btn_bottombutton_f6").nfnAddReadonly();
                    }
                    if (isHasYJJ) {
                        $("#btn_bottombutton_f2").nfnAddReadonly();
                        $("#btn_bottombutton_f3").nfnAddReadonly();
                        $("#btn_bottombutton_f6").nfnAddReadonly();
                        $("#btn_bottombutton_f7").nfnAddReadonly();
                    }
                    if (isHasYCX) {
                        $("#btn_bottombutton_f2").nfnAddReadonly();
                        $("#btn_bottombutton_f3").nfnAddReadonly();
                        $("#btn_bottombutton_f6").nfnAddReadonly();
                        $("#btn_bottombutton_f7").nfnAddReadonly();
                    }
                }
            },
            gridComplete: function () {
                afterCompleteFunction();
            }
        });
        $("#btn_search").click(function () {
            $gridXshypInfoList.jqGrid('setGridParam', {
                postData: getSearchPostData()
            }).trigger('reloadGrid');
        });
        $("#btn_search").trigger('click');
    }

    //Điều kiện truy vấn
    function getSearchPostData() {
        var inputCode = $("#txtINPUTCODE").val();
        var shzt = $("#ddlSHZT").val();
        return { inputCode: inputCode, shzt: shzt };
    };

    //Đã hết hạn Màu nền là màu đỏ
    function afterCompleteFunction() {
        var ids = $("#gridXSHYPInfoList").getDataIDs();
        for (var i = 0; i < ids.length; i++) {
            var rowData = $("#gridXSHYPInfoList").getRowData(ids[i]);
            if (rowData.Isgq === "已过期") {
                $("#" + ids[i]).find("td").css("background-color", "#EECBAD");
            }
        }
    }

    //Phê duyệt EnumPriceAdjustOperationType:1:Phê duyệt,2:Từ chối,3:Thu hồi,4:Thực hiện
    function newtouch_event_f2() {
        MedicineAdjustPriceApproval(1);
    }
    //Từ chối
    function newtouch_event_f3() {
        MedicineAdjustPriceApproval(2);
    }
    //Thu hồi
    function newtouch_event_f6() {
        MedicineAdjustPriceApproval(3);
    }
    //Thực hiện
    function newtouch_event_f7() {
        MedicineAdjustPriceApproval(4);
    }

    //Duyệt Từ chối Thu hồi Thực hiện thao tác
    function MedicineAdjustPriceApproval(operationType) {
        var rowsData = $("#gridXSHYPInfoList").jqGrid("getRowData_AllLine", true);
        //var rowsDataArray = JSON.parse(rowsData);
        var rowsDataArray = rowsData;
        if (rowsDataArray.length === 0) {
            $.modalAlert("Vui lòng chọn dữ liệu cần thao tác trước", 'warning');
            return;
        }
        var ypCodeStr = "";
        for (var i = 0; i < rowsDataArray.length; i++) {
            if (rowsDataArray[i].Isgq === '已过期' && operationType=="4") {
                $.modalAlert(rowsDataArray[i].ypCode + " Đã hết hạn，Thời gian thực hiện phải lớn hơn thời gian hiện tại", 'warning');
                return;
            }
            ypCodeStr += rowsDataArray[i].ypCode + ",";
        }

        if (ypCodeStr == "") {
            $.modalAlert("Không lấy được dữ liệu cần thao tác", 'warning');
            return;
        }
        var tipStr = "";
        if (operationType == "1") {
            tipStr = "Bạn có chắc muốn phê duyệt không?？";
        } else if (operationType == "2") {
            tipStr = "Bạn có chắc muốn từ chối không?？";
        } else if (operationType == "3") {
            tipStr = "Bạn có chắc muốn thu hồi không?？";
        } else if (operationType == "4") {
            tipStr = "Bạn có chắc muốn thực hiện không?？";
        }
        $.modalConfirm(tipStr, function (flag) {
            if (flag) {
                $.najax({
                    url: "/DrugStorage/MedicineAdjustPriceApproval",
                    dataType: "json",
                    data: { ypCodeStr: ypCodeStr, operationType: operationType },
                    Type: "POST",
                    success: function (data) {
                        if (data.message === 'Thao tác thành công') {
                            $.modalAlert(data.message, 'success');
                        } else {
                            $.modalAlert(data.message, 'error');
                        }
                        $("#btn_search").trigger('click');
                    }
                });
            }
            else
                return false;
        }, false);        
    }

    //Vô hiệu hóa
    function DisableControls(flag) {
        if (flag === "0" || flag === "2" || flag === "3") {
            $("#btn_bottombutton_f7").attr("disabled", "disabled").css("background-color", "rgb(238, 238, 238)");
        } else {
            $("#btn_bottombutton_f7").removeAttr("disabled");
        }
    }
</script>






@{
    ViewBag.Title = "InStorage";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    .req {
        color: red;
    }
</style>
<form id="form1" style="overflow:auto;">
    <div class="panel panel-default">
        <div class="panel-heading">
            Thông tin nhập kho
        </div>
        <div style="padding: 2px;padding-right:10px;">
            <table class="form">
                <tr>
                    <th class="formTitle">Số phiếu nhập kho:</th>
                    <td class="formValue">
                        <input id="txtRKDH" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle"><span class="req">*</span>Nhà cung cấp:</th>
                    <td class="formValue">
                        <input id="txtGYSMC" type="text" onchange="ChangeGYSCODE()" class="form-control" placeholder="Mã Tên Pinyin" />
                        <input id="txtGYSCODE" type="hidden" value="" />
                    </td>
                    <th class="formTitle">Ngày nhập kho:</th>
                    <td class="formValue">
                        <input id="txtRKRQ" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy HH:mm:ss' })" />
                    </td>
                    <th class="formTitle">Cách nhập kho:</th>
                    <td class="formValue formDdlSelectorTd">
                        <select id="ddlRKFS" class="form-control required"></select>
                    </td>
                </tr>
            </table>
        </div>
        <div class="panel-heading">
            Chi tiết thuốc
        </div>
        <div id="divYPMX" style="padding-right:10px;">
            <table class="form">
                <tr>
                    <th class="formTitle"><span class="req">*</span>Mã thuốc:</th>
                    <td class="formValue">
                        <input id="txtSRM" type="text" class="form-control" placeholder="Mã Tên Pinyin Tên hàng hóa" />
                    </td>
                    <th class="formTitle"><span class="req">*</span>Số lượng nhập kho:</th>
                    <td class="formValue">
                        <div class="row">
                            <div class="col-md-8">
                                <input id="txtRKSL" type="text" class="form-control" onchange="RKSL_Leave()" />
                            </div>
                            <div class="col-md-4">
                                <select id="ddlRKDW" class="form-control required" onchange="RKSL_Leave()"></select>
                                <input id="kxdw" hidden="hidden" />
                            </div>
                        </div>
                    </td>
                    <th class="formTitle"><span class="req">*</span>Tổng giá nhập:</th>
                    <td class="formValue">
                        <input id="txtJJZE" type="text" class="form-control" onchange="JJZE_Leave()" style="width: 75%;float: left;" />
                        <span style="float: left;line-height:24px;margin-left: 5px;">(đ)</span>
                    </td>
                    <th class="formTitle"><span class="req">*</span>Số lô:</th>
                    <td class="formValue">
                        <input id="txtPH" type="text" class="form-control" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Số hóa đơn:</th>
                    <td class="formValue">
                        <input id="txtFPH" type="text" class="form-control" />
                        <input id="editRowId" value="" style="display:none;" />
                    </td>
                    <th class="formTitle">Ngày lập hóa đơn:</th>
                    <td class="formValue">
                        <input id="txtKPRQ" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                    </td>
                    <th class="formTitle">Hạn sử dụng:</th>
                    <td class="formValue">
                        <input id="txtYXQ" type="text" class="form-control input-wdatepicker" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" onblur="updatePC()" />
                    </td>
                    <th class="formTitle">Ngày sản xuất:</th>
                    <td class="formValue">
                        <input id="txtSCRQ" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Tên thuốc:</th>
                    <td class="formValue">
                        <input id="txtYPMC" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">Số đăng ký:</th>
                    <td class="formValue">
                        <input id="txtPZWH" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">Tồn kho hiện có:</th>
                    <td class="formValue">
                        <input id="txtkykc" type="text" class="form-control newtouch_Readonly" />
                        <input id="hidden_kcsl" type="text" hidden="hidden" />
                    </td>
                    <th class="formTitle">Quy cách:</th>
                    <td class="formValue">
                        <input id="txtGG" type="text" class="form-control newtouch_Readonly" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Lô:</th>
                    <td class="formValue">
                        <input id="txtPC" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">Nhà sản xuất:</th>
                    <td class="formValue">
                        <input id="txtSCCJ" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <td colspan="4">
                        <input id="txtYSJG" type="hidden" value="" />
                        <input id="txtWG" type="hidden" value="" />
                        <input id="txtPFJ" type="hidden" value="" />
                        <input id="txtLSJ" type="hidden" value="" />
                        <input id="txtJJ" type="hidden" value="" />
                        <input id="txtKL" type="hidden" value="" />
                        <input id="txtPFZE" type="hidden" value="" />
                        <input id="txtLSZE" type="hidden" value="" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</form>
@Html.Partial("_MiddleButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
ShowKeyList = new[] { 2, 3, 6 },
F2Text = "Thêm",
F3Text = "Sửa",
F6Text = "Xóa"
})

<div>
    <table id="gridRKMX"></table>
</div>
@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
ShowKeyList = new int[] { 7, 8 },
F7Text = "Đặt lại",
F8Text = "Đăng ký nhập kho"
})
<span style="float: left;line-height: 25px;margin: 8px 5px;">Tổng nhập kho: &nbsp;<span id="txtRKZE"></span> &nbsp;đ</span>

<script>
    window.newtouch_globalconfig.f4opions = {
        container: "#divYPMX"
    };
    $(function () {
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });
        gridRKMX([]);
        initialRKFS();//Tải phương thức nhập kho
        initialYPGYS();//Lớp nổi đăng ký nhà cung cấp thuốc
        initialRKDH();//Tải số nhập kho
        $('#txtYXQ').val(Getyxq($("#txtSCRQ").val()));
    });

    //Phương thức nhập kho
    function initialRKFS() {
        $("#ddlRKFS").bindSelect({
            url: "/MedicineStorageIOMode/MedicineStorageIOModeList?crkbz=0",
        });
    }

    //Nhà cung cấp thuốc
    function initialYPGYS() {
        $("#txtGYSMC").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            url: '/Medicine/MedicineSupplierList',
            height: 200,
            width: 500,
            caption: "Nhà cung cấp thuốc",
            colModel: [
                { label: 'gysId', name: 'gysId', hidden: true },
                { label: 'Mã nhà cung cấp', name: 'gysCode', widthratio: 40 },
                { label: 'Tên nhà cung cấp', name: 'gysmc', widthratio: 40 }
            ],
            ajaxparameters: function () {
                return "keyword=" + $("#txtGYSCODE").val();
            },
            itemdbclickhandler: function ($thistr) {
                $("#txtGYSCODE").val($thistr.attr('data-gysCode'));
                $("#txtGYSMC").val($thistr.attr('data-gysmc'));
            }
        });
    }

    //Tải số nhập kho
    function initialRKDH() {
        $.najax({
            url: "/DrugStorage/initialRKDH?r=" + Math.random(),
            dataType: "text",
            async: false,
            success: function (data) {
                $("#txtRKDH").val(data);
            }
        });
    }

    //Mã nhập
    $("#txtSRM").newtouchBatchFloatingSelector({
        clickautotrigger: true,
        height: 300,
        width: 1100,
        id: 'initialSRM',
        url: '../StorageManage/DrugStockSearch/DrugAndStockSearch',
        ajaxmethod: 'Get',
        ajaxreqdata: function () {
            var reqData = {};
            reqData.keyword = $("#txtSRM").val();
            return reqData;
        },
        colModel: [
            { label: 'Loại', name: 'dlmc', width: 50 },
            { label: 'Mã', name: 'ypdm', width: 100 },
            { label: 'Tên', name: 'ypmc', width: 200, align: 'left' },
            { label: 'Quy cách', name: 'gg', width: 100, align: 'center' },
            { label: 'Tồn kho', name: 'slStr', width: 70, align: "right" },
            { label: 'Đơn vị', name: 'bzdw', width: 60 },
            { label: 'Nhà sản xuất', name: 'sccj', width: 200, align: 'left' },
            { label: 'Số đăng ký', name: 'pzwh', width: 150, align: 'left' },
            {
                label: 'Giá bán lẻ', name: 'lsj', width: 70, align: "right",
                formatter: function (cellvalue) {
                    return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0.00";
                }
            },
            {
                label: 'Giá bán buôn', name: 'pfj', width: 70, align: "right",
                formatter: function (cellvalue) {
                    return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0.00";
                }
            },
            { label: 'bzs', name: 'bzs', hidden: true },
            { label: 'zxdw', name: 'zxdw', hidden: true },
            { label: 'kykc', name: 'kykc', hidden: true }
        ],
        itemdbclickhandler: function ($thistr) {
            $("#txtSRM").attr('data-dlmc', $thistr.attr('data-dlmc'))
                .attr('data-bzs', $thistr.attr('data-bzs'))
                .val($thistr.attr('data-ypdm'));
            $("#txtYPMC").attr('data-bzdw', $thistr.attr('data-bzdw'))
                .val($thistr.attr('data-ypmc'));
            $("#thPFJDW").text("Giá bán buôn(đ/" + $thistr.attr('data-bzdw') + "):");
            $("#thLSJDW").text("Giá bán lẻ(đ/" + $thistr.attr('data-bzdw') + "):");
            $("#thJJDW").text("Giá nhập(đ/" + $thistr.attr('data-bzdw') + "):");
            $("#txtGG").val($thistr.attr('data-gg'));
            $("#txtkykc").val($thistr.attr('data-slStr'));
            $("#hidden_kcsl").val($thistr.attr('data-kykc'));
            $("#ddlRKDW").empty();
            var kxdw;
            $("#ddlRKDW").append('<option >' + $thistr.attr('data-bzdw') + '</option>'); //Đơn vị xuất kho
            $("#kxdw").val(kxdw); //Đơn vị có thể chọn

            $("#txtSCCJ").val($thistr.attr('data-sccj'));
            $("#txtPZWH").val($thistr.attr('data-pzwh'));
            $("#txtLSJ").val(parseFloat($thistr.attr('data-lsj')).toFixed(4));
            $("#txtPFJ").val(parseFloat($thistr.attr('data-pfj')).toFixed(4));
            var date = new Date();
            var hours = date.getHours().toString();
            if (hours.length === 1) {
                hours = "0" + hours;
            }
            var minutes = date.getMinutes().toString();
            if (minutes.length === 1) {
                minutes = "0" + minutes;
            }
            var milliseconds = date.getMilliseconds().toString();
            if (milliseconds.length === 1) {
                milliseconds = milliseconds + "00";
            }
            else if (milliseconds.length === 2) {
                milliseconds = milliseconds + "0";
            }
            var currentTime = hours + minutes + milliseconds;
            $("#txtPC").val($("#txtYXQ").val().replace(/-/g, "").toString() + currentTime);

            return;
        }

    });

    //Nhà cung cấpcodeThay đổi, Chi tiết thuốcdivXóa
    function ChangeGYSCODE() {
        ClearRKMX();
    }

    //Chi tiết nhập kho
    function gridRKMX(mydata) {
        var $gridRkmx = $("#gridRKMX");
        $gridRkmx.newtouchLocalDataGrid({
            height: $(window).height() - document.getElementById('gridRKMX').offsetTop - 85,
            unwritten: false,
            colModel: [
                { label: 'Loại thuốc', name: 'dlmc', width: 70, align: 'left' },
                { label: 'Số hóa đơn', name: 'fph', width: 80, align: 'left' },
                { label: 'Mã thuốc', name: 'ypdm', width: 70, align: 'left' },
                { label: 'Tên thuốc', name: 'ypmc', width: 110, align: 'left' },
                { label: 'Quy cách', name: 'gg', width: 80, align: 'left' },
                { label: 'Số lượng', name: 'rksl', width: 60, align: 'left' },
                { label: 'Đơn vị', name: 'dw', width: 60, align: 'left' },
                { label: 'Số lô', name: 'ph', width: 100, align: 'left' },
                { label: 'Lô', name: 'pc', width: 100, align: 'left' },
                { label: 'Hạn sử dụng', name: 'yxq', width: 70, align: 'left' },
                {
                    label: 'Giá bán buôn', name: 'pfj', width: 70, align: 'right',
                    formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0.00";
                    }
                },
                {
                    label: 'Giá bán lẻ', name: 'lsj', width: 70, align: 'right',
                    formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0.00";
                    }
                },
                {
                    label: 'Giá nhập', name: 'jj', width: 70, align: 'right',
                    formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0.00";
                    }
                },
                {
                    label: 'Tiền giá nhập', name: 'zje', width: 80, align: 'right',
                    formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0.00";
                    }
                },
                { label: 'Tỷ lệ chiết khấu', name: 'kl', width: 55, align: 'left' },
                { label: 'Tồn kho hiện có', name: 'rkbmkcstr', width: 70, align: 'left' },
                { label: 'Ngày lập hóa đơn', name: 'kprq', width: 75, align: 'left' },
                { label: 'Ngoại quan', name: 'wg', width: 100, align: 'left' },
                { label: 'Số đăng ký', name: 'pzwh', width: 100, align: 'left' },
                { label: 'Nhà sản xuất', name: 'sccj', width: 100, align: 'left' },
                { label: 'Ngày sản xuất', name: 'scrq', width: 70, align: 'left' },
                { label: 'pfze', name: 'pfze', hidden: true, align: 'left' },
                { label: 'lsze', name: 'lsze', hidden: true, align: 'left' },
                { label: 'Rkzhyz', name: 'Rkzhyz', hidden: true, align: 'left' },
                { label: 'Ysjg', name: 'Ysjg', hidden: true, align: 'left' },
                { label: 'rkbmkc', name: 'rkbmkc', hidden: true },
                { label: 'sl', name: 'sl', hidden: true }, //Số lượng lưu cuối cùng vào cơ sở dữ liệu
                { label: 'kxdw', name: 'kxdw', hidden: true } //Đơn vị có thể chọn
            ],
            ondblClickRow: function (rowid) {
                gridDbclickRow(rowid);
            }
        }, mydata);
    }

    //Nhấp đúp
    function gridDbclickRow(rowid) {
        if (rowid) {
            var getRowData = $("#gridRKMX").jqGrid('getRowData', rowid);
            if (getRowData) {
                $("#txtSRM").val(getRowData.ypdm);
                $("#txtFPH").val(getRowData.fph);
                $("#txtYPMC").val(getRowData.ypmc);
                $("#txtGG").val(getRowData.gg);
                $("#txtRKSL").val(getRowData.sl);
                $("#txtPH").val(getRowData.ph);
                $("#txtPC").val(getRowData.pc);
                $("#txtYXQ").val(Getyxq(getRowData.scrq));
                $("#txtPFJ").val(getRowData.pfj);
                $("#txtLSJ").val(getRowData.lsj);
                $("#txtJJ").val(getRowData.jj);
                $("#txtKL").val(getRowData.kl);
                $("#ddlRKDW").empty();
                $("#ddlRKDW").append('<option >' + getRowData.dw + '</option>');
                $("#txtkykc").val(getRowData.rkbmkcstr);
                $("#txtKPRQ").val(getRowData.kprq);
                $("#txtWG").val(getRowData.wg);
                $("#txtPZWH").val(getRowData.pzwh);
                $("#txtSCCJ").val(getRowData.sccj);
                $("#txtSCRQ").val(getRowData.scrq);
                $("#txtJJZE").val(getRowData.zje);
                $("#txtPFZE").val(getRowData.pfze);
                $("#txtLSZE").val(getRowData.lsze);
                $("#txtYSJG").val(getRowData.Ysjg);
                $("#hidden_kcsl").val(getRowData.rkbmkc);

                $('#editRowId').val(rowid);
            }
        }
    }

    //Đặt lại
    function newtouch_event_f7() {
        initialRKDH(); //Đổi số đơn
        $("#txtGYSCODE").val("");
        $("#txtGYSMC").val("");
        $("#txtRKZE").val("");
        EnabledSysBasicInfo();//Bật
        ClearRKMX();//Xóa trống chi tiết
        $('#gridRKMX').jqGrid("clearGridData");
    }

    //Tải bằng Entergrid
    $('#txtWG').keydownEnterEvent(function () {
        if ($('#editRowId').val()) { //là sửa đổi
            newtouch_event_f3(); //Mô phỏng Sửa nút Nhấn
        }
        else {
            newtouch_event_f2(); //Mô phỏng Nút xác nhận Nhấn
        }
    });

    //Lấy chi tiết
    function getEditRowData() {
        var count = $("#gridRKMX").getGridParam('records');
        if (count < 1) {
            //Kiểm tra dữ liệu chính
            if (!CheckMainData()) {
                return false;
            }
        }
        //Kiểm tra chi tiết
        if (!CheckDetailData()) {
            return false;
        }

        var sl;
        if ($("#ddlRKDW").find("option:selected").text() === $("#txtYPMC").attr('data-bzdw')) {
            sl = parseFloat($("#txtRKSL").val());
        } else {
            sl = parseFloat($("#txtRKSL").val() / parseFloat($("#txtSRM").attr('data-bzs'))); //Nếu đơn vị nhập kho đã chọn: Đơn vị kho thuốc,thìsllà số lượng nhập kho/Hệ số chuyển đổi, Sau đó lưu vào cơ sở dữ liệu
        }
        var data = [{
            dlmc: $("#txtSRM").attr('data-dlmc'),
            fph: $("#txtFPH").val(),
            ypdm: $("#txtSRM").val(),
            ypmc: $("#txtYPMC").val(),
            gg: $("#txtGG").val(),
            sl: sl, //Số lượng lưu cuối cùng vào cơ sở dữ liệu
            rksl: $("#txtRKSL").val(), //Số lượng nhập kho trên trang
            dw: $("#ddlRKDW").find("option:selected").text(),
            kxdw: $("#kxdw").val(),
            ph: $("#txtPH").val(),
            pc: $("#txtPC").val(),
            yxq: $("#txtYXQ").val(),
            pfj: $("#txtPFJ").val(),
            lsj: $("#txtLSJ").val(),
            jj: $("#txtJJ").val(),
            zje: $("#txtJJZE").val(),
            kl: $("#txtKL").val(),
            rkbmkcstr: $("#txtkykc").val(),
            kprq: $("#txtKPRQ").val(),
            wg: $("#txtWG").val(),
            pzwh: $("#txtPZWH").val(),
            sccj: $("#txtSCCJ").val(),
            scrq: $("#txtSCRQ").val(),
            pfze: $("#txtPFZE").val(),
            lsze: $("#txtLSZE").val(),
            Rkzhyz: $("#txtSRM").attr('data-bzs'),
            Ysjg: $("#txtYSJG").val(),
            rkbmkc: $("#hidden_kcsl").val()

        }];
        return data;
    }


    //Thêm nút
    function newtouch_event_f2() {
        if ($("#txtYXQ").val() <= $("#txtSCRQ").val()) {
            $.modalMsg("Hạn sử dụng phải muộn hơn ngày sản xuất của thuốc", "warning", 1500);
            return false;
        }
        var count = $("#gridRKMX").getGridParam('records');
        if (count < 1) {
            //Kiểm tra dữ liệu chính
            if (!CheckMainData()) {
                return false;
            }
        }
        //Kiểm tra chi tiết
        if (!CheckDetailData()) {
            return false;
        }
        //Lấy chi tiết
        var data = getEditRowData();
        //Kiểm tra mục trùng lặp
        var isRepeatedAdd = false;
        $.each($("#gridRKMX").getDataIDs(), function () {
            var rowData = $("#gridRKMX").jqGrid('getRowData', this);
            if (rowData.ypdm === data[0].ypdm && rowData.ph === data[0].ph || rowData.pc === data[0].pc) {
                isRepeatedAdd = true;
            }
        });

        if (isRepeatedAdd) {
            $.modalMsg("Không được thêm trùng", "warning", 1000);
            return false;
        }
        $("#gridRKMX").newtouchLocalDataGrid(null, data);
        ComputeRKZE();//Tính số tiền nhập kho
        DisableControls();//Vô hiệu hóa
        ClearRKMX();
    }

    //Sửa nút
    function newtouch_event_f3() {
        if ($("#txtYXQ").val() <= $("#txtSCRQ").val()) {
            $.modalMsg("Hạn sử dụng phải muộn hơn ngày sản xuất của thuốc", "warning", 1500);
            return false;
        }
        if ($('#editRowId').val()) {
            var count = $("#gridRKMX").getGridParam('records');
            if (count < 1) {
                //Kiểm tra dữ liệu chính
                if (!CheckMainData()) {
                    return false;
                }
            }
            //Kiểm tra chi tiết
            if (!CheckDetailData()) {
                return false;
            }
            //Lấy chi tiết
            var data = getEditRowData();
            $('#gridRKMX').jqGrid("delRowData", $('#editRowId').val()); //trướcremovebỏ dòng đó
            //Kiểm tra mục trùng lặp
            var isRepeatedAdd = false;
            $.each($("#gridRKMX").getDataIDs(), function () {
                var rowData = $("#gridRKMX").jqGrid('getRowData', this);
                if (rowData.ypdm === data[0].ypdm && rowData.ph === data[0].ph && rowData.pc === data[0].pc) {
                    isRepeatedAdd = true;
                }
            });

            if (isRepeatedAdd) {
                $.modalMsg("Không được thêm trùng", "warning", 1000);
                return false;
            }
            $("#gridRKMX").newtouchLocalDataGrid(null, data);
            ComputeRKZE();//Tính số tiền nhập kho
            DisableControls();//Vô hiệu hóa
            ClearRKMX();
        }
        else {
            //LấygridDòng đang được chọn
            var seleId = $('#gridRKMX').jqGrid('getGridParam', 'selrow');
            if (seleId) {
                //Yêu cầu sửa dòng đó
                gridDbclickRow(seleId);
            }
        }
    }

    //Xóa
    function newtouch_event_f6() {
        var delRowid = $("#gridRKMX").jqGrid('getGridParam', 'selrow');
        if (!delRowid) {
            $.modalMsg("Chưa chọn dòng", "warning", 1000);
            return;
        }
        $('#gridRKMX').jqGrid('delRowData', delRowid);
        ComputeRKZE();//Tính tổng nhập kho
        //Xóa
        //$("#txtGYSCODE").val("");
        //$("#txtGYSMC").val("");
        EnabledSysBasicInfo();//Bật
    }

    //Nhập kho
    function newtouch_event_f8() {
        var crkdj = Object();
        crkdj.pdh = $("#txtRKDH").val();
        crkdj.ckbm = $("#txtGYSCODE").val();
        crkdj.crkfsdm = $("#ddlRKFS").val();
        var djmx = $("#gridRKMX").jqGrid('getRowData_AllLine');
        if (djmx == null || djmx.length <= 0) {
            $.modalMsg("Vui lòng thêm thông tin nhập kho trước", "warning", 1000);
            return;
        }
        $.najax({
            url: "/DrugStorage/SaveInStorageInfo",
            dataType: "json",
            data: { crkdj: crkdj, crkdjmx: djmx },
            type: "POST",
            success: function (data) {
                if (data.state === 'success') {
                    $.modalAlert("Đăng ký nhập kho đã được gửi", 'success');
                    newtouch_event_f7();//Nhập kho mới: Số chứng từ mới Xóa trống dữ liệu chính Xóa trống chi tiết
                    $('#gridRKMX').jqGrid("clearGridData");//Xóa trốngGrid
                }
                else {
                    $.newtouchAlert(data);
                }
            }
        });

    }

    //Số lượng mất tiêu điểm,Tính số tiền bán buôn Số tiền bán lẻ
    function RKSL_Leave() {
        if ($("#txtRKSL").val() === "") {
            return false;
        }
        if (isNaN($("#txtRKSL").val())) {
            $.modalMsg("Lỗi định dạng số lượng", "warning", 1000);
            return false;
        }
        var sl;
        var pfj = parseFloat($("#txtPFJ").val());
        var lsj = parseFloat($("#txtLSJ").val());
        if ($("#ddlRKDW").find("option:selected").text() === $("#txtYPMC").attr('data-bzdw')) {
            sl = parseFloat($("#txtRKSL").val());
        } else {
            sl = roundingBy4she6ru5chengshuang(parseFloat($("#txtRKSL").val()) / parseFloat($("#txtSRM").attr('data-bzs')), 4);
        }

        $("#thPFZEDW").text("Tổng giá bán buôn(đ/" + $("#ddlRKDW").find("option:selected").text() + "):");
        $("#thLSZEDW").text("Tổng tiền bán lẻ(đ/" + $("#ddlRKDW").find("option:selected").text() + "):");
        $("#txtPFZE").val((pfj * sl).toFixed(4));
        $("#txtLSZE").val((lsj * sl).toFixed(4));

        //Tính lại đơn giá nhập kho
        JJZE_Leave();
        //Tính tỷ lệ khấu trừ
        ComputeKL();
    }

    //Tổng giá nhập mất tiêu điểm, Tính đơn giá nhập kho
    function JJZE_Leave() {
        if (isNaN($("#txtJJZE").val())) {
            $.modalMsg("Định dạng tổng giá nhập sai", "warning", 1000);
            return false;
        }
        if ($("#txtJJZE").val() === "") {
            return false;
        }
        if ($("#txtRKSL").val() === "") {
            return false;
        }
        var sl;
        if ($("#ddlRKDW").find("option:selected").text() === $("#txtYPMC").attr('data-bzdw')) { //Nếu đơn vị có thể trả đã chọn: Đơn vị kho thuốc Số lượng=Nhập số lượng
            sl = parseFloat($("#txtRKSL").val());
        } else { //Đơn vị có thể trả: Đơn vị nhỏ nhất, Số lượng=Nhập số lượng/Hệ số chuyển đổi
            sl = roundingBy4she6ru5chengshuang(parseFloat($("#txtRKSL").val()) / parseFloat($("#txtSRM").attr('data-bzs')), 4);
        }
        var jjze = parseFloat($("#txtJJZE").val());
        var jj = (sl === 0 ? 0 : roundingBy4she6ru5chengshuang((jjze / sl), 4));
        $("#txtJJ").val(parseFloat(jj).toFixed(4));

        ComputeKL();
    }

    //Tính tỷ lệ khấu trừ
    function ComputeKL() {
        if ($("#txtJJ").val() === "") {
            return;
        }
        var pfj = parseFloat($("#txtPFJ").val());
        var jj = parseFloat($("#txtJJ").val());

        $("#txtKL").val(roundingBy4she6ru5chengshuang((pfj * 100 / jj), 2)); //Làm tròn 5 bỏ 6 lên
    }

    //Tính tổng nhập kho
    function ComputeRKZE() {
        var rkze = 0;
        var count = $("#gridRKMX").getGridParam('records');
        if (count > 0) {
            var rowIds = $("#gridRKMX").getDataIDs();
            for (var i = 0; i < rowIds.length; i++) {
                var getRowZje = $("#gridRKMX").getRowData(rowIds[i]).zje;
                rkze = parseFloat(rkze) + parseFloat(getRowZje);
            }
            //Số tiền nhập kho
            $("#txtRKZE").html(rkze.toFixed(2));
        } else {
            $("#txtRKZE").html('');
        }
    }

    //Khi hạn dùng thay đổi, Lô thuốc cũng thay đổi theo
    function updatePC() {
        var date = new Date();
        var hours = date.getHours().toString();
        if (hours.length === 1) {
            hours = "0" + hours;
        }
        var minutes = date.getMinutes().toString();
        if (minutes.length === 1) {
            minutes = "0" + minutes;
        }
        var milliseconds = date.getMilliseconds().toString();
        if (milliseconds.length === 1) {
            milliseconds = milliseconds + "00";
        }
        else if (milliseconds.length === 2) {
            milliseconds = milliseconds + "0";
        }
        var currentTime = hours + minutes + milliseconds;
        $("#txtPC").val($("#txtYXQ").val().replace(/-/g, "").toString() + currentTime);
    }

    //Kiểm tra dữ liệu chính
    function CheckMainData() {
        if ($("#txtRKDH").val() === "") {
            $.modalMsg("Số phiếu nhập kho trống", "warning", 1000);
            return false;
        }
        if ($("#txtGYSCODE").val() === "") {
            $.modalMsg("Mã nhà cung cấp trống", "warning", 1000);
            return false;
        }
        if ($("#txtGYSMC").val() === "") {
            $.modalMsg("Tên nhà cung cấp trống", "warning", 1000);
            return false;
        }
        return true;
    }

    //Kiểm tra dữ liệu chi tiết
    function CheckDetailData() {
        var reg = /^[1-9]\d*$/;//Lớn hơn0 số nguyên
        if ($("#txtSRM").val() === "") {
            $.modalMsg("Mã thuốc không được để trống", "warning", 1000);
            return false;
        }
        if ($("#txtYPMC").val() === "") {
            $.modalMsg("Tên thuốc không được để trống", "warning", 1000);
            return false;
        }
        if (!reg.test($("#txtRKSL").val())) {
            $.modalMsg("Số lượng nhập kho phải lớn hơn0 số nguyên", "warning", 1500);
            return false;
        }
        var reg2 = /^\d+(?:\.\d{0,2})?$/;
        if (!reg2.test($("#txtJJZE").val())) {
            $.modalMsg("Tổng giá nhập vui lòng nhập đúng định dạng tiền", "warning", 1500);
            return false;
        }
        if ($("#txtPH").val() === "") {
            $.modalMsg("Số lô không được để trống", "warning", 1000);
            return false;
        }
        return true;
    }

    //Xóa chi tiết
    function ClearRKMX() {
        newtouch_globalevent_f4();
        $("#ddlRKDW").empty();
        $("#txtKPRQ").val($.getDate());
        $("#txtSCRQ").val($.getDate());
        $("#txtYXQ").val(Getyxq($("#txtSCRQ").val()));


    function EnabledSysBasicInfo() {
        $("#txtGYSCODE").removeAttr("disabled").removeAttr("style");
        $("#txtRKRQ").removeAttr("disabled").removeAttr("style");
        $("#ddlRKFS").removeAttr("disabled").removeAttr("style");

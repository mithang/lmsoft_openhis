    //Hạn dùng mặc định cộng12tháng
    function Getyxq(scrq) {
        var s = scrq.split('-');
        var year = Number($('#txtSCRQ').val().split('-')[0]) + 1;
        return year + "-" + s[1] + "-" + s[2];
    }


@{
    ViewBag.Title = "HandOutMedicineInfo";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    #btn_search {
        height: 45px;
        width: 45px;
        background-color: #fff;
        color: #00a9ea;
        font-weight: bolder;
    }
     
</style>
<form id="form1">
    <div class="panel panel-default" style="margin-bottom: 5px;">
        <div class="panel-heading">
            Thông tin lọc
        </div>
        <table class="form">
            <tr>
                <td class="formTitle"><span class="required">*</span>Ngày bắt đầu：</td>
                <td class="formValue">
                    <input type="text" id="begindate" name="begindate" value="@DateTime.Now.ToString("yyyy-MM-dd 00:00")" class="form-control input-wdatepicker" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm' })"/>
                </td>
                <td class="formTitle"><span class="required">*</span>Ngày kết thúc：</td>
                <td class="formValue">
                    <input type="text" id="enddate" name="enddate" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm")" class="form-control input-wdatepicker" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm' })"/>
                </td>
                <td class="formTitle">Dạng bào chế thuốc：</td>
                <td class="formValue">
                    <select class="form-control" id="jxbh">
                        <option value="">Tất cả</option>
                    </select>
                </td>
                <td class="formTitle">thuộc tính：</td>
                <td class="formValue">
                    <select class="form-control" id="yptssx">
                        <option value="">Tất cả</option>
                    </select>
                </td>
                <td class="formTitle" rowspan="2">
                    <input type="button" class="btn btn-primary btn-md" value="Tra cứu" id="btn_search" />
                </td>
            </tr>
            <tr>
                <td class="formTitle">Số chứng từ：</td>
                <td class="formValue">
                    <input type="text" id="Pdh" class="form-control" placeholder="Vui lòng nhập số chứng từ" />
                </td>
                <td class="formTitle">Bộ phận nhận hàng：</td>
                <td class="formValue">
                    <select class="form-control" id="shbm">
                        <option value="">Tất cả</option>
                    </select>
                </td>
                <td class="formTitle">Loại thuốc：</td>
                <td class="formValue">
                    <select class="form-control" id="yplb">
                        <option value="">Tất cả</option>
                    </select>
                </td>
                <td class="formTitle">Loại xuất kho：</td>
                <td class="formValue">
                    <select class="form-control" id="djlx">
                        <option value="">Tất cả</option>
                        <option value="3">Xuất kho trực tiếp</option>
                        <option value="4">Xuất kho theo đơn lĩnh</option>
                    </select>
                </td>
            </tr>
        </table>
    </div>
</form>

<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>
    $(function () {
        initialddlJXList();
        iniddlTSSXList();
        iniddlSHBMist();
        initialddlYPLBList();
        gridList();
    });

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/DrugStorage/QueryHandOutMeidicineList",
            postData: $("#form1").formSerialize(),
            height: $(window).height() - 190,
            colModel: [
                { label: "Khóa chính", name: "crkId", hidden: true, key: true },
                {
                    label: "Loại chứng từ", name: "djlx", width: 80, align: 'left',
                    formatter: function (cellvalue) {
                        switch (cellvalue) {
                        case 1: return "Nhập kho thuốc";
                        case 2: return "Xuất kho ra ngoài";
                        case 3: return "Xuất kho trực tiếp";
                        case 4: return "Xuất kho theo đơn lĩnh";
                        case 5: return "Trả thuốc phát nội bộ";
                        }
                    }
                },
                { label: "Khoa xuất kho", name: "ckbm", width: 80, align: 'left' },
                { label: 'Tên thuốc', name: 'ypmc', width: 100, align: 'left' },
                { label: 'Số lượng', name: 'fysl', width: 50, align: 'left' },
                { label: 'Dạng bào chế', name: 'jxmc', width: 50, align: 'left' },
                //{ label: 'thuộc tính', name: 'sx', width: 50, align: 'left' },
                { label: 'Loại thuốc', name: 'Yplbmc', width: 60, align: 'left' },
                { label: 'Ngày xuất kho', name: 'Cksj', width: 120, align: 'left', formatter: 'date', formatoptions: { srcformat: 'y-m-d H:i', newformat: 'y-m-d H:i' }},
                { label: 'Số chứng từ', name: 'Pdh', width: 120, align: 'left' },
                { label: 'Bộ phận nhận hàng', name: 'rkbm', width: 50, align: 'left' },
                { label: 'Quy cách', name: 'ypgg', width: 50, align: 'left' },
                //{ label: 'Đơn vị', name: 'Dw', width: 50, align: 'left' },
                { label: 'Số lô', name: 'Ph', width: 100, align: 'left' },
                { label: 'Hạn sử dụng', name: 'Yxq', width: 70, align: 'left' },
                { label: 'Nhà sản xuất', name: 'ycmc', width: 150, align: 'left' },
                { label: 'Pinyin', name: 'py', width: 50, align: 'left' },
                { label: 'Giá bán buôn', name: 'Pfj', width: 50, align: 'left' },
                { label: 'Giá bán lẻ', name: 'Lsj', width: 50, align: 'left' },
                { label: 'Giá nhập', name: 'JJ', width: 50, align: 'left' },
                { label: 'Tổng số tiền', name: 'Zje', width: 50, align: 'left' },
                //{
                //    label: 'Số tiền xuất kho', name: 'ckje', width: 50, align: 'left',
                //    formatter: function (val, opts, rowdata) {
                //        return (rowdata.Lsj * rowdata.Sl).toFixed(2);
                //    }
                //},
                { label: 'Nhân viên xuất kho', name: 'Ckczy', width: 50, align: 'left' }
            ],
            pager: "#gridPager",
            sortname: 'cksj desc',
            viewrecords: true
        });
        $("#btn_search").click(function () {
            if (validatelyInfo()) {
                $gridList.jqGrid('setGridParam', {
                    postData: $("#form1").formSerialize()
                }).trigger('reloadGrid');
            }
        });
    }

    //Kiểm tra ngày
    function validatelyInfo() {
        //Kiểm tra bắt buộc nhập
        var begindate = $("#begindate").val();
        var enddate = $("#enddate").val();
        var pdh = $("#Pdh").val();
        if ((begindate && enddate) || pdh) {
            return true;
        }
        $.modalAlert("Số chứng từ và ngày, bắt buộc nhập một trong hai！", 'warning');
        return false;
    }

    //Dạng bào chế thuốc
    function initialddlJXList() {
        $("#jxbh").bindSelect({
            url: "/PharmacyDrugStorage/GetMedicineFormulationList",
            id: "jxCode",
            text: "jxmc"
        });
    }

    //Thuộc tính thuốc
    function iniddlTSSXList() {
        $("#yptssx").bindSelect({
            url: "/Medicine/GetMedicineTSSXList",
            id: "Code",
            text: "Name"
        });
    }

    //Bộ phận nhận hàng
    function iniddlSHBMist() {
        $("#shbm").bindSelect({
            url: "/Medicine/GetMeidicineSHBMList",
            id: "Code",
            text: "Name"
        });
    }


    //Loại thuốc
    function initialddlYPLBList() {
        $("#yplb").bindSelect({
            url: "/PharmacyDrugStorage/GetMedicineCategoryList"
        });
    }

</script>
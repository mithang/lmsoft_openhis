
@{
    ViewBag.Title = "Bắt đầu kiểm kê";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    .dv-navigation {
        height: 40px;
        margin-bottom: 5px;
    }

    .progress_bar {
        margin-left: 10px;
        padding: 10px 0 10px;
    }

        .progress_bar li {
            width: 180px;
            float: left;
            text-align: center;
            position: relative;
            line-height: 30px;
            list-style: none;
            border-top: 6px solid #f5f5f5;
        }

            .progress_bar li i {
                position: absolute;
                left: 50%;
                margin-left: -10px;
                top: -14px;
                height: 18px;
                width: 18px;
                border: 2px solid white;
                border-radius: 10px;
                background-color: #f5f5f5;
            }

        .progress_bar .completeLi {
            color: #ff9813;
            border-top-color: #ff9813;
        }

        .progress_bar .completePoint {
            background-color: #ff9813;
        }

    input[name=deptSjsl] {
        padding: 2px;
    }

    input[name=minSjsl] {
        padding: 2px;
    }
</style>
<form id="form1">
    <div class="panel panel-default dv-navigation">
        <ol class="progress_bar">
            <li id="dv_startPd"><i></i><label>Bắt đầu kiểm kê</label></li>
            <li id="dv_savePd"><i></i><label>Lưu</label></li>
            <li id="dv_endPd"><i></i><label>Kết thúc kiểm kê</label></li>
            <li id="dv_completePd"><i></i><label>Hoàn thành</label></li>
        </ol>
    </div>
    <div class="panel panel-default" style="margin-bottom:5px;">
        <div class="panel-heading">Điều kiện tra cứu</div>
        <table class="form">
            <tr>
                <th class="formTitle" style="width: 50px;">Ngày:</th>
                <td class="formValue" colspan="2">
                    <select id="ddlRQ" class="form-control"></select>
                </td>
                <th class="formTitle" style="width: 65px;">Từ khóa:</th>
                <td class="formValue" style="width: 115px;">
                    <input id="txtSRM" type="text" class="form-control" placeholder="Pinyin Tên thuốc" />
                </td>
                <th class="formTitle">Trạng thái thuốc:</th>
                <td class="formValue" style="width: 55px;">
                    <select id="ddlYPZT" name="ddlYPZT" class="form-control">
                        <option value="-1">Tất cả</option>
                        <option value="1">Bật</option>
                        <option value="0">Ngừng dùng</option>
                    </select>
                </td>
                <th class="formTitle" style="display:none">Loại thuốc:</th>
                <td class="formValue" style="display:none">
                    <select id="ddlYPLB" class="form-control">
                        <option value="">Tất cả</option>
                    </select>
                </td>
                <th class="formTitle">Hiển thị tồn kho:</th>
                <td class="formValue">
                    <select id="ddlKCXS" name="ddlKCXS" class="form-control">
                        <option value="-1">Tất cả</option>
                        <option value="0">Hiển thị tồn kho bằng 0</option>
                        <option value="1">Không hiển thị số lượng lý thuyết bằng 0</option>
                        <option value="2">Không hiển thị số lượng thực tế bằng 0</option>
                        <option value="4">Không hiển thị khi cả hai đều bằng 0</option>
                    </select>
                </td>
                <td class="formValue" style="width: 160px;">
                    <input type="button" id="btn_search" class="btn btn-primary" value="Tra cứu" />
                    <input type="button" id="btn_backIndex" class="btn btn-primary" value="Về trang chủ" style="float:right;" />
                </td>
            </tr>
        </table>
    </div>
    <div class="panel panel-default" style="margin-bottom: 0;">
        <div class="panel-heading">
            <span>Chi tiết kiểm kê | Chọn đơn vị: Đơn vị khoa</span>
            <i id='i-changeUnit' onclick='ChooseUnit(this)' class='fa fa-toggle-off' style='margin:0 5px;font-size:1.6rem;color:#ff9813;vertical-align:middle;'></i>Đơn vị nhỏ nhất
        </div>
    </div>
    <div id="dv-pdmx-deptUnit">
        <table id="gridKCInfo"></table>
        <div id="gridPager" rel="form1"></div>
    </div>
    <div id="dv-pdmx-minUnit" style="display: none;">
        <table id="gridKCInfoByMinUnit"></table>
        <div id="gridKCInfoByMinUnitPager" rel="form1"></div>
    </div>
    <div style="color: #ff0000;float: left;margin-top: 10px;">(Thực tế)Số khoa: Số đơn vị khoa thực tế; (Thực tế)Số nhỏ nhất: Số đơn vị nhỏ nhất thực tế!</div>
    @Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
    ShowKeyList = new[] { 8, 7, 3,9 },
    F3Text = "Kết thúc",
    F7Text = "Kiểm kê lại",
    F9Text = "In kiểm kê"
})
    <div class="ckbox" style="float: right;margin-top: 10px;">
        <input id="autoCarryDown" name="autoCarryDown" type="checkbox" checked="checked">
        <label for="autoCarryDown"></label>
    </div>
    <div style="float:right;margin: 10px 5px 0 0;font-size: 14px;">Tự động kết chuyển:</div>
</form>
<script language="javascript">
    var $gridKCInfo = $("#gridKCInfo");
    var $gridKCInfoMinUnit = $("#gridKCInfoByMinUnit");
    var lastRowId;
    var ObjArr_Load = new Array();
    $(".toolbar").css("width", 350);

    $(function () {
        $("#btn_backIndex").click(function () {//Quay lại
            $.loading("Đang chuyển trang");
            window.location.href = "StockInventoryV2";
        });
        StartInventory();
        InitialPd();
    });

    //Khởi tạo kiểm kê
    function InitialPd() {
        gridKCInfo();
        gridKCInfoMinUnit();
        $("#btn_search").click(function () {//Gắn truy vấn
            if ($("#i-changeUnit").hasClass("fa-toggle-off")) {
                $gridKCInfo.jqGrid('setGridParam',
                    {
                        url: "/PharmacyDrugStorage/InventoryInfoQuery?r=" + Math.random(),
                        postData: getSearchPostData()
                    }).trigger('reloadGrid');
            } else {
                $gridKCInfoMinUnit.jqGrid('setGridParam',
                    {
                        url: "/PharmacyDrugStorage/InventoryInfoQuery?r=" + Math.random(),
                        postData: getSearchPostData()
                    }).trigger('reloadGrid');
            }
        });
    }

    //Bắt đầu kiểm kê
    function StartInventory() {
        $.najax({
            type: "POST",
            url: "/PharmacyDrugStorage/StartInventory",
            dataType: "json",
            cache: false,
            success: function (ajaxresp) {
                GetPDSJ();//Lấy ngày kiểm kê
                $.UpdateProgressbar.update(1);
            }
        });
    }

    //Lấy thời gian kiểm kê
    function GetPDSJ() {
        $.najax({
            type: "GET",
            url: "/PharmacyDrugStorage/GetPDDateDropdownList",
            dataType: "json",
            success: function (ajaxresp) {
                //Xóa trước, Điền tiếp
                $("#ddlRQ").empty();
                for (var i = 0; i < ajaxresp.data.length; i++) {
                    $("#ddlRQ").append('<option data-pdId=' + ajaxresp.data[i].pdId + '>' + ajaxresp.data[i].pdsj + '</option>');
                }
                $("#btn_search").trigger("click");
            }
        });
    }

    //Thông tin tồn kho
    function gridKCInfo() {
        $gridKCInfo.dataGrid({
            postData: getSearchPostData(),
            height: $(window).height() - 270,
            url: "",
            editurl: "clientArray", //Chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            colModel: [
                { label: 'Tên thuốc', name: 'ypmc', width: 120, align: 'left' },
                { label: 'Quy cách', name: 'ypgg', width: 80, align: 'left' },
                { label: 'Số lý thuyết', name: 'llsl', width: 80, align: 'left' },
                { label: '(Thực tế)Số khoa', name: 'deptSjsl', width: 70, align: 'center', editable: true, editwidth: "90%" },
                { label: 'Đơn vị', name: 'deptdw', width: 40, align: 'left' },
                { label: 'Hệ số', name: 'zhyz', width: 40, align: 'left' },
                { label: 'Số lô', name: 'ph', width: 100, align: 'center' },
                { label: 'Lô', name: 'pc', width: 100, align: 'left' },
                { label: 'Hạn sử dụng', name: 'yxq', width: 80, align: 'left' },
                { label: 'Giá bán buôn', name: 'pfj', width: 60, align: 'left' },
                { label: 'Giá bán lẻ', name: 'lsj', width: 60, align: 'left' },
                { label: 'Tiền bán buôn(Lý thuyết)', name: 'llpfje', width: 70, align: 'left' },
                { label: 'Tiền bán lẻ(Lý thuyết)', name: 'lllsje', width: 70, align: 'left' },
                { label: 'Tiền bán buôn(Thực tế)', name: 'sjpfje', width: 70, align: 'left' },
                { label: 'Tiền bán lẻ(Thực tế)', name: 'sjlsje', width: 70, align: 'left' },
                { label: 'Xuất xứ', name: 'ycmc', width: 120, align: 'left' },
                { label: 'Pinyin', name: 'py', width: 100, align: 'left' },
                { label: 'pdmxId', name: 'pdmxId', hidden: true },
                { label: 'Số lý thuyết', name: 'llsl_zxbz', hidden: true },
                { label: 'Mã thuốc', name: 'ypCode', hidden: true },
                { label: 'Số lượng thực tế(Đóng gói khoa)', name: 'sjslstr', hidden: true },
                { label: 'CreateTime', name: 'CreateTime', hidden: true }
            ],
            multiselect: false,
            pager: "#gridPager",
            sortname: 'ypmc asc',
            sortable: true,
            viewrecords: true,
            gridComplete: function () {
                afterCompleteFunction();
                window.initLayout("MyTabGrid");
            },
            onSelectRow: function (rowid) {
                $("#" + $.jgrid.jqID(rowid) + "_deptSjsl").focus();
            }
        });
    }

    //Thông tin tồn kho
    function gridKCInfoMinUnit() {
        $gridKCInfoMinUnit.dataGrid({
            postData: getSearchPostData(),
            height: $(window).height() - 270,
            url: "",
            editurl: "clientArray", //Chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            colModel: [
                { label: 'Tên thuốc', name: 'ypmc', width: 120, align: 'left' },
                { label: 'Quy cách', name: 'ypgg', width: 80, align: 'left' },
                { label: 'Số lý thuyết', name: 'llsl', width: 80, align: 'left' },
                { label: '(Thực tế)Số nhỏ nhất', name: 'minSjsl', width: 70, align: 'center', editable: true, editwidth: "90%" },
                { label: 'Đơn vị', name: 'zxdw', width: 40, align: 'left' },
                { label: 'Hệ số', name: 'zhyz', width: 40, align: 'left' },
                { label: 'Số lô', name: 'ph', width: 100, align: 'center' },
                { label: 'Lô', name: 'pc', width: 100, align: 'left' },
                { label: 'Hạn sử dụng', name: 'yxq', width: 80, align: 'left' },
                { label: 'Giá bán buôn', name: 'pfj', width: 60, align: 'left' },
                { label: 'Giá bán lẻ', name: 'lsj', width: 60, align: 'left' },
                { label: 'Tiền bán buôn(Lý thuyết)', name: 'llpfje', width: 70, align: 'left' },
                { label: 'Tiền bán lẻ(Lý thuyết)', name: 'lllsje', width: 70, align: 'left' },
                { label: 'Tiền bán buôn(Thực tế)', name: 'sjpfje', width: 70, align: 'left' },
                { label: 'Tiền bán lẻ(Thực tế)', name: 'sjlsje', width: 70, align: 'left' },
                { label: 'Xuất xứ', name: 'ycmc', width: 120, align: 'left' },
                { label: 'Pinyin', name: 'py', width: 100, align: 'left' },
                { label: 'pdmxId', name: 'pdmxId', hidden: true },
                { label: 'Số lý thuyết', name: 'llsl_zxbz', hidden: true },
                { label: 'Mã thuốc', name: 'ypCode', hidden: true },
                { label: 'Số lượng thực tế(Đóng gói khoa)', name: 'sjslstr', hidden: true },
                { label: 'CreateTime', name: 'CreateTime', hidden: true }
            ],
            multiselect: false,
            pager: "#gridKCInfoByMinUnitPager",
            sortname: 'ypmc asc',
            sortable: true,
            viewrecords: true,
            gridComplete: function () {
                afterCompleteFunctionMinUnit();
                window.initLayout("MyTabGrid");
            },
            onSelectRow: function (rowid) {
                $("#" + $.jgrid.jqID(rowid) + "_minSjsl").focus();
            }
        });
    }

    //Chọn đơn vị
    function ChooseUnit(obj) {
        if ($(obj).hasClass("fa-toggle-off")) {
            $(obj).removeClass("fa-toggle-off");
            $(obj).addClass("fa-toggle-on");
            $("#dv-pdmx-deptUnit").hide();
            $("#dv-pdmx-minUnit").show();
        } else {
            $(obj).removeClass("fa-toggle-on");
            $(obj).addClass("fa-toggle-off");
            $("#dv-pdmx-deptUnit").show();
            $("#dv-pdmx-minUnit").hide();
        }
        $("#btn_search").trigger("click");
    }

    //Điều kiện truy vấn
    function getSearchPostData() {
        var pdsj = $("#ddlRQ").val();
        var pdId = $("#ddlRQ option:selected").attr('data-pdId');
        var srm = $("#txtSRM").val();
        var ypzt = $("#ddlYPZT").val();
        var kcxs = $("#ddlKCXS").val();
        if (!pdsj && !pdId) {
            return false;
        }
        if (kcxs === "" || kcxs == null) {
            kcxs = -1;
        }
        return { pdsj: pdsj, pdId: pdId, srm: srm, ypzt: ypzt, yplb: "", kcxs: kcxs };
    };

    //Tải dữ liệu truy vấn lần đầu
    function afterCompleteFunction() {
        ObjArr_Load = [];
        $.loading("Đang tải dữ liệu");
        var rowIds = $gridKCInfo.jqGrid('getDataIDs');//GridSau khi tải xong, bật chỉnh sửa trong dòng 1.Lấy tất cả các dòng trướcId 2.Duyệt để gọieditRowPhương thức
        for (var i = 0; i < rowIds.length; i++) {
            ObjArr_Load.push($gridKCInfo.jqGrid('getRowData', rowIds[i]));
            $gridKCInfo.jqGrid('editRow', rowIds[i], true, null, null, null, null, function (callbackRowId) { //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.
            });
        }
        $.loading(false);
    }

    //Tải dữ liệu truy vấn lần đầu
    function afterCompleteFunctionMinUnit() {
        ObjArr_Load = [];
        $.loading("Đang tải dữ liệu");
        var rowIds = $gridKCInfoMinUnit.jqGrid('getDataIDs');//GridSau khi tải xong, bật chỉnh sửa trong dòng 1.Lấy tất cả các dòng trướcId 2.Duyệt để gọieditRowPhương thức
        for (var i = 0; i < rowIds.length; i++) {
            ObjArr_Load.push($gridKCInfoMinUnit.jqGrid('getRowData', rowIds[i]));
            $gridKCInfoMinUnit.jqGrid('editRow', rowIds[i], true, null, null, null, null, function (callbackRowId) { //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.
            });
        }
        $.loading(false);
    }

    //Lưu
    function newtouch_event_f8() {
        var $targetJqg;
        if ($("#i-changeUnit").hasClass("fa-toggle-off")) {
            $targetJqg = $gridKCInfo;//Lấy tất cả các dòngId, Duyệt để đưa hộp chỉnh sửa về trạng thái lưu
        } else {
            $targetJqg = $gridKCInfoMinUnit;//Lấy tất cả các dòngId, Duyệt để đưa hộp chỉnh sửa về trạng thái lưu
        }
        var rowIds = $targetJqg.jqGrid('getDataIDs');//Lấy tất cả các dòngId, Duyệt để đưa hộp chỉnh sửa về trạng thái lưu

        //Kiểm tra số lượng trả
        for (var i = 0; i < rowIds.length; i++) {
            $targetJqg.saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);
            var rowData = $targetJqg.jqGrid('getRowData', rowIds[i]);
            if (!rowData) {
                return false;
            }
            if ($("#i-changeUnit").hasClass("fa-toggle-off")) { //Đơn vị khoa
                if (rowData.deptSjsl.replace(/(^\s*)|(\s*$)/g, "") === "" || rowData.deptSjsl < 0 || isNaN(rowData.deptSjsl) || rowData.deptSjsl === "") {
                    $.modalAlert("Hạng mục(" + rowData.ypmc + ")Số lượng thực tế phải là số tự nhiên, Vui lòng xác nhận.", "warning");
                    EnableInlineEditBox();//Bật khung sửa trong dòng
                    return false;
                }
            } else { //Đơn vị nhỏ nhất
                if (rowData.minSjsl.replace(/(^\s*)|(\s*$)/g, "") === "" || rowData.minSjsl < 0 || isNaN(rowData.minSjsl) || rowData.minSjsl === "") {
                    $.modalAlert("Hạng mục(" + rowData.ypmc + ")Số lượng thực tế phải là số tự nhiên, Vui lòng xác nhận.", "warning");
                    EnableInlineEditBoxMinUnit();//Bật khung sửa trong dòng
                    return false;
                }
            }
        }
        var kcInfoJsonSave = $targetJqg.jqGrid('getRowData_AllLine');
        var objArrSave = new Array();
        $.each(kcInfoJsonSave, function () {//Khi lưu thìGriddòng dữ liệu vào mảng mới
            objArrSave.push(this);
        });
        var resultObjArr = new Array();
        //so sánh với mảng tải từ trang, đặt dòng dữ liệu đã sửa vàoresultObjArrtrong, gửi cho máy chủ
        for (var i = 0; i < objArrSave.length; i++) {
            if (objArrSave[i].deptSjsl !== ObjArr_Load[i].deptSjsl || objArrSave[i].minSjsl !== ObjArr_Load[i].minSjsl) {
                resultObjArr.push({ pdmxId: objArrSave[i].pdmxId, sjsl: CalculationMinUnitNum(objArrSave[i].deptSjsl, objArrSave[i].minSjsl, objArrSave[i].zhyz) });
            }
        }
        if (resultObjArr.length === 0) {
            $.modalAlert("Không có dữ liệu cần lưu", 'warning');
            $("#btn_search").trigger("click");
            $.UpdateProgressbar.update(2);
            return false;
        }
        $.najax({
            type: "POST",
            url: "/PharmacyDrugStorage/SaveInventoryInfo",
            dataType: "json",
            data: { resultObjArr: JSON.stringify(resultObjArr), pdId: $("#ddlRQ option:selected").attr('data-pdId') },
            success: function (ajaxresp) {
                $("#btn_search").trigger("click");
                $.UpdateProgressbar.update(2);
                $.modalAlert("Lưu thành công", 'success');
            },
            error: function (ajaxresp) {
                $.modalAlert(ajaxresp.message, Error);
            }
        });
    };

    //Quy đổi tồn kho thành số đơn vị nhỏ nhất Chia lẻ
    function CalculationMinUnitNum(deptNum, minNum, zhyz) {
        if (deptNum == null) return parseInt(minNum);
        if (minNum == null) return parseInt(deptNum) * parseInt(zhyz);
        return parseInt(deptNum) * parseInt(zhyz) + parseInt(minNum);
    }

    //Quy đổi tồn kho thành số đơn vị nhỏ nhất Không chia lẻ
    function CalculationMinUnitNumNoOpen(deptNum, zhyz) {
        return parseInt(deptNum) * parseInt(zhyz);
    }

    //Bật hộp chỉnh sửa trong dòng
    function EnableInlineEditBox() {
        var rowIds = $gridKCInfo.jqGrid('getDataIDs');//GridSau khi tải xong, bật chỉnh sửa trong dòng 1.Lấy tất cả các dòng trướcId 2.Duyệt để gọieditRowPhương thức
        for (var i = 0; i < rowIds.length; i++) {
            $gridKCInfo.jqGrid('editRow', rowIds[i], true, null, null, null, null, function (callbackRowId) { //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.
            });
        }
    }

    //Bật hộp chỉnh sửa trong dòng
    function EnableInlineEditBoxMinUnit() {
        var rowIds = $gridKCInfoMinUnit.jqGrid('getDataIDs');//GridSau khi tải xong, bật chỉnh sửa trong dòng 1.Lấy tất cả các dòng trướcId 2.Duyệt để gọieditRowPhương thức
        for (var i = 0; i < rowIds.length; i++) {
            $gridKCInfoMinUnit.jqGrid('editRow', rowIds[i], true, null, null, null, null, function (callbackRowId) { //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.
            });
        }
    }

    //Kết thúc kiểm kê
    function newtouch_event_f3() {
        if ($("#autoCarryDown").is(":checked")) {
            $.modalConfirm("Bạn có chắc muốn tự động tạo kết chuyển không??",
                function (flag) {
                    if (flag) {
                        InventorySubmit();
                    }
                });
        } else {
            InventorySubmit();
        }
    }

    //Gửi
    function InventorySubmit() {
        $.najax({
            type: "POST",
            url: "/PharmacyDrugStorage/EndInventory",
            dataType: "json",
            data: { pdId: $("#ddlRQ option:selected").attr('data-pdId'), autoCarryDown: $("#autoCarryDown").is(":checked") ? "1" : "0" },
            success: function (ajaxresp) {
                $.modalAlert("Kiểm kê hoàn tất", 'success');
                GetPDSJ();//Làm mới thời gian kiểm kê và thông tin thuốc
                $.UpdateProgressbar.update(4);
            },
            error: function (ajaxresp) {
                $.modalAlert(ajaxresp.message, Error);
            }
        });
    }

    //Hủy kiểm kê
    function newtouch_event_f7() {
        $.modalConfirm("Bạn có chắc muốn kiểm kê lại không??",
            function (flag) {
                if (flag) {
                    var pdId = $("#ddlRQ option:selected").attr('data-pdId');
                    $.najax({
                        type: "POST",
                        url: "/PharmacyDrugStorage/CancelInventory",
                        dataType: "json",
                        data: { pdId: pdId },
                        success: function (ajaxresp) {
                            $("#ddlRQ option[data-pdId='" + pdId + "']").remove();
                            StartInventory();
                        }
                    });
                }
            });
    }

    //In chi tiết kiểm kê
    function newtouch_event_f9() {
        var srm = $("#txtSRM").val();
        var ypzt = $("#ddlYPZT").val();
        var kcxs = $("#ddlKCXS").val();
        var pdId = $("#ddlRQ option:selected").attr('data-pdId');
        window.open("/Report/PrintReport?type=StockInventory&param=srm=" + srm + "|ypzt=" + ypzt + "|kcxs=" + kcxs + "|pdId=" + pdId + "|yfbm=@ViewBag.bmCode |OrganizeId=@ViewBag.OrganizeId", "height=500, width=1195, top=100, left=50, toolbar=no, menubar=no, scrollbar=yes, resizeble=no, location=no, status=no");
    }

    //Cập nhật tiến độ
    $.UpdateProgressbar = {
        startPd: function () {
            $(".progress_bar").find("li").removeClass("completeLi");
            $(".progress_bar").find("i").removeClass("completePoint");
            if (!$("#dv_startPd").hasClass("completeLi")) {
                $("#dv_startPd").addClass("completeLi");
            }
            if (!$("#dv_startPd").find("i").hasClass("completePoint")) {
                $("#dv_startPd").find("i").addClass("completePoint");
            }
        },
        savePd: function () {
            if (!$("#dv_savePd").hasClass("completeLi")) {
                $("#dv_savePd").addClass("completeLi");
            }
            if (!$("#dv_savePd").find("i").hasClass("completePoint")) {
                $("#dv_savePd").find("i").addClass("completePoint");
            }
        },
        endPd: function () {
            if (!$("#dv_endPd").hasClass("completeLi")) {
                $("#dv_endPd").addClass("completeLi");
            }
            if (!$("#dv_endPd").find("i").hasClass("completePoint")) {
                $("#dv_endPd").find("i").addClass("completePoint");
            }
        },
        completePd: function () {
            if (!$("#dv_completePd").hasClass("completeLi")) {
                $("#dv_completePd").addClass("completeLi");
            }
            if (!$("#dv_completePd").find("i").hasClass("completePoint")) {
                $("#dv_completePd").find("i").addClass("completePoint");
            }
        },
        update: function (step) {
            switch (step) {
                case 1:
                    $.UpdateProgressbar.startPd();
                    break;
                case 2:
                    $.UpdateProgressbar.startPd();
                    $.UpdateProgressbar.savePd();
                    break;
                case 3:
                    $.UpdateProgressbar.startPd();
                    $.UpdateProgressbar.savePd();
                    $.UpdateProgressbar.endPd();
                    break;
                case 4:
                    $.UpdateProgressbar.startPd();
                    $.UpdateProgressbar.savePd();
                    $.UpdateProgressbar.endPd();
                    $.UpdateProgressbar.completePd();
                    break;
            }
        },
        clean: function () {//Khởi tạo thanh tiến trình Về 0
            $("li").removeClass("completeLi");
            $("i").removeClass("completePoint");
        }
    };
</script>
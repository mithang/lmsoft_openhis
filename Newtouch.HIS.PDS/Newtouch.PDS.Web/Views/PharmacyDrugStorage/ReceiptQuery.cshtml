@using Newtouch.Infrastructure;
@using Newtouch.HIS.Web.Core.Extensions;
@{
    ViewBag.Title = "ReceiptQuery";
    Layout = "~/Views/Shared/_Index.cshtml";
    var djlxItemStrs = "1,2,3,4,5,6"; //Enum tương ứngEnumDanJuLX
    if (Constants.CurrentYfbm.yfbmjb == "2")    //Nhà thuốc
    {
        djlxItemStrs = "3,4,5,6"; //Phát thuốc trực tiếp、Phát thuốc theo đơn lĩnh、Trả lại phát thuốc nội bộ
    }
}

<form id="form1">
    <div class="panel panel-default">
        <div class="panel-heading">
            Điều kiện tra cứu
        </div>
        <div>
            <table class="form">
                <tr>
                    <th class="formTitle">Trạng thái duyệt：</th>
                    <td class="formValue">
                        @Html.DropDownList("ddlSHZT", EnumDjShzt.WaitingApprove.ToDescSelectList(), "Tất cả", new { @class = "form-control" })
                    </td>
                    <th class="formTitle" style="width: 75px;padding-right: 0;">Ngày：</th>
                    <td class="formValue" style="width:130px;">
                        <input id="txtStartDate" type="text" class="form-control input-wdatepicker " value="@DateTime.Now.ToString("yyyy-MM-dd 00:00")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm' })" />
                    </td>
                    <th class="formTitle" style="width: 35px;padding-right: 0;">Đến：</th>
                    <td class="formValue" style="width:130px;">
                        <input id="txtEndDate" type="text" class="form-control input-wdatepicker " value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm' })" />
                    </td>
                    <th class="formTitle">Số chứng từ：</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="txtPDH" />
                    </td>
                    <th class="formTitle">Loại chứng từ：</th>
                    <td class="formValue">
                        @Html.DropDownList("ddlDJLX", EnumDanJuLX.yaopinruku.ToSomeDescSelectList(djlxItemStrs), "Tất cả", new { @class = "form-control" })
                    </td>
                    <td class="formTitle">
                        <input type="button" id="btn_search" class="btn btn-md btn-primary" value="Tra cứu" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div>
        <table id="gridDJMainRecords"></table>
        <div id="gridPager" rel="form1"></div>
    </div>
    <div style="margin-top:5px;">
        <table id="gridDJMXInfo"></table>
    </div>
</form>
<script>
    $(function () {
        //Khi thay đổi kích thước cửa sổ trình duyệt, tải lạijqGridchiều rộng
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });
        gridDJMainRecords();
    });

    //Bản ghi chính của chứng từ
    function gridDJMainRecords() {
        var $gridDjMainRecords = $("#gridDJMainRecords");
        $gridDjMainRecords.dataGrid({
            postData: getSearchPostData(),
            height: 165,
            url: "/PharmacyDrugStorage/SelectReceiptMainInfo?from=query",
            colModel: [
                {
                    label: 'Trạng thái duyệt', name: 'shzt', width: 60, align: 'center', formatter: function (val) {
                        return val === "0" ? "Chưa duyệt" : (val === "1" ? "Đã đạt" : (val === "2" ? "Không đạt" : (val === "3" ? "Đã hủy" : "")));
                    }
                },
                { label: 'Loại chứng từ', name: 'djlxmc', width: 70, align: 'center' },
                { label: 'Số chứng từ', name: 'pdh', width: 130, align: 'center' },
                { label: 'Khoa xuất kho', name: 'ckbmmc', width: 100, align: 'left' },
                { label: 'Khoa nhập kho', name: 'rkbmmc', width: 100, align: 'left' },
                { label: 'Cách nhập/xuất kho', name: 'crkfsmc', width: 80, align: 'center' },
                { label: 'Tiền giá bán buôn', name: 'pjze', width: 80, align: 'left' },
                { label: 'Tiền giá lẻ', name: 'ljze', width: 80, align: 'left' },
                { label: 'Tổng số tiền giá nhập', name: 'zje', width: 80, align: 'left' },
                { label: 'Chênh lệch nhập-xuất', name: 'jxcj', width: 80, align: 'left' },
                { label: 'Thời gian thao tác', name: 'czsj', width: 130, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:s', newformat: 'Y-m-d H:s' }  },
                { label: 'crkId', name: 'crkId', hidden: true, align: 'left' },
                { label: 'djlx', name: 'djlx', hidden: true, align: 'left' }
            ],
            unwritten: false,
            multiselect: false,
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords: true,
            onSelectRow_page: function (rowId) {
                btn_selectrow(rowId);
            }
        });

        $("#btn_search").click(function () {
            $('#gridDJMXInfo').jqGrid("clearGridData");
            $gridDjMainRecords.jqGrid('setGridParam', {
                postData: getSearchPostData()
            }).trigger('reloadGrid');
        });
        $("#btn_search").trigger('click');
    }
    function getSearchPostData() {
        var shzt = $("#ddlSHZT").val();
        var qsrj = $("#txtStartDate").val();
        var jsrj = $("#txtEndDate").val();
        var pdh = $("#txtPDH").val();
        var djlx = $("#ddlDJLX").val();
        return { qsrj: qsrj, jsrj: jsrj, pdh: pdh, djlx: djlx, shzt: shzt };
    };

    //Sự kiện nhấp chuột
    function btn_selectrow(rowId) {
        //Mỗi lần nhấp，Xóa chi tiết trước Sau đó tải lại chi tiết của tất cả các dòng đã chọn
        $('#gridDJMXInfo').jqGrid("clearGridData");
        $.najax({
            type: "POST",
            url: "/PharmacyDrugStorage/SelectReceipDetailInfo",
            data: { crkId: $("#gridDJMainRecords").jqGrid('getRowData', rowId).crkId, djlx: $("#gridDJMainRecords").jqGrid('getRowData', rowId).djlx },
            dataType: "json",
            success: function (ajaxresp) {
                $('#gridDJMXInfo').newtouchLocalDataGrid(null, ajaxresp);
            }
        });
    }

    //Chi tiết chứng từ
    $('#gridDJMXInfo').newtouchLocalDataGrid({
        height: $(window).height() - 385,
        caption: "Chi tiết chứng từ",
        unwritten: false,
        sortable: false,
        colModel: [
            { label: 'Số thứ tự chi tiết nhập/xuất kho', name: 'crkmxId', hidden: true, width: 100, align: 'left' },
            { label: 'Số lô', name: 'ph', width: 80, align: 'left' },
            { label: 'Lô', name: 'pc', width: 80, align: 'left' },
            { label: 'Loại thuốc', name: 'yplbmc', width: 60, align: 'left' },
            { label: 'Tên thuốc', name: 'ypmc', width: 110, align: 'left' },
            { label: 'Quy cách', name: 'gg', width: 70, align: 'left' },
            { label: 'Nhà sản xuất', name: 'sccj', width: 110, align: 'left' },
            { label: 'Số lượng', name: 'slanddw', width: 40, align: 'left' },
            { label: 'Số tiền giá bán buôn', name: 'pjze', width: 70, align: 'left' },
            { label: 'Số tiền giá lẻ', name: 'ljze', width: 70, align: 'left' },
            { label: 'Giá nhập', name: 'jj', width: 70, align: 'left' },
            { label: 'Tổng số tiền giá nhập', name: 'zje', width: 70, align: 'left' },
            { label: 'Chênh lệch nhập-xuất', name: 'jxcj', width: 60, align: 'left' },
            { label: 'Pinyin', name: 'py', width: 60, align: 'left' },
            { label: 'Tỷ lệ chiết khấu', name: 'kl', width: 50, align: 'left' }
        ]
    });

</script>

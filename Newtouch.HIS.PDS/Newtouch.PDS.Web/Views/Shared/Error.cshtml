@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title></title>
    <style type="text/css">
        html, body {
            background-color: #f9f9f9;
            font: normal 62.5% Verdana, Arial, Helvetica, sans-serif, "微软雅黑";
            font-family: "Arial","SimSun";
            padding: 0;
            margin: 0;
            color: #000;
            font-size: 24px;
        }

        .text {
            width: 529px;
            height: 372px;
            margin: 50px auto;
            text-align: center;
        }

        .Prompt {
            line-height: 20px;
            float: right;
        }
    </style>
</head>
<body>
    <div class="text">
        <img src="@MvcHelper.GetStaticResourceScriptUrl("~/img/error_170503.png")" />
        <div class="Prompt">Đã xảy ra lỗi，Vui lòng liên hệ quản trị viên&nbsp;&nbsp;&nbsp;<a style="cursor:pointer;" title="Xem chi tiết ngoại lệ" onclick="showException(); return false;">Chi tiết ngoại lệ</a></div>
    </div>

    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/css/framework-font.css")" rel="stylesheet" />
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/jquery/jquery.choose.js")"></script>
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/bootstrap/bootstrap.js")"></script>
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/js/bootstrap/bootstrap.min.css")" rel="stylesheet" />
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/dialog/dialog.js")"></script>
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/cookie/jquery.cookie.js")"></script>
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/css/framework-theme.css")" rel="stylesheet" id="color-skin" />
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/framework-ui.js")"></script>
    <script src="/js/pds-vi.js"></script>
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/Newtouch-ui.js")"></script>
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/css/skins/_all-skins.css")" rel="stylesheet" />

    <script type="text/javascript">
        function showException() {
            alert('Đã xảy ra sự cố không xác định');
        }
    </script>
</body>
</html>

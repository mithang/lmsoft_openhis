</div>
<script type="text/javascript">
    var ThisbqCode = "";//Khởi tạo khu bệnhCode
    var ThisbrCode = "";//Khởi tạo bệnh nhânCode
    var Thisbqbian = "";
    var checkArray = [];
    var pageNum = 1;

    $(".toolbar").css("width", 250);
    var $dispenseMedicinGridList = $("#dispenseMedicinGridList");
    var zyh = [];

    $(function () {
        //Gắn khu bệnh
        bqGridList();
        //Gắn chi tiết phát thuốc của bệnh nhân
        dispenseMedicinGridList(null);

    });

    function operateTimeList(zyh,bqbm) {

        if ($("#Kssj").val() == "" || $("#Kssj").val() == null) {
            return;
        }

        $.najax({
            type: "Get",
            url: "/HospitalizationPharmacy/GetFybdComboboxList",
            dataType: "json",
            data: {
                Zyh: zyh,
                Bqbm: bqbm,
                Kssj: $("#Kssj").val() + " 00:00:00",
                Jssj: $("#Kssj").val() + " 23:59:59"
            },
            success: function (ajaxresp) {
                if (ajaxresp !== null) {
                    $("#seloperatetime").html("");

                    for (var i = 0; i < ajaxresp.length; i++) {
                        $("#seloperatetime").append("<option value='" + ajaxresp[i].operatetime + "'>" + ajaxresp[i].operatetime + "</option>");
                    }

                    $('#seloperatetime').multiselect({
                        buttonWidth: '100%',
                        includeSelectAllOption: true,
                        enableClickableOptGroups: true,
                        enableCollapsibleOptGroups: true,
                        selectAllText: "Chọn tất cả",
                        nonSelectedText: "Chưa chọn",
                        allSelectedText: "Chọn tất cả"
                    });

                    $('#seloperatetime').multiselect("rebuild");
                }
            }
        });

        //$("#seloperatetime").bindSelect({
        // url: "/HospitalizationPharmacy/GetFybdComboboxList",
        // id: "operatetime",
        // param: {
        // Zyh: zyh,
        // Kssj: $("#Kssj").val() + " 00:00:00",
        // Jssj: $("#Kssj").val() + " 23:59:59"
        // },
        // text: "operatetime"
        //});

        $("#seloperatetime").change(function () {
            $("#btn_search").click();
        });
    }

    //Chi tiết phát thuốc của người dùng
    function dispenseMedicinGridList() {
        $dispenseMedicinGridList.dataGrid({
            multiselect: true,
            url: '/HospitalizationPharmacy/GetFybdList',
            height: $(window).height() - document.getElementById('dispenseMedicinGridList').offsetTop - 150,
            postData: {
                Zyh: ' ',
                Bqbm:' ',
                operatetime:'',
                Kssj: $("#Kssj").val() + " 00:00:00",
                Jssj: $("#Kssj").val() + " 23:59:59"
            },
            colModel: [
                { label: 'Id', name: 'Id', align: 'left', hidden: true },
                { label: 'zyh', name: 'zyh', align: 'left', hidden: true },
                { label: 'Họ tên', name: 'patientName', width: 65, align: 'left' },
                { label: 'Số thứ tự lĩnh thuốc', name: 'lyxh', width: 65, align: 'left' },
                { label: 'Lô', name: 'pc', width: 100, align: 'left' },
                { label: 'Thuốc', name: 'ypmc', width: 100, align: 'left' },
                { label: 'Số giường', name: 'cw', width: 60, align: 'center' },
                { label: 'Số lượng phát thuốc', name: 'slStr', width: 60, align: 'right' },
                { label: 'Dạng bào chế', name: 'jxmc', width: 60, align: 'center' },
                { label: 'Quy cách', name: 'ypgg', width: 100, align: 'left' },
                { label: 'Tần suất', name: 'pcmc', width: 50, align: 'center' },
                { label: 'Số nhóm', name: 'zh', width: 40, align: 'center' },
                { label: 'Liều lượng', name: 'ylStr', width: 60, align: 'center' },
                { label: 'Tính chất y lệnh', name: 'yzxzmc', width: 60, align: 'center' },
                { label: 'Nhà sản xuất', name: 'ycmc', width: 100, align: 'left' },
                { label: 'Cách dùng', name: 'zlff', width: 50, align: 'center' },
                { label: 'Người thao tác', name: 'CreatorCode', width: 70, align: 'center' },
                { label: 'Thời gian thao tác', name: 'CreateTime', width: 100, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i', newformat: 'Y-m-d H:i' } },
                { label: "Y lệnhID", name: 'zxId', hidden: true },
                { label: 'Đơn giá', name: 'djStr', hidden: true },
                { label: 'Số tiền', name: 'je', hidden: true },
                { label: 'Số lượng sử dụng', name: 'yl', hidden: true },
                { label: 'Đơn vị sử dụng', name: 'yldw', hidden: true },
                { label: "Mã thuốc", name: 'ypCode', hidden: true },
                { label: "yzId", name: 'yzId', hidden: true }
            ],
            caption: "Danh sách phát thuốc",
            pager: "#gridPager",
            sortname: 'CreateTime',
            viewrecords: true,
            //multiboxonly : false,
            onSelectAll: function (rowIds, status) {
                //Kích hoạt khi chọn tất cả, rowIdslà tất cả của trang hiện tạirowId
                //checkArrayXóa tất cả của trang hiện tại trong mảng jqGrid('getDataIDs');
                for (var i = 0; i < rowIds.length; i++) {
                    for (var j = 0; j < checkArray.length; j++) {
                        if (checkArray[j].pageNum == pageNum && checkArray[j].rowId == rowIds[i]) {
                            checkArray.splice(j, 1);
                            break;
                        }
                    }
                }
                //Nếu là chọn đã chọn, thì cộng tất cả mục của trang hiện tại
                if (status) {
                    for (var i = 0; i < rowIds.length; i++) {
                        var rowData = $dispenseMedicinGridList.jqGrid('getRowData', rowIds[i]);
                        var checkedItem = { "pageNum": pageNum, "rowId": rowIds[i], "czlx": rowData.czlx, "yzId": rowData.yzId, "Id": rowData.Id, "zxId": rowData.zxId, "zyh": rowData.zyh, "zytyapplyno": rowData.zytyapplyno };
                        checkArray.push(checkedItem)
                    }
                }
            },
            onSelectRow: function (rowId, status) { //NhấncheckboxKích hoạt rowIdlà kích hoạt hiện tạirowid
                //Dữ liệu dòng của dòng được chọn
                var rowData = $dispenseMedicinGridList.jqGrid('getRowData', rowId);
                var checkedItem = { "pageNum": pageNum, "rowId": rowId, "czlx": rowData.czlx, "yzId": rowData.yzId, "Id": rowData.Id, "zxId": rowData.zxId, "zyh": rowData.zyh, "zytyapplyno": rowData.zytyapplyno };
                if (status) {
                    //Nếu được chọn, thì kiểm tra nếu trong mảng chưa có thì thêm vào mảng
                    for (var i = 0; i < checkArray.length; i++) {
                        if (checkArray[i].pageNum == pageNum && checkArray[i].rowId == rowId) {
                            return false;
                        }
                    }
                    checkArray.push(checkedItem);
                } else {
                    //Xóa mảng
                    for (var i = 0; i < checkArray.length; i++) {
                        if (checkArray[i].pageNum == pageNum && checkArray[i].rowId == rowId) {
                            checkArray.splice(i, 1);
                            break;
                        }
                    }
                }
                //console.log(checkArray)
            },
            //Kích hoạt khi mỗi trang tải
            loadComplete: function (data) {
                //Thay đổi biến toàn cụcpageNumSố trang
                pageNum = data.page;
                //Lặp mảng, Để trong trang hiện tạirowIdtrở thành trạng thái được chọn
                for (var i = 0; i < checkArray.length; i++) {
                    if (checkArray[i].pageNum == pageNum) {
                        $dispenseMedicinGridList.jqGrid('setSelection', checkArray[i].rowId, true);
                    }
                }
            }
        });

        $(".ui-pg-selbox").change(function () {
            //Sự kiện cần kích hoạt
            checkArray.splice(0);
        });

        //Truy vấn
        $("#btn_search").click(function () {
            if ($("#Kssj").val() === "") {
                $.modalMsg("Thời gian bắt đầu không được để trống", "warning", 2000);
                return false;
            }
            if ($("#Jssj").val() === "") {
                $.modalMsg("Thời gian kết thúc không được để trống", "warning", 2000);
                return false;
            }
            if ($("#seloperatetime").val() === "") {
                return false;
            }

            var gyssStr = "";
            var gyssArr = $("#seloperatetime").val();
            if (gyssArr != null && gyssArr.length > 0) {
                $.each(gyssArr, function (index, item) {
                    gyssStr += item + ',';
                });
                gyssStr = gyssStr.substring(0, gyssStr.length - 1);
            }

            if (gyssArr == "") {
                return;
            }

            $dispenseMedicinGridList.jqGrid("clearGridData");

            $dispenseMedicinGridList.jqGrid('setGridParam', {
                postData: {
                    Zyh: ThisbrCode,
                    Bqbm: Thisbqbian,
                    operatetime: gyssStr,
                    Kssj: $("#Kssj").val() + " 00:00:00",
                    Jssj: $("#Kssj").val() + " 23:59:59"
                }
            }).trigger('reloadGrid');
        });
    }

    function bqGridList() {
        $("#BqTreeList").treeview({
            height: $(window).height() - 35,
            slimscroll: false,
            showcheck: true,
            url: "/HospitalizationPharmacy/GetFybdBrxxTree",
            param: {},
            oncheckboxclick: function (item, s) {
                getOrderExecutionList(item, s);
            }
        });
    }


    function getOrderExecutionList(item, s)
    {
        var patlist = $("#BqTreeList").getCheckedNodeObjArray();
        var patlistFath = "";
        var patzyh = "";
        var patnots = "";

        //Nút cha đang được chọn
        var len = 0;
        var single = 0; //Có phải nút con đơn lẻ không

        if (item != null && item.Ex1 == "p") {
            patlistFath = item.ChildNodes;
            len = patlistFath.length;
        }
        else if (item != null && item.Ex1 == "c") {
            patlistFath = item;
            len = 1;
            single = 1;
        }
        //Nút được chọn
        for (var i = 0; i < patlist.length; i++) {
            if (patlist[i].Ex1 === "c") {
                patzyh += patlist[i].value + ",";
            }
            else if (patlist[i].Ex1 === "p") {
                patnots += patlist[i].value + ",";
            }
        }

        if (s === 1) {
            if (single === 0) {
                for (var j = 0; j < len; j++) {
                    if (patlistFath[j].Ex1 === "c") {
                        patzyh += patlistFath[j].value + ",";
                        patnots += patlistFath[j].parentnodes + ",";
                    }
                }
            }
            else if (patlistFath.Ex1 === "c") {
                patzyh += patlistFath.value;
                patnots += patlistFath.parentnodes;
            }
        }
        else if (s === 0) {
            if (single === 0) {
                for (var j = 0; j < len; j++) {
                    if (patlistFath[j].Ex1 === "c" && patlistFath[j].checkstate === 1) {
                        patzyh = patzyh.replace(patlistFath[j].value + ",", "");
                        patnots = patnots.replace(patlistFath[j].parentnodes + ",", "");
                    }
                }
            }
            else if (patlistFath.Ex1 === "c") {
                patzyh = patzyh.replace(patlistFath.value + ",", "");
                patnots = patnots.replace(patlistFath.parentnodes + ",", "");
            }
        }

        ThisbrCode = patzyh;
        Thisbqbian = patnots;

        $dispenseMedicinGridList.jqGrid("clearGridData");

        operateTimeList(ThisbrCode, Thisbqbian);
    }

    //Chọn xếp tầng tất cả nút con
    function checkAllSon(node) {
        $('#BqTreeList').treeview('checkNode', node.nodeId, { silent: true });
        if (node.nodes != null && node.nodes.length > 0) {
            for (var i in node.nodes) {
                checkAllSon(node.nodes[i]);
            }
        }
    }
    //Bỏ chọn xếp tầng tất cả nút con
    function uncheckAllSon(node) {
        $('#BqTreeList').treeview('uncheckNode', node.nodeId, { silent: true });
        if (node.nodes != null && node.nodes.length > 0) {
            for (var i in node.nodes) {
                uncheckAllSon(node.nodes[i]);
            }
        }
    }


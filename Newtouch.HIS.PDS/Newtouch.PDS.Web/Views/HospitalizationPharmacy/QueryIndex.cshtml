@using Newtouch.Infrastructure
@{
    ViewBag.Title = "QueryIndex";//Tra cứu phát thuốc nội trú
    Layout = "~/Views/Shared/_Index.cshtml";
    var reportUrl = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("ReportUrl");
}
<style>
    #btn_search {
        height: 45px;
        width: 45px;
        background-color: #fff;
        color: #00a9ea;
        font-weight: bolder;
    }
</style>
<input hidden id="OrganizeId" value="@ViewBag.OrganizeId">
<div class="rows">
    <form id="form1">
        <div class="panel panel-default">
            <div class="panel-heading">
                Điều kiện tra cứu
            </div>
            <div style="padding: 2px;">
                <table class="form">
                    <tr>
                        <th class="formTitle">Khu bệnh1：</th>
                        <td class="formValue formDdlSelectorTd">
                            <select id="bqmc" class="form-control">
                                <option value="">Tất cả</option>
                            </select>
                        </td>
                        <th class="formTitle">Lô：</th>
                        <td class="formValue">
                            <input id="pc" type="text" class="form-control" placeholder="Lô" />
                        </td>
                        <th class="formTitle"><span class="required">*</span>Thời gian bắt đầu：</th>
                        <td class="formValue">
                            <input id="Kssj" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({dateFmt:'yyyy-MM-dd HH:mm:ss'})" />
                        </td>
                        <th class="formTitle"><span class="required">*</span>Thời gian kết thúc：</th>
                        <td class="formValue">
                            <input id="Jssj" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.AddHours(2).ToString("yyyy-MM-dd 23:59")" onfocus="WdatePicker({dateFmt:'yyyy-MM-dd 23:59:59'})" />
                        </td>
                        <td class="formTitle" rowspan="2">
                            <input type="button" id="btn_search" class="btn btn-primary btn-md" value="Tra cứu" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Tên bệnh nhân：</th>
                        <td class="formValue">
                            <input id="patientName" type="text" class="form-control" placeholder="Họ tên" />
                        </td>
                        <th class="formTitle">Thuốc：</th>
                        <td class="formValue">
                            <input id="ypmc" type="text" class="form-control" placeholder="Thuốc" />
                        </td>
                        <th class="formTitle">Số giường：</th>
                        <td class="formValue">
                            <input id="cw" type="text" class="form-control" placeholder="Số giường" />
                        </td>
                        <th class="formTitle">Loại thao tác：</th>
                        <td class="formValue">
                            <select id="fyzt" class="form-control">
                                <option value="">Tất cả</option>
                                <option value="1">Phát thuốc</option>
                                <option value="2">Trả thuốc</option>
                            </select>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </form>
</div>


<div class="rows">
    <table id="resultGridList"></table>
    <div id="gridPager"></div>
</div>
@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
    ShowKeyList = new int[] { 6, 8 } ,
    F6Text = "In bổ sung",
    F8Text = "In tổng hợp",
})

<script type="text/javascript">
    var $gridBRXXDrugsList = $("#resultGridList");
    $(function () {
        $("#bqmc").bindSelect({ //Tập hợp thông tin khu bệnh
            url: "/HospitalizationPharmacy/GetBQSelectJson",
            id: "bqCode",
            text: "bqmc"
        });
        dispenseMedicinGridList();
    });

    //Gắn sự kiện phím Enter
    $(document).keyup(function (event) {
        if (event.keyCode === 13) {
            $("#btn_search").trigger("click");
        }
    });


    var checkArray = [];
    var pageNum = 1;

    //Chi tiết phát thuốc của người dùng
    function dispenseMedicinGridList() {
        $gridBRXXDrugsList.dataGrid({
            multiselect: true,
            url: '/HospitalizationPharmacy/GetZYFYCXDBGridJson',
            height: $(window).height() - document.getElementById('resultGridList').offsetTop - 150,
            postData: {
                Bq: $("#bqmc").val(), patientName: $("#patientName").val(),
                ypmc: $("#ypmc").val(), pc: $("#pc").val(),
                Kssj: $("#Kssj").val(), Jssj: $("#Jssj").val(),
                cw: $("#cw").val(), operateType: $("#fyzt").val()
            },
            colModel: [
                {
                    label: 'Thao tác', name: 'czlx', width: 45, align: 'center',
                    formatter: function (cellvalue) {
                        return cellvalue === "Phát thuốc" ? "<span style='color:#0000cd;'>Phát thuốc</span>" : "<span style='color:#ff0000;'>Trả thuốc</span>";
                    }
                },
                { label: 'Id', name: 'Id',   align: 'left', hidden: true },
                { label: 'zyh', name: 'zyh', align: 'left', hidden: true },
                { label: 'Họ tên', name: 'patientName', width: 80, align: 'left' },
                { label: 'Lô', name: 'pc', width: 100, align: 'left' },
                { label: 'Thuốc', name: 'ypmc', width: 100, align: 'left' },
                { label: 'Số giường', name: 'cw', width: 60, align: 'center' },
                { label: 'Phát/Số lượng trả', name: 'slStr', width: 60, align: 'right' },
                { label: 'Dạng bào chế', name: 'jxmc', width: 60, align: 'center' },
                { label: 'Quy cách', name: 'ypgg', width: 100, align: 'left' },
                { label: 'Tần suất', name: 'pcmc', width: 50, align: 'center' },
                { label: 'Số nhóm', name: 'zh', width: 50, align: 'center' },
                { label: 'Liều lượng', name: 'ylStr', width: 60, align: 'center' },
                { label: 'Tính chất y lệnh', name: 'yzxzmc', width: 60, align: 'center' },
                { label: 'Nhà sản xuất', name: 'ycmc', width: 100, align: 'left' },
                { label: 'Cách dùng', name: 'zlff', width: 50, align: 'center' },
                { label: 'Người thao tác', name: 'CreatorCode', width: 70, align: 'center' },
                { label: 'Thời gian thao tác', name: 'CreateTime', width: 100, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i', newformat: 'Y-m-d H:i' } },
                { label: "Y lệnhID", name: 'zxId', hidden: true },
                { label: 'Đơn giá', name: 'djStr', hidden: true },
                { label: 'Số tiền', name: 'je', hidden: true },
                { label: 'Số lượng sử dụng', name: 'yl', hidden: true },
                { label: 'Đơn vị sử dụng', name: 'yldw', hidden: true },
                { label: "Mã thuốc", name: 'ypCode', hidden: true },
                { label: "yzId", name: 'yzId', hidden: true }
            ],
            caption: "Phát thuốc/Danh sách trả thuốc",
            pager: "#gridPager",
            sortname: 'CreateTime',
            viewrecords: true,
            //multiboxonly : false,
            onSelectAll: function (rowIds, status) {
                //Kích hoạt khi chọn tất cả，rowIdslà tất cả của trang hiện tạirowId
                //checkArrayXóa tất cả của trang hiện tại trong mảng jqGrid('getDataIDs');
                for (var i = 0; i < rowIds.length; i++) {
                    for (var j = 0; j < checkArray.length; j++) {
                        if (checkArray[j].pageNum == pageNum && checkArray[j].rowId == rowIds[i]) {
                            checkArray.splice(j, 1);
                            break;
                        }
                    }
                }
                //Nếu là chọn đã chọn，thì cộng tất cả mục của trang hiện tại
                if (status) {
                    for (var i = 0; i < rowIds.length; i++) {
                        var rowData = $gridBRXXDrugsList.jqGrid('getRowData', rowIds[i]);
                        var checkedItem = { "pageNum": pageNum, "rowId": rowIds[i], "czlx": rowData.czlx, "yzId": rowData.yzId, "Id": rowData.Id, "zxId": rowData.zxId, "zyh": rowData.zyh  };
                        checkArray.push(checkedItem)
                    }
                }
            },
            onSelectRow: function (rowId, status) {  //NhấncheckboxKích hoạt rowIdlà kích hoạt hiện tạirowid
                //Dữ liệu dòng của dòng được chọn
                var rowData = $gridBRXXDrugsList.jqGrid('getRowData', rowId);
                var checkedItem = { "pageNum": pageNum, "rowId": rowId, "czlx": rowData.czlx, "yzId": rowData.yzId, "Id": rowData.Id, "zxId": rowData.zxId, "zyh": rowData.zyh };
                if (status) {
                    //Nếu được chọn，thì kiểm tra nếu trong mảng chưa có thì thêm vào mảng
                    for (var i = 0; i < checkArray.length; i++) {
                        if (checkArray[i].pageNum == pageNum && checkArray[i].rowId == rowId) {
                            return false;
                        }
                    }
                    checkArray.push(checkedItem);
                } else {
                    //Xóa mảng
                    for (var i = 0; i < checkArray.length; i++) {
                        if (checkArray[i].pageNum == pageNum && checkArray[i].rowId == rowId) {
                            checkArray.splice(i, 1);
                            break;
                        }
                    }
                }
                //console.log(checkArray)
            },
            //Kích hoạt khi mỗi trang tải
            loadComplete: function (data) {
                //Thay đổi biến toàn cụcpageNumSố trang
                pageNum = data.page;
                //Lặp mảng，Để trong trang hiện tạirowIdtrở thành trạng thái được chọn
                for (var i = 0; i < checkArray.length; i++) {
                    if (checkArray[i].pageNum == pageNum) {
                        $gridBRXXDrugsList.jqGrid('setSelection', checkArray[i].rowId, true);
                    }
                }
            }
        });

        $(".ui-pg-selbox").change(function () {
            //Sự kiện cần kích hoạt
            checkArray.splice(0);
        });

        //Truy vấn
        $("#btn_search").click(function () {
            if ($("#Kssj").val() === "") {
                $.modalMsg("Thời gian bắt đầu không được để trống", "warning", 2000);
                return false;
            }
            if ($("#Jssj").val() === "") {
                $.modalMsg("Thời gian kết thúc không được để trống", "warning", 2000);
                return false;
            }
            $gridBRXXDrugsList.jqGrid('setGridParam', {
                postData: {
                    Bq: $("#bqmc").val(),
                    patientName: $("#patientName").val(),
                    ypmc: $("#ypmc").val(),
                    pc: $("#pc").val(),
                    Kssj: $("#Kssj").val(),
                    Jssj: $("#Jssj").val(),
                    cw: $("#cw").val(),
                    operateType: $("#fyzt").val()
                }
            }).trigger('reloadGrid');

            checkArray = [];
        });
    }

    function openWindowWithPost(url, name, keys, values) {
        var newWindow = window.open(url, name);

        if (!newWindow) return false;

        var html = "";
        html += "<html><head></head><body><form id='formid' method='post' action='" + url + "'>";

        if (keys && values && (keys.length == values.length))
            for (var i = 0; i < keys.length; i++)
                html += "<input type='hidden' name='" + keys[i] + "' value='" + values[i] + "'/>";

        html += "</form><script type='text/javascript'>document.getElementById(\"formid\").submit()</sc" + "ript></body></html>";

        newWindow.document.write(html);
        return newWindow;
    }

    //In chi tiết
    function newtouch_event_f7() {
        var yzIds = checkArray.map((item) => {
            var czlx = item.czlx.indexOf("Phát thuốc") != -1 ? "Phát thuốc" : "Trả thuốc";
            return item.yzId + czlx + item.Id;
        }).join(",");

        var startTime = $("#Kssj").val();
        var endTime = $("#Jssj").val();
        var fybz = $("#fyzt").val();
        var bqCode = $("#bqmc").val();
        var patientName = $("#patientName").val();
        var ypmc = $("#ypmc").val();
        var cw = $("#cw").val();
        var pc = $("#pc").val();

        var values = new Array("@ViewBag.OrganizeId", "@ViewBag.yfbmCode", startTime, endTime, fybz, bqCode, patientName, ypmc, cw, pc, yzIds);
        var keys = new Array("OrganizeId", "yfbmCode", "kssj", "jssj", "operateType", "bqCode", "patientName", "ypmc", "cw", "pc", "yzIds");
        openWindowWithPost("@(ViewBag.ReportServerHOST)/Pages/ReportViewer.aspx?%2fNewtouch.HIS.Bill%2fZYFYCX_Detail&rs:Command=Render", "", keys, values);
    }

    //In tổng hợp
    function newtouch_event_f8() {
        var kssj = $("#Kssj").val();
        var jssj = $("#Jssj").val();
        var operateType = $("#fyzt").val();
        if (operateType != "1" && operateType != "2") {
            operateType = "1,2";
        }
        //var zxIds = checkArray.map((item) => {
        //    return item.zxId
        //}).join(",");
        //var yzIds = checkArray.map((item) => {
        //    return item.yzId
        //}).join(",");        
        var czIds = checkArray.map((item) => {
            return item.Id
        }).join(",");
        var values = new Array("@ViewBag.OrganizeId", "@ViewBag.yfbmCode", "", "", operateType, kssj, jssj, czIds);
        var keys = new Array("OrganizeId", "yfbmCode", "yzIds", "zxIds", "operateType", "kssj", "jssj", "czIds");

        var uri = '@reportUrl' + "?tempCode=66&systemCode=PDS" + "&hospitalCode=" + '@ViewBag.OrganizeId' + "&yfbmCode=" + '@ViewBag.yfbmCode' + "&yzIds=" + "&zxIds=" + "&operateType=" + operateType + "&kssj=" + kssj + "&jssj=" + jssj + "&czIds=" + czIds;
        window.open(uri);
        //openWindowWithPost("@(ViewBag.ReportServerHOST)/Pages/ReportViewer.aspx?%2fNewtouch.HIS.Bill%2fZYFYCX_Summary_bak&rs:Command=Render", "", keys, values);

    }
    @*function newtouch_event_f8() {
        var startTime = $("#Kssj").val();
        var endTime = $("#Jssj").val();
        var fybz = $("#fyzt").val();
        var bqCode = $("#bqmc").val();
        var patientName = $("#patientName").val();
        var ypmc = $("#ypmc").val();
        var cw = $("#cw").val();
        var pc = $("#pc").val();

        var values = new Array("@ViewBag.OrganizeId", "@ViewBag.yfbmCode", startTime, endTime, fybz, bqCode, patientName, ypmc, cw, pc);
        var keys = new Array("OrganizeId", "yfbmCode", "kssj", "jssj", "operateType", "bqCode", "patientName", "ypmc", "cw", "pc");
        openWindowWithPost("@(ViewBag.ReportServerHOST)/Pages/ReportViewer.aspx?%2fNewtouch.HIS.Bill%2fZYFYCX_Summary&rs:Command=Render", "", keys, values);

    }*@



    function newtouch_event_f6() {
        //In bổ sung Không hỗ trợ in hỗn hợp phát thuốc trả thuốc
        var operateType;
        if (checkArray.length == 0) {
            $.modalMsg("Vui lòng chọn bản ghi thao tác", "warning");
            return false;
        }
        var fy = checkArray.filter((item) => item.czlx.indexOf("Phát thuốc") > 0);
        var ty = checkArray.filter((item) => item.czlx.indexOf("Trả thuốc") > 0);
        if (fy.length > 0 && ty.length > 0) {
            $.modalMsg("Loại thao tác, vui lòng chọn trả thuốc hoặc phát thuốc", "warning");
            return false;
        }
        else if (fy.length > 0) {
            operateType = 1;
        }
        else if (ty.length > 0) {
            operateType = 2;
        }

        var zyh = checkArray[0].zyh;
        if (!!zyh && checkArray.filter((item) => item.zyh != zyh).length>0) {
            $.modalMsg("In nhiều người, vui lòng chọn in tổng hợp", "warning");
            return false;
        }
        //var zxIds = checkArray.map((item) => {
        //    return item.zxId
        //}).join(",");
        //var yzIds = checkArray.map((item) => {
        //    return item.yzId
        //}).join(",");
        var czIds = checkArray.map((item) => {
            return item.Id
        }).join(",");

        var values = new Array("@ViewBag.OrganizeId", "@ViewBag.yfbmCode", "", "", operateType, zyh, czIds, "");
        var keys = new Array("OrganizeId", "yfbmCode", "yzIds", "zxIds", "operateType", "zyh", "czIds", "rdNo");

        var uri = '@reportUrl' + "?tempCode=64&systemCode=PDS" + "&hospitalCode=" + '@ViewBag.OrganizeId' + "&OrganizeId=" + '@ViewBag.OrganizeId' + "&yfbmCode=" + '@ViewBag.yfbmCode' + "&yzIds=" + "&zxIds=" + "&czIds=" + czIds + "&zyh=" + zyh + "&operateType=" + operateType + "&rdNo=";
        window.open(uri);
        //openWindowWithPost("@(ViewBag.ReportServerHOST)/Pages/ReportViewer.aspx?%2fNewtouch.HIS.Bill%2fZYFY_CFD_bak&rs:Command=Render", "", keys, values);

    }


</script>

	<script type="text/javascript">
        var my_skins;
        $(document).ready(function () {
            my_skins = [
    "skin-black",
    "skin-red",
    "skin-white",
    "skin-purple",
    "skin-green",
    "skin-black-light",
    "skin-red-light",
    "skin-white-light",
    "skin-purple-light",
    "skin-green-light"
            ];
        });

		var requexx = "";
		var times;
		var type = "";
        var msgtypecodes = "";
        var kcyjypcode = "", gqyjypcode = "", drgqyjypcode = "";
        $(function () {
            $('#txtb').hide();
            if (requexx != 1) {
                MSGQuery();
            }
            else {
                clearTimeout(times);
            }
        });
		//Biểu tượng nhấp nháy
		function blink(selector) {
			$(selector).fadeOut('slow', function () {
				$(this).fadeIn('slow', function () {
					blink(this);
				});
			});
        }
		function MSGQuery() {
			//yzshzyh = ""; yzzxzyh = ""; requexx = ""; msgtypecodes = "";
			$('#txtb').stop().fadeIn();
			$('#txtb').stop().fadeOut();
			$('#txtb').hide();
			//msgtypecodes = 1;
			//$('#txtb').show();
			//blink('#txtb');
			$.ajax({
				url: "/Home/getmesquery",
				datatype: "json",
				async: false,
				type: "post",
                success: function (rst) {
					var da = (typeof rst === "string" ? JSON.parse(rst) : rst);
					if (da != "" && da != null) {
					    $("#badge1").text((da.kcyj || 0) + (da.gqyj || 0));//+da.drgqyj
						$("#badge2").text(!da.kcyj ? "" : da.kcyj);
						$("#badge3").text(!da.gqyj ? "" : da.gqyj);
						$("#badge4").text(!da.drgqyj ? "" : da.drgqyj);
                        //$("#countents").text(da[0].msgcontent);
						if (da.rows != "") {
							$('#txtb').show();
							blink('#txtb');
                        }
                        var rows = da.rows || [];
                        //1:Cảnh báo tồn kho 2:Cảnh báo hết hạn
						for (var i = 0; i < rows.length; i++) {
							if (rows[i].typeas == "1") {
								kcyjypcode += rows[i].ypCode + ",";
						    }
							else if (rows[i].typeas == "2"){
								gqyjypcode += rows[i].ypCode + ",";
						    }
							else if (rows[i].typeas == "3") {
							    drgqyjypcode += rows[i].ypCode + ",";
							}
						}
					} else {
						requexx = 1;
					}

				},
				error: function () {

				}
			})

		}

		$("#kcyj").click(function () {
			kcyj();
		});

		$("#gqyj").click(function () {
			gqyj();
		});

		$("#drgqyj").click(function () {
		    drgqyj();
		});

		function kcyj() {
			$("#badge2").text("");
			var badge2 = Number($("#badge2").text());
			var badge3 = Number($("#badge3").text());
			var badge4 = Number($("#badge4").text());
			var badge1 = badge2 + badge3;
			$("#badge1").text(badge1 == 0 ? "" : badge1);
			if (badge1 == 0) {
				$('#txtb').stop().fadeIn();
				$('#txtb').stop().fadeOut();
                $('#txtb').hide();
            }
			sessionStorage.setItem('kcyjyp', kcyjypcode);
			top.top.$.Newtouchtab.addTabWithOutMenu({ name: "Tra cứu lượng tồn kho(Nhắc tin nhắn)", enName: "", url: "/OutOrInStoredManage/Purchase/PurchasePlan" });
			//top.top.$.Newtouchtab.addTabWithOutMenu({ name: "Truy vấn lượng tồn kho(Nhắc nhở tin nhắn)", enName: "", url: "/StorageManage/DrugStockSearch/StockQuery"});
		}
        //Đã hết hạn
		function gqyj() {
			$("#badge3").text("");
			var badge2 = Number($("#badge2").text());
			var badge3 = Number($("#badge3").text());
			var badge4 = Number($("#badge4").text());
			var badge1 = badge2 + badge3;// + badge4;
			$("#badge1").text(badge1 == 0 ? "" : badge1);
			if (badge1 == 0) {
				$('#txtb').stop().fadeIn();
				$('#txtb').stop().fadeOut();
                $('#txtb').hide();
            }
			sessionStorage.setItem('gqyjyp', gqyjypcode);
			top.top.$.Newtouchtab.addTabWithOutMenu({ name: "Tra cứu thuốc hết hạn(Nhắc tin nhắn)", enName: "", url: "/StorageManage/DrugStockSearch/ExpiredDrugsView"});
        }
        //Hết hạn trong ngày
		function drgqyj()
		{
		    var badge2 = Number($("#badge2").text());
		    var badge3 = Number($("#badge3").text());
		    var badge4 = Number($("#badge4").text());
		    var badge1 = badge2 + badge3 + badge4;
		    $("#badge1").text(badge1 == 0 ? "" : badge1);
		    if (badge1 == 0) {
		        $('#txtb').stop().fadeIn();
		        $('#txtb').stop().fadeOut();
		        $('#txtb').hide();
		    }
		    sessionStorage.setItem('drgqyjyp', drgqyjypcode);
		    top.top.$.Newtouchtab.addTabWithOutMenu({ name: "1 tháng tới hết hạn - tra cứu thuốc(Nhắc tin nhắn)", enName: "", url: "/StorageManage/DrugStockSearch/ExpiredDrugsView?type=1" });
		}


@{
    ViewBag.Title = "PriceAdjustmentProfitAndLossQuery";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<form id="form1">
    <div class="panel panel-default">
        <div class="panel-heading">
            Điều kiện lọc
        </div>
        <table class="form" >
            <tr>
                <td class="formTitle">Ngày bắt đầu:</td>
                <td class="formValue"><input type="text" id="startTime" style="width: 140px;" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("dd/MM/yyyy 00:00:00")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy 00:00:00' })" /></td>
                <td class="formTitle">Ngày kết thúc:</td>
                <td class="formValue"><input type="text" id="endTime" style="width: 140px;" class="form-control input-wdatepicker" value="@DateTime.Now.AddDays(1).ToString("dd/MM/yyyy HH:mm")" onfocus="WdatePicker({dateFmt:'dd/MM/yyyy HH:mm'})" /></td>
                <td class="formTitle">Từ khóa:</td>
                <td class="formValue">
                    <input type="text" id="Srm" class="form-control" placeholder="Mã thuốc Pinyin Tên" />
                </td>
                <th class="formTitle">Nhà thuốc - Kho thuốc:</th>
                <td class="formValue formDdlSelectorTd">
                    <select id="ddlyfbm" class="form-control required">
                        <option>Tất cả</option>
                    </select>
                </td>
                <td><input type="checkbox" value="Hiển thị bản ghi tồn kho bằng 0" id="checkLkc" style="margin-left:10px;" />Hiển thị bản ghi tồn kho bằng 0</td>
                <td class="formValue">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary" style="width:50px; margin-left:40px;" value="Tra cứu" />
                    <input type="button" id="btn_Excle" class="btn btn-md btn-primary" onclick="Excelbuttion()" style="width:50px; margin-left:40px;" value="Xuất" />
                </td>
            </tr>
        </table>
    </div>
</form>

<div class="gridPanel" style="margin-top:10px">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>
    $(function () {
        initYfbmDdl(); //Tải bộ phận nhà thuốcddl
        gridList(); //Đang tảiGrid
    });
    var gridop = null;
    function gridList() {
        var $gridList = $("#gridList");
        var gridOptins = {
            url: "/Medicine/SelectPriceAdjustmentProfitLossList?r=" + Math.random(),
            height: $(window).height() - 160,
            postData: getSearchPostData(),
            colModel: [
                { label: "Khóa chính", name: "TjsyId", hidden: true, key: true },
                { label: "Mã thuốc", name: "ypCode", width: 60, align: 'left' },
                { label: 'Tên thuốc', name: 'ypmc', width: 120, align: 'left' },
                { label: 'Tên hàng hóa', name: 'spm', width: 120, align: 'left' },
                { label: 'Pinyin', name: 'py', width: 50, align: 'left' },
                { label: 'Quy cách', name: 'ypgg', width: 50, align: 'left' },
                { label: 'Xuất xứ', name: 'ycmc', width: 50, align: 'left' },
                { label: 'Số lượng lúc đó', name: 'Dssl', width: 50, align: 'left' },
                { label: 'Đơn vị', name: 'dw', width: 50, align: 'left' },
                { label: 'Tệp điều chỉnh giá', name: 'Tjwj', width: 70, align: 'left' },
                { label: 'Giá bán buôn gốc', name: 'Ypfj', width: 60, align: 'left' },
                { label: 'Giá bán buôn mới', name: 'Xpfj', width: 70, align: 'left' },
                { label: 'Lợi nhuận giá bán buôn', name: 'Pfjtjlr', width: 50, align: 'left' },
                { label: 'Giá lẻ gốc', name: 'Ylsj', width: 60, align: 'left' },
                { label: 'Giá lẻ mới', name: 'Xlsj', width: 70, align: 'left' },
                { label: 'Lợi nhuận giá lẻ', name: 'Lsjtjlr', width: 50, align: 'left' },
                {
                    label: 'Phạm vi', name: 'mzzybz', width: 80, align: 'left',
                    formatter: function (cellvalue) {
                        if (cellvalue === "0") {
                            return "Dùng chung";
                        } else if (cellvalue === "1") {
                            return "Ngoại trú";
                        } else if (cellvalue === "2") {
                            return "Nội trú";
                        } else {
                            return "";
                        }
                    }
                },
                {
                    label: 'Hiệu lực', name: 'zt', width: 50, align: 'left',
                    formatter: function (cellvalue) {
                        if (cellvalue === "0") {
                            return "Không hiệu lực";
                        } else {
                            return "Hiệu lực";
                        }
                    }
                },
                { label: 'Nhân viên thao tác', name: 'CreatorCode', width: 50, align: 'left' },
                {
                    label: 'Thời gian điều chỉnh', name: 'Tjsj', width: 50, align: 'left',
                    formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' }
                }
            ],
            pager: "#gridPager",
            sortname: 'Tjsj desc'
        };
        $gridList.dataGrid(gridOptins);
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: getSearchPostData()
            }).trigger('reloadGrid');
        });
        //$("#btn_search").trigger('click');
        gridop = gridOptins
    }

    function getSearchPostData() {
        var startTime = $("#startTime").val();
        var endTime = $("#endTime").val();
        var srm = $("#Srm").val();
        var ddlyfbm = $("#ddlyfbm").val();
        var lkc = $("#checkLkc").is(':checked') ? 1 : 0;
        return { startTime: startTime, endTime: endTime, Srm: srm, ddlyfbm: ddlyfbm, Lkc: lkc };
    }

    function initYfbmDdl() {
        $("#ddlyfbm").bindSelect({
            url: "/PharmacyDrugStorage/PharmacyDepartmentList",
            id: "yfbmCode",
            text: "yfbmmc"
        });
    }

    var exportCols = null;
    function Excelbuttion() {
        exportCols = new Array();
        var colsChooseSourceArr = new Array();
        $.each(gridop.colModel, function () {
            if (!(this.hidden === true)) {
                exportCols.push({ Heading: this.label, Name: this.name, Width: this.width });
                colsChooseSourceArr.push({ Heading: this.label, Name: this.name });
            }
        });
        var url = "/DrugStorage/ExcelExportChooseColumns";
        var cols = JSON.stringify(colsChooseSourceArr);
        cols = encodeURIComponent(cols);
        url += "?cols=" + cols;
        $.modalOpen({
            id: "ExcelExportChooseColumns",
            title: "XuấtExcel",
            url: url,
            width: "600px",
            height: "350px",
            callBack: function (iframeId) {
                //Kết quả
                var restArr = top.frames[iframeId].GetChoosedCols();
                if (!!!restArr || !!!restArr.length || restArr.length == 0) {
                    $.modalAlert("Vui lòng chọn cột xuất", 'error');
                    return false;
                }
                var isContainFilter = top.frames[iframeId].GetIsContainFilter();
                //Đóng cửa sổ chọn
                $.modalClose("ExcelExportChooseColumns");
                //
                exportCols = $.jsonWhere(exportCols, function (v) {
                    var matched = false;
                    for (var iIndex = 0; iIndex < restArr.length; iIndex++) {
                        if (restArr[iIndex] == v.Name) {
                            matched = true;
                        }
                    }
                    return matched;
                });
                //Xuất
                Export(isContainFilter);
            }
        });
    }
    function Export(isContainFilter) {

        var startTime = $("#startTime").val();
        var endTime = $("#endTime").val();
        var srm = $("#Srm").val();
        var ddlyfbm = $("#ddlyfbm").val();
        var yfykmc = $("#ddlyfbm option:selected").text()
        var lkc = $("#checkLkc").is(':checked') ? 1 : 0;
        var cols = JSON.stringify(exportCols);
        top.$.cookie('ExportExcelCols', cols, { path: "/" });
        //$.najax({
        // type: "POST",
        // url: "/Medicine/ExcelGet",
        // loading: $.loading("Đang xuấtExcleTệp"),
        // data: { startTime: startTime, endTime: endTime, Srm: srm, ddlyfbm: ddlyfbm, Lkc: lkc, isContainFilter: isContainFilter, yfykmc: yfykmc, colStanWidth: "70", cols: cols },
        // alerterror: false,
        // success: function (res) {

        // }
        //});
        var url = "/Medicine/ExcelGet?";
        url += "startTime=" + startTime;
        url += "&endTime=" + endTime;
        url += "&Srm=" + srm;
        url += "&ddlyfbm=" + ddlyfbm;
        url += "&Lkc=" + lkc;
        url += "&isContainFilter=" + isContainFilter;
        url += "&yfykmc=" + yfykmc;
        url += "&colStanWidth=" + "70"; //Cột tiêu chuẩn chiều rộng cột
        //var cols = JSON.stringify(exportCols);
        //top.$.cookie('ExportExcelCols', cols, { path: "/" });
        //url += "&cols=" + cols;

        window.open(url);
    }

</script>

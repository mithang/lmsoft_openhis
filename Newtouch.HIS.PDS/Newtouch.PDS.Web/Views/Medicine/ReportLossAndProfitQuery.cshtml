@using Newtouch.Infrastructure;
@using Newtouch.Common.Operator;
@{
    ViewBag.Title = "ReportLossAndProfitQuery";
    Layout = "~/Views/Shared/_Index.cshtml";
    var reportUrl = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("ReportUrl");
}

<input hidden id="yfbmcode" value="@Constants.CurrentYfbm.yfbmCode">
<input hidden id="OrganizeId" value="@OperatorProvider.GetCurrent().OrganizeId">
<form id="form1">
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading">
            Thông tin lọc
        </div>
        <table class="form" style="width:98%;border:0">
            <tr>
                <th class="formTitle">Tình hình lãi/lỗ：</th>
                <td style="padding-left:12px;">
                    <div class="btn-group" id="btnLossAndProfitTypeGourp" style="margin-top:0;">
                        <button type="button" id="btnAll" data-keywordtype="All" class="btn active btn-restore">Tất cả</button>
                        <button type="button" id="btnLoss" data-keywordtype="Loss" class="btn btn-default">Báo hỏng</button>
                        <button type="button" id="btnProfit" data-keywordtype="Profit" class="btn btn-default">Báo thừa</button>
                    </div>
                </td>
                <th class="formTitle">Từ khóa：</th>
                <td class="formValue">
                    <input type="text" id="txtINPUTCODE" class="form-control" placeholder="Pinyin thuốc Mã Tên" />
                </td>
                <th class="formTitle">Ngày bắt đầu：</th>
                <td class="formValue">
                    <input type="text" id="txtStartDate" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("yyyy-MM-01 00:00:00")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd  HH:mm:ss' })" />
                </td>
                <th class="formTitle">Ngày kết thúc： </th>
                <td class="formValue">
                    <input type="text" id="txtEndDate" class="form-control input-wdatepicker" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd HH:mm:ss")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd  HH:mm:ss' })" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Nguyên nhân thừa thiếu：</th>
                <td class="formValue">
                    <select class="form-control" id="ddlSYYY">
                        <option value="">Tất cả</option>
                    </select>
                </td>
                <td class="formValue">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary" style="width:50px; margin-left:40px;" value="Tra cứu" />
                </td>
            </tr>
        </table>
    </div>
</form>
<div class="gridPanel" style="margin-top:10px">
    <table id="gridSYXXMXList"></table>
    <div id="gridPager" rel="form1"></div>
</div>
@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
    ShowKeyList = new int[] { 3 },
    F3Text = "In báo hỏng báo thừa"
})

<script>
    $(function () {
        $('#btnLossAndProfitTypeGourp').on('click', '.btn',
            function () {
                if (!$(this).hasClass('active')) {
                    $(this).siblings('.btn').removeClass('btn-restore').removeClass('active').addClass('btn-default');
                    $(this).removeClass('btn-default').addClass('btn-restore active');
                }
            });
        GridSyxxmx();
    });

    //Chi tiết thông tin lãi lỗ
    function GridSyxxmx() {
        var $gridSyxxmxList = $("#gridSYXXMXList");
        $gridSyxxmxList.dataGrid({
            postData: getSearchPostData(),
            url: "/Medicine/SelectLossAndProditInfoList?r=" + Math.random(),
            height: $(window).height() - 265,
            caption: "Tổng lượng thuốc&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span id='yeCon'>Tổng giá bán buôn：" + "0.00" + "đ&nbsp;&nbsp;&nbsp;&nbsp;Tổng giá lẻ：" + "0.00" + "đ</span>",
            colModel: [
                { label: 'Tình hình lãi/lỗ', name: 'syqk', width: 80, align: 'left' },
                { label: 'Nguyên nhân lãi/lỗ', name: 'syyy', width: 110, align: 'left' },
                { label: 'Số chứng từ', name: 'djh', width: 130, align: 'left' },
                { label: 'Tên thuốc', name: 'ypmc', width: 120, align: 'left' },
                { label: 'Số lượng thừa thiếu', name: 'sysl', width: 80, align: 'left' },
                //{ label: 'Đơn vị', name: 'dw', width: 50, align: 'left' },
                { label: 'Giá nhập', name: 'jj', width: 80, align: 'left' },
                { label: 'Giá bán buôn', name: 'pfj', width: 80, align: 'left' },
                { label: 'Tổng giá bán buôn', name: 'pjze', width: 80, align: 'left' },
                { label: 'Giá bán lẻ', name: 'lsj', width: 80, align: 'left' },
                { label: 'Tổng tiền bán lẻ', name: 'ljze', width: 80, align: 'left' },
                { label: 'Thời gian báo cáo', name: 'bgsj', width: 160, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Loại thuốc', name: 'yplb', width: 80, align: 'left' },
                { label: 'Quy cách', name: 'ypgg', width: 120, align: 'left' },
                { label: 'Xuất xứ', name: 'ycmc', width: 120, align: 'left' },
                { label: 'Số lô', name: 'ph', width: 80, align: 'left' },
                { label: 'Hạn sử dụng', name: 'yxq', width: 100, align: 'left' },
                { label: 'Người chịu trách nhiệm', name: 'zrr', width: 80, align: 'left' },
                { label: 'Mã thuốc', name: 'ypCode', hidden: true },
                { label: 'Pinyin', name: 'py', hidden: true },
                { label: 'pjze', name: 'pjze', hidden: true },
                { label: 'ljze', name: 'ljze', hidden: true }
            ],
            multiselect: false,
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords: true,
            loadComplete: function (data) {
                ComputePjzeAndLjze();//Tính tổng giá bán buôn và tổng giá bán lẻ trong thanh tiêu đề
            }
        });
        $("#btn_search").click(function () {
            $gridSyxxmxList.jqGrid('setGridParam',
            {
                url: "/Medicine/SelectLossAndProditInfoList?r=" + Math.random(),
                postData: getSearchPostData()
            }).trigger('reloadGrid');
        });
    }

    //Tải lý do lãi lỗ
    $("#ddlSYYY").bindSelect({
        url: "/Medicine/GetLossProfitReasonListByType?r=" + Math.random(),
        id: "syyyId",
        text: "syyy"
    });

    //Điều kiện truy vấn
    function getSearchPostData() {
        var startTime = $("#txtStartDate").val();
        var endTime = $("#txtEndDate").val();
        var syyy = $("#ddlSYYY").val();
        var inputCode = $("#txtINPUTCODE").val();
        var syqk = -1; //Tất cả
        if ($('#btnLossAndProfitTypeGourp .btn.active').attr('data-keywordtype') === 'Profit') {
            syqk = 1;  //Báo thừa
        } else if ($('#btnLossAndProfitTypeGourp .btn.active').attr('data-keywordtype') === 'Loss') {
            syqk = 2;  //Báo hỏng
        }
        return { startTime: startTime, endTime: endTime, syyy: syyy, inputCode: inputCode, syqk: syqk };
    };

    //Tính tổng giá bán buôn và tổng giá bán lẻ trong thanh tiêu đề
    function ComputePjzeAndLjze() {
        var titlePjze = 0;
        var titleLjze = 0;
        var count = $("#gridSYXXMXList").getGridParam('records');
        if (count > 0) {
            var rowIds = $("#gridSYXXMXList").getDataIDs();
            for (var i = 0; i < rowIds.length; i++) {
                var getRowPjze = $("#gridSYXXMXList").getRowData(rowIds[i]).pjze;
                var getRowLjze = $("#gridSYXXMXList").getRowData(rowIds[i]).ljze;
                titlePjze = parseFloat(titlePjze) + parseFloat(getRowPjze);
                titleLjze = parseFloat(titleLjze) + parseFloat(getRowLjze);
            }
            $("#yeCon").text("Tổng giá bán buôn：" + titlePjze.toFixed(4) + "đ; Tổng giá lẻ：" + titleLjze.toFixed(4) + "đ");
        }
    }

    //Tính tổng giá bán buôn và giá bán lẻ
    function ComputePjzeAndLjze() {
        $.najax({
            url: "/Medicine/ComputePjzeAndLjze",
            dataType: "json",
            data: getSearchPostData(),
            success: function (res) {
                if (res != null) {
                    $("#yeCon").text("Tổng giá bán buôn：" + res.Pjze.toFixed(2) + "đ; Tổng giá lẻ：" + res.Ljze.toFixed(2) + "đ");
                }
            }
        });
    }

    //In tổng hợp
    function newtouch_event_f3() {
		var key = $("#txtINPUTCODE").val();
		var syqk = -1; //Tất cả
		if ($('#btnLossAndProfitTypeGourp .btn.active').attr('data-keywordtype') === 'Profit') {
			syqk = 1;  //Báo thừa
		} else if ($('#btnLossAndProfitTypeGourp .btn.active').attr('data-keywordtype') === 'Loss') {
			syqk = 2;  //Báo hỏng
		}
		var uri = '@reportUrl' + "?tempCode=58&systemCode=PDS" + "&hospitalCode=" + $("#OrganizeId").val() + "&startTime=" + $("#txtStartDate").val() + "&endTime=" + $("#txtEndDate").val() + "&key=" + key + "&yfbm=" + $("#yfbmcode").val() + "&syqk=" + syqk;
		window.open(uri);
		//window.open("/Report/PrintReport?type=BSBY_Query&param=startTime=" + $("#txtStartDate").val() + "|endTime=" + $("#txtEndDate").val() + "|key=" + key + "|yfbm=" + $("#yfbmcode").val() + "|OrganizeId=" + $("#OrganizeId").val() + "|syqk=" + syqk, "height=500, width=1195, top=100, left=50, toolbar=no, menubar=no, scrollbar=yes, resizeble=no, location=no, status=no");
    }
</script>




@{
    ViewBag.Title = "DrugArrangement";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<form id="form1">
    <div class="panel panel-default" style="margin-top:10px;">
        <div class="panel-heading">
            Xếp thuốc ngoại trú
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle">Nhân viên xếp thuốc:</th>
                    <td class="formValue">
                        <input id="txtid" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">Họ tên:</th>
                    <td class="formValue">
                        <input id="txtname" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle ">Số tờ đơn thuốc:</th>
                    <td class="formValue">
                        <input id="txtcf" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle"></th>
                    <td class="formValue">
                        <input type="button" class="btn btn-primary btn-md" id="BtnQuery" value="Tra cứu" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div style="margin-bottom:10px">
        <table id="gridCF"></table>
    </div>
    <div style="margin-bottom:10px">
        <table id="gridCFInfo"></table>
    </div>
    <div class="panel panel-default" style="margin-bottom:10px;">
        <div class="panel-heading">
            Thiết lập
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form" style="padding-left:20px">
                <tr>
                    <th class="formTitle ">Thời gian giãn cách tra cứu:(giây)</th>
                    <td class="formValue">
                        <input id="pycxjgsj" type="number" name="pycxjgsj" class="form-control" />
                    </td>
                    <th class="formTitle">
                    </th>
                    <td class="formValue">
                        <input type="checkbox" id="IsAutoPy" /><span>Tự động xếp thuốc</span>
                    </td>
                    <th class="formTitle ">Thời gian cấp phát thuốc:<label name="dw">(giây)</label></th>
                    <td class="formValue">
                        <input id="pysj" type="number" class="form-control" value="5" />
                    </td>
                    <th></th>
                    <td></td>
                    <th></th>
                    <td></td>
                </tr>
            </table>
        </div>
    </div>
    @Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
    ShowKeyList = new[] { 7, 8 },
    F7Text = "Xếp thuốc",
    F8Text = "Lưu thiết lập"
})
</form>

<script>
    var timer1;//Tự động xếp thuốc
    $(function () {
        gridCF();
        init();
        btn_loaddata();

        if ($("#IsAutoPy").is(':checked')) {
            pyInterval("1");
        };

        $("#IsAutoPy").click(function () {
            var $this = $(this);
            var type = $this.is(':checked') ? "1" : "2";
            pyInterval(type);
        });
    });

    function init() {
        $("#txtcf").val("0");
        loadpyy();
        loadpyhj();
        Loadconfig();
    }


    //Tải nhân viên xếp thuốc
    function loadpyy() {
        $.najax({
            url: "/OutPatientPharmacy/initPYY?r=" + Math.random(),
            dataType: "json",
            async: false,
            cache: false,
            success: function (res) {
                $.loading(false);
                $("#txtid").val(res.UserCode);
                $("#txtname").val(res.UserName);
            }

        });
    }

    //Tải thông tin đơn thuốc
    function loadpyhj() {
        $.najax({
            url: "/OutPatientPharmacy/loadpyhj?r=" + Math.random(),
            dataType: "json",
            async: false,
            cache: false,
            success: function (res) {
                if (res.length !== 0) {
                    $("#txtcf").val(res.length);
                }
            }
        });
    }

    //Tải cấu hình
    function Loadconfig() {
        $.najax({
            url: "/OutPatientPharmacy/Loadconfig?r=" + Math.random(),
            dataType: "json",
            async: false,
            success: function (res) {
                $.loading(false);
                if (res.state === "error") {
                    $.modalAlert(res.message, "error");
                    return;
                }
                $("#IsAutoPy").attr("checked", res.IsAutoPy === "N" ? false : true);
                $("#IsAutoFy").attr("checked", res.IsAutoFy === "N" ? false : true);
                $("#pycxjgsj").val(res.pycxjgsj);
            }

        });
    }

    function gridCF() {
        var $gridCf = $("#gridCF");
        $gridCf.dataGrid({
            height: 150,
            url: "/OutPatientPharmacy/PyInfoSearch?r=" + Math.random(),
            caption: "Danh sách đơn thuốc",
            colModel: [
                { label: 'Số thẻ', name: 'kh', width: 80, align: 'center' },
                { label: 'Họ tên', name: 'xm', width: 80, align: 'left' },
                { label: 'Số hóa đơn', name: 'Fph', width: 100, align: 'center' },
                { label: 'Số đơn thuốc', name: 'cfh', width: 120, align: 'center' },
                { label: 'Tuổi', name: 'nl', width: 50, align: 'center' },
                { label: 'Loại bệnh nhân', name: 'brlxmc', width: 80, align: 'center' },
                { label: 'Cửa sổ thu phí', name: 'sfck', width: 80, align: 'center' },
                { label: 'Bác sĩ', name: 'ys', width: 80, align: 'left' },
                { label: 'Khoa', name: 'ksmc', width: 80, align: 'center' },
                { label: 'Thời gian thu phí', name: 'sfsj', width: 110, align: 'center' },
                { label: 'Mã nội bộ đơn thuốc', name: 'pcfnm', hidden: true }

            ]
        });
        $("#BtnQuery").click(function () {
            $gridCf.trigger('reloadGrid');
        });
    }

    function btn_loaddata(rowid) {
        var $gridCfInfo = $("#gridCFInfo");
        $gridCfInfo.jqGrid("clearGridData");
        var cfh = $("#gridCF").jqGridRowValue().cfh;
        $gridCfInfo.dataGrid({
            height: 150,
            url: "/OutPatientPharmacy/pyDeailInfoSearch?pCfh=" + cfh,
            caption: "Chi tiết đơn thuốc",
            colModel: [
                { label: 'Tên thuốc', name: 'ypmc', width: 100, align: 'left' },
                { label: 'Quy cách', name: 'ypgg', width: 150, align: 'left' },
                { label: 'Số lượng', name: 'sl', width: 100, align: 'left' },
                { label: 'Đơn vị', name: 'dw', width: 100, align: 'left' },
                { label: 'Đơn giá', name: 'dj', width: 100, align: 'left' },
                { label: 'Nhà sản xuất', name: 'ycmc', width: 150, align: 'left' },
                { label: 'Số tiền', name: 'je', width: 100, align: 'left' },
                { label: 'Liều dùng', name: 'jl', width: 100, align: 'left' },
                { label: 'Đơn vị liều', name: 'jldw', width: 100, align: 'left' },
                { label: 'Cách dùng', name: 'yfmc', width: 100, align: 'left' },
                //{ label: 'Tần suất', name: 'pcmc', width: 100, align: 'left' },
                { label: 'Liều lượng', name: 'yl', width: 100, align: 'left' },
                { label: 'Đơn vị liều dùng', name: 'yldw', width: 100, align: 'left' },
                { label: 'Lời dặn bác sĩ', name: 'yszt', width: 100, align: 'left' },
                { label: 'Nhóm thuốc', name: 'czh', width: 100, align: 'left' }
            ]
        });
        var grid = $gridCfInfo.jqGrid()[0].grid;
        $gridCfInfo.jqGrid().setGridParam({ url: "/OutPatientPharmacy/pyDeailInfoSearch?pCfh=" + cfh });
        grid.populate();
    }

    //Xếp thuốc
    function newtouch_globalevent_f7() {
        var id = $("#gridCF").jqGrid("getGridParam", "selrow");
        if (id) {
            var cfnm = $("#gridCF").jqGridRowValue().pcfnm;
            var sfck = $("#gridCF").jqGridRowValue().sfck;
            if (cfnm) {
                $.najax({
                    url: "/OutPatientPharmacy/SetPyInfo?cfnm=" + cfnm + "&&sfck=" + sfck,
                    dataType: "json",
                    cache: false,
                    success: function (res) {
                        if (res.state === "success") {
                            $.modalMsg('Cấp thuốc thành công!', 'success', 1000);
                            $("#gridCF").jqGrid("clearGridData");
                            $("#gridCF").jqGrid('resetSelection');
                            $("#gridCF").trigger("reloadGrid");
                            $("#gridCFInfo").jqGrid("clearGridData");
                            $("#gridCFInfo").jqGrid('resetSelection');
                        } else {
                            $.modalAlert(res.message, 'error');
                        }
                    }
                });
            }
        } else {
            $.modalAlert("Vui lòng chọn thông tin đơn thuốc trước", 'warning');
        }
    }
    //Lưu thiết lập
    function newtouch_globalevent_f8() {
        //var data = $("#form1").formSerialize();
        //$.ajax({
        // type: "POST",
        // url: "/OutPatientPharmacy/SubmitConfig",
        // data: data,
        // dataType: "json",
        // cache: false,
        // success: function (res) {
        // if (res.state === "success") {
        // $.modalMsg('Sửa thành công!', 'success', 1000);
        // }
        // }
        //});
    }

    //Bộ định thời tự động xếp thuốc 1Biểu thị bắt đầu 2Biểu thị kết thúc
    function pyInterval(type) {
        if (type === 1) {
            timer1 = self.setInterval("gridCF()", 50);
        } else {
            window.clearInterval(timer1);
        }
    }
</script>
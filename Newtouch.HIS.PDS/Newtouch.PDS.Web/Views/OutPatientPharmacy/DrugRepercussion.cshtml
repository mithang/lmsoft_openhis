@{
    ViewBag.Title = "DrugRepercussion";
    Layout = "~/Views/Shared/_Index.cshtml";
    var partReturnSwitch = (bool)ViewBag.partReturnSwitch ? "true" : "false";
    var reportUrl = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("ReportUrl");
}
<style>
    .form-control {
        padding: 0 3px;
    }
    .scan-input {
        border: 2px solid #007bff;
        padding: 5px;
    }
</style>
<form id="form1">
    <div class="panel panel-default" style="margin-top:10px;">
        <div class="panel-heading">Điều kiện lọc</div>
        <table class="form">
            <tr>
                <th class="formTitle" style="width:50px;">Số thẻ:</th>
                <td class="formValue">
                    <input type="text" id="kh" class="form-control" placeholder="Số thẻ" />
                </td>
                <th class="formTitle" style="width:50px;">Họ tên:</th>
                <td class="formValue">
                    <input type="text" id="xm" class="form-control" placeholder="Họ tên" />
                </td>
                <th class="formTitle" style="width:60px;">Số đơn thuốc:</th>
                <td class="formValue">
                    <input type="text" id="cfh" class="form-control" />
                </td>
                <th class="formTitle" style="width:60px;">Số hóa đơn:</th>
                <td class="formValue">
                    <input type="text" id="fph" class="form-control" />
                </td>
                <th class="formTitle" style="width:70px;"><span style="color:red;">*</span>Thời gian phát thuốc:</th>
                <td class="formValue" style="width: 220px;">
                    <input id="begindate" type="text" class="form-control input-wdatepicker" style="width:85px;float:left;" value="@DateTime.Now.AddDays(-3).ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                    <span style="float:left;margin:0 5px;">-</span>
                    <input id="enddate" type="text" class="form-control input-wdatepicker" style="width:85px;float:left;" value="@DateTime.Now.AddDays(1).ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                </td>
                <td class="formTitle" style="padding: 15px; width: 50px;">
                    <input type="button" id="btn_search" class="btn btn-primary btn-md" value="Tra cứu" />
                </td>
            </tr>
        </table>
    </div>
</form>
<div id="dv_left" style=" float: left; width: 35%;">
    <table id="gridTYCF"></table>
</div>
<div id="dv_right" style="float: left; width:64.5%; margin-left:0.5%;">
    <table id="gridTYCFInfo"></table>
    <div class="ckbox" style="float:left;margin:10px 10px 12px;">
        <input id="autoprint" name="autoprint" type="checkbox" @ViewBag.autoPrintSwitch><label for="autoprint">Tự động in</label>
    </div>
    @Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
    ShowKeyList = new[] { 7 },
    F7Text = "Trả thuốc",
    WapperInlineStyle = "float:right;width:100px;margin:10px 30px 12px;text-align:right;"
})
</div>
<script>
    var $gridCfList = $("#gridTYCF");
    var $gridCfDetail = $("#gridTYCFInfo");
    $(function () {
        gridTYCF();
        gridTYCFDetail();

        // Quét mã truy xuất thuốc
        $gridCfDetail.on('keydown', '.scan-input', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();

                const inputField = $(this);
                const row = inputField.closest('tr');

                // Có chia lẻ không
                const sfcl = parseInt(row.find('.sfcl').val(), 10);
                var maxEntries = 1;
                if (sfcl === 1) {
                    maxEntries = 1
                } else {
                    maxEntries = parseInt(row.find('.quantity').text(), 10);
                }

                const entries = inputField.val().split(',').filter(entry => entry.trim() !== '').length;

                if (inputField.val() && !inputField.val().endsWith(',')) {
                     inputField.val(removeDuplicates(inputField.val()));
                }

                if (entries >= maxEntries) {
                    $.modalMsg("Đã đạt số lượng mục quét tối đa của dòng này!", "warning", 1500);
                    inputField.val(inputField.val().split(',').filter(entry => entry.trim() != "").slice(0, maxEntries).join(',') + ",");
                }
            }
        });
    });

    function removeDuplicates(str){
        const arr = str.split(',')
        const uniqueArr = [...new Set(arr)]
        return uniqueArr.join(',')+','
    }

    //Gắn sự kiện phím Enter
    $(document).keyup(function (event) {
// if (event.keyCode === 13) {
// $("#btn_search").trigger("click");
// }
    });

    //Lấy dữ liệu
    function gridTYCF() {
        $gridCfList.dataGrid({
            height: $(window).height() - 180,
            caption: "Danh sách đơn thuốc",
            url: "/OutPatientPharmacy/SearchFyCfList",
            postData: $("#form1").formSerialize(),
            colModel: [
                { label: 'Số đơn thuốc', name: 'cfh', width: 115, align: 'center' },
                { label: 'Số hóa đơn', name: 'Fph', width: 70, align: 'center' },
                { label: 'Họ tên', name: 'xm', width: 60, align: 'center' },
                { label: 'Số thẻ', name: 'CardNo', width: 60, align: 'center' },
                {
                    label: 'Thời gian phát thuốc',
                    name: 'fysj',
                    width: 100,
                    align: 'center',
                    formatter: "date",
                    formatoptions: { srcformat: 'Y-m-d H:i', newformat: 'Y-m-d H:i' }
                },
                {
                    label: 'Thời gian thu phí',
                    name: 'sfsj',
                    width: 100,
                    align: 'center',
                    formatter: "date",
                    formatoptions: { srcformat: 'Y-m-d H:i', newformat: 'Y-m-d H:i' }
                }
            ],
            sortname: 'sfsj desc',
            viewrecords: false,
            onSelectRow_page: function (rowid, status) {
                $gridCfDetail.jqGrid("clearGridData");
                $gridCfDetail.jqGrid('setGridParam',
                    {
                        url: "/OutPatientPharmacy/SearchRefundeRpDetail",
                        postData: { cfh: $gridCfList.jqGrid('getRowData', rowid).cfh }
                    }).trigger('reloadGrid');
            },
            beforeRequest: function () {
                $("#gridListPager_left").hide();
                $("#gridListPager_right").hide();
            }
        });
        $("#btn_search").click(function () {
            $gridCfList.jqGrid('setGridParam',
                {
                    postData: $("#form1").formSerialize()
                }).trigger('reloadGrid');
        });
    }

    function gridTYCFDetail() {
        $gridCfDetail.dataGrid({
            height: $(window).height() - 230,
            caption: "Chi tiết đơn thuốc",
            editurl: "clientArray", //Chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            colModel: [
                { label: 'Tên thuốc', name: 'ypmc', width: 110, align: 'left' },
                { label: 'Có thể hoàn', name: 'slstr', width: 40, align: 'left' },
                @*{ label: 'Số lượng', name: 'sl', width: 50, align: 'center', editable:@partReturnSwitch,editwidth:'85%' },*@
                { label: 'Số lượng', name: 'sl', width: 50, align: 'center', classes: 'quantity' },
                { label: 'Đơn vị', name: 'dw', width: 50, align: "left" },
                {
                    label: '<span class="required">*</span>Mã truy xuất', name: 'zsm', width: 80, align: 'center',
                    formatter: function (cellvalue, options) {
                        return "<input name=\"zsm\" id=\"sel_zsm_" + options.rowId + "\" rowid=" + options.rowId + " class=\"scan-input editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" />";
                    }
                },
                {
                    label: '<span class="required">*</span>Có tách lẻ không', name: 'sfcl', width: 80, align: 'center',
                    formatter: function (cellvalue, options) {
                        return "<select name=\"sfcl\" id=\"sel_sfcl_" + options.rowId + "\" rowid=" + options.rowId + " class=\"sfcl editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" ><option value=\"1\">Có</option><option value=\"2\">Không</option></select>";
                    }
                },
                { label: 'Quy cách', name: 'gg', width: 50, align: 'center' },
                { label: 'Số lô', name: 'ph', width: 90, align: 'center' },
                { label: 'Lô', name: 'pc', width: 100, align: 'left' },
                {
                    label: 'Đơn giá',
                    name: 'dj',
                    width: 60,
                    align: 'right',
                    formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0.0000";
                    }
                },
                {
                    label: 'Số tiền',
                    name: 'je',
                    width: 60,
                    align: 'right',
                    formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(2) : "0.00";
                    }
                },
                { label: 'Nhà sản xuất', name: 'ycmc', width: 120, align: 'left' },
                { label: 'Nhóm thuốc', name: 'czh', width: 60, align: 'center' },
                { label: 'Mã thuốc', name: 'ypCode', hidden: true },
                { label: 'ktsl', name: 'ktsl', hidden: true },
                { label: 'zhyz', name: 'zhyz', hidden: true },
                { label: 'cfh', name: 'cfh', hidden: true }
            ],
            multiselect: false,
            viewrecords: true,
            gridComplete: function () {
                EnableInlineEditBox();
            }
        });
    }

    //Bật hộp chỉnh sửa trong dòng
    function EnableInlineEditBox() {
        var rowIds = $gridCfDetail.jqGrid('getDataIDs'); //GridSau khi tải xong, bật chỉnh sửa trong dòng 1.Lấy tất cả các dòng trướcId 2.Duyệt để gọieditRowPhương thức
        for (var i = 0; i < rowIds.length; i++) {
            $gridCfDetail.jqGrid('editRow',
                rowIds[i],
                true,
                null,
                null,
                null,
                null,
                function (callbackRowId) { //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.
                });
        }
    }

    //Trả thuốc
    function newtouch_event_f7() {
        var id = $gridCfList.jqGrid("getGridParam", "selrow");
        if (!id) {
            $.modalAlert("Vui lòng chọn đơn thuốc cần trả thuốc!", 'warning');
            return false;
        }
        var rowIds = $gridCfDetail.jqGrid('getDataIDs'); //Lấy tất cả các dòngId, Duyệt để đưa hộp chỉnh sửa về trạng thái lưu
        var tymx = [];
        //Kiểm tra số lượng trả
        for (var i = 0; i < rowIds.length; i++) {
            $gridCfDetail.saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);
            var rowData = $gridCfDetail.jqGrid('getRowData', rowIds[i]);
            if (!rowData) {
                return false;
            }
            if (rowData.sl.replace(/(^\s*)|(\s*$)/g, "") === "" ||
                rowData.sl === "" ||
                isNaN(rowData.sl) ||
                rowData.sl < 0) {
                $.modalAlert("Hạng mục【" + rowData.ypmc + "】Số lượng trả thuốc phải là số tự nhiên, Vui lòng xác nhận.", "warning");
                EnableInlineEditBox(); //Bật khung sửa trong dòng
                return false;
            }
            if (parseInt(rowData.sl) > parseInt(rowData.ktsl)) {
                $.modalAlert("Hạng mục【" + rowData.ypmc + "】Số lượng trả thuốc không được vượt quá" + rowData.slstr + ".", "warning");
                EnableInlineEditBox(); //Bật khung sửa trong dòng
                return false;
            }
            const rowid = rowIds[i]
            //Mã truy xuất
            var zsm = $("#sel_zsm_" + rowid).val()
            //Có chia lẻ không
            var sfclValue = Number($("#sel_sfcl_" + rowid).val());

            // Kiểm tra số lượng mã truy xuất. Có chia lẻ thì chọn Có, Chỉ cần quét một cái, Nếu không thì cần quét mã tương ứng với số lượng nhập kho
            const zsmLength = $("#sel_zsm_" + rowid).val().split(',').filter(entry => entry.trim() !== '').length
            var maxZsmLength = 1
            if (sfclValue === 1) {
                maxZsmLength = 1
            } else {
                maxZsmLength = parseInt(rowData.sl)
            }
            if (zsmLength != 0 && zsmLength != maxZsmLength) {
                $.modalMsg("Mục: " + rowData.ypmc + " số lượng không khớp với số lượng mã truy xuất!", "warning", 1500);
                return false;
            }
            if (parseInt(rowData.sl) > 0) {
                tymx.push({
                    "ypCode": rowData.ypCode,
                    "sl": rowData.sl,
                    "zhyz": rowData.zhyz,
                    "cfh": rowData.cfh,
                    "ph": rowData.ph,
                    "czh": rowData.czh,
                    "pc": rowData.pc,
                    "zsm": zsm,
                    "sfcl": sfclValue,
                });
            }
        }
        if (tymx.length === 0) {
            $.modalAlert("Không tìm thấy thông tin trả thuốc hợp lệ.", "warning");
            return false;
        }
        $.modalConfirm("Bạn có chắc muốn trả thuốc không??",
            function (flag) {
                if (flag) {
                    $.najax({
                        type: "POST",
                        url: "/OutPatientPharmacy/ExecReturnStorage",
                        data: { tyParam: tymx },
                        dataType: "json",
                        success: function (res) {
                            if (res.state === "success") {
                                if ($("#autoprint").get(0).checked) {
                                    var cfh = $gridCfList.jqGrid('getRowData', id).cfh;
                                    var tydh = JSON.parse(res.data)[0];
                                    var uri = '@reportUrl' + "?tempCode=62&systemCode=PDS" + "&hospitalCode=" + '@ViewBag.OrganizeId' + "&yfbmCode=" + '@ViewBag.yfbmCode' + "&cfh=" + cfh + "&tydh=" + tydh;
                                    window.open(uri);
                                    //window.open("/Report/PrintReport?type=MZTY_Bill&param=OrganizeId=@ViewBag.OrganizeId" + "|yfbmCode=@ViewBag.yfbmCode" + "|cfh=" + cfh + "|tydh=" + tydh);
                                }
                                $.modalMsg('Trả thuốc thành công', 'success', 2000);
                                $gridCfList.jqGrid("clearGridData");
                                $gridCfList.trigger("reloadGrid");
                                $gridCfDetail.jqGrid("clearGridData");
                            }
                        }
                    });
                }
            });
    }
</script>

<script type="text/javascript">
    $('#renewpwd').keyupEnterEvent(function () {
        var newpwd = $.trim($('#newpwd').val());
        var renewpwd = $.trim($('#renewpwd').val());
        if (!!!newpwd || !!!renewpwd) {
            return false;
        }
        if (newpwd != renewpwd) {
            return false;
        }
        btn_submitPwd();
    });
	
    function btn_submitPwd() {
        var newpwd = $.trim($('#newpwd').val());
        var renewpwd = $.trim($('#renewpwd').val());
        if (!!!newpwd || !!!renewpwd) {
            $.modalAlert("Vui lòng nhập mật khẩu", "error");
            return false;
        }
        if (newpwd != renewpwd) {
            $.modalAlert("Hai lần nhập mật khẩu không khớp", "error");//Mật khẩu chưa đủ phức tạp
            return false;
        }
        var ret = /^(?![0-9]+$)(?![a-zA-Z]+$)[0-9A-Za-z]{6,16}$/;
        if (newpwd && !ret.test(newpwd)) {
            $.modalAlert("Mật khẩu chưa đủ phức tạp<br/>6-16 ký tự，phải bao gồm chữ cái và số", "error");//Mật khẩu chưa đủ phức tạp
            return false;
        }
        $.ajax({
            url: "/User/SubmitPersonalPassword",
            data: { newpwd: newpwd, renewpwd: renewpwd },
            type: "post",
            dataType: "json",
            success: function (data) {
                if (data.state == "success") {
                    $.modalAlert("Đặt lại mật khẩu thành công。", "success");
                    location.href = location.href;
                } else {
                    $.modalAlert("Đặt lại mật khẩu thất bại。", "error");
                    location.href = location.href;s
                }
            }
        });
    }
</script>
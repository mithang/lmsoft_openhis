
@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<script>
    var from = $.request("from");
    var organizeId = $.request("organizeId");
    var keyValue = $.request("keyValue");
    var isShowEmpty = $.request("isShowEmpty");
    var isExpand = $.request("isExpand");
    var callbackType = $.request("callbackType");
    var single = $.request("single");
    var fromDialog = $.request("fromDialog");
    var cacheTime = $.request("cacheTime");
    $(function () {
        initControl();
    })
    function initControl() {
        $("#userStaffTree").treeview({
            height: 400,
            slimscroll: false,
            showcheck: true,
            url: "/User/GetSysUserSelectorTree",
            param: { from: from, organizeId: organizeId, keyValue: keyValue, isShowEmpty: isShowEmpty, isExpand: isExpand, cacheTime: cacheTime }
        });
    }
    function submitForm() {
        var treeSeleData;
        if (callbackType == 'json') {
            treeSeleData = $("#userStaffTree").getCheckedNodeObjArray();
            if (single == 'true' && treeSeleData.length != 1) {
                $.modalAlert('Chọn tối đa một dòng', 'warning');
                return;
            }
        }
        else {
            treeSeleData = $("#userStaffTree").getCheckedValues();  //Valuestương ứngUserId
            if (single == 'true' && treeSeleData.length != 1) {
                $.modalAlert('Chọn tối đa một dòng', 'warning');
                return;
            }
            treeSeleData = String(treeSeleData);
        }
        if (false) {

        }
        else if (fromDialog) {
            //Hành vi mặc định，callbackTrướcDialogphương thức của
            top.top.window.frames[fromDialog].userStaffTreeCallback(treeSeleData);
        }
        else {
            //Hành vi mặc định，callbackPhương thức của trang trước
            $.currentWindow().window.userStaffTreeCallback(treeSeleData);
        }
    }
</script>
<form id="form1">
    <div class="widget-body">
        <div id="userStaffTree"></div>
    </div>
</form>



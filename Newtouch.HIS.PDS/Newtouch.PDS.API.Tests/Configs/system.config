<?xml version="1.0" encoding="utf-8"?>
<appSettings>
  <!-- ================== 1：Cấu hình liên quan đến hệ thống phát triển ================== -->
  <!-- Thời gian duy trì danh tính đăng nhập (đơn vị: phút）-->
  <add key="LoginStatusKeepMinute" value="30" />
  <!--BậtIPLọc -->
  <add key="IsIPFilter" value="false" />
  <!-- ================== 2：Cấu hình tham số phần mềm hệ thống ================== -->
  <!-- Liên hệ chúng tôi -->
  <add key="Contact" value="www.newtouch.cn" />
  <!-- Phiên bản phần mềm -->
  <add key="Version" value="1.0" />

  <!-- ReidsCủa bộ nhớ đệmkeyTiền tố Cache Basic -->
  <add key="Reids_Cache_Prefix" value="$C_PDS$"/>
  <!-- Tổ chức cấp cao nhấtId -->
  <add key="Top_OrganizeId" value="d8ee85f8-d8d1-4b5c-bd9e-1761f44242d8"/>
  <!-- Ứng dụngId -->
  <add key="AppId" value="newtouch.his.pds.api.tests"/>

  <!-- Của trạm tĩnhHost -->
  <add key="SiteStaticHost" value="http://59.80.30.157:20103/"/>
  <!--<add key="SiteStaticHost" value="localhost:9061"/>-->
  <!--<add key="SiteStaticHost" value="localhost:20103"/>-->
  <!-- Hệ thống thanh toánAPICủaHost -->
  <!--<add key="SiteSettAPIHost" value="http://59.80.30.157:20137/" />-->
  <add key="SiteSettAPIHost" value="localhost:20136"/>
  <!-- BaseHệ thốngAPICủaHost -->
  <!--<add key="SiteBaseAPIHost" value="http://59.80.30.157:20136/" />-->
  <add key="SiteBaseAPIHost" value="localhost:20951"/>
  <!-- PDS API HOST -->
  <add key="SitePDSAPIHost" value="http://localhost:20138/"/>

  <!-- Của dịch vụ nhật kýUrl -->
  <add key="His.Log.URL" value="http://59.80.30.157:20106/"/>


  <add key="vs:EnableBrowserLink" value="false"/>
</appSettings>
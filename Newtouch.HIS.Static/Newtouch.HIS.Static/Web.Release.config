<?xml version="1.0" encoding="utf-8"?>

<!-- Để biết thêm chi tiết về việc sử dụng chuyển đổi web.config, vui lòng truy cập http://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Trong ví dụ dưới đây，“SetAttributes”chuyển đổi sẽ thay đổi 
    “connectionString”chỉ khi“Match”bộ định vị 
    tìm thấy giá trị“MyDB”thuộc tính“name”thì sử dụng“ReleaseSQLServer”。
    
    <connectionStrings>
      <add name="MyDB" 
        connectionString="Data Source=ReleaseSQLServer;Initial Catalog=MyReleaseDB;Integrated Security=True" 
        xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
    </connectionStrings>
  -->
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <!--
      
      Trong ví dụ dưới đây，“Replace”chuyển đổi sẽ thay thế 
      web.config toàn bộ <customErrors> mục.
      Xin lưu ý, vì 
      tại <system.web> nút chỉ có một customErrors mục, vì vậy không cần sử dụng“xdt:Locator”thuộc tính.
      
      <customErrors defaultRedirect="GenericError.htm"
        mode="RemoteOnly" xdt:Transform="Replace">
        <error statusCode="500" redirect="InternalError.htm"/>
      </customErrors>
    -->
  </system.web>
</configuration>

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<script>
    var keyValue = $.request("keyValue");
    $(function () {
        initControl();
        $.najax({
            url: "/Module/GetFormJson",
            data: { keyValue: keyValue },
            dataType: "json",
            async: false,
            success: function (data) {
                $("#form1").formSerialize(data);
                $("#form1").find('.form-control,select,input').attr('readonly', 'readonly');
                $("#form1").find('div.ckbox label').attr('for', '');
            }
        });
    });
    function initControl() {
        $("#Target").select2({
            minimumResultsForSearch: -1
        });
        $("#ParentId").bindSelect({
            url: "/Module/GetTreeSelectJson",
        });
    }
</script>
<form id="form1">
    <div style="margin-top: 10px; margin-left: 10px; margin-right: 10px;">
        <ul class="nav nav-tabs">
            <li role="presentation" class="active"><a href="#">Thông tin cơ bản</a></li>
        </ul>
        <div style="padding-top: 20px; margin-right: 30px;">
            <table class="form">
                <tr>
                    <th class="formTitle">Cấp trên：</th>
                    <td class="formValue">
                        <select id="ParentId" name="ParentId" class="form-control">
                            <option value="0">Nút cha</option>
                        </select>
                    </td>
                    <th class="formTitle">Tên：</th>
                    <td class="formValue">
                        <input id="Name" name="Name" type="text" class="form-control" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Kết nối：</th>
                    <td class="formValue">
                        <input id="UrlAddress" name="UrlAddress" type="text" class="form-control" />
                    </td>
                    <th class="formTitle">Mục tiêu：</th>
                    <td class="formValue">
                        <select id="Target" name="Target" class="form-control">
                            <option value="">==Vui lòng chọn==</option>
                            <option value="expand" title="expand">Không có trang</option>
                            <option value="iframe" title="iframe">Trang khung</option>
                            <option value="open" title="open">Trang bật lên</option>
                            <option value="blank" title="blank">Cửa sổ mới</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Biểu tượng：</th>
                    <td class="formValue">
                        <div class="input-group">
                            <input id="Icon" name="Icon" type="text" class="form-control">
                            @*<span class="input-group-btn">
                                    <a class="btn  btn-primary"><i class="fa fa-ellipsis-h"></i></a>
                                </span>*@
                        </div>
                    </td>
                    <th class="formTitle">Sắp xếp：</th>
                    <td class="formValue">
                        <input id="px" name="px" type="text" class="form-control" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle" style="height: 35px;">Tùy chọn：</th>
                    <td class="formValue" colspan="3" style="padding-top: 1px;">
                        <div class="ckbox">
                            <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Hiệu lực</label>
                        </div>
                    </td>
                </tr>
                <tr>
                    <th class="formTitle" valign="top" style="padding-top: 5px;">
                        Giới thiệu：
                    </th>
                    <td class="formValue" colspan="3">
                        <textarea id="Description" name="Description" class="form-control" style="height: 100px;"></textarea>
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Người tạo：</th>
                    <td class="formValue">
                        <input id="CreatorCode" name="CreatorCode" type="text" class="form-control" />
                    </td>
                    <th class="formTitle">Thời gian tạo：</th>
                    <td class="formValue">
                        <input id="CreateTime" name="CreateTime" type="text" class="form-control" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Người sửa：</th>
                    <td class="formValue">
                        <input id="LastModifierCode" name="LastModifierCode" type="text" class="form-control" />
                    </td>
                    <th class="formTitle">Thời gian sửa：</th>
                    <td class="formValue">
                        <input id="LastModifyTime" name="LastModifyTime" type="text" class="form-control" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</form>


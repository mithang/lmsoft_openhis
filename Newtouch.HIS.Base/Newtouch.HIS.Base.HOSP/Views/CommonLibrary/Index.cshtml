</div>

<script>
    var valkeyword = "";
    $(function () {
        initControl1();
        initControl2();
        //initControl3();
        initControl4();
        gridList1();
        gridList2();
        gridList3();
        gridList4();
        gridList5();
    });
    //Thuốctab
    function gridList1() {
        var $gridList = $("#gridList1");
        $gridList.dataGrid({
            url: "/CommonLibrary/GetGridJson",
            height: $(window).height() - 130,
            postData: { keyword: $("#txt_keyword_yp1").val(),ypgg: $("#txt_keyword_yp2").val() ,ycmc: $("#txt_keyword_yp3").val(), organizeId: "*",zxyfl:$("#zxyfl").val(), zt: $("#zt").val(), ypflCode: $("#ypflMc").val() === "" ? "" : $("#ypflCode").val(),dlCode:''},
            colModel: [
                { label: "Khóa chính", name: "ypId", hidden: true, key: true },
                {
                    label: 'Đồng bộ', name: 'isSynch', width: 40, hidden: true, align: 'left',
                    formatter: function (cellvalue, options, rowObject) {
                        if (cellvalue === '0') {
                            var $row = JSON.stringify(rowObject).replace(/\"/g, "'");
                            return '<a class="btn btn-default btn-xs" onclick="YibaoUpload(' + $row + ')"><span class="glyphicon glyphicon-refresh"></span></a>';
                        }
                        else if (cellvalue === '1') {
                            return '<a class="btn btn-default btn-xs disabled"><span class="glyphicon glyphicon-refresh"></span></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                { label: "Mã thuốc", name: "ypCode", width: 100, align: 'left' },
                { label: 'Tên thuốc', name: 'ypmc', width: 150, align: 'left' },
                { label: "Mã BHYT", name: "ybdm", width: 100, align: 'left' },
                { label: "Tên BHYT quốc gia", name: "gjybmc", width: 100, align: 'left' },
                { label: "Mã BHYT quốc gia", name: "gjybdm", width: 100, align: 'left' },
                { label: "Mã BHYT nông thôn mới", name: "xnhybdm", width: 100, align: 'left', hidden: true },
                { label: 'Quy cách thuốc', name: 'ypgg', width: 70, align: 'center' },
                { label: 'Số chuẩn thuốc quốc gia', name: 'ypzsm', width: 70, align: 'center' },
                { label: 'Tên thương mại', name: 'spm', width: 100, align: 'left', hidden: true },
                { label: 'Mã chữ cái đầu', name: 'py', width: 100, align: 'left', hidden: true },
                {
                    label: "Tính chất tự trả", name: "zfxz", width: 60, align: 'left', formatter: function (cellVallue) {
                        return cellVallue == 0 ? "Được thanh toán" : (cellVallue == 1 ? "Tự trả" : (cellVallue == 2 ? "Tự trả theo phân loại" : (cellVallue == 3 ? "Hoàn toàn tự trả" : (cellVallue == 4 ? "Hạng A" : (cellVallue == 5 ? "Hạng B" : (cellVallue == 6 ? "Hạng C" : ""))))));
                    }
                },
                {
                    label: "Giá bán lẻ", name: "lsj", width: 60, align: 'left', formatter: "number"
                    , formatoptions: { decimalPlaces: 4, defaultValue: '0.0000' }
                },
                { label: 'Đơn vị đóng gói', name: 'bzdw', width: 80, align: 'left' },
                { label: 'Số lượng lẻ ngoại trú', name: 'mzcls', width: 70, align: 'left' },
                { label: 'Đơn vị lẻ ngoại trú', name: 'mzcldw', width: 70, align: 'left' },
                { label: 'Số lượng lẻ nội trú', name: 'zycls', width: 70, align: 'left' },
                { label: 'Đơn vị lẻ nội trú', name: 'zycldw', width: 80, align: 'left' },
                { label: 'Đơn vị định giá', name: 'djdw', width: 50, align: 'left' },
                { label: 'Tỷ lệ tự trả', name: 'zfbl', width: 50, align: 'left' },
                { label: 'Nhóm lớn', name: 'sfdlMc', width: 50, align: 'left' },
                { label: 'Tên nhà máy dược', name: 'ycmc', width: 80, align: 'left' },
                { label: 'Mã đóng gói thuốc', name: 'ypbzdm', width: 80, align: 'left' },
                {
                    label: 'Cờ ngoại trú/nội trú', name: 'mzzybz', width: 80, align: 'left',
                    formatter: function (cellvalue) {
                        if (cellvalue == "0") {
                            return "Chung";
                        } else if (cellvalue == "1") {
                            return "Ngoại trú";
                        } else if (cellvalue == "2") {
                            return "Nội trú";
                        } else {
                            return "Khác";
                        }
                    }
                },
                {
                    label: 'Giá trần BHYT', name: 'cxjje', width: 80, align: 'left',
                    formatter: function (cxjje) {
                        if (cxjje == 0 || cxjje == null) {
                            return "0.00";
                        } else {
                            return cxjje;
                        }
                    }
                },
                { label: "Hiệu lực", name: "zt", width: 60, align: "center", formatter: function (cellvalue) { return cellvalue == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
                { label: 'Người tạo', name: 'CreatorCode', width: 60, align: 'left' },
                { label: 'Thời gian tạo', name: 'CreateTime', width: 80, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Sửa lần cuối', name: 'LastModifierCode', width: 60, align: 'center' },
                { label: 'Thời gian sửa lần cuối', name: 'LastModifyTime', width: 80, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Sắp xếp', name: 'px', width: 40, align: 'left' }
            ],
            pager: "#gridPager1",
            sortname: 'CreateTime desc',
            viewrecords: true,
            multiselect: true, // Bật chọn nhiều
        });
        $("#btn_search1").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword_yp1").val(),ypgg: $("#txt_keyword_yp2").val() ,ycmc: $("#txt_keyword_yp3").val(), organizeId: "*",zxyfl:$("#zxyfl").val(), zt: $("#zt").val(), ypflCode: $("#ypflMc").val() == "" ? "" : $("#ypflCode").val() },
                page: 1,
            }).trigger('reloadGrid');
        });
    }

    //Sự kiện Enter
    $('#txt_keyword_yp1').keydownEnterEvent(function () {
        $('#btn_search1').trigger('click');
    });

    function initControl1() {
        //Phân loại thuốc
        $('#ypflMc').newtouchFloatingSelector({
            width: 300,
            height: 300,
            caption: "Phân loại thuốc",
            url: '/SysMedicineClassification/GetListSelectJson',
            clickautotrigger: true,
            ajaxparameters: function () {
                return "keyword=" + $.trim($('#ypflMc').val());
            },
            itemdbclickhandler: function ($thistr) {
                $('#ypflCode').val($thistr.attr('data-ypflCode'));
                $('#ypflMc').val($thistr.attr('data-ypflmc'));
            },
            colModel: [{ label: 'Mã', name: 'ypflCode', hidden: true },
            { label: 'Tên', name: 'ypflmc', widthratio: 50 },
            { label: 'Mã chữ cái đầu', name: 'py', widthratio: 50 }
            ]
        });
    }

    function btn_add1() {
        $.modalOpen({
            id: "Form",
            title: "Thêm thuốc hệ thống",
            url: "/CommonLibrary/SysCommonMedicineAdd?orgId=*" ,
            width: "1300px",
            height: "800px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_edit1() {
        let selectedIdList = $("#gridList1").jqGrid('getGridParam', 'selarrrow');
        if (!selectedIdList.length === 1 ) {
            $.modalAlert("Vui lòng chọn một bản ghi để sửa", 'warning');
            return;
        }
        $.modalOpen({
            id: "SysMedicineAdd",
            title: "Sửa thuốc hệ thống",
            url: "/CommonLibrary/SysCommonMedicineAdd?keyValue=" + selectedIdList[0]+"&orgId=*",
            width: "1300px",
            height: "800px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_xy1() {
        debugger;
        var seleRowid = jQuery("#gridList1").jqGrid("getGridParam", "selrow");
        if (!(seleRowid)) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        var xmdm = $("#gridList1").jqGridRowValue().ypCode;
        var xmmc = encodeURIComponent($("#gridList1").jqGridRowValue().ypmc);
        xmmc = xmmc.replace(/%/g, '%25');
        var title = "【" + $("#gridList").jqGridRowValue().ypmc + "】" + "hạn chế sử dụng của";
        $.modalOpen({
            id: "Form",
            title: title,
            url: "/SysChargeItem/YbbxblForm?xmdm=" + xmdm + "&xmmc=" + xmmc,
            width: "600px",
            height: "550px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();

            }
        });
    }
    function btn_Sync1() {
        @*let keyValue = $("#gridList").jqGridRowValue().ypId;*@
        let selectedIdList = $("#gridList1").jqGrid('getGridParam', 'selarrrow');
        if (selectedIdList.length <=  0) {
            $.modalAlert("Vui lòng chọn ít nhất một bản ghi", 'warning');
            return;
        }
        $.najax({
            url: "/CommonLibrary/Sync",
            type: "POST",
            data: {Type:"yp",idList :selectedIdList,organizeId: $("#OrganizeId").val()},
            dataType: "json",
            async: false,
            success: function (data) {
                $.modalAlert(data.message, data.state);
                $('#btn_search1').trigger('click');
            }
        });
        
    }
    //Tải xuống thuốc danh mục BHYT
    function btn_dirSync1() {
        $.modalConfirm("Bạn có chắc muốn đồng bộ thuốc BHYT không？", function (r) {
            if (r) {
                $.loading(true, "Đang đồng bộ dữ liệu...Vui lòng không thao tác");
                $.najax({
                    url: "/CommonLibrary/SyncYbyp",
                    type: "GET",
                    dataType: "json",
                    async: true,
                    success: function (data) {
                        $.modalAlert(data.message, data.state);
                        $('#btn_search1').trigger('click');
                        $.loading(false);
                    }
                });
            } else { 
                

            }
        });

    }

    function btn_allSync1() {
        $.modalConfirm("Bạn có chắc muốn đồng bộ tất cả thuốc không？", function (r) {
            if (r) {
                $.loading(true, 'Đang đồng bộ dữ liệu...');
                $.najax({
                    url: "/CommonLibrary/SyncAllDrug",
                    type: "GET",
                    dataType: "json",
                    async: false,
                    success: function (data) {
                        $.modalAlert(data.message, data.state);
                        $('#btn_search1').trigger('click');
                        $.loading(false);
                    }
                });
            } else {
              
            }
        });


    }
    
    //Đồng bộ thuốc với BHYT
    function YibaoUpload(row) {
        $.najax({
            url: "/SysMedicine/YibaoUploadApi",
            type: "POST",
            data: { ypId: row.ypId, flag: row.zt },
            dataType: "json",
            async: false,
            success: function (data) {
                $.modalAlert(data.message, data.state);
                $('#btn_search1').trigger('click');
            }
        });
    }
    
//Nhóm thu phí lớntab
    function gridList2() {
        var $gridList = $("#gridList2");
        $gridList.dataGrid({
            //treeGrid: true,
            treeGridModel: "adjacency",
            ExpandColumn: "dlCode",
            postData: { keyword: $("#txt_keyword_sfdl1").val(), organizeId: "*",zt:'' },
            url: "/ChargeCategory/GetTreeGridJson",

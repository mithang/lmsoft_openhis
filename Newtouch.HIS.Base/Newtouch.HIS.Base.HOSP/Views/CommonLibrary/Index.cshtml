    @* Tần suất y lệnh *@
    <div class="tab-pane fade" id="yzpc">
        <div class="topPanel">
            <div class="toolbar">
                <div class="btn-group">
                    <a id="NF-add5" class="btn btn-primary" onclick="btn_add5()"><i class="fa fa-plus"></i>Tạo mới</a>
                </div>
                <div class="btn-group">
                    <a id="NF-edit5" class="btn btn-primary" onclick="btn_edit5()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
                </div>
            </div>
            <div class="search">
                <table>
                    <tr>
                        <td>
                            <div class="input-group">
                                <input id="txt_keyword_yzpc" type="text" class="form-control" placeholder="Mã/Tên" style="width: 180px;">
                                <span class="input-group-btn">
                                    <button id="btn_search5" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>

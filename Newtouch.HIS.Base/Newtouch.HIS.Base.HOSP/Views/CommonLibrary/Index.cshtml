                </div>
                <div class="btn-group">
                    <a id="NF-edit4" class="btn btn-primary" onclick="btn_edit4()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
                </div>
            </div>
            <div class="search">
                <table>
                    <tr>
                        <td>
                            <div class="input-group">
                                <input id="txt_keyword_sfxm1" type="text" class="form-control" placeholder="Tên/Mã/Mã chữ cái đầu" style="width: 180px;">
                                <span class="input-group-btn">
                                    <button id="btn_search4" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                                </span>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="toolbar">
                <select id="sfdl" name="sfdl" class="form-control required" style="width:120px">

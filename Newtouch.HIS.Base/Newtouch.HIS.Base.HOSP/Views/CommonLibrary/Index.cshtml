                                <span class="input-group-btn">
                                    <button id="btn_search1" type="button" class="btn btn-primary">
                                        <i
                                            class="fa fa-search"></i></button>
                                </span>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="toolbar">
                @* <div class="btn-group"> *@
                @*     <a id="NF-AllSync" class="btn btn-primary" onclick="btn_allSync1()"><i class="fa fa-plus"></i>Đồng bộ tất cả</a> *@
                @* </div> *@
                <div class="btn-group">
                    <a id="NF-Sync1" class="btn btn-primary" onclick="btn_Sync1()"><i class="fa fa-plus"></i>Đồng bộ</a>

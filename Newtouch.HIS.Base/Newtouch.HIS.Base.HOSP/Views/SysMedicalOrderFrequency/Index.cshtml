
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<div class="topPanel">
    @Html.Partial("_OrganizeIdDDLToolbarSearchView")
    <div class="toolbar">
        <div class="btn-group">
            <a id="NF-add" class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a id="NF-edit" class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        @*<div class="btn-group">
            <a id="NF-delete" class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa</a>
        </div>*@
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Mã/Tên" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>
    $(function () {
        initControl();
        gridList();
    });

    //Tổ chức
    function initControl() {

    }

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/SysMedicalOrderFrequency/GetGridJson",
            postData: getSearchPostData(),
            height: $(window).height() - 125,
            colModel: [
            { label: "yzpcId", name: "yzpcId", width: 100, align: "left", hidden: true },
            { label: "Mã", name: "yzpcCode", width: 100, align: "left" },
            { label: "Tên tần suất", name: "yzpcmc", width: 100, align: "left" },
            { label: "Mô tả tên", name: "yzpcmcsm", width: 100, align: "left" },
            { label: "Số lần thực hiện", name: "zxcs", width: 100, align: "left" },
            { label: "Chu kỳ thực hiện", name: "zxzq", width: 100, align: "left" },
            {
                label: "Đơn vị thời gian chu kỳ thực hiện", name: "zxzqdw", width: 100, align: "left", formatter: function (cellvalue) {
                    if (cellvalue == "1")
                        return "Ngày";
                    else if (cellvalue == "2")
                        return "Giờ";
                    else if (cellvalue == "3")
                        return "Phút";
                }
            },
            { label: "Cờ tuần", name: "zbz", width: 100, align: "left" },
            { label: "Thời gian thực hiện", name: "zxsj", width: 100, align: "left" },
            { label: "Hiệu lực", name: "zt", width: 60, align: "center", formatter: function (cellvalue) { return cellvalue == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
            { label: 'Người tạo', name: 'CreatorCode', width: 60, align: 'left' },
            { label: 'Thời gian tạo', name: 'CreateTime', width: 80, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
            { label: 'Sửa lần cuối', name: 'LastModifierCode', width: 60, align: 'left' },
            { label: 'Thời gian sửa lần cuối', name: 'LastModifyTime', width: 80, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } }
            ]
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: getSearchPostData()
            }).trigger('reloadGrid');
        })
        $("#btn_search").trigger('click');
    }

    //Điều kiện tra cứu
    function getSearchPostData() {
        var keyword = $("#txt_keyword").val();
        var OrganizeId = $("#OrganizeId").val();
        return { keyword: keyword, orgId:OrganizeId };
    };

    //Sự kiện Enter
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    //Thêm mới
    function btn_add() {
        $.modalOpen({
            id: "FormFIEdit",
            title: "Bảo trì tần suất y lệnh",
            url: "/SysMedicalOrderFrequency/Form?orgId=" + $('#OrganizeId').val(),
            width: "500px",
            height: "620px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    //Sửa
    function btn_edit() {
        var seleRowid = jQuery("#gridList").jqGrid("getGridParam", "selrow");
        if (!(seleRowid)) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        var yzpcId = $("#gridList").jqGridRowValue().yzpcId;
        var OrganizeId = $("#OrganizeId").val();
        $.modalOpen({
            id: "FormFIEdit",
            title: "Sửa thông tin",
            url: "/SysMedicalOrderFrequency/Form?yzpcId=" + yzpcId + "&orgId=" + OrganizeId,
            width: "500px",
            height: "620px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    ////Xóa
    //function btn_delete() {
    //    var seleRowid = jQuery("#gridList").jqGrid("getGridParam", "selrow");
    //    if (!(seleRowid)) {
    //        $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
    //        return;
    //    }
    //    var yzpcId = $("#gridList").jqGridRowValue().yzpcId;
    //    var OrganizeId = $("#OrganizeId").val();
    //    $.deleteForm({
    //        url: "/SysMedicalOrderFrequency/DeleteForm",
    //        param: { yzpcId: yzpcId, orgId: OrganizeId },
    //        success: function () {
    //            $("#gridList").trigger("reloadGrid");
    //        }
    //    })
    //}

</script>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="topPanel">
    @Html.Partial("_OrganizeIdDDLToolbarSearchView")
    <div class="toolbar">
        <div class="btn-group">
            <a id="NF-add" authorize="yes" class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a id="NF-edit" class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Mã loại/Mã nhóm lớn" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script>
    $(function () {
        initControl();
        gridList();
    })
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/SysChargeCategoryTypeRelation/GetGridJson",
            height: $(window).height() - 96,
            postData: { keyword: $("#txt_keyword").val(), organizeId: $("#OrganizeId").val() },
            colModel: [
                { label: "Id", name: "Id", hidden: true, key: true },
                { label: "Loại", name: "Type", width: 100, align: 'left' },
                {
                    label: 'Tên loại', name: 'Type', width: 100, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == "OutpatientReg") return 'Hạng mục đăng ký khám';
                        if (cellvalue == "Rehab") return 'Phục hồi chức năng';
                        if (cellvalue == "TCM") return 'Thuốc Đông y';
                        if (cellvalue == "WM") return 'Thuốc Tây';
                        if (cellvalue == "Examination") return 'Kiểm tra';
                        if (cellvalue == "Inspection") return 'Xét nghiệm';
                        if (cellvalue == "RegularItem") return 'Hạng mục thường quy';
                        if (cellvalue == "Diagnose") return 'Hạng mục khám chữa bệnh';
                        if (cellvalue == "cl") return 'Vật tư';
                        if (cellvalue == "JZ") return 'Hạng mục ghi sổ';
                    }
                },
                { label: "Mã nhóm lớn", name: "dlCode", width: 100, align: 'left' },
                { label: "Tên nhóm lớn", name: "dlmc", width: 110, align: 'left' },
                { label: "Hiệu lực", name: "zt", width: 80, align: "center", formatter: function (cellvalue) { return cellvalue == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
                { label: 'Người tạo', name: 'CreatorCode', width: 100, align: 'left' },
                { label: 'Thời gian tạo', name: 'CreateTime', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Sửa lần cuối', name: 'LastModifierCode', width: 100, align: 'left' },
                { label: 'Thời gian sửa lần cuối', name: 'LastModifyTime', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Sắp xếp', name: 'px', width: 40, align: 'left' },
            ],
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword").val(), organizeId: $("#OrganizeId").val() },
            }).trigger('reloadGrid');
        });
    }

    //Sự kiện Enter
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    function initControl() {

    }

    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "Thêm nhóm lớn mới",
            url: "/SysChargeCategoryTypeRelation/Form?orgId=" + $('#OrganizeId').val(),
            width: "550px",
            height: "480px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    function btn_edit() {
        var seleRowid = jQuery("#gridList").jqGrid("getGridParam", "selrow");
        if (!(seleRowid)) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        var keyValue = $("#gridList").jqGridRowValue().Id;
        $.modalOpen({
            id: "Form",
            title: "Sửa nhóm lớn",
            url: "/SysChargeCategoryTypeRelation/Form?keyValue=" + keyValue,
            width: "550px",
            height: "480px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

</script>
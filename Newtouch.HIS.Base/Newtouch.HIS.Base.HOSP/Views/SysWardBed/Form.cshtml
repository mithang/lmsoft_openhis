            <li role="presentation"><a href="#basicInfo" role="tab" data-toggle="tab">Thông tin cơ bản</a></li>
        </ul>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade in active" style="padding-top: 20px; margin-right: 99px; margin-left:69px;" id="basicInfo">
                <table class="form">
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Tổ chức：</th>
                        <td class="formValue formDdlSelectorTd">
                            <select id="OrganizeId" name="OrganizeId" class="form-control required">
                                <option value="">==Vui lòng chọn==</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Mã khu bệnh：</th>
                        <td class="formValue formDdlSelectorTd">
                            <select id="bqCode" name="bqCode" class="form-control required">
                                <option value="">==Vui lòng chọn==</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Phòng bệnh：</th>
                        <td class="formValue formDdlSelectorTd">
                            <select id="bfCode" name="bfCode" class="form-control required">
                                <option value="">==Vui lòng chọn==</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Mã：</th>
                        <td class="formValue">
                            <input type="text" class="form-control required" id="cwCode" name="cwCode" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Tên：</th>
                        <td class="formValue">
                            <input type="text" class="form-control required" id="cwmc" name="cwmc" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Loại giường bệnh：</th>
                        <td class="formValue formDdlSelectorTd">
                            @Html.DropDownList("cwlx", Newtouch.Infrastructure.EnumWardBedType.male.ToDescSelectList(), "==Vui lòng chọn==", new { @class = "form-control required" })
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Hạng giường bệnh：</th>
                        <td class="formValue formDdlSelectorTd">
                           <select id="cwdj" class="form-control required">
                               <option value="">==Vui lòng chọn==</option>
                           </select>
                        </td>
                    </tr>
                    @*<tr>
            <th class="formTitle">Cờ thêm giường：</th>

<?xml version="1.0" encoding="utf-8"?>
<appSettings>
	<!-- ================== 1：Cấu hình liên quan hệ thống phát triển ================== -->
	<!-- Thời gian duy trì danh tính đăng nhập（Đơn vị：Điểm）-->
	<add key="LoginStatusKeepMinute" value="30" />
	<!-- Đá nhau đa thiết bị đầu cuối -->
	<add key="EnableMultipleLoginLimit" value="true" />
	<!-- Đá nhau đa thiết bị đầu cuối-Cùng một tài khoản，Số lượng trực tuyến đồng thời tối đa -->
	<add key="MultipleLoginLimit_Count" value="10" />

	<!--BậtIPLọc（Sau khi bật BậtIPChính sách giới hạn truy cập（Chỉ mở một phần Hoặc Giới hạn truy cập một phần）） -->
	<add key="Is_IPFilter" value="false" />

	<!-- ================== 2：Cấu hình tham số phần mềm hệ thống ================== -->
	<!-- Phiên bản phần mềm -->
	<add key="Version" value="1.00.00.0" />

	<!-- （Cấp cao nhất）Tổ chứcId -->
	<add key="Top_OrganizeId" value="d8ee85f8-d8d1-4b5c-bd9e-1761f44242d8"/>

	<!-- ReidsCủa bộ nhớ đệmkeyTiền tố Cache Basic HOSP -->
	<add key="Reids_Cache_Prefix" value="$C_Base_H$"/>
	<!-- Mật khẩu mặc định của người dùng đăng nhập -->
	<add key="LoginUser_Default_Password" value="123456"/>
	<!-- Ứng dụngId -->
	<add key="AppId" value="newtouch.base.web"/>

	<!-- SETTAPIĐịa chỉ-Đổi danh tính người dùng ủy quyền thống nhất -->
	<add key="UAUserInfoGetAPI" value="http://localhost:7002/api/UA/GetUserInfo"/>


	<!-- Của trang tĩnhHost -->
 	 <add key="SiteStaticHost" value="http://127.0.0.1:8014/"/>

	<!-- Của dịch vụ nhật kýUrl Bỏ--><!--
	<add key="His.Log.URL" value="http://61.172.179.30:1703/"/>-->

	<add key="vs:EnableBrowserLink" value="false"/>

	<!-- Đăng nhập một lầnurl Bỏ--><!--
	<add key="SSOLoginHost" value="http://localhost:16314/Login/Index"/>
	--><!-- Trang chủ đăng nhập một lầnurl Bỏ--><!--
	<add key="SSOHomeHost" value="http://localhost:16314/Home/AuthorizedIndex"/>
	--><!-- Đăng xuất một lầnurl Bỏ--><!--
	<add key="SSOOutLogin" value="http://localhost:16314/Login/OutLogin"/>-->

	<!-- Nhà thuốc/kho thuốcapi URL -->
	<add key="SitePdsAPIHost" value="http://localhost:7004/"/>
	<!-- Báo cáo URL -->
	<add key="ReportUrl" value="http://127.0.0.1:8000/"/>
</appSettings>
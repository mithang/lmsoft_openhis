<?xml version="1.0" encoding="utf-8"?>
<appSettings>
	<!-- ================== 1：Cấu hình liên quan hệ thống phát triển ================== -->
	<!-- Thời gian duy trì danh tính đăng nhập（Đơn vị：Điểm）-->
	<add key="LoginStatusKeepMinute" value="3000" />
	<!-- Đá nhau đa thiết bị đầu cuối -->
	<add key="EnableMultipleLoginLimit" value="false" />
	<!-- Đá nhau đa thiết bị đầu cuối-Cùng một tài khoản，Số lượng trực tuyến đồng thời tối đa -->
	<add key="MultipleLoginLimit_Count" value="10" />

	<!--BậtIPLọc（Sau khi bật BậtIPChính sách giới hạn truy cập（Chỉ mở một phần Hoặc Giới hạn truy cập một phần）） -->
	<add key="Is_IPFilter" value="false" />

	<!-- ================== 2：Cấu hình tham số phần mềm hệ thống ================== -->
	<!-- Phiên bản phần mềm -->
	<add key="Version" value="1.00.00.0" />

	<add key="Top_OrganizeId" value="6d5752a7-234a-403e-aa1c-df8b45d3469f"/>
	<!-- ReidsCủa bộ nhớ đệmkeyTiền tố Cache Basic HOSP -->
	<add key="Reids_Cache_Prefix" value="$C_Base_H$"/>
	<!-- Mật khẩu mặc định của người dùng đăng nhập -->
	<add key="LoginUser_Default_Password" value="123456"/>
	<!-- Ứng dụngId -->
	<add key="AppId" value="BASE"/>

	<!-- Của trang tĩnhHost -->
	<add key="SiteStaticHost" value="http://192.168.9.190:8014/"/>
	<add key="NoticeCorsDomain" value="http://localhost:28341/"/>
	<!-- APIĐịa chỉ-Đổi danh tính người dùng ủy quyền thống nhất -->
	<add key="UAUserInfoGetAPI" value="http://192.168.122.185:7002/api/UA/GetUserInfo"/>

	<!-- Của dịch vụ nhật kýUrl -->
	<add key="His.Log.URL" value="http://116.63.143.14:7008/"/>

	<!-- Khi đăng nhập có hiển thị mã xác minh không -->
	<add key="Is_CheckChkCode" value="true"/>
	<!-- Đường dẫn mặc định tệp cục bộ -->
	<add key="LocalFileBaseDir" value="C:\\"/>

	<add key="vs:EnableBrowserLink" value="false"/>

	<!-- Đăng nhập một lầnurl Trường bỏ -->
	<add key="SSOLoginHost" value="http://192.168.9.190:8005/Login/Index"/>
	<!-- Trang chủ đăng nhập một lầnurl Trường bỏ-->
	<add key="SSOHomeHost" value="http://192.168.9.190:8005/Home/AuthorizedIndex"/>
	<!-- Đăng xuất một lầnurl Trường bỏ -->
	<add key="SSOOutLogin" value="http://192.168.9.190:8005/Login/OutLogin"/>

	<!-- Nhà thuốc/kho thuốcapi URL -->
	<add key="SitePdsAPIHost" value="http://192.168.122.185:7004/"/>
	<add key="ReportUrl" value="http://192.168.9.190:8000/"/>
</appSettings>
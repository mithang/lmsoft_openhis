@{
    ViewBag.Title = "MedicalInsuranceCatalogue";
    Layout = "~/Views/Shared/_Index.cshtml";
    var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}

<ul id="myTab" class="nav nav-tabs">
    <li class="active"><a href="#xz" data-toggle="tab">Tải xuống danh mục loại</a></li>
    <li><a href="#cx" data-toggle="tab">Danh mục loại tra cứu</a></li>
    @*<li><a href="#zdcx" data-toggle="tab">Tra cứu bảng từ điển</a></li>
    <li><a href="#yzry" data-toggle="tab">Tra cứu thông tin nhân viên hành nghề y</a></li>*@
</ul>
<div id="myTabContent" class="tab-content">
    <div class="tab-pane fade in active" id="xz">
        <form>
            <div class="panel panel-default">
                <table class="form">
                    <tr>
                        <th class="formTitle">Danh mục：</th>
                        <td class="formValue" style="width:220px;">
                            <select id="XZNR" name="XZNR" class="form-control">
                                <option value="0">============Vui lòng chọn===========</option>
                                <option value="1301">【1301】Tải xuống danh mục thuốc Tây và thuốc thành phẩm Đông y</option>
                                <option value="1302">【1302】Tải xuống danh mục thuốc thang Đông y</option>
                                <option value="1303">【1303】Tải xuống danh mục chế phẩm cơ sở y tế</option>
                                <option value="1305">【1305】Tải xuống danh mục hạng mục dịch vụ y tế</option>
                                <option value="1306">【1306】Tải xuống danh mục vật tư tiêu hao y tế</option>
                                <option value="1307">【1307】Tải xuống danh mục bệnh và chẩn đoán</option>
                                <option value="1308">【1308】Tải xuống danh mục thao tác phẫu thuật</option>
                                <option value="1309">【1309】Tải xuống danh mục bệnh mạn tính/đặc biệt ngoại trú</option>
                                <option value="1310">【1310】Tải xuống danh mục bệnh trả phí theo bệnh</option>
                                <option value="1311">【1311】Tải xuống danh mục bệnh điều trị phẫu thuật trong ngày</option>
                                <option value="1313">【1313】Tải xuống danh mục hình thái học ung thư</option>
                                <option value="1314">【1314】Tải xuống danh mục bệnh Đông y</option>
                                <option value="1315">【1315】Tải xuống danh mục chứng hậu Đông y</option>

                            </select>
                        </td>
                        <td class="formTitle">Số phiên bản：</td>
                        <td class="formValue">
                            <input type="text" id="BBH" class="form-control" value="0" />
                        </td>
                        <td class="formTitle">
                            <input type="button" id="XiaZai" class="btn btn-primary btn-md" value="Tải xuống danh mục" style="width:55px" />

                        </td>
                        <td class="formTitle" style="text-align:right;">Thuốc/Tên hạng mục：</td>
                        <td class="formValue">
                            <input type="text" id="mlmc" class="form-control" value="" style="width:105px" />
                        </td>
                        <td class="formTitle">
                            <input type="button" id="btn_cx" class="btn btn-primary btn-md" style="float:left" value="Tra cứu" />
                        </td>
                    </tr>
                    <tr>

                        <td class="formValue" style="text-align:left; color:red" colspan="4">
                            <span>
                                Ghi chú:Lần tải xuống đầu tiên truyền số phiên bản“0”    Sau khi thao tác tải xuống, vui lòng đợi5-10Phút
                            </span>
                            Phương thức tải xuống:<span>Một lần<input type="radio" name="rd" value="0" checked="checked"/> Vòng lặp<input type="radio" name="rd" value="1" /></span>
                        </td>
                      
                    </tr>
                </table>
            </div>
            <div class="gridPanel" id="gridPanel1">
                <table id="gridList"></table>
                <div id="gridPager"></div>
            </div>
        </form>
    </div>
    <div class="tab-pane fade" id="cx">
        <form>
            <div class="panel panel-default">
                <table class="form">
                    <tr>
                        <th class="formTitle">*Danh mục：</th>
                        <td class="formValue">
                            <select id="btmlcx" name="btmlcx" class="form-control">
                                <option value="0">============Vui lòng chọn===========</option>
                                <option value="1304">【1304】Tra cứu danh mục thuốc dân tộc</option>
                                <option value="1312">【1312】Tra cứu thông tin danh mục BHYT</option>
                                <option value="1316">【1316】Tra cứu thông tin khớp danh mục y tế với danh mục BHYT</option>
                                <option value="1317">【1317】Tra cứu thông tin khớp danh mục cơ sở y dược</option>
                                <option value="1318">【1318】Tra cứu thông tin giá trần danh mục BHYT</option>
                                <option value="1319">【1319】Tra cứu thông tin tỷ lệ tự trả trước danh mục BHYT</option>

                            </select>
                        </td>
                        <td class="formTitle">*Số trang hiện tại:</td>
                        <td class="formValue">
                            <input type="text" id="pagenum" class="form-control" style="height:26px;width:90px;display:inline" value="" />
                            <input type="button" id="btn_NextPage" class="btn btn-primary btn-md" value="Trang tiếp theo" />
                        </td>
                        <td class="formTitle">*Lượng dữ liệu trang này:</td>
                        <td class="formTitle">
                            <input type="text" id="pagesize" class="form-control" style="height:16px" value="" />
                        </td>
                        <td class="formTitle">*Thời gian cập nhật:</td>
                        <td class="formValue">
                            <input id="gxsj" type="text" class="form-control input-wdatepicker" style="width:120px; float:left;margin-left:1%;" value="@DateTime.Now.AddDays(-180).ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        </td>
                    </tr>
					<tr>
						<td class="formTitle">Mã danh mục y tế:</td>
						<td class="formValue">
							<input type="text" id="drugCode" class="form-control" value="" />
						</td>
						<td class="formTitle">Tên chung:</td>
						<td class="formValue">
							<input type="text" id="drugName" class="form-control" value="" />
						</td>
						<th class="formTitle">Nguồn dữ liệu：</th>
						<td class="formValue">
							<select id="sjly" name="sjly" class="form-control">
								<option value="1">Nguồn dữ liệu cục bộ</option>
								<option value="2">Nguồn dữ liệu BHYT</option>
							</select>
						</td>
						<td class="formTitle">
							<input type="button" id="btn_mlcx" class="btn btn-primary btn-md" value="Tra cứu" />
						</td>
						<td class="formValue"></td>
						<td class="formTitle"></td>
						<td class="formValue"></td>
					</tr>
                </table>
            </div>
            <div class="gridPanel" id="gridPanel2" style="width:100%">
                <table id="gridList2"></table>
            </div>
        </form>
    </div>
    <div class="tab-pane fade" id="zdcx">
        <form>
            <div class="panel panel-default">
                <table class="form">
                    <tr>
                        <td class="formTitle">Loại từ điển:</td>
                        <td class="formValue">
                            <input type="text" id="zdtype" class="form-control" value="" />
                        </td>
                        <td class="formTitle" style="padding-right:5px;">Giá trị khóa từ điển cha:</td>
                        <td class="formValue">
                            <input type="text" id="zdparentValue" class="form-control" value="" />
                        </td>
                        <td class="formTitle" style="padding-right:5px;">Khu vực hành chính:</td>
                        <td class="formValue">
                            <input type="text" id="zdadmdvs" class="form-control" value="" />
                        </td>
                        <td class="formTitle" style="padding-right:5px;">Ngày tra cứu:</td>
                        <td class="formValue">
                            <input id="zddate" type="text" class="form-control input-wdatepicker" style="width:120px; float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        </td>
                        <td class="formTitle" style="padding-right:5px;">
                            <input type="button" id="btn_zdcx" class="btn btn-primary btn-md" value="Tra cứu" style="width:60px;" />
                        </td>
                    </tr>
                </table>
                <div class="gridPanel" id="gridPanel3" style="width:100%">
                    <table id="gridList3"></table>
                </div>
            </div>
        </form>
    </div>

    <div class="tab-pane fade" id="yzry">
        <form>
            @*<div class="panel panel-default">*@
            <table class="form" style="width:350px;">
                <tr>
                    <td class="formTitle">Loại nhân viên hành nghề:</td>
                    <td class="formValue">
                        <select id="prac_psn_type" name="prac_psn_type" class="form-control">
                            <option value="">======Vui lòng chọn=====</option>
                            <option value="1">Bác sĩ</option>
                            <option value="2">Y tá</option>
                            <option value="3">Dược sĩ</option>
                            <option value="4">Nhân viên y kỹ thuật</option>
                        </select>
                    </td>
                    <td class="formTitle" style="padding-right:5px;">
                        <input type="button" id="btn_yzry" class="btn btn-primary btn-md" value="Tra cứu" style="width:60px;" />
                    </td>
                </tr>
            </table>
            <div class="gridPanel" id="gridPanel4" style="width:100%">
                <table id="gridList4"></table>
            </div>
            @*</div>*@
        </form>
    </div>

</div>

    <script type="text/javascript" src="@SiteUrl.GetStaticResourceScriptUrl("~/Content/js/Catalogl.js",false)"></script>
    <script type="text/javascript">

        $(function () {
            $("#pagenum").val(1);
            $("#pagesize").val(100);
        });

        $('#XZNR').change(function () {
            if ($('#XZNR').val()=="0")
            {
                return;
            }
            $("#BBH").val(0);
            $("#mlmc").val("");
            $('#gridList').remove();
            $("#gridPager").remove();
            $("#gbox_gridList").remove();
            $("#gridPanel1").append('<table id="gridList"></table><div id="gridPager"></div>');
            $('#gridList').jqGrid("clearGridData");
            GetVer();
            gridList();
        })

        function GetVer() {
            $.ajax({
                url: "/Settlement/GzybBaseInfo/GetVer",
                dataType: "json",
                async: true,
                data: { tbname: $('#XZNR').val() },
                type: "post",
                success: function (data) {
                    $("#BBH").val(data.bbh);
                },
                error: function (request, error, ex) {
                    $.loading(false);
                    $.modalAlert("Lỗi lấy số phiên bản danh mục：[" + ex + "]", 'error');

                }
            })
        }
        function gridList() {
            var $gridList = $("#gridList");
            var XZNR = $('#XZNR').val();
            $gridList.dataGrid({
                url: "/Settlement/GzybBaseInfo/CatalogueData",
                height: $(window).height() - 160,
                postData: { tbname: XZNR, key: $('#mlmc').val() },
                colModel: mlbh(XZNR),
                pager: "#gridPager",
                sortname: 'VER desc',
                rowNum: '15',
                viewrecords: true
            });

            $("#btn_cx").click(function () {

                $gridList.jqGrid('setGridParam', {
                    postData: { tbname: XZNR, key: $('#mlmc').val() },
                }).trigger('reloadGrid');
            });
        }

        $('#XiaZai').click(function () {
            if($('#XZNR').val()=="0")
            {
                $.modalAlert("Vui lòng chọn danh mục cần tải xuống", 'warning');
                return;
            }
            setTimeout(function () {
                $.loading(true, 'Trong tệp danh mục đang tải xuống Vui lòng đợi một chút...');
                setTimeout(function () { XiaZai(); }, 50);
            }, 50);
        })

        function XiaZai() {
            var XZNR = $('#XZNR').val();
            var bbh = $('#BBH').val();
            var xzfs = $('input[name=rd]:checked').val();
            $.ajax({
                url: "http://127.0.0.1:33333/api/YiBaoDirectory/DownloadIndex",
                dataType: "json",
                async: false,
                data: { ver: bbh, tradiNumber: XZNR, type: xzfs, czydm: '@(opr.rygh)', czyxm: '@(opr.UserName)' },
                type: "post",
                success: function (data) {
                    var Returndata = eval('(' + data + ')');
                    if (Returndata.infcode == "0") {
                        $("#btn_cx").click();
                        GetVer();
                        $.modalAlert("Tải xuống danh mục thành công!", 'success');
                    }
                    else {
                        $.loading(false);
                        if (Returndata.err_msg.indexOf("Đã vi phạm PRIMARY KEY Ràng buộc") == -1) {
                            $.modalAlert(Returndata.err_msg, "error");
                        }
                        else {
                            $("#btn_cx").click();
                            GetVer();
                            $.modalAlert("Đã tải xuống phiên bản mới nhất!", "error");
                        }

                    }

                },
                error: function (request, error, ex) {
                    $.loading(false);
                    $.modalAlert("Dịch vụ BHYT(Giao diện tải xuống danh mục)Không thể truy cập：[" + ex + "]", 'error');

                }

            })


        }
        //Lớp tra cứu danh mục
        $('#btmlcx').change(function () {
            if ($('#btmlcx').val() == "0") {
                return;
            }
            $("#pagenum").val(1);
            $("#drugName").val("");
            $("#drugCode").val("");
            $('#gridList2').remove();
            $("#gbox_gridList2").remove();
            $("#gridPanel2").append('<table id="gridList2"></table>');
            $('#gridList2').jqGrid("clearGridData");
            gridList2();
        })

        function gridList2() {
			var $gridList2 = $("#gridList2");
            var btnMlbh = $("#btmlcx").val();
            $gridList2.newtouchLocalDataGrid({
                height: $(window).height() - 160,
                autowidth: false,
                unwritten: false,
                colModel: mlbh(btnMlbh),
            }, DirectoryQuery());

        }

        $("#btn_mlcx").click(function () {
            if ($('#btmlcx').val() == "0") {
                $.modalAlert("Vui lòng chọn danh mục cần tra cứu", 'warning');
                return;
            }
            //$('#gridList2').remove();
            //$("#gbox_gridList2").remove();
            //$("#gridPanel2").append('<table id="gridList2"></table>');
            $('#gridList2').jqGrid("clearGridData");
            gridList2();
        });
        $("#btn_NextPage").click(function () {
            $("#pagenum").val(parseInt($('#pagenum').val())+1);
            $('#gridList2').jqGrid("clearGridData");
            gridList2();
        });

        //Giá trị trả về khi tra cứu danh mục
        function DirectoryQuery()
		{
			var type = $('#sjly').val();
            var ResultData;
            var drug_prodname = $("#drugName").val();
            var drug_Code = $("#drugCode").val();

            if (drug_Code || drug_prodname)
            {
                $("#pagenum").val(1);
            }
            var updt_time = $('#gxsj').val();
            var page_num = $('#pagenum').val();
            var page_size = $('#pagesize').val();
            var tradiNumber = $("#btmlcx").val();
            var dataReq = { updt_time: updt_time, page_num: page_num, page_size: page_size, tradiNumber: tradiNumber, vali_flag: "1", operatorId: '@(opr.rygh)', operatorName: '@(opr.UserName)' };
            if (tradiNumber = "1304")
            {
                dataReq.med_list_codg = drug_Code;
                dataReq.drug_genname = drug_prodname;
            }
            if (tradiNumber = "1312") {
                dataReq.hilist_code = drug_Code;
                dataReq.hilist_name = drug_prodname;
            }
            if (tradiNumber = "1316")
            {
                dataReq.medins_list_codg = "";
                dataReq.hilist_code = drug_Code;
            }
            if (tradiNumber = "1317") {
                dataReq.med_list_codg = drug_Code;
                dataReq.medins_list_name = drug_prodname;
            }
            if (tradiNumber = "1318") {
                dataReq.med_list_codg = drug_Code;
            }
            if (tradiNumber = "1319") {
                dataReq.hilist_code = drug_Code;
            }
            $.loading(true, 'Đang tải dữ liệu...');
            $.ajax({
                type: "POST",
                url: "http://127.0.0.1:33333/api/YiBaoDirectory/GetCatalogData",
                dataType: "json",
                data:dataReq,
                async: false,
                success: function (data) {
                    ResultData = eval('(' + data + ')');
                    if (ResultData.infcode == "0") {
                        ResultData = ResultData.output.data;
                    }
                    else {
                        $.loading(false);
                        $.modalAlert(ResultData.err_msg, "error");
                    }
                },
                error: function (request, error, ex) {
                    $.loading(false);
                    $.modalAlert("Dịch vụ BHYT(Giao diện tra cứu danh mục)Không thể truy cập：[" + ex + "]", 'error');

                }
            });
            $.loading(false);
            return ResultData;
        }

        //Tra cứu bảng từ điển
        $("#btn_zdcx").click(function () {
            var type = $('#zdtype').val();
            if (!type) {
                $.modalAlert("Loại từ điển không được trống！", 'warning');
                return false;
            }
            var parentValue = $('#zdparentValue').val();
            if (!parentValue) {
                $.modalAlert("Giá trị khóa từ điển cha không được trống！", 'warning');
                return false;
            }
            var admdvs = $('#zdadmdvs').val();
            if (!admdvs) {
                $.modalAlert("Khu vực hành chính không được trống！", 'warning');
                return false;
            }
            var date = $('#zddate').val();
            if (!date) {
                $.modalAlert("Ngày tra cứu không được trống！", 'warning');
                return false;
            }
            $('#gridList3').remove();
            $("#gbox_gridList3").remove();
            $("#gridPanel3").append('<table id="gridList3"></table>');
            $('#gridList3').jqGrid("clearGridData");
            gridList3();

        });

        function gridList3() {
            var $gridList3 = $("#gridList3");
            $gridList3.newtouchLocalDataGrid({
                height: $(window).height() - 160,
                autowidth: false,
                unwritten: false,
                // width: $("#formPat2").width() - 10,
                //caption: captionCon,
                colModel: mlbh("1901"),
            }, DictionaryTable());

        }


        //Giá trị trả về khi tra cứu bảng từ điển
        function DictionaryTable() {
            var type = $('#zdtype').val();
            var parentValue = $('#zdparentValue').val();
            var admdvs = $('#zdadmdvs').val();
            var date = $('#zddate').val();
            //var valiFlag = $('#zdvaliFlag').val();
            var ResultData;
            $.loading(true, 'Đang tải dữ liệu...');
            $.ajax({
                type: "POST",
                url: "http://127.0.0.1:33333/api/YiBao/DictionaryTable",
                dataType: "json",
                data: { type: type, parentValue: parentValue, admdvs: admdvs, date: date, tradiNumber: "1901", vali_Flag: "1", operatorId: operatorId, operatorName: operatorName },
                //data: { updt_time: "2021-06-26", page_num: "1", page_size: "100", tradiNumber: "1304", drug_prodname: "", vali_flag: "1", operatorId: operatorId, operatorName: operatorName},
                async: false,
                success: function (data) {
                    //console.info(data);
                    ResultData = eval('(' + data + ')');
                    ResultData = ResultData.output.list;
                },
                error: function () {
                    $.loading(false);
                    $.modalAlert("Dịch vụ không thể truy cập", 'warning');
                }
            });
            $.loading(false);
            return ResultData;
        }


        $('#prac_psn_type').change(function () {
            newtouch_event_f4();

            $('#gridList4').remove();
            $("#gridPager4").remove();
            $("#gbox_gridList4").remove();
            $("#gridPanel4").append('<table id="gridList4"></table><div id="gridPager4"></div>');
            $('#gridList4').jqGrid("clearGridData");
            MedicalExecutive();
        })


        //Tra cứu thông tin nhân viên hành nghề y
        $("#btn_zdcx").click(function () {
            $('#gridList4').remove();
            $("#gbox_gridList4").remove();
            $("#gridPanel4").append('<table id="gridList4"></table>');
            $('#gridList4').jqGrid("clearGridData");
            MedicalExecutive();
        });
        function MedicalExecutive() {
            var $gridList4 = $("#gridList4");
            $gridList4.newtouchLocalDataGrid({
                height: $(window).height() - 160,
                autowidth: false,
                unwritten: false,
                // width: $("#formPat2").width() - 10,
                //caption: captionCon,
                colModel: [
                    { label: 'Loại giấy tờ của nhân viên', name: 'psn_cert_type', width: 100, align: 'left' },
                    { label: 'Số giấy tờ', name: 'certno', width: 100, align: 'left' },
                    { label: 'Số tự đánh của nhân viên hành nghề', name: 'prac_psn_no', width: 100, align: 'left' },
                    { label: 'Mã nhân viên hành nghề', name: 'prac_psn_code', width: 100, align: 'left' },
                    { label: 'Tên nhân viên hành nghề', name: 'prac_psn_name', width: 100, align: 'left' },
                    { label: 'Phân loại nhân viên hành nghề', name: 'prac_psn_type', width: 60, align: 'left' },
                    { label: 'Mã chứng chỉ hành nghề của nhân viên', name: 'prac_psn_cert', width: 60, align: 'left' },
                    { label: 'Số chứng chỉ hành nghề', name: 'prac_cert_no', width: 60, align: 'left' },
                    { label: 'Cờ bác sĩ BHYT', name: 'hi_dr_flag', width: 60, align: 'left' },
                    { label: 'Thời gian bắt đầu', name: 'begntime', width: 100, align: 'left' },
                    { label: 'Thời gian kết thúc', name: 'endtime', width: 100, align: 'left' },
                    { label: 'Lý do thay đổi', name: 'chg_rea', width: 100, align: 'left' }
                ]
            }, MedicalExecutiveData());

        }
        function MedicalExecutiveData() {
            debugger
            var prac_psn_type = $('#prac_psn_type').val();
            var ResultData;
            $.loading(true, 'Đang tải dữ liệu,Vui lòng đợi...');
            $.ajax({
                type: "POST",
                url: "http://127.0.0.1:33333/api/YiBao/MedicalExecutive",
                dataType: "json",
                data: { prac_psn_type: prac_psn_type, operatorId: operatorId, operatorName: operatorName },
                async: false,
                success: function (data) {
                    //console.info(data);
                    ResultData = eval('(' + data + ')');
                    ResultData = ResultData.output.feedetail;
                },
                error: function () {
                    $.loading(false);
                    $.modalAlert("Dịch vụ không thể truy cập", 'warning');
                }
            });
            $.loading(false);
            return ResultData;
        }


    </script>



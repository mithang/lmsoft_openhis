@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}
@Html.Partial("_YibaoCommonView")
<form name="form1">
    <div class="panel panel-default" style="margin-bottom: 0%;">
        <div class="panel-heading navb-bg">
            Tải xuống thông tin cơ bản BHYT Quý An
        </div>
        <div style="padding-top:1%;padding-bottom:1%; padding-right:7%;" id="divInpatientBasicInfo">
            <table class="form">
                <tr>
                    <td class="formValue">
                        <input type="button" id="btn_icd10" class="btn btn-primary" style="width:40%;margin-left:10%;" value="ICD10Tải xuống" />
                    </td>
                    <td class="formValue">
                        <input type="button" id="btn_fwxm" class="btn btn-primary" style="width:40%;margin-left:10%;" value="Tải xuống danh mục hạng mục" />
                    </td>
                    <td class="formValue">
                        <input type="button" id="btn_codeContrast" class="btn btn-primary" style="width:40%;margin-left:10%;" value="Tải xuống đối chiếu mã" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel" style="margin-top:1%">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>
<script>
    var userId = '@Newtouch.Common.Operator.OperatorProvider.GetCurrent().UserCode;';
    //ICD10Tải xuống
    $('#btn_icd10').click(function () {
        downIcd10();
    })
    //Tải xuống danh mục hạng mục dịch vụ
    $('#btn_fwxm').click(function () {
        downFwxmml();
    })
    //Tải xuống thông tin đối chiếu mã
    $('#btn_codeContrast').click(function () {
        downCodeConstrant();
    })

    //Tải xuốngICD10
    function downIcd10() {
        var folder = getFolder();
        if (folder) {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var filePath = folder + "\\BHYT Quý Châu_Trung tâmICD10Dữ liệu.txt";
            if (fso.FileExists(filePath)) {
                var f = fso.GetFile(filePath);
                f.Delete();
            }
            var GzYB_Icd10_61 = new Object();
            GzYB_Icd10_61.prm_outputfile = filePath;
            var ybjySettReturn_61 = $.guianyibao.UploadICD10(GzYB_Icd10_61);
            if (ybjySettReturn_61 && ybjySettReturn_61.Code == 0) {
                $.modalAlert("BHYTICD10Tải xuống tệp dữ liệu thành công", 'warning');
            } else {
                $.modalAlert("BHYTICD10Tải xuống tệp dữ liệu thất bại" + ybjySettReturn_61.ErrorMsg, 'warning');
            }
        } else $.modalAlert("Vui lòng chọn danh mục nơi đặt", 'warning');
    }

    //Tải xuống danh mục hạng mục dịch vụ
    function downFwxmml() {
        var folder = getFolder();
        var lsh = "";
        if (folder) {
            $.najax({//Lấy số thứ tự lớn nhất của hạng mục BHYT trong hệ thống
                url: "/Settlement/GzybBaseInfo/GetGzybItemCode_MaxLsh",
                dataType: 'text',
                async: false,
                success: function (maxLsh) {
                    lsh = maxLsh;
                }
            });
            if (!lsh) {
                $.modalAlert("Lấy số thứ tự lớn nhất của hạng mục dịch vụ thất bại", 'warning');
                return;
            }
            var liNum = 1;//Cờ dừng vòng lặp
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var filePath = "";
            var fileObj;
            var fileContent = "";
            while (liNum != -1) {
                filePath = folder + "\\BHYT Quý Châu_Danh mục hạng mục dịch vụ" + lsh + ".txt";
                if (fso.FileExists(filePath)) {
                    var f = fso.GetFile(filePath);
                    f.Delete();
                }
                var GzybGetItemCode_91 = new Object();
                GzybGetItemCode_91.prm_aaalsh = lsh;
                GzybGetItemCode_91.prm_outputfile = filePath;
                var itemCodeReturn = new Object();//$.guianyibao.(GzybGetItemCode_91);
                if (itemCodeReturn.Code != 0) {
                    $.modalAlert("Gọi giao diện hạng mục dịch vụ BHYT thất bại" + itemCodeReturn.ErrorMsg, 'warning');
                    return;
                }
                fileObj = fso.OpenTextFile(itemCodeReturn.prm_outputfile, 1);//Mở ở chế độ chỉ đọc
                fileContent = fileObj.ReadAll();
                if ($.trim(fileContent).length > 0) {
                    lsh = fileContent.split(/\t/g)[fileContent.split(/\t/g).length - 1];//Trường cuối cùng là số thứ tự lớn nhất
                }
                else//Nếu trống thì thoát vòng lặp
                    liNum = -1
            }

            var result = $.guianyibaoBase.DealFwxm(folder, "BHYT Quý Châu_Danh mục hạng mục dịch vụ", userId);
            if (result.Code != 0) {
                alert(result.ErrorMsg);
                return;
            }
            $.modalAlert("Tải xuống hạng mục dịch vụ BHYT hoàn tất", 'warning');
        }
    }

    //Tải xuống thông tin đối chiếu mã
    function downCodeConstrant() {
        var CodeInfoReturn_57 = $.guianyibao.BmdzxxQuery();
        if (CodeInfoReturn_57 && CodeInfoReturn_57.Code == 0) {
            $.najax({
                type: "POST",
                url: "/Settlement/GzybBaseInfo/SaveCodeConstrast",
                dataType: "text",
                data: {
                    data: CodeInfoReturn_57.Data
                },
                loading: false,
                success: function (result) {
                    if (result == "0") {
                        $.modalAlert("Lưu thất bại!", 'warning');
                    } else {
                        $.modalAlert("Tải xuống thông tin đối chiếu mã BHYT thành công", 'success');
                    }
                }
            });
        } else {
            $.modalAlert("Tải xuống thông tin đối chiếu mã BHYT thất bại" + CodeInfoReturn_57.ErrorMsg, 'warning');
        }
    }

    //Cung cấp lựa chọn danh mục cục bộ
    function getFolder() {
        try {
            var Message = "\u8bf7\u9009\u62e9\u6587\u4ef6\u5939"; //Thông tin gợi ý của hộp chọn
            var Shell = new ActiveXObject("Shell.Application");
            var Folder = Shell.BrowseForFolder(0, Message, 64, 17); //Danh mục bắt đầu là：Máy tính của tôi
            //var Folder = Shell.BrowseForFolder(0, Message, 0); //Danh mục bắt đầu là：Màn hình nền
            if (Folder != null && Folder.self.Path.indexOf("::") == -1) {
                return Folder.self.Path;
            } else return "";
        }
        catch (e) {
            alert(e.message);
            return "";
        }
    }

</script>

@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<form id="form1">
    <div class="widget-body">
        <div id="orgList"></div>
    </div>
</form>

<div style="position: fixed; bottom: 10px; right: 10px;">
    <a class="btn btn-primary" onclick="btn_authall()">Ủy quyền tất cả</a>
    &nbsp;&nbsp;
    <a class="btn btn-danger" onclick="btn_authcancelall()">Thu hồi tất cả</a>
</div>

<script>
    var keyValue = $.request("keyValue");
    $(function () {
        $("#orgList").treeview({
            height: 400,
            slimscroll: false,
            showcheck: true,
            url: "/Sys/Organize/GetAuthOrganizeList",
            param: { appid: keyValue }
        });
    });
    function submitForm() {
        var postData = {};
        postData["orgList"] = String($("#orgList").getCheckedNodes());
        $.submitForm({
            url: "/Sys/Application/UpdateAuthOrganizeList?keyValue=" + keyValue,
            param: postData,
            success: function () {
                //$.currentWindow().$("#gridList").trigger("reloadGrid");
            }
        })
    }
    function btn_authall() {
        $.modalConfirm("Ủy quyền cho tất cả cơ quan", function (flag) {
            if (flag) {
                var postData = {};
                $.submitForm({
                    url: "/Sys/Application/AuthAllOrganize?keyValue=" + keyValue,
                    param: postData,
                    success: function () {
                        //$.currentWindow().$("#gridList").trigger("reloadGrid");
                    }
                });
            }
        });
    }
    function btn_authcancelall() {
        $.modalConfirm("Thu hồi tất cả ủy quyền", function (flag) {
            if (flag) {
                var postData = {};
                $.submitForm({
                    url: "/Sys/Application/AuthCancelAllOrganize?keyValue=" + keyValue,
                    param: postData,
                    success: function () {
                        //$.currentWindow().$("#gridList").trigger("reloadGrid");
                    }
                });
            }
        });
    }
</script>
<?xml version="1.0" encoding="utf-8"?>

<!-- Liên quan tới việc sử dụng web.config Thông tin chi tiết về chuyển đổi，Vui lòng truy cập https://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
	<!--
    Trong ví dụ dưới đây，“SetAttributes”Chuyển đổi sẽ thay đổi 
    “connectionString”giá trị của，Chỉ khi“Match”Bộ định vị 
    Tìm thấy giá trị là“MyDB”đặc tính của“name”khi sử dụng“ReleaseSQLServer”。
    
    <connectionStrings>
      <add name="MyDB" 
        connectionString="Data Source=ReleaseSQLServer;Initial Catalog=MyReleaseDB;Integrated Security=True" 
        xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
    </connectionStrings>
  -->

	<connectionStrings configSource="Configs\9_190\database.config" xdt:Transform="Replace" />
	<appSettings configSource="Configs\9_190\system.config" xdt:Transform="Replace"  />
	
	<system.web>
		<compilation xdt:Transform="RemoveAttributes(debug)" />
		<!--
      
      Trong ví dụ dưới đây，“Replace”Chuyển đổi sẽ thay thế 
      web.config Toàn bộ của tệp <customErrors> Phần。
      Vui lòng lưu ý，Do 
      Trong <system.web> Chỉ có một dưới nút customErrors Phần，Do đó không cần sử dụng“xdt:Locator”Đặc tính。
      
      <customErrors defaultRedirect="GenericError.htm"
        mode="RemoteOnly" xdt:Transform="Replace">
        <error statusCode="500" redirect="InternalError.htm"/>
      </customErrors>
    -->
	</system.web>
</configuration>
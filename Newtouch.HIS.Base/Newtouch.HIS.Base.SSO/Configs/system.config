<?xml version="1.0" encoding="utf-8"?>
<appSettings>
  <!-- ================== 1: Cấu hình liên quan đến hệ thống phát triển ================== -->
  <!-- Thời gian duy trì danh tính đăng nhập (đơn vị: phút)-->
  <add key="LoginStatusKeepMinute" value="30" />
  <!-- Đăng nhập cùng tài khoản trên nhiều thiết bị sẽ đá nhau -->
  <add key="EnableMultipleLoginLimit" value="true" />
  <!-- Đăng nhập cùng tài khoản trên nhiều thiết bị sẽ đá nhau - cùng một tài khoản, số lượng trực tuyến đồng thời tối đa -->
  <add key="MultipleLoginLimit_Count" value="10" />

  <!--Bật lọc IP (sau khi bật sẽ áp dụng chính sách hạn chế truy cập IP (chỉ mở cho một phần hoặc hạn chế truy cập một phần)) -->
  <add key="Is_IPFilter" value="false" />

  <!-- ================== 2: Cấu hình tham số phần mềm hệ thống ================== -->
  <!-- Phiên bản phần mềm -->
  <add key="Version" value="1.00.00.0" />

  <!-- Id tổ chức (cấp cao nhất) -->
  <add key="Top_OrganizeId" value="d8ee85f8-d8d1-4b5c-bd9e-1761f44242d8"/>
  <!-- Tiền tố key của bộ nhớ đệm Reids Cache Basic HOSP -->
  <add key="Reids_Cache_Prefix" value="$SSO$"/>
  <!-- Mật khẩu mặc định của người dùng đăng nhập -->
  <add key="LoginUser_Default_Password" value="123456"/>
  <!-- Id ứng dụng -->
  <add key="AppId" value="SSO"/>

  <!-- Host của trang tĩnh -->
  <add key="SiteStaticHost" value="http://61.172.179.30:17037/"/>
  
  <!-- Url của dịch vụ nhật ký -->
  <add key="His.Log.URL" value="http://59.80.30.157:20106/"/>

  <add key="vs:EnableBrowserLink" value="false"/>
  <add key="Is_CheckChkCode" value="false"/>
  <add key ="SSOHost" value="http://localhost:2596"/>
</appSettings>
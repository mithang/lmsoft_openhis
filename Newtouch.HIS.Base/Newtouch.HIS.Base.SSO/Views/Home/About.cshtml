    <div class="contentpay">
        <div class="hide_box"></div>
        <div class="shang_box">
            <a class="shang_close" href="javascript:void(0)" onclick="dashangToggle()" title="Đóng">
                <img src="~/Content/img/button_pm_close.png" alt="Hủy" />
            </a>
            <div class="shang_tit">
                <p>Cảm ơn sự ủng hộ của bạn, tôi sẽ tiếp tục cố gắng!</p>
            </div>
            <div class="shang_payimg">
                <img src="~/Content/img/weipayimg.png" alt="Hỗ trợ quét mã" title="Quét mã" />
            </div>
            <div class="pay_explain">Quét mã để thưởng, bạn nói bao nhiêu thì bấy nhiêu</div>
            <div class="shang_payselect">
                <div class="pay_item checked" data-id="weipay">
                    <span class="radiobox"></span>
                    <span class="pay_logo">
                        <img src="~/Content/img/wechat.jpg" alt="WeChat" />
                    </span>
                </div>
                <div class="pay_item" data-id="alipay">
                    <span class="radiobox"></span>
                    <span class="pay_logo">
                        <img src="~/Content/img/alipay.jpg" alt="Alipay" />
                    </span>
                </div>
            </div>
            <div class="shang_info">
                <p>Mở<span id="shang_pay_txt">Alipay</span>Quét một cái là có thể thưởng bằng mã QR rồi</p>
            </div>
        </div>
    </div>
    <script type="text/javascript">
        $(function () {
            $(".pay_item").click(function () {
                $(this).addClass('checked').siblings('.pay_item').removeClass('checked');
                var dataid = $(this).attr('data-id');
                $(".shang_payimg img").attr("src", "/Content/img/" + dataid + "img.png");
                $("#shang_pay_txt").text(dataid == "alipay" ? "Alipay" : "WeChat");
            });
        });
        function dashangToggle() {
            $(".hide_box").fadeToggle();
            $(".shang_box").fadeToggle();
        }
    </script>
</body>
</html>

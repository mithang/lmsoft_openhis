<?xml version="1.0" encoding="utf-8"?>
<appSettings>
  <!-- ================== 1: Cấu hình liên quan đến hệ thống phát triển ================== -->
  <!-- Chế độ nhà cung cấp đăng nhập: Session, Cookie-->
  <add key="LoginProvider" value="Cookie" />
  <!-- Bật nhật ký hệ thống-->
  <add key="IsLog" value="true" />
  <!-- ID ứng dụng-->
  <add key="AppId" value="base.api" />
  <!-- Thời gian timeout của cơ sở dữ liệu-->
  <add key="CommandTimeout" value="180" />
  <!--Bật lọc IP -->
  <add key="IsIPFilter" value="false" />
  <!-- ================== 2: Cấu hình tham số phần mềm hệ thống ================== -->
  <!-- Liên hệ với chúng tôi -->
  <add key="Contact" value="www.Newtouch.cn" />
  <!-- Tên phần mềm -->
  <add key="SoftName" value="Newtouch开发框架" />
  <!-- Phiên bản phần mềm -->
  <add key="Version" value="1.0" />
  <!-- Mã ủy quyền phần mềm, dự phòng để kiểm thử -->
  <add key="LicenceKey" value="83eda07f-ead3-4050-bcee-4f41e57a7e16" />
  <!-- ================== 3: Tham số email bên ngoài ================== -->
  <!-- Thiết lập tên email -->
  <add key="MailName" value="邮件中心" />
  <!-- Thiết lập địa chỉ email -->
  <add key="MailUserName" value="sendbug@Newtouch.cn" />
  <!-- Thiết lập mật khẩu email -->
  <add key="MailPassword" value="123456" />
  <!-- Thiết lập máy chủ email -->
  <add key="MailHost" value="smtp.ym.163.com" />

  <add key="vs:EnableBrowserLink" value="false"/>
  <!-- ================== 4: Tham số in ấn ================== -->
  <add key="CFPrint" value="false" />
  <!-- ================== 5: Cấu hình phòng dược ================== -->
  <add key="YFPZparm" value="mzyf,zyyf" />

  <!-- Cấu hình Id Module phần quan trọng -->
  <!-- Id tổ chức (cấp cao nhất) -->
  <add key="Top_OrganizeId" value="d8ee85f8-d8d1-4b5c-bd9e-1761f44242d8"/>
  
  <!-- Tiền tố key của bộ nhớ đệm Reids Cache Basic HOSP -->
  <add key="Reids_Cache_Prefix" value="$C_Base_A$"/>
  
  <!-- Mật khẩu mặc định của người dùng đăng nhập -->
  <add key="LoginUser_Default_Password" value="123456"/> 

  <!-- Url của dịch vụ nhật ký -->
  <add key="His.Log.URL" value="http://59.80.30.157:20106/"/>

</appSettings>
<script>
	$(function () {
		gridList();
		//$("#btn_searchyb").click(function () {
		//	$('#gridJSMXList').jqGrid("clearGridData");//Xóa chi tiết trước
		//	btn_selectmx();
		//});

		//$("#btn_save").click(function () {

		//	btn_save();
		//});
	});
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "@Url.Action("GetMldzxxlist")",
            height: 500,
            postData: getpostData(),
            rowNum: 16,
            rownumbers: true,
            unwritten: false,
            pager: "#gridPager",
            viewrecords: true,
            colModel: [
                { label: "Khóa chính", name: "Id", hidden: true, frozen: true, key: true },
                { label: 'Tên', name: 'name', width: 300, align: 'center', sortable: false },
                { label: 'Mã', name: 'code', width: 100, align: 'center', sortable: false },
                { label: "Mã BHYT quốc gia", name: "gjybdm", width: 200, align: 'center', sortable: false },
                { label: 'Quy cách thuốc', name: 'gg', width: 150, align: 'center', sortable: false },
                { label: 'Đã đối chiếu chưa', name: 'isdz', width: 110, align: 'center', sortable: false },
                {
                    label: "Thao tác", name: "cz", width: 80, align: "center", formatter: function (cellvalue, options, rowObject) {
                        //return rowObject.code + "" + rowObject.gjybdm;
                        return "<input type=\"button\" id=\"btn_searchsc\" onclick=\"mldzsc('" + rowObject.code + "','" + rowObject.gjybdm + "','" + rowObject.name + "')\" class=\"btn btn-primary\" style=\"width: 20%;  \" value=\"Tải lên\" />&nbsp;&nbsp;&nbsp;&nbsp;<input type=\"button\" id=\"btn_searchcx\" onclick=\"mldzcx('" + rowObject.code + "','" + rowObject.gjybdm + "','" + rowObject.name + "')\" class=\"btn btn-primary\" style=\"width: 20%; \" value=\"Thu hồi\" />"
                    }
                },
            ],

            onSelectRow_page: function (rowid) {
                //btn_selectrow();
            },
            gridComplete: function (gridJszbList) {
                jszbList = null;
                if (gridJszbList && gridJszbList.rows) {
                    jszbList = gridJszbList.rows;
                }
            }
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: getpostData(),
                page: 1,
            }).trigger('reloadGrid');
            //$("#txt_gjybdm").val("");
            //$("#txt_pzwh").val("");
            //$("#txt_scqy").val("");
        });
    }
    function mldzsc(code, gjybdm,name) {
        $.ajax({
            type: "POST",
            url: "http://127.0.0.1:33333/api/YiBao/CatalogComparison3301",
            dataType: "json",
            data: { code: code, gjybdm: gjybdm, name: name, type: $('input:radio:checked').val()},
            async: false,
            success: function (data) {
                var ybmlsc = eval('(' + data + ')');
                if (ybmlsc.infcode == "0") {
                    $.modalAlert("Tải lên đối chiếu danh mục thành công!", 'success');
                    $('#btn_search').trigger('click');
                }
                else {
                    $.modalAlert("Tải lên đối chiếu danh mục thất bại:" + ybmlsc.err_msg, 'error');
                    $('#btn_search').trigger('click');
                }
            },
            error: function () {
                $.loading(false);
                $.modalAlert("Dịch vụ không truy cập được", 'warning');
            }
        });
    }
        function mldzcx(code, gjybdm, name) {
        $.ajax({
            type: "POST",
            url: "http://127.0.0.1:33333/api/YiBao/CatalogComparison3302",
            dataType: "json",
            data: { code: code, gjybdm: gjybdm, name: name, type: $('input:radio:checked').val() },
            async: false,
            success: function (data) {
                var ybmlsc = eval('(' + data + ')');
                if (ybmlsc.infcode == "0") {
                    $.modalAlert("Thu hồi đối chiếu danh mục thành công!", 'success');
                    $('#btn_search').trigger('click');
                }
                else {
                    $.modalAlert("Thu hồi đối chiếu danh mục thất bại:" + ybmlsc.err_msg, 'error');
                    $('#btn_search').trigger('click');
                }
            },
            error: function () {
                $.loading(false);
                $.modalAlert("Dịch vụ không truy cập được", 'warning');
            }
        });
    }
	//Chi tiết quyết toán jGridKhai báo
	$('#gridJSMXList').newtouchLocalDataGrid({
		height: $(window).height() - 520,
		caption: "Thông tin thuốc BHYT",
		unwritten: false,
		colModel: [
			{ label: 'Mã BHYT quốc gia', name: 'ypdm', width: 180, align: 'center' },
			{ label: 'Tên BHYT', name: 'zcmc', width: 200, align: 'center'},
			{ label: 'Tên thuốc BHYT', name: 'ybypmc', width: 80, align: 'center' },
			{ label: 'Quy cách', name: 'sjgg', width: 110, align: 'center' },
			{ label: 'Số đăng ký', name: 'pzwh', width: 130, align: 'center' },
			{ label: 'Dạng bào chế', name: 'sjjx', width: 60, align: 'center' },
			{ label: 'Doanh nghiệp sản xuất', name: 'scqy', width: 180, align: 'center' },
			{ label: 'Loại A/B', name: 'jyl', width: 80, align: 'center' },
			{ label: 'Tên thương mại', name: 'spmc', width: 100, align: 'center' },
			{ label: 'Doanh nghiệp dược', name: 'ypqy', width: 180, align: 'center' },
			{ label: 'Dạng bào chế BHYT', name: 'ybjx', width: 80, align: 'center' },
			{ label: 'Ghi chú', name: 'bz', width: 80, align: 'center' },
			{ label: 'Nguồn dữ liệu', name: 'sjly', width: 60, align: 'center' },
			{ label: 'Chất liệu bao bì', name: 'bzcz', width: 80, align: 'center' },
			{ label: 'Số lượng đóng gói nhỏ nhất', name: 'zxbzsl', width: 40, align: 'center' },
			{ label: 'Đơn vị bào chế nhỏ nhất', name: 'zxzjdw', width: 40, align: 'center' },
			{ label: 'Đơn vị đóng gói nhỏ nhất', name: 'zxbzdw', width: 80, align: 'center' },
			{ label: 'Số hiệu', name: 'bh', width: 80, align: 'center' },


		],
		viewrecords: true,
		//ondblClickRow: function (row) {
		//	btn_clickrow();
		//}
	});

	function btn_selectmx() {

		var ypid = $("#gridList").jqGrid('getGridParam', 'selrow');
		if (!ypid) {
			$.modalMsg("Vui lòng chọn thông tin thuốc cần đối mã", "warning", 1000);
			return false;
		}

		var pzwh = $("#txt_pzwh").val();
		var scqy = $("#txt_scqy").val();
		$('#gridJSMXList').jqGrid("clearGridData");
		$.najax({
			type: "POST",
			url: "@Url.Action("GetYpypxxlist")",
			data: { gjybdm: $("#txt_gjybdm").val(), ypmc: scqy, py:'' , pzwh: pzwh },
			dataType: "json",
			success: function (ajaxresp) {

				$('#gridJSMXList').newtouchLocalDataGrid(null, ajaxresp);
			}
		});
	}
	function btn_selectrow() {
		var gjybdm = $("#gridList").jqGridRowValue().gjybdm;
		var ypmc = $("#gridList").jqGridRowValue().ypmc;
		var yppy = $("#gridList").jqGridRowValue().py;
		var pzwh = $("#gridList").jqGridRowValue().pzwh;
		if (gjybdm != null && gjybdm!="0") {
			$("#txt_gjybdm").val(gjybdm)
		} else {
			$("#txt_gjybdm").val(ypmc);
		}

		$("#txt_pzwh").val("");
		$("#txt_scqy").val("");
		//Mỗi lần nhấp, Xóa chi tiết dòng trước và tổng cộng
		$('#gridJSMXList').jqGrid("clearGridData");
		$.najax({
			type: "POST",
			url: "@Url.Action("GetYpypxxlist")",
			data: { gjybdm: $("#txt_gjybdm").val(), ypmc: '', py: '', pzwh: '' },
			dataType: "json",
			success: function (ajaxresp) {
				$('#gridJSMXList').newtouchLocalDataGrid(null, ajaxresp);
			}
		});
	}


	//Lưu đối mã
	function btn_save() {

		var ypid = $("#gridList").jqGrid('getGridParam', 'selrow');
		if (!ypid) {
			$.modalMsg("Vui lòng chọn thông tin thuốc cần đối mã", "warning", 1000);
			return false;
		}
		var ybid = $("#gridJSMXList").jqGrid('getGridParam', 'selrow');
		if (!ybid ){
			$.modalMsg("Vui lòng chọn thông tin thuốc BHYT", "warning", 1000);
			return false;
		}
		var ybxx = {
			ypdm: $("#gridJSMXList").jqGridRowValue().ypdm,
			zcmc: $("#gridJSMXList").jqGridRowValue().zcmc,
			jyl: $("#gridJSMXList").jqGridRowValue().jyl,
		};
		var ypId = $("#gridList").jqGridRowValue().ypId;
		var zfxz = ybxx.jyl == "甲" ? "4" : ybxx.jyl == "乙" ? "5" : ybxx.jyl == "丙" ? "6" : "1";
		$.najax({
			type: "POST",
			url: "@Url.Action("SaveYpYb")",
			data: { ybxx: ybxx, ypId: ypId},
			dataType: "json",
			success: function (data) {

				if (data != null && data !== "") {
					//gridList();
					$.modalAlert("Đối mã thuốc này thành công", 'success');
					//$("#txt_gjybdm").val("");
					//$('#btn_search').trigger('click');
					$("#txt_pzwh").val("");
					$("#txt_scqy").val("");
					var datarow = {
						gjybdm: $("#gridJSMXList").jqGridRowValue().ypdm,
						gjybmc: $("#gridJSMXList").jqGridRowValue().zcmc,
						zfxz: zfxz,
					};
					$("#gridList").jqGrid('setRowData', ypid, datarow);
				}
			}
		});
	}


	function getpostData() {
		return {
			keyword: $("#txt_keyword").val(), type: $('input:radio:checked').val()
		};
	}

</script>

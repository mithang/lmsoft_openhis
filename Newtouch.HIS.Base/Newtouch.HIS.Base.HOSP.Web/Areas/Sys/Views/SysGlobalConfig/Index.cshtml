
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-default" onclick="$.reload()" aria-label="Tải lại" title="Tải lại"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a id="NF-add" authorize="yes" class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a id="NF-edit" authorize="yes" class="btn btn-default" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Tên/Mã" style="width: 200px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary" aria-label="Tìm kiếm" title="Tìm kiếm"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>
    $(function () {
        gridList()
    })
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            postData: { keyword: $("#txt_keyword").val() },
            url: "/Sys/SysGlobalConfig/GetGridJson",
            height: $(window).height() - 128,
            colModel: [
                 { label: "Khóa chính", name: "Id", hidden: true, key: true, frozen: true },
                { label: "Tên", name: "Name", width: 150, align: 'left', frozen: true },
                    { label: 'Mã', name: 'Code', width: 60, align: 'left' },
                    { label: 'Giá trị', name: 'Value', width: 60, align: 'left' },
                    { label: 'Mô tả', name: 'Memo', width: 150, align: 'left' },
                    { label: 'Thứ tự', name: 'px', width: 40, align: 'left' },
                  { label: "Hiệu lực", name: "zt", width: 60, align: "center", formatter: function (cellvalue) { return cellvalue == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
                { label: 'Thời gian tạo', name: 'CreateTime', width: 80, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Thời gian sửa cuối', name: 'LastModifyTime', width: 80, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
            ],
            pager: "#gridPager",
            sortname: 'CreateTime desc',
        });
        $("#btn_search").click(function () {
            $("#gridList").jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword").val()},
            }).trigger('reloadGrid');
        });
    }

    //Sự kiện nhấn Enter
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "Thêm cấu hình toàn cục mới",
            url: "/Sys/SysGlobalConfig/Form",
            width: "500px",
            height: "470px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    function btn_edit() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        $.modalOpen({
            id: "Form",
            title: "Sửa cấu hình toàn cục",
            url: "/Sys/SysGlobalConfig/Form?keyValue=" + keyValue,
            width: "500px",
            height: "470px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

</script>

<script>
// PER-APP (B) redesign: nut "Sua" chi bat khi co dong duoc chon (trang thai truc quan;
// handler btn_edit() von da chan khi chua chon - day chi la lop vo hieu truc quan).
$(function () {
    try {
        var $editBtn = $(".toolbar a[onclick=\"btn_edit()\"]");
        function rdSyncEditState() {
            var sel = $("#gridList").jqGrid("getGridParam", "selrow");
            var has = !!sel;
            $editBtn.toggleClass("disabled", !has);
            $editBtn.attr("aria-disabled", has ? "false" : "true");
        }
        $("#gridList").on("jqGridSelectRow jqGridGridComplete jqGridAfterGridComplete", rdSyncEditState);
        rdSyncEditState();
    } catch (e) { /* tang cuong giao dien: khong lam hong trang neu luoi chua khoi tao */ }
});
</script>

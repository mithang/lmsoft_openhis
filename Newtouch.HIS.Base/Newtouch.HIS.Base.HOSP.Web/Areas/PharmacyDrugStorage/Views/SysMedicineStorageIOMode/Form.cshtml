@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<form id="form1">
    <div style="padding-top: 20px; margin-right: 30px;">
        <table class="form">
            <tr>
                <th class="formTitle"><span class="required">*</span>Tên:</th>
                <td class="formValue">
                    <input id="crkfsmc" name="crkfsmc" type="text" class="form-control required" placeholder="Vui lòng nhập tên" />
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>Mã:</th>
                <td class="formValue">
                    <input id="crkfsCode" name="crkfsCode" type="text" class="form-control required" placeholder="Vui lòng nhập mã" />
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>Cờ xuất/nhập kho:</th>
                <td class="formValue">
                    @Html.DropDownList("crkbz", EnumCrkbz.In.ToDescSelectList(), "==Vui lòng chọn==", new { @class = "form-control" })
                </td>
            </tr>
            <tr>
                <th class="formTitle">Thứ tự:</th>
                <td class="formValue">
                    <input id="px" name="px" type="text" class="form-control" placeholder="" />
                </td>
            </tr>
            <tr>
                <th class="formTitle" style="height: 35px;">Trạng thái:</th>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Hiệu lực</label>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    var keyValue = $.request("keyValue");
    $(function () {
        if (!!keyValue) {
            $.najax({
                url: "/PharmacyDrugStorage/SysMedicineStorageIOMode/GetFormJson",
                data: { keyValue: keyValue },
                dataType: "json",
                async: false,
                success: function (data) {
                    $("#form1").formSerialize(data);
                }
            });
        }
        else {
            $.najax({
                url: "/HOME/GetNewFieldUniqueValue?orgIdIsStar=true&topOrgIdIsStar=true&initFieldLength=8&fieldName=xt_ypcrkfs.crkfsCode&r=" + Math.random(),
                dataType: "json",
                cache: false,
                success: function (data) {
                    $('#crkfsCode').val(data.data);
                }
            });
        }
    });
    function submitForm() {
        if (!$('#form1').formValid()) {
            return false;
        }
        $.submitForm({
            url: "/PharmacyDrugStorage/SysMedicineStorageIOMode/submitForm?keyValue=" + keyValue,
            param: $("#form1").formSerialize(),
            success: function (data) {
                $.currentWindow().$("#gridList").resetSelection();
                $.currentWindow().$("#gridList").trigger("reloadGrid");
            }
        })
    }

</script>
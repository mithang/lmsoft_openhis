@using Newtouch.Infrastructure
@{
    ViewBag.Title = "RegistorIndex";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="topPanel">
    @Html.Partial("_OrganizeIdDDLToolbarSearchView")
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa</a>
        </div>
        @*<div class="btn-group">
                <a class="btn btn-primary" onclick="btn_users()"><i class="fa fa-pencil-square-o"></i>Người dùng vai trò</a>
            </div>*@
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Tên/Mã" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>
<script>
    $(function () {
        gridList();
    })
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/AccessManage/Registor/GetRegistorList",
            height: $(window).height() - 120,
            postData: { keyword: $("#txt_keyword").val(), org: $("#OrganizeId").val() },
            colModel: [
                { label: "Khóa chính", name: "Id", hidden: true, key: true },
                { label: 'Tên', name: 'RegName', width: 150, align: 'left' },
                { label: "Mã", name: "RegCode", width: 150, align: 'left' },
                {
                    label: 'Cấp quyền', name: 'AuthorizedLev', width: 100, align: 'left', formatter: function (cellvalue) {
                        //var val = $.enum.getDescByValue("EnumAuthorizedLev", cellvalue);
                        if (cellvalue ==@((int)EnumAuthorizedLev.imitatelogin)) {
                            return "Đăng nhập mô phỏng";
                        }
                        else if (cellvalue ==@((int)EnumAuthorizedLev.saltaccess)) {
                            return "Đăng nhập ủy quyền";
                        }else if (cellvalue ==@((int)EnumAuthorizedLev.tokenaccess)) {
                            return "Đăng nhập bằng khẩu lệnh";
                        }return "";
                    }
                },
                {
                    label: 'Thời hạn ủy quyền', name: 'AuthorizedPeriod', width: 100, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue ==@((int)EnumAuthorizedPeriod.longtime)) {
                            return "Hiệu lực vĩnh viễn";
                        }
                        else if (cellvalue ==@((int)EnumAuthorizedPeriod.month)) {
                            return "1 tháng";
                        }else if (cellvalue ==@((int)EnumAuthorizedPeriod.partyear)) {
                            return "Nửa năm";
                        }else if (cellvalue ==@((int)EnumAuthorizedPeriod.year)) {
                            return "1 năm";
                        }return "";                    }
                },
                { label: 'Ghi chú', name: 'Memo', width: 200, align: 'left' },
                { label: "Hiệu lực", name: "zt", width: 60, align: "left", formatter: function (cellvalue) { return cellvalue == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
                { label: 'Người tạo', name: 'CreatorCode', width: 60, align: 'left' },
                { label: 'Thời gian tạo', name: 'CreateTime', width: 80, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Sửa cuối', name: 'LastModifierCode', width: 60, align: 'left' },
                { label: 'Thời gian sửa cuối', name: 'LastModifyTime', width: 80, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Thứ tự', name: 'px', width: 40, align: 'left' }
            ],
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords: true
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword").val(), org: $("#OrganizeId").val() },
            }).trigger('reloadGrid');
        });
    }

    //回车事件
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "Đăng ký",
            url: "/AccessManage/Registor/Form" + "?org=" + $("#OrganizeId").val(),
            width: "600px",
            height: "520px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_edit() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        $.modalOpen({
            id: "Form",
            title: "Sửa đơn đăng ký",
            url: "/AccessManage/Registor/Form?keyValue=" + keyValue + "&org=" + $("#OrganizeId").val(),
            width: "600px",
            height: "520px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
</script>
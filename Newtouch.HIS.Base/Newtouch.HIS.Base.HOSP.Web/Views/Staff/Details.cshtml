@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<script>
    var keyValue = $.request("keyValue");
    $(function () {
        initControl();
        $('#myTab a:first').tab('show');

        if (!!keyValue) {
            $.najax({
                url: "/Staff/GetFormJson",
                data: { keyValue: keyValue },
                dataType: "json",
                async: false,
                success: function (data) {
                    $("#form1").formSerialize(data);
                }
            });
        }
    });
    function initControl() {
        $("#Gender").bindSelect();
        //Hộp thả xuống tổ chức
        $("#OrganizeId").bindSelect({
            url: "/Organize/GetChildTreeSelectJson",
        });
        //Tải hộp thả xuống khoa tương ứng với tổ chức
        $("#OrganizeId").bind("change", function () {
            var organizeId = $(this).val();
            $("#DepartmentCode").bindSelect({
                url: "/Department/GetTreeSelectJson?organizeId=" + organizeId,
            });
        });
        $("#zc").bindSelect({
            url: "/ItemsData/GetSelectJson?code=DoctorTitle"
        });
    }
</script>
<form id="form1">
    <div class="container" style="margin-top: 10px; margin-left: 10px; margin-right: 10px;">
        <ul class="nav nav-tabs" role="tablist" id="myTab">
            <li role="presentation"><a href="#basicInfo" role="tab" data-toggle="tab">Thông tin cơ bản</a></li>
        </ul>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade in active" style="padding-top: 20px; margin-right: 30px;" id="basicInfo">
                <table class="form">
                    <tr>
                        <th class="formTitle">Cơ sở:</th>
                        <td class="formValue">
                            <select id="OrganizeId" name="OrganizeId" class="form-control required">
                                <option value="">==Vui lòng chọn==</option>
                            </select>
                        </td>
                        <th class="formTitle">Khoa:</th>
                        <td class="formValue">
                            <select id="DepartmentCode" name="DepartmentCode" class="form-control required">
                                <option value="">==Vui lòng chọn==</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Họ tên:</th>
                        <td class="formValue">
                            <input id="Name" name="Name" type="text" class="form-control required" placeholder="Vui lòng nhập họ tên" />
                        </td>
                        <th class="formTitle">Giới tính:</th>
                        <td class="formValue">
                            <select id="Gender" name="Gender" class="form-control required">
                                <option value="true">Nam</option>
                                <option value="false">Nữ</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Mã nhân viên:</th>
                        <td class="formValue">
                            <input id="gh" name="gh" type="text" class="form-control required" placeholder="Vui lòng nhập mã nhân viên" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Chức danh:</th>
                        <td class="formValue">
                            <select id="zc" name="zc" class="form-control ">
                                <option value="">==Vui lòng chọn==</option>
                            </select>
                        </td>
                        <th class="formTitle">Ảnh đại diện:</th>
                        <td class="formValue">
                            <input id="HeadIcon" name="HeadIcon" type="text" class="form-control" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Điện thoại:</th>
                        <td class="formValue">
                            <input id="MobilePhone" name="MobilePhone" type="text" class="form-control" />
                        </td>
                        <th class="formTitle">Ngày sinh:</th>
                        <td class="formValue">
                            <input id="Birthday" name="Birthday" type="text" class="form-control input-wdatepicker" onfocus="WdatePicker()" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">WeChat:</th>
                        <td class="formValue">
                            <input id="WeChat" name="WeChat" type="text" class="form-control" />
                        </td>
                        <th class="formTitle">Email:</th>
                        <td class="formValue">
                            <input id="Email" name="Email" type="text" class="form-control" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Thứ tự:</th>
                        <td class="formValue">
                            <input id="px" name="px" type="text" class="form-control" placeholder="" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle" style="height: 35px;">Tùy chọn:</th>
                        <td class="formValue" style="padding-top: 1px;">
                            <div class="ckbox">
                                <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Hiệu lực</label>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle" valign="top" style="padding-top: 5px;">
                            Ghi chú:
                        </th>
                        <td class="formValue" colspan="3">
                            <textarea id="Description" name="Description" class="form-control" style="height: 60px;"></textarea>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Người tạo:</th>
                        <td class="formValue">
                            <input id="CreatorCode" name="CreatorCode" type="text" class="form-control" />
                        </td>
                        <th class="formTitle">Thời gian tạo:</th>
                        <td class="formValue">
                            <input id="CreateTime" name="CreateTime" type="text" class="form-control" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Người sửa:</th>
                        <td class="formValue">
                            <input id="LastModifierCode" name="LastModifierCode" type="text" class="form-control" />
                        </td>
                        <th class="formTitle">Thời gian sửa:</th>
                        <td class="formValue">
                            <input id="LastModifyTime" name="LastModifyTime" type="text" class="form-control" />
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</form>

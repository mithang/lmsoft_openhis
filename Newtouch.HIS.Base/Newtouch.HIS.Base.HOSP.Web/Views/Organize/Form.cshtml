
@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<form id="form1">
    <div class="container" style="margin-top: 10px; margin-left: -4%; ">
        <ul class="nav nav-tabs" role="tablist" id="myTab" style="margin-left: 4%;">
            <li role="presentation"><a href="#basicInfo" role="tab" data-toggle="tab">Thông tin cơ bản</a></li>
        </ul>
        <div class="tab-content">
            <div role="tabpanel" style="padding-top: 20px; margin-left: 45px; margin-right: 75px;" id="basicInfo">
                <table class="form">
                    <tr>
                        <th class="formTitle">Cấp trên:</th>
                        <td class="formValue formDdlSelectorTd">
                            <select id="ParentId" name="ParentId" class="form-control required">
                                <option value="">==Vui lòng chọn==</option>
                            </select>
                        </td>
                        <th class="formTitle"><span class="required">*</span>Tên:</th>
                        <td class="formValue">
                            <input id="Name" name="Name" type="text" class="form-control required" placeholder="" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Tên viết tắt:</th>
                        <td class="formValue">
                            <input id="ShortName" name="ShortName" type="text" class="form-control" placeholder="" />
                        </td>
                        <th class="formTitle"><span class="required">*</span>Mã:</th>
                        <td class="formValue">
                            <input id="Code" name="Code" type="text" class="form-control required" placeholder="" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Mã quốc gia:</th>
                        <td class="formValue">
                            <input id="gjjgdm" name="gjjgdm" type="text" class="form-control" placeholder="" />
                        </td>
                        <th class="formTitle"><span class="required">*</span>Phân loại:</th>
                        <td class="formValue formDdlSelectorTd">
                            <select id="CategoryCode" name="CategoryCode" class="form-control required">
                                <option value="">==Vui lòng chọn==</option>
                            </select>
                        </td>
                        
                    </tr>
                    <tr>
                        <th class="formTitle">Mã phân vùng hành chính BHYT:</th>
                        <td class="formValue">
                            <input id="ybxzqhCode" name="ybxzqhCode" type="text" class="form-control" placeholder="" />
                        </td>
                        <th class="formTitle">Tên phân vùng hành chính BHYT:</th>
                        <td class="formValue">
                            <input id="ybxzqhName" name="ybxzqhName" type="text" class="form-control" placeholder="" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Email:</th>
                        <td class="formValue">
                            <input id="Email" name="Email" type="text" class="form-control" placeholder="" />
                        </td>
                        <th class="formTitle"><span class="required">*</span>Điện thoại:</th>
                        <td class="formValue">
                            <input id="TelePhone" name="TelePhone" type="text" class="form-control required" placeholder="" />
                        </td>
                        
                    </tr>
                    <tr>
                        <th class="formTitle">WeChat:</th>
                        <td class="formValue">
                            <input id="WeChat" name="WeChat" type="text" class="form-control" placeholder="Vui lòng nhập số WeChat chính thức" />
                        </td>
                        <th class="formTitle">Fax:</th>
                        <td class="formValue">
                            <input id="Fax" name="Fax" type="text" class="form-control" placeholder="" />
                        </td>
                        
                    </tr>
                    <tr>
                        <th class="formTitle">Thứ tự:</th>
                        <td class="formValue">
                            <input id="px" name="px" type="text" class="form-control" placeholder="" />
                        </td>
                        <th class="formTitle" style="height: 35px;">Tùy chọn:</th>
                        <td class="formValue" style="padding-top: 1px;">
                            <div class="ckbox">
                                <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Hiệu lực</label>
                            </div>
                        </td>

                    </tr>
                    <tr>
                        <th class="formTitle" valign="top" style="padding-top: 5px;">
                            <span class="required">*</span>Địa chỉ:
                        </th>
                        <td class="formValue" colspan="3">
                            <input id="Address" name="Address" type="text" class="form-control required" placeholder="Vui lòng nhập địa chỉ" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle" valign="top" style="padding-top: 5px;">
                            Giới thiệu:
                        </th>
                        <td class="formValue" colspan="3">
                            <textarea id="Description" name="Description" class="form-control" style="height: 50px;"></textarea>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</form>

<script>
    var keyValue = $.request("keyValue");
    $(function () {
        initControl();
        if (!!keyValue) {
            $.najax({
                url: "/Organize/GetFormJson",
                data: { keyValue: keyValue },
                dataType: "json",
                async: false,
                success: function (data) {
                    $("#form1").formSerialize(data);
                }
            });
        }
    });
    function initControl() {
        //Hộp thả xuống tổ chức cấp trên
        $("#ParentId").bindSelect({
            url: "/Organize/GetChildTreeSelectJson",
        });
        //Thả xuống phân loại cơ sở    //Ở đây không phân biệt tổ chức
        $("#CategoryCode").bindSelect({
            url: "/ItemsData/GetSelectJson",
            param: { code: "OrganizeType" }
        });
    }
    function submitForm() {
        if (!$('#form1').formValid()) {
            return false;
        }
        $.submitForm({
            url: "/Organize/SubmitForm?keyValue=" + keyValue,
            param: $("#form1").formSerialize(),
            success: function () {
                top.top.$.clientsRefresh(); //Làm mới bộ nhớ đệm
                $.currentWindow().$("#gridList").resetSelection();
                $.currentWindow().$("#gridList").trigger("reloadGrid");
            }
        })
    }
</script>

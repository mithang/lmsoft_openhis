
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="topPanel">
    @Html.Partial("_OrganizeIdDDLToolbarSearchView")
    <div class="toolbar">
        <div class="btn-group">
            <a id="NF-add" authorize="yes" class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a id="NF-edit" class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Tên/Mã/Mã đầu chữ" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script>
    $(function () {
        initControl();
        gridList()
    })
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            postData: { keyword: $("#txt_keyword").val(), organizeId: $("#OrganizeId").val() },
            url: "/SysAgriInsuranceChargeCategory/GetGridJson",
            height: $(window).height() - 128,
            colModel: [
                 { label: "Khóa chính", name: "dlId", hidden: true, key: true },
                 { label: 'Tên', name: 'dlmc', width: 150, align: 'left' },
                  { label: "Mã", name: "dlCode", width: 100, align: 'left' },
                  { label: "Mã đầu chữ", name: "py", width: 100, align: 'left' },
                  { label: 'Thứ tự', name: 'px', width: 100, align: 'left' },
                   {
                       label: "Cờ ngoại trú/nội trú", name: "mzzybz", width: 100, align: "left",
                       formatter: function (cellvalue) {
                           if (cellvalue == "0") {
                               return "Chung"
                           } else if (cellvalue == "1") {
                               return "Ngoại trú"
                           } else {
                               return "Nội trú"
                           }
                       }
                   },
                { label: "Hiệu lực", name: "zt", width: 80, align: "left", formatter: function (cellvalue) { return cellvalue == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
                { label: 'Người tạo', name: 'CreatorCode', width: 100, align: 'left' },
                { label: 'Thời gian tạo', name: 'CreateTime', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Sửa cuối', name: 'LastModifierCode', width: 100, align: 'left' },
                { label: 'Thời gian sửa cuối', name: 'LastModifyTime', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Thứ tự', name: 'px', width: 40, align: 'left' }
            ],
        });
        $("#btn_search").click(function () {
            $("#gridList").jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword").val(), organizeId: $("#OrganizeId").val() },
            }).trigger('reloadGrid');
        });
    }

    //回车事件
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    function initControl() {

    }

    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "Thêm nhóm lớn",
            url: "/SysAgriInsuranceChargeCategory/Form?orgId=" + $('#OrganizeId').val(),
            width: "550px",
            height: "480px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    function btn_edit() {
        var seleRowid = jQuery("#gridList").jqGrid("getGridParam", "selrow");
        if (!(seleRowid)) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        var keyValue = $("#gridList").jqGridRowValue().dlId;
        $.modalOpen({
            id: "Form",
            title: "Sửa nhóm lớn",
            url: "/SysAgriInsuranceChargeCategory/Form?keyValue=" + keyValue,
            width: "550px",
            height: "480px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

</script>


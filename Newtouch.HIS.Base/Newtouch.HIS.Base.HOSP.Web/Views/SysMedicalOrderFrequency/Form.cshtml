@using NewtouchHIS.Lib.Framework.Operator;
@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<form id="form1">
    <div class="container" style="margin-top: 10px; margin-left: -4%; ">
        <ul class="nav nav-tabs" role="tablist" id="myTab" style="margin-left: 4%;">
            <li role="presentation"><a href="#basicInfo" role="tab" data-toggle="tab">Thông tin cơ bản</a></li>
        </ul>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade in active" style="padding-top: 20px; margin-right: 58px; margin-left:33px;" id="basicInfo">
                <table class="form">
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Tổ chức:</th>
                        <td class="formValue formDdlSelectorTd">
                            <select id="OrganizeId" name="OrganizeId" class="form-control required">
                                <option value="">==Vui lòng chọn==</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Tên:</th>
                        <td class="formValue">
                            <input type="text" class="form-control required" id="yzpcmc" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Mô tả tên:</th>
                        <td class="formValue">
                            <input type="text" class="form-control required" id="yzpcmcsm" placeholder="VD:mỗi ngày 3 lần" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Mã:</th>
                        <td class="formValue">
                            <input type="text" class="form-control required" id="yzpcCode"  />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Số lần thực hiện:</th>
                        <th class="formValue">
                            <input type="text" class="form-control required" id="zxcs"  />
                        </th>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Chu kỳ thực hiện:</th>
                        <th class="formValue">
                            <input type="text" class="form-control required" id="zxzq"  />
                        </th>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Đơn vị thời gian chu kỳ thực hiện:</th>
                        <th class="formValue">
                            @*<input type="text" class="form-control required" id="zxzqdw"  />*@
                            <select class="form-control required" id="zxzqdw">
                                <option value="1">ngày</option>
                                <option value="2">giờ</option>
                                <option value="3">Phút</option>
                            </select>
                        </th>
                    </tr>
                    <tr>
                        <th class="formTitle">Cờ tuần:</th>
                        <td class="formValue">
                            @*<input class="form-control" id="zbz" value="" type="text" required />*@
                            <select class="form-control required" id="zbz">
                                <option value="1">Có</option>
                                <option value="0">Không</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Thời gian thực hiện:</th>
                        <th class="formValue">
                            <input class="form-control" id="zxsj" value="" type="text" required />
                        </th>
                    </tr>
                    <tr>
                        <th class="formTitle">Hiệu lực:</th>
                        <td class="formValue">
                            <div class="ckbox">
                                <input id="zt" type="checkbox" checked="checked" required><label for="zt"></label>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</form>

<script>
    var keyValue = $.request("yzpcId");
    var orgId = $.request("orgId");
    $(function () {
        initControl();

        if (!!keyValue) {
            $.najax({
                url: "/SysMedicalOrderFrequency/GetFormJson?r=" + Math.random(),
                data: { yzpcId: keyValue, orgId: orgId },
                dataType: "json",
                async: false,
                success: function (data) {
                    $("#form1").formSerialize(data);
                }
            });
        }
    })

    $(document).ready(function () {
        // Đặt tổ chức không thể sửa
        if (keyValue && orgId) {
            $("#OrganizeId").prop("disabled", true); // Đặt hộp chọn không cho sửa
            $("#OrganizeId").css("background-color", "#e9ecef"); // Làm mờ đi
        }
    });

    function initControl() {
        //Hộp thả xuống tổ chức
        $("#OrganizeId").bindSelect({
            url: "/Organize/GetChildTreeSelectJson",
            selectedValue: $.request('orgId'),
        });
    }

    var anPrevOrg = null;
    $('#yzpcCode').focus(function () {
        var organizeId = $("#OrganizeId").val();
        if (!!!keyValue && ($.trim($(this).val()) === '' || organizeId != anPrevOrg)) {
            anPrevOrg = organizeId;
            $.najax({
                url: "/HOME/GetNewFieldUniqueValue?topOrgIdIsStar=false&initFieldLength=8&fieldName=xt_yzpc.yzpcCode&orgId=" + organizeId + "&r=" + Math.random(),
                dataType: "json",
                cache: false,
                success: function (data) {
                    $('#yzpcCode').val(data.data);
                }
            });
        }
    });

    //Gửi
    function submitForm() {
        if (!$('#form1').formValid()) {
            return false;
        }
        var params = $("#form1").formSerialize();
        $.submitForm({
            url: "/SysMedicalOrderFrequency/SubmitForm?yzpcId=" + keyValue,
            param: params,
            success: function () {
                $.currentWindow().$("#gridList").resetSelection();
                $.currentWindow().$("#gridList").trigger("reloadGrid");
            }
        })
    }

</script>

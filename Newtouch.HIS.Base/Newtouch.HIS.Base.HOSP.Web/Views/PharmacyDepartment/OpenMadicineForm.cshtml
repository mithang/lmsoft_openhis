
@{
    ViewBag.Title = "OpenMadicineForm";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<div style="margin-top: 20px; margin-left: 30px;">
    <span style="color:red;">*.Hạn chế thuốc nhà thuốc</span>,ví dụ: giới hạn nhà thuốc Đông y chỉ được nhập kho（các thao tác như phát thuốc）đối với thuốc Đông y
</div>
<form id="form1">
    <div style="padding-top: 10px; margin-right: 30px;">
        <table class="form">
            <tr>
                <td class="formTitle"><span class="required">*</span>Tổ chức:</td>
                <td class="formValue formDdlSelectorTd">
                    <select id="OrganizeId" name="OrganizeId" class="form-control required">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td class="formTitle"><span class="required">*</span>Mã khoa dược:</td>
                <td class="formValue formDdlSelectorTd">
                    <select id="yfbmCode" name="yfbmCode" class="form-control required">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>Mã nhóm thu phí lớn:</th>
                <td class="formValue formDdlSelectorTd">
                    <select id="dlCode" name="dlCode" class="form-control required">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Thứ tự:</th>
                <td class="formValue">
                    <input id="px" name="px" type="text" class="form-control" placeholder="" />
                </td>
            </tr>
            <tr>
                <th class="formTitle" style="height: 35px;">Trạng thái:</th>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Hiệu lực</label>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    var keyValue = $.request("keyValue");
    $(function () {
        initControl();
        if (!!keyValue) {
            $.najax({
                url: "/PharmacyDepartment/GetOpenMedicineFormJson",
                data: { keyValue: keyValue },
                dataType: "json",
                async: false,
                success: function (data) {
                    $("#form1").formSerialize(data);

                    $('#yfbmCode').val(data.yfbmCode).trigger('change');
                    $('#dlCode').val(data.dlCode).trigger('change');
                }
            });
        }
        else {
            var newOrgId = $.request('orgId');
            if (newOrgId) {
                $("#OrganizeId").val(newOrgId).trigger('change');
            }
        }
    });

    function initControl() {
        //Hộp thả xuống tổ chức
        $("#OrganizeId").bindSelect({
            url: "/Organize/GetChildTreeSelectJson",
        });
        //Tải hộp thả xuống khoa tương ứng với tổ chức
        $("#OrganizeId").bind("change", function () {
            var organizeId = $(this).val();
            //Lấy khoa dược
            $("#yfbmCode").bindSelect({
                url: "/PharmacyWindow/PharmacyDepartmentList?organizeId=" + organizeId,
                id: "yfbmCode",
                text: "yfbmmc",
            })
            //Lấy danh mục thu phí lớn
            $("#dlCode").bindSelect({
                url: "/ChargeCategory/GetTreeSelectJson?organizeId=" + organizeId,
            })
        });
    }

    function submitForm() {
        if (!$('#form1').formValid()) {
            return false;
        }
        var postData = $("#form1").formSerialize();
        $.submitForm({
            url: "/PharmacyDepartment/OpenMedicineSubmitForm?keyValue=" + keyValue,
            param: postData,
            success: function () {
                $.currentWindow().$("#gridList").resetSelection();
                $.currentWindow().$("#gridList").trigger("reloadGrid");
            }
        });
    }
</script>
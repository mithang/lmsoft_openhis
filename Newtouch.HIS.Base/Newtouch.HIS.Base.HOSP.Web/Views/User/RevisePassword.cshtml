@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<script>
    var keyValue = $.request("keyValue");
    $(function () {
        $("#Account").val($.request('account'));
        $("#Name").val($.request('name'));
    });
    function submitForm() {
        if (!$('#form1').formValid()) {
            return false;
        }
        var postData = $("#form1").formSerialize();
        postData["userPassword"] = $("#UserPassword").val();
        postData["keyValue"] = keyValue;
        //var ret = /^(?![0-9]+$)(?![a-zA-Z]+$)\S{6,16}$/;
        //if (postData["userPassword"] && !ret.test(postData["userPassword"])) {
        //    $.modalAlert("Vui lòng điền mật khẩu mới theo yêu cầu", "error");//Mật khẩu chưa đủ phức tạp
        //    return false;
        //}
        $.submitForm({
            url: "/User/SubmitRevisePassword",
            param: postData,
            success: function () {
                $.loading(false)
            }
        })
    }

    //Ẩntext block, Hiển thịpassword block
    function showPsw() {
        if ($("#UserPassword").attr("type") == "text") {
            $('#UserPassword').attr("type", "password");
            $('#icon').attr("class", "fa fa-eye");
        } else {
            $('#UserPassword').attr("type", "text");
            $('#icon').attr("class", "fa fa-eye-slash");
            
        }
    }
</script>
<form id="form1">
    <div style="padding-top: 30px; margin-right: 40px;">
        <table class="form">
            <tr>
                <th class="formTitle">Tài khoản:</th>
                <td class="formValue">
                    <input id="Account" name="Account" readonly type="text" class="form-control" />
                </td>
            </tr>
            @*<tr>
                <th class="formTitle">Họ tên: </th>
                <td class="formValue">
                    <input id="Name" name="Name" readonly type="text" class="form-control" />
                </td>
            </tr>*@
            <tr>
                <th class="formTitle"><span class="required">*</span>Mật khẩu:</th>
                <td class="formValue">
                    <div class="input_block" id="psw_invisible">
                        <input id="UserPassword" name="UserPassword" type="password" class="form-control required" placeholder="Vui lòng nhập mật khẩu mới" />
                        <i id="icon" class="fa fa-eye" onclick="showPsw()" style="display: inline;float: right;position: relative;top: -20px;height:0px"></i>
                    </div>
                </td>
            </tr>
            @*<tr>
                <th>
                </th>
                <td>
                    &nbsp;&nbsp;
                    <span style="color:#999;">6-16 ký tự,  phải bao gồm chữ cái và số</span>
                </td>
            </tr>*@
        </table>
    </div>
</form>

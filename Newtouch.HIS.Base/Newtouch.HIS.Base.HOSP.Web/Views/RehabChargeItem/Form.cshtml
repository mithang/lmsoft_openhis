@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<form id="form1">
    <div style="padding-top: 20px; margin-right: 30px;">
        <table class="form">
            <tr>
                <th class="formTitle"><span class="required">*</span>Tổ chức:</th>
                <td class="formValue formDdlSelectorTd">
                    <select id="OrganizeId" name="OrganizeId" class="form-control required">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>Tên:</th>
                <td class="formValue">
                    <input type="text" class="form-control required" id="Name" name="Name" />
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>Mã:</th>
                <td class="formValue">
                    <input type="text" class="form-control required" id="Code" name="Code" />
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>Mã đầu chữ:</th>
                <td class="formValue">
                    <input type="text" class="form-control required" id="py" name="py" />
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>Phương thức tính phí:</th>
                <td class="formValue formDdlSelectorTd">
                    @Html.DropDownList("CollectionMethod", Newtouch.Infrastructure.EnumCollectionMethod.Service.ToDescSelectList(), "==Vui lòng chọn==", new { @class = "form-control required" })
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>Phân loại:</th>
                <td class="formValue formDdlSelectorTd">
                    <select id="sfflCode" name="sfflCode" class="form-control required">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Thứ tự:</th>
                <th class="formValue">
                    <input type="text" class="form-control" id="px" name="px" />
                </th>
            </tr>
            <tr>
                <th class="formTitle">Hiệu lực:</th>
                <td class="formValue">
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt"></label>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    var sfxmId = $.request("sfxmId");
    var OrganizeId = $.request("OrganizeId");
    $(function () {
        initControl();

        if (!!sfxmId) {
            $.najax({
                url: "/RehabChargeItem/GetFormJson?r=" + Math.random(),
                data: { sfxmId: sfxmId, OrganizeId: OrganizeId },
                dataType: "json",
                async: false,
                success: function (data) {
                    $("#form1").formSerialize(data);
                }
            });
        }
        else {
            $.najax({
                url: "/HOME/GetNewFieldUniqueValue?orgIdIsStar=true&topOrgIdIsStar=true&initFieldLength=8&fieldName=kf_sfxm.Code&r=" + Math.random(),
                dataType: "json",
                cache: false,
                success: function (data) {
                    $('#Code').val(data.data);
                }
            });
        }
    })

    function initControl() {
        //Hộp thả xuống tổ chức
        $("#OrganizeId").bindSelect({
            url: "/Organize/GetChildTreeSelectJson",
        });
        $("#OrganizeId").change(function () {
            //Thả xuống phân loại thu phí
            $("#sfflCode").bindSelect({
                url: "/RehabChargeItem/GetsfflBindSelect?OrganizeId=" + $('#OrganizeId').val()
            });
        });
        $('#CollectionMethod').select2();
    }

    //Mã đầu chữ
    $('#Name').keyup(function () {
        $('#py').val($(this).toShouPin());
    })

    //Gửi
    function submitForm() {
        if (!$('#form1').formValid()) {
            return false;
        }
        var params = $("#form1").formSerialize();
        $.submitForm({
            url: "/RehabChargeItem/SubmitForm?sfxmId=" + sfxmId,
            param: params,
            success: function () {
                $.currentWindow().$("#gridList").resetSelection();
                $.currentWindow().$("#gridList").trigger("reloadGrid");
            }
        })
    }
</script>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Mã/Tên" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>
    $(function () {
        gridList();
    });

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/SysMedicineUsage/GetGridJson",
            postData: getSearchPostData(),
            height: 400,
            colModel: [
            { label: "yfId", name: "yfId", width: 100, align: "left", hidden: true },
            { label: "Mã cách dùng", name: "yfCode", width: 150, align: "left" },
            { label: "Tên cách dùng", name: "yfmc", width: 150, align: "left" },
	            { label: "Loại thuốc", name: "yplx", width: 100, align: "center",formatter: function(cellvalue) {
		            if (cellvalue=="1") {
			            return "Thuốc Tây";
		            } else if(cellvalue=="2") {
			            return "Thuốc Đông y";
		            }
		            return "";
	            } },
            { label: "Hiệu lực", name: "zt", width: 100, align: "center", formatter: function (cellvalue) { return cellvalue == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
            { label: 'Người tạo', name: 'CreatorCode', width: 100, align: 'left' },
            { label: 'Thời gian tạo', name: 'CreateTime', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
            { label: 'Sửa cuối', name: 'LastModifierCode', width: 100, align: 'left' },
            { label: 'Thời gian sửa cuối', name: 'LastModifyTime', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } }
            ],
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords: true
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: getSearchPostData(), url: "/SysMedicineUsage/GetGridJson"
            }).trigger('reloadGrid');
        })
        $("#btn_search").trigger('click');
    }
    //查询条件
    function getSearchPostData() {
        var keyword = $("#txt_keyword").val();
        return { keyword: keyword };
    };

    //回车事件
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    //新增
    function btn_add() {
        $.modalOpen({
            id: "FormFIEdit",
            title: "Bảo trì cách dùng thuốc",
            url: "/SysMedicineUsage/Form",
            width: "500px",
            height: "570px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

</script>

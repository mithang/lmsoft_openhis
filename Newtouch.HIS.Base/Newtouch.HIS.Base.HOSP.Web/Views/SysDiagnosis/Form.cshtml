<script>
    var keyValue = $.request("keyValue");
    $(function () {
        initControl();
        if (!!keyValue) {
            $.najax({
                url: "/SysDiagnosis/GetFormJson",
                data: { keyValue: keyValue },
                dataType: "json",
                async: false,
                success: function (data) {
                    $("#form1").formSerialize(data);
                }
            });
        }
    });

    function initControl() {
        //Hộp thả xuống tổ chức
        $("#OrganizeId").bindSelect({
            url: "/Organize/GetChildTreeSelectJson",
            selectedValue: $.request('orgId'),
        });

        //Mã đầu chữ
        $('#zdmc').keyup(function () {
            $('#py').val($(this).toShouPin());
        })

        //Loại chẩn đoán
        $("#zdlx").bindSelect({
            url: "/ItemsData/GetSelectJson",
            param: { code: "DiagnosisType" }
        });
    }

    function submitForm() {
        if (!$('#form1').formValid()) {
            return false;
		}
        debugger
        var postData = $("#form1").formSerialize();
        if (!postData.OrganizeId)
            postData.OrganizeId = "*";
        $.submitForm({
            url: "/SysDiagnosis/SubmitForm?keyValue=" + keyValue,
            param: postData,
            success: function () {
                $.currentWindow().$("#gridList").resetSelection();
                $.currentWindow().$("#gridList").trigger("reloadGrid");
            }
        })
    }
</script>
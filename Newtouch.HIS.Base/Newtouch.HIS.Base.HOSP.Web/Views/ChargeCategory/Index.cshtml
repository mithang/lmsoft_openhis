
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="topPanel">
    @Html.Partial("_OrganizeIdDDLToolbarSearchView")
    <div class="toolbar">
        <div class="btn-group">
            <a id="NF-add" authorize="yes" class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a id="NF-edit" class="btn btn-default" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Tên" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary" aria-label="Tìm kiếm" title="Tìm kiếm"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
                <td class="formTitle">Trạng thái hiệu lực:</td>
                <td class="input-group" id="zttd" style="margin-top:13px;">
                    <select id="yxzt" name="zt" class="form-control">
                        <option value="" >Tất cả</option>
                        <option value="0">Vô hiệu</option>
                        <option value="1" selected="selected">Hiệu lực</option>
                    </select>
                </td>
                <td></td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script>
    $(function () {
        initControl();
        gridList()
    })
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            treeGrid: true,
            treeGridModel: "adjacency",
            ExpandColumn: "dlCode",
            postData: { keyword: $("#txt_keyword").val(), organizeId: $("#OrganizeId").val(),zt: $("#yxzt").val() },
            url: "/ChargeCategory/GetTreeGridJson",
            height: $(window).height() - 128,
            colModel: [
                 { label: "Khóa chính", name: "dlId", hidden: true, key: true, frozen: true },
                    { label: 'Tên', name: 'dlmc', width: 150, align: 'left', frozen: true },
                  { label: "Mã", name: "dlCode", width: 100, align: 'left' },
                 {
                     label: "Cờ ngoại trú/nội trú", name: "mzzybz", width: 100, align: "left",
                    formatter: function (cellvalue) {
                        if (cellvalue == "0") {
                            return "Chung"
                        } else if (cellvalue == "1") {
                            return "Ngoại trú"
                        } else {
                            return "Nội trú"
                        }
                    }
                 },
            {
                label: "Loại nhóm lớn", name: "dllb", width: 100, align: "left",
                formatter: function (cellvalue) {
                    if (cellvalue == "1") {
                        return "Thuốc"
                    }
                    else if (cellvalue == "2") {
                        return "Hạng mục điều trị"
                    }
                    else if (cellvalue == "3") {
                        return "Hạng mục không điều trị"
                    }
                    else {
                        return ""
                    }
                }
                },
				{ label: 'Phân loại sở thuộc', name: 'fjmc', width: 100, align: 'left' },
				{
					label: 'Thuế suất', name: 'sn', width: 40, align: 'left', formatter: function (cellvalue) {
						if (cellvalue == null) {
							return 0
						}
						else {
							return cellvalue
						}
						
					}},
                { label: "Hiệu lực", name: "zt", width: 80, align: "left",
                    formatter: function (cellvalue, options, rowObject) {
                        return cellvalue == "1"
                            ? `<i class="fa fa-toggle-on" style="cursor:pointer;" onclick="toggleZt('${rowObject.dlId}', 0)"></i>`
                            : `<i class="fa fa-toggle-off" style="cursor:pointer;" onclick="toggleZt('${rowObject.dlId}', 1)"></i>`;
                    } },
                { label: 'Người tạo', name: 'CreatorCode', width: 100, align: 'left' },
                { label: 'Thời gian tạo', name: 'CreateTime', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Sửa cuối', name: 'LastModifierCode', width: 100, align: 'left' },
                { label: 'Thời gian sửa cuối', name: 'LastModifyTime', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Thứ tự', name: 'px', width: 85, align: 'left' }
            ],
        });
        $("#btn_search").click(function () {
            $("#gridList").jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword").val(), organizeId: $("#OrganizeId").val() ,zt: $("#yxzt").val()},
            }).trigger('reloadGrid');
        });
    }

    //Sự kiện nhấn Enter
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    function initControl() {

    }

    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "Thêm nhóm lớn",
            url: "/ChargeCategory/Form?orgId=" + $('#OrganizeId').val(),
            width: "550px",
            height: "700px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    function btn_edit() {
        var seleRowid = jQuery("#gridList").jqGrid("getGridParam", "selrow");
        if (!(seleRowid)) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        var keyValue = $("#gridList").jqGridRowValue().dlId;
        $.modalOpen({
            id: "Form",
            title: "Sửa nhóm lớn",
            url: "/ChargeCategory/Form?keyValue=" + keyValue,
            width: "550px",
			height: "700px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function toggleZt(dlId, newZt) {

        // Gửi yêu cầu tới backend để cập nhật dữ liệu
        $.ajax({
            url: '/ChargeCategory/UpdateZt',  // của xử lý sửa đổi ở backendURL
            type: 'POST',
            data: {
                dlId: dlId,
                zt: newZt,
                organizeId: $("#OrganizeId").val()
            },
            success: function () {
                // Chuyển trạng thái công tắc hiển thị
                $('#btn_search').trigger('click');

            },
        });
    }

</script>

<script>
// PER-APP (B) redesign: nut "Sua" chi bat khi co dong duoc chon (trang thai truc quan;
// handler btn_edit() von da chan khi chua chon - day chi la lop vo hieu truc quan).
$(function () {
    try {
        var $editBtn = $(".toolbar a[onclick=\"btn_edit()\"]");
        function rdSyncEditState() {
            var sel = $("#gridList").jqGrid("getGridParam", "selrow");
            var has = !!sel;
            $editBtn.toggleClass("disabled", !has);
            $editBtn.attr("aria-disabled", has ? "false" : "true");
        }
        $("#gridList").on("jqGridSelectRow jqGridGridComplete jqGridAfterGridComplete", rdSyncEditState);
        rdSyncEditState();
    } catch (e) { /* tang cuong giao dien: khong lam hong trang neu luoi chua khoi tao */ }
});
</script>


@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="topPanel">
    @Html.Partial("_OrganizeIdDDLToolbarSearchView")
    <div class="toolbar">
        <div class="btn-group">
            <a id="NF-add" authorize="yes" class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a id="NF-edit" class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a id="NF-edit" class="btn btn-primary" onclick="btn_xy()"><i class="fa fa-pencil-square-o"></i>Hạn chế dùng</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Tên/Mã/Mã đầu chữ" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
                <td class="formTitle">Trạng thái hiệu lực:</td>
                <td class="input-group" id="zttd" style="margin-top:13px;">
                    <select id="yxzt" name="zt" class="form-control">
                        <option value="" >Tất cả</option>
                        <option value="0">Vô hiệu</option>
                        <option value="1" selected="selected">Hiệu lực</option>
                    </select>
                </td>
                <td></td>
            </tr>
        </table>
    </div>
    <div class="toolbar">
        <select id="sfdl" name="sfdl" class="form-control required" style="width:120px">
            <option value="">==Vui lòng chọn==</option>
        </select>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>
    $(function () {
        debugger
        initControl();
        gridList()
    })
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            postData: { keyword: $("#txt_keyword").val(),organizeId: $("#OrganizeId").val(), sfdl: $("#sfdl").val(), zt: $("#yxzt").val() },
            url: "/SysChargeItem/GetGridJson",
            height: $(window).height() - 128,
            colModel: [
                 { label: "Khóa chính", name: "sfxmId", hidden: true, key: true },
                 //{
                 //    label: '同步', name: 'isSynch', width: 40, align: 'left',
                 //    formatter: function (cellvalue, options, rowObject) {
                 //        if (cellvalue === '0') {
                 //            var $row = JSON.stringify(rowObject).replace(/\"/g, "'");
                 //            return '<a class="btn btn-default btn-xs" onclick="YibaoUpload(' + $row + ')"><span class="glyphicon glyphicon-refresh"></span></a>';
                 //        }
                 //        else if (cellvalue === '1') {
                 //            return '<a class="btn btn-default btn-xs disabled"><span class="glyphicon glyphicon-refresh"></span></a>';
                 //        }
                 //        else {
                 //            return '';
                 //        }
                 //    }
                 //},
                 { label: 'Tên', name: 'sfxmmc', width: 150, align: 'left' },
                 { label: 'Quy cách', name: 'gg', width: 30, align: 'left' },
                 { label: "Mã", name: "sfxmCode", width: 75, align: 'left' },
                { label: "Mã BHYT", name: "ybdm", width: 75, align: 'left' },
                { label: "Mã BHYT quốc gia", name: "gjybdm", width: 90, align: 'left' },
                { label: "Mã BHYT nông thôn mới", name: "xnhybdm", width: 90, align: 'left', hidden: true },
                 { label: "Mã đầu chữ", name: "py", hidden: true },
                { label: 'Tên BHYT quốc gia', name: 'gjybmc', width: 150, align: 'left' },
                { label: 'Nhà sản xuất', name: 'sccj', width: 150, align: 'left' },
                {
                    label: "Tính chất tự trả", name: "zfxz", width: 60, align: 'left', formatter: function (cellVallue) {
                        return cellVallue == 0 ? "Được thanh toán" : (cellVallue == 1 ? "Tự trả" : (cellVallue == 2 ? "Tự trả theo loại" : (cellVallue == 3 ? "Tự túc hoàn toàn" : (cellVallue == 4 ? "Loại A" : (cellVallue == 5 ? "Loại B" : (cellVallue == 6 ? "Loại C" : ""))))));
                    }
                },
                {
                    label: "Đơn giá", name: "dj", width: 60, align: 'left', formatter: "number"
                , formatoptions: { decimalPlaces: 2, defaultValue: '0.00' }
                },
                { label: "Nhóm thu phí lớn", name: "sfdlmc", width: 100, align: 'left' },
                {
                    label: 'Số tiền vượt giá trần', name: 'cxjje', width: 80, align: 'left',
                    formatter: function (cxjje) {
                        if (cxjje == 0 || cxjje == null) {
                            return "0.00";
                        } else {
                            return cxjje;
                        }
                    }
                },
                {
                    label: "Hiệu lực", name: "zt", width: 80, align: "left", formatter: function (cellvalue, options, rowObject) {
                        return cellvalue == "1"
                            ? `<i class="fa fa-toggle-on" style="cursor:pointer;" onclick="toggleZt('${rowObject.sfxmId}', 0)"></i>`
                            : `<i class="fa fa-toggle-off" style="cursor:pointer;" onclick="toggleZt('${rowObject.sfxmId}', 1)"></i>`;
                    }
                },
                 { label: 'Người tạo', name: 'CreatorCode', width: 100, align: 'left' },
                 { label: 'Thời gian tạo', name: 'CreateTime', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                 { label: 'Sửa cuối', name: 'LastModifierCode', width: 100, align: 'left' },
                 { label: 'Thời gian sửa cuối', name: 'LastModifyTime', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
				{ label: 'Thứ tự', name: 'px', width: 40, align: 'left' },
				{ label: "Có phải dữ liệu đồng bộ vật tư không", name: "iswzsame", hidden: true },
            ],
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords: true
        });
        $("#btn_search").click(function () {
            $("#gridList").jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword").val(), organizeId: $("#OrganizeId").val(), sfdl: $("#sfdl").val(),zt: $("#yxzt").val() },
            }).trigger('reloadGrid');
        });
    }

    //回车事件
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    function initControl() {
        //获取收费大类
        $("#sfdl").bindSelect({
            url: "/ChargeCategory/GetTreeSelectJson?organizeId=" + $("#OrganizeId").val(),
        });
    }

    $("#sfdl").change(function () {
        $('#btn_search').trigger('click');
    });

    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "Thêm hạng mục mới",
            url: "/SysChargeItem/Form?orgId=" + $('#OrganizeId').val(),
            width: "1100px",
            height: "570px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    function btn_edit() {
        var seleRowid = jQuery("#gridList").jqGrid("getGridParam", "selrow");
        if (!(seleRowid)) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
		}
		if ($("#gridList").jqGridRowValue().iswzsame=="1") {
			$.modalAlert("Dữ liệu này được đồng bộ từ hệ thống vật tư,nếu muốn sửa, vui lòng sửa trong hệ thống vật tư", 'warning');
			return;
		}
        var keyValue = $("#gridList").jqGridRowValue().sfxmId;
        $.modalOpen({
            id: "Form",
            title: "Sửa hạng mục",
            url: "/SysChargeItem/Form?keyValue=" + keyValue,
			width: "1100px",
			height: "550px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_xy()
    {
        var seleRowid = jQuery("#gridList").jqGrid("getGridParam", "selrow");
        if (!(seleRowid)) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        var xmdm = $("#gridList").jqGridRowValue().sfxmCode;
        var xmmc = encodeURIComponent($("#gridList").jqGridRowValue().sfxmmc);
        xmmc = xmmc.replace(/%/g, '%25');
        var title = "["+$("#gridList").jqGridRowValue().sfxmmc +"]"+ " Giới hạn sử dụng";
        $.modalOpen({
            id: "Form",
            title: title,
            url: "/SysChargeItem/YbbxblForm?xmdm=" + xmdm + "&xmmc=" + encodeURIComponent(xmmc),
            width: "600px",
            height: "550px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
               
            }
        });
    }
    
    function toggleZt(sfxmId, newZt) {
        
        // 发送请求到后端更新数据
        $.ajax({
            url: '/SysChargeItem/UpdateZt',  // 后端处理修改的URL
            type: 'POST',
            data: {
                sfxmId: sfxmId,
                zt: newZt,
                organizeId: $("#OrganizeId").val()
            },
            success: function () {
                    // 切换显示的开关状态
                $('#btn_search').trigger('click');
              
            },
        });
    }
    
    
    //收费项目同步医保
    function YibaoUpload(row) {
        $.najax({
            url: "/SysChargeItem/YibaoUploadApi",
            type: "POST",
            data: { sfxmId: row.sfxmId, flag: row.zt },
            dataType: "json",
            async: false,
            success: function (data) {
                $.modalAlert(data.message, data.state);
                $('#btn_search').trigger('click');
            }
        });
    }
</script>


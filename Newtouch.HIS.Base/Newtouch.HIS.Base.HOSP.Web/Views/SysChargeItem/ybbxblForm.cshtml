@{
    ViewBag.Title = "YbbxblForm";
    Layout = "~/Views/Shared/_Form.cshtml";
}


<form id="form1">
    <div style="padding-top: 10px; margin-right: 30px; ">
        <div class="gridPanel" style="margin-top:1%">
            <table id="gridList"></table>
            <div id="gridPager"></div>
        </div>
    </div>
</form>

<script>
    debugger;
    var xmdm = $.request("xmdm");
    var xmmc = decodeURIComponent($.request("xmmc"));
    $(function () {
        $('#gridList').newtouchLocalDataGrid({
            //caption: 'Chi tiết tính phí',
            height: $(window).height() - 80,
            unwritten: false,
            editurl: "clientArray",
            //rownumbers: true,
            colModel: [
                { label: "xmcode", name: "xmcode", width: 130, align: "left", hidden: true },
                { label: "xmmc", name: "xmmc", width: 130, align: "left", hidden: true },
                { label: "Tên tính chất", name: "xzId", width: 130, align: "left", hidden:true },
                { label: "Tên tính chất", name: "xzmc", width: 130, align: "left" },
                {
                    label: "Tỷ lệ tự trả(%)", name: "zfbl", width: 130, align: "left", editable: true, editrules: { numeric: true, minValue: 0.0, maxValue: 100 },
                    editoptions: {
                        dataEvents: [
                                {
                                    type: 'change',
                                    fn: function (e) {
                                        var cellval = $(this).val();
                                        if (cellval.replace(/(^\s*)|(\s*$)/g, "") == "") {
                                            $.modalAlert("Giá trị trống,Vui lòng xác nhận.", 'warning');
                                            return;
                                        }
                                        if (cellval<0 ||cellval>100) {
                                            $.modalAlert("Tỷ lệ tự trả: Giá trị nhập vào phải từ 0 đến 100", 'warning');
                                            $(this).val('')
                                            return;
                                        }
                                    }
                                }
                        ]
                    }
                },
                {
                    label: "Hạn mức phí", name: "fyxe", width: 100, align: "left", editable: true, editrules: { numeric: true, minValue: 0.0, maxValue: 100 }, editoptions: {
                        dataEvents: [
                                {
                                    type: 'change',
                                    fn: function (e) {
                                        var cellval = $(this).val();
                                        if (cellval.replace(/(^\s*)|(\s*$)/g, "") == "") {
                                            $.modalAlert("Giá trị trống,Vui lòng xác nhận.", 'warning');
                                            return;
                                        }
                                        if (cellval < 0 || cellval > 100) {
                                            $.modalAlert("Hạn mức phí:Giá trị nhập vào phải là0~100trong khoảng", 'warning');
                                            $(this).val('')
                                            return;
                                        }
                                    }
                                }
                        ]
                    }
                },
                {
                    label: "Tỷ lệ vượt hạn(%)", name: "cxbl", width: 130, align: "left", editable: true, editrules: { numeric: true, minValue: 0.0, }, editoptions: {
                        dataEvents: [
                                {
                                    type: 'change',
                                    fn: function (e) {
                                        var cellval = $(this).val();
                                        if (cellval.replace(/(^\s*)|(\s*$)/g, "") == "") {
                                            $.modalAlert("Giá trị trống,Vui lòng xác nhận.", 'warning');
                                            return;
                                        }
                                        if (cellval < 0 || cellval > 100) {
                                            $.modalAlert("Tỷ lệ vượt hạn:Giá trị nhập vào phải là0~100trong khoảng", 'warning');
                                            $(this).val('')
                                            return;
                                        }
                                    }
                                }
                        ]
                    }
                },
            ],
            //multiselect: true,
            gridComplete: function () {

                //Bật hộp sửa trong dòng
                EnableInlineEditBox();
            },
            onSelectRow: function (rowid) {
                $("#" + $.jgrid.jqID(rowid) + "_cxbl").focus();
            }

        });
        ajaxLoad();
    });


    function submitForm() {
        debugger;
        var res = true;
        //Lấy tất cả dòngId，Duyệt để hộp sửa ở trạng thái lưu
        var rowIds = $("#gridList").jqGrid('getDataIDs');
        for (var i = 0; i < rowIds.length; i++) {
            $("#gridList").saveRow(rowIds[i], null, null, null, function (callbackRowId) {
                res = false;
                 }, null, null);
        }
        if (!res)
        {
            return;
        }
        //Lấy dữ liệu tất cả dòng đã chọn
        var data = $("#gridList").jqGrid('getRowData_AllLine', false);
        $.najax({
            url: "/SysChargeItem/SaveYbblValue",
            dataType: "json",
            data: { entity: data, xmbm: xmdm, xmmc: xmmc },
            type: "POST",
            success: function (data) {
                $.modalAlert("Lưu thành công", 'success');
                $.currentWindow().$("#gridList").resetSelection();
                $.currentWindow().$("#gridList").trigger("reloadGrid");
                $.modalClose("Form");
                $.loading(false);
            },
            error: function (request, error, ex) {
                $.modalAlert("Dịch vụ không truy cập được", 'error');
            }
        });

    }

    function ajaxLoad()
    {
        $.najax({
            type: "POST",
            url: "/SysChargeItem/Getybbxbldata",
            data: { keyValue: xmdm },
            dataType: "json",
            //async: false,
            success: function (data) {
                $("#gridList").newtouchLocalDataGrid(null, data);
            }
        });
    }
    //Bật hộp sửa trong dòng
    function EnableInlineEditBox() {
        //GridSau khi tải xong thì bật sửa trong dòng   1.Trước tiên lấy tất cả dòngId  2.Duyệt gọieditRowPhương pháp
        var rowIds = $("#gridList").jqGrid('getDataIDs');
        for (var i = 0; i < rowIds.length; i++) {
            $("#gridList").jqGrid('editRow', rowIds[i], true, null, null, null, null, function (callbackRowId) {    

            });

        }
    }
    
</script>

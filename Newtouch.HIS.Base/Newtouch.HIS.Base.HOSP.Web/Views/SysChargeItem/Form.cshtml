@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";
}


<form id="form1">
    <div style="padding-top: 20px; margin-right: 30px; ">
        <table class="form">
            <tr>
                <td class="formTitle"><span class="required">*</span>Tổ chức:</td>
                <td class="formValue formDdlSelectorTd">
                    <select id="OrganizeId" name="OrganizeId" class="form-control required">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <td class="formTitle"><span class="required">*</span>Tên:</td>
                <td class="formValue">
                    <input id="sfxmmc" name="sfxmmc" type="text" class="form-control required" />
                </td>
                <td class="formTitle"><span class="required">*</span>Mã:</td>
                <td class="formValue">
                    <input id="sfxmCode" name="sfxmCode" type="text" class="form-control required" placeholder="Vui lòng nhập mã" />
                </td>
            </tr>
            <tr id="trSSDJ" name="trSSDJ">
                <th class="formTitle"><span class="required">*</span>Mã đầu chữ:</th>
                <td class="formValue">
                    <input id="py" name="py" type="text" class="form-control required" placeholder="" />
                </td>
                <th class="formTitle">Cấp phẫu thuật:</th>
                <td class="formValue">
                    <select id="ssdj" name="ssdj" class="form-control required">
                        <option value="">==Vui lòng chọn==</option>
                        <option value="1">Phẫu thuật cấp 1</option>
                        <option value="2">Phẫu thuật cấp 2</option>
                        <option value="3">Phẫu thuật cấp 3</option>
                        <option value="4">Phẫu thuật cấp 4</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td class="formTitle">
                    <span class="required">*</span>Tính chất tự trả:
                </td>
                <td class="formValue">
                    @Html.DropDownList("zfxz", Newtouch.Infrastructure.EnumZFXZv2.ZF.ToDescSelectList(), "==Vui lòng chọn==", new { @class = "form-control required" })
                </td>
                <td class="formTitle">Tỷ lệ tự trả:</td>
                <td class="formValue">
                    <input id="zfbl" name="zfbl" type="text" class="form-control" placeholder="" />
                </td>
                <td class="formTitle">Chiến lược tính giá:</td>
                <td class="formValue">
                    @Html.DropDownList("jjcl", Newtouch.Infrastructure.EnumSfxmJjcl.Amount.ToDescSelectList(((int)Newtouch.Infrastructure.EnumSfxmJjcl.Amount)), "==Vui lòng chọn==", new { @class = "form-control required" })
                </td>
            </tr>
            <tr>
                <td class="formTitle"><span class="required">*</span>Đơn giá:</td>
                <td class="formValue">
                    <input id="dj" name="dj" type="text" class="form-control required" placeholder="" />
                </td>
                <td class="formTitle"><span class="required">*</span>Đơn vị:</td>
                <td class="formValue">
                    <input id="dw" name="dw" type="text" class="form-control required" placeholder="" />
                </td>
                <td class="formTitle">Số lượng đơn vị tính:</td>
                <td class="formValue">
                    <input id="dwjls" name="dwjls" type="text" class="form-control" value="1" placeholder="" />
                </td>
            </tr>
            <tr>
                <td class="formTitle"><span class="required">*</span>Nhóm thu phí lớn:</td>
                <td class="formValue formDdlSelectorTd">
                    <select id="sfdlCode" name="sfdlCode" class="form-control required">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <td class="formTitle">Nhóm thu phí lớn của bệnh án:</td>
                <td class="formValue formDdlSelectorTd">
                    <select id="badlCode" name="badlCode" class="form-control">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <td class="formTitle">Khoa thực hiện mặc định:</td>
                <td class="formValue formDdlSelectorTd">
                    <select id="zxks" name="zxks" class="form-control">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td class="formTitle">Số đăng ký:</td>
                <td class="formValue" style="padding-top: 1px;">
                    <input id="pzwh" name="pzwh" type="text" class="form-control" placeholder="" />
                </td>
                <th class="formTitle">Quy cách:</th>
                <td class="formValue">
                    <input id="gg" name="gg" type="text" class="form-control" placeholder="" />
                </td>
                <td class="formTitle">Nhà sản xuất:</td>
                <td class="formValue">
                    <input id="sccj" name="sccj" type="text" class="form-control" placeholder="" />
                </td>
            </tr>
            <tr>
                <td class="formTitle"><span class="required">*</span>Cờ BHYT:</td>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">
                        <!-- Cờ BHYT：Dù đã có đối chiếu mã BHYT，cũng cần gắn cờ BHYT thì mới tương tác với BHYT -->
                        <select id="ybbz" name="ybbz" class="form-control required">
                            <option value="">==Vui lòng chọn==</option>
                            <option value="1">Có</option>
                            <option value="0">Không</option>
                        </select>
                    </div>
                </td>
                <td class="formTitle">Mã BHYT quốc gia:</td>
                <td class="formValue">
                    <input id="gjybdm" name="gjybdm" type="text" class="form-control" placeholder="" />
                </td>
                <td class="formTitle">Mã BHYT tỉnh:</td>
                <td class="formValue">
                    <!-- Được tự động lấy từ hạng mục khám chữa bệnh BHYT，BHYT chia hạng mục khám chữa bệnh và vật tư -->
                    <input id="ybdm" name="ybdm" type="text" class="form-control" placeholder="" />
                </td>
            </tr>
            <tr>
                @*<td class="formTitle">Mã BHYT nông thôn mới：</td>
        <td class="formValue">
            <input id="xnhybdm" name="xnhybdm" type="text" class="form-control" placeholder="" />
        </td>*@
                <td class="formTitle"><span class="required">*</span>Cờ ngoại trú/nội trú:</td>
                <td class="formValue formDdlSelectorTd">
                    <select id="mzzybz" class="form-control required" name="mzzybz">
                        <option value="">==Vui lòng chọn==</option>
                        <option value="0">Chung</option>
                        <option value="1">Ngoại trú</option>
                        <option value="2">Nội trú</option>
                    </select>
                </td>
                <td class="formTitle" style="display:none">Nhóm thu phí lớn bảo hiểm nông nghiệp:</td>
                <td class="formValue formDdlSelectorTd" style="display:none">
                    <select id="nbdlCode" name="nbdlCode" class="form-control">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <td class="formTitle">Giá trần BHYT:</td>
                <td class="formValue">
                    <input id="cxjje" name="cxjje" type="text" class="form-control" placeholder="" oninput="value=value.replace(/[^\d]/g,'')" />
                </td>
                <td class="formTitle">Tên BHYT quốc gia:</td>
                <td class="formValue">
                    <input id="gjybmc" name="gjybmc" type="text" class="form-control" placeholder=""/>
                </td>
            </tr>
            <tr>
                <td class="formTitle">Cờ thực hiện:</td>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">


                        <input id="ssbz" name="ssbz" type="checkbox" checked="checked"><label for="ssbz">Có</label>
                    </div>
                </td>
                <td class="formTitle">Cờ đặc biệt:</td>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">
                        <!-- Hạng mục đặc biệt：1：xt_sfxmtsbzchỉ nhóm bệnh nhân đặc biệt đã cấu hình trong đó mới được dùng hạng mục này -->
                        <input id="tsbz" name="tsbz" type="checkbox"><label for="tsbz">Có</label>
                    </div>
                </td>
                <td class="formTitle">Cờ thu phí:</td>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">
                        <input id="sfbz" name="sfbz" type="checkbox" checked="checked"><label for="sfbz">Có</label>
                    </div>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Loại đăng ký:</th>
                <td class="formValue">
                    <select id="sqlx" name="sqlx" class="form-control">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <td class="formTitle">Mã giá:</td>
                <td class="formValue">
                    <!-- Được tự động lấy từ hạng mục khám chữa bệnh BHYT，BHYT chia hạng mục khám chữa bệnh và vật tư -->
                    <input id="wjdm" name="wjdm" type="text" class="form-control" placeholder="" />
                </td>
                <td class="formTitle">Thời lượng (phút):</td>
                <td class="formValue">
                    <input id="duration" name="duration" type="text" class="form-control" placeholder="" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Thứ tự:</th>
                <td class="formValue">
                    <input id="px" name="px" type="text" class="form-control" placeholder="" />
                </td>
                <th class="formTitle" style="height: 35px;">Trạng thái:</th>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Hiệu lực</label>
                    </div>
                </td>
            </tr>
            <tr>
                <th class="formTitle" valign="top" style="padding-top: 5px;">
                    Ghi chú:
                </th>
                <td class="formValue">
                    <textarea id="bz" name="bz" class="form-control" style="height: 60px;"></textarea>
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    var keyValue = $.request("keyValue");
    $(function () {
        initControl();
        
        if (!!keyValue) {
            $.najax({
                url: "/SysChargeItem/GetFormJson",
                data: { keyValue: keyValue },
                dataType: "json",
                async: false,
                success: function (data) {
                    $("#form1").formSerialize(data);

                    $("#OrganizeId").trigger('change');

                    $("#sfdlCode").val(data.sfdlCode).trigger('change');
                    $("#badlCode").val(data.badlCode).trigger('change');
                    $("#nbdlCode").val(data.nbdlCode).trigger('change');
                    $("#zxks").val(data.zxks).trigger('change');
                    $("#cxjje").val(data.cxjje);
                }
            });
        }
        else {
            var newOrgId = $.request('orgId');
            if (newOrgId) {
                $("#OrganizeId").val(newOrgId).trigger('change');
            }
        }
    });

    function initControl() {
        //Hộp thả xuống tổ chức
        $("#OrganizeId").bindSelect({
            url: "/Organize/GetChildTreeSelectJson",
        });
        //Tải hộp thả xuống khoa tương ứng với tổ chức
        $("#OrganizeId").bind("change", function () {
            var organizeId = $(this).val();
            //Lấy danh mục thu phí lớn
            $("#sfdlCode").bindSelect({
                url: "/ChargeCategory/GetTreeSelectJson?organizeId=" + organizeId,
            });
            //Lấy danh mục thu phí hồ sơ bệnh án lớn
            $("#badlCode").bindSelect({
                url: "/SysMedicalRecordChargeCategory/GetListSelectJson?organizeId=" + organizeId,
                id: "dlCode",
                text: "dlmc",
            });
            //Lấy danh mục thu phí bảo hiểm nông nghiệp lớn
            $("#nbdlCode").bindSelect({
                url: "/SysAgriInsuranceChargeCategory/GetListSelectJson?organizeId=" + organizeId,
                id: "dlCode",
                text: "dlmc",
            });
            //Khoa thực hiện mặc định
            $("#zxks").bindSelect({
                url: "/Department/GetTreeSelectJson?organizeId=" + organizeId,
            });
        });
        $('#zfxz').select2();
        //Mã đầu chữ
        $('#sfxmmc').keyup(function () {
            $('#py').val($(this).toShouPin());
        });
        //Loại đề nghị thuốc
        $("#sqlx").bindSelect({
            url: "/ItemsData/GetSelectJson",
            param: { code: "ExamTypeID" }
        });
        //$("#sfxmmc").ypFloatingSelector({
        //    itemdbclickhandler: function ($thistr) {
        //        $('#id').val($thistr.attr('data-id'));
        //        $('#xmmc').val($thistr.attr('data-xmmc'));
        //        $('#pym').val($thistr.attr('data-pym'));
        //        $('#ybxj').val($thistr.attr('data-ybxj'));
        //        $('#dfybdm').val($thistr.attr('data-dfybdm'));
        //        $('#gjybdm').val($thistr.attr('data-gjybdm'));
        //    }
        //});

        $.fn.sfxmmcFloatingSelector = function (options) {
            var defaults = {
                url: '/SysMedicine/GetYbName',
                width: 1100,
                height: 300,
                clickautotrigger: true,
                caption: "Chọn thuốc",
				ajaxparameters: function ($thisinput) {
					var key = $.trim($('#sfxmmc').val());
					if ($thisinput.selector == "#gjybdm") {
                        key = $.trim($('#gjybdm').val());;
					}
                    return 'organizeId=' + $.trim($('#OrganizeId').val()) + '&keyword=' + key + '&lx=' + $("#sfdlCode").val();
                },
                itemdbclickhandler: null,
                colModel: [
                    { label: 'Loại', name: 'lx', widthratio: 5, },
                    { label: 'Tên hạng mục quốc gia', name: 'xmmc', widthratio: 15 },
                    { label: 'Mã BHYT quốc gia', name: 'gjybdm', widthratio: 15, },
                    { label: 'Quy cách', name: 'gg', widthratio: 5, },
                    { label: 'Đơn vị', name: 'dw', widthratio: 5, },
                    { label: 'Đơn giá', name: 'dj', widthratio: 5, },
                    { label: 'Giá trần BHYT', name: 'ybxj', widthratio: 10 },
                    { label: 'Số đăng ký', name: 'pzwh', widthratio: 10, },
                    { label: 'Nhà sản xuất', name: 'sccj', widthratio: 10, },
                    { label: 'Tên hạng mục', name: 'dfxmmc', widthratio: 10, },
                    { label: 'Mã BHYT', name: 'dfybdm', widthratio: 10 },
                    { label: 'Mã Pinyin', name: 'pym', widthratio: 10, hidden: true },
                    { label: 'ID', name: 'id', widthratio: 5, hidden: true },
                ]
            };
            var options = $.extend(defaults, options);

            $(this).newtouchFloatingSelector(options);
        }

        $("#sfxmmc").sfxmmcFloatingSelector({
            organizeId: $.trim($('#OrganizeId').val()),
            width: 700,
            
            itemdbclickhandler: function ($thistr) {
                var curData = $.currentWindow().document.getElementById('gridList');
                var rowIds = jQuery(curData).jqGrid('getDataIDs');
                for (var k = 0; k < rowIds.length; k++) {
                    debugger
                    var curRowData = jQuery(curData).jqGrid('getRowData', rowIds[k]);
                    if ($thistr.attr('data-gjybdm') != "" && $thistr.attr('data-gjybdm') != null && curRowData.gjybdm == $thistr.attr('data-gjybdm')) {
                        $.modalAlert("Hệ thống đã tồn tại mã BHYT quốc gia là" + $thistr.attr("data-gjybdm") + " của thuốc," + $thistr.attr("data-xmmc"), 'warning');
                    };
                    $('#py').val($thistr.attr('data-pym'));
                    $('#sfxmmc').val($thistr.attr('data-xmmc'));
                    $('#cxjje').val($thistr.attr('data-ybxj'));
                    $('#ybdm').val($thistr.attr('data-dfybdm'));
                    $('#gjybdm').val($thistr.attr('data-gjybdm'));
                    $('#ybbz').val("1");
                }
            }
		});

		$("#gjybdm").sfxmmcFloatingSelector({
			organizeId: $.trim($('#OrganizeId').val()),
			width: 1100,
			itemdbclickhandler: function ($thistr) {
				var curData = $.currentWindow().document.getElementById('gridList');
				var rowIds = jQuery(curData).jqGrid('getDataIDs');
				for (var k = 0; k < rowIds.length; k++) {
					debugger
					var curRowData = jQuery(curData).jqGrid('getRowData', rowIds[k]);
					//if ($thistr.attr('data-gjybdm') != "" && $thistr.attr('data-gjybdm') != null && curRowData.gjybdm == $thistr.attr('data-gjybdm')) {
					//	$.modalAlert("Hệ thống đã tồn tại mã BHYT quốc gia là" + $thistr.attr("data-gjybdm") + " của thuốc，" + $thistr.attr("data-xmmc"), 'warning');
					//};
				}
                if (($('#sfxmmc').val() != "" || $('#ypmc').val() != null) && $('#ybdm').val() != $thistr.attr('data-gjybdm')) {
					$.modalConfirm("Có cập nhật thông tin BHYT của hạng mục hiện tại không??", function (flag) {
						if (flag) {
							//$('#py').val($thistr.attr('data-pym'));
							//$('#sfxmmc').val($thistr.attr('data-xmmc'));
							$('#cxjje').val($thistr.attr('data-ybxj'));
							$('#ybdm').val($thistr.attr('data-dfybdm'));
							$('#gjybdm').val($thistr.attr('data-gjybdm'));
							$('#ybbz').val("1");
                            $('#sccj').val($thistr.attr('data-sccj'));
                            $('#gg').val($thistr.attr('data-gg'));
                            $('#pzwh').val($thistr.attr('data-pzwh'));
                            $('#gjybmc').val($thistr.attr('data-xmmc'));
						}
					})
				}
			}
		});

    }
    

    var anPrevOrg = null;
    $('#sfxmCode').focus(function () {
        var organizeId = $("#OrganizeId").val();
        if (!!!keyValue && ($.trim($(this).val()) === '' || organizeId != anPrevOrg)) {
            anPrevOrg = organizeId;
            $.najax({
                url: "/HOME/GetNewFieldUniqueValue?topOrgIdIsStar=false&initFieldLength=8&fieldName=xt_sfxm.sfxmCode&orgId=" + organizeId + "&r=" + Math.random(),
                dataType: "json",
                cache: false,
                success: function (data) {
                    $('#sfxmCode').val(data.data);
                }
            });
        }
        });
        

    function submitForm() {
        if (!$('#form1').formValid()) {
            return false;
        }
        debugger
        var postData = $("#form1").formSerialize();
        $.submitForm({
            url: "/SysChargeItem/SubmitForm?keyValue=" + keyValue,
            param: postData,
            success: function () {
                $.currentWindow().$("#gridList").resetSelection();
                $.currentWindow().$("#gridList").trigger("reloadGrid");
            }
        })
    }

    $("#sfdlCode").change(function () {
        if ($("#sfdlCode").val() == "13") {
            $("#ssdj").addClass("form-control required");
            $("#trSSDJ").css("display", "");
        }
        else {
            $("#ssdj").removeClass("required");
            $("#ssdj").val("");
            $("#trSSDJ").css("display", "none");
        }
    });


</script>
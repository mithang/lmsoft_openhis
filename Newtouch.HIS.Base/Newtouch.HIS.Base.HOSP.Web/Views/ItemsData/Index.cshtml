@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<!--selectDanh sách thả xuống-->
<script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/select2/select2.min.js")"></script>
<link href="@MvcHelper.GetStaticResourceScriptUrl("~/js/select2/select2.min.css")" rel="stylesheet" />

<div class="ui-layout" id="layout" style="height: 100%; width: 100%;">
    <div class="ui-layout-west">
        <div id="itemTree"></div>
    </div>
    <div class="ui-layout-center">
        <div class="topPanel">
            @Html.Partial("_OrganizeIdDDLToolbarSearchView")
            <div class="toolbar">
                <div class="btn-group">
                    <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
                </div>
                <div class="btn-group">
                    <a id="NF-add" authorize="yes" class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
                    <a class="btn btn-primary dropdown-toggle" data-toggle="dropdown"><span class="caret"></span></a>
                    <ul class="dropdown-menu pull-right">
                        <li><a id="NF-itemstype" authorize="yes" onclick="btn_itemstype()" href="javascript:void(0)">Quản lý phân loại</a></li>
                    </ul>
                </div>
                <div class="btn-group">
                    <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
                </div>
            </div>
            <div class="search">
                <table>
                    <tr>
                        <td>
                            <div class="input-group">
                                <input id="txt_keyword" type="text" class="form-control" placeholder="Tên/Mã" style="width: 180px;">
                                <span class="input-group-btn">
                                    <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                                </span>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="gridPanel">
            <table id="gridList"></table>
        </div>
    </div>
</div>

<script>
    $(function () {
        $('#layout').layout();
        treeView();
        gridList();
    });
    function treeView() {
        $("#itemTree").treeview({
            url: "/ItemsType/GetTreeJson",
            onnodeclick: function (item) {
                $("#txt_keyword").val('');
                //$("#OrganizeId").val($("#OrganizeId option:first").val()).trigger('change');
                $('#btn_search').trigger("click");
            }
        });
    }
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            height: $(window).height() - 96,
            colModel: [
                { label: "Khóa chính", name: "Id", hidden: true, key: true },
                { label: 'Tên', name: 'Name', width: 100, align: 'left' },
                { label: 'Mã', name: 'Code', width: 100, align: 'left' },
                {
                    label: "Cho phép sửa", name: "AllowEdit", width: 80, align: "left",
                    formatter: function (cellvalue) {
                        return cellvalue == 1 ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>";
                    }
                },
                { label: "Ghi chú", name: "Description", index: "Description", width: 200, align: "left", sortable: false },
                { label: "Hiệu lực", name: "zt", width: 80, align: "left", formatter: function (cellvalue) { return cellvalue == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
                { label: 'Người tạo', name: 'CreatorCode', width: 100, align: 'left' },
                { label: 'Thời gian tạo', name: 'CreateTime', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Sửa cuối', name: 'LastModifierCode', width: 100, align: 'left' },
                { label: 'Thời gian sửa cuối', name: 'LastModifyTime', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Thứ tự', name: 'px', width: 40, align: 'left' }

            ]
        });
        $("#btn_search").click(function () {
            if (!$("#itemTree").getCurrentNode()) {
                $.modalAlert("Vui lòng chọn nhóm từ điển lớn bên trái trước.", 'warning');
                return false;
            }
            $gridList.jqGrid('setGridParam', {
                url: "/ItemsData/GetGridJson",
                postData: { itemId: $("#itemTree").getCurrentNode().id, keyword: $("#txt_keyword").val(), OrganizeId: $("#OrganizeId").val() },
            }).trigger('reloadGrid');
        });
    }

    //Sự kiện nhấn Enter
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })
    //Chuyển thả xuống
    $('#OrganizeId').change(function () {
        $('#btn_search').trigger('click');
    })

    function btn_add() {
        if (!$("#itemTree").getCurrentNode()) {
            $.modalAlert("Vui lòng chọn nhóm từ điển lớn bên trái trước.", 'warning');
            return false;
        }
        var itemId = $("#itemTree").getCurrentNode().id;
        var itemName = $("#itemTree").getCurrentNode().text;
        if (!itemId) {
            return false;
        }
        $.modalOpen({
            id: "Form",
            title: itemName + "  › Thêm từ điển mới",
            url: "/ItemsData/Form?itemId=" + itemId + "&orgId=" + $('#OrganizeId').val(),
            width: "450px",
            height: "350px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    function btn_edit() {
        if (!$("#itemTree").getCurrentNode()) {
            $.modalAlert("Vui lòng chọn nhóm từ điển lớn bên trái trước.", 'warning');
            return false;
        }

     
        var itemId = $("#itemTree").getCurrentNode().id;
        var itemName = $("#itemTree").getCurrentNode().text;

        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }

        var AllowEdit = $("#gridList").jqGridRowValue().AllowEdit;
        if (AllowEdit.indexOf('fa-toggle-off') >= 0) {
            return;
        }

        $.modalOpen({
            id: "Form",
            title: itemName + "  › Sửa từ điển",
            url: "/ItemsData/Form?keyValue=" + keyValue + "&itemId=" + itemId + "&organizeId=" + $('#OrganizeId').val(),
            width: "450px",
            height: "350px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    function btn_itemstype() {
        $.modalOpen({
            id: "ItemsType",
            title: "Phân loại từ điển",
            url: "/ItemsType/Index",
            width: "800px",
            height: "550px",
            btn: null,
        });
    }
</script>
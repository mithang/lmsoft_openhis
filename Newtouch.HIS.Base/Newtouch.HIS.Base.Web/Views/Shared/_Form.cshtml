<!DOCTYPE html>

<html>
<head>
    <META HTTP-EQUIV="Cache-Control" CONTENT="no-cache,no-store, must-revalidate">
    <META HTTP-EQUIV="pragma" CONTENT="no-cache">
    <META HTTP-EQUIV="expires" CONTENT="0">
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/css/framework-font.css")" rel="stylesheet" />
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/css/framework-theme.css")" rel="stylesheet" id="color-skin" />
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/css/redesign-tokens.css", false)" rel="stylesheet" />

    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/jquery/jquery-2.1.1.min.js")"></script>
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/jquery/jquery.choose.js")"></script>
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/bootstrap/bootstrap.js")"></script>
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/js/bootstrap/bootstrap.min.css")" rel="stylesheet" />
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/wdtree/tree.js")"></script>
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/js/wdtree/tree.css")" rel="stylesheet" />
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/js/select2/select2.min.css")" rel="stylesheet" />
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/select2/select2.min.js")"></script>
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/js/wizard/wizard.css")" rel="stylesheet" />
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/wizard/wizard.js")"></script>
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/validate/jquery.validate.min.js")"></script>
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/css/framework-ui.css")" rel="stylesheet" />
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/framework-ui.js")"></script>
    <script src="/js/baseweb-vi.js"></script>
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/datepicker/WdatePicker.js")"></script>
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/js/datepicker/skin/WdatePicker.css")" rel="stylesheet" />

    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/jquery-ui/jquery-ui.min.js")"></script>
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/js/jquery-ui/jquery-ui.min.css")" rel="stylesheet" />
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/jQuery.Hz2Py-min.js")" type="text/javascript"></script>
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/Newtouch-ui.js")"></script>
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/redesign-grid.js", false)"></script>
    <!-- jqgrid -->
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/jqgrid/jqgrid.min.js")"></script>
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/js/jqgrid/jqgrid.css")" rel="stylesheet" />
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/jqgrid/grid.locale-cn.js")"></script>
    <script src="/js/jqgrid/grid.locale-vi.js"></script>
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/css/framework-ui.css")" rel="stylesheet" />
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/css/common.css")" rel="stylesheet" />
    <script type="text/javascript">
        if (window.isIElte8()) {
            var cssurl = '@MvcHelper.GetStaticResourceScriptUrl("~/css/framework-ui-ie-lte8.css")';
            var linkHtml = '<link href="' + cssurl + '" rel="stylesheet" />';
            document.write(linkHtml);
        }
    </script>
</head>
<body>
    @RenderBody()
    @Html.AntiForgeryToken()
</body>
</html>

@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<form id="form1">
    <div style="padding-top: 20px; margin-right: 30px;">
        <table class="form">
            <tr>
                <th class="formTitle"><span class="required">*</span>Tên:</th>
                <td class="formValue">
                    <input id="jxmc" name="jxmc" type="text" class="form-control required" placeholder="Vui lòng nhập tên" />
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>Mã:</th>
                <td class="formValue">
                    <input id="jxCode" name="jxCode" type="text" class="form-control required" placeholder="Vui lòng nhập mã" />
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>Mã đầu chữ:</th>
                <td class="formValue">
                    <input id="py" name="py" type="text" class="form-control required" placeholder="" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Thứ tự:</th>
                <td class="formValue">
                    <input id="px" name="px" type="text" class="form-control" placeholder="" />
                </td>
            </tr>
            <tr>
                <th class="formTitle" style="height: 35px;">Trạng thái:</th>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Hiệu lực</label>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    var keyValue = $.request("keyValue");
    $(function () {
        initControl();
        if (!!keyValue) {
            $.najax({
                url: "/SysMedicineFormulation/GetFormJson",
                data: { keyValue: keyValue },
                dataType: "json",
                async: false,
                success: function (data) {
                    $("#form1").formSerialize(data);
                }
            });
        }
        else {
            $.najax({
                url: "/HOME/GetNewFieldUniqueValue?orgIdIsStar=true&topOrgIdIsStar=true&initFieldLength=8&fieldName=xt_ypjx.jxCode&r=" + Math.random(),
                dataType: "json",
                cache: false,
                success: function (data) {
                    $('#jxCode').val(data.data);
                }
            });
        }
    });

    function initControl() {

        //Mã đầu chữ
        $('#jxmc').keyup(function () {
            $('#py').val($(this).toShouPin());
        })
    }

    function submitForm() {
        if (!$('#form1').formValid()) {
            return false;
        }
        $.submitForm({
            url: "/SysMedicineFormulation/submitForm?keyValue=" + keyValue,
            param: $("#form1").formSerialize(),
            success: function (data) {
                $.currentWindow().$("#gridList").resetSelection();
                $.currentWindow().$("#gridList").trigger("reloadGrid");
            }
        })
    }

</script>
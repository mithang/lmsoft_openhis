
@{
    ViewBag.Title = "Quản lý thông tin cơ bản hạng mục phục hồi chức năng";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a id="NF-add" class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a id="NF-edit" class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Tên/Mã/Mã đầu chữ" style="width: 200px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>
    $(function () {
        gridList();
    });

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/RehabChargeItem/GetRehabChargeItemList",
            postData: getSearchPostData(),
            height: 400,
            colModel: [
            { label: "sfxmId", name: "sfxmId", width: 100, align: "center", hidden: true },
            { label: "Tên", name: "Name", width: 100, align: "center" },
            { label: "Mã", name: "Code", width: 100, align: "center" },
            { label: "Phân loại", name: "sfflName", width: 100, align: "center" },
            { label: "Mã đầu chữ", name: "py", width: 100, align: "center" },
            //{ label: "Thời lượng", name: "duration", width: 100, align: "center" },
                 { label: 'Thứ tự', name: 'px', width: 40, align: 'left' },
                { label: "Hiệu lực", name: "zt", width: 60, align: "center", formatter: function (cellvalue) { return cellvalue == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
                { label: 'Thời gian tạo', name: 'CreateTime', width: 80, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Thời gian sửa cuối', name: 'LastModifyTime', width: 80, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
            ]
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: getSearchPostData(), url: "/RehabChargeItem/GetRehabChargeItemList"
            }).trigger('reloadGrid');
        })
        $("#btn_search").trigger('click');
    }
    //Điều kiện tìm kiếm
    function getSearchPostData() {
        var keyword = $("#txt_keyword").val();
        return { keyword: keyword };
    };

    //Sự kiện nhấn Enter
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    function btn_add() {
        $.modalOpen({
            id: "FormFIEdit",
            title: "Bảo trì hạng mục phục hồi chức năng",
            url: "/RehabChargeItem/Form",
            width: "500px",
            height: "470px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    //Sửa
    function btn_edit() {
        var keyValue = $("#gridList").jqGridRowValue().sfxmId;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        $.modalOpen({
            id: "FormFIEdit",
            title: "Sửa thông tin",
            url: "/RehabChargeItem/Form?sfxmId=" + keyValue,
            width: "500px",
            height: "470px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

</script>

<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
	</configSections>
	<log4net>
		<!--nhật ký lỗi：：：ghi nhật ký lỗi-->
		<!--tách tệp nhật ký theo ngày một ngày một tệp-->
		<!-- appender định nghĩa phương thức xuất nhật ký   ghi nhật ký vào tệp dưới dạng tệp cuộn lại。-->
		<appender name="ErrorAppender" type="log4net.Appender.RollingFileAppender">
			<!--đường dẫn lưu：khi dự án khởi động, đường dẫn dưới đây tự động tạiCtạo trong ổ đĩalog、logErrortệp-->
			<file value="LogFile/error/error_" />
			<!-- nếu muốn thêm đường dẫn trong dự án này，khi đó trực tiếp bỏ điC:\\  chỉ đặtlog\\LogError   khi dự án khởi động, mặc định tạo tệp -->
			<appendToFile value="true"/>
			<!--theo phương thức nào để tạo nhiều tệp nhật ký(ngày[Date],kích thước tệp[Size],hỗn hợp[Composite])-->
			<rollingStyle value="Date"/>
			<!--đây là thư mục tạo theo ngày-->
			<datePattern value="yyyy-MM-dd'.log'"/>
			<!--có chỉ ghi vào một tệp hay không-->
			<staticLogFileName value="false"/>
			<!--được giữ lạilogsố lượng tệp sau khi vượt quá số lượng này tự động xóa các bản ghi trước đó   hình như chỉ khi theoSizehiệu lực khi tách giá trị đặtvalue="－1"là không giới hạn số tệp-->
			<param name="MaxSizeRollBackups" value="100"/>
			<!--kích thước mỗi tệp。chỉ sử dụng trong phương thức hỗn hợp và phương thức theo kích thước tệp。sau khi vượt quá kích thước, tự động thêm số nguyên dương vào sau tất cả tên tệp để đổi tên，số lớn nhất được ghi sớm nhất。đơn vị có thể dùng:KB|MB|GB。không sử dụng số thập phân,nếu không sẽ luôn ghi vào nhật ký hiện tại-->
			<maximumFileSize value="10MB" />
			<!-- layout điều khiểnAppenderđịnh dạng xuất của，cũng có thể làxml  mộtAppenderchỉ có thể là mộtlayout-->
			<layout type="log4net.Layout.PatternLayout">
				<!--mô tả bằng chữ ở cuối mỗi nhật ký-->
				<!--định dạng xuất mẫu-->
				<!-- <param name="ConversionPattern"  value="thời gian ghi：%date luồngID:[%thread] mức nhật ký：%-5level lớp ghi：%logger   
        người thao tácID：%property{Operator} loại thao tác：%property{Action}%n  tên máy hiện tại:%property%ntên máy hiện tại và người dùng đăng nhập：%username %n  
        vị trí ghi： %logger thuộc tính[%property{NDC}] mô tả tin nhắn：%property{Message}%n   bất thường：%exception%n tin nhắn：%message%newline%n%n" />-->

				<!--Ví dụ mẫu：2008-03-26 13:42:32,111 [10] INFO  Log4NetDemo.MainClass [(null)] - info-->
				<!--<conversionPattern value="%newline %nthời gian ghi：%date %nluồngID:[%thread] %nmức nhật ký： %-5level %nmô tả lỗi：%message%newline %n"/>-->
				<conversionPattern value="%n＝＝＝＝＝＝＝＝＝＝
                                  %n【日志级别】%-5level
                                  %n【记录时间】%date[%property{Operator}]
                                  %n【执行时间】[%r]毫秒
                                  %n【操作类型】%property{Action}
                                  %n【请求描述】%message
                                  %n【错误详情】%exception%n"/>
			</layout>
			<filter type="log4net.Filter.LevelRangeFilter,log4net">
				<levelMin value="ERROR" />
				<levelMax value="FATAL" />
			</filter>
		</appender>

		<!--DEBUG：：：ghiDEBUGnhật ký-->
		<!--tách tệp nhật ký theo ngày một ngày một tệp-->
		<!-- appender định nghĩa phương thức xuất nhật ký   ghi nhật ký vào tệp dưới dạng tệp cuộn lại。-->
		<appender name="DebugAppender" type="log4net.Appender.RollingFileAppender">
			<!--đường dẫn lưu：khi dự án khởi động, đường dẫn dưới đây tự động tạiCtạo trong ổ đĩalog、logErrortệp-->
			<file value="LogFile/debug/debug_" />
			<!-- nếu muốn thêm đường dẫn trong dự án này，khi đó trực tiếp bỏ điC:\\  chỉ đặtlog\\LogError   khi dự án khởi động, mặc định tạo tệp -->
			<appendToFile value="true"/>
			<!--theo phương thức nào để tạo nhiều tệp nhật ký(ngày[Date],kích thước tệp[Size],hỗn hợp[Composite])-->
			<rollingStyle value="Date"/>
			<!--đây là thư mục tạo theo ngày-->
			<datePattern value="yyyy-MM-dd'.log'"/>
			<!--có chỉ ghi vào một tệp hay không-->
			<staticLogFileName value="false"/>
			<!--được giữ lạilogsố lượng tệp sau khi vượt quá số lượng này tự động xóa các bản ghi trước đó   hình như chỉ khi theoSizehiệu lực khi tách giá trị đặtvalue="－1"là không giới hạn số tệp-->
			<param name="MaxSizeRollBackups" value="100"/>
			<!--kích thước mỗi tệp。chỉ sử dụng trong phương thức hỗn hợp và phương thức theo kích thước tệp。sau khi vượt quá kích thước, tự động thêm số nguyên dương vào sau tất cả tên tệp để đổi tên，số lớn nhất được ghi sớm nhất。đơn vị có thể dùng:KB|MB|GB。không sử dụng số thập phân,nếu không sẽ luôn ghi vào nhật ký hiện tại-->
			<maximumFileSize value="10MB" />
			<!-- layout điều khiểnAppenderđịnh dạng xuất của，cũng có thể làxml  mộtAppenderchỉ có thể là mộtlayout-->
			<layout type="log4net.Layout.PatternLayout">
				<!--mô tả bằng chữ ở cuối mỗi nhật ký-->
				<!--định dạng xuất mẫu-->
				<!-- <param name="ConversionPattern"  value="thời gian ghi：%date luồngID:[%thread] mức nhật ký：%-5level lớp ghi：%logger   
        người thao tácID：%property{Operator} loại thao tác：%property{Action}%n  tên máy hiện tại:%property%ntên máy hiện tại và người dùng đăng nhập：%username %n  
        vị trí ghi：%location%n mô tả tin nhắn：%property{Message}%n   bất thường：%exception%n tin nhắn：%message%newline%n%n" />-->

				<!--Ví dụ mẫu：2008-03-26 13:42:32,111 [10] INFO  Log4NetDemo.MainClass [(null)] - info-->
				<!--<conversionPattern value="%newline %nthời gian ghi：%date %nluồngID:[%thread] %nmức nhật ký： %-5level %nmô tả lỗi：%message%newline %n"/>-->
				<conversionPattern value="%n＝＝＝＝＝＝＝＝＝＝
                                  %n【日志级别】%-2level
                                  %n【记录时间】%date
                                  %n【执行时间】[%r]毫秒
                                  %n【debug位置】%logger 属性[%property{NDC}]
                                  %n【debug描述】%message"/>
			</layout>
			<filter type="log4net.Filter.LevelRangeFilter,log4net">
				<levelMin value="ALL" />
				<levelMax value="WARN" />
			</filter>
		</appender>
		<!-- ghi nhật ký vào tệp dưới dạng tệp cuộn lại -->
		<!-- tách tệp nhật ký theo ngày，đồng thời lấy ngày làm tên tệp nhật ký -->
		<appender name="InfoAppender" type="log4net.Appender.RollingFileAppender">
			<!-- vị trí lưu tệp nhật ký，có thể là đường dẫn tuyệt đối hoặc đường dẫn tương đối -->
			<file value="LogFile/info/info_" />
			<!-- nối thông tin nhật ký vào tệp nhật ký đã có-->
			<appendToFile value="true" />
			<!-- chế độ khóa tối thiểu，để cho phép nhiều tiến trình ghi vào cùng một tệp -->
			<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
			<!-- chỉ định tách tệp nhật ký theo ngày -->
			<rollingStyle value="Date" />
			<!-- quy tắc đặt tên tệp nhật ký -->
			<!--<datePattern value="&quot;Logs_&quot;yyyyMMdd&quot;.log&quot;"/>-->
			<datePattern value="yyyy-MM-dd'.log'"/>
			<!-- khi lấy ngày làm tên tệp nhật ký，phảistaticLogFileNameđặt giá trị của thànhfalse -->
			<staticLogFileName value="false" />
			<maxSizeRollBackups value="5" />
			<maximumFileSize value="10MB" />
			<!-- mẫu hiển thị nhật ký -->
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%n＝＝＝＝＝＝＝＝＝＝
                                  %n【日志级别】%-2level
                                  %n【记录时间】%date
                                  %n【执行时间】[%r]毫秒
                                  %n【debug位置】%logger 属性[%property{NDC}]
                                  %n【debug描述】%message"/>
			</layout>
			<filter type="log4net.Filter.LevelRangeFilter,log4net">
				<levelMin value="ALL" />
				<levelMax value="OFF" />
			</filter>
		</appender>
		<!--Set root logger level to DEBUG and its only appender to A1-->
		<root>
			<!--mức kiểm soát，từ thấp đến cao: ALL|DEBUG|INFO|WARN|ERROR|FATAL|OFF-->
			<level value="ALL" />
			<appender-ref ref="DebugAppender" />
			<appender-ref ref="ErrorAppender" />
			<appender-ref ref="InfoAppender" />
		</root>
	</log4net>
</configuration>
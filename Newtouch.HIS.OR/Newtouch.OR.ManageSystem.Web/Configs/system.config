<?xml version="1.0" encoding="utf-8"?>
<appSettings>
  <!-- ================== 1：Cấu hình tham số phần mềm hệ thống ================== -->
  <!-- Phiên bản phần mềm -->
  <add key="Version" value="1.00.00.0" />

  <!-- ================== 2：Cấu hình liên quan đến hệ thống phát triển ================== -->
  <!-- Có hiển thị mã xác minh khi đăng nhập không -->
  <add key="Is_CheckChkCode" value="false"/>
  <!-- Thời gian duy trì trạng thái đăng nhập（Đơn vị：phút）-->
  <add key="LoginStatusKeepMinute" value="3000" />
  <!-- Đa thiết bị tự đăng xuất lẫn nhau -->
  <add key="EnableMultipleLoginLimit" value="true" />
  <!-- Đa thiết bị tự đăng xuất lẫn nhau-Cùng một tài khoản，Số người trực tuyến đồng thời tối đa -->
  <add key="MultipleLoginLimit_Count" value="10" />
  <!-- Reidscủa bộ nhớ đệmkeyTiền tố（Để khi nhiều ứng dụng dùng chung một cơ sở dữ liệu，tránh bộ nhớ đệm bị rối loạn） -->
  <add key="Reids_Cache_Prefix" value="$OR$"/>
  <!-- Ứng dụngId -->
  <add key="AppId" value="OR"/>
  <add key="AppName" value="手术室管理系统"/>

  <!-- Trangdomain（Nhúng trang từ miền khác，và thực thijs cần đặt thành cùng một miền）-->
  <add key="Document_Domain" value="localhost"/>
  <!-- APIĐịa chỉ-Đổi danh tính người dùng ủy quyền thống nhất settapiĐịa chỉ -->
  <add key="UAUserInfoGetAPI" value="http://localhost:7002/api/UA/GetUserInfo"/>
  <!-- SettCấu hình địa chỉ（Cấu hình đăng nhập ủy quyền thống nhất）（Sett.WebĐịa chỉ mạng ngoài） -->
  <add key="Sett_UALoginAddress" value="http://127.0.0.1:8002/Login/UALogin"/>
  
  <!-- Tổ chức cấp cao nhấtId -->
  <add key="Top_OrganizeId" value="d8ee85f8-d8d1-4b5c-bd9e-1761f44242d8"/>
  <!-- Tạo người dùng mới khi Vai trò liên kết mặc định -->
  <add key="CreateUser_Default_RoleCode" value="DefaultRole"/>
  <!-- của trang tĩnhHost Mạng công cộngip-->
  <add key="SiteStaticHost" value="http://localhost:8014/"/>
  <!-- của dịch vụ nhật kýUrl Trường đã bỏ-->
  <add key="His.Log.URL" value="http://59.80.30.157:20106/"/>
  <!-- Công tắc-Có tải cây menu bên trái không（Tải mặc định） -->
  <add key="Is_LoadNavTree" value="true"/>
  <!-- Công tắc-Có bật giám sát trang menu không（Cây menu bên trái，Nhấp chuột，thời gian tải trang bên phải） -->
  <add key="Is_NavPageLoadMoniter" value="true"/>
  <!-- Máy chủ báo cáo Host http://59.80.30.160:56014/ Trường đã bỏ-->
  <add key="ReportServer.HOST" value="http://59.80.30.160:56014/ReportServer/"/>

  <!-- ================== 3：Cấu hình liên quan đến nghiệp vụ ================== -->


  <!-- ================== Khác ================== -->
  <add key="vs:EnableBrowserLink" value="false"/>
</appSettings>

@{
    ViewBag.Title = "Cấp độ vết mổ";
    Layout = "~/Views/Shared/_Index.cshtml";
}


<style>
    body {
        background: #DFC2F2;
        background-image: linear-gradient( 135deg, #d5b1f8 10%, #a49cf2 100%);
        background-attachment: fixed;
        background-size: cover;
        /*color:#3dd73c*/
    }
</style>
<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-pencil-square-o"></i>Xóa</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Mã/Tên" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>
    $(function () {
        GridInit();
    });

    function GridInit() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/Operation/OpNotchGrade/GetPagintionList",
            autowidth: true,
            height: $(window).height() - 118,
            colModel: [
                { label: "Id", name: "Id", hidden: true },
                { label: "Mã", name: "Code", width: 180, align: 'left' },
                { label: "Tên", name: "Name", width: 180, align: 'left' },
                { label: "Thời gian tạo", name: "CreateTime", width: 180, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }},
                { label: "Người tạo", name: "CreatorCode", width: 160, align: 'left' }
            ],
            sortname: "ID desc",
            rowNum: 13,
            pager: "#gridPager",
            viewrecords: true,
            ondblClickRow: function () {
                btn_edit();
            },
        });
        $("#btn_search").click(function () {
            $("#gridList").jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword").val() }, page: 1
            }).trigger('reloadGrid');
        });
    }

    function btn_add() {
        window.$.modalOpen({
            id: "Form",
            title: "Thêm mới cấp độ vết mổ",
            url: "/Operation/OpNotchGrade/Form",
            width: "500px",
            height: "350px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                });
            }
        });
    }

    function btn_edit() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return false;
        }
        $.modalOpen({
            id: "updateForm",
            title: "Sửa cấp độ vết mổ",
            url: "/Operation/OpNotchGrade/Form?keyValue=" + keyValue,
            width: "500px",
            height: "350px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                });
            }
        });
    }

    function btn_delete() {
        window.$.modalConfirm("Bạn có chắc chắn muốn xóa không?？", function (flag) {
            if (!flag) {
                return false;
            }
            return true;
        });
        var keyValue = window.$("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            window.$.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return false;
        }
        window.$.deleteForm({
            url: "/Operation/OpNotchGrade/DeleteData",
            param: { keyValue: keyValue },
            success: function () {
                $.modalMsg("Xóa thành công", "success");
                $('#gridList').jqGrid("clearGridData"); //Xóa chi tiết củagrid
                $("#btn_search").trigger("click");
            }
        });
        return true;
    }
</script>


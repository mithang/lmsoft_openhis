@using Newtouch.OR.ManageSystem.Infrastructure
@using Newtouch.Tools

@{
    ViewBag.Title = "Xếp lịch phẫu thuật";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    .container {
        background-color: #ffffff !important;
        height: 100vh; /*Chiều cao của phần tử bằng window chiều cao của*/
        width: 99%;
    }

    .tableth {
        background-color: #e2eef1;
        border-top-left-radius: 4px;
        border-top-right-radius: 4px;
    }
    .btn{
        font-weight:bold;
        padding-left:15px;
        padding-right:15px;
    }

    /*    .table {
        margin: 30px 5px 0px 5px;
        background-color: #ededfc;
        border-bottom-right-radius: 5px;
        border-bottom-left-radius: 5px;
    }*/
    /*Khắc phục việc đặt độ rộng cột tiêu đề không có hiệu lực*/
    /* #table{
            table-layout: fixed;
        }*/
    /*Khắc phục sau khi cố định tiêu đề,Tiêu đề và nội dung bảng không thẳng hàng*/
    .table_list_box {
        table-layout: fixed !important;
    }

    .fixed-table-header {
        border-right: solid 1px #ddd;
        border-top: solid 1px #ddd;
    }

        .fixed-table-header table {
            border-top: solid 0px #ddd !important;
            margin-top: -1px;
        }
    .input-wrap {
        max-width: 100px;
    }

        .input-wrap input {
            width: 100%;
            overflow-wrap: break-word;
        }
    .btnopr {
        margin: 2px 3px;
    }
</style>
<div class="container">
    <div class="row" style="height:99%;">
        <div class="col-sm-12" style="height:100%;">
            <div class="row toolbar" id="toolbar" style="height: 5%; width: 99%;">
                <table class="form">
                    <tr>
                        <td class="formTitle">Ngày phẫu thuật：</td>
                        <td class="formValue" colspan="2">
                            <input id="txt_ksrq" type="text" class="form-control input-wdatepicker" style="float:left;width:45%;" onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" value="@DateTime.Now.ToString("yyyy-MM-01")">
                            <span style="float:left;">_</span>
                            <input id="txt_jsrq" type="text" class="form-control input-wdatepicker" style="float:left;width:45%;" onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" value="@DateTime.Now.AddMonths(1).ToString("yyyy-MM-dd")">
                        </td>
                        <td class="formTitle">Trạng thái phẫu thuật：</td>
                        <td class="formValue formDdlSelectorTd">
                            <select class="form-control" id="sszt" data-enumtype="EnumSSzt">
                                <option value="">===Tất cả===</option>
                            </select>
                        </td>
                        <td class="formTitle">Khu bệnh：</td>
                        <td class="formValue formDdlSelectorTd">
                            <select id="bqlist" name="bqlist" class="form-control " style="float:left;">
                                <option value=""> ==Vui lòng chọn== </option>
                            </select>
                        </td>
                        <td class="formTitle"></td>
                        <td class="formValue"></td>
                    </tr>
                    <tr>
                        <th class="formTitle">Tên bệnh nhân/Số nhập viện：</th>
                        <td class="formValue" colspan="2">
                            <input id="txt_keyword" name="txt_keyword" class="form-control" />
                        </td>
                        <td class="formTitle">Bác sĩ phẫu thuật chính：</td>
                        <td class="formValue formDdlSelectorTd">
                            <input id="stafflist" value="undefined" type="hidden" />
                            <input id="staffname" attr-code="" attr-zjm="" name="staffname" type="text" class="form-control required" autocomplete="off" />

                        </td>
                        <td class="formTitle">Phòng mổ：</td>
                        <td class="formValue formDdlSelectorTd">
                            <select id="roomlist" name="roomlist" class="form-control ">
                                <option value=""> ==Vui lòng chọn== </option>
                            </select>
                        </td>
                        <td class="formTitle"></td>
                        <td class="formTitle">
                            <a class="btn btn-primary btn-md btn-block" id="btn_search" value=""><i class="fa fa-search"></i> Tra cứu</a>
                        </td>
                    </tr>
                </table>
            </div>
            <table class="table" id="tabel_sspb" style="width:99%;"></table>
        </div>
    </div>
</div>
@*<div class="panel">
        <div class="panel_body" style="margin-left: 15px;">

            <div>
                <div class="row toolbar" id="toolbar"></div>
                <table id="gridList"></table>
            </div>
        </div>
    </div>*@
<script>
	$(function() {
        TableInit();
		$("#bqlist").bindSelect({
			url: "/Operation/Common/Getbqlist",
			id: "bqcode",
			text: "bqmc"
		});
		$("#roomlist").bindSelect({
			url: "/Operation/Common/GetRoomlist",
			id: "Code",
			text: "Name",
			minimumResultsForSearch: 0
		});
		$("#staffname").staffFloatingSelector({
			organizeId: '',
			width: 200,
			itemdbclickhandler: function($this) {
				$("#staffname").val($this.attr('data-name')).attr("attr-code", $this.attr('data-id'))
					.attr("attr-zjm", $this.attr('data-zjm'));
				var name = $("#stafflist").val($this.attr('data-name')).val();
				var code = $("#stafflist").val($this.attr('data-code')).val();
				$("#staffname").html(name);
				$("#stafflist").html(code);
			}
        });
        $('#btn_search').click(function () {
            tableRefresh();
        });
	});

    function arrangeShow(rowid) {
        var rowData = $('#tabel_sspb').bootstrapTable("getRowByUniqueId", rowid);
        keyValue = rowData.Id;
        var menuname = "Xếp lịch phẫu thuật-" + rowData.xm;

        top.top.$.Newtouchtab.addTabWithOutMenu({ name: menuname, enName: "", url: "/Operation/OpArrangement/OperationProcDetail?keyValue=" + keyValue + "&zyh=" + rowData.zyh });
    //    top.top.$.Newtouchtab.addTabWithOutMenu({ name: menuname, enName: "", url: "/Operation/OpArrangement/ArrangementDetail?keyValue=" + keyValue });
    }
    function registOperation(rowid) {
        var rowData = $('#tabel_sspb').bootstrapTable("getRowByUniqueId", rowid);
        keyValue = rowData.Id;
        var menuname = "Đăng ký phẫu thuật";
        top.top.$.Newtouchtab.addTabWithOutMenu({ name: menuname, enName: "", url: "/Operation/OpRegister/Index?keyValue=" + keyValue + "&zyh=" + rowData.zyh });
    }

    function arrangeCancel(val) {
        window.$.modalConfirm("Bạn có chắc chắn muốn hủy không?？", function (flag) {
            if (!flag) {
                return false;
            }
            return true;
        });
        if ($("#gridList").jqGridRowValue() == undefined) {
			var keyValue = $("#gridList").jqGridRowValue()[val].Id;
        } else {
			var keyValue = $("#gridList").jqGridRowValue().Id;
        }
        if (!!!keyValue) {
            window.$.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return false;
        }
        window.$.deleteForm({
            url: "/Operation/OpArrangement/DeleteForm",
            param: { keyValue: keyValue },
            success: function () {
                $.modalMsg("Hủy thành công", "success");
                $("#gridList").trigger("reloadGrid");
            }
        });
        return true;
    }

    function getRoom(oproom) {
        var roomName = "";
        $.ajax({
            url: "/Operation/Common/GetRoomlist",
            data: { Code:oproom},
            dataType: "json",
            success: function (data) {
                roomName= data[0].Name;
            }
        });
        return roomName;
    }

    function tableRefresh() {
        $('#tabel_sspb').bootstrapTable('refresh', { queryParams: queryParams });
    }

    //Tham số yêu cầu
    function queryParams(params) {
        var data = {
            //Số bản ghi mỗi trang
            limit: params.limit,
            //Yêu cầu trang thứ mấy
            offset: params.offset,
            order: params.order,
            sort: params.sort,
            search: params.search,
            queryParams: {
                keyword: $("#txt_keyword").val(),
                ksrq: $("#txt_ksrq").val(),
                jsrq: $("#txt_jsrq").val(),
                sszt: $("#sszt option:selected").val(),
                bq: $("#bqlist option:selected").val(),
                ysgh: $("#stafflist").val(),
                room: $("#roomlist option:selected").val()
            }
        };
        return data;
    }
    function getPatListTableHeight() {
        var height = $(window).height() - $('#toolbar').height()-20;
        return height;
    }
    var tableCols = [{
        field: 'Id',
        title: 'Id',
        visible: false
    }, {
        field: 'Applyno',
        title: 'Số đơn đăng ký',
        halign: "center",
        align: 'left',
        valign: 'middle',
        width: 2,
        unitWidth: "%",
    }, {
        field: 'xm',
        title: 'Tên bệnh nhân',
        halign: "center",
        align: 'left',
        valign: 'middle',
    }, {
        field: 'xb',
        title: 'Giới tính',
        halign: "center",
        align: 'center',
        valign: 'middle',
        //width: 2,
        //unitWidth: "%",
        formatter: function (value, row, index) {
            return $.getGender(row.xb);
        }
    }, {
        field: 'nl',
        title: 'Tuổi',
        halign: "center",
        align: 'center',
        valign: 'middle',
    }, {
        field: 'zyh',
        title: 'Số nhập viện',
        halign: "center",
        align: 'center',
        valign: 'middle',
    }, {
        field: 'bq',
        title: 'Khu bệnh',
        halign: "center",
        align: 'center',
        valign: 'middle',
    }, {
        field: 'ch',
        title: 'Số giường',
        halign: "center",
        align: 'center',
        valign: 'middle',
    }, {
        field: 'zd',
        title: 'Chẩn đoán',
        halign: "center",
        align: 'left',
        valign: 'middle',
    }, {
        field: 'sqzt',
        title: 'Trạng thái phẫu thuật',
        halign: "center",
        align: 'left',
        valign: 'middle',
        formatter: function (value, row, index) {
            if (row.sqzt == @((int) EnumSSzt.dpb)) {
                return "Chờ xếp lịch";
            }
            else if (row.sqzt == @((int) EnumSSzt.ypb)) {
                return "Đã xếp lịch";
            }
            else if (row.sqzt == @((int) EnumSSzt.yzf)) {
                return "Đã hủy";
            }
            else if (row.sqzt == @((int) EnumSSzt.yzx)) {
                return "Đã đăng ký";
            }
            else {
                return "Chờ xếp lịch";
            }
        }
    }, {
        field: 'ssmc',
        title: 'Tên phẫu thuật',
        halign: "center",
        align: 'left',
        valign: 'middle',
    }, {
        field: 'sssj',
        title: 'Thời gian phẫu thuật',
        halign: "center",
        align: 'left',
        valign: 'middle',
        formatter: function (value, row, index) {
            return row.sssj.replace("T", " ");
        }
    }, {
        field: 'ysxm',
        title: 'Bác sĩ phẫu thuật chính',
        halign: "center",
        align: 'center',
        valign: 'middle'
    }, {
        field: '',
        title: 'Chi tiết',
        halign: "center",
        align: 'center',
        valign: 'middle',
        formatter: function (value, row, index) {
            if (row.sqzt == '@((int)EnumSSzt.ypb)') {
                return "<a class='btn btn-info btnopr'  onclick='arrangeShow(\"" + row.Id + "\")'>Chi tiết xếp lịch</a> <a class='btn btn-default btnopr' onclick='arrangeCancel(\"" + row.Id + "\")'>Hủy xếp lịch</a> <a class='btn btn-warning btnopr' onclick='registOperation(\"" + row.Id + "\")'>Đăng ký</a>";
            }
            else if (row.sqzt == '@((int)EnumSSzt.dpb)' || row.sqzt == "" || row.sqzt == null) {
                return "<a class='btn btn-success btnopr' onclick='arrangeShow(\"" + row.Id + "\")'>Xếp lịch</a>";
            }
            else if (row.sqzt=='@((int)EnumSSzt.yzx)') {
                return "<a class='btn btn-info btnopr' onclick='arrangeShow(\"" + row.Id + "\")'>Chi tiết đăng ký</a>";
            }
            return "";
        }
    }];
    function TableInit() {
        $('#tabel_sspb').bootstrapTable('destroy').bootstrapTable({
            url: '/Operation/OpArrangement/GetGridList',
            method: 'POST',                      //Phương thức yêu cầu dữ liệu
            contentType: "application/x-www-form-urlencoded",
            // classes: "table table-bordered table-striped table-hover",
            search: false,
            striped: true, //Có hiển thị màu xen kẽ các dòng không
            toolbar: '#toolbar',            //Nút công cụ dùng vùng chứa nào #toolbar
            //toolbarAlign: 'left',
            uniqueId: "Id",
            //******Cài đặt phân trang****
            queryParams: queryParams,
            pagination: true,                   //Có hiển thị phân trang không（*）
            pageNumber: 1,                      //Tải khởi tạo trang đầu tiên，Mặc định trang đầu tiên,và ghi lại
            pageSize: 10,                       //Số dòng bản ghi mỗi trang（*）
            pageList: [20, 50, 100],            //Số dòng mỗi trang có thể chọn（*）
            paginationHAlign: "left",
            paginationDetailHAlign: "right",
            //sortable: true,                     //Có bật sắp xếp không
            //sortOrder: "asc",                   //Cách sắp xếp
            sidePagination: 'client',           //Phương thức phân trang：clientPhân trang phía máy khách，serverPhân trang phía máy chủ（*）
            showPaginationSwitch: false,
            //******Cài đặt phân trang****
            //******Cài đặt tiêu đề bảng****
            showHeader: true,                   //Hiển thị tiêu đề bảng
            theadClasses: "tableth",        //Đặt kiểu tiêu đề bảng tại đây
            //******Cài đặt tiêu đề bảng****
            showRefresh: false,//Nút làm mới
            height: getPatListTableHeight(),
            columns: tableCols,
            onDblClickRow: function (row, $element, field) {
                //PatInit(row.zyh);

            },
        }).bootstrapTable("hideLoading");
    }
</script>

@using Newtouch.OR.ManageSystem.Infrastructure
@{
    ViewBag.Title = "Đơn đăng ký phẫu thuật";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<style>
    .heightfull {
        height: 100%;
    }

    .heighthalf {
        height: 50%;
    }

    .container {
        background-color: #ffffff !important;
        height: 100vh; /*Chiều cao của phần tử bằng window chiều cao*/
    }

    .form-control {
        height: 99% !important;
        padding: 6.5px 5px !important;
    }

    .colorgreen {
        color: #689f38;
    }

    .card {
        width: 95%;
        margin: 0px 10px;
        position: relative;
        border: 1px solid #ddd;
        background-color: #fff;
        padding: 10px;
        box-shadow: 10px 10px 0px #ddd; /*Bóng ngang và dọc*/
    }

    .patcard {
        background-color: #f3ebfb;
        padding-bottom: 10px;
        width:100%;
    }
    .title {
        font-weight: bold;
        font-size: 20px;
        color: #00a0ea;
        padding: 15px 25px 5px 25px;
        width: 100%;
        text-align: center;
    }



    .tableth {
        background-color: #e2eef1;
        border-top-left-radius: 4px;
        border-top-right-radius: 4px;
    }
    /*.table {
        margin: 30px auto 0px auto;
        background-color: #ededfc;
        border-bottom-right-radius: 5px;
        border-bottom-left-radius: 5px;
    }

    .fixed-table-header {
        border-right: solid 1px #ddd;
        border-top: solid 1px #ddd;
        border-top-right-radius: 5px;
        border-top-left-radius: 5px;
    }

        .fixed-table-header table {
            border-top: solid 0px #ddd !important;
            margin-top: -1px;

        }*/
    .btnopr {
        margin: 2px 3px;
    }
</style>
<div class="container">
    <div class="row heightfull">
        <div class="col-xs-6 col-sm-4 heightfull">
            <div class="row toolbar" id="toolbar" style="height:5%;">
                <div class="col-sm-5">
                    <select id="bqlist" name="bqlist" class="form-control ">
                        <option value="">   Tất cả khoa phòng   </option>
                    </select>
                </div>
                <div class="col-sm-6">
                    <div class="row">
                        <div class="col-sm-11">
                            <div class="input-group">
                                <input id="txt_keyword" type="text" class="form-control" placeholder="Tên bệnh nhân/Số nhập viện">
                                <span id="btn-search" class="input-group-addon btn-success"><i class="fa fa-search"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div style="height:94%;">
                <table class="table" id="table"></table>
            </div>
            
        </div>

        <div class="col-xs-6 col-sm-8 heightfull" style="overflow-y:auto;">
             
                @Html.Partial("_PatientCard")
            <div class="row" style="padding-top: 10px; padding-left: 10px; height: 70%; width: 99%;">
                <ul class="nav nav-tabs navb-bg" id="myTab">
                    <li role="presentation"><a href="#linkpat" role="tab" data-toggle="tab">Danh sách phẫu thuật</a></li>
                    <li role="presentation"><a href="#linkop" role="tab" data-toggle="tab">Đơn đăng ký phẫu thuật</a></li>
                </ul>
                <div class="tab-content">
                    <div id="dv-pat" style="display: none; width:95%;">
                        <div class="row" style="padding:10px 10px;">
                            <div id="time_horizon" class="btn-group col-sm-11">
                                <a class="btn btn-default active" data-value="">Tất cả</a>
                                <a class="btn btn-default" data-value="@((int)EnumSqzt.dsh)">Đã gửi đơn</a>
                                <a class="btn btn-default" data-value="@((int)EnumSqzt.ypb)">Đã duyệt</a>
                                <a class="btn btn-default" data-value="@((int)EnumSqzt.yqx)">Đã hủy</a>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <table class="table" id="tabel_patop"></table>
                        </div>
                    </div>
                    <div id="dv-op" style="display: none; width: 95%;height:90%;">
                        @Html.Partial("OpApplyCard")
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<script>
    $(function () {
        $("#bqlist").bindSelect({
            url: "/Operation/Common/Getbqlist",
            id: "bqcode",
            text: "bqmc"
        });
        tabInit();
        PatListTableLoad();
        PatOpTableLoad();
        $(".fa-refresh").on('click', function () {
            tableRefresh();
        });


        $("#btn-search").on('click', function () {
            tableRefresh();
        });
        $("#time_horizon a.btn-default").click(function () {
            $("#time_horizon a.btn-default").removeClass("active");
            $(this).addClass("active");
            patOpTableRefresh();
        });

       /* console.log($("#sel_ssmc").select2("data"));*/
    });

    function tabInit() {
        $('a[data-toggle="tab"]').on('show.bs.tab', function (e) {
            switch ($(this).attr('href')) {
                case "#linkpat":
                    $("#dv-pat").show();
                    $("#dv-op").hide();
                    patOpTableRefresh();
                    break;
                case "#linkop":
                    var zyh = $("#zyh").val();
                    if (!zyh) {
                        $.modalAlert("Thông tin bệnh nhân không được để trống", 'warning');
                        return;
                    }
                    $("#dv-pat").hide();
                    $("#dv-op").show();
                    $("#dv_opdetailpat").hide();
                    break;
            }

        });

        $('#myTab a:first').trigger('click');
    }
    function tableRefresh() {
        $('#table').bootstrapTable('refresh', { queryParams: queryParams });
    }
    function patOpTableRefresh() {
        $('#tabel_patop').bootstrapTable('refresh', { queryParams: queryParams });
    }
    //Tham số yêu cầu
    function queryParams(params) {
        var data = {
            //Mỗi trang bao nhiêubản ghi
            limit: params.limit,
            //Yêu cầu trang thứ mấy
            offset: params.offset,
            order: params.order,
            sort: params.sort,
            search: params.search,
            queryParams: {
                bq: $("#bqlist option:selected").val(),
                keyword: $("#txt_keyword").val(),
                zyh: $("#zyh").val(),
                sqlx: $("#time_horizon a.active").attr('data-value'),
            }
        };
        return data;
    }
    function getPatListTableHeight() {
        var height = $(window).height() - $('#toolbar').height();
        return height;
    }
    function getPatOpTableHeight() {
        var height = $(window).height() - $('.card').height()-20;
        return height;
    }
    //Danh sách bệnh nhân colđịnh nghĩa
    var patListColumns = [{
        field: 'Id',
        title: 'Id',
        visible: false
    }, {
        field: 'xm',
        title: 'Họ tên',
        halign: "center",
        align: 'left',
        valign: 'middle',
        formatter: function (value, row, index) {
            return row.sex == "1" ? "<i class='fa fa-male colorgreen' title='Nam'></i> " + row.xm : "<i class='fa fa-female colorgreen' title='Nữ'></i> " + row.xm;
        }
    }, {
        field: 'sex',
        title: 'Giới tính',
        halign: "center",
        align: 'center',
        valign: 'middle',
        visible: false,
        formatter: function (value, row, index) {
            return row.sex == "1" ? "Nam" : "Nữ";
        }
    }, {
        field: 'nl',
        title: 'Tuổi',
        halign: "center",
        align: 'center',
        valign: 'middle',
    }, {
        field: 'zyh',
        title: 'Số nhập viện',
        halign: "center",
        align: 'center',
        valign: 'middle',
    }, {
        field: 'zdmc',
        title: 'Chẩn đoán nhập viện',
        halign: "center",
        align: 'left',
        valign: 'middle',
    }, {
        field: 'ryrq',
        title: 'Ngày nhập viện',
        halign: "center",
        align: 'center',
        valign: 'middle',
        visible: false
    }, {
        field: 'WardName',
        title: 'Khoa phòng',
        halign: "center",
        align: 'center',
        valign: 'middle',
    }];
    function PatlistTable() {
        $('#table').bootstrapTable('refresh', { url: '/Operation/OpApply/GetPatGridList', queryParams: queryParams });
    }
    function PatListTableLoad() {
        $('#table').bootstrapTable('destroy').bootstrapTable({
            url: '/Operation/OpApply/GetPatGridList',
            method: 'POST',                      //Phương thức yêu cầu dữ liệu
            contentType: "application/x-www-form-urlencoded",
           // classes: "table table-bordered table-striped table-hover",
            search: false,
            striped: true, //Có hiển thị màu xen kẽ hàng không
            toolbar: '#toolbar',            //Nút công cụ dùng container nào #toolbar
            //toolbarAlign: 'left',
            //******Cài đặt phân trang****
            queryParams: queryParams,
            pagination: true,                   //Có hiển thị phân trang không（*）
            pageNumber: 1,                      //Tải trang đầu tiên khi khởi tạo，Mặc định trang đầu tiên,và ghi lại
            pageSize: 20,                       //Số dòng bản ghi mỗi trang（*）
            pageList: [20, 50, 100],            //Số dòng mỗi trang có thể chọn（*）
            paginationHAlign: "left",
            paginationDetailHAlign: "right",
            //sortable: true,                     //Có bật sắp xếp không
            //sortOrder: "asc",                   //Cách sắp xếp
            sidePagination: 'client',           //Cách phân trang：clientPhân trang phía client，serverPhân trang phía server（*）
            showPaginationSwitch: false,
            //******Cài đặt phân trang****
            //******Cài đặt tiêu đề bảng****
            showHeader: true,                   //Hiển thị tiêu đề bảng
            theadClasses: "tableth",        //Đặt kiểu tiêu đề bảng tại đây
            //******Cài đặt tiêu đề bảng****
            showRefresh: false,//Nút làm mới
            height: getPatListTableHeight(),
            columns: patListColumns,
            onDblClickRow: function (row, $element, field) {
                PatInit(row.zyh);

            },
        }).bootstrapTable("hideLoading");
    }




    /***************Danh sách phẫu thuật của bệnh nhân*************** */
    var patOpColumns = [{
        field: 'Id',
        title: 'Id',
        visible: false
    }, {
            field: 'sqzt',
            title: 'sqzt',
            visible: false
        }, {
        field: 'ssmcn',
        title: 'Tên phẫu thuật',
        halign: "center",
        align: 'left',
        valign: 'middle'
        }, {
            field: 'sssj',
            title: 'Thời gian phẫu thuật',
            halign: "center",
            align: 'left',
            valign: 'middle',
        formatter: function (value, row, index) {
            return row.sssj.replace("T", " ");
            }
        },
        {
            field: 'sqztmc',
            title: 'Trạng thái phẫu thuật',
            halign: "center",
            align: 'center',
            valign: 'middle',
            formatter: function (value, row, index) {
                if (row.sqzt == (@((int)EnumSqzt.dsh))) {
                    return "Đã gửi đơn";
                }
                else if (row.sqzt == (@((int)EnumSqzt.ypb))) {
                    return "Đã xếp lịch";
                }
                else if (row.sqzt == (@((int)EnumSqzt.yqx))) {
                    return "Đã hủy đơn";
                }
                else {
                    return "Trạng thái bất thường";
                }
            }
        }, {
            field: 'ysxm',
            title: 'Bác sĩ mổ chính',
            halign: "center",
            align: 'left',
            valign: 'middle'
        }, {
            field: 'LastModifyTime',
            title: 'Cập nhật gần nhất',
            halign: "center",
            align: 'left',
            valign: 'middle',
            formatter: function (value, row, index) {
                if (!row.LastModifyTime) {
                    return row.CreateTime.replace("T", " ");
                }
                return row.LastModifyTime.replace("T", " ");
            }
        }, {
            field: 'Applyno',
            title: 'Số đơn đăng ký phẫu thuật',
            align: 'left',
            valign: 'middle'
        }, {
        field: 'nl',
        title: 'Chi tiết',
        halign: "center",
        align: 'center',
        valign: 'middle',
        formatter: function (value, row, index) {
            if (row.sqzt == (@((int)EnumSqzt.dsh))) {
                return "<a class='btn btn-info btnopr' onclick='showDetail(\"" + row.Id + "\")'>&nbsp;Chi tiết&nbsp;</a>&nbsp;&nbsp;<a class='btn btn-danger btnopr' onclick='applyCancel(\"" + row.Id + "\")'>&nbsp;Hủy bỏ&nbsp;</a>";
            }
            else {
                return "<a class='btn btn-info btnopr' onclick='showDetail(\"" + row.Id + "\")'>&nbsp;Chi tiết&nbsp;</a>";
            }
        }
    }];
    function PatOpTableLoad() {
        $('#tabel_patop').bootstrapTable('destroy').bootstrapTable({
            url: '/Operation/OpApply/GetGridListOP',
            method: 'POST',                      //Phương thức yêu cầu dữ liệu
            contentType: "application/x-www-form-urlencoded",
            //classes: "table table-bordered table-striped table-hover",
            search: false,
            striped: true, //Có hiển thị màu xen kẽ hàng không
            queryParams: queryParams,
            pagination: false,                   //Có hiển thị phân trang không（*）
            uniqueId:"Id",
            //sortable: true,                     //Có bật sắp xếp không
            //sortOrder: "asc",                   //Cách sắp xếp
            //******Cài đặt tiêu đề bảng****
            showHeader: true,                   //Hiển thị tiêu đề bảng
            theadClasses: "tableth",        //Đặt kiểu tiêu đề bảng tại đây
            //******Cài đặt tiêu đề bảng****
            showRefresh: false,//Nút làm mới
            /* height: getTableHeight(),*/
            columns: patOpColumns,
        }).bootstrapTable("hideLoading");
        $(".fixed-table-loading").remove();
        $(".no-records-found").remove();
    }

    var $Operations = $("#sel_ssmc").select2({
        language: "zh-CN",
        allowClear: true,
        ajax: {
            url: "/Operation/Common/GetOperations",
            delay: 250,
            data: function (params) {
                var query = {
                    ssdmData: params.term
                }
                return query;
            },
            processResults: function (data) {
                return processResultsData(data);
            },
            cache: true,
        },
    });

    function processResultsData(resultData) {
        //Trả về dữ liệu cuối cùngdata chodataArray
        var jsonObj = JSON.parse(resultData);
        var dataArray = [];
        for (var i = 0; i < resultData.length; i++) {
            var dataObj = {};
            if (!!jsonObj[i]) {
                dataObj.id = jsonObj[i].ssdm;
                dataObj.text = jsonObj[i].ssmc;
                dataArray.push(dataObj);
            }
        }
        return {
            results: dataArray
        };
    }

    function OperationDicAjax(ssdmArray) {
        $.najax({
            url: "/Operation/Common/GetOperationAjax",
            data: { ssdm: !!ssdmArray? ssdmArray.join(","):null },
            dataType: "json",
            success: function (data) {
                if (data.length > 0) {
                    var selData = $("#sel_ssmc").val();
                    if (ssdmArray != null && ssdmArray.length > 0 && (!selData || (!!selData && selData.length != ssdmArray.length))) {
                        var array = [];
                        $.each(data, function () {
                            var option = new Option(this.ssmc, this.ssdm, true, true);
                            $Operations.append(option);
                        });

                        $Operations.trigger("change");
                        //OperationsRefresh();
                        //$("#sel_ssmc").val(ssdmArray).trigger("change");
                    }
                }

            }
        });
    }

    //Nút đăng ký phẫu thuật
    function showOpApply() {
        var zyh = $("#zyh").val();
        if (!zyh) {
            $.modalAlert("Thông tin bệnh nhân không được để trống", 'warning');
            return;
        }
        $('#myTab [href="#linkop"').trigger('click');
        $.ajax({
            url: "/Operation/OpApply/GetFormJson",
            data: { keyValue: "" },
            dataType: "json",
            success: function (data) {
                $("#formapply").formSerialize(data);
                $("#sel_ssmc").val("").trigger("change");
                $("#dv_apply_btn").show();
                $("#dv_cancel_btn").hide();
                //$("#dv_back_btn").show();
            }
        });

    }
    //Xem chi tiết đơn đăng ký phẫu thuật
    function showDetail(rowid) {
        var rowData=$('#tabel_patop').bootstrapTable("getRowByUniqueId", rowid);
        /*var rowData = $('#table').bootstrapTable('getSelections');*/
          if (rowData.sqzt ==@((int)EnumSqzt.dsh)) {
              $("#dv_apply_btn").show();
              $("#dv_cancel_btn").show();
              //$("#dv_back_btn").hide();
          }
          else if (rowData.sqzt ==@((int)EnumSqzt.ypb)) {
              $("#dv_apply_btn").hide();
              $("#dv_cancel_btn").hide();
              //$("#dv_back_btn").show();
          }
          else if (rowData.sqzt ==@((int)EnumSqzt.yqx)) {
              $("#dv_apply_btn").hide();
              $("#dv_cancel_btn").hide();
              //$("#dv_back_btn").show();
        }
        $('#myTab [href="#linkop"').trigger('click');
        $.ajax({
            url: "/Operation/OpApply/GetFormJson",
            data: { keyValue: rowData.Applyno },
            dataType: "json",
            success: function (data) {
                $("#formapply").formSerialize(data);
                //$("#Applyno").html("Số đơn đăng ký phẫu thuật：" + data.Applyno);
                if (data.sssj != null) {
                    $("#sssj").val(data.sssj.replace("T", " "));
                }
                OperationDicAjax(data.ssdm);
                $("#sel_ssmc").val(data.ssdm).trigger("change");
                $("#ysgh").val(data.ysxm);
                $("#zdysgh").val(data.ysgh);
                $("#mzysgh").val(data.mzys);
                $("#mzys").val(data.mzysxm).data("name", data.mzysxm).attr("attr-code",data.mzys);
            }
        });
    }

    //Hủy chi tiết đơn đăng ký phẫu thuật
    function applyCancel(rowid) {
        var rowData = $('#tabel_patop').bootstrapTable("getRowByUniqueId", rowid);
        $.deleteForm({
            prompt:"Lưu ý: Vui lòng xác nhận có hủy đơn phẫu thuật này không?",
            url: "/Operation/OpApply/DeleteApply",
            param: { keyValue: rowData.Applyno },
            success: function () {
                patOpTableRefresh();
            }
        });
    }

    //Lấy giá trị chọn nhiều
    function getMultiSelectText(id) {
        return $.map($("#" + id).select2('data'), function (value) {
            return value.text
        }).join(",");
    }

    function patchangeRefresh() {
        patOpTableRefresh();
        $('#myTab a:first').trigger('click');
    }
</script>


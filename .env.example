# OpenHIS Docker — example env file. Copy to .env (setup.sh does it for you):
#   cp .env.example .env
# setup.sh generates strong random values automatically when .env is missing.
# NEVER commit a real .env (it is gitignored). NEVER put the VM's real
# secrets in here — this setup generates its own fresh secrets.
#
# SA_PASSWORD: SQL Server 2022 requires at least 8 chars with upper-case,
# lower-case, digit and symbol. Do NOT use "$" (compose would try to
# expand it — write "$$" if you must).
SA_PASSWORD=ChangeMe_Strong1!
# REDIS_PASSWORD: Redis requirepass. Any non-empty string.
REDIS_PASSWORD=ChangeMe_Redis1!
# APP_SECRET: shared by BaseAPI (SSOAuthIdentity), WebAPI.Manage
# (SSOAuthIdentity) and AuthCenter (JWT SSOAuthApp 0-7) in this local setup.
# On the VM each app has its own secret; one shared secret keeps local
# setup to a single value. Use distinct secrets in production.
APP_SECRET=ChangeMe_AppSecret_0123456789abcdef
# AUTHCENTER_JWT_KEY: signing key for AuthCenter-issued JWTs.
AUTHCENTER_JWT_KEY=ChangeMe_JwtKey_0123456789abcdef0123456789abcdef

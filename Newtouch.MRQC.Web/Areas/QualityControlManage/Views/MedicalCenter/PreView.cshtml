@{
    ViewBag.Title = "Xem trước hồ sơ";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <script src="~/Scripts/jquery.min.js"></script>
</head>
<body>
    <div>
        <form method="post" action="#">
            <div style="width:100%;height:100%">
                @Html.Raw(ViewBag.WriterControlHtml)
            </div>
        </form>
    </div>

</body>
</html>

<script>
        // QA-phase2 (MRQC-01): myWriterControl is the DCSoft.Writer control,
        // rendered only when ViewBag.WriterControlHtml is set by the document
        // flow. On a direct GET (and on MedicalCenter/Index, which includes
        // this partial) the element does not exist, so the unconditional
        // ctl.style access threw "ctl is null" on page load. Guard it: the
        // DCSoft editor itself remains Windows-only (deferred), but the page
        // no longer throws when the control is absent.
        var ctl = document.getElementById("myWriterControl");
        if (ctl) {
        ctl.style.height = "800px";
        ctl.Options.workspacebackcolorstring = "#66CCCC"
        }
        //Mở tài liệu
        function FileOpen(fileUrl) {
            var ctl = document.getElementById("myWriterControl");
            if (!ctl) { return; }
            var doc = ctl.GetContentDocument();
            $(doc).find("[dctype='XTextDocumentHeaderElement'],[dctype='XTextDocumentFooterElement'],[dctype='XTextDocumentHeaderForFirstPageElement'],[dctype='XTextDocumentFooterForFirstPageElement']").html("");
            ctl.ClearDocumentBody();
            ctl.preserveScrollPosition = true;
            var fileName = fileUrl;//"//File//Bệnh án nội trú//2023//12//01//03245//011028 Giấy thông báo cho bệnh nhân.xml";
            //Phản hồi sự kiện EventReadFileContent của control ở phía máy chủ là có thể tải tài liệu bằng chế độ AJAX.
            var result = ctl.LoadDocumentFromFile(fileName, null);
            //ctl.ServerMessage trả về lỗi phía máy chủ
            setTimeout(function () { PrintPreview(); }, 300)
            
        }
        //In
        function print() {
            var ctl = document.getElementById("myWriterControl");
            if (!ctl) { return; }
            ctl.PrintDocument();

        }
        //Xem trước khi in
        function PrintPreview() {
            var ctl = document.getElementById("myWriterControl");
            if (!ctl) { return; }
            ctl.LoadPrintPreview();
        }
        var ctl = document.getElementById("myWriterControl");
        function Build() {
            if (!ctl) { return; }
            if (ctl) {
                BindingDCWriterClientControl(ctl);
                ctl.EventAfterPrintPreview = function (PrintPreviewDoc) {
                    var styleDom = document.createElement("style");
                    // Khắc phục lỗi in phông SimSun
                    var cssStr = "@@font-face {font-family: 宋体;src: local('宋体');}";
                    styleDom.innerHTML = cssStr;
                    var page = PrintPreviewDoc.querySelector("div[pageindex]");
                    if (page) {
                        page.appendChild(styleDom);
                    }

                }
            }
            FileOpen();
        }
        Build();

</script>
<?xml version="1.0" encoding="utf-8"?>
<log4net>
	<!-- Ghi nhật ký dưới dạng tệp cuộn (rolling file) -->
	<!-- Chia tệp nhật ký theo ngày và dùng ngày làm tên tệp nhật ký -->
	<appender name="RollingFileAppenderNameByDate" type="log4net.Appender.RollingFileAppender">
		<!-- Vị trí lưu tệp nhật ký, có thể là đường dẫn tuyệt đối hoặc tương đối -->
		<file value="LogFile\info\" />
		<!-- Ghi thêm thông tin nhật ký vào tệp nhật ký hiện có-->
		<appendToFile value="true" />
		<!-- Chế độ khóa tối thiểu để nhiều tiến trình có thể ghi cùng một tệp -->
		<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
		<!-- Chỉ định chia tệp nhật ký theo ngày -->
		<rollingStyle value="Date" />
		<!-- Quy tắc đặt tên tệp nhật ký -->
		<!--<datePattern value="&quot;Logs_&quot;yyyyMMdd&quot;.log&quot;"/>-->
		<datePattern value="yyyyMM/yyyyMMdd&quot;.log&quot;" />
		<!-- Khi dùng ngày làm tên tệp nhật ký, phải đặt giá trị staticLogFileName thành false -->
		<staticLogFileName value="false" />
		<maxSizeRollBackups value="5" />
		<maximumFileSize value="10MB" />
		<!-- Mẫu hiển thị nhật ký -->
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="[%level][Thời gian thực thi]:%date %newline%thread %logger %newline%message%newline--------------------------------------------------------------------%newline" />
		</layout>
	</appender>
	<appender name="ErrorFileAppenderNameByDate" type="log4net.Appender.RollingFileAppender">
		<!-- Vị trí lưu tệp nhật ký, có thể là đường dẫn tuyệt đối hoặc tương đối -->
		<file value="LogFile\error\" />
		<!-- Ghi thêm thông tin nhật ký vào tệp nhật ký hiện có-->
		<appendToFile value="true" />
		<!-- Chế độ khóa tối thiểu để nhiều tiến trình có thể ghi cùng một tệp -->
		<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
		<!-- Chỉ định chia tệp nhật ký theo ngày -->
		<rollingStyle value="Date" />
		<!-- Quy tắc đặt tên tệp nhật ký -->
		<!--<datePattern value="&quot;Logs_&quot;yyyyMMdd&quot;.log&quot;"/>-->
		<datePattern value="yyyyMM/yyyyMMdd&quot;.log&quot;" />
		<!-- Khi dùng ngày làm tên tệp nhật ký, phải đặt giá trị staticLogFileName thành false -->
		<staticLogFileName value="false" />
		<maxSizeRollBackups value="5" />
		<maximumFileSize value="10MB" />
		<!-- Mẫu hiển thị nhật ký -->
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="[%level][Thời gian ngoại lệ]:%date %newline %thread %logger %newline%message%newline--------------------------------------------------------------------%newline" />
		</layout>
		<filter type="log4net.Filter.LevelRangeFilter,log4net">
			<levelMin value="ERROR" />
			<levelMax value="FATAL" />
		</filter>
	</appender>

	<root>
		<!-- Mức kiểm soát, từ thấp đến cao: ALL|DEBUG|INFO|WARN|ERROR|FATAL|OFF -->
		<!-- Ví dụ nếu định nghĩa mức INFO thì các mức dưới INFO, như nhật ký DEBUG, sẽ không được ghi -->
		<!-- Nếu không định nghĩa giá trị LEVEL thì mặc định là DEBUG -->
		<level value="ALL" />
		<!-- Chia tệp nhật ký theo ngày và dùng ngày làm tên tệp nhật ký -->
		<appender-ref ref="RollingFileAppenderNameByDate" />
		<appender-ref ref="ErrorFileAppenderNameByDate" />
	</root>
</log4net>

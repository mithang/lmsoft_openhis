@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";

    var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa đổi</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-pencil-square-o"></i>Xóa</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Tên" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script>
    $(function () {
        gridList();
    })
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            treeGrid: true,
            treeGridModel: "adjacency",
            ExpandColumn: "Icon",
            url: "/SystemManage/SysModule/GetTreeGridJson",
            height: $(window).height() - 96,
            colModel: [
                { label: "Khóa chính", name: "Id", hidden: true, key: true },
                { label: "Hiệu lực", name: "zt", width: 80, align: "center", formatter: function (cellvalue) { return cellvalue == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
                { label: 'Tiếng AnhTên', name: 'EnName', width: 180, align: 'left' },
                { label: 'Tên', name: 'Name', width: 180, align: 'left' },
                {
                    label: "Biểu tượng", name: "Icon", width: 80, align: "center", formatter: function (cellvalue) {
                        if (cellvalue) {
                            return '<i class=\"' + cellvalue + '\"></i>';
                        }
                        else {
                            return "";
                        }
                    }
                },
                { label: 'Kết nối', name: 'UrlAddress', width: 260, align: 'left' },
                {
                    label: 'Mục tiêu', name: 'Target', width: 100, align: 'center',
                    formatter: function (cellvalue) {
                        if (cellvalue == "expand") {
                            return "Không có trang";
                        }
                        else if (cellvalue == "iframe") {
                            return "Trang khung";
                        }
                        else if (cellvalue == "open") {
                            return "Trang bật lên";
                        }
                        else if (cellvalue == "blank") {
                            return "Cửa sổ mới";
                        }
                        else if (cellvalue == "subpage") {
                            return "Trang con";
                        }
                        else if (cellvalue == "toplocation") {
                            return "Cửa sổ hiện tại";
                        }
                    }
                },
                { label: 'Ứng dụng bên ngoài', name: 'AppId', width: 300, align: 'left' },
                { label: 'Có chỉ áp dụng cho tổ chức hiện tại hay không', name: 'OrganizeId', width: 100, align: 'left', formatter: function (cellvalue) { return !!cellvalue ? "Có" : ""; } },
                { label: 'Giới thiệu', name: 'Description', width: 300, align: 'left' },
                    { label: 'Thứ tự sắp xếp', name: 'px', width: 40, align: 'left' },
                { label: 'Người tạo', name: 'CreatorCode', width: 100, align: 'left' },
                { label: 'Thời gian tạo', name: 'CreateTime', width: 130, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Sửa đổi lần cuối', name: 'LastModifierCode', width: 100, align: 'left' },
                { label: 'Thời gian sửa đổi lần cuối', name: 'LastModifyTime', width: 130, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
            ]
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword").val() },
            }).trigger('reloadGrid');
        });
    }

    //Nhấn Enter kích hoạt sự kiện tìm kiếm
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    //Thêm mới
    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "Thêm mớiMenu",
            url: "/SystemManage/SysModule/Form",
            width: "700px",
            height: "440px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                });
            }
        });
    }

    //Sửa đổi
    function btn_edit() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        var thisOrgId = $("#gridList").jqGridRowValue().OrganizeId;
        if (!!!thisOrgId && '@(!string.IsNullOrEmpty(opr.OrganizeId) && opr.OrganizeId != opr.TopOrganizeId)' === 'True') {
            $.modalAlert("Không có quyền sửa đổi", 'warning');
            return;
        }
        $.modalOpen({
            id: "Form",
            title: "Sửa đổiMenu",
            url: "/SystemManage/SysModule/Form?keyValue=" + keyValue,
            width: "700px",
            height: "440px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                });
            }
        });
    }

    //Xóa
    function btn_delete() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        var thisOrgId = $("#gridList").jqGridRowValue().OrganizeId;
        if (!!!thisOrgId && '@(!string.IsNullOrEmpty(opr.OrganizeId) && opr.OrganizeId != opr.TopOrganizeId)' === 'True') {
            $.modalAlert("Không có quyền sửa đổi", 'warning');
            return;
        }
        $.deleteForm({
            url: "/SystemManage/SysModule/DeleteForm",
            param: { keyValue: keyValue },
            success: function () {
                $("#gridList").resetSelection();
                $("#gridList").trigger("reloadGrid");
            }
        });
    }

</script>

@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";

}
<style>
    .patListTB {
        width: 100%;
        border: 1px #eee solid;
        margin-bottom: 10px;
    }

        .patListTB tr td {
            text-align: center;
            border: 1px #eee solid;
            line-height: 30px;
            height: 30px;
            padding-left: 40px;
        }

        .patListTB tr th {
            text-align: center;
            background-color: #eee;
            border: 1px #eee solid;
            line-height: 30px;
        }
</style>
<form id="form1">
    <div style="padding-top:18px; margin-right: 30px;">
        <table class="form">
            <tr>
                <th class="formTitle" colspan="4">Thông tin bệnh nhân：</th>
                <td class="formValue" style="white-space: nowrap;text-overflow: ellipsis;text-align:center;font-style:italic;">
                    <input id="brjs" name="brjs" type="text" class="form-control required" value="bệnhngườiMô tả ngắn" readonly="readonly" style="border:none" />
                    <input id="zyh" name="zyh" type="hidden" class="form-control required" value="Số nhập viện" readonly="readonly" style="border:none;" />
                </td>
            </tr>
        </table>
        <table class="form">
            <tr>
                <th class="formTitle">Loại bệnh án：</th>
                <td class="formValue">
                    <select id="bllx" class="form-control required" data-EnumType="EnumBllx">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Bệnh ánthời gian：</th>
                <td class="formValue">
                    <input id="blsj" type="text" class="form-control input-wdatepicker formClearIgnore" onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss'})" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" />
                </td>
            </tr>
            <tr>
                @*<th class="formTitle">Mã số văn bản：</th>
                    <td class="formValue">
                        <input id="px" name="px" type="text" class="form-control" placeholder="" />
                    </td>*@
                <th class="formTitle">Quyền mẫu：</th>
                <td class="formValue">
                    <select id="mbqx" name="mbqx" class="form-control required" data-EnumType="Enummbqx"></select>
                </td>
            </tr>

        </table>
        <div id="dv_mblb" style="margin-left: 25px;">
            <table id="mbgridList"></table>
        </div>

    </div>
</form>

<script>
    var keyValue = $.request("keyValue");
    var bllx = $.request("bllx");
    var zyh = $.request("zyh");

    $(function () {
        //initControl();
        if (!!zyh) {
            $.najax({
                url: "/RecordManage/PatInfo/MedRecordTreeEditJson",
                data: { keyValue: keyValue, bllx: bllx,zyh:zyh },
                dataType: "json",
                success: function (data) {
                    $("#form1").formSerialize(data);
                }
            });
        }
        else {
            $('#zt').click(function () {
                return false;
            });
        }
        initControl();
    });

    function initControl() {
        $('#bllx').val(bllx);
        mbgridList();
    }

    function AcceptClick(callBack) {
        if (!$('#form1').formValid()) {
            return false;
        }

        var mbRowId = $("#mbgridList").jqGrid('getGridParam', 'selrow');
        var mbData=$("#mbgridList").jqGrid('getRowData', mbRowId);
        if (mbRowId != null) {
            top.top.$.Newtouchtab.addTabWithOutMenu({ name: "Thao tác bệnh án", enName: "", url: "/RecordManage/MedicalRecord/MedicalRecordEdiForAdd?mbbh=" + mbRowId + "&zyh=" + $("#zyh").val(),AppId:"EMR" });
            $.modalClose();
        }
        else {
            $.modalAlert("Vui lòng chọn mẫu bệnh án", 'warning');
        }
    }


    @*$("#bllx").bindSelect({
        url: "@Url.Action("GetMedRecordType")",
    });*@

    $('#bllx').change(function () {
        mbListRefresh()
    });

    $('#mbqx').change(function () {
        mbListRefresh()
    });

    function mbListRefresh()
    {
        if ($("#mbqx").val() != "" && $("#mbqx").val() != null && $("#mbqx").val() != "undefined")
        {
            $("#mbgridList").jqGrid('setGridParam', {
                postData: { mbqx: $("#mbqx").val(), bllx: $("#bllx").val() },
            }).trigger('reloadGrid');
        }
    }

    function mbgridList() {
        //debugger
        var $gridList = $("#mbgridList");
        $gridList.dataGrid({
            treeGrid: true,
            treeGridModel: "adjacency",
            ExpandColumn: "CreateTime",
            url: "/RecordManage/PatInfo/GetMedRecordTempList",
            postData: { mbqx: $("#mbqx").val(), bllx: $("#bllx").val() },
            height: $(window).height() - 180,
            colModel: [
                { label: "MẫuID", name: "Id", hidden: true, key: true },
                {
                    label: 'MẫuLoại', name: 'bllxmc', hidden: true, width: 60, align: 'center'
                },
                {
                    label: 'MẫuTên', name: 'mbmc', width: 190, align: 'left'
                },
                {
                    label: "Nguồn", name: "Memo", width: 30, align: 'left', formatter: function (val) {
                        if (val != "" && val != null) {
                            return "[Chuyển]";
                        }
                        else {
                            return "";
                        }
                    }
                },
                {
                    label: "Tính chất mẫu", name: "Isempty", width: 100, align: "center", formatter: function (cellvalue) {
                        if (cellvalue == "1")
                            return "Mẫu trống";
                        else
                            return 'Mẫu tùy chỉnh';
                    }
                },
                { label: 'TạoNgày', name: 'CreateTime', width: 130, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Sửa đổiNgày', name: 'LastModifierTime', width: 130, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },

            ], ondblClickRow: function (row) {
                var mbRowId = $("#mbgridList").jqGrid('getGridParam', 'selrow');
                var mbData = $("#mbgridList").jqGrid('getRowData', mbRowId);
                if (mbRowId != null) {
                    top.top.$.Newtouchtab.addTabWithOutMenu({ name: "Thao tác bệnh án", enName: "", url: "/RecordManage/MedicalRecord/MedicalRecordEdiForAdd?mbbh=" + mbRowId + "&zyh=" + $("#zyh").val(), AppId:"EMR" });
                    $.modalClose();
                }
                else {
                    $.modalAlert("Vui lòng chọn mẫu bệnh án", 'warning');
                }
        }
        });
        //$("#btn_search").click(function () {
        //    $gridList.jqGrid('setGridParam', {
        //        postData: { keyword: $("#txt_keyword").val() },
        //    }).trigger('reloadGrid');
        //});
    }


</script>
<?xml version="1.0" encoding="utf-8"?>
<appSettings>
  <!-- ================== 1：Cấu hình tham số phần mềm hệ thống ================== -->
  <!-- Phiên bản phần mềm -->
  <add key="Version" value="1.00.00.0" />

  <!-- ================== 2：Cấu hình liên quan hệ thống phát triển ================== -->
  <!-- Thời gian duy trì trạng thái đăng nhập (đơn vị: phút)-->
  <add key="LoginStatusKeepMinute" value="30" />
  <!-- Đá ra khỏi nhiều thiết bị đầu cuối -->
  <add key="EnableMultipleLoginLimit" value="true" />
  <!-- Đá ra khỏi nhiều thiết bị đầu cuối - cùng một tài khoản, số lượng trực tuyến tối đa cùng lúc -->
  <add key="MultipleLoginLimit_Count" value="10" />
  <!-- Tiền tố key của bộ nhớ đệm Reids (để nhiều ứng dụng dùng chung một cơ sở dữ liệu, ngăn ngừa bộ nhớ đệm lộn xộn) -->
  <add key="Reids_Cache_Prefix" value="$CI$"/>
  <!-- Ứng dụngId -->
  <add key="AppId" value="MR"/>
  <add key="AppName" value="病案系统"/>
  <!-- Có hiển thị mã xác minh khi đăng nhập hay không -->
  <add key="Is_CheckChkCode" value="false"/>
  
  <!-- Id tổ chức cấp cao nhất -->
  <add key="Top_OrganizeId" value="d8ee85f8-d8d1-4b5c-bd9e-1761f44242d8"/>
  <!-- Vai trò liên kết mặc định khi tạo người dùng mới -->
  <add key="CreateUser_Default_RoleCode" value="DefaultRole"/>
  <!-- Host công cộng của trang tĩnhip-->
  <add key="SiteStaticHost" value="http://IP:8014/"/>
  <!-- URL dịch vụ nhật ký, đã bỏ-->
  <add key="His.Log.URL" value="http://59.80.30.160:56006/"/>
  <!-- Công tắc - có tải cây menu bên trái hay không (mặc định tải） -->
  <add key="Is_LoadNavTree" value="true"/>
  <!-- Công tắc - có bật giám sát trang menu hay không (cây menu bên trái, nhấp chuột, thời gian tải trang bên phải） -->
  <add key="Is_NavPageLoadMoniter" value="true"/>

  <!-- Máy chủ báo cáo Host http://59.80.30.160:56014/ Đã bỏ-->
  <add key="ReportServer.HOST" value="http://59.80.30.160:56014/ReportServer/"/>
 <!--  kyDịch vụ trình soạn thảoĐịa chỉ-->
  <add key="KyEmrEdiForUrl" value="http://IP:3071" />
  <!-- ================== 3：Cấu hình liên quan nghiệp vụ ================== -->
 <!--Đường dẫn tệp EMR-->
  <add key="DcWriterFileRoter" value="D:\web\EMR"/>
  <!--Địa chỉ xuất bệnh án sang hệ thống thống kê y tế 4-->
  <add key="MedicalRecordExport" value="D:\\"/>

  <!-- ================== Khác ================== -->
  <add key="vs:EnableBrowserLink" value="false"/>

  <!-- Địa chỉ báo cáo mới, IP công cộng-->
  <add key="ReportUrl" value="http://IP:8000/"/>
  <add key="ReportSystemCode" value="MR"/>
</appSettings>
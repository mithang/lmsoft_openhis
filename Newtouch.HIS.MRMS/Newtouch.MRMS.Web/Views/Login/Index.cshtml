@{ 
    var isCheckChkCode = (ViewBag.IsCheckChkCode as bool?) ?? true;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- T-01: script chong-frame phai nam SAU doctype. Ban cu dat script truoc
         doctype nen trinh duyet roi ve quirks mode, scrollWidth do duoc
         2024 (desktop) / 548 (mobile) thay vi bang viewport. -->
    <script type="text/javascript">
        if (window.top != window) {
            top.location.href = location.href;
        }
    </script>
    <title>@("MRMS Hệ thống bệnh án")</title>
    <link rel="shortcut icon" href="@MvcHelper.GetStaticResourceScriptUrl("~/img/newtouchcloud.ico")">
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/Content/css/login.css", false)" rel="stylesheet" />
    @Html.Partial("_FrontReference")
    <script type="text/javascript" src="@MvcHelper.GetStaticResourceScriptUrl("~/js/cookie/jquery.cookie.js")"></script>
    <script type="text/javascript" src="@MvcHelper.GetStaticResourceScriptUrl("~/js/md5/jquery.md5.js")"></script>
    <!--[if lte IE 8]>
        <div id="errorie"><div>Bạn vẫn đang dùng trình duyệt IE đã cũ, vui lòng nâng cấp trình duyệt lên phiên bản IE8 trở lên trước khi sử dụng hệ thống bình thường <a target="_blank" href="http://windows.microsoft.com/zh-cn/internet-explorer/ie-8-worldwide-languages">Nhấn để nâng cấp</a>&nbsp;&nbsp;Chúng tôi đặc biệt khuyến nghị bạn đổi trình duyệt:<a href="http://down.tech.sina.com.cn/content/40975.html" target="_blank">Google Chrome</a></div></div>
    <![endif]-->
</head>
<body style="overflow: hidden;">
    <form id="form1" style="overflow: hidden;">

        <div class="login">
            @*         <div id='login_db' style='position: absolute; right: 10px; top: 10px; height: 100px; width: 200px; z-index: 1000; color: Red; font-size: 50px;'></div>*@

            <div class="login-head">
                <div class="login-head-a">
                    <img src="~/Content/img/NewTouch.png" title="" alt="" />
                </div>

            </div>
            <div class="login-con">
                <div class="login-a">
                    <div class="login-b">
                        <div class="login-b-a">
                            <a class="lo_mod tab_on">Chào mừng</a>

                        </div>
                        <div class="login-b-b">
                            <ul>

                                <li>
                                    <label for="userName" class="ui-label">
                                        <span class="ui-icon ui-icon-userDEF">
                                        </span>
                                    </label>
                                    <input id="txt_account" value="" type="text" placeholder="Tài khoản đăng nhập">
                                </li>
                                <li>
                                    <label for="userName" class="ui-label"><span class="ui-icon-ysh ui-icon-userDEF"></span></label>
                                    <input id="txt_password" value="" type="password" placeholder="Mật khẩu đăng nhập">
                                </li>
                                @{
                                    if (isCheckChkCode)
                                    {
                                        <li>
                                            <input id="txt_code" type="text" placeholder="Mã xác minh" style="width: 130px;float:left;">
                                            <div style="width: 120px; float: left; padding-top: -15px; padding-left: 14px;">
                                                <img id="imgcode" class="authcode" src="~/Login/GetAuthCode" width="50" height="25" alt="Mã xác nhận" />
                                                <a id="switchCode" href="javascript:void();" style="text-decoration: none;">Đổi mã khác</a>
                                            </div>
                                        </li>
                                    }
                                }
                                <li class="login-x">
                                    <div class="login-x-a">
                                        <button id="login_button" type="button" style="background-color:#3b9df0;color:white">
                                            <span>Đăng nhập</span>
                                        </button>
                                    </div>
                                </li>
                            </ul>
                            <div class="login_tips"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="login-foot" style="left:0px;width:100%;text-align:center;font-size:20px;bottom:20px;color:#9BA0A8">
                <span>
                    Bản quyền © 2025 Công ty TNHH Công nghệ Chuỗi Số Hàng Ngày Hồ Bắc
                    Mã nguồn hệ thống được cấp phép theo <a href="https://open.tntlinking.com/communityTreaty" style="color:#9BA0A8">Giấy phép Phần mềm Nguồn mở Hàng Ngày (Bản Cộng đồng)</a>
                </span>
            </div>
        </div>
        <script type="text/javascript">
            var s;//Tự thích ứng độ phân giải biểu mẫu
            function resize() {
                s = window.screen.width / 1920;
                document.body.style.transformOrigin = '0 0';
                document.body.style.transform = 'scale(' + s + ',' + s + ')';
                document.body.style.width = window.innerWidth / s + 'px';
                document.body.style.height = window.innerHeight / s + 'px';
            }
            window.onresize = function () {
                resize();
            }
            resize();
            (function ($) {
                $.login = {
                    formMessage: function (msg) {
                        $('.login_tips').find('.tips_msg').remove();
                        $('.login_tips').append('<div class="tips_msg"><i class="fa fa-question-circle"></i>' + msg + '</div>');
                    },
                    loginClick: function () {
                        var $username = $("#txt_account");
                        var $password = $("#txt_password");
                        var $code = $("#txt_code");
                        if ($username.val() == "") {
                            $username.focus();
                            $.login.formMessage('Vui lòng nhập tên đăng nhập / số điện thoại / email.');
                            return false;
                        } else if ($password.val() == "") {
                            $password.focus();
                            $.login.formMessage('Vui lòng nhập mật khẩu đăng nhập.');
                            return false;
                        } else if ($code.val() == "") {
                            $code.focus();
                            $.login.formMessage('Vui lòng nhập mã xác minh.');
                            return false;
                        } else {
                            $("#login_button").attr('disabled', 'disabled').find('span').html("loading...");
                            $.ajax({
                                url: "/Login/CheckLogin",
                                data: { username: $username.val(), password: $.md5($password.val()), code: $code.val() },
                                type: "post",
                                dataType: "json",
                                success: function (data) {
                                    if (data.state == "success") {
                                        $("#login_button").find('span').html("Đăng nhập thành công, đang chuyển hướng...");
                                        window.setTimeout(function () {
                                            window.location.href = "/Home/Index";
                                        }, 10);
                                    } else {
                                        $("#login_button").removeAttr('disabled').find('span').html("Đăng nhập");
                                        $("#switchCode").trigger("click");
                                        $code.val('');
                                        $.login.formMessage(data.message);
                                    }
                                }
                            });
                        }
                    },
                    init: function () {
                        $('.wrapper').height($(window).height());
                        $(".container").css("margin-top", ($(window).height() - $(".container").height()) / 2 - 50);
                        $(window).resize(function (e) {
                            $('.wrapper').height($(window).height());
                            $(".container").css("margin-top", ($(window).height() - $(".container").height()) / 2 - 50);
                        });
                        $("#switchCode").click(function () {
                            $("#imgcode").attr("src", "/Login/GetAuthCode?time=" + Math.random());
                        });
                        var loginErrorKey = "Newtouch_login_error";
                        var appId = '@("MR")';
                        if (appId) {
                            loginErrorKey = appId + "_" + loginErrorKey;
                        }
                        document.cookie = appId + '_newtouch_loginuserkey_2016=; expires=Thu,01 Jan 2022 00:00:00 GMT;path=/'
                        var login_error = top.$.cookie(loginErrorKey);
                        if (login_error != null) {
                            switch (login_error) {
                                case "overdue":
                                    $.login.formMessage("Phiên đăng nhập hệ thống đã hết hạn, vui lòng đăng nhập lại");
                                    break;
                                case "sidelined":
                                    $.login.formMessage("Tài khoản này đã đăng nhập ở nơi khác, bạn đã bị đăng xuất");
                                    break;
                                case "-1":
                                    $.login.formMessage("Hệ thống gặp lỗi không xác định, vui lòng đăng nhập lại");
                                    break;
                            }
                            top.$.cookie(loginErrorKey, '', { path: "/", expires: -1 });
                        }
                        $("#login_button").click(function () {
                            $.login.loginClick();
                        });
                        document.onkeydown = function (e) {
                            if (!e) e = window.event;
                            if ((e.keyCode || e.which) == 13) {
                                document.getElementById("login_button").focus();
                                document.getElementById("login_button").click();
                            }
                        }
                        $('#txt_account, #txt_password, #txt_code').keyup(function () {
                            $.login.formMessage('');
                        });
                    }
                };
                $(function () {
                    $.login.init();
                });
            })(jQuery);
        </script>
    </form>
    <script type="text/javascript">
        window.onload = function () {
            if (window.screenLeft == 0 && window.document.body.clientWidth == window.screen.width && window.screenTop == 0) {
                return;
            }
            else {
                try {
                    var WsShell = new ActiveXObject('WScript.Shell')
                    WsShell.SendKeys('{F11}');
                }
                catch (e) {
                }
            }
        }
    </script>
</body>
</html>
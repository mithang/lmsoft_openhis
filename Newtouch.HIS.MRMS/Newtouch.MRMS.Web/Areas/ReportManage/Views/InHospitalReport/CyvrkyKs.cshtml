
@{
    ViewBag.Title = "Báo cáo thống kê nội trú";
    Layout = "~/Views/Shared/_Index.cshtml";
    var reportUrl = AppSettings.GetConfig("ReportUrl");
    var reportSystemCode = AppSettings.GetConfig("ReportSystemCode");
}


<div class="rows">
    <div class="panel panel-default">
        <table class="form">
            <tr>
                <th class="formTitle">Thời gian bắt đầu:</th>
                <td class="formValue">
                    <input id="ksrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:140px"
                           onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy HH:mm:ss' })"
                           onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy HH:mm:ss', onpicked: function () { refReport(); } })"
                           value="@DateTime.Now.ToString("01/MM/yyyy 00:00:00")" />
                </td>
                <th class="formTitle">Thời gian kết thúc:</th>
                <td class="formValue">
                    <input id="jsrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:140px"
                           onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy  HH:mm:ss' })"
                           onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy  HH:mm:ss', onpicked: function () { refReport(); } })"
                           value="@DateTime.Now.ToString("dd/MM/yyyy  23:59:59")" />
                </td>
                <th class="formTitle">Khoa xuất viện:</th>
                <td class="formValue">
                    <input id="cykb" type="text" class="form-control formClearIgnore" style="width:90px" />
                </td>
                <th class="formTitle"></th>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Truy vấn" style="width:55px" />
                </td>
                <th></th>
                <td></td>
                <th></th>
                <td></td>
            </tr>
        </table>
    </div>
</div>
<div class="ui-layout" id="layout" style="height:100%;width:100%;">
    <iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
            scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
</div>
<script type="text/javascript">
    var reportServerHOST = '@(ViewBag.ReportServerHOST)';
    var orgId = '@(ViewBag.OrgId)';
    //$(function(){
    //    submit();
    //});

    function submit() {
        if ($('#ksrq').val().length == 0 || $('#jsrq').val().length == 0) {
            $.modalAlert("Vui lòng chọn khoảng thời gian", "error");
            return;
		}
        var url = reportServerHOST +'Pages/ReportViewer.aspx?/Newtouch.Report.MRMS/Bảng cơ cấu nguồn bệnh nhân xuất viện(Thống kê theo khoa)&rs:Command=Render';
        //url += "&begin=" + $('#ksrq').val() + "&end =" + $('#jsrq').val() + "&OrganizeId=6d5752a7-234a-403e-aa1c-df8b45d3469f" ;
        url += "&OrganizeId=6d5752a7-234a-403e-aa1c-df8b45d3469f";
        url += "&begin=" + $('#ksrq').val();
        url += "&end=" + $('#jsrq').val();
		setTimeout("$.loading(true, 'Đang yêu cầu trang báo cáo...');", 10);
        $("#iframerightiframerightiframerightttt").attr('src', url);
   
    }

    $("#iframerightiframerightiframerightttt").load(function () {
        $.loading(false);
    });

    $(function () {
        var h = $(window).height() - 55
        $('#layout iframe').css('height', h);

    });

    //Làm mới danh sách
    function refReport() {
        $("#btn_search").trigger('click');
    }

</script>

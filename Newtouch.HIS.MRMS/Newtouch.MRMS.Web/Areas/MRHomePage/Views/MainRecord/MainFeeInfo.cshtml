
@{
    Layout = null;
}
<style>
    #dv_fee input {
        border-top: none;
        border-left: none;
        border-right: none;
        text-wrap: normal;
        border-bottom-color: #74e8b5;
    }
</style>
<div id="dv_fee">
    <table class="form">
        <tr>
            <th class="formTitle" style="font-weight:bold;">Tổng chi phí nội trú (đồng)</th>
            <td class="formValue">
                <input id="ZFY" name="ZFY" class="form-control" style="font-weight:bold;" attr-desc="Tổng chi phí nội trú" />
            </td>
            <td class="formValue" colspan="3">
                <span style="float:left;padding-right:10px;padding-top: 5px;">(Trong đó:Số tiền tự trả</span>
                <input id="ZFJE" name="ZFJE" class="form-control" style="width:30%;float:left;" attr-desc="Số tiền tự trả"  />
                <span style="float:left;padding-right:10px;padding-top: 5px;">)</span>
            </td>
            <th class="formTitle">Đã duyệt chưa</th>
            <td class="formValue">
                <select id="SWHZSJ" name="SWHZSJ" class="form-control" data-enumtype="EnumYorN"></select>
                <input style="height:0px;border-width:1px;" class="form-control" />
            </td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">1.Loại dịch vụ y tế tổng hợp</td>
            <th class="formTitle">(1)Phí dịch vụ y tế thông thường</th>
            <td class="formValue"><input id="YLFUF" name="YLFUF" class="form-control" attr-desc="Phí dịch vụ y tế thông thường"  /></td>
            <th class="formTitle">(2)Phí thủ thuật điều trị thông thường</th>
            <td class="formValue"><input id="ZLCZF" name="ZLCZF" class="form-control" attr-desc="Phí thủ thuật điều trị thông thường"  /></td>
            <th class="formTitle">(3)Phí điều dưỡng</th>
            <td class="formValue"><input id="HLF" name="HLF" class="form-control" attr-desc="Phí điều dưỡng"  /></td>
            <th class="formTitle">(4)Phí khác</th>
            <td class="formValue"><input id="QTFY" name="QTFY" class="form-control" attr-desc="Phí khác"  /></td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">2.Loại chẩn đoán</td>
            <th class="formTitle">(5)Phí chẩn đoán bệnh lý</th>
            <td class="formValue"><input id="BLZDF" name="BLZDF" class="form-control" attr-desc="Phí chẩn đoán bệnh lý"  /></td>
            <th class="formTitle">(6)Phí chẩn đoán xét nghiệm</th>
            <td class="formValue"><input id="SYSZDF" name="SYSZDF" class="form-control" attr-desc="Phí chẩn đoán xét nghiệm"  /></td>
            <th class="formTitle">(7)Phí chẩn đoán hình ảnh</th>
            <td class="formValue"><input id="YXXZDF" name="YXXZDF" class="form-control" attr-desc="Phí chẩn đoán hình ảnh"  /></td>
            <th class="formTitle">(8)Phí hạng mục chẩn đoán lâm sàng</th>
            <td class="formValue"><input id="LCZDXMF" name="LCZDXMF" class="form-control" attr-desc="Phí hạng mục chẩn đoán lâm sàng"  /></td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">3.Loại điều trị</td>
            <th class="formTitle">(9)Phí hạng mục điều trị không phẫu thuật</th>
            <td class="formValue"><input id="FSSZLXMF" name="FSSZLXMF" class="form-control" attr-desc="Phí hạng mục điều trị không phẫu thuật"  /></td>
            <td class="formValue" colspan="3">
                <span style="float:left;padding-right:10px;padding-top: 5px;">(Trong đó:Phí vật lý trị liệu lâm sàng</span>
                <input id="WLZLF" name="WLZLF" class="form-control" style="width:50%;float:left;" attr-desc="Phí vật lý trị liệu lâm sàng"  />
                <span style="float:left;padding-right:10px;padding-top: 5px;">)</span>
            </td>
        </tr>
        <tr>
            <td class="formValue"></td>
            <th class="formTitle">(10)Phí điều trị phẫu thuật</th>
            <td class="formValue"><input id="SSZLF" name="SSZLF" class="form-control" attr-desc="Phí điều trị phẫu thuật"  /></td>
            <td class="formValue" colspan="4">
                <span style="float:left;padding-right:10px;padding-top: 5px;">(Trong đó:Phí gây mê</span>
                <input id="MAF" name="MAF" class="form-control" style="width:30%;float:left;" attr-desc="Phí gây mê"  />
                <span style="float:left;padding-right:10px;padding-top: 5px;">Phí phẫu thuật</span>
                <input id="SSF" name="SSF" class="form-control" style="width:30%;float:left;" attr-desc="Phí phẫu thuật"  />
                <span style="float:left;padding-right:10px;padding-top: 5px;">)</span>
            </td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">4.Loại phục hồi</td>
            <th class="formTitle">(11)Phí phục hồi</th>
            <td class="formValue"><input id="KFF" name="KFF" class="form-control" attr-desc="Phí phục hồi"  /></td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">5.Loại y học cổ truyền</td>
            <th class="formTitle">(12)Phí điều trị y học cổ truyền</th>
            <td class="formValue"><input id="ZYZLF" name="ZYZLF" class="form-control" attr-desc="Phí điều trị y học cổ truyền"  /></td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">6.Loại thuốc tây</td>
            <th class="formTitle">(13)Phí thuốc tây</th>
            <td class="formValue"><input id="XYF" name="XYF" class="form-control" attr-desc="Phí thuốc tây" /></td>
            <td class="formValue" colspan="3">
                <span style="float:left;padding-right:10px;padding-top: 5px;">(Trong đó:Chi phí thuốc kháng khuẩn</span>
                <input id="KJYWF" name="KJYWF" class="form-control" style="width:50%;float:left;" attr-desc="Chi phí thuốc kháng khuẩn"  />
                <span style="float:left;padding-right:10px;padding-top: 5px;">)</span>
            </td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">7.Loại thuốc đông y</td>
            <th class="formTitle">(14)Phí thuốc thành phẩm y học cổ truyền</th>
            <td class="formValue"><input id="ZCYF" name="ZCYF" class="form-control" attr-desc="Phí thuốc thành phẩm y học cổ truyền"  /></td>
            <th class="formTitle">(15)Phí thuốc thảo dược</th>
            <td class="formValue"><input id="ZCYF1" name="ZCYF1" class="form-control" attr-desc="Phí thuốc thảo dược"  /></td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">8.Loại máu và chế phẩm máu</td>
            <th class="formTitle">(16)Phí máu</th>
            <td class="formValue"><input id="XF" name="XF" class="form-control" attr-desc="Phí máu"  /></td>
            <th class="formTitle" colspan="2">(17)Phí chế phẩm albumin</th>
            <td class="formValue"><input id="BDBLZPF" name="BDBLZPF" class="form-control" attr-desc="Phí chế phẩm albumin"  /></td>
            <th class="formTitle" colspan="2">(18)Phí chế phẩm globulin</th>
            <td class="formValue"><input id="QDBLZPF" name="QDBLZPF" class="form-control" attr-desc="Phí chế phẩm globulin"  /></td>
        </tr>
        <tr>
            <td class="formValue"></td>
            <th class="formTitle">(19)Phí chế phẩm yếu tố đông máu</th>
            <td class="formValue"><input id="NXYZLZPF" name="NXYZLZPF" class="form-control" attr-desc="Phí chế phẩm yếu tố đông máu"  /></td>
            <th class="formTitle" colspan="2">(20)Phí chế phẩm cytokine</th>
            <td class="formValue"><input id="XBYZLZPF" name="XBYZLZPF" class="form-control" attr-desc="Phí chế phẩm cytokine"  /></td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">9.Loại vật tư tiêu hao</td>
            <th class="formTitle">(21)Phí vật liệu y tế dùng một lần cho kiểm tra</th>
            <td class="formValue"><input id="HCYYCLF" name="HCYYCLF" class="form-control" attr-desc="Phí vật liệu y tế dùng một lần cho kiểm tra"  /></td>
            <th class="formTitle" colspan="2">(22)Phí vật liệu y tế dùng một lần cho điều trị</th>
            <td class="formValue"><input id="YYCLF" name="YYCLF" class="form-control" attr-desc="Phí vật liệu y tế dùng một lần cho điều trị"  /></td>
            <th class="formTitle" colspan="2">(23)Phí vật liệu y tế dùng một lần cho phẫu thuật</th>
            <td class="formValue"><input id="YCXYYCLF" name="YCXYYCLF" class="form-control" attr-desc="Phí vật liệu y tế dùng một lần cho phẫu thuật"  /></td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">10.Loại khác</td>
            <th class="formTitle">(24)Phí khác</th>
            <td class="formValue"><input id="QTF" name="QTF" class="form-control" attr-desc="Phí khác"  /></td>
        </tr>
    </table>
</div>

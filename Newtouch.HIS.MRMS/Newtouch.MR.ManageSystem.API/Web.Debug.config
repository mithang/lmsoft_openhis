<?xml version="1.0" encoding="utf-8"?>

<!-- Để biết thông tin chi tiết về việc sử dụng chuyển đổi web.config, vui lòng truy cập http://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Trong ví dụ dưới đây，“SetAttributes”chuyển đổi sẽ thay đổi 
    “connectionString”giá trị, chỉ khi trong“Match”bộ định vị 
    tìm thấy giá trị là“MyDB”thuộc tính“name”thì sử dụng“ReleaseSQLServer”。
    
    <connectionStrings>
      <add name="MyDB" 
        connectionString="Data Source=ReleaseSQLServer;Initial Catalog=MyReleaseDB;Integrated Security=True" 
        xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
    </connectionStrings>
  -->
  <system.web>
    <!--
      
      Trong ví dụ dưới đây，“Replace”chuyển đổi sẽ thay thế 
      web.config toàn bộ tệp <customErrors> mục。
      Xin lưu ý, do 
      tại <system.web> nút chỉ có một mục customErrors, do đó không cần sử dụng“xdt:Locator”thuộc tính。
      
      <customErrors defaultRedirect="GenericError.htm"
        mode="RemoteOnly" xdt:Transform="Replace">
        <error statusCode="500" redirect="InternalError.htm"/>
      </customErrors>
    -->
  </system.web>
</configuration>
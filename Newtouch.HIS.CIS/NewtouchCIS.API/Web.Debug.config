<?xml version="1.0" encoding="utf-8"?>

<!-- Để biết thêm chi tiết về việc sử dụng phép chuyển đổi web.config, vui lòng truy cập http://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Trong ví dụ dưới đây, phép chuyển đổi “SetAttributes” sẽ thay đổi 
    giá trị của “connectionString”, để chỉ khi bộ định vị “Match” 
    tìm thấy thuộc tính “name” có giá trị “MyDB” thì dùng “ReleaseSQLServer”.
    
    <connectionStrings>
      <add name="MyDB" 
        connectionString="Data Source=ReleaseSQLServer;Initial Catalog=MyReleaseDB;Integrated Security=True" 
        xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
    </connectionStrings>
  -->
  <system.web>
    <!--
      
      Trong ví dụ dưới đây, phép chuyển đổi “Replace” sẽ thay thế 
      toàn bộ tiết <customErrors> của tệp web.config.
      Xin lưu ý, do 
      dưới nút <system.web> chỉ có một tiết customErrors, nên không cần dùng thuộc tính “xdt:Locator”.
      
      <customErrors defaultRedirect="GenericError.htm"
        mode="RemoteOnly" xdt:Transform="Replace">
        <error statusCode="500" redirect="InternalError.htm"/>
      </customErrors>
    -->
  </system.web>
</configuration>
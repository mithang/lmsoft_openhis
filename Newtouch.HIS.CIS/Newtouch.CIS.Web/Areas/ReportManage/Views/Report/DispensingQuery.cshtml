    function MergerStatistics(gridName, CellName) {
        //đượcđếnHiển thịđếngiớimặtcủaidtậphợp
        var mya = $("#" + gridName + "").getDataIDs();
        //hiện tạiHiển thịnhiềuítdòng
        var length = mya.length;
        for (var i = 0; i < length; i++) {
            //từtrênđếndướiLấymột dòngthông tin
            var before = $("#" + gridName + "").jqGrid('getRowData', mya[i]);
            //địnhnghĩahợpvàdòngsố
            var rowSpanTaxCount = 1;
            for (j = i + 1; j <= length; j++) {
                //vàtrênbêncủathông tinđốiso VDnếuGiá trịmộtdạngthìhợpvàdòngsố+1 nhiênsauCài đặtrowspan 让hiện tạiphiếuôẨn
                var end = $("#" + gridName + "").jqGrid('getRowData', mya[j]);
                var cellNames = CellName.split(",");
                for (var n = 0; n < cellNames.length; n++) {
                    if (before[cellNames[0]] == end[cellNames[0]]) {
                        rowSpanTaxCount++;
                        $("#" + gridName + "").setCell(mya[j], cellNames[0], '', { display: 'none' });
                    } else {
                        rowSpanTaxCount = 1;
                        break;
                    }
                    $("#" + cellNames[0] + "" + mya[i] + "").attr("rowspan", rowSpanTaxCount);//cuối cùnghợpvàcầnhợpvàcủadòngvàhợpvàcủadòngsố
                    $("#" + cellNames[0] + "" + mya[i] + "").attr("position", "relative");
                    $("#" + cellNames[0] + "" + mya[i] + "").attr("top", "50%");
                    $("#" + cellNames[0] + "" + mya[i] + "").attr("transform", "translateY(-50%)");

                }

            }

        }

    }

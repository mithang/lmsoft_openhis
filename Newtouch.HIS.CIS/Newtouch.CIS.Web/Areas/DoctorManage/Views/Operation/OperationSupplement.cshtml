@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "OperationSupplement";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    #leftPart {
        float: left;
        width: 24%;
    }

        #leftPart .btn-group {
            float: right;
            font-size: 12px;
            font-weight: 200;
        }

    #rightPart {
        float: left;
        width: 75%;
        padding-left: 7px;
    }
</style>
<script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/validate/jquery.validate.min.js")"></script>
<div id="leftPart" class="rows">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form" style="width:95%">
            <tr>
                <th class="formTitle" style="width:100px;">&nbsp;&nbsp; <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>&nbsp;&nbsp;Họ tên/Số nhập viện:</th>
                <td class="formValue">
                    <input id="keyword" type="text" class="form-control" />
                </td>
            </tr>
        </table>
    </div>
    <div class="gridPanel">
        <table id="gridPatList"></table>
    </div>
</div>
<div id="rightPart" class="rows">
    <div id="dv_baseInfoAndItem">
        <div class="panel panel-default">
            <div class="panel-heading navb-bg">
                Thông tin cơ bản
            </div>
            <table class="form" style="margin-bottom:10px;margin-top:10px;">
                <tr>
                    <th class="formTitle">Số nhập viện:</th>
                    <td class="formValue">
                        <label id="zyh"></label>
                    </td>
                    <th class="formTitle">Họ tên:</th>
                    <td class="formValue">
                        <label id="xm"></label>
                    </td>
                    <th class="formTitle">Giới tính:</th>
                    <td class="formValue">
                        <label id="xb"></label>
                    </td>
                    <th class="formTitle">Tuổi:</th>
                    <td class="formValue">
                        <label id="nl"></label>
                    </td>
                </tr>
            </table>
        </div>
        @*mắtmắtBiểu tượngloại bỏ*@
        <i id="expandIcon" class="fa" style="text-align: center; width: 100%;">MởMụcThu phí</i>
        @*<i id="expandIcon" class="fa fa-eye" aria-hidden="true" style="font-size: large; text-align: center; width: 100%;"></i>*@
        <div class="panel panel-default" id="singleItemDiv">
            <div class="panel-heading navb-bg">
                @*mắtmắtBiểu tượngloại bỏ*@
                @*<i id="singleItemIcon" class="fa fa-eye-slash" style="font-size:larger;"></i>*@
                MụcThu phí&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                <i id="singleItemIcon" class="fa">(Đóng)</i>
            </div>
            <form id="form1">
                <label id="dwjls" hidden="hidden"></label>@*Một lầntínhlượngsố，vàMột lầnĐiều trịlượnglàmsokhá*@
                <input id="zfxz" type="text" style="display:none;" class="form-control" />
                @{
                    @Html.Partial("originalCharge"); //Thường quyThu phí。Số lượng
                }

            </form>
        </div>

        @Html.Partial("_MiddleButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
   {
       ShowKeyList = new int[] { 2, 3, 6, 9 },
       F2Text = "Thêm",
       F3Text = "Sửa",
       F6Text = "Xóa",
       F9Text = "HủySửa",
       F9Hidden = true
   })
    </div>
    <div class="gridPanel">
        <table id="gridFeeList"></table>
    </div>
    @Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new[] { 4, 8 },
    F8Text = "Xác nhậnGửi"
})
</div>
<script>
    //
    var multiTimesSettWithUnSettedSingleItem = false; //Công tắccấu hình：có thểnhiều lầngiao dịchchế độ khôngĐơn thuốcchưaMục thu phíCóKhôngtựđộngmangvào
    //
    var leftdata = [];//tráibênNguồn dữ liệu
    var respmzh; //Số khám ngoại trúkiểm tra（Không cóđổi）
    var editingNewid = null; //đangởSửacủadòng
    var patInfoPostObj = {}; //Cá nhânthông tinObjectđối tượng cầnGửiđếnmáy chủ
    $(function () {
        $("#gridFeeList").newtouchLocalDataGrid(null, []);
        hideEditBotton();
        $(".fa_icontoggle").click(function () {
            if ($(this).find("i").hasClass("fa-angle-double-down")) {
                $("#gridFeeList").setGridHeight($(window).height() - 245);
            }
            else {
                $("#gridFeeList").setGridHeight($(window).height() - 265);
            }
        });
        $('#expandIcon:visible').trigger('click');
        //
        initGridPatList();
        //Khôngthìxemkhôngđếnloadinghiệunếu
        setTimeout("gridPatList()", 50);
    });

    //trangmặttrongtố，Tính toánTổng số tiền Số lượngbảnbản
    function reCalcZjeFromsl() {
        var resultZje = "0.00";
        var txtDj = $("#dj").html();
        var txtSl = $('#sl').val();
        if (txtDj && txtSl) {
            if (!isNaN(txtDj) && !isNaN(txtSl)) {
                resultZje = roundingBy4she6ru5chengshuang((parseFloat(txtDj) * parseFloat(txtSl)), 2);
            }
        }
        $('#zje').html(resultZje);
    }

    ///ẨnSửaNút
    function hideEditBotton() {
        $('#btn_bottombutton_f2,#btn_bottombutton_f3,#btn_bottombutton_f6').hide();
    }
    //Hiển thịSửaNút
    function showEditBotton() {
        //$('#btn_bottombutton_f3').attr('disabled', 'disabled');
        //$('#btn_bottombutton_f6').attr('disabled', 'disabled');
        $('#btn_bottombutton_f2,#btn_bottombutton_f3,#btn_bottombutton_f6').show();
    }

    //triểnmởMụctínhphínhậpmặtbảng
    $('#expandIcon').click(function () {
        $(this).hide();
        $('#singleItemDiv').show();
        $('#form1').show();
        showEditBotton();
        $("#gridFeeList").setGridHeight($(window).height() - $("#dv_baseInfoAndItem").outerHeight(true) - 89);
    });

    //ẨnMụctínhphínhậpmặtbảng
    $('#singleItemIcon').click(function () {
        $('#singleItemDiv').hide();
        $('#form1').show().hide();
        $('#expandIcon').show();
        hideEditBotton();
        $("#gridFeeList").setGridHeight($(window).height() - $("#dv_baseInfoAndItem").outerHeight(true) - 89);
    });

    //gridPatListkếtcấu trúc
    function initGridPatList() {
        $("#gridPatList").newtouchLocalDataGrid({
            height: $(window).height() - 125,
            unwritten: false,
            rownumbers: false,
            url: "@Url.Action("GetOperatPatSearchList")",
            colModel: [
                { label: 'Số nhập viện', name: 'zyh', width: 60, align: 'left' },
                { label: 'Họ tên', name: 'xm', width: 70, align: 'left' },
                { label: 'xb', name: 'xb', width: 70, align: 'left', hidden: true },
                { label: 'nl', name: 'nl', width: 70, align: 'left', hidden: true }
            ],
            ondblClickRow: function (rowid) {
                newtouch_event_f4();
                var rowData = $("#gridPatList").jqGrid('getRowData', rowid);
                $("#zyh").html(rowData.zyh);
                $("#xm").html(rowData.xm);
                if(rowData.xb=="1")
                {
                    $("#xb").html("Nam");
                }
                else if(rowData.xb=="2")
                {
                    $("#xb").html("Nữ");
                }
                $("#nl").html(rowData.nl);
                gridFeeList();
            }
        });
    }

    //Làm mớiDanh sách bệnh nhân
    function gridPatList() {
        $.najax({
            type: "GET",
            url: "@Url.Action("GetOperatPatSearchList")",
            loading: true,
            loadingtext: "ĐangTảiDanh sách bệnh nhân,Vui lòng đợi trong giây lát...",
            success: function (ajaxresp) {
                newtouch_event_f4();
                leftdata = ajaxresp;
                var $gridPatList = $("#gridPatList");
                $gridPatList.resetSelection();
                $gridPatList.clearGridData();
                $gridPatList.newtouchLocalDataGrid({ posttofirst: false }, leftdata);
            }
        });
    }

    //Làm mớiChi phídanh sách
    function gridFeeList() {
        $.najax({
            type: "GET",
            url: "@Url.Action("getSupplement")",
            data: { zyh: $("#zyh").html() },
            loading: true,
            loadingtext: "ĐangTảiChi phíDanh sách,Vui lòng đợi trong giây lát...",
            success: function (ajaxresp) {
                $("#gridFeeList").resetSelection();
                $("#gridFeeList").clearGridData();
                $("#gridFeeList").newtouchLocalDataGrid({ posttofirst: false }, ajaxresp);
                fillGridDataToMxList();
            }
        });
    }

    $("#gridFeeList").newtouchLocalDataGrid({
        height: $(window).height() - 225,
        unwritten: false,
        url: "@Url.Action("getSupplement")",
        colModel: [
            {
                label: "newid", name: "newid", align: "left", hidden: true, formatter: function (cellvalue, options, rowObject) {
                    if ($.trim(rowObject.Id).length > 0) {
                        return rowObject.Id;
                    } else {
                        return rowObject.newid;
                    }
                }
            },
            { label: "Id", name: "Id", align: "left", hidden: true },
            {
                label: "Loại", name: "yzlb", width: 50, align: "left", formatter: function (cellvalue) {
                    if (cellvalue == "0") {
                        return "Thuốc"
                    }
                    else if (cellvalue == "-1") {
                        return "Mục";
                    }
                    else {
                        return "error";
                    }
                }
            },
            { label: "Tên mục", name: "xmmc", width: 170, align: "left" },
            { name: "xmdm", align: "left", hidden: true },
            { label: "dxmdm", name: "dxmdm", hidden: true },
            { label: "gg", name: "gg", hidden: true },
            { label: "Tổng số lượng tính phí", name: "sl", width: 70, align: "left" },
            { label: "Đơn vị", name: "dw", width: 40, align: "left" },
            {
                label: "Đơn giá", name: "dj", width: 80, align: "left", formatter: "number"
                , formatoptions: { decimalPlaces: 4, defaultValue: '0.0000' }
            },
            {
                label: "Số tiền", name: "zje", width: 80, align: "left", formatoptions: { decimalPlaces: 2, defaultValue: '0.00' }
            }, {
                label: "Thực hiệnTrạng thái", name: "zxzt", width: 50, align: "left", formatter: function (cellvalue) {
                    if (cellvalue == "0") {
                        return "Chưa thực hiện"
                    }
                    else if (cellvalue == "1") {
                        return "Đã thực hiện";
                    }
                    else {
                        return "error";
                    }
                }
            },
            { label: "dwxs", name: "dwxs", hidden: true },
            { label: "ykxs", name: "ykxs", hidden: true },
            { label: "ybshbz", name: "ybshbz", hidden: true },
            { label: "ybdm", name: "ybdm", hidden: true }
        ],
        onSelectRow: function (rowid) {
            //$('#btn_bottombutton_f3').removeAttr('disabled');
            //$('#btn_bottombutton_f6').removeAttr('disabled');
        },
        ondblClickRow: function (rowid) {
            var rowData = $("#gridFeeList").jqGrid('getRowData', rowid);
            if (rowData.zxzt == "Đã thực hiện")
            {
                $.modalAlert("Chi phí này đã thực hiện, không được phép sửa.", "warning");
                return;
            }
            sfxmgridDbclickRow(rowData);
        }
    });
    //Hạng mục điều trị lớp nổi
    var searchTypePart1 = "yp";
    var searchTypePart2 = "sfxm";
    searchTypePart1 += '.kc';
    searchTypePart2 += '.dwjls';

    $('#sfxmmc').sfxmFloatingSelector({
        searchType: 'yp,sfxm',
        leftshift: 100, //chỉnhthểtráilệchchuyển
        ajaxparameters: function ($thisinput) {
            return "dllb=1,2&mzzybz=2&keyword=" + $.trim($thisinput.val());
        },
        itemdbclickhandler: function ($thistr, $thisinput) {
            if ($.trim($("#zyh").html) == "") {
                $.modalAlert("ChưaChọnBệnh nhân", "warning");
                return;
            }
            if ($thisinput.attr('id') === 'sfxmmc') {
                $('#yzlx').val($thistr.attr('data-yzlx'));
                $('#sfxmmc').val($thistr.attr('data-sfxmmc'));
                $('#sfxmCode').val($thistr.attr('data-sfxmCode'));
                $('#gg').val($thistr.attr('data-gg'));
                $('#sfdlCode').val($thistr.attr('data-sfdlCode'));
                $('#dwjls').val($thistr.attr('data-dwjls'));
                $('#zfxz').val($thistr.attr('data-zfxz'));
                $('#cls').val($thistr.attr('data-cls'));
                $('#ybdm').val($thistr.attr('data-ybdm'));
                $('#yfbmcode').val($thistr.attr('data-yfbmcode'));

                var djVal = parseFloat($thistr.attr('data-dj')).toFixed(4);
                $('#dj').html(djVal);
                $('#dw').html($thistr.attr('data-dw'));
            }
        }
    });

    //Thêm
    function newtouch_event_f2() {
        if ($("#zyh").html() == "") {
            $.modalAlert("ThiếuBệnh nhânThông tin cơ bản", 'warning');
            return;
        }

        var data = getEditRowData();
        if (!checkEditingRowData(data)) {    //Dữ liệuCóKhônghoàn thiện，Kiểm trabắt buộc mục
            return;
        }
        reCalcZjeFromsl();
        var addgoon = function () {

            if (!checkEditingRowData(data)) {    //Dữ liệuCóKhônghoàn thiện，Kiểm trabắt buộc mục
                return;
            }
            data.zje = $('#zje').html();
            data.zxzt = "0";
            data.newid = Math.random().toString() + new Date().getMilliseconds();   //newid()
            gridMxList.unshift(data);   //làmlàmới mụcThêm //”sốnhómnhấttrướcđầu“

            //lạisẽxmsốnhómhiển thịhiệnđếngrid
            fillDataToGrid();
            Clearjzxm();
        }

        if (data && parseFloat(data.dj) < '0') {
            $.modalAlert("Đơn giá phải là số không nhỏ hơn 0", 'warning');
            return;
        }
        else if (data && parseFloat(data.dj) == '0') {
            $.modalConfirm("Đơn giá bằng 0, xác nhận có thêm không", function (flag) {
                if (!flag) {
                    return;
                }
                else {
                    addgoon();
                }
            });
        }
        else {
            addgoon();
        }
    }

    //Sửa
    function newtouch_event_f3() {
        if ($("#zyh").html() == "") {
            $.modalAlert("ThiếuBệnh nhânThông tin cơ bản", 'warning');
            return;
        }
        if (editingNewid) {
            var data = getEditRowData();
            if (!(checkEditingRowData(data))) {
                //Dữ liệuCóKhônghoàn thiện，Kiểm trabắt buộc mục
                return;
            }
            reCalcZjeFromsl();
            data.zje = $('#zje').html();
            data.zxzt = "0";
            updategoon = function () {

                data.newid = editingNewid;
                if (editingNewid.length == 36) {//GUIDthìbảogiữID,KhôngthìlàmớiDữ liệuIDkhôngdùngGán giá trị
                    data.Id = editingNewid;
                }

                //Kiểm tratrùng lặp mục

                //trướcởxmsốnhómtrongtìmđếncủa
                if (editingNewid) {
                    var matchedIndex = -1;
                    for (var ii = 0; ii < gridMxList.length; ii++) {
                        if (gridMxList[ii].newid == data.newid) {
                            matchedIndex = ii;
                            break;
                        }
                    }
                    if (matchedIndex == -1) {
                        return; //ứngCóNgoại lệ
                    }
                    gridMxList.remove(matchedIndex);   //loại bỏ mục
                    gridMxList.unshift(data);   //làmlàmới mụcThêm    //”sốnhómnhấttrướcđầu“
                }

                //lạisẽxmsốnhómhiển thịhiệnđếngrid
                fillDataToGrid();
                Clearjzxm();

                editingNewid = null;    //đangởSửacủadòng

            }
            if (data && parseFloat(data.dj) < '0') {
                $.modalAlert("Đơn giá phải là số không nhỏ hơn 0", 'warning');
                return;
            }
            else if (data && parseFloat(data.dj) == '0') {
                $.modalConfirm("Đơn giá bằng 0, xác nhận có sửa không", function (flag) {
                    if (!flag) {
                        return;
                    }
                    else {
                        updategoon();
                    }
                });
            }
            else {
                updategoon();
            }
        }
        else {
            //$('#btn_bottombutton_f2').attr('disabled', 'disabled');
            //Lấygridhiện tạiĐã chọncủađómộtdòng
            var seleId = $('#gridFeeList').jqGrid('getGridParam', 'selrow');
            if (seleId) {
                //yêu cầuSửadòng
                gridEditRow(seleId);
            }
            else {
                return;
            }
        }
    }

    //xóa
    function newtouch_event_f4() {
        gridMxList = [];
        $("#gridFeeList").clearGridData();
        $('#xm,#xb,#nl,#zjh').html('');
        $("#zje").html('0.00');
        Clearjzxm();
    };

    //Xóa
    function newtouch_event_f6() {
        //Lấygridhiện tạiĐã chọncủađómộtdòng
        var rowid = $('#gridFeeList').jqGrid('getGridParam', 'selrow');
        //yêu cầuXóadòng
        if (rowid) {
            var rowData = $("#gridFeeList").jqGrid('getRowData', rowid);
            if (rowData.zxzt == "Đã thực hiện") {
                $.modalAlert("Chi phí này đã thực hiện, không được phép sửa.", "warning");
                return;
            }
            if (rowData) {
                if (!!rowData.newid) {
                    if (gridMxList.length > 0) {
                        for (var jj = (gridMxList.length - 1) ; jj >= 0 ; jj--) {
                            if (gridMxList[jj].newid == rowData.newid) {
                                gridMxList.remove(jj);   //loại bỏ
                            }
                        }
                    }
                }
            }
            //lạisẽxmsốnhómhiển thịhiệnđếngrid
            fillDataToGrid();
        }
    }

    //xác nhận
    function newtouch_event_f8() {

        if ($("#zyh").html() == "") {
            $.modalAlert("ThiếuBệnh nhânThông tin cơ bản", 'warning');
            return;
        }
        var dataIDs = $("#gridFeeList").jqGrid('getDataIDs');
        var dataInfo = [];
        $.each(dataIDs, function () {
            var detail = $("#gridFeeList").jqGrid('getRowData', this);
            detail.yzlb = detail.yzlb == "Thuốc" ? "0" : "-1";
            detail.zxzt = detail.zxzt == "Đã thực hiện" ? "1" : "0";
            delete detail.newid;
            dataInfo.push(detail);
        });

        $.najax({
            type: "POST",
            url: "@Url.Action("submitForm_Supplement")",
            data: { RequestItems: dataInfo, zyh: $("#zyh").html() },
            dataType: "json",
            success: function (ajaxresp) {
                $.modalAlert("Gửithành công", 'success');
                gridFeeList();
                Clearjzxm();
            },
            complete: function () {
                $.loading(false);
            }
        });
    }

    //Lấychi tiết
    function getEditRowData() {
        var data = {
            xmdm: $('#sfxmCode').val(),
            xmmc: $('#sfxmmc').val(),
            yzlb: $('#yzlx').val() == "1" ? "0" : "-1",
            gg: $('#gg').val(),
            ykxs: $('#cls').val(),
            ybdm: $('#ybdm').val(),
            dj: $('#dj').html(),
            dw: $('#dw').html(),
            sl: $('#sl').val(),
            dxmdm: $('#sfdlCode').val(),
            dwxs: $('#dwjls').val(),
            zje: $('#zje').html(),
            ybshbz: $('#zfxz').val(),
            zxzt: "0"
        };
        return data;
    }

    //nhấp đúpMục thu phí
    function sfxmgridDbclickRow(rowData) {
        if (!!rowData.newid) {
            if (rowData) {
                editingNewid = rowData.newid;
                //thứ tựcộthóađếnSửalĩnh vựctrong

                $('#sfxmmc').val(rowData.xmmc);
                $('#sfxmCode').val(rowData.xmdm);
                $('#gg').val(rowData.gg);
                $('#yzlx').val(rowData.yzlb == "Thuốc" ? "1" : "2");// yzlx:1 Thuốc,2 Mục thu phí
                $('#sfdlCode').val(rowData.dxmdm);
                $('#dw').html(rowData.dw);
                '@(ViewBag.sfxm_dj)' === 'ON'
                    ? $('#dj').val(rowData.dj)
                    : $('#dj').html(rowData.dj);
                $('#sl').val(rowData.sl);
                $('#dwjls').val(rowData.dwxs);
                $('#zje').html(rowData.zje);
                $('#zfxz').val(rowData.ybshbz);
                $('#cls').val(rowData.ykxs);
                $('#ybdm').val(rowData.ybdm);
                $('#expandIcon').trigger('click');
                //$('#btn_bottombutton_f6').attr('disabled', 'disabled');
                //$('#btn_bottombutton_f9').show();
                //$('#btn_bottombutton_f2').attr('disabled', 'disabled');
                //$('#btn_bottombutton_f3').removeAttr('disabled');
            }
        }
        else {
            $.modalAlert("Không thể sửa chi tiết này", "warning");
            return;
        }
    }

    //
    var patModel = null;

    //Kiểm trađangởSửacủaDữ liệu（chờGửi）củaxongchỉnhtính
    function checkEditingRowData(rowData) {
        if (!rowData.xmdm || !rowData.xmmc || !rowData.yzlb || !rowData.dxmdm) {
            $.modalAlert("Vui lòng chọnMục thu phí", 'warning');
            return;
        }
        if (!!!rowData.sl || isNaN(rowData.sl)) {
            $.modalAlert("ThiếuSố lượng", 'warning');
            return;
        }
        //Thường quy，Số lượng
        if (!((/^(\+|-)?\d+$/).test(rowData.sl)) || rowData.sl < 1) {
            $.modalAlert("Số lượng là số nguyên lớn hơn 0", 'warning');
            return;
        }
        else if (!!!rowData.dw) {
            $.modalAlert("ThiếuMụcĐơn vịThông tin", 'warning');
        }
        else if (!((/^(([1-9][0-9]*\.[0-9][0-9]*)|([0]\.[0-9][0-9]*)|([1-9][0-9]*)|([0]{1}))$/).test(rowData.dj))) {
            $.modalAlert("Đơn giá phải là số không nhỏ hơn 0", 'warning');
        }
        else if (rowData.dj == "" || isNaN(rowData.dj)) {
            $.modalAlert("ThiếuMụcĐơn giáThông tin", 'warning');
        }
        else {
            return true;
        }
        return false;
    }

    //yêu cầu Sửa dòng
    function gridEditRow(rowid) {
        if (rowid) {
            var rowData = $("#gridFeeList").jqGrid('getRowData', rowid);
            if (rowData) {
                if (!!rowData.newid) {
                    //ởgridMxListtìm start
                    rowDataArr = $.jsonWhere(gridMxList, function (v) {
                        return v && v.newid == rowData.newid;
                    });
                    if (!rowDataArr || rowDataArr.length == 0) {
                        return; //làgìsaokhôngtìmđến
                    }
                    rowData = rowDataArr[0];  //thông quarowData.newidtừđối tượngsốnhómtronglấyradòngDữ liệu
                    if (true) { //&&có thểSửa
                        editingNewid = rowData.newid;    //đangởSửacủadòng
                    }
                    else {
                        return;
                    }
                    //ởgridMxListtìm end
                }
                else {
                    //$('#btn_bottombutton_f2').removeAttr('disabled');
                    $.modalAlert("Không thể sửa chi tiết này", "warning");
                    return;
                }
                //thứ tựcộthóađếnSửalĩnh vựctrong
                $('#sfxmmc').val(rowData.xmmc);
                $('#sfxmCode').val(rowData.xmdm);
                $('#gg').val(rowData.gg);
                $('#yzlx').val(rowData.yzlb == "0" ? "1" : "2");// yzlb:-1 Mục thu phí,0 Thuốc;yzlx:1 Thuốc,2 Mục thu phí
                $('#sfdlCode').val(rowData.dxmdm);
                $('#dw').html(rowData.dw);
                '@(ViewBag.sfxm_dj)' === 'ON'
                    ? $('#dj').val(rowData.dj)
                    : $('#dj').html(rowData.dj);
                $('#sl').val(rowData.sl);
                $('#dwjls').val(rowData.dwjls);
                $('#zje').html(rowData.zje);
                $('#zfxz').val(rowData.ybshbz);
                $('#cls').val(rowData.ykxs);
                $('#ybdm').val(rowData.ybdm);
                //$('#btn_bottombutton_f6').attr('disabled', 'disabled');
                //$('#btn_bottombutton_f9').show();

                //$('#btn_bottombutton_f2').attr('disabled', 'disabled');
            }
        }
    }
    var gridMxList = [];
    //tớigridFeeList gridtrongđiềnDữ liệu
    function fillDataToGrid() {
        $("#gridFeeList").resetSelection();
        $("#gridFeeList").clearGridData();
        for (var i = 0; i <= gridMxList.length; i++) {
            $("#gridFeeList").newtouchLocalDataGrid(null, gridMxList[gridMxList.length - i]);
        }
    }


    function fillGridDataToMxList() {
        gridMxList = [];
        var dataIDs = $("#gridFeeList").jqGrid('getDataIDs');
        $.each(dataIDs, function () {
            var detail = $("#gridFeeList").jqGrid('getRowData', this);
            detail.yzlb = detail.yzlb == "Thuốc" ? "0" : "-1";
            detail.zxzt = detail.zxzt == "Đã thực hiện" ? "1" : "0";
            gridMxList.push(detail);
        });
    }

    //Xóa trắngHạng mục ghi nợ
    function Clearjzxm() {
        $('#zfxz').val('');
        $('#sfxmmc').val('');
        $('#sfxmCode').val('');
        $('#gg').val('');
        $('#yzlx').val('');
        $('#sfdlCode').val('');
        $('#dw').html('');
        $('#dj').html('')
        $('#dwjls').val('');
        $('#sl').val('');
        $('#cls').val('');
        $('#ybdm').val('');
        $('#yfbmcode').val('');
    }

    //tìm kiếmThông tin bệnh nhân
    $('#keyword').keyup(function () {
        if (leftdata != null && leftdata.length > 0) {
            $("#gridPatList").resetSelection();
            $("#gridPatList").clearGridData();
            var redata = [];
            var $this = $(this).val();
            for (var i = 0; i < leftdata.length; i++) {
                if (leftdata[i].zyh.indexOfIgnoreCase($this) != -1 ||
                    leftdata[i].xm.indexOfIgnoreCase($this) != -1 ||
                    leftdata[i].py.indexOfIgnoreCase($this) != -1 ||
                    $this.trim() == '') {
                    redata.push(leftdata[i]);
                }
            }
            $("#gridPatList").newtouchLocalDataGrid({ posttofirst: false }, redata);
        }
    });


    //Trì hoãngọigiúpgiúphàmsố
    var timeoutFunc = null;
    var timeoutFuncParam1 = null;
    var timeoutFuncParam2 = null;
    var timeoutFuncParam3 = null;
    var timeoutFuncParam4 = null;
    function invokeTimeoutFunc() {
        if (timeoutFunc) {
            timeoutFunc(timeoutFuncParam1, timeoutFuncParam2, timeoutFuncParam3, timeoutFuncParam4);
        }
    }
</script>
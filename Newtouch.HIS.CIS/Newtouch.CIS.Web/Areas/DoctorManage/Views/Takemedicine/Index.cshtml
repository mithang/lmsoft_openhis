    function caltakesl(rowid) {
        if ($("#" + rowid + "_yldwwwwwww").val() == "1") {//dùnglượngĐơn vịđợitạiSố ngàykhiTính toánTổng lượng，Khôngthìkhôngquản
            //0 biểu thị đơn vị tổng lượng, không tính toán. 1 biểu thị đơn vị số ngày, tính toán tổng lượng
            var yldwval = $("#" + rowid + "_yldwwwwwww").val();
            var yl = $("#" + rowid + "_yl").val();
            if (yldwval == "0") {
                if (isNaN(yl) || yl == "") {

                } else {
                    $("#" + rowid + "_sl").val(yl);
                }
            } else {
                var jlzhxs = $("#" + rowid + "_jlzhxs").val();
                var zyzhxs = $("#" + rowid + "_zyzhxs").val();
                var ypjl = $("#" + rowid + "_ypjl").val();
                var dwlb = $("#" + rowid + "_dwlb").val();
                var zxcs = $("#" + rowid + "_zxcs").val();
                var zxzq = $("#" + rowid + "_zxzq").val();
                var zxzqdw = $("#" + rowid + "_zxzqdw").val();
                var qzfs = $("#" + rowid + "_qzfs").val();
                if (isNaN(jlzhxs) || jlzhxs == "") {
                    //$.modalAlert("thiếuHệ số chuyển đổi liều", 'warning');
                    return;
                } else if (isNaN(zyzhxs) || zyzhxs == "") {
                    //$.modalAlert("thiếuNhập việnchuyểnđổihệsố", 'warning');
                    return;
                } else if (isNaN(ypjl) || ypjl == "") {
                    //$.modalAlert("Thiếu liều lượng", 'warning');
                    return;
                } else if (isNaN(dwlb) || dwlb == "") {
                    //$.modalAlert("Thiếu đơn vịLoại", 'warning');
                    return;
                } else if (isNaN(zxcs) || zxcs == "") {
                    //$.modalAlert("thiếuThực hiện lầnsố", 'warning');
                    return;
                } else if (isNaN(zxzq) || zxzq == "") {
                    //$.modalAlert("thiếuThực hiệnchu kỳ", 'warning');
                    return;
                } else if (isNaN(zxzqdw) || zxzqdw == "") {
                    //$.modalAlert("thiếuThực hiệnchu kỳĐơn vị", 'warning');
                    return;
                } else if (isNaN(yl) || yl == "") {
                    //$.modalAlert("thiếudùnglượng", 'warning');
                    return;
                } else {
                    var sl = getypsl(jlzhxs, zyzhxs, ypjl, dwlb, zxcs, zxzq, zxzqdw, yl, qzfs);
                    var kcsl = $("#" + rowid + "_kcsl").val();
                    if (sl > kcsl) {
                        $.modalAlert($("#" + rowid + "_xmmc").val() + "Tồn khoKhông đủ", 'warning');
                        $("#" + rowid + "_ypjl").focus();
                        return;
                    }
                    $("#" + rowid + "_sl").val(sl);
                }
            }
        }

    }

    function caltakeslobj(obj) {
        if (obj.yldwwwwwww == "1") {//dùnglượngĐơn vịđợitạiSố ngàykhiTính toánTổng lượng，Khôngthìkhôngquản
            //0 biểu thị đơn vị tổng lượng, không tính toán. 1 biểu thị đơn vị số ngày, tính toán tổng lượng
            if (obj.yldwwwwwww == "0") {
                if (isNaN(obj.yl) || obj.yl == "") {
                } else {
                    return obj.yl;
                }
            } else {
                if (isNaN(obj.jlzhxs) || obj.jlzhxs == "") {
                    //$.modalAlert("thiếuHệ số chuyển đổi liều", 'warning');
                    return;
                } else if (isNaN(obj.zyzhxs) || obj.zyzhxs == "") {
                    //$.modalAlert("thiếuNhập việnchuyểnđổihệsố", 'warning');
                    return;
                } else if (isNaN(obj.ypjl) || obj.ypjl == "") {
                    //$.modalAlert("Thiếu liều lượng", 'warning');
                    return;
                } else if (isNaN(obj.dwlb) || obj.dwlb == "") {
                    //$.modalAlert("Thiếu đơn vịLoại", 'warning');
                    return;
                } else if (isNaN(obj.zxcs) || obj.zxcs == "") {
                    //$.modalAlert("thiếuThực hiện lầnsố", 'warning');
                    return;
                } else if (isNaN(obj.zxzq) || obj.zxzq == "") {
                    //$.modalAlert("thiếuThực hiệnchu kỳ", 'warning');
                    return;
                } else if (isNaN(obj.zxzqdw) || obj.zxzqdw == "") {
                    //$.modalAlert("thiếuThực hiệnchu kỳĐơn vị", 'warning');
                    return;
                } else if (isNaN(obj.yl) || obj.yl == "") {
                    //$.modalAlert("thiếudùnglượng", 'warning');
                    return;
                } else {
                    var sl = getypsl(obj.jlzhxs, obj.zyzhxs, obj.ypjl, obj.dwlb, obj.zxcs, obj.zxzq, obj.zxzqdw, obj.yl, obj.qzfs);
                    if (sl > obj.kcsl) {
                        $.modalAlert(obj.xmmc + "Tồn khoKhông đủ", 'warning');
                        return;
                    }
                    return sl;
                }
            }
        } else {
            return obj.sl;
        }

    }


@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "Xuất việnMang thuốc";
    var IsQyKssKz = (ViewBag.IsQyKssKz as bool?) ?? false;
    var qxjb = ViewBag.qxjb;
}
<div id="linkcydy" role="tabpanel" class="tab-pane" style="width:98%; margin-right: 10px;margin-top: 3px;">
    <div class="contentPanel" style="border: 1px solid #ddd;">
        <div style="background-color: #fff;" id="dv_takegridmedicine">
            <table id="gridTake"></table>
            <div id="gridTakePager"></div>
        </div>
    </div>
    <div class="toolbar" style="float:right;width:80%;margin:10px 30px 12px;text-align:right;">
        <a class="btn btn-primary" style="margin-left:4px;" onclick="HistoricalOrders(@Html.Raw(((int)EnumYzlx.Cydy).ToString()))">Lịch sửY lệnhTrích dẫn</a>
        <a class="btn btn-primary" style="margin-left:4px;" id="btn_bottombutton_f7" onclick="ReviewToday()">Xem trong ngày</a>
        <a class="btn btn-primary" style="margin-left:4px;" id="btn_bottombutton_f8" onclick="SaveTakeTemplate()">Lưu thành bộ mẫu</a>
        <a class="btn btn-primary" style="margin-left:4px;" id="btn_bottombutton_f9" onclick="SaveTakeMedicine('1')">Lưu</a>
    </div>
</div>
<script>
    var deldata = [];//Xóađối tượng

    var cydyflag = 0;
    var Outlocaldata = new Array();
    function init_OutMedicinePrescription() {

        //chỉ chưaLưuđếnCơ sở dữ liệucủaY lệnhcần khởi tạo tronggridtrong
        Outlocaldata = new Array();
        if (window.alldataArray.cydy) {
            Outlocaldata = $.jsonWhere($.deepClone.clone(window.alldataArray.cydy), function (icf) {
                return !!!icf.Id;
            });
            $.each(Outlocaldata, function () {
                if (!this.Id) {
                    $.modalAlert('Y lệnhBất thường', "warning");
                    location.href = location.href;
                }
                this.action = getIActionStr();
            });
        }
        else {
            window.alldataArray.cydy = new Array(); //Để tiện dùng về sau$.each()
        }

        if (cydyflag == 0) {   //Trang này khởi tạo
            gridTake();
            cydyflag = 1;
        }

        else {
            $("#gridTake").clearGridData(); //xóa trắng trước
            //Mở lại trang này
            $("#gridTake").jqGrid('setGridParam', {
                datatype: 'local',
                data: Outlocaldata
            }).trigger("reloadGrid");
        }
    }

    var IsQyKssKz = "@IsQyKssKz";//CóKhôngKích hoạtKháng sinhđiều khiển
    var kssReasons = ":"; //LấyKháng sinhnguyên nhân
    $.each($.itemDetails.getItems('kssReason'),
        function() {
            if (this.Code != undefined) {
                kssReasons += ";" + this.Code + ":" + this.Name;
            }
        });

    //Thuốcdanh sách
    function gridTake() {
        var $gridTake = $("#gridTake");
        $gridTake.jqGrid({
            datatype: 'local',
            data: Outlocaldata,
            height: $(window).height() - 180,
            shrinkToFit: true,   //true:theo tỷ lệVDkhởi tạo độ rộng cột false:Sử dụngcolModelđộ rộng đã chỉ định
            autowidth: true,
            rownumbers: true,  //CóKhôngHiển thịSố thứ tự
            editurl: "clientArray",  //dòngSửakhông gửi lên máy chủGửiDữ liệu
            unwritten: false,
            colModel: [
                { label: 'Id', name: 'Id', align: 'center', hidden: true },
                { label: 'Dài hạn<br>Tạm thời', name: 'yzlb', width: 35, editwidth: '100%', align: 'center', editable: true },
                {
                    label: '<span class="required">*</span>Tên thuốc', name: 'xmmc', width: 140, editwidth: '100%', align: 'center', editable: true
                },
                {
                    label: '<span class="required">*</span>Thời gian bắt đầu', name: 'kssj', width: 140, editwidth: '100%',
                    align: 'center',
                    editable: true, unformat: pickDate, formatter: "date",
                    formatoptions: { srcformat: 'Y-m-d h:m:s', newformat: 'Y-m-d h:m:s' },
                    formatter: function (cellvalue, options, cell) {
                        return (typeof (cellvalue) == "undefined") ? "" : cellvalue;
                    }
                },
                { label: 'xmdm', name: 'xmdm', width: 100, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: '<span class="required">*</span>Quy cách', name: 'ypgg', width:70, editwidth: '100%', align: 'center', editable: true },
                { label: 'jlzhxs', name: 'jlzhxs', editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: 'zyzhxs', name: 'zyzhxs', editwidth: '100%', align: 'center', editable: true, hidden: true },
                {
                    label: '<span class="required">*</span>Liều lượng', name: 'ypjl', width: 55, editwidth: '100%', align: 'center', editable: true, editoptions: {
                        dataEvents: [
                                {
                                    type: 'change',
                                    fn: function (e) {
                                        var cellval = $(this).val();
                                        if(cellval.replace(/(^\s*)|(\s*$)/g, "") == ""){
                                            $.modalAlert("Liều lượngđể trống,Vui lòng xác nhận.", 'warning');
                                            return;
                                        }
                                        if(isNaN(cellval)){
                                            $.modalAlert("Liều lượng:Vui lòng nhập số", 'warning');
                                            $(this).val('');
                                            return;
                                        }
                                        var row = $(e.target).closest('tr.jqgrow');
                                        var rowid = row.attr('id');
                                        if(IsQyKssKz)
                                        {
                                            if($("#" + rowid + "_xmmc").val()==="")
                                            {
                                                $.modalAlert("Vui lòng chọn trướcThuốc.", 'warning');
                                                $(this).val('');
                                                return;
                                            }
                                            if($("#" + rowid + "_jlfwbegin").val()!= "undefined" && parseFloat($("#" + rowid + "_jlfwbegin").val()) > parseFloat(cellval)){
                                                $.modalAlert("Liều lượng nhỏ hơn phạm vi liều tối thiểu một lần của kháng sinh, vui lòng xác nhận.", 'warning');
                                                $(this).val('');
                                                return;
                                            }
                                            if($("#" + rowid + "_jlfwend").val()!= "undefined" && parseFloat($("#" + rowid + "_jlfwend").val()) < parseFloat(cellval)){
                                                $.modalAlert("Liều lượng vượt quá phạm vi liều tối đa một lần của kháng sinh, vui lòng xác nhận.", 'warning');
                                                $(this).val('');
                                                return;
                                            }
                                        }

                                        caltakesl(rowid);
                                    }
                                }
                        ]
                    }},
                {
                    label: '<span class="required">*</span>Đơn vị', name: 'dw', width: 60, editwidth: '100%', align: 'center', editable: true, edittype: "select", editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    $("#" + rowid + "_dwwwwwww").val($(this).find("option:selected").text());
                                    //dùng làmLưuĐã chọncủadwcủaGiá trị
                                    $("#" + rowid + "_dwlb").val($(this).val());
                                    caltakesl(rowid);
                                }
                            }
                        ]

                    }  //Lưu ý: đơn vị liều phải ghi ở phía dưới liều lượng, vì phía dưới căn cứ vào đây để tìm đơn vị liều. (vì select không có thuộc tính id)
                },
                { label: 'dwlb', name: 'dwlb', editwidth: '', align: 'center', editable: true, hidden: true },  //Không thể bỏ
                { label: 'redundant_jldw', name: 'redundant_jldw', editwidth: '', align: 'center', editable: true, hidden: true },  //Không thể bỏ
                { label: 'dwwwwwww', name: 'dwwwwwww', editwidth: '', align: 'center', editable: true, hidden: true },  //Không thể bỏ
                {
                    label: '<span class="required">*</span>Cách dùng', name: 'yfmc', width: 70, editwidth: '100%', align: 'center', edittype: "select", editable: true, editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    $("#" + rowid + "_ypyfdm").val($(this).val());
                                    $("#" + rowid + "_yfmcval").val($(this).find("option:selected").text());
                                    $.ajax({
                                        type: "POST",
                                        dataType: "json", //Quay lạijsondữ liệu dạng
                                        url: "/Prescription/GetSfxmItem",
                                        data: { "yfCode": $("#" + rowid + "_ypyfdm").val() },
                                        async: false,
                                        success: function (ret) {
                                            if (ret != null && ret != "" && ret != []) {
                                                $("#" + rowid + "_yfztbm").val(ret[0]['sfmb']);
                                                $("#" + rowid + "_yfztmc").val(ret[0]['sfmbmc']);
                                            }
                                            else {
                                                $("#" + rowid + "_yfztbm").val("");
                                                $("#" + rowid + "_yfztmc").val("");
                                            }
                                        }
                                    })
                                }
                            }
                        ]

                    }
                },
                { label: '<span class="required"></span>Bộ mẫu', name: 'yfztmc', width: 65, editwidth: '100%', align: 'center', editable: true},
                { label: '<span class="required"></span>Bộ mẫuMã', name: 'yfztbm', width: 65, editwidth: '100%', align: 'center', editable: true,hidden:true},
                { label: 'yfmcval', name: 'yfmcval', width: 75, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: 'ypyfdm', name: 'ypyfdm', width: 75, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: '<span class="required">*</span>Tần suất', name: 'pcmc', width: 50, editwidth: '100%', align: 'center',  editable: true },
                { label: 'pcCode', name: 'pcCode', editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: 'zxcs', name: 'zxcs',editable: true,hidden: true },
                { label: 'zxzq', name: 'zxzq',editable: true,hidden: true },
                { label: 'zxzqdw', name: 'zxzqdw', editable: true, hidden: true },
                {
                    label: '<span class="required">*</span>Liều dùngĐơn vị', name: 'yldw', width: 90, editwidth: '100%', align: 'center', editable: true, edittype: "select", editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    var $thisval = $(this).val();
                                    if ($thisval == "1") {//Số ngày
                                        //Kích hoạt
                                        $("#" + rowid + "_yl").css('background-color', 'white').removeAttr('readonly');
                                        //Vô hiệu hóa
                                        $("#" + rowid + "_sl").css('background-color', '#f6f7fb').attr('readonly', 'true');
                                        $("#" + rowid + "_sl").val("");
                                    } else {//mang thuốcTổng lượng
                                        //Vô hiệu hóa
                                        $("#" + rowid + "_yl").css('background-color', '#f6f7fb').attr('readonly', 'true');
                                        $("#" + rowid + "_yl").val("");
                                        //Kích hoạt
                                        $("#" + rowid + "_sl").css('background-color', 'white').removeAttr('readonly');
                                        $("#" + rowid + "_sl").val("");
                                    }
                                    $("#" + rowid + "_yldwwwwwww").val($thisval);
                                    caltakesl(rowid);
                                }
                            }
                        ]

                    }
                },
                { label: 'yldwwwwwww', name: 'yldwwwwwww', editwidth: '', align: 'center', editable: true, hidden: true },  //Không thể bỏ
                { label: '<span class="required">*</span>Số ngày', name: 'yl', width: 50, editwidth: '100%', align: 'center', editable: true },
                { label: 'Tổng lượng', name: 'sl', width: 50, editwidth: '100%', align: 'center', editable: true },
                { label: 'Nhập viện<br>Đơn vị', name: 'zydw', width: 50, editwidth: '100%', align: 'center', editable: true},
                { label: 'Dặn dò', name: 'ztnr', width: 80, editwidth: '100%', align: 'center', editable: true },
                {
                    label: 'Kháng sinh<br>Nguyên nhân', name: 'kssReason', width: 100, editwidth: '100%', align: 'center', edittype: "select", editable: true, editoptions: { value: kssReasons,
                    dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    //if($(this).val()=="")
                                    //{
                                    //    $.modalAlert("Kháng sinhThuốccầnđiềnviếtdùngdùngnguyên nhân，vui lònglạichọn", "warning");
                                    //    $(this).val("2");
                                    //}
                                }
                            }
                    ]
                    }
                },
                {
                    label: 'Chuyển sang tự chi trả', name: 'iszzf', width: 80, editwidth: '100%', align: 'center', edittype: "select", editable: true, editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    $("#" + rowid + "_iszzffffff").val($(this).val());
                                }
                            }
                        ]

                    }
                },
                { label: 'iszzffffff', name: 'iszzffffff', editwidth: '', align: 'center', editable: true, hidden: true }, 
                {
                    label: 'Tính phí', name: 'isjf', width: 40, editwidth: '100%', align: 'center', edittype: "select", editable: true, editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    $("#" + rowid + "_isjffffff").val($(this).val());
                                }
                            }
                        ]

                    }
                },
                { label: 'isjffffff', name: 'isjffffff', editwidth: '', align: 'center', editable: true, hidden: true },
                 {
                     label: 'Thuốc gây nghiện - hướng thần', name: 'yztaggg', width: 60, editwidth: '100%', align: 'center', edittype: "select", editable: true, editoptions: {
                         dataEvents: [
                             {
                                 type: 'change',
                                 fn: function (e) {
                                     var row = $(e.target).closest('tr.jqgrow');
                                     var rowid = row.attr('id');
                                     $("#" + rowid + "_yztag").val($(this).val());
                                 }
                             }
                         ]

                     }
                 },
                { label: 'yztag', name: 'yztag', editwidth: '', align: 'center', editable: true, hidden: true },
                { label: 'iskss', name: 'iskss', editable: true, hidden: true },
                { label: 'jlfwbegin', name: 'jlfwbegin', editable: true, hidden: true },
                { label: 'jlfwend', name: 'jlfwend', editable: true, hidden: true },
                { label: 'pcfwbegin', name: 'pcfwbegin', editable: true, hidden: true },
                { label: 'pcfwend', name: 'pcfwend', editable: true, hidden: true },
                { label: 'Thao tác', name: 'action', width: 45, align: 'center' },
                { name: 'yzlx', hidden: true },
                { name: 'zyh', hidden: true },
                { name: 'ysgh', hidden: true },
                { name: 'zxksdm', width: 50, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { name: 'qzfs', width: 50, editwidth: '100%', editable: true, hidden: true },
                { name: 'kcsl', width: 50, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { name: 'jxCode', width: 50, editwidth: '100%', align: 'center', editable: true, hidden: true }
            ],
            editinputwidthborder: false,    //CóKhôngcần viền Mặc địnhlàtrue
            editinputborderradius: false,   //CóKhôngcần bo tròn viền Mặc địnhtrue(có bo tròn)
            pager: "gridTakePager",
            gridComplete: function () {
                EnableTInlineEditBox();
                //Ẩngridthanh cuộn dưới cùng
                $gridTake.closest(".ui-jqgrid-bdiv").css({ "overflow-x": "hidden" });
            }
        });

        //Menu cấp 2
        $gridTake.jqGrid('setGroupHeaders', {
            useColSpanStyle: true,
            groupHeaders: [
                {
                    startColumnName: 'xmmc',
                    numberOfColumns: 6,
                    titleText: 'Thông tin cơ bản'
                }, {
                    startColumnName: 'ypjl',
                    numberOfColumns: 2,
                    titleText: 'Mỗi lầnLiều lượng'
                }]
        });

        $.each($(".jqg-first-row-header").find("th"),
            function () {
                $(this).css("padding", 0);
            });

        //Nút tùy chỉnh
        $gridTake.navGrid('#gridTakePager',
                {
                    edit: false,
                    add: false,
                    del: false,
                    search: false,
                    refresh: false,
                    view: false,
                    position: "left",
                    cloneToTop: false
                })
            .navButtonAdd('#gridTakePager',
                {
                    buttonicon: "glyphicon glyphicon-new-window",
                    title: "Y lệnh mới",
                    caption: "Y lệnh mới",
                    position: "last",
                    onClickButton: function() {
                        newTPresData(null);
                    }
                });
        $("#gridTakePager_right").append('<div class=\"ckbox\" style=\"margin-top:2px;\"><span style="color:red;">Nhà thuốc:</span><select id="tip_cydyyfly"></select></div>');
        $("#gridTakePager_right").append("<div class=\"ckbox\" style=\"margin-top:2px;\"><input id=\"chkTakelsyz\" name=\"chkTakelsyz\" type=\"checkbox\" checked=\"checked\" ><label for=\"chkTakelsyz\">Y lệnh tạm thời</label></div>");
        $("#tip_cydyyfly").empty();
        $.ajax({
            type: "POST",
            dataType: "json", //Quay lạijsondữ liệu dạng
            url: "/Prescription/GetYfData",
            data: { },
            async: false,
            success: function (ret) {
                var res=false;
                var currYfdm = sessionStorage.getItem('currzyyf');
                $.each(ret, function () {
                    if((this.mzzybz=="2" && res==false && !currYfdm)||(currYfdm==this.yfbmCode && res==false)){
                        var option = "<option value='" + this.yfbmCode +"|"+ this.mzzybz + "' selected>" + this.yfbmmc + "</option>";
                        res=true;
                    }
                    else
                        var option = "<option value='" + this.yfbmCode +"|"+ this.mzzybz + "'>" + this.yfbmmc + "</option>";
                    $("#tip_cydyyfly").append(option);
                });
            }
        });
        $("#tip_cydyyfly").change(function(){
            sessionStorage.setItem("currzyyf", $("#tip_cydyyfly").val().split('|')[0]);
        });
    }

    //Bật sửa trong dòng
    function EnableTInlineEditBox() {
        var ids = $("#gridTake").getDataIDs();
        $.each(ids, function () {
            var rowid = String(this);
            //MởSửachế độ
            $("#gridTake").jqGrid('editRow', rowid, false, initTInlineFunc);

            //chomỗi lầnĐơn vị liềuđiềnoption
            var jldw = $("#" + rowid + "_redundant_jldw").val();    //Đơn vị liều Thuốcbảng từ điểncủaĐơn vị
            var dw = $("#" + rowid + "_dwwwwwww").val();     //Đơn vị nhập viện
            if (!!dw) {
                //cách tìm phần tử nàyPhương phápkhông nên dùng，nhưng doselectKhông cóidThuộc tính
                $("#" + rowid + "_ypjl").parent().next().children('select').html('');

                if (jldw === dw) {
                    $("#" + rowid + "_ypjl").parent().next().children('select').append('<option value="1">' + jldw + '</option>');
                }
                else {
                    var dwlb = $("#" + rowid + "_dwlb").val(); //tồn tạiởĐơn vịLoạikhi，thaybảngđãtồn tạiởĐã chọncủaĐơn vị，trangmặtĐã chọn
                    var jldwlb = 1, dwdwlb = 4;
                    if (!!dwlb) {
                        if (jldwlb == dwlb) {
                            jldwlb = 4, dwdwlb = 1;
                        }
                    }
                    if(!!jldw){
                        $("#" + rowid + "_ypjl").parent().next().children('select').append('<option value="' + jldwlb+'">' + jldw + '</option>');
                    }
                    if (!!dw) {
                        $("#" + rowid + "_ypjl").parent().next().children('select').append('<option value="' + dwdwlb + '">' + dw + '</option>');
                    }
                    $("#" + rowid + "_ypjl").parent().next().children('select').val(dwlb);
                }
            }
            var yldw = $("#" + rowid + "_yldwwwwwww").val();
            if (yldw == "1") {//Số ngày
                //Kích hoạt
                $("#" + rowid + "_yl").css('background-color', 'white').removeAttr('readonly');
                //Vô hiệu hóa
                $("#" + rowid + "_sl").css('background-color', '#f6f7fb').attr('readonly', 'true');
            } else {//mang thuốcTổng lượng
                //Vô hiệu hóa
                $("#" + rowid + "_yl").css('background-color', '#f6f7fb').attr('readonly', 'true');
                //Kích hoạt
                $("#" + rowid + "_sl").css('background-color', 'white').removeAttr('readonly');
            }
            $("#" + rowid + "_kssj").css("text-align", "left");

            //Loại y lệnh: dài hạn, tạm thời
            if ($("#" + rowid + "_yzlb").val() == undefined || $("#" + rowid + "_yzlb").val() === "") {
                var yzlb = $("#chkTakelsyz").is(":checked") ? "临" : "长";
                $("#" + rowid + "_yzlb").val(yzlb);
            }
        });
    }

    //Khởi tạo lớp nổi
    function initTInlineFunc(rowid) {
        var qxjb = "@qxjb";
        //Một số cột chỉ đọc
        $("#" + rowid + "_ypgg").css('background-color','#f6f7fb').attr('readonly','true');
        $("#" + rowid + "_dw").css('background-color','#f6f7fb').attr('readonly','true');
        $("#" + rowid + "_zydw").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_pcmc").attr('readonly', 'true');
        $("#" + rowid + "_sl").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_zxzqdw").parent().next().children('select').html('');
        $("#" + rowid + "_zxzqdw").parent().next().children('select').append('<option value="1">Số ngày</option><option value="0">Thuốc mang theoTổng lượng</option>');
        $("#" + rowid + "_ypgg").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_xmmc").attr('autocomplete', 'off');
        $("#" + rowid + "_yzlb").attr('readonly', 'true');
        $("#" + rowid + "_kssReason").parent().next().children('select').html('');

@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "Nhập văn bản";
}
<style>
    #dv_gridword td {
        padding: 0;
    }

    #dv_gridword th {
        padding: 5px 0;
    }

    #gridword select[role=select] {
        padding: 0;
    }

    #gridword input[role=textbox] {
        padding: 2px 0;
        text-align: center;
    }
</style>
<div id="linkwzlr" role="tabpanel" class="tab-pane" style="width:98%;margin-right: 10px;margin-top: 3px;">
    <div class="contentPanel" style="border: 1px solid #ddd;">
        <div style="background-color: #fff;" id="dv_gridword">
            <table id="gridword"></table>
            <div id="gridwordPager"></div>
        </div>
    </div>
    <div class="toolbar" style="float:right;width:80%;margin:10px 30px 12px;text-align:right;">
        <a class="btn btn-primary" style="margin-left:4px;" onclick="HistoricalOrders(@Html.Raw(((int)EnumYzlx.Wz).ToString()))">Trích dẫn y lệnh lịch sử</a>
        <a class="btn btn-primary" style="margin-left:4px;" id="btn_bottombutton_f7" onclick="ReviewToday()">Xem trong ngày</a>
        <a class="btn btn-primary" style="margin-left:4px;" id="btn_bottombutton_f8" onclick="SaveWordTemplate()">Lưu thành gói khác</a>
        <a class="btn btn-primary" style="margin-left:4px;" id="btn_bottombutton_f9" onclick="SaveWordMedicine('1')">Lưu</a>
    </div>
</div>
<script>
    var deldata = [];//Xóa đối tượng
    var wzyzflag = 0;
    var wordlocaldata = new Array();
    function init_WordPrescription() {
        //Chỉ y lệnh chưa lưu vào cơ sở dữ liệu mới cần khởi tạo tronggridtrong
        wordlocaldata = new Array();
        if (window.alldataArray.wzyz) {
            wordlocaldata = $.jsonWhere($.deepClone.clone(window.alldataArray.wzyz), function (icf) {
                return !!!icf.Id;
            });
            $.each(wordlocaldata, function () {
                if (!this.Id) {
                    $.modalAlert('Y lệnh bất thường', "warning");
                    location.href = location.href;
                }
                this.action = getWordActionStr();
            });
        }
        else {
            window.alldataArray.wzyz = new Array(); //Để tiện sử dụng sau này$.each()
        }

        if (wzyzflag == 0) {   //Khởi tạo trang này
            gridword();

            wzyzflag = 1;
        }

        else {
            $("#gridword").clearGridData(); //Xóa trước
            //Mở lại trang này
            $("#gridword").jqGrid('setGridParam', {
                datatype: 'local',
                data: wordlocaldata
            }).trigger("reloadGrid");
        }
    }


    //Danh sách thuốc
    function gridword() {
        var $gridword = $("#gridword");
        $gridword.jqGrid({
            datatype: 'local',
            data: wordlocaldata,
            height: $(window).height() - 180,
            shrinkToFit: true,   //true:Khởi tạo chiều rộng cột theo tỷ lệ false:Sử dụngcolModelchiều rộng đã chỉ định
            autowidth: true,
            rownumbers: true,  //Có hiển thị số thứ tự không
            editurl: "clientArray",  //Chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            unwritten: false,
            colModel: [
                { label: 'Id', name: 'Id', align: 'center', hidden: true },
                { label: 'Dài hạn<br>Tạm thời', name: 'yzlb', width: 35, editwidth: '100%', align: 'center', editable: true},
                {
                    label: '<span class="required">*</span>Chỉ định', name: 'xmmc', width: 250, editwidth: '100%', align: 'center', editable: true
                },
                {
                    label: '<span class="required">*</span>Thời gian bắt đầu', name: 'kssj', width: 140, editwidth: '95%',

                    align: 'center',
                    editable: true, unformat: pickDate, formatter: "date",
                    formatoptions: { srcformat: 'Y-m-d h:m:s', newformat: 'Y-m-d h:m:s' },
                    formatter: function (cellvalue, options, cell) {
                        return (typeof (cellvalue) == "undefined") ? "" : cellvalue;
                    }
                },
                { label: 'xmdm', name: 'xmdm', width: 100, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: '<span class="required">*</span>Tần suất', name: 'pcmc', width: 60, editwidth: '100%', align: 'center', editable: true },
                { label: 'pcCode', name: 'pcCode', editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: 'Số ngày', name: 'ts', width: 80, editwidth: '100%', align: 'center', editable: true },
                { label: 'zxcs', name: 'zxcs', editable: true, hidden: true },
                { label: 'zxzq', name: 'zxzq', editable: true, hidden: true },
                { label: 'zxzqdw', name: 'zxzqdw', editable: true, hidden: true },
                { label: 'Dặn dò', name: 'ztnr', width: 260, editwidth: '100%', align: 'center', editable: true },
                { label: 'Thao tác', name: 'action', width: 80, align: 'center' },
                { name: 'yzlx', hidden: true },
                { name: 'zyh', hidden: true },
                { name: 'ysgh', hidden: true }, { name: 'Px', hidden: true },
            ],
            editinputwidthborder: false,    //Có cần viền không mặc định làtrue
            editinputborderradius: false,   //Có cần bo góc viền không Mặc địnhtrue(có bo góc)
            pager: "gridwordPager",
            gridComplete: function () {
                EnableWordInlineEditBox();
                //ẨngridThanh cuộn dưới cùng
                $gridword.closest(".ui-jqgrid-bdiv").css({ "overflow-x": "hidden" });
            }
        });

        //Menu cấp hai
        $gridword.jqGrid('setGroupHeaders', {
            useColSpanStyle: true,
            groupHeaders: [
                {
                    startColumnName: 'xmmc',
                    numberOfColumns: 3,
                    titleText: 'Thông tin cơ bản'
                }]
        });

        $.each($(".jqg-first-row-header").find("th"),
            function () {
                $(this).css("padding", 0);
            });
        //Nút tùy chỉnh
        $gridword.navGrid('#gridwordPager',
                {
                    edit: false,
                    add: false,
                    del: false,
                    search: false,
                    refresh: false,
                    view: false,
                    position: "left",
                    cloneToTop: false
                })
            .navButtonAdd('#gridwordPager',
                {
                    buttonicon: "glyphicon glyphicon-new-window",
                    title: "Y lệnh mới",
                    caption: "Y lệnh mới",
                    position: "last",
                    onClickButton: function() {
                        newWordPresData();
                    }
            });
        $("#gridwordPager_right").append("<div class=\"ckbox\" style=\"margin-top:2px;\"><input id=\"chkwordyz\" name=\"chkwordyz\" type=\"checkbox\" ><label for=\"chkwordyz\">Y lệnh tạm thời</label></div>");
        $("#gridwordPager_right").append("<div class=\"ckbox\" style=\"margin-top:2px;\"><input id=\"chkycy\" name=\"chkycy\" type=\"checkbox\" ><label for=\"chkycy\">Dự kiến xuất viện</label></div>");
    }

    //Bật chỉnh sửa trong dòng
    function EnableWordInlineEditBox() {
        var ids = $("#gridword").getDataIDs();
        $.each(ids, function () {
            var rowid = String(this);
            //Mở chế độ chỉnh sửa
            $("#gridword").jqGrid('editRow', rowid, false, initWordInlineFunc);
            $("#" + rowid + "_kssj").css("text-align", "left");

            //Loại y lệnh Dài hạn, tạm thời
            if ($("#" + rowid + "_yzlb").val() == undefined || $("#" + rowid + "_yzlb").val() === "") {
                var yzlb = $("#chkwordyz").is(":checked") ? "临" : "长";
                $("#" + rowid + "_yzlb").val(yzlb);
            }
            $("#" + rowid + "_yzlb").attr('readonly', 'true');
        });

    }

    //Khởi tạo Lớp nổi
    function initWordInlineFunc(rowid) {
        //Một số cột chỉ đọc
        $("#" + rowid + "_pcmc").attr('readonly', 'true');
        var currlineId = $("#gridword").getRowData(rowid).Id;
        $("#" + rowid + "_xmmc").attr('autocomplete', 'off');
        if (currlineId.indexOf("0.") == '-1') {//Dữ liệu đã sửa không được phép sửa hạng mục thu phí
           // $("#" + rowid + "_xmmc").css('background-color', '#f6f7fb').attr('readonly', 'true');
        }

        //Loại y lệnh Nổi
        $("#" + rowid + "_yzlb").yzlbFloatingSelector({
            isinputchangetriggered: false,
            showtext: 'Name',
            attrcols: ['yzlb', "Name"],
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_yzlb").val($this.attr('data-yzlb'));
                $("#" + rowid + "_yzlb").trigger("change");
            }
        });

        $("#" + rowid + "_yzlb").change(function () {
            if ($("#" + rowid + "_yzlb").val() === "临") {
                $("#" + rowid + "_ts").css('background-color', '#f6f7fb').attr('readonly', 'true'); //Y lệnh tạm thời Vô hiệu hóa số ngày
            } else {
                $("#" + rowid + "_ts").css('background-color', '#fff').removeAttr('readonly'); //Y lệnh dài hạn Bật số ngày
            }
        });

        //Lớp nổi tần suất
        $("#" + rowid + "_pcmc").pcFloatingSelector({
            showtext: 'yzpcmc',
            attrcols: ['yzpcmc', 'yzpcCode', 'zxcs', 'zxzq', 'zxzqdw'],
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_pcmc").val($this.attr('data-yzpcmc'));
                $("#" + rowid + "_pcCode").val($this.attr('data-yzpcCode'));
                $("#" + rowid + "_zxcs").val($this.attr('data-zxcs'))
                $("#" + rowid + "_zxzq").val($this.attr('data-zxzq'))
                $("#" + rowid + "_zxzqdw").val($this.attr('data-zxzqdw'));
                if($("#" + rowid + "_pcmc").val()=="ST")
                {
                    $("#" + rowid + "_yzlb").val("临");
                }
                var pcCode = $("#" + rowid + "_pcCode").val();
                //Vô hiệu hóa số ngày của y lệnh tạm thời
                if ('@ViewBag.pcStr' !== '' && pcCode !== '' && (!isNaN(pcCode)) &&
                    (('@ViewBag.pcStr').indexOf(pcCode) > -1)) {
                    $("#" + rowid + "_ts").css('background-color', '#f6f7fb').attr('readonly', 'true');
                } else {
                    $("#" + rowid + "_ts").css('background-color', 'white').removeAttr('readonly');
                }
            }
        });

        //Lớp nổi dặn dò
        $("#" + rowid + "_ztnr").ztFloatingSelector({
            height: 100,
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_ztnr").val($this.attr('data-ztmc'));
            }
        });


        //Lớp nổi chỉ định
        //$("#" + rowid + "_xmmc").zsFloatingSelector({
        //    height: 300,
        //    itemdbclickhandler: function ($this) {
        //        $("#" + rowid + "_xmmc").val($this.attr('data-ssmc') + '   ' + $this.attr('data-sssj') + '   ' + $this.attr('data-Name'));
        //    }
        //});
    }

    //Y lệnh mới Nút
    function newWordPresData() {
        if (patobjValidate()) {
            var dataRow = {
                Id: Math.random().toString() + new Date().getMilliseconds(),
                xmdm: "999999999999999999",
                action: getWordActionStr(),
                kssj: $.getTime(),
                yzlx: @((int)EnumYzlx.Wz),//Nhập văn bản
                yzzt: 0,//Mặc định chưa duyệt
                zyh: currentobj.zyh,
                yzlb: $("#chkwordyz").is(":checked") ? "临" : "长",
                xmmc: $("#chkycy").is(":checked") ? "预出院" : ""
                //ycy: $("#chkycy").is(":checked") ?"YCY":""
            };
            $("#gridword").jqGrid("addRowData", undefined, dataRow, "last");
        }
    }

    //Xóa chi tiết
    function deleteIRowData(selRowId, recalc) {
        if (!!selRowId) {
           var Id= $("#gridword").jqGrid('getRowData', selRowId).Id;
            $("#gridword").jqGrid("delRowData", selRowId);
            if (Id.indexOf("0.")==='-1') {//Ghi lại, xóa khỏi cơ sở dữ liệu
                deldata.push(Id);
            }
        }
    }

    function getWordActionStr() {
        return "<i class='fa fa-plus-square-o' style='font-size: large; color: #09a3ea;' onclick='newWordPresData()'></i>&nbsp;&nbsp;&nbsp;<i class='fa fa-minus-square-o' style='font-size: large; color: #09a3ea;' onclick='deleteIRowData($(this).parent().parent().attr(\"id\"));return false;'></i>";
    }

    //Hành động nút Lưu 
    function SaveWordMedicine(savetodb) {
        patobjValidate();
            //Lấy tất cả các dòngId，duyệt để khung chỉnh sửa ở trạng thái lưu
            var rowIds = $("#gridword").jqGrid('getDataIDs');
            for (var i = 0; i < rowIds.length; i++) {
                var saveResult = $("#gridword").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);

                if (!saveResult) {
                    EnableWordInlineEditBox();    //Khởi động lại và bật chỉnh sửa Nếu không, lần sauSavethì sẽ trả vềfalse
                    return;   //Lưu thất bại, thìreturn
                }
            }
        var gridwordData = $("#gridword").jqGrid('getRowData_AllLine', null, true);
            if (gridwordData.length<1) {
                $.modalAlert("Hiện không có nội dung y lệnh đã lưu", 'warning');

        }

            var flag = false;
        var gridSimpleData = [];
        var px = 0;
            $.each(gridwordData, function () {    //Loại bỏaction
                for (var i = 0; i < $(this).length; i++) {
                    delete $(this)[i].action;
                    $(this)[i].ysgh = '@ViewBag.ysgh';
                    $(this)[i].Px = px + 1; px++;
                    if (savetodb == '1') {
                        if (this.xmmc == undefined || this.xmmc == "") {
                            $.modalAlert("Thiếu hạng mục", "warning");
                            flag = true;
                            return false;
                        } else if (this.kssj == undefined || this.kssj == "") {
                            $.modalAlert("Thiếu thời gian bắt đầu", "warning");
                            flag = true;
                            return false;
                        } else if (this.kssj < window.currentobj.ryrq) {
                            $.modalAlert("[" + this.xmmc + "]Thời gian bắt đầu không được sớm hơn thời gian nhập viện Ngày nhập viện:" + window.currentobj.ryrq, "warning");
                            flag = true;
                            return false;
                        } else if (this.pcmc == undefined || this.pcmc == "") {
                            $.modalAlert("Thiếu tần suất", "warning");
                            flag = true;
                            return false;
                        }
                    }
                }
        });

        if (flag) {
            EnableWordInlineEditBox();
            return;
        }

        //Lưu dữ liệu
        window.alldataArray.wzyz = $.jsonWhere(window.alldataArray.wzyz, function (iyzmx) {
            if (!!!iyzmx.Id) {
                return false;   //Trong danh sách chỉnh sửa có
            }
            for (var iIndex = 0; iIndex < gridwordData.length; iIndex++) {
                if (gridwordData[iIndex].Id === iyzmx.Id) {
                    return false;
                }
            }
            return true;
        });

        $.each(gridwordData, function () {
            this.yztag = $("#chkycy").is(":checked") ? "YCY" : "";//Gán giá trị dự kiến xuất viện
            window.alldataArray.wzyz.unshift(this);
        });

        wordlocaldata = new Array();

        if (savetodb==='1') {
            submitService(gridwordData);
            window.alldataArray.wzyz = [];
        }
    }
    //Xác thực
    function ValidateWord() {
        patobjValidate();
        //Có dữ liệu không
        var data = $("#gridword").jqGrid('getRowData_AllLine', null, true);
        if (data.length===0) {
            $.modalAlert("Thiếu dữ liệu y lệnh", 'warning');
            return false;
        }
        return true;
    }

    //Khởi tạo khi thao tác sửa
    function EditWInit(zyh, yzId, yzlb) {
        $.najax({
            url: "/DoctorManage/Medicine/GetYZDetail",
            dataType: "json",
            data: { zyh: zyh, yzId: yzId, yzlx: yzlb },//yzlx:Ký hiệu dài hạn, tạm thời
            type: "POST",
            success: function (data) {
                currentobj = data.patientInfo;
                wordlocaldata = data.DoctorServiceUIRequestDto;
                $.each(wordlocaldata, function () {
                    this.action = getMActionStr();
                });
                $("#gridword").jqGrid('setGridParam', {
                    datatype: 'local',
                    data: wordlocaldata,
                }).trigger("reloadGrid");

            }
        });
    }

     //Lưu thành mẫu khác
    function SaveWordTemplate() {
        $.modalOpen({
            id: "Form",
            title: "Gói",
            url: "/DoctorManage/DoctorsAdvice/Form",
            width: "400px",
            height: "300px",
            callBack: function (iframeId) {
                var obj = top.frames[iframeId].submitForm();
                if (obj && obj.mbmc != "" && obj.mblx) {
                    $.modalClose("Form");
                } else {
                    $.modalAlert("Tên gói và phạm vi gói là bắt buộc", "warning");
                    return;
                }
                var mbObj = {};
                if (obj != typeof (undefined)) {
                    mbObj.tcfw = obj.mblx;
                    mbObj.tcmc = obj.mbmc;
                    mbObj.tclx = @Html.Raw(((int)EnumYzlx.Wz).ToString());
                    mbObj.ysgh = '@ViewBag.ysgh';
                }

                //Lấy tất cả các dòngId，duyệt để khung chỉnh sửa ở trạng thái lưu
                var rowIds = $("#gridword").jqGrid('getDataIDs');
                for (var i = 0; i < rowIds.length; i++) {
                    var saveResult = $("#gridword").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);

                    if (!saveResult) {
                        EnableWordInlineEditBox();    //Khởi động lại và bật chỉnh sửa Nếu không, lần sauSavethì sẽ trả vềfalse
                        return;   //Lưu thất bại, thìreturn
                    }
                }
                var gridWordData = $("#gridword").jqGrid('getRowData_AllLine', null, true);
                if (gridWordData.length < 1) {
                    $.modalAlert("Thiếu dữ liệu y lệnh", 'warning');
                    return false;
                }
                $.each(gridWordData, function () {    //Loại bỏaction
                    for (var i = 0; i < $(this).length; i++) {
                        delete $(this)[i].action;
                    }
                });

                $.najax({
                    url: "@Url.Action("saveAsTemplate")",
                    dataType: "json",
                    data: { mbObj: mbObj, mxList: gridWordData },
                    type: "POST",
                    success: function (data) {
                        $.modalMsg("Lưu thành công", 'success');
                        window.$('#current').trigger('click');
                    }
                });
            }
        });
    }
</script>

    //LấyĐơn thuốchiển thịhiệnmàu sắc
    function getZhColor(zh) {
        var matched = $.jsonWhere(cfColorArr, function (v) {
            if (v.zh === zh) {
                return v.color
            }
        });
        if (matched && matched.length) {
            return matched[0].color;
        }
        var unusedColor = $.jsonWhere(cfSourceColorArr, function (v) {
            if (v) {
                var usedArr = $.jsonWhere(cfColorArr, function (q) {
                    return q && q.color === v.color;
                });
                if (!usedArr || usedArr.length == 0) {
                    return true;
                }
            }
            return false;
        });
        if (unusedColor && unusedColor.length) {
            var thisColor = unusedColor[0].color;
            cfColorArr.push({ zh: zh, color: thisColor });
            return thisColor;
        }
        return '#ddd';  //màu sắcdùngxongđã Mặc địnhmột màu
    }

    //Tính toánTần suấtSố lượng
    function getpcsl(zxcs, zxzq, zxzqdw)
    {
        debugger;
        if (isNaN(zxzqdw) || zxzqdw=="") {
            $.modalAlert("Thực hiệnChu kỳĐơn vịkhông được để trống", 'error');
            return;
        }
        var rtnsl;
        switch (zxzqdw) {//1：ngày，2：giờ，3：Phút
            case "1":
                rtnsl = (zxcs / zxzq);
                break;
            case "2":
                rtnsl = (zxcs / zxzq) * 24;
                break;
            case "3":
                rtnsl = (zxcs / zxzq) * 24 * 60;
                break;
            case 4:
                rtnsl = 0;
                break;
        }
        return rtnsl;
    }

    //Tính toánThuốcSố lượng
    function getypsl(jlzhxs, zyzhxs, ypjl, dwlb, zxcs, zxzq, zxzqdw, ts, qzfs)
    {
        debugger;
        var zysl = 0;
        if (isNaN(dwlb) || dwlb == "") {
            $.modalAlert("Đơn vịLoạikhông được để trống", 'error');
            return;
        }
        var qzint = ypjl * ts;//Mặc địnhĐơn vị nhập viện ，khôngcầnchuyểnđổi
        if (dwlb == 1) {//Đơn vị liều chuyểnđổithànhĐơn vị liều
            qzint = parseFloat((qzint / (jlzhxs * zyzhxs)).toFixed(10));
        }
        if (qzfs == "day") {
            zysl = Number(Math.ceil(qzint * getpcsl(zxcs, zxzq, zxzqdw)));
        } else if (qzfs == "times") {
            if(zxzq>1)//theo tình hình bán của gói liệu trình
                zysl = Number(Math.ceil(qzint * getpcsl(zxcs, zxzq, zxzqdw)));
            else
                zysl = Number(Math.ceil(qzint) * getpcsl(zxcs, zxzq, zxzqdw));
        }
        return zysl;
    }


@{
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="rows" style="width:95%;margin-left:1%;">
    <table class="form" style="width: 100%;height: 100px;border: 1px solid #ddd;margin-bottom: 20px; margin-top:20px;">
        <tr>
            <td class="formTitle">
                <span style="color:red">*</span>Xuất việnThời gian:
            </td>
            <td colspan="4" class="formValue">
                <input id="tzsj" style="width:145px;" class="form-control input-wdatepicker" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")">
            </td>
        </tr>
        <tr>
            <td colspan="5" style="padding-left:10px">
                <span style="color: red;">
                    Vui lòng chú ý:1. Vui lòng điền chính xác ngày và giờ xuất viện,
                    Sau khi 【Xác nhận】, toàn bộ y lệnh dài hạn của bệnh nhân này sẽ bị dừng,
                    Đồng thời hệ thống sẽ tự động nhập cho bạn một dòng y lệnh 【Xuất viện】!<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2. Bệnh nhân xuất viện hôm nay không cần dùng thuốc, vui lòng điều chỉnh riêng thời gian dừng y lệnh thành ngày trước ngày xuất viện (ví dụ: dùng thuốc đường tĩnh mạch)
                </span>
            </td>
        </tr>
    </table>
</div>
<script type="text/javascript">
    var zyh = $.request("zyh");

    function submitForm(callback)
    {
        var data = { zyh: zyh, tzsj: $('#tzsj').val() };
        $.najax({
            url: "@Url.Action("AdviceLeaveHospitalStopSubmit")",
            dataType: "json",
            data: data,
            type: "POST",
            success: function ()
            {
                if (callback) {
                    callback();
                }
            }
        });
    }

</script>

@{
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="rows" style="width:95%;margin-left:1%;">
    <table class="form" style="width: 100%;height: 100px;border: 1px solid #ddd;margin-bottom: 20px; margin-top:20px;">
        <tr>
            <td class="formTitle">
                <span style="color:red">*</span>Mục tiêuKhu bệnh:
            </td>
            <td class="formValue formDdlSelectorTd" style="width:110px;">
                <select id="sel_inpatientArea" class="form-control">
                    <option value="">==Vui lòng chọn==</option>
                </select>
            </td>
            <td class="formTitle">
                <span style="color:red">*</span>Thời gian bắt đầu:
            </td>
            <td colspan="2" class="formValue">
                <input id="kssj" style="width:145px;" class="form-control input-wdatepicker" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy HH:mm:ss' })" value="@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")">
            </td>
        </tr>
        <tr>
            <td colspan="5" style="padding-left:10px">
                <span style="color: red;">
                    Vui lòng chú ý: Vui lòng điền chính xác khu bệnh đích và thời gian bắt đầu,
                    Sau khi 【Xác nhận】, toàn bộ y lệnh dài hạn của bệnh nhân này sẽ bị dừng,
                    Đồng thời hệ thống sẽ tự động nhập cho bạn một dòng y lệnh 【Chuyển khu】!
                </span>
            </td>
        </tr>
    </table>
</div>
<script type="text/javascript">
    var zyh = $.request("zyh");

    $("#sel_inpatientArea").bindSelect({
        //url: "/SystemManage/BaseData/GetAuthedWardSelectJson",
        url: "/NurseManage/EntryRegistration/TreeViewdata",

    });
    function submitForm(callback) {
        $.najax({
            url: "@Url.Action("AdviceTransferWardStopSubmit")",
            dataType: "json",
            data: { zyh: zyh, bq: $('#sel_inpatientArea').find("option:selected").text(), kssj: $('#kssj').val() },
            type: "POST",
            success: function () {
                if (callback) { 
                    callback();
                }
            }
        });
    }

</script>
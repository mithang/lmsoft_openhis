@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "HistoricalOrders";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<form id="tabGrid">
    <div>
        <table class="form">
            <tr>
                <td class="formValue" style="text-align: center;">
                    Họ tên:<label id="xm"></label>
                </td>
                <td class="formValue" style="text-align: center;">
                    Giới tính:<label id="xb"></label>
                </td>
                <td class="formValue" style="text-align: center;">
                    Ngày nhập viện:<label id="ryrq"></label>
                </td>
                <td class="formValue" style="text-align: center;">
                    Ngày xuất viện:<label id="cyrq"></label>
                </td>
                <td class="formValue" style="text-align: center;">
                    Chẩn đoán nhập viện:<label id="ryzd"></label>
                </td>
                <td class="formValue" style="text-align: center;">
                    Chẩn đoán xuất viện:<label id="cyzd"></label>
                </td>
            </tr>
        </table>
    </div>
        <div>
            <table class="form">
                <tr>
                    <th class="formTitle">Ngày bắt đầu:</th>
                    <td class="formValue">
                        <input id="kssj" name="kssj" type="text" class="required form-control input-wdatepicker formClearIgnore" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" value="@DateTime.Now.AddMonths(-1).ToString("yyyy-MM-dd HH:mm:ss")">
                    </td>
                    <th class="formTitle">Ngày kết thúc:</th>
                    <td class="formValue">
                        <input id="jssj" name="jssj" type="text" class="required form-control input-wdatepicker formClearIgnore" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")">
                    </td>
                    <th class="formTitle">Dài hạn/Y lệnh tạm thời:</th>
                    <td class="formValue">
                        <select id="CLSelect" name="CLSelect"  class="form-control required">
                            <option value="">Tất cả y lệnh</option>
                            <option value="临">Y lệnh tạm thời</option>
                            <option value="长">Y lệnh dài hạn</option>
                        </select>
                    </td>
                    <th class="formTitle" id="yzlxth" style="display:none">Loại y lệnh:</th>
                    <td class="formValue" id="yzlxtd" style="display:none">
                        <select id="yzlxSel" name="yzlxSel"  class="form-control required">
                            <option value="2">Thuốc</option>
                            <option value="10">Thảo dược</option>
                            <option value="4">Thuốc mang về khi xuất viện</option>
                            <option value="3">Nhập văn bản</option>
                            <option value="5">Nhập hạng mục</option>
                        </select>
                    </td>
                    <td class="formValue" style="width:90px;">
                        <input type="button" id="btn_search" onclick="search()" class="btn btn-md btn-primary" style="width:80px;" value="Tra cứu" />
                    </td>
                </tr>
            </table>
            <div class="gridPanel">
                <table id="gridList" rel="tabGrid"></table>
                <div id="gridPager"></div>
            </div>
        </div>
</form>

<script>
    var zyh = $.request("zyh");
    var tclx = $.request("tclx");
    var ryrq = $.request("ryrq");
    var xm = $.request("xm");
    var xb = $.request("xb");
    var cyrq = $.request("cyrq");
    var ryzd = $.request("ryzd");
    var cyzd = $.request("cyzd");
    $("#kssj").val(ryrq);
    $("#ryrq").text(ryrq);
    $("#xm").text(xm);
    $("#xb").text(xb);
    $("#cyrq").text(cyrq);
    $("#ryzd").text(ryzd);
    $("#cyzd").text(cyzd);
    var yp = @Html.Raw(((int)EnumYzlx.Yp).ToString());
    var wz = @Html.Raw(((int)EnumYzlx.Wz).ToString());
    var sfxm = @Html.Raw(((int)EnumYzlx.sfxm).ToString());
    var cydy = @Html.Raw(((int)EnumYzlx.Cydy).ToString());
    var ssyz = @Html.Raw(((int)EnumYzlx.ssyz).ToString());
    var zyyz = @Html.Raw(((int)EnumYzlx.zcy).ToString());
    var kfyz = @Html.Raw(((int)EnumYzlx.rehab).ToString());
    function search() {
        $("#gridList").jqGrid('setGridParam', {
            postData: { zyh: zyh, type: tclx==""?  $("#yzlxSel").val():tclx, kssj: $("#kssj").val(), jssj: $("#jssj").val(), cqorls: $("#CLSelect").val()  } 
        }).trigger('reloadGrid');
    }
    $("#CLSelect").change(function () {
        $("#gridList").jqGrid('setGridParam', {
            postData: { zyh: zyh, type: tclx==""?  $("#yzlxSel").val():tclx, kssj: $("#kssj").val(), jssj: $("#jssj").val(), cqorls: $("#CLSelect").val() }
        }).trigger('reloadGrid');
    });
    $("#yzlxSel").change(function () {
        alert(tclx);alert( $("#yzlxSel").val());
        $("#gridList").jqGrid('setGridParam', {
            postData: { zyh: zyh, type: tclx==""?  $("#yzlxSel").val():tclx, kssj: $("#kssj").val(), jssj: $("#jssj").val(), cqorls: $("#CLSelect").val() }
        }).trigger('reloadGrid');
    });
    $(function () {
        if(tclx==""){
            $("#yzlxth").css({"display":""});
            $("#yzlxtd").css({"display":""});
        }
        gridList();
    });
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "@Url.Action("GetHistoricalOrders")",
            postData: { zyh: zyh, type: tclx==""?  $("#yzlxSel").val():tclx, kssj: $("#kssj").val(), jssj: $("#jssj").val(), cqorls: $("#CLSelect").val() },
            height: $(window).height() - 70,
            unwritten: false,
            rownumbers: true,
            multiselect: true,
            colModel: [
                { label: 'Id', name: 'Id', hidden: true },
                { label: 'Dài hạn, tạm thời', name: 'yzlb', width: 30, align: 'center' },
                { label: 'Thời gian nhập', name: 'CreateTime', width: 120, align: 'center' },
                { label: 'Mã hạng mục', name: 'xmdm', width: 10, align: 'left', hidden: true },
                { label: 'Tên hạng mục', name: 'xmmc', width: 10, align: 'left', hidden: true },
                { label: 'Nội dung y lệnh', name: 'yznr', width: 240, align: 'left'},
                //{ label: 'Đơn giá', name: 'dj', width: 60, align: 'left' },
                { label: 'Liều lượng', name: 'ypjl', width: 40, align: 'center', hidden: true },
                { label: 'Cách dùng', name: 'yfmcval', width: 60, align: 'center', hidden: true},
                { label: 'Mã cách dùng', name: 'ypyfdm', width: 10, align: 'left', hidden: true },
                { label: 'Liều lượng mỗi lần điều trị', name: 'ypjl', width: 80, align: 'center', hidden: (tclx == sfxm || tclx == kfyz) ? null : true },
                { label: 'pcCode', name: 'pcCode', hidden: true },
                { label: 'Tần suất', name: 'pcmc', width: 60, align: 'center', hidden: true},
                { label: 'Quy cách', name: 'ypgg', width: 100, align: 'center', hidden: (tclx == yp || tclx == cydy || tclx == zyyz) ? null : true },
                { label: 'Tổng số lượng', name: 'sl', width: 40, align: 'center' },
                { label: 'Đơn vị', name: 'dwwwwwww', width: 40, align: 'center' },
                { label: 'Vị trí', name: 'bw', width: 60, align: 'center', hidden: (tclx == sfxm||tclx==kfyz) ? null : true },
    //            {
    //                label: 'Dấu hiệu tự chuẩn bị', name: 'zbbzzzzzzz', width: 50, align: 'center', hidden: tclx == yp ? null : true, formatter: function (val) {
    //                    return val == 1 ? "Có" : "Không";
    //                }
    //            },
    //            { label: 'Dặn dò', name: 'ztnr', width: 90, align: 'left' },
    //            { label: 'Loại y tế', name: 'zfxz', hidden: true },
    //            {
    //                label: 'Loại y tế', name: 'zfxzmc',width: 50,hidden:(tclx==kfyz)? null:true, formatter: function (cellvalue, a, b) {
    //                    return $.enum.getDescByValue("EnumZiFuXingZhi", b.zfxz);
    //                }
    //            },
                  { label: 'Tồn kho', name: 'kcsl', width: 50, hidden: true },
                {
                    label: 'Dấu hiệu kiểm soát', name: 'kzbz', width: 50, hidden: (tclx == yp || tclx == zyyz) ? null : tclx == cydy ? null : true, formatter: function (val) {
                        if (val == "0") {
                            return "正常";
                        } else if (val == "1") {
                            return "禁用"
                        } else if (val == null) {
                            return "";
                        }
                        return val;
                    }
                },
    //            { label: 'jlzhxs', name: 'jlzhxs', hidden: true },
    //            { label: 'zyzhxs', name: 'zyzhxs', hidden: true },
    //            { label: 'qzfs', name: 'qzfs', hidden: true },
    //            { label: 'dwjls', name: 'dwjls', hidden: true }

            ],
            viewrecords: true,
            sortname: 'zh desc',
            loadComplete: function () {
                //var ids = $gridList.getDataIDs();
                //$.each(ids, function () {
                //    var rowid = String(this);
                //    var kcsl = $gridList.jqGrid('getRowData', rowid).kcsl;
                //    var kzbz = $gridList.jqGrid('getRowData', rowid).kzbz;
                //    if ((kcsl != "" && kzbz != "Vô hiệu hóa" && (tclx == yp || tclx == zyyz || tclx == cydy)) || (tclx != yp && tclx != cydy && tclx != zyyz)) {
                //        $gridList.jqGrid('setSelection', rowid); //Cài đặtjqGridChọn
                //    }
                //});
                //$('#cb_gridList').prop('checked', true);//Nút chọn tất cả
            },
            onSelectRow: function (rowid, status) {
                if (status && (tclx == yp || tclx == zyyz)) {
                    var kcsl = $gridList.jqGrid('getRowData', rowid).kcsl;
                    var kzbz = $gridList.jqGrid('getRowData', rowid).kzbz;
                    if (kcsl == "") {
                        $.modalAlert("Thuốc này không có tồn kho, không thể chọn", "warning");
                        $gridList.jqGrid('setSelection', rowid, false); //Cài đặtjqGridChọn
                        return;
                    }
                    if (kzbz == "禁用") {
                        $.modalAlert("Thuốc này đang bị vô hiệu hóa, không thể chọn", "warning");
                        $gridList.jqGrid('setSelection', rowid, false); //Cài đặtjqGridChọn
                        return;
                    }
                }
                //gridztcheck([rowid], status);
            },
            onSelectAll: function (aRowids, status) {
                //gridztcheck(aRowids, status);
            }
        });
    }

    //function gridztcheck(aRowids, status){
    //    CalculateInsPresJYAmount();
    //}

    //Tính số tiền phiếu yêu cầu
    //function CalculateInsPresJYAmount() {
    //    var totalAmount = 0.00;
    //    var allData = $("#gridList").jqGrid('getRowData_AllLine', true, true);
    //    $.each(allData, function () {
    //        totalAmount += parseFloat(this.dj) * parseFloat(this.sl);
    //    });
    //    $("#gridList").jqGrid("setCaption", "Tổng cộng:" + "<label style='color:red;'>￥"
    //        + totalAmount.toFixed(2) + "</label>");   //Đặt lạicaptionGiá trị thuộc tính
    //}

    function submitForm() {
        var data = $("#gridList").jqGrid('getRowData_AllLine', true, true);
        if(!data || data.length==0){
            $.modalAlert("Vui lòng chọn chi tiết để sao chép", 'warning');
            return;
        }
        var yzlistId = "";
        $.each(data, function () {
            for (var i = 0; i < $(this).length; i++) {
                yzlistId = yzlistId + $(this)[i].Id +",";
            }
        });
        return yzlistId;
    }
</script>



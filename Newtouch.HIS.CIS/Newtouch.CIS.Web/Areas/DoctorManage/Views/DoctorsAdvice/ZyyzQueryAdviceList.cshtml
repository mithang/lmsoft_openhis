    ///kiểm trahiện tạibệnh ngườiCóKhôngtồn tạiởchưaPhê duyệtcủaY lệnh dài hạn
    function boolwsh(zyh, callback) {
        $.najax({
            url: "@Url.Action("boolwsh")",
            dataType: "json",
            data: { zyh: zyh },
            async: true,
            type: "POST",
            success: function () {
                callback(false);
            }, error: function () {
                callback(true);
            }
        });
    }

    //InY lệnh dài hạn
    function newtouch_event_f2() {
        var zyh = currentobj.zyh;

        var isSign = "0";
        if (isshowSign && isshowSign === '1') {
            isSign = "1";
        }
        if($('#ck_printgoon').is(':checked'))
        {
            $.modalAlert("Y lệnh dài hạn không hỗ trợ in tiếp, vui lòng không tick chọn in tiếp", "warning");
            //yzContinuePrint(zyh,"2",isSign);
        }
        else{
            top.top.$.Newtouchtab.addTabWithOutMenu({ name: zyh+"-Y lệnh dài hạn", enName: "", url: "/SystemManage/YzPreView/YzPreView?zyh=" + zyh+ "&orgId="+'@curOpr.OrganizeId'+"&isSign="+isSign+"&yzlx="+"Y lệnh dài hạn", AppId: "EMR" });

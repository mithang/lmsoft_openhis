                            type: "POST",
                            success: function () {
                                $.loading(false);
                                $.modalMsg("Tạo mớithành công", 'success');
                                btn_search();
                            }
                        });
                    }
                });*@
                $.modalOpen({
                    id: "BindingFeeForm",
                    title: "Y lệnh phụ",
                    url: "/NurseManage/OrderExecution/BindingFeeForm?zyh=" + currentobj.zyh + "&yzid=" + tt.Id,
                    width: "1000px",
                    height: "700px",
                    btn: ['Xác nhận'],
                    callBack: function (iframeId) {
                        btn_search();
                        //var Obj = top.frames[iframeId].submitForm();
                        $.modalClose("BindingFeeForm");
                    },
                    cancelCallBack: function (iframeId) {
                        btn_search();
                        $.modalClose("BindingFeeForm");
                    }
                });
            }
        }
    });

    function gridPatientList() {
        $('#gridPatientList').dataGrid({
            url:"@Url.Action("AdviceGridView")",
            height: $(window).height() - 220,
            postData: getSearchPostData(),
            unwritten: false,
            pager: '#gridPatPager',
            //sortname: 'zh,yzlb,yzlx,kssj desc',
            //sortname: 'yzlx,kssj desc,zh,Px',
            sortname: 'yzh desc,px,kssj desc,zh',
            rownumbers: true,
            rowNum: 100, //mỗitrangHiển thịghi chépsố
            colModel: [
                { label: 'Y lệnhID', name: 'Id', align: 'center', width: 50, hidden: true },
                {label: 'Loại y lệnh', name: 'yzlb', align: 'center', width: 50},
                {
                    label: 'Y lệnhLoại', name: 'yzlx', align: 'center', width: 50, formatter: function (val) {
                        return $.enum.getDescByValue("EnumYzlx", val)
                    }
                },
                { label: 'Thời gian bắt đầu', name: 'kssj', align: 'center', width: 130, formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Bác sĩ', name: 'ysmc', align: 'center', width: 40 },
                {
                    label: 'Y lệnh phụ', name: 'isfsyz', align: 'center', width: 60, formatter: function (val, option, row) {
                        if (row.isfsyz != null && row.isfsyz != "") {
                            return " <label style='color:red'>(Y lệnh phụ)</label>";
                        }
                        else {
                            return "";
                        }
                    }
                },
                { label: 'Y lệnh', name: 'yzmc', align: 'center', width: 180},
                { label: 'Liều lượng', name: 'yzjl', align: 'center', width: 30 },
                { label: 'Cách dùng', name: 'yfmc', align: 'center', width: 30 },
                { label: 'Tần suất', name: 'yzpcmc', align: 'center', width: 30 },
                {label: 'Cùng nhóm', name: 'zh', align: 'center', width: 30},
                {
                    label: 'DừngThời gian', name: 'tzsj', align: 'center', width: 110, formatter: "date",
                    formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }
                },
                { label: 'DừngBác sĩ', name: 'tzr', align: 'center', width: 50 },
				{ label: 'Người thực hiện', name: 'zxr', align: 'center', width: 50 },
				{ label: 'Khoa thực hiện', name: 'deptName', align: 'center', width: 60 },
                { label: 'yztag', name: 'yztag', align: 'center', hidden: true },
                { label: 'iszt', name: 'iszt', align: 'center', hidden: true },
                { label: 'yfztbs', name: 'yfztbs', align: 'center', hidden: true },
                { label: 'Thuốc gây nghiện - hướng thần', name: 'yztagName', align: 'center', width: 30 },
                { label: 'Số y lệnh', name: 'yzh', align: 'center', width: 60 , hidden: true},
                {
                    label: 'ThuốcTổng lượng', name: 'zycldw', align: 'center', width: 50
                },
                { label: 'Tính phí', name: 'isjf', align: 'center', width: 30,formatter:function(val){
                    return $.enum.getDescByValue("EnumSF", val);
                    }
                 },
                 {
                     label: 'Test da', name: 'ispscs', align: 'center', width: 30, formatter: function (val) {
                         return $.enum.getDescByValue("EnumSF", val);
                     }
                 },
                 { label: 'Chuyển sang tự chi trả', name: 'zzfbz', align: 'center', width: 40,formatter:function(val){
                      return $.enum.getDescByValue("EnumSF", val);
                      }
                 },
                 { label: 'Cuối cùngThực hiệnThời gian', name: 'zxsj', align: 'center', width: 110, formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }  },
                 {
                    label: 'Trạng thái', name: 'yzzt', align: 'center', width: 40, formatter: function (val, options, rowObject) {
                        if (rowObject["yzzt"] ==@Html.Raw(((int)EnumYzzt.DC).ToString())) {//DCTrạng thái
                            //cóThực hiệnThời gian，lấyĐã thực hiệnTrạng thái，cóPhê duyệtThời gian，lấyĐã duyệtTrạng thái
                            if (rowObject["zxsj"] !== typeof (undefined) && rowObject["zxsj"] !== "") {
                              return "Thực hiện";
                            } else {
                                return "Duyệt";
                            }
                        } else if (rowObject["yzzt"] ==@Html.Raw(((int)EnumYzzt.TZ).ToString())) {
                            if (rowObject["yzlb"] == "长") {
                                return "Dừng";
                            } else {
                                return "Hủy bỏ";
                            }
                        }
                        return $.enum.getDescByValue("EnumYzzt", val)
                    }
                 },
                { label: 'Thao tác', name: 'cz', align: 'center', width: 70, title: false , formatter: function (val, option, row) {
                        if (row.isfsyz != null && row.isfsyz != "") {
                            return "<span style='color:red' onclick='DeleteBind(\"" + row.Id + "\",\"" + row.yzlb +"\")' title='Hủy bỏDừng' >Hủy bỏDừng</span>";
                        }
                        else {
                            return "";
                        }
                       }
                 }],

                gridComplete: function () {
                    var ids = $("#gridPatientList").jqGrid('getDataIDs');
                    for (i = 0; i < ids.length; i++) {
                        var rowData = $("#gridPatientList").jqGrid('getRowData', ids[i]);
                        if (rowData.yzzt == "Thực hiện") {
                            $('#gridPatientList tr[id="' + ids[i] + '"]').addClass('orginal');
                        } else
                            if (rowData.yzzt == "Chờ duyệt" || rowData.yzzt == "Duyệt") {
                                $('#gridPatientList tr[id="' + ids[i] + '"]').addClass('ysh');
                            } else
                                if (rowData.yzzt == "Dừng") {
                                    $('#gridPatientList tr[id="' + ids[i] + '"]').addClass('grey');
                                } else if (rowData.yzzt == "Hủy bỏ") {
                                    $('#gridPatientList tr[id="' + ids[i] + '"]').addClass('red');
                                }
                        //Số nhómtạoký tự đặc biệt
                        var returnval = "";
                        if (rowData.zh != typeof (undefined) && rowData.zh !== "" && rowData.zh !== null) {
                            if (last == rowData.zh) {
                                returnval = "Ở giữa";
                                if (i == (ids.length-1)) {//cuối cùng
                                    returnval = "Kết thúc";
                                    last = "";
                                }
                            } else if (last !== rowData.zh) {
                                if (last !== "") {
                                    setlastrowzuhao(ids[i]);
                                }
                                returnval = "Bắt đầu";
                            }
                            $("#gridPatientList").setCell(ids[i], "zh", '<img src="../../../../Content/img/'+ returnval+'.png" />');//setCell Cài đặtkiểu ô đơn Giá trị hoặc thuộc tính
                        } else if (last !== rowData.zh && last!=="") {
                            setlastrowzuhao(ids[i]);
                        }
                        last = rowData.zh;
                    }
                },
                onSelectRow: function (rowid) {
                    var obj = $("#gridPatientList").jqGrid('getRowData', rowid);
                    onSelectyzobj(obj);
                }
         });
    }
    //Cài đặtcái trướcdòngSố nhóm
    function setlastrowzuhao(rowid) {
        var lastrow = parseInt(rowid) - 1;
        $("#gridPatientList").setCell(lastrow, "zh", '<img src="../../../../Content/img/Kết thúc.png" />');//setCell Cài đặtkiểu ô đơn Giá trị hoặc thuộc tính
    }
    function onSelectyzobj(obj) {
        currentyzobj.Id = obj.Id;//Y lệnhid
        currentyzobj.yznr = obj.yznr;//Nội dung y lệnh
        currentyzobj.yztag = obj.yztag;//thuốc gây nghiện hướng thầnY lệnh
    }
    function getSearchPostData() {
        $('#kssj').val($.getDate({ date: currentobj.ryrq }));
        var wsh = false;
        var dryz = false;
        var yzlb = "Dài hạn/Tạm thời";
        if ($('#btn_wsh').hasClass("active")) {//chưaPhê duyệt
            wsh = true;
        } else
            if ($('#btn_dryz').hasClass("active")) {
                dryz = true;
            } else if (($('#btn_cqyz').hasClass("active") && $('#btn_lsyz').hasClass("active"))) {
                var yzlb = "Dài hạn/Tạm thời";
            } else if ($('#btn_cqyz').hasClass("active") && !$('#btn_lsyz').hasClass("active")) {
                var yzlb = "长";
            } else if (!$('#btn_cqyz').hasClass("active") && $('#btn_lsyz').hasClass("active")) {
                var yzlb = "临";
            }
        var yx = $('input[name="optionsRadios"]:checked').val();//var yx = $('#panelposition').val();
        var kssj = $('#kssj').val();
        var jssj = $('#jssj').val();
        var yzlx = $('#yzlx').val();
        return { dryz: dryz, yzlb: yzlb, wsh: wsh, yx: yx, kssj: kssj, jssj: jssj, yzlx: yzlx, zyh: currentobj.zyh };
    }
    function newtouch_event_f6() {
        var zyh = currentobj.zyh;
        top.top.$.Newtouchtab.addTabWithOutMenu({ name: "Phiếu theo dõi 3 chỉ sốTra cứu(Điều dưỡng)", enName: "", url: "/NurseManage/InpatientVitalSigns/TemperatureChartIndex?zyh=" + zyh + "&yshsbz=2" });
    }
    function btn_search() {
        last = "";
        $("#gridPatientList").clearGridData();
        $("#gridPatientList").jqGrid('setGridParam', {
            url: "@Url.Action("AdviceGridView")",
            postData: getSearchPostData()
        }).trigger("reloadGrid");
    }
    $('#yzlx').change(function () {
        btn_search();
    });
    $('#panelposition').click(function () {
        btn_search();
    });


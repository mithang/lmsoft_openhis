<script src="~/Content/js/bootstrap-contextmenu.min.js"></script>
<script>
    var newlist = new Array();
    var last = "";//một cái trướcSố nhóm
    var isshowSign = '@isShowSign';
    //hiện tạiĐã chọnY lệnhđối tượng
    var currentyzobj = {};
    $(function () {
        gridPatientList();
        $('#gridPatientList').clearGridData();
        $('#btnKeywordTypeGourp').on('click', '.btn', function () {
            if ($(this).attr('id') == "btn_dryz" || $(this).attr('id') == "btn_wsh") {
                if (!$(this).hasClass('active')) {
                    $(this).siblings('.btn').removeClass('btn-restore').removeClass('active').addClass('btn-default');
                }
            } else {
                if ($('#btn_dryz').hasClass("active")) {
                    $('#btn_dryz').removeClass('btn-restore').removeClass('active').addClass('btn-default');
                }
                if ($('#btn_wsh').hasClass("active")) {
                    $('#btn_wsh').removeClass('btn-restore').removeClass('active').addClass('btn-default');
                }
            }
            if ($(this).hasClass("active")) {
                $(this).removeClass('btn-restore').removeClass('active').addClass('btn-default');
            } else {
                $(this).removeClass('btn-default').addClass('btn-restore active');
            }
            btn_search();
        });

        $("#yzlx").bindSelect({
            url: "@Url.Action("GetyzlxContain")"
        });
    });

    function BindingFee() {
        var keyValue = $("#gridPatientList").jqGridRowValue().Id;
        if (!!!keyValue) {
            let res = confirm('Chưa chọn mục/thuốc, có tiếp tục không?');
            if (res == true) {
                $.modalOpen({
                    id: "BindingFeeForm",
                    title: "Y lệnh phụ",
                    url: "/NurseManage/OrderExecution/BindingFeeForm?zyh=" + currentobj.zyh + "&yzid=" + "",
                    width: "1000px",
                    height: "700px",
                    btn: ['Xác nhận'],
                    callBack: function (iframeId) {
                        btn_search();
                        //var Obj = top.frames[iframeId].submitForm();
                        $.modalClose("BindingFeeForm");
                    },
                    cancelCallBack: function (iframeId) {
                        btn_search();
                        $.modalClose("BindingFeeForm");
                    }
                });
            }
            return;
        }
        else {
            $.modalOpen({
                id: "BindingFeeForm",
                title: "Y lệnh phụ",
                url: "/NurseManage/OrderExecution/BindingFeeForm?zyh=" + currentobj.zyh + "&yzid=" + keyValue,
                width: "1000px",
                height: "700px",
                btn: ['Xác nhận'],
                callBack: function (iframeId) {
                    btn_search();
                    //var Obj = top.frames[iframeId].submitForm();
                    $.modalClose("BindingFeeForm");
                },
                cancelCallBack: function (iframeId) {
                    btn_search();
                    $.modalClose("BindingFeeForm");
                }
            });
        }
    }
    //XóavàHủy liên kếtY lệnh
    function DeleteBind(Id,yzlb) {
        let res = confirm('Có hủy bỏ/dừng y lệnh này không?');
        if (res == true) {
            var yzxz = "2";
            if (yzlb=="临") {
                yzxz = "1";
            }
            $.ajax({
                url: "/NurseManage/OrderExecution/DeleteBind",
                data: { zyh: currentobj.zyh, yzid: Id, yzxz: yzxz },
                dataType: "json",
                type: "POST",
                async: false,
                success: function (data) {
                    if (data != null && data.message != "") {
                        $.modalAlert("Hủy bỏ/Dừngthất bại!" + data.message, 'warning');
                        return;
                    }
                    else {
                        $.modalAlert("Hủy bỏ/Dừngthành công!", 'success');
                        btn_search();
                        return;
                    }
                }
            });
        }
    }
    $('#gridPatientList').contextmenu({
        target: '#context-menu',
        before: function (e, context) {
            $('#gridPatientList').data("contextmenu-rowId", $(e.target).closest('tr').attr('id'));
        },
        onItem: function (context, e) {
            var menuName = $(e.target).text();
            var tt = $('#gridPatientList').jqGrid('getRowData', $('#gridPatientList').data('contextmenu-rowId'));
            if (menuName == "Y lệnh phụ") {
                //if(tt.yzzt!="Dừng")
                //{
                //    $.modalAlert("khôngDừngTrạng tháicủaY lệnhkhôngcó thểTạo mới", "warning");
                //    return;

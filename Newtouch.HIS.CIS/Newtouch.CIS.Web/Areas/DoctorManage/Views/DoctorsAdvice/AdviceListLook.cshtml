@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "AdviceListLook";
    Layout = null;
    //Phiếu in y lệnh dài hạn có hiển thị chữ ký không
    var isShowSign = SysConfigReader.String("IS_ShowSigner");
    //Thời gian
    var kssj = ViewData["kssj"];
    var curOpr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}
<style>
    /*Đã thực hiện*/
    .orginal {
        color: brown;
    }
    /*Đã duyệt*/
    .ysh {
        background-color: white;
        color: black;
    }
    /*Đã dừng*/
    .grey {
        color: grey;
    }
    /*Đã hủy bỏ*/
    .red {
        color: red;
    }
    /*DC*/
    .pink {
        color: pink;
    }

    .toolbar {
        width: 45% !important;
        margin: 10px 30px 12px;
    }
</style>
<div id="linkyzcx" role="tabpanel" class="tab-pane">
    <div class="topPanel" style="width: 99%; margin-top: -15px; border-radius: 5px;height:unset !important">
        <table class="form" style="margin-left:5px;">
            <tr>
                <td colspan="3" id="btnKeywordTypeGourp">
                    <input type="button" id="btn_cqyz" class="panelposition btn btn-default btn-md" value="Y lệnh dài hạn">
                    <input type="button" id="btn_lsyz" class="panelposition btn btn-default btn-md" value="Y lệnh tạm thời">
                </td>
                <td class="formTitle">
                    Loại y lệnh:
                </td>
                <td class="formValue formDdlSelectorTd">
                    <select id="yzlx" class="form-control required"></select>
                </td>
                <td class="formValue" style="width:15%;margin-left:10px">
                    <div id="panelposition" style="margin-left:30px">
                        <label><input type="radio" name="optionsRadios" class="optionsRadios formClearIgnore" checked value="qb" />Tất cả y lệnh</label>
                        <label><input type="radio" id="radioTreating" name="optionsRadios" class="optionsRadios formClearIgnore" value="yx" />Y lệnh có hiệu lực</label>
                    </div>
                </td>
                <th class="formTitle">Ngày bắt đầu:</th>
                <td class="formValue">
                    <input id="kssj" type="text" class="form-control input-wdatepicker formClearIgnore" onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd', onpicked: function () { btn_search() } })" value="@kssj" />
                </td>
                <th class="formTitle">Ngày kết thúc:</th>
                <td class="formValue">
                    <input id="jssj" type="text" class="form-control input-wdatepicker formClearIgnore" onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd', onpicked: function () { btn_search() }  })" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </td>
                <td class="formTitle">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary" value="Tra cứu" onclick="btn_search()" style="margin-right:10px" />
                </td>
            </tr>
        </table>
    </div>
    <div class="contentPanel" style="width: 99%; margin-top: 2px;">
        <div style="background-color: #fff;width:100%;">
            <table id="gridPatientList"></table>
            <div id="gridPatPager"></div>
        </div>
    </div>
    <table style="width:420px;height:20px; margin-top:10px;margin-left:10px; float:left; color:#274b6d">
        <tr>
            <td>
                <label style="height:7px;width:25px;background-color:brown; border:1px solid #ddd"></label>
            </td>
            <td>Thực hiện dài hạn/Tạm thời</td>
            <td>
                <label style="height:7px;width:25px;background-color:red; border:1px solid #ddd"></label>
            </td>
            <td>Hủy tạm thời</td>
            <td>
                <label style="height:7px;width:25px;background-color:grey; border:1px solid #ddd"></label>
            </td>
            <td>Dừng dài hạn</td>
            <td>
                <label style="height:7px;width:25px;background-color:black;  border:1px solid #ddd"></label>
            </td>
            <td>Chưa thực hiện dài hạn/Tạm thời</td>
        </tr>
    </table>
    @Html.Partial("~/Areas/DoctorManage/Views/Apply/ReportTree.cshtml")
    @*<div id="printgoon" class="ckbox" style="float:right;padding-right:5px;margin-top:10px;margin-left:10px;">
            <div>
                <input id="ck_printgoon" name="ck_printgoon" type="checkbox"><label for="ck_printgoon">In tiếp</label>
            </div>
        </div>*@
    @Html.Partial("_BottomButtonsYzPrintView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 2, 3 },
    F2Text = "打印长期",
    F3Text = "打印临时",
    F5Text = "刷新"
});
</div>

<script>
    var newlist = new Array();
    var last = "";//Số nhóm trước
    var isshowSign = '@isShowSign';
    $(function () {
        gridPatientList();
        $('#gridPatientList').clearGridData();
        $('#btnKeywordTypeGourp').on('click', '.btn', function () {
            if ($(this).attr('id') == "btn_dryz" || $(this).attr('id') == "btn_wsh") {
                if (!$(this).hasClass('active')) {
                    $(this).siblings('.btn').removeClass('btn-restore').removeClass('active').addClass('btn-default');
                }
            } else {
                if ($('#btn_dryz').hasClass("active")) {
                    $('#btn_dryz').removeClass('btn-restore').removeClass('active').addClass('btn-default');
                }
                if ($('#btn_wsh').hasClass("active")) {
                    $('#btn_wsh').removeClass('btn-restore').removeClass('active').addClass('btn-default');
                }
            }
            if ($(this).hasClass("active")) {
                $(this).removeClass('btn-restore').removeClass('active').addClass('btn-default');
            } else {
                $(this).removeClass('btn-default').addClass('btn-restore active');
            }
            btn_search();
        });

        $("#yzlx").bindSelect({
            url: "@Url.Action("GetyzlxContain")",
        });
    });

    function gridPatientList() {
        $('#gridPatientList').dataGrid({
            url:"@Url.Action("AdviceGridView")",
            height: $(window).height() - 220,
            postData: getSearchPostData(),
            unwritten: false,
            pager: '#gridPatPager',
            //sortname: 'zh,yzlb,yzlx,kssj desc',
            sortname: 'yzh desc,px,kssj desc,zh',
            rowNum: 100,
            rownumbers: true,
            colModel: [
                { label: 'Y lệnhID', name: 'Id', align: 'center',  hidden: true },
                {label: 'Loại y lệnh', name: 'yzlb', align: 'center', width: 50},
                {
                    label: 'Loại y lệnh', name: 'yzlx', align: 'center', width: 50, formatter: function (val) {
                        return $.enum.getDescByValue("EnumYzlx", val);
                    }
                },
                { label: 'Thời gian bắt đầu', name: 'kssj', align: 'center', width: 109, formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Bác sĩ', name: 'ysmc', align: 'center', width: 40 },
                { label: 'Y lệnh', name: 'yzmc', align: 'center', width: 240},
                {label: 'Cùng nhóm', name: 'zh', align: 'center', width: 30},
                {
                    label: 'Thời gian dừng', name: 'tzsj', align: 'center', width: 110, formatter: "date",
                    formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }
                },
                { label: 'Bác sĩ dừng', name: 'tzr', align: 'center', width: 50 },
				{ label: 'Người thực hiện', name: 'zxr', align: 'center', width: 50 },
				{ label: 'Khoa thực hiện', name: 'deptName', align: 'center', width: 60 },
                { label: 'yztag', name: 'yztag', align: 'center', hidden: true },
                { label: 'Thuốc gây nghiện, thuốc hướng thần', name: 'yztagName', align: 'center', width: 30 },
                { label: 'Số y lệnh', name: 'yzh', align: 'center', width: 60 , hidden: true},
                {
                    label: 'Tổng số lượng thuốc', name: 'zycldw', align: 'center', width: 30
                },
                { label: 'Tính phí', name: 'isjf', align: 'center', width: 30,formatter:function(val){
                    return $.enum.getDescByValue("EnumSF", val);
                } },
                {
                    label: 'Test da', name: 'ispscs', align: 'center', width: 30, formatter: function (val) {
                        return $.enum.getDescByValue("EnumSF", val);
                    }
                },
                { label: 'Chuyển sang tự trả', name: 'zzfbz', align: 'center', width: 30,formatter:function(val){
                    return $.enum.getDescByValue("EnumSF", val);
					}
				},
                { label: 'Cuối cùng<br/>Thời gian thực hiện', name: 'zxsj', align: 'center', width: 70, formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }  },
    ],

            gridComplete: function () {
                var ids = $("#gridPatientList").jqGrid('getDataIDs');
                for (i = 0; i < ids.length; i++) {
                    var rowData = $("#gridPatientList").jqGrid('getRowData', ids[i]);
                    if (rowData.yzzt == "执行") {
                        $('#gridPatientList tr[id="' + ids[i] + '"]').addClass('orginal');
                    } else
                        if (rowData.yzzt == "待审" || rowData.yzzt == "审核") {
                            $('#gridPatientList tr[id="' + ids[i] + '"]').addClass('ysh');
                        } else
                            if (rowData.yzzt == "停止") {
                                $('#gridPatientList tr[id="' + ids[i] + '"]').addClass('grey');
                            } else if (rowData.yzzt == "作废") {
                                $('#gridPatientList tr[id="' + ids[i] + '"]').addClass('red');
                            }
                    //Số nhóm sinh ra ký tự đặc biệt
                    var returnval = "";
                    if (rowData.zh != typeof (undefined) && rowData.zh !== "" && rowData.zh !== null) {
                        if (last == rowData.zh) {
                            returnval = "中间";
                            if (i == (ids.length - 1)) {//Cuối cùng
                                returnval = "结束";
                                last = "";
                            }
                        } else if (last !== rowData.zh) {
                            if (last !== "") {
                                setlastrowzuhao(ids[i]);
                            }
                            returnval = "开始";
                        }
                        $("#gridPatientList").setCell(ids[i], "zh", '<img src="../../../../Content/img/' + returnval + '.png" />');//setCell Đặt kiểu ô Giá trị hoặc thuộc tính
                    } else if (last !== rowData.zh && last !== "") {
                        setlastrowzuhao(ids[i]);
                    }
                    last = rowData.zh;
                }
            },
            //onSortCol: function (index, iCol, sortorder) {
            //    debugger;
            //    if (index=="cz") {
            //        $("#gridPatientList").setColProp(iCol, { sortable: false });
            //    }
            //}
    });
    }
    //Đặt số nhóm của dòng trên
    function setlastrowzuhao(rowid) {
        var lastrow = parseInt(rowid) - 1;
        $("#gridPatientList").setCell(lastrow, "zh", '<img src="../../../../Content/img/Kết thúc.png" />');//setCell Đặt kiểu ô Giá trị hoặc thuộc tính
    }

    function getSearchPostData() {
        if (currentobj == null || currentobj==undefined) return null;
        var wsh = false;
        var dryz = false;
        var yzlb = "长临";
        if ($('#btn_wsh').hasClass("active")) {//Chưa duyệt
            wsh = true;
        } else
            if ($('#btn_dryz').hasClass("active")) {
                dryz = true;
            } else if (($('#btn_cqyz').hasClass("active") && $('#btn_lsyz').hasClass("active"))) {
                var yzlb = "长临";
            } else if ($('#btn_cqyz').hasClass("active") && !$('#btn_lsyz').hasClass("active")) {
                var yzlb = "长";
            } else if (!$('#btn_cqyz').hasClass("active") && $('#btn_lsyz').hasClass("active")) {
                var yzlb = "临";
            }
        var yx = $('input[name="optionsRadios"]:checked').val();//$('#optionsRadios').val();
        var kssj = $('#kssj').val();
        var jssj = $('#jssj').val();
        var yzlx = $('#yzlx').val();
        return {dryz: dryz, yzlb: yzlb, wsh: wsh, yx: yx, kssj: kssj, jssj: jssj, yzlx: yzlx, zyh: currentobj.zyh };
    }

    function btn_search() {
        last = "";
        $("#gridPatientList").clearGridData();
        $("#gridPatientList").jqGrid('setGridParam', {
            url: "@Url.Action("AdviceGridView")",
            postData: getSearchPostData()
        }).trigger("reloadGrid");
    }
    $('#yzlx').change(function () {
        btn_search();
    });
    $('#panelposition').click(function () {
        btn_search();
    });


    //Y lệnh dừng
    function advicestop(selRowId) {
        var yzId = $("#gridPatientList").jqGrid('getRowData', selRowId).Id;
        var yznr = $("#gridPatientList").jqGrid('getRowData', selRowId).yznr;
        var kssj = $("#gridPatientList").jqGrid('getRowData', selRowId).kssj;
        var tzsj = $.trim($("#gridPatientList").jqGrid('getRowData', selRowId).tzsj);
        var tznr = "无停止时间";
        if (tzsj !== typeof (undefined) && tzsj !== "") {
            var date1 = new Date(kssj)
            var date2 = new Date(tzsj)

            var s1 = date1.getTime(), s2 = date2.getTime();

            var total = (s2 - s1) / 1000;
            tznr = parseInt(total / (24 * 60 * 60)) + "天";//Tính số ngày nguyên
        }
        $.modalOpen({
            id: "Form",
            title: "Y lệnh dừng",
            url: "/DoctorManage/DoctorsAdvice/AdviceStop?yzId=" + yzId + "&yznr=" + yznr + "&kssj=" + kssj + "&tznr=" + tznr,
            width: "550px",
            height: "370px",
            callBack: function (iframeId) {
                var obj = top.frames[iframeId].submitForm(function () {
                    $.loading(false);
                    $.modalMsg("Thao tác thành công", 'success');
                    $.modalClose("Form");
                    btn_search();
                });

            }
        });
    }

    //Xóa
    function advicedel(yzid) {
        $.modalConfirm("Bạn có chắc muốn xóa không?",
            function (flag) {
                if (flag) {
                    $.najax({
                        url: "@Url.Action("DelForm")",
                        dataType: "json",
                        data: { yzId: yzid},
                        type: "POST",
                        success: function () {
                            $.loading(false);
                            $.modalMsg("Xóa thành công", 'success');
                            btn_search();
                        }
                    });
                }
            });
    }

    //Hủy bỏ
    function adviceinvalid(yzId, yzzt,yzlx) {
        window.zfgoon = function () {
            $.modalConfirm("【Lưu ý】Sau khi y lệnh bị hủy, vui lòng liên hệ y tá kịp thời để xử lý thuốc đã gửi! Y lệnh này đã phát thuốc hoặc đã gửi, có xác nhận hủy không",
                       function (flag2) {
                           if (flag2) {
                               var data = { yzId: yzId };
                               $.najax({
                                   url: "@Url.Action("StopSubmitForm")",
                                   dataType: "json",
                                   data: data,
                                   type: "POST",
                                   success: function () {
                                       $.loading(false);
                                       $.modalMsg("Thao tác thành công", 'success');
                                       btn_search();
                                   }
                               });
                           } else {
                               return;
                           }
                       });
        };
        $.modalConfirm("Có cần hủy bỏ không?",
            function (flag) {
                if (flag) {
                    if (yzzt == @Html.Raw((int)EnumYzzt.Zx).ToString()&& ((yzlx==@Html.Raw((int)EnumYzlx.Cydy))||(yzlx==@Html.Raw((int)EnumYzlx.Yp)))) {
                        setTimeout('zfgoon()', 100);
                    } else {
                        var data = { yzId: yzId };
                        $.najax({
                            url: "@Url.Action("StopSubmitForm")",
                            dataType: "json",
                            data: data,
                            type: "POST",
                            success: function () {
                                $.loading(false);
                                $.modalMsg("Thao tác thành công", 'success');
                                btn_search();
                            }
                        });
                    }
                } else {
                    return;
                }
            });
    }
    //Sửa
    function advicemodify(yzId, yzlx, yzlb) {
        if (currentobj == typeof (undefined) || currentobj.zyh == typeof (undefined)) {
            $.modalAlert("Thiếu bệnh nhân");
            return;
        }
        //1.Kiểm tra trước loại y lệnh hiện tại
        if (yzlx == typeof (undefined) || yzlx == "") {
            $.modalAlert("Thiếu loại y lệnh");
            return;
        }
        //2.Vào trang tương ứng để sửa y lệnh
        switch (parseInt(yzlx)) {
            case @Html.Raw(((int)EnumYzlx.Yp).ToString())://Thuốc
                $('#myTab [href="#linkyplr"').trigger('click'); //Khởi tạo hiển thị mục nàotab
                EditMInit(currentobj.zyh, yzId, yzlb);
                break;
            case @Html.Raw(((int)EnumYzlx.Wz).ToString())://Văn bản
                $('#myTab [href="#linkwzlr"').trigger('click'); //Khởi tạo hiển thị mục nàotab
                EditWInit(currentobj.zyh, yzId, yzlb);
                break;
            case @Html.Raw(((int)EnumYzlx.sfxm).ToString())://Hạng mục
                $('#myTab [href="#linkxmlr"').trigger('click'); //Khởi tạo hiển thị mục nàotab
                EditIInit(currentobj.zyh, yzId, yzlb);
                break;
            case @Html.Raw(((int)EnumYzlx.rehab).ToString())://Hạng mục
            	$('#myTab [href="#linkkfyz"').trigger('click'); //Khởi tạo hiển thị mục nàotab
	            EditRInit(currentobj.zyh, yzId, yzlb);
	            break;
            case @Html.Raw(((int)EnumYzlx.Cydy).ToString())://Thuốc mang về khi xuất viện
                $('#myTab [href="#linkcydy"').trigger('click'); //Khởi tạo hiển thị mục nàotab
                EditTInit(currentobj.zyh, yzId, yzlb);
                break;
                @*case @Html.Raw(((int)EnumYzlx.Ty).ToString())://Chung
                //$('#myTab [href="#linkyplr"').trigger('click'); //Khởi tạo hiển thị mục nàotab
                //EditInit(zyh, yzId, yzlb);
                break;*@
            case @Html.Raw(((int)EnumYzlx.jy).ToString())://Xét nghiệm
                $('#myTab [href="#linkjy"').trigger('click'); //Khởi tạo hiển thị mục nàotab
                EditJYInit(currentobj.zyh, yzId, yzlb);
                break;
            case @Html.Raw(((int)EnumYzlx.jc).ToString())://Kiểm tra
                $('#myTab [href="#linkjc"').trigger('click'); //Khởi tạo hiển thị mục nàotab
                EditJCInit(currentobj.zyh, yzId, yzlb);
                break;
            case @Html.Raw(((int)EnumYzlx.ssyz).ToString())://Y lệnh ăn uống
                $('#myTab [href="#linkssyz"').trigger('click'); //Khởi tạo hiển thị mục nàotab
                EditSSInit(currentobj.zyh, yzId, yzlb);
                break;
            case @Html.Raw(((int)EnumYzlx.oper).ToString())://Y lệnh phẫu thuật
                $('#myTab [href="#linkxmlr"').trigger('click'); //Khởi tạo hiển thị mục nàotab
                EditIInit(currentobj.zyh, yzId, yzlb);
                break;
            case @Html.Raw(((int)EnumYzlx.zcy).ToString())://Thảo dược
                $('#myTab [href="#linkzylr"').trigger('click'); //Khởi tạo hiển thị mục nàotab
                EditTCMInit(currentobj.zyh, yzId, yzlb);
                break;
        }
    }
    //HủyDC
    function advicedc(yzId) {
        $.najax({
            url: "@Url.Action("advicedc")",
            dataType: "json",
            data: { yzId: yzId},
            type: "POST",
            success: function () {
                $.loading(false);
                $.modalMsg("Thao tác thành công", 'success');
                btn_search();
            }
        });
    }

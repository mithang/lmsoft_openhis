    function advicemodify(yzId, yzlx, yzlb) {
        //Phê duyệtphiếucứSửathứmộtloạiứngdùngCảnh
        if ("@isopenPriorReview" == "ON" && currentobj.brxzdm != "0") {
            var GetMAC = "";
            $.ajax({
                type: "Get",
                url: "http://127.0.0.1:33333/api/YiBao/GetMAC",
                dataType: "json",
                async: false,
                success: function (data) {
                    GetMAC = data.Data;
                },

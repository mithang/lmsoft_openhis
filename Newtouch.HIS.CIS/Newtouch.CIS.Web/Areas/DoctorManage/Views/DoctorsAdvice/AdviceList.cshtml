                break;
            case @Html.Raw(((int)EnumYzlx.rehab).ToString())://Phục hồi chức năng
            	$('#myTab [href="#linkkfyz"').trigger('click'); //Khởi tạoHiển thịnàotab
	            EditRInit(currentobj.zyh, yzId, yzlb);
	            break;
            case @Html.Raw(((int)EnumYzlx.Cydy).ToString())://Xuất việnmang thuốc
                $('#myTab [href="#linkcydy"').trigger('click'); //Khởi tạoHiển thịnàotab
                EditTInit(currentobj.zyh, yzId, yzlb);
                break;
                @*case @Html.Raw(((int)EnumYzlx.Ty).ToString())://Chung
                //$('#myTab [href="#linkyplr"').trigger('click'); //Khởi tạoHiển thịnàotab
                //EditInit(zyh, yzId, yzlb);
                break;*@
            case @Html.Raw(((int)EnumYzlx.jy).ToString())://Xét nghiệm
                $('#myTab [href="#linkjy"').trigger('click'); //Khởi tạoHiển thịnàotab

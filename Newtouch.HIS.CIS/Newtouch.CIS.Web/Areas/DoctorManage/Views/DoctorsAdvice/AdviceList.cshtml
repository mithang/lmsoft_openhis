    function HlyyDrugInfo(Data) {
        $("#HlyydrugGrid").clearGridData();  // Xóa trắngDữ liệu
        var $HlyydrugGrid = $("#HlyydrugGrid");
        // địnhnghĩabảngôcộtmẫuloại
        var drugColModel = [
            { label: 'Số nhóm', name: 'GroupNo', align: 'center', width: 100 },
            { label: 'Tên thuốc', name: 'DrugName', align: 'center', width: 150,
                formatter: function (cellValue, options, rowObject) {
                    // tạoTên thuốccủavượtchuỗinhận，điểmnhấpkhitruyềnvàodrugId
                    return '<a href="javascript:void(0);" onclick="getYpsms(\'' + rowObject.DrugId + '\')">' + cellValue + '</a>';
                }},
            { label: 'Đường dùng thuốc', name: 'AdminRoute', align: 'center', width: 100 },
            { label: 'Tần suất dùng thuốc', name: 'AdminFrequency', align: 'center', width: 100 },
            { label: 'LỗiThông tin', name: 'MessageText', align: 'center', width: 250 },
            { label: 'Đề xuất', name: 'Advice', align: 'center', width: 200 },
            { label: 'Nguồn', name: 'Source', align: 'center', width: 100 },
            { label: 'LỗiLoại', name: 'Type', align: 'center', width: 100 }
        ];
        const cfStateMap = {
            "1": "Đang duyệt",
            "0": "Đã duyệt",
            "2": "Không thông qua"
        };
        const auditStatus = cfStateMap[Data.Cfstate] || "Không rõTrạng thái";
        let statusColor;
        let fontSize = "16px";  // Mặc địnhchữthểlớnnhỏ
        switch (Data.Cfstate) {
            case "1": // Phê duyệttrong
                statusColor = "orange";  //
                break;
            case "0": // Đã duyệt
                statusColor = "green";
                break;
            case "2": //khôngthông qua
                statusColor = "red";
                break;
            default:
                statusColor = "gray";  // Không xác địnhTrạng thái
                break;
        }
        $("#hlyyauditStatus").html("DuyệtTrạng thái: <span style='color: " + statusColor + "; font-size: " + fontSize + ";'>" + auditStatus + "</span>");
        // tạovàđiềnThuốcChi tiếtbảngô
        $HlyydrugGrid.newtouchLocalDataGrid({
            unwritten: false,
            caption: "ThuốcThông tinChi tiết",
            colModel: drugColModel,
            shrinkToFit: true,
        }, Data.Message.Infos.InfoList.length > 0 ?Data.Message.Infos.InfoList : [{/* Empty row to show column headers */ }]);

    }
    function getYpsms(drugId) {
        // ởđâyThực hiệnđiểmnhấpsự kiệncủalogictập
        $.najax({
            url: "/MedicalRecord/GetypSms",
            data: {drugId: drugId},
            type: "POST",
            success: function (data) {
                if(data.state && data.state === 'success' && !(data.data === false)){
                    $.modalAlert(data.data, 'success')
                }
                else{
                    $.modalAlert("Gửithất bại", 'error');
                }
            }
        });

    }

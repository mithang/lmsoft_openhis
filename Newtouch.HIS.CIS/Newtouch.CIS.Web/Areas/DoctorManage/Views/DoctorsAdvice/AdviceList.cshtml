                            return "Thực hiện";
                        } else {
                            return "Duyệt";
                        }
                    } else if (rowObject["yzzt"] ==@Html.Raw(((int)EnumYzzt.TZ).ToString())) {
                        if (rowObject["yzlb"] == "长") {
                            return "Dừng";
                        } else {
                            return "Hủy bỏ";
                        }
                    }
                        return $.enum.getDescByValue("EnumYzzt", val);
                    }
    },
    {
        label: 'Thao tác', name: 'cz', sortable: false, align: 'center', width: 70, title: false,
        formatter: function (val, options, rowObject) {
			if (rowObject["yzzt"] ==@Html.Raw(((int)EnumYzzt.Zx).ToString())|| rowObject["yzzt"] ==@Html.Raw(((int)EnumYzzt.Sh).ToString())) {//Đã thực hiệnhoặcPhê duyệtcủaY lệnh
                if (rowObject["yzlb"] == "长") {
                return "<span style='color:red' onclick='advicestop(\"" + options.rowId + "\")'' title='Dừng' >Dừng</span>"
            } else if (rowObject["yzlb"] == "临") {
                return "<span style='color:red' onclick='adviceinvalid(\"" + rowObject["Id"] + "\",\"" + rowObject["yzzt"] + "\",\"" + rowObject["yzlx"] + "\",\"" + rowObject["iszt"] + "\")'' title='Hủy bỏ' >Hủy bỏ</span>"
            }
        }
    else if (rowObject["yzzt"] ==@Html.Raw(((int)EnumYzzt.Ds).ToString())) {//chưaPhê duyệtcủaY lệnhcó thểSửaXóa
        if (rowObject["iszt"]=="Y") {
        @*if (rowObject["yzlx"]==@Html.Raw(((int)EnumYzlx.jc).ToString())||rowObject["yzlx"]==@Html.Raw(((int)EnumYzlx.jy).ToString())) {*@
            return "<span style='color:red' onclick='advicedel(\"" + rowObject["Id"] + "\",\""+rowObject["yzlx"]+"\",\""+rowObject["iszt"]+"\")'' title='Xóa' >Xóa</span>";
        }
                var result = "<span style='color:blue' onclick='advicemodify(\"" + rowObject["Id"] + "\",\"" + rowObject["yzlx"] + "\",\"" + rowObject["yzlb"] + "\")' title='Sửa'>Sửa</span> | " +
                    "<span style='color:red' onclick='advicedel(\"" + rowObject["Id"] + "\")' title='Xóa'>Xóa</span>";

                return result;

            } else if (rowObject["yzzt"] ==@Html.Raw(((int)EnumYzzt.DC).ToString())) {//Hủy DC
                return "<span style='color:red' onclick='advicedc(\"" +
                    rowObject["Id"] +
                    "\",\""+rowObject["yzlx"]+"\",\""+rowObject["iszt"]+"\")'' title='Hủy DC' >Hủy DC</span>";
            } else if (rowObject["yzzt"] ==@Html.Raw(((int)EnumYzzt.TZ).ToString())) {//Dừng/Hủy bỏ
                return "";
            } else {
                return val;
            }
        }
    }],

            gridComplete: function () {
                var ids = $("#gridPatientList").jqGrid('getDataIDs');
                for (i = 0; i < ids.length; i++) {
                    var rowData = $("#gridPatientList").jqGrid('getRowData', ids[i]);
                    if (rowData.yzzt == "Thực hiện") {
                        $('#gridPatientList tr[id="' + ids[i] + '"]').addClass('orginal');
                    } else
                        if (rowData.yzzt == "Chờ duyệt" || rowData.yzzt == "Duyệt") {
                            $('#gridPatientList tr[id="' + ids[i] + '"]').addClass('ysh');
                        } else
                            if (rowData.yzzt == "Dừng") {
                                $('#gridPatientList tr[id="' + ids[i] + '"]').addClass('grey');
                            } else if (rowData.yzzt == "Hủy bỏ") {
                                $('#gridPatientList tr[id="' + ids[i] + '"]').addClass('red');
                            }
                    //Số nhómtạoký tự đặc biệt
                    var returnval = "";
                    if (rowData.zh != typeof (undefined) && rowData.zh !== "" && rowData.zh !== null) {
                        if (last == rowData.zh) {
                            returnval = "Ở giữa";
                            if (i == (ids.length - 1)) {//cuối cùng
                                returnval = "Kết thúc";
                                last = "";
                            }
                        } else if (last !== rowData.zh) {
                            if (last !== "") {
                                setlastrowzuhao(ids[i]);
                            }
                            returnval = "Bắt đầu";
                        }
                        $("#gridPatientList").setCell(ids[i], "zh", '<img src="../../../../Content/img/' + returnval + '.png" />');//setCell Cài đặtkiểu ô đơn Giá trị hoặc thuộc tính
                    } else if (last !== rowData.zh && last !== "") {
                        setlastrowzuhao(ids[i]);
                    }
                    last = rowData.zh;
                }
            },
            onSelectRow: function (rowid) {
                var obj = $("#gridPatientList").jqGrid('getRowData', rowid);
                onSelectyzobj(obj);
            }
            //onSortCol: function (index, iCol, sortorder) {
            //    debugger;
            //    if (index=="cz") {
            //        $("#gridPatientList").setColProp(iCol, { sortable: false });
            //    }
            //}
    });

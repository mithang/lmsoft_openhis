        function YZZDCorrespond() {
                $.modalOpen({
                    id: "OrderDiagnosisForm",
                    title: "Chẩn đoán y lệnh",
                    url: "/DoctorManage/Medicine/OrderDiagnosisForm?zyh=zy&brxz=",
                    width: "500px",
                    height: "330px",
                    callBack: function (iframeId) {
                        var obj = top.frames[iframeId].Orderdiagnosis();
                        var zdObj = {};
                        if (obj != typeof (undefined)) {
                            zdObj.zdsj = obj.zdsj;
                            zdObj.jbbm = obj.jbbm;
                            zdObj.jbmc = obj.jbmc;
                        }
                        $.modalClose("OrderDiagnosisForm");
                        $("#zdmc").text("Chẩn đoán y lệnh:" + zdObj.jbmc);
                        $("#pdyzzd").val(zdObj.jbbm);
                        $("#pdyzzdmc").val(zdObj.jbmc);
                        $("#pdyzzdsj").val(zdObj.zdsj);
                    }
            });
    }
    function EnableTCMInlineEditBox() {
        var ids = $("#gridTCMmedicine").getDataIDs();
        $.each(ids, function () {
            var rowid = String(this);
            //Mở chế độ chỉnh sửa
            $("#gridTCMmedicine").jqGrid('editRow', this, false, initTCMInlineFunc);

            //Điền đơn vị cho liều lượng mỗi lầnoption
            var jldw = $("#" + rowid + "_redundant_jldw").val();    //Đơn vị liều lượng Đơn vị của bảng từ điển thuốc
            var dw = $("#" + rowid + "_dwwwwwww").val();     //Đơn vị nhập viện
            if (!!dw) {
                //Cách tìm phần tử này không nên dùng, nhưng vìselectKhông cóidThuộc tính
                $("#" + rowid + "_ypjl").parent().next().children('select').html('');

                if (jldw === dw) {
                    $("#" + rowid + "_ypjl").parent().next().children('select').append('<option value="1">' + jldw + '</option>');
                }
                else {
                    var dwlb = $("#" + rowid + "_dwlb").val(); //Khi tồn tại loại đơn vị, nghĩa là đã tồn tại đơn vị đã chọn, trang sẽ chọn
                    var jldwlb = 1, dwdwlb = 4;
                    if (!!dwlb) {
                        if (jldwlb == dwlb) {
                            jldwlb = 4, dwdwlb = 1;
                        }
                    }
                    if (!!jldw) {
                        $("#" + rowid + "_ypjl").parent().next().children('select').append('<option value="' + jldwlb + '">' + jldw + '</option>');
                    }
                    if (!!dw) {
                        $("#" + rowid + "_ypjl").parent().next().children('select').append('<option value="' + dwdwlb + '">' + dw + '</option>');
                    }
                    $("#" + rowid + "_ypjl").parent().next().children('select').val(dwlb);
                }
            }
            //Đánh dấu màu đơn thuốc
            var zh = $('#' + $($("#gridTCMmedicine").getRowData(rowid).zh).attr('id')).val();
            if (zh !== "") {
                var cfColor = getZhColor(zh);
                $('#gridTCMmedicine tr[id="' + String(this) + '"]').css('border-left-color', cfColor);
                $('#gridTCMmedicine tr[id="' + String(this) + '"]').css('border-left-style', 'solid');
                $('#gridTCMmedicine tr[id="' + String(this) + '"]').css('border-left-width', '5px');
            }

            $("#" + rowid + "_kssj").css("text-align", "left");
        });
    }

    //Thêm chi tiết
    function addTCMRowData(selRowId) {
        var zh = $('#' + $($("#gridTCMmedicine").getRowData(selRowId).zh).attr('id')).val();
        if (zh.replace(/(^\s*)|(\s*$)/g, "") == "") {
            $.modalAlert("Số nhóm trống, vui lòng xác nhận.", 'warning');
            return;
        }
        if (isNaN(zh)) {
            $.modalAlert("Số nhóm: vui lòng nhập số", 'warning');
            return;
        }

        var selRowData = $("#gridTCMmedicine").getRowData(selRowId);
        //2 Thêm một dòng mới
        var dataRow = {
            Id: selRowData.Id,
            zh: zh,
            zyh: currentobj.zyh,
            yzlx: @Html.Raw(((int)EnumYzlx.zcy).ToString()),
            yzzt:@Html.Raw(((int)EnumYzzt.Ds).ToString()),//Mặc định chưa duyệt
            yfmcval: $("#" + selRowId + "_pcCode").parent().next().children('select').find("option:selected").text(),
            ypyfdm: $("#" + selRowId + "_ypyfdm").val(),
            pcmc: $("#" + selRowId + "_pcmc").val(),
            pcCode: $("#" + selRowId + "_pcCode").val(),
            zxcs: $("#" + selRowId + "_zxcs").val(),
            zxzq: $("#" + selRowId + "_zxzq").val(),
            zxzqdw: $("#" + selRowId + "_zxzqdw").val(),
            kssj: $("#" + selRowId + "_kssj").val(),
            action: getTCMActionStr()
        };
        $("#gridTCMmedicine").jqGrid("addRowData", undefined, dataRow, "after", selRowId);
    }

    //Xóa chi tiết
    function deleteTCMRowData(selRowId, recalc) {
        if (!!selRowId) {
            var Id = $("#gridTCMmedicine").jqGrid('getRowData', selRowId).Id;
            $("#gridTCMmedicine").jqGrid("delRowData", selRowId);
            if (Id.indexOf("0.") == '-1') {//Ghi lại, xóa khỏi cơ sở dữ liệu
                deldata.push(Id);
            }
        }
    }

    function getTCMActionStr() {
        return "<i class='fa fa-plus-square-o' style='font-size: large; color: #09a3ea;' onclick='newTCMPresData(this)'></i>&nbsp;&nbsp;&nbsp;<i class='fa fa-minus-square-o' style='font-size: large; color: #09a3ea;' onclick='deleteTCMRowData($(this).parent().parent().attr(\"id\"));return false;'></i>";
    }

    //Y lệnh mới Nút
    function newTCMPresData(currentObj) {
        //if (yjjzhmsg)
        //{
        //    $.modalAlert(yjjzhmsg, 'warning');
        //    return;
        //}
        var $gridmedicine = $("#gridTCMmedicine");
        if (patobjValidate()) {
            ///Sao chép thời gian bắt đầu của thuốc đã lập lần trước
            var flag = false;
            var kssj = $.getTime();
            var rowIds = $gridmedicine.jqGrid('getDataIDs');
            if (rowIds == null || rowIds.length === 0) {
                flag = true;
            } else {
                var lastRowId = rowIds[rowIds.length - 1];
                if (lastRowId) {
                    kssj = $("#" + lastRowId + "_kssj").val();
                }
            }

            var dataRow = {
                Id: Math.random().toString() + new Date().getMilliseconds(), //Chưa lưu vào cơ sở dữ liệu

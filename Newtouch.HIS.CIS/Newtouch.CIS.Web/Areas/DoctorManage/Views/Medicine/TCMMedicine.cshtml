    function SavTCMService(savetodb) {
        //if (yjjzhmsg)
        //{
        //    $.modalAlert(yjjzhmsg, 'warning');
        //    return;
        //}
            if ($("#pdyzzd").val() == null || $("#pdyzzd").val() == "" || $("#pdyzzdmc").val() == null || $("#pdyzzdmc").val() == "" || $("#pdyzzdsj").val() == null || $("#pdyzzdsj").val() == "") {
            YZZDCorrespond();
            return;
        }
        patobjValidate();
        //Lấy tất cả các dòngId，duyệt để khung chỉnh sửa ở trạng thái lưu
        var rowIds = $("#gridTCMmedicine").jqGrid('getDataIDs');
            for (var i = 0; i < rowIds.length; i++) {
                if (MatchTCMZuhaoInfo(rowIds[i], true)) {
                    var saveResult = $("#gridTCMmedicine").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);

                    if (!saveResult) {
                        EnableTCMInlineEditBox();    //Khởi động lại và bật chỉnh sửa Nếu không, lần sauSavethì sẽ trả vềfalse
                        return;   //Lưu thất bại, thìreturn
                    }
                } else {
                    return false;
                }
            }
        var flag = false;
        var gridSimpleData = [];
        var gridzycfData = $("#gridTCMmedicine").jqGrid('getRowData_AllLine', null, true);
        if (gridzycfData.length < 1) {
            $.modalAlert("Hiện không có nội dung y lệnh đã lưu", 'warning');
        }
            $.each(gridzycfData, function () {    //Loại bỏaction
                for (var i = 0; i < $(this).length; i++) {
                    delete $(this)[i].action;
                    delete $(this)[i].jqRowId;   //Loại bỏjqRowId
                    $(this)[i].ysgh = '@ViewBag.ysgh';
                    $(this)[i].yzzdid = $("#pdyzzd").val();
                    $(this)[i].yzzdmc = $("#pdyzzdmc").val();
                    $(this)[i].yzzdsj = $("#pdyzzdsj").val();
                    if (savetodb == '1') {
                        if (this.xmmc == undefined || this.xmmc == "") {
                            $.modalAlert("Thiếu tên", "warning");
                            flag = true;
                            return false;
                        } else if (this.kssj == undefined || this.kssj == "") {
                            $.modalAlert("Thiếu thời gian bắt đầu", "warning");
                            flag = true;
                            return false;
                        } else if (this.kssj < window.currentobj.ryrq) {
                            $.modalAlert("[" + this.xmmc + "]Thời gian bắt đầu không được sớm hơn thời gian nhập viện Ngày nhập viện:" + window.currentobj.ryrq, "warning");
                            flag = true;
                            return false;
                        } else if (this.ypgg == undefined || this.ypgg == "") {
                            $.modalAlert("Thiếu quy cách", "warning");
                            flag = true;
                            return false;
                        } else if (isNaN(this.sl) || this.sl == "") {
                            $.modalAlert("Thiếu số thang", "warning");
                            flag = true;
                            return false;
                        } else if (isNaN(this.ypjl) || this.ypjl == "") {
                            $.modalAlert("Thiếu liều lượng", "warning");
                            flag = true;
                            return false;
                        } else if (this.dw === undefined || this.dw == "") {
                            $.modalAlert("Thiếu đơn vị", "warning");
                            flag = true;
                            return false;
                        } else if (this.pcmc === undefined || this.pcmc == "") {
                            $.modalAlert("Thiếu tần suất", "warning");
                            flag = true;
                            return false;
                        } else if (this.yfmc === undefined || this.yfmc == "" || this.yfmc == "请选择") {
                            $.modalAlert("Thiếu cách dùng", "warning");
                            flag = true;
                            return false;
                        }
                          else if (this.djbz === undefined || this.djbz == "") {
                            $.modalAlert("Thiếu dấu hiệu sắc thay", "warning");
                            flag = true;
                            return false;
                        } else if (this.cydybz === undefined || this.cydybz == "") {
                            $.modalAlert("Thiếu dấu hiệu mang thuốc khi xuất viện", "warning");
                            flag = true;
                            return false;
                        }

                        gridSimpleData.push({ Id: Math.random().toString() + new Date().getMilliseconds(), pccode: $(this)[i].pcCode, kssj: $(this)[i].kssj, xmdm: $(this)[i].xmdm });
                    }
                }
        });
        if (flag) {
            EnableTCMInlineEditBox();
            return;
        }

            //Lưu dữ liệu
            window.alldataArray.zyyz = $.jsonWhere(window.alldataArray.zyyz, function (icfmx) {
                if (!!!icfmx.Id) {
                    return false;   //Trong danh sách chỉnh sửa có
                }
                for (var iIndex = 0; iIndex < gridzycfData.length; iIndex++) {
                    if (gridzycfData[iIndex].Id == icfmx.Id) {
                        return false;
                    }
                }
                return true;
            });
            $.each(gridzycfData, function (index) {
                window.alldataArray.zyyz.unshift(this);
            });


        tcmmedicinelocaldata = new Array();
            if (savetodb == '1') {
                ValidateTCMRepeat(gridSimpleData, gridzycfData);
            }
    }

    //Xác minh y lệnh có trùng lặp không
        function ValidateTCMRepeat(gridSimpleData, gridmedicineData) {
        $.najax({
            url: "/DoctorManage/Medicine/ValidateRepeat",
            dataType: "json",
            data: { req: gridSimpleData, zyh: currentobj.zyh },
            type: "POST",
            loadingtext: "Dữ liệu y lệnh đang được lưu, vui lòng đợi...",
            success: function (resp) {
                if (!!resp && resp.length > 0) {
                    $.each(resp, function (index, val) {
                        var msg = val.clbz == "0" ? ("药品:" + val.xmmc + "24小时内有已开立医嘱,是否继续保存？") : ("[" + val.xmmc + "]已在长期医嘱中使用，是否继续保存？");
                        $.modalConfirm(msg, function (flag) {
                            if (flag) {
                                submitService(gridmedicineData);
                            } else {
                                EnableTCMInlineEditBox();
                            }
                            return;
                        });
                    });
                } else {
                    submitService(gridmedicineData);
                }
                window.alldataArray.zyyz = [];
                $("#pdyzzd").val("");
                $("#pdyzzdmc").val("");
                $("#pdyzzdsj").val("");
                $("#zdmc").text("");
            }
        });
    }

    //Khởi tạo khi thao tác sửa
    function EditTCMInit(zyh, yzId, yzlb) {
        $.najax({
            url: "/DoctorManage/Medicine/GetYZDetail",
            dataType: "json",
            data: { zyh: zyh, yzId: yzId, yzlx: yzlb },//yzlx:Ký hiệu dài hạn, tạm thời
            type: "POST",
            success: function (data) {
                currentobj = data.patientInfo;
                tcmmedicinelocaldata = data.DoctorServiceUIRequestDto;
                medicinekcdata = JSON.parse(data.DrugStockInfo);
                $.each(tcmmedicinelocaldata, function () {
                    this.action = getTCMActionStr();
                    var topxmdm = this.xmdm;
                    var toplyyf = this.zxksdm;
                    var topkcsl;
                    $.each(medicinekcdata, function () {
                        if (topxmdm == this.xmdm && toplyyf == this.lyyf) {
                            topkcsl = this.kysl;
                        }
                    });
                    this.kcsl = topkcsl;
                });
                $("#gridTCMmedicine").jqGrid('setGridParam', {
                    datatype: 'local',
                    data: tcmmedicinelocaldata,
                }).trigger("reloadGrid");

            }
        });
    }

    //Cùng một số nhóm cần khớp cách dùng, tần suất, số ngày, ngày kết thúc
    function MatchTCMZuhaoInfo(rowid, validate) {
        var rtnval = true;
        var currRowZh = $("#" + rowid + "_zh").val();
        if (currRowZh) {
            var allData = $("#gridTCMmedicine").jqGrid('getRowData_AllLine');
            $.each(allData, function () {
                var objId = $(this.zh).attr('rowid');
                var objzh = $("#" + objId + "_zh").val();
                if (objzh == currRowZh && objId != rowid) {
                    var objyfmc = $("#" + objId + "_yfmcval").val();
                    var objypyfdm = $("#" + objId + "_ypyfdm").val();
                    var objpcmc = $("#" + objId + "_pcmc").val();
                    var objpcCode = $("#" + objId + "_pcCode").val();
                    var objzxcs = $("#" + objId + "_zxcs").val();
                    var objzxzq = $("#" + objId + "_zxzq").val();
                    var objzxzqdw = $("#" + objId + "_zxzqdw").val();
                    var kssj = $("#" + objId + "_kssj").val();
                    var currentjx = $("#" + rowid + "_jxCode").val();
                    var jxyfdy = top.top.clients.ypjxyfdy;
                    var jxyf = top.top.clients.ypyf;//Tất cả cách dùng

                    if (validate) {
                        var yfmcval = $("#" + rowid + "_yfmcval").val();
                        var ypyfdm = $("#" + rowid + "_ypyfdm").val();
                        var pcmc = $("#" + rowid + "_pcmc").val();
                        var pccode = $("#" + rowid + "_pcCode").val();
                        var zxcs = $("#" + rowid + "_zxcs").val();
                        var zxzq = $("#" + rowid + "_zxzq").val();
                        var zxzqdw = $("#" + rowid + "_zxzqdw").val();
                        var rowkssj = $("#" + rowid + "_kssj").val();
                        if (yfmcval !== objyfmc || ypyfdm !== objypyfdm) {
                            $.modalAlert("Số nhóm là" + currRowZh + "cách dùng không nhất quán", "warning");
                            rtnval = false;
                        } else
                            if (pcmc !== objpcmc || pccode !== objpcCode) {
                                $.modalAlert("Số nhóm là" + currRowZh + "tần suất không nhất quán", "warning");
                                rtnval = false;
                            } else
                                if (zxcs !== objzxcs || zxzq !== objzxzq || zxzqdw !== objzxzqdw) {
                                    $.modalAlert("Số nhóm là" + currRowZh + "tần suất thực hiện không nhất quán", "warning");
                                    rtnval = false;
                                } else
                                    if (rowkssj !== kssj) {
                                        $.modalAlert("Số nhóm là" + currRowZh + "thời gian bắt đầu không nhất quán", "warning");
                                        rtnval = false;
                                    }
                    } else {
                        $("#" + rowid + "_pcCode").parent().next().children('select').html("");
                        //Hộp thả xuống cách dùng
                        if (currentjx !== null && currentjx !== "") {//Dạng bào chế của thuốc hiện tại
                            if ($("#" + rowid + "_xmmc").val() == "") {
                                return false;
                            }
                            $.each(jxyfdy, function (idx, val) {//Dạng bào chế tương ứng với cách dùng
                                if (val.jxCode === currentjx) {//Tìm dạng bào chế hiện tại
                                    var yfCode = val.yfCode;//Lấy cách dùng hiện tại
                                    if (currRowZh !== "" && objypyfdm !== "" && yfCode.indexOf(objypyfdm) < 0 && objypyfdm !== "请选择") {//Cách dùng cùng nhóm đã tồn tại trước đó
                                        $.modalAlert($("#" + rowid + "_xmmc").val() + "不存在" + objyfmc + "用法", "warning");
                                        $("#" + rowid + "_zh").val("");
                                        $("#" + rowid + "_zh").focus();
                                        return false;
                                    }
                                    $.each(jxyf, function (i, v) {
                                        if (yfCode.indexOf(v.yfCode) > '-1') {
                                            var append = "<option value=" + v.yfCode + ">" + v.yfmc + "</option>";
                                            $("#" + rowid + "_pcCode").parent().next().children('select').append(append);
                                        }
                                    });
                                    $("#" + rowid + "_pcCode").parent().next().children('select').val(objypyfdm);
                                }
                            });
                        }

                        $("#" + rowid + "_yfmcval").val(objyfmc);
                        $("#" + rowid + "_ypyfdm").val(objypyfdm);
                        $("#" + rowid + "_pcmc").val(objpcmc);       //Tần suất
                        $("#" + rowid + "_pcCode").val(objpcCode);
                        $("#" + rowid + "_zxcs").val(objzxcs);//Số lần thực hiện
                        $("#" + rowid + "_zxzq").val(objzxzq);//Chu kỳ thực hiện
                        $("#" + rowid + "_zxzqdw").val(objzxzqdw);//Đơn vị chu kỳ thực hiện
                        $("#" + rowid + "_kssj").val(kssj);//Thời gian bắt đầu
                    }
                }
            });
        }
        return rtnval;
    }

    //Tạo hộp thả xuống cách dùng thuốc
    function Generatezcyypyfoption(rowid) {
        var currentjx = $("#" + rowid + "_jxCode").val();
        var curzh = $("#" + rowid + "_zh").val();
        var curyfdm = $("#" + rowid + "_ypyfdm").val();
        var curyfmc = $("#" + rowid + "_yfmcval").val();
        var jxyfdy = top.top.clients.ypjxyfdy;
        var jxyf = top.top.clients.ypyf;//Tất cả cách dùng
        $("#" + rowid + "_pcCode").parent().next().children('select').html('<option>Vui lòng chọn</option>');
        var basejx = false;//Thuốc hiện tại có bảo trì tương ứng dạng bào chế không, mặc định là không
        //Hộp thả xuống cách dùng
        if (currentjx !== null && currentjx !== "") {//Dạng bào chế của thuốc hiện tại
            $.each(jxyfdy, function (idx, val) {//Dạng bào chế tương ứng với cách dùng
                if (val.jxCode === currentjx) {//Tìm dạng bào chế hiện tại
                    basejx = true;
                    var yfCode = val.yfCode;//Lấy cách dùng hiện tại
                    if (curzh !== "" && curyfdm !== "" && yfCode.indexOf(curyfdm) < 0 && curyfdm!=="请选择") {//Cách dùng cùng nhóm đã tồn tại trước đó
                        $.modalAlert($("#" + rowid + "_xmmc").val() + "不存在" + curyfmc + "用法", "warning");
                        $("#" + rowid + "_zh").val("");
                        $("#" + rowid + "_zh").focus();
                    }
                    var firstval = 0;
                    $.each(jxyf, function (i, v) {
                        if (yfCode.indexOf(v.yfCode) > '-1') {
                            firstval++;
                            var append = "<option value=" + v.yfCode + ">" + v.yfmc + "</option>";
                            $("#" + rowid + "_pcCode").parent().next().children('select').append(append);
                            if ((curyfdm == "" || isNaN(curyfdm)) && firstval == 1) {
                                $("#" + rowid + "_yfmcval").val(v.yfmc);
                                $("#" + rowid + "_ypyfdm").val(v.yfCode);
                            } else if (curyfdm == v.yfCode) {
                                $("#" + rowid + "_yfmcval").val(v.yfmc);
                            }
                        }
                    });
                    if (curyfdm !== "" && !isNaN(curyfdm)) {
                        $("#" + rowid + "_pcCode").parent().next().children('select').val(curyfdm);
                        $("#" + rowid + "_ypyfdm").val(curyfdm);
                    }
                }
            });

            if (!basejx) {
                $.modalAlert($("#" + rowid + "_xmmc").val() + "对应的剂型缺少用法维护", "warning");
                $("#" + rowid + "_yfmcval").val("");
                $("#" + rowid + "_ypyfdm").val("");
                $("#" + rowid + "_pcCode").parent().next().children('select').html('');
                return;
            }
        }
        $("#" + rowid + "_pcCode").parent().next().children('select').trigger("change");
        }

    //Lưu thành mẫu khác
    function SaveTCMMedicineTemplate()
    {
         $.modalOpen({
            id: "Form",
            title: "Gói",
            url: "/DoctorManage/DoctorsAdvice/Form",
            width: "400px",
            height: "300px",
            callBack: function (iframeId) {
                var obj = top.frames[iframeId].submitForm();
                if (obj && obj.mbmc != "" && obj.mblx) {
                    $.modalClose("Form");
                } else {
                    $.modalAlert("Tên gói và phạm vi gói là bắt buộc", "warning");
                    return;
                }
                var mbObj = {};
                if (obj != typeof (undefined)) {
                    mbObj.tcfw = obj.mblx;
                    mbObj.tcmc = obj.mbmc;
                    mbObj.tclx= @Html.Raw(((int)EnumYzlx.zcy).ToString());
                    mbObj.ysgh = '@ViewBag.ysgh';
                }

                //Lấy tất cả các dòngId，duyệt để khung chỉnh sửa ở trạng thái lưu
                var rowIds = $("#gridTCMmedicine").jqGrid('getDataIDs');
                for (var i = 0; i < rowIds.length; i++) {
                    calMsl(rowIds[i]);
                    if (!MatchTCMZuhaoInfo(rowIds[i], true)) {
                        return;
                    }
                    var saveResult = $("#gridTCMmedicine").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);

                        if (!saveResult) {
                            EnableTCMInlineEditBox();    //Khởi động lại và bật chỉnh sửa Nếu không, lần sauSavethì sẽ trả vềfalse
                            return;   //Lưu thất bại, thìreturn
                        }
                }
                var gridmedicineData = $("#gridTCMmedicine").jqGrid('getRowData_AllLine', null, true);
                if (gridmedicineData.length < 1) {
                    $.modalAlert("Thiếu dữ liệu y lệnh", 'warning');
                    return false;
                }
                $.each(gridmedicineData, function () {    //Loại bỏaction
                    for (var i = 0; i < $(this).length; i++) {
                        delete $(this)[i].action;
                    }
                });

                $.najax({
                    url: "@Url.Action("saveAsTemplate")",
                    dataType: "json",
                    data: { mbObj: mbObj, mxList: gridmedicineData },
                    type: "POST",
                    success: function (data) {
                        $.modalMsg("Lưu thành công", 'success');
                        window.$('#current').trigger('click');
                    }
                });
            }
        });
        }

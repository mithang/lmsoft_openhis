    function init_TCMMedicinePrescription() {
        //Chỉ y lệnh chưa lưu vào cơ sở dữ liệu mới cần khởi tạo tronggridtrong
        tcmmedicinelocaldata = new Array();
        if (window.alldataArray.zyyz) {
            tcmmedicinelocaldata = $.jsonWhere($.deepClone.clone(window.alldataArray.zyyz), function (icf) {
                return !!!icf.Id;
            });
            $.each(tcmmedicinelocaldata, function () {
                if (!this.Id) {
                    $.modalAlert('Y lệnh bất thường', "warning");
                    location.href = location.href;
                }
                this.action = getTCMActionStr()
            });
        }
        else {
            window.alldataArray.zyyz = new Array(); //Để tiện sử dụng sau này$.each()
        }

        if (zyypyzflag == 0) {   //Khởi tạo trang này
            gridTCMmedicine();
            zyypyzflag = 1;
        }
        else {
            $("#gridTCMmedicine").clearGridData(); //Xóa trước
            //Mở lại trang này
            $("#gridTCMmedicine").jqGrid('setGridParam', {
                datatype: 'local',
                data: tcmmedicinelocaldata
            }).trigger("reloadGrid");
        }
    }



    //Hành động nút Lưu
    function SaveDoctorService(savetodb) {
        debugger;
        if (yjjzhmsg)
        {
            $.modalAlert(yjjzhmsg, 'warning');
            return;
        }
            patobjValidate();
            //Lấy tất cả các dòngId，duyệt để khung chỉnh sửa ở trạng thái lưu
        var rowIds = $("#gridmedicine").jqGrid('getDataIDs');


        for (var i = 0; i < rowIds.length; i++) {
            if (savetodb == '1' && ($("#" + rowIds[i] + "_sl").val() == "" || $("#" + rowIds[i] + "_sl").val() == undefined)) {
                calMsl(rowIds[i]);
            }
            if ($("#" + rowIds[i] + "_sl").val() != null && $("#" + rowIds[i] + "_sl").val() !="") {
                $("#" + rowIds[i] + "_sl").val(Math.round($("#" + rowIds[i] + "_sl").val()));
            }
            if (MatchMZuhaoInfo(rowIds[i], true)) {
                var saveResult = $("#gridmedicine").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);

                    if (!saveResult) {
                        EnableMInlineEditBox();    //Khởi động lại và bật chỉnh sửa Nếu không, lần sauSavethì sẽ trả vềfalse
                        return;   //Lưu thất bại, thìreturn
                    }
            } else {
                return false;
                }
            }


        var gridmedicineData = $("#gridmedicine").jqGrid('getRowData_AllLine', null, true);

            if (gridmedicineData.length<1) {
                $.modalAlert("Hiện không có nội dung y lệnh đã lưu", 'warning');
            }

            var flag = false;
            var gridSimpleData = [];
            var px=0;
            $.each(gridmedicineData, function () {    //Loại bỏaction
                for (var i = 0; i < $(this).length; i++) {
                    delete $(this)[i].action;
                    $(this)[i].ysgh = '@ViewBag.ysgh';
                    $(this)[i].Px=px+1; px++;
                    if (savetodb == '1') {
                        if (this.xmmc == undefined || this.xmmc == "") {
                            $.modalAlert("Thiếu hạng mục", "warning");
                            flag = true;
                            return false;
                        } else if (this.kssj == undefined || this.kssj == "") {
                            $.modalAlert("Thiếu thời gian bắt đầu", "warning");
                            flag = true;
                            return false;
                        } else if (this.kssj < window.currentobj.ryrq) {
                            $.modalAlert("[" + this.xmmc + "]Thời gian bắt đầu không được sớm hơn thời gian nhập viện Ngày nhập viện:" + window.currentobj.ryrq, "warning");
                            flag = true;
                            return false;
                        } else if (this.ypgg == undefined || this.ypgg == "") {
                            $.modalAlert("Thiếu quy cách thuốc", "warning");
                            flag = true;
                            return false;
                        } else if (this.ypjl == undefined || this.ypjl == "") {
                            $.modalAlert("Thiếu liều lượng thuốc", "warning");
                            flag = true;
                            return false;
                        } else if (this.dw === undefined || this.dw == "") {
                            $.modalAlert("Thiếu đơn vị", "warning");
                            flag = true;
                            return false;
                        } else if (this.yfmc === undefined || this.yfmc == "" || this.yfmc == "请选择") {
                            $.modalAlert("Thiếu cách dùng", "warning");
                            flag = true;
                            return false;
                        } else if (this.pcmc === undefined || this.pcmc == "") {
                            $.modalAlert("Thiếu tần suất", "warning");
                            flag = true;
                            return false;
                        } else if (this.zbbz === undefined || this.zbbz == "") {
                            $.modalAlert("Thiếu dấu hiệu tự chuẩn bị", "warning");
                            flag = true;
                            return false;
                        }
                        else if (this.yztag != "" && this.yzzdid=="") {
                            $.modalAlert("Y lệnh thuốc gây nghiện, thuốc hướng thần cần điền chẩn đoán, vui lòng chọn lại thuốc gây nghiện, thuốc hướng thần", "warning");
                            flag = true;
                            return false;
                        }
                        else if (this.ispscs != "" && this.ispscs == "") {
                            $.modalAlert("Thiếu dấu hiệu kiểm tra test da", "warning");
                            flag = true;
                            return false;
                        }
                    }
                    gridSimpleData.push({ Id: Math.random().toString() + new Date().getMilliseconds(),pccode: $(this)[i].pcCode, kssj: $(this)[i].kssj, xmdm: $(this)[i].xmdm });
                }
            });
            if (flag) {
                EnableMInlineEditBox();
                return;
        }
            //Lưu dữ liệu
            window.alldataArray.ypyz = $.jsonWhere(window.alldataArray.ypyz, function (iyzmx) {
                if (!!!iyzmx.Id) {
                    return false;   //Trong danh sách chỉnh sửa có
                }
                for (var iIndex = 0; iIndex < gridmedicineData.length; iIndex++) {
                    if (gridmedicineData[iIndex].Id == iyzmx.Id) {
                        return false;
                    }
                }
                return true;
            });

            $.each(gridmedicineData, function () {
                window.alldataArray.ypyz.unshift(this);
            });

            medicinelocaldata = new Array();


            if (savetodb=='1') {
                //Xác minh y lệnh có trùng lặp không, rồi gửi dữ liệu về phía máy chủ để lưu gridSimpleDataNguồn trùng lặp,gridmedicineDataNguồn lưu y lệnh
                ValidateRepeat(gridSimpleData, gridmedicineData);

            }
    }
    //Xác minh y lệnh có trùng lặp không
    function ValidateRepeat(gridSimpleData, gridmedicineData)
    {
        $.najax({
            url: "/DoctorManage/Medicine/ValidateRepeat",
            dataType: "json",
            data: { req: gridSimpleData, zyh: currentobj.zyh },
            type: "POST",
            loadingtext: "Dữ liệu y lệnh đang được lưu, vui lòng đợi...",
            success: function (resp) {
                if (!!resp && resp.length > 0) {
                    $.each(resp, function (index, val) {
                        var msg = val.clbz == "0" ? ("药品:" + val.xmmc + "24小时内有已开立医嘱,是否继续保存？") : ("[" + val.xmmc + "]已在长期医嘱中使用，是否继续保存？");
                        $.modalConfirm(msg, function (flag) {
                            if (flag) {
                                submitService(gridmedicineData);
                            } else {
                                EnableMInlineEditBox();
                            }
                            return;
                        });
                    });
                } else {
                    submitService(gridmedicineData);
                }
                window.alldataArray.ypyz = [];
            }
        });
    }
    //Xác thực
    function Validate() {
        patobjValidate();

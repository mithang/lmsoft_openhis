                { label: 'Tái sử dụng(Nhiều lần)Sử dụngDấu hiệu', name: 'reptFlag', width: 80, align: 'left' },
                { label: 'Lớn nhấtTái sử dụngSố lần', name: 'maxReptCnt', width: 80, align: 'left' },
                { label: 'Số lần đã tái sử dụng', name: 'reptdCnt', width: 80, align: 'left' },
                { label: 'Sử dụngNhỏ nhấtKhoảng cách(Số ngày)', name: 'minInrvDays', width: 80, align: 'left' },
                { label: 'Đơn thuốcLoạiSố hiệu', name: 'rxTypeCode', width: 80, align: 'left' },
                { label: 'Đơn thuốcLoạiTên', name: 'rxTypeName', width: 80, align: 'left' },
                { label: 'Dài hạnĐơn thuốcDấu hiệu', name: 'longRxFlag', width: 80, align: 'left' },
                { label: 'Nghiệp vụLoạiMã', name: 'bizTypeCode', width: 80, align: 'left' },
                { label: 'Nghiệp vụLoạiTên', name: 'bizTypeName', width: 80, align: 'left' },
                { label: 'Đơn thuốcBổ sungThuộc tínhMã', name: 'rxExraAttrCode', width: 80, align: 'left' },
                { label: 'Đơn thuốcBổ sungThuộc tínhTên', name: 'rxExraAttrName', width: 80, align: 'left' },
            ],
            //pager: "#gridPager",
            viewrecords: true
        });
    }


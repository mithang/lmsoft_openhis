                { label: 'Kê đơnThời gian', name: 'prscTime', width: 80, align: 'left' },
                { label: 'ThuốcSố lượng(Số thang)', name: 'rxDrugCnt', width: 80, align: 'left' },
                { label: 'Đơn thuốcLiều nguyênCách dùng Số hiệu', name: 'rxUsedWayCodg', width: 80, align: 'left' },
                { label: 'Đơn thuốcLiều nguyênCách dùng Tên', name: 'rxUsedWayName', width: 80, align: 'left' },
                { label: 'Đơn thuốcLiều nguyênTần suất Số hiệu', name: 'rxFrquCodg', width: 80, align: 'left' },
                { label: 'Đơn thuốcLiều nguyênTần suấtTên', name: 'rxFrquName', width: 80, align: 'left' },
                { label: 'Đơn thuốcLiều nguyênĐơn vị liều', name: 'rxDosunt', width: 80, align: 'left' },

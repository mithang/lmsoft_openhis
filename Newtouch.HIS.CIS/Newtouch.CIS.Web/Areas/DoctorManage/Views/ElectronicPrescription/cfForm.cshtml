            colModel: [
                { label: 'Bảo hiểm y tếĐơn thuốcSố hiệu', name: 'hiRxno', width: 80, align: 'left' },
                { label: 'Chỉ địnhY tếCơ sởSố hiệu', name: 'fixmedinsCode', width: 80, align: 'left' },
                { label: 'Chỉ địnhY tếCơ sởTên', name: 'fixmedinsName', width: 80, align: 'left' },
                {label: 'Bảo hiểm y tếĐơn thuốcTrạng tháiMã', name: 'rxStasCodg', width: 80, align: 'left'},
                { label: 'Bảo hiểm y tếĐơn thuốcTrạng tháiTên', name: 'rxStasName', width: 80, align: 'left' },
                { label: 'Bảo hiểm y tếĐơn thuốcSử dụngTrạng tháiMã', name: 'rxUsedStasCodg', width: 80, align: 'left' },

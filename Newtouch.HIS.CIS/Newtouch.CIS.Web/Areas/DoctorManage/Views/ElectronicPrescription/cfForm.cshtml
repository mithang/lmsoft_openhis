                { label: 'tự chi trả Nguyên nhân Mô tả', name: 'realDscr', width: 80, align: 'left' },
                { label: 'Cần thiết Thuốc Tồn kho Số lượng', name: 'drugTotlcnt', width: 80, align: 'left' },

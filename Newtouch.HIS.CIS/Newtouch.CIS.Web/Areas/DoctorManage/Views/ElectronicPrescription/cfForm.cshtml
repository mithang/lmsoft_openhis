                { label: 'Dùng thuốc Số ngày', name: 'medcDays', width: 80, align: 'left' },
                { label: 'Tổng lượng dùng thuốc', name: 'drugCnt', width: 80, align: 'left' },
                { label: 'Đơn vị tổng lượng dùng thuốc', name: 'drugDosunt', width: 80, align: 'left' },

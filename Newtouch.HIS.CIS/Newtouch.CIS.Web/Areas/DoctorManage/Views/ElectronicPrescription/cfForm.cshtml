            multiselect: false,
            unwritten: false,
            colModel: [
                { label: 'Bảo hiểm y tế Đơn thuốc Số hiệu', name: 'hiRxno', width: 80, align: 'left' },
                { label: 'Chỉ địnhY tế Cơ sở Số hiệu', name: 'fixmedinsCode', width: 80, align: 'left' },
                { label: 'Chỉ địnhY tế Cơ sở Tên', name: 'fixmedinsName', width: 80, align: 'left' },
                {label: 'Bảo hiểm y tế Đơn thuốc Trạng thái Mã', name: 'rxStasCodg', width: 80, align: 'left'},
                { label: 'Bảo hiểm y tế Đơn thuốc Trạng thái Tên', name: 'rxStasName', width: 80, align: 'left' },
                { label: 'Bảo hiểm y tế Đơn thuốc Sử dụng Trạng thái Mã', name: 'rxUsedStasCodg', width: 80, align: 'left' },
                { label: 'Bảo hiểm y tế Đơn thuốc Sử dụng Trạng thái Tên', name: 'rxUsedStasName', width: 80, align: 'left' },
                { label: 'Kê đơn Thời gian', name: 'prscTime', width: 80, align: 'left' },
                { label: 'Thuốc Số lượng(Số thang)', name: 'rxDrugCnt', width: 80, align: 'left' },
                { label: 'Đơn thuốc Liều nguyên Cách dùng Số hiệu', name: 'rxUsedWayCodg', width: 80, align: 'left' },
                { label: 'Đơn thuốc Liều nguyên Cách dùng Tên', name: 'rxUsedWayName', width: 80, align: 'left' },
                { label: 'Đơn thuốc Liều nguyên Tần suất Số hiệu', name: 'rxFrquCodg', width: 80, align: 'left' },
                { label: 'Đơn thuốc Liều nguyên Tần suất Tên', name: 'rxFrquName', width: 80, align: 'left' },
                { label: 'Đơn thuốc Liều nguyên Đơn vị liều', name: 'rxDosunt', width: 80, align: 'left' },
                { label: 'Liều dùng một lần của đơn thuốc', name: 'rxDoscnt', width: 80, align: 'left' },

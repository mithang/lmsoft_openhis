                { label: 'Số đơn thuốc bảo hiểm y tế', name: 'hiRxno', width: 80, align: 'left' },
                { label: 'Số cơ sở y tế chỉ định', name: 'fixmedinsCode', width: 80, align: 'left' },
                { label: 'Tên cơ sở y tế chỉ định', name: 'fixmedinsName', width: 80, align: 'left' },
                {label: 'Mã trạng thái đơn thuốc bảo hiểm y tế', name: 'rxStasCodg', width: 80, align: 'left'},
                { label: 'Tên trạng thái đơn thuốc bảo hiểm y tế', name: 'rxStasName', width: 80, align: 'left' },
                { label: 'Mã trạng thái sử dụng đơn thuốc bảo hiểm y tế', name: 'rxUsedStasCodg', width: 80, align: 'left' },
                { label: 'Tên trạng thái sử dụng đơn thuốc bảo hiểm y tế', name: 'rxUsedStasName', width: 80, align: 'left' },
                { label: 'Thời gian kê đơn', name: 'prscTime', width: 80, align: 'left' },
                { label: 'Số lượng thuốc (số thang)', name: 'rxDrugCnt', width: 80, align: 'left' },
                { label: 'Cách dùng nguyên thang của đơn thuốc Số hiệu', name: 'rxUsedWayCodg', width: 80, align: 'left' },
                { label: 'Cách dùng nguyên thang của đơn thuốc Tên', name: 'rxUsedWayName', width: 80, align: 'left' },
                { label: 'Tần suất nguyên thang của đơn thuốc Số hiệu', name: 'rxFrquCodg', width: 80, align: 'left' },
                { label: 'Tên tần suất nguyên thang của đơn thuốc', name: 'rxFrquName', width: 80, align: 'left' },

                { label: 'Dấu hiệu sử dụng lại (nhiều lần)', name: 'reptFlag', width: 80, align: 'left' },
                { label: 'Số lần sử dụng lại tối đa', name: 'maxReptCnt', width: 80, align: 'left' },
                { label: 'Số lần đã sử dụng lại', name: 'reptdCnt', width: 80, align: 'left' },
                { label: 'Khoảng cách tối thiểu khi sử dụng (số ngày)', name: 'minInrvDays', width: 80, align: 'left' },
                { label: 'Số loại đơn thuốc', name: 'rxTypeCode', width: 80, align: 'left' },
                { label: 'Tên loại đơn thuốc', name: 'rxTypeName', width: 80, align: 'left' },
                { label: 'Dấu hiệu đơn thuốc dài hạn', name: 'longRxFlag', width: 80, align: 'left' },
                { label: 'Mã loại nghiệp vụ', name: 'bizTypeCode', width: 80, align: 'left' },
                { label: 'Tên loại nghiệp vụ', name: 'bizTypeName', width: 80, align: 'left' },
                { label: 'Mã thuộc tính bổ sung của đơn thuốc', name: 'rxExraAttrCode', width: 80, align: 'left' },
                { label: 'Tên thuộc tính bổ sung của đơn thuốc', name: 'rxExraAttrName', width: 80, align: 'left' },
            ],
            //pager: "#gridPager",
            viewrecords: true
        });
    }


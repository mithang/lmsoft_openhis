                { label: 'Tái sử dụng(Nhiều lần)Sử dụng Dấu hiệu', name: 'reptFlag', width: 80, align: 'left' },
                { label: 'Lớn nhất Tái sử dụng Số lần', name: 'maxReptCnt', width: 80, align: 'left' },
                { label: 'Số lần đã tái sử dụng', name: 'reptdCnt', width: 80, align: 'left' },
                { label: 'Sử dụng Nhỏ nhất Khoảng cách(Số ngày)', name: 'minInrvDays', width: 80, align: 'left' },
                { label: 'Đơn thuốc Loại Số hiệu', name: 'rxTypeCode', width: 80, align: 'left' },
                { label: 'Đơn thuốc Loại Tên', name: 'rxTypeName', width: 80, align: 'left' },
                { label: 'Dài hạn Đơn thuốc Dấu hiệu', name: 'longRxFlag', width: 80, align: 'left' },
                { label: 'Nghiệp vụ Loại Mã', name: 'bizTypeCode', width: 80, align: 'left' },
                { label: 'Nghiệp vụ Loại Tên', name: 'bizTypeName', width: 80, align: 'left' },
                { label: 'Đơn thuốc Bổ sung Thuộc tính Mã', name: 'rxExraAttrCode', width: 80, align: 'left' },
                { label: 'Đơn thuốc Bổ sung Thuộc tính Tên', name: 'rxExraAttrName', width: 80, align: 'left' },
            ],
            //pager: "#gridPager",
            viewrecords: true
        });
    }


@using Newtouch.Infrastructure
<link href="~/Content/css/beveltabs.css" rel="stylesheet" />
<script src="~/Content/js/beveltabs.js"></script>
<div id="linkxmlr" role="tabpanel" class="tab-pane" style="width:98%; margin-right: 10px;margin-top: 3px;">
    <div class="contentPanel" style="border: 1px solid #ddd;">
        <div style="background-color: #fff;" id="dv_gridsfxm">
            <table id="gridsfxm" style="border-collapse:collapse"></table>
            <div id="gridsfxmPager"></div>
        </div>
    </div>

    <div class="toolbar" style="float:right;width:80%;margin:10px 30px 12px;text-align:right;">
        <div id="labyzzje" style="margin-top:2px;float:left;"></div>
        <a class="btn btn-primary" style="margin-left:4px;" onclick="HistoricalOrders(@Html.Raw(((int)EnumYzlx.sfxm).ToString()))">Trích dẫn y lệnh lịch sử</a>
        <a class="btn btn-primary" style="margin-left:4px;" id="btn_bottombutton_f7" onclick="ReviewToday()">Xem trong ngày</a>
        <a class="btn btn-primary" style="margin-left:4px;" id="btn_bottombutton_f8" onclick="SaveItemTemplate()">Lưu thành gói khác</a>
        <a class="btn btn-primary" style="margin-left:4px;" id="btn_bottombutton_f9" onclick="SaveItemMedicine('1')">Lưu</a>
    </div>
</div>

@*Nhập hạng mục*@
<script>
    //var localdata = [];//Đối tượng mang thuốc
    var deldata = [];//Xóa đối tượng
    var zlltext = ('@ViewBag.zzlconfig' == "" ? "每次治疗量" : '@ViewBag.zzlconfig');
    var xmyzflag = 0;

    var itemlocaldata = new Array();
    function init_ItemPrescription() {

        //Chỉ y lệnh chưa lưu vào cơ sở dữ liệu mới cần khởi tạo tronggridtrong
        itemlocaldata = new Array();
        if (window.alldataArray.xmyz) {
            itemlocaldata = $.jsonWhere($.deepClone.clone(window.alldataArray.xmyz), function (icf) {
                return !!!icf.Id;
            });
            $.each(itemlocaldata, function () {
                if (!this.Id) {
                    $.modalAlert('Y lệnh bất thường', "warning");
                    location.href = location.href;
                }
                this.action = getIActionStr()
            });
        }
        else {
            window.alldataArray.xmyz = new Array(); //Để tiện sử dụng sau này$.each()
        }

        if (xmyzflag == 0) {   //Khởi tạo trang này
            gridsfxm();
            xmyzflag = 1;
        }

        else {
            $("#gridsfxm").clearGridData(); //Xóa trước
            //Mở lại trang này
            $("#gridsfxm").jqGrid('setGridParam', {
                datatype: 'local',
                data: itemlocaldata
            }).trigger("reloadGrid");
        }
    }

    //Danh sách thuốc
    function gridsfxm() {
        var $gridsfxm = $("#gridsfxm");
        $gridsfxm.jqGrid({
            datatype: 'local',
            data: itemlocaldata,
            height: $(window).height() - 180,
            shrinkToFit: true,   //true:Khởi tạo chiều rộng cột theo tỷ lệ false:Sử dụngcolModelchiều rộng đã chỉ định
            autowidth: true,
            rownumbers: true,  //Có hiển thị số thứ tự không
            editurl: "clientArray",  //Chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            unwritten: false,
            colModel: [
                { label: 'Id', name: 'Id', align: 'center', hidden: true },
                { label: 'Dài hạn<br>Tạm thời', name: 'yzlb', width: 35, editwidth: '100%', align: 'center', editable: true },
                {
                    label: '<span class="required">*</span>Hạng mục thu phí', name: 'xmmc', width: 220, editwidth: '100%', align: 'center', editable: true
                },
                {
                    label: 'zxksdm', name: 'zxksdm', editwidth: '100%', align: 'center', editable: true, hidden: true
                },
				{
				    label: '<span class="required">*</span>Khoa thực hiện', name: 'zxksmc', width: 180, editwidth: '100%', align: 'center', editable: true
                },
                {
                    label: '<span class="required">*</span>Đơn giá', name: 'dj', width: 80, editwidth: '100%', align: 'center', editable: true
                },
                {
                    label: '<span class="required">*</span>Thời gian bắt đầu', name: 'kssj', width: 135, editwidth: '100%',
                    align: 'center',
                    editable: true, unformat: pickDate, formatter: "date",
                    formatoptions: { srcformat: 'Y-m-d h:m:s', newformat: 'Y-m-d h:m:s' },
                    formatter: function (cellvalue, options, cell) {
                        return (typeof (cellvalue) == "undefined") ? "" : cellvalue;
                    }
                },
                { label: '<span class="required">*</span>Đơn vị', name: 'dw', width: 55, editwidth: '100%', align: "center", editable: true },
                { label: 'xmdm', name: 'xmdm', width: 100, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: 'dwjls', name: 'dwjls', editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: 'dwwwwwww', name: 'dwwwwwww', width: 40, editwidth: '', align: 'center', editable: true, hidden: true },  //Không thể loại bỏ
                {
                    label: '<span class="required">*</span>' + zlltext, name: 'ypjl', width: 80, editwidth: '100%', align: 'center', editable: true,
                    editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var cellval = $(this).val();
                                    if (cellval.replace(/(^\s*)|(\s*$)/g, "") == "") {
                                        $.modalAlert(zlltext+"trống, vui lòng xác nhận.", 'warning');
                                        return;
                                    }
                                    if (isNaN(cellval)) {
                                        $.modalAlert(zlltext +": vui lòng nhập số", 'warning');
                                        $(this).val('');
                                        return;
                                    }
                                    if (parseInt(cellval)<0) {
                                        $.modalAlert(zlltext + ": lớn hơn0", 'warning');
                                        $(this).val('');
                                        return;
                                    }
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    calitemsl(rowid);
                                    CalculateRegularItemEachLineSlAndJe(rowid);   //Tính toán Tổng số lượng chi tiết, tổng số tiền chi tiết và số tiền đơn thuốc
                                }
                            }
                        ]
                    }
                },
                { label: '<span class="required">*</span>Tần suất', name: 'pcmc', width: 50, editwidth: '100%', align: 'center', editable: true },
                { label: 'pcCode', name: 'pcCode', editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: 'zxcs', name: 'zxcs',editable: true,hidden: true },
                { label: 'zxzq', name: 'zxzq',editable: true,hidden: true },
                { label: 'zxzqdw', name: 'zxzqdw', editable: true, hidden: true },
                { label: '<span class="required">*</span>Số tiền', name: 'je', width: 100, editwidth: '100%', align: 'center', editable: true },
                { label: 'Số ngày', name: 'ts', width: 50, editwidth: '100%', align: 'center', editable: true },
                { label: 'Vị trí', name: 'bw', width: 150, editwidth: '100%', align: "center", editable: true, hidden: '@ViewBag.bwhide' =="False" ? undefined : true },
                { label: 'Tổng số lượng', name: 'sl', editwidth: '100%', hidden: true, align: 'center', editable: true},
                { label: 'Dặn dò', name: 'ztnr', width: '@ViewBag.bwhide'=="False" ? 150 : 300, editwidth: '100%', align: 'center', editable: true },
                {
                    label: 'Chuyển sang tự trả', name: 'iszzf', width: 50, editwidth: '100%', align: 'center', edittype: "select", editable: true, editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    $("#" + rowid + "_iszzffffff").val($(this).val());
                                }
                            }
                        ]

                    }
                },
                { label: 'iszzffffff', name: 'iszzffffff', editwidth: '', align: 'center', editable: true, hidden: true },
                {
                    label: 'Tính phí', name: 'isjf', width: 40, editwidth: '100%', align: 'center', edittype: "select", editable: true, editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    $("#" + rowid + "_isjffffff").val($(this).val());
                                }
                            }
                        ]

                    }
                },
                { label: 'isjffffff', name: 'isjffffff', editwidth: '', align: 'center', editable: true, hidden: true },
                { label: 'Thao tác', name: 'action', width: 80, align: 'center' },
                { name: 'yzlx', hidden: true },
                { name: 'dwlb', hidden: true },
                { name: 'zyh', hidden: true },
                { name: 'ysgh', hidden: true },
                { name: 'sfxmzt',hidden:true}
            ],
            editinputwidthborder: false,    //Có cần viền không mặc định làtrue
            editinputborderradius: false,   //Có cần bo góc viền không Mặc địnhtrue(có bo góc)
            pager: "gridsfxmPager",
            gridComplete: function () {
                EnableIInlineEditBox();
                //ẨngridThanh cuộn dưới cùng
                $gridsfxm.closest(".ui-jqgrid-bdiv").css({ "overflow-x": "hidden" });
            }
        });

        //Menu cấp hai
        $gridsfxm.jqGrid('setGroupHeaders', {
            useColSpanStyle: true,
            groupHeaders: [
                {
                    startColumnName: 'xmmc',
                    numberOfColumns: 4,
                    titleText: 'Thông tin cơ bản'
                }, {
                    startColumnName: 'dwjls',
                    numberOfColumns: 7,
                    titleText: 'Cách dùng hạng mục'
                }]
        });
        $.each($(".jqg-first-row-header").find("th"),
            function () {
                $(this).css("padding", 0);
            });

        //Nút tùy chỉnh
        $gridsfxm.navGrid('#gridsfxmPager',
                {
                    edit: false,
                    add: false,
                    del: false,
                    search: false,
                    refresh: false,
                    view: false,
                    position: "left",
                    cloneToTop: false
                })
            .navButtonAdd('#gridsfxmPager',
                {
                    buttonicon: "glyphicon glyphicon-new-window",
                    title: "Y lệnh mới",
                    caption: "Y lệnh mới",
                    position: "last",
                    onClickButton: function() {
                        newIPresData(null);
                    }
            });

        $("#gridsfxmPager_right").append("<div class=\"ckbox\" style=\"margin-top:2px;\"><input id=\"chkItemlsyz\" name=\"chkItemlsyz\" type=\"checkbox\" ><label for=\"chkItemlsyz\">Y lệnh tạm thời</label></div>");
    }

    //Bật chỉnh sửa trong dòng
    function EnableIInlineEditBox() {
        var ids = $("#gridsfxm").getDataIDs();
        $.each(ids, function () {
            var rowid = String(this);
            //Mở chế độ chỉnh sửa
            $("#gridsfxm").jqGrid('editRow', rowid, false, initIInlineFunc);
            $("#" + rowid + "_kssj").css("text-align", "left");

            //Loại y lệnh Dài hạn, tạm thời
            if ($("#" + rowid + "_yzlb").val() == undefined || $("#" + rowid + "_yzlb").val() === "") {
                var yzlb = $("#chkItemlsyz").is(":checked") ? "临" : "长";
                $("#" + rowid + "_yzlb").val(yzlb);
            }
            $("#" + rowid + "_yzlb").attr('readonly', 'true');
            CalculateRegularItemEachLineSlAndJe(String(this), false);
        });
        CalculateRegularItemPresAmount();  //Tính số tiền của đơn thuốc
    }
    //Tính số lượng và số tiền trong chi tiết
    function CalculateRegularItemEachLineSlAndJe(rowid, recalc) {
        var obj = new Object();

        var currRowSl = $('#' + rowid + '_sl').val();
        var currRowDj = $('#' + rowid + '_dj').val();

        if (currRowSl > 0 && currRowDj > 0) {
            obj.currRowZe = roundingBy4she6ru5chengshuang(parseFloat(currRowSl) * parseFloat(currRowDj), 2);
        }

        $('#' + rowid + '_je').val(obj.currRowZe)   //Gán giá trị

        if (!(recalc === false)) {
            CalculateRegularItemPresAmount()  //Tính số tiền đơn thuốc
        }
    }
    //Tính số tiền đơn thuốc
    function CalculateRegularItemPresAmount() {
        var allData = $("#gridsfxm").jqGrid('getRowData_AllLine', null, true);
        var yzzje = parseFloat("0.00",2);
        $.each(allData, function () {
            var rowid = this.jqRowId;
            var sl = $("#" + rowid + "_sl").val();
            var dj = $("#" + rowid + "_dj").val();
            if (!sl && !dj) {
                return;
            }
            yzzje += parseFloat(roundingBy4she6ru5chengshuang(parseFloat($.undefinedwith0(sl) * parseFloat($.undefinedwith0(dj))), 2),2);   //Tính tổng số tiền y lệnh
        });
        $('#labyzzje').html('');
        $('#labyzzje').append('Tổng số tiền:<label style="color:red;font-size:20px;">￥' + roundingBy4she6ru5chengshuang(yzzje, 2)+ '</label>');
    }
    //Khởi tạo Lớp nổi
    function initIInlineFunc(rowid) {
        //Một số cột chỉ đọc
        $("#" + rowid + "_pcmc").attr('readonly', 'true');
        $("#" + rowid + "_sl").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_dw").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_je").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_xmmc").attr('autocomplete', 'off');
        $("#" + rowid + "_dj").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_ztnr").parent().next().children('select').html('');
        $("#" + rowid + "_ztnr").parent().next().children('select').append('<option value="1">Có</option><option value="0">Không</option>');
        $("#" + rowid + "_iszzffffff").parent().next().children('select').html('');
        $("#" + rowid + "_iszzffffff").parent().next().children('select').append('<option value="1">Có</option><option value="0">Không</option>');

        var iszzfval = $("#" + rowid + "_iszzffffff").val();
        if (!!iszzfval) {
            $("#" + rowid + "_ztnr").parent().next().children('select').val(iszzfval).trigger("change");
        } else {
            $("#" + rowid + "_ztnr").parent().next().children('select').val(0).trigger("change");
        }
        var isjfval = $("#" + rowid + "_isjffffff").val();
        if (!!isjfval) {
            $("#" + rowid + "_iszzffffff").parent().next().children('select').val(isjfval).trigger("change");
        } else {
            $("#" + rowid + "_iszzffffff").parent().next().children('select').val(1).trigger("change");
        }

        var currlineId = $("#gridsfxm").getRowData(rowid).Id;
        if (currlineId.indexOf("0.") == '-1') {//Dữ liệu đã sửa không được phép sửa hạng mục thu phí
            $("#" + rowid + "_xmmc").css('background-color', '#f6f7fb').attr('readonly', 'true');
        } else {
            var searchType = "sfxm";
            var sfdllx = "RegularItem";
            if ('@ViewBag.sfxmService'=="kf") {
                searchType = "sfxm.dwjls";
                sfdllx = "Rehab";
            }

            //Loại y lệnh Nổi
            $("#" + rowid + "_yzlb").yzlbFloatingSelector({
                isinputchangetriggered: false,
                showtext: 'Name',
                attrcols: ['yzlb',"Name"],
                itemdbclickhandler: function ($this) {
                    $("#" + rowid + "_yzlb").val($this.attr('data-yzlb'));
                    $("#" + rowid + "_yzlb").trigger("change");
                }
            });

            $("#" + rowid + "_yzlb").change(function() {
                if ($("#" + rowid + "_yzlb").val() === "临") {
                    $("#" + rowid + "_sl").show();
                    $("#" + rowid + "_ts").css('background-color', '#f6f7fb').attr('readonly', 'true'); //Y lệnh tạm thời Vô hiệu hóa số ngày
                    $("#" + rowid + "_sl").css('background-color', '#fff').removeAttr('readonly'); //Y lệnh tạm thời Bật tổng số lượng
                } else {
                    $("#" + rowid + "_ts").css('background-color', '#fff').removeAttr('readonly'); //Y lệnh dài hạn Bật số ngày
                    $("#" + rowid + "_sl").css('background-color', '#f6f7fb').attr('readonly', 'true'); //Y lệnh dài hạn Vô hiệu hóa tổng số lượng
                    $("#" + rowid + "_sl").hide();
                }
            });

            //Lớp nổi thuốc  //Thuốc Đông y, thuốc Tây y có bị trùng lặp không ‘"#" + rowid + "_xmmc"’
            $("#" + rowid + "_xmmc").sfxmFloatingSelector({
                djDecimalPlaces: 4,
                //leftshift: 150,
                showgg: true,
                showypkc: true, //Có hiển thị tồn kho không
                searchType: searchType,
                ajaxparameters: function ($thisinput) {
                    return "mzzybz=2&dllb=2&sfdllx=" + sfdllx+"&keyword=" + $.trim($thisinput.val());
                },
                itemdbclickhandler: function ($this) {
                    $("#" + rowid + "_xmmc").val($this.attr('data-sfxmmc'));
                    $("#" + rowid + "_xmdm").val($this.attr('data-sfxmCode'));
                    $("#" + rowid + "_dw").val($this.attr('data-dw'));
                    $("#" + rowid + "_dj").val($this.attr('data-dj'));
                    $("#" + rowid + "_dwjls").val($this.attr('data-dwjls'));
                    $("#" + rowid + "_zxksdm").val($this.attr('data-zxks'));
                    $("#" + rowid + "_zxksmc").val($this.attr('data-zxksmc'));
                    $("#" + rowid + "_xmmc").css('background-color', '#f6f7fb').attr('readonly', 'true');
                    var rowData = $("#gridsfxm").getRowData(rowid);
                    $("#gridsfxm").jqGrid('setCell',rowid,"yzlx",@Html.Raw(((int)EnumYzlx.sfxm).ToString()));
                    if($this.attr('data-sfdlcode')=="13")//Xử lý nhóm lớn phẫu thuật
                    {
                        $("#gridsfxm").jqGrid('setCell',rowid,"yzlx","9");//Đặt loại y lệnh thành y lệnh phẫu thuật
                    }
                    if($this.attr('data-zfxz')=="9")//Tạm dùng trường này để phân biệt bộ mẫu hạng mục
                    {
                        $("#gridsfxm").jqGrid('setCell',rowid,"sfxmzt","Y");//Tổ hợp hạng mục
                    }
                    var jldw = $this.attr('data-jldw');    //Đơn vị liều lượng
                    var dw = $this.attr('data-dw');     //Đơn vị nhập viện
                    //Khởi tạo giá trị đơn vị và loại đơn vị, nếu không sẽ không có giá trị truyền về phía máy chủ
                    //Đơn vị liều lượng mặc định, không tồn tại đơn vị liều lượng, mặc định đơn vị nhập viện, đều không tồn tại thì không gán giá trị
                    if (!!jldw) {
                        $("#" + rowid + "_dwwwwwww").val(jldw);
                        $("#" + rowid + "_dwlb").val("1");
                    } else if (!!dw) {
                        $("#" + rowid + "_dwwwwwww").val(dw);
                        $("#" + rowid + "_dwlb").val("4");
                    }
                    CalculateRegularItemEachLineSlAndJe(rowid);   //Tính toán Tổng số lượng chi tiết, tổng số tiền chi tiết và số tiền đơn thuốc
                }
            });
        }
        //Lớp nổi tần suất
        $("#" + rowid + "_pcmc").pcFloatingSelector({
            showtext: 'yzpcmc',
            attrcols: ['yzpcmc', 'yzpcCode', 'zxcs', 'zxzq', 'zxzqdw'],
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_pcmc").val($this.attr('data-yzpcmc'));
                $("#" + rowid + "_pcCode").val($this.attr('data-yzpcCode'));
                $("#" + rowid + "_zxcs").val($this.attr('data-zxcs'))
                $("#" + rowid + "_zxzq").val($this.attr('data-zxzq'))
                $("#" + rowid + "_zxzqdw").val($this.attr('data-zxzqdw'));
                if($("#" + rowid + "_pcmc").val()=="ST")
                {
                    $("#" + rowid + "_yzlb").val("临");
                }
                //Vô hiệu hóa số ngày của y lệnh tạm thời
                var pcCode = $("#" + rowid + "_pcCode").val();
                if ('@ViewBag.pcStr' !== '' && pcCode !== '' && (!isNaN(pcCode)) &&
                    (('@ViewBag.pcStr').indexOf(pcCode) > -1)) {
                    $("#" + rowid + "_ts").css('background-color', '#f6f7fb').attr('readonly', 'true');
                } else
                {
                    $("#" + rowid + "_ts").css('background-color', 'white').removeAttr('readonly');
                }
                debugger;
                calitemsl(rowid);
                CalculateRegularItemEachLineSlAndJe(rowid);   //Tính toán Tổng số lượng chi tiết, tổng số tiền chi tiết và số tiền đơn thuốc
            }
        });

        $("#" + rowid + "_ypjl").keyup(function () {
            calitemsl(rowid);
            CalculateRegularItemEachLineSlAndJe(rowid);   //Tính toán Tổng số lượng chi tiết, tổng số tiền chi tiết và số tiền đơn thuốc
        });
        $("#" + rowid + "_zxksmc").newtouchBatchFloatingSelector({
            height: 170,
            width: 300,
            caption: "Chọn khoa",
            url: '/Rehab/GetSfxmZxksSelectJson2',
            clickautotrigger: true,
            ajaxparameters: function ($thisinput) {
                return 'sfxmCode=' + $("#" + rowid + "_xmCode").val() + "&keyword=" + $thisinput.val();
            },
            colModel: [
				{ label: 'Số hiệu', name: 'Code', widthratio: 40 },
				{ label: 'Tên', name: 'Name', widthratio: 60 },
				{ label: 'Phiên âm', name: 'py', hidden: true }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#" + rowid + "_zxksdm").val($thistr.find("td:eq(0)").html());
                $("#" + rowid + "_zxksmc").val($thistr.find('td:eq(1)').html());
                return;
            },
        });

        //Lớp nổi vị trí
        $("#" + rowid + "_bw").bwFloatingSelector({
            showtext: 'bwmc',
            attrcols: ['bwmc', 'bwCode'],
            checkItemActivity: function ($li, $thisinput) {
                var selected = false;//Mặc định không chọn giá trị hiện tại
                var selectval = $thisinput.val();
                if (selectval) {
                    selectval = selectval.split(',');
                    $.each(selectval, function () {
                        if (this == $li.html()) {
                            selected = true;
                        }
                    });
                }
                return selected;
            },
            ajaxparameters: function ($thisinput) {
                return "keyword=" + $thisinput.val();
            },
            itemdbclickhandler: function ($this) {
                var mcval = "";
                if (typeof ($this) !== "undefined") {
                    $.each($this, function () {
                        mcval += this.attr('data-bwmc') + ",";

                    });
                    if (mcval.length > 0) {
                        mcval = mcval.substring(0, mcval.length - 1);
                    };
                }
                $("#" + rowid + "_bw").val(mcval);
            }
        });

        //Lớp nổi dặn dò
        $("#" + rowid + "_ztnr").ztFloatingSelector({
            height: 100,
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_ztnr").val($this.attr('data-ztmc'));
            }
        });
    }

    function calitemsl(rowid) {
        debugger;
        //Số lượng đo của đơn vị/Liều lượng mỗi lần điều trị*Tần suất
        var dwjls = $("#" + rowid + "_dwjls").val();
        var mczll = $("#" + rowid + "_ypjl").val();
        var zxcs = $("#" + rowid + "_zxcs").val();
        var zxzq = $("#" + rowid + "_zxzq").val();
        var zxzqdw = $("#" + rowid + "_zxzqdw").val();
        if (isNaN(dwjls) || dwjls == "") {
            return;
        } else if (isNaN(mczll) || mczll == "") {
            return;
        } else if (isNaN(zxcs) || zxcs == "") {
            return;
        } else if (isNaN(zxzq) || zxzq == "") {
            return;
        } else if (isNaN(zxzqdw) || zxzqdw == "") {
            return;
        } else if (mczll !== "" && dwjls !== "" && (parseInt(dwjls) > parseInt(mczll))) {
            //rowid = rowid.substring(3);
            $.modalAlert($("#" + rowid + "_xmmc").val()+"的" + zlltext + "不能小于单位计量数", "warning");
            $("#" + rowid + "_sl").val("");
            return false;
        } else {
            var sl = getItemsl(dwjls, mczll, zxcs, zxzq, zxzqdw);
            $("#" + rowid + "_sl").val(sl);
        }
        return true;
    }

    function calitemslByobj(obj) {
        if (isNaN(obj.dwjls) || obj.dwjls === "") {
            return false;
        } else if (isNaN(obj.ypjl) || obj.ypjl === "") {
            return false;
        } else if (isNaN(obj.zxcs) || obj.zxcs === "") {
            return false;
        } else if (isNaN(obj.zxzq) || obj.zxzq === "") {
            return false;
        } else if (isNaN(obj.zxzqdw) || obj.zxzqdw === "") {
            return false;
        } else if (obj.ypjl !== "" && obj.dwjls !== "" && (parseInt(obj.dwjls) > parseInt(obj.ypjl))) {
            //rowid = rowid.substring(3);
            $.modalAlert(obj.xmmc+"của" + zlltext + "Không được nhỏ hơn số lượng đo của đơn vị", "warning");
            return false;
        } else {
            var sl = getItemsl(obj.dwjls, obj.ypjl, obj.zxcs, obj.zxzq, obj.zxzqdw);
            return sl;
        }
    }

    function getItemsl(dwjls, mczll, zxcs, zxzq, zxzqdw) {
        var qzint=1;
        if(zxzq>1)
            qzint = Number(Math.ceil(zxzq * getpcsl(zxcs, zxzq, zxzqdw)));
        else
            qzint = Number(getpcsl(zxcs, zxzq, zxzqdw));
        return qzint * Math.floor(mczll / dwjls);
    }

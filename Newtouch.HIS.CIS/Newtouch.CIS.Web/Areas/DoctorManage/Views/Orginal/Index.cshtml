    //Hành động nút Lưu
    function SaveItemMedicine(savetodb) {
        //if (yjjzhmsg)
        //{
        //    $.modalAlert(yjjzhmsg, 'warning');
        //    return;
        //}
        patobjValidate();
            //Lấy tất cả các dòngId，duyệt để khung chỉnh sửa ở trạng thái lưu
            var rowIds = $("#gridsfxm").jqGrid('getDataIDs');
            for (var i = 0; i < rowIds.length; i++) {
                    var saveResult = $("#gridsfxm").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);
                    if (!saveResult) {
                        EnableIInlineEditBox();    //Khởi động lại và bật chỉnh sửa Nếu không, lần sauSavethì sẽ trả vềfalse
                        return;   //Lưu thất bại, thìreturn
                    }
            }
            var gridsfxmData = $("#gridsfxm").jqGrid('getRowData_AllLine', null, true);
            if (gridsfxmData.length<1) {
                $.modalAlert("Hiện không có nội dung y lệnh đã lưu", 'warning');
            }
        var gridSimpleData = [];
        var flag = false;
            $.each(gridsfxmData, function () {    //Loại bỏaction
                for (var i = 0; i < $(this).length; i++) {
                    delete $(this)[i].action;
                    $(this)[i].ysgh = '@ViewBag.ysgh';
                    var sl = calitemslByobj(this);
                    if (!sl && savetodb == '1') {
                        $.modalAlert("Tính số lượng thất bại", "warning");
                        flag = true;
                        return false;
                    } else if (sl) {
                        $(this)[i].sl = sl;
                    }
                    if (savetodb == '1') {
                        if (this.xmmc == undefined || this.xmmc == "") {
                            $.modalAlert("Thiếu hạng mục", "warning");
                            flag = true;
                            return false;
                        } else if (this.zxksmc == undefined || this.zxksmc == "" || this.zxksdm == undefined || this.zxksdm == ""){
                            $.modalAlert("Thiếu khoa thực hiện,Vui lòng chọn", "warning");
                            flag = true;
                            return false;
                        }else if (this.kssj == undefined || this.kssj == "") {
                            $.modalAlert("Thiếu thời gian bắt đầu", "warning");
                            flag = true;
                            return false;
                        } else if (this.kssj < window.currentobj.ryrq) {
                            $.modalAlert("[" + this.xmmc + "]Thời gian bắt đầu không được sớm hơn thời gian nhập viện Ngày nhập viện:" + window.currentobj.ryrq, "warning");
                            flag = true;
                            return false;
                        } else if (this.dw == undefined || this.dw == "") {
                            $.modalAlert("Thiếu đơn vị", "warning");
                            flag = true;
                            return false;
                        } else if (this.ypjl == undefined || this.ypjl == "") {
                            $.modalAlert("Thiếu liều lượng", "warning");
                            flag = true;
                            return false;
                        }else if (this.pcmc == undefined || this.pcmc == "") {
                            $.modalAlert("Thiếu tần suất", "warning");
                            flag = true;
                            return false;
                        }
                    }
                }
        });

        if (flag) {
            EnableIInlineEditBox();
            return;
        }

        //Lưu dữ liệu
        window.alldataArray.xmyz = $.jsonWhere(window.alldataArray.xmyz, function (iyzmx) {
            if (!!!iyzmx.Id) {
                return false;   //Trong danh sách chỉnh sửa có
            }
            for (var iIndex = 0; iIndex < gridsfxmData.length; iIndex++) {
                if (gridsfxmData[iIndex].Id == iyzmx.Id) {
                    return false;
                }
            }
            return true;
        });

        $.each(gridsfxmData, function () {
            window.alldataArray.xmyz.unshift(this);
        });

        itemlocaldata = new Array();


        if (savetodb=='1') {
            submitService(gridsfxmData);
            window.alldataArray.xmyz = [];
        }
    }

    //Lưu thành mẫu khác
    function SaveItemTemplate() {
        $.modalOpen({
            id: "Form",
            title: "Gói",
            url: "/DoctorManage/DoctorsAdvice/Form",
            width: "400px",
            height: "300px",
            callBack: function (iframeId) {
                var obj = top.frames[iframeId].submitForm();
                if (obj && obj.mbmc != "" && obj.mblx) {
                    $.modalClose("Form");
                } else {
                    $.modalAlert("Tên gói và phạm vi gói là bắt buộc", "warning");
                    return;
                }
                var mbObj = {};
                if (obj != typeof (undefined)) {
                    mbObj.tcfw = obj.mblx;
                    mbObj.tcmc = obj.mbmc;
                    mbObj.tclx = @Html.Raw(((int)EnumYzlx.sfxm).ToString());
                    mbObj.ysgh = '@ViewBag.ysgh';
                }
                //Lấy tất cả các dòngId，duyệt để khung chỉnh sửa ở trạng thái lưu
                var rowIds = $("#gridsfxm").jqGrid('getDataIDs');
                for (var i = 0; i < rowIds.length; i++) {
                    calitemsl(rowIds[i]);
                    var saveResult = $("#gridsfxm").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);

                    if (!saveResult) {
                        EnableIInlineEditBox();    //Khởi động lại và bật chỉnh sửa Nếu không, lần sauSavethì sẽ trả vềfalse
                        return;   //Lưu thất bại, thìreturn
                    }
                }
                var gridsfxmData = $("#gridsfxm").jqGrid('getRowData_AllLine', null, true);
                if (gridsfxmData.length < 1) {
                    $.modalAlert("Thiếu dữ liệu y lệnh", 'warning');
                    return false;
                }
                $.each(gridsfxmData, function () {    //Loại bỏaction
                    for (var i = 0; i < $(this).length; i++) {
                        delete $(this)[i].action;
                    }
                });
                $.najax({
                    url: "@Url.Action("saveAsTemplate")",
                    dataType: "json",
                    data: { mbObj: mbObj, mxList: gridsfxmData },
                    type: "POST",
                    success: function (data) {
                        $.modalMsg("Lưu thành công", 'success');
                        window.$('#current').trigger('click');
                    }
                });
            }
        });
    }

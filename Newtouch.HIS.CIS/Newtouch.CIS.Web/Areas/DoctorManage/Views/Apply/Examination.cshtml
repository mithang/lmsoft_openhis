@using Newtouch.Infrastructure
@{
    ViewBag.Title = "Examination";
    Layout = null;
}
<style>
    #divGridjc select[role=select] {
        padding: 0;
    }

    #divGridjc input[role=textbox] {
        padding: 2px 0;
        text-align: center;
    }
</style>
<div id="linkjc" role="tabpanel" class="tab-pane" style="width:70.5%; float:right; margin-right: 10px; border:solid 1px #ddd; margin-top: 3px;">
    <div style="background-color: #fff;">
        <table id="gridjc"></table>
    </div>
    <div id="divGridjc" style="display:none;" >
        <table id="alreadyJCAppliedList"></table>
    </div>
    <div id="divGridjczt" style="background-color:white;">
        <table id="alreadyJCAppliedGroupList"></table>
    </div>
    <table class="form">
        <tr>
            <td class="formTitle">
                Ấn tượng lâm sàng
            </td>
            <td class="formValue">
                <input id="txt_jc_lcyx" name="txt_jc_lcyx" type="text" class="form-control" />
            </td>
            <td class="formTitle">
                Ghi chú yêu cầu
            </td>
            <td class="formValue">
                <input id="txt_jc_sqbz" name="txt_jc_sqbz" type="text" class="form-control" />
            </td>
            <td style="width:100px;"></td>
            <td style="width:100px;"></td>
        </tr>
        <tr>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td class="formValue">
                <input type="button" class="btn btn-primary" value="Lưu phiếu yêu cầu" style="display: table-cell;float:right" onclick="SaveExaminationZT('1')" />
            </td>
        </tr>
    </table>
</div>

<script>
    var jcflag = 0;
    var jclocaldata = new Array();
    var sqdh = "";
    $(function() {
        gridjc();
        gridAlreadyJCApplied();
        gridAlreadyJCGroupApplied();
    });

    var jcflag = 0;
    var jclocaldata = new Array();
    function init_jcPrescription() {

        //Chỉ y lệnh chưa lưu vào cơ sở dữ liệu mới cần khởi tạo tronggridtrong
        jclocaldata = new Array();
        if (window.alldataArray.jcyz) {
            jclocaldata = $.jsonWhere($.deepClone.clone(window.alldataArray.jcyz), function (icf) {
                return !!!icf.Id;
            });
            $.each(jclocaldata, function () {
                if (!this.Id) {
                    $.modalAlert('Y lệnh bất thường', "warning");
                    location.href = location.href;
                }
            });
        }
        else {
            window.alldataArray.jcyz = new Array(); //Để tiện sử dụng sau này$.each()
        }

        if (jyflag === 0) {   //Khởi tạo trang này
            gridAlreadyJCApplied();
            gridAlreadyJCGroupApplied();
            jyflag = 1;
        }

        else {
            $("#alreadyJCAppliedList").clearGridData(); //Xóa trước
            $('#alreadyJCAppliedGroupList').clearGridData();

            //Mở lại trang này
            $('#alreadyJCAppliedList').newtouchLocalDataGrid(null, jclocaldata);
            if (jclocaldata.length>0&&jclocaldata[0].sqdh !== undefined) {
                sqdh = jclocaldata[0].sqdh;
            }
            EnableExaIInlineEditBoxZT();
        }
    }


    //Danh sách
    function gridjc() {
        var $gridjc = $("#gridjc");
        $gridjc.dataGrid({
            caption: "Chọn bộ mẫu",
            height: 160,
            //multiselect: true,
            colModel: [
                { label: 'Tên hạng mục', name: 'xmmc', width: 200, align: 'center' },
                { label: 'Mã hạng mục', name: 'xmdm',width: 80, align: 'center', hidden: true },
                { label: 'Loại yêu cầu', name: 'sqlx', width: 80, align: 'left' },
                { label: 'Vị trí', name: 'bw', width: 150, align: 'left', hidden: true },
                { label: 'Số lượng', name: 'sl', width: 60, align: 'left' },
                {
                    label: 'Đơn giá', name: 'dj', width: 80, align: 'left', formatter: "number"
                    , formatoptions: { decimalPlaces: 2, defaultValue: '0.00' }
                },
                { label: 'Đơn vị', name: 'dw', width: 120, align: 'center' },
                { label: 'zxks', name: 'zxks', width: 60, align: 'center', hidden: true },
                { label: 'Bộ mẫuID', name: 'ztId', width: 60, align: 'left', hidden: true },
                { label: 'Tên bộ mẫu', name: 'ztmc', width: 120, align: 'center' },
                { label: 'Khoa thực hiện', name: 'zxksmc', width: 100, align: 'center' },
                { label: 'Có phải bảo hiểm y tế không', name: 'sfyb', width: 100, align: 'center' }
            ],
            //onSelectRow: function (rowid, status) {
            //    gridjccheck([rowid], status);
            //},
            //onSelectAll: function (aRowids, status) {
            //    gridjccheck(aRowids, status);
            //},
            gridComplete: function () {
                //ẨngridThanh cuộn dưới cùng
                $gridjc.closest(".ui-jqgrid-bdiv").css({ "overflow-x": "hidden" });

            }
        });
    }

    function gridjccheck(aRowids, status) {
        $.each(aRowids, function () {
            if (status === true) {
                addJCRow(this);
            }
            else {
                deleteJCRow(this);
            }
        });
        CalculateInsPresJCAmount($("#alreadyJCAppliedList"));
    }

    //Tính số tiền phiếu yêu cầu
    function CalculateInsPresJCAmount($grid) {
        var totalAmount = 0.00;
        var allData = $grid.jqGrid('getRowData_AllLine', null, true);
        $.each(allData, function () {
            if (!!this.zhje) {
                totalAmount += parseFloat(this.zhje);
            }
            else {
                var objId = $(this.ztId).attr('rowid');
                var sl = $("#" + objId + "_sl").val();
                totalAmount += parseFloat(this.dj * sl);
            }
        });
        $grid.jqGrid("setCaption", "已开申请单明细，申请单总金额：" + "<label style='color:red;'>￥"
            + totalAmount.toFixed(2) + "</label>");   //Đặt lạicaptionGiá trị thuộc tính
    }

    function addJCRow(sourceRowid) {
        var sourceRowData = $("#gridjc").getRowData(sourceRowid);
        var rowIds = $("#alreadyJCAppliedList").jqGrid('getDataIDs');
        for (var i = 0; i < rowIds.length; i++) {
            var currRow = $("#alreadyJCAppliedList").getRowData(rowIds[i]);
            if (currRow.xmdm === sourceRowData.xmdm) {
                return; //Đã thêm rồi  //Không được thêm trùng lặp
            }
        }

        //Thực hiệnadd
        var aRowData = {};
        aRowData.Id = Math.random().toString() + new Date().getMilliseconds();
        aRowData.xmmc = sourceRowData.xmmc;
        aRowData.xmdm = sourceRowData.xmdm;
        aRowData.sqlx = sourceRowData.sqlx;
        aRowData.bw = sourceRowData.bw;
        aRowData.sl = sourceRowData.sl;
        aRowData.dj = sourceRowData.dj;
        aRowData.ztId = sourceRowData.ztId;
        aRowData.ztmc = sourceRowData.ztmc;
        aRowData.dwwwwwww = sourceRowData.dw;
        aRowData.zxksdm = sourceRowData.zxks;
        aRowData.zxksmc = sourceRowData.zxksmc;
        aRowData.kssj = $.getTime();
        $('#alreadyJCAppliedList').newtouchLocalDataGrid(null, aRowData);
        EnableExaIInlineEditBox();
        MatchZTInfo(sourceRowid);
    }

    function deleteJCRow(sourceRowid) {
        var sourceRowData = $("#gridjc").getRowData(sourceRowid);
        var rowIds = $("#alreadyJCAppliedList").jqGrid('getDataIDs');
        for (var i = 0; i < rowIds.length; i++) {
            var currRow = $("#alreadyJCAppliedList").getRowData(rowIds[i]);
            if (currRow.xmdm === sourceRowData.xmdm) {
                //Thực hiện xóa bỏ
                $('#alreadyJCAppliedList').jqGrid("delRowData", rowIds[i]);
                return;
            }
        }
    }

    function gridAlreadyJCApplied() {
        //init Phiếu yêu cầu đã lập
        $('#alreadyJCAppliedList').newtouchLocalDataGrid({
            height: $(window).height() - 410,
            unwritten: false,
            editurl: "clientArray",
            caption: "Chi tiết phiếu đã lập, tổng số tiền phiếu:0.00",
            colModel: [
                { label: 'Id', name: 'Id', align: 'center', hidden: true },
                { label: 'Tên hạng mục', name: 'xmmc', width: 200, align: 'center' },
                { label: 'Mã hạng mục', name: 'xmdm', align: 'center', hidden: true },
                { label: 'Loại yêu cầu', name: 'sqlx', width: 80, align: 'left' },
                {
                    label: '<span class="required">*</span>Thời gian bắt đầu', name: 'kssj', width: 150, editwidth: '100%',
                    align: 'center', hidden: true,
                    editable: true, formatter: "date",
                    formatoptions: { srcformat: 'Y-m-d h:m:s', newformat: 'Y-m-d h:m:s' },
                    editoptions: {
                        dataEvents: [
                            {
                                type: 'click',
                                fn: function (e) {
                                    $(this).find('input[type=text]').addClass("input-wdatepicker");
                                    WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })
                                }
                            }
                        ]
                    },
                    formatter: function (cellvalue, options, cell) {
                        return (typeof (cellvalue) == "undefined") ? "" : cellvalue;
                    }
                },
                { label: 'Vị trí', name: 'bw', editable: true, editwidth: '97%', width: 80, align: 'center' },
                {
                    label: 'Phương pháp', name: 'bwff', editable: true, editwidth: '97%',  edittype: "select", width: 100, align: 'left', editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                }
                            }
                        ]

                    }
                },
                {
                    label: 'Số lượng', name: 'sl', width: 50, editwidth: '95%',editable: true, align: 'center',
                    editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    CalculateInsPresJCAmount();
                                }
                            }
                        ]
                    }
                },
                { label: 'Đơn giá', name: 'dj', width: 120, align: 'left' },
                { label: 'Đơn vị', name: 'dwwwwwww', width: 50, align: 'center' },
                { label: 'zxksdm', name: 'zxksdm', align: 'center', hidden: true },
                { label: 'Khoa thực hiện', name: 'zxksmc', width: 90, align: 'center' },
                { label: 'Bộ mẫuID', name: 'ztId', width: 60, align: 'center', editable: true, hidden: true },
                { label: 'Tên bộ mẫu', name: 'ztmc', width: 120, align: 'center' },
                { label: 'Có phải bảo hiểm y tế không', name: 'sfyb', width: 60, align: 'center' },
                { name: 'yzlx', hidden: true },
                { name: 'pcCode', hidden: true },
                { name: 'pcmc', hidden: true },
                { name: 'zyh', hidden: true },
                { name: 'ysgh', hidden: true },
                { name: 'zxcs', hidden: true },
                { name: 'zxzq', hidden: true },
                { name: 'zxzqdw', hidden: true }
                ],
            gridComplete: function () {
                EnableExaIInlineEditBox();
            }
        });
    }

    function EnableExaIInlineEditBox() {
        var ids = $("#alreadyJCAppliedList").getDataIDs();
        $.each(ids, function () {
            var rowid = String(this);
            //Mở chế độ chỉnh sửa
            $("#alreadyJCAppliedList").jqGrid('editRow', rowid, false, initJcIInlineFunc);
        });
    }

    function initJcIInlineFunc(rowid) {
        var cursqlx = $("#gridjc").getRowData(rowid).sqlx;
           //Lớp nổi vị trí
        if ('@ViewBag.PACSCode'.indexOf(cursqlx) > -1) {
            $("#" + rowid + "_bw").yxbwFloatingSelector({
                showtext: 'jcbw',
                attrcols: ['jcbw'],
                mutiselect: false,
                //checkItemActivity: checkItemActivity,
                itemdbclickhandler: function ($this) {
                    var mcval = $this[0].textContent;
                    $("#" + rowid + "_bw").val(mcval);
                    MatchZTInfo(rowid);
                    generatebwffinfo(rowid, mcval);
                },
            });
        } else {
            //Lớp nổi vị trí
            $("#" + rowid + "_bw").bwFloatingSelector({
                showtext: 'bwmc',
                attrcols: ['bwmc', 'bwCode'],
                //checkItemActivity: checkItemActivity,
                itemdbclickhandler: function ($this) {
                    var mcval = "";
                    if (typeof ($this) !== "undefined") {
                        $.each($this, function () {
                            mcval += this.attr('data-bwmc') + ",";

                        });
                        if (mcval.length > 0) {
                            mcval = mcval.substring(0, mcval.length - 1);
                        };
                    }
                    $("#" + rowid + "_bw").val(mcval);
                    MatchZTInfo(rowid);
                },
            });
        }
    }

    //Bộ mẫu Cùng một vị trí
    function MatchZTInfo(rowid, valiate) {
        var rtnval = true;
        var currRowZtid = $("#" + rowid + "_ztId").val();
        if (currRowZtid) {
            var allData = $("#alreadyJCAppliedList").jqGrid('getRowData_AllLine');
            $.each(allData, function () {
                var objId = $(this.ztId).attr('rowid');
                var objZtid = $("#" + objId + "_ztId").val();
                if (objZtid == currRowZtid && objId != rowid) {
                    currRowbw = $("#" + rowid + "_bw").val();
                    if (valiate && currRowbw != $("#" + objId + "_bw").val()) {//Khi xác thực, trả vềtrue or false
                        rtnval == false;
                    } else {
                        $("#" + objId + "_bw").val(currRowbw);
                    }

                }
            })
        }
        return rtnval;
    }


    //Phương pháp tạo vị trí
    function generatebwffinfo(rowid, $thisval) {
        $.najax({
            url: "/SystemManage/BodyParts/GetYxBodyMethod",
            data: { keyword: $thisval },
            dataType: "json",
            type: "POST",
            success: function (data) {
                $("#" + rowid + "_bw").parent().next().children('select').html('');
                var yslboption = "<option>Vui lòng chọn</option>";
                if (data != undefined && data.length > 0) {
                    $.each(data, function (idx, val) {
                        yslboption += "<option value=" + val + ">" + val + "</option>";
                    });
                    $("#" + rowid + "_bw").parent().next().children('select').append(yslboption);
                } else {
                    $("#" + rowid + "_bw").parent().next().children('select').html('').attr("disabled", 'true').css('background-color', '#f6f7fb');
                }
            }
        });
    }

    function GetSqdhMethod() {
        if (sqdh=="") {
            $.najax({
                url: "/DoctorManage/Apply/GetSqdhMethod",
                dataType: "json",
                type: "POST",
                async: false,
                success: function (resp) {
                    sqdh = resp.data;

                }
            });
        }
        return sqdh;
    }


    //Hành động nút Lưu
    function SaveExamination(savetodb) {
        //Lấy tất cả các dòngId，duyệt để khung chỉnh sửa ở trạng thái lưu
        var rowIds = $("#alreadyJCAppliedList").jqGrid('getDataIDs');
        if (rowIds.length < 1) {
            $.modalAlert("Thiếu dữ liệu y lệnh", "warning");
            return;
        }
        for (var i = 0; i < rowIds.length; i++) {
            var saveResult = $("#alreadyJCAppliedList").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);
            if (!saveResult) {
                EnableExaIInlineEditBox();    //Khởi động lại và bật chỉnh sửa Nếu không, lần sauSavethì sẽ trả vềfalse
                    return;   //Lưu thất bại, thìreturn
                }

        }
        var gridjcData = $("#alreadyJCAppliedList").jqGrid('getRowData_AllLine', null, true);
        if (gridjcData.length < 1) {
            $.modalAlert("Hiện không có nội dung đã lưu", 'warning');
        }
        $.each(gridjcData, function () {
            delete this.jqRowId;   //Loại bỏjqRowId
            this.yzlx =@Html.Raw(((int)EnumYzlx.jc).ToString());
            this.zyh = currentobj.zyh;
            this.ysgh = '@ViewBag.ysgh';
            this.pcCode = '@ViewBag.pccode';
            this.pcmc = '@ViewBag.pcmc';
            this.zxcs = '@ViewBag.zxcs';
            this.zxzq = '@ViewBag.zxzq';
            this.zxzqdw = '@ViewBag.zxzqdw';
            this.ypjl = '1';
            this.sqdh = GetSqdhMethod();
            this.yzlb = "临";
            this.lcyx = $('#txt_jc_lcyx').val();
            this.sqbz = $('#txt_jc_sqbz').val();
        });

        //Lưu dữ liệu
        window.alldataArray.jcyz = $.jsonWhere(window.alldataArray.jcyz, function (iyzmx) {
            if (!!!iyzmx.Id) {
                return false;   //Trong danh sách chỉnh sửa có
            }
            for (var iIndex = 0; iIndex < gridjcData.length; iIndex++) {
                if (gridjcData[iIndex].Id === iyzmx.Id) {
                    return false;
                }
            }
            return true;
        });

        $.each(gridjcData, function () {
            window.alldataArray.jcyz.unshift(this);
        });

        jclocaldata = new Array();
        if (savetodb=='1') {
            submitService(gridjcData);
            window.alldataArray.jcyz = [];
            sqdh = "";
            $("#alreadyJCAppliedList").jqGrid("setCaption", "已开申请单明细，申请单总金额：0.00");   //Đặt lạicaptionGiá trị thuộc tính
        }
    }

    /********************************************************/
   //Hiển thị chọn bộ mẫu kiểm tra
    function gridAlreadyJCGroupApplied() {
        $('#alreadyJCAppliedGroupList').newtouchLocalDataGrid({
            height: $(window).height() - 410,
            unwritten: false,
            caption: "Chi tiết phiếu đã lập, tổng số tiền phiếu:0.00",
            editurl: "clientArray",
            colModel: [
                { label: 'Bộ mẫuID', name: 'ztId', width: 60, align: 'left', key: true, editable: true, hidden: true },
                { label: 'mbId', name: 'mbId', width: 60, align: 'left', hidden: true },
                { label: 'Tên bộ mẫu', name: 'ztmc', width: 150, align: 'left' },
                { label: 'Vị trí', name: 'bw', editable: true, editwidth: '97%', width: 150, align: 'center' },
                {
                    label: 'Phương pháp', name: 'bwff', editable: true, editwidth: '97%', edittype: "select", width: 150, align: 'left', editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                }
                            }
                        ]

                    }
                },
                {
                    label: 'Số tiền', name: 'zhje', width: 80, align: 'center', formatter: "number"
                    , formatoptions: { decimalPlaces: 2, defaultValue: '0.00' }
                },
                { label: 'zxksdm', name: 'zxksdm', align: 'center', hidden: true },
                { label: 'Khoa thực hiện', name: 'zxksmc', width: 80, align: 'center' },
                { label: 'Loại yêu cầu', name: 'sqlx', width: 70, align: 'left' },
                { label: 'Thao tác', name: 'action', width: 60, align: 'center' },
            ],
            gridComplete: function () {
                EnableExaIInlineEditBoxZT();
            }
        });
    }

    function EnableExaIInlineEditBoxZT() {
        var ids = $("#alreadyJCAppliedGroupList").getDataIDs();
        $.each(ids, function () {
            var rowid = String(this);
            //Mở chế độ chỉnh sửa
            $("#alreadyJCAppliedGroupList").jqGrid('editRow', rowid, false, initJcIInlineZTFunc);
        });

    }
    function initJcIInlineZTFunc(rowid) {
        var cursqlx = $("#alreadyJCAppliedGroupList").getRowData(rowid).sqlx;//$("#" + rowid + "_sqlx").val();
           //Lớp nổi vị trí
        if ('@ViewBag.PACSCode'.indexOf(cursqlx) > -1) {
            $("#" + rowid + "_bw").yxbwFloatingSelector({
                showtext: 'jcbw',
                attrcols: ['jcbw'],
                mutiselect: false,
                //checkItemActivity: checkItemActivity,
                itemdbclickhandler: function ($this) {
                    var mcval = $this[0].textContent;
                    $("#" + rowid + "_bw").val(mcval);
                    MatchZTInfo(rowid);
                    generatebwffinfo(rowid, mcval);
                },
            });
        } else {
            //Lớp nổi vị trí
            $("#" + rowid + "_bw").bwFloatingSelector({
                showtext: 'bwmc',
                attrcols: ['bwmc', 'bwCode'],
                //checkItemActivity: checkItemActivity,
                itemdbclickhandler: function ($this) {
                    var mcval = "";
                    if (typeof ($this) !== "undefined") {
                        $.each($this, function () {
                            mcval += this.attr('data-bwmc') + ",";

                        });
                        if (mcval.length > 0) {
                            mcval = mcval.substring(0, mcval.length - 1);
                        };
                    }
                    $("#" + rowid + "_bw").val(mcval);
                    MatchZTInfo(rowid);
                },
            });
        }
    }


    //Hành động nút Lưu
    function SaveExaminationZT(savetodb) {
        //if (yjjzhmsg)
        //{
        //    $.modalAlert(yjjzhmsg, 'warning');
        //    return;
        //}
        var gridjcData;
        //Lấy tất cả các dòngId，duyệt để khung chỉnh sửa ở trạng thái lưu
        var rowIds = $("#alreadyJCAppliedGroupList").jqGrid('getDataIDs');
        if (rowIds.length < 1) {
            $.modalAlert("Thiếu dữ liệu y lệnh", "warning");
            return;
        }
        for (var i = 0; i < rowIds.length; i++) {
            var saveResult = $("#alreadyJCAppliedGroupList").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);
            if (!saveResult) {
                EnableExaIInlineEditBoxZT();    //Khởi động lại và bật chỉnh sửa Nếu không, lần sauSavethì sẽ trả vềfalse
                    return;   //Lưu thất bại, thìreturn
                }
        }
        var jcmbId = $("#alreadyJCAppliedGroupList").getRowData(rowIds[0]).mbId;
        $.najax({
            url: "/TemplateManage/InspectionTemplate/GetGPackageDetailByZtIdArray",
            data: { ztId: rowIds,mbId:jcmbId },
            dataType: "json",
            type: "POST",
            async: false,
            success: function (data) {
                gridjcData = data;
                $.each(gridjcData, function () {
                    this.bw = $("#alreadyJCAppliedGroupList").getRowData(this.ztId).bw;
                    this.bwff = $("#alreadyJCAppliedGroupList").getRowData(this.ztId).bwff;
                    this.lcyx = $('#txt_jc_lcyx').val();
                    this.sqbz = $('#txt_jc_sqbz').val();
                    this.yzlx =@Html.Raw(((int)EnumYzlx.jc).ToString());
                    this.zyh = currentobj.zyh;
                    this.ysgh = '@ViewBag.ysgh';
                    this.pcCode = '@ViewBag.pccode';
                    this.pcmc = '@ViewBag.pcmc';
                    this.zxcs = '@ViewBag.zxcs';
                    this.zxzq = '@ViewBag.zxzq';
                    this.zxzqdw = '@ViewBag.zxzqdw';
                    this.ypjl = '1';
                    this.sqdh = GetSqdhMethod();
                    this.yzlb = "临";
                    this.kssj = $.getTime();
                    this.zxksdm = this.zxks;
                    this.ztmbId=jcmbId;
                    this.isjffffff='@ViewBag.openYjzxSwitch'=="ON" ? 0:1 //Khi công tắc thực hiện của khoa kỹ thuật y tế đang bật, thực hiện y lệnh không tính vào phí Sau khi kỹ thuật y tế thực hiện thì tính vào phí
                });
            }
        });

        //Lưu dữ liệu
        window.alldataArray.jcyz = $.jsonWhere(window.alldataArray.jcyz, function (iyzmx) {
            if (!!!iyzmx.Id) {
                return false;   //Trong danh sách chỉnh sửa có
            }
            for (var iIndex = 0; iIndex < gridjcData.length; iIndex++) {
                if (gridjcData[iIndex].Id === iyzmx.Id) {
                    return false;
                }
            }
            return true;
        });

        $.each(gridjcData, function () {
            window.alldataArray.jcyz.unshift(this);
        });

        jclocaldata = new Array();
        if (savetodb=='1') {
            submitService(gridjcData);
            window.alldataArray.jcyz = [];
            sqdh = "";
            $("#alreadyJCAppliedGroupList").jqGrid("setCaption", "已开申请单明细，申请单总金额：0.00");   //Đặt lạicaptionGiá trị thuộc tính
        }
    }

</script>


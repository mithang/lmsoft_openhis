@{
    //CóKhôngbậtlis pacsbáo cáoĐăng ký
    var IsreportOpen = SysConfigReader.String("IsreportOpen");
    var pacsHost = SiteUrl.GetUrl("OuterPacsServiceHost", "");
    var curOpr = NewtouchHIS.Lib.Framework.Operator.OperatorProvider.GetCurrent();
 }
<div id="floatLisReportDiv">
    <div data-href="ynbg"><span>Trong việnBáo cáo</span></div>
</div>
<div id="floadLisReportTree" style="display:none;z-index:1;background: white;">
    <div class="panel-body">
        <table class="form">
            <tr>
                <td class="formValue">
                    <input class="btn btn-info md" id="btn_pacs" style="width: 60px;" value="PACSBáo cáo" />
                </td>
            </tr>
            <tr>
                <td class="formValue">
                    <input class="btn btn-info md" id="btn_lis_report" style="width: 60px;" value="LISBáo cáo" />
                </td>
            </tr>
            @*<tr>
                    <td class="formValue">
                        <input class="btn btn-info md" id="btn_bc" style="width: 100px;" value="Báo cáo siêu âm B" />
                    </td>
                </tr>
                <tr>
                    <td class="formValue">
                        <input class="btn btn-info md" id="btn_xd" style="width: 100px;" value="Báo cáo điện tim" />
                    </td>
                </tr>*@
        </table>
    </div>
</div>
<script>
    function cfLeftFloatHide() {
        $("#floatLisReportDiv div").removeClass("activepart");
        $('#floadLisReportTree').hide();
    }

    $('.contentPanel').on('click', function () {
        cfLeftFloatHide();
    });
    $("#floatLisReportDiv div").on("click", function (e) {
        e.preventDefault();
        if ($(this).hasClass('activepart')) {
            //lạiđiểmnhấp Ẩn
            $("#floatLisReportDiv div").removeClass("activepart");
            $('#floadLisReportTree').hide();
        }
        else {
            $("#floatLisReportDiv div").removeClass("activepart");
            $(this).addClass("activepart");
            $('#floadLisReportTree').show();
        }
    })
    $('#btn_pacs').click(function () {
        debugger
        var zyh = "";
        if ($("#zyh").val())
            zyh = $("#zyh").val();//Điều dưỡngtrạmBệnh nhântrongtimSố nhập việnLấy
        else
            zyh=currentobj.zyh;
        if ("@IsreportOpen" == "true") {
            $.modalOpen({
                id: "medicaljyForm",
                title: "Kiểm traPhiếuDanh sách",
                url: "/MedicalRecord/PacsSqdhQueryForm?mzzyh=" + zyh + "&type=" + "zy",
                width: "900px",
                height: "600px",
                btn: ['', 'Đóng'],
                btnclass: ['', 'btn btn-danger'],
            });
        } else {
            //Jinfeng Yitong PACS 2024-4-28 chl
            $.ajax({
                type: "POST",
                dataType: "json", //Quay lạijsondữ liệu dạng
                url: "/DoctorsAdvice/CountLISztzy",
                data: { "zyh": currentobj.zyh },
                async: false,
                success: function (data) {
                    var num = data.num;
                    if (num < 1) {
                        $.modalAlert("Hiện tạiKhông cóĐã hoàn thànhBáo cáo,Không thểXem", 'warning');
                        return;
                    }
                    else {
                        window.open("@pacsHost/doctor-api/api/viewer?type=2&pid=" + currentobj.blh + "&areaCode=" + "@curOpr.OrganizeId", "_blank");

                    }
                }
            });
        }
    })
    $('#btn_lis_report').click(function () {
        debugger
        var zyh = "";
        if ($("#zyh").val())
            zyh = $("#zyh").val();//Điều dưỡngtrạmBệnh nhântrongtimSố nhập việnLấy
        else
            zyh=currentobj.zyh;

        if ("@IsreportOpen" == "true") {
            $.modalOpen({
                id: "medicaljyForm",
                title: "Xét nghiệmPhiếuDanh sách",
                url: "/MedicalRecord/LisSqdhQueryForm?mzzyh=" + zyh + "&type=" + "zy",
                width: "900px",
                height: "600px",
                btn: ['', 'Đóng'],
                btnclass: ['', 'btn btn-danger'],
            });
        } else {
            $.ajax({
                type: "POST",
                dataType: "json", //Quay lạijsondữ liệu dạng
                url: "/DoctorsAdvice/CountLISztzy",
                data: { "zyh": currentobj.zyh },
                async: false,
                success: function (data) {
                    var num = data.num;
                    if (num < 1) {
                        $.modalAlert("Hiện tạiKhông cóĐã hoàn thànhBáo cáo,Không thểXem", 'warning');
                        return;
                    }
                    else {
                        window.open("@pacsHost/doctor-api/api/viewer?type=1&pid=" + currentobj.blh + "&areaCode=" + "@curOpr.OrganizeId", "_blank");
                    }
                }
            });
        }
    })

</script>
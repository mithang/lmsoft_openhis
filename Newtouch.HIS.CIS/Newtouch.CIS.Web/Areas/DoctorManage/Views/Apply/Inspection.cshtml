@using Newtouch.Infrastructure
@{
    ViewBag.Title = "Inspection";
    Layout = null;
}
<style>
    /*.gview_alreadyJYAppliedList {
        width: 770px !important
    }*/
</style>
<div id="linkjy" role="tabpanel" class="tab-pane" style="width:70.5%;float:right; margin-right: 10px; border:solid 1px #ddd; margin-top: 3px;">
    <div style="background-color: #fff;">
        <table id="gridjy"></table>
    </div>
    <div id="divGridjy" style="background-color:white;display:none;">
        <table id="alreadyJYAppliedList"></table>
    </div>
    <div id="divGridjyzh" style="background-color:white">
        <table id="alreadyJYAppliedGroupList"></table>
    </div>
    <table class="form">
        <tr>
            <td class="formTitle">
                Ấn tượng lâm sàng
            </td>
            <td class="formValue">
                <input id="txt_jy_lcyx" name="txt_jy_lcyx" type="text" class="form-control" />
            </td>
            <td class="formTitle">
                Ghi chú yêu cầu
            </td>
            <td class="formValue">
                <input id="txt_jy_sqbz" name="txt_jy_sqbz" type="text" class="form-control" />
            </td>
            <td style="width:100px;"></td>
            <td style="width:100px;"></td>
        </tr>
        <tr>
            <td colspan="4"></td>
            <td class="formValue">
                <input type="button" class="btn btn-primary" value="Lưu phiếu yêu cầu" style="display:table-cell" onclick="SaveInspectionbyZt('1')" />
            </td>
        </tr>
    </table>
</div>

<script>
    var jyflag = 0;
    var jylocaldata = new Array();
    var jysqdh = "";
    $(function () {
        gridjy();
        gridAlreadyJYApplied();
        gridAlreadyJYGroupApplied();
    });

    function init_jyPrescription() {

        //Chỉ y lệnh chưa lưu vào cơ sở dữ liệu mới cần khởi tạo tronggridtrong
        jylocaldata = new Array();
        if (window.alldataArray.jyyz) {
            jylocaldata = $.jsonWhere($.deepClone.clone(window.alldataArray.jyyz), function (icf) {
                return !!!icf.Id;
            });
            $.each(jylocaldata, function () {
                if (!this.Id) {
                    $.modalAlert('Y lệnh bất thường', "warning");
                    location.href = location.href;
                }
            });
        }
        else {
            window.alldataArray.jyyz = new Array(); //Để tiện sử dụng sau này$.each()
        }

        if (jyflag == 0) {   //Khởi tạo trang này
            gridAlreadyJYApplied();
            gridAlreadyJYGroupApplied();
            jyflag = 1;
        }

        else {
            $("#alreadyJYAppliedList").clearGridData(); //Xóa trước
            //Mở lại trang này
            $('#alreadyJYAppliedList').newtouchLocalDataGrid(null, jylocaldata);
            if (jylocaldata.length>0&&jylocaldata[0].sqdh !== undefined) {
                jysqdh = jclocaldata[0].sqdh;
            }
        }
    }


    //Danh sách bộ mẫu
    function gridjy() {
        var $gridjy = $("#gridjy");
        $gridjy.dataGrid({
            caption: "Chọn bộ mẫu",
            height: 130,
            unwritten: false,
            //multiselect: true,
			colModel: [
				{ label: 'Sắp xếp', name: 'px', width: 60, align: 'left', hidden: true },
                { label: 'Tên hạng mục', name: 'xmmc', width: 200, align: 'center' },
                { label: 'Mã hạng mục', name: 'xmdm', width: 120, align: 'center' },
                {
                    label: 'Đơn giá', name: 'dj', width: 100, align: 'center', formatter: "number"
                    , formatoptions: { decimalPlaces: 2, defaultValue: '0.00' }
                },
                { label: 'Đơn vị', name: 'dw', width: 100, align: 'center' },
                { label: 'Số lượng', name: 'sl', width: 80, align: 'center' },
                { label: 'zxks', name: 'zxks', width: 60, align: 'center', hidden: true },
                { label: 'Khoa thực hiện', name: 'zxksmc', width: 120, align: 'center' },
                { label: 'Có phải bảo hiểm y tế không', name: 'sfyb', width: 60, align: 'center' },
                { label: 'Bộ mẫuID', name: 'ztId', width: 60, align: 'left', hidden: true },
                { label: 'Tên bộ mẫu', name: 'ztmc', width: 150, align: 'center' }
            ],
            //onSelectRow: function (rowid, status) {
            //    gridjycheck([rowid], status);
            //},
            //onSelectAll: function (aRowids, status) {
            //    gridjycheck(aRowids, status);
            //},
            gridComplete: function () {
                //ẨngridThanh cuộn dưới cùng
                $gridjy.closest(".ui-jqgrid-bdiv").css({ "overflow-x": "hidden" });
            }
        });
    }

    function gridjycheck(aRowids, status) {
        $.each(aRowids, function () {
            if (status === true) {
              //190301 Bệnh nhân bảo hiểm y tế không thể thêm hạng mục tự trả, chưa xác nhận có dùng y lệnh nhập viện không
                @*if (window.currPatientInfo.brxzCode != "" &&'@ViewBag.ControlbrxzCode'.indexOf(window.currPatientInfo.brxzCode) > -1 && this.sfyb == "否") {
                     $.modalAlert("Bệnh nhân này là bệnh nhân bảo hiểm y tế, không được chọn hạng mục tự trả【" + this.xmmc + "】", "warning");
                     $("#gridjy").jqGrid('setSelection', rowid, false); //Cài đặtjqGridChọn
                    return;
                }*@
                addJYRow(this);
            }
            else {
                deleteJYRow(this);
            }
        });
        CalculateInsPresJYAmount($("#alreadyJYAppliedList"));
        
    }

    function addJYRow(sourceRowid) {
        var sourceRowData = $("#gridjy").getRowData(sourceRowid);
        var rowIds = $("#alreadyJYAppliedList").jqGrid('getDataIDs');
        for (var i = 0; i < rowIds.length; i++) {
            var currRow = $("#alreadyJYAppliedList").getRowData(rowIds[i]);
            if (currRow.xmdm === sourceRowData.xmdm) {
                return; //Đã thêm rồi  //Không được thêm trùng lặp
            }
        }
        //Thực hiệnadd
        var aRowData = {};
        aRowData.Id = Math.random().toString() + new Date().getMilliseconds();
        aRowData.xmmc = sourceRowData.xmmc;
        aRowData.xmdm = sourceRowData.xmdm;
        aRowData.dj = sourceRowData.dj;
        aRowData.sl = sourceRowData.sl;
        aRowData.dwwwwwww = sourceRowData.dw;
        aRowData.zxksdm = sourceRowData.zxks;
        aRowData.zxksmc = sourceRowData.zxksmc;
        aRowData.ztId = sourceRowData.ztId;
        aRowData.ztmc = sourceRowData.ztmc;
        aRowData.pcCode = "00";
        aRowData.pcmc = "ST";
        aRowData.kssj = $.getTime();
        aRowData.yzlb = "临";
        $('#alreadyJYAppliedList').newtouchLocalDataGrid(null, aRowData);
    }

    function deleteJYRow(sourceRowid) {
        var sourceRowData = $("#gridjy").getRowData(sourceRowid);
        var rowIds = $("#alreadyJYAppliedList").jqGrid('getDataIDs');
        for (var i = 0; i < rowIds.length; i++) {
            var currRow = $("#alreadyJYAppliedList").getRowData(rowIds[i]);
            if (currRow.xmdm === sourceRowData.xmdm) {
                //Thực hiện xóa bỏ
                $('#alreadyJYAppliedList').jqGrid("delRowData", rowIds[i]);
                return;
            }
        }
    }

    //Tính số tiền phiếu yêu cầu
    function CalculateInsPresJYAmount($grid) {
        var totalAmount = 0.00;
        var allData = $grid.jqGrid('getRowData_AllLine', null, true);
        $.each(allData, function () {
            if (!!this.dj) {
                totalAmount += parseFloat(this.dj) * parseFloat(this.sl);
            }
            else if (!!this.zhje) {
                totalAmount += parseFloat(this.zhje);
            }
        });
        $grid.jqGrid("setCaption", "已开申请单明细，申请单总金额：" + "<label style='color:red;'>￥"
            + totalAmount.toFixed(2) + "</label>");   //Đặt lạicaptionGiá trị thuộc tính
    }

    function gridAlreadyJYApplied() {
        $('#alreadyJYAppliedList').newtouchLocalDataGrid({
            height: $(window).height() - 410,
            unwritten: false,
            caption: "Chi tiết phiếu đã lập, tổng số tiền phiếu:0.00",
            editurl: "clientArray",
            colModel: [
                { label: 'Id', name: 'Id', align: 'center', hidden: true },
                { label: 'Tên hạng mục', name: 'xmmc', width: 150, align: 'center' },
                {
                    label: '<span class="required">*</span>Thời gian bắt đầu', name: 'kssj', width: 180, editwidth: '100%',
                    align: 'center', hidden: true,
                    editable: true, formatter: "date",
                    formatoptions: { srcformat: 'Y-m-d h:m:s', newformat: 'Y-m-d h:m:s' },
                    editoptions: {
                        dataEvents: [
                            {
                                type: 'click',
                                fn: function (e) {
                                    $(this).find('input[type=text]').addClass("input-wdatepicker");
                                    WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' });
                                }
                            }
                        ]
                    },
                    formatter: function (cellvalue, options, cell) {
                        return (typeof (cellvalue) == "undefined") ? "" : cellvalue;
                    }
                },
                { label: 'Mã hạng mục', name: 'xmdm', width: 100, align: 'center' },
                { label: 'Đơn giá', name: 'dj', width: 100, align: 'center' },
                { label: 'Đơn vị', name: 'dwwwwwww', width: 100, align: 'center' },
                { label: 'Số lượng', name: 'sl', width: 80, align: 'center' },
                { label: 'zxksdm', name: 'zxksdm', width: 60, align: 'center', hidden: true },
                { label: 'Khoa thực hiện', name: 'zxksmc', width: 150, align: 'center' },
                { label: 'Có phải bảo hiểm y tế không', name: 'sfyb', width: 60, align: 'center' },
                { label: 'Bộ mẫuID', name: 'ztId', width: 60, align: 'left', editable: true, hidden: true },
                { label: 'Tên bộ mẫu', name: 'ztmc', width: 120, align: 'center' },
                //{ name: 'sl', hidden: true },
                { name: 'yzlx', hidden: true },
                { name: 'zyh', hidden: true },
                { name: 'ysgh', hidden: true },
                { name: 'pcCode', hidden: true },
                { name: 'pcmc', hidden: true },
                { label: 'zxcs', name: 'zxcs', editable: true, hidden: true },
                { label: 'zxzq', name: 'zxzq', editable: true, hidden: true },
                { label: 'zxzqdw', name: 'zxzqdw', editable: true, hidden: true }],
                gridComplete: function () {
                    EnableInInlineEditBox();
            }
        });
    }

    function GetjySqdhMethod() {
        if (jysqdh == "") {
            $.najax({
                url: "/DoctorManage/Apply/GetSqdhMethod",
                dataType: "json",
                type: "POST",
                async: false,
                success: function (resp) {
                    jysqdh = resp.data;

                }
            });
        }
        return jysqdh;
    }

    //Hành động nút Lưu
    function SaveInspection(savetodb) {
        //Lấy tất cả các dòngId，duyệt để khung chỉnh sửa ở trạng thái lưu
        var rowIds = $("#alreadyJYAppliedList").jqGrid('getDataIDs');
        if (rowIds.length < 1) {
            $.modalAlert("Thiếu dữ liệu y lệnh", "warning");
            return;
        }
        for (var i = 0; i < rowIds.length; i++) {
            var saveResult = $("#alreadyJYAppliedList").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);
                if (!saveResult) {
                    EnableInInlineEditBox();    //Khởi động lại và bật chỉnh sửa Nếu không, lần sauSavethì sẽ trả vềfalse
                    return;   //Lưu thất bại, thìreturn
                }

        }
        var gridjyData = $("#alreadyJYAppliedList").jqGrid('getRowData_AllLine', null, true);
        if (gridjyData.length < 1) {
            $.modalAlert("Hiện không có nội dung đã lưu", 'warning');
        }
        $.each(gridjyData, function () {
            delete this.jqRowId;   //Loại bỏjqRowId
            this.yzlx =@Html.Raw(((int)EnumYzlx.jy).ToString());
            this.zyh = currentobj.zyh;
            this.ysgh = '@ViewBag.ysgh';
            this.zxcs = '@ViewBag.zxcs';
            this.zxzq = '@ViewBag.zxzq';
            this.zxzqdw = '@ViewBag.zxzqdw';
            this.ypjl = '1';
            this.sqdh = GetjySqdhMethod();
            this.yzlb = "临";
            this.lcyx = $('#txt_jy_lcyx').val();
            this.sqbz = $('#txt_jy_sqbz').val();
        });
        //Lưu dữ liệu
        window.alldataArray.jyyz = $.jsonWhere(window.alldataArray.jyyz, function (iyzmx) {
            if (!!!iyzmx.Id) {
                return false;   //Trong danh sách chỉnh sửa có
            }
            for (var iIndex = 0; iIndex < gridjyData.length; iIndex++) {
                if (gridjyData[iIndex].Id == iyzmx.Id) {
                    return false;
                }
            }
            return true;
        });

        $.each(gridjyData, function () {
            window.alldataArray.jyyz.unshift(this);
        });

        jylocaldata = new Array();
        if (savetodb === '1') {
            submitService(gridjyData);
            window.alldataArray.jyyz = [];
            jysqdh = "";
            $("#alreadyJYAppliedList").jqGrid("setCaption", "已开申请单明细，申请单总金额：0.00");   //Đặt lạicaptionGiá trị thuộc tính
        }

    }
    //Bật chỉnh sửa trong dòng
    function EnableInInlineEditBox() {
        var ids = $("#alreadyJYAppliedList").getDataIDs();
        $.each(ids, function () {
            var rowid = String(this);
            //Mở chế độ chỉnh sửa
            $("#alreadyJYAppliedList").jqGrid('editRow', rowid, true);
        });
    }

    /********************************************************/
    //Hiển thị chọn tổ hợp xét nghiệm
    function gridAlreadyJYGroupApplied() {
        $('#alreadyJYAppliedGroupList').newtouchLocalDataGrid({
            height: $(window).height() - 410,
            unwritten: false,
            caption: "Chi tiết phiếu đã lập, tổng số tiền phiếu:0.00",
            editurl: "clientArray",
            colModel: [
                { label: 'Bộ mẫuID', name: 'ztId', width: 60, align: 'left', key: true,  hidden: true },
                 { label: 'mbId', name: 'mbId', width: 60, align: 'left', hidden: true },
                { label: 'Tên bộ mẫu', name: 'ztmc', width: 300, align: 'left' },                
                {
                    label: 'Số tiền', name: 'zhje', width: 100, align: 'center', formatter: "number"
                    , formatoptions: { decimalPlaces: 2, defaultValue: '0.00' }},
                { label: 'zxksdm', name: 'zxksdm', width: 60, align: 'center', hidden: true },
                { label: 'Khoa thực hiện', name: 'zxksmc', width: 150, align: 'center' },
                { label: 'Thao tác', name: 'action', width: 150, align: 'center' },
                ],
            gridComplete: function () {
            }
        });
    }

    //Hành động nút lưu theo bộ mẫu
    function SaveInspectionbyZt(savetodb) {
        //if (yjjzhmsg)
        //{
        //    $.modalAlert(yjjzhmsg, 'warning');
        //    return;
        //}
        var gridjyData;
        //Lấy tất cả các dòngId，duyệt để khung chỉnh sửa ở trạng thái lưu
        var rowIds = $("#alreadyJYAppliedGroupList").jqGrid('getDataIDs');
        if (rowIds.length < 1) {
            $.modalAlert("Thiếu dữ liệu y lệnh", "warning");
            return;
        }
        var jymbId = $("#alreadyJYAppliedGroupList").getRowData(rowIds[0]).mbId;
        $.najax({
            url: "/TemplateManage/InspectionTemplate/GetGPackageDetailByZtIdArray",
            data: { ztId: rowIds,mbId:jymbId  },
            dataType: "json",
            type: "POST",
            async: false,
            success: function (data) {
                gridjyData = data;
                $.each(gridjyData, function () {
                    this.pcCode = "00";
                    this.pcmc = "ST";
                    this.kssj = $.getTime();
                    this.yzlb = "临";
                    this.yzlx =@Html.Raw(((int)EnumYzlx.jy).ToString());
                    this.zyh = currentobj.zyh;
                    this.ysgh = '@ViewBag.ysgh';
                    this.zxcs = '@ViewBag.zxcs';
                    this.zxzq = '@ViewBag.zxzq';
                    this.zxzqdw = '@ViewBag.zxzqdw';
                    this.ypjl = '1';
                    this.sqdh = GetjySqdhMethod();
                    this.lcyx = $('#txt_jy_lcyx').val();
                    this.sqbz = $('#txt_jy_sqbz').val();
                    this.zxksdm = this.zxks;
                    this.ztmbId=jymbId;
                    this.isjffffff='@ViewBag.openYjzxSwitch'=="ON" ? 0:1 //Khi công tắc thực hiện của khoa kỹ thuật y tế đang bật, thực hiện y lệnh không tính vào phí Sau khi kỹ thuật y tế thực hiện thì tính vào phí
                });

            }
        });
        window.alldataArray.jyyz = $.jsonWhere(window.alldataArray.jyyz, function (iyzmx) {
            if (!!!iyzmx.Id) {
                return false;   //Trong danh sách chỉnh sửa có
            }
            for (var iIndex = 0; iIndex < gridjyData.length; iIndex++) {
                if (gridjyData[iIndex].Id == iyzmx.Id) {
                    return false;
                }
            }
            return true;
        });

        $.each(gridjyData, function () {
            window.alldataArray.jyyz.unshift(this);
        });

        jylocaldata = new Array();
        if (savetodb === '1') {
            submitService(gridjyData);
            window.alldataArray.jyyz = [];
            jysqdh = "";
            $("#alreadyJYAppliedGroupList").jqGrid("setCaption", "已开申请单明细，申请单总金额：0.00");   //Đặt lạicaptionGiá trị thuộc tính
        }

    }
</script>


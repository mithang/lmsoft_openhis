	//LưuNútthao tác
	function SaveRehabMedicine(savetodb) {
	    //if (yjjzhmsg)
	    //{
	    //    $.modalAlert(yjjzhmsg, 'warning');
	    //    return;
	    //}
		patobjValidate();
		//Lấytất cả các dòngId，duyệt đểSửakhung ở trạng tháiLưuTrạng thái
		var rowIds = $("#gridkfxm").jqGrid('getDataIDs');
		for (var i = 0; i < rowIds.length; i++) {
			var saveResult = $("#gridkfxm").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);
			if (!saveResult) {
				EnableRehabEditBox();    //khởi động lạiKích hoạtSửa Khôngthì lần sau lầnSavekhisẽQuay lạifalse
				return;   //Lưu thất bại，thìreturn
			}
		}
		var gridkfxmData = $("#gridkfxm").jqGrid('getRowData_AllLine', null, true);
		if (gridkfxmData.length<1) {
			$.modalAlert("Hiện tại không có nội dung y lệnh đã lưu", 'warning');
		}
		var gridSimpleData = [];
		var flag = false;
		$.each(gridkfxmData, function () {    //Bỏaction
			for (var i = 0; i < $(this).length; i++) {
				delete $(this)[i].action;
				$(this)[i].ysgh = '@ViewBag.ysgh';
				var sl = calitemslByobj(this);
				if (!sl && savetodb == '1') {
					$.modalAlert("Tính toánSố lượngthất bại", "warning");
					flag = true;
					return false;
				} else if (sl) {
					$(this)[i].sl = sl;
				}
				if (savetodb == '1') {
					if (this.xmmc == undefined || this.xmmc == "") {
						$.modalAlert("ThiếuMục", "warning");
						flag = true;
						return false;
					}else if(this.zxksmc==undefined ||this.zxksmc==""){
					    $.modalAlert("ThiếuKhoa thực hiện", "warning");
					    flag = true;
					    return false;
					} else if (this.kssj == undefined || this.kssj == "") {
						$.modalAlert("ThiếuThời gian bắt đầu", "warning");
						flag = true;
						return false;
                    } else if (this.kssj < window.currentobj.ryrq) {
                        $.modalAlert("[" + this.xmmc + "]Thời gian bắt đầuKhông được sớm hơnNhập việnThời gian Ngày nhập viện:" + window.currentobj.ryrq, "warning");
                        flag = true;
                        return false;
                    } else if (this.dw == undefined || this.dw == "") {
						$.modalAlert("ThiếuThời gian bắt đầu", "warning");
						flag = true;
						return false;
					} else if (this.ypjl == undefined || this.ypjl == "") {
						$.modalAlert("ThiếuThời gian bắt đầu", "warning");
						flag = true;
						return false;
					}else if (this.pcmc == undefined || this.pcmc == "") {
						$.modalAlert("ThiếuTần suất", "warning");
						flag = true;
						return false;
					}
				}
			}
		});

		if (flag) {
			EnableRehabEditBox();
			return;
		}

		//Lưu dữ liệu
		window.alldataArray.kfyz = $.jsonWhere(window.alldataArray.kfyz, function (iyzmx) {
			if (!!!iyzmx.Id) {
				return false;   //Sửatrong danh sách có
			}
			for (var iIndex = 0; iIndex < gridkfxmData.length; iIndex++) {
				if (gridkfxmData[iIndex].Id == iyzmx.Id) {
					return false;
				}
			}
			return true;
		});

		$.each(gridkfxmData, function () {
			window.alldataArray.kfyz.unshift(this);
		});

		itemlocaldata = new Array();


		if (savetodb=='1') {
			submitService(gridkfxmData);
			window.alldataArray.kfyz = [];
		}
	}

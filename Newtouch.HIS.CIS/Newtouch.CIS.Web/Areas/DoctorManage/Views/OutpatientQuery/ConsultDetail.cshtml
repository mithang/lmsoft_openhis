
@{
    ViewBag.Title = "Chi tiết khám ngoại trú";
    Layout = "~/Views/Shared/_Index.cshtml";
    var reportUrl = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("ReportUrl");
    var ReportSystemCode = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("ReportSystemCode");
    var curOpr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}
<form name="form1">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form">
            <tr>
                <th class="formTitle">Ngày:</th>
                <td class="formValue" style="width:10%">
                    <input id="kssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
                           onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
                           value="@DateTime.Now.ToString("yyyy-MM-01")" />
                </td>
                <td class="formValue" style="width:8px;float:left;">-</td>
                <td class="formValue" style="width:10%;float:left;">
                    <input id="jssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px;float:left;"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
                           onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
                           value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </td>
                <th class="formTitle">Số thẻ ngoại trú/Họ tên/Khoa:</th>
                <td class="formValue">
                    <input id="keyword" type="text" class="form-control" placeholder="Số thẻ ngoại trú/Họ tên/Khoa" />
                </td>
                <td class="formValue" colspan="2">
                    <input type="button" id="btn_search" class="btn btn-primary btn-md" style="margin-left: 10px; width: 40px;" value="Tra cứu" />
                    <input type="button" id="btn_print" class="btn btn-primary btn-md" style="margin-left: 10px; width: 40px;" value="In" />
                </td>
            </tr>
        </table>
    </div>
    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>
<script>
    $(function () {
        //Khi thay đổi kích thước cửa sổ trình duyệt thì tải lạijqGridchiều rộng của
        $(window).resize(function () {
            initLayout("MyTabGrid");
        });
        //Danh sách tra cứu
        gridList();
    });
    //Tra cứu thanh toán đăng ký khám ngoại trú
    function gridList() {
        var $gridJsList = $("#gridList");
        $gridJsList.dataGrid({
            postData: { kssj: $("#kssj").val(), jssj: $("#jssj").val(), keyword: $("#keyword").val()},
            height: $(window).height() - 160,
            url: "/DoctorManage/OutpatientQuery/GetConsultDetailGridJson",
            colModel: [
                { label: 'Số khám ngoại trú', name: 'mzh', width: 100, align: 'left' },
                { label: 'Tên bệnh nhân', name: 'xm', align: 'left', width: 110 },
                { label: 'Giới tính', name: 'xb', align: 'center', width: 50 },
                { label: 'Tuổi', name: 'nl', align: 'right', width: 50 },
                { label: 'Khoa khám', name: 'ks', width: 80, align: 'left' },
                { label: 'Bác sĩ khám', name: 'ys', width: 80, align: 'left' },
                { label: 'Loại khám', name: 'jzlx', align: 'center', width: 50 },
                { label: 'Khám lần đầu', name: 'cz', align: 'center', width: 50 },
                { label: 'Thời gian bắt đầu', name: 'zlkssj', align: 'left', width: 120, formatter: function (val) { return $.getTime({ date: val }); } },
                { label: 'Thời gian kết thúc', name: 'zljssj', align: 'left', width: 120, formatter: function (val) { return val != "" && val != undefined ? $.getTime({ date: val }) : ""; } },
                { label: 'Trạng thái khám', name: 'jzzt', align: 'center', width: 50 },
                { label: 'Tên chẩn đoán chính', name: 'zdmc', width: 150, align: 'left' },
                { label: 'Số thẻ khám', name: 'jzkh', align: 'left', width: 70 },
                { label: 'Ngày tái khám', name: 'fzrq', align: 'left', width: 80 },
                { label: 'Năm tháng sinh', name: 'csny', align: 'left', width: 60, formatter: function (val) { return $.getTime({ date: val }); } },
                { label: 'Số chứng minh nhân dân', name: 'zjh', align: 'left', width: 120 },
                { label: 'Tính chất bệnh nhân', name: 'brxzmc', align: 'center', width: 70 },
                //{ label: 'Số chứng nhận y tế', name: 'ylzh', align: 'center', width: 50 },
                { label: 'Nghề nghiệp', name: 'zy', align: 'left', width: 50 },
                { label: 'Dân tộc', name: 'mz', align: 'left', width: 50 },
                //{ label: 'Nhóm máu', name: 'xx', align: 'center', width: 50 },
                { label: 'Ngày khám lần đầu', name: 'czrq', align: 'left', width: 80 },
                { label: 'Điện thoại nhà', name: 'dh', align: 'left', width: 50 },
                { label: 'Địa chỉ nhà', name: 'xian_dz', align: 'left', width: 50 },
                { label: 'Tên đơn vị', name: 'dwmc', align: 'left', width: 50 },
                { label: 'Điện thoại đơn vị', name: 'dwdh', align: 'left', width: 50 },
                { label: 'Quan hệ người đi cùng', name: 'lxrgx', align: 'left', width: 65 },
                { label: 'Tên người đi cùng', name: 'lxr', align: 'left', width: 65 },
                { label: 'Điện thoại người đi cùng', name: 'lxrdh', align: 'center', width: 65 },
                { label: 'Đơn vị người đi cùng', name: 'lxrdw', align: 'left', width: 65 },
                { label: 'Địa chỉ người đi cùng', name: 'jjlxr_dz', align: 'left', width: 65 },
            ],
            pager: "#gridPager",
            sortname: " zlkssj asc",
            rownumbers: true,  //Có hiển thị số thứ tự không
            viewrecords: true
        });

        $("#btn_search").click(function () {
            $('#gridList').jqGrid("clearGridData");//Xóa chi tiết trước
            $gridJsList.jqGrid('setGridParam', {
                postData: { kssj: $("#kssj").val(), jssj: $("#jssj").val(), keyword: $("#keyword").val() },
                url: "/DoctorManage/OutpatientQuery/GetConsultDetailGridJson",
            }).trigger('reloadGrid');
        });
    }


    $("#btn_print").click(function () {
        var uri = '@Html.Raw(reportUrl)' + "?tempCode=1244" + "&systemCode=" + '@Html.Raw(ReportSystemCode)' + "&hospitalCode=" + '@ViewBag.OrganizeId' + "&kssj=" + $('#kssj').val() + "&jssj=" + $('#jssj').val() + "&jzys=" + '@curOpr.rygh' + "&keyword=" + $('#keyword').val();
        if (uri) {
            window.open(uri);
        }
    })



</script>
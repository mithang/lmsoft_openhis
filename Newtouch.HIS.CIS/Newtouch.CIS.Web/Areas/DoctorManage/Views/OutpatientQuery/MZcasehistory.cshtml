
@{
    ViewBag.Title = "MZcasehistory";
    Layout = "~/Views/Shared/_Index.cshtml";
    var reportUrl = Newtouch.CIS.Compat.AppConfig.Get("ReportUrl");
    var ReportSystemCode = Newtouch.CIS.Compat.AppConfig.Get("ReportSystemCode");
    var curOpr = NewtouchHIS.Lib.Framework.Operator.OperatorProvider.GetCurrent();
}

<form name="form1">
	<div class="panel panel-default">
		<div class="panel-heading navb-bg">
			Điều kiện lọc
		</div>
		<table class="form">
			<tr>
				<th class="formTitle">Ngày:</th>
				<td class="formValue" style="width:10%">
					<input id="kssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px"
						   onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy' })"
						   onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })"
						   value="@DateTime.Now.AddDays(-1).ToString("dd/MM/yyyy")" />
				</td>
				<td class="formValue" style="width:8px;float:left;">-</td>
				<td class="formValue" style="width:10%;float:left;">
					<input id="jssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px;float:left;"
						   onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy' })"
						   onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })"
						   value="@DateTime.Now.ToString("dd/MM/yyyy")" />
				</td>
				<td class="formValue" colspan="2">
					<input type="button" id="btn_search" class="btn btn-primary btn-md" style="margin-left: 10px; width: 40px;" value="Tra cứu" />
					@*<input type="button" id="btn_print" class="btn btn-primary btn-md" style="margin-left: 10px; width: 40px;" value="In" />*@
				</td>
			</tr>
		</table>
	</div>
	<div class="ui-layout" id="layout" style="height:70%;width:100%;">
		<ul class="nav nav-tabs" id="myTab">
			<li class="active"><a href="#librlb" id="alibrlb" data-toggle="tab" onclick="newtabchange('1')">Ngoại trúBệnh ánDanh sách</a></li>
			<li><a href="#linbl" id="alinbl" data-toggle="tab" onclick="newtabchange('2')">Bệnh ánChi tiết</a></li>
			<li><a href="#linlsjz" id="alinlsjz" data-toggle="tab" onclick="newtabchange('3')">Lịch sửBệnh ánGhi chép</a></li>
		</ul>
		<div class="tab-pane fade in active" id="librlb">
			<table id="gridList"></table>
			<div id="gridPager"></div>
		</div>
		<div class="tab-pane fade" id="linbl">
			<iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
					scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
		</div>
		<div class="tab-pane fade" id="linlsjz">
			@*@Html.Partial("~/Areas/DoctorManage/Views/OutpatientQuery/MZcasehistorylsView.cshtml")*@
			<div>
				<table id="gridListls"></table>
				<div id="gridPagerls"></div>
			</div>
			<div>
				<table id="gridListlscfmx"></table>
				<div id="gridPagerlscfmx"></div>
			</div>
			

		</div>
	</div>
	
</form>

<script>
	var mzh = "";
	var blh = "";
	var ogid = '@curOpr.OrganizeId';
	var reportUrl = '@Html.Raw(reportUrl)';
    $(function () {
        //Khi thay đổi kích thước cửa sổ trình duyệt, tải lạijqGridđộ rộng
		var h = $(window).height() - 100;
		$('#layout iframe').css('height', h);
		//newtabchange("1")
        //Tra cứudanh sách
		gridList();
		lsblinfo();
		lsjzcfmx();
    });
    //Hồ sơKhám bệnhghi chépTra cứu
    function gridList() {
        var $gridJsList = $("#gridList");
        $gridJsList.dataGrid({
            postData: {kssj:$("#kssj").val(),jssj:$("#jssj").val()},
			height: $(window).height() - 190,
			url: "/DoctorManage/OutpatientQuery/GetMedicalRecordGridJson",
            colModel: [
				{ label: 'Số bệnh án', name: 'blh', width: 100, align: 'left' },
                { label: 'Mã số khám ngoại trú', name: 'mzh', width: 100, align: 'left' },
                { label: 'Họ tên', name: 'xm', align: 'left', width: 110 },
                { label: 'Giới tính', name: 'xb', align: 'center', width: 80 },
                { label: 'Tuổi', name: 'nl', align: 'left', width: 50 },
                { label: 'Chẩn đoán', name: 'zdmc', width: 150, align: 'left' },
                { label: 'Thời gian bắt đầu', name: 'zlkssj', align: 'left', width: 120, formatter: function (val) { return $.getTime({ date: val }); } },
                { label: 'Kết thúcThời gian', name: 'zljssj', align: 'left', width: 120, formatter: function (val) { return val != "" && val != undefined ? $.getTime({ date: val }) : ""; } },
                { label: 'Khoa', name: 'ks', width: 80, align: 'left' },
                { label: 'Khám bệnhBác sĩ', name: 'ys', width: 80, align: 'left' },
                { label: 'Địa chỉ gia đình', name: 'dz', width: 80, align: 'left' },
                { label: 'Kết quả điều trị', name: 'zg', width: 80, align: 'left', hidden: true }
            ],
            pager: "#gridPager",
            sortname: " zlkssj asc",
            rownumbers: true,  //CóKhôngHiển thịSố thứ tự
			viewrecords: true,
			ondblClickRow: function (rowid) {
				doubleclick(rowid);
			},
        });

		$("#btn_search").click(function () {
			//điểmnhấpTra cứuĐặt lạimỗicáidanh sáchTra cứu
			//blh = "";
            $('#gridList').jqGrid("clearGridData");//Xóa trắng chi tiết trước
            $gridJsList.jqGrid('setGridParam', {
                postData: { kssj: $("#kssj").val(), jssj: $("#jssj").val() },
                url: "/DoctorManage/OutpatientQuery/GetMedicalRecordGridJson",
				page: 1,
			}).trigger('reloadGrid');


			$("#iframerightiframerightiframerightttt").attr('src', "");


			$('#gridListls').jqGrid("clearGridData");//Xóa trắng chi tiết trước
			$("#gridListls").jqGrid('setGridParam', {
				postData: { blh: blh },
				url: "/DoctorManage/OutpatientQuery/MZBLlsinfo",
				page: 1,
			}).trigger('reloadGrid');


			$('#gridListlscfmx').jqGrid("clearGridData");//Xóa trắng chi tiết trước
			$("#gridListlscfmx").jqGrid('setGridParam', {
				postData: { jzid: "" },
				url: "/DoctorManage/OutpatientQuery/MZlsjzCfInfo",
				page: 1,
			}).trigger('reloadGrid');
        });
	}

	//Hồ sơChi tiếtTra cứu
	function blxqinfo() {
		$("#alinbl").click();
		var uri = reportUrl + "?tempCode=1253&mzh=" + mzh + "&systemCode=" + '@Html.Raw(ReportSystemCode)' + "&orgId=" + ogid + "&row=1";
		$("#iframerightiframerightiframerightttt").attr('src', uri);
	}

	//cắtđổithẻảnhThao tác
	function newtabchange(tabaction) {
		switch (tabaction) {
			case "1":
				$("#librlb").show();
				$("#linbl").hide();
				$("#linlsjz").hide(); 
				break;
			case "2":
				$("#librlb").hide();
				$("#linbl").show();
				$("#linlsjz").hide();
				break;
			case "3":
				$("#librlb").hide();
				$("#linbl").hide();
				$("#linlsjz").show();
				//console.log("bản lầnnhấp đúpSố bệnh án：", blh);
				
				break;
			default:

				break;
		}
	}

	//nhấp đúpHồ sơKhám bệnhghi chépThao tác
	function doubleclick(rowid) {
		var selRowData = $("#gridList").getRowData(rowid);
		if (selRowData==null) {
			$.modalAlert("Vui lòng chọnmột dòngBệnh nhânThông tin", 'warning');
			return;
		}
		//$.modalMsg("chọnBệnh nhâncủaSố khám ngoại trúlà：" + selRowData.mzh, 'warning');
		mzh = selRowData.mzh;//Hồ sơChi tiếtthông tinSử dụng
		blh = selRowData.blh;//Lịch sửHồ sơthông tinSử dụng
		blxqinfo();//tảiHồ sơChi tiếtthông tin

		$('#gridListls').jqGrid("clearGridData");//Xóa trắng chi tiết trước
		$("#gridListls").jqGrid('setGridParam', {
			postData: { blh: blh },
			url: "/DoctorManage/OutpatientQuery/MZBLlsinfo",
			page: 1,
		}).trigger('reloadGrid');

		$('#gridListlscfmx').jqGrid("clearGridData");//Xóa trắng chi tiết trước
		$("#gridListlscfmx").jqGrid('setGridParam', {
			postData: { jzid: "" },
			url: "/DoctorManage/OutpatientQuery/MZlsjzCfInfo",
			page: 1,
		}).trigger('reloadGrid');
		
	}

	//Lịch sửHồ sơKhám bệnhTra cứu
	function lsblinfo() {
		var $gridlsList = $("#gridListls");
		$gridlsList.dataGrid({
			postData: { blh: blh },
			height: $(window).height() - 500,
			url: "/DoctorManage/OutpatientQuery/MZBLlsinfo",
			caption: "Lịch sửKhám bệnhGhi chép",
			colModel: [
				{ label: 'Số bệnh án', name: 'blh', width: 100, align: 'left' },
				{ label: 'Mã số khám ngoại trú', name: 'mzh', width: 100, align: 'left' },
				{ label: 'Họ tên', name: 'xm', width: 80, align: 'left' },
				{ label: 'Giới tính', name: 'xb', width: 50, align: 'center' },
				{ label: 'Tuổi', name: 'nl', width: 50, align: 'left' },
				{ label: 'Chẩn đoán', name: 'zdmc', width: 150, align: 'left' },
				{ label: 'Thời gian bắt đầu', name: 'zlkssj', width: 120, align: 'left', formatter: function (val) { return $.getTime({ date: val }); } },
				{ label: 'Kết thúcThời gian', name: 'zljssj', width: 120, align: 'left', formatter: function (val) { return val != "" && val != undefined ? $.getTime({ date: val }) : ""; } },
				{ label: 'Khoa', name: 'ks', width: 80, align: 'left' },
				{ label: 'Khám bệnhBác sĩ', name: 'ys', width: 80, align: 'left' },
				{ label: 'Địa chỉ gia đình', name: 'dz', width: 80, align: 'left' },
				{ label: 'Khám bệnhID', name: 'jzId', width: 80, align: 'left', hidden: true }
			],
			pager: "#gridPagerls",
			sortname: " zlkssj desc",
			rownumbers: true,  //CóKhôngHiển thịSố thứ tự
			viewrecords: true,
			onSelectRow: function (rowid) {
				var rowdata = $("#gridListls").getRowData(rowid);
				if (rowdata) {
					//console.log("Đã chọnKhám bệnhID：", rowdata.jzId);
					var jzid = rowdata.jzId;
					$('#gridListlscfmx').jqGrid("clearGridData");//Xóa trắng chi tiết trước
					$("#gridListlscfmx").jqGrid('setGridParam', {
						postData: { jzid: jzid },
						url: "/DoctorManage/OutpatientQuery/MZlsjzCfInfo",
						page: 1,
					}).trigger('reloadGrid');
                }
            },
			ondblClickRow: function (rowid) {
				var selRowData = $("#gridListls").getRowData(rowid);
				if (selRowData == null) {
					$.modalAlert("Vui lòng chọnmột dòngBệnh nhânThông tin", 'warning');
					return;
				}
				mzh = selRowData.mzh;//Hồ sơChi tiếtthông tinSử dụng
				blxqinfo();//tảiHồ sơChi tiếtthông tin
				
			},
		});
	}

	function lsjzcfmx() {
		var $gridlscfmxList = $("#gridListlscfmx");
		$gridlscfmxList.dataGrid({
			postData: { jzid: "" },
			height: $(window).height() - 400,
			url: "/DoctorManage/OutpatientQuery/MZlsjzCfInfo",
			caption: "Lịch sửĐơn thuốcChi tiết",
			colModel: [
				{ label: 'Đơn thuốcLoại', hidden: true, name: 'cflx', width: 140, align: 'left', formatter: function (val) { return $.enum.getDescByValue("EnumCflx", val); } },
				{ label: 'Số đơn thuốc', name: 'cfh', width: 140, align: 'left' },
				{ label: 'MụcMã', name: 'sfxmcode', width: 100, align: 'left', hidden: true },
				{ label: 'Tên mục', name: 'sfxmmc', width: 140, align: 'left' },
				{ label: 'Đơn giá', name: 'dj', align: 'left', width: 80 },
				{ label: 'Đơn vị', name: 'dw', align: 'left', width: 80},
				{ label: 'Số lượng', name: 'sl', align: 'center', width: 80 },
				{ label: 'Số tiền', name: 'je', align: 'left', width: 80 },
				{ label: 'KêBác sĩ', name: 'klys', width: 130, align: 'left' },
				{ label: 'KêKhoa', name: 'klks', width: 130, align: 'left' },
                {
                    label: 'Thu phíTrạng thái', name: 'sfbz', width: 90, align: 'left', formatter: function (val, options, rowObject) {
                        if (rowObject["tbz"])
                            return "Đã hoàn phí";
                        else if (rowObject["sfbz"])
                            return "Đã thu phí";
                        else
                            return "Chưa thu phí";
                    }
                },
                { label: 'Thu phíTrạng thái', name: 'tbz', width: 90, align: 'center', hidden: true }
			],
			pager: "#gridPagerlscfmx",
			sortname: " cfh asc",
			rownumbers: true,  //CóKhôngHiển thịSố thứ tự
			viewrecords: true,
			grouping: true,
			rowNum: 50, //mỗitrangHiển thịghi chépsố
			groupingView: {
				//groupSummary: [true],//hợptínhcộtCóKhôngHiển thị  ởcầnhợptínhcủacộtthêmsummaryTypeThuộc tính  'sum'
				groupCollapse: true,//Khởi tạoCóKhônggấp lạiphútnhómchi tiết truegấp lại falsetriểnmở
				groupColumnShow: [true],
				groupText: ['<b>{0}       Số chi tiết: {1} </b>'],
				groupField: ['cflx'],
				groupOrder: ['asc']
			}
		});
	}
	function cs() {
		$("#grid").jqGrid({
			url: 'data.json',
			datatype: "json",
			colModel: [
				{ label: 'ID', name: 'id', key: true, width: 75 },
				{ label: 'Họ tên', name: 'name', width: 150 },
				{ label: 'Tuổi', name: 'age', width: 150 },
				{ label: 'Thành phố', name: 'city', width: 150 },
				{ label: 'Quốc gia', name: 'country', width: 150 }
			],
			viewrecords: true,
			height: 250,
			rowNum: 20,
			pager: "#pager",
			caption: "Bảng ví dụ",
			subGrid: true,
			subGridRowExpanded: function (subgridDivId, rowId) {
				var subgridTableId = subgridDivId + "_t";
				$("#" + subgridDivId).html("<table id='" + subgridTableId + "'></table>");

				$("#" + subgridTableId).jqGrid({
					url: 'subgrid_data.json',
					datatype: "json",
					colModel: [
						{ label: 'ID', name: 'id', key: true, width: 75 },
						{ label: 'Số phiếu đặt', name: 'order_number', width: 150 },
						{ label: 'Số tiền', name: 'amount', width: 150 },
						{ label: 'Ngày', name: 'date', width: 150 }
					],
					height: '100%',
					rowNum: 5,
					subGrid: true,
					subGridOptions: {
						plusicon: "fa fa-plus",
						minusicon: "fa fa-minus",
						openicon: "fa fa-folder-open",
						reloadOnExpand: false,
					},
					subGridRowExpanded: function (subgridDivId, rowId) {
						var subgridTableId = subgridDivId + "_t";
						$("#" + subgridDivId).html("<table id='" + subgridTableId + "'></table>");

						$("#" + subgridTableId).jqGrid({
							url: 'subgrid2_data.json',
							datatype: "json",
							colModel: [
								{ label: 'ID', name: 'id', key: true, width: 75 },
								{ label: 'Tên sản phẩm', name: 'product_name', width: 150 },
								{ label: 'Số lượng', name: 'quantity', width: 150 },
								{ label: 'Đơn giá', name: 'price', width: 150 }
							],
							height: '100%',
							rowNum: 5
						});
					}
				});
			}
		});
	}
</script>
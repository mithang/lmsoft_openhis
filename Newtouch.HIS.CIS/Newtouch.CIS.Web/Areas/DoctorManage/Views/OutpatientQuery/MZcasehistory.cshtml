
@{
    ViewBag.Title = "MZcasehistory";
    Layout = "~/Views/Shared/_Index.cshtml";
    var reportUrl = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("ReportUrl");
    var ReportSystemCode = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("ReportSystemCode");
    var curOpr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}

<form name="form1">
	<div class="panel panel-default">
		<div class="panel-heading navb-bg">
			Điều kiện lọc
		</div>
		<table class="form">
			<tr>
				<th class="formTitle">Ngày:</th>
				<td class="formValue" style="width:10%">
					<input id="kssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px"
						   onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
						   onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
						   value="@DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd")" />
				</td>
				<td class="formValue" style="width:8px;float:left;">-</td>
				<td class="formValue" style="width:10%;float:left;">
					<input id="jssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px;float:left;"
						   onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
						   onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
						   value="@DateTime.Now.ToString("yyyy-MM-dd")" />
				</td>
				<td class="formValue" colspan="2">
					<input type="button" id="btn_search" class="btn btn-primary btn-md" style="margin-left: 10px; width: 40px;" value="Tra cứu" />
					@*<input type="button" id="btn_print" class="btn btn-primary btn-md" style="margin-left: 10px; width: 40px;" value="In" />*@
				</td>
			</tr>
		</table>
	</div>
	<div class="ui-layout" id="layout" style="height:70%;width:100%;">
		<ul class="nav nav-tabs" id="myTab">
			<li class="active"><a href="#librlb" id="alibrlb" data-toggle="tab" onclick="newtabchange('1')">Danh sách bệnh án ngoại trú</a></li>
			<li><a href="#linbl" id="alinbl" data-toggle="tab" onclick="newtabchange('2')">Chi tiết bệnh án</a></li>
			<li><a href="#linlsjz" id="alinlsjz" data-toggle="tab" onclick="newtabchange('3')">Hồ sơ bệnh án lịch sử</a></li>
		</ul>
		<div class="tab-pane fade in active" id="librlb">
			<table id="gridList"></table>
			<div id="gridPager"></div>
		</div>
		<div class="tab-pane fade" id="linbl">
			<iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
					scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
		</div>
		<div class="tab-pane fade" id="linlsjz">
			@*@Html.Partial("~/Areas/DoctorManage/Views/OutpatientQuery/MZcasehistorylsView.cshtml")*@
			<div>
				<table id="gridListls"></table>
				<div id="gridPagerls"></div>
			</div>
			<div>
				<table id="gridListlscfmx"></table>
				<div id="gridPagerlscfmx"></div>
			</div>
			

		</div>
	</div>
	
</form>

<script>
	var mzh = "";
	var blh = "";
	var ogid = '@curOpr.OrganizeId';
	var reportUrl = '@Html.Raw(reportUrl)';
    $(function () {
        //Khi thay đổi kích thước cửa sổ trình duyệt thì tải lạijqGridchiều rộng của
		var h = $(window).height() - 100;
		$('#layout iframe').css('height', h);
		//newtabchange("1")
        //Danh sách tra cứu
		gridList();
		lsblinfo();
		lsjzcfmx();
    });
    //Tra cứu hồ sơ khám bệnh án
    function gridList() {
        var $gridJsList = $("#gridList");
        $gridJsList.dataGrid({
            postData: {kssj:$("#kssj").val(),jssj:$("#jssj").val()},
			height: $(window).height() - 190,
			url: "/DoctorManage/OutpatientQuery/GetMedicalRecordGridJson",
            colModel: [
				{ label: 'Số hồ sơ bệnh án', name: 'blh', width: 100, align: 'left' },
                { label: 'Số khám ngoại trú', name: 'mzh', width: 100, align: 'left' },
                { label: 'Họ tên', name: 'xm', align: 'left', width: 110 },
                { label: 'Giới tính', name: 'xb', align: 'center', width: 80 },
                { label: 'Tuổi', name: 'nl', align: 'left', width: 50 },
                { label: 'Chẩn đoán', name: 'zdmc', width: 150, align: 'left' },
                { label: 'Thời gian bắt đầu', name: 'zlkssj', align: 'left', width: 120, formatter: function (val) { return $.getTime({ date: val }); } },
                { label: 'Thời gian kết thúc', name: 'zljssj', align: 'left', width: 120, formatter: function (val) { return val != "" && val != undefined ? $.getTime({ date: val }) : ""; } },
                { label: 'Khoa', name: 'ks', width: 80, align: 'left' },
                { label: 'Bác sĩ khám', name: 'ys', width: 80, align: 'left' },
                { label: 'Địa chỉ nhà', name: 'dz', width: 80, align: 'left' },
                { label: 'Kết quả chuyển biến', name: 'zg', width: 80, align: 'left', hidden: true }
            ],
            pager: "#gridPager",
            sortname: " zlkssj asc",
            rownumbers: true,  //Có hiển thị số thứ tự không
			viewrecords: true,
			ondblClickRow: function (rowid) {
				doubleclick(rowid);
			},
        });

		$("#btn_search").click(function () {
			//Nhấn tra cứu để đặt lại tra cứu của từng danh sách
			//blh = "";
            $('#gridList').jqGrid("clearGridData");//Xóa chi tiết trước
            $gridJsList.jqGrid('setGridParam', {
                postData: { kssj: $("#kssj").val(), jssj: $("#jssj").val() },
                url: "/DoctorManage/OutpatientQuery/GetMedicalRecordGridJson",
				page: 1,
			}).trigger('reloadGrid');


			$("#iframerightiframerightiframerightttt").attr('src', "");


			$('#gridListls').jqGrid("clearGridData");//Xóa chi tiết trước
			$("#gridListls").jqGrid('setGridParam', {
				postData: { blh: blh },
				url: "/DoctorManage/OutpatientQuery/MZBLlsinfo",
				page: 1,
			}).trigger('reloadGrid');


			$('#gridListlscfmx').jqGrid("clearGridData");//Xóa chi tiết trước
			$("#gridListlscfmx").jqGrid('setGridParam', {
				postData: { jzid: "" },
				url: "/DoctorManage/OutpatientQuery/MZlsjzCfInfo",
				page: 1,
			}).trigger('reloadGrid');
        });
	}

	//Tra cứu chi tiết bệnh án
	function blxqinfo() {
		$("#alinbl").click();
		var uri = reportUrl + "?tempCode=1253&mzh=" + mzh + "&systemCode=" + '@Html.Raw(ReportSystemCode)' + "&orgId=" + ogid + "&row=1";
		$("#iframerightiframerightiframerightttt").attr('src', uri);
	}

	//Thao tác chuyển thẻ
	function newtabchange(tabaction) {
		switch (tabaction) {
			case "1":
				$("#librlb").show();
				$("#linbl").hide();
				$("#linlsjz").hide(); 
				break;
			case "2":
				$("#librlb").hide();
				$("#linbl").show();
				$("#linlsjz").hide();
				break;
			case "3":
				$("#librlb").hide();
				$("#linbl").hide();
				$("#linlsjz").show();
				//console.log("Số bệnh án nhấn đúp lần này:", blh);
				
				break;
			default:

				break;
		}
	}

	//Thao tác hồ sơ khám bệnh án nhấn đúp
	function doubleclick(rowid) {
		var selRowData = $("#gridList").getRowData(rowid);
		if (selRowData==null) {
			$.modalAlert("Vui lòng chọn một thông tin bệnh nhân", 'warning');
			return;
		}
		//$.modalMsg("Số khám ngoại trú của bệnh nhân đã chọn là:" + selRowData.mzh, 'warning');
		mzh = selRowData.mzh;//Sử dụng thông tin chi tiết bệnh án
		blh = selRowData.blh;//Sử dụng thông tin bệnh án lịch sử
		blxqinfo();//Tải thông tin chi tiết bệnh án

		$('#gridListls').jqGrid("clearGridData");//Xóa chi tiết trước
		$("#gridListls").jqGrid('setGridParam', {
			postData: { blh: blh },
			url: "/DoctorManage/OutpatientQuery/MZBLlsinfo",
			page: 1,
		}).trigger('reloadGrid');

		$('#gridListlscfmx').jqGrid("clearGridData");//Xóa chi tiết trước
		$("#gridListlscfmx").jqGrid('setGridParam', {
			postData: { jzid: "" },
			url: "/DoctorManage/OutpatientQuery/MZlsjzCfInfo",
			page: 1,
		}).trigger('reloadGrid');
		
	}

	//Tra cứu khám bệnh án lịch sử
	function lsblinfo() {
		var $gridlsList = $("#gridListls");
		$gridlsList.dataGrid({
			postData: { blh: blh },
			height: $(window).height() - 500,
			url: "/DoctorManage/OutpatientQuery/MZBLlsinfo",
			caption: "Hồ sơ khám lịch sử",
			colModel: [
				{ label: 'Số hồ sơ bệnh án', name: 'blh', width: 100, align: 'left' },
				{ label: 'Số khám ngoại trú', name: 'mzh', width: 100, align: 'left' },
				{ label: 'Họ tên', name: 'xm', width: 80, align: 'left' },
				{ label: 'Giới tính', name: 'xb', width: 50, align: 'center' },
				{ label: 'Tuổi', name: 'nl', width: 50, align: 'left' },
				{ label: 'Chẩn đoán', name: 'zdmc', width: 150, align: 'left' },
				{ label: 'Thời gian bắt đầu', name: 'zlkssj', width: 120, align: 'left', formatter: function (val) { return $.getTime({ date: val }); } },
				{ label: 'Thời gian kết thúc', name: 'zljssj', width: 120, align: 'left', formatter: function (val) { return val != "" && val != undefined ? $.getTime({ date: val }) : ""; } },
				{ label: 'Khoa', name: 'ks', width: 80, align: 'left' },
				{ label: 'Bác sĩ khám', name: 'ys', width: 80, align: 'left' },
				{ label: 'Địa chỉ nhà', name: 'dz', width: 80, align: 'left' },
				{ label: 'Khám bệnhID', name: 'jzId', width: 80, align: 'left', hidden: true }
			],
			pager: "#gridPagerls",
			sortname: " zlkssj desc",
			rownumbers: true,  //Có hiển thị số thứ tự không
			viewrecords: true,
			onSelectRow: function (rowid) {
				var rowdata = $("#gridListls").getRowData(rowid);
				if (rowdata) {
					//console.log("Lần khám đã chọnID：", rowdata.jzId);
					var jzid = rowdata.jzId;
					$('#gridListlscfmx').jqGrid("clearGridData");//Xóa chi tiết trước
					$("#gridListlscfmx").jqGrid('setGridParam', {
						postData: { jzid: jzid },
						url: "/DoctorManage/OutpatientQuery/MZlsjzCfInfo",
						page: 1,
					}).trigger('reloadGrid');
                }
            },
			ondblClickRow: function (rowid) {
				var selRowData = $("#gridListls").getRowData(rowid);
				if (selRowData == null) {
					$.modalAlert("Vui lòng chọn một thông tin bệnh nhân", 'warning');
					return;
				}
				mzh = selRowData.mzh;//Sử dụng thông tin chi tiết bệnh án
				blxqinfo();//Tải thông tin chi tiết bệnh án
				
			},
		});
	}

	function lsjzcfmx() {
		var $gridlscfmxList = $("#gridListlscfmx");
		$gridlscfmxList.dataGrid({
			postData: { jzid: "" },
			height: $(window).height() - 400,
			url: "/DoctorManage/OutpatientQuery/MZlsjzCfInfo",
			caption: "Chi tiết đơn thuốc lịch sử",
			colModel: [
				{ label: 'Loại đơn thuốc', hidden: true, name: 'cflx', width: 140, align: 'left', formatter: function (val) { return $.enum.getDescByValue("EnumCflx", val); } },
				{ label: 'Số đơn thuốc', name: 'cfh', width: 140, align: 'left' },
				{ label: 'Mã hạng mục', name: 'sfxmcode', width: 100, align: 'left', hidden: true },
				{ label: 'Tên hạng mục', name: 'sfxmmc', width: 140, align: 'left' },
				{ label: 'Đơn giá', name: 'dj', align: 'left', width: 80 },
				{ label: 'Đơn vị', name: 'dw', align: 'left', width: 80},
				{ label: 'Số lượng', name: 'sl', align: 'center', width: 80 },
				{ label: 'Số tiền', name: 'je', align: 'left', width: 80 },
				{ label: 'Bác sĩ lập', name: 'klys', width: 130, align: 'left' },
				{ label: 'Khoa lập', name: 'klks', width: 130, align: 'left' },
                {
                    label: 'Trạng thái thu phí', name: 'sfbz', width: 90, align: 'left', formatter: function (val, options, rowObject) {
                        if (rowObject["tbz"])
                            return "已退费";
                        else if (rowObject["sfbz"])
                            return "已收费";
                        else
                            return "未收费";
                    }
                },
                { label: 'Trạng thái thu phí', name: 'tbz', width: 90, align: 'center', hidden: true }
			],
			pager: "#gridPagerlscfmx",
			sortname: " cfh asc",
			rownumbers: true,  //Có hiển thị số thứ tự không
			viewrecords: true,
			grouping: true,
			rowNum: 50, //Số bản ghi hiển thị mỗi trang
			groupingView: {
				//groupSummary: [true],//Cột tổng cộng có hiển thị không  Thêm vào cột cần tổng cộngsummaryTypeThuộc tính  'sum'
				groupCollapse: true,//Khởi tạo có thu gọn chi tiết nhóm không trueThu gọn falseMở rộng
				groupColumnShow: [true],
				groupText: ['<b>{0}       Số chi tiết: {1} </b>'],
				groupField: ['cflx'],
				groupOrder: ['asc']
			}
		});
	}
	function cs() {
		$("#grid").jqGrid({
			url: 'data.json',
			datatype: "json",
			colModel: [
				{ label: 'ID', name: 'id', key: true, width: 75 },
				{ label: 'Họ tên', name: 'name', width: 150 },
				{ label: 'Tuổi', name: 'age', width: 150 },
				{ label: 'Thành phố', name: 'city', width: 150 },
				{ label: 'Quốc gia', name: 'country', width: 150 }
			],
			viewrecords: true,
			height: 250,
			rowNum: 20,
			pager: "#pager",
			caption: "Bảng ví dụ",
			subGrid: true,
			subGridRowExpanded: function (subgridDivId, rowId) {
				var subgridTableId = subgridDivId + "_t";
				$("#" + subgridDivId).html("<table id='" + subgridTableId + "'></table>");

				$("#" + subgridTableId).jqGrid({
					url: 'subgrid_data.json',
					datatype: "json",
					colModel: [
						{ label: 'ID', name: 'id', key: true, width: 75 },
						{ label: 'Số đơn hàng', name: 'order_number', width: 150 },
						{ label: 'Số tiền', name: 'amount', width: 150 },
						{ label: 'Ngày', name: 'date', width: 150 }
					],
					height: '100%',
					rowNum: 5,
					subGrid: true,
					subGridOptions: {
						plusicon: "fa fa-plus",
						minusicon: "fa fa-minus",
						openicon: "fa fa-folder-open",
						reloadOnExpand: false,
					},
					subGridRowExpanded: function (subgridDivId, rowId) {
						var subgridTableId = subgridDivId + "_t";
						$("#" + subgridDivId).html("<table id='" + subgridTableId + "'></table>");

						$("#" + subgridTableId).jqGrid({
							url: 'subgrid2_data.json',
							datatype: "json",
							colModel: [
								{ label: 'ID', name: 'id', key: true, width: 75 },
								{ label: 'Tên sản phẩm', name: 'product_name', width: 150 },
								{ label: 'Số lượng', name: 'quantity', width: 150 },
								{ label: 'Đơn giá', name: 'price', width: 150 }
							],
							height: '100%',
							rowNum: 5
						});
					}
				});
			}
		});
	}
</script>
<link href="@SiteUrl.GetStaticResourceScriptUrl("~/Content/css/TemperatureChart.css", false)" rel="stylesheet" />
<style type="text/css">
    #tablBaseInfo {
        margin: 5px 0 0 3px;
    }

        #tablBaseInfo td {
            padding: 3px 5px;
        }
</style>
<table id="tablBaseInfo" class="form" style="width:750px;">
    <tr>
        <td class="formValue" colspan="4">Ngày:<label id="lblRq"></label></td>
    </tr>
    <tr>
        <td class="formValue">Họ tên:<label id="lblXm"></label></td>
        <td class="formValue">Số hồ sơ bệnh án:<label id="lblBlh"></label></td>
        <td class="formValue">Số nhập viện:<label id="lblZyh"></label></td>
        <td class="formValue">Khu bệnh:<label id="lblBq"></label></td>
    </tr>
    <tr>
        <td class="formValue">Giường bệnh:<label id="lblCw"></label></td>
        <td class="formValue">Ngày nhập viện:<label id="lblRqrq"></label></td>
        <td class="formValue" style="display:none">Ngày xuất khu:<label id="lblCqrq"></label></td>
    </tr>
</table>
<div id="3cbill">
    <div class="drawingboard" id="board0">
        <table class="bottomtbl">
            <tr>
                <td>呼吸(次/分)</td>
            </tr>
            <tr>
                <td>血压(mmHg)</td>
            </tr>
            <tr>
                <td>Độ bão hòa oxy máu%</td>
            </tr>
            <tr>
                <td>氧流量(升/分)</td>
            </tr>
            <tr>
                <td>Số lần đại tiện</td>
            </tr>
            <tr>
                <td>摄入量(ml)</td>
            </tr>
            <tr>
                <td>小&nbsp;&nbsp;便(ml)</td>
            </tr>
            <tr>
                <td>呕吐量(ml)</td>
            </tr>
            <tr>
                <td>引流量(ml)</td>
            </tr>
            <tr>
                <td>输入液体量(ml)</td>
            </tr>
            <tr>
                <td>体&nbsp;&nbsp;重(kg)</td>
            </tr>
            <tr>
                <td>身&nbsp;&nbsp;高(cm)</td>
            </tr>
        </table>
    </div>
</div>
<script>
    var billIndex = 0;//Dấu phân trang phiếu ba chỉ số
    var $board = null
    //base
    var spc = 16;
    var sspace = 11;
    var sspacewidth = 14;
    var outerspace = 3; //Khoảng trắng bên ngoài phiếu nhiệt độ
    var xouterspace = 3;
    var bodyHeight = 700;   //Chiều cao tổng thể
    var origin;
    //calc
    var sjStartTop;
    var contentStartTop;
    var contentStartLeft;

    //Huyết áp, mạch, hô hấp, nhiệt độ
    var twArr = [42, 41, 40, 39, 38, 37, 36, 35, 34];
    var hxArr = [80, 70, 60, 50, 40, 30, 20, 10, 0];
    var mbArr = [180, 160, 140, 120, 100, 80, 60, 40, 20];
    var xyArr = [180, 160, 140, 120, 100, 80, 60, 40, 20];
    var wljwArr = [42, 41, 40, 39, 38, 37, 36, 35, 34];

    var twColor = 'cblack';
    var hxColor = 'cblue';
    var mbColor = 'cred';
    var xyszColor = 'corange';
    var xyxzColor = 'corange';
    var wljwColor = 'cred';

    //Phiếu nhiệt độcontentcủa viền dướitopTọa độ
    var twLastTop;
    //Phiếu nhiệt độcontentcủa viền phảileftTọa độ
    var twLastLeft;

    var bottomtrCount = $('.bottomtbl tr').length;
    var bodyLastTop;

    var rqCellValueArr = new Array();

    var ryrq;
    //Định vị
    if (window.top == window.self) {
        $('#tablBaseInfo').css('marginLeft', 30);
    }

    function reLocation() {
        origin = { x: xouterspace, y: 0 + outerspace };
        //calc
        sjStartTop = origin.y + spc * 2;
        contentStartTop = origin.y + spc * 3;
        contentStartLeft = origin.x + sspacewidth * 6;   //6ô  //Nhưng phải cho thêm chút chiều rộng

        //Phiếu nhiệt độcontentcủa viền dướitopTọa độ
        twLastTop = contentStartTop + sspace * 5 * (twArr.length - 1);

        bodyLastTop = twLastTop + spc * bottomtrCount;
    };

    function search(kssj, jssj, zyh) {
        tempData = null; //
        tempKssj = null;
        $('#tablBaseInfo td label').html('');
        if (!kssj || !jssj || !zyh) {
            $.modalAlert('Vui lòng hoàn thiện điều kiện lọc', 'error');
            return;
        }
        billIndex = 0;
        $("#3cbill").empty();//Xóa nội dung phiếu ba chỉ số
        $.najax({
            url: "/NurseManage/InpatientVitalSigns/GetTemperatureChartJson",
            data: { kssj: kssj, jssj: jssj, zyh: zyh },
            loadingtext: "Dữ liệu phiếu nhiệt độ đang được yêu cầu, vui lòng đợi...",
            asnyc: false,
            success: function (data) {
                //
                if (!(data && data.list && data.list.length)) {
                    //draw([]);
                    if (!(data && data.patInfo)) {
                        $.modalAlert('Vui lòng chọn số nhập viện', 'warning');
                        return;
                    }
                    //return;
                }
                //Điền bảng thông tin cơ bản
                if (data && data.patInfo) {
                    fillPatBaseInfo(data.patInfo);
                    ryrq = data.patInfo.ryrq;
                }
                $('#lblRq').html($.getDate({ date: kssj }) + " 至 " + $.getDate({ date: jssj }));
                //
                if (!(data && data.list && data.list.length)) {
                    data.list = [];
                }

                //tempKssj = kssj = $.getDate({ date: kssj });   //Dung sai một chút
                //Không hiển thị bảng ngày trước ngày nhập viện
                tempKssj = kssj = ryrq > kssj ? ryrq : $.getDate({ date: kssj });   //Dung sai một chút

                var printHasNext = true;
                while (printHasNext) {
                    // Thời gian bắt đầu hiện tại
                    var thiskssj = tempKssj;
                    // Thời gian kết thúc hiện tại
                    var thisjssj = $.getDate({ date: $.dateAdd($.strToDate(thiskssj), 'd', 6) });
                    var billHtml = '<div class="drawingboard" id="board' + billIndex + '" style="width:1139px;height:660px;"><table class="bottomtbl"><tr><td>Hô hấp(lần/phút)</td></tr>';
                    billHtml += '<tr><td>Huyết áp(mmHg)</td></tr><tr><td>Độ bão hòa oxy máu%</td></tr><tr><td>Lưu lượng oxy(lít/phút)</td></tr>';
                    billHtml += '<tr><td>Số lần đại tiện</td></tr><tr><td>Lượng đưa vào(ml)</td></tr><tr><td>Tiểu&nbsp;&nbsp;tiện(ml)</td></tr>';
                    billHtml += '<tr><td>Lượng nôn(ml)</td></tr><tr><td>Lượng dịch dẫn lưu(ml)</td></tr><tr><td>Nhập lượng dịch(ml)</td></tr><tr><td>Cân&nbsp;&nbsp;nặng(kg)</td></tr>';
                    billHtml += '<tr><td>Chiều&nbsp;&nbsp;cao(cm)</td></tr></table></div>';
                    $(billHtml).appendTo($("#3cbill"))
                    rqCellValueArr.splice(0, rqCellValueArr.length);
                    for (var sj = thiskssj; sj <= thisjssj;) {
                        rqCellValueArr.push(sj);
                        var dateSj = $.strToDate(sj);
                        dateSj.add('d', 1);
                        sj = $.getDate({ date: dateSj });
                    }

                    var drawData = [];
                    for (var i = 0; i < data.list.length; i++) {
                        var item = data.list[i];
                        if ($.getDate({ date: item.rq }) >= thiskssj && $.getDate({ date: item.rq }) <= thisjssj) {
                            drawData.push(item);
                        }
                    }

                    draw(drawData, billIndex);
                    if (thisjssj >= jssj) {
                        printHasNext = false;
                    }
                    //Đặt lại thời gian bắt đầu tiếp theo
                    if (printHasNext) {
                        tempKssj = $.getDate({ date: $.dateAdd($.strToDate(thisjssj), 'd', 1) });
                        billIndex++;
                    }
                }
            }
        });
    }

    var tempData;    //Sử dụngsetTimeoutcần
    var tempKssj;
    function draw(data, index) {
        //Đặt lại trước
        $board = $('#board' + index);
        $board.find('>*:not(table)').remove();
        $.each($('#board' + index + ' .bottomtbl tr'), function () {
            $(this).find('td:gt(0)').remove();
        });
        if (!rqCellValueArr || !rqCellValueArr.length) {
            //return;
        }
        //Kiểu
        var docwd = $(document).width();
        var twdContentWidth = sspacewidth * 6 * (rqCellValueArr.length);
        twdContentWidth += sspacewidth * 9; //Làm cột ngày
        if ((docwd - twdContentWidth).toFixed(2) > 50) {
            if (window.top != window.self) {
                if (!rqCellValueArr || !rqCellValueArr.length) {

                }
                else {
                    xouterspace = parseInt((docwd - twdContentWidth).toFixed(2) / 2);  //Có thể để thêm chút khoảng trắng
                }
            }
            else {
                xouterspace = 30;
            }
        }
        else {
            xouterspace = 3;    //default
        }
        //
        reLocation();
        twLastLeft = contentStartLeft + sspacewidth * 6 * (rqCellValueArr.length);
        //
        if (!(window.isIE() && window.isIElte8())) {
            //Thêm khung vẽcanvas
            $('#board' + index).append('<canvas id="drawCanvas' + index + '" width="' + twLastLeft + '" height="' + (twLastTop + 10) + '"></canvas> ');
            checkCanvasAble();
        }
        //Vẽ
        tempData = data;
        if (canvasAble) {
            startDraw();
        }
        else {
            setTimeout("$.loading(true, '体温单绘制中，请稍后...');", 25);
            setTimeout("startDraw();", 50);
        }
    }

    function startDraw() {
        var data = tempData;
        //
        drawTemplet(data);
        //
        if (canvasAble) {
            startDraw2();
        }
        else {
            setTimeout("startDraw2();", 50);
        }
    }

    function startDraw2() {
        var data = tempData;
        //
        drawDataPoint(data);
        //
        if (canvasAble) {
            startDraw3();
        }
        else {
            $.loading(true, 'Đường nối đang được vẽ, có thể tốn thời gian, vui lòng đợi...');
            setTimeout("startDraw3();", 50);
        }
    }

    function startDraw3() {
        var data = tempData;
        //
        drawDataLigature(data);
        //
        if (canvasAble) {
        }
        else {
            $.loading(false);
        }
    }

    //TheodataĐặt lại bảng vẽ chiều dài và chiều cao
    function drawTemplet(data) {
        //Chiều dài và chiều rộng của bảng vẽ
        var totalwidth = $(window).width();
        var totalheight = bodyHeight;
        $board.css('width', totalwidth);
        $board.css('height', totalheight);
        //Viền trên của thời điểm
        drawLine(origin.x, origin.y, twLastLeft - origin.x);
        //Thêm một chút khoảng trắng bên phải
        drawLine(twLastLeft, origin.y, xouterspace).css('visibility', 'hidden');
        //bodyViền trên
        drawLine(origin.x, sjStartTop, twLastLeft - origin.x);
        //bodyViền trên
        drawLine(origin.x, sjStartTop - spc, twLastLeft - origin.x);
        //bodyViền trái
        drawLine(origin.x, origin.y, bodyLastTop - origin.y, '', 'vline');
        //contentViền trái
        drawLine(contentStartLeft, origin.y, bodyLastTop - origin.y, '', 'vline');
        //contentViền trên
        drawLine(origin.x, contentStartTop, twLastLeft - origin.x);

        //Vẽ đường dọc
        var rqCellCount = rqCellValueArr.length;
        for (var i = 0; i < rqCellCount; i++) {
            //Đường phải
            var left = contentStartLeft + sspacewidth * 6 * (i + 1);
            if (i == rqCellCount - 1) {
                //Vẽ đường đen ở phía phải nhất
                drawLine(left, origin.y, twLastTop - origin.y, '', 'vline');
            } else {
                drawLine(left, origin.y, twLastTop - origin.y, 'cred', 'vline');
            }
            //Dưới cùngtableVẽ đường dọc
            drawLine(left, twLastTop, bodyLastTop - twLastTop, '', 'vline');
            //Ở giữa5đường của các thời điểm
            for (var j = 0; j < 5; j++) {
                left = contentStartLeft + sspacewidth * 6 * i + sspacewidth * (j + 1);
                if (j === 2) {
                    //drawLine(left, sjStartTop, twLastTop - sjStartTop + spc * 11, '', 'vline');
					drawLine(left, sjStartTop, twLastTop - sjStartTop + spc * 1, '', 'vline');
                }
                else {
                    drawLine(left, sjStartTop, twLastTop - sjStartTop + spc, '', 'vline');
                }
            }
        }
        //Vẽ đường ngang
        for (var i = 0; i < (twArr.length - 1); i++) {
            var top = contentStartTop + sspace * 5 * (i + 1);
            //Đường cuối cùng bắt đầu từ tráiorigin
            var left = i == (twArr.length - 1 - 1) ? origin.x : contentStartLeft;
            //Đường cuối cùng có màu mặc định
            var colr = i == (twArr.length - 1 - 1) ? '' : 'c666';
            //Đường cuối cùng không in đậm
            var bold = i == (twArr.length - 1 - 1) ? '' : 'bold';
            drawLine(left, top, twLastLeft - left, colr, '', bold);
            //Huyết áp, mạch, hô hấp, nhiệt độ bên trái
            if (i < twArr.length - 1 - 1) {
                var ileft = left - ((contentStartLeft - origin.x) / 2) * 0 - 28;
                $div = $('<div style="position:absolute;text-align:center;left:' + ileft + 'px;top:' + (top - (sspace / 2) - 1) + 'px;width:' + sspacewidth + 'px;height:' + spc + 'px;line-height:' + spc + 'px;">'
                    + twArr[i + 1] + '℃</div>');
                $div.appendTo($board);
                //
                //               ileft = left - ((contentStartLeft - origin.x) / 4) * 1 - 28;
                //               $div = $('<div style="position:absolute;text-align:center;left:' + ileft + 'px;top:' + (top - (sspace / 2) - 1) + 'px;width:' + sspacewidth + 'px;height:' + spc + 'px;line-height:' + spc + 'px;">'
                //+ hxArr[i + 1] + '</div>');
                //               $div.appendTo($board);
                //
                ileft = left - ((contentStartLeft - origin.x) / 2) * 1 - 28;
                $div = $('<div style="position:absolute;text-align:center;left:' + ileft + 'px;top:' + (top - (sspace / 2) - 1) + 'px;width:' + sspacewidth + 'px;height:' + spc + 'px;line-height:' + spc + 'px;">'
                    + mbArr[i + 1] + '</div>');
                $div.appendTo($board);
                //
                //               ileft = left - ((contentStartLeft - origin.x) / 4) * 3 - 28;
                //               $div = $('<div style="position:absolute;text-align:center;left:' + ileft + 'px;top:' + (top - (sspace / 2) - 1) + 'px;width:' + sspacewidth + 'px;height:' + spc + 'px;line-height:' + spc + 'px;">'
                //+ xyArr[i + 1] + '</div>');
                //               $div.appendTo($board);
            }
            //ở giữa4đường nhiệt độ (phía trên đường này)
            for (var j = 0; j < 4; j++) {
                top = contentStartTop + sspace * 5 * i + sspace * (j + 1);
                drawLine(contentStartLeft, top, twLastLeft - contentStartLeft);
            }
        }
        //Dưới cùngtableVẽ đường ngang
        for (var i = 0; i < bottomtrCount; i++) {
            top = twLastTop + spc * (i + 1);
            var widthlength = twLastLeft - origin.x;
            if (i == bottomtrCount - 1) {
                widthlength++;  //Để nó trông như khép kín
            }
            drawLine(origin.x, top, widthlength);
        }
        //Dưới cùngtable  tableđường vàdivKhó căn chỉnh, vì vậy dùngdivVẽ đường
        $board.find('.bottomtbl').css('width', twLastLeft - origin.x)
            .css('left', origin.x).css('top', twLastTop).show();
        $board.find('.bottomtbl td').css('width', contentStartLeft - origin.x)
            .css('height', spc).css('line-height', spc + 'px');

        var thistdhtml = '<td style="width:' + sspacewidth + 'px;height:' + spc + 'px;line-height:' + spc + 'px;"></td>';
        for (var i = 0; i < rqCellValueArr.length; i++) {
            var thistd = "";
            var rqData = $.jsonWhere(data, function (v) { return v.rq && $.getDate({ date: v.rq }) == rqCellValueArr[i] });
            var thistz = "";
            var thisxybhd = 0;
            var thisxybhd = 0;
            var thisxyll = 0;
            var thisdbcs = 0;
            var thissrl = 0;    //Lượng đưa vào(ml)
            var thisxbl = 0;
            var thisotl = 0;
            var thisyll = 0;    //Lượng dịch dẫn lưu
            var thissrytl = 0;    //Nhập lượng dịch
            var thishx = 0;//Hô hấp
            var thissj = 0;
            var thisgxy = 0;//Tăng huyết áp
            var thisdxy = 0;//Hạ huyết áp

            if (rqData.length < 1) {
                thistd += thistdhtml;
                thistd += thistdhtml;
                thistd += thistdhtml;
                thistd += thistdhtml;
                thistd += thistdhtml;
                thistd += thistdhtml;
            } else {
                //hss Sửa vào2019.08.22 Hiển thị hô hấpbugSửa chữa
                for (var k = 1; k < 7; k++) {
                    var f = false;
                    var hx = "";
                    $.each(rqData, function (i, v) {
                        if (v.hx && v.sj / 4 == k) {
                            f = true;
                            hx = v.hx;
                        }
                    });
                    if (!f) {
                        thistd += thistdhtml;
                    } else {
                        thistd += '<td style="width:' + sspacewidth + 'px;height:' + spc + 'px;line-height:' + spc + 'px;">' + hx + '</td>';
                    }
                }
            }
            for (var j = 0; j < rqData.length; j++) {

                if (rqData[j].tz) {
                    if (rqData[j].brzt == "10") {
                        thistz += "卧";
                    } else {
                        thistz += rqData[j].tz.toString();
                    }
                }
                if (rqData[j].xybhd) {
                    thisxybhd = rqData[j].xybhd;
                }
                if (rqData[j].xyll) {
                    thisxyll = rqData[j].xyll;
                }
                if (rqData[j].dbcs) {
                    thisdbcs += rqData[j].dbcs;
                }
                if (rqData[j].xbl) {
                    thisxbl += rqData[j].xbl;
                }
                if (rqData[j].otl) {
                    thisotl += rqData[j].otl;
                }
                if (rqData[j].syl) {
                    thissrl += rqData[j].syl;
                }
                if (rqData[j].ysl) {
                    thissrl += rqData[j].ysl;
                }
                if (rqData[j].sxl) {
                    thissrl += rqData[j].sxl;
                }
                if (rqData[j].cys) {
                    thisyll += rqData[j].cys;
                }
                if (rqData[j].skyll) {
                    thisyll += rqData[j].skyll;
                }
                if (rqData[j].xyl) {
                    thisyll += rqData[j].xyl;
                }
                if (rqData[j].wyl) {
                    thisyll += rqData[j].wyl;
                }
                if (rqData[j].fxxq) {
                    thisyll += rqData[j].fxxq;
                }
                if (rqData[j].qtsc) {
                    thisyll += rqData[j].qtsc;
                }
                if (rqData[j].srytl) {
                    thissrytl += rqData[j].srytl;
                }
                if (rqData[j].xysz) {
                    thisgxy = rqData[j].xysz;
                }
                if (rqData[j].xyxz) {
                    thisdxy = rqData[j].xyxz;
				}
				//Trạng thái nhập viện
				var brzt1 = ["", "入", "在", "出", "请", "转", "转", "拒", "返", "复", "卧"];
				var brzt2 = ["", "院", "院", "院", "假", "入", "出", "测", "院", "测", "床"]
				for (var j = 0; j < rqData.length; j++) {
					if (rqData[j].brzt) {
						thisbrzt = rqData[j].brzt;
					}
					if (thisbrzt == "1" || thisbrzt == "3" || thisbrzt == "4" || thisbrzt == "8") {
						left = contentStartLeft + i * sspacewidth * 6 + j * sspacewidth;
						top = origin.y + spc * 4-spc;
						$div = $('<div style="position:absolute;text-align:center;left:' + left + 'px;top:' + top + 'px;width:' + sspacewidth + 'px;height:' + spc + 'px;line-height:' + spc + 'px;">'
							+ brzt1[thisbrzt] + '</div>');
						$div.appendTo($board);
					}
				}
				for (var j = 0; j < rqData.length; j++) {
					if (rqData[j].brzt) {
						thisbrzt = rqData[j].brzt;
					}
					if (thisbrzt == "1" || thisbrzt == "3" || thisbrzt == "4" || thisbrzt == "8") {
						left = contentStartLeft + i * sspacewidth * 6 + j * sspacewidth;
						top = origin.y + spc * 5 - spc;

						$div = $('<div style="position:absolute;text-align:center;left:' + left + 'px;top:' + top + 'px;width:' + sspacewidth + 'px;height:' + spc + 'px;line-height:' + spc + 'px;">'
							+ brzt2[thisbrzt] + '</div>');
						$div.appendTo($board);
					}
				}

				//Hiển thị thời gian 
				for (var j = 0; j < rqData.length; j++) {
					var showSJ = "";
					if (rqData[j].sj < 10) {
						showSJ = "0";
					} else {
						showSJ = rqData[j].sj.toString().substring(0, 1);
					}
					left = contentStartLeft + i * sspacewidth * 6 + j * sspacewidth;
					top = origin.y + spc * 7.4 - spc;

					$div = $('<div style="position:absolute;text-align:center;left:' + left + 'px;top:' + top + 'px;width:' + sspacewidth + 'px;height:' + spc + 'px;line-height:' + spc + 'px;">'
						+ showSJ + '</div>');
					$div.appendTo($board);
				}

    //Vẽ điểm nhiệt độ
    function drawTwPoint(item) {
        if (item.tw) {
            var idx = getIndexOfRq(item.rq);
            if (idx < 0) {
                return;
            }
			var left = contentStartLeft + (sspacewidth * 6) * idx + sspacewidth * ((item.sj + 2)/ 4 - 1);
            var top = contentStartTop;
            if (item.tw > twArr[0]) {
                top = contentStartTop;
            }
            else if (item.tw < twArr[twArr.length - 1]) {
                top = twLastTop;
            }
            else {
                //*5là vì mỗi1độ chiếm5ô .toFixed(2)Cójsphép trừbug
                top += (twArr[0] - item.tw).toFixed(2) * 5 * sspace;
            }
            //để nó căn vào thời điểm này căn giữa
            left += sspacewidth / 2;
            if ($.jsonWhere(twArr, function (v) { return v == item.tw }).length == 1
                && item.tw != twArr[0] && item.tw != twArr[twArr.length - 1]) {
                top = top + 0.5;    //Hiển thị đúng giờ là trường hợp đặc biệt, vì chiều cao của đường thẳng2px
            }
            item.twLocation = { x: left, y: top };
            drawX(left, top, twColor, item.tw);
            //Giả mạotitle
            drawFalsifyTitle(left, top, item.tw);
        }
    }


@using Newtouch.Infrastructure
@{
    ViewBag.Title = "";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script src="@SiteUrl.GetStaticResourceScriptUrl("~/js/dialog/dialog.js")"></script>
<script src="~/Content/js/utility.js"></script>
<div class="panel panel-default">
    @Html.Partial("_TemperatureChartForCQ")
</div>

<div id="loadingPage" style="display: none;">
    <div class="loading-shade"></div>
    <div class="loading-content" onclick="$.loading(false)">Dữ liệu đang được tải, vui lòng đợi…</div>
</div>

<div style="position:fixed;top:10px;left:250px;cursor:pointer;">
    <img id="print" src="@SiteUrl.GetStaticResourceScriptUrl("~/img/print.png")" title="In" alt="In" />
</div>
<script>
    $(function () {
        initControl();

        var kssj = $.request('kssj');
        var jssj = $.request('jssj');
        var zyh = $.request('zyh');
        search(kssj, jssj, zyh);
    });

    function initControl() {
        $('#print').click(function () {
            $('#print').hide();
            window.print();
        });

        $(document).click(function () {
            $('#print:hidden').show();
        });
    }

</script>
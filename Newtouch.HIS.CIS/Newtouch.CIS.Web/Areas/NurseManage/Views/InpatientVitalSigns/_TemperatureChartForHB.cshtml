        $('.lblCw').html(patInfo.cwmc);
        //$('#lblRyrq').html(patInfo.ryrq.substring(0,10));
        if (patInfo.ryrq != null) {
            $('.lblRqrq').html(patInfo.ryrq.substring(0, 10));
        }

        if (patInfo.cqrq != null) {
            $('.lblCqrq').html(patInfo.cqrq.substring(0, 10));
        }
    }


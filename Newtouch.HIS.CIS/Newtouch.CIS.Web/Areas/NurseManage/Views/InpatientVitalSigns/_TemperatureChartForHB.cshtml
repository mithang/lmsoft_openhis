<script>
    var billIndex = 0;//Dấu phân trang phiếu ba chỉ số
    var billpageks = [];
    var billpagejs = [];
    var $board = null
    //base
    var spc = 16;
    var sspace = 11;
    var sspacewidth = 14;
    var outerspace = 3; //Khoảng trắng bên ngoài phiếu nhiệt độ
    var xouterspace = 3;
    var bodyHeight = 800;   //Chiều cao tổng thể

    function drawTwMemo() {
        if (ztItem.length > 0) {
            for (var i = 0; i < ztItem.length; i++) {
                idx = getIndexOfRq(ztItem[i].rq);
                var left = contentStartLeft + (sspacewidth * 6) * idx + sspacewidth * parseInt(ztItem[i].sj / 4);

                { label: "hxj", name: "hxj", hidden: true, editable: true },
                { label: "Nhịp tim(lần/phút)", name: "xl", width: 65, align: 'left', editwidth: "75%", editable: true },
                { label: "Mạch(lần/phút)", name: "mb", width: 65, align: 'left', editwidth: "75%", editable: true },
                { label: "Hô hấp(lần/phút)", name: "hx", width: 65, align: 'left', editwidth: "75%", editable: true },
                { label: "hxj", name: "hxj", width: 50, align: 'left', hidden: true },
                //{label: "Huyết áptrênGiá trị", name: "xysz", width: 50, align: 'left', editable: true},
                //{ label: "Huyết ápdướiGiá trị", name: "xyxz", width: 50, editable: true, align: 'left' },
                { label: "Huyết ápGiá trị trên dưới", name: "xysxz", width: 80, align: 'left', editwidth: "75%", editable: true },

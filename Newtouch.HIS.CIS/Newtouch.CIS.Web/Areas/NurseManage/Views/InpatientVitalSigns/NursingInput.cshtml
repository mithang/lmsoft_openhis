                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    //dùng làmLưuĐã chọncủaGiá trị
                                    $("#" + rowid + "_twclfs").val($(this).val());
                                }
                            }
                        ]
                    }
                },
                { label: "twclfs", name: "twclfs", hidden: true, editable: true },
                { label: "Nhiệt độ(℃)", editwidth: "75%", required: false, name: "tw", width: 50, align: 'left', editable: true },
                {
                    label: "Máy tạo nhịp", name: "qbqtext", width: 65, align: 'left', edittype: 'select', editwidth: "65%", editable: true, editoptions: {
                        value: { 1: 'Có', 0: 'Không' },
                        dataEvents: [
                           {
                               type: 'change',
                               fn: function (e) {
                                   var row = $(e.target).closest('tr.jqgrow');
                                   var rowid = row.attr('id');
                                   //dùng làmLưuĐã chọncủaGiá trị
                                   $("#" + rowid + "_qbq").val($(this).val());
                               }
                           }
                        ]
                    }
                },
                { label: "qbq", name: "qbq", hidden: true, editable: true },
                {
                    label: "Máy hô hấp", name: "hxjtext", width: 65, align: 'left', edittype: 'select', editwidth: "65%", editable: true, editoptions: {

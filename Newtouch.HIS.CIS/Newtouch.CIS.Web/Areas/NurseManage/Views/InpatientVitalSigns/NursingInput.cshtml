                                    //dùng làmLưuĐã chọncủaGiá trị
                                    $("#" + rowid + "_brzt").val($(this).val());
                                }
                            }
                        ]
                    }
                },
                { label: "Đánh dấu trạng thái<br />(giờ)", name: "brzt_hh", width: 80, align: 'left', editable: true },

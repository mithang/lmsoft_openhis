    function settetime() {

        var date = new Date();
        var dates = date.getHours();
        var datef = date.getMinutes();
        if (datef < 9) {
            datef = "0" + datef;
        }
        var datem = date.getSeconds();
        if (datem < 9) {
            datem = "0" + datem;
        }
        var tetime = dates + ":" + datef + ":" + datem;
        //console.log(tetime);
        $('#txt_yzxsj').val(tetime);
    }


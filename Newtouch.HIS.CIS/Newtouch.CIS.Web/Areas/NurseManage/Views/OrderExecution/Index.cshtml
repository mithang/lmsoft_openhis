    //Liên kết chi phí
    function BindingFee() {
        //allbtndisabled();
        var selPatTrees = $("#BqTreeList").getCheckedNodeObjArray();
        if (selPatTrees == null || selPatTrees.length < 1) {
            let res = confirm('Y lệnh phụ thuộc chưa chọn bệnh nhân Có tiếp tục không?');
            if (res == true) {
                $.modalOpen({
                    id: "BindingFeeForm",
                    title: "Y lệnh phụ thuộc",
                    url: "/NurseManage/OrderExecution/BindingFeeForm?zyh=&yzid=",
                    width: "1000px",
                    height: "700px",
                    btn: ['', '关闭'],
                    btnclass: ['', 'btn btn-danger'],
                    callBack: function (iframeId) {
                        RefreshOrder();
                        //var Obj = top.frames[iframeId].submitForm();
                        $.modalClose("BindingFeeForm");
                    },
                    cancelCallBack: function (iframeId) {
                        reloadgrid();
                        $.modalClose("BindingFeeForm");
                    }
                });
                return;
            } else {
                return;
            }
        }
        var zyharr = [];
        for (var i = 0; i < selPatTrees.length; i++) {
            if (selPatTrees[i].Ex1 === "c") {
                zyharr.push({ zyh: selPatTrees[i].value});
            }
        }
        if (zyharr.length==0) {
            $.modalAlert("Vui lòng chọn trước bệnh nhân cần thực hiện", 'warning');
            return;
        }
        if (zyharr.length>1) {
            $.modalAlert("Liên kết chi phí chỉ được chọn một bệnh nhân", 'warning');
            return;
        }
        var strYZID = [];
        var selRowIds = jQuery("#gridList").jqGrid("getGridParam", "selarrrow");//đã chọnid
        if (selRowIds == null || selRowIds.length === 0) {
            let res = confirm('Y lệnh phụ thuộc chưa chọn thuốc/Hạng mục Có tiếp tục không?');
            if (res == true) {//Chưa chọn y lệnh hoặc thuốc để thêm y lệnh mới
                $.modalOpen({
                    id: "BindingFeeForm",
                    title: "Y lệnh phụ thuộc",
                    url: "/NurseManage/OrderExecution/BindingFeeForm?zyh=" + zyharr[0].zyh + "&yzid=" +"",
                    width: "1000px",
                    height: "700px",
                    btn: ['', '关闭'],
                    btnclass: ['', 'btn btn-danger'],
                    callBack: function (iframeId) {
                        reloadgrid();
                        //var Obj = top.frames[iframeId].submitForm();
                        $.modalClose("BindingFeeForm");
                    },
                    cancelCallBack: function (iframeId) {
                        reloadgrid();
                        $.modalClose("BindingFeeForm");
                    }
                });
            } else {
                return;
            }
        } else {
            for (var i = 0; i < selRowIds.length; i++) {
                var rowData = $("#gridList").jqGrid('getRowData', selRowIds[i]);
                strYZID.push({
                    zyh: rowData.zyh, yzid: rowData.yzid, yzxz: rowData.yzxz, yzlx: rowData.yzlx, dj: rowData.dj,
                    zxsj: rowData.zxsj, ypmc: rowData.xmmc, zh: rowData.zh, zh1: rowData.zh1, isjf: rowData.isjf,
                    yfztbs: rowData.yfztbs, yply: rowData.yply, brxm: rowData.hzxm, yzh: rowData.yzh, sl: rowData.sl
                });
            }
            if (strYZID.length > 1) {
                for (var i = 0; i < strYZID.length; i++) {
                    if (strYZID[i].zh == null || strYZID[i].zh == "") {
                        $.modalAlert("Nhiều y lệnh không thể liên kết", 'warning');
                        return;
                    }
                    for (var j = 0; j < strYZID.length; j++) {
                        if (strYZID[i].zh != strYZID[j].zh) {
                            $.modalAlert("Nhiều y lệnh không thể liên kết", 'warning');
                            return;
                        }
                    }
                }
            }
            $.modalOpen({
                id: "BindingFeeForm",
                title: "Y lệnh phụ thuộc",
                url: "/NurseManage/OrderExecution/BindingFeeForm?zyh=" + zyharr[0].zyh + "&yzid=" + strYZID[0].yzid,
                width: "1000px",
                height: "700px",
                btn: ['', '关闭'],
                btnclass: ['', 'btn btn-danger'],
                callBack: function (iframeId) {
                    //var Obj = top.frames[iframeId].submitForm();
                    reloadgrid();
                    $.modalClose("BindingFeeForm");

                },
                cancelCallBack: function (iframeId) {
                    reloadgrid();
                    $.modalClose("BindingFeeForm");
                }
            });
        }

    }
    function reloadgrid() {
        var selPatTrees = $("#BqTreeList").getCheckedNodeObjArray();
        if (selPatTrees == null || selPatTrees.length < 1) {
            $.modalAlert("Vui lòng chọn trước bệnh nhân cần thực hiện", 'warning');
            return;
        }
        var patzyh = "";
        for (var i = 0; i < selPatTrees.length; i++) {
            if (selPatTrees[i].Ex1 === "c") {
                patzyh += selPatTrees[i].value + ",";
                //Tiền tạm ứng vượt hạn mức không thể thực hiện
                //if (UnExecutionList.indexOf(selPatTrees[i].value) != -1) {
                //    $.modalAlert("Tài khoản tạm ứng đã nợ phí,Không thể phát sinh tính phí,Cần nạp tiền vào tài khoản tạm ứng trước", 'warning');
                //    return;
                //}
            }
        }
        if (patzyh === "") {
            $.modalAlert("Vui lòng chọn trước bệnh nhân cần thực hiện", 'warning');
            allbtn();
            return;
        }
        $('#gridList').jqGrid('setGridParam', {
            postData: {
                patList: patzyh, zxsj: $('#txt_zxrq').val() + " " + $('#txt_yzxsj').val()
            }
        }).trigger("reloadGrid");
    }
    //Xóa và hủy liên kết y lệnh
    function DeleteBind() {
        //allbtndisabled();
        var selPatTrees = $("#BqTreeList").getCheckedNodeObjArray();
        if (selPatTrees == null || selPatTrees.length < 1) {
            $.modalAlert("Vui lòng chọn trước bệnh nhân cần liên kết chi phí", 'warning');
            return;
        }
        var zyharr = [];
        for (var i = 0; i < selPatTrees.length; i++) {
            if (selPatTrees[i].Ex1 === "c") {
                zyharr.push({ zyh: selPatTrees[i].value });
            }
        }
        if (zyharr.length == 0) {
            $.modalAlert("Vui lòng chọn trước bệnh nhân", 'warning');
            return;
        }
        if (zyharr.length > 1) {
            $.modalAlert("Hủy y lệnh phụ thuộc chỉ được chọn một bệnh nhân", 'warning');
            return;
        }
        var strYZID = [];
        var selRowIds = jQuery("#gridList").jqGrid("getGridParam", "selarrrow");//đã chọnid
        if (selRowIds == null || selRowIds.length === 0) {
            $.modalAlert("Vui lòng chọn y lệnh cần hủy hoặc dừng", 'warning');
            return;
        }
        for (var i = 0; i < selRowIds.length; i++) {
            var rowData = $("#gridList").jqGrid('getRowData', selRowIds[i]);
            if (rowData.isfsyz != null && rowData.isfsyz!="") {
                strYZID.push({
                    zyh: rowData.zyh, yzid: rowData.yzid, yzxz: rowData.yzxz, yzlx: rowData.yzlx, dj: rowData.dj,
                    zxsj: rowData.zxsj, ypmc: rowData.xmmc, zh: rowData.zh, zh1: rowData.zh1, isjf: rowData.isjf,
                    yfztbs: rowData.yfztbs, yply: rowData.yply, brxm: rowData.hzxm, yzh: rowData.yzh, isfsyz: rowData.isfsyz
                });
            }
        }
        if (strYZID.length > 1) {
            for (var i = 0; i < strYZID.length; i++) {
                if (strYZID[i].zh == null || strYZID[i].zh == "") {
                    $.modalAlert("Nhiều y lệnh không thể hủy bỏ/Dừng", 'warning');
                    return;
                }
                for (var j = 0; j < strYZID.length; j++) {
                    if (strYZID[i].zh != strYZID[j].zh) {
                        $.modalAlert("Nhiều y lệnh không thể hủy bỏ/Dừng", 'warning');
                        return;
                    }
                }
            }
        }
        if (strYZID[0].isfsyz != null && strYZID[0].isfsyz != "") {
            $.ajax({
                url: "/NurseManage/OrderExecution/DeleteBind",
                data: { zyh: zyharr[0].zyh, yzid: strYZID[0].yzid, yzxz: strYZID[0].yzxz },
                dataType: "json",
                type: "POST",
                async: false,
                success: function (data) {
                    if (data != null && data.message != "") {
                        $.modalAlert("Hủy bỏ/Dừng thất bại!" + data.message, 'warning');
                        return;
                    }
                    else {
                        $.modalAlert("Hủy bỏ/Dừng thành công!", 'success');
                        reloadgrid();
                        return;
                    }
                }
            });

        }
        else {
            $.modalAlert("Vui lòng chọn y lệnh phụ thuộc để hủy!", 'warning');
            return;
        }
    }
</script>
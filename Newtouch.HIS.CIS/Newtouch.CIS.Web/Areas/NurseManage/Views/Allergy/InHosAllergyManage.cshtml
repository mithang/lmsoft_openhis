@{
    ViewBag.Title = "Test daQuản lý";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    #btn_search {
        width: 45px;
        font-weight: bolder;
    }
</style>
<div class="panel panel-default">
    <div class="panel-heading navb-bg">
        Điều kiện lọc
    </div>
    <div style="padding: 2px;">
        <table class="form">
            <tr>
                <td class="formTitle">Từ khóa:</td>
                <td class="formValue">
                    <input type="text" class="form-control" id="keyword" placeholder="Số nhập viện/Họ tên/Pinyin" />
                </td>
                <td class="formTitle">Khoa:</td>
                <td class="formValue formDdlSelectorTd">
                    <select class="form-control" id="sel_ks">
                        <option value="">==Tất cả==</option>
                    </select>
                </td>
                <td class="formTitle">Trạng thái:</td>
                <td class="formValue formDdlSelectorTd">
                    <select class="form-control" id="sel_zt">
                        <option value="">===Tất cả===</option>
                        <option value="0">Chưa thực hiện</option>
                        <option value="1">Đã thực hiện</option>
                    </select>
                </td>
                <td class="formTitle">Nhập việnThời gian:</td>
                <td class="formValue">
                    <input id="txt_kssj" type="text" class="form-control input-wdatepicker" style="width:95%; float:left;" onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" value="@DateTime.Now.ToString("yyyy-MM-01")">
                </td>
                <td class="formTitle" style="width:5px">đến</td>
                <td class="formValue">
                    <input id="txt_jssj" type="text" class="form-control input-wdatepicker" style="width:95%; float:left;" onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")">
                </td>
                <td class="formTitle">
                    <input type="button" class="btn btn-primary btn-md" id="btn_search" value="Tra cứu" />
                </td>
                <td></td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel" style="width: 48%;float:left;">
    <table id="gridListPatient"></table>
    <div id="gridPager1" rel="form1"></div>
</div>
<div class="gridPanel" style="margin-left:0.5%;width:51.5%;float:left;">
    <table id="gridListPs"></table>
    <div id="gridPager2" rel="form2"></div>
</div>
@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
    ShowKeyList = new[] { 7, 8 },
    F7Text = "Thực hiện",
    F8Text = "HủyThực hiện"
})
<script>
    var localdata = {};
    var $gridPsList = $("#gridListPs");
    $(function () {
        //Khi thay đổi kích thước cửa sổ trình duyệt, tải lạijqGridđộ rộng
        $(window).resize(function () {

        });
        Initial();
    });

    //Khởi tạo
    function Initial() {
        gridList();
        gridMxInfo();
        //gắnKhoa
        $("#sel_ks").bindSelect({
            url: "/SystemManage/SysDepartment/GetTreeSelectJson",
        });
    }

    //chínhbảngthông tin
    function gridList() {
        var $gridList = $("#gridListPatient");
        $gridList.dataGrid({
            url: "/NurseManage/Allergy/GetZyPatientListJson",
            postData: getGridListPar(),
            height: $(window).height() - document.getElementById('gridListPatient').offsetTop - 120,
            colModel: [
                { label: 'Id', name: 'Id', key: true, hidden: true },
                { label: 'Số bệnh án', name: 'blh', hidden: true },
                { label: 'Số nhập viện', name: 'zyh',width: 100, align: 'center' },
                { label: 'Họ tên', name: 'xm', width: 70, align: 'center' },
                {
                    label: 'Giới tính', name: 'xb', width: 30, align: 'center', formatter: function (val) {
                        if (val == "1") {
                            return "Nam";
                        } else { return "Nữ"; }
                    }},
                { label: 'Ngày sinh', name: 'birth', width: 80, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Số giường', name: 'BedCode', width: 80, align: 'center' },
                { label: 'Pinyin', name: 'py', width: 50, align: 'center' }
            ],
            pager: "#gridPager1",
            rowNum: '15',
            sortname: 'CreateTime desc',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                localdata = {};
                ajaxmxList();
            },
        });
        $("#btn_search").click(function () {
            $gridPsList.jqGrid('clearGridData');
            $gridList.jqGrid('setGridParam',
                {
                    postData: getGridListPar()
                }).trigger('reloadGrid');
        });
    }
    //Tra cứutham số
    function getGridListPar() {
        var ks = $('#sel_ks').val();
        var keyword = $('#keyword').val();
        var kssj = $('#txt_kssj').val();
        var jssj = $('#txt_jssj').val();
        var zxzt = $('#sel_zt').val();
        return { keyword: keyword, ks: ks, kssj: kssj, jssj: jssj, zxzt: zxzt }
    }

    //tảiBệnh nhânTest daMục
    function ajaxmxList() {
        var rowData = $("#gridListPatient").jqGridRowValue();
        var zyh = rowData.zyh;
        localdata["zyh"] = zyh;
        localdata["blh"] = rowData.blh;
        localdata["xm"] = rowData.xm;
        localdata["sex"] = rowData.xb;
        $gridPsList.jqGrid('setGridParam', {
            url: "/NurseManage/Allergy/GetZyPatientPsItemsJson",
            postData: { zyh: zyh },
        }).trigger('reloadGrid');
    }

    //Test daMục
    function gridMxInfo() {
        $gridPsList.dataGrid({
            height: $(window).height() - document.getElementById('gridListPs').offsetTop - 120,
            multiselect: false,
            colModel: [
                { label: 'Y lệnhid', name: 'yzId', key: true, hidden: true },
                { label: 'Mụccode', name: 'xmCode', hidden: true },
                { label: 'Số bệnh án', name: 'blh', hidden: true },
                { label: 'Thông tin dị ứngId', name: 'gmxxId', hidden: true },
                { label: 'Tên mục', name: 'xmmc', width: 100, align: 'center' },
                { label: 'Số lượng', name: 'sl', width: 50, align: 'center' },
                { label: 'Đơn vị', name: 'dw', width: 50, align: 'center' },
                { label: 'Liều lượng', name: 'ypjl', width: 50, align: 'center' },
                { label: 'Quy cách', name: 'ypgg', width: 50, align: 'center' },
                { label: 'Người thực hiện', name: 'CreatorName', width: 50, align: 'center' },
                { label: 'Kết quả', name: 'Result', width: 50, align: 'center' },
                { label: 'Ghi chú', name: 'Remark', width: 50, align: 'center' }
            ],
            pager: "#gridPager2",
            rowNum: '15',
            sortname: 'CreateTime desc',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                newtouch_event_f7();
            },
        });
    }

    //Thực hiện
    function newtouch_event_f7() {
        if (!$gridPsList.jqGridRowValue().xmCode) {
            $.modalAlert("Vui lòng chọn một mục test da", 'warning');
            return;
        }
        var sdf = $gridPsList.jqGridRowValue()
        if ($gridPsList.jqGridRowValue().Result) {
            $.modalAlert("Đã làm test da, cấm thao tác trùng lặp", 'warning');
            return;
        }
        var xmcode = $gridPsList.jqGridRowValue().xmCode;
        var xmmc = $gridPsList.jqGridRowValue().xmmc;
        var yzId = $gridPsList.jqGridRowValue().yzId;
        $.modalOpen({
            id: "Form",
            title: "Thông tin dị ứng",
            url: "/NurseManage/Allergy/AllergyForm?yzId=" + yzId + "&xmcode=" + xmcode + "&xmmc=" + xmmc + "&blh=" + localdata.blh + "&xm=" + localdata.xm + "&sex=" + localdata.sex,
            width: "500px",
            height: "340px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $gridPsList.resetSelection();
                    $gridPsList.trigger("reloadGrid");
                });
            }
        });
    }

    //HủyThực hiện
    function newtouch_event_f8() {
        var gmxxId = $gridPsList.jqGridRowValue().gmxxId;
        var blh = $gridPsList.jqGridRowValue().blh;
        if (!!!gmxxId) {
            $.modalAlert("Vui lòng chọn một dòng mục đã thực hiện", 'warning');
            return;
        }
        $.deleteForm({
            url: "@Url.Action("DeleteExecutedGmxx")",
            param: { gmxxId: gmxxId },
            success: function () {
                $gridPsList.resetSelection();
                $gridPsList.trigger("reloadGrid");
            }
        })
    }
</script>

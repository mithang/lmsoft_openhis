@{
    ViewBag.Title = "Quản lý test da";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    #btn_search {
        width: 45px;
        font-weight: bolder;
    }
</style>
<div class="panel panel-default">
    <div class="panel-heading navb-bg">
        Điều kiện lọc
    </div>
    <div style="padding: 2px;">
        <table class="form">
            <tr>
                <td class="formTitle">Từ khóa:</td>
                <td class="formValue">
                    <input type="text" class="form-control" id="keyword" placeholder="Số hồ sơ bệnh án/Họ tên/Phiên âm" />
                </td>
                <td class="formTitle">Khoa:</td>
                <td class="formValue formDdlSelectorTd">
                    <select class="form-control" id="sel_ks">
                        <option value="">==全部==</option>
                    </select>
                </td>
                <td class="formTitle">Trạng thái:</td>
                <td class="formValue formDdlSelectorTd">
                    <select class="form-control" id="sel_zt">
                        <option value="">===全部===</option>
                        <option value="0">Chưa thực hiện</option>
                        <option value="1">Đã thực hiện</option>
                    </select>
                </td>
                <td class="formTitle">Thời gian khám:</td>
                <td class="formValue">
                    <input id="txt_kssj" type="text" class="form-control input-wdatepicker" style="width:95%; float:left;" onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" value="@DateTime.Now.ToString("yyyy-MM-01")">
                </td>
                <td class="formTitle" style="width:5px">đến</td>
                <td class="formValue">
                    <input id="txt_jssj" type="text" class="form-control input-wdatepicker" style="width:95%; float:left;" onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </td>
                <td class="formTitle">
                    <input type="button" class="btn btn-primary btn-md" id="btn_search" value="Tra cứu" />
                </td>
                <td></td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel" style="width: 48%;float:left;">
    <table id="gridListPatient"></table>
    <div id="gridPager1" rel="form1"></div>
</div>
<div class="gridPanel" style="margin-left:0.5%;width:51.5%;float:left;">
    <table id="gridListPs"></table>
    <div id="gridPager2" rel="form2"></div>
</div>
@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
    ShowKeyList = new[] { 7, 8 },
    F7Text = "执行",
    F8Text = "取消执行"
})
<script>
    var localdata = {};
    var $gridPsList = $("#gridListPs");
    $(function () {
        //Khi thay đổi kích thước cửa sổ trình duyệt thì tải lạijqGridchiều rộng của
        $(window).resize(function () {

        });
        Initial();
    });

    //Khởi tạo
    function Initial() {
        gridList();
        gridMxInfo();
        //Liên kết khoa
        $("#sel_ks").bindSelect({
            url: "/SystemManage/SysDepartment/GetTreeSelectJson",
        });
    }

    //Thông tin bảng chính
    function gridList() {
        var $gridList = $("#gridListPatient");
        $gridList.dataGrid({
            url: "/NurseManage/Allergy/GetMzPatientListJson",
            postData: getGridListPar(),
            height: $(window).height() - document.getElementById('gridListPatient').offsetTop - 120,
            colModel: [
                { label: 'Id', name: 'jzId', key: true, hidden: true },
                //{ label: 'Nguồn', name: 'Name', width: 30, align: 'center' },
                { label: 'Số hồ sơ bệnh án', name: 'blh', width: 100, align: 'center' },
                { label: 'Họ tên', name: 'xm', width: 70, align: 'center' },
                { label: 'Giới tính', name: 'xb', width: 30, align: 'center' },
                { label: 'Ngày sinh', name: 'csny', width: 80, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Khoa', name: 'ghksmc', width: 80, align: 'center' },
                { label: 'Phiên âm', name: 'py', width: 50, align: 'center' }
            ],
            pager: "#gridPager1",
            rowNum: '15',
            sortname: 'CreateTime desc',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                localdata = {};
                ajaxmxList();
            },
        });
        $("#btn_search").click(function () {
            $gridPsList.jqGrid('clearGridData');
            $gridList.jqGrid('setGridParam',
                {
                    postData: getGridListPar()
                }).trigger('reloadGrid');
        });
    }
    //Tham số tra cứu
    function getGridListPar() {
        var ksmc = $("#sel_ks").find("option:selected").text();
        var ks = ksmc.indexOf('=') >= 0 ? "" : ksmc;
        var keyword = $('#keyword').val();
        var kssj = $('#txt_kssj').val();
        var jssj = $('#txt_jssj').val();
        var zxzt = $('#sel_zt').val();
        return { keyword: keyword, ks: ks, kssj: kssj, jssj: jssj, zxzt: zxzt }
    }

    //Tải hạng mục test da của bệnh nhân
    function ajaxmxList() {
        var rowData = $("#gridListPatient").jqGridRowValue();
        var Id = rowData.jzId;
        localdata["jzid"] = rowData.Id;
        localdata["blh"] = rowData.blh;
        localdata["xm"] = rowData.xm;
        localdata["sex"] = rowData.xb;
        $gridPsList.jqGrid('setGridParam', {
            url: "/NurseManage/Allergy/GetMzPatientPsItemsJson",
            postData: { Id: Id },
        }).trigger('reloadGrid');
    }

    //Hạng mục test da
    function gridMxInfo() {
        $gridPsList.dataGrid({
            height: $(window).height() - document.getElementById('gridListPs').offsetTop - 120,
            multiselect: false,
            colModel: [
                { label: 'cfmxId', name: 'cfmxId', key: true, hidden: true },
                { label: 'Hạng mụccode', name: 'xmCode', hidden: true },
                { label: 'Số hồ sơ bệnh án', name: 'blh', hidden: true },
                { label: 'Thông tin dị ứngId', name: 'gmxxId', hidden: true },
                { label: 'Tên hạng mục', name: 'xmmc', width: 100, align: 'center' },
                { label: 'Số lượng', name: 'sl', width: 30, align: 'center' },
                { label: 'Đơn giá', name: 'dj', width: 50, align: 'center' },
                { label: 'Số tiền', name: 'je', width: 50, align: 'center' },
                { label: 'Đơn vị', name: 'dw', width: 50, align: 'center' },
                { label: 'Người thực hiện', name: 'CreatorName', width: 50, align: 'center' },
                { label: 'Kết quả', name: 'Result', width: 50, align: 'center' },
                { label: 'Ghi chú', name: 'Remark', width: 100, align: 'center' }
            ],
            pager: "#gridPager2",
            rowNum: '15',
            sortname: 'CreateTime desc',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                newtouch_event_f7();
            },
        });
    }

    //Thực hiện
    function newtouch_event_f7() {
        if (!$gridPsList.jqGridRowValue().xmCode) {
            $.modalAlert("Vui lòng chọn một hạng mục test da", 'warning');
            return;
        }
        if ($gridPsList.jqGridRowValue().Result) {
            $.modalAlert("Đã làm test da rồi, cấm thao tác trùng lặp", 'warning');
            return;
        }
        var xmcode = $gridPsList.jqGridRowValue().xmCode;
        var xmmc = $gridPsList.jqGridRowValue().xmmc;
        var cfmxid = $gridPsList.jqGridRowValue().cfmxId;
        $.modalOpen({
            id: "Form",
            title: "Thông tin dị ứng",
            url: "/NurseManage/Allergy/AllergyForm?cfmxid=" + cfmxid + "&xmcode=" + xmcode + "&xmmc=" + xmmc + "&blh=" + localdata.blh + "&xm=" + localdata.xm + "&sex=" + localdata.sex,
            width: "500px",
            height: "340px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $gridPsList.resetSelection();
                    $gridPsList.trigger("reloadGrid");
                });
            }
        });
    }
    
    //Hủy thực hiện
    function newtouch_event_f8() {
        var gmxxId = $gridPsList.jqGridRowValue().gmxxId;
        var blh = $gridPsList.jqGridRowValue().blh;
        if (!!!gmxxId) {
            $.modalAlert("Vui lòng chọn một hạng mục đã thực hiện", 'warning');
            return;
        }
        $.deleteForm({
            url: "@Url.Action("DeleteExecutedGmxx")",
            param: { gmxxId: gmxxId },
            success: function () {                
                $gridPsList.resetSelection();
                $gridPsList.trigger("reloadGrid");
            }
        })
    }
</script>

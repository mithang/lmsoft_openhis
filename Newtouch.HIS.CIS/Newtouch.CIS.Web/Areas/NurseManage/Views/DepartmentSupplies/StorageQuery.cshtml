
@{
    ViewBag.Title = "Tra cứu tồn kho vật tư khoa";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<style>
    #btn_search {
        width: 45px;
        font-weight: bolder;
    }
    #btn_sync {
        width: 45px;
        font-weight: bolder;
    }
    #btn_print {
        width: 45px;
        background-color: #fff;
        color: #00a9ea;
        font-weight: bolder;
    }

    #TabGrid {
        width: 100%;
        position: fixed;
        bottom: 10px;
        right: 0;
        z-index: 8888;
        background-color: #253443;
        filter: alpha(Opacity=95);
        -moz-opacity: 0.95;
        opacity: 0.95;
        box-shadow: 0px 2px 10px #909090;
    }

        #TabGrid > * {
            filter: alpha(Opacity=95);
            -moz-opacity: 0.95;
            opacity: 0.95;
        }

    .showbotton {
        display: none;
        position: fixed;
        bottom: 5px;
        right: 0;
        z-index: 9999;
        background-color: #ccc;
        width: 50px;
        height: 44px;
        filter: alpha(Opacity=90);
        -moz-opacity: 0.9;
        opacity: 0.9;
        cursor: pointer;
        border-radius: 100px 0 0 100px;
    }
</style>
<form id="form1">
    <div class="panel panel-default">
        <div class="panel-heading">Điều kiện lọc</div>
        <div style="padding-right:10px;">
            <table class="form">
                <tr>
                    <td class="formTitle">Tên vật tư:</td>
                    <td class="formValue">
                        <input type="text" id="keyWord" class="form-control" placeholder="Phiên âm/Tên" />
                        <input type="hidden" id="productId" value="" />
                    </td>
                    <td class="formTitle">Khoa:</td>
                    <td class="formValue formDdlSelectorTd">
                        <input type="text" id="ks" class="form-control" autocomplete="off" style="width: 200px" />
                        <input type="text" id="ksCode" class="form-control" style="display:none;" />
                    </td>
                    <td class="formTitle">Loại:</td>
                    <td class="formValue formDdlSelectorTd">
                        <select class="form-control" id="lb">
                            <option value="">Tất cả</option>
                        </select>
                    </td>
                    <td class="formTitle">Hiển thị tồn kho bằng 0:</td>
                    <td class="formValue formDdlSelectorTd">
                        <select class="form-control" id="xslkc" name="xslkc">
                            <option value="1">Có</option>
                            <option value="0">Không</option>
                        </select>
                    </td>
                    <th class="formTitle" colspan="2">
                        <input type="button" class="btn btn-primary btn-md" id="btn_search" value="Tra cứu" />
                        <input type="button" class="btn btn-primary btn-md" id="btn_sync" value="Đồng bộ vật tư" />
                    </th>
                    <td class="formValue"></td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel" style="margin-top:10px">
        <table id="gridList"></table>
        <div id="gridPager" rel="form1"></div>
    </div>
</form>
<div id="TabGrid">
    <ul class="nav nav-tabs navb-bg" role="tablist" id="myTab">
        <li role="presentation" class="active">
            <a href="#dv_mx" id="linkSearch" role="tab" data-toggle="tab">Chi tiết chứng từ</a>
        </li>
        <li style="float:right">
            <span class="hiding glyphicon glyphicon-chevron-right btn-lg"></span>
        </li>
    </ul>
    <div id="dv_mx">
        <table id="gridMxInfo"></table>
    </div>
</div>
<div class="showbotton">
    <span class="glyphicon glyphicon-chevron-left btn-lg"></span>
</div>
<script>
    var $gridMxList = $("#gridMxInfo");
    $(function () {
        //Khi thay đổi kích thước cửa sổ trình duyệt thì tải lạijqGridchiều rộng của
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });
        $(".hiding,.rows,#dv_search,.toolbar,.panel-default").click(function () {
            TabGridHide();
        });
        $(".showbotton").click(function () {
            $(".showbotton").animate({ width: 'hide' },
                "fast",
                function () {
                    $("#TabGrid").animate({ left: '0px' }, "slow");
                });
        });
        Initial();
    });

    //Liên kết sự kiện Enter
    $(document).keyup(function (event) {
        if (event.keyCode === 13) {
            $("#btn_search").trigger("click");
        }
    });

    //Khởi tạo
    function Initial() {
        getLbSelectTree();
        gridList();
        gridMxInfo();
        TabGridHide();;

        $('#ks').ksFloatingSelector({
            iszlks: "1",
            itemdbclickhandler: function ($this) {
                $('#ks').attr('data-code', $this.attr('data-Code'))
                    .val($this.attr('data-Name'));
                $('#ksCode').attr('data-code', $this.attr('data-Code'))
                    .val($this.attr('data-Code'));
            },
        });

        $("#ks").change(function () {
            if (!$("#ks").val()) {
                $("#ksCode").val("");
            }
        })
    }

    //Ẩn hộp tìm kiếm và hiển thị mũi tên
    function TabGridHide() {
        var tabGridwith = $("#TabGrid").width() + 200;
        if ($(".showbotton").is(":hidden")) {
            $("#TabGrid").animate({ left: tabGridwith },
                "slow",
                function () {
                    $(".showbotton").animate({ width: 'show' }, "fast");
                });
        }
    }

    //Loại
    function getLbSelectTree() {
        $("#lb").bindSelect({
            url: "/NurseManage/DepartmentSupplies/GetPatientTreeSelectJson"
        });
    }

    //Thông tin bảng chính
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/NurseManage/DepartmentSupplies/GetWarehouseStorage",
            postData: $("#form1").formSerialize(),
            height: $(window).height() - document.getElementById('gridList').offsetTop - 70,
            colModel: [
                { label: 'ks', name: 'ks', width: 180, align: 'left',hidden:true },
                { label: 'Khoa', name: 'ksName', width: 100, align: 'left' },
                { label: 'Tên', name: 'wzmc', width: 180, align: 'left' },
                { label: 'Phiên âm', name: 'py', width: 80, align: 'left' },
                { label: 'Loại', name: 'lb', width: 120, align: 'left' },
                { label: 'Quy cách', name: 'gg', width: 100, align: 'left' },
                { label: 'Số lượng', name: 'slStr', width: 80, align: 'center' },
                 { label: 'Đơn giá bán lẻ', name: 'lsjStr', width: 80, align: 'center' },
                {
                    label: 'Đơn giá bán lẻ', name: 'lsj', width: 80, align: 'center',
                    formatter: function (val) {
                        return val.toFixed(4);
                    }
                },
                { label: 'Đơn vị đơn giá', name: 'bmdwmc', width: 60, align: 'center', hidden: true },
                {
                    label: 'Tổng số tiền bán lẻ', name: 'lsze', width: 80, align: 'center', 
                    formatter: function (val) {
                        return val.toFixed(2);
                    }
                },
                {
                    label: 'Tổng giá nhập', name: 'jjze', width: 80, align: 'right',hidden:true,
                    formatter: function (val) {
                        return val.toFixed(2);
                    }
                },
                { label: 'Thương hiệu', name: 'brand', width: 100, align: 'center' },
                { label: 'Thời hạn hiệu lực', name: 'yxqStr', width: 70, align: 'left', hidden: true },
                { label: 'Nhà sản xuất', name: 'sccj', width: 150, align: 'left' },
                { label: "productId", name: "productId", hidden: true}
            ],
            pager: "#gridPager",
            sortname: 'ksName asc',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                debugger;
                var z = $('input[name=mxyx]:checked').length > 0 ? "1" : "";
                $gridMxList.jqGrid('setGridParam',
                    {
                        url: "/NurseManage/DepartmentSupplies/GetWarehouseStorageDetail",
                        postData: { ks: $("#gridList").getRowData(rowid).ks, proId: $("#gridList").getRowData(rowid).productId, zt: z }
                    }).trigger('reloadGrid');
                $(".showbotton").click();
            }
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam',
                {
                    postData: $("#form1").formSerialize()
                }).trigger('reloadGrid');
        });
        $("#btn_sync").click(function () {
            $.najax({
                url: "/NurseManage/DepartmentSupplies/UpdateSyncWz",
                type: "POST",
                data: {},
                dataType: "json",
                success: function (data) {
                    if (data.state === 'success') {
                        $.modalMsg("Đồng bộ vật tư tiêu hao thành công!", "success", 1000);
                    }
                    else {
                        $.modalMsg(data, "error", 1000);
                    }
                }
            });
        })
    }

    //Thông tin chi tiết
    function gridMxInfo() {
        $gridMxList.dataGrid({
            url: "",
            postData: "",
            height: $(window).height() - document.getElementById('gridList').offsetTop - 200,
            colModel: [
                { label: 'Tên', name: 'wzmc', width: 180, align: 'left', hidden: true },
                { label: 'Số tồn kho', name: 'bmkcslStr', width: 80, align: 'right' },
                { label: 'Số đóng băng', name: 'bmdjslStr', width: 80, align: 'right' },
               
               
                { label: 'Đơn giá nhập', name: 'jjStr', width: 120, align: 'right'},
                { label: 'Đơn vị đơn giá', name: 'bmdwmc', width: 70, align: 'center',hidden:true },
                {
                    label: 'Tổng giá nhập', name: 'jjze', width: 100, align: 'center',
                    formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(2) : "0.00";
                    }
                },
                 {
                     label: 'Đơn giá bán lẻ', name: 'lsjStr', width: 120, align: 'center'
                 },
                  {
                      label: 'Tổng số tiền bán lẻ', name: 'lsze', width: 100, align: 'center',
                      formatter: function (cellvalue) {
                          return cellvalue ? parseFloat(cellvalue).toFixed(2) : "0.00";
                      }
                  },
                   { label: 'Số lô', name: 'ph', width: 120, align: 'left' },
                { label: 'Lô', name: 'pc', width: 120, align: 'left' },
                { label: 'Thời hạn hiệu lực', name: 'yxq', width: 70, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                {
                    label: 'Trạng thái', name: 'zt', width: 50, align: 'center', formatter: function (val, options) {
                        return val === "1" ? "<i rowId=" + options.rowId + " onclick='operateZt(this)' class=\"fa fa-toggle-on\"></i>" : "<i rowId=" + options.rowId + " onclick='operateZt(this)' class=\"fa fa-toggle-off\"></i>";
                    }
                },
                { label: 'productId', name: 'productId', hidden: true },
                { label: 'Id', name: 'Id', hidden: true }
            ]
        });
    }

    //Đặt tồn kho có hiệu lực hay không
    function operateZt(obj) {
        var zt = "1";
        var mxId = $gridMxList.getRowData($(obj).attr("rowId")).Id;
        if ($(obj).hasClass("fa-toggle-off")) {
            $(obj).removeClass("fa-toggle-off").addClass("fa-toggle-on");
            zt = "1";
        } else {
            $(obj).removeClass("fa-toggle-on").addClass("fa-toggle-off");
            zt = "0";
        }

        $.najax({
            url: "/NurseManage/DepartmentSupplies/UpdateKcxxZt",
            type: "POST",
            data: { mxId: mxId, zt: zt },
            dataType: "json",
            success: function (data) {
                if (data.state === 'success') {
                    //$.modalMsg("Sửa trạng thái tồn kho thành công", "success", 1000);
                }
                else {
                    $.modalMsg(data, "error", 1000);
                }
            }
        });
    }

    //Lấyurltham số trong
    function getQueryString(name) {
        // Khớp tham số mục tiêu
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
        var result = window.location.search.substr(1).match(reg); // 对querystringKhớp tham số mục tiêu
        if (result != null) {
            return decodeURIComponent(result[2]);
        } else {
            return null;
        }
    }

</script>

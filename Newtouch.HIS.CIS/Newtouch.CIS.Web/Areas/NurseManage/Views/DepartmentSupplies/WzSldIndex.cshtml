
@{
    ViewBag.Title = "WzSldIndex";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<style>
    .req {
        color: red;
    }

    .inline {
        width: 80%;
        display: inline;
    }

    .PriceInline {
        width: 70%;
        display: inline;
    }

    #dv-detail table th {
        border: solid 1px #ddd;
        padding: 0;
        vertical-align: middle;
    }

    #dv-detail .ui-jqgrid-labels, #dv-detail .jqgrow .ui-row-ltr {
        height: 30px;
        vertical-align: middle;
    }


    #dv-detail table td {
        border: solid 1px #ddd;
        padding: 0;
        vertical-align: middle;
    }

    #dv-detail input[role=textbox] {
        padding: 2px 2px;
    }

    .input-wdatepicker-native {
        height: auto;
        width: 90px;
        border: 0;
        box-shadow: none;
        border-radius: 0;
        padding: 6px 6px;
        text-align: left;
    }

    #gridList .ckbox label {
        margin-top: 24px;
    }

    .sp-ckze {
        color: #ff0000;
    }
</style>
<form id="form1">
    <div class="panel panel-default" style="margin-bottom:10px;">
        <div class="panel-heading">Thông tin phiếu lĩnh</div>
        <table class="form">
            <tr>
                <th class="formTitle">Số phiếu lĩnh:</th>
                <td class="formValue">
                    <input id="Pdh" type="text" class="form-control newtouch_Readonly required" />
                </td>
                <th class="formTitle"><span class="required">*</span>Khu bệnh</th>
                <td>
                    <input type="text" id="bqtext" name="bqtext" data-bqbmId="" placeholder="Vui lòng chọn khu bệnh" class="form-control required" autocomplete="off" />

                </td>
                <th class="formTitle"><span class="required">*</span>Khoa lĩnh</th>
                <td class="formValue">
                    <input type="text" id="slksbm" name="slksbm" data-slksbmId="" placeholder="Vui lòng chọn khoa lĩnh" class="form-control required" autocomplete="off" />
                </td>
                <th class="formTitle" style="width:60px;">
                    <input type="button" id="btn_add" class="btn btn-md btn-primary" value="Thêm" />
                </th>
            </tr>
        </table>
    </div>
    <div id="dv-detail">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>
<div style="float: left; line-height: 35px; font-weight: bolder;">
    <span>本次出库总额(元)：</span>
    <span class="sp-ckze">0.00</span>
</div>
@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
    ShowKeyList = new[] { 7, 8 },
    F7Text = "重置",
    F8Text = "提交"
})

<script type="text/javascript">
    var $gridList = $("#gridList");
    $(".toolbar").css("width", "20%");
    $(function () {
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });
        init();
        Backspaceslksbm();
       
        $("#btn_add").click(function () {
            $gridList.jqGrid("addRowData", undefined, { operate: GetOperatehtml() }, "last");
        });

         //Khởi tạo khu bệnh
        $("#bqtext").newtouchBatchFloatingSelector({
            height: 300,
            width: 300,
            clickautotrigger: true,
            ajaxmethod: 'Get',
            caption: "Khoa nhập kho",
            url: "/NurseManage/DepartmentSupplies/GetDeptBy",
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = $("#rkbm").val();
                return reqData;
            },
            colModel: [
                { label: 'ID', name: 'ID', hidden: true },
                { label: 'Tên khu bệnh', name: 'name', widthratio: 100 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#bqtext").val($thistr.attr('data-name')).attr("data-bqbmId", $thistr.attr('data-ID'));
                return;
            }
        });
        //Khởi tạo khoa nhập kho
        $("#slksbm").newtouchBatchFloatingSelector({
            height: 300,
            width: 300,
            clickautotrigger: true,
            ajaxmethod: 'Get',
            caption: "Khoa nhập kho",
            url: "/NurseManage/DepartmentSupplies/GetDeptByKf",
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = $("#rkbm").val();
                return reqData;
            },
            colModel: [
                { label: 'ID', name: 'ID', hidden: true },
                { label: 'Tên kho', name: 'name', widthratio: 100 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#slksbm").val($thistr.attr('data-name')).attr("data-slksbmId", $thistr.attr('data-ID'));
                return;
            }
        });
    });

    //Khởi tạo
    function init() {
        $('#gridList').jqGrid("clearGridData");//Xóa sạchGrid
        $gridList.clearGridData();
        GetNewCkzksdh();
        InitJqGrid();
        $gridList.jqGrid("addRowData", undefined, { operate: GetOperatehtml() }, "last");
    }


    


    //Xóa bộ phận nhập kho
    function Backspaceslksbm() {
        $("#slksbm").keydown(function (e) {
            var e = window.event ? window.event : e;
            var keyCode = e.which ? e.which : e.keyCode;
            if (keyCode === 8) {//tab
                $("#slksbm").val("").attr("data-slksbmId", "");
            }
        });
    }
    //Tải số phiếu lĩnh
    function GetNewCkzksdh() {
        $.najax({
            url: "/NurseManage/DepartmentSupplies/GetNewCkzksdh?r=" + Math.random(),
            dataType: "text",
            type: "Get",
            success: function (data) {
                $("#Pdh").val(data);
            }
        });
    }

    //Khởi tạo chi tiết xuất kho
    function InitJqGrid() {
        $gridList.newtouchLocalDataGrid({
            data: [],
            height: $(window).height() - document.getElementById('gridList').offsetTop - 85,
            rownumbers: true,  //Có hiển thị số thứ tự không
            multiselect: true,
            editurl: "clientArray",  //Chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            unwritten: false,
            colModel: [
                { label: 'Thao tác', name: 'operate', width: 50, align: 'center' },
                { label: '<span class="required">*</span>Tên vật tư', name: 'wzmc', width: 105, align: 'center', editable: true, editwidth: "100%" },
                { label: "Loại vật tư", name: "lbmc", width: 75, align: 'center', editable: true, editwidth: "100%" },
                { label: '<span class="required">*</span>Lô', name: 'pc', width: 80, align: 'center', editable: true, editwidth: "100%" },
                { label: '<span class="required">*</span>Số lượng', name: 'sl', width: 45, align: 'center', editable: true, editwidth: "100%" },
                {
                    label: 'Đơn vị', name: 'unitName', width: 50, align: 'center',
                    formatter: function (cellvalue, options) {
                        return "<select name=\"dw\" id=\"sel_dw_" + options.rowId + "\" rowid=" + options.rowId + " class=\"editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" ></select>";
                    }
                },
                { label: '<span class="required">*</span>Số lô', name: 'ph', width: 80, align: 'center', editable: true, editwidth: "100%" },
                { label: 'Tồn kho', name: 'slstr', width: 70, align: 'center', editable: true, editwidth: "100%" },
                { label: 'Quy cách', name: 'gg', width: 80, align: 'center', editable: true, editwidth: "100%" },
                { label: 'Ngày sản xuất', name: 'scrq', width: 70, align: 'center', editable: true, editwidth: "100%" },
                { label: 'Thời hạn hiệu lực', name: 'yxq', width: 70, align: 'center', editable: true, editwidth: "100%" },
                { label: 'Nhà sản xuất', name: 'sccj', width: 105, align: 'center', editable: true, editwidth: "100%" },
                { label: 'Đơn giá nhập', name: 'jj', width: 75, align: 'center', editable: true, editwidth: "100%" },
                { label: 'Tổng giá nhập', name: 'jjze', width: 80, align: 'center', editable: true, editwidth: "100%" },
                { label: 'zhyz', name: 'zhyz', hidden: true, editable: true },
                { label: 'lsj', name: 'lsj', editable: true, hidden: true },
                { label: 'lsze', name: 'lsze', editable: true, hidden: true },
                { label: 'kykcsl', name: 'kykcsl', hidden: true, editable: true },
                { label: 'ckbmkc', name: 'ckbmkc', hidden: true, editable: true },
                { label: 'productId', name: 'productId', hidden: true, editable: true },
                { label: 'fph', name: 'fph', hidden: true, editable: true },
                { label: 'bmjj', name: 'bmjj', hidden: true, editable: true },
                { label: 'minjj', name: 'minjj', hidden: true, editable: true },//Giá nhập đơn vị tối thiểu
                { label: 'minlsj', name: 'minlsj', hidden: true, editable: true }
            ],
            editinputwidthborder: false,    //Có cần viền không mặc định làtrue
            editinputborderradius: false,   //Có cần bo góc viền không Mặc địnhtrue(có bo góc)
            gridComplete: function () {
                var ids = $gridList.getDataIDs();
                var lastRowoid = ids[ids.length - 1];
                EnableInlineEditBox(lastRowoid);
            },
            onSelectRow: function (id) {
                Calculatebcjjze();
            }
        });
    }

    //Bật chỉnh sửa trong dòng
    function EnableInlineEditBox(rowid) {
        $gridList.jqGrid('editRow', rowid, false, initInlineFunc);//Mở chế độ chỉnh sửa
        $("#jqg_gridList_" + rowid).trigger("click");
    }
    //Tính tổng giá nhập lần này
    function Calculatebcjjze() {
        var r = 0;
        $.each($gridList.find("input[type=checkbox]:checked"), function () {
            var rowid = $(this).parent().parent().parent().attr("id");
            var jjze = parseFloat($("#" + rowid + "_jjze").val());
            if (!isNaN(jjze)) {
                r += jjze;
            }
        });
        $(".sp-ckze").html(r.toFixed(2));
    }

    //Khởi tạo Lớp nổi
    function initInlineFunc(rowid) {
        //Một số cột chỉ đọc
        $("#" + rowid + "_wzmc").attr("autocomplete", "off");
        $("#" + rowid + "_lbmc").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_ph").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_slstr").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_gg").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_scrq").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_yxq").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_lsj").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_lsze").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_zhyz").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_sccj").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_jj").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_jjze").css('background-color', '#f6f7fb').attr('readonly', 'true');

        InitProduct(rowid + "_wzmc", rowid); //Lớp nổi vật tư
        InitTabKey("sel_dw_" + rowid, rowid);
    }

    //Khởi tạo mã nhập
    function InitProduct(id, rowid) {
        $("#" + id).newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 300,
            width: 920,
            id: 'selectProduct',
            url: '/NurseManage/DepartmentSupplies/DepartmentStockListQuery',
            ajaxmethod: 'Get',
            inputtextcheck: function () {
                if ($("#slksbm").val() === "" ||
                    $("#slksbm").attr("data-slksbmId") === "") {   //Loại bỏ khoảng trắng hai đầu
                    $.modalAlert("Vui lòng chọn trước khoa lĩnh", 'warning');
                    return false;
                }
                return true;
            },
            ajaxreqdata: function () {
                var reqData = {};
                reqData.slksbm = $("#slksbm").attr("data-slksbmId");
                reqData.key = $("#" + id).val();

                return reqData;
            },
            caption: "Thông tin vật tư",
            colModel: [
                { label: 'Loại', name: 'lbmc', width: 120 },
                { label: 'Tên', name: 'name', width: 200, align: "left" },
                { label: 'Tồn kho', name: 'slstr', width: 100 },
                { label: 'Quy cách', name: 'gg', width: 120 },
                {
                    label: 'Đơn giá bán lẻ', name: 'bmlsj', width: 90, align: "right",
                    formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0.00";
                    }
                },
                { label: 'Đơn vị', name: 'bmdwmc', width: 50 },
                { label: 'Nhà sản xuất', name: 'supplierName', width: 180, align: "left" },
                { label: 'Id', name: 'Id', hidden: true },
                { label: 'kykcsl', name: 'kykcsl', hidden: true },
                { label: 'zhyz', name: 'zhyz', hidden: true },
                { label: 'bmdwmc', name: 'bmdwmc', hidden: true },
                { label: 'bmdwId', name: 'bmdwId', hidden: true },
                { label: 'zxdwId', name: 'zxdwId', hidden: true },
                { label: 'minlsj', name: 'minlsj', hidden: true },
                { label: 'fph', name: 'fph', hidden: true },
                { label: 'mindwmc', name: 'mindwmc', hidden: true }
            ],
            itemdbclickhandler: function ($thistr) {
                fillProductInfo(rowid, $thistr);
            }
        });
    }

    //Điền thông tin vật tư
    function fillProductInfo(rowid, $thistr) {
        $("#" + rowid + "_slstr").val($thistr.attr('data-slstr'));
        $("#" + rowid + "_lbmc").val($thistr.attr('data-lbmc'));
        $("#" + rowid + "_productId").val($thistr.attr('data-Id'));
        $("#" + rowid + "_wzmc").val($thistr.attr('data-name'));
        $("#" + rowid + "_gg").val($thistr.attr('data-gg'));
        $("#" + rowid + "_sccj").val($thistr.attr('data-supplierName'));
        $("#" + rowid + "_lsj").val($thistr.attr('data-bmlsj'));
        $("#" + rowid + "_rkbmkc").val($thistr.attr('data-kykcsl'));
        $("#" + rowid + "_minlsj").val($thistr.attr('data-minlsj'));
        ChangeDw(rowid);
        initDw($thistr, rowid);
        $("#" + rowid + "_sl").val("");
        $("#" + rowid + "_lsze").val("");
        $("#sel_dw_" + rowid).trigger("change");
        $("#" + rowid + "_pc").attr("autocomplete", "off");
        InitPc(rowid + "_pc", rowid);

        $("#" + rowid + "_sl").keyup(function () {
            if (CheckKc(rowid)) {
                CalculateJj(rowid);
                CalculationLsze(rowid);
            }
        });
    }


    //Khởi tạo đơn vị
    function initDw($thistr, rowid) {
        $("#sel_dw_" + rowid).empty();
        if ($thistr.attr('data-bmdwmc') !== $thistr.attr('data-mindwmc')) {
            $("#sel_dw_" + rowid).append("<option data-zhyz='1' value='" + $thistr.attr('data-zxdwId') + "'>" + $thistr.attr('data-mindwmc') + "</option>");
        }
        $("#sel_dw_" + rowid).append("<option data-zhyz='" + $thistr.attr('data-zhyz') + "' value='" + $thistr.attr('data-bmdwId') + "'>" + $thistr.attr('data-bmdwmc') + "</option>");
        $("#sel_dw_" + rowid).trigger("change");
    }

    //Chuyển đổi đơn vị
    function ChangeDw(rowid) {
        $("#sel_dw_" + rowid).change(function () {
            $("#" + rowid + "_zhyz").val($(this).find("option:selected").attr("data-zhyz"));
            CalculateJj(rowid);
            CalculationLsze(rowid);
        });
    }


    //Sự kiện kiểm tra tồn kho
    function CheckKc(rowid) {
        var sl = Number($("#" + rowid + "_sl").val());
        var reg = /^[1-9]\d*$/;//lớn hơn0số nguyên của
        if (!reg.test(sl)) {
            $.modalMsg("Số lượng phải lớn hơn0số nguyên!", "warning", 1500);
            return false;
        }
        var zhyz = Number($("#sel_dw_" + rowid).find("option:selected").attr("data-zhyz"));
        if (isNaN(zhyz)) {
            $.modalMsg("Hệ số chuyển đổi phải lớn hơn0số nguyên!", "warning", 1500);
            return false;
        }
        var maxsl = Number($("#" + rowid + "_kykcsl").val());
        if (zhyz * sl > maxsl) {
            $.modalMsg("Số lượng không được vượt quá tổng tồn kho", "error", 1000);
            $("#" + rowid + "_sl").val("");
            return false;
        }
        return true;
    }

    //Tính tổng số tiền bán lẻ
    function CalculationLsze(rowid) {
        var zhyz = Number($("#sel_dw_" + rowid).find("option:selected").attr("data-zhyz"));
        var minlsj = Number($("#" + rowid + "_minlsj").val());
        $("#" + rowid + "_lsj").val((minlsj * zhyz).toFixed(4));
        var sl = Number($("#" + rowid + "_sl").val());
        $("#" + rowid + "_lsze").val((zhyz * sl * minlsj).toFixed(2));
    }


    //Khởi tạo lô thuốc
    function InitPc(id, rowid) {
        $("#" + id).newtouchBatchFloatingSelector({
            height: 300,
            width: 870,
            clickautotrigger: true,
            url: "/NurseManage/DepartmentSupplies/ProductBatchQuery",
            ajaxmethod: 'Get',
            inputtextcheck: function () {
                if ($("#" + rowid + "_productId").val().replace(/(^\s*)|(\s*$)/g, "") === "" ||
                    $("#" + rowid + "_wzmc").val().replace(/(^\s*)|(\s*$)/g, "") === "") {   //Loại bỏ khoảng trắng hai đầu
                    $.modalAlert("Vui lòng chọn trước vật tư", 'warning');
                    return false;
                }
                return true;
            },
            ajaxreqdata: function () {
                var reqData = {};
                reqData.proId = $("#" + rowid + "_productId").val();
                reqData.slksbm = $("#slksbm").attr("data-slksbmId");
                reqData.keyword = $("#" + id).val();
                return reqData;
            },
            colModel: [
                { label: 'Số lô', name: 'ph', width: 120 },
                { label: 'Lô', name: 'pc', width: 200 },
                { label: 'Số lượng', name: 'slstr', width: 100 },
                { label: 'Đơn giá nhập', name: 'jjdwdj', width: 90, align: "right" },
                {
                    label: 'Tổng giá nhập', name: 'jjzje', width: 90,
                    formatter: function (cellvalue) { return cellvalue.toFixed(2); }
                },
                { label: 'Thời hạn hiệu lực', name: 'yxq', width: 80, formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Ngày sản xuất', name: 'scrq', width: 100, formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'kykcsl', name: 'kykcsl', hidden: true },
                { label: 'fph', name: 'fph', hidden: true },
                { label: 'minjj', name: 'minjj', hidden: true },
                { label: 'bmjj', name: 'bmjj', hidden: true },
                { label: 'kcsl', name: 'kcsl', hidden: true }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#" + rowid + "_ph").val($thistr.attr('data-ph'));
                $("#" + rowid + "_pc").val($thistr.attr('data-pc'));
                $("#" + rowid + "_slstr").val($thistr.attr('data-slstr'));
                $("#" + rowid + "_yxq").val($thistr.attr('data-yxq'));
                $("#" + rowid + "_kykcsl").val($thistr.attr('data-kykcsl'));
                $("#" + rowid + "_scrq").val($thistr.attr('data-scrq'));
                $("#" + rowid + "_bmjj").val($thistr.attr('data-bmjj'));
                $("#" + rowid + "_minjj").val($thistr.attr('data-minjj'));
                $("#" + rowid + "_fph").val($thistr.attr('data-fph'));
                $("#" + rowid + "_sl").val("");
                $("#" + rowid + "_lsze").val("");
                CalculateJj(rowid);
            }
        });
    }

    //Tính giá nhập
    function CalculateJj(rowid) {
        var zhyz = Number($("#sel_dw_" + rowid).find("option:selected").attr("data-zhyz"));
        var minJj = parseFloat($("#" + rowid + "_minjj").val());
        if (isNaN(zhyz) || isNaN(minJj)) return;
        $("#" + rowid + "_jj").val((minJj * zhyz).toFixed(4));
        var sl = Number($("#" + rowid + "_sl").val());
        $("#" + rowid + "_jjze").val((zhyz * sl * minJj).toFixed(2));
        Calculatebcjjze();
    }
    //Xác thực thông tin chính
    function ValidateMain() {
        if ($("#Pdh").val() === "") {
            $.modalMsg("Số phiếu xuất kho không được trống", 'warning', 1500);
            return false;
        }
        if ($("#rkbm").val() === "" || $("#rkbm").attr("data-rkbmId") === "") {
            $.modalMsg("Vui lòng chọn khoa nhập kho", 'warning', 1500);
            return false;
        }
        return true;
    }
    //Lấy nút thao táchtml
    function GetOperatehtml() {
        return "<i class='fa fa-plus-square-o' style='font-size: large; color: #09a3ea;vertical-align: middle;' onclick='addItem(this);'></i>&nbsp;&nbsp;&nbsp;<i class='fa fa-minus-square-o' style='font-size: large; color: #09a3ea;vertical-align: middle;' onclick='deleteItem(this);'></i>";
    }

    //Thêm chi tiết
    function addItem() {
        var ids = $gridList.getDataIDs();
        var lastRowoid = ids[ids.length - 1];
        var dataRow = {
            operate: GetOperatehtml()
        };
        $gridList.jqGrid("addRowData", undefined, dataRow, "after", lastRowoid);
    }

    //Xóa chi tiết
    function deleteItem(obj) {
        var selRowId = $(obj).parent().parent().attr("id");
        if (!!selRowId) {
            $gridList.jqGrid("delRowData", selRowId);
        }
    }
    //Tại hóa đơn nhấn lạitab键
    function InitTabKey(id, rowid) {
        $("#" + id).keydown(function (e) {
            var e = window.event ? window.event : e;
            var keyCode = e.which ? e.which : e.keyCode;
            if (keyCode === 9) {//tab
                $(this).parent().parent().find(".fa-plus-square-o").trigger("click");
            }
        });
    }
    //Xác thực giá trị số
    function Validately(rowData, rowid) {
        if (rowData.wzmc === "" || rowData.productId === "") {
            $.modalMsg('Vật tư là bắt buộc', 'error', 1000);
            return false;
        }
        var reg = /^[1-9]\d*$/;//lớn hơn0số nguyên của
        if (!reg.test(rowData.sl)) {
            $.modalMsg("Số lượng phải lớn hơn0số nguyên!", "warning", 1500);
            return false;
        }
        if (rowData.pc === "" || rowData.ph === "") {
            $.modalMsg("Lô, số lô không được trống!", "warning", 1000);
            return false;
        }
        return true;
    }
     //Xuất kho
    function newtouch_event_f8() {
        if (!ValidateMain()) return;
        var list = [];
        var validationFailedArr = [];
        $.each($gridList.find("input[type=checkbox]:checked"), function () {
            var rowid = $(this).parent().parent().parent().attr("id");
            $gridList.saveRow(rowid, null, null, null, function (callbackRowId) { }, null, null);
            var rowData = $gridList.jqGrid('getRowData', rowid);
            if (!Validately(rowData, rowid)) {
                validationFailedArr.push(rowid);
                return;
            }
            list.push(AssembleData(rowData, rowid));
        });
        if (validationFailedArr.length > 0) {
            for (var i = 0; i < validationFailedArr.length; i++) {
                $gridList.jqGrid('editRow', validationFailedArr[i], false, initInlineFunc);//Mở chế độ chỉnh sửa
            }
            return;
        }
        if (list.length === 0) {
            $.modalMsg("Vui lòng chọn dữ liệu chỉnh sửa!", 'warning', 1000);
            return;
        }
        @*var crkdj = Object();
        crkdj.auditState ="@((int)EnumAuditState.Waiting)";
        crkdj.Pdh = $("#Pdh").val();
        crkdj.deliveryNo = "";
        crkdj.crkfs = $("#crkfs").val();
        crkdj.ckbm = "";
        crkdj.rkbm = $("#rkbm").attr("data-rkbmId");*@
        $.najax({
            url: "/StorageManage/Storage/SaveDeliveryToDepartment",
            type: "POST",
            alerterror: false,
            data: { crkdj: crkdj, crkdjmx: list },
            dataType: "json",
            success: function (res) {
                if (res.state === "success") {
                    $.modalAlert("Xuất kho thành công", 'success');
                    newtouch_event_f7();//Xuất nhập kho: số chứng từ mới Xóa dữ liệu chính Xóa chi tiết
                } else {
                    $.modalAlert(res.message, "error");
                    var rowIds = $gridList.getDataIDs();
                    for (var i = 0; i < rowIds.length; i++) {
                        $gridList.jqGrid('editRow', rowIds[i], false, initInlineFunc);//Mở chế độ chỉnh sửa
                    }
                }
            }
        });
    }
    //Phiếu xuất kho mới
    function newtouch_event_f7() {
        newtouch_globalevent_f4(null, {
            container: "#form1",
            inner: false
        });
        $("#rkbm").val("").attr("data-rkbmId", "");
        init();

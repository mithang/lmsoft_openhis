@model dynamic

@{
    ViewBag.Title = "Khu bệnhPhòngGiườngBảo trì";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<style>
    .dv-body {
        /*background-color: #00a0e9;*/
    }

    .dv-left {
        width: 250px;
        float: left;
    }

    .dv-left-title {
        width: 100%;
        height: 30px;
        line-height: 30px;
        background-color: #00a0e9;
        text-align: center;
        color: white;
    }

    .dv-right {
        float: left;
        margin-left: 5px;
    }

    .dv-right-room {
        width: 100%;
    }

    .dv-right-bed {
        width: 100%;
        margin-top: 5px;
    }

    .sp-showOrClose {
        margin: 0 20px;
        float: right;
        cursor: pointer;
        color: rgb(0, 160, 234);
        font-size: 1.8rem;
    }

    .dv-grid {
        width: 100%;
    }

    #dv_bed_grid {
        display: none;
    }
</style>
<div class="dv-body">
    <div class="dv-left">
        <div class="dv-left-title">Khu bệnhDanh sách</div>
        <table id="gridBqList"></table>
    </div>
    <div class="dv-right">
        <div class="dv-right-room">
            <div class="topPanel">
                <div class="toolbar">
                    <div class="btn-group">
                        <a class="btn btn-primary" onclick="RefreshRoom()"><span class="fa fa-refresh"></span></a>
                    </div>
                    <div class="btn-group">
                        <a authorize="yes" class="btn btn-primary" onclick="AddRoom()">
                            <i class="fa fa-plus"></i>PhòngTạo mới
                        </a>
                    </div>
                    <div class="btn-group">
                        <a authorize="yes" class="btn btn-primary" onclick="UpdateRoom()">
                            <i class="fa fa-pencil-square-o"></i>PhòngSửa
                        </a>
                    </div>
                    <div class="btn-group">
                        <a authorize="yes" class="btn btn-primary" onclick="AttributesPlusRoom()">
                            <i class="fa fa-pencil-square-o"></i>Bổ sungThuộc tính
                        </a>
                    </div>
                    <div class="btn-group">
                        <a authorize="yes" class="btn btn-primary" onclick="DeleteRoom()">
                            <i class="fa fa-trash-o"></i>PhòngXóa
                        </a>
                    </div>
                </div>
                <span class="sp-showOrClose">
                    <i class="fa fa-angle-down fa-lg" aria-hidden="true" onclick="roomShowOrClose(1)"></i>
                    <i class="fa fa-angle-up fa-lg" aria-hidden="true" onclick="roomShowOrClose(0)"></i>
                </span>
            </div>
            <div class="dv-grid" id="dv_room_grid">
                <table id="gridRoomList"></table>
            </div>
        </div>
        <div class="dv-right-bed">
            <div class="topPanel">
                <div class="toolbar">
                    <div class="btn-group">
                        <a class="btn btn-primary" onclick="RefreshBed()"><span class="fa fa-refresh"></span></a>
                    </div>
                    <div class="btn-group">
                        <a authorize="yes" class="btn btn-primary" onclick="AddBed()">
                            <i class="fa fa-plus"></i>Giường bệnhTạo mới
                        </a>
                    </div>
                    <div class="btn-group">
                        <a authorize="yes" class="btn btn-primary" onclick="UpdateBed()">
                            <i class="fa fa-pencil-square-o"></i>Giường bệnhSửa
                        </a>
                    </div>
                    <div class="btn-group">
                        <a authorize="yes" class="btn btn-primary" onclick="AttributesPlusBed()">
                            <i class="fa fa-pencil-square-o"></i>Bổ sungThuộc tính
                        </a>
                    </div>
                    <div class="btn-group">
                        <a authorize="yes" class="btn btn-primary" onclick="AddCosts()">
                            <i class="fa fa-pencil-square-o"></i>Mục thu phí liên quan
                        </a>
                    </div>
                    <div class="btn-group">
                        <a authorize="yes" class="btn btn-primary" onclick="DeleteBed()">
                            <i class="fa fa-trash-o"></i>Giường bệnhXóa
                        </a>
                    </div>
                </div>
                <span class="sp-showOrClose">
                    <i class="fa fa-angle-down fa-lg" aria-hidden="true" onclick="roomShowOrClose(1)"></i>
                    <i class="fa fa-angle-up fa-lg" aria-hidden="true" onclick="roomShowOrClose(0)"></i>
                </span>
            </div>
            <div class="dv-grid" id="dv_bed_grid">
                <table id="gridBedList"></table>
            </div>
        </div>
    </div>
</div>

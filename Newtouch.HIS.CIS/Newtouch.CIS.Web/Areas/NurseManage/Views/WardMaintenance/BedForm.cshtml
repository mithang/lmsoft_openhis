@model dynamic

@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<form id="form1">
    <div class="panel panel-default" style="padding-right:10px;">
        <table class="form">
            <tr>
                <th class="formTitle"><span class="required">*</span>Số giường:</th>
                <td class="formValue">
                    <input id="txt_bedNo" name="txt_bedNo" type="text" class="form-control newtouch_Readonly required" />
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>Loại giường bệnh:</th>
                <td class="formValue">
                    <select id="sel_type" name="sel_type" class="form-control required">
                        <option value="1">Nam</option>
                        <option value="2">Nữ</option>
                        <option value="3">混</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Dấu hiệu đặc biệt:</th>
                <td class="formValue">
                    <select id="sel_tsbz" name="sel_tsbz" class="form-control required">
                        <option value="1">Thường</option>
                        <option value="2">Nhu cầu đặc biệt</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Khoa:</th>
                <td class="formValue">
                    <select id="sel_dept" name="sel_dept" class="form-control required">
                        <option value="1">Khoa điều dưỡng</option>
                        <option value="2">Khoa phục hồi chức năng</option>
                        <option value="3">Khoa nội</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle" style="height: 35px;">Tùy chọn:</th>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Có hiệu lực</label>
                    </div>
                </td>
            </tr>
            <tr>
                <th class="formTitle" valign="top" style="padding-top: 5px;">Ghi chú:</th>
                <td class="formValue">
                    <textarea id="Description" name="Description" class="form-control" style="height: 60px;"></textarea>
                </td>
            </tr>
        </table>
    </div>
</form>
<script lang="javascript">

</script>
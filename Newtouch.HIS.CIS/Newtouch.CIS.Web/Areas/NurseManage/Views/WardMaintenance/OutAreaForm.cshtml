                        <input id="txt_fzzd2dm" type="hidden" />
                        <input id="txt_fzzd2" disabled="disabled" name="txt_fzzd2" type="text" style="background-color:#edeaea" class="form-control required zdinput" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Chẩn đoán hỗ trợ3：</th>
                    <td class="formValue">
                        <input id="txt_fzzd3dm" type="hidden" />
                        <input id="txt_fzzd3" disabled="disabled" name="txt_fzzd3" type="text" style="background-color:#edeaea" class="form-control required zdinput" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Chẩn đoán tùy chỉnh:</th>
                    <td class="formValue">
                        <textarea id="txt_zdyzd" disabled="disabled" name="txt_zdyzd" style="background-color:#edeaea" class="form-control zdinput" style="height: 60px;"></textarea>
                    </td>
                </tr>*@
        </table>
    </div>
    <div class="container">
        <ul class="nav nav-tabs" role="tablist" id="myTab">
            <li role="presentation"><a href="#xyzdInfo" role="tab" data-toggle="tab">Chẩn đoán Tây y</a></li>
            <li role="presentation"><a href="#zyzdInfo" role="tab" data-toggle="tab">Chẩn đoán Đông y</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade in active" id="xyzdInfo">
            <table id="tablezd" class="form">
                <tr>
                    <th class="formTitle">
                        <i id="zdCircle" class="fa fa-plus-circle plusToggleCircle" aria-hidden="true" style="display:none;color: #6ff3ad; font-size: large;"></i>
                        Chẩn đoán xuất viện:
                    </th>
                    <td class="formValue">
                        <input id="txt_cyzddm" type="hidden" />
                        <input id="txt_cyzd" name="txt_cyzd" type="text" style="background-color:#edeaea" disabled="disabled" class="form-control required zdinput" />
                    </td>
                </tr>
            </table>
        </div>
        <div id="zyzdInfo" role="tabpanel" class="tab-pane fade in">
            <table id="tablezyzd" class="form" style="width: 98%; border: 0">
                <tr>

                    <th class="formTitle">
                        <i id="zyzdCircle" class="fa fa-plus-circle plusToggleCircle" aria-hidden="true" style="display:none;color: #6ff3ad; font-size: large;"></i>
                        Bệnh chính:
                    </th>
                    <td class="formValue">
                        <input id="txt_zycyzddm" type="hidden" />
                        <input id="txt_zycyzd" name="txt_zycyzd" type="text" style="background-color:#edeaea" disabled="disabled" class="form-control required zdinput" />
                    </td>
                </tr>

            </table>
        </div>
    </div>
</form>
<script lang="javascript">
    var zdcnt = 0;
    $('#myTab a:first').tab('show');
    $(function () {

    function GetPatDiagnosis() {
        $.najax({
            type: "GET",
            url: "/NurseManage/WardMaintenance/GetPatDiagnosis?r=" + Math.random(),
            data: { zyh: '@ViewBag.zyh' },
            loadingtext: "Dữ liệu đang được tải, vui lòng đợi...",
            dataType: "json",
            success: function (zdlist) {
                //zdcnt = zdlist.length;
                $.each(zdlist, function (n, item) {
                    if (item.zddm)
                    {
                        zdcnt++;
                    }
                    if (item.zddl == "TCM") {
                        if (item.zdlx == "1") {
                            $("#txt_zycyzd").val(item.zdmc);
                            $("#txt_zycyzddm").val(item.zddm);
                        }
                        //Chẩn đoán hỗ trợ
                        if (item.zdlx > "1") {
                            $('#tablezyzd .plusToggleCircle').click();
                            var number = item.px;
                            $("#txt_zyfzzd" + number).val(item.zdmc);
                            $("#txt_zyfzzd" + number + "dm").val(item.zddm);
                        }
                    } else {
                        if (item.zdlx == "1") {
                            $("#txt_cyzd").val(item.zdmc);
                            $("#txt_cyzddm").val(item.zddm);
                        }
                        //Chẩn đoán hỗ trợ
                        if (item.zdlx > "1") {
                            $('#tablezd .plusToggleCircle').click();
                            var number = item.px;
                            $("#txt_fzzd" + number).val(item.zdmc);
                            $("#txt_fzzd" + number + "dm").val(item.zddm);
                        }
                    }
                    //if (item.zddm != "999999999")
                    //{
                    //    zdcnt++;
                    //}
                    //if (item.zdlx=="0") {
                    //    $("#txt_cyzd").val(item.zdmc);
                    //    $("#txt_cyzddm").val(item.zddm);
                    //}
                    //if (item.zdlx == "1") {
                    //    $("#txt_fzzd1").val(item.zdmc);
                    //    $("#txt_fzzd1dm").val(item.zddm);
                    //}
                    //if (item.zdlx == "2") {
                    //    $("#txt_fzzd2").val(item.zdmc);
                    //    $("#txt_fzzd2dm").val(item.zddm);
                    //}
                    //if (item.zdlx == "3") {
                    //    $("#txt_fzzd3").val(item.zdmc);
                    //    $("#txt_fzzd3dm").val(item.zddm);
                    //}
                    //if (item.zdlx == "9") {
                    //    $("#txt_zdyzd").val(item.zdmc);
                    //}
                })
            }
        })
    }
    var theAcceptClickCallBack = null;
    function AcceptClick(callBack) {
        theAcceptClickCallBack = callBack;
        var zyh = '@ViewBag.zyh';
        var cyfs = $("#sel_cqfs").val();
        var cqsj = $("#txt_cqrq").val();
        //var zdrq = $("#txt_zdsj").val();
        var zyzd = $("#txt_cyzd").val();//Chẩn đoán Tây y
        var zyzddm = $("#txt_cyzddm").val();
        var zyzyzd = $("#txt_zycyzd").val();//Chẩn đoán Đông y
        var zyzyzddm = $("#txt_zycyzddm").val();
        //var fzzd1 = $("#txt_fzzd1").val();
        //var fzzd1dm = $("#txt_fzzd1dm").val();
        //var fzzd2 = $("#txt_fzzd2").val();
        //var fzzd2dm = $("#txt_fzzd2dm").val();
        //var fzzd3 = $("#txt_fzzd3").val();
        //var fzzd3dm = $("#txt_fzzd3dm").val();
        //var zdyzd = $("#txt_zdyzd").val();
        var patOutAreaVO = {
            zyh: zyh,
            cyfs: cyfs,
            cqsj: cqsj,
            zyzddm: (zyzddm == null || zyzddm == undefined) ? zyzyzddm : zyzddm,
            zyzd: (zyzd == null || zyzd == undefined) ? zyzyzd : zyzd
        }
        if ((zyzd == "" || zyzddm == "") && (zyzyzd == "" || zyzyzddm=="")) {
            if ('@isOpendiags' == 'OFF') {
                $.modalAlert('Trang đầu bệnh án của bệnh nhân này chưa nhập chẩn đoán chính xuất viện, không được phép xuất khu!', 'warning');
            }
            else {
                $.modalAlert('Bệnh nhân này không có chẩn đoán chính xuất viện, không được phép xuất khu!', 'warning');
            }
            callBack();
        }
        if ("@isopenPriorReview" == "ON") {
            var GetMAC = "";
            $.ajax({
                type: "Get",
                url: "http://127.0.0.1:33333/api/YiBao/GetMAC",
                dataType: "json",
                async: false,
                success: function (data) {
                    GetMAC = data.Data;
                },
                error: function (request, error, ex) {
                    $.modalAlert("Dịch vụ duyệt bảo hiểm y tế không thể truy cập:[" + ex + "]", 'error');
                }
            });
            //Dịch vụ duyệt chất lượng bệnh án
            $.ajax({
                url: "/DoctorManage/Medicine/GetBashData",
                dataType: "json",
                data: { zyh: zyh,GetMAC },
                type: "POST",
                cache: false,
                async: true,
                success: function (reqdata) {
                    if (reqdata) {
                        if (reqdata.message != "") {
                            $.modalAlert("Gọi giao diện duyệt bệnh án thất bại:" + reqdata.message, 'warning');
                        }
                    }
                }
            });
            $.ajax({
                url: "/DoctorManage/Medicine/GetDrgData",
                dataType: "json",
                data: { zyh: zyh, GetMAC},
                type: "POST",
                cache: false,
                async: true,
                success: function (reqdata) {
                    if (reqdata) {
                        if (reqdata.message != "") {
                            $.modalAlert("DrgGọi giao diện thất bại:" + reqdata.message, 'warning');
                        }
                    }
                }
            });
        }
        if (zdcnt == 1) {
            $.modalConfirm("Chẩn đoán xuất viện hiện tại chỉ có một, xác định xuất khu?", function (flag) {
                if (flag) {
                    $.ajax({
                        type: "POST",
                        url: "/NurseManage/WardMaintenance/SavaPatDiagnosis",
                        data: { patOutAreaVO: patOutAreaVO },
                        dataType: "json",
                        async: false,
                        success: function (ajaxresp) {
                            if (ajaxresp.state == "success") {
                                $.modalMsg('Xuất khu thành công', 'success');
                            }
                            else {
                                $.modalAlert(ajaxresp.message, 'warning');
                            }
                            clearData();
                            callBack();
                        }
                    });
                }
                else {
                    callBack();
                }
            });
        }
        else {
            $.ajax({
                type: "POST",
                url: "/NurseManage/WardMaintenance/SavaPatDiagnosis",
                data: { patOutAreaVO: patOutAreaVO },
                dataType: "json",
                async: false,
                success: function (ajaxresp) {
                    if (ajaxresp.state == "success") {
                        $.modalMsg('Xuất khu thành công', 'success');
                    }
                    else {
                        $.modalAlert(ajaxresp.message, 'warning');
                    }
                    clearData();
                    callBack();
                }
            });
        }


    }
    //Chẩn đoán hỗ trợ Đông y Thêm mớiicon
    $('#tablezyzd .plusToggleCircle').click(function () {
        var number = $('#tablezyzd .zdinput').length + 1;
        var $newTr = $('<tr><th class="formTitle"><i class="fa fa-minus minusToggleCircle" aria-hidden="true" style="width:30px;display:none; margin-left: 10px; color: #6ff3ad; font-size: large;"></i>Chứng chính:</th><td class="formValue"><input id="txt_zyfzzd' + number + 'dm" type="hidden" /><input id="txt_zyfzzd' + number + '" name="txt_zyfzzd' + number + '" type="text"  disabled="disabled" style="background-color:#edeaea" class="form-control required zdinput" /></td></tr>');
        $newTr.appendTo($(this).closest('table'));
    });

    //Chẩn đoán hỗ trợ Tây y Thêm mớiicon
    $('#tablezd .plusToggleCircle').click(function () {
        var number = $('#tablezd .zdinput').length + 1;
        var $newTr = $('<tr><th class="formTitle"><i class="fa fa-minus minusToggleCircle" aria-hidden="true" style="width:30px;display:none; margin-left: 10px; color: #6ff3ad; font-size: large;"></i>Chẩn đoán hỗ trợ:</th><td class="formValue"><input id="txt_fzzd' + number + 'dm" type="hidden" /><input id="txt_fzzd' + number + '" name="txt_fzzd' + number + '" type="text"  disabled="disabled" style="background-color:#edeaea" class="form-control required zdinput" /></td></tr>');
        $newTr.appendTo($(this).closest('table'));
    });

    function clearData()
    {
        $("#sel_cqfs").val("");
        $("#txt_cqrq").val("");
        $("txt_zdsj").val("");
        $("#txt_cyzd").val("");
        $("#txt_cyzddm").val("");
        $("#txt_fzzd1").val("");
        $("#txt_fzzd1dm").val("");
        $("#txt_fzzd2").val("");
        $("#txt_fzzd2dm").val("");
        $("#txt_fzzd3").val("");
        $("#txt_fzzd3dm").val("");
        $("#txt_zdyzd").val("");
    }


</script>
@model dynamic

@{
    ViewBag.Title = "Chẩn đoán xuất khu";
    Layout = "~/Views/Shared/_Index.cshtml";
    var isShowDiag = SysConfigReader.String("Inpatient_OutAre");
}

<style>
    .dv-body {
        /*background-color: #00a0e9;*/
        width: 100%;
    }

    .dv-left {
        width: 120px;
        float: left;
    }

    .dv-left-title {
        width: 100%;
        height: 30px;
        line-height: 30px;
        background-color: #00a0e9;
        text-align: center;
        color: white;
    }

    .dv-right {
        float: left;
        margin-left: 5px;
    }

    .dv-body {
        /*overflow-x:hidden;*/
        overflow-y: hidden;
    }

    .gridPanel .ui-jqgrid-bdiv {
        overflow-x: hidden;
    }
</style>
<div class="dv-body" style="background-color: white;">
    <div class="dv-left">
        <div class="dv-left-title">Danh sách khu bệnh</div>
        @*<table id="gridBqList"></table>*@
        @Html.Partial("_WardTreeForm")
    </div>

    <div class="dv-right">
        <form name="form1">
            <div class="panel panel-default">
                <div class="panel-heading navb-bg">
                    Điều kiện lọc
                </div>
                <div>
                    <table class="form">
                        <tr>
                            <th class="formTitle">Họ tên/Số nhập viện:</th>
                            <td class="formValue">
                                <input id="txt_name" type="text" class="form-control" placeholder="Họ tên/Số nhập viện" />
                            </td>
                            <td class="formTitle">
                                <input type="button" id="btn_search" class="btn btn-md btn-primary" value="Tra cứu" />
                            </td>
                            <td colspan="4"></td>

                        </tr>
                    </table>
                </div>
            </div>
        </form>
        <div class="gridPanel">
            <table id="gridPatList"></table>
            <div id="gridPager"></div>
        </div>
    </div>
</div>
<script lang="javascript">

    $(document).ready(function () {

        DefaultCheck();
    });
    //Mặc định chọn nút gốc.
    function DefaultCheck() {
        var firstid = $("div[id^='wardTree_']:first").attr("id").replace("wardTree_", "");//Mã khu bệnh của nút gốc
        var addstyleid = 'wardTree_' + firstid;
        var item = new Object();
        item.id = firstid;
        $("#" + addstyleid + "").addClass('bbit-tree-selected');//Thêm kiểu đã chọn
        wardTree_onnodeclick(item);
    }
    var bqdm = null;
    $(".dv-body").height($(window).height());
    $(".dv-body").width($(window).width());
    var rightWidth = $(".Newtouch_iframe", parent.document).width() - $(".dv-left").width() - 5
    $(".dv-right").width(rightWidth - 20);

    function wardTree_onnodeclick(item) {
        bqdm = item.id;
        GetPatientList(bqdm);
        refleshPatientList();
    }
    //Sự kiện làm mới
    function refleshPatientList() {
        $("#btn_search").trigger('click');
    }
    $("#btn_search").click(function () {
        var keyValue = bqdm;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn khu bệnh", 'warning');
            return;
        }
        $("#gridPatList").jqGrid('setGridParam', {
            postData: { keyword: $('#txt_name').val(), bqdm: bqdm },
        }).trigger('reloadGrid'); //Tải lại bảng hiện tại
    });
    // Điều kiện tra cứu
    function getSearchPostData() {
        var keyword = $('#txt_name').val();
        //var ksrq = $('#txt_ksrq').val();
        //var jsrq = $('#txt_jsrq').val();
        //return{ keyword: keyword, ksrq: ksrq, jsrq: jsrq };
        return { keyword: keyword };

    }
    function GetPatientList(bqdm) {
        var $gridList = $("#gridPatList");
        var Querydata = getSearchPostData();
        Querydata["bqdm"] = bqdm;
        //alert(bqdm);
        $gridList.dataGrid({
            //Lấy thông tin bệnh nhân tại viện
            url: "/EntryRegistration/GetINAreaPatlist",
            postData: Querydata,
            dataType: "json",
            height: $(window).height() - 155,
            //width: $(".Newtouch_iframe", parent.document).width() - $(".dv-left").width() - 5,
            //autowidth: false,//Tự tính lại theo chiều rộng của vùng chứa cha,Mặc địnhfalse Không tính lại
            //shrinkToFit: true,// Thu phóng theo tỷ lệ mặc định làtrue
            //multiselect: true,
            //unwritten:false,
            colModel: [
                { label: 'Id', name: 'Id', hidden: true },
                { label: 'Số nhập viện', name: 'zyh', align: 'center', width: 60 },
                { label: 'Họ tên', name: 'xm', align: 'center', width: 90 },
                {
                    label: 'Giới tính', name: 'sex', align: 'center', width: 50, formatter: function (val) {
                        return $.getGender(val);
                    }
                },
                { label: 'Tuổi', name: 'nl', align: 'center', width: 50 },
                { label: 'Số giường', name: 'cwmc', align: 'center', width: 70 },
                { label: 'Ngày nhập viện', name: 'ryrq', align: 'center', width: 85, formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d' } },
                { label: 'Tính chất bệnh nhân', name: 'brxz', hidden: true },
                { label: 'Loại chi phí', name: 'brxzmc', align: 'center', width: 80 },
                { label: 'Chẩn đoán nhập viện', name: 'zzdmc', align: 'center', width: 150 },
                { label: 'Chẩn đoán xuất viện', name: 'cyzdmc', align: 'center', width: 150 },
                { label: 'Bác sĩ giường bệnh', name: 'ysxm', align: 'center', width: 90 },
                {
                    label: "Thao tác", name: "", align: "center", width: 100,
                    formatter: function (cellvalue, options, rowobject) {
                        return "<a href=\#\" onclick='recall1(\"" + rowobject.zyh + "\",\"" + rowobject.brxz + "\")'' title='Chẩn đoán nhập viện' style='text-decoration: none;color: #dd4b39;cursor: pointer;'>Chẩn đoán nhập viện</a>" +
                            "<a href=\#\" onclick='recall2(\"" + rowobject.zyh + "\",\"" + rowobject.brxz + "\")'' title='Chẩn đoán ra khỏi khu' style='text-decoration: none;color: #dd4b39;cursor: pointer;margin-left:5px;'>Chẩn đoán ra khỏi khu</a>";
                    }
                }
            ],
            pager: "#gridPager",
            sortname: 'ryrq desc',
            viewrecords: true,
            //loadComplete: function () { //ẨngridThanh cuộn dưới cùng
            //    $("#gridPatList").closest(".ui-jqgrid-bdiv").css({ "overflow-x": "hidden" });
            //}
        });
    }

    //Chẩn đoán nhập viện
    function recall1(zyh,brxz) {
        if (zyh == null || zyh === "") {
            $.modalAlert("Vui lòng chọn một bệnh nhân", 'warning');
            return;
        }
        $.modalOpen({
            id: "InAreaDiagnoosisForm",
            title: "Chẩn đoán nhập viện",
            url: "/NurseManage/WardMaintenance/InAreaDiagnoosisForm?zyh=" + zyh + "&brxz=" + brxz,
            width: "620px",
            height: "400px",
            callBack: function (iframeId) {
                top.frames[iframeId].SavaInArea();
                $.loading(false);
                $.modalClose("InAreaDiagnoosisForm");
                refleshPatientList();
            }
        });
    }
    
    //Chẩn đoán xuất viện
    function recall2(zyh, brxz) {
        if (zyh == null || zyh === "") {
            $.modalAlert("Vui lòng chọn một bệnh nhân", 'warning');
            return;
        }
        var btn = ['确定', '关闭'];
        var btnclass = ['btn btn-primary', 'btn btn-danger'];
        if ('@isShowDiag'=='OFF')
        {
            btn = ['', '关闭']
            btnclass = ['', 'btn btn-danger'];
        }
        $.modalOpen({
            id: "OutAreaDiagnoosisForm",
            title: "Bệnh nhân xuất khu",
            url: "/NurseManage/WardMaintenance/OutAreaDiagnoosisForm?zyh=" + zyh + "&brxz=" + brxz,
            width: "620px",
            height: "460px",
            btn: btn,
            btnclass: btnclass,
            callBack: function (iframeId) {
                top.frames[iframeId].SavaOutArea();
                $.loading(false);
                $.modalClose("OutAreaDiagnoosisForm");
                refleshPatientList();
            }
        });
    }
</script>
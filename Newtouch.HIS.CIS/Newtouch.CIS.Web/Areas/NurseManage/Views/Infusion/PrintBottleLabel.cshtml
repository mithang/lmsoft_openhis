@model dynamic
@{
    ViewBag.Title = "Nhãn chaiIn";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<style>
    table {
        font-size: 12px;
        margin: 0 auto;
    }

    th {
        text-align: right;
        padding: 0;
        margin: 0;
    }

    #imgqr {
        width: 100%;
        height: 100%;
        margin: 0;
    }

    #tb_pat td {
        text-align: left;
        padding: 0;
        margin: 0;
    }

    #tb_yp th, td {
        text-align: center;
        padding: 0;
        margin: 0;
    }
</style>
<form>
    <div style="position:fixed;top:321px;left:50px;cursor:pointer;">
        <img id="print" src="@MvcHelper.GetStaticResourceScriptUrl("~/img/print.png")" title="In" alt="In" />
    </div>
    <table id="tb_pat">
        <tr>
            <th style="width:37px;">Họ tên:</th>
            <td style="width:50px;">@ViewBag.patInfo.patientName</td>
            <th style="width:55px;">Giường/Số ghế:</th>
            <td style="width:75px;">@ViewBag.patInfo.seatNum</td>
            <th rowspan="3" style="width: 50px; height: 49px;">
                <img id="imgqr" src="@ViewBag.src" />
            </th>
        </tr>
        <tr>
            <th>Tuổi:</th>
            <td></td>
            <th>Pha thuốc:</th>
            <td>@ViewBag.patInfo.dispenserName</td>
        </tr>
        <tr>
            <th>Thực hiện:</th>
            <td>@ViewBag.patInfo.executorName</td>
            <th>Thời gian:</th>
            <td></td>
        </tr>
        <tr><td style="border-bottom:1px solid #000000;border-top:1px solid #000000; padding:1px 0;" colspan="5"></td></tr>
    </table>
    <table id="tb_yp">
        <tr>
            <th style="width:100px;">Thuốc</th>
            <th style="width:52px;">Quy cách</th>
            <th style="width:40px;">Liều dùng</th>
            <th style="width:40px;">Số lượng</th>
            <th style="width:40px;">Liều lượng</th>
        </tr>
        <tr><td style="border-bottom:1px solid #000000; padding:1px 0;" colspan="5"></td></tr>
        @foreach (var item in ViewBag.drugs)
        {
            if (item != null)
            {
                <tr>
                    <td>@item.ypmc</td>
                    <td>@item.ypgg</td>
                    <td>@item.ylStr</td>
                    <td>@item.slStr</td>
                    <td>@item.jlStr</td>
                </tr>
            }
        }
    </table>
</form>

<script lang="javascript">
    $(function () {
        printPage();
    });
    function printPage() {
        $('#print').click(function () {
            $('#print').hide();
            window.print();
            $.modalClose("PrintBottleLabel");
        });

    }
</script>
@{
    ViewBag.Title = "Quản lý thông tin dị ứng nhập viện";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    #btn_search {
        width: 45px;
        font-weight: bolder;
    }
</style>
<div class="panel panel-default">
    <div class="panel-heading navb-bg">
        Điều kiện lọc
    </div>
    <div style="padding: 2px;">
        <table class="form">
            <tr>
                <td class="formTitle">Từ khóa:</td>
                <td class="formValue">
                    <input type="text" class="form-control" id="keyword" placeholder="Số chứng từ/Họ tên" />
                </td>
                <td class="formTitle">Khoa:</td>
                <td class="formValue formDdlSelectorTd">
                    <select class="form-control" id="lb">
                        <option value="">Tất cả</option>
                    </select>
                </td>
                <td class="formTitle">Trạng thái:</td>
                <td class="formValue formDdlSelectorTd">
                    <select class="form-control" id="lb">
                        <option value="">Tất cả</option>
                    </select>
                </td>
                <td class="formTitle">Thời gian:</td>
                <td class="formValue">
                    <input id="txt_zxrq" type="text" class="form-control input-wdatepicker" style="width:80%; float:left;" onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" value="@DateTime.Now.ToString("yyyy-MM-01")">
                </td>
                <td class="formTitle" style="width:5px">đến</td>
                <td class="formValue">
                    <input id="txt_zxrq" type="text" class="form-control input-wdatepicker" style="width:80%; float:left;" onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </td>
                <td class="formTitle">
                    <input type="button" class="btn btn-primary btn-md" id="btn_search" value="Tra cứu" />
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel" style="width: 45%;float:left;">
    <table id="gridListPatient"></table>
    <div id="gridPager1" rel="form1"></div>
</div>
<div class="gridPanel" style="margin-left:0.5%;width:54.5%;float:left;">
    <table id="gridListPs"></table>
    <div id="gridPager2" rel="form1"></div>
</div>
@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
    ShowKeyList = new[] { 7, 8 },
    F7Text = "执行",
    F8Text = "取消执行"
})
<script>
    var localdata = [];
    var deldata = [];//Xóa đối tượng
    var $gridMxList = $("#gridListPs");
    $(function () {
        //Khi thay đổi kích thước cửa sổ trình duyệt thì tải lạijqGridchiều rộng của
        $(window).resize(function () {
            
        });
        Initial();
    });

    //Khởi tạo
    function Initial() {
        getLbSelectTree();
        gridList();
        gridMxInfo();
    }

    //Loại
    function getLbSelectTree() {
        $("#lb").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.itemDetails) {
                    $.each(top.clients.itemDetails, function (idx, val) {
                        if (val.Type === "SSDFL") {
                            $.each(val.Items, function (key, value) {
                                $('#lb').append('<option value="' + value.Code + '">' + value.Name + '</option>');
                            });
                        }
                    });
                }
                return resultObjArr;
            }
        });
        $('#lb').change(function () {
            $('#btn_search').trigger('click');
        });
    }

    //Thông tin bảng chính
    function gridList() {
        var $gridList = $("#gridListPatient");
        $gridList.dataGrid({
            url: "/NurseManage/",
            postData: $("#form1").formSerialize(),
            height: $(window).height() - document.getElementById('gridListPatient').offsetTop - 120,
            colModel: [
                { label: 'Id', name: 'Id', key: true, hidden: true },
                { label: 'Nguồn', name: 'Name', width: 30, align: 'center' },
                { label: 'Số chứng từ', name: 'py', width: 100, align: 'center' },
                { label: 'Họ tên', name: 'DietBigType', width: 50, align: 'center' },
                {
                    label: 'Giới tính', name: 'DietType', width: 30, align: 'center', formatter: function (cellvalue) {
                        return $.enum.getDescByValue("EnumSSLB", cellvalue);
                    }
                },
                { label: 'Tuổi', name: 'bdsfxm', width: 30, align: 'center' },
                { label: 'Số nhập viện', name: 'bdsfxm', width: 50, align: 'center' },
                { label: 'Số giường', name: 'bdsfxm', width: 50, align: 'center' },
                { label: 'Khoa', name: 'bdsfxm', width: 50, align: 'center' }
            ],
            pager: "#gridPager1",
            rowNum: '15',
            sortname: 'CreateTime desc',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                localdata = [];
                ajaxmxList();
            },
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam',
                {
                    postData: getgridListPar()
                }).trigger('reloadGrid');
        });
    }

    function ajaxmxList() {
        var Id = $("#gridList").jqGridRowValue().Id;
        $.najax({
            url: "@Url.Action("GetGridMXList")",
            data: { Id: Id },
            dataType: "json",
            type: "POST",
            async: false,
            success: function (data) {
                localdata = data;
                $.each(localdata, function () {
                    this.action = getActionStr()
                });
                $gridMxList.jqGrid('setGridParam', {
                    datatype: 'local',
                    data: localdata,
                }).trigger("reloadGrid");
            }
        });
    }

    //Thông tin chi tiết
    function gridMxInfo() {
        $gridMxList.dataGrid({
            url: "/NurseManage/",
            postData: $("#form1").formSerialize(),
            height: $(window).height() - document.getElementById('gridListPs').offsetTop - 120,
            multiselect: true,
            colModel: [
                { label: 'Id', name: 'Id', key: true, hidden: true },
                { label: 'Tên hạng mục', name: 'Name', width: 100, align: 'center' },
                { label: 'Quy cách hạng mục', name: 'py', width: 50, align: 'center' },
                { label: 'Số lượng', name: 'py', width: 50, align: 'center' },
                { label: 'Đơn giá', name: 'py', width: 50, align: 'center' },
                { label: 'Số tiền', name: 'py', width: 50, align: 'center' },
                { label: 'Người thực hiện', name: 'py', width: 50, align: 'center' },
                { label: 'Trạng thái', name: 'py', width: 50, align: 'center' },
                { label: 'Kết quả', name: 'py', width: 50, align: 'center' },
                { label: 'Ghi chú', name: 'py', width: 50, align: 'center' }
            ],
            pager: "#gridPager2",
            rowNum: '15',
            sortname: 'CreateTime desc',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {

            },
        });
    }


    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "Thêm suất ăn mới",
            url: "/NurseManage/DietaryAdvice/Form",
            width: "700px",
            height: "300px",
            callBack: function (iframeId) {
                top.frames[iframeId].AcceptClick(function (data) {
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                });
            }
        });
    }

    function btn_edit() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        $.modalOpen({
            id: "Form",
            title: "Sửa suất ăn",
            url: "/NurseManage/DietaryAdvice/Form?keyValue=" + keyValue,
            width: "700px",
            height: "300px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $.currentWindow().$("#gridList").resetSelection();
                    $.currentWindow().$("#gridList").trigger("reloadGrid");

                });

            }
        });
    }

    function btn_delete() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        $.deleteForm({
            url: "@Url.Action("DeleteForm")",
            param: { keyValue: keyValue },
            success: function () {
                $.modalMsg("Xóa thành công","warning");
                $("#gridList").resetSelection();
                $("#gridList").trigger("reloadGrid");
            }
        })
    }

    function getgridListPar() {
        var lb = $('#lb').val();
        var keyword = $('#keyword').val();
        return { lb: lb, keyword: keyword }
    }

    function newsfxmData() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một thông tin suất ăn", 'warning');
            return;
        }
         var dataRow = {
             Id: Math.random().toString() + new Date().getMilliseconds(),
             action: getActionStr(),
             baseId: $("#gridList").jqGridRowValue().Id
            };
        $gridMxList.jqGrid("addRowData", undefined, dataRow, "last");
    }

    function getActionStr() {
        return "<i class='fa fa-minus-square-o' style='font-size: large; color: #09a3ea;' onclick='deleteRowData($(this).parent().parent().attr(\"id\"))'></i>";
    }

    function saveData() {

        //Lấy tất cả các dòngId，duyệt để khung chỉnh sửa ở trạng thái lưu
        var rowIds = $gridMxList.jqGrid('getDataIDs');
        if (rowIds < 1) {
            $.modalAlert("Hiện không có nội dung suất ăn đã lưu", 'warning');
            return;
        }
        for (var i = 0; i < rowIds.length; i++) {
            var saveResult = $gridMxList.saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);

            if (!saveResult) {
                EnableInlineEditBox();    //Khởi động lại và bật chỉnh sửa Nếu không, lần sauSavethì sẽ trả vềfalse
                return;   //Lưu thất bại, thìreturn
            }
        }

        var gridMxData = $gridMxList.jqGrid('getRowData_AllLine', null, true);
        if (gridMxData.length < 1) {
            $.modalAlert("Hiện không có nội dung y lệnh đã lưu", 'warning');
        }

        $.each(gridMxData, function () {
            delete this.action;
             });
       

        $.najax({
            url: "@Url.Action("SaveData")",
            data: { gridMxData: gridMxData, deldata: deldata },
            dataType: "json",
            type: "POST",
            async: false,
            success: function (data) {
                $.modalMsg("Lưu thành công", "success");
                $(".hiding").click();
            }
        });
    }
    //Xóa chi tiết
    function deleteRowData(selRowId) {
        if (!!selRowId) {
            var Id = $gridMxList.jqGrid('getRowData', selRowId).Id;
            $gridMxList.jqGrid("delRowData", selRowId);
            if (Id.indexOf("0.") == '-1') {//Ghi lại, xóa khỏi cơ sở dữ liệu
                deldata.push(Id);
            }
        }
    }

    //Thêm mới
    function newtouch_event_f7() {
        var key = "";
        $.modalOpen({
            id: "Form",
            title: "Thông tin dị ứng",
            url: "/NurseManage/Infusion/AllergyForm?id=" + key,
            width: "500px",
            height: "340px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("#gridListPatient").resetSelection();
                    $("#gridListPatient").trigger("reloadGrid");
                });
            }
        });
    }
</script>

    function TransferBed(eleBeDv) {
        $.modalConfirm("Xác nhận chuyển giường?", function (flag) {
            if (flag) {
                $.najax({
                    type: "POST",
                    url: "/EntryRegistration/ChangeBed",
                    data: { zyh: zyh, bedCode: bedCode, wardCode: bqdm },
                    dataType: "json",
                    loadingtext: "Bệnh nhân đang chuyển giường, vui lòng đợi trong giây lát...",
                    success: function (ajaxresp) {
                        if (ajaxresp.state == "success") {
                            $.modalMsg('Chuyển giường thành công!', 'success');
                        }
                        else {
                            $.modalAlert(ajaxresp.message, 'warning');
                        }
                        getBedInitList(bqdm);
                    }
                });
            }

        });
    }

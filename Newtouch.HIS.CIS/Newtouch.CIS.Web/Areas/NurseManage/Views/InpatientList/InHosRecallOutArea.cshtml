@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "Trung tâm bệnh nhân trạm y tá-Thu hồi xuất khu";
    var reportUrl = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("ReportUrl");
    var ReportSystemCode = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("ReportSystemCode");
    var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}


<div id="linkcqzh" role="tabpanel" class="tab-pane" style="width:100%;margin-right: 5px; border:solid 1px #ddd; margin-top: 3px;">
    <form name="form1">
        <div class="panel panel-default">
            <div class="panel-heading navb-bg">
                Điều kiện lọc
            </div>
            <div>
                <table class="form">
                    <tr>
                        <th class="formTitle">Họ tên:</th>
                        <td class="formValue">
                            <input id="txt_zhname" class="form-control" placeholder="Họ tên" />
                        </td>
                        <th class="formTitle">Ngày bắt đầu:</th>
                        <td class="formValue">
                            <input id="txt_zhksrq" class="form-control input-wdatepicker formClearIgnore" onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', onpicked: function () { refleshPatientList(); } })" value="@DateTime.Now.ToString("yyyy-MM-01")" />
                        </td>
                        <th class="formTitle">Ngày kết thúc:</th>
                        <td class="formValue">
                            <input id="txt_zhjsrq" class="form-control input-wdatepicker formClearIgnore" onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', onpicked: function () { refleshPatientList(); } })" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </td>
                        <td class="formTitle">
                            <input type="button" id="btncqzh_search" class="btn btn-md btn-primary" value="Tra cứu" />
                        </td>
                        <td colspan="1"></td>
                    </tr>
                </table>
            </div>
        </div>
    </form>
    <div class="gridPanel" style="width: 100%;background-color: #fff;">
        <table id="gridPatCqzhList"></table>
        <div id="gridCqzhPager"></div>
    </div>
</div>
<script type="text/javascript">
    function init_cqzh()
    {
        $("#PatTreeList").treeview({
            height: $(window).height() - 40,
            slimscroll: false,
            showcheck: false,
            url: "/NurseManage/EntryRegistration/TreeViewdata",
            param: {},
            oncheckboxclick: null,
            onnodeclick: function (item) {
                var callbackFuncName = 'PatTreeListcqzh_onnodeclick';
                if (window[callbackFuncName] && typeof window[callbackFuncName] === 'function') {
                    window[callbackFuncName](item);
                }
            }

        });
        DefaultZhCheck();
    }
    //Mặc định chọn nút gốc.
    function DefaultZhCheck() {
        var firstid = $("div[id^='PatTreeList_']:first").attr("id").replace("PatTreeList_", "");//Mã khu bệnh của nút gốc
        var addstyleid = 'PatTreeList_' + firstid;
        var item = new Object();
        item.id = firstid;
        $("#" + addstyleid + "").addClass('bbit-tree-selected');//Thêm kiểu đã chọn
        PatTreeListcqzh_onnodeclick(item);
    }
    var bqdm = null;
    //$(".dv-body").height($(window).height());
    //$(".dv-body").width($(window).width());
    //var rightWidth = $(".Newtouch_iframe", parent.document).width() - $(".dv-left").width() - 5;
    //$(".dv-right").width(rightWidth - 20);
    function PatTreeListcqzh_onnodeclick(item) {

        bqdm = item.id;
        GetPatientCqzhList(bqdm);
        refleshPatientList();
    }
    //Sự kiện làm mới
    function refleshPatientList() {
        $("#btncqzh_search").trigger('click');
    }
    $("#btncqzh_search").click(function () {
        var keyValue = bqdm;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn khu bệnh", 'warning');
            return;
        }
        if ($('#txt_zhksrq').val() && $('#txt_zhjsrq').val() && ($('#txt_zhksrq').val() > $('#txt_zhjsrq').val())) {
            $.modalAlert("Ngày bắt đầu không được lớn hơn thời gian kết thúc", 'warning');
            return;
        }
        $("#gridPatCqzhList").jqGrid('setGridParam', {
            postData: { keyword: $('#txt_zhname').val(), ksrq: $('#txt_zhksrq').val(), jsrq: $('#txt_zhjsrq').val(), bqdm: bqdm },
        }).trigger('reloadGrid'); //Tải lại bảng hiện tại
    });
    // Điều kiện tra cứu
    function getSearchzhPostData() {
        var keyword = $('#txt_zhname').val();
        var ksrq = $('#txt_zhksrq').val();
        var jsrq = $('#txt_zhjsrq').val();
        return { keyword: keyword, ksrq: ksrq, jsrq: jsrq };

    }
    function GetPatientCqzhList(bqdm) {
        var $gridList = $("#gridPatCqzhList");
        var Querydata = getSearchzhPostData();
        Querydata["bqdm"] = bqdm;
        //alert(bqdm);
        $gridList.dataGrid({
            //Lấy thông tin bệnh nhân chờ thanh toán xuất khu
            url: "/EntryRegistration/GetOutAreaPatlist",
            postData: Querydata,
            dataType: "json",
            height: $(window).height() - 155,
            //width: $(".Newtouch_iframe", parent.document).width() - $(".dv-left").width() - 5,
            autowidth: true,//Tự điều chỉnh theo chiều rộng của vùng chứa cha
            shrinkToFit: false,//Thanh cuộn
            //unwritten: false,
            //multiselect: true,
            colModel: [
               { label: 'Id', name: 'Id', hidden: true },
               { label: 'Số nhập viện', name: 'zyh', align: 'center', width: 80 },
               { label: 'Họ tên', name: 'xm', align: 'center', width: 100 },
               {
                   label: 'Giới tính', name: 'sex', align: 'center', width: 40, formatter: function (val) {
                       return $.getGender(val);
                   }
               },
               { label: 'Tuổi', name: 'nl', align: 'center', width: 40 },
                { label: 'Số giường', name: 'cwmc', align: 'center', width: 80 },
               { label: 'Ngày nhập viện', name: 'ryrq', align: 'center', width: 150, formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
               { label: 'Loại chi phí', name: 'brxzmc', align: 'center', width: 80 },
               { label: 'Chẩn đoán nhập viện', name: 'zzdmc', align: 'center', width: 120 },

               { label: 'Ngày xuất khu', name: 'cqrq', align: 'center', width: 150, formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
               { label: 'Bác sĩ giường bệnh', name: 'ysxm', align: 'center', width: 100 },
               {
                   label: "Thao tác", name: "zyh", align: "center", width: 80,
                   formatter: function (cellvalue) {
                       return "<a href=\#\" onclick='recall(\"" + cellvalue + "\")'' title='Triệu hồi ra khỏi khu' style='text-decoration: none;color: #dd4b39;cursor: pointer;'>Triệu  hồi</a>";
                   }
               }
            ],
            pager: "#gridPager",
            sortname: 'zyh asc',
            viewrecords: true,
        });
    }
    //Thu hồi
    function recall(zyh) {
        if (zyh == null || zyh == "") {
            $.modalAlert("Vui lòng chọn một bệnh nhân", 'warning');
            return;
        }
        $.modalConfirm("Bạn có chắc muốn thu hồi không?", function (flag) {
            if (flag) {
                $.ajax({
                    type: "POST",
                    url: "/EntryRegistration/SaveRecallOutArea",
                    data: { zyh: zyh, bqdm: bqdm },
                    dataType: "json",
                    success: function (ajaxresp) {
                        if (ajaxresp.state == "success") {
                            $.modalMsg('Thu hồi thành công', 'success');
                        }
                        else {
                            $.modalAlert(ajaxresp.message, 'warning');
                        }
                        refleshPatientList();
                    }
                });
            }
        });
    }
</script>  

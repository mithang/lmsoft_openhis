            var rowData = $("#gridYzshList").jqGrid('getRowData', selRowIds[i]);
            strYZID.push({ yzid: rowData.yzid, yzxz: rowData.yzxz, yzlxmc: rowData.yzlx, zyh: rowData.zyh, zh1: rowData.zh1, ispscs: rowData.ispscs, yzh: rowData.yzh });
            //2021-9-18 HủyTest dakếtnếukiểm tra
            //if (rowData.ispscs == "1" && rowData.psjg == "0") {
            //    strYZID.push({ yzid: rowData.yzid, yzxz: rowData.yzxz, yzlxmc: rowData.yzlx, zyh: rowData.zyh, zh1: rowData.zh1, zh: rowData.zh, ispscs: rowData.ispscs, yzh: rowData.yzh });
            //}
            //else if (rowData.ispscs != "1") {
            //    strYZID.push({ yzid: rowData.yzid, yzxz: rowData.yzxz, yzlxmc: rowData.yzlx, zyh: rowData.zyh, zh1: rowData.zh1, zh: rowData.zh, ispscs: rowData.ispscs, yzh: rowData.yzh });
            //}
            //else {
            //    if (tipyzs == "") {
            //        tipyzs += rowData.yzid;
            //    }
            //    else {
            //        tipyzs += "," + rowData.yzid;
            //    }
            //}
        }
        if (strYZID.length == 0 && patzyh === "") {
            //if (!!tipyzs) {
            //    AuditTipsPs(tipyzs);
            //}
            return;
        }

        $.najax({
            type: "POST",
            url: "/NurseManage/OrderAudit/submitOrderListbyPat",
            data: { patList: patzyh, yzxz: yzxz, orderList: strYZID },
            dataType: "json",
            success: function (ajaxresp) {
                if (ajaxresp == "") {
                    setTimeout(function () {
                        $.modalMsg('Duyệtthất bại', 'error');
                    }, 1000);
                }
                else {
                    setTimeout(function () {
                        if (!!ajaxresp.data) {
                            AuditTipsPs(ajaxresp.data);
                        }
                        else {
                            $.modalMsg('Duyệtthành công', 'success');
                        }

                    }, 1000);

                }
                getOrderAuditList(null, null);
            }
        });
    }

    function PSLR(rowId) {

        InpatientPslrForm(rowId);

    }

    function InpatientPslrForm(rowId) {
        var selRowIds = "";
        if (!!rowId) {
            selRowIds = rowId;
        }
        else {
            selRowIds = jQuery("#gridYzshList").jqGrid("getGridParam", "selarrrow");
            if (selRowIds.length > 1) {
                $.modalAlert("Test daNhậpChỉ có thểĐã chọnmộtBệnh nhân", 'warning');
                return;
            }
        }
        if (selRowIds == null || selRowIds.length < 1) {
            $.modalAlert("Vui lòngĐã chọncần duyệtBệnh nhân", 'warning');
            return;
        }
        var rowData = $("#gridYzshList").jqGrid('getRowData', selRowIds);
        if (rowData.ispscs != "1") {
            $.modalAlert("Y lệnh này không cần test da", 'warning');
            return;
        }
        //if (rowData.ispscs == "1" && (rowData.psjg == "0" || rowData.psjg == "1")) {
        //    $.modalAlert("Hiện tại kết quả không thể sửa, vui lòng chuyển đến trang nhập kết quả test da.", 'warning');
        //    return;
        //}
        zyh = rowData.zyh;
        yzid = rowData.yzid;
        yzxz = rowData.yzxz;

        $.modalOpen({
            id: "InpatientVitalSignsForm",
            title: "Test daNhập",
            url: "/NurseManage/OrderAudit/Inputresults",
            width: "400px",
            height: "200px",
            leftlalbelchecked: true,
            leftlalbelcheckedasClose: false,
            callBack: function (iframeId) {
                top.frames[iframeId].AcceptClick(function (patData) {

                    $.ajax({
                        url: "/NurseManage/OrderAudit/Enteragain",
                        dataType: "json",
                        data: { "zyh": zyh, "yzid": yzid, "lrjg": patData, "yzlb": yzxz },
                        type: "post",
                        success: function (data) {
                            var s = JSON.stringify(data.message);
                            if (s = "Test daNhậpthành công") {
                                $.modalMsg('Test daNhậpthành công', 'success');
                                $('#gridYzshList').jqGrid("clearGridData");
                                getOrderAuditList(null, null);
                            }
                            else {
                                $.modalMsg('Nhập thất bại hoặc đã nhập', 'error');
                                $('#gridYzshList').jqGrid("clearGridData");
                                getOrderAuditList(null, null);
                            }
                        }
                    });
                });
            }
        });
    }

    function AuditTipsPs(ajaxresp) {
        $.modalOpen({
            id: "AuditTipsPs",
            title: "Kết quả test daNhắc nhở",
            url: "/NurseManage/OrderAudit/AuditTips?ajaxresp=" + ajaxresp,

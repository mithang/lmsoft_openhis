    <div class="gridPanel" style="width: 100%;background-color: #fff;">
        <table id="gridYzshList"></table>
        <div id="gridYzshPager"></div>
    </div>
</div>

<script>
    var shzyh = "";
    var fistshload = true;
    function init_yzsh(zyh) {
        if (!shzyh)
            shzyh = zyh;
        $('#gridYzshList').jqGrid("clearGridData");
        getYzshTreeList(shzyh);
        if (fistshload) {
            gridYzshList(shzyh);
            fistshload = false;
        } else {
            RefreshyzshOrder();
        }
        
    }
    function getYzshTreeList(zyhtimes) {
        $("#PatTreeList").treeview({
            height: $(window).height() - 40,
            slimscroll: false,
            showcheck: true,
            url: "/NurseManage/OrderAudit/GetPatWardTree",
            param: { aa: zyhtimes, keyword: $("#keyword").val() },
            oncheckboxclick: function (item, s) {
                getOrderAuditList(item, s);
            }
        });

    }

    function getOrderAuditList(item, s) {
        var patlist = $("#PatTreeList").getCheckedNodeObjArray();
        var patlistFath = "";

        var patzyh = "";
        var patzyhItem = "";

        //hiện tạiĐã chọnNút cha
        var len = 0;
        var single = 0; //CóKhôngphiếucáicontiếtđiểm

        if (item != null && item.Ex1 == "p") {
            patlistFath = item.ChildNodes;
            len = patlistFath.length;
        }
        else if (item != null && item.Ex1 == "c") {
            patlistFath = item;
            len = 1;
            single = 1;
        }

        //Đã chọntiếtđiểm
        for (var i = 0; i < patlist.length; i++) {
            if (patlist[i].Ex1 == "c") {
                patzyh += patlist[i].value + ",";
            }
        }

        if (s == 1) {
            if (single == 0) {
                for (var j = 0; j < len; j++) {
                    if (patlistFath[j].Ex1 == "c") {
                        patzyh += patlistFath[j].value + ",";
                    }
                }
            }
            else if (patlistFath.Ex1 == "c") {
                patzyh += patlistFath.value;
            }
        }
        else if (s == 0) {
            if (single == 0) {
                for (var j = 0; j < len; j++) {
                    if (patlistFath[j].Ex1 == "c" && patlistFath[j].checkstate == 1) {
                        patzyh = patzyh.replace(patlistFath[j].value + ",", "");
                    }
                }
            }
            else if (patlistFath.Ex1 == "c") {
                patzyh = patzyh.replace(patlistFath.value + ",", "");
            }

        }
        shzyh = patzyh;
        $('#gridYzshList').jqGrid('setGridParam', {
            postData: {
                patList: patzyh
            }
        }).trigger("reloadGrid");
    }

    var checkTrigger = false;
    var list = new Array();
    var liststu = false;
    var j = 0;
    function gridYzshList(patzyh) {
        var $gridYzshList = $("#gridYzshList");
        $gridYzshList.dataGrid({
            postData: { patList: patzyh },
            url: "/NurseManage/OrderAudit/GetGridJson",
            height: $(window).height() - 140,
            rowNum: 100, //mỗitrangHiển thịghi chépsố
            colModel: [
                { label: 'Y lệnhID', name: 'yzid', align: 'center', width: 30, hidden: true, key: true },
                { label: 'zyh', name: 'zyh', align: 'center', hidden: true },
                { label: 'Tên bệnh nhân', name: 'hzxm', align: 'center', width: 60 },
                { label: 'Y lệnhMục', name: 'xmmc', align: 'center', width: 150 },
                { label: 'Tính chất y lệnh', name: 'yzxzsm', align: 'center', width: 50 },
                {
                    label: 'Y lệnhLoại', name: 'yzlx', align: 'center', width: 50, formatter: function (val) {
                        return $.enum.getDescByValue("EnumYzlx", val);
                    }
                },
                { label: 'Thời gian bắt đầu', name: 'kssj', align: 'center', width: 109, formatter: function (val) { return $.getTime({ date: val }); } },
                {
                    label: 'Nội dung y lệnh', name: 'yzmc', align: 'center', width: 200, formatter: function (val) {
                        if (val != null) {
                            if (val.indexOf("[Dừng]") != -1) {
                                return "<span style='color:red'>[Dừng]</span>" + val.replace("[Dừng]", "")
                            }
                            else
                                return val;
                        }

                        else return "";
                    }
                },
                { label: 'Liều lượng', name: 'yzjl', align: 'center', width: 40, hidden: true },
                { label: 'Cách dùng', name: 'yfmc', align: 'center', width: 30, hidden: true },
                { label: 'Tần suất', name: 'yzpcmc', align: 'center', width: 30 ,hidden:true},
                { label: 'Đơn giá', name: 'dj', align: 'center', width: 50 },
                { label: 'Số lượng', name: 'sl', align: 'center', width: 50, hidden: true },
                { label: 'Số lượng', name: 'slstr', align: 'center', width: 50 },
                { label: 'Số tiền', name: 'je', align: 'center', width: 50 },
                { label: 'Dừng/Hủy bỏThời gian', name: 'tzsj', align: 'center', width: 100, formatter: function (val) { if (val != null) return $.getTime({ date: val }); else return ""; } },
                {
                    label: 'ThuốcNguồn', name: 'yply', align: 'center', width: 50, formatter: function (val) {
                        return $.enum.getDescByValue("EnumYply", val);
                    }
                },
                { label: 'Thuốc gây nghiện - hướng thần', name: 'yztagName', align: 'center', width: 50 },
                 {
                     label: 'Có tính phí không', name: 'isjf', align: 'center', width: 50, formatter: function (val) {
                         return $.enum.getDescByValue("EnumSF", val);
                     }
                 },
                {
                    label: 'Có hay khôngTest da', name: 'ispscs', align: 'center', width: 50, formatter: function (val) {
                        return $.enum.getDescByValue("EnumSF", val);
                    }
                },
                { label: 'Kết quả test da', name: 'psjgms', align: 'center', width: 50, formatter: function (val) { if ((val == "阳性" || val == "Dương tính")) return "<span style='color:red;'>" + val + "</span>"; else if (!!val) return val; else return ""; } },
                { label: 'Người nhập', name: 'Creator', align: 'center', width: 50 },
                { label: 'Mã tính chất y lệnh', name: 'yzxz', align: 'center', hidden: true },
                { label: 'Y lệnhSố nhóm', name: 'zh', align: 'center', width: 70, formatter: function (val) { if (val != null) return val; else return ""; } },
                { label: 'zh1', name: 'zh1', align: 'center', width: 70, hidden: true, formatter: function (val) { if (val != null) return val; else return ""; } }
                , { label: 'ispscs', name: 'ispscs', align: 'center', hidden: true }
                , { label: 'yzh', name: 'yzh', align: 'center', hidden: true }
                , { label: 'iszt', name: 'iszt', align: 'center', hidden: true }
                , { label: 'psjg', name: 'psjg', align: 'center', hidden: true }
                , { label: 'yfztbs', name: 'yfztbs', align: 'center', hidden: true },
                {
                    label: 'Thao tác', name: '', align: 'center', width: 70, formatter: function (val, row, option) {
                        return "<a class='btn btn-default' onclick='PSLR(\"" + option.yzid + "\")'>Test daBổ sung</a>"
                        //if (option.ispscs == "1" && !option.psjg) {
                        //    return "<a class='btn btn-default' onclick='PSLR(\"" + option.yzid + "\")'>Test dabổ sungghi</a>"
                        //}
                        //else
                        //    return "";
                    }
                }
            ],
            pager: "#gridYzshPager",
            sortname: 'zyh,yzlx,zh desc,Px,ispscs desc,kssj Desc',
            viewrecords: true,
            multiselect: true,
            onSelectRow: function (rowIndex, s) {
                if (!checkTrigger) {
                    var len = 0;
                    var rowData = $("#gridYzshList").jqGrid('getRowData', rowIndex);
                    var ids = $("#gridYzshList").jqGrid('getRowData_AllLine');
                    liststu = s; //Trạng thái đồng bộ
                    if (rowData.yzlx == "Xét nghiệm" || rowData.yzlx == "Kiểm tra") {
                        for (var i = 0; i < ids.length; i++) {
                            if (ids[i].zh1 == rowData.zh1 && ids[i].zh1 != "") {
                                if (s == true) {
                                    if (rowIndex != ids[i].yzid) {
                                        list[len] = ids[i].yzid;
                                        len += 1;
                                    }
                                }
                                else {
                                    if (rowIndex != ids[i].yzid) {
                                        list[len] = ids[i].yzid;
                                        len += 1;
                                    }
                                }
                            }
                        }
                    }
                    else {
                        for (var i = 0; i < ids.length; i++) {
                            if (ids[i].zh == rowData.zh && ids[i].zh != "") {
                                if (s == true) {
                                    if (rowIndex != ids[i].yzid) {
                                        list[len] = ids[i].yzid;
                                        len += 1;
                                    }
                                }
                                else {
                                    if (rowIndex != ids[i].yzid) {
                                        list[len] = ids[i].yzid;
                                        len += 1;
                                    }
                                }
                            }
                        }
                    }


                    checkTrigger = true;
                }

                if (list.length > 0) {

                    for (j = j; j < list.length; j++) {
                        if (liststu) //Cùng nhómĐã chọn
                        {
                            j = j + 1;
                            $("#gridYzshList").jqGrid("setSelection", list[j - 1], true);

                        }
                        else { //Cùng nhómHủyĐã chọn
                            //j = j + 1;
                            $("#gridYzshList").jqGrid("setSelection", list[j], false);      //Hủykhôngkích hoạtonselectrow                       
                        }

                    }
                }

                j = 0;
                checkTrigger = false;
                list = new Array();
                liststu = false;
            },
            gridComplete: function () {
                //$("#gview_gridYzshList").attr("style", $(window).width());
                //$(".ui-jqgrid-hdiv,.ui-jqgrid-bdiv").css("width", "100%");
                //$(".ui-jqgrid-pager").css("width", "100%");
                //$("#gbox_gridYzshList").css("width", "100%");
            }
        });
    }
    //làm mớiY lệnh mới
    function RefreshyzshOrder() {
        $('#gridYzshList').jqGrid("clearGridData");
        getOrderAuditList(null, null);
    }
    //Phê duyệthiện tại
    function AuditChecked() {

            //    strYZID.push({ yzid: rowData.yzid, yzxz: rowData.yzxz, yzlxmc: rowData.yzlx, zyh: rowData.zyh, zh1: rowData.zh1, zh: rowData.zh, ispscs: rowData.ispscs, yzh: rowData.yzh });
            //}
            //else if (rowData.ispscs != "1") {
            //    strYZID.push({ yzid: rowData.yzid, yzxz: rowData.yzxz, yzlxmc: rowData.yzlx, zyh: rowData.zyh, zh1: rowData.zh1, zh: rowData.zh, ispscs: rowData.ispscs, yzh: rowData.yzh });
            //}
            //else {
            //    if (tipyzs == "") {
            //        tipyzs += rowData.yzid;
            //    }
            //    else {
            //        tipyzs +=","+ rowData.yzid;
            //    }
            //}
        }
        if (strYZID.length == 0) {
            //if (!!tipyzs) {
            //    AuditTipsPs(tipyzs);
            //}
            return;
        }
        $.najax({
            type: "POST",
            url: "/NurseManage/OrderAudit/submitOrderList",
            data: { orderList: strYZID },
            dataType: "text",
            success: function (ajaxresp) {
                if (ajaxresp == "") {
                    setTimeout(function () {
                        $.modalMsg('Duyệtthất bại', 'error');
                    }, 1000);
                }
                else {
                    setTimeout(function () {
                        if (!!ajaxresp && !!JSON.parse(ajaxresp).data) {
                            AuditTipsPs(JSON.parse(ajaxresp).data);
                        }
                        else {
                            $.modalMsg('Duyệtthành công', 'success');

                        }

                    }, 1000);

                }
                //top.window.MSGQuery();
                getOrderAuditList(null, null);
                //getBqTreeList();
            }
        });
    }
    //Phê duyệtTạm thời  Dài hạn  Tất cả
    function AuditOrders(yzxz) {
        var selPatTrees = $("#PatTreeList").getCheckedNodeObjArray();

        var strYZID = [];
        var selRowIds = jQuery("#gridYzshList").jqGrid("getGridParam", "selarrrow");

        //var selPatTrees = $('#PatTreeList').treeview('getChecked');
        if (selPatTrees == null || selPatTrees.length < 1) {
            $.modalAlert("Vui lòngĐã chọncần duyệtBệnh nhân", 'warning');
            return;
        }

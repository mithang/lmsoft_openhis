                <label><input type="radio" id="radioTreating" name="optionsRadioszxd" class="optionsRadios formClearIgnore" value="1" />Tạm thời</label>
                <a id="Zxd_ExecutionChecked" class="btn btn-primary" onclick="Zxd_ExecutionChecked()">

    ////var jydURL = '@Html.Raw(reportUrl)' + "?tempCode=35&systemCode=CIS";//Phiếu xét nghiệm
    var jydURL = '@Html.Raw(reportUrl)' + "?tempCode=30&systemCode=CIS";//Phiếu xét nghiệm
    var jcdURL = '@Html.Raw(reportUrl)' + "?tempCode=36&systemCode=CIS";//Phiếu kiểm tra
    var kfydURL = '@Html.Raw(reportUrl)' + "?tempCode=37&systemCode=CIS";//Phiếu uống
    var zsdURL = '@Html.Raw(reportUrl)' + "?tempCode=38&systemCode=CIS";//Phiếu tiêm
    var sydURL = '@Html.Raw(reportUrl)' + "?tempCode=39&systemCode=CIS";//Phiếu truyền dịch
    var hldURL = '@Html.Raw(reportUrl)' + "?tempCode=41&systemCode=CIS";//Phiếu điều dưỡng
    var zldURL = '@Html.Raw(reportUrl)' + "?tempCode=42&systemCode=CIS";//Phiếu điều trị
    var zcyyzdURL = '@Html.Raw(reportUrl)' + "?tempCode=44&systemCode=CIS";//Phiếu đơn thuốc Đông y
    var syxskURL = '@Html.Raw(reportUrl)' + "?tempCode=97&systemCode=CIS"; //Thẻ tuần tra truyền dịch
    var lsyzdURL = '@Html.Raw(reportUrl)' + "?tempCode=28&systemCode=CIS";//Y lệnh tạm thời
    var cqyzdURL = '@Html.Raw(reportUrl)' + "?tempCode=27&systemCode=CIS";//Y lệnh dài hạn
    var ypbjURL = '@Html.Raw(reportUrl)' + "?tempCode=70&systemCode=CIS";//Nhãn thuốc (nhãn truyền dịch)
    var whbqURL = '@Html.Raw(reportUrl)' + "?tempCode=1310&systemCode=CIS";//Nhãn khí dung
    var jyztdyURL = '@Html.Raw(reportUrl)' + "?tempCode=32&systemCode=CIS";//Nhãn bộ mẫu xét nghiệm (nhãn ống nghiệm)

    var orgId = '@curOpr.OrganizeId';
    var zxddyzyh = "";

    $(function () {
        $("#printgoon").hide();
        

        $("#btn_zxddysearch").click(function () {
            reloadGrid(zxddyzyh);

        });
        $("#zxdlb").change(function () {
            reloadGrid(zxddyzyh);
        });

        $("input[name='optionsRadioszxd']").click(function () {
            reloadGrid(zxddyzyh);
        });
    })

    function init_zxddy(zyh) {
        if (!zxddyzyh)
            zxddyzyh = zyh;
        getZxxdyTreeList(zxddyzyh);
        gridzxddyList();
    }
    function getZxxdyTreeList(zyhtimes) {
         $("#PatTreeList").treeview({
            height: $(window).height(),
            slimscroll: false,
            showcheck: true,
            url: "/NurseManage/InpatientList/GetPatWardTree?zyzt=" + $('#zyzt').val() + "&keyword=" + $('#keyword').val() + "&checkzyh=" + zxddyzyh,
            oncheckboxclick: function (item, s) {
                getOrderZxddyExecutionList(item, s);
            }
        });
    }

    function getOrderZxddyExecutionList(item, s) {
        var patlist = $("#PatTreeList").getCheckedNodeObjArray();
        var patlistFath = "";

        var patzyh = "";

        //Nút cha đang được chọn hiện tại
        var len = 0;
        var single = 0; //Có phải là nút con đơn lẻ không

        if (item != null && item.Ex1 == "p") {
            patlistFath = item.ChildNodes;
            len = patlistFath.length;
        }
        else if (item != null && item.Ex1 == "c") {
            patlistFath = item;
            len = 1;
            single = 1;
        }

        //Nút đã chọn
        for (var i = 0; i < patlist.length; i++) {
            if (patlist[i].Ex1 == "c") {
                patzyh += patlist[i].value + ",";
            }
        }

        if (s == 1) {
            if (single == 0) {
                for (var j = 0; j < len; j++) {
                    if (patlistFath[j].Ex1 == "c") {
                        patzyh += patlistFath[j].value + ",";
                    }
                }
            }
            else if (patlistFath.Ex1 == "c") {
                patzyh += patlistFath.value;
            }
        }
        else if (s == 0) {
            if (single == 0) {
                for (var j = 0; j < len; j++) {
                    if (patlistFath[j].Ex1 == "c" && patlistFath[j].checkstate == 1) {
                        patzyh = patzyh.replace(patlistFath[j].value + ",", "");
                    }
                }
            }
            else if (patlistFath.Ex1 == "c") {
                patzyh = patzyh.replace(patlistFath.value + ",", "");
            }

        }
        zxddyzyh = patzyh;
        $('#gridzxddyList').jqGrid('setGridParam', {
            postData: {
                zyh: patzyh, zxsj: $('#txt_zxdrq').val(), zxsjend: $('#txt_zxdrqend').val() + ' 23:59:59', zxdlb: $('#zxdlb').val(), yzxz: $('input[name="optionsRadioszxd"]:checked').val()
            }
        }).trigger("reloadGrid");
    }

    function reloadGrid(zyh) {
        var zxsj = $('#txt_zxdrq').val() + " 00:00:00";
        var zxsjend;
        var zxdlb = $('#zxdlb').val();
        var yzxz = $('input[name="optionsRadioszxd"]:checked').val();
        //Đánh giá dựa trên có dài hạn khôngzxsjendgiá trị của
        if (yzxz === "2" || yzxz === "1") {
            zxsjend = $('#txt_zxdrq').val() + " 23:59:59";
        } else {
            zxsjend = $('#txt_zxdrqend').val() + " 23:59:59";
        }

        $('#gridzxddyList').jqGrid('setGridParam', {
            postData: {
                zyh: zyh, zxsj: zxsj, zxsjend: zxsjend, zxdlb: zxdlb, yzxz: yzxz
            }
        }).trigger("reloadGrid");
    }
    //Lắng nghe tất cả/Dài hạn/thay đổi tạm thời
    $('input[name="optionsRadioszxd"]').change(function () {
        // Lấy mục đang được chọn hiện tại radio giá trị của
        var selectedValue = $('input[name="optionsRadioszxd"]:checked').val();

        if (selectedValue === "2" || selectedValue === "1") {
            $('.endTime-show').hide();
        } else {
            $('.endTime-show').show();
        }
    });
    function getOrderListByPatId(patid) {
        $('#gridzxddyList').jqGrid("clearGridData");
        $('#gridzxddyList').newtouchLocalDataGrid(null, orderList);
    }

    var checkTrigger = false;
    var list = new Array();
    var liststu = false;
    var j = 0;
    function gridzxddyList(patzyh) {
        var $gridzxddyList = $("#gridzxddyList");
        $gridzxddyList.dataGrid({
            multiselect: true,
            postData: { zyh: zxddyzyh, zxsj: $('#txt_zxdrq').val(), zxsjend: $('#txt_zxdrqend').val() + ' 23:59:59', zxdlb: $('#zxdlb').val(), yzxz: $('input[name="optionsRadioszxd"]:checked').val() },
            url: "/NurseManage/ExceReportPrint/QueryExecDetailGridJson",
            height: $(window).height() - 185,
            colModel: [
                { label: 'Y lệnhID', name: 'yzId', align: 'center', width: 50, key: true, hidden: true },
                { label: 'Họ tên', name: 'hzxm', align: 'center', width: 50 },
                { label: 'Dài hạn, tạm thời', name: 'clbz', align: 'center', width: 50},
                { label: 'Số y lệnh', name: 'yzh', align: 'center', width: 135 },
                { label: 'Số thứ tự nhận thuốc', name: 'lyxh', align: 'center',width: 60  },
                { label: 'Số nhóm', name: 'zh', align: 'center', width: 50 },
                {
                    label: 'Có tính phí không', name: 'isjf', align: 'center', width: 50, formatter: function (val) {
                        if (val == "0") {
                            return "否";
                        }
                        else {
                            return "是";
                        }
                    }
                },
                { label: 'Y lệnh', name: 'yznr', align: 'center', width: 270 },
                { label: 'Đơn giá', name: 'dj', align: 'center', width: 50, formatter: 'number', formatoptions: { thousandsSeparator: "", decimalPlaces: 4 } },
                { label: 'Số lượng', name: 'sl', align: 'center', width: 50, formatter: 'number', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 } },
                { label: 'Số tiền', name: 'je', align: 'center', width: 50, formatter: 'number', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 } },
                { label: 'Thời gian thực hiện lần cuối', name: 'zxsj', align: 'center', width: 120, formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Người duyệt', name: 'shz', align: 'center', width: 55 },
                { label: 'Người thực hiện', name: 'zxz', align: 'center', width: 55 },
                { label: 'yzlx', name: 'yzlx', align: 'center', hidden: true },
                { label: 'ypyfdm', name: 'ypyfdm', align: 'center', hidden: true },
                { label: 'zyh', name: 'zyh', align: 'center', hidden: true }
            ],
            pager: "#gridzxddyPager",
            rowNum: 100,
            sortname: 'zxsj desc,zh desc,px',
            viewrecords: true,
            multiselect: true,
            onSelectRow: function (rowIndex, s) {
            if (!checkTrigger) {
                var len = 0;
                var rowData = $("#gridzxddyList").jqGrid('getRowData', rowIndex);
                var ids = $("#gridzxddyList").jqGrid('getRowData_AllLine');

                liststu = s; //Trạng thái đồng bộ
                for (var i = 0; i < ids.length; i++) {
                    if ("zld" == $('#zxdlb').val()) {
                        if (ids[i].lyxh == rowData.lyxh && ids[i].lyxh != "") {
                            if (s == true) {
                                if (rowIndex != ids[i].yzId) {
                                    list[len] = ids[i].yzId;
                                    len += 1;
                                }
                            }
                            else {
                                if (rowIndex != ids[i].yzId) {
                                    list[len] = ids[i].yzId;
                                    len += 1;
                                }
                            }
                        }
                    } else {
                        if (ids[i].yzh == rowData.yzh && ids[i].yzh != "") {
                            if (s == true) {
                                if (rowIndex != ids[i].yzId) {
                                    list[len] = ids[i].yzId;
                                    len += 1;
                                }
                            }
                            else {
                                if (rowIndex != ids[i].yzId) {
                                    list[len] = ids[i].yzId;
                                    len += 1;
                                }
                            }
                        }
                    }

                }
                checkTrigger = true;
            }

            if (list.length > 0) {

                for (j = j; j < list.length; j++) {
                    if (liststu) //Chọn cùng nhóm
                    {
                        j = j + 1;
                        $("#gridzxddyList").jqGrid("setSelection", list[j - 1], true);

                    }
                    else { //Hủy chọn cùng nhóm
                        //j = j + 1;
                        $("#gridzxddyList").jqGrid("setSelection", list[j], false);      //Hủy không kích hoạtonselectrow
                    }

                }
            }

            j = 0;
            checkTrigger = false;
            list = new Array();
            liststu = false;
        },
        });
    }
    //Làm mới y lệnh
    function RefreshdyOrder() {
        $('#gridzxddyList').jqGrid("clearGridData");
        getOrderZxddyExecutionList(null, null);
    }

    //In
    function Zxd_ExecutionChecked() {
        //đã chọnid
        var zxdlb = $('#zxdlb').val();
        var selRowIds = jQuery("#gridzxddyList").jqGrid("getGridParam", "selarrrow");
        if (selRowIds == null || selRowIds.length == 0) {
            if (zxdlb != "yzd") {
                $.modalAlert("Vui lòng chọn trước y lệnh cần in", 'warning');
                return;
            }
        }
        var yzxz = $('input[name="optionsRadioszxd"]:checked').val();
        var ksrq = $('#txt_zxdrq').val().substr(0, 10);
        var jsrq = $('#txt_zxdrqend').val().substr(0, 10);
        if (ksrq != jsrq && zxdlb != "yzd" && yzxz == "qb")
        {
            $.modalAlert("Ngày in vui lòng chọn cùng một ngày", 'warning');
            return;
        }
        //Nhãn truyền dịch Nhãn ống nghiệm Tham số in
        var strlyxh = "";
        var yzhstr = "";
        var zhstr = "";
        if (zxdlb == "ypbj" || zxdlb == "jyztdy" || zxdlb =='whbq') { //Nhãn truyền dịch Nhãn ống nghiệm
            for (var i = 0; i < selRowIds.length; i++) {
                var rowData = $("#gridzxddyList").jqGrid('getRowData', selRowIds[i]);
                if (strlyxh.indexOf(rowData.lyxh) < 0) {
                    strlyxh = strlyxh + "," + rowData.lyxh;
                }

                if (yzhstr.indexOf(rowData.yzh) < 0) {
                    yzhstr = yzhstr + "," + rowData.yzh;
                }

                if (zhstr.indexOf(rowData.zh) < 0) {
                    zhstr = zhstr + "," + rowData.zh;
                }
            }
        }
        var printParam = {
            "strlyxh": strlyxh, "yzhstr": yzhstr, "zhstr": zhstr
        }

        if (!zxdlb) {
            $.modalAlert("Vui lòng chọn trước loại phiếu thực hiện", 'warning');
            return;
        }
        else if (zxdlb == "kfyd_yf" || zxdlb == "zsd_yf" || zxdlb == "hld_sfdl" || zxdlb == "zld_yzlx" || zxdlb == "syd_yf" || zxdlb == "zcy_yzlx" || zxdlb == "syxsk" || zxdlb == "ypbj" || zxdlb == "jyztdy" || zxdlb == "whbq") //Uống Phiếu tiêm Phiếu điều dưỡng Phiếu điều trị Phiếu truyền dịch Nhãn truyền dịch Nhãn ống nghiệm
        {
            FlPrint(zxdlb, selRowIds, printParam);
            return;
        }
        else if (zxdlb == "yzd") {
            FlPrint(zxdlb, null, printParam);
            return;
        }
        var printed = [];
        var strlyxh = "";
        var reportServerHOST = '@(ViewBag.ReportServerHOST)';
        for (var i = 0; i < selRowIds.length; i++) {
            var rowData = $("#gridzxddyList").jqGrid('getRowData', selRowIds[i]);
            if ($.inArray(rowData.yzh, printed) < 0) {//Cùng một lô đã in rồi thì không bật lên nữa
                if (zxdlb === "jyd" || zxdlb === "jcd") {
                    //var rpturl = zxdlb === "jyd" ? reportServerHOST + "/ReportServer/Pages/ReportViewer.aspx?%2fNewtouch.Report.1%2f%E8%B4%B5%E5%AE%89%E4%BD%8F%E9%99%A2%E6%A3%80%E9%AA%8C%E7%94%B3%E8%AF%B7%E5%8D%95&rs:Command=Render&rc:Stylesheet=MyStyleSheetBlankPage&yzdh=" + rowData.yzh + "&zyh=" + zyh + "&orgId=" + orgId + "&yzzt=2" : reportServerHOST + "/ReportServer/Pages/ReportViewer.aspx?%2fNewtouch.Report.1%2f%E4%BD%8F%E9%99%A2%E6%A3%80%E6%9F%A5%E7%94%B3%E8%AF%B7%E5%8D%95&rs:Command=Render&rc:Stylesheet=MyStyleSheetBlankPage&yzdh=" + rowData.yzh + "&zyh=" + zyh + "&orgId=" + orgId;
                    var rpturl = zxdlb == "jyd" ? jydURL + "&yzdh=" + rowData.yzh + "&zyh=" + rowData.zyh + "&orgId=" + orgId + "&yzzt=2" : jcdURL + "&yzdh=" + rowData.yzh + "&zyh=" + rowData.zyh + "&orgId=" + orgId;

                    $.ajax({
                        url: '/MedicalRecord/GetBarCodeBycfh',
                        async: false,
                        data: { cfh: rowData.yzh },
                        success: function (r) {
                            var aaa = r.replace(/\+/g, '%2B');
                            rpturl = rpturl + "&barcode=" + aaa;
                            window.open(rpturl, "_blank", "height=500, width=1195,top=100, left=50, toolbar =no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no");
                        }
                    });
                }  else if (zxdlb === "zsz") {//Chứng nhận tiêm
                    window.open(reportServerHOST + "/ReportServer/Pages/ReportViewer.aspx?%2fNewtouch.Report.1%2f%E8%B4%B5%E5%AE%89%E4%BD%8F%E9%99%A2%E6%B3%A8%E5%B0%84%E5%8D%95&rs:Command=Render&rc:Stylesheet=MyStyleSheetBlankPage&yzdh=" + rowData.yzh + "&zyh=" + zxddyzyh + "&orgId=" + orgId, "_blank", "height=500, width=1195,top=100, left=50, toolbar =no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no");
                } else if (zxdlb === "whd") {//Phiếu khí dung
                    window.open(whdURL + "&orgId=" + orgId + "&zyh=" + rowData.zyh + "&yzdh=" + rowData.yzh + "&ksrq=" + ksrq + " 00:00:01&jsrq=" + jsrq +" 23:59:59", "_blank", "height=500, width=1195,top=100, left=50, toolbar =no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no");

                }
                else if (rowData.yzlx == '@((int)EnumYzlx.Yp)' || rowData.yzlx == '@((int)EnumYzlx.Cydy)' || rowData.yzlx == '@((int)EnumYzlx.zcy)') {

                }
                printed.push(rowData.yzh);
            }
            if (strlyxh.indexOf(rowData.lyxh) < 0) {
                strlyxh = strlyxh + "," + rowData.lyxh;
            }
        }
        if (zxdlb === "zld") {
            var clbz = $("input:radio[name=optionsRadioszxd]:checked").val();

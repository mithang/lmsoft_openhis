@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "Trung tâm bệnh nhân trạm y tá-Thực hiện y lệnh";
    //Công tắc thực hiện y lệnh nợ phí
    var ISOpenqfswith = (ViewBag.isqfswith);
    var reportUrl = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("ReportUrl");
    var ReportSystemCode = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("ReportSystemCode");
    var curOpr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}

<div id="linkyzzx" role="tabpanel" class="tab-pane" style="width:100%;margin-right: 5px; border:solid 1px #ddd; margin-top: 3px;">
    <div class="btn-group">
        <table>
            <tr>
                <td class="formTitle"> Ngày thực hiện:</td>
                <td class="formValue" style="width:120px">
                    <input id="txt_zxrq" type="text" class="form-control input-wdatepicker" style="width:70%; height:35%; float:left;"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
                           onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', onpicked: function () { RefreshzxOrder() } })" value="@DateTime.Now.ToString("yyyy-MM-dd ")" />
                </td>
                <td class="formTitle">Thời gian thực hiện:</td>
                <td class="formValue" style="width:120px">
                    <input id="txt_yzxsj" type="text" class="form-control input-wdatepicker" style="width:70%; height:35%; float:left;"
                           onclick="WdatePicker({ dateFmt: 'HH:mm:ss' })"
                           onfocus="WdatePicker({ dateFmt: 'HH:mm:ss' })" value="@DateTime.Now.ToString("HH:mm:ss")" />
                </td>
                @*<td>
                    <input type="button" id="btn_search" class="btn btn-primary" value="Tra cứu y lệnh thực hiện trước" />
                </td>*@
                @*<td>
                    <input type="button" id="btn_BindingFee" class="btn btn-primary" value="Y lệnh phụ thuộc" onclick="BindingFee()" />
                    <input type="button" id="btn_DeleteBind" class="btn btn-primary" value="Hủy phụ thuộc" onclick="DeleteBind()" />
                </td>*@
            </tr>
        </table>
    </div>
    <div class="btn-group">
        <a class="btn btn-primary" onclick="RefreshzxOrder()"><span class="fa fa-refresh"></span></a>
    </div>
    <div class="btn-group">
        <a id="ExecutionChecked" class="btn btn-primary" onclick="ExecutionChecked()">
            <i class="fa fa-pencil-square-o"></i>Thực hiện hiện tại
        </a>
    </div>
    <div class="btn-group">
        <a id="ExecutionTemporary" class="btn btn-primary" onclick="ExecutionOrders(@Html.Raw(((int)EnumYzxz.Ls).ToString()))">
            <i class="fa fa-pencil-square-o"></i>Thực hiện tạm thời
        </a>
    </div>
    <div class="btn-group">
        <a id="ExecutionLong" class="btn btn-primary" onclick="ExecutionOrders(@Html.Raw(((int)EnumYzxz.Cq).ToString()))">
            <i class="fa fa-pencil-square-o"></i>Thực hiện dài hạn
        </a>
    </div>
    <div class="btn-group">
        <a id="ExecutionAll" class="btn btn-primary" onclick="ExecutionOrders(0)">
            <i class="fa fa-pencil-square-o"></i>Thực hiện tất cả
        </a>
    </div>
    <div class="btn-group">
        <input type="button" id="btn_BindingFee" class="btn btn-primary" value="Y lệnh phụ thuộc" onclick="BindingFee()" />
    </div>
    <div class="btn-group">
        <input type="button" id="btn_DeleteBind" class="btn btn-primary" value="Y lệnh phụ thuộc(Hủy bỏ)" onclick="DeleteBind()" />
    </div>
    <div class="gridPanel" style="width: 100%;background-color: #fff;">
        <table id="gridYzzxList"></table>
        <div id="gridYzzxPager"></div>
    </div>

</div>
<script type="text/javascript">
    var yjjzhmsg = "";
    var zxzyh = "";
    var fistzxload = true;
    function init_yzzx(zyh) {
        debugger;
        if (!zxzyh)
            zxzyh = zyh;
        $('#gridYzzxList').jqGrid("clearGridData");
        getYzzxTreeList(zxzyh);
        if (fistzxload) {
            gridTzzxList(zxzyh);
            fistzxload = false;
        } else {
            RefreshzxOrder();
        }
    }
    function getYzzxTreeList(zyhtimes) {
        $("#PatTreeList").treeview({
            height: $(window).height() - 40,
            slimscroll: false,
            showcheck: true,
            url: "/NurseManage/OrderExecution/GetPatWardTree",
            param: { aa: zyhtimes, zxsj: $('#txt_zxrq').val(), keyword: $("#keyword").val() },
            oncheckboxclick: function (item, s) {
                debugger
                getOrderExecutionList(item, s);
            }
        });
    }

    function getOrderExecutionList(item, s) {
        var patlist = $("#PatTreeList").getCheckedNodeObjArray();
        var patlistFath = "";
        yjjzhmsg = "";
        var patzyh = "";
        //Nút cha đang được chọn hiện tại
        var len = 0;
        var single = 0; //Có phải là nút con đơn lẻ không
        if (item != null && item.Ex1 == "p") {
            patlistFath = item.ChildNodes;
            len = patlistFath.length;
        }
        else if (item != null && item.Ex1 == "c") {
            patlistFath = item;
            len = 1;
            single = 1;
        }
        //Nút đã chọn
        for (var i = 0; i < patlist.length; i++) {
            if (patlist[i].Ex1 == "c") {
                patzyh += patlist[i].value + ",";
            }
        }
        if (s == 1) {
            if (single == 0) {
                for (var j = 0; j < len; j++) {
                    if (patlistFath[j].Ex1 == "c") {
                        patzyh += patlistFath[j].value + ",";
                    }
                }
            }
            else if (patlistFath.Ex1 == "c") {
                patzyh += patlistFath.value;
            }
        }
        else if (s == 0) {
            if (single == 0) {
                for (var j = 0; j < len; j++) {
                    if (patlistFath[j].Ex1 == "c" && patlistFath[j].checkstate == 1) {
                        patzyh = patzyh.replace(patlistFath[j].value + ",", "");
                    }
                }
            }
            else if (patlistFath.Ex1 == "c") {
                patzyh = patzyh.replace(patlistFath.value + ",", "");
            }

        }
        zxzyh = patzyh;
        $('#gridYzzxList').jqGrid('setGridParam', {
            postData: {
                patList: patzyh, zxsj: $('#txt_zxrq').val() + " " + $('#txt_yzxsj').val()
            }
        }).trigger("reloadGrid");
        if ("@ISOpenqfswith" == "ON" && patzyh) {
            $.najax({
                type: "POST",
                url: "/PatientList/PatYjjWarn",
                data: { patlist: patzyh },
                dataType: "json",
                async: false,
                success: function (ajaxresp) {
                    UnExecutionList = [];
                    WarmList = [];
                    //$.each(ajaxresp, function () {
                    //    if(this.zhsy<=this.bje &&this.zhsy>0)
                    //    {
                    //        $.modalAlert("Số nhập viện:" + this.zyh + "Số dư tài khoản tạm ứng đã đạt hạn mức,Vui lòng nhắc bệnh nhân nạp tiền", 'warning');
                    //        WarmList.push(this.zyh);
                    //    }
                    //    else if (this.zhsy<=0)//&& this.zhye>0
                    //    {
                    //        yjjzhmsg = "Số nhập viện:" + this.zyh + "Tài khoản tạm ứng đã nợ phí,Không thể phát sinh tính phí,Cần nạp tiền vào tài khoản tạm ứng trước";
                    //        $.modalAlert(yjjzhmsg, 'warning');
                    //        UnExecutionList.push(this.zyh);
                    //    }
                    //    return;
                    //});
                }
            });
        }
    }

    var checkTrigger = false;
    var list = new Array();
    var liststu = false;
    var j = 0;
    function gridTzzxList(patzyh) {
        var $gridYzzxList = $("#gridYzzxList");
        $gridYzzxList.dataGrid({
            multiselect: true,
            postData: { patList: patzyh, zxsj: $('#txt_zxrq').val() },
            url: "/NurseManage/OrderExecution/GetGridJson",
            height: $(window).height() - 140,
            rowNum: 100, //Số bản ghi hiển thị mỗi trang
            colModel: [
                { label: 'Y lệnhID', name: 'yzid', align: 'center', width: 50, key: true, hidden: true },
                { label: 'Số nhập viện', name: 'zyh', align: 'center', width: 50, hidden: true },
                { label: 'Tên bệnh nhân', name: 'hzxm', align: 'center', width: 60 },
                { label: 'Số nhóm y lệnh', name: 'zh', align: 'center', width: 50, formatter: function (val) { if (val != null) return val; else return ""; } },
                { label: 'zh1', name: 'zh1', align: 'center', width: 70, hidden: true, formatter: function (val) { if (val != null) return val; else return ""; } },
                {
                    label: 'Y lệnh phụ thuộc', name: 'isfsyz', align: 'center', width: 60, hidden: true, formatter: function (val, option, row) {
                        debugger
                        if (row.isfsyz != null && row.isfsyz != "") {
                            return " <label style='color:red'>(Y lệnh phụ thuộc)</label>";
                        }
                        else {
                            return "";
                        }
                    }
                },
                { label: 'Hạng mục y lệnh', name: 'xmmc', align: 'left', width: 150 },
                {
                    label: 'Loại y lệnh', name: 'yzlx', align: 'center', width: 60, formatter: function (val, option, row) {
                        return $.enum.getDescByValue("EnumYzlx", row.yzlx);
                    }
                },
                { label: 'Liều lượng', name: 'yzjl', align: 'center', width: 40, hidden: true },
                { label: 'Cách dùng', name: 'yfmc', align: 'center', width: 30, hidden: true },
                { label: 'Tần suất', name: 'yzpcmc', align: 'center', width: 30, hidden: true },
                { label: 'Đơn giá', name: 'dj', align: 'center', width: 50 },
                { label: 'Số lượng', name: 'sl', align: 'center', width: 50, hidden: true },
                { label: 'Số lượng', name: 'slstr', align: 'center', width: 50 },
                { label: 'Số tiền', name: 'je', align: 'center', width: 50 },
                { label: 'yzlx', name: 'yzlx', align: 'center', hidden: true },
                { label: 'isfsyz', name: 'isfsyz', align: 'center', hidden: true },
                { label: 'yzh', name: 'yzh', align: 'center', hidden: true },
                { label: 'isjf', name: 'isjf', align: 'center', hidden: true },
                { label: 'zh1', name: 'zh1', align: 'center', hidden: true },
                { label: 'yfztbs', name: 'yfztbs', align: 'center', hidden: true },
                { label: 'Tính chất y lệnh', name: 'yzxzsm', align: 'center', width: 60 },
                { label: 'Đơn giá hạng mục thu phí', name: 'dj', align: 'center', width: 100, hidden: true },
                {
                    label: 'Y lệnh', name: 'yzmc', align: 'left', width: 260, formatter: function (val, options, rowObject) {debugger
                        if (rowObject["isfsyz"]) {
                            return " <label style='color:red'>(Phụ)</label>" + val;
                        } else {
                            return val;
                        }
                    }
                },
                { label: 'Thời gian bắt đầu', name: 'kssj', align: 'center', width: 110, formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Thời gian thực hiện lần cuối', name: 'zxsj', align: 'center', width: 110, formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Dừng/Thời gian hủy bỏ', name: 'tzsj', align: 'center', width: 110, formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                {
                    label: 'Nguồn thuốc', name: 'yply', align: 'center', width: 50, formatter: function (val) {
                        return $.enum.getDescByValue("EnumYply", val);
                    }
                },
                { label: 'Thuốc gây nghiện, thuốc hướng thần', name: 'yztagName', align: 'center', width: 50 },
                 {
                     label: 'Có tính phí không', name: 'isjf', align: 'center', width: 50, formatter: function (val) {
                         return $.enum.getDescByValue("EnumSF", val);
                     }
                 },
                { label: 'Người duyệt', name: 'shr', align: 'center', width: 70 },
                { label: 'Người thực hiện', name: 'zxr', align: 'center', width: 70, hidden: true },
                { label: 'Mã tính chất y lệnh', name: 'yzxz', align: 'center', width: 70, hidden: true },

            ],
            pager: "#gridYzzxPager",
            //sortname: 'yzh desc,zh,kssj,zyh,yzlx,px',
            sortname: 'yzh desc,kssj,zyh,yzlx,zh,px',
            viewrecords: true,
            multiselect: true,
            onSelectRow: function (rowIndex, s) {
                if (!checkTrigger) {
                    var len = 0;
                    var rowData = $("#gridYzzxList").jqGrid('getRowData', rowIndex);
                    var ids = $("#gridYzzxList").jqGrid('getRowData_AllLine');
                    liststu = s; //Trạng thái đồng bộ
                    if (rowData.zh1 != "") {
                        for (var i = 0; i < ids.length; i++) {
                            if (ids[i].zh1 === rowData.zh1 && ids[i].zh1 !== "") {
                                if (s === true) {
                                    if (rowIndex !== ids[i].yzid) {
                                        list[len] = ids[i].yzid;
                                        len += 1;
                                    }
                                }
                                else {
                                    if (rowIndex !== ids[i].yzid) {
                                        list[len] = ids[i].yzid;
                                        len += 1;
                                    }
                                }
                            }
                        }
                    }
                    else {
                        for (var i = 0; i < ids.length; i++) {
                            if (ids[i].zh === rowData.zh && ids[i].zh !== "") {
                                if (s === true) {
                                    if (rowIndex !== ids[i].yzid) {
                                        list[len] = ids[i].yzid;
                                        len += 1;
                                    }
                                }
                                else {
                                    if (rowIndex !== ids[i].yzid) {
                                        list[len] = ids[i].yzid;
                                        len += 1;
                                    }
                                }
                            }
                        }
                    }

                    checkTrigger = true;
                }

                if (list.length > 0) {

                    for (j; j < list.length; j++) {
                        if (liststu) //Chọn cùng nhóm
                        {
                            j = j + 1;
                            $("#gridYzzxList").jqGrid("setSelection", list[j - 1], true);

                        }
                        else { //Hủy chọn cùng nhóm
                            //j = j + 1;
                            $("#gridYzzxList").jqGrid("setSelection", list[j], false);      //Hủy không kích hoạtonselectrow
                        }

                    }
                }

                j = 0;
                checkTrigger = false;
                list = new Array();
                liststu = false;
            },
            gridComplete: function () {
                //$("#gview_gridYzzxList").attr("style", $(window).width());
                //$(".ui-jqgrid-hdiv,.ui-jqgrid-bdiv").css("width", "100%");
                //$(".ui-jqgrid-pager").css("width", "100%");
                //$("#gbox_gridYzzxList").css("width", "100%");
            }
        });
    }
    //Làm mới y lệnh
    function RefreshzxOrder() {
        //getYzzxTreeList("");
        $('#gridYzzxList').jqGrid("clearGridData");
        getOrderExecutionList(null, null);
    }

    //Thực hiện hiện tại
    var UnExecutionList = [];
    var WarmList = [];
    function ExecutionChecked() {
        var selPatTrees = $("#PatTreeList").getCheckedNodeObjArray();
        if (selPatTrees == null || selPatTrees.length < 1) {
            $.modalAlert("Vui lòng chọn trước bệnh nhân cần thực hiện", 'warning');
            allbtn();
            return;
        }
        var patzyh = "";
        for (var i = 0; i < selPatTrees.length; i++) {
            if (selPatTrees[i].Ex1 === "c") {
                patzyh += selPatTrees[i].value + ",";
                //Tiền tạm ứng vượt hạn mức không thể thực hiện
                //if (UnExecutionList.indexOf(selPatTrees[i].value) != -1) {
                //    $.modalAlert("Tài khoản tạm ứng đã nợ phí,Không thể phát sinh tính phí,Cần nạp tiền vào tài khoản tạm ứng trước", 'warning');
                //    return;
                //}
            }
        }
        if (patzyh === "") {
            $.modalAlert("Vui lòng chọn trước bệnh nhân cần thực hiện", 'warning');
            allbtn();
            return;
        }
        if (yjjzhmsg) {
            $.modalAlert(yjjzhmsg, 'warning');
            allbtn();
            return;
        }
        var strYZID = [];
        var selRowIds = jQuery("#gridYzzxList").jqGrid("getGridParam", "selarrrow");//đã chọnid
        if (selRowIds == null || selRowIds.length === 0) {
            $.modalAlert("Vui lòng chọn trước y lệnh cần thực hiện", 'warning');
            allbtn();
            return;
        }
        for (var i = 0; i < selRowIds.length; i++) {
            var rowData = $("#gridYzzxList").jqGrid('getRowData', selRowIds[i]);
            strYZID.push({
                zyh: rowData.zyh, yzid: rowData.yzid, yzxz: rowData.yzxz, yzlx: rowData.yzlx, dj: rowData.dj,
                zxsj: rowData.zxsj, ypmc: rowData.xmmc, zh: rowData.zh, zh1: rowData.zh1, isjf: rowData.isjf,
                yfztbs: rowData.yfztbs, yply: rowData.yply
            });
        }
        $.loading(true, "Y lệnh đang được thực hiện, vui lòng đợi...");
        var Vzxsj = ctorzxsj();

        $.ajax({
            type: "POST",
            url: "/NurseManage/OrderExecution/submitOrderExecutionList",
            data: { patlist: patzyh, orderList: strYZID, Vzxsj: Vzxsj },
            dataType: "json",
            //async: false,
            success: function (ajaxresp) {
                var rtnobj = JSON.parse(ajaxresp.data);
                if (ajaxresp.state === "success") {
                    $.ajax({
                        type: "POST",
                        url: "/NurseManage/OrderExecution/pushApplicationform",
                        data: { orderList: strYZID },
                        dataType: "json",
                        async: false,
                        success: function (repjson) {

                        }
                    });
                    if (rtnobj.cnt > 0) {

                        $.modalConfirm("Thực hiện thành công, có in không?",
                            function (flag) {
                                if (flag) {
                                    console.log($("#txt_zxrq").val());
                                    var uri = '@reportUrl' + "?tempCode=98" + "&systemCode=" + '@Html.Raw(ReportSystemCode)' + "&yzh=" + "" + "&orgId=" + '@curOpr.OrganizeId' + "&lyxh=" + rtnobj.lyxh + "&zxrq=" + ctorzxsj();
                                    window.open(uri);
                                    //window.open("/ReportManage/Report/PrintYzYpReport?yzh=" + rtnobj.yzh + "&lyxh=" + rtnobj.lyxh + "&zxrq=" + rtnobj.zxrq, "height=500, width=1195,top=100, left=50, toolbar =no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no");
                                }
                            });
                    }
                    $.loading(false);
                    RefreshzxOrder();
                }
                else {
                    $.modalAlert(ajaxresp.message, 'warning');
                    RefreshzxOrder();
                }
                //getOrderExecutionList(null, null);
            }
        });
    }

    function ctorzxsj() {
        var zxrq = $('#txt_zxrq').val();
        var yzzxsj = $('#txt_yzxsj').val();
        return $.getDate({ date: zxrq }) + " " + yzzxsj; //$.getTime().substring(11, 19);
    }
    function ctorzxsj() {
        var zxrq = $('#txt_zxrq').val();
        var yzzxsj = $('#txt_yzxsj').val();
        return $.getDate({ date: zxrq }) + " " + yzzxsj; //$.getTime().substring(11, 19);
    }

    //Thực hiện tạm thời  Dài hạn  Tất cả
    function ExecutionOrders(yzxz) {
        var selPatTrees = $("#PatTreeList").getCheckedNodeObjArray();
        if (selPatTrees == null || selPatTrees.length < 1) {
            $.modalAlert("Vui lòng chọn trước bệnh nhân cần thực hiện", 'warning');
            allbtn();
            return;
        }
        var patzyh = "";
        for (var i = 0; i < selPatTrees.length; i++) {
            if (selPatTrees[i].Ex1 === "c") {
                patzyh += selPatTrees[i].value + ",";
                //Tiền tạm ứng vượt hạn mức không thể thực hiện
                //if (UnExecutionList.indexOf(selPatTrees[i].value) != -1) {
                //    $.modalAlert("Tài khoản tạm ứng đã nợ phí,Không thể phát sinh tính phí,Cần nạp tiền vào tài khoản tạm ứng trước", 'warning');
                //    return;
                //}
            }
        }
        if (patzyh === "") {
            $.modalAlert("Vui lòng chọn trước bệnh nhân cần thực hiện", 'warning');
            allbtn();
            return;
        }
        if (yjjzhmsg) {
            $.modalAlert(yjjzhmsg, 'warning');
            allbtn();
            return;
        }
        var Vzxsj = ctorzxsj();
        $.loading(true, "Y lệnh đang được thực hiện, vui lòng đợi...");
        $.ajax({
            type: "POST",
            url: "/NurseManage/OrderExecution/submitOrderExecutionListbyPat",
            data: { patlist: patzyh, yzxz: yzxz, Vzxsj: Vzxsj },
            dataType: "json",
            success: function (ajaxresp) {
                if (ajaxresp.state === "success") {
                    var rtnobj = JSON.parse(ajaxresp.data);
                    if (rtnobj.cnt > 0) {
                        $.modalConfirm("Thực hiện thành công, có in không?",
                            function (flag) {
                                if (flag) {
                                    var lyxh = jQuery.parseJSON(ajaxresp.data).lyxh;;
                                    window.open("/ReportManage/Report/PrintYzYpReport?yzh=&lyxh=" + lyxh + "&zxrq=" + Vzxsj, "height=500, width=1195,top=100, left=50, toolbar =no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no");
                                }
                            });
                    }
                    $.loading(false);
                    RefreshzxOrder();
                }
                else {
                    $.modalAlert(ajaxresp.message, 'warning');
                    RefreshzxOrder();
                }
                //getOrderExecutionList(null, null);
            }
        });
    }

    //Liên kết chi phí
    function BindingFee() {
        var selPatTrees = $("#PatTreeList").getCheckedNodeObjArray();
        if (selPatTrees == null || selPatTrees.length < 1) {
            let res = confirm('Y lệnh phụ thuộc chưa chọn bệnh nhân Có tiếp tục không?');
            if (res == true) {
                $.modalOpen({
                    id: "BindingFeeForm",
                    title: "Y lệnh phụ thuộc",
                    url: "/NurseManage/OrderExecution/BindingFeeForm?zyh=&yzid=",
                    width: "1000px",
                    height: "700px",
                    btn: ['确认'],
                    callBack: function (iframeId) {
                        RefreshzxOrder();
                        //var Obj = top.frames[iframeId].submitForm();
                        $.modalClose("BindingFeeForm");
                    },
                    cancelCallBack: function (iframeId) {
                        reloadgrid();
                        $.modalClose("BindingFeeForm");
                    }
                });
                return;
            } else {
                return;
            }
        }
        var zyharr = [];
        for (var i = 0; i < selPatTrees.length; i++) {
            if (selPatTrees[i].Ex1 === "c") {
                zyharr.push({ zyh: selPatTrees[i].value });
            }
        }
        if (zyharr.length == 0) {
            $.modalAlert("Vui lòng chọn trước bệnh nhân cần thực hiện", 'warning');
            return;
        }
        if (zyharr.length > 1) {
            $.modalAlert("Liên kết chi phí chỉ được chọn một bệnh nhân", 'warning');
            return;
        }
        var strYZID = [];
        var selRowIds = jQuery("#gridYzzxList").jqGrid("getGridParam", "selarrrow");//đã chọnid
        if (selRowIds == null || selRowIds.length === 0) {
            let res = confirm('Y lệnh phụ thuộc chưa chọn thuốc/Hạng mục Có tiếp tục không?');
            if (res == true) {//Chưa chọn y lệnh hoặc thuốc để thêm y lệnh mới
                $.modalOpen({
                    id: "BindingFeeForm",
                    title: "Y lệnh phụ thuộc",
                    url: "/NurseManage/OrderExecution/BindingFeeForm?zyh=" + zyharr[0].zyh + "&yzid=" + "",
                    width: "1000px",
                    height: "700px",
                    btn: ['确认'],
                    callBack: function (iframeId) {
                        reloadgrid();
                        //var Obj = top.frames[iframeId].submitForm();
                        $.modalClose("BindingFeeForm");
                    },
                    cancelCallBack: function (iframeId) {
                        reloadgrid();
                        $.modalClose("BindingFeeForm");
                    }
                });
            } else {
                return;
            }
        } else {
            for (var i = 0; i < selRowIds.length; i++) {
                var rowData = $("#gridYzzxList").jqGrid('getRowData', selRowIds[i]);
                strYZID.push({
                    zyh: rowData.zyh, yzid: rowData.yzid, yzxz: rowData.yzxz, yzlx: rowData.yzlx, dj: rowData.dj,
                    zxsj: rowData.zxsj, ypmc: rowData.xmmc, zh: rowData.zh, zh1: rowData.zh1, isjf: rowData.isjf,
                    yfztbs: rowData.yfztbs, yply: rowData.yply, brxm: rowData.hzxm, yzh: rowData.yzh
                });
            }
            if (strYZID.length > 1) {
                for (var i = 0; i < strYZID.length; i++) {
                    if (strYZID[i].zh == null || strYZID[i].zh == "") {
                        $.modalAlert("Nhiều y lệnh không thể liên kết", 'warning');
                        return;
                    }
                    for (var j = 0; j < strYZID.length; j++) {
                        if (strYZID[i].zh != strYZID[j].zh) {
                            $.modalAlert("Nhiều y lệnh không thể liên kết", 'warning');
                            return;
                        }
                    }
                }
            }
            $.modalOpen({
                id: "BindingFeeForm",
                title: "Y lệnh phụ thuộc",
                url: "/NurseManage/OrderExecution/BindingFeeForm?zyh=" + zyharr[0].zyh + "&yzid=" + strYZID[0].yzid,
                width: "1000px",
                height: "700px",
                btn: ['确认'],
                callBack: function (iframeId) {
                    //var Obj = top.frames[iframeId].submitForm();
                    reloadgrid();
                    $.modalClose("BindingFeeForm");

                },
                cancelCallBack: function (iframeId) {
                    reloadgrid();
                    $.modalClose("BindingFeeForm");
                }
            });
        }

    }

    function reloadgrid() {
        var selPatTrees = $("#PatTreeList").getCheckedNodeObjArray();
        if (selPatTrees == null || selPatTrees.length < 1) {
            $.modalAlert("Vui lòng chọn trước bệnh nhân cần thực hiện", 'warning');
            return;
        }
        var patzyh = "";
        for (var i = 0; i < selPatTrees.length; i++) {
            if (selPatTrees[i].Ex1 === "c") {
                patzyh += selPatTrees[i].value + ",";
                //Tiền tạm ứng vượt hạn mức không thể thực hiện
                //if (UnExecutionList.indexOf(selPatTrees[i].value) != -1) {
                //    $.modalAlert("Tài khoản tạm ứng đã nợ phí,Không thể phát sinh tính phí,Cần nạp tiền vào tài khoản tạm ứng trước", 'warning');
                //    return;
                //}
            }
        }
        if (patzyh === "") {
            $.modalAlert("Vui lòng chọn trước bệnh nhân cần thực hiện", 'warning');
            allbtn();
            return;
        }
        $('#gridYzzxList').jqGrid('setGridParam', {
            postData: {
                patList: patzyh, zxsj: $('#txt_zxrq').val() + " " + $('#txt_yzxsj').val()
            }
        }).trigger("reloadGrid");
    }

    //Xóa và hủy liên kết y lệnh
    function DeleteBind() {
        var selPatTrees = $("#PatTreeList").getCheckedNodeObjArray();
        if (selPatTrees == null || selPatTrees.length < 1) {
            $.modalAlert("Vui lòng chọn trước bệnh nhân cần liên kết chi phí", 'warning');
            return;
        }
        var zyharr = [];
        for (var i = 0; i < selPatTrees.length; i++) {
            if (selPatTrees[i].Ex1 === "c") {
                zyharr.push({ zyh: selPatTrees[i].value });
            }
        }
        if (zyharr.length == 0) {
            $.modalAlert("Vui lòng chọn trước bệnh nhân", 'warning');
            return;
        }
        if (zyharr.length > 1) {
            $.modalAlert("Hủy y lệnh phụ thuộc chỉ được chọn một bệnh nhân", 'warning');
            return;
        }
        var strYZID = [];
        var selRowIds = jQuery("#gridYzzxList").jqGrid("getGridParam", "selarrrow");//đã chọnid
        if (selRowIds == null || selRowIds.length === 0) {
            $.modalAlert("Vui lòng chọn y lệnh cần hủy hoặc dừng", 'warning');
            return;
        }
        for (var i = 0; i < selRowIds.length; i++) {
            var rowData = $("#gridYzzxList").jqGrid('getRowData', selRowIds[i]);
            if (rowData.isfsyz != null && rowData.isfsyz != "") {
                strYZID.push({
                    zyh: rowData.zyh, yzid: rowData.yzid, yzxz: rowData.yzxz, yzlx: rowData.yzlx, dj: rowData.dj,
                    zxsj: rowData.zxsj, ypmc: rowData.xmmc, zh: rowData.zh, zh1: rowData.zh1, isjf: rowData.isjf,
                    yfztbs: rowData.yfztbs, yply: rowData.yply, brxm: rowData.hzxm, yzh: rowData.yzh, isfsyz: rowData.isfsyz
                });
            }
        }
        if (strYZID.length > 1) {
            for (var i = 0; i < strYZID.length; i++) {
                if (strYZID[i].zh == null || strYZID[i].zh == "") {
                    $.modalAlert("Nhiều y lệnh không thể hủy bỏ/Dừng", 'warning');
                    return;
                }
                for (var j = 0; j < strYZID.length; j++) {
                    if (strYZID[i].zh != strYZID[j].zh) {
                        $.modalAlert("Nhiều y lệnh không thể hủy bỏ/Dừng", 'warning');
                        return;
                    }
                }
            }
        }
        if (strYZID[0].isfsyz != null && strYZID[0].isfsyz != "") {
            $.ajax({
                url: "/NurseManage/OrderExecution/DeleteBind",
                data: { zyh: zyharr[0].zyh, yzid: strYZID[0].yzid, yzxz: strYZID[0].yzxz },
                dataType: "json",
                type: "POST",
                async: false,
                success: function (data) {
                    if (data != null && data.message != "") {
                        $.modalAlert("Hủy bỏ/Dừng thất bại!" + data.message, 'warning');
                        return;
                    }
                    else {
                        $.modalAlert("Hủy bỏ/Dừng thành công!", 'success');
                        reloadgrid();
                        return;
                    }
                }
            });

        }
        else {
            $.modalAlert("Vui lòng chọn y lệnh phụ thuộc để hủy!", 'warning');
            return;
        }
    }

    </script>

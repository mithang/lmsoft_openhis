@model dynamic
@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "Tổn thất/lãiTra cứu";
    Layout = "~/Views/Shared/_Index.cshtml";
    var reportUrl = Newtouch.CIS.Compat.AppConfig.Get("ReportUrl");
    var reportSystemCode = Newtouch.CIS.Compat.AppConfig.Get("ReportSystemCode");

}
<style>
    #btn_search {
        float: left;
        margin-left: 25px;
        margin-right: 10px;
        width: 45px;
        font-weight: bolder;
    }

    #btn_print {
        width: 45px;
        background-color: #fff;
        color: #00a9ea;
        font-weight: bolder;
        float: left;
    }
</style>
<form id="form1">
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading">
            LọcThông tin
        </div>
        <table class="form" style="width:98%;border:0">
            <tr>
                <th class="formTitle">Tình hình thừa thiếu:</th>
                <td style="padding-left:12px;">
                    <div class="btn-group" id="btnLossAndProfitTypeGourp" style="margin-top:0;">
                        <button type="button" id="btnAll" data-keywordtype="All" class="btn active btn-restore">Tất cả</button>
                        <button type="button" id="btnLoss" data-keywordtype="Loss" class="btn btn-default">Báo hỏng</button>
                        <button type="button" id="btnProfit" data-keywordtype="Profit" class="btn btn-default">Báo thừa</button>
                    </div>
                </td>
                <th class="formTitle">Từ khóa:</th>
                <td class="formValue">
                    <input type="text" id="txtINPUTCODE" class="form-control" placeholder="Pinyin/Tên" />
                </td>
                <th class="formTitle">Ngày bắt đầu:</th>
                <td class="formValue">
                    <input type="text" id="txtStartDate" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("yyyy-MM-01 00:00:00")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy HH:mm:ss' })" />
                </td>
                <th class="formTitle">Ngày kết thúc: </th>
                <td class="formValue">
                    <input type="text" id="txtEndDate" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy HH:mm:ss' })" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Nguyên nhân thừa thiếu:</th>
                <td class="formValue">
                    <select class="form-control" id="ddlSYYY">
                        <option value="">Tất cả</option>
                    </select>
                </td>
                <td class="formValue" colspan="6">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary" value="Tra cứu" />
                    <input type="button" id="btn_print" class="btn btn-primary" value="In" />
                </td>
            </tr>
        </table>
    </div>
</form>
<div class="gridPanel" style="margin-top:10px">
    <table id="gridSYXXMXList"></table>
    <div id="gridPager" rel="form1"></div>
</div>

<script>
    $(function () {
        Init();
        GridSyxxmx();
    });

    //Khởi tạo
    function Init() {
        //tảinguyên nhân lãi lỗ
        $("#ddlSYYY").bindSelect({
            url: "/NurseManage/ProfitAndLoss/GetLossProfitReasonListByType",
            id: "Id",
            text: "syyy"
        });
        $('#btnLossAndProfitTypeGourp').on('click', '.btn',
            function () {
                if (!$(this).hasClass('active')) {
                    $(this).siblings('.btn').removeClass('btn-restore').removeClass('active').addClass('btn-default');
                    $(this).removeClass('btn-default').addClass('btn-restore active');
                }
            }
        );
         $("#btn_print").click(function () {
            var syqk = ""; //Tất cả
            if ($('#btnLossAndProfitTypeGourp .btn.active').attr('data-keywordtype') === 'Profit') {
                syqk = 1;  //báo thừa
            } else if ($('#btnLossAndProfitTypeGourp .btn.active').attr('data-keywordtype') === 'Loss') {
                syqk = 0;  //Báo hỏng
            }
            var url = '@reportUrl' + "?tempCode=1328" + "&systemCode=" + '@reportSystemCode' + "&hospitalCode=" + '@ViewBag.OrganizeId' + "&OrganizeId=@ViewBag.OrganizeId&warehouseId=@Constants.DeptCode";
            url += "&sybz=" + syqk;
            url += "&kssj=" + $("#txtStartDate").val();
            url += "&jssj=" + $("#txtEndDate").val();
            url += "&keyWord=" + ($("#txtINPUTCODE").val() === "" ? "" : $("#txtINPUTCODE").val());
            window.open(url);
        });
    }

    //lãi lỗthông tinchi tiết
    function GridSyxxmx() {
        var $gridSyxxmxList = $("#gridSYXXMXList");
        $gridSyxxmxList.dataGrid({
            postData: getSearchPostData(),
            url: "/NurseManage/ProfitAndLoss/SelectLossAndProditInfoList",
            height: $(window).height() - 220,
            caption: "Thừa thiếuChi tiết&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span id='yeCon'>Trang hiện tạiTổng tiền giá lẻ:" + "0.00" + "</span>",
            colModel: [
                {
                    label: "Dấu hiệu thừa thiếu", name: "sybz", width: 55, align: "center",
                    formatter: function (cellvalue) { return cellvalue === "1" ? "Báo thừa" : "Báo hỏng"; }
                },
                { label: 'Nguyên nhân thừa thiếu', name: 'syyy', width: 120, align: 'left' },
                { label: 'Số chứng từ', name: 'djh', width: 160, align: 'left' },
                { label: 'Vật tưTên', name: 'wzmc', width: 120, align: 'left' },
                { label: 'Thừa thiếuSố lượng', name: 'syslStr', width: 55, align: 'right' },//mangĐơn vị
                {
                    label: 'Giá nhập', name: 'jj', width: 70, align: 'right',
                    formatter: function (val) { return val.toFixed(4); }},
                {
                    label: 'Giá bán lẻ', name: 'lsj', width: 70, align: 'right',
                    formatter: function (val) { return val.toFixed(4); } },
                {
                    label: 'Tổng tiền bán lẻ', name: 'ljze', width: 70, align: 'right',
                    formatter: function (val) { return val.toFixed(2); } },
                { label: 'Báo cáoThời gian', name: 'Bgsj', width: 100, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i', newformat: 'Y-m-d H:i' }},
                { label: 'Vật tưLoại', name: 'lb', width: 80, align: 'left' },
                { label: 'Quy cách', name: 'gg', width: 120, align: 'left' },
                { label: 'Nơi sản xuất', name: 'cd', width: 120, align: 'left' },
                { label: 'Số lô', name: 'Ph', width: 80, align: 'left' },
                { label: 'Hạn hiệu lực', name: 'Yxq', width: 70, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Người chịu trách nhiệm', name: 'Zrr', width: 66, align: 'left' },
                { label: 'productId', name: 'productId', hidden: true }
            ],
            multiselect: false,
            pager: "#gridPager",
            sortname: 'bgsj desc',
            viewrecords: true,
            loadComplete: function (data) {
                ComputePjzeAndLjze();//Tính toándấuđềcộttrongcủalôgiátổngmứcvàkhônggiátổngmức
            }
        });
        $("#btn_search").click(function () {
            $gridSyxxmxList.jqGrid('setGridParam',
                {
                    url: "/NurseManage/ProfitAndLoss/SelectLossAndProditInfoList?r=" + Math.random(),
                    postData: getSearchPostData()
                }).trigger('reloadGrid');
        });
    }

    //Điều kiện tìm kiếm
    function getSearchPostData() {
        var startTime = $("#txtStartDate").val();
        var endTime = $("#txtEndDate").val();
        var syyy = $("#ddlSYYY").val();
        var inputCode = $("#txtINPUTCODE").val();
        var syqk = -1; //Tất cả
        if ($('#btnLossAndProfitTypeGourp .btn.active').attr('data-keywordtype') === 'Profit') {
            syqk = 1;  //báo thừa
        } else if ($('#btnLossAndProfitTypeGourp .btn.active').attr('data-keywordtype') === 'Loss') {
            syqk = 0;  //Báo hỏng
        }
        return { startTime: startTime, endTime: endTime, syyy: syyy, inputCode: inputCode, sybz: syqk };
    };

    //Tính toándấuđềcộttrongcủalôgiátổngmứcvàkhônggiátổngmức
    function ComputePjzeAndLjze() {
        var titleLjze = 0;
        var count = $("#gridSYXXMXList").getGridParam('records');
        if (count > 0) {
            var rowIds = $("#gridSYXXMXList").getDataIDs();
            for (var i = 0; i < rowIds.length; i++) {
                var getRowLjze = $("#gridSYXXMXList").getRowData(rowIds[i]).ljze;
                titleLjze = parseFloat(titleLjze) + parseFloat(getRowLjze);
            }
            $("#yeCon").text("Trang hiện tạiTổng tiền giá lẻ:" + titleLjze.toFixed(2) + "");
        }
    }

</script>



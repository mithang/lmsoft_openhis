    //sốGiá trịkiểm tra
    function Validately(rowData, rowid) {
        //if ($("#rkbm").val() === "" || $("#rkbmmc").val() === "") {   //Bỏtráiphảihaiđầutrốngô
        //    $.modalMsg("Vui lòng chọnphát thuốcKhoa phòng", "error", 1000);
        //    return false;
        //}
        if (rowData.ypmc === "") {
            $.modalMsg('ThuốcBắt buộc chọn', 'error', 1000);
            return false;
        }
        //if (rowData.pc === "") {
        //    $.modalMsg('Lôphảichọn', 'error', 1000);
        //    return false;
        //}
        var reg = /^[1-9]\d*$/;//Lớn hơn0 số nguyên
        if (!reg.test(rowData.tsl)) {
            $.modalMsg("Số lượng phải là số nguyên lớn hơn 0!", "warning", 1500);
            return false;
        }
        if ($("#sel_dw_" + rowid).val() === "") {
            $.modalMsg('Vui lòng chọnĐơn vị', 'error', 1000);
            return false;
        }
        var zhyz = Number($("#sel_dw_" + rowid).find("option:selected").attr("data-zhyz"));
        var tsl = Number(rowData.tsl);
        var maxsl = Number(rowData.kykc);
        if (zhyz * tsl > maxsl) {
            $.modalMsg("Số lượng phát thuốc không được vượt quá tổng lượng tồn kho", "error", 1000);
            $("#" + rowid + "_sl").val("");
            return false;
        }
        return true;
    }


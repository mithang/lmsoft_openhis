    //Khởi tạophát thuốcKhoa phòng
    function InitRkbm() {
        //Khu bệnhlớp nổi
        $("#rkbmmc").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 200,
            width: 400,
            url: "/OrderAudit/GetTheLowerKsCodeList",
            ajaxmethod: 'Get',
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = $.trim($("#slksmc").val());
                return reqData;
            },
            colModel: [
                { label: 'Khu bệnhMã', name: 'bqCode', width: 100 },
                { label: 'Khu bệnhTên', name: 'bqmc', width: 220 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#rkbm").val($thistr.attr('data-bqCode'));
                $("#rkbmmc").val($thistr.attr('data-bqmc'));
                return;
            }
        });
        $("#slksmc").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 200,
            width: 400,
            url: "/OrderAudit/GetSysDepartmentList",
            ajaxmethod: 'Get',
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = $.trim($("#slksmc").val());
                return reqData;
            },
            colModel: [
                { label: 'KhoaMã', name: 'Code', width: 100 },
                { label: 'KhoaTên', name: 'Name', width: 220 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#slksbm").val($thistr.attr('data-Code'));
                $("#slksmc").val($thistr.attr('data-Name'));
                return;
            }
        });
    }

    //Lưu
    function newtouch_event_f8() {
        var list = [];
        var validationFailedArr = [];
        $.each($("#gridList").find("input[type=checkbox]:checked"), function () {
            var rowid = $(this).parent().parent().parent().attr("id");
            $("#gridList").saveRow(rowid, null, null, null, function (callbackRowId) { }, null, null);
            var rowData = $("#gridList").jqGrid('getRowData', rowid);
            if (!Validately(rowData, rowid)) {
                validationFailedArr.push(rowid);
                return;
            }
            list.push(AssembleData(rowData, rowid));
        });
        if (validationFailedArr.length > 0) {
            for (var i = 0; i < validationFailedArr.length; i++) {
                $("#gridList").jqGrid('editRow', validationFailedArr[i], false, initInlineFunc);//MởSửachế độ
            }
            return;
        }
        if (list.length === 0) {
            $.modalMsg("Vui lòng tick chọn dữ liệu cần sửa!", 'warning', 1000);
            return;
        }
        var par = new Object();
        par["mx"] = list;
        par["yfbm"] = $("#yfbm").val();
        par["lybm"] = $("#lybm").val();
        par["rkbm"] = $("#rkbm").val();
        par["ksbm"] = $("#slksbm").val();
        par["thyy"] = $("#thyy").val();
        par["djh"] = $("#djh").val();
        par["isdeldj"] = djId;
        $.najax({
            type: "POST",
            url: "/PrepareMedicine/SubmitKsbyth",
            data: par,
            dataType: "json",
            success: function (res) {
                if (res) {
                    newtouch_event_f7();
                    $.modalMsg(res.message, 'success');
                }
            }
        });
    }

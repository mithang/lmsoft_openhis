@using Newtouch.Infrastructure
@{
    ViewBag.Title = "Ward_Application";//Chuẩn bị thuốc khoa
    Layout = "~/Views/Shared/_Index.cshtml";

}

<style>
    .inline {
        width: 80%;
        display: inline;
    }

    .PriceInline {
        width: 70%;
        display: inline;
    }

    #dv-detail table th {
        border: solid 1px #ddd;
        padding: 0;
        vertical-align: middle;
    }

    #dv-detail .ui-jqgrid-labels, #dv-detail .jqgrow .ui-row-ltr {
        height: 30px;
        vertical-align: middle;
    }


    #dv-detail table td {
        border: solid 1px #ddd;
        padding: 0;
        vertical-align: middle;
    }

    #dv-detail input[role=textbox] {
        padding: 2px 2px;
    }

    #gridList .ckbox label {
        margin-top: 24px;
    }
</style>
<form id="form1">
    <div class="panel panel-default" style="margin-bottom:10px;">
        <div class="panel-heading">Phát thuốcThông tin</div>
        <table class="form">
            <tr>
                <th class="formTitle"><span class="required">*</span>Trả lạiKhoa:</th>
                <td class="formValue">
                    <input type="text" id="slksmc" name="slksmc" class="form-control" placeholder="Vui lòng chọnLĩnh thuốcKhoa" />
                    <input type="hidden" id="slksbm" />
                </td>
                <th class="formTitle"><span class="required">*</span>Trả lạiKhu bệnh:</th>
                <td class="formValue">
                    <input type="text" id="rkbmmc" name="rkbmmc" class="form-control" placeholder="Vui lòng chọnLĩnh thuốcKhu bệnh" />
                    <input type="hidden" id="rkbm" />
                </td>
                <th class="formTitle "><span class="required">*</span>Trả lạiNhà thuốc:</th>
                <td class="formValue">
                    <input type="text" id="lybm" name="lybm" data-yfbmCode="" placeholder="Vui lòng chọnMục tiêuNhà thuốc" class="form-control" />
                    <input type="hidden" id="yfbm" />
                </td>
                <th class="formTitle "><span class="required">*</span>Trả lạiSố phiếu:</th>
                <td class="formValue">
                    <input type="text" id="djh" name="djh" class="form-control newtouch_Readonly" />
                </td>
                <th class="formTitle "><span class="required">*</span>Lý do trả lại:</th>
                <td class="formValue">
                    <input type="text" id="thyy" name="thyy" class="form-control" />
                </td>
                <th class="formTitle">
                    <input type="button" id="btn_add" class="btn btn-md btn-primary" value="Thêm" />
                </th>
                <td></td>
            </tr>
        </table>
    </div>
    <div id="dv-detail">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>
@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
    ShowKeyList = new int[] { 7, 8, 9 },
    F7Text = "Đặt lại",
    F8Text = "Lưu",
    F9Text = "Lưu và gửi"
})
<script type="text/javascript">

    var $gridList = $("#gridList");
    var ypcodestr = $.request("ypcode");
    var yfbmstr = $.request("yfbm");
    var yfmcstr = $.request("yfmc");
    var djId = $.request("djId");

    $(function () {
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });
        init();
        InitRkbm();

        GetTargetDept();
        //$("#fyfs").bindSelect({ url: "/DrugStorage/GetCrkfs?crkbz=1", id: "crkfsCode", text: "crkfsmc" });
        $("#btn_add").click(function () {
            $("#gridList").jqGrid("addRowData", undefined, { operate: GetOperatehtml() }, "last");
        });
        InitBackspaceKeyForRkbm();
        if (djId != null && djId != "") {
            $.najax({
                type: "Get",
                url: "/PrepareMedicine/QueryPrepareMedicineReturnbyId",
                data: { djId: djId },
                dataType: "json",
                success: function (ajaxresp) {
                    if (ajaxresp !== null) {
                        $("#slksmc").val(ajaxresp[0].ksmc);
                        $("#slksbm").val(ajaxresp[0].ksbm);
                        $("#rkbmmc").val(ajaxresp[0].bqmc);
                        $("#rkbm").val(ajaxresp[0].bqbm);
                        $("#lybm").val(ajaxresp[0].yfmc);
                        $("#yfbm").val(ajaxresp[0].yfbm);
                        $("#djh").val(ajaxresp[0].djh);
                        $("#thyy").val(ajaxresp[0].thyy);
                    }
                }
            });
            $.najax({
                type: "Get",
                url: "/PrepareMedicine/QueryPrepareMedicineReturnMXbyId",
                data: { djId: djId },
                dataType: "json",
                success: function (ajaxresp) {
                    if (ajaxresp !== null) {
                        for (var i = 0; i < ajaxresp.length; i++) {
                            ajaxresp[i].operate = GetOperatehtml();
                            ajaxresp[i].dlmc = ajaxresp[i].yplb;
                            $("#gridList").jqGrid("addRowData", undefined, ajaxresp[i], "last");
                            $("#jqg" + (i + 1) + "_ykpfj").val(ajaxresp[i].pfj);
                            $("#jqg" + (i + 1) + "_yklsj").val(ajaxresp[i].lsj);
                            $("#jqg" + (i + 1) + "_zje").val(ajaxresp[i].zje);
                            $.ajax({
                                type: "POST",
                                url: "/PrepareMedicine/BydjQueryKykc",
                                data: { ypbm: ajaxresp[i].ypdm, pc: ajaxresp[i].pc, ph: ajaxresp[i].ph, yfbm: $("#yfbm").val() },
                                dataType: "json",
                                async: false,
                                success: function (res) {
                                    if (res != null) {
                                        $("#jqg" + (i + 1) + "_kykc").val(res.kysl);
                                        $("#jqg" + (i + 1) + "_slStr").val(res.kysl);
                                    }
                                }
                            });
                            $("#sel_dw_jqg" + (i + 1)).append('<option value="ckdw" data-zhyz="' + ajaxresp[i].zhyz + '" selected>' + ajaxresp[i].dw + '</option>');
                        }
                    }
                }
            });
        } else {
            $("#gridList").jqGrid("addRowData", undefined, { operate: GetOperatehtml() }, "last");
        }
if (ypcodestr != null && yfbmstr != null && ypcodestr != "" && yfbmstr != "") {
            $("#lybm").val(yfmcstr);
            $("#yfbm").val(yfbmstr);
            $.najax({
                type: "Get",
                url: "/PrepareMedicine/ApplyDrugsSearch",
                data: { ypcodestr: ypcodestr, yfbmstr: yfbmstr },
                dataType: "json",
                success: function (ajaxresp) {
                    if (ajaxresp !== null) {
                        for (var i = 0; i < ajaxresp.length; i++) {
                            ajaxresp[i].operate = GetOperatehtml();
                            $("#gridList").jqGrid("addRowData", undefined, ajaxresp[i], "last");
                            $("#sel_dw_jqg" + (i + 1)).append('<option value="ckdw" data-zhyz="' + ajaxresp[i].zhyz + '" selected>' + ajaxresp[i].dw + '</option>');
                        }
                    }
                }
            });
        }
        else {
            $("#gridList").jqGrid("addRowData", undefined, { operate: GetOperatehtml() }, "last");
        }
    });
    //tạophiếusố phiếu
    function NewDjh() {
        $.ajax({
            type: "Get",
            url: "/OrderAudit/InitDjh",
            data: { djmc: 'KhoaChuẩn bị thuốcTrả lạiphiếu', yfbmCode: $("#yfbm").val(), r: Math.random() },
            dataType: "json",
            success: function (res) {
                if (res.state === "success") {
                    $("#djh").val(res.data);
                }
                else {
                    $.modalAlert(res.message, 'error');
                }
            }
        });
    }
    //theobackspacephímxóasởtất cả
    function InitBackspaceKeyForRkbm() {
        $("#rkbmmc").keydown(function (e) {
            e = window.event ? window.event : e;
            var keyCode = e.which ? e.which : e.keyCode;
            if (keyCode === 8) {//tab
                $("#rkbmmc").val("");
                $("#rkbm").val("");
            }
        });
    }

    //Khởi tạo
    function init() {
        NewDjh();
        InitJqGrid();
        $("#gridList").jqGrid("addRowData", undefined, { operate: GetOperatehtml() }, "last");}

    //Thêmphát thuốcchi tiết
    function addItem(obj) {
        var ids = $("#gridList").getDataIDs();
        var lastRowoid = ids[ids.length - 1];
        var dataRow = {
            operate: GetOperatehtml(),
        };
        $("#gridList").jqGrid("addRowData", undefined, dataRow, "after", lastRowoid);
    }

    //Xóaphát thuốcchi tiết
    function deleteItem(obj) {
        var selRowId = $(obj).parent().parent().attr("id");
        if (!!selRowId) {
            $("#gridList").jqGrid("delRowData", selRowId);
        }
    }

    //LấyThao tácNúthtml
    function GetOperatehtml() {
        return "<i class='fa fa-plus-square-o' style='font-size: large; color: #09a3ea;vertical-align: middle;' onclick='addItem(this);'></i>&nbsp;&nbsp;&nbsp;<i class='fa fa-minus-square-o' style='font-size: large; color: #09a3ea;vertical-align: middle;' onclick='deleteItem(this);'></i>";
    }

    //Khởi tạoXuất khochi tiết
    function InitJqGrid() {
        $gridList.newtouchLocalDataGrid({
            data: [],
            height: $(window).height() - document.getElementById('gridList').offsetTop - 85,
            rownumbers: true,  //CóKhôngHiển thịSố thứ tự
            multiselect: true,
            editurl: "clientArray",  //dòngSửakhông gửi lên máy chủGửiDữ liệu
            unwritten: false,
            colModel: [
                { label: 'Thao tác', name: 'operate', width: 50, align: 'center' },
                { label: '<span class="required">*</span>Tên thuốc', name: 'ypmc', width: 200, align: 'center', editable: true, editwidth: "100%" },
                { label: "ThuốcMã", name: "ypdm", width: 75, align: 'center', editable: true, editwidth: "100%" },
                { label: "ThuốcLoại", name: "dlmc", width: 75, align: 'center', editable: true, editwidth: "100%" },
                { label: 'Lượng tồn kho', name: 'slStr', width: 70, align: 'center', editable: true, editwidth: "100%" },
                { label: '<span class="required">*</span>Số lượng trả', name: 'tsl', width:75, align: 'center', editable: true, editwidth: "100%" },
                { label: '<span class="required">*</span>Đơn vị', name: 'dw', width: 50, align: 'center', formatter: function (cellvalue, options) { return "<select name=\"dw\" id=\"sel_dw_" + options.rowId + "\" rowid=" + options.rowId + " class=\"editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" ></select>"; } },
                { label: 'Quy cách', name: 'gg', width: 55, align: 'center', editable: true, editwidth: "100%" },
                
               { label: 'Hạn hiệu lực', name: 'yxq', width: 50, align: 'center', editable: true, editwidth: "100%" },
                { label: 'Nhà sản xuất', name: 'sccj', width: 200, align: 'center', editable: true, editwidth: "100%" },
                { label: 'Lô', name: 'pc', width: 90, align: 'center', editable: true, editwidth: "100%" },
                { label: 'Số lô', name: 'ph', width: 80, align: 'center', editable: true, editwidth: "100%" },
                //{ label: 'khôngbánĐơn giá', name: 'lsjdjdw', width: 75, align: 'center', editable: true, editwidth: "100%" },
                //{ label: 'tổng bán lẻ', name: 'lsze', width: 80, align: 'center', editable: true, editwidth: "100%" },
                { label: 'pc', name: 'pc', hidden: true },
                { label: 'ph', name: 'ph', hidden: true },
                { label: 'bzs', name: 'bzs', hidden: true, editable: true },
                { label: 'kykc', name: 'kykc', hidden: true, editable: true },
                { label: 'pfj', name: 'pfj', hidden: true, editable: true },
                { label: 'lsj', name: 'lsj', hidden: true, editable: true },
                { label: 'zxdwlsj', name: 'zxdwlsj', hidden: true, editable: true },
                { label: 'ykpfj', name: 'ykpfj', hidden: true, editable: true },
                { label: 'yklsj', name: 'yklsj', hidden: true, editable: true },
                { label: 'zxdwjj', name: 'zxdwjj', hidden: true, editable: true },
                { label: 'bzdwjj', name: 'bzdwjj', hidden: true, editable: true }
            ],
            editinputwidthborder: false,    //CóKhôngcần viền Mặc địnhlàtrue
            editinputborderradius: false,   //CóKhôngcần bo tròn viền Mặc địnhtrue(có bo tròn)
            gridComplete: function () {
                var ids = $("#gridList").getDataIDs();
                var lastRowoid = ids[ids.length - 1];
                EnableInlineEditBox(lastRowoid);
            }
        });
    }

    //lắp rápGửiDữ liệu
    function AssembleData(rowData, rowid) {
        //var zxdwlsj = Number(rowData.zxdwlsj);
        //var ykpfj = Number(rowData.ykpfj);
        //var yklsj = Number(rowData.yklsj);
        //var zhyz = Number($("#sel_dw_" + rowid).find("option:selected").attr("data-zhyz"));
        //var ckdw = $("#sel_dw_" + rowid).find("option:selected").text();
        //var sl = Number(rowData.sl);
        //var bzs = Number(rowData.bzs);
        //var zje = (sl * zhyz * zxdwlsj).toFixed(2);
        //var pfj = (ykpfj / bzs * zhyz).toFixed(4);
        //var lsj = (yklsj / bzs * zhyz).toFixed(4);
        //return {
        //    ypdm: rowData.ypdm,
        //    pfj: pfj,
        //    lsj: lsj,
        //    jj: rowData.bzdwjj,
        //    ykpfj: rowData.ykpfj,
        //    yklsj: rowData.yklsj,
        //    zje: zje,
        //    sl: rowData.sl,
        //    ckbmkc: rowData.kykc,
        //    ckzhyz: $("#sel_dw_" + rowid).find("option:selected").attr("data-zhyz"),
        //    sccj: rowData.sccj,
        //    ckdw: ckdw
        //};
        return {
             Id:'',
         byId:'',
         OrganizeId:'',
            ypdm: rowData.ypdm,
            ypmc: rowData.ypmc,
            yplb: rowData.dlmc,
            tsl: Number(rowData.tsl),
            dw: $("#sel_dw_" + rowid).find("option:selected").text(),
            gg: rowData.gg,
            yxq: rowData.yxq,
         yfbm:$("#yfbm").val(),
            thyy: $("#tyyy").val(),
            sccj: rowData.sccj,
            ph:rowData.ph,
            pc:rowData.pc
        }
    }

    //Bật sửa trong dòng
    function EnableInlineEditBox(rowid) {
        $("#gridList").jqGrid('editRow', rowid, false, initInlineFunc);//MởSửachế độ
        $("#jqg_gridList_" + rowid).trigger("click");
    }

    //Khởi tạo lớp nổi
    function initInlineFunc(rowid) {
        //Một số cột chỉ đọc
        $("#" + rowid + "_dlmc").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_ypdm").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_slStr").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_gg").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_ph").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_yxq").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_sccj").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_lsj").css('background-color', '#f6f7fb').attr('readonly', 'true');
        //$("#" + rowid + "_lsjdjdw").css('background-color', '#f6f7fb').attr('readonly', 'true');
        //$("#" + rowid + "_lsze").css('background-color', '#f6f7fb').attr('readonly', 'true');
        InitSrm(rowid + "_ypmc", rowid)//Lớp nổi thuốc
        InitTabKey("sel_dw_" + rowid, rowid);//Đơn vịtabđổidòng
    }

    //tabphímraphát
    function InitTabKey(id, rowid) {
        $("#" + id).keydown(function (e) {
            e = window.event ? window.event : e;
            var keyCode = e.which ? e.which : e.keyCode;
            if (keyCode === 9) {//tab
                $(this).parent().parent().find(".fa-plus-square-o").trigger("click");
            }
        });
    }
    //LấyMục tiêuNhà thuốc
    function GetTargetDept() {
        $("#lybm").newtouchBatchFloatingSelector({
            height: 200,
            width: 250,
            clickautotrigger: true,
            url: "/OrderAudit/GetTheLowerYfbmCodeList",
            ajaxmethod: 'POST',
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = $.trim($("#lybm").val());
                return reqData;
            },
            caption: "Lĩnh thuốcPhòng ban",
            colModel: [
                { label: 'Nhà thuốcMã', name: 'yfbmCode', widthratio: 50 },
                { label: 'Nhà thuốcTên', name: 'yfbmmc', widthratio: 50 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#lybm").val($thistr.attr('data-yfbmmc'));
                $("#lybm").attr("data-yfbmCode", $thistr.attr('data-yfbmCode'));
                $("#yfbm").val($thistr.attr('data-yfbmCode'));
                return;
            }
        });
    }

    //Khởi tạonhậpmã
    function InitSrm(id, rowid) {
        $("#" + id).newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 350,
            width: 1080,
            url: "/PrepareMedicine/DrugAndStockSearch",
            ajaxmethod: 'Get',
            inputtextcheck: function () {
                //if ($("#yfbm").val() === "" ) {
                //    $.modalMsg("vui lòngởlớp nổitrongchọnNhà thuốc", "error", 1000);
                if ($("#rkbm").val() === "" || $("#rkbmmc").val() === "" || $("#lybm").val() === "" || $("#yfbm").val() === "" || $("#slksmc").val() === "" || $("#slksbm").val() === "") {
                    $.modalMsg("Vui lòng chọn khoa, khu bệnh và nhà thuốc trong lớp nổi", "error", 1000);
                    return false;
                }
                return true;
            },
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = $.trim($("#" + id).val());
                reqData.yfbm = $("#yfbm").val();
                return reqData;
            },
            colModel: [
                { label: 'Loại', name: 'dlmc', width: 60 },
                { label: 'Mã', name: 'ypdm', width: 100 },
                { label: 'Tên', name: 'ypmc', width: 200, align: 'left' },
                { label: 'Quy cách', name: 'gg', width: 110, align: 'left' },
                { label: 'Tồn kho', name: 'slStr', width: 90, align: 'center' },
                { label: 'Đơn giá bán lẻ', name: 'lsjdjdw', width: 120, align: 'center' },//Khoa phòngĐơn vịGiá bán lẻ
                { label: 'Lô', name: 'pc', width: 120, align: 'center' },
                { label: 'Số lô', name: 'ph', width: 120, align: 'center' },
                { label: 'Số phê duyệt', name: 'pzwh', width: 150, align: 'center' },
                { label: 'Nhà sản xuất', name: 'sccj', width: 200, align: 'left' },
                { label: 'pfj', name: 'pfj', hidden: true },//Khoa phòngĐơn vịGiá bán buôn
                { label: 'lsj', name: 'lsj', hidden: true },//Khoa phòngĐơn vịGiá bán lẻ
                { label: 'ykpfj', name: 'ykpfj', hidden: true },
                { label: 'yklsj', name: 'yklsj', hidden: true },
                { label: 'bzs', name: 'bzs', hidden: true },
                { label: 'bzdw', name: 'bzdw', hidden: true },
                { label: 'dw', name: 'dw', hidden: true },//Khoa phòngĐơn vị
                { label: 'zhyz', name: 'zhyz', hidden: true },
                { label: 'zxdw', name: 'zxdw', hidden: true },
                { label: 'zxdwlsj', name: 'zxdwlsj', hidden: true },
                { label: 'kykc', name: 'kykc', hidden: true },
                { label: 'Hạn hiệu lực', name: 'yxq', hidden: true },
                { label: 'ph', name: 'ph', hidden: true },
                { label: 'pc', name: 'pc', hidden: true }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#" + rowid + "_dlmc").val($thistr.attr('data-dlmc'));
                $("#" + rowid + "_ypdm").val($thistr.attr('data-ypdm'));
                $("#" + rowid + "_ypmc").val($thistr.attr('data-ypmc'));
                $("#" + rowid + "_gg").val($thistr.attr('data-gg'));
                $("#" + rowid + "_sccj").val($thistr.attr('data-sccj'));
                $("#" + rowid + "_lsj").val($thistr.attr('data-lsj'));
                //$("#" + rowid + "_lsjdjdw").val($thistr.attr('data-lsjdjdw'));
                $("#" + rowid + "_pfj").val($thistr.attr('data-pfj'));
                $("#" + rowid + "_yklsj").val($thistr.attr('data-yklsj'));
                $("#" + rowid + "_ykpfj").val($thistr.attr('data-ykpfj'));
                $("#" + rowid + "_zhyz").val($thistr.attr('data-zhyz'));
                $("#" + rowid + "_bzs").val($thistr.attr('data-bzs'));
                $("#" + rowid + "_zxdwlsj").val($thistr.attr('data-zxdwlsj'));
                $("#" + rowid + "_slStr").val($thistr.attr('data-slStr'));
                $("#" + rowid + "_kykc").val($thistr.attr('data-kykc'));
                $("#" + rowid + "_yxq").val($thistr.attr('data-yxq'));
                initDw($thistr, rowid);
                $("#" + rowid + "_sl").val("");
                $("#" + rowid + "_pc").val($thistr.attr('data-pc'));
                $("#" + rowid + "_ph").val($thistr.attr('data-ph'));
                //$("#" + rowid + "_lsze").val("");
                $("#sel_dw_" + rowid).trigger("change");
                //InitPc(rowid + "_pc", rowid);
                InitKcCheck(rowid);
                ChangeDw(rowid);
            }
        });
    }

    //Đơn vịcắtđổi
    function ChangeDw(rowid) {
        $("#sel_dw_" + rowid).change(function () {
            if(CheckKc(rowid)) CalculationLsze(rowid);
        });
    }

    //Khởi tạonhậpTồn khoKiểm trasự kiện
    function InitKcCheck(rowid) {
        $("#" + rowid + "_sl").blur(function () {
            if (CheckKc(rowid)) CalculationLsze(rowid);
        });
    }

    //Tồn khoKiểm trasự kiện
    function CheckKc(rowid) {
        var zhyz = Number($("#sel_dw_" + rowid).find("option:selected").attr("data-kykc"));
        var sl = Number($("#" + rowid + "_sl").val());
        var maxsl = Number($("#" + rowid + "_kykc").val());
        if (zhyz * sl > maxsl) {
            $.modalMsg("Số lượng phát thuốc không được vượt quá tổng lượng tồn kho", "error", 1000);
            $("#" + rowid + "_sl").val("");
            return false;
        }
        return true;

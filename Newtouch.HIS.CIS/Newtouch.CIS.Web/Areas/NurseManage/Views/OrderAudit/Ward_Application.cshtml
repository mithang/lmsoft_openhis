    //Xác thực giá trị số
    function Validately(rowData, rowid) {
        if ($("#rkbm").val() === "" || $("#rkbmmc").val() === "") {   //Loại bỏ khoảng trắng hai đầu
            $.modalMsg("Vui lòng chọn bộ phận phát thuốc", "error", 1000);
            return false;
        }
        if (rowData.ypmc === "") {
            $.modalMsg('Thuốc là bắt buộc', 'error', 1000);
            return false;
        }
        if (rowData.pc === "") {
            $.modalMsg('Lô là bắt buộc', 'error', 1000);
            return false;
        }
        var reg = /^[1-9]\d*$/;//lớn hơn0số nguyên của
        if (!reg.test(rowData.sl)) {
            $.modalMsg("Số lượng phải lớn hơn0số nguyên!", "warning", 1500);
            return false;
        }
        if ($("#sel_dw_" + rowid).val() === "") {
            $.modalMsg('Vui lòng chọn đơn vị', 'error', 1000);
            return false;
        }
        var zhyz = Number($("#sel_dw_" + rowid).find("option:selected").attr("data-zhyz"));
        var sl = Number(rowData.sl);
        var maxsl = Number(rowData.kykc);
        if (zhyz * sl > maxsl) {
            $.modalMsg("Số lượng phát thuốc không được vượt quá tổng tồn kho", "error", 1000);
            $("#" + rowid + "_sl").val("");
            return false;
        }
        return true;
    }


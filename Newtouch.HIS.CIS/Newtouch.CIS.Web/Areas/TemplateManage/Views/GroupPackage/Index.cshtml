@using Newtouch.Infrastructure
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script src="@SiteUrl.GetStaticResourceScriptUrl("~/js/validate/jquery.validate.min.js")"></script>
<style>
    #GridListPager_center {
    display:none;
    }
    .ui-pg-div {
        color: #fff;
        background-color: #31b0d5;
        border-color: #269abc;
        padding: 4px 8px;
        line-height: 1.3333333;
        border-radius: 6px;
        font-size: xx-small;
    }
    .contentPanel {
    border:1px solid #ddd
    }
</style>
<div style="float:left;width:22%; border:solid 1px #ddd;">
    <div class="topPanel" >
        <div class="search">
            <table>
                <tr>
                    <td>
                        <div class="input-group">
                            <input id="txt_keyword" type="text" class="form-control" placeholder="Tên bộ mẫu" style="width: 180px;">
                            <span class="input-group-btn">
                                <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                            </span>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div style="width:98%;">
        <table id="gridList" ></table>
    </div>
</div>
<div class="panel panel-default" style="width:75%; float:right; margin-right: 10px; border:solid 1px #ddd;">
    <div class="panel-heading">
        Thông tin bộ mẫu
    </div>
    <div class="panel-body">
        <form id="form1">
            <table class="form">
                <tr>
                    <th class="formTitle"><span class="required">*</span>Tên:</th>
                    <td class="formValue">
                        <input id="ztId" type="text" hidden />
                        <input id="ztmc" name="ztmc" type="text" class="form-control required" value="" placeholder="Vui lòng nhập tên bộ mẫu" />
                    </td>
                    <th class="formTitle">Mô tả:</th>
                    <td class="formValue">
                        <input id="Description" name="Description" type="text" class="form-control" value="" placeholder="Vui lòng nhập mô tả" />
                    </td>
                    <th class="formTitle">Lưu ý:</th>
                    <td class="formValue">
                        <input id="Remark" name="Remark" type="text" class="form-control" value="" placeholder="Vui lòng nhập lưu ý" />
                    </td>
                    <th class="formTitle">Tùy chọn:</th>
                    <td class="formValue" style="padding-top: 1px;">
                        <div class="ckbox">
                            <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Có hiệu lực</label>
                        </div>
                    </td>
                </tr>
            </table>
        </form>
    </div>
    <div style="background-color: #fff;width:85%;padding-left:2px;">
        <table id="xmDetailListGridList"></table>
        <div id="GridListPager"></div>
    </div>
    @Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
    {
        ShowKeyList = new int[] { 3, 4, 6, 8 },
        F3Text = "新增组套",
        F6Text = "删除"
    })
</div>


<script>
    var type = $.request("type")=="jy"?@((int)EnumjyjczutaoLx.jy):$.request("type")=="jc"?@((int)EnumjyjczutaoLx.jc):"";
    var sfdllx = $.request("type") == "jy" ? 'Inspection' : 'Examination';
    var itemlocaldata = new Array();
    $(function () {
        initChargeItemGrid();
        if (type) {
            var $gridList = $("#gridList");
            $gridList.dataGrid({
                url: "/TemplateManage/GroupPackage/SelectGridList?type=" + type,
                height: $(window).height() - 50,
                colModel: [
                    { label: 'ztId', name: 'ztId',hidden:true },
                    { label: 'Tên', name: 'ztmc', width: 90, align: 'left' },
                ],
                sortname: 'ztmc asc',
                //viewrecords: true,
                rowNum: 1000,
                onSelectRow: function (rowid) {
                    var rowdata = $("#gridList").getRowData(rowid);
                    if (!rowdata || !rowdata.ztId) {
                        return;
                    }
                    itemlocaldata = new Array();
                    $.najax({
                        url: "/TemplateManage/GroupPackage/GetGroupPackageDetail",
                        data: { ztId: rowdata.ztId },
						dataType: "json",
						//sortname: "px asc",
                        async: false,
                        success: function (data) {
                            $("#form1").formSerialize(data.ztEntity);   //Gán giá trị văn bản
                            if (data.ztEntity != null) {
                                data.ztEntity.zt == '1' ? $('#zt').prop('checked', true) : $('#zt').prop('checked', false);
                            }
                            $("#xmDetailListGridList").clearGridData();
                            itemlocaldata = data.ztxmList;
                            $.each(itemlocaldata, function () {
                                this.action = getActionStr()
                            });
                            //Mở lại trang này
                            $("#xmDetailListGridList").jqGrid('setGridParam', {
                                datatype: 'local',
                                data: itemlocaldata
                            }).trigger("reloadGrid");
                            CalculateInsPresJYJCAmount($("#xmDetailListGridList"));
                        }
                    });
                }
            });
            $("#btn_search").click(function () {
                $gridList.jqGrid('setGridParam', {
                    postData: { keyword: $("#txt_keyword").val(), type: type },
                }).trigger('reloadGrid'); 
            });
        }

    });
    //jGridKhai báo
    function initChargeItemGrid() {
        $('#xmDetailListGridList').jqGrid({
            datatype: 'local',
            data: itemlocaldata,
            height: 280,
            editurl: "clientArray",  //Chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            unwritten: false,
            rowNum: 1000,
            rowList: [1000],
            pager: "#GridListPager",
            caption: "Tổng số tiền hạng mục thu phí:0.00",
			//caption: "Hạng mục thu phí",
			//sortname: "px asc",
            colModel: [
				{ label: 'Id', name: 'Id', hidden: true },
				//{ label: 'px', name: 'px', hidden: true },
                { label: 'Hạng mục thu phí', name: 'sfxmCode', hidden: true, editable: true },
                { label: 'Tên hạng mục thu phí', name: 'sfxmmc', width: 300, align: 'center', editwidth: '93%', editable: true },
                { label: 'sfdl', name: 'sfdl', hidden: true, align: 'center', editwidth: '93%',editable: true },
                { label: 'Nhóm lớn thu phí', name: 'sfdlmc', width: 120, align: 'center', editwidth: '93%', editable: true },
                { label: 'Đơn giá', name: 'dj', width: 100, align: 'center', editwidth: '93%', editable: true },
                { label: 'Đơn vị', name: 'dw', width: 100, align: 'center', editwidth: '93%', editable: true },
                {
                    label: 'Số lượng', name: 'sl', width: 100, align: 'center', editable: true, editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    CalculateInsPresJYJCAmount();
                                }
                            }
                        ]
                    } },
                @*{ label: 'Số lượng', name: 'sl', width: 100, align: 'center', editable: true, hidden: type ==@((int)EnumjyjczutaoLx.jy)? true : false },*@
                { label: 'Thao tác', name: 'action', width: 50, align: 'center'}
            ],
            gridComplete: function () {
                EnableInlineEditBox();
            }
        });

        //Nút tùy chỉnh
        $('#xmDetailListGridList').navGrid('#GridListPager',
            { edit: false, add: false, del: false, search: false, refresh: false, view: false, position: "left", cloneToTop: false })
            .navButtonAdd('#GridListPager',
            {
                buttonicon: "glyphicon glyphicon-new-window",
                title: "Hạng mục mới",
                caption: "Hạng mục mới",
                position: "last",
                onClickButton: function () {
                    newsfxmData();
                },
			})
		jQuery("#xmDetailListGridList").jqGrid('sortableRows');
    }

      //Y lệnh mới Nút
    function newsfxmData() {
        var dataRow = {
            Id: Math.random().toString() + new Date().getMilliseconds(),
            action: getActionStr(),
            sl:1
        };
        $("#xmDetailListGridList").jqGrid("addRowData", undefined, dataRow, "last");
    }

    function EnableInlineEditBox() {
        var ids = $("#xmDetailListGridList").getDataIDs();
        $.each(ids, function () {
            var rowid = String(this);
            //Mở chế độ chỉnh sửa
            $("#xmDetailListGridList").jqGrid('editRow', rowid, false, initInlineFunc);
        })
    }
    function initInlineFunc(rowid) {
        $("#" + rowid + "_sfdl").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_dj").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_dw").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_sfdlmc").css('background-color', '#f6f7fb').attr('readonly', 'true');
        //Lớp nổi hạng mục
        $("#" + rowid + "_sfxmmc").sfxmFloatingSelector({
            djDecimalPlaces: 4,
            searchType: 'sfxm',
            leftshift: 150,
            ajaxparameters: function ($thisinput) {
                return "mzzybz=1&dllb=2&sfdllx=" + sfdllx + "&keyword=" + $.trim($thisinput.val());
            },
            itemdbclickhandler: function ($thistr) {
                var returnFlag = false;
                var allData = $("#xmDetailListGridList").getRowData_AllLine(undefined, true);
                $.each(allData, function () {
                    if (!returnFlag) {
                        var sfxmCode = this["sfxmCode"];
                        if (sfxmCode && sfxmCode == $thistr.attr('data-sfxmCode')) {
                            returnFlag = true;
                            return;
                        }
                    }
                });
                if (returnFlag) {
                    $.modalAlert("Không được thêm trùng lặp", 'warning');
                    return;
                }
                $("#" + rowid + "_sfxmmc").val($thistr.attr('data-sfxmmc'));
                $("#" + rowid + "_sfxmCode").val($thistr.attr('data-sfxmCode'));
                $("#" + rowid + "_sfdlmc").val($thistr.attr('data-sfdlmc'));
                $("#" + rowid + "_sfdl").val($thistr.attr('data-sfdlCode'));
                $("#" + rowid + "_dj").val($thistr.attr('data-dj'));
                $("#" + rowid + "_dw").val($thistr.attr('data-dw'));
            },
        });
    }

    function getActionStr() {
        return "<i class='fa fa-minus-square-o' style='font-size: large; color: #09a3ea;' onclick='deleteItemRowData($(this).parent().parent().attr(\"id\"));return false;'></i>";
    }
    
    //Xóa chi tiết
    function deleteItemRowData(selRowId, recalc) {
        if (!!selRowId) {
            var Id = $("#xmDetailListGridList").jqGrid('getRowData', selRowId).Id;
            $("#xmDetailListGridList").jqGrid("delRowData", selRowId);
        }
    }

    //validkiểu mở rộng của
    var valOptions = {
        errorPlacement: function (error, element) {
            element.parents('.formValue').addClass('has-error');
        }
    }

    //Lưu
    function newtouch_event_f8()
    {
        //Xác thực thông tin bắt buộc  (Triệu chứng chính, thời gian khởi phát)
        if (!$('#form1').formValid()) {
            $.modalAlert("Thông tin bắt buộc chưa hoàn thiện", 'warning');
            return;
        }

        //Gói
        var ztobj = {
            ztId: $('#ztId').val(),
            ztmc:$('#ztmc').val(),
            Type:type,
            Description:$('#Description').val(),
            Remark: $('#Remark').val(),
            zt: $('#zt').prop('checked') == false ?'0':'1'
        }

        var rowIds = $("#xmDetailListGridList").jqGrid('getDataIDs');
        for (var i = 0; i < rowIds.length; i++) {
            var saveResult = $("#xmDetailListGridList").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);

            if (!saveResult) {
                EnableInlineEditBox();    //Khởi động lại và bật chỉnh sửa Nếu không, lần sauSavethì sẽ trả vềfalse
                return;   //Lưu thất bại, thìreturn
            }
        }

        //Hạng mục
		var ztxmlist = $("#xmDetailListGridList").jqGrid('getRowData_AllLine', null, true);
		//Lấy số thứ tự sắp xếp
		for (var i = 0; i < ztxmlist.length; i++) {
			ztxmlist[i].px = i+1;
		}
        $.each(ztxmlist, function () {    //Loại bỏaction
            delete this.action;   //Loại bỏaction
        })
        $.najax({
            url: "/TemplateManage/GroupPackage/SaveData",
            dataType: "json",
            data: { ztobj: ztobj, ztxmlist: ztxmlist },
            type: "POST",
            success: function (data) {
                $.modalAlert("Lưu thành công", 'warning');
                //Xóa sạch
                newtouch_globalevent_f4();
                $("#xmDetailListGridList").clearGridData();
                //Làm mới
                $("#gridList").jqGrid('setGridParam', {
                    page: 1,
                }).trigger('reloadGrid');
            }
        });
    }

    //Thêm bộ mẫu mới
    function newtouch_event_f3()
    {
        newtouch_globalevent_f4();
        $("#xmDetailListGridList").clearGridData();
    }

    function newtouch_event_f4() {
        $("#xmDetailListGridList").clearGridData();
    }


    //Xóa
    function newtouch_event_f6()
    {
        var ztId = $('#ztId').val();
        if(ztId){
            $.najax({
                url: "/TemplateManage/GroupPackage/DeleteData",
                dataType: "json",
                data: { ztId: ztId },
                type: "POST",
                success: function (data) {
                    $("#gridList").trigger('reloadGrid');
                    $.modalAlert("Xóa thành công", 'warning');
                }
            });
        }
    }
    
    //Tính số tiền phiếu yêu cầu
    function CalculateInsPresJYJCAmount($grid) {
        var totalAmount = 0;
        var allData = $grid.jqGrid('getRowData_AllLine', null, true);
        for (var i = 1; i < allData.length+1; i++) {
            var sl = $('#' + i + '_sl').val();
            var dj = $('#' + i + '_dj').val();
            totalAmount += dj * sl;
        }
        $("#xmDetailListGridList").jqGrid("setCaption", "收费项目总金额：" + "<label style='color:red;'>￥"
            + totalAmount.toFixed(2) + "</label>");   //Đặt lạicaptionGiá trị thuộc tính
    }

</script>


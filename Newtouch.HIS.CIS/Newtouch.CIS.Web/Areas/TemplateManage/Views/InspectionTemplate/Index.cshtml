@using Newtouch.Infrastructure
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/validate/jquery.validate.min.js")"></script>

<div style="float:left;width:17.4%; border:solid 1px #ddd;">
    <table id="gridList"></table>
</div>
<div class="panel panel-default" style="width:80.5%; float:right; margin-right: 10px; border:solid 1px #ddd;">
    <div class="panel-heading">
        MẫuThông tin
    </div>
    <div style="padding:2px;padding-right:20px;">
        <form id="form1">
            <table class="form">
                <tr>
                    <th class="formTitle"><span class="required">*</span>Tên:</th>
                    <td class="formValue">
                        <input id="mbId" type="text" hidden />
                        <input id="mbmc" name="mbmc" type="text" class="form-control required" value="" placeholder="Vui lòng nhập tên mẫu" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Loại lớn:</th>
                    <td class="formValue formDdlSelectorTd">
                        <select id="dlCode" name="dlCode" class="form-control required">
                            <option>==Vui lòng chọn==</option>
                        </select>
                    </td>
                    <th class="formTitle"><span class="required">*</span>Khoa thực hiện:</th>
                    <td class="formValue">
                        <input id="zxks" name="zxks" type="text" class="form-control required" value="" placeholder="Vui lòng nhậpKhoa thực hiện" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Tùy chọn:</th>
                    <td class="formValue" style="padding-top: 1px;">
                        <div class="ckbox">
                            <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Hiệu lực</label>
                        </div>
                    </td>
                    <th class="formTitle"><b>ThêmBộ mẫu:</b></th>
                    <td class="formValue">
                        <input id="txtZutaoSel" type="text" class="form-control" placeholder="Vui lòng nhập tên bộ mẫu hoặc mã" />
                    </td>
                    <td>
                        &nbsp;&nbsp;&nbsp;
                        <i class="fa fa-minus-circle fa-lg" id="btn_Remove" style="cursor:pointer;" onclick="btn_removeItem()"></i>
                    </td>
                </tr>
            </table>
        </form>

        <div style="background-color: #fff; width: 90%; margin:2% 0 0 5%; border:solid 1px #ddd">
            <table id="groupPackageListGridList"></table>
        </div>

    </div>
    @Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
    {
        ShowKeyList = new int[] { 3, 4, 6, 8 },
        F3Text = "Thêm mớiMẫu",
        F6Text = "Xóa"
    })
</div>


<script>
    var type = $.request("type")=="jy"?@((int)EnumjyjcmbLx.jy):$.request("type")=="jc"?@((int)EnumjyjcmbLx.jc):0;
    $(function () {
        if (type) {
            var $gridList = $("#gridList");
            $gridList.dataGrid({
                url: "/TemplateManage/InspectionTemplate/SelectGridList?type=" + type,
                height: $(window).height() - 50,
                colModel: [
                    { label: 'mbId', name: 'mbId', width: 100, align: 'left',hidden:true },
                    { label: 'Tên', name: 'mbmc', width: 100, align: 'left' },
                ],
                sortname: 'mbmc asc',
                viewrecords: true,
                rowNum: 50,
                onSelectRow: function (rowid) {
                    var rowdata = $("#gridList").getRowData(rowid);
                    if (!rowdata || !rowdata.mbId) {
                        return;
                    }
                    $.ajax({
                        url: "/TemplateManage/InspectionTemplate/GetTemplateDetail",
                        data: { mbId: rowdata.mbId },
                        dataType: "json",
                        async: false,
                        success: function (data) {
                            $("#form1").formSerialize(data.mbEntity);   //văn bảnGán giá trị
                            $('#zxks').attr('data-code', data.mbEntity.zxks).val(data.mbEntity.zxksmc);
                            $('#kdks').attr('data-code', data.mbEntity.kdks).val(data.mbEntity.zxksmc);

                            $("#groupPackageListGridList").clearGridData();
                            initGroupPackageGrid(data.mbztList);    //Mục thu phí
                        }
                    });
                }
            });
        }

        //tảiNhóm lớn
        $("#dlCode").bindSelect({
            url: "/TemplateManage/InspectionTemplate/GetCategoryList",
            id: "dlCode",
            text: "dlmc"
        });

        //chỉlàsửađổikiểu
        $("#dlCode").select2({
            minimumResultsForSearch: -1
        });

        initGroupPackageGrid([]);
    })

    //Thực hiệnKhoalớp nổi
    $('#zxks').ksFloatingSelector({
        itemdbclickhandler: function ($this) {
            $('#zxks').attr('data-code', $this.attr('data-Code'))
                      .val($this.attr('data-Name'));
        },
    });
    
    //Bộ mẫulớp nổi
    $('#txtZutaoSel').zutaoFloatingSelector({
        type: type,
        itemdbclickhandler: function ($thistr) {
            var returnFlag = false;
            var allData = $("#groupPackageListGridList").getRowData_AllLine(undefined, true);
            $.each(allData, function () {
                if(!returnFlag){
                    var ztId = this["ztId"];
                    if (ztId && ztId == $thistr.attr('data-ztId')) {
                        returnFlag = true;
                        return;
                    }
                }
            });
            if (returnFlag) {
                $.modalAlert("Không được thêm trùng lặp", 'warning');
                return;
            }
            btn_addItem($thistr);
        }
    });

    //jGridTuyên bố
    function initGroupPackageGrid(data) {
        $('#groupPackageListGridList').newtouchLocalDataGrid({
            height: 280,
            unwritten: false,
            caption: "Bộ mẫuThông tin",
            colModel: [
                { label: 'ztId', name: 'ztId', width: 120, hidden: true, align: 'left' },
                { label: 'Loại', name: 'Type', width: 100, align: 'left',hidden:true },
                { label: 'Tên bộ mẫu', name: 'ztmc', width: 200, align: 'left' },
                { label: 'Mô tả', name: 'Description', width: 120, align: 'left' },
                { label: 'Lưu ý', name: 'Remark', width: 120, align: 'left' }
            ]
        }, data);
    }


    //Thêm hạng mục
    function btn_addItem($thistr) {
        $('#groupPackageListGridList').newtouchLocalDataGrid(null, [{
            ztId: $thistr.attr('data-ztId'),
            ztmc: $thistr.attr('data-ztmc'),
            Type: $thistr.attr('data-Type'),
            Description: $thistr.attr('data-Description'),
            Remark: $thistr.attr('data-Remark')
        }]);
    }

    //XóaMục
    function btn_removeItem() {
        var rowid = $("#groupPackageListGridList").jqGrid("getGridParam", "selrow");
        $('#groupPackageListGridList').jqGrid("delRowData", rowid);
    }


    //validcủakiểu mở rộng
    var valOptions = {
        errorPlacement: function (error, element) {
            element.parents('.formValue').addClass('has-error');
        }
    }

    //Lưu
    function newtouch_event_f8() {
        //bắt buộcthông tinkiểm tra  （chínhbảo、phátbệnhThời gian）
        if (!$('#form1').formValid(valOptions)) {
            $.modalAlert("Thông tin bắt buộc chưa hoàn thiện", 'warning');
            return;
        }

        //mẫu
        var mbobj = {
            mbId: $('#mbId').val(),
            Type: type,
            mbmc: $('#mbmc').val(),
            dlCode: $('#dlCode').val(),
            zxks: $('#zxks').attr('data-Code'),
            zt:$('#zt').val()
        }

        //Bộ mẫu
        var mbztlist = $("#groupPackageListGridList").jqGrid('getRowData_AllLine', null, true);

        $.najax({
            url: "/TemplateManage/InspectionTemplate/SaveData",
            dataType: "json",
            data: { mbobj: mbobj, mbztlist: mbztlist },
            type: "POST",
            success: function (data) {
                $.modalAlert("Lưu thành công", 'warning');
                //Xóa trắng
                newtouch_globalevent_f4();
                $("#groupPackageListGridList").clearGridData();
                //Làm mới
                $("#gridList").jqGrid('setGridParam', {
                    page: 1,
                }).trigger('reloadGrid');
            }
        });
    }
    
    //Thêm mớiBộ mẫu
    function newtouch_event_f3()
    {
        newtouch_globalevent_f4();
        $("#groupPackageListGridList").clearGridData();
    }

    //Xóa
    function newtouch_event_f6()
    {
        var mbId = $('#mbId').val();
        if(mbId){
            $.najax({
                url: "/TemplateManage/InspectionTemplate/DeleteData",
                dataType: "json",
                data: { mbId: mbId},
                type: "POST",
                success: function (data) {
                    $("#gridList").trigger('reloadGrid');
                    $.modalAlert("Xóa thành công", 'warning');
                }
            });
        }
    }

</script>


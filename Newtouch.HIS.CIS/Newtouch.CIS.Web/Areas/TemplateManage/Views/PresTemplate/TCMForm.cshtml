@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "TCMForm";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<script src="@SiteUrl.GetStaticResourceScriptUrl("~/js/validate/jquery.validate.min.js")"></script>
<link href="@SiteUrl.GetStaticResourceScriptUrl("~/Content/css/tcmgridmenu.css", false)" rel="stylesheet" />

<div id="linkzycf" style="width:100%;">
    <table id="gridzycf"></table>
    @Html.Partial("_TemplateFooterAmt")
</div>

<script>
    var mbId = $.request("mbId");
    var localdata = [];
    //var zje = [];
    $(function () {
        gridzycf();

        $("#mblx").bindSelect({
            url: "/MedicalRecord/GetMbqxSelectJson",
        });

        if (mbId) {
            $.najax({
                url: "/TemplateManage/PresTemplate/SelectPresTemplateDetailByMbId",
                dataType: "json",
                data: { mbId: mbId },
                type: "POST",
                success: function (data) {
                    localdata = data.mbmxList;
                    $.each(localdata, function () {
                        this.action = getTCMActionStr()
                    });
                    $("#gridzycf").jqGrid('setGridParam', {
                        datatype: 'local',
                        data: localdata
                    }).trigger("reloadGrid");
                    $('#mblx').val(data.mblx).trigger("change");
                    $('#mbmc').val(data.mbmc);
                }
            });
        }
    });

   
      function Delete() {
        if (mbId == null || mbId == "") {
            $.modalAlert("Thiếu mẫu", "warning");
            return;
        }
        $.najax({
            url: "@Url.Action("Delete")",
            dataType: "json",
            data: { mbId: mbId },
            type: "POST",
            loadingtext: "Dữ liệu gói đang được xóa, vui lòng đợi...",
            success: function (data) {
                $.modalMsg("Xóa thành công", 'success');
                $.currentWindow().$("#beveltabs a[id='current']").trigger('click');
                location.href = "/TemplateManage/PresTemplate/WMForm?mbId=";
            }
        });
    }

    //Danh sách đơn thuốc
    function gridzycf() {
        var $gridzycf = $("#gridzycf");
        $gridzycf.jqGrid({
            datatype: 'local',
            data: localdata,
            height: $(window).height() - 130,
            //altRows: true,//Đổi màu xen kẽ các dòng
            shrinkToFit: true,   //true:Khởi tạo chiều rộng cột theo tỷ lệ false:Sử dụngcolModelchiều rộng đã chỉ định
            autowidth: true,
            rownumbers: false,  //Có hiển thị số thứ tự không
            multiselect: true,
            multiboxonly: false,  //Hộp kiểm true:Không được chọn nhiều
            editurl: "clientArray",  //Chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            unwritten: false,
            colModel: [
                { label: 'mbId', name: 'mbId', width: 120, editwidth: '5%', align: 'center', hidden: true },
                { label: 'ypCode', name: 'ypCode', width: 100, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: '<span class="required">*</span>Tên', name: 'ypmc', width: 110, editwidth: '100%', align: 'center', editable: true, editrules: { required: true } },
                { label: 'cls', name: 'cls', width: 120, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: '<span class="required">*</span>Quy cách', name: 'ypgg', width: 80, editwidth: '100%', align: 'center', editable: true, editrules: { required: true } },
                {
                    label: '<span class="required">*</span>Đơn giá', name: 'dj', width: 60, editwidth: '100%', align: 'center', editable: true, editrules: { required: true }
                },
                {
                    label: '<span class="required">*</span>Liều lượng', name: 'mcjl', width: 48, editwidth: '100%', align: 'center', editable: true, editoptions: {
                        dataEvents: [
                                {
                                    type: 'change',
                                    fn: function (e) {
                                        var cellval = $(this).val();
                                        if(cellval.replace(/(^\s*)|(\s*$)/g, "") == ""){
                                            $.modalAlert("Liều lượng trống, vui lòng xác nhận.", 'warning');
                                            return;
                                        }
                                        if(isNaN(cellval)){
                                            $.modalAlert("Liều lượng: vui lòng nhập số", 'warning');
                                            $(this).val('')
                                            return;
                                        }
                                        var row = $(e.target).closest('tr.jqgrow');
                                        var rowid = row.attr('id');

                                        CalculateTCMEachLineSlANDJe(rowid);
                                    }
                                }
                        ]
                    }, editrules: { required: true }
                },
                {
                    label: '<span class="required">*</span>Đơn vị', name: 'mcjldw', width: 65, editwidth: '50%', align: 'center', editable: true, editrules: { required: true }
                },
                {
                    label: '<span class="required">*</span>Số lượng', name: 'sl', width: 48, editwidth: '100%', align: 'center', editable: true, hidden:true
                },
                { label: '<span class="required">*</span>Đơn vị', name: 'dw', width: 50, editwidth: '100%', align: 'center', editable: true, hidden:true },
                { label: '<span class="required">*</span>Số tiền mỗi thang', name: 'je', width: 100, editwidth: '100%', align: 'center', editable: true, editrules: { required: true } },
                { label: 'Dặn dò', name: 'Remark', width: 160, editwidth: '100%', align: 'center',  editoptions: {
                    dataEvents: [
                                {
                                    type: 'keydown',
                                    fn: function (e) {
                                        if(e.keyCode == 13){
                                            var row = $(e.target).closest('tr.jqgrow');
                                            var rowid = row.attr('id');
                                            var saveResult =$gridzycf.saveRow(rowid, null, null, null, function (callbackRowId) { }, null, null);
                                            if (!saveResult) {
                                                return;
                                            }
                                            addTCMRowData(rowid);   //Thêm một chi tiết
                                        }
                                    }
                                }
                    ]
                }, editable: true
                },
                { name: 'zxks', width: 50, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: 'Thao tác', name: 'action', width: 110, editwidth: '81%', align: 'center' }
            ],
            editinputwidthborder: false,    //Có cần viền không mặc định làtrue
            editinputborderradius: false,   //Có cần bo góc viền không Mặc địnhtrue(có bo góc)
            pager: "#gridzycfPager",
            loadComplete: function () {
                //Đơn thuốc mới
                if (localdata && localdata.length == 0) {
                    newTCMPresData();
                }
                var ids = $("#gridzycf").getDataIDs();
                $.each(ids, function () {
                    var sl = $("#" + this + "_je").val();
                    zje[this] = parseFloat(sl);
                });
            },
            gridComplete: function () {
                var ids = $("#gridzycf").getDataIDs();
                $.each(ids, function () {
                    $gridzycf.jqGrid('editRow', this, true, initTCMInlineFunc);  //editRow: Mở chế độ chỉnh sửa initTCMInlineFunc:Khởi tạo lớp nổi

                    CalculateTCMEachLineSlANDJe(this);
                });
                getgridTotalAmt("gridzycf");
            }
        });
        //Menu cấp hai
        $gridzycf.jqGrid('setGroupHeaders', {
            useColSpanStyle: true,
            groupHeaders: [
            {
                startColumnName: 'ypmc',
                numberOfColumns: 4,
                titleText: 'Thông tin cơ bản'
            }, {
                startColumnName: 'mcjl',
                numberOfColumns: 2,
                titleText: 'Liều lượng mỗi lần'
            }, {
                startColumnName: 'yf',
                numberOfColumns: 5,
                titleText: 'Cách dùng thuốc'
            }, {
                startColumnName: 'sl',
                numberOfColumns: 2,
                titleText: 'Tổng số lượng thuốc'
            }, ]
        });
    }

    //Cùng một số nhóm cần khớp cách dùng, tần suất, số ngày, ngày kết thúc
    function MatchTCMZuhaoInfo(rowid) {
        var currRowZh = $("#" + rowid + "_zh").val();
        if (currRowZh) {
            var allData = $("#gridzycf").jqGrid('getRowData_AllLine', null, true);
            $.each(allData, function () {
                var objId = $(this.zh).attr('rowid');
                var objzh = $("#" + objId + "_zh").val();

                if (objzh == currRowZh && objId != rowid) {
                    var objyfmc = $("#" + objId + "_yfmc").val();
                    var objyfCode = $("#" + objId + "_yfCode").val();
                    var objpcmc = $("#" + objId + "_pcmc").val();
                    var objpcCode = $("#" + objId + "_pcCode").val();

                    $("#" + rowid + "_yfmc").val(objyfmc)        //Cách dùng
                    $("#" + rowid + "_yfCode").val(objyfCode)
                    $("#" + rowid + "_pcmc").val(objpcmc)        //Tần suất
                    $("#" + rowid + "_pcCode").val(objpcCode)
                }
            });
        }
    }

    //Khởi tạo Lớp nổi
    function initTCMInlineFunc(rowid) {
        //Một số cột chỉ đọc
        $("#" + rowid + "_dj").css('background-color','#f6f7fb').attr('readonly','true');
        $("#" + rowid + "_ypgg").css('background-color','#f6f7fb').attr('readonly','true');
        $("#" + rowid + "_dw").css('background-color','#f6f7fb').attr('readonly','true');
        $("#" + rowid + "_je").css('background-color','#f6f7fb').attr('readonly','true');

        //Lớp nổi thuốc
        $("#" + rowid + "_ypmc").sfxmFloatingSelector({
            djDecimalPlaces: 4,
            //leftshift:150,
            searchType: 'yp.kc',
            ajaxparameters : function($thisinput) {
                return "mzzybz=1&dllb=1&sfdllx=TCM&keyword=" + $.trim($thisinput.val());
            },
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_ypmc").val($this.attr('data-sfxmmc'));
                $("#" + rowid + "_ypCode").val($this.attr('data-sfxmCode'));
                $("#" + rowid + "_ypgg").val($this.attr('data-gg'));
                $("#" + rowid + "_dj").val($this.attr('data-dj'));
                $("#" + rowid + "_dw").val($this.attr('data-dw'));
                $("#" + rowid + "_cls").val($this.attr('data-cls'));
                $("#" + rowid + "_zxks").val($this.attr('data-yfbmCode'));
                $("#" + rowid + "_mcjldw").val($this.attr('data-jldw'));

                CalculateTCMEachLineSlANDJe(rowid);   //Tính số tiền trong chi tiết và số tiền đơn thuốc
            }
        });

        //Lớp nổi tần suất
        $("#" + rowid + "_pcmc").pcFloatingSelector({
            showtext: 'yzpcmc',
            attrcols: ['yzpcmc', 'yzpcCode', 'zxcs', 'zxzq', 'zxzqdw'],
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_pcmc").val($this.attr('data-yzpcmc'))
                $("#" + rowid + "_pcCode").val($this.attr('data-yzpcCode'))
            },
        });

        //Lớp nổi cách dùng
        $("#" + rowid + "_yfmc").yfFloatingSelector({
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_yfmc").val($this.attr('data-yfmc'));
                $("#" + rowid + "_yfCode").val($this.attr('data-yfCode'));
            }
        });

        //Lớp nổi dặn dò
        $("#" + rowid + "_Remark").ztFloatingSelector({
            height:100,
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_Remark").val($this.attr('data-ztmc'));
            },
        });
    }

    //Tính số tiền trong chi tiết và số tiền đơn thuốc
    function CalculateTCMEachLineSlANDJe(rowid) {
        var currRowZe = 0.00;

        var mcjl = $('#' + rowid + '_mcjl').val();     //Liều lượng
        $('#' + rowid + '_sl').val(mcjl, 2);

        var currRowSl = $('#' + rowid + '_sl').val(); //Số lượng
        var currRowDj = $('#' + rowid + '_dj').val();

        //Điều kiện: đơn vị thuốc Đông y và đơn vị liều lượng phải được bảo trì nhất quán
        if (currRowDj && parseFloat(currRowSl) > 0) {
            //Đơn giá Số lượng không trống
            currRowZe = roundingBy4she6ru5chengshuang(parseFloat(currRowDj) * parseFloat(currRowSl),2);
        }

        $('#' + rowid + '_je').val(currRowZe);
        if (parseFloat(currRowZe) > 0) {
            zje[rowid] = currRowZe;
            getgridTotalAmt("gridzycf");
        }
    }

    //Đơn thuốc mới Nút
    function newTCMPresData() {
        var dataRow = {
            zh: '',
            ypmc: '',
            ypgg: '',
            dj: '',
            tieshu: '',
            mcjl: '',
            mcjldw: '',
            yf: '',
            pc: '',
            sl: '',
            dw: '',
            action: getTCMActionStr()
        };
        $("#gridzycf").jqGrid("addRowData", undefined, dataRow, "first");

    }

    //Thêm chi tiết
    function addTCMRowData(selRowId) {
        var dataRow = {
            ypmc: '',
            ypgg: '',
            dj: '',
            mcjl: '',
            mcjldw: '',
            sl: '',
            dw: '',
            action: getTCMActionStr()
        };
        $("#gridzycf").jqGrid("addRowData", undefined, dataRow, "first");
    }

    //Xóa chi tiết
    function deleteTCMRowData(selRowId) {
        if (!!selRowId) {
            $("#gridzycf").jqGrid("delRowData", selRowId);
        }
    }

    function getTCMActionStr() {
        return "<input class='btn btn-default btn-md btn_add' type='button' value='Add' onclick='addTCMRowData($(this).parent().parent().attr(\"id\"))'/><input class='btn btn-default btn-md btn_del' type='button' value='Delete' onclick='deleteTCMRowData($(this).parent().parent().attr(\"id\"))'/>";
    }

    //validkiểu mở rộng của
    var valOptions = {
        errorPlacement: function (error, element) {
            element.parents('.formValue').addClass('has-error');
        }
    }

    //Lưu
    function Save() {
        //Xác thực thông tin bắt buộc  (Triệu chứng chính, thời gian khởi phát)
        if (!$('#form1').formValid(valOptions)) {
            $.modalAlert("Thông tin bắt buộc chưa hoàn thiện", 'warning');
            return;
        }
        //Lấy tất cả các dòngId，duyệt để khung chỉnh sửa ở trạng thái lưu
        var rowIds = $("#gridzycf").jqGrid('getDataIDs');
        for (var i = 0; i < rowIds.length; i++) {
            var saveResult = $("#gridzycf").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);

            if (!saveResult) {
                return;   //Lưu thất bại, thìreturn
            }
        }
        var gridzycfData = $("#gridzycf").jqGrid('getRowData_AllLine', null, true);
        if(!gridzycfData || gridzycfData.length==0){
            $.modalAlert("Chi tiết mẫu không được trống", 'warning');
            return;
        }

        var gridzycfData = $("#gridzycf").jqGrid('getRowData_AllLine', null, true);
        $.each(gridzycfData, function () {    //Loại bỏaction
            for (var i = 0; i < $(this).length; i++) {
                delete $(this)[i].action;
            }
        });

        //Bảng mẫu
        var mbObj = {
            mbId: mbId,
            mblx: $('#mblx').val(),//$.currentWindow().$('#current').attr('data-type'),
            //ksCode: '',   //Theotype Gán giá trị ở phía máy chủ
            cflx: @Html.Raw(((int)EnumCflx.TCMPres).ToString()),
            mbmc: $('#mbmc').val(),
            //ysgh: ''    //Theotype Gán giá trị ở phía máy chủ
        }

        //Lưu dữ liệu
        $.najax({
            url: "/TemplateManage/PresTemplate/SaveData",
            dataType: "json",
            data: { mbObj: mbObj, mxList: gridzycfData },
            type: "POST",
            success: function (data) {
                $.modalAlert("Lưu thành công", 'warning');
                //window.$("#gridzycf").clearGridData();
                //newTCMPresData();
                //$('#mbmc').val('');
                if(!mbId && data.data){
                    mbId = data.data;
                    $.currentWindow().expandCflx = @Html.Raw(((int)EnumCflx.TCMPres).ToString());
                }
                $.currentWindow().$("#beveltabs a[id='current']").trigger('click');
                location.href = "/TemplateManage/PresTemplate/TCMForm?mbId=" + mbId;
            }
        });
    }
</script>

@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script src="@SiteUrl.GetStaticResourceScriptUrl("~/js/validate/jquery.validate.min.js")"></script>
<script src="@SiteUrl.GetStaticResourceScriptUrl("~/js/wdtree/tree.js")"></script>
<link href="@SiteUrl.GetStaticResourceScriptUrl("~/js/wdtree/tree.css")" rel="stylesheet" />
<style>
    #form1 > .form .formValue input.form-control {
        border-top: 0px;
        border-left: 0px;
        border-right: 0px;
        border-radius: 0px !important;
    }

    #tablezd .formTitle {
        width: 27px;
        padding-right: 15px;
    }

    #tablezd .formValue {
        position: relative;
    }

    .fa.fa-times {
        position: absolute;
        right: 5px;
        top: 13px;
    }
</style>
<div style="float:left; width:17.4%; height:98%; border:solid 1px #ddd;">
    <div class="ui-layout-west">
        <ul id="beveltabs">
            <li><a href="#" name="#personal" data-type=@Html.Raw(((int)EnumCfMbLx.personal).ToString())>Cá nhân</a></li>
            <li><a href="#" name="#department" data-type=@Html.Raw(((int)EnumCfMbLx.department).ToString())>Khoa</a></li>
            <li><a href="#" name="#hospital" data-type=@Html.Raw(((int)EnumCfMbLx.hospital).ToString())>Toàn viện</a></li>
        </ul>
        <div id="treeContent">
            <div id="personal">
                <div id="personalTree"></div>
            </div>
            <div id="department">
                <div id="departmentTree"></div>
            </div>
            <div id="hospital">
                <div id="hospitalTree"></div>
            </div>
        </div>
    </div>
    <input type="text" id="mbId" hidden />
</div>
<div style="width:80.5%; float:right; margin-right: 10px; border:solid 1px #ddd; height:100%;">
    <div class="panel panel-default">
        <div class="panel-heading">
            Chi tiết bệnh án
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <form id="form1">
                <table class="form">
                    <tr>
                        <th class="formTitle">Triệu chứng chính:</th>
                        <td class="formValue" colspan="4">
                            <input type="text" id="zs" name="zs" class="form-control activeValue focusInput required" />
                            <i class="fa fa-times" aria-hidden="true" hidden></i>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Bệnh sử hiện tại:</th>
                        <td class="formValue" colspan="4">
                            <textarea id="xbs" name="xbs" class="form-control activeValue focusInput" style="height:35px;"></textarea>
                            <i class="fa fa-times" aria-hidden="true" hidden></i>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Tiền sử:</th>
                        <td class="formValue" colspan="4">
                            <textarea id="jws" name="jws" class="form-control activeValue focusInput" style="height:35px;"></textarea>
                            <i class="fa fa-times" aria-hidden="true" hidden></i>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Khám thực thể:</th>
                        <td class="formValue" colspan="4">
                            <textarea id="ct" name="ct" class="form-control activeValue focusInput" style="height:35px;"></textarea>
                            <i class="fa fa-times" aria-hidden="true" hidden></i>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Xử lý:</th>
                        <td class="formValue" colspan="4">
                            <textarea id="clfa" name="clfa" class="form-control activeValue focusInput" style="height:35px;"></textarea>
                            <i class="fa fa-times" aria-hidden="true" hidden></i>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Chẩn đoán Tây y:</th>
                        <td class="formValue" colspan="4">
                            <table id="tablexyzd">
                                <tr>
                                    <th class="formTitle">主</th>
                                    <td class="formValue">
                                        <input type="checkbox" id="chk1" class="chkValue" style="float:left;" /><label style="float:left;margin-top:3px;">Nghi ngờ</label>
                                        <input type="text" id="zd1" name="zd1" class="form-control activeValue focusInput zdText" style="width:70%;" placeholder="" />
                                        <i class="fa fa-times" aria-hidden="true" hidden></i>
                                    </td>
                                    <td>
                                        <i id="zdCircle" class="fa fa-plus-circle plusToggleCircle" aria-hidden="true" style="margin-left: 10px; color: #6ff3ad; font-size: large;"></i>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Chẩn đoán Đông y:</th>
                        <td class="formValue" colspan="4">
                            <table id="tablezyzd">
                                <tr>
                                    <th class="formTitle">主</th>
                                    <td class="formValue">
                                        <input type="checkbox" id="chk2" class="chkValue" style="float:left;" /><label style="float:left;margin-top:3px;">Nghi ngờ</label>
                                        <input type="text" id="zd2" name="zd2" class="form-control activeValue focusInput zdText" style="width:70%;" />
                                        <i class="fa fa-times" aria-hidden="true" hidden></i>
                                    </td>
                                    <th class="formTitle">Hội chứng</th>
                                    <td class="formValue">
                                        <input type="text" id="zh1" name="zh1" class="form-control activeValue focusInput zhText" />
                                        <i class="fa fa-times" aria-hidden="true" hidden></i>
                                    </td>
                                    <td>
                                        <i id="zdCircle" class="fa fa-plus-circle plusToggleCircle" aria-hidden="true" style="margin-left: 10px; color: #6ff3ad; font-size: large;"></i>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Bộ mẫu mẫu đơn thuốc:</th>
                        <td class="formValue">
                            <input id="txtZutaoSel" type="text" class="form-control" placeholder="Vui lòng nhập tên bộ mẫu hoặc mã" />
                        </td>
                        <td>
                            &nbsp;&nbsp;&nbsp;
                            <i class="fa fa-minus-circle fa-lg" id="btn_Remove" style="cursor:pointer;" onclick="btn_removeItem()"></i>
                            Loại đơn thuốc: 
                            <select id="cflx" class="vitalsignschange">
                                <option value="0">=请选择=</option>
                                <option value="1"> Đơn thuốc Tây y</option>
                                <option value="2"> Đơn thuốc Đông y</option>
                                <option value="3"> Đơn thuốc phục hồi chức năng</option>
                                <option value="6"> Đơn thuốc hạng mục thông thường</option>
                                <option value="4"> Đơn thuốc xét nghiệm</option>
                                <option value="5"> Đơn thuốc kiểm tra</option>
                            </select>
                        </td>
                        <td ></td>
                        <td></td>
                    </tr>
                </table>
            </form>
            <div style="background-color: #fff; width: 90%; margin-left:5px; border:solid 1px #ddd">
                <table id="groupPackageListGridList"></table>
            </div>
        </div>
       
    </div>
    <form id="form2">
        <table class="form" style="margin-top:2px;">
            <tr>
                <th class="formTitle"><span class="required">*</span>Tên mẫu: </th>
                <td class="formValue">
                    <input id="mbmc" name="mbmc" type="text" class="form-control required" />
                </td>
                <td colspan="3"></td>
            </tr>
        </table>
    </form>
    

    @Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 3, 4, 6, 8 },
    F3Text = "新增模板",
    F6Text = "删除"
})
</div>

<link href="" rel="stylesheet" />
<link href="@SiteUrl.GetStaticResourceScriptUrl("~/Content/css/beveltabs.css", false)" rel="stylesheet" />
<script src="@SiteUrl.GetStaticResourceScriptUrl("~/Content/js/beveltabs.js", false)"></script>

<script type="text/javascript">
    var ybnhlx = null;
    $(function ($) {
        initGroupPackageGrid([]);
        $("#beveltabs a:first").trigger('click');
    });

    $("#beveltabs a").on("click", function (e) {
        
        $($(this).attr('name') + "Tree").treeview({
            height: $(window).height() - 100,
            slimscroll: false,
            url: "/MRecordTemplate/GetTreeList?mblx=" + $('#current').attr('data-type'),
            onnodeclick: function (item) {
                if (!item.id) {
                    return;
                }
                $('#mbId').val(item.id);
                $.najax({
                    url: "/TemplateManage/MRecordTemplate/SelectTemplateDetailByMbId",
                    dataType: "json",
                    data: { mbId: item.id },
                    type: "POST",
                    success: function (ajaxresp) {
                        $('#mbmc').val(ajaxresp.mbmc);
                        $('#form1').formSerialize(ajaxresp);

                        $('#tablexyzd .minusToggleCircle').trigger('click');  //Khôi phục trước

                        $('#tablezyzd .minusToggleCircle').trigger('click');  //Khôi phục trước

                        //3.Điền chẩn đoán
                        if (ajaxresp.xyzdList && ajaxresp.xyzdList.length && ajaxresp.xyzdList.length > 0) {
                            for (var i = 0; i < ajaxresp.xyzdList.length; i++) {
                                if(ajaxresp.xyzdList.length>1 &&  i< ajaxresp.xyzdList.length-1)
                                {
                                    //trướcappend
                                    var number = $('#tablexyzd .zdText').length + 1;
                                    var $newTr = $('<tr><th class="formTitle">副</th><td class="formValue"><input type="checkbox" id="chk'+ number +'" class="chkValue" style="float:left;" /><label style="float:left;margin-top:3px;">Nghi ngờ</label><input type="text" id="zd'+ number +'" class="form-control activeValue focusInput zdText" style="width:70%;" /><i class="fa fa-times" aria-hidden="true" hidden></i></td><td><i class="fa fa-minus minusToggleCircle" aria-hidden="true" style="margin-left: 10px; color: #6ff3ad; font-size: large;"></i></td></tr>');
                                    $newTr.appendTo($('#tablexyzd'));
                                }

                                //Gán lại giá trị
                                for (var j = 0; j < $('#tablexyzd .zdText').length; j++) {
                                    if(i==j){
                                        $($('#tablexyzd .zdText')[j]).val(ajaxresp.xyzdList[i].zdmc);
                                        $($('#tablexyzd .zdText')[j]).attr("data-zdCode",ajaxresp.xyzdList[i].zdCode);
                                        $($('#tablexyzd .chkValue')[j]).prop('checked' ,ajaxresp.xyzdList[i].ysbz);
                                    }
                                }
                            }
                        }
                        else{
                            //Xóa chẩn đoán chính
                            $('#tablexyzd .zdText').val('');
                            $('#tablexyzd .zdText').attr("data-zdCode",'');
                            $('#tablexyzd .chkValue').prop('checked' ,false);
                        }

                        if (ajaxresp.zyzdList && ajaxresp.zyzdList.length && ajaxresp.zyzdList.length > 0) {
                            for (var i = 0; i < ajaxresp.zyzdList.length; i++) {
                                if(ajaxresp.zyzdList.length>1 &&  i< ajaxresp.zyzdList.length-1)
                                {
                                    //trướcappend
                                    var number = $('#tablezyzd .zdText').length + 1;
                                    var $newTr = $('<tr><th class="formTitle">副</th><td class="formValue"><input type="checkbox" id="chk'+ number +'" class="chkValue" style="float:left;" /><label style="float:left;margin-top:3px;">Nghi ngờ</label><input type="text" id="zd'+ number +'" class="form-control activeValue focusInput zdText" style="width:70%;" /><i class="fa fa-times" aria-hidden="true" hidden></i></td><th class="formTitle">Hội chứng</th><td class="formValue"><input type="text" id="zh'+ number +'" class="form-control activeValue focusInput zhText" /><i class="fa fa-times" aria-hidden="true" hidden></i></td><td><i class="fa fa-minus minusToggleCircle" aria-hidden="true" style="margin-left: 10px; color: #6ff3ad; font-size: large;"></i></td></tr>');
                                    $newTr.appendTo($('#tablezyzd'));
                                }
                                //Gán lại giá trị
                                for (var j = 0; j < $('#tablezyzd .zdText').length; j++) {
                                    if(i==j){
                                        $($('#tablezyzd .zdText')[j]).val(ajaxresp.zyzdList[i].zdmc);
                                        $($('#tablezyzd .zdText')[j]).attr("data-zdCode",ajaxresp.zyzdList[i].zdCode);
                                        $($('#tablezyzd .chkValue')[j]).prop('checked' ,ajaxresp.zyzdList[i].ysbz);
                                        $($('#tablezyzd .zhText')[j]).val(ajaxresp.zyzdList[i].zhmc);
                                        $($('#tablezyzd .zhText')[j]).attr("data-zhCode",ajaxresp.zyzdList[i].zhCode);
                                    }
                                }
                            }
                        }
                        else{
                            //Xóa chẩn đoán chính
                            $('#tablezyzd .zdText').val('');
                            $('#tablezyzd .zdText').attr("data-zdCode", '');
                            $('#tablezyzd .chkValue').prop('checked' ,false);
                            $('#tablezyzd .zhText').val('');
                            $('#tablezyzd .zhText').attr("data-zhCode",'');
                        }
                        $("#groupPackageListGridList").clearGridData();
                        initGroupPackageGrid(ajaxresp.mbztList);    //Hạng mục thu phí
                    }
                });
            }
        });
    });

    //validkiểu mở rộng của
    var valOptions = {
        errorPlacement: function (error, element) {
            element.parents('.formValue').addClass('has-error');
        }
    }

    //Lớp nổi chẩn đoán Tây y
    function bindXyzdFloatingSelector($ele){
        $ele.zdFloatingSelector({
            zdlx:"WM",
            //ybnhlx:ybnhlx,
            itemdbclickhandler: function ($thistr, $thisinput) {
                $thisinput.val($thistr.attr('data-zdmc'))
                    .attr('data-zdCode', $thistr.attr('data-zdCode'));
                //Hiển thị Ẩn Xóaicon
                if (!!$.trim($thisinput.val())) {
                    $thisinput.siblings('.fa.fa-times').show();
                }
                else {
                    $thisinput.siblings('.fa.fa-times').hide();
                }
            }
        });
    }
    bindXyzdFloatingSelector($("#tablexyzd .zdText"));

    //Lớp nổi chẩn đoán Đông y
    function bindZyzdFloatingSelector($ele){
        $ele.zdFloatingSelector({
            zdlx:"TCM",
            //ybnhlx:ybnhlx,
            itemdbclickhandler: function ($thistr, $thisinput) {
                $thisinput.val($thistr.attr('data-zdmc'))
                    .attr('data-zdCode', $thistr.attr('data-zdCode'));
                //Hiển thị Ẩn Xóaicon
                if (!!$.trim($thisinput.val())) {
                    $thisinput.siblings('.fa.fa-times').show();
                }
                else {
                    $thisinput.siblings('.fa.fa-times').hide();
                }
            }
        });
    }
    bindZyzdFloatingSelector($("#tablezyzd .zdText"));

    //Lớp nổi hội chứng
    function bindZyzhFloatingSelector($ele){
        $ele.zyzhFloatingSelector({
            itemdbclickhandler: function ($thistr, $thisinput) {
                $thisinput.val($thistr.attr('data-zhmc'))
                    .attr('data-zhCode', $thistr.attr('data-zhCode'));
                //Hiển thị Ẩn Xóaicon
                if (!!$.trim($thisinput.val())) {
                    $thisinput.siblings('.fa.fa-times').show();
                }
                else {
                    $thisinput.siblings('.fa.fa-times').hide();
                }
            }
        });
    }
    //Lớp nổi hội chứng
    bindZyzhFloatingSelector($("#tablezyzd .zhText"));

    //Chẩn đoán Tây y Thêm mới
    $('#tablexyzd .plusToggleCircle').click(function () {
        var number = $('#tablexyzd .zdText').length + 1;
        var $newTr = $('<tr><th class="formTitle">副</th><td class="formValue"><input type="checkbox" id="chk'+ number +'" class="chkValue" style="float:left;" /><label style="float:left;margin-top:3px;">Nghi ngờ</label><input type="text" id="zd'+ number +'" class="form-control activeValue focusInput zdText" style="width:70%;" /><i class="fa fa-times" aria-hidden="true" hidden></i></td><td><i class="fa fa-minus minusToggleCircle" aria-hidden="true" style="margin-left: 10px; color: #6ff3ad; font-size: large;"></i></td></tr>');
        $newTr.appendTo($(this).closest('table'));
        //Lớp nổi chẩn đoán Tây y
        bindXyzdFloatingSelector($newTr.find(".zdText"));
    });

    //Chẩn đoán Đông y Thêm mới
    $('#tablezyzd .plusToggleCircle').click(function () {
        var number = $('#tablezyzd .zdText').length + 1;
        var $newTr = $('<tr><th class="formTitle">副</th><td class="formValue"><input type="checkbox" id="chk'+ number +'" class="chkValue" style="float:left;" /><label style="float:left;margin-top:3px;">Nghi ngờ</label><input type="text" id="zd'+ number +'" class="form-control activeValue focusInput zdText" style="width:70%;" /><i class="fa fa-times" aria-hidden="true" hidden></i></td><th class="formTitle">Hội chứng</th><td class="formValue"><input type="text" id="zh'+ number +'" class="form-control activeValue focusInput zhText" /><i class="fa fa-times" aria-hidden="true" hidden></i></td><td><i class="fa fa-minus minusToggleCircle" aria-hidden="true" style="margin-left: 10px; color: #6ff3ad; font-size: large;"></i></td></tr>');
        $newTr.appendTo($(this).closest('table'));
        //Lớp nổi chẩn đoán Đông y
        bindZyzdFloatingSelector($newTr.find(".zdText"));
        //Lớp nổi hội chứng
        bindZyzhFloatingSelector($newTr.find(".zhText"));
    });

    //Ẩn Hiển thị Xóaicon
    $('#form1').on('keyup click change blur', '.activeValue', function(){
        if (!!$.trim($(this).val())) {
            $(this).siblings('.fa.fa-times').show();
        }
        else {
            $(this).siblings('.fa.fa-times').hide();
        }
    });

    //Xóa sạchiconSự kiện
    $('#form1').on('click', '.fa.fa-times', function(){
        $(this).siblings('input.form-control').val('');
        $(this).siblings('textarea.form-control').val('');
        $(this).hide();
    });

    //Xóaicon
    $('#form1').on('click', '.minusToggleCircle', function(){
        $(this).closest('tr').remove();
    })
    
    cfzutaoFloatingSelector();
    
    //Bộ mẫu mẫu đơn thuốc
    function cfzutaoFloatingSelector(){
        //Mặc địnhoptions
        var defaults = {
            width: 350,
            height: 280,
            focusautotrigger: true,
            caption: "Chọn bộ mẫu",
            url: '/PresTemplate/GetCfmbList',
            ajaxparameters: function ($thisinput) {
                return "mblx="+ $('#current').attr('data-type') + "&cflx="+$("#cflx").val()+"&expandCflx=null&mbKeyword=" + $.trim($thisinput.val());
            },
            itemdbclickhandler: function ($thistr) {
                var returnFlag = false;
                var allData = $("#groupPackageListGridList").getRowData_AllLine(undefined, true);
                $.each(allData, function () {
                    if(!returnFlag){
                        var mbId = this["mbId"];
                        if (mbId && mbId  == $thistr.attr('data-mbId')) {
                            returnFlag = true;
                            return;
                        }
                    }
                });
                if (returnFlag) {
                    $.modalAlert("Không được thêm trùng lặp", 'warning');
                    return;
                }
                btn_addItem($thistr);

            },
            colModel: [
                { label: 'cfmbId', name: 'mbId', hidden: true },
                { label: 'Tên mẫu', name: 'mbmc', widthratio: 30 },
                {
                    label: 'Loại đơn thuốc',
                    name: 'cflx',
                    widthratio: 20,
                    formatter: function(value, options, row) {
                        // Chuyển đổi giá trị số thành chữ Hán
                        const prescriptionTypes = {
                            1: "西药处方",
                            2: "中药处方",
                            4: "检验处方",
                            5: "检查处方",
                            3: "康复处方",
                            6: "常规项目处方",
                        };
                        return prescriptionTypes[value] || "未知类型"; // Giá trị mặc định là "Loại không xác định"
                    }
                },
                { label: 'Mô tả', name: 'Description', widthratio: 30, hidden: true},
                { label: 'Lưu ý', name: 'Remark', widthratio: 30 ,hidden: true}
            ]
        };
        var options = $.extend(defaults, options);

        $('#txtZutaoSel').newtouchFloatingSelector(options);
    }

    //Lớp nổi bộ mẫu đơn thuốc
    //$('#txtZutaoSel').cfzutaoFloatingSelector({
    //    mblx:  0,
    //    cflx:$("#cflx").val(),
    //    itemdbclickhandler: function ($thistr) {
    //        var returnFlag = false;

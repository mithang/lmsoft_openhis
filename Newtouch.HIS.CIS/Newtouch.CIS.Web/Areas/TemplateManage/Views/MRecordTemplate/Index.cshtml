    function initGroupPackageGrid(data) {
        $('#groupPackageListGridList').newtouchLocalDataGrid({
            height: 200, // Tăng chiều cao, đảm bảo nội dung không bị ép
            unwritten: false,
            caption: "Thông tin bộ mẫu",
            colModel: [
                { label: 'mbId', name: 'mbId', width: 120, hidden: true, align: 'left' },
                { label: 'Tên mẫu', name: 'mbmc', width: 200, align: 'left'  },  // Điều chỉnh chiều rộng
                { label: 'Loại đơn thuốc', name: 'cflx', width: 120, align: 'left',
                    formatter: function(value, options, row) {
                        debugger;
                            // Nếu giá trị là số, chuyển đổi thành chữ Hán
                            if (typeof value === 'number' || Number.isInteger(value)) {
                                const prescriptionTypes = {
                                    1: "西药处方",
                                    2: "中药处方",
                                    4: "检验处方",
                                    5: "检查处方",
                                    3: "康复处方",
                                    6: "常规项目处方",
                                };
                                return prescriptionTypes[value] || "未知类型";
                            }
                            // Nếu không phải Số, trả về giá trị ban đầu trực tiếp
                            return value;
                      }
                },
            ]
        }, data);
    }


    function btn_addItem($thistr) {
        $('#groupPackageListGridList').newtouchLocalDataGrid(null, [{
            mbId: $thistr.attr('data-mbId'),        // trong bảng tương ứng cfmbId
            mbmc: $thistr.attr('data-mbmc'),        // trong bảng tương ứng Tên mẫu (mbmc)
            cflx: $thistr.attr('data-cflx'),                          // Dùng chữ Hán thay thế Số, hiển thị loại đơn thuốc
            Description: $thistr.attr('data-Description'),  // trong bảng tương ứng Mô tả
            Remark: $thistr.attr('data-Remark')     // trong bảng tương ứng Lưu ý
        }]);
    }

    //Lưu
    function newtouch_event_f8(){
        //Xác thực thông tin bắt buộc
        if (!$('#form2').formValid(valOptions)) {
            $.modalAlert("Thông tin bắt buộc chưa hoàn thiện", 'warning');
            return;
        }
        //Thông tin bệnh án
        var blmbObject = {
            mbId: $('#mbId').val(),
            mbmc: $('#mbmc').val(),
            mblx: $('#current').attr('data-type'),
            zs: $('#zs').val(),
            xbs: $('#xbs').val(),
            jws: $('#jws').val(),
            ct: $('#ct').val(),
            clfa: $('#clfa').val()
        }

        //Chẩn đoán Tây y
        var xyzdArray = new Array();
        for (var i = 0; i < $('#tablexyzd .zdText').length; i++) {
            var zdObj = new Object();
            zdObj.zdmc = $($('#tablexyzd .zdText')[i]).val();
            zdObj.zdCode = $($('#tablexyzd .zdText')[i]).attr('data-zdCode');
            zdObj.ysbz = $($('#tablexyzd .zdText')[i]).siblings('.chkValue').is(':checked')
            if (zdObj.zdmc && zdObj.zdmc) {    //Để loại trừ chẩn đoán trống
                if (i == 0) {
                    zdObj.zdlx =  @Html.Raw(((int)EnumZdlx.Main).ToString());   //Mặc định chẩn đoán đầu tiên là chẩn đoán chính  1: Chẩn đoán chính 2Chẩn đoán phụ
                }
                else {
                    zdObj.zdlx =  @Html.Raw(((int)EnumZdlx.Deputy).ToString());
                }

                xyzdArray.push(zdObj)
            }
        }

        //Chẩn đoán Đông y
        var zyzdArray = new Array();
        for (var i = 0; i < $('#tablezyzd .zdText').length; i++) {
            var zdObj = new Object();
            zdObj.zdmc = $($('#tablezyzd .zdText')[i]).val();
            zdObj.zdCode = $($('#tablezyzd .zdText')[i]).attr('data-zdCode');
            zdObj.ysbz = $($('#tablexyzd .zdText')[i]).siblings('.chkValue').is(':checked')
            zdObj.zhmc = $($('#tablezyzd .zhText')[i]).val();
            zdObj.zhCode = $($('#tablezyzd .zhText')[i]).attr('data-zhCode');
            if (zdObj.zdmc && zdObj.zdmc) {    //Để loại trừ chẩn đoán trống
                if (i == 0) {
                    zdObj.zdlx =  @Html.Raw(((int)EnumZdlx.Main).ToString());   //Mặc định chẩn đoán đầu tiên là chẩn đoán chính  1: Chẩn đoán chính 2Chẩn đoán phụ
                }
                else {
                    zdObj.zdlx =  @Html.Raw(((int)EnumZdlx.Deputy).ToString());
                }

                zyzdArray.push(zdObj)
            }
        }
        //Bộ mẫu
        var mbztlist = $("#groupPackageListGridList").jqGrid('getRowData_AllLine', null, true);
        debugger;
        const prescriptionTypes = {
            "西药处方": 1,
            "中药处方": 2,
            "检验处方": 4,
            "检查处方": 5,
            "康复处方": 3,
            "常规项目处方": 6,
        };

        for (var i = 0; i < mbztlist.length; i++) {
            if (prescriptionTypes[mbztlist[i].cflx] !== undefined) {
                mbztlist[i].cflx = prescriptionTypes[mbztlist[i].cflx]; // Chuyển đổi thành Số
            } else {
                mbztlist[i].cflx = "未知类型"; // Khi không tìm thấy chữ Hán tương ứng thì đặt thành“Loại không xác định”
            }
        }
        $.najax({
            url: "/MRecordTemplate/SaveData",
            dataType: "json",
            data: { blmbObject: blmbObject, xyzdList: xyzdArray, zyzdList:zyzdArray, mbztlist: mbztlist},
            type: "POST",
            success: function (data) {
                $.modalAlert("Lưu thành công", 'success');
                //Làm mới cây bên trái
                $.currentWindow().$('#current').trigger('click');
                //Xóa sạch
                newtouch_globalevent_f4();
            }
        });
       
    }
    
    //Thêm mẫu mới
    function newtouch_event_f3(){
        newtouch_globalevent_f4();
        $("#groupPackageListGridList").clearGridData();
    }

    function newtouch_event_f4(){
        $('#form1 .minusToggleCircle').trigger('click');
    }

    //Xóa mẫu
    function newtouch_event_f6(){
        if(!!!$('#mbId').val()){
            $.modalAlert("Vui lòng chọn mẫu", 'warning');
            return;
        }
        $.modalConfirm("Xác định xóa mẫu?", function (flag) {
            if (flag) {
                $.najax({
                    url: "/TemplateManage/MRecordTemplate/DeleteTemplate",
                    dataType: "json",
                    data: { mbId: $('#mbId').val() },
                    type: "POST",
                    success: function (ajaxresp) {
                        $.modalAlert("Thao tác thành công", 'success');
                        $.currentWindow().$('#current').trigger('click');
                        newtouch_globalevent_f4();
                    }
                });
            }
        });
    }

 
    //Xóa hạng mục
    function btn_removeItem() {
        var rowid = $("#groupPackageListGridList").jqGrid("getGridParam", "selrow");
        $('#groupPackageListGridList').jqGrid("delRowData", rowid);
    }



</script>
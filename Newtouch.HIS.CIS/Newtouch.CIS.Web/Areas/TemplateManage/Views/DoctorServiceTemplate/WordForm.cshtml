@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "WordForm";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    .ui-jqgrid .ui-jqgrid-btable tbody tr.jqgrow td {
        border: 1px solid #ddd;
    }
    #gridwordPager_center {
        display: none;
    }
    #linkwzlr .ui-th-ltr, #linkwzlr .ui-jqgrid .ui-jqgrid-htable th.ui-th-ltr {
        border: solid 1px #ddd;
    }
</style>
<link href="@MvcHelper.GetStaticResourceScriptUrl("~/Content/css/cispage.css", false)" rel="stylesheet" />
<script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/validate/jquery.validate.min.js")"></script>
<link href="@MvcHelper.GetStaticResourceScriptUrl("~/Content/css/wmgridmenu.css", false)" rel="stylesheet" />
<div id="linkwzlr" style="width:100%;">
    <table id="gridword"></table>
    <table id="gridwordPager"></table>
    <form id="form1">
        <table class="form" style="margin-top:10px;">
            <tr>
                <th class="formTitle"><span class="required">*</span>MẫuTên: </th>
                <td class="formValue">
                    <input id="mbmc" name="mbmc" type="text" class="form-control required" />
                </td>
                <td class="formTitle">Loại mẫu:</td>
                <td class="formValue">
                    <select id="mblx" class="form-control required">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <td class="formValue">
                    <input type="button" id="" class="btn btn-primary" value="Lưu" style="margin-left:20%; width:20%;" onclick="Save()" />
                    <input type="button" id="" class="btn btn-primary" value="Xóa" style="margin-left:10%; width:20%;" onclick="Delete()" />
                </td>
                <td></td>
            </tr>
        </table>
    </form>
</div>

<script>
    var mbId = $.request("mbId");
    var localdata = [];//mang thuốcđối tượng
    var deldata = [];//Xóađối tượng
    $(function () {
        gridword();

        $("#mblx").bindSelect({
            url: "/MedicalRecord/GetMbqxSelectJson",
        });

		    if (mbId) {
            $.najax({
                url: "/DoctorManage/DoctorsAdvice/GetMBDetailByMainId",
                dataType: "json",
                data: { Id: mbId },
                type: "POST",
                success: function (localdata) {
                    if (localdata !== typeof (undefined) && localdata.length > 0) {
                        $.each(localdata, function () {
                            this.action = getWordActionStr();
                        });
                        $("#gridword").jqGrid('setGridParam', {
                            datatype: 'local',
                            data: localdata
                        }).trigger("reloadGrid");
                        $('#mblx').val(localdata[0].tcfw).trigger("change");
                        $('#mbmc').val(localdata[0].tcmc);
                    }
                }
            });
        }
    });

    //danh sách
    function gridword() {
        var $gridword = $("#gridword");
        $gridword.jqGrid({
            datatype: 'local',
            data: localdata,
            height: $(window).height() - 200,
            shrinkToFit: true,   //true:theo tỷ lệVDkhởi tạo độ rộng cột false:Sử dụngcolModelđộ rộng đã chỉ định
            autowidth: true,
            rownumbers: true,  //CóKhôngHiển thịSố thứ tự
            editurl: "clientArray",  //dòngSửakhông gửi lên máy chủGửiDữ liệu
            unwritten: false,
            colModel: [
                {label: 'Id', name: 'Id', width: 120, editwidth: '81%', align: 'center', hidden: true},
                {label: '<span class="required">*</span>Chỉ định', name: 'xmmc', width: 300, editwidth: '100%', align: 'center', editable: true, editrules: { required: true }},
                { label: 'xmdm', name: 'xmdm', width: 100, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: '<span class="required">*</span>Tần suất', name: 'pcmc', width: 60, editwidth: '100%', align: 'center', editrules: { required: true }, editable: true },
                { label: 'pcCode', name: 'pcCode', editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: 'zxcs', name: 'zxcs', editable: true, hidden: true },
                { label: 'zxzq', name: 'zxzq', editable: true, hidden: true },
                { label: 'zxzqdw', name: 'zxzqdw', editable: true, hidden: true },
                { label: 'Dặn dò', name: 'ztnr', width: 310, editwidth: '100%', align: 'center', editable: true },
                { label: 'Thao tác', name: 'action', width: 30, align: 'center' },
                { name: 'yzlx', hidden: true }
            ],
            editinputwidthborder: false,    //CóKhôngcần viền Mặc địnhlàtrue
            editinputborderradius: false,   //CóKhôngcần bo tròn viền Mặc địnhtrue(có bo tròn)
            pager: "gridwordPager",
            loadComplete: function () {
                if (localdata && localdata.length == 0) {
                    newWordPresData();
                }
            },
            gridComplete: function () {
                EnableWordInlineEditBox();
                //Ẩngridthanh cuộn dưới cùng
                $gridword.closest(".ui-jqgrid-bdiv").css({ "overflow-x": "hidden" });
            }
        });

        //Menu cấp 2
        $gridword.jqGrid('setGroupHeaders', {
            useColSpanStyle: true,
            groupHeaders: [
                {
                    startColumnName: 'xmmc',
                    numberOfColumns: 3,
                    titleText: 'Thông tin cơ bản'
                }]
        });

        //Nút tùy chỉnh
        $gridword.navGrid('#gridwordPager',
            { edit: false, add: false, del: false, search: false, refresh: false, view: false, position: "left", cloneToTop: false })
            .navButtonAdd('#gridwordPager',
            {
                buttonicon: "glyphicon glyphicon-new-window",
                title: "Chi tiết mới",
                caption: "Chi tiết mới",
                position: "first",
                onClickButton: function () {
                    newWordPresData();
                },
            })
    }

    //Bật sửa trong dòng
    function EnableWordInlineEditBox() {
        var ids = $("#gridword").getDataIDs();
        $.each(ids, function () {
            var rowid = String(this);
            //MởSửachế độ
            $("#gridword").jqGrid('editRow', rowid, false, initWordInlineFunc);
        });
    }

    //Khởi tạo lớp nổi
    function initWordInlineFunc(rowid) {
        //Một số cột chỉ đọc
        $("#" + rowid + "_pcmc").attr('readonly', 'true');
        //Lớp nổi tần suất
        $("#" + rowid + "_pcmc").pcFloatingSelector({
            showtext: 'yzpcmc',
            attrcols: ['yzpcmc', 'yzpcCode', 'zxcs', 'zxzq', 'zxzqdw'],
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_pcmc").val($this.attr('data-yzpcmc'));
                $("#" + rowid + "_pcCode").val($this.attr('data-yzpcCode'));
                $("#" + rowid + "_zxcs").val($this.attr('data-zxcs'))
                $("#" + rowid + "_zxzq").val($this.attr('data-zxzq'))
                $("#" + rowid + "_zxzqdw").val($this.attr('data-zxzqdw'));
            },
        });

        //Lớp nổi dặn dò
        $("#" + rowid + "_ztnr").ztFloatingSelector({
            height: 100,
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_ztnr").val($this.attr('data-ztmc'));
            },
        });
    }

    //Thêm mới Nút
    function newWordPresData() {
        var dataRow = {
            Id: Math.random().toString() + new Date().getMilliseconds(),
            xmdm: "999999999999999999",
            yzlx: @Html.Raw(((int)EnumYzlx.Wz).ToString()),//văn bảnnhập
            action: getWordActionStr()
        };
        $("#gridword").jqGrid("addRowData", undefined, dataRow, "first");
    }

    //Xóa chi tiết
    function deleteIRowData(selRowId, recalc) {
        if (!!selRowId) {
           var Id= $("#gridword").jqGrid('getRowData', selRowId).Id;
            $("#gridword").jqGrid("delRowData", selRowId);
            if (Id.indexOf("0.")=='-1') {//ghi lại，từCơ sở dữ liệuXóa
                deldata.push(Id);
            }
        }
    }

    function getWordActionStr() {
        return "<input class='btn btn-default btn-md btn_del' type='button' value='Delete' onclick='deleteIRowData($(this).parent().parent().attr(\"id\"))'/>";
    }

      //Lưu
    function Save() {
        if (ValidateWord()) {//kiểm traDữ liệu
            //Lấytất cả các dòngId，duyệt đểSửakhung ở trạng tháiLưuTrạng thái
            var rowIds = $("#gridword").jqGrid('getDataIDs');

            for (var i = 0; i < rowIds.length; i++) {
                var saveResult = $("#gridword").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);

                if (!saveResult) {
                    EnableWordInlineEditBox();    //khởi động lạiKích hoạtSửa Khôngthì lần sau lầnSavekhisẽQuay lạifalse
                    return;   //Lưu thất bại，thìreturn
                }
            }
            var gridwordData = $("#gridword").jqGrid('getRowData_AllLine', null, true);
            if (gridwordData.length < 1) {
                $.modalAlert("Hiện tạiKhông cóLưunội dung gói", 'warning');
            }
            $.each(gridwordData, function () {    //Bỏaction
                for (var i = 0; i < $(this).length; i++) {
                    delete $(this)[i].action;
                }
            });
            submitService(gridwordData);

        }
    }

    //Gửiđếnmáy chủ
    function submitService(gridwordData) {
        //bảng gói
        var mbObj = {
            Id: mbId,
            tcfw: $('#mblx').val(),//$.currentWindow().$('#current').attr('data-type'),
            tclx: @Html.Raw(((int)EnumYzlx.Wz).ToString()),
            tcmc: $('#mbmc').val()
        }
        $.najax({
            url: "@Url.Action("Submit")",
            dataType: "json",
            data: { mbObj: mbObj, mbDetailList: gridwordData },
            type: "POST",
            loadingtext: "Đang lưu dữ liệu gói, vui lòng đợi trong giây lát...",
            success: function (data) {
                $.modalMsg("Lưu thành công", 'success');
                   if(!mbId && data.data){
                    mbId = data.data;
                    $.currentWindow().expandyzlx = @Html.Raw(((int)EnumYzlx.Wz).ToString());
                    
                }
                $.currentWindow().$("#beveltabs a[id='current']").trigger('click');
                location.href = "/TemplateManage/DoctorServiceTemplate/WordForm?mbId=" + mbId;
            }
        });
    }

    //kiểm tra
    function ValidateWord() {
        //CóKhôngcóDữ liệu
        var data = $("#gridword").jqGrid('getRowData_AllLine', null, true);
        if (data.length==0) {
            $.modalAlert("Thiếu dữ liệu gói", 'warning');
            return false;
        }
        return true;
    }

    function Delete() {
        if (mbId == null || mbId == "") {
            $.modalAlert("Thiếu gói", "warning");
            return;
        }
            $.najax({
            url: "@Url.Action("Delete")",
            dataType: "json",
            data: { mbId: mbId},
            type: "POST",
            loadingtext: "Đang xóa dữ liệu gói, vui lòng đợi trong giây lát...",
            success: function (data) {
                $.modalMsg("Xóa thành công", 'success');
                $.currentWindow().$("#beveltabs a[id='current']").trigger('click');
                location.href = "/TemplateManage/DoctorServiceTemplate/WordForm?mbId=";
            }
        });
    }
</script>



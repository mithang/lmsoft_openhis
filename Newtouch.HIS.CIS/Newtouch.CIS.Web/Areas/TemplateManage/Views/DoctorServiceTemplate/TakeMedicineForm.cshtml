@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "TakeMedicineForm";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    .ui-jqgrid .ui-jqgrid-btable tbody tr.jqgrow td {
        border: 1px solid #ddd;
    }
    #gridTakePager_center {
        display: none;
    }
    #linkcydy .ui-th-ltr, #linkkfcf .ui-jqgrid .ui-jqgrid-htable th.ui-th-ltr {
        border: solid 1px #ddd;
    }
</style>
<link href="@MvcHelper.GetStaticResourceScriptUrl("~/Content/css/cispage.css", false)" rel="stylesheet" />
<script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/validate/jquery.validate.min.js")"></script>
<link href="@MvcHelper.GetStaticResourceScriptUrl("~/Content/css/wmgridmenu.css", false)" rel="stylesheet" />


<div id="linkcydy" style="width:100%;">
    <table id="gridTake"></table>
    <table id="gridTakePager"></table>
    <form id="form1">
        <table class="form" style="margin-top:10px;">
            <tr>
                <th class="formTitle"><span class="required">*</span>MẫuTên: </th>
                <td class="formValue">
                    <input id="mbmc" name="mbmc" type="text" class="form-control required" />
                </td>
                <td class="formTitle"><span class="required">*</span>Loại mẫu:</td>
                <td class="formValue">
                    <select id="mblx" class="form-control required">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <td class="formValue">
                    <input type="button" id="" class="btn btn-primary" value="Lưu" style="margin-left:20%; width:20%;" onclick="Save()" />
                    <input type="button" id="" class="btn btn-primary" value="Xóa" style="margin-left:10%; width:20%;" onclick="Delete()" />
                </td>
                <td></td>
            </tr>
        </table>
    </form>
</div>

<script>
    var mbId = $.request("mbId");

    var localdata = [];
    $(function () {
        gridTake();

        $("#mblx").bindSelect({
            url: "/MedicalRecord/GetMbqxSelectJson",
        });

        if (mbId) {
            $.najax({
                url: "/DoctorManage/DoctorsAdvice/GetMBDetailByMainId",
                dataType: "json",
                data: { Id: mbId },
                type: "POST",
                success: function (localdata) {
                    if (localdata !== typeof (undefined) && localdata.length > 0) {
                        $.each(localdata, function () {
                            this.action = getWMActionStr();
                        });
                        $("#gridTake").jqGrid('setGridParam', {
                            datatype: 'local',
                            data: localdata
                        }).trigger("reloadGrid");
                        $('#mblx').val(localdata[0].tcfw).trigger("change");
                        $('#mbmc').val(localdata[0].tcmc);
                    }
                }
            });
        }
    });

    //Đơn thuốcdanh sách
    function gridTake() {
        var $gridTake = $("#gridTake");
        $gridTake.jqGrid({
            datatype: 'local',
            data: localdata,
            height: $(window).height() - 200,
            //altRows: true,//Đổi màu xen kẽ dòng
            shrinkToFit: true,   //true:theo tỷ lệVDkhởi tạo độ rộng cột false:Sử dụngcolModelđộ rộng đã chỉ định
            autowidth: true,
            rownumbers: true,  //CóKhôngHiển thịSố thứ tự
            editurl: "clientArray",  //dòngSửakhông gửi lên máy chủGửiDữ liệu
            unwritten: false,
            colModel: [
                {
                    label: 'Id', name: 'Id', width: 120, editwidth: '81%', align: 'center', hidden: true
                },
                {
                    label: '<span class="required">*</span>Tên thuốc', name: 'xmmc', width: 140, editwidth: '100%', align: 'center', editable: true, editrules: { required: true }
                },
                { label: 'xmdm', name: 'xmdm', width: 100, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: '<span class="required">*</span>Quy cách', name: 'ypgg', hidden: true, editwidth: '100%', align: 'center', editable: true, editrules: { required: true } },
                { label: 'jlzhxs', name: 'jlzhxs', editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: 'zyzhxs', name: 'zyzhxs', editwidth: '100%', align: 'center', editable: true, hidden: true },
                {
                    label: '<span class="required">*</span>Liều lượng', name: 'ypjl', width: 50, editwidth: '100%', align: 'center', editable: true, editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var cellval = $(this).val();
                                    if (cellval.replace(/(^\s*)|(\s*$)/g, "") == "") {
                                        $.modalAlert("Liều lượngđể trống,Vui lòng xác nhận.", 'warning');
                                        return;
                                    }
                                    if (isNaN(cellval)) {
                                        $.modalAlert("Liều lượng:Vui lòng nhập số", 'warning');
                                        $(this).val('')
                                        return;
                                    }
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    caltakesl(rowid);
                                }
                            }
                        ]
                    }, editrules: { required: true }
                },
                {
                    label: '<span class="required">*</span>Đơn vị', name: 'dw', width: 65, editwidth: '70%', align: 'center', editable: true, edittype: "select", editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    $("#" + rowid + "_dwwwwwww").val($(this).find("option:selected").text());
                                    //dùng làmLưuĐã chọncủadwcủaGiá trị
                                    $("#" + rowid + "_dwlb").val($(this).val());
                                    caltakesl(rowid);
                                }
                            }
                        ]

                    }, editrules: { required: true }   //Lưu ý：Đơn vị liềuphải định ký tựởLiều lượngphía dưới，vìphía dướiCóTheonàyCơ sởđến tìmĐơn vị liềucủa。（vìselectKhông cóidcủaThuộc tính）
                },
                { label: 'dwlb', name: 'dwlb', editwidth: '', align: 'center', editable: true, hidden: true },  //Không thể bỏ
                { label: 'redundant_jldw', name: 'redundant_jldw', editwidth: '', align: 'center', editable: true, hidden: true },  //Không thể bỏ
                { label: 'dwwwwwww', name: 'dwwwwwww', editwidth: '', align: 'center', editable: true, hidden: true },  //Không thể bỏ
                { label: '<span class="required">*</span>Cách dùng', name: 'yfmcval', width: 50, editwidth: '100%', align: 'center', editable: true, editrules: { required: true } },
                { label: 'ypyfdm', name: 'ypyfdm', editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: '<span class="required">*</span>Tần suất', name: 'pcmc', width: 50, editwidth: '100%', align: 'center', editrules: { required: true }, editable: true },
                { label: 'pcCode', name: 'pcCode', editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: 'zxcs', name: 'zxcs', editable: true, hidden: true },
                { label: 'zxzq', name: 'zxzq', editable: true, hidden: true },
                { label: 'zxzqdw', name: 'zxzqdw', editable: true, hidden: true },
                {
                    label: '<span class="required">*</span>Liều dùngĐơn vị', name: 'yldw', width: 95, editwidth: '80%', align: 'center', editable: true, edittype: "select", editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    var $thisval = $(this).val();
                                    if ($thisval == "1") {//Số ngày
                                        //Kích hoạt
                                        $("#" + rowid + "_yl").css('background-color', 'white').removeAttr('readonly');
                                        //Vô hiệu hóa
                                        $("#" + rowid + "_sl").css('background-color', '#f6f7fb').attr('readonly', 'true');
                                        $("#" + rowid + "_sl").val("");
                                    } else {//mang thuốcTổng lượng
                                        //Vô hiệu hóa
                                        $("#" + rowid + "_yl").css('background-color', '#f6f7fb').attr('readonly', 'true');
                                        $("#" + rowid + "_yl").val("");
                                        //Kích hoạt
                                        $("#" + rowid + "_sl").css('background-color', 'white').removeAttr('readonly');
                                        $("#" + rowid + "_sl").val("");
                                    }
                                    $("#" + rowid + "_yldwwwwwww").val($thisval);
                                    caltakesl(rowid);
                                }
                            }
                        ]

                    }, editrules: { required: true }
                },
                { label: 'yldwwwwwww', name: 'yldwwwwwww', editwidth: '', align: 'center', editable: true, hidden: true },  //Không thể bỏ
                { label: '<span class="required">*</span>Số ngày', name: 'yl', width: 40, editwidth: '100%', align: 'center', editable: true },
                { label: 'Tổng lượng', name: 'sl', width: 50, editwidth: '100%', align: 'center', editable: true, editrules: { required: true } },
                { label: 'Đơn vị nhập viện', name: 'zydw', width: 50, editwidth: '100%', align: 'center', editable: true },
                { label: 'Dặn dò', name: 'ztnr', width: 120, editwidth: '100%', align: 'center', editable: true },
                { label: 'Thao tác', name: 'action', width: 30, align: 'center' },
                { name: 'yzlx', hidden: true },
                { name: 'zxksdm', width: 50, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { name: 'qzfs', width: 50, editwidth: '100%', editable: true, hidden: true }
            ],
            editinputwidthborder: false,    //CóKhôngcần viền Mặc địnhlàtrue
            editinputborderradius: false,   //CóKhôngcần bo tròn viền Mặc địnhtrue（có bo tròn）
            pager: "gridTakePager",
            loadComplete: function () {
                if (localdata && localdata.length == 0) {
                    newWMPresData();
                }
            },
            gridComplete: function () {
                var ids = $("#gridTake").getDataIDs();
                $.each(ids, function () {
                    var rowid = String(this);
                    //MởSửachế độ
                    $("#gridTake").jqGrid('editRow', rowid, false, initWMInlineFunc);

                    //chomỗi lầnĐơn vị liềuđiềnoption
                    var jldw = $("#" + rowid + "_redundant_jldw").val();    //Đơn vị liều Thuốcbảng từ điểncủaĐơn vị
                    var dw = $("#" + rowid + "_dwwwwwww").val();     //Đơn vị nhập viện
                    if (!!dw) {
                        //cách tìm phần tử nàyPhương phápkhông nên dùng，nhưng doselectKhông cóidThuộc tính
                        $("#" + rowid + "_ypjl").parent().next().children('select').html('');

                        if (jldw == dw) {
                            $("#" + rowid + "_ypjl").parent().next().children('select').append('<option value="1">' + jldw + '</option>');
                        }
                        else {
                            var dwlb = $("#" + rowid + "_dwlb").val(); //tồn tạiởĐơn vịLoạikhi，thaybảngđãtồn tạiởĐã chọncủaĐơn vị，trangmặtĐã chọn
                            var jldwlb = 1, dwdwlb = 4;
                            if (!!dwlb) {
                                if (jldwlb == dwlb) {
                                    jldwlb = 4, dwdwlb = 1;
                                }
                            }
                            if (!!jldw) {
                                $("#" + rowid + "_ypjl").parent().next().children('select').append('<option value="' + jldwlb + '">' + jldw + '</option>');
                            }
                            if (!!dw) {
                                $("#" + rowid + "_ypjl").parent().next().children('select').append('<option value="' + dwdwlb + '">' + dw + '</option>');
                            }
                            $("#" + rowid + "_ypjl").parent().next().children('select').val(dwlb);
                        }
                    }
                });
                //Ẩngridthanh cuộn dưới cùng
                $gridTake.closest(".ui-jqgrid-bdiv").css({ "overflow-x": "hidden" });
            }
        });

        //Nút tùy chỉnh
        $gridTake.navGrid('#gridTakePager',
            { edit: false, add: false, del: false, search: false, refresh: false, view: false, position: "left", cloneToTop: false })
            .navButtonAdd('#gridTakePager',
            {
                buttonicon: "glyphicon glyphicon-new-window",
                title: "Chi tiết mới",
                caption: "Chi tiết mới",
                position: "first",
                onClickButton: function () {
                    newWMPresData();
                },
            })

        //Menu cấp 2
        $gridTake.jqGrid('setGroupHeaders', {
            useColSpanStyle: true,
            groupHeaders: [
                {
                    startColumnName: 'ypjl',
                    numberOfColumns: 2,
                    titleText: 'Mỗi lầnLiều lượng'
                }]
        });
    }

    //Khởi tạo lớp nổi
    function initWMInlineFunc(rowid) {
        //Một số cột chỉ đọc
        $("#" + rowid + "_ypgg").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_dw").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_zydw").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_pcmc").attr('readonly', 'true');
        $("#" + rowid + "_sl").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_zxzqdw").parent().next().children('select').html('');
        $("#" + rowid + "_zxzqdw").parent().next().children('select').append('<option value="1">Số ngày</option><option value="0">Thuốc mang theoTổng lượng</option>');
        var yldwval = $("#" + rowid + "_yldwwwwwww").val();
        if (!!yldwval) {
            $("#" + rowid + "_zxzqdw").parent().next().children('select').val(yldwval);
        } else {
            $("#" + rowid + "_zxzqdw").parent().next().children('select').val("0");
            $("#" + rowid + "_yldwwwwwww").val("0");
            //Vô hiệu hóa
            $("#" + rowid + "_yl").css('background-color', '#f6f7fb').attr('readonly', 'true');
            $("#" + rowid + "_yl").val("");
            //Kích hoạt
            $("#" + rowid + "_sl").css('background-color', 'white').removeAttr('readonly');
        }
            //Lớp nổi thuốc  //Thuốc Đông yThuốc Tây sẽtrùng lặpsao ‘"#" + rowid + "_xmmc"’
        $("#" + rowid + "_xmmc").sfxmFloatingSelector({
            djDecimalPlaces: 4,
                //leftshift: 150,
                showgg: true,
                searchType: "yp.kc",
                ajaxparameters: function ($thisinput) {
                    return "mzzybz=2&dllb=1&keyword=" + $.trim($thisinput.val());
                },
                itemdbclickhandler: function ($this) {
                    $("#" + rowid + "_xmmc").val($this.attr('data-sfxmmc'));
                    $("#" + rowid + "_xmdm").val($this.attr('data-sfxmCode'));
                    $("#" + rowid + "_ypgg").val($this.attr('data-gg'));
                    $("#" + rowid + "_redundant_jldw").val($this.attr('data-jldw'));
                    $("#" + rowid + "_dw").val($this.attr('data-dw'));
                    $("#" + rowid + "_jlzhxs").val($this.attr('data-jldwzhxs'));
                    $("#" + rowid + "_zyzhxs").val($this.attr('data-cls'));
                    $("#" + rowid + "_zydw").val($this.attr('data-dw'));
                    $("#" + rowid + "_zxksdm").val($this.attr('data-yfbmCode'));
                    $("#" + rowid + "_qzfs").val($this.attr('data-zyqzlx') == "1" ? "day" : "times"); 
                    //cách tìm phần tử nàyPhương phápkhông nên dùng，nhưng doselectKhông cóidThuộc tính
                    var jldw = $this.attr('data-jldw');    //Đơn vị liều
                    var dw = $this.attr('data-dw');     //Đơn vị nhập viện
                    $("#" + rowid + "_ypjl").parent().next().children('select').html('');
                    if (jldw == dw) {
                        $("#" + rowid + "_ypjl").parent().next().children('select').append('<option value="1">' + jldw + '</option>');
                    }
                    else {
                        if (!!jldw) {
                            $("#" + rowid + "_ypjl").parent().next().children('select').append('<option value="1">' + jldw + '</option>');
                        }
                        if (!!dw) {
                            $("#" + rowid + "_ypjl").parent().next().children('select').append('<option value="4">' + dw + '</option>');
                        }
                    }
                    //Khởi tạoĐơn vịvàĐơn vịLoạicủaGiá trị，KhôngthìKhông cóGiá trịtruyềnđếnmáy chủ
                    //Mặc địnhĐơn vị liều，khôngtồn tạiởĐơn vị liều，Mặc địnhĐơn vị nhập viện，đềukhôngtồn tạiở，khôngGán giá trị
                    if (!!jldw) {
                        $("#" + rowid + "_dwwwwwww").val(jldw);
                        $("#" + rowid + "_dwlb").val("1");
                    } else if (!!dw) {
                        $("#" + rowid + "_dwwwwwww").val(dw);
                        $("#" + rowid + "_dwlb").val("4");
                    }
                }
            });
        //Lớp nổi tần suất
        $("#" + rowid + "_pcmc").pcFloatingSelector({
            showtext: 'yzpcmc',
            attrcols: ['yzpcmc', 'yzpcCode', 'zxcs', 'zxzq', 'zxzqdw'],
            isinputchangetriggered: false,
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_pcmc").val($this.attr('data-yzpcmc'));
                $("#" + rowid + "_pcCode").val($this.attr('data-yzpcCode'));
                $("#" + rowid + "_zxcs").val($this.attr('data-zxcs'))
                $("#" + rowid + "_zxzq").val($this.attr('data-zxzq'))
                $("#" + rowid + "_zxzqdw").val($this.attr('data-zxzqdw'));
                caltakesl(rowid);
            }
        });

        //Cách dùnglớp nổi
        $("#" + rowid + "_yfmcval").yfFloatingSelector({
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_yfmcval").val($this.attr('data-yfmc'));
                $("#" + rowid + "_ypyfdm").val($this.attr('data-yfCode'));
            }
        });

        $("#" + rowid + "_ypjl ,#" + rowid + "_yl").keyup(function () {
            caltakesl(rowid);
        });

        //Lớp nổi dặn dò
        $("#" + rowid + "_ztnr").ztFloatingSelector({
            height: 100,
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_ztnr").val($this.attr('data-ztmc'));
            },
        });
    }

      function caltakesl(rowid) {
        if ($("#" + rowid + "_yldwwwwwww").val() == "1") {//dùnglượngĐơn vịđợitạiSố ngàykhiTính toánTổng lượng，Khôngthìkhôngquản
            //0 biểu thịTổng lượngĐơn vị，khôngdùngTính toán。1 biểu thịSố ngàyĐơn vị，Tính toánTổng lượng
            var yldwval = $("#" + rowid + "_yldwwwwwww").val();
            var yl = $("#" + rowid + "_yl").val();
            if (yldwval == "0") {
                if (isNaN(yl) || yl == "") {

                } else {
                    $("#" + rowid + "_sl").val(yl);
                }
            } else {
                var jlzhxs = $("#" + rowid + "_jlzhxs").val();
                var zyzhxs = $("#" + rowid + "_zyzhxs").val();
                var ypjl = $("#" + rowid + "_ypjl").val();
                var dwlb = $("#" + rowid + "_dwlb").val();
                var zxcs = $("#" + rowid + "_zxcs").val();
                var zxzq = $("#" + rowid + "_zxzq").val();
                var zxzqdw = $("#" + rowid + "_zxzqdw").val();
                var qzfs = $("#" + rowid + "_qzfs").val();
                if (isNaN(jlzhxs) || jlzhxs == "") {
                    //$.modalAlert("thiếuHệ số chuyển đổi liều", 'warning');
                    return;
                } else if (isNaN(zyzhxs) || zyzhxs == "") {
                    //$.modalAlert("thiếuNhập việnchuyểnđổihệsố", 'warning');
                    return;
                } else if (isNaN(ypjl) || ypjl == "") {
                    //$.modalAlert("Thiếu liều lượng", 'warning');
                    return;
                } else if (isNaN(dwlb) || dwlb == "") {
                    //$.modalAlert("Thiếu đơn vịLoại", 'warning');
                    return;
                } else if (isNaN(zxcs) || zxcs == "") {
                    //$.modalAlert("thiếuThực hiện lầnsố", 'warning');
                    return;
                } else if (isNaN(zxzq) || zxzq == "") {
                    //$.modalAlert("thiếuThực hiệnchu kỳ", 'warning');
                    return;
                } else if (isNaN(zxzqdw) || zxzqdw == "") {
                    //$.modalAlert("thiếuThực hiệnchu kỳĐơn vị", 'warning');
                    return;
                } else if (isNaN(yl) || yl == "") {
                    //$.modalAlert("thiếudùnglượng", 'warning');
                    return;
                } else {
                    var sl = getypsl(jlzhxs, zyzhxs, ypjl, dwlb, zxcs, zxzq, zxzqdw, yl,qzfs);
                    $("#" + rowid + "_sl").val(sl);
                }
            }
        }

    }
   //Tính toánTần suấtSố lượng
    function getpcsl(zxcs, zxzq, zxzqdw)
    {
        if (isNaN(zxzqdw) || zxzqdw=="") {
            $.modalAlert("Thực hiệnChu kỳĐơn vịkhông được để trống", 'error');
            return;
        }
        var rtnsl;
        switch (zxzqdw) {
            case "1":
                rtnsl = (zxcs / zxzq);
                break;
            case "2":
                rtnsl = (zxcs / zxzq) * 24;
                break;
            case "3":
                rtnsl = (zxcs / zxzq) * 24 * 60;
                break;
            case 4:
                rtnsl = 0;
                break;
        }
        return rtnsl;
    }

    //Tính toánThuốcSố lượng
    function getypsl(jlzhxs, zyzhxs, ypjl, dwlb, zxcs, zxzq, zxzqdw, ts,qzfs)
    {
        var zysl = 0;
        if (isNaN(dwlb) || dwlb == "") {
            $.modalAlert("Đơn vịLoạikhông được để trống", 'error');
            return;
        }
        var qzint = ypjl * ts;//Mặc địnhĐơn vị nhập viện ，khôngcầnchuyểnđổi
        if (dwlb == 1) {//Đơn vị liều chuyểnđổithànhĐơn vị liều
            qzint = (ypjl * ts / jlzhxs / zyzhxs);
        }
        if (qzfs == "day") {
            zysl = Number(Math.ceil(qzint * getpcsl(zxcs, zxzq, zxzqdw)));
        } else if (qzfs == "times") {
            zysl = Number(Math.ceil(qzint) * getpcsl(zxcs, zxzq, zxzqdw));
        }
        return zysl;
    }

    //Đơn thuốc mới Nút
    function newWMPresData() {
        var dataRow = {
            Id: Math.random().toString() + new Date().getMilliseconds(),
            action: getWMActionStr(),
            yzlx: @Html.Raw(((int)EnumYzlx.Cydy).ToString()),
        };
        $("#gridTake").jqGrid("addRowData", undefined, dataRow, "first");
    }

    //Xóa chi tiết
    function deleteWMRowData(selRowId) {
        if (!!selRowId) {
            $("#gridTake").jqGrid("delRowData", selRowId);
        }
    }

    function getWMActionStr() {
        return "<input class='btn btn-default btn-md btn_del' type='button' value='Delete' onclick='deleteWMRowData($(this).parent().parent().attr(\"id\"))'/>";
    }

    //Lưu
    function Save() {
        if (ValidateT()) {//kiểm traDữ liệu
            //Lấytất cả các dòngId，duyệt đểSửakhung ở trạng tháiLưuTrạng thái
            var rowIds = $("#gridTake").jqGrid('getDataIDs');

            for (var i = 0; i < rowIds.length; i++) {
                caltakesl(rowIds[i]);
                var saveResult = $("#gridTake").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);

                if (!saveResult) {
                    EnableMInlineEditBox();    //khởi động lạiKích hoạtSửa Khôngthì lần sau lầnSavekhisẽQuay lạifalse
                    return;   //Lưu thất bại，thìreturn
                }
            }
            var gridsfxmData = $("#gridTake").jqGrid('getRowData_AllLine', null, true);
            if (gridsfxmData.length < 1) {
                $.modalAlert("Hiện tạiKhông cóLưunội dung gói", 'warning');
            }
            $.each(gridsfxmData, function () {    //Bỏaction
                for (var i = 0; i < $(this).length; i++) {
                    delete $(this)[i].action;
                }
            });
            submitService(gridsfxmData);
        }
    }

    //Gửiđếnmáy chủ
    function submitService(gridmedicineData) {
        //bảng gói
        var mbObj = {
            Id: mbId,
            tcfw: $('#mblx').val(),//$.currentWindow().$('#current').attr('data-type'),
            tclx: @Html.Raw(((int)EnumYzlx.Cydy).ToString()),
            tcmc: $('#mbmc').val()
        }
        $.najax({
            url: "@Url.Action("Submit")",
            dataType: "json",
            data: { mbObj: mbObj, mbDetailList: gridmedicineData },
            type: "POST",
            loadingtext: "Đang lưu dữ liệu gói, vui lòng đợi trong giây lát...",
            success: function (data) {
                $.modalMsg("Lưu thành công", 'success');
                   if(!mbId && data.data){
                    mbId = data.data;
                    $.currentWindow().expandyzlx = @Html.Raw(((int)EnumYzlx.Cydy).ToString());
                   
                }
                $.currentWindow().$("#beveltabs a[id='current']").trigger('click');
                location.href = "/TemplateManage/DoctorServiceTemplate/TakeMedicineForm?mbId=" + mbId;
            }
        });
    }

    //kiểm tra
    function ValidateT() {
        //CóKhôngcóDữ liệu
        var data = $("#gridTake").jqGrid('getRowData_AllLine', null, true);
        if (data.length == 0) {
            $.modalAlert("Thiếu dữ liệu gói", 'warning');
            return false;
        }
        return true;
    }

    function Delete() {
        if (mbId == null || mbId == "") {
            $.modalAlert("Thiếu gói", "warning");
            return;
        }
            $.najax({
            url: "@Url.Action("Delete")",
            dataType: "json",
            data: { mbId: mbId},
            type: "POST",
            loadingtext: "Đang xóa dữ liệu gói, vui lòng đợi trong giây lát...",
            success: function (data) {
                $.modalMsg("Xóa thành công", 'success');
                $.currentWindow().$("#beveltabs a[id='current']").trigger('click');
                location.href = "/TemplateManage/DoctorServiceTemplate/TakeMedicineForm?mbId=";
            }
        });
    }
</script>



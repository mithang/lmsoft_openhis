@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "ItemForm";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    .ui-jqgrid .ui-jqgrid-btable tbody tr.jqgrow td {
        border: 1px solid #ddd;
    }

    #gridsfxmPager_center {
        display: none;
    }
    #linksfxm .ui-th-ltr, #linksfxm .ui-jqgrid .ui-jqgrid-htable th.ui-th-ltr {
        border: solid 1px #ddd;
    }
</style>
<link href="@MvcHelper.GetStaticResourceScriptUrl("~/Content/css/cispage.css", false)" rel="stylesheet" />
<script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/validate/jquery.validate.min.js")"></script>
<link href="@MvcHelper.GetStaticResourceScriptUrl("~/Content/css/wmgridmenu.css", false)" rel="stylesheet" />
<div id="linksfxm" style="width:100%;">
    <table id="gridsfxm"></table>
    <table id="gridsfxmPager"></table>
    @Html.Partial("_TemplateFooterAmt")
</div>

<script>
    var mbId = $.request("mbId");
    var localdata = [];
    var zje = [];
     var zlltext = ('@ViewBag.zzlconfig' == "" ? "Liều mỗi lần điều trị" : '@ViewBag.zzlconfig');
    $(function () {
        gridsfxm();

        $("#mblx").bindSelect({
            url: "/MedicalRecord/GetMbqxSelectJson",
        });

        if (mbId) {
            $.najax({
                url: "/DoctorManage/DoctorsAdvice/GetMBDetailByMainId",
                dataType: "json",
                data: { Id: mbId },
                type: "POST",
                success: function (localdata) {
                    if (localdata !== typeof (undefined) && localdata.length > 0) {
                        var zjeinit = 0.00;
                        $.each(localdata, function () {
                            this.action = getWMActionStr();
                        });
                        $("#gridsfxm").jqGrid('setGridParam', {
                            datatype: 'local',
                            data: localdata
                        }).trigger("reloadGrid");
                        $('#mblx').val(localdata[0].tcfw).trigger("change");
                        $('#mbmc').val(localdata[0].tcmc);
                        $("#spzje").html(parseFloat(zjeinit).toFixed(2));
                        var ids = $("#gridsfxm").getDataIDs();
                        $.each(ids, function () {
                            var sl = $("#" + this + "_ypjl").val();
                            var dj = $("#" + this + "_dj").val();
                            zje[this] = parseFloat(dj) * parseFloat(sl);
                            getgridTotalAmt("gridsfxm");
                        });
                    }
                }
            });
        }
    });

    function gridsfxm() {
        var $gridsfxm = $("#gridsfxm");
        $gridsfxm.jqGrid({
            datatype: 'local',
            data: localdata,
            height: $(window).height() - 200,
            //altRows: true,//Đổi màu xen kẽ dòng
            shrinkToFit: true,   //true:theo tỷ lệVDkhởi tạo độ rộng cột false:Sử dụngcolModelđộ rộng đã chỉ định
            autowidth: true,
            rownumbers: true,  //CóKhôngHiển thịSố thứ tự
            editurl: "clientArray",  //dòngSửakhông gửi lên máy chủGửiDữ liệu
            unwritten: false,
            colModel: [
                {
                    label: 'Id', name: 'Id', width: 120, editwidth: '81%', align: 'center', hidden: true
                },
                {
                    label: '<span class="required">*</span>Mục thu phí', name: 'xmmc', width: 230, editwidth: '100%', align: 'center', editable: true, editrules: { required: true }
                },
                { label: '<span class="required">*</span>Đơn vị', name: 'dw', width: 50, editwidth: '100%', align: "center", editable: true },
                { label: '<span class="required">*</span>Đơn giá', name: 'dj', width: 60, editwidth: '100%', align: "center", editable: true },
                { label: 'xmdm', name: 'xmdm', width: 100, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: 'dwjls', name: 'dwjls', editwidth: '100%', align: 'center', editable: true, hidden: true },
                {
                    label: '<span class="required">*</span>' + zlltext, name: 'ypjl', width: 90, editwidth: '100%', align: 'center', editable: true,
                    editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var cellval = $(this).val();
                                    if (cellval.replace(/(^\s*)|(\s*$)/g, "") == "") {
                                        $.modalAlert(zlltext +"để trống,Vui lòng xác nhận.", 'warning');
                                        return;
                                    }
                                    if (isNaN(cellval)) {
                                        $.modalAlert(zlltext +":Vui lòng nhập số", 'warning');
                                        $(this).val('')
                                        return;
                                    }
                                    if (parseInt(cellval) < 0) {
                                        $.modalAlert(zlltext + ":Lớn hơn0", 'warning');
                                        $(this).val('')
                                        return;
                                    }
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    calitemsl(rowid);
                                }
                            }
                        ]
                    }, editrules: { required: true }
                },
                { label: '<span class="required">*</span>Tần suất', name: 'pcmc', width: 80, editwidth: '100%', align: 'center', editrules: { required: true }, editable: true },
                { label: 'pcCode', name: 'pcCode', editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: 'zxcs', name: 'zxcs', editable: true, hidden: true },
                { label: 'zxzq', name: 'zxzq', editable: true, hidden: true },
                { label: 'zxzqdw', name: 'zxzqdw', editable: true, hidden: true },
                { label: 'Vị trí', name: 'bw', width: 80, editwidth: '100%', align: "center", editable: true, hidden: '@ViewBag.bwhide'=="false" ? undefined : true },
                { label: 'Tổng lượng', name: 'sl', editwidth: '100%', hidden: true, align: 'center', editable: true, editrules: { required: true } },
                { label: 'Dặn dò', name: 'ztnr',width: '@ViewBag.bwhide'=="false" ? 80 : 160, editwidth: '100%', align: 'center', editable: true },
                { label: 'Thao tác', name: 'action', width: 30, align: 'center' },
                { name: 'yzlx', hidden: true }],
            editinputwidthborder: false,    //CóKhôngcần viền Mặc địnhlàtrue
            editinputborderradius: false,   //CóKhôngcần bo tròn viền Mặc địnhtrue(có bo tròn)
            pager: "gridsfxmPager",
            loadComplete: function () {
                if (localdata && localdata.length == 0) {
                    newWMPresData();
                }
            },
            gridComplete: function () {
                var ids = $("#gridsfxm").getDataIDs();
                $.each(ids, function () {
                    $gridsfxm.jqGrid('editRow', this, true, initWMInlineFunc);  //editRow：MởSửachế độ initWMInlineFunc:Khởi tạolớp nổi

                    //chomỗi lầnĐơn vị liềuđiềnoption  (chỉcó thểnàysaoviếtđơn giảnphiếu，Mặc dùtôicũngBiếtnàydạngviếtkhôngtốt)
                    var jldw = $("#" + this + "_redundant_jldw").val();    //Đơn vị liều
                    var dw = $("#" + this + "_dw").val();     //Đơn vị ngoại trú
                    if (!!dw) {
                        //cách tìm phần tử nàyPhương phápkhông nên dùng，nhưng doselectKhông cóidThuộc tính
                        $("#" + this + "_mcjl").parent().next().children('select').html('');
                        if (jldw == dw) {
                            $("#" + this + "_mcjl").parent().next().children('select').append('<option>' + jldw + '</option>');
                        }
                        else {
                            if(!!jldw){
                                $("#" + this + "_mcjl").parent().next().children('select').append('<option>' + jldw + '</option>');
                            }
                            if(!!dw){
                                $("#" + this + "_mcjl").parent().next().children('select').append('<option>' + dw + '</option>');
                            }
                        }
                        selectedjldw = !!jldw ? jldw : dw;
                        if (selectedjldw) {
                            $($("#" + this + "_mcjl").parent().next().children('select')).val(selectedjldw).trigger('change')
                        }
                    }
                    //Ẩngridthanh cuộn dưới cùng
                    $gridsfxm.closest(".ui-jqgrid-bdiv").css({ "overflow-x": "hidden" });
                });

            }
        });

        //Menu cấp 2
        $gridsfxm.jqGrid('setGroupHeaders', {
            useColSpanStyle: true,
            groupHeaders: [
                {
                    startColumnName: 'xmmc',
                    numberOfColumns: 4,
                    titleText: 'Thông tin cơ bản'
                }, {
                    startColumnName: 'dwjls',
                    numberOfColumns: 7,
                    titleText: 'MụcCách dùng'
                }]
        });

        //Nút tùy chỉnh
        $gridsfxm.navGrid('#gridsfxmPager',
            { edit: false, add: false, del: false, search: false, refresh: false, view: false, position: "left", cloneToTop: false })
            .navButtonAdd('#gridsfxmPager',
            {
                buttonicon: "glyphicon glyphicon-new-window",
                title: "Chi tiết mới",
                caption: "Chi tiết mới",
                position: "first",
                onClickButton: function () {
                    newWMPresData();
                },
            })
    }

    //Khởi tạo lớp nổi
    function initWMInlineFunc(rowid) {
        //Một số cột chỉ đọc
        $("#" + rowid + "_dj").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_ypgg").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_dw").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_pcmc").attr('readonly', 'true');
        $("#" + rowid + "_je").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_dj").css('background-color', '#f6f7fb').attr('readonly', 'true');

        //Lớp nổi thuốc
        $("#" + rowid + "_xmmc").sfxmFloatingSelector({
            djDecimalPlaces: 4,
            //leftshift: 150,
            searchType: "sfxm",
            ajaxparameters: function ($thisinput) {
                return "mzzybz=2&dllb=2&keyword=" + $.trim($thisinput.val());
            },
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_xmmc").val($this.attr('data-sfxmmc'));
                $("#" + rowid + "_xmdm").val($this.attr('data-sfxmCode'));
                $("#" + rowid + "_dw").val($this.attr('data-dw'));
                $("#" + rowid + "_dwjls").val($this.attr('data-dwjls'));
                $("#" + rowid + "_dj").val($this.attr('data-dj'));
            }
        });

        //Lớp nổi tần suất
        $("#" + rowid + "_pcmc").pcFloatingSelector({
            showtext: 'yzpcmc',
            attrcols: ['yzpcmc', 'yzpcCode', 'zxcs', 'zxzq', 'zxzqdw'],
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_pcmc").val($this.attr('data-yzpcmc'));
                $("#" + rowid + "_pcCode").val($this.attr('data-yzpcCode'));
                $("#" + rowid + "_zxcs").val($this.attr('data-zxcs'))
                $("#" + rowid + "_zxzq").val($this.attr('data-zxzq'))
                $("#" + rowid + "_zxzqdw").val($this.attr('data-zxzqdw'));
                calitemsl(rowid);
            },
        });

        $("#" + rowid + "_ypjl").keyup(function () {
            calitemsl(rowid);
        });

        //Vị trílớp nổi
        $("#" + rowid + "_bw").bwFloatingSelector({
            showtext: 'bwmc',
            attrcols: ['bwmc', 'bwCode'],
            checkItemActivity: function ($li, $thisinput) {
                var selected = false;//Mặc địnhKhông cóĐã chọnhiện tạiGiá trị
                var selectval = $thisinput.val();
                if (selectval) {
                    selectval = selectval.split(',');
                    $.each(selectval, function () {
                        if (this == $li.html()) {
                            selected = true;
                        }
                    });
                }
                return selected;
            },
            itemdbclickhandler: function ($this) {
                var mcval = "";
                if (typeof ($this) !== "undefined") {
                    $.each($this, function () {
                        mcval += this.attr('data-bwmc') + ",";

                    });
                    if (mcval.length > 0) {
                        mcval = mcval.substring(0, mcval.length - 1);
                    };
                }
                $("#" + rowid + "_bw").val(mcval);
            },
        });

        //Lớp nổi dặn dò
        $("#" + rowid + "_ztnr").ztFloatingSelector({
            height: 100,
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_ztnr").val($this.attr('data-ztmc'));
            },
        });
    }

    function calitemsl(rowid) {
        //Số lượng đơn vị tính/Liều mỗi lần điều trị*Tần suất
        var dwjls = $("#" + rowid + "_dwjls").val();
        var mczll = $("#" + rowid + "_ypjl").val();
        var zxcs = $("#" + rowid + "_zxcs").val();
        var zxzq = $("#" + rowid + "_zxzq").val();
        var zxzqdw = $("#" + rowid + "_zxzqdw").val();
        var dj = $("#" + rowid + "_dj").val();

        if (isNaN(dwjls) || dwjls == "") {
            return;
        } else if (isNaN(mczll) || mczll == "") {
            return;
        } else if (isNaN(zxcs) || zxcs == "") {
            return;
        } else if (isNaN(zxzq) || zxzq == "") {
            return;
        } else if (isNaN(zxzqdw) || zxzqdw == "") {
            return;
        } else if (mczll !== "" && dwjls !== "" && (parseInt(dwjls) > parseInt(mczll))) {
            rowid = rowid.substring(3);
            $.modalAlert("Dòng thứ " + rowid + " " + zlltext + " không được nhỏ hơn số lượng tính theo đơn vị", "warning");
            $("#" + rowid + "_sl").val("");
            return false;
        } else {
            var sl = getItemsl(dwjls, mczll, zxcs, zxzq, zxzqdw);
            $("#" + rowid + "_sl").val(sl);

            if (parseFloat(mczll) > 0 && parseFloat(dj) > 0) {
                zje[rowid] = parseFloat(mczll) * parseFloat(dj);
                getgridTotalAmt("gridsfxm");
            }
        }
        return true
    }

    function getItemsl(dwjls, mczll, zxcs, zxzq, zxzqdw) {
        var qzint = Number(getpcsl(zxcs, zxzq, zxzqdw));
        return qzint * Math.floor(mczll / dwjls);
    }


    //Tính toánTần suấtSố lượng
    function getpcsl(zxcs, zxzq, zxzqdw) {
        if (isNaN(zxzqdw) || zxzqdw == "") {
            $.modalAlert("Thực hiệnChu kỳĐơn vịkhông được để trống", 'error');
            return;
        }
        var rtnsl;
        switch (zxzqdw) {
            case "1":
                rtnsl = (zxcs / zxzq);
                break;
            case "2":
                rtnsl = (zxcs / zxzq) * 24;
                break;
            case "3":
                rtnsl = (zxcs / zxzq) * 24 * 60;
                break;
            case 4:
                rtnsl = 0;
                break;
        }
        return rtnsl;
    }

    //Đơn thuốc mới Nút
    function newWMPresData() {
        var dataRow = {
            Id: Math.random().toString() + new Date().getMilliseconds(),
            action: getWMActionStr(),
            yzlx: @Html.Raw(((int)EnumYzlx.sfxm).ToString()),
        };
        $("#gridsfxm").jqGrid("addRowData", undefined, dataRow, "first");

    }

    //Xóa chi tiết
    function deleteWMRowData(selRowId) {
        if (!!selRowId) {
            $("#gridsfxm").jqGrid("delRowData", selRowId);
            getgridTotalAmt("gridsfxm");
        }
    }

    function getWMActionStr() {
        return "<input class='btn btn-default btn-md btn_del' type='button' value='Delete' onclick='deleteWMRowData($(this).parent().parent().attr(\"id\"))'/>";
    }

    //Lưu
    function Save() {
        if (ValidateI()) {//kiểm traDữ liệu
            //Lấytất cả các dòngId，duyệt đểSửakhung ở trạng tháiLưuTrạng thái
            var rowIds = $("#gridsfxm").jqGrid('getDataIDs');
            for (var i = 0; i < rowIds.length; i++) {
                if (calitemsl(rowIds[i])) {
                    var saveResult = $("#gridsfxm").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);

                    if (!saveResult) {
                        EnableIInlineEditBox();    //khởi động lạiKích hoạtSửa Khôngthì lần sau lầnSavekhisẽQuay lạifalse
                        return;   //Lưu thất bại，thìreturn
                    }
                } else {
                    return;
                }
            }
            var gridsfxmData = $("#gridsfxm").jqGrid('getRowData_AllLine', null, true);
            if (gridsfxmData.length < 1) {
                $.modalAlert("Hiện tạiKhông cóLưunội dung gói", 'warning');
            }
            $.each(gridsfxmData, function () {    //Bỏaction
                for (var i = 0; i < $(this).length; i++) {
                    delete $(this)[i].action;
                }
            });
            submitService(gridsfxmData);
        }
    }

    function Delete() {
        if (mbId == null || mbId == "") {
            $.modalAlert("Thiếu gói", "warning");
            return;
        }
            $.najax({
            url: "@Url.Action("Delete")",
            dataType: "json",
            data: { mbId: mbId},
            type: "POST",
            loadingtext: "Đang xóa dữ liệu gói, vui lòng đợi trong giây lát...",
            success: function (data) {
                $.modalMsg("Xóa thành công", 'success');
                $.currentWindow().$("#beveltabs a[id='current']").trigger('click');
                location.href = "/TemplateManage/DoctorServiceTemplate/ItemForm?mbId=";
            }
        });
    }

    //Gửiđếnmáy chủ
    function submitService(gridmedicineData) {
        //bảng gói
        var mbObj = {
            Id: mbId,
            tcfw: $('#mblx').val(),//$.currentWindow().$('#current').attr('data-type'),
            tclx: @Html.Raw(((int)EnumYzlx.sfxm).ToString()),
            tcmc: $('#mbmc').val()
        }
        $.najax({
            url: "@Url.Action("Submit")",
            dataType: "json",
            data: { mbObj: mbObj, mbDetailList: gridmedicineData },
            type: "POST",
            loadingtext: "Đang lưu dữ liệu gói, vui lòng đợi trong giây lát...",
            success: function (data) {
                $.modalMsg("Lưu thành công", 'success');
                   if(!mbId && data.data){
                    mbId = data.data;
                    $.currentWindow().expandyzlx = @Html.Raw(((int)EnumYzlx.sfxm).ToString());
                    
                }
                $.currentWindow().$("#beveltabs a[id='current']").trigger('click');
                location.href = "/TemplateManage/DoctorServiceTemplate/ItemForm?mbId=" + mbId;
            }
        });
    }

    //kiểm tra
    function ValidateI() {
        //CóKhôngcóDữ liệu
        var data = $("#gridsfxm").jqGrid('getRowData_AllLine', null, true);
        if (data.length == 0) {
            $.modalAlert("Thiếu dữ liệu gói", 'warning');
            return false;
        }
        return true;
    }


</script>



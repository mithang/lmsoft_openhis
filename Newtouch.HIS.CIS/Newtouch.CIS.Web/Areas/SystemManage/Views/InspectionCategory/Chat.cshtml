<!--jQuerykhoCóphảicầncủa,Mặc địnhtình hìnhdướiở_Layout.cshtmldẫndùng. -->
<!--dẫndùngSignalRkho. -->
<!-- ASP.NET Core SignalR client (port of the old jquery.signalR 2.x proxy). Hub route: /signalr (ChatHub). -->
<script src="/js/signalr.min.js"></script>
<script>
    $(function () {
        // ASP.NET Core SignalR: ChatHub at /signalr, server event addNewMessageToPage.
        var connection = new signalR.HubConnectionBuilder().withUrl("/signalr").build();

        // địnhnghĩaphụcvụdụng cụđầugọicủakhách hàngđầuaddNewMessageToPageđếnchỗlýnhậnthuđếncủahủytin.
        connection.on("addNewMessageToPage", function (name, message) {
            if (name == $('#displayname').val()) {
                $('#discussion').append('<li class="msgright"><p class="touxiangright">' + htmlEncode(name)+'</p><p class="msgcardright">' + htmlEncode(message) + '</p></li >');
            }
            else {
                $('#discussion').append('<li class="msgleft"><p class="touxiangleft">' + htmlEncode(name) +'</p><p class="msgcardleft">' + htmlEncode(message) + '</p></li >');
            }
            // sẽhủytinThêmđếnultrên.
            //$('#discussion').append('<li class="msgleft"><p class="msgcardleft>' + htmlEncode(name)+htmlEncode(message)
            //    + '</p></li>');
        };

        // LấyNgười dùngtên.
        $('#displayname').val(prompt('Vui lòng nhập tên của bạn:', ''));

        // Cài đặttiêu điểmđiểmđếnnhậpkhung.
        $('#message').focus();

        // Bắt đầuLiên kếtphụcvụdụng cụ，Liên kếtthành côngsaulàGửiNútLưu ýsáchclicksự kiện.
        connection.start().then(function () {
            $('#sendbtn').click(function () {
                // gọiphụcvụdụng cụđầutậpđườngdụng cụcủaSendPhương pháp.
                connection.invoke("Send", $('#displayname').val(), $('#message').val());
                // Xóa trắngnhậpkhungthông tinvàLấytiêu điểmđiểm.
                $('#message').val('').focus();
            });
        });
    });

    // nàycó thểchọncôngcó thểsẽhtml-encodeshủytinHiển thịởtrangmặttrên.
    function htmlEncode(value) {
        var encodedValue = $('<div />').text(value).html();
        return encodedValue;
    }
</script>

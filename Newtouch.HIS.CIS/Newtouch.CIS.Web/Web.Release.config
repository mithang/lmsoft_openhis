<?xml version="1.0" encoding="utf-8"?>

<!-- Về việc sử dụng web.config Để biết chi tiết về việc chuyển đổi, vui lòng truy cập http://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Trong ví dụ dưới đây,“SetAttributes”Việc chuyển đổi sẽ thay đổi 
    “connectionString”giá trị, để chỉ trong“Match”bộ định vị 
    tìm giá trị là“MyDB”đặc tính“name”khi đó sử dụng“ReleaseSQLServer”。
    
    <connectionStrings>
      <add name="MyDB" 
        connectionString="Data Source=ReleaseSQLServer;Initial Catalog=MyReleaseDB;Integrated Security=True" 
        xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
    </connectionStrings>
  -->
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <!--
      
      Trong ví dụ dưới đây,“Replace”Việc chuyển đổi sẽ thay thế 
      web.config toàn bộ của tệp <customErrors> mục.
      Xin lưu ý, vì 
      tại <system.web> dưới nút chỉ có một customErrors mục, vì vậy không cần sử dụng“xdt:Locator”đặc tính.
      
      <customErrors defaultRedirect="GenericError.htm"
        mode="RemoteOnly" xdt:Transform="Replace">
        <error statusCode="500" redirect="InternalError.htm"/>
      </customErrors>
    -->
  </system.web>
</configuration>
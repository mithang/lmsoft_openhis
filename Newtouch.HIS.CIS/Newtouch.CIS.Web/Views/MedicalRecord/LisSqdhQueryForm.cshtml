@{
    ViewBag.Title = "Xét nghiệmPhiếu";
    Layout = "~/Views/Shared/_Form.cshtml";
    var pacsHost = SiteUrl.GetUrl("OuterPacsServiceHost", "");
    var YjzxRportSwith = SysConfigReader.String("openYjzxSwitch");//kỹ thuật y họcQuản lýcôngcó thểCông tắc --báo cáoTải lênphươngkiểu
    var curOpr = NewtouchHIS.Lib.Framework.Operator.OperatorProvider.GetCurrent();
}

<form id="formPatSer" style="margin:2px;margin-top:10px;">
    <div class="gridPanel">
        <div>
            <table class="form">
                <tr>
                    <th class="formTitle">PhiếuThời gianPhạm vi:</th>
                    <td class="formValue" colspan="2">
                        <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:30%;  float:left;" value="@DateTime.Now.ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                        <span style="margin-left:1%;float:left">—</span>
                        <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:30%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                    </td>
                    <th class="formTitle">Tên bộ mẫu:</th>
                    <td class="formValue">
                        <input id="ztmc" type="text" class="form-control" placeholder="Tên bộ mẫu" />
                    </td>
                    <td class="formValue">
                        &nbsp;&nbsp;
                        <input type="button" id="btn_search" class="btn btn-primary" value=" Tra cứu " />
                        @*<a href="~/File/LisApp.rar">LisApp</a>*@
                    </td>
                </tr>
            </table>
        </div>
        <table id="gridList" rel="formPatSer"></table>
        <div id="gridPager" style="padding-right:20%"></div>
    </div>
</form>
<script lang="javascript">
    var mzzyh = $.request("mzzyh");
    var type = $.request("type");
    $(function () {
        gridList();
    })

    $('#btn_search').click(function () {
        //$("#gridList").clearGridData();
        var kssj = $('#kssj').val();
        var jssj = $('#jssj').val() + " 23:59:59";
        var ztmc = $('#ztmc').val();
        $("#gridList").jqGrid('setGridParam', {
            postData: { mzzyh: mzzyh, type: type, ztmc: ztmc, kssj: kssj, jssj: jssj },
        }).trigger('reloadGrid'); //lạitảihiện tạibảngô
    });

    function gridList() {
        var kssj = $('#kssj').val();
        var jssj = $('#jssj').val() + " 23:59:59";
        var ztmc = $('#ztmc').val();
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/MedicalRecord/GetLisSqdhGridJson",
            autowidth: false,
            postData: { mzzyh: mzzyh, type: type, ztmc: ztmc, kssj: kssj, jssj: jssj },
            width: $("#formPatSer").width()-10,
            height: $(window).height() - 120,
            colModel: [
                { label: 'Họ tên', name: 'xm', align: 'left', hidden: true},
                //{ label: 'Giới tính', name: 'xb', align: 'left', hidden: true },
                { label: 'Số phiếu', name: 'lissqdh', align: 'left', width:'200px' },
                { label: 'Tên bộ mẫu', name: 'ztmc', align: 'left', width: '240px' },
                { label: 'Đề nghịThời gian', name: 'sqsj', align: 'left', width: '150px' },
                { label: 'PhiếuTrạng thái', name: 'syncStatus', align: 'left', width: '80px' },
                { label: 'blh', name: 'blh', hidden: true },
               //{ label: 'ztId', name: 'ztId', hidden: true },
               //{ label: 'Tổng số tiền', name: 'zje' ,align: 'left'}
                {
                    label: "Thao tác", name: "", align: "center", width: 100,
                    formatter: function (cellvalue, options, rowobject) {
                        return "<a href=\#\" onclick='recall(\"" + rowobject.lissqdh + "\",\"" + rowobject.syncStatus + "\",\"" + rowobject.blh + "\")'' title='lisBáo cáo' style='text-decoration: none;color: #dd4b39;cursor: pointer;'>XemBáo cáo</a>";
                    }
                }
            ],
            pager: "#gridPager",
            sortname: 'sqsj desc',
            viewrecords: true
        });
    }

    function recall(lissqdh, syncStatus, blh) {
        if ("@YjzxRportSwith" == "ON") {
            $.modalOpen({
                id: "ApplyFormUpload",
                title: "Xem trước báo cáo",
                url: "/NurseManage/OrderExecution/ApplyFormUpload?sqdh=" + lissqdh+"&query=true",
                width: "900px",
                height: "700px",
                btn: null
            });
        } else {
            if (syncStatus != "Đã hoàn thành") {
                $.modalAlert("Trạng thái hiện tại không phải đã hoàn thành nên không thể xem báo cáo", 'warning');
                return;
            } else {
                //Jinfeng Yitong LIS 2024-4-28
                window.open("@pacsHost/doctor-api/api/viewer?type=1&pid=" + blh + "&areaCode=" + "@curOpr.OrganizeId", "_blank");
                //$.ajax({
                //    url: "http://127.0.0.1:22228/api/CQSmartCheck/GetLisReport",//lisbáo cáo
                //    dataType: "json",
                //    data: { type: type, brxx_id: lissqdh },
                //    type: "POST",
                //    async: true,
                //    success: function (ajaxdata) { }
                //});
            }
        }       
    }

    function btn_editbak() {
        var $gridList = $("#gridList");
        if ($gridList.jqGridRowValue().syncStatus != "Đã hoàn thành") {
            $.modalAlert("Trạng thái hiện tại không phải đã hoàn thành nên không thể xem báo cáo", 'warning');
            return;
        } else {
            
            $.ajax({
                url: "http://127.0.0.1:22228/api/CQSmartCheck/GetLisReport",//lisbáo cáo
                dataType: "json",
                data: { type: type, brxx_id: $gridList.jqGridRowValue().lissqdh },
                type: "POST",
                async: true,
                success: function (ajaxdata) { }
            });
        }
    }
</script>

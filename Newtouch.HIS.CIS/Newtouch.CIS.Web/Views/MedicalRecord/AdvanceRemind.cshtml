
@{
    ViewBag.Title = "Lập đơn thuốc(Y lệnh)Nhắc nhở trước";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script type="text/javascript">
    var sqtxdata = [];
    $(function () {
        sqtxdata = JSON.parse(sessionStorage.getItem('sqtxdataList'));
        gridList();
    });
    function gridList() { 
        var $gridList = $("#gridList");
        $gridList.jqGrid({
            datatype: 'local',
            data: sqtxdata,
            height: $(window).height() - 80,
            shrinkToFit: false,   //true:Khởi tạo chiều rộng cột theo tỷ lệ false:Sử dụngcolModelchiều rộng đã chỉ định
            autowidth: true,
            rownumbers: false,  //Có hiển thị số thứ tự không
            unwritten: false,
            colModel: [
                { label: 'Số đơn thuốc', name: 'AKC220', width: 80, align: 'center' },
                { label: 'Thuốc/Mã hạng mục', name: 'AKE001', width: 80, align: 'center' },
                { label: 'Thuốc bảo hiểm y tế/Tên hạng mục', name: 'AKE002', width: 120, align: 'center' },
                { label: 'Tên quy tắc vi phạm', name: 'BZE868', width: 80, align: 'center'},
                { label: 'Giải thích vi phạm', name: 'AAE013', width: 150, align: 'center' },
                {
                    label: 'Cấp độ vi phạm', name: 'BAZ969', width: 60, align: 'center', formatter: function (cellvalue) {
                        return cellvalue == '01' ? '严重' : (cellvalue=='02' ? '警告':'提示')
                    }
                },
                {
                    label: 'Cấp độ hạn chế', name: 'BAZ970', width: 60, align: 'center', formatter: function (cellvalue) {
                        if(cellvalue=='1'){
                            return '禁忌';
                        } else if (cellvalue=='2')
                        {
                            return '不推荐';
                        } else if (cellvalue == '3') {
                            return '慎用';
                        } else if (cellvalue == '4') {
                            return '关注';
                        } else if (cellvalue == '5') {
                            return '安全';
                        }
                        else {
                            return cellvalue;
                        }
                    }
                }
            ]
        });
    };
</script>




@{
    ViewBag.Title = "KêĐơn thuốc(Y lệnh)Nhắc trước";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script type="text/javascript">
    var sqtxdata = [];
    $(function () {
        sqtxdata = JSON.parse(sessionStorage.getItem('sqtxdataList'));
        gridList();
    });
    function gridList() { 
        var $gridList = $("#gridList");
        $gridList.jqGrid({
            datatype: 'local',
            data: sqtxdata,
            height: $(window).height() - 80,
            shrinkToFit: false,   //true:theo tỷ lệVDkhởi tạo độ rộng cột false:Sử dụngcolModelđộ rộng đã chỉ định
            autowidth: true,
            rownumbers: false,  //CóKhôngHiển thịSố thứ tự
            unwritten: false,
            colModel: [
                { label: 'Số đơn thuốc', name: 'AKC220', width: 80, align: 'center' },
                { label: 'Thuốc/MụcMã', name: 'AKE001', width: 80, align: 'center' },
                { label: 'Bảo hiểm y tếThuốc/Tên mục', name: 'AKE002', width: 120, align: 'center' },
                { label: 'Tên quy tắc vi phạm', name: 'BZE868', width: 80, align: 'center'},
                { label: 'Vi phạmMô tả', name: 'AAE013', width: 150, align: 'center' },
                {
                    label: 'Vi phạmCấp độ', name: 'BAZ969', width: 60, align: 'center', formatter: function (cellvalue) {
                        return cellvalue == '01' ? 'Nghiêm trọng' : (cellvalue=='02' ? 'Cảnh báo':'Nhắc nhở')
                    }
                },
                {
                    label: 'Cấp độ hạn chế', name: 'BAZ970', width: 60, align: 'center', formatter: function (cellvalue) {
                        if(cellvalue=='1'){
                            return 'Chống chỉ định';
                        } else if (cellvalue=='2')
                        {
                            return 'Không khuyến nghị';
                        } else if (cellvalue == '3') {
                            return 'Thận trọng';
                        } else if (cellvalue == '4') {
                            return 'Theo dõi';
                        } else if (cellvalue == '5') {
                            return 'An toàn';
                        }
                        else {
                            return cellvalue;
                        }
                    }
                }
            ]
        });
    };
</script>



	var url = '@dzcfUrl';
	//Tải lên đơn thuốc điện tử
	function dzcfsc(type,cfh) {
		var upload = '';
		var errorCode = '';
		$.ajax({
			url: url+"prescription/rest/prescription/uploadep?cfh=" + cfh,
			type: "GET",
			dataType: "json",
			//data: { cfh: cfh },
			async: true,
			success: function (ret) {
				upload = ret.status;
				//console.log(ret);
				if (upload == 'Success') {
					$.modalAlert("Gửi thành công", 'success');
					updateSendtohisResult(type, cfh);
				} else {
					errorCode = ret.errorCode;
					$.modalAlert("Gửi thất bại" + errorCode, 'error');
					//return "Lưu thất bại,Lý do thất bại là:" + errorCode + "。";
				}
			}
		});

	}

	//Hủy đơn thuốc điện tử và xóa
	function dzcfcx(type,cfh, cfid) {

		$.modalOpen({
			id: "dzcfcxForm",
			title: "Lý do hủy đơn thuốc điện tử",
			url: "/MedicalRecord/dzcfcxForm",
			width: "600px",
			height: "300px",
			callBack: function (iframeId) {
				var mbObj = top.frames[iframeId].submitForm();
				$.modalClose("dzcfcxForm");
				if (mbObj != null && mbObj != undefined) {
					var upload = '';
					var errorCode = '';
					$.ajax({
						url: url+"prescription/rest/prescription/cancel",
						type: "POST",
						dataType: "json",
						contentType:"application/json;charset=UTF-8",
						data: JSON.stringify({ cfh: cfh, reason: mbObj.zfyy }),
						async: false,
						success: function (ret) {
							upload = ret.status;
							if (upload == 'Success') {
								$.modalAlert("Hủy thành công", 'success');
								removeCfFromWindowAlldataArray(type, cfid);
							} else {
								errorCode = ret.errorCode;
								$.modalAlert("Hủy thất bại" + errorCode, 'error');
								//return "Lưu thất bại,Lý do thất bại là:" + errorCode + "。";
							}
						}
					});
				}
			}
		});

	}


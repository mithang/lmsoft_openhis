        if(typeFlag == "historynodeContent"){   //Kết thúcKhám bệnhcủaHồ sơnội dung
            newdataArray = window.historydataArray;
            $newtableKfmx = $('#tableNC_KfMx');
            $newtableCgxmmx = $('#tableNC_CgxmMx');
            $newtableXymx = $('#tableNC_XyMx');
            $newtableYyhcmx = $('#tableNC_Yyhcmx');
            $newtableZymx = $('#tableNC_ZyMx');
            $newtableJymx = $('#tableNC_JyMx');
			$newtableJcmx = $('#tableNC_JcMx');
			$newtableDzCfMx = $('#tableNC_DzCfMx');
        }
        else{
            newdataArray = window.alldataArray;
            $newtableKfmx = $('#tableKfMx');
            $newtableCgxmmx = $('#tableCgxmMx');
            $newtableYyhcmx = $('#tableYyhcMx');
            $newtableXymx = $('#tableXyMx');
            $newtableZymx = $('#tableZyMx');
            $newtableJymx = $('#tableJyMx');
			$newtableJcmx = $('#tableJcMx');
			$newtableDzCfMx = $('#tableDzcfMx');
        }
        if (newdataArray && Object.keys(newdataArray)) {
            //alldataArray :[kfcf:[{cfh：‘Đơn thuốc1’，xmmc：‘’},{cfh：‘Đơn thuốc2’，xmmc：‘’}，{cfh：‘Đơn thuốc1’，xmmc：‘’}]]
            //1.duyệttất cảDữ liệu
            $.each(Object.keys(newdataArray), function () {    //Object.keys(newdataArray):["kfcf"]
                var itemsKey = String(this);      //String(Object.keys(newdataArray):["kfcf"]) : kfcf
                //2.Theomỗicáitìmdẫntìmđếncủa nótương ứngcủaValue（valueCómộtsốnhóm，sốnhómtrongCónhiềucáiđối tượng）
                var itemsMxArr = newdataArray[String(this)];    //itemsMxArr lấyrakeylàkfcfcủatất cảchi tiết
                // 3.1.1tìmđếnkeyCóKhônglàPhục hồi chức năngĐơn thuốc
                if (itemsKey == "kfcf") {
                    $newtableKfmx.html('');   //Xóa trắng trướchtml
                    var typeClassificationArr = new Array();
                    for (var i = 0; i < itemsMxArr.length; i++) {
                        var cfh = itemsMxArr[i].cfh;
                        //3.3 kiểm traPhân loạisốnhómCóKhôngtồn tạiởSố đơn thuốc
                        var existPres = $.jsonWhere(typeClassificationArr, function (v) {
                            return v && v.cfh == cfh;
                        });
                        //3.3.1 nếutồn tạiở，thìpushSố đơn thuốcphía dướicủaĐơn thuốcchi tiết
                        if (existPres && existPres.length && existPres.length == 1) {
                            continue;
                        }
                        else {
                            let JeArray = {};
                            itemsMxArr.forEach(item => {
                                if (!JeArray[item.cfh]) {
                                    JeArray[item.cfh] = [];
                                }
                                JeArray[item.cfh].push(item);
                            });

                            var JeArrays = new Array();

                            for (const groupKey in JeArray) {
                                if (JeArray.hasOwnProperty(groupKey)) {
                                    const itemArray = JeArray[groupKey];
                                    for (const items in itemArray) {
                                        const itemsDetails = itemArray[items];
                                        if (itemsMxArr[i].cfh == itemsDetails.cfh)
                                            JeArrays = itemArray; break;
                                    }
                                    if (JeArrays.length > 0) break;
                                }
                            }
                            let toJe = "";
                            if (JeArrays.length > 0) toJe = JeArrays.reduce((prev, items) => { return prev += parseFloat(items.je) }, 0).toFixed(2);
                            //3.3.2 nếukhôngtồn tạiở，thìpush
                            typeClassificationArr.push({ cfId: itemsMxArr[i].cfId
                                ,cfh: itemsMxArr[i].cfh
                                ,klrq: itemsMxArr[i].klrq
                                ,sfbz: itemsMxArr[i].sfbz
                                ,sendtohisResult: itemsMxArr[i].sendtohisResult
                                ,cfzhdysj: itemsMxArr[i].cfzhdysj
                                , zldzhdysj: itemsMxArr[i].zldzhdysj
                                , tbz: itemsMxArr[i].tbz
                                , je: toJe
                            });
                        }

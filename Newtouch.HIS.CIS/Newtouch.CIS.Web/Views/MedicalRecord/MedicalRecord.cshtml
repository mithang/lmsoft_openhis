@using Newtouch.Infrastructure;

@{
    ViewBag.Title = "Bệnh án";//Bệnh án ngoại trú
    // T-02 (sua RS-01/RS-02): xem ghi chu tuong tu o PatientList.cshtml.
    // O che do partial trong MainBusiness (ViewData CisEmbeddedPartial=true)
    // Layout=null de khong render long tai lieu _Index va khong nap lai
    // jQuery (lam mat plugin treeview/validate cua trang cha).
    Layout = (ViewData["CisEmbeddedPartial"] as bool?) == true ? null : "~/Views/Shared/_Index.cshtml";

    var pacsHost = SiteUrl.GetUrl("OuterPacsServiceHost", "");
    var isPrintRehabPres = (ViewBag.ISPrintRehabPres as bool?) ?? false;
    var isPrintRehabTreatment = (ViewBag.ISPrintRehabTreatment as bool?) ?? false;
    //hợplýdùngthuốcgiao diện
    var isOpenRationalUse = (ViewBag.isOpenRationalUse); //CóKhôngbậthợplýdùngthuốcPhê duyệtgiao diện

    //Công tắc：Có mở khôngXét nghiệmKiểm tra
    var IsOpenJyJcSwitch = ViewBag.IsOpenJyJcSwitch as bool?;
    //Công tắc：Ngoại trúCó mở khôngPhục hồi chức năngĐơn thuốc
    var isOpenKfcf = (ViewBag.ISOpenKfcf as bool?);
    //Công tắc：Ngoại trúCó mở khôngHạng mục thông thườngĐơn thuốc
    var isOpenCgxmcf = (ViewBag.ISOpenCgxmcf as bool?);
    //Công tắc：Ngoại trúCó mở khôngydùngVật tư tiêu haoĐơn thuốc
    var iSOpenWzhc = (ViewBag.ISOpenWzhc as bool?);
    //Công tắc：CóKhôngbậtnhắc trước
    var iSReminderBeforehand = SysConfigReader.Bool("IS_ReminderBeforehand", false).Value;

    //LấyInĐơn thuốccấu hình
    var mzcfdPrinturl = SysConfigReader.OrgReportLink("mzcfdPrint");  //Đơn thuốc
    var mzzcycfPrint = SysConfigReader.OrgReportLink("mzzcycfPrint");  //trongthảo dượcĐơn thuốc
    var mzjyjcPrinturl = SysConfigReader.OrgReportLink("jcjyPrint");//Xét nghiệmKiểm traphiếu
    var mzjcPrinturl = SysConfigReader.OrgReportLink("jcPrint");//Kiểm traKiểm traphiếu
    var mzwhdPrinturl = SysConfigReader.OrgReportLink("whdPrint");//khí dungphiếu
    var mzzszPrinturl = SysConfigReader.OrgReportLink("mzzszPrint");//Lưu ýxạphiếu zszPrint
    var mzjzdPrinturl = SysConfigReader.OrgReportLink("jzdPrint");//Khám bệnhphiếu
    var mzcgcfPrinturl = SysConfigReader.OrgReportLink("mzcgcfPrint");//Ngoại trúHạng mục thông thườngĐơn thuốc
    var optionItem = SysConfigReader.String("Outpatient_patient_reg_optionItem"); //khôngbắt buộc mục
    var exelink_pacs = ViewBag.exelink_pacs;

    //xatrìnhy tế
    var OrganizeCodeSd = ViewBag.OrganizeCodeSd;
    var RemoteTreatRPTURL = ViewBag.RemoteTreatRPTURL;


    //Tần Hoàng Đảotrícó thểPhê duyệtnhắc trướccấu hình
    var medicalInsurance = SysConfigReader.String("medicalInsurance");
    //CóKhôngbậtlis pacsbáo cáoĐăng ký
    var IsreportOpen = SysConfigReader.String("IsreportOpen");
    var sfxmztbs = SysConfigReader.String("sfxmztbs");//Bộ mẫuMụcCóKhônghợpvàHiển thị
    var SkipPatientList = SysConfigReader.String("SkipPatientList");//Lưu、Kết thúcKhám bệnhCóKhôngQuay lạibệnh ngườidanh sách
    var openblbookprint = SysConfigReader.String("blbookprint");//CóKhôngKích hoạtHồ sơbảnIn
    var ControlsyyfCode = SysConfigReader.String("sydyfpz");//truyền dịchCách dùngcấu hình
                                                            //Nhập việnchứngIn
    var reportUrl = Newtouch.CIS.Compat.AppConfig.Get("ReportUrl");
    var ReportSystemCode = Newtouch.CIS.Compat.AppConfig.Get("ReportSystemCode");
    var curOpr = NewtouchHIS.Lib.Framework.Operator.OperatorProvider.GetCurrent();
    var dzcfUrl = Newtouch.CIS.Compat.AppConfig.Get("DzcfUrl");
}

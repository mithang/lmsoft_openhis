@using Newtouch.Infrastructure;

@{
    ViewBag.Title = "Bệnh án";//Bệnh án ngoại trú
    Layout = null;

    var pacsHost = SiteUrl.GetUrl("OuterPacsServiceHost", "");
    var isPrintRehabPres = (ViewBag.ISPrintRehabPres as bool?) ?? false;
    var isPrintRehabTreatment = (ViewBag.ISPrintRehabTreatment as bool?) ?? false;
    //Giao diện sử dụng thuốc hợp lý
    var isOpenRationalUse = (ViewBag.isOpenRationalUse); //Có bật giao diện duyệt sử dụng thuốc hợp lý không

    //Công tắc: có mở xét nghiệm kiểm tra không
    var IsOpenJyJcSwitch = ViewBag.IsOpenJyJcSwitch as bool?;
    //Công tắc: ngoại trú có mở đơn thuốc phục hồi chức năng không
    var isOpenKfcf = (ViewBag.ISOpenKfcf as bool?);
    //Công tắc: ngoại trú có mở đơn thuốc hạng mục thông thường không
    var isOpenCgxmcf = (ViewBag.ISOpenCgxmcf as bool?);
    //Công tắc: ngoại trú có mở đơn thuốc vật tư y tế không
    var iSOpenWzhc = (ViewBag.ISOpenWzhc as bool?);
    //Công tắc: có bật nhắc nhở trước không
    var iSReminderBeforehand = SysConfigReader.Bool("IS_ReminderBeforehand", false).Value;

    //Lấy cấu hình in đơn thuốc
    var mzcfdPrinturl = SysConfigReader.OrgReportLink("mzcfdPrint");  //Phiếu đơn thuốc
    var mzzcycfPrint = SysConfigReader.OrgReportLink("mzzcycfPrint");  //Phiếu đơn thuốc thảo dược
    var mzjyjcPrinturl = SysConfigReader.OrgReportLink("jcjyPrint");//Phiếu xét nghiệm kiểm tra
    var mzjcPrinturl = SysConfigReader.OrgReportLink("jcPrint");//Phiếu kiểm tra
    var mzwhdPrinturl = SysConfigReader.OrgReportLink("whdPrint");//Phiếu khí dung
    var mzzszPrinturl = SysConfigReader.OrgReportLink("mzzszPrint");//Phiếu tiêm zszPrint
    var mzjzdPrinturl = SysConfigReader.OrgReportLink("jzdPrint");//Phiếu khám
    var mzcgcfPrinturl = SysConfigReader.OrgReportLink("mzcgcfPrint");//Phiếu đơn thuốc hạng mục thông thường ngoại trú
    var optionItem = SysConfigReader.String("Outpatient_patient_reg_optionItem"); //Mục không bắt buộc
    var exelink_pacs = ViewBag.exelink_pacs;

    //Y tế từ xa
    var OrganizeCodeSd = ViewBag.OrganizeCodeSd;
    var RemoteTreatRPTURL = ViewBag.RemoteTreatRPTURL;


    //Cấu hình nhắc nhở trước duyệt thông minh Tần Hoàng Đảo
    var medicalInsurance = SysConfigReader.String("medicalInsurance");
    //Có bật khônglis pacsĐăng ký báo cáo
    var IsreportOpen = SysConfigReader.String("IsreportOpen");
    var sfxmztbs = SysConfigReader.String("sfxmztbs");//Hạng mục bộ mẫu có hiển thị gộp không
    var SkipPatientList = SysConfigReader.String("SkipPatientList");//Lưu, kết thúc khám có quay lại danh sách bệnh nhân không
    var openblbookprint = SysConfigReader.String("blbookprint");//Có bật in sổ bệnh án không
    var ControlsyyfCode = SysConfigReader.String("sydyfpz");//Cấu hình cách dùng truyền dịch
                                                            //In giấy chứng nhận nhập viện
    var reportUrl = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("ReportUrl");
    var ReportSystemCode = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("ReportSystemCode");
    var curOpr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
    var dzcfUrl = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("DzcfUrl");
}

                    break;
            }

            // ThêmSố đơn thuốcvàPhê duyệtTrạng tháiđếnmẫutrạng tháikhung
            $("#hlyyauditStatus").append("<div style='margin-top: 10px;'>Số đơn thuốc: " + prescriptionId + " DuyệtTrạng thái: <span style='color: " + statusColor + "; font-size: " + fontSize + ";'>" + auditStatus + "</span></div>");

            // làmỗicáiSố đơn thuốctạomộtphiếuđộccủabảngô
            if (item.prescriptions.length > 0) {
                // tạophútnhómdấuđề
                var tableContainer = $('<div class="table-container"></div>');
                tableContainer.append("<h5>Số đơn thuốc: " + prescriptionId + " DuyệtThông tin</h5>");

                // tạovàđiềnThuốcChi tiếtbảngô
                var table = $('<table class="table table-bordered table-striped"></table>');
                table.append('<thead><tr>' + drugColModel.map(function(col) {
                    return '<th>' + col.label + '</th>';
                }).join('') + '</tr></thead>');

                var tbody = $('<tbody></tbody>');
                item.prescriptions.forEach(function(drugInfo) {
                    var row = '<tr>';
                    drugColModel.forEach(function(col) {
                        if (col.name === 'DrugName') {
                            row += '<td><a href="javascript:void(0);" onclick="getYpsms(\'' + drugInfo.DrugId + '\')">' + drugInfo[col.name] + '</a></td>';
                        } else {
                            row += '<td>' + (drugInfo[col.name] || '') + '</td>';
                        }
                    });
                    row += '</tr>';
                    tbody.append(row);
                });
                table.append(tbody);
                tableContainer.append(table);

                // sẽSố đơn thuốccủabảngôChènđếndungdụng cụtrong
                $("#drugGridContainer").append(tableContainer);
            }
        }

    }



    function getYpsms(drugId) {
        // ởđâyThực hiệnđiểmnhấpsự kiệncủalogictập
        $.najax({
            url: "/MedicalRecord/GetypSms",
            data: {drugId: drugId},
            type: "POST",
            success: function (data) {
                if(data.state && data.state === 'success' && !(data.data === false)){
                    $.modalAlert(data.data, 'success')
                }
                else{
                    $.modalAlert("Gửithất bại", 'error');
                }
            }
        });
        
        
    }
    

</script>

    function HlyyDrugInfo(Data) {
        // Xóa nội dung đã có
        $("#hlyyauditStatus").empty();
        $("#drugGridContainer").empty();  // Xóa vùng chứa bảng thuốc

        // Theo số đơn thuốc (cfh) và Trạng thái duyệt (Cfstate) Dữ liệu nhóm
        var groupedData = {};

        Data.forEach(function(item) {
          
            var prescriptionId = item.cfh;
            var auditStatus = item.Cfstate;

        
            if (!groupedData[prescriptionId]) {
                groupedData[prescriptionId] = {
                    auditStatus: auditStatus,  // Lưu trạng thái duyệt
                    prescriptions: []  // Lưu thông tin thuốc thuộc số đơn thuốc hiện tại
                };
            }

            // Nếu InfoList Có dữ liệu, thêm thông tin thuốc
            if (item.Message.Infos.InfoList && item.Message.Infos.InfoList.length > 0) {
                groupedData[prescriptionId].prescriptions.push(...item.Message.Infos.InfoList);
            }
        });
        
        // Định nghĩa mô hình cột chi tiết thuốc
        var drugColModel = [
            { label: 'Số nhóm', name: 'GroupNo', align: 'center', width: 100 },
            {
                label: 'Tên thuốc',
                name: 'DrugName',
                align: 'center',
                width: 150,
                formatter: function(cellValue, options, rowObject) {
                    // Đảm bảo khi nhấn sẽ truyền vào chính xác DrugId
                    if ('@(isOpenRationalUse)' === 'ON') {
                        // Tạo một siêu liên kết, khi nhấn sẽ truyền vàoDrugId
                        return '<a href="javascript:void(0);" onclick="getYpsms(\'' + rowObject.DrugId + '\')">' + cellValue + '</a>';
                    }
                    return cellValue; // Nếu chưa bật rational use, hiển thị trực tiếp tên thuốc
                }
            },
            { label: 'Đường dùng thuốc', name: 'AdminRoute', align: 'center', width: 100 },
            { label: 'Tần suất dùng thuốc', name: 'AdminFrequency', align: 'center', width: 100 },
            { label: 'Thông tin lỗi', name: 'MessageText', align: 'center', width: 250 },
            { label: 'Đề xuất', name: 'Advice', align: 'center', width: 200 },
            { label: 'Nguồn', name: 'Source', align: 'center', width: 100 },
            { label: 'Loại lỗi', name: 'Type', align: 'center', width: 100 }
        ];
        
        for (var prescriptionId in groupedData) {
            var item = groupedData[prescriptionId];

            // Định nghĩa màu sắc và văn bản của trạng thái duyệt
            const cfStateMap = {
                "1": "审核中",
                "0": "已审核",
                "2": "不通过"
            };
            const auditStatus = cfStateMap[item.auditStatus] || "未知状态";
            let statusColor;
            let fontSize = "10px";  // Kích thước phông chữ mặc định

            switch (item.auditStatus) {
                case "1": // Đang duyệt
                    statusColor = "orange";
                    break;
                case "0": // Đã duyệt
                    statusColor = "green";
                    break;
                case "2": // Không đạt
                    statusColor = "red";
                    break;
                default:
                    statusColor = "gray";
                    break;
            }

            // Thêm số đơn thuốc và trạng thái duyệt vào hộp thoại
            $("#hlyyauditStatus").append("<div style='margin-top: 10px;'>Số đơn thuốc: " + prescriptionId + " 审核状态: <span style='color: " + statusColor + "; font-size: " + fontSize + ";'>" + auditStatus + "</span></div>");

            // Tạo một bảng riêng cho mỗi số đơn thuốc
            if (item.prescriptions.length > 0) {
                // Tạo tiêu đề nhóm
                var tableContainer = $('<div class="table-container"></div>');
                tableContainer.append("<h5>Số đơn thuốc: " + prescriptionId + " Thông tin duyệt</h5>");

                // Tạo và điền bảng chi tiết thuốc
                var table = $('<table class="table table-bordered table-striped"></table>');
                table.append('<thead><tr>' + drugColModel.map(function(col) {
                    return '<th>' + col.label + '</th>';
                }).join('') + '</tr></thead>');

                var tbody = $('<tbody></tbody>');
                item.prescriptions.forEach(function(drugInfo) {
                    var row = '<tr>';
                    drugColModel.forEach(function(col) {
                        if (col.name === 'DrugName') {
                            row += '<td><a href="javascript:void(0);" onclick="getYpsms(\'' + drugInfo.DrugId + '\')">' + drugInfo[col.name] + '</a></td>';
                        } else {
                            row += '<td>' + (drugInfo[col.name] || '') + '</td>';
                        }
                    });
                    row += '</tr>';
                    tbody.append(row);
                });
                table.append(tbody);
                tableContainer.append(table);

                // Chèn bảng của số đơn thuốc này vào vùng chứa
                $("#drugGridContainer").append(tableContainer);
            }
        }

    }



    function getYpsms(drugId) {
        // Thực thi logic sự kiện nhấn tại đây
        $.najax({
            url: "/MedicalRecord/GetypSms",
            data: {drugId: drugId},
            type: "POST",
            success: function (data) {
                if(data.state && data.state === 'success' && !(data.data === false)){
                    $.modalAlert(data.data, 'success')
                }
                else{
                    $.modalAlert("Gửi thất bại", 'error');
                }
            }
        });
        
        
    }
    


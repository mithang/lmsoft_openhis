    function arrangeCfDtoArray(cfDtoArray) {
        var rs = true;
        var msg = "";
        for (var i = 0; i < cfDtoArray.length; i++) {
            var cflx = cfDtoArray[i].cflx;
            if (cflx == "xycf" || cflx == "zycf" || cflx == "cgxmcf" || cflx == "kfcf") {
                if (!cfDtoArray[i].cfHtml) {
                    continue;
                }
                var cfmxCount = cfDtoArray[i].cfHtml.length;
                for (var j = 0; j < cfmxCount; j++) {
                    if (cfDtoArray[i].cfHtml[j].cfId != "") { continue; }
                    if (cflx == "cgxmcf" || cflx == "kfcf") {
                        /*Số lượng/Đơn giá/Số tiềnđềukhônglàtrống*/
                        if (cfDtoArray[i].cfHtml[j].xmCode == null || cfDtoArray[i].cfHtml[j].xmCode == "" || cfDtoArray[i].cfHtml[j].sl == "" || cfDtoArray[i].cfHtml[j].je == "") {
                            rs = false;
                            msg = (cflx == "cgxmcf" ? "Thường quyMụcĐơn thuốc" : "Phục hồi chức năngĐơn thuốc") + "Dòng thứ " + (j + 1) + " dòng Số lượng/Đơn giá/Số tiềntrong có một hoặc nhiều giá trị trống，vui lòng kiểm tra！";
                            break;
                        }
                        if (cfDtoArray[i].cfHtml[j].zxks == "") {
                            rs = false;
                            msg = (cflx == "cgxmcf" ? "Thường quyMụcĐơn thuốc" : "Phục hồi chức năngĐơn thuốc") + "Dòng thứ " + (j + 1) + " dòng 【Khoa thực hiện】có giá trị trống，vui lòng kiểm tra！";
                            break;
                        }
                    }
                    else {
                        if (cfDtoArray[i].cfHtml[j].ypCode == null || cfDtoArray[i].cfHtml[j].ypCode == "" || cfDtoArray[i].cfHtml[j].sl == "" || cfDtoArray[i].cfHtml[j].je == "") {
                            rs = false;
                            msg = (cflx == "xycf" ? "Thuốc TâyĐơn thuốc" : "Thuốc YHCTĐơn thuốc") + "Dòng thứ " + (j + 1) + " dòng Số lượng/Đơn giá/Số tiềntrong có một hoặc nhiều giá trị trống，vui lòng kiểm tra！";
                            break;
                        }
                    }

                    /*ThuốchoặcMụclàtrống、Số lượng/Đơn giá/Số tiềnkhôngtoànlàtrống，thìxemcùngtrốngdòngvàXóadòng*/
                    //cfDtoArray[i].cfHtml.splice(j, 1);
                    //j--;
                    //cfmxCount--;
                }

                if (!rs) {
                    break;
                }
            }
        }
        return { rs: rs, msg: msg };
    }

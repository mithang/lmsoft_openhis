    }

	var url = '@dzcfUrl';
	//điện tửĐơn thuốcTải lên
	function dzcfsc(type,cfh) {
		var upload = '';
		var errorCode = '';
		$.ajax({
			url: url+"prescription/rest/prescription/uploadep?cfh=" + cfh,
			type: "GET",
			dataType: "json",
			//data: { cfh: cfh },
			async: true,
			success: function (ret) {
				upload = ret.status;
				//console.log(ret);
				if (upload == 'Success') {
					$.modalAlert("Gửithành công", 'success');
					updateSendtohisResult(type, cfh);
				} else {
					errorCode = ret.errorCode;
					$.modalAlert("Gửithất bại" + errorCode, 'error');
					//return "Lưu thất bại,thất bạinguyên nhânCó:" + errorCode + "。";
				}
			}
		});

	}

	//điện tửĐơn thuốcThu hồivàXóa
	function dzcfcx(type,cfh, cfid) {

		$.modalOpen({
			id: "dzcfcxForm",
			title: "Điện tửĐơn thuốcHủy bỏNguyên nhân",
			url: "/MedicalRecord/dzcfcxForm",
			width: "600px",
			height: "300px",
			callBack: function (iframeId) {
				var mbObj = top.frames[iframeId].submitForm();
				$.modalClose("dzcfcxForm");
				if (mbObj != null && mbObj != undefined) {
					var upload = '';
					var errorCode = '';
					$.ajax({
						url: url+"prescription/rest/prescription/cancel",
						type: "POST",
						dataType: "json",
						contentType:"application/json;charset=UTF-8",
						data: JSON.stringify({ cfh: cfh, reason: mbObj.zfyy }),
						async: false,
						success: function (ret) {
							upload = ret.status;
							if (upload == 'Success') {
								$.modalAlert("Hủy bỏthành công", 'success');
								removeCfFromWindowAlldataArray(type, cfid);
							} else {
								errorCode = ret.errorCode;
								$.modalAlert("Hủy bỏthất bại" + errorCode, 'error');
								//return "Lưu thất bại,thất bạinguyên nhânCó:" + errorCode + "。";
							}
						}
					});
				}
			}
		});

	}


@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<object id="ActiveX996" classid="clsid:F48D2AD3-23FF-4882-8A9A-FB540AA718F5"  codebase="CISActiveX.cab" style="display: none;"></object>
<form id="form1">
    <table class="form">
        <tr>
            <td class="formTitle">Số thẻ:</td>
            <td class="formValue">
                <input id="kh" class="form-control" placeholder="Vui lòng nhập số thẻ" value="c0004876" />
            </td>
            <td>
                <input type="button" class="btn btn-primary btn-md" id="btn_1" value="Xem báo cáo điện tâm đồ trong viện" />
            </td>
        </tr>
        <tr>
            <td class="formTitle">Đăng ký khámID：</td>
            <td class="formValue">
                <input id="ghid" class="form-control" placeholder="Vui lòng nhập đăng ký khámID" />
            </td>
            <td class="formTitle">Họ tên:</td>
            <td class="formValue">
                <input id="ghname" class="form-control" placeholder="Vui lòng nhập tên" />
            </td>
            <td class="formTitle">Thời gian bắt đầu:</td>
            <td class="formValue">
                <input id="startdate" type="text" class="form-control input-wdatepicker form-an" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" value="@DateTime.Now.ToString("yyyy-MM-dd 00:00:00")" />
            </td>
        </tr>
        <tr>
            <td class="formTitle">Thời gian kết thúc:</td>
            <td class="formValue">
                <input id="enddate" type="text" class="form-control input-wdatepicker form-an" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" />
            </td>
            <td>
                <input type="button" class="btn btn-primary btn-md" id="btn_7" value="Hình ảnh trong việnBXem báo cáo siêu âm" />
            </td>
            <td>
                <input type="button" class="btn btn-primary btn-md" id="btn_8" value="Xem báo cáo xét nghiệm trong viện" />
            </td>
        </tr>
        <tr>
            <td class="formTitle">Số bệnh nhân:</td>
            <td class="formValue">
                <input id="patid" class="form-control" placeholder="Vui lòng nhập số duy nhất của bệnh nhân" />
            </td>
            <td class="formTitle">Số phiếu yêu cầu:</td>
            <td class="formValue">
                <input id="orderno" class="form-control" placeholder="Vui lòng nhập số phiếu yêu cầu" />
            </td>
            <td>
                <input type="button" class="btn btn-primary btn-md" id="btn_3" value="Yêu cầu điện tâm đồ y tế từ xa" />
            </td>
        </tr>
        <tr>
            <td class="formTitle">Mã duy nhất của bệnh nhân:</td>
            <td class="formValue">
                <input id="jypatid" class="form-control" placeholder="Vui lòng nhập mã duy nhất của bệnh nhân" />
            </td>
            <td class="formTitle">Số giao dịch khám:</td>
            <td class="formValue">
                <input id="jzlsh" class="form-control" placeholder="Vui lòng nhập số giao dịch khám" />
            </td>
            <td>
                <input type="button" class="btn btn-primary btn-md" id="btn_5" value="Yêu cầu xét nghiệm" />
            </td>
        </tr>
        <tr>
            <td class="formTitle">Số thẻ:</td>
            <td class="formValue">
                <input id="yxkh" class="form-control" placeholder="Vui lòng nhập số thẻ" />
            </td>
            <td class="formTitle">Số phiếu yêu cầu:</td>
            <td class="formValue">
                <input id="yxnum" class="form-control" placeholder="Vui lòng nhập số phiếu yêu cầu" />
            </td>
            <td>
                <input type="button" class="btn btn-primary btn-md" id="btn_6" value="Yêu cầu hình ảnh y tế từ xa" />
            </td>
        </tr>
        <tr>
            <td class="formTitle">Số thẻ:</td>
            <td class="formValue">
                <input id="xdkh" class="form-control" placeholder="Vui lòng nhập số thẻ" />
            </td>
            <td class="formTitle">Số phiếu yêu cầu:</td>
            <td class="formValue">
                <input id="xdnum" class="form-control" placeholder="Vui lòng nhập số phiếu yêu cầu" />
            </td>
            <td>
                <input type="button" class="btn btn-primary btn-md" id="btn_9" value="Xem điện tâm đồ y tế từ xa" />
            </td>
        </tr>
    </table>
</form>


<script>
    $(function () {
        $('#btn_1').click(function () {
             $.ajax({
                type: "POST",
                 url: "@Url.Action("chakanmingxidiaoyong")",
                 data: { kh: $('#kh').val() },
                dataType: "xml",  //Loại tham số làxml
                contentType: "application/x-www-form-urlencoded",//đang dùngxmlcó định dạng
                 error: function (error) {
                     var resp = JSON.parse(JSON.parse(error.responseText).data);
                     if (resp !== undefined && resp.length > 0) {
                         sessionStorage.setItem('XindianList', JSON.stringify(resp));
                         $.modalOpen({
                             id: "Form",
                             title: "Chi tiết điện tâm đồ",
                             url: "@Url.Action("ViewXindianList")",
                             width: "700px",
                             height: "530px",
                             btn:null
                         });
                    }
                }
            })
        });
        $('#btn_2').on("click", function () {
            window.open($('#imgsrc').val());
        });

        $('#btn_3').click(function () {
             $.ajax({
                type: "POST",
                 url: "@Url.Action("xindianshenqing")",
                 data: { patid: $('#patid').val(), orderno: $('#orderno').val()},
                dataType: "xml",  //Loại tham số làxml
                contentType: "application/x-www-form-urlencoded",//đang dùngxmlcó định dạng
                error: function (error) {
                    if (JSON.parse(JSON.parse(error.responseText).data)[0].Return === "1") {
                        window.open("http://www.baidu.com/", "_blank");
                    }
                }
            })
        });

        $('#btn_4').click(function () {
            if (!$('#form1').formValid()) {
                return false;
            }
             $.ajax({
                type: "POST",
                 url: "@Url.Action("xindianshenqing")",
                 data: getxindianshenqingPostdata(),
                dataType: "xml",  //Loại tham số làxml
                contentType: "application/x-www-form-urlencoded",//đang dùngxmlcó định dạng
                error: function (error) {
                    if (JSON.parse(JSON.parse(error.responseText).data)[0].Return === "1") {
                        window.open("http://www.baidu.com/", "_blank");
                    }
                }
            })
        });

          $('#btn_5').click(function () {
             $.ajax({
                type: "POST",
                 url: "@Url.Action("jianyanshenqing")",
                 data: {patid: $('#jypatid').val(), jzlsh: $('#jzlsh').val() },
                dataType: "xml",  //Loại tham số làxml
                contentType: "application/x-www-form-urlencoded",//đang dùngxmlcó định dạng
                error: function (error) {
                    if (JSON.parse(JSON.parse(error.responseText).data)[0].return === "1") {
                        window.open("http://www.baidu.com/", "_blank");
                    }
                }
            })
        });

             $('#btn_6').click(function () {
             $.ajax({
                type: "POST",
                 url: "@Url.Action("yingxiangshenqing")",
                 data: { patid: $('#yxkh').val(), num: $('#yxnum').val() },
                dataType: "xml",  //Loại tham số làxml
                contentType: "application/x-www-form-urlencoded",//đang dùngxmlcó định dạng
                error: function (error) {
                    if (JSON.parse(JSON.parse(error.responseText).data)[0].return === "1") {
                        window.open("http://www.baidu.com/", "_blank");
                    }
                }
            })
        });

         $('#btn_9').click(function () {
             $.ajax({
                type: "POST",
                 url: "@Url.Action("xindiandiaoyue")",
                 data: { kh: $('#xdkh').val(), orderno: $('#xdnum').val() },
                dataType: "xml",  //Loại tham số làxml
                contentType: "application/x-www-form-urlencoded",//đang dùngxmlcó định dạng
                error: function (error) {
                    if (JSON.parse(JSON.parse(error.responseText).data)[0].return === "1") {
                        window.open("http://www.baidu.com/", "_blank");
                    }
                }
            })
        });

        $('#btn_7').click(function () {
            var str = "http://40.21.114.251:8888/ReportList.aspx?hoscode=&patientid=&hispatientid=" + $('#ghid').val() + "&hissheetid=&name=" + $('#ghname').val() + "&startdate=" + $('#startdate').val() + "&enddate=" + $('#enddate').val()+"&sex=";
            window.open(str, "_blank");
        });

             $('#btn_8').click(function () {
	             var activeX = document.getElementById("ActiveX996");
	            activeX.jianyandiaoyue();
        });
        });

    function getxindianshenqingPostdata() {
        var data = $("#form1").formSerialize();
        return data;
    }

    function browserIsIe() {
        if (!!window.ActiveXObject || "ActiveXObject" in window) {
            return true;
        }
        else {
            return false;
        }
    }

    function createIframe(imgSrc) {
        //Nếu bị ẩniframekhông tồn tại thì tạo
        if ($("#IframeReportImg").length === 0) {
            $('<iframe style="display:none;" id="IframeReportImg" name="IframeReportImg" onload="downloadImg();" width="0" height="0" src="about:blank"></iframe>').appendTo("body");
        }
        //iframecủasrcNếu thuộc tính không trỏ đến địa chỉ hình ảnh,thì sửa thủ công,Tải hình ảnh
        if ($('#IframeReportImg').attr("src") != imgSrc) {
            $('#IframeReportImg').attr("src", imgSrc);
        } else {
            //Nếu trỏ đến địa chỉ hình ảnh,Gọi trực tiếp phương pháp tải xuống
            downloadImg();
        }
    }
    //Hàm tải xuống hình ảnh
    function downloadImg() {
        //iframecủasrcThuộc tính không trống,GọiexecCommand(),Lưu hình ảnh
        if ($('#IframeReportImg').src != "about:blank") {
            window.frames["IframeReportImg"].document.execCommand("SaveAs");
        }
    }
</script>


@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<div class="alert alert-warning" style="margin:20px;padding:15px;border:1px solid #faebcc;background:#fcf8e3;color:#8a6d3b;">
<strong>Thông báo:</strong> Tích hợp LIS ActiveX (điều khiển COM NewtouchActiveX, chỉ chạy trên Internet Explorer + Windows) không thể chạy trên Linux.
Chức năng này cần giải pháp thay thế (SDK của nhà cung cấp / tiện ích trình duyệt / native messaging host) và đã được ghi nhận để triển khai riêng.
Các chức năng khác của trang vẫn hoạt động bình thường.
</div>
<form id="form1">
    <table class="form">
        <tr>
            <td class="formTitle">Số thẻ:</td>
            <td class="formValue">
                <input id="kh" class="form-control" placeholder="Vui lòng nhậpSố thẻ" value="c0004876" />
            </td>
            <td>
                <input type="button" class="btn btn-primary btn-md" id="btn_1" value="Trong việnĐiện timBáo cáoTra cứu" />
            </td>
        </tr>
        <tr>
            <td class="formTitle">Đăng ký khámID:</td>
            <td class="formValue">
                <input id="ghid" class="form-control" placeholder="Vui lòng nhậpĐăng ký khámID" />
            </td>
            <td class="formTitle">Họ tên:</td>
            <td class="formValue">
                <input id="ghname" class="form-control" placeholder="Vui lòng nhậpHọ tên" />
            </td>
            <td class="formTitle">Thời gian bắt đầu:</td>
            <td class="formValue">
                <input id="startdate" type="text" class="form-control input-wdatepicker form-an" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" value="@DateTime.Now.ToString("yyyy-MM-dd 00:00:00")" />
            </td>
        </tr>
        <tr>
            <td class="formTitle">Kết thúcThời gian:</td>
            <td class="formValue">
                <input id="enddate" type="text" class="form-control input-wdatepicker form-an" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" />
            </td>
            <td>
                <input type="button" class="btn btn-primary btn-md" id="btn_7" value="Tra cứu báo cáo siêu âm B trong viện" />
            </td>
            <td>
                <input type="button" class="btn btn-primary btn-md" id="btn_8" value="Xét nghiệmTrong việnBáo cáoTra cứu" />
            </td>
        </tr>
        <tr>
            <td class="formTitle">Bệnh nhânSố hiệu:</td>
            <td class="formValue">
                <input id="patid" class="form-control" placeholder="Vui lòng nhậpBệnh nhânDuy nhấtSố hiệu" />
            </td>
            <td class="formTitle">Số phiếu:</td>
            <td class="formValue">
                <input id="orderno" class="form-control" placeholder="Vui lòng nhậpSố phiếu" />
            </td>
            <td>
                <input type="button" class="btn btn-primary btn-md" id="btn_3" value="Từ xaY tếĐiện timĐề nghị" />
            </td>
        </tr>
        <tr>
            <td class="formTitle">Bệnh nhânDuy nhấtMã:</td>
            <td class="formValue">
                <input id="jypatid" class="form-control" placeholder="Vui lòng nhậpBệnh nhânDuy nhấtMã" />
            </td>
            <td class="formTitle">Khám bệnhSố thứ tự:</td>
            <td class="formValue">
                <input id="jzlsh" class="form-control" placeholder="Vui lòng nhậpKhám bệnhSố thứ tự" />
            </td>
            <td>
                <input type="button" class="btn btn-primary btn-md" id="btn_5" value="Xét nghiệmĐề nghị" />
            </td>
        </tr>
        <tr>
            <td class="formTitle">Số thẻ:</td>
            <td class="formValue">
                <input id="yxkh" class="form-control" placeholder="Vui lòng nhậpSố thẻ" />
            </td>
            <td class="formTitle">Số phiếu:</td>
            <td class="formValue">
                <input id="yxnum" class="form-control" placeholder="Vui lòng nhậpSố phiếu" />
            </td>
            <td>
                <input type="button" class="btn btn-primary btn-md" id="btn_6" value="Từ xaY tếHình ảnhĐề nghị" />
            </td>
        </tr>
        <tr>
            <td class="formTitle">Số thẻ:</td>
            <td class="formValue">
                <input id="xdkh" class="form-control" placeholder="Vui lòng nhậpSố thẻ" />
            </td>
            <td class="formTitle">Số phiếu:</td>
            <td class="formValue">
                <input id="xdnum" class="form-control" placeholder="Vui lòng nhậpSố phiếu" />
            </td>
            <td>
                <input type="button" class="btn btn-primary btn-md" id="btn_9" value="Từ xaY tếĐiện timTra cứu" />
            </td>
        </tr>
    </table>
</form>


<script>
    $(function () {
        $('#btn_1').click(function () {
             $.ajax({
                type: "POST",
                 url: "@Url.Action("chakanmingxidiaoyong")",
                 data: { kh: $('#kh').val() },
                dataType: "xml",  //tham sốLoạilàxml
                contentType: "application/x-www-form-urlencoded",//Sử dụngcủaxmlđịnh dạngcủa
                 error: function (error) {
                     var resp = JSON.parse(JSON.parse(error.responseText).data);
                     if (resp !== undefined && resp.length > 0) {
                         sessionStorage.setItem('XindianList', JSON.stringify(resp));
                         $.modalOpen({
                             id: "Form",
                             title: "Điện timChi tiết",
                             url: "@Url.Action("ViewXindianList")",
                             width: "700px",
                             height: "530px",
                             btn:null
                         });
                    }
                }
            })
        });
        $('#btn_2').on("click", function () {
            window.open($('#imgsrc').val());
        });

        $('#btn_3').click(function () {
             $.ajax({
                type: "POST",
                 url: "@Url.Action("xindianshenqing")",
                 data: { patid: $('#patid').val(), orderno: $('#orderno').val()},
                dataType: "xml",  //tham sốLoạilàxml
                contentType: "application/x-www-form-urlencoded",//Sử dụngcủaxmlđịnh dạngcủa
                error: function (error) {
                    if (JSON.parse(JSON.parse(error.responseText).data)[0].Return === "1") {
                        window.open("http://www.baidu.com/", "_blank");
                    }
                }
            })
        });

        $('#btn_4').click(function () {
            if (!$('#form1').formValid()) {
                return false;
            }
             $.ajax({
                type: "POST",
                 url: "@Url.Action("xindianshenqing")",
                 data: getxindianshenqingPostdata(),
                dataType: "xml",  //tham sốLoạilàxml
                contentType: "application/x-www-form-urlencoded",//Sử dụngcủaxmlđịnh dạngcủa
                error: function (error) {
                    if (JSON.parse(JSON.parse(error.responseText).data)[0].Return === "1") {
                        window.open("http://www.baidu.com/", "_blank");
                    }
                }
            })
        });

          $('#btn_5').click(function () {
             $.ajax({
                type: "POST",
                 url: "@Url.Action("jianyanshenqing")",
                 data: {patid: $('#jypatid').val(), jzlsh: $('#jzlsh').val() },
                dataType: "xml",  //tham sốLoạilàxml
                contentType: "application/x-www-form-urlencoded",//Sử dụngcủaxmlđịnh dạngcủa
                error: function (error) {
                    if (JSON.parse(JSON.parse(error.responseText).data)[0].return === "1") {
                        window.open("http://www.baidu.com/", "_blank");
                    }
                }
            })
        });

             $('#btn_6').click(function () {
             $.ajax({
                type: "POST",
                 url: "@Url.Action("yingxiangshenqing")",
                 data: { patid: $('#yxkh').val(), num: $('#yxnum').val() },
                dataType: "xml",  //tham sốLoạilàxml
                contentType: "application/x-www-form-urlencoded",//Sử dụngcủaxmlđịnh dạngcủa
                error: function (error) {
                    if (JSON.parse(JSON.parse(error.responseText).data)[0].return === "1") {
                        window.open("http://www.baidu.com/", "_blank");
                    }
                }
            })
        });

         $('#btn_9').click(function () {
             $.ajax({
                type: "POST",
                 url: "@Url.Action("xindiandiaoyue")",
                 data: { kh: $('#xdkh').val(), orderno: $('#xdnum').val() },
                dataType: "xml",  //tham sốLoạilàxml
                contentType: "application/x-www-form-urlencoded",//Sử dụngcủaxmlđịnh dạngcủa
                error: function (error) {
                    if (JSON.parse(JSON.parse(error.responseText).data)[0].return === "1") {
                        window.open("http://www.baidu.com/", "_blank");
                    }
                }
            })
        });

        $('#btn_7').click(function () {
            var str = "http://40.21.114.251:8888/ReportList.aspx?hoscode=&patientid=&hispatientid=" + $('#ghid').val() + "&hissheetid=&name=" + $('#ghname').val() + "&startdate=" + $('#startdate').val() + "&enddate=" + $('#enddate').val()+"&sex=";
            window.open(str, "_blank");
        });

             $('#btn_8').click(function () {
	             var activeX = document.getElementById("ActiveX996");
	            activeX.jianyandiaoyue();
        });
        });

    function getxindianshenqingPostdata() {
        var data = $("#form1").formSerialize();
        return data;
    }

    function browserIsIe() {
        if (!!window.ActiveXObject || "ActiveXObject" in window) {
            return true;
        }
        else {
            return false;
        }
    }

    function createIframe(imgSrc) {
        //VDnếuẨncủaiframekhôngtồn tạiởthìtạo
        if ($("#IframeReportImg").length === 0) {
            $('<iframe style="display:none;" id="IframeReportImg" name="IframeReportImg" onload="downloadImg();" width="0" height="0" src="about:blank"></iframe>').appendTo("body");
        }
        //iframecủasrcThuộc tínhVDkhôngchỉtớihìnhảnhĐịa chỉ,thìtayđộngSửa,tảihìnhảnh
        if ($('#IframeReportImg').attr("src") != imgSrc) {
            $('#IframeReportImg').attr("src", imgSrc);
        } else {
            //VDchỉtớihìnhảnhĐịa chỉ,trực tiếpgọiTải xuốngPhương pháp
            downloadImg();
        }
    }
    //Tải xuốnghìnhảnhcủahàmsố
    function downloadImg() {
        //iframecủasrcThuộc tínhkhônglàtrống,gọiexecCommand(),Lưuhìnhảnh
        if ($('#IframeReportImg').src != "about:blank") {
            window.frames["IframeReportImg"].document.execCommand("SaveAs");
        }
    }
</script>


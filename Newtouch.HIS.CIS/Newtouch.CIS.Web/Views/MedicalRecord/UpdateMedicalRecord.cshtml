
@{
	ViewBag.Title = "LogQuery";
	Layout = "~/Views/Shared/_Index.cshtml";
}

<form name="form1">
	<div class="panel panel-default">
		<div class="panel-heading navb-bg">
			Điều kiện lọc
		</div>
		<table class="form">
			<tr>

				<th class="formTitle">Số bệnh án/Họ tên:</th>
				<td class="formValue">
					<input type="text" class="form-control" id="txtxm" name="txtxm" />
				</td>
				<td class="formTitle">Tên bác sĩ:</td>
				<td class="formValue">
					<input id="txt_doctor" name="txt_doctor" type="text" class="form-control required" />
				</td>
				<td style="width: 20px"></td>
				<th class="formTitle" id="thCZRQ">Ngày thao tác:</th>
				<td class="formValue" colspan="3">
					<input id="txtCreateTimestart" type="text" class="form-control input-wdatepicker formClearIgnore" style="width: 42%; float: left;" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
					<span style="margin-left: 2%; float: left;">—</span>
					<input id="txtCreateTimeEnd" type="text" class="form-control input-wdatepicker formClearIgnore" style="width: 41%; float: left; margin-left: 2%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
				</td>
				
			@*</tr>
			<tr>*@
				<th class="formTitle">Tuổi bệnh nhân:</th>
				<td class="formValue">
					<select class="form-control" id="hznl">
						<option value="" selected>Tất cả</option>
						<option value="1">lớn hơn35tuổi tròn</option>
					</select>
				</td>
				<th class="formTitle">Đường huyết, huyết áp:</th>
				<td class="formValue">
					<select class="form-control" id="xtxy">
						<option value="" selected>Tất cả</option>
						<option value="1">Có giá trị</option>
					</select>
				</td>
				<td class="formValue">
					<input type="button" id="btn_search" class="btn btn-primary btn-md" style="margin-left: 10px; width: 40px;" value="Tra cứu" />
				</td>
			</tr>
		</table>
		<table class="form" style="border-bottom-color:aliceblue;border-top:groove">
			<tr>
				<th class="formTitle">Họ tên:</th>
				<td class="formValue">
					<input type="text" class="form-control" id="txtname" name="txtname" disabled="disabled" />
					<input type="hidden" class="form-control" id="jzID" name="txtname" disabled="disabled" />
				</td>
				<th class="formTitle">Ngày khởi phát:</th>
				<td class="formValue">
					<input type="text" id="fbsj" name="fbsj" class="form-control input-wdatepicker activeValue focusInput" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
					<i class="fa fa-times" aria-hidden="true" hidden></i>
				</td>
				<th class="formTitle">Đường huyết:</th>
				<td class="formValue">
					<select id="xuetangclfs" class="form-control">
						<option value="">=请选择=</option>
						<option value="xuetang_kf">Khi đói</option>
						<option value="xuetang_ch">Sau ăn</option>
						<option value="xuetang_sj">Ngẫu nhiên</option>
					</select>
				</td>
				<td class="formValue">
					<div class="row">
						<div class="col-md-7">
							<input id="xuetang" name="xuetang" type="text" class="form-control form-an vitalsignschange" />
						</div>
						<div class="col-md-5">
							<label>mmol/L</label>
						</div>
					</div>
				</td>
				<th class="formTitle">Nhiệt độ cơ thể:</th>
				<td class="formValue">
					<div class="row">
						<div class="col-md-7">
							<input id="tiwen" name="tiwen" type="text" class="form-control form-an vitalsignschange" />
						</div>
						<div class="col-md-5">
							<label>℃</label>
						</div>
					</div>
				</td>
				<td class="formValue" rowspan="2">
					<input type="button" id="btn_save" class="btn btn-primary btn-md" style="margin-left: 10px; width: 60px;height:30px;" value="Lưu" />
				</td>
			</tr>
			<tr>
				<th class="formTitle">Huyết áp tâm thu:</th>
				<td class="formValue">
					<div class="row">
						<div class="col-md-7">
							<input id="shousuoya" name="shousuoya" type="text" class="form-control form-an vitalsignschange" />
						</div>
						<div class="col-md-5">
							<label>mmHg</label>
						</div>
					</div>
				</td>
				<th class="formTitle">Huyết áp tâm trương:</th>
				<td class="formValue">
					<div class="row">
						<div class="col-md-7">
							<input id="shuzhangya" name="shuzhangya" type="text" class="form-control form-an vitalsignschange" />
						</div>
						<div class="col-md-5">
							<label>mmHg</label>
						</div>
					</div>
				</td>
				<th class="formTitle"></th>
			</tr>
		</table>
	</div>
	<div class="gridPanel">
		<table id="gridJSList"></table>
		<div id="gridPager"></div>
	</div>
</form>
<script>
	//$('#xuetangclfs').itemDetailsBindSelect({ itemtype: "xuetangclfs" });
    $(function () {
        //Khi thay đổi kích thước cửa sổ trình duyệt thì tải lạijqGridchiều rộng của
        $(window).resize(function () {
            initLayout("MyTabGrid");
        });
        //Hồ sơ chính thanh toán
        gridJSListData();
    });
    $("#txt_doctor").dutyStaffFloatingSelector({
        dutyCode: 'Doctor'
    });
    //Tra cứu thanh toán đăng ký khám ngoại trú
    function gridJSListData() {
        var $gridJsList = $("#gridJSList");
        $gridJsList.dataGrid({
            postData: getSearchPostData(),
            height: $(window).height() - 160,
            url: "@Url.Action("OutpatientPatientQuery")",
            colModel: [
                { label: 'jzId', name: 'jzId', hidden: true, align: 'left' },
	            { label: 'xuetangclfs', name: 'xuetangclfs', hidden: true, align: 'left' },
	            { label: 'dqxuetang', name: 'dqxuetang', hidden: true, align: 'left' },
                { label: 'Ngày khám', name: 'jzsj', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                //{ label: 'Ngày', name: 'createtime', width: 140, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Số khám ngoại trú', name: 'mzh', width: 100, align: 'left' },
                { label: 'Họ tên', name: 'xm', align: 'center', width: 80 },
                {
                    label: 'Giới tính', name: 'xb', align: 'center', width: 50, formatter: function (val) {
                        return $.getGender(val);
                    }
                },
                { label: 'Tuổi', name: 'nlshow', align: 'center', width: 50 },
                 { label: 'Nhiệt độ cơ thể', name: 'tiwen', width: 80, align: 'left' },
                { label: 'Đường huyết', name: 'xuetang', width: 80, align: 'left' },
                { label: 'Huyết áp', name: 'xueya', width: 80, align: 'left' },
                { label: 'Ngày khởi phát', name: 'fbsj', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Nghề nghiệp', name: 'zy', width: 80, align: 'left' },
                { label: 'Địa chỉ', name: 'dz', width: 80, align: 'left' },
                { label: 'Khám lần đầu/tái khám', name: 'cfz', width: 80, align: 'left' },
                { label: 'Triệu chứng chính', name: 'zs', width: 80, align: 'left' },
                { label: 'Tên chẩn đoán', name: 'xyzdmc', width: 80, align: 'left' },
                { label: 'Xử lý', name: 'clfa', width: 80, align: 'left' },
                { label: 'Chữ ký bác sĩ', name: 'jzys', width: 80, align: 'left' },
                { label: 'Số giấy tờ hợp lệ', name: 'sfzh', width: 130, align: 'left' },
                { label: 'Điện thoại', name: 'ContactNum', width: 100, align: 'left' },
                { label: 'Khoa', name: 'ghksmc', width: 80, align: 'left' },
                { label: 'Bệnh sử hiện tại', name: 'xbs', width: 80, align: 'left' },
                { label: 'Tên phụ huynh', name: 'jzxm', align: 'center', width: 80 },
                { label: 'Số điện thoại', name: 'dhhm', align: 'center', width: 80 },
                { label: 'Ghi chú', name: 'bz', width: 100, align: 'left' },
            ],
            pager: "#gridPager",
            sortname: " jzsj asc",
            viewrecords: true,
            onSelectRow: function (rowIndex) {
	            cleanpatinfo();
            	var rowData = $("#gridJSList").jqGrid('getRowData', rowIndex);
            	$("#jzID").val(rowData.jzId);
	            $("#txtname").val(rowData.xm);
            	$("#tiwen").val(rowData.tiwen);
            	$("#xuetangclfs").val(rowData.xuetangclfs);
            	$("#xuetang").val(rowData.dqxuetang);
            	$("#shousuoya").val(rowData.xueya.split('/')[0]);
            	$("#shuzhangya").val(rowData.xueya.split('/')[1]);
            	$("#fbsj").val(rowData.fbsj);
            }
        });

        $("#btn_search").click(function () {
            $('#gridJSList').jqGrid("clearGridData");//Xóa chi tiết trước
            $gridJsList.jqGrid('setGridParam', {
                postData: getSearchPostData(),
                url: '@Url.Action("OutpatientPatientQuery")'
            }).trigger('reloadGrid');

	        cleanpatinfo();
        });
    	$("#btn_save").click(function () {
    		if ($('#jzID').val()=="") {
    			$.modalAlert("Vui lòng chọn trước một thông tin khám của bệnh nhân", 'warning');
		    }
		    $.najax({
			    url: "/MedicalRecord/SaveUpdateMed",
			    data: { jzid: $('#jzID').val(), fbrq: $('#fbsj').val(), xuetang: $('#xuetang').val(), xuetangclfs: $('#xuetangclfs').val(), tiwen: $('#tiwen').val(), shousuoya: $('#shousuoya').val(), shuzhangya: $('#shuzhangya').val() },
			    type: "POST",
			    success: function(ajaxResp) {
			    	if (ajaxResp) {
			    		$.modalAlert("Sửa thành công", 'success');
			    		$("#btn_search").trigger('click');
				    }
			    },
			    errorCallback: function (data) {
			    	$.modalAlert(data.message, 'warning');
			    }
		    });
	    });
    }

	function cleanpatinfo() {
		$("#jzID").val("");
		$("#txtname").val("");
		$("#tiwen").val("");
		$("#xuetangclfs").val("");
		$("#xuetang").val("");
		$("#shousuoya").val("");
		$("#shuzhangya").val("");
		$("#fbsj").val("");
	}
    function clearData() {
        $("#txt_doctor").val("");
        $("#txt_doctor").attr("data-StaffGh", "");
    }
    var jszbList = null;

    function getSearchPostData() {
        var xm = $("#txtxm").val();
        var sfrqTimestart = $("#txtCreateTimestart").val();
        var sfrqTimeEnd = $("#txtCreateTimeEnd").val();
        var ysgh="";// = $("#txt_doctor").attr("data-StaffGh");
        if (!!$("#txt_doctor").attr("data-StaffGh") && !!$("#txt_doctor").val()) {
            ysgh = $("#txt_doctor").attr("data-StaffGh");
        }
        var hznl1 = $("#hznl").val();
        var xtxy1 = $("#xtxy").val();
	    var qbdc1 = "";
        return {
        	keyword: xm, kssj: sfrqTimestart, jssj: sfrqTimeEnd, jzysgh: ysgh, hznl: hznl1, xtxy: xtxy1, qbdc: qbdc1
        };
    };



</script>

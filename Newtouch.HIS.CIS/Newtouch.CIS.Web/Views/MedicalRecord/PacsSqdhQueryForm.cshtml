@{
    ViewBag.Title = "Kiểm traPhiếu";
    Layout = "~/Views/Shared/_Form.cshtml";
    var pacsopenURL = Newtouch.CIS.Compat.AppConfig.Get("pacsOpenUrl");
    var YjzxRportSwith = SysConfigReader.String("openYjzxSwitch");//kỹ thuật y họcQuản lýcôngcó thểCông tắc --báo cáoTải lênphươngkiểu
}

<form id="formPatSer" style="margin:2px;margin-top:10px;">
    <div class="panel panel-default">
        <div>
            <table class="form">
                <tr>
                    <th class="formTitle">PhiếuThời gianPhạm vi:</th>
                    <td class="formValue" colspan="2">
                        <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:30%;  float:left;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        <span style="margin-left:1%;float:left">—</span>
                        <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:30%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    </td>
                    <th class="formTitle">Tên bộ mẫu:</th>
                    <td class="formValue">
                        <input id="txt_ztmc" type="text" class="form-control" placeholder="Tên bộ mẫu" />
                    </td>
                    <td class="formTitle">
                        <input type="button" id="btn_search" class="btn btn-md btn-primary" value="Tra cứu" />
                    </td>

                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel">
        <table id="gridList" rel="formPatSer"></table>
        <div id="gridPager" style="padding-right:20%"></div>
    </div>
</form>
<script lang="javascript">
    var mzzyh = $.request("mzzyh");
    var type = $.request("type");
    $(function () {
        gridList();

    })
    $(document).ready(function () {
        $("#btn_search").trigger('click');
    });
    $("#btn_search").click(function () {
        var kssj = $('#kssj').val();
        var jssj = $('#jssj').val() + " 23:59:59";
        var ztmc = $('#txt_ztmc').val();
        $("#gridList").jqGrid('setGridParam', {
            postData: { mzzyh: mzzyh, type: type, ztmc: ztmc, kssj: kssj, jssj: jssj },
        }).trigger('reloadGrid'); //lạitảihiện tạibảngô
    });
    function gridList() {
        var kssj = $('#kssj').val();
        var jssj = $('#jssj').val() + " 23:59:59";
        var ztmc = $('#txt_ztmc').val();
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/MedicalRecord/GetPacsSqdhGridJson",
            autowidth: false,
            postData: { mzzyh: mzzyh, type: type, ztmc: ztmc, kssj: kssj, jssj: jssj },
            width: $(window).width()-10,
            height: $(window).height() - 125,
            colModel: [
                { label: 'Họ tên', name: 'xm', align: 'left', hidden: true },
               //{ label: 'Giới tính', name: 'xb', align: 'left', hidden: true },
               { label: 'Số phiếu', name: 'lissqdh', align: 'left' },
                { label: 'Tên bộ mẫu', name: 'ztmc', align: 'left' },
               { label: 'Đề nghịThời gian', name: 'sqsj', align: 'left' },
               { label: 'PhiếuTrạng thái', name: 'syncStatus', align: 'left' },
                //{ label: 'ztId', name: 'ztId', hidden: true },
               {
                    label: "Thao tác", name: "", align: "center", width: 100,
                    formatter: function (cellvalue, options, rowobject) {
                        return "<a href=\#\" onclick='recall(\"" + rowobject.lissqdh + "\",\"" + rowobject.syncStatus + "\")'' title='XemBáo cáo' style='text-decoration: none;color: #dd4b39;cursor: pointer;'>XemBáo cáo</a>";
                    }
                }
               //{ label: 'Tổng số tiền', name: 'zje' ,align: 'left'}
            ],
            pager: "#gridPager",
            sortname: 'sqsj desc',
            viewrecords: true
        });
    }
    function recall(sqdh, syncStatus )
    {
        if ("@YjzxRportSwith" == "ON") {
            $.modalOpen({
                id: "ApplyFormUpload",
                title: "Xem trước báo cáo",
                url: "/NurseManage/OrderExecution/ApplyFormUpload?sqdh=" + sqdh + "&query=true",
                width: "900px",
                height: "700px",
                btn: null
            });
        } else {
            if (syncStatus != "己出报告" && syncStatus != "等待报告") {
                $.modalAlert("Trạng thái hiện tại không phải đã hoàn thành nên không thể xem báo cáo", 'warning');
                return;
            }
            else {
                window.open('@pacsopenURL' + "DepExamViewer/#/?hisreqid=" + sqdh + "", "height=800, width=1195,top=100, left=50, toolbar =no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no");
                //$.modalOpen({
                //    id: "medicaljgForm",
                //    title: "Báo cáo kiểm tra",
                //    url: "https://202.127.1.101:9901/DepExamViewer/?patid='" + sqdh+"'" ,
                //    width: "1000px",
                //    height: "1000px",
                //    btn: ['', ''],
                //    btnclass: ['', ''],
                //});
            }
        }
        
    }
    //jqGrid nhấp đúpĐã chọnnào đódòng
    function btn_editbak() {
        var $gridList = $("#gridList");
        if ($gridList.jqGridRowValue().syncStatus != "己出报告") {
            $.modalAlert("Trạng thái hiện tại không phải đã hoàn thành nên không thể xem báo cáo", 'warning');
            return;
        }
        else {
             @*$.najax({
                url: "@Url.Action("OpenExe")",
                dataType: "json",
                 data: { sqdh: $gridList.jqGridRowValue().lissqdh },
                async: true,    
                type: "POST",
                success: function () {
                    //callback(false);
                }, error: function () {
                    //callback(true);
                }
            });*@
            $.modalOpen({
                id: "medicaljgForm",
                title: "Kiểm traBáo cáo",
                url: "http://192.168.3.17:8088/WebSearch.aspx?ReqNO='" + sqdh + "'",
                width: "1000px",
                height: "800px",
                btn: ['', ''],
                btnclass: ['', ''],
            });
        }

    }
</script>

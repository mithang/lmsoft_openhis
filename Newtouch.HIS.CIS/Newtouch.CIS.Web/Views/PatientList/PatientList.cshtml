@using Newtouch.Infrastructure;
@using NewtouchHIS.Lib.Framework.Operator;
@{
	/**/

	ViewBag.Title = "PatientList";
	var opr = OperatorProvider.GetCurrent();
	// T-02: partial trong MainBusiness (render partial bo qua Layout) dong thoi
	// mo duoc bang URL truc tiep; URL standalone can _Index de co jQuery
	// (truoc day: "$ is not defined").
	Layout = "~/Views/Shared/_Index.cshtml";
	var iSReminderBeforehand = SysConfigReader.Bool("IS_ReminderBeforehand", false).Value;
	var isShowghlybz = SysConfigReader.String("IS_Showghlybz");
	var cmmSwitch = SysConfigReader.Bool("cmmSwitch", false).Value;
	var djzhqsj = SysConfigReader.String("YXZ_CIS_1001");
}
@Html.Partial("_YibaoCommonView")

<div id="linkbrlb" role="tabpanel" class="tab-pane">
    <div class="topPanel" style="width: 99%; margin-top: 15px; border-radius: 5px; height:75px">
        <table class="form">
            <tr>
                <th class="formTitle">Khám bệnhLoại:</th>
                <td class="formValue" style="width:10%;">
                    <select id="mjzbz" name="mjzbz" class="form-control formClearIgnore" data-EnumType="EnumOutPatientType">
                    </select>
                </td>
                <td class="formValue" style="width:18%;">
                    <div class="panelposition">
                        <label><input type="radio" name="optionsRadios" class="optionsRadios formClearIgnore" onclick="refleshPatientList()" checked value=@Html.Raw(((int)EnumJzzt.NotYetTreate).ToString()) />Chờ khám bệnh</label>
                        <label><input type="radio" id="radioTreating" name="optionsRadios" class="optionsRadios formClearIgnore" onclick="refleshPatientList()" value=@Html.Raw(((int)EnumJzzt.Treating).ToString()) />Đang khám bệnh</label>
                        <label><input type="radio" id="radioTreated" name="optionsRadios" class="optionsRadios formClearIgnore" onclick="refleshPatientList()" value=@Html.Raw(((int)EnumJzzt.Treated).ToString()) />Đã khám bệnh</label>
                    </div>
                </td>
                <th class="formTitle">Ngày khám:</th>
                <td class="formValue" style="width:13%;">
                    <input id="kzrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:70%;" value="" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', onpicked: function () { refleshPatientList(); } })" />
                </td>
                <td class="formValue" style="width:18%;">
                    <div class="row">
                        <div class="col-md-10">
                            <input id="txt_keyword" type="text" class="form-control formClearIgnore" placeholder="Vui lòng nhậpSố khám ngoại trú,Số bệnh án,Họ tên">
                        </div>
                        <div class="col-md-2" style="line-height:26px;">
                            <button id="btn_search" type="button" class="btn btn-info"><i class="fa fa-search"></i></button>
                        </div>
                    </div>
                </td>
                <td class="formValue">
                    <input type="button" id="btn_startTreat" class="panelposition btn btn-default btn-md" onclick="startTreat()" value="Bắt đầuKhám chữa bệnh">
                    <input type="button" id="btn_resumeTreat" class="panelposition btn btn-default btn-md" onclick="resumeTreat()" value="Tiếp tục điều trị" style="margin-left:6%;">
                </td>
                @*<td class="formValue" style="width: 70px;">
                        <input id="syncPdsbc" type="text" class="form-control" value="2021-6-18" />
                        <input id="btn_syncPdsbc" type="button" class="panelposition btn btn-default btn-md"  value="Bổ sungđẩyđếnNhà thuốc" onclick="synctoPDS()" />
                    </td>*@
            </tr>
        </table>
    </div>
    <div class="contentPanel" style="width: 99%; height: 84%; margin-top: 2px;">
        <div style="background-color: #fff;width:100%;">
            <table id="gridPatientList"></table>
            <div id="gridPatPager"></div>
        </div>
    </div>
</div>
<script src="~/Content/js/pdjhyybb.js"></script>
<script>
    var cmmSwitch = "@(cmmSwitch ? 1 : 0)";
    var djz = "";
    function init_PatientList() {
        initMjzbz();
        gridPatientList();
        $("#btn_search").trigger('click');
    }

    //Làm mới danh sách
    function refleshPatientList() {
        $("#btn_search").trigger('click');
    }

    //vềxe
    $('#txt_keyword').keydownEnterEvent(function() {
        $("#btn_search").trigger('click');
    });

    $('#mjzbz').change(function () {
        $("#btn_search").trigger('click');
    });

    //Khởi tạoKhám bệnhLoại（Đăng nhậpNgười dùngCóchuyên gia,Khám bệnhLoạiMặc địnhgắnchuyên giaNgoại trú）
    function initMjzbz() {
        $.ajax({
            type: "POST",
            url: "/PatientList/IsExpertByLoginUser",
            //data: {  },
            dataType: "json",
            async: false,
            success: function (data) {
                var flag = data;
                if (flag == true) {
                    $("#mjzbz option[value='3']").attr("selected", "selected");
                }
            }
        });
    }

    //Thông tin bệnh nhândanh sách
    function gridPatientList() {
        var $gridPatientList = $("#gridPatientList");
        $gridPatientList.dataGrid({
            url: GetSearchUrl(),
            postData: getSearchPostData(),
            height: $(window).height() - 230,
            caption: "Đăng ký khámThông tin",
            colModel: [
                { label: 'jzId', name: 'jzId', width: 80, align: 'left', hidden: true },
                { label: 'Số khám ngoại trú', name: 'mzh', width: 100, align: 'left' },
                { label: 'Số thứ tự', name: 'queno', width: 30, align: 'left' },
                {
                    label: 'Khám bệnhLoại', name: 'mjzbz', width: 70, align: 'left',
                    formatter: function (celvalue) {
                        return $.enum.getDescByValue("EnumOutPatientType", celvalue);
                    }
                },
                { label: 'Số bệnh án', name: 'blh', width: 80, align: 'left' },
                {
                    label: 'Họ tên', name: 'xmms', width: 100, align: 'left', formatter: function (val, option, rows) {
                        if ('@isShowghlybz' == "ON" && rows.ghlybz) {
                            var desc = $.enum.getDescByValue("EnumMzghly", rows.ghlybz);
                            return rows.xm + "[" + desc + "]";
                        }
                        else
                            return rows.xm;
                    }
                },
                { label: 'xm', name: 'xm', hidden: true},
                { label: 'Giới tính', name: 'xb', width: 50, align: 'left' },
                { label: 'Ngày sinh', name: 'csny', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Loại phí', name: 'brxzmc', width: 80, align: 'left' },
                { label: 'Đăng ký khámKhoa', name: 'ghksmc', width: 80, align: 'left' },
                { label: 'Đăng ký khámBác sĩ', name: 'ghys', width: 80, align: 'left' },
                { label: 'Đăng ký khámNgày', name: 'ghsj', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Đăng ký khámThao tácThời gian', name: 'ghczsj', width: 120, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Khám bệnhBác sĩ', name: 'ghys', width: 80, align: 'left' },
                {
                    label: 'Thao tác', name: 'action', width: 150, align: 'center', formatter: function (val, option, rows) {

                        if (djz == "1") {
							return "<input class='btn btn-default btn-md btn_add' type='button' value='Gọi số' onclick='jiaohao(" + rows.mzh + ",$(this).parent().parent().attr(\"id\"))'/>"+"<input class='btn btn-default btn-md btn_del' type='button' value='Quá số' onclick='guohao(" + rows.mzh + ")'/>";
                            //return '<input type="button" class="btn btn-default"  onclick="jiaohao(' + rows.mzh + ',' + $(this).parent().parent().attr("\'id\'") + ')" value="Gọi số" /> <input type="button" class="btn btn-default"  onclick="guohao(' + rows.mzh + ')" value="quasố" />';
                        } else {
                            return '';
                        }
                    }
                },
                { label: 'jzzt', name: 'jzzt', width: 80, align: 'left', hidden: true },
                { label: 'brxzCode', name: 'brxzCode',hidden: true },
                { label: 'jzks', name: 'jzks', hidden: true },
                { label: 'nlshow', name: 'nlshow', hidden: true },
                { label: 'jzys', name: 'jzys',hidden: true },
                { label: 'ybjsh', name: 'ybjsh',hidden: true },
                { label: 'cfzbz', name: 'cfzbz',hidden: true },
                { label: 'sbbh', name: 'sbbh',hidden: true },
                { label: 'cbdbm', name: 'cbdbm',hidden: true },
                { label: 'py', name: 'py', hidden: true },
                { label: 'kh', name: 'kh', hidden: true },
                { label: 'ContactNum', name: 'ContactNum', hidden: true },
                { label: 'province', name: 'province', hidden: true },
                { label: 'city', name: 'city', hidden: true },
                { label: 'county', name: 'county', hidden: true },
                { label: 'zjlx', name: 'zjlx', hidden: true },
                { label: 'zjh', name: 'zjh', hidden: true },
                { label: 'address', name: 'address', hidden: true },
                { label: 'ghlybz', name: 'ghlybz', hidden: true },
                { label: 'grbh', name: 'grbh', hidden: true }
            ],
            rowNum: 150,
            viewrecords: true,
            pager: "#gridPatPager",
            onSelectRow: function (rowid) {
                var rowdata = $gridPatientList.getRowData(rowid);
                if (rowdata && rowdata.jzzt == '@((int)EnumJzzt.Treated)') {
                    //Khám bệnhKết thúccủaCảnh
                    $('#btn_startTreat').attr('disabled', 'disabled');
                    $('#btn_resumeTreat').removeAttr('disabled', 'disabled');
                }
                else {
                    $('#btn_startTreat').removeAttr('disabled', 'disabled');
                    $('#btn_resumeTreat').attr('disabled', 'disabled');
                }
            },
            ondblClickRow: function (rowid) {
                startTreat(rowid);
            },
            gridComplete: function () {
                if ($("input[name='optionsRadios']:checked").val() == '@((int)EnumJzzt.Treating)') {   //Đang khám bệnh
                    var ids = $("#gridPatientList").getDataIDs();
                    for (i = 0; i < ids.length; i++) {
                        $('#gridPatientList tr[id="' + ids[i] + '"]').addClass('success1');
                    }
                }
                if ($("input[name='optionsRadios']:checked").val() == '@((int)EnumJzzt.Treated)') {   //Đã khám bệnh
                    var ids = $("#gridPatientList").getDataIDs();
                    for (i = 0; i < ids.length; i++) {
                        $('#gridPatientList tr[id="' + ids[i] + '"]').addClass('info');
                    }
                }
            },
            loadComplete: function () {
                //var selRowData = $gridPatientList.jqGrid('getRowData_AllLine');
                //for (var i = 0; i < selRowData.length; i++) {

                //}
            }
        });

        $("#btn_search").click(function () {
            //Xóa trắngThông tin bệnh nhân
            window.currPatientInfo = null;
            removePatientBasicInfo();
            $gridPatientList.jqGrid('setGridParam', {
                postData: getSearchPostData(), url: GetSearchUrl(),
                page: 1,
            }).trigger('reloadGrid');
        });
    }

    //Từ khóa
    function getSearchPostData() {
        var keyword = $("#txt_keyword").val();
        var jzzt = $("input[name='optionsRadios']:checked").val();
        var mjzbz = $('#mjzbz option:selected').val();
        var kzrq = $('#kzrq').val();
        return { keyword: keyword, mjzbz: mjzbz, jzzt: jzzt, kzrq: kzrq };
    }
	function jiaohao(mzh, rowid) {
  //      $.ajax({
  //          type: "POST",
  //          url: "/QueueInfo/CallNumber",
  //          data: { mzh: mzh, calledstu:"2"},
  //          dataType: "json",
  //          async: false,
  //          success: function (data) {
  //              $.modalAlert("Gọi sốHoàn thành！", 'success');
  //              startTreat(rowid);
  //          }
		//});
		$.najax({
			type: "POST",
			url: "/NurseManage/OutpatientConsult/UpdatePatient",
			data: { mzh: mzh, calledstu: 4 },
			dataType: "json",
			async: false,
			success: function (refdata) {
				if (refdata.falg == null || refdata.falg == undefined) {
					startTreat(rowid);
				} else {
					$.modalAlert("Bệnh nhân này đã được gọi số", 'success');
				}
			}
		});

    }
    function guohao(mzh) {
        $.ajax({
            type: "POST",
            url: "/QueueInfo/CallNumber",
            data: { mzh: mzh, calledstu: "3" },
            dataType: "json",
            async: false,
            success: function (ajaxresp) {
                $.modalAlert("Quá sốHoàn thành!", 'success');
            }
        });
    }
    //Url
    function GetSearchUrl() {
		var url = "";
		
        if ($("input[name='optionsRadios']:checked").val() == '@((int)EnumJzzt.NotYetTreate)') {   //Chờ khám bệnh
            url = "/PatientList/SelectNotYetTreateList";
			djz = "1";
			if ('@djzhqsj' == "1") {
			url = "/PatientList/GetdjzList";
		}
        } else if ($("input[name='optionsRadios']:checked").val() == '@((int)EnumJzzt.Treating)' || $("input[name='optionsRadios']:checked").val() == '@((int)EnumJzzt.Treated)') {   //Đang khám bệnh、Đã khám bệnh
            url = "/PatientList/SelectTreatingOrTreatedList";
            djz = "0";
		}
		
        return url;
    }

    //biến toàn cục bản lầnKhám bệnhcủaThông tin bệnh nhân
    var currPatientInfo = Object();

    //Bắt đầu/kếtiếpChẩn đoán
    function startTreat(selrowId) {
        if (!selrowId) {
            selrowId = $("#gridPatientList").jqGrid("getGridParam", "selrow");
        }
        if (!selrowId) {
            $.modalAlert("Vui lòng chọn trước mộtBệnh nhân", 'warning');
            return;
        }
        
        var selRowData = $("#gridPatientList").getRowData(selrowId);

        syncPresChargeStatus(selRowData.blh, true);

        sessionStorage.removeItem('reqSourcePage');  //Xóa trắng trước
        if (selRowData.jzzt === '@((int)EnumJzzt.NotYetTreate)') {
            //Chờ khám bệnh
            //phiếuđộcnhậpdấu hiệu sinh tồnCông tắc（Điều dưỡngnhập）
            if (window.IsVitalSignsSwitch=== 'ON') {
                if (window.IsNurse === "True") {
                    //hiện tạiĐăng nhập ngườiCóĐiều dưỡng
                    $.modalOpen({
                        id: "Form",
                        title: "Dấu hiệu sinh tồn",
                        url: "/PatientList/Form?mzh=" + selRowData.mzh,
                        width: "550px",
                        height: "470px",
                        callBack: function (iframeId) {
                            top.frames[iframeId].submitForm();
                        }
                    });
                    return; //khônglạikếtiếpđi
                }
                //kiểm tracó thểkhôngcó thểBắt đầuKhám bệnh（Chờ khám bệnhcủa）
            }
            //2.checkcó thểkhôngcó thểBắt đầumớicủaKhám bệnh
            //Tra cứuBệnh nhân cùng mộtcáiKhoa cửagấpkhám chuyên gia đợi cuối cùngmột lầnKhám bệnh  Khám bệnhTrạng thái
            var historyLastTreat = null;
            $.ajax({
                type: "POST",
                url: "/PatientList/GetLastTreate",
                data: { blh: selRowData.blh, mjzbz: $('#mjzbz option:selected').val() },
                dataType: "json",
                async: false,
                success: function (ajaxresp) {
                    historyLastTreat = ajaxresp;
                }
            });

            if (historyLastTreat != null && !!historyLastTreat.jzzt && historyLastTreat.jzzt != '@((int)EnumJzzt.Treated)') {
                $.modalAlert("Không thể bắt đầu lượt khám mới<br/>" + "Tồn tại lượt khám chưa kết thúc" + $.getDate({ date: historyLastTreat.zlkssj }), 'warning');
                return;
            }
            //3.
            if (window.IsVitalSignsSwitch === 'ON') {
                //mớiKhám bệnhtảidấu hiệu sinh tồn
                $.najax({
                    type: "POST",
                    url: "/PatientList/GetVitalSignsByMzh",
                    data: { mzh: selRowData.mzh },
                    dataType: "json",
                    success: function (ajaxresp) {
                        if (ajaxresp) {
                            $('#form1').formSerialize(ajaxresp);
                            if (ajaxresp.fzbz == "1") {
                                $("input[name='cfzbzRadios'][value='0']").prop('checked', false);
                                $("input[name='cfzbzRadios'][value='1']").prop('checked', true);
                            } else {
                                $("input[name='cfzbzRadios'][value='1']").prop('checked', false);
                                $("input[name='cfzbzRadios'][value='0']").prop('checked', true);
                            }
                            //window.$('#tizhong').val(ajaxresp.tizhong); //Khởi tạo载vàođãnhậptốtcủadấu hiệu sinh tồn
                            //window.$('#tiwen').val(ajaxresp.tiwen);
                            //window.$('#maibo').val(ajaxresp.maibo);
                            ////window.$('#xueya').val(ajaxresp.xueya);
                            //window.$('#xuetang').val(ajaxresp.xuetang);
                            //window.$('#shengao').val(ajaxresp.shengao);
                            //window.$('#shousuoya').val(ajaxresp.shousuoya);
                            //window.$('#shuzhangya').val(ajaxresp.shuzhangya);
                            //window.$('#huxi').val(ajaxresp.huxi);
                            //window.$("#xuetangclfs").val(ajaxresp.xtfs);
                        }
                    }
                });
            }
            sessionStorage.setItem("reqSourcePage", "fromNotYetTreatePage");

        }
        else if (selRowData.jzzt === '@((int)EnumJzzt.Treating)') {
            //Đang khám bệnh
            sessionStorage.setItem("reqSourcePage", "fromTreatingPage");
        }
        else {
            //Đã khám bệnh
            sessionStorage.setItem("reqSourcePage", "fromTreatedPage");
        }

        $.loading(true);
        window.mrflag = 0;    //nhậnlàCóthứmột lầntảiHồ sơtrang，nàydạngmỗi lầnChẩn đoán，đềusẽTheobệnh ngườicủajzIdtraraLịch sửHồ sơ
        selRowData.mjzbz = $('#mjzbz option:selected').val();
        window.currPatientInfo = selRowData;
        $('#tip_yfly').unbind('change'); //đitrừMặc địnhNhà thuốcchangesự kiện
        //Xóa trắng tất cảvăn bản、Đơn thuốc、Đơn thuốc lịch sử、griddanh sách
        newtouch_globalevent_f4();  //ởbệnhVDtrang

        //Hiển thịThông tin bệnh nhân
        showPatientBasicInfo();
        if (window.currPatientInfo.cfzbz == "1") {
            window.$("input[name='cfzbzRadios'][value='0']").prop('checked', false);
            window.$("input[name='cfzbzRadios'][value='1']").prop('checked', true);
        } else {
            window.$("input[name='cfzbzRadios'][value='1']").prop('checked', false);
            window.$("input[name='cfzbzRadios'][value='0']").prop('checked', true);
        }
        window.$('#mzh').text(window.currPatientInfo.mzh);
        window.$('#zlkssj').text($.getTime());
        window.$('#jzks').text('@opr.DepartmentName');
        window.$('#sbbh').text(window.currPatientInfo.sbbh);
        //chuyển đếnđếnHồ sơtrang
        $('#myTab [href="#linkbl"').trigger('click'); //Khởi tạoHiển thịnàotab

        $.loading(false);


        if (cmmSwitch === "1" && selRowData.jzzt === '@((int)EnumJzzt.NotYetTreate)') {
            $("#li_pushPatient").hide();
            $.najax({
                type: "Get",
                url: "/MainBusiness/TcmHis01",
                data: selRowData,
                dataType: "json",
                success: function (ajaxresp) { }
            });
        } else if (cmmSwitch === "1" && selRowData.jzzt !== '@((int)EnumJzzt.NotYetTreate)') {
            $("#li_pushPatient").show();
        }
    }

    //khôi phụclạiKhám bệnh
    function resumeTreat() {
        var selrowId = $("#gridPatientList").jqGrid("getGridParam", "selrow");
        if (!selrowId) {
            $.modalAlert("Vui lòng chọn trước mộtBệnh nhân", 'warning');
            return;
        }
        var selRowData = $("#gridPatientList").getRowData(selrowId);
        if (!selRowData || selRowData.jzzt != '@((int)EnumJzzt.Treated)') {
            return;
        }

        syncPresChargeStatus(selRowData.blh, false);

        //2.checkcó thểkhôngcó thểkhôi phụclạiKhám bệnh
        //Tra cứuBệnh nhân cùng mộtcáiKhoa cửagấpkhám chuyên gia đợi cuối cùngmột lầnKhám bệnh  Khám bệnhTrạng thái
        var historyLastTreat = null;
        $.ajax({
            type: "POST",
            url: "/PatientList/GetLastTreate",
            data: { blh: selRowData.blh, mjzbz: $('#mjzbz option:selected').val() },
            dataType: "json",
            async: false,
            success: function (ajaxresp) {
                historyLastTreat = ajaxresp;
            }
        });
        if (historyLastTreat == null || !!!historyLastTreat.jzzt) {
            return;
        }
        if (historyLastTreat.jzId != selRowData.jzId) {
            $.modalAlert("Không thể khôi phục<br/>" + "Chỉ lần khám cuối cùng mới khôi phục được", 'warning');
            return;
        }
        $.najax({
            url: "/PatientList/ResumeTreat",
            dataType: "json",
            data: { jzId: selRowData.jzId },
            type: "POST",
            success: function (data) {
                $.modalAlert("Đã khôi phục lượt khám", 'success');
                $("#btn_search").trigger('click');
            }
        });
    }

    //TheoSố bệnh ánĐồng bộBệnh nhâncủaĐơn thuốcThu phíTrạng thái
    //sync：CóKhôngĐồng bộ
    function syncPresChargeStatus(blh, sync) {
        $.ajax({
            url: '/PatientList/SyncPresChargeStatus',
            data: { blh: blh },
            dataType: "json",
            async: !!!sync,
        });
    }


</script>

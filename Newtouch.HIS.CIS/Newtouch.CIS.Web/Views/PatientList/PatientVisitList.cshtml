@using Newtouch.Infrastructure;
@{
	ViewBag.Title = "Khám bệnhThông tinTra cứu";
	Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
	#btn_search {
		width: 45px;
		font-weight: bolder;
	}
</style>
<div class="panel panel-default">
	<div class="panel-heading navb-bg">
		Điều kiện lọc
	</div>
	<table class="form">
		<tr>
			<td class="formTitle"><span style="color:#ff0000;">*</span>Khám bệnhThời gian:</td>
			<td class="formValue">
				<input id="txt_kssj" type="text" class="form-control input-wdatepicker" style="width:90%; float:left;" onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" onfocus="    WdatePicker({ dateFmt: 'dd/MM/yyyy' })" value="@DateTime.Now.AddMonths(-12).ToString("dd/MM/yyyy")">
			</td>
			<td class="formTitle" style="width:10px">đến</td>
			<td class="formValue">
				<input id="txt_jssj" type="text" class="form-control input-wdatepicker" style="width:90%; float:left;" onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" onfocus="    WdatePicker({ dateFmt: 'dd/MM/yyyy' })" value="@DateTime.Now.ToString("dd/MM/yyyy")">
			</td>
			<td class="formTitle">Khám bệnhLoại:</td>
			<td class="formValue formDdlSelectorTd">
				<select class="form-control" id="sel_jzlx">
					<option value="">===Tất cả===</option>
					<option value="0">Ngoại trú</option>
					<option value="1">Nhập viện</option>
				</select>
			</td>
			<td class="formTitle">Quyết toánTrạng thái:</td>
			<td class="formValue formDdlSelectorTd">
				<select class="form-control" id="sel_jszt">
					<option value="">===Tất cả===</option>
					<option value="0">Chưa quyết toán</option>
					<option value="1">Đã quyết toán</option>
				</select>
			</td>
			<td class="formTitle">Tên bệnh nhân:</td>
			<td class="formValue">
				<input type="text" class="form-control" id="txtxm" placeholder="Tên bệnh nhân" />
			</td>
			<td class="formTitle">Số thẻ:</td>
			<td class="formValue">
				<input type="text" class="form-control" id="txtkh" placeholder="Số thẻ" />
			</td>
			<td class="formValue">
				<input type="button" class="btn btn-primary btn-md" id="btn_search" value="Tra cứu" />
			</td>
		</tr>
	</table>
</div>
<div class="gridPanel" style="width: 35%;float:left;">
	<table id="gridPatList"></table>
	<div id="gridPatPager" rel="form"></div>
</div>
<div class="gridPanel" id="divPatInfo" style="margin-left: 0.5%; width: 64%; float: left; background-color: aliceblue; border-style: solid; border-width: 1px; border-color:gainsboro;">

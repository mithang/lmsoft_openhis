                                         width: "900px",
                                         height: "700px",
                                         btn: ['Sao chép', 'Đóng'],
                                         callBack: function (yziframeId) {
                                             var yzlistId = top.frames[yziframeId].submitForm();
                                             $.najax({
                                                 url: "/DoctorManage/DoctorsAdvice/GetHistoricalRegist",
                                                 dataType: "json",
                                                 data: { zyh: zyhorryrq.split(',')[0],curzyh:currentobj.zyh , yzlistId: yzlistId },
                                                 type: "POST",
                                                 loadingtext: "Đang trích dẫn y lệnh lịch sử, vui lòng đợi...",
                                                 success: function (resp) {
                                                     if (resp.data == "T")
                                                     {
                                                         $.modalMsg("Trích dẫnthành công", 'success');
                                                         $.modalClose("HistoricalZyyzForm");
                                                     }
                                                     else {
                                                         $.modalMsg("Trích dẫn thất bại, vui lòng thử lại!", 'warning');
                                                     }
                                                     
                                                 }
                                             });
                                         }
                                     })
                                 }
                             }
                         });
                     }
                 },
                 {
                     name: 'Lịch sửBệnh án',
                     onClick: function (row) {
                         top.top.$.Newtouchtab.addTabWithOutMenu({ name: "Lịch sửBệnh án", enName: "", url: "/MedicalRecordManage/PatInfo/PatHistoricalMedRecord?zyh=" + currentobj.zyh, AppId: "EMR" });
                     }
                 },
                {
                    name: 'LISBáo cáo',
                    onClick: function (row) {
                        //Jinfeng Yitong LIS 2024-4-28 chl
                        window.open("@pacsHost/doctor-api/api/viewer?type=1&pid=" + currentobj.blh + "&areaCode=" + "@curOpr.OrganizeId", "_blank");

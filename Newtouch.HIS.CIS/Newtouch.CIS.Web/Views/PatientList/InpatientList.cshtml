                        //    btn: ['', 'Đóng'],
                        //    btnclass: ['', 'btn btn-danger'],
                        //});
                    }
                }
                , {
                    name: 'PASCBáo cáo',
                    onClick: function (row) {
                        //Jinfeng Yitong PACS 2024-4-28 chl
                        window.open("@pacsHost/doctor-api/api/viewer?type=2&pid=" + currentobj.blh + "&areaCode=" + "@curOpr.OrganizeId", "_blank");
                        //đothửchuỗinhận

@model dynamic
@{
    ViewBag.Title = "Nhập việnBệnh nhânDanh sách";
    Layout = "~/Views/Shared/_Index.cshtml";
    var pacsHost = SiteUrl.GetUrl("OuterPacsServiceHost", "");
    //Y lệnh dài hạnInphiếuCóKhôngHiển thịchữ ký
    var isShowSign = SysConfigReader.String("IS_ShowSigner");
    var curOpr = NewtouchHIS.Lib.Framework.Operator.OperatorProvider.GetCurrent();
}
<script src="~/Content/js/BootstrapMenu.min.js"></script>
<style>

    #dev_ycq {
        display: none;
    }
    #dv_zbqleft {
        width: 82%;
    }
    #txt_cwmc {
        margin: 7px 15px;
        height: 21px;
        width: 100px;
        padding: 0 10px;
        border: 0;
        border-bottom: 1px solid #ccc;
    }

    .li-refresh {
        background-color: #00a0e9;
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
    }

        .li-refresh span {
            margin: 10px 15px;
        }

    #div_zbq {
        overflow-y: auto;
    }
</style>
<ul class="nav nav-tabs navb-bg" role="tablist">
    <li role="presentation" class="active" id="linkzbq">
        <a href="#div_zbq" role="tab" data-toggle="tab">Đang ở khu bệnh</a>
    </li>
    <li role="presentation" id="linkycq">
        <a href="#dev_ycq" role="tab" data-toggle="tab">Đã chuyển khu</a>
    </li>
    <li>
        <table class="form" style="width:460px">
            <tr>
                <td class="formValue formDdlSelectorTd">
                    <select id="sel_inpatientArea" class="form-control">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <td class="formValue formDdlSelectorTd" style="width:90px">
                    <select id="sel_inpatienttype" class="form-control">
                        <option value="">Tất cả</option>
                        <option value="@ViewBag.ysgh">Phụ trách</option>
                    </select>
                </td>
                <td>
                    <input id="txt_cwmc" placeholder="NhậpSố giường" />
                </td>
                <td style="padding-left:20px;">
                    <i class="fa fa-id-card-o" title="Chế độ thẻ giường" style="line-height:40px" hidden></i>
                    <i class="fa fa-list" title="Chế độ danh sách" style="line-height:40px"></i>
                </td>
            </tr>
        </table>
    </li>
    <li class="li-refresh" style="float: right;">
        <span class="glyphicon glyphicon-refresh" aria-hidden="true" onclick="newtouch_event_f4()"></span>
    </li>
</ul>
<div class="panel panel-default">
    <div id="div_zbq">
        <div id="dv_zbqright" style="width: 17%; float: right;height:95%; ">
            @Html.Partial("InpatientInfoShow")
        </div>
        @Html.Partial("_InpatientMahjongCardList")
    </div>
    <div id="dev_ycq">
        <table class="form" style="margin-left:5px;">
            <tr>
                <th class="formTitle">Chuyển khuNgày bắt đầu:</th>
                <td class="formValue">
                    <input id="txt_ksrq" type="text" class="form-control input-wdatepicker formClearIgnore" onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy'})" value="@DateTime.Now.ToString("yyyy-MM-01")" />
                </td>
                <th class="formTitle">Ngày kết thúc:</th>
                <td class="formValue">
                    <input id="txt_jsrq" type="text" class="form-control input-wdatepicker formClearIgnore" onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" value="@DateTime.Now.ToString("dd/MM/yyyy")" />
                </td>
                <th class="formTitle" style="width:120px">Số nhập viện/Họ tên/Số thẻ:</th>
                <td class="formValue">
                    <input type="text" id="ycq_keyword" name="ycq_keyword" class="form-control" placeholder="Ít nhất 1 ký tự" />
                </td>
                <td class="formTitle" colspan="2" style="padding-left:20px">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary" value="Tra cứu" style="margin-right:10px" />
                    <input type="button" id="btn_printcq" onclick="printcq()" class="btn btn-md btn-primary" value="InDài hạn" style="margin-right:10px" />
                    <input type="button" id="btn_printls" onclick="printls()" class="btn btn-md btn-primary" value="InTạm thời" style="margin-right:10px" />
                </td>
                <td></td>
                <td></td>
            </tr>
        </table>
        <table id="div_ycqList"></table>
        <div id="div_ycqgridPager"></div>
    </div>
</div>
<script type="text/javascript">

    var nurseCenter = false;
    var isshowSign = '@isShowSign';
    $(function () {
        rows = 12;
        initinpatientList();
    });
    //**************common**************
    $('#txt_cwmc').keyup(function () {
        commonsearch();
    });
    $('#sel_inpatienttype,#sel_inpatientArea').change(function () {
        if ($(this).attr("id") == "sel_inpatientArea") {
            var $thisval = $(this).val();
            var flag = false;
            $("#sel_inpatientArea option").each(function () {
                if ($thisval == $(this).val()) {
                    flag = true;
                    localStorage.removeItem("lastabq");
                    localStorage.setItem("lastabq", $(this).val());
                }
            });
            if (!flag) {//hộp thả xuốngtìmkhôngđếnTùy chọnthìkhôngchọn
                $(this).val("");
            }
        }
        commonsearch();
    });

    function initinpatientList() {
        $("#sel_inpatientArea").bindSelect({
            url: "/SystemManage/BaseData/GetAuthedWardSelectJson",
            //url: "/NurseManage/EntryRegistration/TreeViewdata",
        });

        $("#sel_inpatientArea").removeAttr("style");

        var lastbqval = localStorage.getItem("lastabq");
        var selectval = "";
        if (lastbqval == typeof (undefined) || lastbqval == "" || lastbqval == null || lastbqval == 'null') {
            if ('@ViewBag.bqval' !== "") {
                //Gán giá trị
                selectval = '@ViewBag.bqval';
            }
        } else {
            //Gán giá trị
            selectval = lastbqval;
        }
        if (selectval !== "") {
            $('#sel_inpatientArea').val(selectval).trigger("change", false);
        }
    }
    function commonsearch() {
        $(".ul-zbq").children("li").remove();
        $('.ui-pg-input').val(1);
        ajaxrequestzbq();
        ajaxrequestycq();
    }

    function newtouch_event_f4() {
        //Thời gian bắt đầu，Thời gian kết thúckhôi phục
        $('#txt_ksrq').val($.getDate());
        $('#txt_jsrq').val($.getDate());
        $('#ycq_keyword').val('');
        clearSelectpatient();//xóalýhiện tạiĐã chọnđối tượng
        zbqPatientList = [];//xóalýKhu bệnhtrongbệnh người
        init();
        $('#linkzbq').addClass("active");
        $('#linkycq').removeClass("active");
        $(".nav-tabs li[id='linkzbq']").trigger("click");
    }
    //**************Đang ở khu bệnh**************

    $(function () {
        init();
        //tìm kiếmThống kêTùy chọnthẻcắtđổi
        $(".nav-tabs li").click(function () {
            clearSelectpatient();
            if ($(this)[0].id === "linkzbq") {
                $("#div_zbq").show(300, ajaxrequestzbq);
                $("#dev_ycq").hide(500);
                $('.ul-zbq,.fa-list').show();
                $('#gbox_div_zbqList,.fa-id-card-o').hide();
                $(".ul-zbq li").each(function () {
                    if ($(this).find(".dv-cwmc").hasClass("bedchoose")) {
                        $(this).find(".dv-cwmc").removeClass("bedchoose");
                        $(this).trigger("mouseout");
                    }
                    if ($(this).hasClass("bedborderchoose")) {
                        $(this).removeClass("bedborderchoose");
                    }
                });
                //ajaxrequestzbq();
            } else if ($(this)[0].id === "linkycq") {
                $("#div_zbq").hide(500);
                $("#dev_ycq").show(300, ajaxrequestycq);
                $('.fa-id-card-o,.fa-list').hide();
                //ajaxrequestycq();
            }
        });
        $(".li-refresh").click(function () {

        });
        $("#div_zbq").height($(window).height() - 55);
        InitTZ();
    });

    function init() {
       // initzbq();
        initycq();
    }

    //**************đãra khỏi khu**************

    function initycq() {
        div_ycqList();

        $('#ycq_keyword').newtouchBatchFloatingSelector({
            width: 450,
            height: 200,
            caption: "ChọnBệnh nhân",
            url: "@Url.Action("patientFloatingSelectorSource")",
            ajaxparameters: function ($thisinput) {
                var keyword = $thisinput.val().trim();
                return "keyword=" + keyword;
            },
            itemdbclickhandler: function ($thistr, $thisinput) {
                $('#ycq_keyword').val($thistr.attr('data-zyh'));
            },
            colModel: [
                { label: 'Khóa chính', name: 'Id', hidden: true },
                { label: 'Số nhập viện', name: 'zyh', width: 100, align: 'center' },
                { label: 'Số bệnh án', name: 'blh', width: 90, align: 'center' },
                { label: 'Họ tên', name: 'xm', width: 80, align: 'center' },
                { label: 'Ngày sinh', name: 'birth', hidden: true, width: 100, align: 'center' },
                {
                    label: 'Giới tính', name: 'xb', width: 50, align: 'center', formatter: function (cellvalue) {
                        return $.getGender(cellvalue);
                    }
                },
                { label: 'Tuổi', name: 'birth', width: 50, align: 'center' },
                { label: 'Ngày nhập viện', name: 'ryrq', hidden: true }
            ]
        });
    }

    function div_ycqList() {
        $('#div_ycqList').dataGrid({
            url: "@("GetycqPatientList")",
            postData: { bqCode: $('#sel_inpatientArea').val(), ys: $('#sel_inpatienttype').val(), bedCode: $('#txt_cwmc').val(), ksrq: $('#txt_ksrq').val(), jsrq: $('#txt_jsrq').val(), zyh: $('#ycq_keyword').val() },
            height: $(window).height() - 160,
            shrinkToFit: false,
            unwritten: false,
            colModel: [
                { label: 'Id', name: 'Id', hidden: true },
                { label: 'brxzdm', name: 'brxzdm', hidden: true },
                { label: 'brxzmc', name: 'brxzmc', hidden: true },
                { label: 'Họ tên', name: 'xm', align: 'center', width: 150 },
                { label: 'Số nhập viện', name: 'zyh', align: 'center', width: 80 },
                { label: 'Số thẻ', name: 'cardno', align: 'center', width: 50 },
                { label: 'Số giường', name: 'cwmc', align: 'center', width: 80 },
                {
                    label: 'Giới tính', name: 'sex', align: 'center', width: 100, formatter: function (val) {
                        return $.getGender(val);
                    }
                },
                { label: 'Tuổi', name: 'nlShow', align: 'center', width: 70 },
                { label: 'Chẩn đoán nhập viện', name: 'zdmc', width: 80, align: 'left' },
                { label: 'Ngày nhập viện', name: 'ryrq', align: 'center', width: 140, formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d' } },
                { label: 'Chuyển khuNgày', name: 'cqrq', align: 'center', width: 140, formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d' } },
                { label: 'Giường bệnhBác sĩ', name: 'ysmc', align: 'center', width: 120 }
            ],
            pager: "#div_ycqgridPager",
            sortname: 'cqrq desc',
            gridComplete: function () {
                //Ẩngridthanh cuộn dưới cùng
                $("#div_ycqList").closest(".ui-jqgrid-bdiv").css({ "overflow-x": "hidden" });
            },
            onSelectRow: function (rowid) {
                var obj = $("#div_ycqList").jqGrid('getRowData', rowid);
                onSelectpatient(obj);
            }
        });
    }

    //Lấyđãra khỏi khuThông tin bệnh nhân
    function ajaxrequestycq() {
		if (validateSearch()) {
            $('#div_ycqList').jqGrid('setGridParam', {
               url: "@("GetycqPatientList")",
                postData: { bqCode: $('#sel_inpatientArea').val(), ys: $('#sel_inpatienttype').val(), bedCode: $('#txt_cwmc').val(), ksrq: $('#txt_ksrq').val(), jsrq: $('#txt_jsrq').val(), zyh: $('#ycq_keyword').val()},
                ondblClickRow: function (rowid) {
                    var obj = $("#div_ycqList").jqGrid('getRowData', rowid);
                    onSelectpatient(obj);
                    sessionStorage.setItem('currentobj', JSON.stringify(currentPatient));
                    top.top.$.Newtouchtab.tryCloseTab({ name: "Y lệnhQuản lý", url: "/DoctorManage/DoctorsAdvice/Index?IsOnlyLook=true&kssj=" + $('#txt_ksrq').val() + "&ycqbr=1", AppId: "CIS"});
                    top.top.$.Newtouchtab.addTabWithOutMenu({ name: "Y lệnhQuản lý", enName: "", url: "/DoctorManage/DoctorsAdvice/Index?IsOnlyLook=true&kssj=" + $('#txt_ksrq').val()+"&ycqbr=1", AppId: "CIS" });
                }
            }).trigger('reloadGrid');
            @*$.najax({
                url: "@("GetycqPatientList")",
                dataType: "json",
                data: { bqCode: $('#sel_inpatientArea').val(), ys: $('#sel_inpatienttype').val(), bedCode: $('#txt_cwmc').val(), ksrq: $('#txt_ksrq').val(), jsrq: $('#txt_jsrq').val(), zyh: $('#ycq_keyword').val() },
                type: "POST",
                success: function (respdata) {
                    $('#div_ycqList').jqGrid("clearGridData");
                    $('#div_ycqList').newtouchLocalDataGrid(null, JSON.parse(respdata.data));
                }
            });*@
        }
    }

    $('#btn_search').click(function () {
        ajaxrequestycq();
    });


    function validateSearch() {
        var bqval = $('#sel_inpatientArea').val();
        if (bqval == "") {
            $.modalAlert("Khu bệnh chưa chọn", 'warning');
            return false;
        }
        return true;
    }

    //InY lệnh dài hạn
    function printcq() {
        var keyValue = $("#div_ycqList").jqGridRowValue().zyh;
        if (!!!keyValue) {
            $.modalAlert("Chưa chọn bệnh nhân","warning");
            return;
        }
        var isSign = "0";
        if (isshowSign && isshowSign === '1') {
            isSign = "1";
        }
        top.top.$.Newtouchtab.addTabWithOutMenu({ name: keyValue + "-Y lệnh dài hạn", enName: "", url: "/SystemManage/YzPreView/YzPreView?zyh=" + keyValue + "&orgId=" + '@curOpr.OrganizeId' + "&isSign=" + isSign + "&yzlx=" + "Y lệnh dài hạn", AppId: "EMR" });
        //window.open("/ReportManage/Report/PrintCqyzReport?zyh=" + keyValue+ "&isShowSign=" + isSign,"height=500, width=1195,top=100, left=50, toolbar =no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no");
    }

    //InY lệnh tạm thời
    function printls() {
        var keyValue = $("#div_ycqList").jqGridRowValue().zyh;
        if (!!!keyValue) {
            $.modalAlert("Chưa chọn bệnh nhân", "warning");
            return;
        }
        var isSign = "0";
        if (isshowSign && isshowSign === '1') {
            isSign = "1";
        }
        top.top.$.Newtouchtab.addTabWithOutMenu({ name: keyValue + "-Y lệnh tạm thời", enName: "", url: "/SystemManage/YzPreView/YzPreView?zyh=" + keyValue + "&orgId=" + '@curOpr.OrganizeId' + "&isSign=" + isSign + "&yzlx=" + "Y lệnh tạm thời", AppId: "EMR" });
        //window.open("/ReportManage/Report/PrintLsyzReport?zyh=" + keyValue+ "&isShowSign=" + isSign, "height=500, width=1195,top=100, left=50, toolbar =no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no");
    }
    //phảiphímmenuphiếusự kiện
    function InitTZ() {
        var menuNo = new BootstrapMenu('.ul-zbq li', {
            fetchElementData: function ($rowElem) {
                currentobj = { "blh": $($rowElem).find(".dv-patxm").attr('data-blh'), "zyh": $($rowElem).find(".dv-patxm").attr('data-zyh'), "xm": $($rowElem).find(".dv-patxm").attr('data-xm'), "sex": $($rowElem).find(".dv-patxm").attr('data-sex'), "age": $($rowElem).find(".dv-patxm").attr('data-age'), "brxzmc": $($rowElem).find(".dv-patxm").attr('data-brxzmc'), "brxzdm": $($rowElem).find(".dv-patxm").attr('data-brxzdm'), "ryrq": $($rowElem).find(".dv-patxm").attr('data-ryrq') };

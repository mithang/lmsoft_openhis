    // FIX gstack T-21: jclocaldata/jylocaldata chi duoc dinh nghia trong
    // partial Xet nghiem/Kiem tra (Apply/Examination.cshtml,
    // Apply/Inspection.cshtml), ma 2 partial nay chi render khi
    // IsOpenJyJcSwitch == true. Khi switch tat, click tab benh nhan danh
    // vao `jclocaldata.length` -> ReferenceError (pageerror) va handler
    // chet truoc khi chuyen tab. Khai bao mac dinh rong o day (var khai
    // bao lai khong reset mang da co neu partial da render).
    if (typeof jclocaldata === 'undefined') { var jclocaldata = []; }
    if (typeof jylocaldata === 'undefined') { var jylocaldata = []; }
    //click：điểmnhấptabnội dungcủasự kiện
    $('a[data-toggle="tab"]').on('click', function (e, v) {
        var currentlink = $('.nav-tabs').find("li.active a").attr("href");//hiện tạitrangmặt
        var targetlink = e.target.hash;//Mục tiêutrangmặt
        if ((currentlink !== "#linkbrlb" || currentlink !== "#linkbl") && targetlink == "#linkbrlb") {//Danh sách bệnh nhân，Ngoại trúHồ sơ khôngNhắc nhở//KháctrangmặtcóDữ liệutồn tạiởkhibậtcửa sổNhắc nhở
            if ($("#gridcgxmcf").jqGrid('getDataIDs').length > 0 || $("#gridkfcf").jqGrid('getDataIDs').length > 0
                || $("#gridxycf").jqGrid('getDataIDs').length > 0 || $("#gridzycf").jqGrid('getDataIDs').length > 0
                || $("#gridwzhccf").jqGrid('getDataIDs').length > 0
                || jclocaldata.length > 0 || jylocaldata.length > 0) {
                e.preventDefault();
                e.stopPropagation();
                confirm($(this).attr("href"));
            }
        } else {
            transferbool = true;
            $('#myTab a[href="' + $(this).attr("href") + '"]').tab('show')//Khởi tạoHiển thịnàotab
        }
    });
    function confirm(TargetHref) {
        $.modalConfirm("Hiện tại trang còn dữ liệu y lệnh chưa lưu, rời trang sẽ xóa trắng dữ liệu, có vẫn cần chuyển không?", function (flag) {
            if (flag) {
                transferbool = true;
                $('#myTab a[href="' + TargetHref + '"]').tab('show')//.trigger('click'); //Khởi tạoHiển thịnàotab
            } else {
                return false;
            }
        });
    }
</script>
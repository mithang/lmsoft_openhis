@{
    ViewBag.Title = "Inspection";
    Layout = null;
}

<div id="linkjy" role="tabpanel" class="tab-pane" style="width:70.5%; float:right; margin-right: 10px; border:solid 1px #ddd; margin-top: 3px;">
    <div style="background-color: #fff;">
        <table id="gridjy"></table>
    </div>
    @*divGridjy-Phiên bản cũ*@
    <div id="divGridjy" style="display:none;">
        <table id="alreadyJYAppliedList"></table>
    </div>
    <div id="divGridjyzh" style="background-color:white">
        <table id="alreadyJYAppliedGroupList"></table>
    </div>
    <table class="form">
        <tr>
            <td class="formTitle">
                Ấn tượng lâm sàng
            </td>
            <td class="formValue">
                <input id="txt_jy_lcyx" name="txt_jy_lcyx" type="text" class="form-control" />
            </td>
            <td class="formTitle">
                Ghi chú yêu cầu
            </td>
            <td class="formValue">
                <input id="txt_jy_sqbz" name="txt_jy_sqbz" type="text" class="form-control" />
            </td>
            <td style="width:100px;"></td>
            <td style="width:100px;"></td>
        </tr>
        <tr>
            <td colspan="4"></td>
            <td>
                <input type="button" class="btn btn-primary" value="Quay lại bệnh án" style="display:table-cell" onclick="SaveInspectionbyZt()" />
            </td>
            <td class="formValue">
                <input type="button" class="btn btn-primary" value="F3: Lưu phiếu yêu cầu" style="display:table-cell" onclick="SaveInspectionbyZt('1')" />
            </td>
        </tr>
    </table>
</div>

<script>
    var jyflag = 0;
    var jylocaldata = new Array();
    var thsNewJyCfh = null; //Số đơn thuốc
    function init_Inspection() {
        jylocaldata = new Array();
        thsNewJyCfh = null;
        if (window.alldataArray.jycf) {
            jylocaldata = $.jsonWhere($.deepClone.clone(window.alldataArray.jycf), function (icf) {
                if (!!!icf.cfh) {
                    thsNewJyCfh = icf.cfh;
                    return true;
                }
                return false;
            });
        }
        else {
            window.alldataArray.jycf = new Array(); //Để tiện sử dụng sau này$.each()
        }

        if (!!!thsNewJyCfh) {
            thsNewJyCfh = GetNewPresNo();
        }

        if (jyflag == 0) {   //Khởi tạo trang này
            gridjy();
            gridAlreadyJYApplied();
            gridAlreadyJYGroupApplied();
            jyflag = 1;
        }
        else {
            //$("#gridjy").clearGridData();
            //$('#alreadyJYAppliedList').clearGridData();
            //
            //$('#alreadyJYAppliedList').newtouchLocalDataGrid(null, jylocaldata);
            EnableInspectionInlineEditBox();
        }
    }

    //Danh sách đơn thuốc
    function gridjy() {
        var $gridjy = $("#gridjy");
        $gridjy.dataGrid({
            caption: "Chọn bộ mẫu",
            height: 130,
            //multiselect: true,
            unwritten: false,
            colModel: [
                { label: 'Tên hạng mục', name: 'xmmc', width: 200, align: 'left' },
                { label: 'Mã hạng mục', name: 'xmCode', width: 120, align: 'left' },
                {
                    label: 'Đơn giá', name: 'dj', width: 100, align: 'left', formatter: "number"
                    , formatoptions: { decimalPlaces: 2, defaultValue: '0.00' }
                },
                { label: 'Đơn vị', name: 'dw', width: 100, align: 'left' },
                { label: 'Số lượng', name: 'sl', width: 80, align: 'left' },
                { label: 'zxks', name: 'zxks', width: 60, align: 'left', hidden: true },
                { label: 'Khoa thực hiện', name: 'zxksmc', width: 80, align: 'left' },
                { label: 'Có phải bảo hiểm y tế không', name: 'sfyb', width: 60, align: 'center' },
                { label: 'Bộ mẫuID', name: 'ztId', width: 60, align: 'left', hidden: true },
                { label: 'Tên bộ mẫu', name: 'ztmc', width: 120, align: 'center' }
            ],
            gridComplete: function () {
                //ẨngridThanh cuộn dưới cùng
                $gridjy.closest(".ui-jqgrid-bdiv").css({ "overflow-x": "hidden" });
            }
            //onSelectRow: function (rowid, status) {
            //    gridjycheck([rowid], status);
            //},
            //onSelectAll: function (aRowids, status) {
            //    gridjycheck(aRowids, status);
            //}
        });
    }

    function gridjycheck(aRowids, status) {
        $.each(aRowids, function () {
            if (status === true) {
                var data = $("#gridjy").getRowData(this);
                if (window.currPatientInfo.brxzCode != "" &&'@ViewBag.ControlbrxzCode'.indexOf(window.currPatientInfo.brxzCode) > -1 && data.sfyb == "否") {
                    $.modalAlert("Bệnh nhân này là bệnh nhân bảo hiểm y tế, không được chọn hạng mục tự trả【" + data.xmmc + "】", "warning");
                    $("#gridjy").jqGrid('setSelection', rowid, false); //Cài đặtjqGridChọn
                    return false;
                }
                addJYRow(this);
            }
            else {
                deleteJYRow(this);
            }
        });
        CalculateInsPresJYAmount($("#gridjy"));
    }

    function addJYRow(sourceRowid) {
        var sourceRowData = $("#gridjy").getRowData(sourceRowid);
        var rowIds = $("#alreadyJYAppliedList").jqGrid('getDataIDs');
        for (var i = 0; i < rowIds.length; i++) {
            var currRow = $("#alreadyJYAppliedList").getRowData(rowIds[i]);
            if (currRow.xmCode === sourceRowData.xmCode) {
                return; //Đã thêm rồi  //Không được thêm trùng lặp
            }
        }
        //Thực hiệnadd
        var aRowData = {};
        aRowData.xmmc = sourceRowData.xmmc;
        aRowData.xmCode = sourceRowData.xmCode;
        aRowData.dj = sourceRowData.dj;
        aRowData.dw = sourceRowData.dw;
        aRowData.sl = sourceRowData.sl;
        aRowData.zxks = sourceRowData.zxks;
        aRowData.zxksmc = sourceRowData.zxksmc;
        aRowData.ztId = sourceRowData.ztId;
        aRowData.ztmc = sourceRowData.ztmc;
        $('#alreadyJYAppliedList').newtouchLocalDataGrid(null, aRowData);
        EnableInspectionInlineEditBox();
    }

    function deleteJYRow(sourceRowid) {
        var sourceRowData = $("#gridjy").getRowData(sourceRowid);
        var rowIds = $("#alreadyJYAppliedList").jqGrid('getDataIDs');
        for (var i = 0; i < rowIds.length; i++) {
            var currRow = $("#alreadyJYAppliedList").getRowData(rowIds[i]);
            if (currRow.xmCode === sourceRowData.xmCode) {
                //Thực hiện xóa bỏ
                $('#alreadyJYAppliedList').jqGrid("delRowData", rowIds[i]);
                return;
            }
        }
    }

    //Tính số tiền phiếu yêu cầu
    function CalculateInsPresJYAmount($grid) {
        var totalAmount = 0.00;
        var allData = $grid.jqGrid('getRowData_AllLine', null, true);
        $.each(allData, function () {
            if (!!this.zhje) {
                totalAmount += parseFloat(this.zhje);
            }
            else {
                var sl = $("#alreadyJYAppliedList input[name=sl]").val();
                totalAmount += parseFloat(this.dj) * parseFloat(sl);
            }

        });
        $grid.jqGrid("setCaption", "已开申请单明细，申请单总金额：" + "<label style='color:red;'>￥"
            + totalAmount.toFixed(2) + "</label>");   //Đặt lạicaptionGiá trị thuộc tính
    }

    function gridAlreadyJYApplied() {
        //init Phiếu yêu cầu đã lập
        $('#alreadyJYAppliedList').newtouchLocalDataGrid({
            height: $(window).height() - 390,
            unwritten: false,
            editurl: "clientArray",  //Chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            caption: "Chi tiết phiếu đã lập, tổng số tiền phiếu:0.00",
            colModel: [
                { label: 'Tên hạng mục', name: 'xmmc', width: 200, align: 'left' },
                { label: 'Mã hạng mục', name: 'xmCode', width: 200, align: 'left' },
                { label: 'Đơn giá', name: 'dj', width: 120, align: 'left' },
                {
                    label: 'Số lượng', name: 'sl', width: 80, align: 'left', editable: true,editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    CalculateInsPresJYAmount($('#alreadyJYAppliedList'));
                                }
                            }
                        ]
                    } },
                { label: 'Đơn vị', name: 'dw', width: 120, align: 'left' },
                { label: 'zxks', name: 'zxks', width: 60, align: 'left', hidden: true },
                { label: 'Khoa thực hiện', name: 'zxksmc', width: 120, align: 'left' },
                { label: 'Bộ mẫuID', name: 'ztId', width: 60, align: 'left',  hidden: true },
                { label: 'Tên bộ mẫu', name: 'ztmc', width: 120, align: 'center' }]
        });
    }
    function EnableInspectionInlineEditBox() {
        var ids = $("#alreadyJYAppliedList").getDataIDs();
        $.each(ids, function () {
            var rowid = String(this);
            //Mở chế độ chỉnh sửa
            $("#alreadyJYAppliedList").jqGrid('editRow', rowid, false);
        });

    }

    //Lưu
    function SaveJY(savetodb, justUpdateAlldataArray) {
        //Dưới dạng một đơn thuốc mới
        var gridjyData = $("#alreadyJYAppliedList").jqGrid('getRowData_AllLine', null, true);
        $.each(gridjyData, function () {
            this.lcyx = $('#txt_jy_lcyx').val();
            this.sqbz = $('#txt_jy_sqbz').val();
            this.sl = $('#alreadyJYAppliedList input[name=sl]').val();
            delete this.jqRowId;   //Loại bỏjqRowId
        });

        //Xóa ấn tượng lâm sàng, ghi chú yêu cầu
        $('#txt_jc_lcyx').val('');
        $('#txt_jc_sqbz').val('');

        window.alldataArray.jycf = $.jsonWhere(window.alldataArray.jycf, function (icfmx) {
            if (!!!icfmx.cfId) {
                return false;   //Trong danh sách chỉnh sửa có
            }
            return true;
        });

        $.each(gridjyData, function () {
            this.cfh = thsNewJyCfh;
            window.alldataArray.jycf.push(this);
        });
        if (!(justUpdateAlldataArray == true)) {
            if (savetodb == '1') {
                if (SaveData(false, function () {
                    $.modalAlert("Lưu phiếu yêu cầu thành công", 'success');
                    thsNewJyCfh = GetNewPresNo();
                })) {
                    $("#gridjy").clearGridData();
                    $('#alreadyJYAppliedList').clearGridData();
                }
                $("#alreadyJYAppliedList").jqGrid("setCaption", "已开申请单明细，申请单总金额：0.00");   //Đặt lạicaptionGiá trị thuộc tính
            }
            else {
                //Quay lại trang bệnh án
                $('#myTab [href="#linkbl"]').trigger('click'); //Khởi tạo hiển thị mục nàotab
                //Trang bệnh án tải lại đơn thuốc, dữ liệu đơn thuốc đã thay đổi
                triggleActive();
            }
        }
        else {
            triggleActive();
        }
    }

    /********************************************************/
    //Hiển thị chọn tổ hợp xét nghiệm
    function gridAlreadyJYGroupApplied() {
        $('#alreadyJYAppliedGroupList').newtouchLocalDataGrid({
            height: $(window).height() - 410,
            unwritten: false,
            caption: "Chi tiết phiếu đã lập, tổng số tiền phiếu:0.00",
            editurl: "clientArray",
            colModel: [
                { label: 'Bộ mẫuID', name: 'ztId', width: 60, align: 'left', key: true, hidden: true },
                { label: 'mbId', name: 'mbId', width: 60, align: 'left', hidden: true },
                { label: 'Tên bộ mẫu', name: 'ztmc', width: 300, align: 'left' },
                {
                    label: 'Số tiền', name: 'zhje', width: 100, align: 'center', formatter: "number"
                    , formatoptions: { decimalPlaces: 2, defaultValue: '0.00' } },
                { label: 'zxksdm', name: 'zxksdm', width: 60, align: 'center', hidden: true },
                { label: 'Khoa thực hiện', name: 'zxksmc', width: 150, align: 'center' },
                { label: 'Thao tác', name: 'action', width: 150, align: 'center' },
            ],
            gridComplete: function () {
            }
        });
    }

    function SaveInspectionbyZt(savetodb, justUpdateAlldataArray) {
        //Dưới dạng một đơn thuốc mới
        var gridjyData;
        var rowIds = $("#alreadyJYAppliedGroupList").jqGrid('getDataIDs');
       
        //Xóa ấn tượng lâm sàng, ghi chú yêu cầu
        $('#txt_jc_lcyx').val('');
        $('#txt_jc_sqbz').val('');

        window.alldataArray.jycf = $.jsonWhere(window.alldataArray.jycf, function (icfmx) {
            if (!!!icfmx.cfId) {
                return false;   //Trong danh sách chỉnh sửa có
            }
            return true;
        });
        if (rowIds.length > 0) {
            var mbId = $("#alreadyJYAppliedGroupList").getRowData(rowIds[0]).mbId;
            $.najax({
                url: "/TemplateManage/InspectionTemplate/GetGPackageDetailByZtIdArray",
                data: { ztId: rowIds, mbId: mbId },
                dataType: "json",
                type: "POST",
                async: false,
                success: function (data) {
                    gridjyData = data;
                    $.each(gridjyData, function () {
                        this.lcyx = $('#txt_jy_lcyx').val();
                        this.sqbz = $('#txt_jy_sqbz').val();
                        this.ztmbId = mbId;
                        this.cfh = thsNewJyCfh;
                        window.alldataArray.jycf.push(this);
                    });

                }
            });
        }
        if (!(justUpdateAlldataArray == true)) {
            if (savetodb == '1') {
                if (SaveData(false, function () {
                    $.modalAlert("Lưu phiếu yêu cầu thành công", 'success');
                    thsNewJyCfh = GetNewPresNo();
                })) {
                    $("#gridjy").clearGridData();
                    $('#alreadyJYAppliedGroupList').clearGridData();
                }
                $("#alreadyJYAppliedGroupList").jqGrid("setCaption", "已开申请单明细，申请单总金额：0.00");   //Đặt lạicaptionGiá trị thuộc tính
            }
            else {
                //Quay lại trang bệnh án
                $('#myTab [href="#linkbl"]').trigger('click'); //Khởi tạo hiển thị mục nàotab
                //Trang bệnh án tải lại đơn thuốc, dữ liệu đơn thuốc đã thay đổi
                triggleActive();
            }
        }
        else {
            triggleActive();
        }
    }
</script>


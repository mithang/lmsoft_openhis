    //Lưu
    function SaveTCMPres(savetodb, justUpdateAlldataArray) {
        debugger
        //Lấytất cả các dòngId，duyệt đểSửakhung ở trạng tháiLưuTrạng thái
        var rowIds = $("#gridzycfnew").jqGrid('getDataIDs');
        for (var i = 0; i < rowIds.length; i++) {
            var saveResult = $("#gridzycfnew").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);
            //Tồn khoXét nghiệm
            if(isMedicineSearchRelatedKC === 'True'){
                var rowData = $("#gridzycfnew").getRowData(rowIds[i]);
                var thissl = rowData.sl;
                if(thissl){
                    if(!ypkccheck(rowData.zxks,rowData.ypCode,parseInt(thissl))){
                        $.modalAlert(rowData.ypmc + "ThuốcTồn khoKhông đủ", "error");
                        saveResult = false;
                    }
                }
            }
            if (!saveResult) {
                EnableTCMnewInlineEditBox();    //khởi động lạiKích hoạtSửa Khôngthì lần sau lầnSavekhisẽQuay lạifalse
                return;   //Lưu thất bại，thìreturn
            }
        }
        var tieshu = $('#tieshu').val();
        var cfyf = $('#cfyf').val();
        var djbz = $('#djbz').is(':checked');
        if ($('#daijiantieshu').val() == 0 || $('#daijiantieshu').val() == "") {
            djbz = false;
        }
        var djfs = $('#djfs').val();//sắc hộphươngkiểu
        var djts = $('#daijiantieshu').val();//sắc hộtrảsố
        var cfzt = $('#cfzt').val();//Dặn dò
        if (tieshu == null || tieshu=="") {
            $.modalAlert("Vui lòng điềnSố lần trả", "error");
            return;
        }
        if (djts > "0" && djfs=="") {
            $.modalAlert("Vui lòng chọnSắc thuốc hộPhương thức!", "error");
            return;
        }
        var gridzycfnewData = $("#gridzycfnew").jqGrid('getRowData_AllLine', null, true);
        var zycfnewData = new Array();
        $.each(gridzycfnewData, function () {    //Bỏaction
            delete this.action;   //Bỏaction
            delete this.jqRowId;   //BỏjqRowId

            if (savetodb == '1') {
                if (this.ypmc == undefined || this.ypmc == "") {
                    $.modalAlert("ThiếuTên", "warning");
                    saveResult = false;
                    return false;
                } else if (this.ypgg == undefined || this.ypgg == "") {
                    $.modalAlert("ThiếuQuy cách", "warning");
                    saveResult = false;
                    return false;
                } else if (isNaN(this.dj) || this.dj == "") {
                    $.modalAlert("ThiếuĐơn giá", "warning");
                    saveResult = false;
                    return false;
                } else if (isNaN(this.mcjl) || this.mcjl == "") {
                    $.modalAlert("Thiếu liều lượng", "warning");
                    saveResult = false;
                    return false;
                } else if (this.mcjldw === undefined || this.mcjldw == "") {
                    $.modalAlert("Thiếu đơn vị", "warning");
                    saveResult = false;
                    return false;
                } else if (isNaN(this.sl) || this.sl == "") {
                    $.modalAlert("ThiếuSố lượng", "warning");
                    saveResult = false;
                    return false;
                } else if (this.dw === undefined || this.dw == "") {
                    $.modalAlert("Thiếu đơn vị", "warning");
                    saveResult = false;
                    return false;
                } else if (isNaN(this.je) || this.je == "") {
                    $.modalAlert("ThiếuSố tiền", "warning");
                    saveResult = false;
                    return false;
                }
                if (this.ypmc2 != undefined && this.ypmc2 != "") {
                    if (this.ypmc2 == undefined || this.ypmc2 == "") {
                        $.modalAlert("ThiếuTên", "warning");
                        saveResult = false;
                        return false;
                    }
                    else if (this.ypgg2 == undefined || this.ypgg2 == "") {
                        $.modalAlert("ThiếuQuy cách", "warning");
                        saveResult = false;
                        return false;
                    } else if (isNaN(this.dj2) || this.dj2 == "") {
                        $.modalAlert("ThiếuĐơn giá", "warning");
                        saveResult = false;
                        return false;
                    } else if (isNaN(this.mcjl2) || this.mcjl2 == "") {
                        $.modalAlert("Thiếu liều lượng", "warning");
                        saveResult = false;
                        return false;
                    } else if (this.mcjldw2 === undefined || this.mcjldw2 == "") {
                        $.modalAlert("Thiếu đơn vị", "warning");
                        saveResult = false;
                        return false;
                    } else if (isNaN(this.sl2) || this.sl2 == "") {
                        $.modalAlert("ThiếuSố lượng", "warning");
                        saveResult = false;
                        return false;
                    } else if (this.dw2 === undefined || this.dw2 == "") {
                        $.modalAlert("Thiếu đơn vị", "warning");
                        saveResult = false;
                        return false;
                    } else if (isNaN(this.je2) || this.je2 == "") {
                        $.modalAlert("ThiếuSố tiền", "warning");
                        saveResult = false;
                        return false;
                    }
                }
            }
            this.tieshu = tieshu;
            this.cfyf = cfyf;
            this.djbz = djbz;
            this.sfbz = false;
            this.djfs = djfs;
            this.djts = djts;
            this.cfzt = cfzt;
            var thismxCfId = this.cfId;
            var matchedHisCf = $.jsonWhere(window.alldataArray.zycf, function(icfmx){
                return !!icfmx.cfId && icfmx.cfId == thismxCfId;
            });
            if(matchedHisCf && matchedHisCf.length){
                this.cfzhdysj = matchedHisCf[0].cfzhdysj;
                this.sendtohisResult = matchedHisCf[0].sendtohisResult;
                this.klrq = matchedHisCf[0].klrq;
            }
            this.cftag = $("#tip_jmcf").val();
            this.isdzcf = $("#isdzcfzy").val();
        });
        if (!saveResult) {
            EnableTCMnewInlineEditBox();    //khởi động lạiKích hoạtSửa Khôngthì lần sau lầnSavekhisẽQuay lạifalse
            return;   //Lưu thất bại，thìreturn
        }
        //Lưu dữ liệu
        window.alldataArray.zycf = $.jsonWhere(window.alldataArray.zycf, function(icfmx){
            if(!!!icfmx.cfId){
                return false;   //Sửatrong danh sách có
            }
            for(var iIndex = 0; iIndex < gridzycfnewData.length; iIndex++){
                if(gridzycfnewData[iIndex].cfh == icfmx.cfh){
                    return false;
                }
            }
            return true;
        });
        $.each(gridzycfnewData, function(){
            window.alldataArray.zycf.push(this);
            if(this.ypCode2){
                var cfmx = {
                    Remark: this.Remark2,
                    cfId: this.cfId2,
                    cfh: this.cfh2,
                    cfmxId: this.cfmxId2,
                    cftag: this.cftag,
                    cfyf: this.cfyf,
                    cfzhdysj: this.cfzhdysj,
                    cfzt: this.cfzt,
                    dj: this.dj2,
                    djbz: this.djbz,
                    djfs: this.djfs,
                    djts: this.djts,
                    dw: this.dw2,
                    isdzcf: this.isdzcf,
                    iszzf: this.iszzf2,
                    je: this.je2,
                    klrq: this.klrq,
                    mcjl: this.mcjl2,
                    mcjldw: this.mcjldw2,
                    sendtohisResult: this.sendtohisResult,
                    sfbz: this.sfbz,
                    sl: this.sl2,
                    ts: this.ts2,
                    tieshu: this.tieshu,
                    xzsybz: this.xzsybz2,
                    ybwym:this.ybwym2,
                    ypCode:this.ypCode2,
                    ypgg:this.ypgg2,
                    ypmc:this.ypmc2,
                    zxks:this.zxks2,
                    zysm:this.zysm2,
                    zzfbz:this.zzfbz2
                };
                window.alldataArray.zycf.push(cfmx);
            }
        });
        zylocaldata = new Array();
        if(!(justUpdateAlldataArray == true)){
            if(savetodb == '1'){
                if (SaveData(false, function(){
                    window.initHistoryPresTree('@Html.Raw(((int)EnumCflx.TCMPres).ToString())');
                    $.modalAlert("Lưu thành công", 'success');
                    var griddata = $("#gridzycfnew").jqGrid('getRowData_AllLine', null, true);
                    $.each($("#gridzycfnew").jqGrid('getRowData_AllLine', null, true),
                        function () { //1.Xóadòng
                            var selRowId = $(this.ypmc).attr('rowid');
                            deleteTCMRowData(selRowId, false);
                        });
                })) {
                    $("#gridzycfnew").clearGridData();
                } else {
                    EnableTCMnewInlineEditBox();
                }
            }
            else{
                //nhảy vềHồ sơtrang
                $('#myTab [href="#linkbl"]').trigger('click'); //Khởi tạoHiển thịnàotab
                //bệnhVDtranglạitảiĐơn thuốc，Dữ liệu đơn thuốc đã thay đổi
                triggleActive();
            }
        }
        else {
            triggleActive();
        }
    }

    function getTCMActionStr() {
        return "<i class='fa fa-plus-square-o' style='font-size: large; color: #09a3ea;' onclick='addTCMRowData($(this).parent().parent().attr(\"id\"));return false;'></i>&nbsp;&nbsp;&nbsp;<i class='fa fa-minus-square-o' style='font-size: large; color: #09a3ea;' onclick='deleteTCMRowData($(this).parent().parent().attr(\"id\"));return false;'></i>";
    }

    //Lưu thành mẫu
    function saveAsTCMTemplate(){
        $.modalOpen({
            id: "Form",
            title: "Lưu thành mẫu",
            url: "/MedicalRecord/Form",
            width: "400px",
            height: "250px",
            callBack: function (iframeId) {
                var mbObj = top.frames[iframeId].submitForm();
                if (!(mbObj && mbObj.mbmc && mbObj.mblx)) {
                    return;
                }
                $.modalClose("Form");
                //bảng mẫu
                var mbObj = {
                    mblx: mbObj.mblx,
                    cflx: @Html.Raw(((int)EnumCflx.TCMPres).ToString()),
                    mbmc: mbObj.mbmc,
                }
                //Lấytất cả các dòngId，duyệt đểSửakhung ở trạng tháiLưuTrạng thái
                var rowIds = $("#gridzycfnew").jqGrid('getDataIDs');
                for (var i = 0; i < rowIds.length; i++) {
                    var saveResult = $("#gridzycfnew").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);

                    if (!saveResult) {
                        EnableTCMnewInlineEditBox();    //khởi động lạiKích hoạtSửa Khôngthì lần sau lầnSavekhisẽQuay lạifalse
                        return;   //Lưu thất bại，thìreturn
                    }
                }
                var gridzycfnewData = $("#gridzycfnew").jqGrid('getRowData_AllLine');
                if(!gridzycfnewData || gridzycfnewData.length==0){
                    $.modalAlert("Chi tiết mẫu không được để trống", 'warning');
                    return;
                }

                mbObj.tieshu = $('#tieshu').val();
                mbObj.cfyf = $('#cfyf').val();
                mbObj.djbz = $('#djbz').is(':checked');

                $.each(gridzycfnewData, function () {    //Bỏaction
                    delete this.action;   //Bỏaction
                    delete this.jqRowId;   //BỏjqRowId
                });

                $.najax({
                    url: "/TemplateManage/PresTemplate/SaveData",
                    dataType: "json",
                    data: { mbObj: mbObj, mxList: gridzycfnewData },
                    type: "POST",
                    success: function (data) {
                        $.modalAlert("Lưu thành công", 'warning');
                        window.$('#current').trigger('click');
                    },
                    complete:function(){
                        EnableWMInlineEditBox();    //khởi động lạiKích hoạtSửa Khôngthì lần sau lầnSavekhisẽQuay lạifalse
                    }
                });

            }
        });
    }

</script>

@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "Thuốc Đông yĐơn thuốc-Phiên bản mới";
    Layout = null;
    //ThuốcTìm kiếm，ThuốcCóKhôngNhà thuốc liên quanTồn kho
    var isMedicineSearchRelatedKC = (ViewBag.ISMedicineSearchRelatedKC as bool?) ?? false;
}
<style type="text/css">
    .newZycfDisableBackgroud {
        background-color: #CCC !important;
    }

    #gridzycfnew input {
        padding: 6px 0;
    }

    #gridzycfnew select[role=select] {
        padding: 6px 0;
    }

    #gridzycfnew input[role=textbox] {
        text-align: center;
    }
</style>
<div id="linkzycfnew" role="tabpanel" class="tab-pane" style="width:96.5%;height:100%; float:right; margin-right: 10px; border:solid 1px #ddd; margin-top: 3px;">
    <div class="contentPanel">
        <div style="background-color: #fff;width:100%;display: flex">
            <table id="gridzycfnew"></table>
            <div id="gridzycfnewPager"></div>
        </div>
    </div>
    <div id="bottom" style="border-top: solid 1px #ddd; height: 80px; margin-bottom:1px;">
        <form id="formTCM" style="float:left; width:50%; position: relative; top: 0%;">

            <table class="form" id="tableTCMPresAmount">
                <tr>
                    <th class="formTitle"><span class="required">*</span>Số lần trả:</th>
                    <td class="formValue">
                        <input type="text" id="tieshu" name="tieshu" value="1" class="form-control required" />
                    </td>
                    <th class="formTitle">Sắc thuốc hộSố lần trả:</th>
                    <td class="formValue">
                        <input type="text" id="daijiantieshu" name="daijiantieshu" class="form-control required" />
                    </td>
                    <th class="formTitle">Sắc thuốc hộPhương thức:</th>
                    <td class="formValue">
                        <select id="djfs" name="djfs" class="form-control"></select>
                    </td>
                    <th class="formTitle">Phí sắc thuốc hộ:</th>
                    <td class="formValue">
                        <input type="text" id="djf" name="djf" value="0" disabled="disabled" class="form-control required" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Cách dùng:</th>
                    <td class="formValue">
                        <select id="cfyf" name="cfyf" class="form-control"></select>
                    </td>
                    <th class="formTitle">Dặn dò:</th>
                    <td class="formValue">
                        <input type="text" id="cfzt" name="cfzt" class="form-control required" />
                    </td>
                    <td colspan="2">
                        <div class="ckbox" style="margin-left:38px;">
                            <input id="djbz" name="djbz" type="checkbox"><label for="djbz">Có hay khôngSắc thuốc hộ</label>
                        </div>
                    </td>
                </tr>
            </table>
        </form>
        <div class="lowerrightcorner" style="margin-left: 50%; width: 50%; border-left: solid 1px #ddd; height: 100%;">
            <table class="form" style="position: relative; top: 20%;">
                <tr>
                    <th class="formTitle">Tổng số tiền:</th>
                    <td class="formValue" id="tdTCMTotalAmount"></td>
                    <td style="width: 90px;"></td>
                    <td></td>
                </tr>
                <tr>
                    <td></td>
                    <td class="formValue">
                        <input type="button" class="btn btn-primary" value="Quay lạiBệnh án" style="margin-left:48%;display:table-cell;" onclick="SaveTCMPres()" />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-primary" value="Lưu thành mẫu" style="display:table-cell;" onclick="saveAsTCMTemplate()" />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-primary" value="F3:LưuĐơn thuốc" style="display:table-cell;" onclick="SaveTCMPres('1')" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>

<script>
    var isMedicineSearchRelatedKC = '@(isMedicineSearchRelatedKC)';
    var zycfflag = 0;
    var zylocaldata = new Array();
    function init_TCMPrescriptionNew() {
        $.najax({
            url: "/SystemManage/SysBaseData/GetDjFee",
            dataType: "text",
            async: false,
            success: function (data) {
                $('#djbz').attr('data-djfdj', data);
            }
        });

        //chỉ chưaLưuđếnCơ sở dữ liệucủaĐơn thuốccần khởi tạo tronggridtrong
        if (window.alldataArray.zycf) {
            zylocaldata = $.jsonWhere($.deepClone.clone(window.alldataArray.zycf), function(icf){
                return !!!icf.cfId;
            });
            $.each(zylocaldata, function () {
                if(!this.cfh){
                    alert('Đơn thuốcBất thường');
                    location.href = location.href;
                }
                this.action = getTCMActionStr();
            });
        }
        else{
            window.alldataArray.zycf = new Array(); //Để tiện dùng về sau$.each()
        }

        if (zycfflag === 0) {   //Trang này khởi tạo
            gridzycfnew();
            zycfflag = 1;
            //tảiCách dùng thuốc
            $("#cfyf").bindSelect({
                url: "/SystemManage/SysBaseData/GetZYMedicineUsageList",
                id: "yfCode",
                text: "yfmc"
            });
            var jianfuCode = null;
            $.each($("#cfyf option"), function(){
                if($(this).text() == '煎服'){
                    jianfuCode = $(this).attr('value');
                }
            });
            if(!!jianfuCode){
                $("#cfyf").val(jianfuCode).trigger('change');
            }
            $("#djfs").append("<option value=''>Không</option>");
            $("#djfs").bindSelect({
                url: "/SystemManage/SysBaseData/GetTCMDjfsUsageList",
                id: "Name",
                text: "Name"
            });
            var djfsCode = null;
            $.each($("#djfs option"), function () {
                if ($(this).text() == 'Không') {
                    djfsCode = $(this).attr('value');
                }
            });
            if (!!djfsCode) {
                $("#djfs").val(djfsCode).trigger('change');
            }
            $('#tieshu').val('1');
            $('#daijiantieshu').val('0');
        }
        else {
            $("#gridzycfnew").clearGridData(); //xóa trắng trước
            //Mở lại trang này
            $("#gridzycfnew").jqGrid('setGridParam', {
                datatype: 'local',
                data: zylocaldata
            }).trigger("reloadGrid");
            if(zylocaldata && zylocaldata[0] && zylocaldata[0].cfyf){
                $("#cfyf").val(zylocaldata[0].cfyf).trigger('change');
                $("#tieshu").val(zylocaldata[0].tieshu);
                if(!!zylocaldata[0].djbz){
                    $("#djbz").prop('checked', true);
                }
            }
            //
            $('.glyphicon-new-window:visible').parent('div.ui-pg-div').removeClass('newZycfDisableBackgroud');
            $('#tieshu').val("1");
        }

        //kích hoạt ngaySửacủa nótrongmột bản lầnKhám bệnhcủaĐã gửiĐơn thuốc（chưaGửiđếnkhotrongcủachắc chắn sẽởSửadanh sáchtrong）
        var triggereditcfh = sessionStorage.getItem("triggereditcfh");
        if(!!triggereditcfh){
            sessionStorage.removeItem("triggereditcfh");
            $("#floatLeftMostPartDiv div[data-href='lscf']").trigger('click');
            //chưaGửiđếnCơ sở dữ liệucủaĐơn thuốc，đâylength 0 cũng không sao
            $('span.bbit-tree-node-text[data-value="' + triggereditcfh + '"]').trigger('click');
        }
        var isdzcf = '0';
        $.jsonWhere(window.alldataArray.zycf, function (v) {
            if (v.cfh == triggereditcfh && v.isdzcf != '') {
                isdzcf = v.isdzcf;
            }
        });
        $("#isdzcfzy").val(isdzcf);
    }


    //Thêm mớichi tiết
    function addTCMRowData(selRowId) {
        var selRowData = $("#gridzycf").getRowData(selRowId);
        //2 mớithêmmộtdòng
        var dataRow = {
            cfId: selRowData.cfId,
            cfh: selRowData.cfh,
            ybwym:GetGuid(19,62),
            action: getTCMActionStr()
        };
        $("#gridzycf").jqGrid("addRowData", undefined, dataRow, "after", selRowId);

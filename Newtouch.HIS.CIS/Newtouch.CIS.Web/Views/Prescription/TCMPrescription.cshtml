@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "Đơn thuốc Đông y";
    Layout = null;
    //Tìm kiếm thuốc, thuốc có liên kết tồn kho nhà thuốc không
    var isMedicineSearchRelatedKC = (ViewBag.ISMedicineSearchRelatedKC as bool?) ?? false;
}
<style type="text/css">
    .newZycfDisableBackgroud {
        background-color: #CCC !important;
    }

    #gridzycf input {
        padding: 6px 0;
    }

    #gridzycf select[role=select] {
        padding: 6px 0;
    }

    #gridzycf input[role=textbox] {
        text-align: center;
    }
</style>
<div id="linkzycf" role="tabpanel" class="tab-pane" style="width:96.5%; float:right; margin-right: 10px; border:solid 1px #ddd; margin-top: 3px;">
    <div class="contentPanel">
        <div style="background-color: #fff;">
            <table id="gridzycf"></table>
            <div id="gridzycfPager"></div>
        </div>
    </div>
    <div id="bottom" style="border-top: solid 1px #ddd; height: 80px; margin-bottom:1px;">
        <form id="formTCM" style="float:left; width:50%; position: relative; top: 25%;">
            <table class="form" id="tableTCMPresAmount">
                <tr>
                    <th class="formTitle"><span class="required">*</span>Số thang:</th>
                    <td class="formValue">
                        <input type="text" id="tieshu" name="tieshu" class="form-control required" />
                    </td>
                    <th class="formTitle">Cách dùng đơn thuốc:</th>
                    <td class="formValue">
                        <select id="cfyf" name="cfyf" class="form-control"></select>
                    </td>
                    <td colspan="2">
                        <div class="ckbox" style="margin-left:38px;">
                            <input id="djbz" name="djbz" type="checkbox"><label for="djbz">Có sắc thay không</label>
                        </div>
                    </td>
                </tr>
            </table>
        </form>
        <div class="lowerrightcorner" style="margin-left: 50%; width: 50%; border-left: solid 1px #ddd; height: 100%;">
            <table class="form" style="position: relative; top: 25%;">
                <tr>
                    <th class="formTitle">Tổng số tiền:</th>
                    <td class="formValue" id="tdTCMTotalAmount"></td>
                    <td style="width: 90px;"></td>
                    <td></td>
                </tr>
                <tr>
                    <td></td>
                    <td class="formValue">
                        <input type="button" class="btn btn-primary" value="Quay lại bệnh án" style="margin-left:48%;display:table-cell;" onclick="SaveTCMPres()" />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-primary" value="Lưu thành mẫu khác" style="display:table-cell;" onclick="saveAsTCMTemplate()" />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-primary" value="F3: Lưu đơn thuốc" style="display:table-cell;" onclick="SaveTCMPres('1')" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>

<script>
    var isMedicineSearchRelatedKC = '@(isMedicineSearchRelatedKC)';
    var zycfflag = 0;
    var zylocaldata = new Array();

    function init_TCMPrescription() {
        $.najax({
            url: "/SystemManage/SysBaseData/GetDjFee",
            dataType: "text",
            async: false,
            success: function (data) {
                $('#djbz').attr('data-djfdj',data);
            }
        });

        //Chỉ đơn thuốc chưa lưu vào cơ sở dữ liệu mới cần khởi tạo tronggridtrong
        if (window.alldataArray.zycf) {
            zylocaldata = $.jsonWhere($.deepClone.clone(window.alldataArray.zycf), function(icf){
                return !!!icf.cfId;
            });
            $.each(zylocaldata, function () {
                if(!this.cfh){
                    alert('Đơn thuốc bất thường');
                    location.href = location.href;
                }
                this.action = getTCMActionStr();
            });
        }
        else{
            window.alldataArray.zycf = new Array(); //Để tiện sử dụng sau này$.each()
        }

        if (zycfflag === 0) {   //Khởi tạo trang này
            gridzycf();
            zycfflag = 1;
            //Tải cách dùng thuốc
            $("#cfyf").bindSelect({
                url: "/SystemManage/SysBaseData/GetZYMedicineUsageList",
                id: "yfCode",
                text: "yfmc"
            });
            var jianfuCode = null;
            $.each($("#cfyf option"), function(){
                if($(this).text() == '煎服'){
                    jianfuCode = $(this).attr('value');
                }
            });
            if(!!jianfuCode){
                $("#cfyf").val(jianfuCode).trigger('change');
            }
            $('#tieshu').val('1');
        }
        else {
            $("#gridzycf").clearGridData(); //Xóa trước
            //Mở lại trang này
            $("#gridzycf").jqGrid('setGridParam', {
                datatype: 'local',
                data: zylocaldata
            }).trigger("reloadGrid");
            if(zylocaldata && zylocaldata[0] && zylocaldata[0].cfyf){
                $("#cfyf").val(zylocaldata[0].cfyf).trigger('change');
                $("#tieshu").val(zylocaldata[0].tieshu);
                if(!!zylocaldata[0].djbz){
                    $("#djbz").prop('checked', true);
                }
            }

            //
            $('.glyphicon-new-window:visible').parent('div.ui-pg-div').removeClass('newZycfDisableBackgroud');
        }

        //Ngay lập tức kích hoạt chỉnh sửa một trong các đơn thuốc đã gửi của lần khám này (đơn thuốc chưa gửi vào cơ sở dữ liệu chắc chắn sẽ nằm trong danh sách chỉnh sửa)
        var triggereditcfh = sessionStorage.getItem("triggereditcfh");
        if(!!triggereditcfh){
            sessionStorage.removeItem("triggereditcfh");
            $("#floatLeftMostPartDiv div[data-href='lscf']").trigger('click');
            //Đơn thuốc chưa gửi vào cơ sở dữ liệu, ở đâylength 0 Cũng không có vấn đề
            $('span.bbit-tree-node-text[data-value="' + triggereditcfh + '"]').trigger('click');
        }
        var isdzcf = '0';
        $.jsonWhere(window.alldataArray.zycf, function (v) {
            if (v.cfh == triggereditcfh && v.isdzcf != '') {
                isdzcf = v.isdzcf;
            }
        });
        $("#isdzcfzy").val(isdzcf);
    }

    //Danh sách đơn thuốc
    function gridzycf() {
        var $gridzycf = $("#gridzycf");
        $gridzycf.jqGrid({
            datatype: 'local',
            data: zylocaldata,
            height: $(window).height() - 230,
            //altRows: true,//Đổi màu xen kẽ các dòng
            shrinkToFit: true,   //true:Khởi tạo chiều rộng cột theo tỷ lệ false:Sử dụngcolModelchiều rộng đã chỉ định
            autowidth: true,
            rownumbers: true,  //Có hiển thị số thứ tự không
            multiselect: true,
            multiboxonly: false,  //Hộp kiểm true:Không được chọn nhiều
            editurl: "clientArray",  //Chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            unwritten: false,
            colModel: [
                { label: 'cfId', name: 'cfId', hidden: true },
                { label: 'ybwym', name: 'ybwym', hidden: true },
                { label: 'xzsybz', name: 'xzsybz', hidden: true },
                { label: 'cfmxId', name: 'cfmxId', hidden: true },
                { label: 'zxks', name: 'zxks', editable: true, hidden: true },
                { label: 'cfh', name: 'cfh', width: 120, align: 'center', hidden: true },
                { label: 'ypCode', name: 'ypCode', width: 100, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: '<span class="required">*</span>Tên', name: 'ypmc', width: 285, editwidth: '100%', align: 'center', editable: true },
                { label: '<span class="required">*</span>Quy cách', name: 'ypgg', width: 80, editwidth: '100%', align: 'center', editable: true },
                {label: '<span class="required">*</span>Đơn giá', name: 'dj', width: 60, editwidth: '100%', align: 'center', editable: true},
                {
                    label: '<span class="required">*</span>Liều lượng', name: 'mcjl', width: 55, editwidth: '100%', align: 'center', editable: true, editoptions: {
                        dataEvents: [
                                {
                                    type: 'change',
                                    fn: function (e) {
                                        var cellval = $(this).val();
                                        if(cellval.replace(/(^\s*)|(\s*$)/g, "") == ""){
                                            $.modalAlert("Liều lượng trống, vui lòng xác nhận.", 'warning');
                                            return;
                                        }
                                        if(isNaN(cellval)){
                                            $.modalAlert("Liều lượng: vui lòng nhập số", 'warning');
                                            $(this).val('')
                                            return;
                                        }
                                        var row = $(e.target).closest('tr.jqgrow');
                                        var rowid = row.attr('id');

                                        CalculateTCMEachLineSlANDJe(rowid);
                                    }
                                }
                        ]
                    }
                },
                {
                    label: '<span class="required">*</span>Đơn vị', name: 'mcjldw', width: 65, editwidth: '100%', align: 'center', editable: true
                },
                { label: 'Số ngày', name: 'ts', width: 60, editwidth: '100%', align: 'center', editable: true, editoptions: {
                    dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var cellval = $(this).val();
                                    if(isNaN(cellval)){
                                        $.modalAlert("Liều lượng: vui lòng nhập số", 'warning');
                                        $(this).val('')
                                        return;
                                    }
                                }
                            }
                    ]
                }},
                {
                    label: '<span class="required">*</span>Số lượng', name: 'sl', width: 48, editwidth: '100%', align: 'center', editable: true, editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var cellval = $(this).val();
                                    if (cellval.replace(/(^\s*)|(\s*$)/g, "") == "") {
                                        $.modalAlert("Số lượng trống, vui lòng xác nhận.", 'warning');
                                        return;
                                    }
                                    if (isNaN(cellval)) {
                                        $.modalAlert("Số lượng: vui lòng nhập số", 'warning');
                                        $(this).val('');
                                        return;
                                    }
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    CalculateTCMEachLineJe(rowid);   //Tính số tiền chi tiết và số tiền đơn thuốc
                                }
                            }
                        ]
                    }
                },
                { label: '<span class="required">*</span>Đơn vị', name: 'dw', width: 50, editwidth: '100%', align: 'center', editable: true, hidden:true },
                { label: '<span class="required">*</span>Số tiền', name: 'je', width: 60, editwidth: '100%', align: 'center', editable: true },
                { label: 'Dặn dò', name: 'Remark', width: 153, editwidth: '100%', align: 'center',  editoptions: {
                    dataEvents: [
                                {
                                    type: 'keydown',
                                    fn: function (e) {
                                        if(e.keyCode == 13){
                                            var row = $(e.target).closest('tr.jqgrow');
                                            var rowid = row.attr('id');
                                            var saveResult =$gridzycf.saveRow(rowid, null, null, null, function (callbackRowId) { }, null, null);
                                            if (!saveResult) {
                                                return;
                                            }
                                            addTCMRowData(rowid);   //Thêm một chi tiết
                                        }
                                    }
                                }
                    ]
                }, editable: true },
                {
                    label: 'Chuyển sang tự trả', name: 'iszzf', width: 80, editwidth: '100%', align: 'center', edittype: "select", editable: true, editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    $("#" + rowid + "_zzfbz").val($(this).val());
                                }
                            }
                        ]

                    }
                },
                { label: 'zzfbz', name: 'zzfbz', editwidth: '', align: 'center', editable: true, hidden: true },
                { label: 'Mã bảo hiểm y tế quốc gia', name: 'gjybdm', editable: true, hidden: true},
                { label: 'Thao tác', name: 'action', width: 110, align: 'center' }
            ],
            editinputwidthborder: false,    //Có cần viền không mặc định làtrue
            editinputborderradius: false,   //Có cần bo góc viền không Mặc địnhtrue(có bo góc)
            pager: "#gridzycfPager",
            loadComplete: function () {
            },
            gridComplete: function () {
                EnableTCMInlineEditBox();
                //
                if ($("#gridzycf").jqGrid('getRowData_AllLine').length > 0) {
                    //Không thể thêm đơn thuốc mới nữa
                    $('.glyphicon-new-window:visible').parent('div.ui-pg-div').addClass('newZycfDisableBackgroud');
                }
            }
        });
        //Menu cấp hai
        $gridzycf.jqGrid('setGroupHeaders', {
            useColSpanStyle: true,
            groupHeaders: [
            {
                startColumnName: 'ypCode',
                numberOfColumns: 4,
                titleText: 'Thông tin cơ bản'
            }, {
                startColumnName: 'mcjl',
                numberOfColumns: 2,
                titleText: 'Liều lượng mỗi lần'
            }]
        });
        //Nút tùy chỉnh
        $gridzycf.navGrid('#gridzycfPager',
                {
                    edit: false,
                    add: false,
                    del: false,
                    search: false,
                    refresh: false,
                    view: false,
                    position: "left",
                    cloneToTop: false
                })
            .navButtonAdd('#gridzycfPager',
                {
                    buttonicon: "glyphicon glyphicon-remove",
                    title: "Xóa chi tiết",
                    caption: "Xóa chi tiết",
                    position: "last",
                    onClickButton: function() {
                        $.each($("#gridzycf").jqGrid('getRowData_AllLine', true, true),
                            function() { //1.Xóa dòng
                                var selRowId = $(this.ypmc).attr('rowid');
                                deleteTCMRowData(selRowId, false);
                            });
                        CalculateTCMPresAmount(); //2.Tính số tiền của đơn thuốc
                    }
                }).navSeparatorAdd("#gridzycfPager", { sepclass: "ui-separator", sepcontent: '' })
            .navButtonAdd('#gridzycfPager',
                {
                    buttonicon: "glyphicon glyphicon-new-window",
                    title: "Đơn thuốc mới",
                    caption: "Đơn thuốc mới",
                    position: "last",
                    onClickButton: function() {
                        if ($("#gridzycf").jqGrid('getRowData_AllLine').length > 0) {
                            $.modalAlert("Không thể chỉnh sửa đồng thời nhiều đơn thuốc Đông y", 'warning');
                            return;
                        }
                        newTCMPresData();
                    }
                });
        $("#tip_zyyfly").empty();
        $("#gridzycfPager_right").append('<span style="color:red;">Nhà thuốc:</span><select id="tip_zyyfly"></select>');
        $("#gridzycfPager_right").append('<span>Đơn thuốc điện tử:</span><select id="isdzcfzy"><option value="0">Không</option><option value="1">Có</option></select>&nbsp;&nbsp;&nbsp;<span style="color:red;">Đơn thuốc đặc biệt:</span><select id="tip_jmcf"><option value="">==Vui lòng chọn==</option><option value="LXGB">Cán bộ nghỉ hưu</option><option value="TBCF">Đơn thuốc bệnh đặc biệt</option></select>');

        $.ajax({
            type: "POST",
            dataType: "json", //Quay lạijsondữ liệu có định dạng
            url: "/Prescription/GetYfData",
            data: { },
            async: false,
            success: function (ret) {
                var res=false;
                var currYfdm = sessionStorage.getItem('currentzyf');
                $.each(ret, function () {
                    if((this.mzzybz=="1" && res==false && !currYfdm) ||(currYfdm==this.yfbmCode && res==false)){
                        var option = "<option value='" + this.yfbmCode +"|"+ this.mzzybz + "' selected>" + this.yfbmmc + "</option>";
                        res=true;
                    }
                    else
                        var option = "<option value='" + this.yfbmCode +"|"+ this.mzzybz + "'>" + this.yfbmmc + "</option>";
                    $("#tip_zyyfly").append(option);
                });
            }
        });
        $("#tip_zyyfly").change(function(){
            sessionStorage.setItem("currentzyf", $("#tip_zyyfly").val().split('|')[0]);
        });
    }
    function EnableTCMInlineEditBox(){
        var ids = $("#gridzycf").getDataIDs();
        $.each(ids, function () {
            //Mở chế độ chỉnh sửa
            $("#gridzycf").jqGrid('editRow', this, false, initTCMInlineFunc);

            //CalculateTCMEachLineSlANDJe(this, false);
        });

        CalculateTCMPresAmount();
	}

    //Khởi tạo Lớp nổi
	function initTCMInlineFunc(rowid) {



        //Một số cột chỉ đọc
        $("#" + rowid + "_dj").css('background-color','#f6f7fb').attr('readonly','true');
        $("#" + rowid + "_ypgg").css('background-color','#f6f7fb').attr('readonly','true');
        $("#" + rowid + "_mcjldw").css('background-color','#f6f7fb').attr('readonly','true');
        $("#" + rowid + "_je").css('background-color','#f6f7fb').attr('readonly','true');
        $("#" + rowid + "_Remark").parent().next().children('select').html('');
        $("#" + rowid + "_Remark").parent().next().children('select').append('<option value="1">Có</option><option value="0">Không</option>');

        var iszzfval = $("#" + rowid + "_zzfbz").val();
        if (!!iszzfval) {
            $("#" + rowid + "_Remark").parent().next().children('select').val(iszzfval).trigger("change");
        } else {
            $("#" + rowid + "_Remark").parent().next().children('select').val(0).trigger("change");
        }


        //Được tính dựa trên số thang và liều lượng

        //$("#" + rowid + "_sl").css('background-color','#f6f7fb').attr('readonly','true');
        $("#" + rowid + "_ypmc").attr('autocomplete', 'off');

        var currlineCfh = $("#gridzycf").getRowData(rowid).cfh;
        //Lớp nổi thuốc  //Thuốc Đông y, thuốc Tây y có bị trùng lặp không ‘"#" + rowid + "_ypmc"’
        $("#" + rowid + "_ypmc").sfxmFloatingSelector({
            djDecimalPlaces: 4,
            searchType: $("#isdzcfzy").val() == "1" ? "yp" : '@(isMedicineSearchRelatedKC ? "yp.kc" : "yp")', //Thuốc có hiển thị tồn kho không
            ajaxparameters: function ($thisinput) {
                 var flag = false;
                //Nếu là thuốc bị hạn chế,flag=true
                if (window.currPatientInfo.brxzCode != "" &&'@ViewBag.ControlbrxzCode'.indexOf(window.currPatientInfo.brxzCode) > -1) {
                    flag = true;
                }
                var mzzybz=$('#tip_zyyfly option:selected').val().split('|')[1];//Bộ phận nhà thuốc 0: Không phát thuốc 1: Thuốc ngoại trú 2: Thuốc nhập viện 3: Dùng chung ngoại trú và nhập viện
                if(mzzybz=="3")
                    mzzybz="1";
                if($("#isdzcfzy").val() == "1")
                    mzzybz="9";//Theo danh mục đơn thuốc điện tử
                return "onlyybflag=" + flag + "&mzzybz="+mzzybz+"&dllb=1&sfdllx=TCM&keyword=" + $.trim($thisinput.val())+"&ypyfbmCode="+$('#tip_zyyfly option:selected').val().split('|')[0];
			},

			itemdbclickhandler: function ($this) {

				$.ajax({
					url: "/SystemManage/SysBaseData/GetPermissions",
					dataType: "json",
					data: { "tsypzl": $this.attr('data-tsypbz'), "dlcode": $this.attr('data-sfdlCode'), "kssqxjb": $this.attr('data-kssqxjb') },
					type: "POST",
					async: true,
					success: function (req) {
						if (req < '1') {
							if (req == '-1') {
								$.modalAlert("Tạm thời chưa lập" + $this.attr('data-tsypbzmc') + "类药品权限", 'warning');
								$("#" + rowid + "_ypmc").val("");
								$("#" + rowid + "_xmmc").val("");
								$("#" + rowid + "_xmdm").val("");
								$("#" + rowid + "_ypgg").val("");
								$("#" + rowid + "_dj").val("");
								$("#" + rowid + "_redundant_jldw").val("");
								$("#" + rowid + "_dw").val("");
								return;
							}
							if (req == '-2') {
								$.modalAlert("Tạm thời chưa lập" + $this.attr('data-kssmc') + "类药品权限", 'warning');
								$("#" + rowid + "_ypmc").val("");
								$("#" + rowid + "_xmmc").val("");
								$("#" + rowid + "_xmdm").val("");
								$("#" + rowid + "_ypgg").val("");
								$("#" + rowid + "_dj").val("");
								$("#" + rowid + "_redundant_jldw").val("");
								$("#" + rowid + "_dw").val("");
								return;
							}
							if (req == '-3') {
								$.modalAlert("Tạm thời chưa lập" + $this.attr('data-sfdlmc') + "类药品权限", 'warning');
								$("#" + rowid + "_ypmc").val("");
								$("#" + rowid + "_xmmc").val("");
								$("#" + rowid + "_xmdm").val("");
								$("#" + rowid + "_ypgg").val("");
								$("#" + rowid + "_dj").val("");
								$("#" + rowid + "_redundant_jldw").val("");
								$("#" + rowid + "_dw").val("");
								return;
							}

						}
					}
				});

                var xzyysm=$this.attr('data-xzyysm');
                var xzyy= $this.attr('data-xzyy');
                if (xzyy) {
                    $.modalOpen({
                        id: "XzyyForm",
                        title: "Giải thích thuốc bị hạn chế",
                        url: "/TemplateManage/PresTemplate/XzyyForm?keyValue=" + xzyysm,
                        width: "400px",
                        height: "200px",
                        callBack: function (iframeId) {
                            var sfkbRadio = top.frames[iframeId].submitForm();
                            if (sfkbRadio!=null&&sfkbRadio!="") {
                                //Thay đổi giá trị của một cột trong một dòng
                                $("#gridxycf").jqGrid('setCell',rowid,"xzsybz",sfkbRadio);
                                $.modalClose("XzyyForm");
                            }

                        }
                    });
                }
                //Kiểm tra trùng lặp
                var isRepeatedAdd = false;
                var addypCode = $this.attr('data-sfxmCode');
                $.each($("#gridzycf").getDataIDs(), function () {
                    var cfh = $("#gridzycf").getRowData(String(this)).cfh;
                    var ypCode = $('#' + $($("#gridzycf").getRowData(String(this)).ypCode).attr('id')).val();
                    if (addypCode == ypCode && String(this) != rowid && cfh == currlineCfh) {
                        isRepeatedAdd = true;
                        return;
                    }
                });
                if (isRepeatedAdd) {
                    $.modalAlert("Chi tiết trong một đơn thuốc không được trùng lặp", 'warning');
                    return;
                }
                //
                $("#" + rowid + "_zxks").val($this.attr('data-yfbmCode'));
                //
                $("#" + rowid + "_ypmc").val($this.attr('data-sfxmmc'));
                $("#" + rowid + "_ypCode").val($this.attr('data-sfxmCode'));
                $("#" + rowid + "_ypgg").val($this.attr('data-gg'));
                $("#" + rowid + "_dj").val($this.attr('data-dj'));
                $("#" + rowid + "_mcjldw").val($this.attr('data-jldw'));
                $("#" + rowid + "_dw").val($this.attr('data-dw'));
                $("#" + rowid + "_mcjl").val($this.attr('data-mrjl'));
                $("#" + rowid + "_gjybdm").val($this.attr('data-gjybdm'));

                $("#" + rowid + "_ypmc").css('background-color','#f6f7fb').attr('readonly','true');
                CalculateTCMEachLineSlANDJe(rowid);   //Tính số tiền trong chi tiết và số tiền đơn thuốc

                if(isMedicineSearchRelatedKC === 'True'){
                    //Số lượng tồn kho
                    var kcsl = parseInt($this.attr('data-kcsl'));
                    var cls = parseInt($this.attr('data-cls'));
                    var mzkcsl = !!kcsl && !!cls ? (parseInt(kcsl / cls)) : 0;
                    ypkcrem($this.attr('data-yfbmCode'), $this.attr('data-sfxmCode'), mzkcsl);
                }
			}



        });
        //Lớp nổi dặn dò
        $("#" + rowid + "_Remark").ztFloatingSelector({
            height:100,
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_Remark").val($this.attr('data-ztmc'));
            },
		});


    }

    //Tính số lượng trong chi tiết
    function CalculateTCMEachLineSlANDJe(rowid, recalc) {
        var currRowZe = 0.00;

        var tieshu = $.undefinedwith0($('#tieshu').val());    //Số thang
        var mcjl = $('#' + rowid + '_mcjl').val();     //Liều lượng

        if(tieshu && mcjl){
            $('#' + rowid + '_sl').val(roundingBy4she6ru5chengshuang((parseFloat(tieshu) * parseFloat($.undefinedwith0(mcjl))),0))

            //Phía dưới tính số tiền trong chi tiết
            var currRowSl = $('#' + rowid + '_sl').val(); //Số lượng
            var currRowDj = $('#' + rowid + '_dj').val();

            //Điều kiện: đơn vị thuốc Đông y và đơn vị liều lượng phải được bảo trì nhất quán
            if (currRowDj && parseFloat(currRowSl) > 0) {
                //Đơn giá Số lượng không trống
                currRowZe = roundingBy4she6ru5chengshuang(parseFloat(currRowDj) * parseFloat(currRowSl),2);
            }

            $('#' + rowid + '_je').val(currRowZe);
        }
        if(!(recalc === false)){
            //Phía dưới tính số tiền của toàn bộ đơn thuốc
            CalculateTCMPresAmount();
        }
    }

    //Tính số tiền trong chi tiết
    function CalculateTCMEachLineJe(rowid) {
        //Phía dưới tính số tiền trong chi tiết
        var currRowSl = $('#' + rowid + '_sl').val(); //Số lượng
        var currRowDj = $('#' + rowid + '_dj').val();

        //Điều kiện: đơn vị thuốc Đông y và đơn vị liều lượng phải được bảo trì nhất quán
        if (currRowDj && parseFloat(currRowSl) > 0) {
            //Đơn giá Số lượng không trống
            currRowZe = roundingBy4she6ru5chengshuang(parseFloat(currRowDj) * parseFloat(currRowSl), 2);
        }

        $('#' + rowid + '_je').val(currRowZe);
        CalculateTCMPresAmount();
    }

    //Tính số tiền đơn thuốc
    function CalculateTCMPresAmount() {
        var allData = $("#gridzycf").jqGrid('getRowData_AllLine');
        if(!!!allData || !!!allData.length || allData.length == 0){
            $('#tdTCMTotalAmount').html('');  //Xóa trước
            $('#tdTCMTotalAmount').append('<label style="color:red;">￥' + 0.00 + '</label>');
            return;
        }
        //allDataXác thực trước Trong danh sách chỉ được có một đơn thuốc
        var justOneCf = true;
        for (var i = 0; i < allData.length; i++) {
            if(allData[i].cfh != allData[0].cfh){
                justOneCf = false;
            }
        }
        if(!justOneCf){
            alert('Đơn thuốc bất thường');
            location.href = location.href;
        }
        var totalAmount = 0.00;
        for (var i = 0; i < allData.length; i++) {
            var cfje = $("#" + allData[i].jqRowId + "_je").val();
            if(!!cfje){
                totalAmount += parseFloat(cfje);
            }
        }
        var tieshu = $.undefinedwith0($('#tieshu').val());
        var djbz = $('#djbz').is(':checked');
        if(djbz && !!$('#djbz').attr('data-djfdj')){
            var djf = parseFloat($('#djbz').attr('data-djfdj')) * parseFloat(tieshu);
            var djzfy = parseFloat(totalAmount) + parseFloat(djf);
            totalAmount = roundingBy4she6ru5chengshuang(djzfy,2)  //Thuật toán cộng phí sắc thay: đơn giá sắc thay*Số thang
        }
        else{
            totalAmount =totalAmount.toFixed(2);
        }

        $('#tdTCMTotalAmount').html('');  //Xóa trước
        $('#tdTCMTotalAmount').append('<label style="color:red;">￥' + totalAmount + '</label>');
    }

    //Có sắc thay không, chi phí liên quan
    $('#djbz').change(function(){
        CalculateTCMPresAmount();
    });

    $('#tieshu').change(function(){
        var val = $(this).val();
        if(val.replace(/(^\s*)|(\s*$)/g, "") == ""){
            $.modalAlert("Số thang trống, vui lòng xác nhận.", 'warning');
            return;
        }
        if(isNaN(val)){
            $.modalAlert("Số thang: vui lòng nhập số", 'warning');
            $(this).val('')
            return;
        }
        $.each($("#gridzycf").getDataIDs(), function () {
            CalculateTCMEachLineSlANDJe(String(this));   //Ở đây có lẽ là tính số lượng và số tiền của mỗi dòng (phương pháp này bao gồm tính số tiền đơn thuốc)
        });
    });

    //Đơn thuốc mới Nút
    function newTCMPresData() {
        var dataRow = {
            cfId: null, //Chưa lưu vào cơ sở dữ liệu
            cfh: GetNewPresNo(),
            ybwym:GetGuid(19,62),
            action: getTCMActionStr()
        };
        $("#gridzycf").jqGrid("addRowData", undefined, dataRow, "last");
        var rowIds = $("#gridzycf").jqGrid('getDataIDs');

    //Tính số tiền đơn thuốc
    function CalculateDzcfAmount() {
        var presClassificationArr = new Array();   //Đơn thuốcPhân loại
        var allData = $("#griddzcf").jqGrid('getRowData_AllLine', null, true);
        $.each(allData, function () {
            var cfh = this.cfh;
            var rowid = this.jqRowId;

            var ypmc = $("#" + rowid + "_ypmc").val();
            var cfje = $("#" + rowid + "_je").val();

            if (!ypmc && !cfje) {
                return;
            }

            var existPres = $.jsonWhere(presClassificationArr, function (v) {
                return v && v.cfh == cfh;    //nhaucùngĐơn thuốc đặtđếnmộtsốnhómtrong  Số đơn thuốclàkey Số tiềnlàvalue
            });
            if (existPres && existPres.length == 1) {       //đãtồn tạiởSố đơn thuốc
                existPres[0].cfje = roundingBy4she6ru5chengshuang((parseFloat(existPres[0].cfje) + parseFloat(cfje)), 2);
            } else {
                presClassificationArr.push({ cfh: cfh, cfje: cfje });    //Đơn thuốc mớisố
            }
        });

        var totalAmount = 0.00;
        //ghépnhậnhtml
		$('#tabledzcfPresAmount').html('');   //Xóa trắng trước
        for (var i = 0; i < presClassificationArr.length; i++) {
            totalAmount = roundingBy4she6ru5chengshuang((parseFloat(totalAmount) + parseFloat(presClassificationArr[i].cfje)), 2);  //Tính toánTổng số tiền
			$('#tabledzcfPresAmount').append('<tr><th class="formTitle">Số đơn thuốc:</th><td class="formValue"><label style="color:red;">' + presClassificationArr[i].cfh + '</label></td><th class="formTitle">Số tiền tham khảo:</th><td class="formValue"><label style="color:red;">￥' + presClassificationArr[i].cfje + '</label></td><th class="formTitle">Đơn thuốcHiệu lựcSố ngày:</th><td class="formValue"><label style="color:red;">' + 3 + ' ngày' +'</label></td></tr>');
        }
		$('#tddzcfTotalAmount').html('');  //Xóa trắng trước
		$('#tddzcfTotalAmount').append('<label style="color:red;">￥' + totalAmount + '</label>');
    }


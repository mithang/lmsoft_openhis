	function uploadep(cfh) {
		var upload = '';
		var errorCode = '';
		var url = '@dzcfUrl';
		$.ajax({
			url: url+"prescription/rest/prescription/uploadep?cfh=" + cfh,
			type: "GET",
			dataType: "json",
			//data: { cfh: cfh },
			async: false,
			success: function (ret) {
				upload = ret.status;
				//console.log(ret);
				if (upload == 'Success') {
					return "1";
				} else {
					errorCode = ret.errorCode;
					return "2";
					//return "Lưu thất bại,thất bạinguyên nhânCó:" + errorCode + "。";
				}
			}
		})

	}


    function CalculateEachLineDzcfJe(rowid, recalc) {
        var currRowZe = 0.00;
        //if ($('#' + rowid + '_dj').val()) {
        //    var editdj = roundingBy4she6ru5chengshuang($('#' + rowid + '_dj').val(), 2);
        //    $('#' + rowid + '_dj').val(editdj);

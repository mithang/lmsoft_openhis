                    $.modalAlert("ThiếuTần suất", "warning");
                    flag = true;
                    return false;
                } else if (isNaN(this.sl) || this.sl == "") {
                    $.modalAlert("ThiếuSố lượng", "warning");
                    flag = true;
                    return false;
                } else if (this.dw === undefined || this.dw == "") {
                    $.modalAlert("Thiếu đơn vị", "warning");
                    flag = true;
                    return false;
                } else if (isNaN(this.je) || this.je == "") {
                    $.modalAlert("ThiếuSố tiền", "warning");
                    flag = true;
                    return false;
                }
                var objzh = this.zh;
                var objyfmc = this.yfmcval;
                var objpcCode = this.pcCode;
                var objpcmc = this.pcmc;
                var objypyfdm = this.yfCode;
                var objId = this.jqRowId;
                if (objzh) {
                    $.each(gridxycfData, function () {
                        var currRowZh = this.zh;
                        var yfmcval = this.yfmcval;
                        var ypyfdm = this.yfCode;
                        var pcmc = this.pcmc;
                        var pccode = this.pcCode;
                        var rowid = this.jqRowId;
                        if (objzh == currRowZh && objId != rowid) {
                            if (yfmcval !== objyfmc || ypyfdm !== objypyfdm) {
                                $.modalAlert("Số ngày của nhóm " + currRowZh + "Cách dùng không nhất quán", "warning");
                                saveResult = false;
                                return false;
                            } else
                                if (pcmc !== objpcmc || pccode !== objpcCode) {
                                    $.modalAlert("Số ngày của nhóm " + currRowZh + "Tần suất không nhất quán", "warning");
                                    saveResult = false;
                                    return false;
                                }
                        }

                    });
                }

            }

            delete this.action;   //Bỏaction
            delete this.jqRowId;   //BỏjqRowId



            this.sfbz = false;  //mộtđịnhCóChưa thu phímớicó thểvàovàoSửaTrạng thái
            var thismxCfId = this.cfId;
            var matchedHisCf = $.jsonWhere(window.alldataArray.xycf, function(icfmx){
                return !!icfmx.cfId && icfmx.cfId == thismxCfId;
            });
            if(matchedHisCf && matchedHisCf.length){
                this.cfzhdysj = matchedHisCf[0].cfzhdysj;
                this.sendtohisResult = matchedHisCf[0].sendtohisResult;
                this.klrq = matchedHisCf[0].klrq;
            }

            this.cftag = $("#tip_jmcf").val();
            this.isdzcf = $("#isdzcfxy").val();
        });
        if ((!(saveResult == false)) && savetodb == '1' && gridxycfData.length > 0) {//Thuốchạnchếmởlập
            var isbmzd = $("#mzbck").is(":checked") ? "1" : "0";
            var cfdata = [];
            $.each(gridxycfData, function () {
                var cfxx = { ypCode: this.ypCode, sl: parseInt(this.sl) };
                cfdata.push(cfxx);
            });
            var xzkldata = {
                mbzd: isbmzd,
                cfdata: cfdata
            }
            $.ajax({
                type: "POST",
                dataType: "json", //Quay lạijsondữ liệu dạng
                url: "/Prescription/Getxzkls",
                data: { xzkldata: xzkldata} ,
                async: false,
                success: function (ret) {
                    if (ret != null && ret != "" && ret.message != null && ret.message != "") {
                        $.modalAlert(ret.message, "error");
                        saveResult = false;
                    }
                }
            });
        }
        //
        if (flag) {
            EnableWMInlineEditBox();    //khởi động lạiKích hoạtSửa Khôngthì lần sau lầnSavekhisẽQuay lạifalse
            return false;   //Lưu thất bại，thìreturn
        }
        //LấyChẩn đoán
        var blObject = new Array();
        var cfh = "";
        $.each($("#gridxycf").getDataIDs(), function () {
            cfh = $("#gridxycf").getRowData(String(this)).cfh;
        });
        var gyssStr = "";
        var gyssArr = $("#selgys").val();
        if (gyssArr != null && gyssArr.length > 0) {
            $.each(gyssArr, function (index, item) {
                blObject.push({
                    zdmc: item.split("|")[1],
                    zdCode: item.split("|")[0],
                    cfh: cfh
                });
            });
            gyssStr = gyssStr.substring(0, gyssStr.length - 1);
        }
        else {
            $.modalAlert("Vui lòng chọn chẩn đoán tương ứng!", "warning");
            return;
        }
        window.alldataArray.cfzdlist = $.jsonWhere(window.alldataArray.cfzdlist, function (icd) {
            if (!!!icd.id) {
                return false;   //Sửatrong danh sách có
            }
            for (var iIndex = 0; iIndex < blObject.length; iIndex++) {
                if (blObject[iIndex].cfh == icd.cfh) {
                    return false;
                }
            }
            return true;
        });
        $.each(blObject, function () {
            window.alldataArray.cfzdlist.push(this);
        });
        //Lưu dữ liệu
        window.alldataArray.xycf = $.jsonWhere(window.alldataArray.xycf, function (icfmx) {
            if(!!!icfmx.cfId){
                return false;   //Sửatrong danh sách có
            }
            for(var iIndex = 0; iIndex < gridxycfData.length; iIndex++){
                if(gridxycfData[iIndex].cfh == icfmx.cfh){
                    return false;
                }
            }
            return true;
        });
        //if (!!$("#tip_jmcf").val()) {
        //    window.alldataArray.xycf.cftag = $("#tip_jmcf").val();
        //}
        $.each(gridxycfData, function () {
            window.alldataArray.xycf.push(this);
        });
        xylocaldata = new Array();

        if(!(justUpdateAlldataArray == true)){
            if(savetodb == '1'){
                if (SaveData(false, function(){
                    window.initHistoryPresTree('@Html.Raw(((int)EnumCflx.WMPres).ToString())');
                    $.modalAlert("Lưu thành công", 'success');
                })) {
                    $("#gridxycf").clearGridData();
                } else {
                    EnableWMInlineEditBox();
                }
            }
            else{
                //nhảy vềHồ sơtrang
                $('#myTab [href="#linkbl"]').trigger('click'); //Khởi tạoHiển thịnàotab
                //bệnhVDtranglạitảiĐơn thuốc，Dữ liệu đơn thuốc đã thay đổi
                triggleActive();
            }
        }
        else {
            triggleActive();
        }
    }

	function getWMActionStr() {
        return "<i class='fa fa-plus-square-o' style='font-size: large; color: #09a3ea;' onclick='addWMRowData($(this).parent().parent().attr(\"id\"));return false;'></i>&nbsp;&nbsp;&nbsp;<i class='fa fa-minus-square-o' style='font-size: large; color: #09a3ea;' onclick='deleteWMRowData($(this).parent().parent().attr(\"id\"));return false;'></i>";
    }

    //Lưu thành mẫu
    function saveAsWMTemplate(){
        $.modalOpen({
            id: "Form",
            title: "Lưu thành mẫu",
            url: "/MedicalRecord/Form",
            width: "400px",
            height: "250px",
            callBack: function (iframeId) {
                var mbObj = top.frames[iframeId].submitForm();
                if (!(mbObj && mbObj.mbmc && mbObj.mblx)) {
                    return;
                }
                $.modalClose("Form");
                //bảng mẫu
                var mbObj = {
                    mblx: mbObj.mblx,
                    cflx: @Html.Raw(((int)EnumCflx.WMPres).ToString()),
                    mbmc: mbObj.mbmc,
                };
                //Lấytất cả các dòngId，duyệt đểSửakhung ở trạng tháiLưuTrạng thái
                var rowIds = $("#gridxycf").jqGrid('getDataIDs');
                for (var i = 0; i < rowIds.length; i++) {
                    var saveResult = $("#gridxycf").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);

                    if (!saveResult) {
                        EnableWMInlineEditBox();    //khởi động lạiKích hoạtSửa Khôngthì lần sau lầnSavekhisẽQuay lạifalse
                        return;   //Lưu thất bại，thìreturn
                    }
                }
                var gridxycfData = $("#gridxycf").jqGrid('getRowData_AllLine', null, true);
                if(!gridxycfData || gridxycfData.length==0){
                    $.modalAlert("Chi tiết mẫu không được để trống", 'warning');
                    return;
                }

                $.each(gridxycfData, function () {    //Bỏaction
                    for (var i = 0; i < $(this).length; i++) {
                        delete $(this)[i].action;
                    }
                });

                $.najax({
                    url: "/TemplateManage/PresTemplate/SaveData",
                    dataType: "json",
                    data: { mbObj: mbObj, mxList: gridxycfData },
                    type: "POST",
                    success: function (data) {
                        $.modalAlert("Lưu thành công", 'warning');
                        window.$('#current').trigger('click');
                    },
                    complete:function(){
                        EnableWMInlineEditBox();    //khởi động lạiKích hoạtSửa Khôngthì lần sau lầnSavekhisẽQuay lạifalse
                    }
                });
            }
        });
    }
    ///tạoCách dùng thuốchộp thả xuống
    function Generateypyfoption(rowid) {
        
        var currentjx = $("#" + rowid + "_jxCode").val();
        var curzh = $("#" + rowid + "_zh").val();
        var curyfdm = $("#" + rowid + "_yfCode").val();
        var curyfmc = $("#" + rowid + "_yfmcval").val();
        var jxyfdy = top.top.clients.ypjxyfdy;
        var jxyf = top.top.clients.ypyf;//tất cảCách dùng
        $("#" + rowid + "_mcjldwwwwwww").parent().next().children('select').html("<option>Vui lòng chọn</option>");
        var basejx = false;//hiện tạiThuốcCóKhôngBảo trìDạng bào chếtương ứng，Mặc địnhKhông
        //Cách dùnghộp thả xuống
        if (currentjx !== null && currentjx !== "") {//hiện tạiDạng bào chế thuốc
            $.each(jxyfdy, function (idx, val) {//Dạng bào chếCách dùngtương ứng
                if (val.jxCode === currentjx) {//tìmđếnhiện tạiDạng bào chế
                    basejx = true;
                    var yfCode = val.yfCode;//Lấyhiện tạiCách dùng
                    if (curzh !== "" && curyfdm !== "" && yfCode.indexOf(curyfdm) < 0) {//Cùng nhómCách dùngtrước đâyđãtồn tạiở
                        $.modalAlert($("#" + rowid + "_ypmc").val() + "Không tồn tại" + curyfmc + "Cách dùng", "warning");
                        $("#" + rowid + "_zh").val("");
                        $("#" + rowid + "_zh").focus();
                    }
                    var firstval = 0;
                    $.each(jxyf, function (i, v) {
                        if (yfCode.indexOf(v.yfCode) > '-1') {
                            firstval++;
                            var append = "<option value=" + v.yfCode + ">" + v.yfmc + "</option>";
                            $("#" + rowid + "_mcjldwwwwwww").parent().next().children('select').append(append);
                            if ((curyfdm == "" || isNaN(curyfdm)) && firstval == 1) {
                                $("#" + rowid + "_yfmcval").val(v.yfmc);
                                $("#" + rowid + "_yfCode").val(v.yfCode);
                            } else if (curyfdm == v.yfCode) {
                                $("#" + rowid + "_yfmcval").val(v.yfmc);
                            }
                        }
                    });
                    if (curyfdm !== "" && !isNaN(curyfdm)) {
                        $("#" + rowid + "_mcjldwwwwwww").parent().next().children('select').val(curyfdm);
                        $("#" + rowid + "_yfCode").val(curyfdm);
                    }
                }
            });

            if (!basejx) {
                $.modalAlert($("#" + rowid + "_ypmc").val() + "dạng bào chế tương ứng còn thiếuCách dùngBảo trì", "warning");
                $("#" + rowid + "_yfmcval").val("");
                $("#" + rowid + "_yfCode").val("");
                $("#" + rowid + "_mcjldwwwwwww").parent().next().children('select').html('');
                return;
            }

            //tốc độ truyền
            if ($("#" + rowid + "_yfCode").val() === "@ViewBag.frequencyRelDroppingSpeed" ||
                $("#" + rowid + "_yfmcval").val() === "@ViewBag.frequencyRelDroppingSpeed") {
                $("#" + rowid + "_ds").show();
            } else {
                $("#" + rowid + "_ds").hide();
                $("#" + rowid + "_ds").val("");
            }
        }
    }

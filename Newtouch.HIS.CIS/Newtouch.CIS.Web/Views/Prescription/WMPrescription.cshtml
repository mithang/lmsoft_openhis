    function getypsl(jlzhxs,cls,ypjl,dwlb,zxcs)
    {
       
        var mzsl = 0;
        var qzint = ypjl;
        //if (dwlb == 1) {//Đơn vị liều chuyểnđổithànhĐơn vị liều
            qzint = Number(Math.ceil(((qzint / (jlzhxs)).toFixed(4))));
        // }
        if(cls==1)//theotháokhông
            mzsl = Number(Math.ceil((qzint * zxcs)));
        else
            mzsl = Number(Math.ceil(cls/(qzint * zxcs)));
        return mzsl;
    }

    function ValidateFiveType(rowid) {
        
        var currRowyp = $("#" + rowid + "_ypCode").val();
        var currRowpc = $("#" + rowid + "_pcCode").val();
        var currRowccfh = $("#gridxycf").getRowData(rowid).cfh;
        if (currRowyp && currRowpc && currRowccfh) {
            var typecnt = 1;
            var allData = $("#gridxycf").jqGrid('getRowData_AllLine');
            $.each(allData, function () {
                var objId = $(this.ypCode).attr('rowid');
                var objyp = $("#" + objId + "_ypCode").val();
                var objpc = $("#" + objId + "_pcCode").val();
                var objcfh = $("#gridxycf").getRowData(objId).cfh;
                if (currRowyp === objyp && currRowpc === objpc && currRowccfh === objcfh&& objId != rowid) {
                    typecnt++;
                }
            });
            if (typecnt>4) {
                $.modalAlert("Số đơn thuốc là" + currRowccfh + "Thuốc cùng loại vượt quá 5, vui lòng thêm đơn thuốc mới", "warning");
                return false;
            }
        }
    }

    //Tính toánSố tiền chi tiết và số tiền đơn thuốc
    function CalculateEachLineWMJe(rowid, recalc) {
        
        var currRowZe = 0.00;
        //if ($('#' + rowid + '_dj').val()) {
        //    var editdj = roundingBy4she6ru5chengshuang($('#' + rowid + '_dj').val(), 2);
        //    $('#' + rowid + '_dj').val(editdj);
        //}

        var currRowDj = $('#' + rowid + '_dj').val();
        var currRowSl = $('#' + rowid + '_sl').val();
        var ts=$('#' + rowid + '_tsss').val();
        var zxcs=$('#' + rowid + '_zxcs').val();
        if (currRowDj && parseFloat(currRowSl) > 0) {
            currRowZe = roundingBy4she6ru5chengshuang(parseFloat(currRowDj) * parseFloat(currRowSl),2); //Đơn giá Số lượng lẻ Số lượng khônglàtrống

        }
        $('#' + rowid + '_je').val(currRowZe); //Gán giá trị
        if(!(recalc === false)){
            $('#' + rowid + '_ts').val(ts=='1'? Number(Math.ceil(currRowSl/zxcs)) :ts * currRowSl); //Gán giá trị
            CalculateWMPresAmount();  //Tính số tiền đơn thuốc
        }
    }

    //Tính số tiền đơn thuốc
    function CalculateWMPresAmount() {
        var presClassificationArr = new Array();   //Đơn thuốcPhân loại
        var allData = $("#gridxycf").jqGrid('getRowData_AllLine', null, true);
        $.each(allData, function () {
            var cfh = this.cfh;
            var rowid = this.jqRowId;

            var ypmc = $("#" + rowid + "_ypmc").val();
            var cfje = $("#" + rowid + "_je").val();

            if (!ypmc && !cfje) {
                return;
            }

            var existPres = $.jsonWhere(presClassificationArr, function (v) {
                return v && v.cfh == cfh;    //nhaucùngĐơn thuốc đặtđếnmộtsốnhómtrong  Số đơn thuốclàkey Số tiềnlàvalue
            });
            if (existPres && existPres.length == 1) {       //đãtồn tạiởSố đơn thuốc
                existPres[0].cfje = roundingBy4she6ru5chengshuang((parseFloat(existPres[0].cfje) + parseFloat(cfje)), 2);
            } else {
                presClassificationArr.push({ cfh: cfh, cfje: cfje });    //Đơn thuốc mớisố
            }
        });

        var totalAmount = 0.00;
        //ghépnhậnhtml
        $('#tableWMPresAmount').html('');   //Xóa trắng trước
        for (var i = 0; i < presClassificationArr.length; i++) {
            totalAmount = roundingBy4she6ru5chengshuang((parseFloat(totalAmount) + parseFloat(presClassificationArr[i].cfje)), 2);  //Tính toánTổng số tiền
            $('#tableWMPresAmount').append('<tr><th class="formTitle">Số đơn thuốc:</th><td class="formValue"><label style="color:red;">' + presClassificationArr[i].cfh + '</label></td><th class="formTitle">Số tiền:</th><td class="formValue"><label style="color:red;">￥' + presClassificationArr[i].cfje + '</label></td></tr>');
        }
        $('#tdWMTotalAmount').html('');  //Xóa trắng trước
        $('#tdWMTotalAmount').append('<label style="color:red;">￥' + totalAmount + '</label>');
    }


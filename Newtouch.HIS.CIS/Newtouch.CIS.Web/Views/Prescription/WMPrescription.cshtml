    //Bật sửa trong dòng
    function EnableWMInlineEditBox() {

        var ids = $("#gridxycf").getDataIDs();
        $.each(ids, function () {
            var rowid = String(this);
            //MởSửachế độ
            $("#gridxycf").jqGrid('editRow', rowid, false, initWMInlineFunc);

            //nhận dạngĐơn thuốcmàu sắc
            var cfh = $("#gridxycf").getRowData(String(this)).cfh;
            var cfColor = getCfColor(@Html.Raw(((int)EnumCflx.WMPres).ToString()),cfh);
            $('#gridxycf tr[id="' +  String(this) + '"]').css('border-left-color',cfColor);
            $('#gridxycf tr[id="' +  String(this) + '"]').css('border-left-style','solid');
            $('#gridxycf tr[id="' +  String(this) + '"]').css('border-left-width','2px');

            //chomỗi lầnĐơn vị liềuđiềnoption
            var jldw = $("#" + rowid + "_redundant_jldw").val();    //Đơn vị liều Thuốcbảng từ điểncủaĐơn vị
            var dw = $("#" + rowid + "_dw").val();     //Đơn vị ngoại trú

            if (!!dw) {
                //cách tìm phần tử nàyPhương phápkhông nên dùng，nhưng doselectKhông cóidThuộc tính
                $("#" + rowid + "_mcjl").parent().next().children('select').html('');

                if (jldw == dw) {
                    $("#" + rowid + "_mcjl").parent().next().children('select').append('<option>' + jldw + '</option>');
                }
                else {
                    if(!!jldw){
                        $("#" + rowid + "_mcjl").parent().next().children('select').append('<option>' + jldw + '</option>');
                    }
                    if(!!dw){
                        $("#" + rowid + "_mcjl").parent().next().children('select').append('<option>' + dw + '</option>');
                    }
                }
                selectedjldw = !!jldw ? jldw : dw;
                var mcjldwwwwwww = $("#" + rowid + "_mcjldwwwwwww").val();  //trên lầnĐã chọncủa
                if (mcjldwwwwwww!="") {
                    selectedjldw = mcjldwwwwwww;
                }
                if (selectedjldw) {
                    $($("#" + rowid + "_mcjl").parent().next().children('select')).val(selectedjldw).trigger('change');
                }
            }

            CalculateEachLineWMJe(rowid, false);
        });

        CalculateWMPresAmount();  //Tính toánĐơn thuốccủaSố tiền
    }

    //cùng mộtSố nhómcần khớpCách dùng、Tần suất//、Số ngày、hết hạnNgày
    function MatchWMZuhaoInfo(rowid) {
        var currRowZh = $("#" + rowid + "_zh").val();
        if (currRowZh) {
            var allData = $("#gridxycf").jqGrid('getRowData_AllLine');
            $.each(allData, function () {
                var objId = $(this.zh).attr('rowid');
                var objzh = $("#" + objId + "_zh").val();

                if (objzh == currRowZh && objId != rowid) {
                    var objyfmc = $("#" + objId + "_yfmcval").val();
                    var objyfCode = $("#" + objId + "_yfCode").val();
                    var objpcmc = $("#" + objId + "_pcmc").val();
                    var objpcCode = $("#" + objId + "_pcCode").val();
                    var currentjx = $("#" + rowid + "_jxCode").val();

                    var jxyfdy = top.top.clients.ypjxyfdy;
                    var jxyf = top.top.clients.ypyf;//tất cảCách dùng

                    $("#" + rowid + "_mcjldwwwwwww").parent().next().children('select').html("");
                    //Cách dùnghộp thả xuống
                    if (currentjx !== null && currentjx !== "") {//hiện tạiDạng bào chế thuốc
                        if ($("#" + rowid + "_ypmc").val() == "") {
                            return false;
                        }
                        $.each(jxyfdy, function (idx, val) {//Dạng bào chếCách dùngtương ứng
                            if (val.jxCode === currentjx) {//tìmđếnhiện tạiDạng bào chế
                                var yfCode = val.yfCode;//Lấyhiện tạiCách dùng
                                if (currRowZh !== "" && objyfCode !== "" && yfCode.indexOf(objyfCode) < 0) {//Cùng nhómCách dùngtrước đâyđãtồn tạiở
                                    $.modalAlert($("#" + rowid + "_ypmc").val() + "Không tồn tại" + objyfmc + "Cách dùng", "warning");
                                    $("#" + rowid + "_zh").val("");
                                    $("#" + rowid + "_zh").focus();
                                    return false;
                                }
                                $.each(jxyf, function (i, v) {
                                    if (yfCode.indexOf(v.yfCode) > '-1') {
                                        var append = "<option value=" + v.yfCode + ">" + v.yfmc + "</option>";
                                        $("#" + rowid + "_mcjldwwwwwww").parent().next().children('select').append(append);
                                    }
                                });
                                $("#" + rowid + "_mcjldwwwwwww").parent().next().children('select').val(objyfCode);
                            }
                        });
                    }

                    $("#" + rowid + "_yfmcval").val(objyfmc); //Cách dùng
                    $("#" + rowid + "_yfCode").val(objyfCode);
                    $("#" + rowid + "_pcmc").val(objpcmc); //Tần suất
                    $("#" + rowid + "_pcCode").val(objpcCode);
                }
            });
        }
	}

    var isselzd = false;
    function mxbzdselect(zdcode) {
        $.ajax({
            type: "POST",
            dataType: "json", //Quay lạijsondữ liệu có định dạng
            url: "/Prescription/Getmxbzd",
            data: { "zdcode": zdcode },
            async: false,
            success: function (ret) {
                if (ret != null && ret != "" && ret.mxbstr != null && ret.mxbstr != "") {
                    isselzd = true;
                }
            }
        });
    }
    function selectzd() {
        isselzd = false;
        var zdarr = [];
        var gyssArr = $("#selgys").val();
        if (gyssArr != null && gyssArr.length > 0) {
            $.each(gyssArr, function (index, item) {
                zdarr.push(item.split("|")[0]);
            });
        }
        if (zdarr.length > 0) {
            mxbzdselect(zdarr.join(","));///Phía máy chủ đánh giá tất cả chẩn đoán Tây y
        }
        if (isselzd == true) {
            $("#mzbck").prop("checked", true);
        } else {
            $("#mzbck").prop("checked", false);
        }

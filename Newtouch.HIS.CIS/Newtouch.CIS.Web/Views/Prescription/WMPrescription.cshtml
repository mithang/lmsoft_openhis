    function init_WMPrescription() {
        //chỉ chưaLưuđếnCơ sở dữ liệucủaĐơn thuốccần khởi tạo tronggridtrong
        xylocaldata = new Array();
        if (window.alldataArray.xycf) {
            xylocaldata = $.jsonWhere($.deepClone.clone(window.alldataArray.xycf), function(icf){
                return !!!icf.cfId;
            });
            $.each(xylocaldata, function () {
                if(!this.cfh){
                    alert('Đơn thuốcBất thường');
                    location.href = location.href;
                }
                this.action = getWMActionStr();
            });
        }
        else{
            window.alldataArray.xycf = new Array(); //Để tiện dùng về sau$.each()
        }

        if (xycfflag == 0) {   //Trang này khởi tạo
            gridxycf();
            xycfflag = 1;
        }
        else {
            $("#gridxycf").clearGridData(); //xóa trắng trước
            //Mở lại trang này
            $("#gridxycf").jqGrid('setGridParam', {
                datatype: 'local',
                data: xylocaldata
            }).trigger("reloadGrid");
        }

        //kích hoạt ngaySửacủa nótrongmột bản lầnKhám bệnhcủaĐã gửiĐơn thuốc（chưaGửiđếnkhotrongcủachắc chắn sẽởSửadanh sáchtrong）
        var triggereditcfh = sessionStorage.getItem("triggereditcfh");
        if(!!triggereditcfh){
            sessionStorage.removeItem("triggereditcfh");
            $("#floatLeftMostPartDiv div[data-href='lscf']").trigger('click');
            //chưaGửiđếnCơ sở dữ liệucủaĐơn thuốc，đâylength 0 cũng không sao
            $('span.bbit-tree-node-text[data-value="' + triggereditcfh + '"]').trigger('click');
        }
        zddata();//Chẩn đoánhộp kiểmtạo

        //Khởi tạođặcđặcĐơn thuốc
        var cftag = '';
        $.jsonWhere(window.alldataArray.xycf, function (v) {
            if (v.cfh==triggereditcfh && v.cgtag != '') {
                cftag = v.cftag;
            }
        });
        $("#tip_jmcf").val(cftag);
        var isdzcf = '0';
        $.jsonWhere(window.alldataArray.xycf, function (v) {
            if (v.cfh == triggereditcfh && v.isdzcf != '') {
                isdzcf = v.isdzcf;
            }
        });
        $("#isdzcfxy").val(isdzcf);
    }

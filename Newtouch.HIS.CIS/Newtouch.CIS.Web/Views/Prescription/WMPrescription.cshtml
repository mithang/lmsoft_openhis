    function init_WMPrescription() {
        //Chỉ đơn thuốc chưa lưu vào cơ sở dữ liệu mới cần khởi tạo tronggridtrong
        xylocaldata = new Array();
        if (window.alldataArray.xycf) {
            xylocaldata = $.jsonWhere($.deepClone.clone(window.alldataArray.xycf), function(icf){
                return !!!icf.cfId;
            });
            $.each(xylocaldata, function () {
                if(!this.cfh){
                    alert('Đơn thuốc bất thường');
                    location.href = location.href;
                }
                this.action = getWMActionStr();
            });
        }
        else{
            window.alldataArray.xycf = new Array(); //Để tiện sử dụng sau này$.each()
        }

        if (xycfflag == 0) {   //Khởi tạo trang này
            gridxycf();
            xycfflag = 1;
        }
        else {
            $("#gridxycf").clearGridData(); //Xóa trước
            //Mở lại trang này
            $("#gridxycf").jqGrid('setGridParam', {
                datatype: 'local',
                data: xylocaldata
            }).trigger("reloadGrid");
        }

        //Ngay lập tức kích hoạt chỉnh sửa một trong các đơn thuốc đã gửi của lần khám này (đơn thuốc chưa gửi vào cơ sở dữ liệu chắc chắn sẽ nằm trong danh sách chỉnh sửa)
        var triggereditcfh = sessionStorage.getItem("triggereditcfh");
        if(!!triggereditcfh){
            sessionStorage.removeItem("triggereditcfh");
            $("#floatLeftMostPartDiv div[data-href='lscf']").trigger('click');
            //Đơn thuốc chưa gửi vào cơ sở dữ liệu, ở đâylength 0 Cũng không có vấn đề
            $('span.bbit-tree-node-text[data-value="' + triggereditcfh + '"]').trigger('click');
        }
        zddata();//Tạo hộp kiểm chẩn đoán

        //Khởi tạo đơn thuốc đặc biệt
        var cftag = '';
        $.jsonWhere(window.alldataArray.xycf, function (v) {
            if (v.cfh==triggereditcfh && v.cgtag != '') {
                cftag = v.cftag;
            }
        });
        $("#tip_jmcf").val(cftag);
        var isdzcf = '0';
        $.jsonWhere(window.alldataArray.xycf, function (v) {
            if (v.cfh == triggereditcfh && v.isdzcf != '') {
                isdzcf = v.isdzcf;
            }
        });
        $("#isdzcfxy").val(isdzcf);
    }
    //Danh sách đơn thuốc

                            var selRowId = $(this.xmmc).attr('rowid');
                            deleteConsumablesRowData(selRowId, false);
                        });
                        CalculateConsumablesPresAmount();  //2.Tính toánĐơn thuốccủaSố tiền
                    }
                },

                { label: '<span class="required">*</span>Đơn vị', name: 'dw', width: 80, editwidth: '100%', align: 'center', editable: true },
                { label: 'Vị trí', name: 'bw', width: 160, editwidth: '100%', align: "center", editable: true ,hidden: true,editoptions:{
                    dataEvents:[{
                        type:'keydown',
                        fn:function(e){
                            if (e.keyCode == 13){
                                var rowid=$(e.target).closest('tr.jqgrow').attr('id');
                                $("#"+rowid+"_sl").focus();
                            }
                        }
                    }]
                }},
                {
                    label: 'Chuyển sang tự chi trả', name: 'iszzf', width: 80, editwidth: '100%', align: 'center', edittype: "select", editable: true, editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    $("#" + rowid + "_zzfbz").val($(this).val());
                                }
                            }
                        ]

                    }
                },
                { label: 'zzfbz', name: 'zzfbz', editwidth: '', align: 'center', editable: true, hidden: true },
                {
                    label: '<span class="required">*</span>Số lượng', name: 'sl', width: 80, editwidth: '100%', align: 'center', editable: true, editrules: { integer: true, minValue: 1 }, editoptions: {
                        dataEvents: [
                                {
                                    type: 'change',
                                    fn: function (e) {
                                        var cellval = $(this).val();
                                        if(cellval.replace(/(^\s*)|(\s*$)/g, "") == ""){
                                            $.modalAlert("Số lượngđể trống,Vui lòng xác nhận.", 'warning');
                                            return;
                                        }
                                        if(isNaN(cellval)){
                                            $.modalAlert("Số lượng:Vui lòng nhập số", 'warning');
                                            $(this).val('')
                                            return;
                                        }
                                        var row = $(e.target).closest('tr.jqgrow');
                                        var rowid = row.attr('id');

                                        CalculateConsumablesEachLineSlAndJe(rowid);   //Tính toán Tổng số lượng chi tiết、Số tiền chi tiết và số tiền đơn thuốc
                                    }
                            }, {
                                type: 'keydown',
                                fn: function (e) {
                                    if (e.keyCode == 13) {
                                        var row = $(e.target).closest('tr.jqgrow');
                                        var rowid = row.attr('id');
                                       
                                        addConsumablesRowData(rowid);   //Thêm mớimột dòngchi tiết
                                    }
                                }
                            }
                                //,
                                //{
                                //    type: 'keyup',
                                //    fn: function (e) {
                                //        var cellval = $(this).val();
                                //        if(cellval.replace(/(^\s*)|(\s*$)/g, "") == ""){
                                //            $.modalAlert("Số lượnglàtrống，Vui lòng xác nhận", 'warning');
                                //            return;
                                //        }
                                //        if(isNaN(cellval)){
                                //            $.modalAlert("Số lượng：Vui lòng nhập số", 'warning');
                                //            $(this).val('')
                                //            return;
                                //        }
                                //        var row = $(e.target).closest('tr.jqgrow');
                                //        var rowid = row.attr('id');

                                //        CalculateConsumablesEachLineSlAndJe(rowid);   //Tính toán Tổng số lượng chi tiết、Số tiền chi tiết và số tiền đơn thuốc
                                //    }
                                //}
                        ]
                    }
                },
                { label: '<span class="required">*</span>Số tiền', name: 'je', width: 100, editwidth: '100%', align: 'center', editable: true },
                { label: 'zfxz', name: 'zfxz', editwidth: '', align: 'center', editable: true, hidden: true },
				{ label: 'xzyysm', name: 'xzyysm', editwidth: '', align: 'center', editable: true, hidden: true },
				{ label: 'kcsl', name: 'kcsl', editwidth: '', width: 35, align: 'center', editable: true, hidden: true },
				{ label: 'sfdlcode', name: 'sfdlcode', editwidth: '', width: 35, align: 'center', editable: true, hidden: true },
                { label: 'Bộ mẫu', name: 'yfztmc', width: 65, editwidth: '100%', align: 'center', editable: true,hidden:true},
				{ label: 'Bộ mẫuMã', name: 'yfztbm', width: 65, editwidth: '100%', align: 'center', editable: true,hidden:true},
                { label: 'Thao tác', name: 'action', width: 120, align: 'center' }
            ],
            editinputwidthborder: false,    //CóKhôngcần viền Mặc địnhlàtrue
            editinputborderradius: false,   //CóKhôngcần bo tròn viền Mặc địnhtrue(có bo tròn)
            pager: "#gridwzhccfPager",
            loadComplete: function () {
                ////tựđộngkích hoạtĐơn thuốc mới
                //if (wzhclocaldata && wzhclocaldata.length == 0) {
                //    newConsumablesPresData();
                //}
            },
            gridComplete: function () {
                EnableConsumablesInlineEditBox();
            }
        });

        //Menu cấp 2
        $gridwzhccf.jqGrid('setGroupHeaders', {
            useColSpanStyle: true,
            groupHeaders: [
            {
                startColumnName: 'xmmc',
                numberOfColumns: 5,
                titleText: 'Thông tin cơ bản'
            }]
        });

        //Nút tùy chỉnh
        $gridwzhccf
            .navGrid('#gridwzhccfPager', { edit: false, add: false, del: false, search: false, refresh: false, view: false, position: "left", cloneToTop: false })

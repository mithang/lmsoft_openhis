                        dataEvents:[{
                            type:'keydown',
                            fn:function(e){
                                if (e.keyCode == 13){
                                    var rowid=$(e.target).closest('tr.jqgrow').attr('id');
                                    $("#"+rowid+"_bw").focus();
                                }
                            }

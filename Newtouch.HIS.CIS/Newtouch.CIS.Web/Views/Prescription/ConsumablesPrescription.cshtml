    //Bật sửa trong dòng
    function EnableConsumablesInlineEditBox(){
        var ids = $("#gridwzhccf").getDataIDs();
        $.each(ids, function () {
            //MởSửachế độ
            $("#gridwzhccf").jqGrid('editRow', String(this), false, initConsumablesInlineFunc);

            //nhận dạngĐơn thuốcmàu sắc
            var cfh = $("#gridwzhccf").getRowData(String(this)).cfh;
            var cfColor = getCfColor(@Html.Raw(((int)EnumCflx.Yyhc).ToString()),cfh);
            $('#gridwzhccf tr[id="' +  String(this) + '"]').css('border-left-color',cfColor);
            $('#gridwzhccf tr[id="' +  String(this) + '"]').css('border-left-style','solid');
            $('#gridwzhccf tr[id="' +  String(this) + '"]').css('border-left-width','5px');

            CalculateConsumablesEachLineSlAndJe(String(this), false);
        });

        CalculateConsumablesPresAmount();  //Tính toánĐơn thuốccủaSố tiền
    }

    //Khởi tạo lớp nổi
    function initConsumablesInlineFunc(rowid) {
        //Một số cột chỉ đọc
        $("#" + rowid + "_dj").css('background-color','#f6f7fb').attr('readonly','true');
        $("#" + rowid + "_dw").css('background-color','#f6f7fb').attr('readonly','true');
        $("#" + rowid + "_je").css('background-color','#f6f7fb').attr('readonly','true');
        $("#" + rowid + "_xmmc").attr('autocomplete', 'off'); 
        $("#" + rowid + "_zxksmc").attr('autocomplete', 'off'); 
        $("#" + rowid + "_bw").parent().next().children('select').html('');
        $("#" + rowid + "_bw").parent().next().children('select').append('<option value="1">Có</option><option value="0">Không</option>');

        var iszzfval = $("#" + rowid + "_zzfbz").val();
        if (!!iszzfval) {
            $("#" + rowid + "_bw").parent().next().children('select').val(iszzfval).trigger("change");
        } else {
            $("#" + rowid + "_bw").parent().next().children('select').val(0).trigger("change");
        }
		$("#" + rowid + "_xmmc").click(function () {
			if ($("#" + rowid + "_xmmc") != "") {
				$("#" + rowid + "_xmmc").select();
			}
		});
		var currlineCfh = $("#gridwzhccf").getRowData(rowid).cfh;
        //Mụclớp nổi
        $("#" + rowid + "_xmmc").sfxmFloatingSelector({
            djDecimalPlaces: 4,
            searchType : 'yyhc',
            ajaxparameters: function ($thisinput) {
                 var flag = false;
                //thuốc hạn chếcủalời，flag=true
                if (window.currPatientInfo.brxzCode != "" &&'@ViewBag.ControlbrxzCode'.indexOf(window.currPatientInfo.brxzCode) > -1) {
                    flag = true;
                }
                return "onlyybflag=" + flag + "&mzzybz=1&dllb=2&sfdllx=cl&keyword=" + $.trim($thisinput.val())+"&ypyfbmCode="+currPatientInfo.jzks;
            },
            itemdbclickhandler: function ($this) {
                //Kiểm tratrùng lặp
                var isRepeatedAdd = false;
                //Thu phíBộ mẫutạmdùngxzyysmtồn tạiđặtMụcchi tiếtMã
				var addzfxz = $this.attr('data-zfxz');// debugger;
                var addxmCode =addzfxz=='9'? $this.attr('data-xzyysm'):$this.attr('data-sfxmCode');
                $.each($("#gridwzhccf").getDataIDs(), function () {
                    var cfh = $("#gridwzhccf").getRowData(String(this)).cfh;
                    var zfxz=  $('#' + $($("#gridwzhccf").getRowData(String(this)).zfxz).attr('id')).val();
                    var xmCode = zfxz=='9'? $('#' + $($("#gridwzhccf").getRowData(String(this)).xzyysm).attr('id')).val() 
                        : $('#' + $($("#gridwzhccf").getRowData(String(this)).xmCode).attr('id')).val();
                    if((addzfxz=='9'||zfxz=='9')&& String(this) != rowid && cfh == currlineCfh)
                    {
                        var addmxarr=addxmCode.split(',')
                        var mxarr=xmCode.split(',')
                        for(var i=0;i<addmxarr.length;i++)
                        {
                            if(isRepeatedAdd)break;
                            if(xmCode.indexOf(addmxarr[i].toString()) > -1)
                            {
                                for (var j = 0; j < mxarr.length; j++) {
                                    if (addmxarr[i] == mxarr[j]) {
                                        isRepeatedAdd = true;
                                        break;
                                    }
                                }
                            }
                        }
                    }
                    else if (addxmCode == xmCode && String(this) != rowid && cfh == currlineCfh) {
                        isRepeatedAdd = true;
                        return;
                    }
                });
                if (isRepeatedAdd) {
                    $.modalAlert("Chi tiết trong đơn thuốc lẻ hoặc chi tiết trong bộ mẫu không được trùng lặp", 'warning');
                    return;
                }
                if(addzfxz=='9')
                {
                    $("#" + rowid + "_yfztbm").val($this.attr('data-sfxmCode'));
                    $("#" + rowid + "_yfztmc").val($this.attr('data-sfxmmc'));
                }
                $("#" + rowid + "_xmmc").val($this.attr('data-sfxmmc'))
                $("#" + rowid + "_xmCode").val($this.attr('data-sfxmCode'));
                $("#" + rowid + "_dj").val($this.attr('data-dj'));
                $("#" + rowid + "_dw").val($this.attr('data-dw'));
                $("#" + rowid + "_zxks").val($this.attr('data-yfbmCode'));
                $("#" + rowid + "_zxksmc").val($this.attr('data-yfbmmc'));
                $("#" + rowid + "_zfxz").val($this.attr('data-zfxz'));
                $("#" + rowid + "_xzyysm").val($this.attr('data-xzyysm'));
                //Khởi tạolà1
				$("#" + rowid + "_sl").val(1);
				//$("#" + rowid + "_xmmc").css('background-color','#f6f7fb').attr('readonly','true');

				$("#" + rowid + "_kcsl").val($this.attr('data-kcsl'));
				$("#" + rowid + "_sfdlcode").val($this.attr('data-sfdlCode'));
                //Tồn khoSố lượng
				var kcsl = parseInt($this.attr('data-kcsl'));
				var cls = parseInt($this.attr('data-cls'));
				var mzkcsl = !!kcsl && !!cls ? (parseInt(kcsl / cls)) : 0;
				ypkcrem($this.attr('data-yfbmCode'), $this.attr('data-sfxmCode'), mzkcsl);
				CalculateConsumablesEachLineSlAndJe(rowid);   //Tính toán Tổng số lượng chi tiết、Số tiền chi tiết và số tiền đơn thuốc
            },
        });
        //Thực hiệnKhoa
        $("#" + rowid + "_zxksmc").newtouchBatchFloatingSelector({
            height: 170,
            width: 300,
            caption: "ChọnKhoa",
            url: '/Prescription/GetSfxmZxksSelectJson',
            clickautotrigger: true,
            ajaxparameters: function ($thisinput) {
                return 'sfxmCode=' + $("#" + rowid + "_xmCode").val() + "&keyword=" + $thisinput.val();
            },
            colModel: [
                { label: 'Số hiệu', name: 'Code', widthratio: 40 },
                { label: 'Tên', name: 'Name', widthratio: 60 },
                { label: 'Pinyin', name: 'py', hidden: true }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#" + rowid + "_zxks").val($thistr.find("td:eq(0)").html());
                $("#" + rowid + "_zxksmc").val($thistr.find('td:eq(1)').html());
                return;
            },
        });
        //Vị trílớp nổi
        $("#" + rowid + "_bw").bwFloatingSelector({
            showtext: 'bwmc',
            attrcols: ['bwmc', 'bwCode'],
            checkItemActivity: checkItemActivity,
            ajaxparameters: function ($thisinput) {
                return "keyword=" + $thisinput.val();
            },
            itemdbclickhandler: function ($this) {
                var mcval = "";
                if (typeof ($this) !== "undefined") {
                    $.each($this, function () {
                        mcval += this.attr('data-bwmc') + ",";

                    });
                    if (mcval.length > 0) {
                        mcval = mcval.substring(0, mcval.length - 1);
                    };
                }
                $("#" + rowid + "_bw").val(mcval);
            },
        });

    }

    //Tính toántrong chi tiếtSố lượngvàSố tiền
    function CalculateConsumablesEachLineSlAndJe(rowid, recalc) {
        var obj = new Object();

        var currRowSl = $('#' + rowid + '_sl').val();
        var currRowDj = $('#' + rowid + '_dj').val();

        if (currRowSl > 0 && currRowDj > 0) {
            obj.currRowZe = roundingBy4she6ru5chengshuang(parseFloat(currRowSl) * parseFloat(currRowDj),2);
        }

        $('#' + rowid + '_je').val(obj.currRowZe)   //Gán giá trị

        if(!(recalc === false)){
            CalculateConsumablesPresAmount()  //Tính số tiền đơn thuốc
        }
    }

    //Tính số tiền đơn thuốc
    function CalculateConsumablesPresAmount() {
        var presClassificationArr = new Array();   //Đơn thuốcPhân loại
        var allData = $("#gridwzhccf").jqGrid('getRowData_AllLine', null, true);
        $.each(allData, function () {
            var cfh = this.cfh;
            var rowid = this.jqRowId;

            var xmmc = $("#" + rowid + "_xmmc").val();
            var sl = $("#" + rowid + "_sl").val();
            var dj = $("#" + rowid + "_dj").val();

            if (!xmmc && !sl && !dj) {
                return;
            }
            var cfje = roundingBy4she6ru5chengshuang(parseFloat($.undefinedwith0(sl) * parseFloat($.undefinedwith0(dj))), 2);   //Tính toánnàyĐơn thuốccủaSố tiền

            var existPres = $.jsonWhere(presClassificationArr, function (v) {
                return v && v.cfh == cfh;    //nhaucùngĐơn thuốc đặtđếnmộtsốnhómtrong  Số đơn thuốclàkey Số tiềnlàvalue
            });
            if (existPres && existPres.length == 1) {       //đãtồn tạiởSố đơn thuốc
                existPres[0].cfje = roundingBy4she6ru5chengshuang((parseFloat(existPres[0].cfje) + parseFloat(cfje)), 2);
            } else {
                presClassificationArr.push({ cfh: cfh, cfje: cfje });    //Đơn thuốc mớisố
            }
        });

        var totalAmount = 0.00;
        //ghépnhậnhtml
        $('#tableConsumablesPresAmount').html('');   //Xóa trắng trước
        for (var i = 0; i < presClassificationArr.length; i++) {
            totalAmount = roundingBy4she6ru5chengshuang((parseFloat(totalAmount) + parseFloat(presClassificationArr[i].cfje)), 2);  //Tính toánTổng số tiền
            $('#tableConsumablesPresAmount').append('<tr><th class="formTitle">Số đơn thuốc:</th><td class="formValue"><label style="color:red;">' + presClassificationArr[i].cfh + '</label></td><th class="formTitle">Số tiền:</th><td class="formValue"><label style="color:red;">￥' + presClassificationArr[i].cfje + '</label></td></tr>');
        }
        $('#tdConsumablesTotalAmount').html('');  //Xóa trắng trước
        $('#tdConsumablesTotalAmount').append('<label style="color:red;">￥' + totalAmount + '</label>');
    }

    //Đơn thuốc mới Nút
    function newConsumablesPresData() {
        var eRowIds = $("#gridwzhccf").jqGrid("getDataIDs");
        if(eRowIds && eRowIds.length){
            $.modalConfirm("Xác nhận muốn thêm đơn thuốc mới?", function (flag) {
                if(flag){
                    newConsumablesPresData_sub();
                }
            });
        }
        else{
            newConsumablesPresData_sub();
        }
    }

    function newConsumablesPresData_sub(){
        var dataRow = {
            cfId: null, //cònchưaLưuđếnCơ sở dữ liệu
            cfh: GetNewPresNo(),
            ybwym:GetGuid(19,62),
            action: getConsumablesActionStr()
        };
        $("#gridwzhccf").jqGrid("addRowData", undefined, dataRow, "last");
        var rowIds = $("#gridwzhccf").jqGrid('getDataIDs');
        $("#"+rowIds[rowIds.length-1]+"_xmmc").focus();
    }

    //Thêm mớichi tiết
    function addConsumablesRowData(selRowId) {
        //Lấyhiện tạiThêmcủaSố đơn thuốc
        var selRowData = $("#gridwzhccf").getRowData(selRowId);

        //mớithêmmộtdòng
        var dataRow = {
            cfId: selRowData.cfId,  //cùngdạngcfIdcũngcần
            cfh: selRowData.cfh,
            ybwym:GetGuid(19,62),
            action: getConsumablesActionStr()
        };
        $("#gridwzhccf").jqGrid("addRowData", undefined, dataRow, "after", selRowId);
        var rowIds = $("#gridwzhccf").jqGrid('getDataIDs');
        $("#"+rowIds[rowIds.length-1]+"_xmmc").focus();
    }

    //Xóa chi tiết
    function deleteConsumablesRowData(selRowId, recalc) {
        if (!!selRowId) {
            delSqtx("wzhccf",selRowId);
            $("#gridwzhccf").jqGrid("delRowData", selRowId);
            if(!(recalc === false)){
                CalculateConsumablesPresAmount();
            }
        }
    }


    function getConsumablesActionStr() {
        return "<i class='fa fa-plus-square-o' style='font-size: large; color: #09a3ea;' onclick='addConsumablesRowData($(this).parent().parent().attr(\"id\"));return false;'></i>&nbsp;&nbsp;&nbsp;<i class='fa fa-minus-square-o' style='font-size: large; color: #09a3ea;' onclick='deleteConsumablesRowData($(this).parent().parent().attr(\"id\"));return false;'></i>";
    }

    //Lưu
    function SaveConsumablesPres(savetodb, justUpdateAlldataArray) {
        debugger;
        //Lấytất cả các dòngId，duyệt đểSửakhung ở trạng tháiLưuTrạng thái
        var rowIds = $("#gridwzhccf").jqGrid('getDataIDs');
        for (var i = 0; i < rowIds.length; i++) {
            var saveResult = $("#gridwzhccf").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);
            var rowData = $("#gridwzhccf").getRowData(rowIds[i]);
            var thissl = rowData.sl;
            if(thissl){
                if(!ypkccheck(rowData.zxks,rowData.xmCode,parseInt(thissl))){
                    $.modalAlert(rowData.xmmc + "Vật tư tiêu haoTồn khoKhông đủ", "error");
                    saveResult = false;
                }
            }
            if (!saveResult) {
                EnableConsumablesInlineEditBox();    //khởi động lạiKích hoạtSửa Khôngthì lần sau lầnSavekhisẽQuay lạifalse
                return;   //Lưu thất bại，thìreturn
            }
        }

        var gridwzhccfData = $("#gridwzhccf").jqGrid('getRowData_AllLine', null, true);

        var flag = false;
        if (savetodb=='1') {
            $.each(gridwzhccfData, function () {
                var slval = this.sl;
                if (slval.replace(/(^\s*)|(\s*$)/g, "") == "") {
                    $.modalAlert("Số lượngkhông được để trống,Vui lòng xác nhận.", 'warning');
                    flag = true;
                    return false;
                } else if (this.xmmc == undefined || this.xmmc == "") {
                    $.modalAlert("ThiếuMục", "warning");
                    flag = true;
                    return false;
                }else if(this.zxksmc==undefined||this.zxksmc==""){
                    $.modalAlert("ThiếuKhoa thực hiện", "warning");
                    flag = true;
                    return false;
                } else if (isNaN(this.dj) || this.dj == "") {
                    $.modalAlert("ThiếuĐơn giá", "warning");
                    flag = true;
                    return false;
                } else if (this.dw === undefined || this.dw == "") {
                    $.modalAlert("Thiếu đơn vị", "warning");
                    flag = true;
                    return false;
                } else if (isNaN(this.sl) || this.sl == "") {
                    $.modalAlert("ThiếuSố lượng", "warning");
                    flag = true;
                    return false;
                } else if (isNaN(this.je) || this.je == "") {
                    $.modalAlert("ThiếuSố tiền", "warning");
                    flag = true;
					return false;
				} else if (this.sfdlcode == '18' && parseFloat(this.kcsl) < parseFloat(this.sl)) {
					$.modalAlert("[" + this.xmmc + "] số lượng lớn hơn lượng tồn kho, lượng tồn kho là [" + this.kcsl + "], số lượng kê là [" + this.sl+"]", "warning");
					flag = true;
					return false;
				}
            })
        }

        if (flag) {
            EnableConsumablesInlineEditBox();
            return;
        }

        $.each(gridwzhccfData, function () {
            delete this.action;   //Bỏaction
            delete this.jqRowId;   //BỏjqRowId

            this.sfbz = false;  //mộtđịnhCóChưa thu phímớicó thểvàovàoSửaTrạng thái
            var thismxCfId = this.cfId;
            var matchedHisCf = $.jsonWhere(window.alldataArray.wzhccf, function(icfmx){
                return !!icfmx.cfId && icfmx.cfId == thismxCfId;
            });
            if(matchedHisCf && matchedHisCf.length){
                this.cfzhdysj = matchedHisCf[0].cfzhdysj;
                this.sendtohisResult = matchedHisCf[0].sendtohisResult;
                this.klrq = matchedHisCf[0].klrq;
            }
        });
        //Lưu dữ liệu
        window.alldataArray.wzhccf = $.jsonWhere(window.alldataArray.wzhccf, function(icfmx){
            if(!!!icfmx.cfId){
                return false;   //Sửatrong danh sách có
            }
            for(var iIndex = 0; iIndex < gridwzhccfData.length; iIndex++){
                if(gridwzhccfData[iIndex].cfh == icfmx.cfh){
                    return false;
                }
            }
            return true;
        });

		var hccfmxlist = new Array();
		$.each(gridwzhccfData, function(){
		    window.alldataArray.wzhccf.push(this);

			hccfmxlist.push(this.cfh);
        });

		hccfmxlist = Array.from(new Set(hccfmxlist));//đitrọng
		wzhclocaldata = new Array();

        if(!(justUpdateAlldataArray == true)){
            if (savetodb == '1') {
                if (SaveData(false, function () {
					window.initHistoryPresTree('@Html.Raw(((int)EnumCflx.Yyhc).ToString())');
					WZDJSsave(hccfmxlist);//Khoavật tưTồn khođôngkết
                    $.modalAlert("Lưu thành công", 'success');
                })) {
                    $("#gridwzhccf").clearGridData();
                } else {
                    EnableConsumablesInlineEditBox();    //khởi động lạiKích hoạtSửa Khôngthì lần sau lầnSavekhisẽQuay lạifalse
                }
            }
            else{
                //nhảy vềHồ sơtrang
                $('#myTab [href="#linkbl"]').trigger('click'); //Khởi tạoHiển thịnàotab
                //bệnhVDtranglạitảiĐơn thuốc，Dữ liệu đơn thuốc đã thay đổi
                triggleActive();
            }
        }
        else {
            triggleActive();
        }
    }


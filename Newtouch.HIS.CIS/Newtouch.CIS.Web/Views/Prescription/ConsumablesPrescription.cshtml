			async: true,
			success: function (ajaxresp) {
				//console.log("Khấu trừvật tưTồn khotình hình", ajaxresp);
			}
		});

	}

    //Lưu thành mẫu
	function saveAsConsumablesTemplate(){
        $.modalOpen({
            id: "Form",
            title: "Lưu thành mẫu",
            url: "/MedicalRecord/Form",
            width: "400px",
            height: "250px",
            callBack: function (iframeId) {
                var mbObj = top.frames[iframeId].submitForm();
                if (!(mbObj && mbObj.mbmc && mbObj.mblx)) {
                    return;
                }
                $.modalClose("Form");
                //bảng mẫu
                var mbObj = {
                    mblx: mbObj.mblx,
                    cflx: @Html.Raw(((int)EnumCflx.Yyhc).ToString()),
                    mbmc: mbObj.mbmc,
                }
                //Lấytất cả các dòngId，duyệt đểSửakhung ở trạng tháiLưuTrạng thái
                var rowIds = $("#gridwzhccf").jqGrid('getDataIDs');
                for (var i = 0; i < rowIds.length; i++) {
                    var saveResult = $("#gridwzhccf").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);

                    if (!saveResult) {
                        EnableConsumablesInlineEditBox();    //khởi động lạiKích hoạtSửa Khôngthì lần sau lầnSavekhisẽQuay lạifalse
                        return;   //Lưu thất bại，thìreturn
                    }
                }
                var gridwzhccfData = $("#gridwzhccf").jqGrid('getRowData_AllLine', null, true);
                if(!gridwzhccfData || gridwzhccfData.length==0){
                    EnableConsumablesInlineEditBox();    //khởi động lạiKích hoạtSửa Khôngthì lần sau lầnSavekhisẽQuay lạifalse
                    $.modalAlert("Chi tiết mẫu không được để trống", 'warning');
                    return;
                }

                $.each(gridwzhccfData, function () {    //Bỏaction
                    for (var i = 0; i < $(this).length; i++) {
                        delete $(this)[i].action;
                    }
                });

                $.najax({
                    url: "/TemplateManage/PresTemplate/SaveData",
                    dataType: "json",
                    data: { mbObj: mbObj, mxList: gridwzhccfData },
                    type: "POST",
                    success: function (data) {
                        $.modalAlert("Lưu thành công", 'warning');
                        window.$('#current').trigger('click');
                    },
                    complete:function(){
                        EnableConsumablesInlineEditBox();    //khởi động lạiKích hoạtSửa Khôngthì lần sau lầnSavekhisẽQuay lạifalse
                    }
                });
            }
        });
    }
   
</script>
@using Newtouch.Infrastructure
@{
    //vật tưVật tư tiêu hao
    ViewBag.Title = "ConsumablesPrescription";
    Layout = null;
}
<div id="linkwzhccf" role="tabpanel" class="tab-pane" style="width:96.5%; float:right; margin-right: 10px; border:solid 1px #ddd; margin-top: 3px;">
    <div class="contentPanel">
        <div style="background-color: #fff;">
            <table id="gridwzhccf"></table>
            <div id="gridwzhccfPager"></div>
        </div>
    </div>
    <div id="bottom" class="clearfix" style="border-top: solid 1px #ddd; height: 80px;margin-bottom:1px;">
        <table class="form" id="tableConsumablesPresAmount" style="float:left; width:50%;border-right: solid 1px #ddd;"></table>
        <div class="lowerrightcorner" style="margin-left: 50%;width: 50%;height: 100%;">
            <table class="form" style="position: relative; top: 25%;">
                <tr>
                    <th class="formTitle">Tổng số tiền:</th>
                    <td class="formValue" id="tdConsumablesTotalAmount"></td>
                    <td style="width: 90px;"></td>
                    <td></td>
                </tr>
                <tr>
                    <td></td>
                    <td class="formValue">
                        <input type="button" class="btn btn-primary" value="Quay lạiBệnh án" style="margin-left:48%; display:table-cell" onclick="SaveConsumablesPres()" />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-primary" value="Lưu thành mẫu" style="display:table-cell;" onclick="saveAsConsumablesTemplate()" />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-primary" value="F3:LưuĐơn thuốc" style="display:table-cell;" onclick="SaveConsumablesPres('1')" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>

<script>
    var wzhccfflag = 0;
    var wzhclocaldata = new Array();

    function init_ConsumablesPrescription() {

        //chỉ chưaLưuđếnCơ sở dữ liệucủaĐơn thuốccần khởi tạo tronggridtrong
        wzhclocaldata = new Array();
        if (window.alldataArray.wzhccf) {
            wzhclocaldata = $.jsonWhere($.deepClone.clone(window.alldataArray.wzhccf), function(icf){
                return !!!icf.cfId;
            });
            $.each(wzhclocaldata, function () {
                if(!this.cfh){
                    alert('Đơn thuốcBất thường');
                    location.href = location.href;
                }
                this.action = getConsumablesActionStr()
            });
        }
        else{
            window.alldataArray.wzhccf = new Array(); //Để tiện dùng về sau$.each()
        }

        if (wzhccfflag == 0) {   //Trang này khởi tạo
            gridwzhccf();
            wzhccfflag = 1;
        }
        else {
            $("#gridwzhccf").clearGridData(); //xóa trắng trước
            //Mở lại trang này
            $("#gridwzhccf").jqGrid('setGridParam', {
                datatype: 'local',
                data: wzhclocaldata
            }).trigger("reloadGrid");

            ////Bật sửa trong dòng
            //EnableConsumablesInlineEditBox();
        }

        //kích hoạt ngaySửacủa nótrongmột bản lầnKhám bệnhcủaĐã gửiĐơn thuốc(chưaGửiđếnkhotrongcủachắc chắn sẽởSửadanh sáchtrong)
        var triggereditcfh = sessionStorage.getItem("triggereditcfh");
        if(!!triggereditcfh){
            sessionStorage.removeItem("triggereditcfh");
            $("#floatLeftMostPartDiv div[data-href='lscf']").trigger('click');
            //chưaGửiđếnCơ sở dữ liệucủaĐơn thuốc，đâylength 0 cũng không sao
            $('span.bbit-tree-node-text[data-value="' + triggereditcfh + '"]').trigger('click');
        }
    }

    //Đơn thuốcdanh sách

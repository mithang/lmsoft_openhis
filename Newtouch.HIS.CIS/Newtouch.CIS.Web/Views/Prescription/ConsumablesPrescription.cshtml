            autowidth: true,
            rownumbers: true,  //CóKhôngHiển thịSố thứ tự
            multiselect: true,
            editurl: "clientArray",  //dòngSửakhông gửi lên máy chủGửiDữ liệu
            unwritten: false,
            colModel: [
                { label: 'cfId', name: 'cfId', hidden: true },
                { label: 'ybwym', name: 'ybwym', hidden: true },

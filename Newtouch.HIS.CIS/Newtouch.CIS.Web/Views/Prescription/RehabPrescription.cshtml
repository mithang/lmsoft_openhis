@using Newtouch.Infrastructure
@{
    ViewBag.Title = "RehabPrescription";
    Layout = null;
    //Đơn thuốc phục hồi chức năng có trích dẫn đề xuất điều trị không
    var isWithRehabSuggestion = SysConfigReader.Bool("IS_WithRehabSuggestion", false).Value;
}
<div id="linkkfcf" role="tabpanel" class="tab-pane" style="width:96.5%; float:right; margin-right: 10px; border:solid 1px #ddd; margin-top: 3px;">
    <div class="contentPanel">
        <div style="background-color: #fff;">
            <table id="gridkfcf"></table>
            <div id="gridkfcfPager"></div>
        </div>
    </div>
    <div id="bottom" class="clearfix" style="border-top: solid 1px #ddd; height: 80px;margin-bottom:1px;">
        <table class="form" id="tableRehabPresAmount" style="float:left; width:50%;border-right: solid 1px #ddd;"></table>
        <div class="lowerrightcorner" style="margin-left: 50%;width: 50%;height: 100%;">
            <table class="form" style="position: relative; top: 25%;">
                <tr>
                    <th class="formTitle">Tổng số tiền:</th>
                    <td class="formValue" id="tdRehabTotalAmount"></td>
                    <td style="width: 90px;"></td>
                    <td></td>
                </tr>
                <tr>
                    <td class="formValue">
                        @if (isWithRehabSuggestion)
                        {
                            <input type="button" class="btn btn-success" value="Đề xuất phục hồi chức năng" style="margin-left:48%; " onclick="AddRefeKfjy()" />
                        }
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-primary" value="Quay lại bệnh án" style="margin-left:48%; display:table-cell" onclick="SaveRehabPres()" />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-primary" value="Lưu thành mẫu khác" style="display:table-cell;" onclick="saveAsRehabTemplate()" />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-primary" value="F3: Lưu đơn thuốc" style="display:table-cell;" onclick="SaveRehabPres('1')" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>

@*Đơn thuốc phục hồi chức năng*@
<script>
    var kfcfflag = 0;
    var kflocaldata = new Array();

    function init_RehabPrescription() {

        //Chỉ đơn thuốc chưa lưu vào cơ sở dữ liệu mới cần khởi tạo tronggridtrong
        kflocaldata = new Array();
        if (window.alldataArray.kfcf) {
            kflocaldata = $.jsonWhere($.deepClone.clone(window.alldataArray.kfcf), function(icf){
                return !!!icf.cfId;
            });
            $.each(kflocaldata, function () {
                if(!this.cfh){
                    alert('Đơn thuốc bất thường');
                    location.href = location.href;
                }
                this.action = getRehbActionStr()
            });
        }
        else{
            window.alldataArray.kfcf = new Array(); //Để tiện sử dụng sau này$.each()
        }

        if (kfcfflag == 0) {   //Khởi tạo trang này
            gridkfcf();
            kfcfflag = 1;
        }
        else {
            $("#gridkfcf").clearGridData(); //Xóa trước
            //Mở lại trang này
            $("#gridkfcf").jqGrid('setGridParam', {
                datatype: 'local',
                data: kflocaldata
            }).trigger("reloadGrid");

            ////Bật chỉnh sửa trong dòng
            //EnableRehabInlineEditBox();
        }

        //Ngay lập tức kích hoạt chỉnh sửa một trong các đơn thuốc đã gửi của lần khám này (đơn thuốc chưa gửi vào cơ sở dữ liệu chắc chắn sẽ nằm trong danh sách chỉnh sửa)
        var triggereditcfh = sessionStorage.getItem("triggereditcfh");
        if(!!triggereditcfh){
            sessionStorage.removeItem("triggereditcfh");
            $("#floatLeftMostPartDiv div[data-href='lscf']").trigger('click');
            //Đơn thuốc chưa gửi vào cơ sở dữ liệu, ở đâylength 0 Cũng không có vấn đề
            $('span.bbit-tree-node-text[data-value="' + triggereditcfh + '"]').trigger('click');
        }
    }

    //Danh sách đơn thuốc
    function gridkfcf() {
        var $gridkfcf = $("#gridkfcf");
        $gridkfcf.jqGrid({
            datatype: 'local',
            data: kflocaldata,
            height: $(window).height() - 230,
            //altRows: true,//Đổi màu xen kẽ các dòng
            shrinkToFit: true,   //true:Khởi tạo chiều rộng cột theo tỷ lệ false:Sử dụngcolModelchiều rộng đã chỉ định
            autowidth: true,
            rownumbers: true,  //Có hiển thị số thứ tự không
            multiselect: true,
            editurl: "clientArray",  //Chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            unwritten: false,
            colModel: [
                { label: 'cfId', name: 'cfId', hidden: true },
                { label: 'ybwym', name: 'ybwym', hidden: true },
                { label: 'xzsybz', name: 'xzsybz', hidden: true },
                { label: 'cfmxId', name: 'cfmxId', hidden: true },
                { label: '<span class="required">*</span>Số đơn thuốc', name: 'cfh', width: 180, align: 'center'},
                {
                    label: 'xmCode', name: 'xmCode', editwidth: '100%', align: 'center', editable: true, hidden: true
                },
                {
                    label: '<span class="required">*</span>Tên hạng mục', name: 'xmmc', width: 280, editwidth: '100%', align: 'center', editable: true
                },
                {
                    label: 'zxks', name: 'zxks', editwidth: '100%', align: 'center', editable: true, hidden: true
                },
                {
                    label: '<span class="required">*</span>Khoa thực hiện', name: 'zxksmc', width: 180, editwidth: '100%', align: 'center', editable: true
                },
                {
                    label: '<span class="required">*</span>Đơn giá', name: 'dj', width: 80, editwidth: '100%', align: 'center', editable: true
                },
                { label: '<span class="required">*</span>Đơn vị', name: 'dw', width: 80, editwidth: '100%', align: 'center', editable: true },
                { label: 'dwjls', name: 'dwjls', width: 80, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: 'jjcl', name: 'jjcl', width: 80, editwidth: '100%', align: 'center', editable: true, hidden: true },
                {
                    label: '<span class="required">*</span>Liều lượng mỗi lần điều trị', name: 'mczll', width: 110, editwidth: '100%', align: 'center', editable: true, editrules: { integer: true, minValue: 1 }, editoptions: {
                        dataEvents: [
                                {
                                    type: 'change',
                                    fn: function (e) {
                                        var cellval = $(this).val();
                                        if(cellval.replace(/(^\s*)|(\s*$)/g, "") == ""){
                                            $.modalAlert("Liều lượng mỗi lần điều trị trống, vui lòng xác nhận.", 'warning');
                                            return;
                                        }
                                        if(isNaN(cellval)){
                                            $.modalAlert("Liều lượng mỗi lần điều trị: vui lòng nhập số", 'warning');
                                            $(this).val('')
                                            return;
                                        }
                                        var row = $(e.target).closest('tr.jqgrow');
                                        var rowid = row.attr('id');

                                        CalculateRehabEachLineSlAndJe(rowid);   //Tính toán Tổng số lượng chi tiết, tổng số tiền chi tiết và số tiền đơn thuốc
                                    }
                                }
                        ]
                    }
                },
                { label: '<span class="required">*</span>Tần suất', name: 'pcmc', width: 80, editwidth: '100%', align: 'center', editable: true },
                { label: 'pcCode', name: 'pcCode', width: 100, editwidth: '100%', align: 'center', editable: true, hidden: true },
                {
                    label: '<span class="required">*</span>Số lần', name: 'sl', width: 80, editwidth: '100%', align: 'center', editable: true, editrules: { integer: true, minValue: 1 }, editoptions: {
                        dataEvents: [
                                {
                                    type: 'change',
                                    fn: function (e) {
                                        var cellval = $(this).val();
                                        if(cellval.replace(/(^\s*)|(\s*$)/g, "") == ""){
                                            $.modalAlert("Số lượng trống, vui lòng xác nhận.", 'warning');
                                            return;
                                        }
                                        if(isNaN(cellval)){
                                            $.modalAlert("Số lượng: vui lòng nhập số", 'warning');
                                            $(this).val('')
                                            return;
                                        }
                                        var row = $(e.target).closest('tr.jqgrow');
                                        var rowid = row.attr('id');

                                        CalculateRehabEachLineSlAndJe(rowid);   //Tính toán Tổng số lượng chi tiết, tổng số tiền chi tiết và số tiền đơn thuốc
                                    }
                                }
                                //,
                                //{
                                //    type: 'keyup',
                                //    fn: function (e) {
                                //        var cellval = $(this).val();
                                //        if(cellval.replace(/(^\s*)|(\s*$)/g, "") == ""){
                                //            $.modalAlert("Số lượng trống, vui lòng xác nhận.", 'warning');
                                //            return;
                                //        }
                                //        if(isNaN(cellval)){
                                //            $.modalAlert("Số lượng: vui lòng nhập số", 'warning');
                                //            $(this).val('')
                                //            return;
                                //        }
                                //        var row = $(e.target).closest('tr.jqgrow');
                                //        var rowid = row.attr('id');

                                //        CalculateRehabEachLineSlAndJe(rowid);   //Tính toán Tổng số lượng chi tiết, tổng số tiền chi tiết và số tiền đơn thuốc
                                //    }
                                //}
                        ]
                    }
                },
                { label: 'Vị trí', name: 'bw', width: 160, editwidth: '100%', align: "center", editable: true },
                {
                    label: 'Chuyển sang tự trả', name: 'iszzf', width: 80, editwidth: '100%', align: 'center', edittype: "select", editable: true, editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    $("#" + rowid + "_zzfbz").val($(this).val());
                                }
                            }
                        ]

                    }
                },
                { label: 'zzfbz', name: 'zzfbz', editwidth: '', align: 'center', editable: true, hidden: true },
                { label: '<span class="required">*</span>Tổng số lượng', name: 'zl', width: 80, editwidth: '100%', align: 'center', editable: true },
                { label: '<span class="required">*</span>Số tiền', name: 'je', width: 100, editwidth: '100%', align: 'center', editable: true },
                { label: 'Thao tác', name: 'action', width: 120, align: 'center' }
            ],
            editinputwidthborder: false,    //Có cần viền không mặc định làtrue
            editinputborderradius: false,   //Có cần bo góc viền không Mặc địnhtrue(có bo góc)
            pager: "#gridkfcfPager",
            loadComplete: function () {
                ////Tự động kích hoạt đơn thuốc mới
                //if (kflocaldata && kflocaldata.length == 0) {
                //    newRehPresData();
                //}
            },
            gridComplete: function () {
                EnableRehabInlineEditBox();
            }
        });

        //Menu cấp hai
        $gridkfcf.jqGrid('setGroupHeaders', {
            useColSpanStyle: true,
            groupHeaders: [
            {
                startColumnName: 'xmmc',
                numberOfColumns: 5,
                titleText: 'Thông tin cơ bản'
            }, {
                startColumnName: 'mczll',
                numberOfColumns: 5,
                titleText: 'Cách dùng hạng mục'
            }]
        });

        //Nút tùy chỉnh
        $gridkfcf
            .navGrid('#gridkfcfPager', { edit: false, add: false, del: false, search: false, refresh: false, view: false, position: "left", cloneToTop: false })
            .navButtonAdd('#gridkfcfPager', {
                buttonicon: "glyphicon glyphicon-remove",
                title: "Xóa chi tiết",
                caption: "Xóa chi tiết",
                position: "last",
                onClickButton: function () {
                    var selRowData = $("#gridkfcf").jqGrid('getRowData_AllLine', true);
                    if(selRowData.length == 0){
                        $.modalAlert("Chưa chọn bất kỳ chi tiết nào", 'warning');
                        return;
                    }
                    else{
                        $.each(selRowData, function () {   //1.Xóa dòng
                            deleteRehRowData(this.jqRowId, false);
                        });
                        CalculateRehabPresAmount();  //2.Tính số tiền của đơn thuốc
                    }
                },
            })
            .navSeparatorAdd("#gridkfcfPager", { sepclass: "ui-separator", sepcontent: '' })
            .navButtonAdd('#gridkfcfPager', {
                buttonicon: "glyphicon glyphicon-new-window",
                title: "Đơn thuốc mới",
                caption: "Đơn thuốc mới",
                position: "last",
                onClickButton: function () {
                    newRehPresData();
                },
            });
    }

    //Bật chỉnh sửa trong dòng
    function EnableRehabInlineEditBox(){
        var ids = $("#gridkfcf").getDataIDs();
        $.each(ids, function () {
            //Mở chế độ chỉnh sửa
            $("#gridkfcf").jqGrid('editRow', String(this), false, initRehabInlineFunc);

            //Đánh dấu màu đơn thuốc
            var cfh = $("#gridkfcf").getRowData(String(this)).cfh;
            var cfColor = getCfColor(@Html.Raw(((int)EnumCflx.RehabPres).ToString()),cfh);
            $('#gridkfcf tr[id="' +  String(this) + '"]').css('border-left-color',cfColor);
            $('#gridkfcf tr[id="' +  String(this) + '"]').css('border-left-style','solid');
            $('#gridkfcf tr[id="' +  String(this) + '"]').css('border-left-width','5px');

            CalculateRehabEachLineSlAndJe(String(this), false);
        });

        CalculateRehabPresAmount();  //Tính số tiền của đơn thuốc
    }

    //Khởi tạo Lớp nổi
    function initRehabInlineFunc(rowid) {
        //Một số cột chỉ đọc
        $("#" + rowid + "_dj").css('background-color','#f6f7fb').attr('readonly','true');
        $("#" + rowid + "_dw").css('background-color','#f6f7fb').attr('readonly','true');
        $("#" + rowid + "_pcmc").attr('readonly','true');
        $("#" + rowid + "_zl").css('background-color','#f6f7fb').attr('readonly','true');
        $("#" + rowid + "_je").css('background-color','#f6f7fb').attr('readonly','true');
        $("#" + rowid + "_xmmc").attr('autocomplete', 'off'); 
        $("#" + rowid + "_zxksmc").attr('autocomplete', 'off'); 
        $("#" + rowid + "_bw").parent().next().children('select').html('');
        $("#" + rowid + "_bw").parent().next().children('select').append('<option value="1">Có</option><option value="0">Không</option>');

        var iszzfval = $("#" + rowid + "_zzfbz").val();
        if (!!iszzfval) {
            $("#" + rowid + "_bw").parent().next().children('select').val(iszzfval).trigger("change");
        } else {
            $("#" + rowid + "_bw").parent().next().children('select').val(0).trigger("change");
        }

        var currlineCfh = $("#gridkfcf").getRowData(rowid).cfh;
        //Lớp nổi hạng mục
        $("#" + rowid + "_xmmc").sfxmFloatingSelector({
            djDecimalPlaces: 4,
            searchType : 'sfxm.dwjls',
            ajaxparameters: function ($thisinput) {
                var flag = false;
                //Nếu là thuốc bị hạn chế,flag=true
                if (window.currPatientInfo.brxzCode != "" &&'@ViewBag.ControlbrxzCode'.indexOf(window.currPatientInfo.brxzCode) > -1) {
                    flag = true;
                };
                return "onlyybflag=" + flag + "&mzzybz=1&dllb=2&sfdllx=Rehab&keyword=" + $.trim($thisinput.val());
            },
            itemdbclickhandler: function ($this) {
                //Kiểm tra trùng lặp
                var isRepeatedAdd = false;
                var addxmCode = $this.attr('data-sfxmCode');
                $.each($("#gridkfcf").getDataIDs(), function () {
                    var cfh = $("#gridkfcf").getRowData(String(this)).cfh;
                    var xmCode = $('#' + $($("#gridkfcf").getRowData(String(this)).xmCode).attr('id')).val();
                    if (addxmCode == xmCode && String(this) != rowid && cfh == currlineCfh) {
                        isRepeatedAdd = true;
                        return;
                    }
                });
                if (isRepeatedAdd) {
                    $.modalAlert("Chi tiết trong một đơn thuốc không được trùng lặp", 'warning');
                    return;
                }

                $("#" + rowid + "_xmmc").val($this.attr('data-sfxmmc'))
                $("#" + rowid + "_xmCode").val($this.attr('data-sfxmCode'))
                $("#" + rowid + "_dwjls").val($this.attr('data-dwjls'))
                $("#" + rowid + "_jjcl").val($this.attr('data-jjcl'));
                $("#" + rowid + "_dj").val($this.attr('data-dj'));
                $("#" + rowid + "_dw").val($this.attr('data-dw'));
                $("#" + rowid + "_zxks").val($this.attr('data-zxks'));
                $("#" + rowid + "_zxksmc").val($this.attr('data-zxksmc'));
                //Khởi tạo thành1
                $("#" + rowid + "_mczll").val($this.attr('data-dwjls'));
                $("#" + rowid + "_sl").val(1);
                $("#" + rowid + "_xmmc").css('background-color','#f6f7fb').attr('readonly','true');
                CalculateRehabEachLineSlAndJe(rowid);   //Tính toán Tổng số lượng chi tiết, tổng số tiền chi tiết và số tiền đơn thuốc
            },
        });
        //Lớp nổi khoa thực hiện
        //$("#" + rowid + "_zxksmc").ksFloatingSelector({
        //    itemdbclickhandler: function ($this) {
        //        $("#" + rowid + "_zxks").val($this.attr('data-Code'))
        //        $("#" + rowid + "_zxksmc").val($this.attr('data-Name'))
        //    },
        //});
        $("#" + rowid + "_zxksmc").newtouchBatchFloatingSelector({
            height: 170,
            width: 300,
            caption: "Chọn khoa",
            url: '/Prescription/GetSfxmZxksSelectJson',
            clickautotrigger: true,
            ajaxparameters: function ($thisinput) {
                return 'sfxmCode=' + $("#" + rowid + "_xmCode").val() + "&keyword=" + $thisinput.val();
            },
            colModel: [
                { label: 'Số hiệu', name: 'Code', widthratio: 40 },
                { label: 'Tên', name: 'Name', widthratio: 60 },
                { label: 'Phiên âm', name: 'py', hidden: true }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#" + rowid + "_zxks").val($thistr.find("td:eq(0)").html());
                $("#" + rowid + "_zxksmc").val($thistr.find('td:eq(1)').html());
                return;
            },
        });
        //Lớp nổi tần suất
        $("#" + rowid + "_pcmc").pcFloatingSelector({
            showtext: 'yzpcmc',
            attrcols: ['yzpcmc', 'yzpcCode', 'zxcs', 'zxzq', 'zxzqdw'],
            checkItemActivity: checkItemActivity,
            itemdbclickhandler: function ($this) {
                $("#" + rowid + "_pcmc").val($this.attr('data-yzpcmc'));
                $("#" + rowid + "_pcCode").val($this.attr('data-yzpcCode'));
            },
        });

        //Lớp nổi vị trí
        $("#" + rowid + "_bw").bwFloatingSelector({
            showtext: 'bwmc',
            attrcols: ['bwmc', 'bwCode'],
            checkItemActivity: checkItemActivity,
            itemdbclickhandler: function ($this) {
                var mcval = "";
                if (typeof ($this) !== "undefined") {
                    $.each($this, function () {
                        mcval += this.attr('data-bwmc') + ",";

                    });
                    if (mcval.length > 0) {
                        mcval = mcval.substring(0, mcval.length - 1);
                    };
                }
                $("#" + rowid + "_bw").val(mcval);
            },
        });
    }

    //Tính số lượng và số tiền trong chi tiết
    function CalculateRehabEachLineSlAndJe(rowid, recalc) {
        var obj = new Object();

        obj.currRowZl = 0;  //Giá trị ban đầu   //Tổng số lượng tính phí
        obj.currRowZe = 0.00;  //Giá trị ban đầu

        var currRowZll = $('#' + rowid + '_mczll').val();
        var currRowDwjls = $('#' + rowid + '_dwjls').val();
        var currRowSl = $('#' + rowid + '_sl').val();

        var currRowDj = $('#' + rowid + '_dj').val();

        if (parseFloat(currRowZll) > 0 && parseFloat(currRowDwjls) > 0 && parseFloat(currRowSl) > 0) {
            //Liều lượng điều trị Số lượng tính theo đơn vị Số lượng không trống
            if(parseInt(currRowZll) < parseInt(currRowDwjls)){
                $.modalAlert('Liều lượng mỗi lần điều trị không được nhỏ hơn số lượng đo của đơn vị', 'error');
                $('#' + rowid + '_mczll').val('');
                return;
            }
            obj.currRowZl = parseInt(parseInt(currRowZll) / parseInt(currRowDwjls)) * parseFloat(currRowSl);
        }
        if (obj.currRowZl && obj.currRowZl > 0 && currRowDj) {
            obj.currRowZe = roundingBy4she6ru5chengshuang(parseFloat(obj.currRowZl) * parseFloat(currRowDj),2);
        }

        $('#' + rowid + '_zl').val(obj.currRowZl);  //Gán giá trị
        $('#' + rowid + '_je').val(obj.currRowZe)   //Gán giá trị

        if(!(recalc === false)){
            CalculateRehabPresAmount()  //Tính số tiền đơn thuốc
        }
    }

    //Tính số tiền đơn thuốc
    function CalculateRehabPresAmount() {
        var presClassificationArr = new Array();   //Phân loại đơn thuốc
        var allData = $("#gridkfcf").jqGrid('getRowData_AllLine', null, true);
        $.each(allData, function () {
            var cfh = this.cfh;
            var rowid = this.jqRowId;

            var xmmc = $("#" + rowid + "_xmmc").val();
            var mczll = $("#" + rowid + "_mczll").val();
            var dwjls = $("#" + rowid + "_dwjls").val();
            var sl = $("#" + rowid + "_sl").val();
            var dj = $("#" + rowid + "_dj").val();

            if (!xmmc && !mczll && !dwjls && !sl && !dj) {
                return;
            }
            var cfje = roundingBy4she6ru5chengshuang(((parseFloat($.undefinedwith0(mczll)) / parseFloat($.undefinedwith0(dwjls))) * parseFloat($.undefinedwith0(sl)) * parseFloat($.undefinedwith0(dj))), 2);   //Tính số tiền của đơn thuốc này

            var existPres = $.jsonWhere(presClassificationArr, function (v) {
                return v && v.cfh == cfh;    //Đơn thuốc giống nhau Đặt vào một mảng  Số đơn thuốc làkey Số tiền làvalue
            });
            if (existPres && existPres.length == 1) {       //Số đơn thuốc đã tồn tại
                existPres[0].cfje = roundingBy4she6ru5chengshuang((parseFloat(existPres[0].cfje) + parseFloat(cfje)), 2);
            } else {
                presClassificationArr.push({ cfh: cfh, cfje: cfje });    //Số đơn thuốc mới
            }
        });

        var totalAmount = 0.00;
        //Nốihtml
        $('#tableRehabPresAmount').html('');   //Xóa trước
        for (var i = 0; i < presClassificationArr.length; i++) {
            totalAmount = roundingBy4she6ru5chengshuang((parseFloat(totalAmount) + parseFloat(presClassificationArr[i].cfje)), 2);  //Tính tổng số tiền
            $('#tableRehabPresAmount').append('<tr><th class="formTitle">Số đơn thuốc:</th><td class="formValue"><label style="color:red;">' + presClassificationArr[i].cfh + '</label></td><th class="formTitle">Số tiền:</th><td class="formValue"><label style="color:red;">￥' + presClassificationArr[i].cfje + '</label></td></tr>');
        }
        $('#tdRehabTotalAmount').html('');  //Xóa trước
        $('#tdRehabTotalAmount').append('<label style="color:red;">￥' + totalAmount + '</label>');
    }


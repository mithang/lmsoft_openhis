<div class="dv-body">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>

        <table class="form" style="width:95%">
            <tbody>
                <tr>
                    <th class="formTitle">Ngày tra cứu:</th>
                    <td class="formValue" colspan="2">
                        <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; float:left;" value="@DateTime.Now.AddDays(-2).ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                        <span style="margin-left:1%;float:left">—</span>
                        <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:43%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                    </td>
                    <th class="formTitle">Họ tên/Số khám ngoại trú:</th>
                    <td class="formValue">
                        <input id="keyword" type="text" class="form-control">
                    </td>
                    <td class="formValue">
                        <a id="btn_refresh" class="btn btn-primary" onclick="RefreshOrder()" style="width:80px;">
                            <i class="fa fa-refresh"></i>Tra cứu
                        </a>
                    </td>
                    <td class="formValue">
                        <a id="btn_input" class="btn btn-primary" onclick="InputResult()" style="width:80px;">
                            <i class="fa fa-pencil-square-o"></i>LạiThực hiện
                        </a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>


    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>

</div>

<script type="text/javascript">
    $(".dv-body").height($(window).height());
    $(".dv-body").width($(window).width());
    $(function() {
        $(window).resize(function () {//Khi thay đổi kích thước cửa sổ trình duyệt, tính lại rộng cao
            $(".dv-body").height($(window).height());
        });
        

        gridList();
    });

    function RefreshOrder() {

        var keyword = $("#keyword").val();
        var kssj = $("#kssj").val();
        var jssj = $("#jssj").val();
        $('#gridList').jqGrid('setGridParam', {
            postData: {
                keyword: keyword, kssj: kssj, jssj: jssj
            }
        }).trigger("reloadGrid");
    }

    function gridList() {
        var $gridList = $("#gridList");
        var keyword = $("#keyword").val();
        var kssj = $("#kssj").val();
        var jssj = $("#jssj").val();
        $gridList.dataGrid({
            postData: { keyword: keyword, kssj: kssj, jssj: jssj },
            url: "/OutpatientNurse/skintesfrom",
            height: $(window).height() - 130,
            shrinkToFit: true,   //true:theo tỷ lệVDkhởi tạo độ rộng cột false:Sử dụngcolModelđộ rộng đã chỉ định
            autowidth: true,
            colModel: [
                { label: 'gmxxid', name: 'gmxxid', align: 'center', hidden: true, key: true  },
                { label: 'Đơn thuốcChi tiếtID', name: 'cfmxId', align: 'center', hidden: true},
                { label: 'Số khám ngoại trú', name: 'mzh', align: 'center', width: 100 },
                { label: 'blh', name: 'blh', align: 'center', hidden: true },
                { label: 'Tên bệnh nhân', name: 'xm', align: 'center', width: 60 },
                { label: 'Giới tính', name: 'xb', align: 'left', width: 30 },
                { label: 'Số đơn thuốc', name: 'cfh', align: 'center', width: 100, formatter: function (val) { if (val != null) return val; else return ""; } },
                { label: 'Thời gian bắt đầu', name: 'kssj', align: 'center', width: 100, formatter: function (val) { return $.getTime({ date: val }); } },
                { label: 'Giá trị kết quả', name: 'lrjg', align: 'center', width: 50, formatter: function (val) { if ((val == "阳性" || val == "Dương tính")) return "<span style='color:red;'>" + val + "</span>"; else return val; } },
                { label: 'Nội dung đơn thuốc', name: 'cfmxnr', align: 'center', width: 180 },
                { label: 'Người nhập', name: 'CreatorName', align: 'center', width: 50 },
                { label: 'NhậpThời gian', name: 'CreateTime', align: 'center', width: 100, formatter: function (val) { return $.getTime({ date: val }); } },
                { label: 'Người cập nhật', name: 'LastModifierName', align: 'center', width: 50 },
                { label: 'Thời gian cập nhật', name: 'LastModifyTime', align: 'center', width: 100, formatter: function (val) { return val!=null? $.getTime({ date: val }):""; } },
                { label: 'ypcode', name: 'ypcode', align: 'center', hidden: true },
                { label: 'cancel', name: 'iscancel', align: 'center', hidden: true },
                { label: 'Thực hiệnTrạng thái', name: 'cancel', align: 'center', width: 50, formatter: function (val) { return val == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
                { label: 'Thao tác', name: 'action', align: 'center', width: 40, formatter: function (val) { return "<input class='btn btn-default btn-md btn_add' type='button' value='HủyThực hiện' onclick='cancelRow($(this).parent().parent().attr(\"id\"))'/>";} },
            ],
            pager: "#gridPager",
            sortname: 'CreateTime Desc',
            viewrecords: true,
            multiselect: true,
            //onSelectRow: function (rowIndex, s) {
            //    InputResult();
            //} 
        });
    }
    //HủyThực hiện
    function cancelRow(rowid) {
        var rowData = $("#gridList").jqGrid('getRowData', rowid);
        if (rowData==null) {
            $.modalMsg("Không tìm thấy dòng hiện tại", 'error');
        }
        $.ajax({
            url: "/OutpatientNurse/skintescancel",
            dataType: "json",
            data: { "gmxxid": rowData.gmxxid },
            type: "post",
            success: function (data) {
                RefreshOrder();
                if (!!data && data.state == "success") {
                    $.modalMsg('Test daHủyThực hiệnthành công', 'success');
                }
                else if (!!data && data.state == "error") {
                    $.modalMsg(data.message, 'error');
                }

            }
        });
    }
    //Test dalại lầnThực hiện
    function InputResult() {
        var selRowIds = jQuery("#gridList").jqGrid("getGridParam", "selarrrow");
        if (selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn mục chờ thực hiện", 'warning');
            return;
        }
        var cfmxid = "";
        for (var i = 0; i < selRowIds.length; i++) {
            var rowData = $("#gridList").jqGrid('getRowData', selRowIds[i]);
            if (rowData.iscancel == "1") {
                $.modalAlert("Trong các mục thực hiện đã chọn có mục chưa hủy thực hiện, hãy hủy thực hiện trước!", 'warning');
                return false;
            }
            if (cfmxid == "") {
                cfmxid = rowData.cfmxId;
            }
            else {
                cfmxid += "," + rowData.cfmxId;
            }
        }
        $.modalOpen({
            id: "InpatientVitalSignsForm",
            title: "Test daNhập",
            url: "/NurseManage/OrderAudit/Inputresults",
            width: "400px",
            height: "200px",
            leftlalbelchecked: true,
            leftlalbelcheckedasClose: false,
            callBack: function (iframeId) {
                top.frames[iframeId].AcceptClick(function (patData) {
                    $.ajax({
                        url: "/OutpatientNurse/EnteragainMuti",
                        dataType: "json",
                        data: { "cfmxid": cfmxid, "lrjg": patData },
                        type: "post",
                        success: function (data) {
                            RefreshOrder();
                            if (!!data && data.state == "success") {
                                $.modalMsg('Test daThực hiệnthành công', 'success');
                            }
                            else if (!!data && data.state == "error") {
                                $.modalMsg(data.message, 'error');
                            }

                        }
                    });
                });
            }
        });
    }

</script>
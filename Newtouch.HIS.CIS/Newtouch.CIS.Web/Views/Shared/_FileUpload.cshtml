
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Tải lên hình ảnh tài liệu</title>
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/css/framework-theme.css")" rel="stylesheet" id="color-skin" />

    @*<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">*@
    <link href="~/Content/css/bootstrap5.min.css.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    @*<link href="~/Content/css/all.min.css" rel="stylesheet" />*@
    
    <link href="@MvcHelper.GetStaticResourceScriptUrl("~/css/framework-font.css")" rel="stylesheet" />
    @Html.Partial("_FrontReference")
    <script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/framework-ui.js")"></script>
    @* RS-N01 (họ T-02, CIS): layout này nạp framework-ui nhưng chưa từng nạp
       cis-vi.js, nên $.modalAlert ở trang ApplyFormUpload (nhánh lỗi xóa báo
       cáo) nem "top.layer is undefined" khi không có layer (không trang CIS
       nào nạp layer.js). Nạp cis-vi.js ngay sau framework-ui theo đúng mẫu
       _Index/_Form: có layer thì ủy thác về bản gốc, không có thì fallback. *@
    <script src="/js/cis-vi.js"></script>
</head>
<body>
    <div class="container1">
        @RenderBody()
    </div>
    @*<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>*@
    <script src="~/Content/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@{
    ViewBag.Title = "Thực hiện tiêm";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    #btn_search {
        width: 45px;
        font-weight: bolder;
    }
</style>
<div class="panel panel-default">
    <div class="panel-heading navb-bg">
        Điều kiện lọc
    </div>
    <table class="form">
        <tr>
            <td class="formTitle">Số thẻ:</td>
            <td class="formValue">
                <input type="text" class="form-control" id="txtkh" placeholder="Số thẻ" />
            </td>
            <td class="formTitle">Số hóa đơn:</td>
            <td class="formValue">
                <input type="text" class="form-control" id="txtfph" placeholder="Số hóa đơn" />
            </td>
            <td class="formTitle"><span style="color:#ff0000;">*</span>Thời gian thu phí:</td>
            <td class="formValue">
                <input id="txtsfkssj" type="text" class="form-control input-wdatepicker" style="width:90%; float:left;" onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" value="@DateTime.Now.ToString("yyyy-MM-dd")">
            </td>
            <td class="formTitle" style="width:10px">đến</td>
            <td class="formValue">
                <input id="txtsfjssj" type="text" class="form-control input-wdatepicker" style="width:90%; float:left;" onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")">
            </td>
            <td class="formValue">
                <input type="button" class="btn btn-primary btn-md" id="btn_search" value="Tra cứu" />
                <input type="button" class="btn btn-primary btn-md" id="btn_sync" value="Đồng bộ đơn thuốc" />
            </td>
        </tr>
    </table>
</div>
<div class="gridPanel" style="width: 28%;float:left;">
    <table id="gridPatList"></table>
    <div id="gridPatPager" rel="form1"></div>
</div>
<div class="gridPanel" style="margin-left:0.5%;width:71.5%;float:left;">
    <table id="gridRpList"></table>
    <div id="gridRpPager" rel="form1"></div>
</div>
<div style="margin-left:0.5%;">
    <table class="form" style="width:200px;float: left;">
        <tr>
            <td class="formTitle">Số ghế/Số giường:</td>
            <td class="formValue">
                <input id="txtSeatNum" name="txtSeatNum" type="text" class="form-control" placeholder="Số ghế/Số giường" value="" />
            </td>
        </tr>
    </table>
    @Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
    {
        ShowKeyList = new[] { 6, 7, 8, 9, 10 },
        F6Text= "成组",
        F7Text = "执行",
        F8Text = "输液开始",
        F9Text = "输液结束",
        F10Text = "打印"
    })
</div>
@Html.Partial("_PrintCommonView")
<script>
    var $gridList = $("#gridPatList");
    var $gridMxList = $("#gridRpList");
    var currentKh = "";
    $(".toolbar").width(400);
    $(function () {
        //Khi thay đổi kích thước cửa sổ trình duyệt thì tải lạijqGridchiều rộng của
        $(window).resize(function () {

        });
        Initial();
        //Đồng bộ
        $("#btn_sync").click(function () {
            $.najax({
                url: "@Url.Action("SyncSettRpDetail")",
                data: getGridPatPar(),
                dataType: "json",
                type: "Get",
                success: function (data) {
                    if (data != null && data.state === "success") {
                        $("#btn_search").trigger("click");
                    }
                }
            });
        });
        $("#btn_search").click(function () {
            currentKh = "";
            if ($("#txtsfkssj").val() === "" || $("#txtsfjssj").val() === "") {
                $.modalMsg("Thời gian thu phí không được trống", "warning");
                return;
            }
            $gridMxList.jqGrid("clearGridData");
            $gridList.jqGrid('setGridParam',
            {
                url: "/NurseManage/Infusion/PatientListQuery",
                postData: getGridPatPar(),
                }).trigger('reloadGrid');
        });
    });

    //Liên kết sự kiện Enter
    $(window).keyup(function (event) {
        if (event.keyCode == 13) {
            $("#btn_search").trigger("click");
        }
    });

    //Khởi tạo
    function Initial() {
        gridList();
    }

    //Lắp ráp điều kiện tra cứu thông tin bệnh nhân
    function getGridPatPar() {
        return { kh: $("#txtkh").val(), fph: $("#txtfph").val(), kssj: $("#txtsfkssj").val(), jssj: $("#txtsfjssj").val() }
    }

    //Thông tin bảng chính
    function gridList() {
        //Thông tin bệnh nhân
        $gridList.dataGrid({
            url: "/NurseManage/Infusion/PatientListQuery",
            postData: getGridPatPar(),
            height: $(window).height() - document.getElementById('gridPatList').offsetTop - 70,
            colModel: [
                { label: 'Họ tên', name: 'xm', width: 80, align: 'center' },
                { label: 'Số thẻ', name: 'kh', width: 100, align: 'center' }
            ],
            pager: "#gridPatPager",
            rowNum: '25',
            sortname: 'xm',
            ondblClickRow: function (rowid, iRow, iCol, e) {
                var rowData = $gridList.jqGrid('getRowData', rowid);
                currentKh = rowData.kh;
                $gridMxList.jqGrid('setGridParam',
                    {
                        url:"@Url.Action("MzsyypxxQury")",
                        postData: { kh: rowData.kh}
                    }).trigger('reloadGrid');
            }
        });
        //Thông tin thuốc truyền dịch
        $gridMxList.dataGrid({
            url: "",
            height: $(window).height() - document.getElementById('gridRpList').offsetTop - 120,
            multiselect: true,
            colModel: [
                { label: 'Id', name: 'Id', key: true, hidden: true },
                { label: 'Nhóm', name: 'groupNo', width: 30, align: 'center' },
                { label: 'Giường/Số ghế', name: 'seatNum', width: 50, align: 'center' },
                { label: 'Thời gian thu phí', name: 'sfsj', width: 115, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }},
                { label: 'Số đơn thuốc', name: 'cfh', width: 110, align: 'center' },
                { label: 'Tên thuốc', name: 'ypmc', width: 100, align: 'left' },
                { label: 'Quy cách', name: 'ypgg', width: 50, align: 'left' },
                { label: 'Lượng dùng', name: 'ylStr', width: 50, align: 'right' },
                { label: 'Số lượng', name: 'slStr', width: 50, align: 'right' },
                { label: 'Liều lượng', name: 'jlStr', width: 50, align: 'right' },
                { label: 'Bắt đầu truyền dịch', name: 'sykssj', width: 115, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }},
                { label: 'Kết thúc truyền dịch', name: 'syjssj', width: 115, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Dược sĩ pha thuốc', name: 'dispenserName', width: 50, align: 'left' },
                { label: 'Người thực hiện', name: 'executorName', width: 50, align: 'left' },
                { label: 'Ghi chú', name: 'remark', width: 100, align: 'left' }
            ],
            pager: "#gridRpPager",
            rowNum: '25',
            sortname: 'groupNo',
            viewrecords: true
        });
    }

    //Lấy mục đã chọncheckboxcủaID
    function getCheckedIds() {
        var allChk = $("#gridRpList input[type=checkbox]:checked");
        if (allChk.length == 0) return null;
        var ids = [];
        $.each(allChk, function (index, item) {
            ids.push($(item).parent().parent().parent()[0].id);
        });
        return ids;
    }

    //Nhóm
    function newtouch_event_f6() {
        if (currentKh === "") {
            $.modalMsg("Vui lòng chọn bệnh nhân", "warning");
            return;
        }
        var ids = getCheckedIds();
        if (ids == null || ids.length <= 0) {
            $.modalMsg("Vui lòng chọn thuốc cần nhóm", "warning");
            return;
        }
        $.najax({
            url: "@Url.Action("Grouping")",
            data: { tags: ids, kh: currentKh },
            dataType: "json",
            type: "Post",
            success: function (data) {
                if (data != null && data.state === "success") {
                    $gridMxList.jqGrid('setGridParam',
                    {
                        url: "@Url.Action("MzsyypxxQury")",
                        postData: { kh: currentKh }
                    }).trigger('reloadGrid');
                }
            }
        });
    }

    //Thực hiện
    function newtouch_event_f7() {
        if (currentKh === "") {
            $.modalMsg("Vui lòng chọn bệnh nhân", "warning");
            return;
        }
        var ids = getCheckedIds();
        if (ids == null || ids.length <= 0) {
            $.modalMsg("Vui lòng chọn thuốc cần thực hiện", "warning");
            return;
        }
        var keyValue = "";
        for (var i = 0; i < ids.length; i++) {
            keyValue += ids[i] + ",";
        }
        $.modalOpen({
            id: "Form",
            title: "Thực hiện truyền dịch",
            url: "/NurseManage/Infusion/InjectionForm?keyValue=" + keyValue,
            width: "500px",
            height: "400px",
            callBack: function (iframeId, isClose) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $gridMxList.jqGrid('setGridParam',
                    {
                        url: "@Url.Action("MzsyypxxQury")",
                        postData: { kh: currentKh }
                    }).trigger('reloadGrid');
                });
            }
        });
    }

    //Bắt đầu truyền dịch
    function newtouch_event_f8() {
        if (currentKh === "") {
            $.modalMsg("Vui lòng chọn bệnh nhân", "warning");
            return;
        }
        var ids = getCheckedIds();
        if (ids == null || ids.length <= 0) {
            $.modalMsg("Vui lòng chọn thuốc cần bắt đầu truyền dịch", "warning");
            return;
        }
        $.najax({
            url: "@Url.Action("StartInfusion")",
            data: { tags: ids, seatNum: $("#txtSeatNum").val() },
            dataType: "json",
            type: "Post",
            success: function (data) {
                if (data != null && data.state === "success") {
                    $gridMxList.jqGrid('setGridParam',
                    {
                        url: "@Url.Action("MzsyypxxQury")",
                        postData: { kh: currentKh }
                    }).trigger('reloadGrid');
                }
            }
        });
    }

    //Kết thúc truyền dịch
    function newtouch_event_f9() {
        if (currentKh === "") {
            $.modalMsg("Vui lòng chọn bệnh nhân", "warning");
            return;
        }
        var ids = getCheckedIds();
        if (ids == null || ids.length <= 0) {
            $.modalMsg("Vui lòng chọn thuốc cần kết thúc truyền dịch", "warning");
            return;
        }
        $.najax({
            url: "@Url.Action("EndInfusion")",
            data: { tags: ids },
            dataType: "json",
            type: "Post",
            success: function (data) {
                if (data != null && data.state === "success") {
                    $gridMxList.jqGrid('setGridParam',
                    {
                        url: "@Url.Action("MzsyypxxQury")",
                        postData: { kh: currentKh }
                    }).trigger('reloadGrid');
                }
            }
        });
    }

    //In
    function newtouch_event_f10() {
        if (currentKh === "") {
            $.modalMsg("Vui lòng chọn bệnh nhân", "warning");
            return;
        }
        var ids = getCheckedIds();
        if (ids == null || ids.length <= 0) {
            $.modalMsg("Vui lòng chọn thuốc truyền dịch cần in", "warning");
            return;
        }
        var tmpIds = "";
        for (var i = 0; i < ids.length; i++) {
            tmpIds += ids[i] + ",";
        }
        $.loading(true, 'Dữ liệu đang được tra cứu, vui lòng đợi...');
        $.ajax({
            url: "@Url.Action("PrintBottleLabel")",
            type: 'get',
            data: { tags: tmpIds },
            async: true,
            cache: false,
            success: function (res) {
                if (!!res) {
                    webPrint.PrintHtml(res);
                }
                else {
                    $.modalAlert('Tải dữ liệu nội dung in thất bại', 'error');
                    return;
                }
            },
            complete: function () {
                $.loading(false);
            }
        });
    }
</script>

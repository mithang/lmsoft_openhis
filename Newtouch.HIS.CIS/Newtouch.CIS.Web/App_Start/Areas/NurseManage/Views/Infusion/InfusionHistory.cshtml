@{
    ViewBag.Title = "Tra cứu lịch sử truyền dịch";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    #btn_search {
        width: 45px;
        font-weight: bolder;
    }
</style>
<div class="panel panel-default">
    <div class="panel-heading navb-bg">
        Điều kiện lọc
    </div>
    <table class="form">
        <tr>
            <td class="formTitle">Số thẻ:</td>
            <td class="formValue">
                <input type="text" class="form-control" id="txtkh" placeholder="Số thẻ" />
            </td>
            <td class="formTitle">Số hóa đơn:</td>
            <td class="formValue">
                <input type="text" class="form-control" id="txtfph" placeholder="Số hóa đơn" />
            </td>
            <td class="formTitle"><span style="color:#ff0000;">*</span>Thời gian thu phí:</td>
            <td class="formValue">
                <input id="txtsfkssj" type="text" class="form-control input-wdatepicker" style="width:90%; float:left;" onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" value="@DateTime.Now.ToString("yyyy-MM-dd")">
            </td>
            <td class="formTitle" style="width:10px">đến</td>
            <td class="formValue">
                <input id="txtsfjssj" type="text" class="form-control input-wdatepicker" style="width:90%; float:left;" onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")">
            </td>
            <td class="formValue">
                <input type="button" class="btn btn-primary btn-md" id="btn_search" value="Tra cứu" />
            </td>
        </tr>
    </table>
</div>
<div class="gridPanel" style="width: 28%;float:left;">
    <table id="gridPatList"></table>
    <div id="gridPatPager" rel="form1"></div>
</div>
<div class="gridPanel" style="margin-left:0.5%;width:71.5%;float:left;">
    <table id="gridRpList"></table>
    <div id="gridRpPager" rel="form1"></div>
</div>
<script>
    var $gridList = $("#gridPatList");
    var $gridMxList = $("#gridRpList");
    var currentKh = "";
    $(function () {
        //Khi thay đổi kích thước cửa sổ trình duyệt thì tải lạijqGridchiều rộng của
        $(window).resize(function () {

        });
        Initial();
        $("#btn_search").click(function () {
            currentKh = "";
            if ($("#txtsfkssj").val() === "" || $("#txtsfjssj").val() === "") {
                $.modalMsg("Thời gian thu phí không được trống", "warning");
                return;
            }
            $gridMxList.jqGrid("clearGridData");
            $gridList.jqGrid('setGridParam',
            {
                url: "/NurseManage/Infusion/PatientListQuery",
                postData: getGridPatPar(),
            }).trigger('reloadGrid');
        });
        $("#btn_search").trigger("click");
    });

    //Liên kết sự kiện Enter
    $(window).keyup(function (event) {
        if (event.keyCode == 13) {
            $("#btn_search").trigger("click");
        }
    });

    //Khởi tạo
    function Initial() {
        gridList();
    }

    //Lắp ráp điều kiện tra cứu thông tin bệnh nhân
    function getGridPatPar() {
        return { kh: $("#txtkh").val(), fph: $("#txtfph").val(), kssj: $("#txtsfkssj").val(), jssj: $("#txtsfjssj").val() }
    }

    //Thông tin bảng chính
    function gridList() {
        //Thông tin bệnh nhân
        $gridList.dataGrid({
            url: "/NurseManage/Infusion/PatientHistoryListQuery",
            postData: getGridPatPar(),
            height: $(window).height() - document.getElementById('gridPatList').offsetTop - 70,
            colModel: [
                { label: 'Họ tên', name: 'xm', width: 80, align: 'center' },
                { label: 'Số thẻ', name: 'kh', width: 100, align: 'center' }
            ],
            pager: "#gridPatPager",
            rowNum: '25',
            sortname: 'xm',
            ondblClickRow: function (rowid, iRow, iCol, e) {
                var rowData = $gridList.jqGrid('getRowData', rowid);
                currentKh = rowData.kh;
                $gridMxList.jqGrid('setGridParam',
                    {
                        url:"@Url.Action("HistoryMzsyypxxQury")",
                        postData: { kh: rowData.kh}
                    }).trigger('reloadGrid');
            }
        });
        //Thông tin thuốc truyền dịch
        $gridMxList.dataGrid({
            url: "",
            height: $(window).height() - document.getElementById('gridRpList').offsetTop - 70,
            multiselect: true,
            colModel: [
                { label: 'Id', name: 'Id', key: true, hidden: true },
                { label: 'Nhóm', name: 'groupNo', width: 30, align: 'center' },
                { label: 'Thời gian thu phí', name: 'sfsj', width: 115, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }},
                { label: 'Số đơn thuốc', name: 'cfh', width: 110, align: 'center' },
                { label: 'Tên thuốc', name: 'ypmc', width: 100, align: 'left' },
                { label: 'Quy cách', name: 'ypgg', width: 50, align: 'left' },
                { label: 'Lượng dùng', name: 'ylStr', width: 50, align: 'right' },
                { label: 'Số lượng', name: 'slStr', width: 50, align: 'right' },
                { label: 'Liều lượng', name: 'jlStr', width: 50, align: 'right' },
                { label: 'Bắt đầu truyền dịch', name: 'sykssj', width: 115, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }},
                { label: 'Kết thúc truyền dịch', name: 'syjssj', width: 115, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } }
            ],
            pager: "#gridRpPager",
            rowNum: '25',
            sortname: 'groupNo',
            viewrecords: true
        });
    }
</script>

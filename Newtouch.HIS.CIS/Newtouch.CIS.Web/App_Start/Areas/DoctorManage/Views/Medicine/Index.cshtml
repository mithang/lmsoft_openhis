    function calMsl(rowid) {
        var tsStr = $("#" + rowid + "_ts").val();
        var jlzhxs = $("#" + rowid + "_jlzhxs").val();
        var zyzhxs = $("#" + rowid + "_zyzhxs").val();
        var ypjl = $("#" + rowid + "_ypjl").val();
        var dwlb = $("#" + rowid + "_dwlb").val();
        var zxcs = $("#" + rowid + "_zxcs").val();
        var zxzq = $("#" + rowid + "_zxzq").val();
        var zxzqdw = $("#" + rowid + "_zxzqdw").val();
        var qzfs = $("#" + rowid + "_qzfs").val();
        if (isNaN(jlzhxs) || jlzhxs == "") {
            //$.modalAlert("Thiếu hệ số chuyển đổi liều lượng", 'warning');
            return;
        } else if (isNaN(zyzhxs) || zyzhxs == "") {
            //$.modalAlert("Thiếu hệ số chuyển đổi nhập viện", 'warning');
            return;
        } else if (isNaN(ypjl) || ypjl == "") {
            //$.modalAlert("Thiếu liều lượng", 'warning');
            return;
        } else if (isNaN(dwlb) || dwlb == "") {
            //$.modalAlert("Thiếu loại đơn vị", 'warning');
            return;
        } else if (isNaN(zxcs) || zxcs == "") {
            //$.modalAlert("Thiếu số lần thực hiện", 'warning');
            return;
        } else if (isNaN(zxzq) || zxzq == "") {
            //$.modalAlert("Thiếu chu kỳ thực hiện", 'warning');
            return;
        } else if (isNaN(zxzqdw) || zxzqdw == "") {
            //$.modalAlert("Thiếu đơn vị chu kỳ thực hiện", 'warning');
            return;
        } else {
            var ts = 1;
            if (tsStr != undefined && tsStr !== "") ts = Number(Math.ceil(tsStr));
            var sl = 0;
            var yzlb = $("#" + rowid + "_yzlb").val();     //Loại y lệnh Dài hạn, tạm thời
            if (yzlb === "临") { //Y lệnh tạm thời
                sl = getypsl(jlzhxs, zyzhxs, ypjl, dwlb, zxcs, zxzq, zxzqdw, ts, qzfs);
            } else { //Y lệnh dài hạn
                sl = getypsl(jlzhxs, zyzhxs, ypjl, dwlb, zxcs, zxzq, zxzqdw, 1, qzfs);
            }
            //var sl = getypsl(jlzhxs, zyzhxs, ypjl, dwlb, zxcs, zxzq, zxzqdw, ts, qzfs);
            var kcsl = Number($("#" + rowid + "_kcsl").val());
            if (sl>kcsl) {
                $.modalAlert($("#" + rowid + "_xmmc").val() + "库存不足", 'warning');
                $("#" + rowid + "_ypjl").focus();
                return;
            }
            $("#" + rowid + "_sl").val(sl);
        }
    }

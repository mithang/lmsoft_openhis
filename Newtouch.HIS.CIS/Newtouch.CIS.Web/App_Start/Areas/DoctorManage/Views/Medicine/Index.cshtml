@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "Nhập thuốc";
    var IsQyKssKz = (ViewBag.IsQyKssKz as bool?) ?? false;
    var qxjb = ViewBag.qxjb;
}

<div id="linkyplr" role="tabpanel" class="tab-pane" style="width:98%;margin-right: 10px; border:solid 1px #ddd; margin-top: 3px;">
    <div style="background-color: #fff;" id="dv_gridmedicine">
        <table id="gridmedicine"></table>
        <div id="gridmedicinePager"></div>
    </div>
    <div class="toolbar" style="float:right;width:80%;margin:10px 30px 12px;text-align:right;">
        <a class="btn btn-primary" style="margin-left:4px;" onclick="ReviewToday()">Xem trong ngày</a>
        <a class="btn btn-primary" style="margin-left:4px;" onclick="SaveMedicineTemplate()">Lưu thành gói khác</a>
        <a class="btn btn-primary" style="margin-left:4px;" onclick="SaveDoctorService('1')">Lưu</a>
    </div>
</div>
<script>
    var localdata = [];//Đối tượng y lệnh thuốc
    var deldata = [];//Xóa đối tượng

    var ypyzflag = 0;
    var medicinelocaldata = new Array();
    function init_MedicinePrescription()
    {

        //Chỉ y lệnh chưa lưu vào cơ sở dữ liệu mới cần khởi tạo tronggridtrong
        medicinelocaldata = new Array();
        if (window.alldataArray.ypyz) {
            medicinelocaldata = $.jsonWhere($.deepClone.clone(window.alldataArray.ypyz), function (icf) {
                return !!!icf.Id;
            });
            $.each(medicinelocaldata, function () {
                if (!this.Id) {
                    $.modalAlert('Y lệnh bất thường',"warning");
                    location.href = location.href;
                }
                this.action = getMActionStr()
            });
        }
        else {
            window.alldataArray.ypyz = new Array(); //Để tiện sử dụng sau này$.each()
        }

        if (ypyzflag == 0) {   //Khởi tạo trang này
            gridmedicine();
            ypyzflag = 1;
        }

        else {
            $("#gridmedicine").clearGridData(); //Xóa trước
            //Mở lại trang này
            $("#gridmedicine").jqGrid('setGridParam', {
                datatype: 'local',
                data: medicinelocaldata
            }).trigger("reloadGrid");
        }
    }
    var IsQyKssKz = "@IsQyKssKz";//Có bật kiểm soát kháng sinh không
    var kssReasons = ":"; //Lấy lý do kháng sinh
    $.each($.itemDetails.getItems('kssReason'),
        function() {
            if (this.Code != undefined) {
                kssReasons += ";" + this.Code + ":" + this.Name;
            }
        });


    //Danh sách thuốc
    function gridmedicine() {
        var $gridmedicine = $("#gridmedicine");
        $gridmedicine.jqGrid({
            datatype: 'local',
            data: medicinelocaldata,
            height: $(window).height() - 200,
            shrinkToFit: true,   //true:Khởi tạo chiều rộng cột theo tỷ lệ false:Sử dụngcolModelchiều rộng đã chỉ định
            autowidth: true,
            rownumbers: true,  //Có hiển thị số thứ tự không
            editurl: "clientArray",  //Chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            unwritten: false,
            colModel: [
                { label: 'Id', name: 'Id', align: 'center', hidden: true },
                { label: 'Dài hạn<br>Tạm thời', name: 'yzlb', width: 35, editwidth: '100%', align: 'center', editable: true},
                {
                    label: 'Nhóm<br>số', name: 'zh', width: 35, editwidth: '100%', align: 'center', editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    MatchMZuhaoInfo(rowid, false);   //Cùng một số nhóm cần khớp cách dùng, tần suất, số ngày, ngày kết thúc

                                    var Id = $("#gridmedicine").getRowData(rowid).Id;
                                    var zh = $('#' + $($("#gridmedicine").getRowData(rowid).zh).attr('id')).val();
                                    var zhColor = getZhColor(zh);
                                    $('#gridmedicine tr[id="' + rowid + '"]').css('border-left-color', zhColor);
                                    $('#gridmedicine tr[id="' + rowid + '"]').css('border-left-style', 'solid');
                                    $('#gridmedicine tr[id="' + rowid + '"]').css('border-left-width', '5px');
                                }
                            }
                        ]
                    }, editable: true
                },
                {
                    label: '<span class="required">*</span>Tên', name: 'xmmc', width: 150, editwidth: '100%', align: 'center', editable: true
                },
                {
                    label: '<span class="required">*</span>Thời gian bắt đầu', name: 'kssj', width: 140, editwidth: '100%',
                    align: 'center',
                    editable: true, unformat: pickDate, formatter: "date",
                    formatoptions: { srcformat: 'Y-m-d h:m:s', newformat: 'Y-m-d h:m:s' },
                    formatter: function (cellvalue, options, cell) {
                        return (typeof (cellvalue) == "undefined") ? "" : cellvalue;
                    }
                },
                { label: 'xmdm', name: 'xmdm', width: 100, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: '<span class="required">*</span>Quy cách', width: 80,  name: 'ypgg', editwidth: '100%', align: 'center', editable: true },
                {
                    label: '<span class="required">*</span>Liều lượng', name: 'ypjl', width: 50, editwidth: '100%', align: 'center', editable: true, editoptions: {
                    dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var cellval = $(this).val();
                                    if(cellval.replace(/(^\s*)|(\s*$)/g, "") == ""){
                                        $.modalAlert("Liều lượng trống, vui lòng xác nhận.", 'warning');
                                        return;
                                    }
                                    if(isNaN(cellval)){
                                        $.modalAlert("Liều lượng: vui lòng nhập số", 'warning');
                                        $(this).val('')
                                        return;
                                    }
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    if(IsQyKssKz)
                                    {
                                        if($("#" + rowid + "_xmmc").val()=="")
                                        {
                                            $.modalAlert("Vui lòng chọn thuốc trước.", 'warning');
                                            $(this).val('')
                                            return;
                                        }
                                        if($("#" + rowid + "_jlfwbegin").val()!= "undefined" && parseFloat($("#" + rowid + "_jlfwbegin").val()) > parseFloat(cellval)){
                                            $.modalAlert("Liều lượng nhỏ hơn phạm vi tối thiểu của liều kháng sinh đơn lần, vui lòng xác nhận.", 'warning');
                                            $(this).val('')
                                            return;
                                        }
                                        if($("#" + rowid + "_jlfwend").val()!= "undefined" && parseFloat($("#" + rowid + "_jlfwend").val()) < parseFloat(cellval)){
                                            $.modalAlert("Liều lượng vượt quá phạm vi tối đa của liều kháng sinh đơn lần, vui lòng xác nhận.", 'warning');
                                            $(this).val('')
                                            return;
                                        }
                                    }

                                    calMsl(rowid);
                                }
                            }
                    ]
                }},
                {
                    label: '<span class="required">*</span>Đơn vị', name: 'dw', width: 50, editwidth: '100%', align: 'center', editable: true, edittype: "select", editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    $("#" + rowid + "_dwwwwwww").val($(this).find("option:selected").text());
                                    //Dùng để lưu mục đã chọndwgiá trị của
                                    $("#" + rowid + "_dwlb").val($(this).val());
                                    calMsl(rowid);
                                }
                            }
                        ]

                    }   //Lưu ý: đơn vị liều lượng phải nằm dưới liều lượng, vì phía dưới tìm đơn vị liều lượng dựa trên cơ quan này. (VìselectKhông cóidthuộc tính của)
                },
                { label: 'dwlb', name: 'dwlb', editwidth: '', align: 'center', editable: true, hidden: true },  //Không thể loại bỏ
                { label: 'redundant_jldw', name: 'redundant_jldw', editwidth: '', align: 'center', editable: true, hidden: true },  //Không thể loại bỏ
                { label: 'dwwwwwww', name: 'dwwwwwww', width: 40, editwidth: '', align: 'center', editable: true, hidden: true },  //Không thể loại bỏ
                {
                    label: '<span class="required">*</span>Cách dùng', name: 'yfmc', width: 70, editwidth: '100%', align: 'center', edittype: "select", editable: true, editoptions: {
                    dataEvents: [
                        {
                            type: 'change',
                            fn: function (e) {
                                var row = $(e.target).closest('tr.jqgrow');
                                var rowid = row.attr('id');
                                $("#" + rowid + "_ypyfdm").val($(this).val());
                                $("#" + rowid + "_yfmcval").val($(this).find("option:selected").text());
                                //Tốc độ truyền
                                if ($("#" + rowid + "_ypyfdm").val() === "@ViewBag.frequencyRelDroppingSpeed" ||
                                    $("#" + rowid + "_yfmcval").val() === "@ViewBag.frequencyRelDroppingSpeed") {
                                    $("#" + rowid + "_ds").show();
                                } else {
                                    $("#" + rowid + "_ds").hide();
                                }
                            }
                        }
                    ]
                }
                },
                { label: 'yfmcval', name: 'yfmcval', width: 75, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: 'ypyfdm', name: 'ypyfdm', width: 75, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: '<span class="required">*</span>Tần suất', name: 'pcmc', width: 55, editwidth: '100%', align: 'center', editable: true },
                { label: 'Tốc độ truyền<br>giọt/phút', name: 'ds', width: 55, editwidth: '100%', align: 'center', editable: true },
                { label: 'pcCode', name: 'pcCode', editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: 'Số ngày', name: 'ts', width: 45, editwidth: '100%', align: 'center', editable: true },
                { label: 'Tổng số lượng', name: 'sl', width: 45, editwidth: '100%', align: 'center', editable: true},
                { label: 'Nhà thuốc<br>Đơn vị', name: 'zydw', width: 45, editwidth: '100%', align: 'center', editable: true },
                { label: 'zxcs', name: 'zxcs', editable: true, hidden: true },
                { label: 'zxzq', name: 'zxzq',editable: true,hidden: true },
                { label: 'zxzqdw', name: 'zxzqdw', editable: true, hidden: true },
                {
                    label: '<span class="required">*</span>Tự chuẩn bị', name: 'zbbz', width: 50, editwidth: '100%', align: 'center', editable: true, edittype: "select", editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    $("#" + rowid + "_zbbzzzzzzz").val($(this).val());
                                }
                            }
                        ]

                    }
                },
                { label: 'zbbzzzzzzz', name: 'zbbzzzzzzz', width: 40, editwidth: '', align: 'center', editable: true, hidden: true },  //Không thể loại bỏ
                { label: 'Dặn dò', name: 'ztnr', width: 90, editwidth: '100%', align: 'center', editable: true },
                {
                    label: 'Kháng sinh<br>Lý do', name: 'kssReason', width: 80, editwidth: '100%', align: 'center', edittype: "select", editable: true, editoptions: { value: kssReasons,
                    dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    //if($(this).val()=="")
                                    //{
                                    //    $.modalAlert("Thuốc kháng sinh cần điền lý do sử dụng, vui lòng chọn lại", "warning");
                                    //    $(this).val("2");
                                    //}
                                }
                            }
                    ]
                    }
                },
                { label: 'Thao tác', name: 'action', width: 45, align: 'center' },
                { label: 'iskss', name: 'iskss', editable: true, hidden: true },
                { label: 'jlfwbegin', name: 'jlfwbegin', editable: true, hidden: true },
                { label: 'jlfwend', name: 'jlfwend', editable: true, hidden: true },
                { label: 'pcfwbegin', name: 'pcfwbegin', editable: true, hidden: true },
                { label: 'pcfwend', name: 'pcfwend', editable: true, hidden: true },
                { name: 'zyh', hidden: true },
                { name: 'ysgh', hidden: true },
                { name: 'kcsl', hidden: true },
                { name: 'yzlx', hidden: true },
                { label: 'jlzhxs', name: 'jlzhxs', editwidth: '100%', align: 'center', editable: true, hidden: true },
                { label: 'zyzhxs', name: 'zyzhxs', editwidth: '100%', align: 'center', editable: true, hidden: true },
                { name: 'jxCode', width: 50, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { name: 'zxksdm', width: 50, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { name: 'qzfs', width: 50, editwidth: '100%', align: 'center', editable: true, hidden: true },
                { name: 'kcsl', width: 50, editwidth: '100%', align: 'center', editable: true, hidden: true }
            ],
            editinputwidthborder: false,    //Có cần viền không mặc định làtrue
            editinputborderradius: false,   //Có cần bo góc viền không Mặc địnhtrue(có bo góc)
            pager: "gridmedicinePager",
            gridComplete: function () {
                EnableMInlineEditBox();
                //$gridmedicine.closest(".ui-jqgrid-bdiv").css({ "overflow-x": "hidden" });//ẨngridThanh cuộn dưới cùng
            }
        });
        //Menu cấp hai
        $gridmedicine.jqGrid('setGroupHeaders', {
            useColSpanStyle: true,
            groupHeaders: [
            {
                startColumnName: 'xmmc',
                numberOfColumns: 4,
                titleText: 'Thông tin cơ bản'
            }, {
                startColumnName: 'ypjl',
                numberOfColumns: 2,
                titleText: 'Liều lượng mỗi lần'
            }]
        });
        $.each($(".jqg-first-row-header").find("th"),
            function () {
                $(this).css("padding", 0);
            });

        //Nút tùy chỉnh
        $gridmedicine.navGrid('#gridmedicinePager',
                {
                    edit: false,
                    add: false,
                    del: false,
                    search: false,
                    refresh: false,
                    view: false,
                    position: "left",
                    cloneToTop: false
                })
            .navButtonAdd('#gridmedicinePager',
                {
                    buttonicon: "glyphicon glyphicon-new-window",
                    title: "Y lệnh mới",
                    caption: "Y lệnh mới",
                    position: "last",
                    onClickButton: function() {
                        newMPresData(null);
                    }
            });
        $("#gridmedicinePager_right").append("<div class=\"ckbox\" style=\"margin-top:2px;\"><input id=\"chklsyz\" name=\"chklsyz\" type=\"checkbox\" ><label for=\"chklsyz\">Y lệnh tạm thời</label></div>");
    }

    //Bật chỉnh sửa trong dòng
    function EnableMInlineEditBox(){
        var ids = $("#gridmedicine").getDataIDs();
        if (ids.length>0) {
            $.each(ids, function () {
                var rowid = String(this);
                //Mở chế độ chỉnh sửa
                $("#gridmedicine").jqGrid('editRow', rowid, false, initWMInlineFunc);

                //Đánh dấu màu đơn thuốc
                var zh = $('#' + $($("#gridmedicine").getRowData(rowid).zh).attr('id')).val();
                if (zh !== "") {
                    var cfColor = getZhColor(zh);
                    $('#gridmedicine tr[id="' + String(this) + '"]').css('border-left-color', cfColor);
                    $('#gridmedicine tr[id="' + String(this) + '"]').css('border-left-style', 'solid');
                    $('#gridmedicine tr[id="' + String(this) + '"]').css('border-left-width', '5px');
                }

                //Điền đơn vị cho liều lượng mỗi lầnoption
                var jldw = $("#" + rowid + "_redundant_jldw").val();    //Đơn vị liều lượng Đơn vị của bảng từ điển thuốc
                var dw = $("#" + rowid + "_dwwwwwww").val();     //Đơn vị nhập viện
                var yzlb = $("#" + rowid + "_yzlb").val();     //Loại y lệnh Dài hạn, tạm thời
                if (yzlb === "临") {
                    $("#" + rowid + "_ts").css('background-color', '#f6f7fb').attr('readonly', 'true'); //Y lệnh tạm thời Vô hiệu hóa số ngày
                } else {
                    $("#" + rowid + "_sl").css('background-color', '#f6f7fb').attr('readonly', 'true'); //Y lệnh dài hạn Vô hiệu hóa tổng số lượng
                    $("#" + rowid + "_sl").hide();
                }
                if (!!dw) {
                    //Cách tìm phần tử này không nên dùng, nhưng vìselectKhông cóidThuộc tính
                    $("#" + rowid + "_ypjl").parent().next().children('select').html('');

                    if (jldw == dw) {
                        $("#" + rowid + "_ypjl").parent().next().children('select').append('<option value="1">' + jldw + '</option>');
                    }
                    else {
                        var dwlb = $("#" + rowid + "_dwlb").val(); //Khi tồn tại loại đơn vị, nghĩa là đã tồn tại đơn vị đã chọn, trang sẽ chọn
                        var jldwlb = 1, dwdwlb = 4;
                        if (!!dwlb) {
                            if (jldwlb == dwlb) {
                                jldwlb = 4, dwdwlb = 1;
                            }
                        }
                        if (!!jldw) {
                            $("#" + rowid + "_ypjl").parent().next().children('select').append('<option value="' + jldwlb + '">' + jldw + '</option>');
                        }
                        if (!!dw) {
                            $("#" + rowid + "_ypjl").parent().next().children('select').append('<option value="' + dwdwlb + '">' + dw + '</option>');
                        }
                        $("#" + rowid + "_ypjl").parent().next().children('select').val(dwlb);
                    }
                }
                $("#" + rowid + "_kssj").css("text-align", "left");     //Loại y lệnh Dài hạn, tạm thời
            });
        }
    }

    //Cùng một số nhóm cần khớp cách dùng, tần suất, số ngày, ngày kết thúc
    function MatchMZuhaoInfo(rowid, validate) {
        var rtnval = true;
        var currRowZh = $("#" + rowid + "_zh").val();
        if (currRowZh) {
            var allData = $("#gridmedicine").jqGrid('getRowData_AllLine');
            $.each(allData, function () {
                var objId = $(this.zh).attr('rowid');
                var objzh = $("#" + objId + "_zh").val();
                if (objzh == currRowZh && objId != rowid) {
                    var objyfmc = $("#" + objId + "_yfmcval").val();
                    var objypyfdm = $("#" + objId + "_ypyfdm").val();
                    var objpcmc = $("#" + objId + "_pcmc").val();
                    var objpcCode = $("#" + objId + "_pcCode").val();
                    var objzxcs = $("#" + objId + "_zxcs").val();
                    var objzxzq = $("#" + objId + "_zxzq").val();
                    var objzxzqdw = $("#" + objId + "_zxzqdw").val();
                    var kssj = $("#" + objId + "_kssj").val();
                    var ts = $("#" + objId + "_ts").val();
                    var currentjx = $("#" + rowid + "_jxCode").val();
                    var jxyfdy = top.top.clients.ypjxyfdy;
                    var jxyf = top.top.clients.ypyf;//Tất cả cách dùng

                    if (validate) {
                        var yfmcval = $("#" + rowid + "_yfmcval").val();
                        var ypyfdm = $("#" + rowid + "_ypyfdm").val();
                        var pcmc = $("#" + rowid + "_pcmc").val();
                        var pccode = $("#" + rowid + "_pcCode").val();
                        var zxcs = $("#" + rowid + "_zxcs").val();
                        var zxzq = $("#" + rowid + "_zxzq").val();
                        var zxzqdw = $("#" + rowid + "_zxzqdw").val();
                        var rowkssj = $("#" + rowid + "_kssj").val();
                        var rowts = $("#" + rowid + "_ts").val();
                        if (yfmcval !== objyfmc || ypyfdm !== objypyfdm) {
                            $.modalAlert("Số nhóm là" + currRowZh + "cách dùng không nhất quán", "warning");
                            rtnval = false;
                        } else
                            if (pcmc !== objpcmc || pccode !== objpcCode) {
                                $.modalAlert("Số nhóm là" + currRowZh + "tần suất không nhất quán", "warning");
                                rtnval = false;
                            } else
                                if (zxcs !== objzxcs || zxzq !== objzxzq || zxzqdw !== objzxzqdw) {
                                    $.modalAlert("Số nhóm là" + currRowZh + "tần suất thực hiện không nhất quán", "warning");
                                    rtnval = false;
                                } else
                                    if (rowkssj !== kssj) {
                                        $.modalAlert("Số nhóm là" + currRowZh + "thời gian bắt đầu không nhất quán", "warning");
                                        rtnval = false;
                                    } else
                                        if (rowts !== ts) {
                                            $.modalAlert("Số nhóm là" + currRowZh + "số ngày không nhất quán", "warning");
                                            rtnval = false;
                                        }
                    } else {
                        $("#" + rowid + "_dwwwwwww").parent().next().children('select').html("");
                        //Hộp thả xuống cách dùng
                        if (currentjx !== null && currentjx !== "") {//Dạng bào chế của thuốc hiện tại
                            if ($("#" + rowid + "_xmmc").val() == "") {
                                return false;
                            }
                            $.each(jxyfdy, function (idx, val) {//Dạng bào chế tương ứng với cách dùng
                                if (val.jxCode === currentjx) {//Tìm dạng bào chế hiện tại
                                    var yfCode = val.yfCode;//Lấy cách dùng hiện tại
                                    if (currRowZh !== "" && objypyfdm !== "" && yfCode.indexOf(objypyfdm) < 0) {//Cách dùng cùng nhóm đã tồn tại trước đó
                                        $.modalAlert($("#" + rowid + "_xmmc").val() + "不存在" + objyfmc + "用法", "warning");
                                        $("#" + rowid + "_zh").val("");
                                        $("#" + rowid + "_zh").focus();
                                        return false;
                                    }
                                    $.each(jxyf, function (i, v) {
                                        if (yfCode.indexOf(v.yfCode) > '-1') {
                                            var append = "<option value=" + v.yfCode + ">" + v.yfmc + "</option>";
                                            $("#" + rowid + "_dwwwwwww").parent().next().children('select').append(append);
                                        }
                                    });


@{
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="kb_main_top">
    <h2 style="font-size: large;font-weight: bold;padding-left:10px">
        In tiếp
    </h2>
</div>
<div id="panelposition" style="margin-left:40px">
    <label><input type="radio" name="optionsRadios" class="optionsRadios formClearIgnore" checked value="长期医嘱" />Y lệnh dài hạn</label>
    <label><input type="radio" id="radioTreating" name="optionsRadios" class="optionsRadios formClearIgnore" value="有效医嘱" />Y lệnh có hiệu lực</label>
</div>
<div class="rows" style="width:95%;margin-left:1%; margin-top:10px">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Phương thức in
        </div>
        <div>
            <table class="form" style="width:265px;height:65px;">
                <tr >
                    <td style="width:61px;padding-left:10px">
                        <label><input type="radio" name="optionsRadios1" class="optionsRadios formClearIgnore" checked value="直接续打" />In tiếp trực tiếp</label>
                    </td>
                </tr>
                <tr >
                    <td style="padding-left:10px">
                        <label><input type="radio" name="optionsRadios1" class="optionsRadios formClearIgnore" value="续打" />In tiếp</label>
                    </td>
                    <td class="formTitle">
                        Số trang bắt đầu
                    </td>
                    <td class="formValue">
                        <input class="form-control" id="txt_EndHour" style="width:28px;" value="">
                    </td>
                    <td class="formTitle">
                        Số dòng bắt đầu
                    </td>
                    <td class="formValue">
                        <input class="form-control" id="txt_EndHour" style="width:28px;" value="">
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>
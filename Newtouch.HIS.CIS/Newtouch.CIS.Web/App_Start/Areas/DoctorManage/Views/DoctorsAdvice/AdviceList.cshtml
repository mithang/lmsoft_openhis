    //Làm mới
    function newtouch_event_f4() {
        btn_search();
    }
    //Dừng toàn bộ khi xuất viện
    function newtouch_event_f6() {
        boolwsh(currentobj.zyh, function (rbnbool) {
            if (rbnbool) {
                $.modalAlert("Bệnh nhân này có y lệnh chưa duyệt, vui lòng liên hệ y tá duyệt rồi mới thao tác", "warning");
                return;
            }
            AdviceLeaveHospitalStop();
        });
    }

    ///Thao tác dừng toàn bộ khi xuất viện
    function AdviceLeaveHospitalStop() {
        $.modalOpen({
            id: "AdviceLeaveHospitalStop",
            title: "Dừng toàn bộ khi xuất viện",
            url: "/DoctorManage/DoctorsAdvice/AdviceLeaveHospitalStop?zyh=" + currentobj.zyh,
            width: "550px",
            height: "300px",
            callBack: function (iframeId) {
                $.modalConfirm("Có xác nhận dừng toàn bộ y lệnh dài hạn của bệnh nhân này khi xuất viện không?",
                    function (flag) {
                        if (flag) {
                            top.frames[iframeId].submitForm(function () {
                                $.loading(false);
                                $.modalClose("AdviceLeaveHospitalStop");
                                $.modalMsg("Dừng toàn bộ khi xuất viện thành công", 'success');
                                btn_search();
                            });
                        }
                    });
            }
        });
    }

    //Dừng toàn bộ khi chuyển khu
    function newtouch_event_f7() {
        $.modalOpen({
            id: "TransferWardStop",
            title: "Dừng toàn bộ khi chuyển khu",
            url: "/DoctorManage/DoctorsAdvice/TransferWardStop?zyh=" + currentobj.zyh,
            width: "550px",
            height: "300px",
            callBack: function (iframeId) {
                $.modalConfirm("Có xác nhận dừng toàn bộ y lệnh dài hạn của bệnh nhân này không?",
                    function (flag) {
                        if (flag) {
                            top.frames[iframeId].submitForm(function () {
                                $.loading(false);
                                $.modalClose("TransferWardStop");
                                $.modalMsg("Dừng toàn bộ khi chuyển khu thành công", 'success');
                                btn_search();
                            });
                        }
                    });
            }
        });
    }

    ///Kiểm tra bệnh nhân hiện tại có y lệnh dài hạn chưa duyệt không
    function boolwsh(zyh, callback) {
        $.najax({
            url: "@Url.Action("boolwsh")",
            dataType: "json",
            data: { zyh: zyh },
            async: true,
            type: "POST",
            success: function () {
                callback(false);
            }, error: function () {
                callback(true);
            }
        });
    }


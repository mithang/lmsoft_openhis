
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
@using Newtouch.Infrastructure;
<style>
    .beveltabsli {
        width: 25% !important;
        text-align: center !important;
    }

    #beveltabs a {
        padding: 0 7px !important;
    }
    .ui-layout-pane-west {
       border:none !important;
       background-color:white;
    }
</style>
<div class="ui-layout" id="layout" style="height:100%;width:100%;">
    <div class="ui-layout-west">
        <ul id="beveltabs">
            <li><a href="#" name="#personal" data-type=@Html.Raw(((int)EnumTcfw.Person).ToString())>Cá nhân</a></li>
            <li><a href="#" name="#department" data-type=@Html.Raw(((int)EnumTcfw.Dept).ToString())>Khoa</a></li>
            @if (ViewBag.bhbq)
            {
            <li><a href="#" name="#ward" data-type=@Html.Raw(((int)EnumTcfw.Ward).ToString())>Khu bệnh</a></li>
            }
            <li><a href="#" name="#hospital" data-type=@Html.Raw(((int)EnumTcfw.Hosp).ToString())>Toàn viện</a></li>
        </ul>
        <div id="treeContent">
            <div id="personal">
                <div id="personalTree"></div>
            </div>
            <div id="department">
                <div id="departmentTree"></div>
            </div>
            <div id="ward">
                <div id="wardTree"></div>
            </div>
            <div id="hospital">
                <div id="hospitalTree"></div>
            </div>
        </div>
    </div>
    <iframe class="ui-layout-center" id="iframerightiframerightiframeright" name="iframerightiframerightiframeright"></iframe>
</div>

<link href="@SiteUrl.GetStaticResourceScriptUrl("~/Content/css/beveltabs.css", false)" rel="stylesheet" />
<script src="@SiteUrl.GetStaticResourceScriptUrl("~/Content/js/beveltabs.js", false)"></script>

<script type="text/javascript">
    $(function ($) {
        $('#layout').layout();
        $("#beveltabs a:first").trigger('click');
    });

    var expandyzlx = null;

    $("#beveltabs a").on("click", function (e) {
        var tempExpandyzlx = expandyzlx;    //Thời hạn hiệu lực là một lần
        expandyzlx = null;
        $($(this).attr('name') + "Tree").treeview({
            height: $(window).height() - 100,
            slimscroll: false,
            url: "/TemplateManage/DoctorServiceTemplate/GetTreeList?tcfw=" + $('#current').attr('data-type') + "&tclx=0" + "&expandyzlx=" + tempExpandyzlx,
            onnodeclick: function (item) {
                if (!item.value) {
                    return;
                }

                if (item.value == '@Html.Raw(((int)EnumYzlx.Yp).ToString())') {   //Thuốc
                    $("#iframerightiframerightiframeright").attr("src", "/TemplateManage/DoctorServiceTemplate/MedicineForm?mbId=" + item.Ex1);  //item.Ex1làm mẫuId
                } else if (item.value == '@Html.Raw(((int)@EnumYzlx.Wz).ToString())') {   //Văn bản
                    $("#iframerightiframerightiframeright").attr("src", "/TemplateManage/DoctorServiceTemplate/WordForm?mbId=" + item.Ex1);
                } else if (item.value == '@Html.Raw(((int)@EnumYzlx.sfxm).ToString())') {   //Hạng mục
                    $("#iframerightiframerightiframeright").attr("src", "/TemplateManage/DoctorServiceTemplate/ItemForm?mbId=" + item.Ex1);
                } else if (item.value == '@Html.Raw(((int)@EnumYzlx.Cydy).ToString())') {   //Thuốc mang về khi xuất viện
                    $("#iframerightiframerightiframeright").attr("src", "/TemplateManage/DoctorServiceTemplate/TakeMedicineForm?mbId=" + item.Ex1);
                }else if (item.value == '@Html.Raw(((int)@EnumYzlx.ssyz).ToString())') {   //Y lệnh ăn uống
                    $("#iframerightiframerightiframeright").attr("src", "/TemplateManage/DoctorServiceTemplate/FoodForm?mbId=" + item.Ex1);
                }
            }
        });
    });

</script>
<?xml version="1.0" encoding="utf-8"?>
<appSettings>
  <!-- ================== 1: Cấu hình liên quan đến hệ thống phát triển ================== -->
  <!-- Thời gian duy trì trạng thái đăng nhập (đơn vị: phút)-->
  <add key="LoginStatusKeepMinute" value="3000" />
  <!-- Đăng nhập nhiều thiết bị đầu cuối sẽ đá nhau ra -->
  <add key="EnableMultipleLoginLimit" value="true" />
  <!-- Đăng nhập nhiều thiết bị đầu cuối sẽ đá nhau ra-Cùng một tài khoản, số lượng trực tuyến đồng thời tối đa -->
  <add key="MultipleLoginLimit_Count" value="10" />

  <!--BậtIPLọc (sau khi bật BậtIPChính sách hạn chế truy cập (chỉ mở cho một phần hoặc hạn chế truy cập một phần)) -->
  <add key="Is_IPFilter" value="false" />

  <!-- ================== 2: Cấu hình tham số phần mềm hệ thống ================== -->
  <!-- Phiên bản phần mềm -->

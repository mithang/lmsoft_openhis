<?xml version="1.0" encoding="utf-8"?>
<appSettings>
  <!-- ================== 1: Cấu hình liên quan đến hệ thống phát triển ================== -->
  <!-- Thời gian duy trì trạng thái đăng nhập (đơn vị: phút)-->
  <add key="LoginStatusKeepMinute" value="30" />
  <!-- Đăng nhập trên nhiều thiết bị đầu cuối sẽ đá văng nhau -->
  <add key="EnableMultipleLoginLimit" value="true" />
  <!-- Đăng nhập trên nhiều thiết bị đầu cuối sẽ đá văng nhau - Cùng một tài khoản, số người trực tuyến đồng thời tối đa -->
  <add key="MultipleLoginLimit_Count" value="10" />

  <!--Bật lọc IP (sau khi bật, bật chính sách giới hạn truy cập IP (chỉ mở cho một phần hoặc giới hạn một phần truy cập)) -->
  <add key="Is_IPFilter" value="false" />


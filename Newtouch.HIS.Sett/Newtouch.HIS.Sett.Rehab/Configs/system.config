<?xml version="1.0" encoding="utf-8"?>
<appSettings>
  <!-- ================== 1:Cấu hình liên quan hệ thống phát triển ================== -->
  <!-- chế đ ộ nhà cung cấp đ ăng nhập:Session, Cookie-->
  <add key="LoginProvider" value="Cookie" />
  <!-- Bật nhật ký hệ thống-->
  <add key="IsLog" value="true" />
  <!-- Thời gian chờ cơ sở dữ liệu-->
  <add key="CommandTimeout" value="180" />
  <!--Bật lọc IP -->
  <add key="IsIPFilter" value="false" />
  <!-- ================== 2:Cấu hình tham số phần mềm hệ thống ================== -->
  <!-- Liên hệ chúng tôi -->
  <add key="Contact" value="www.Newtouch.cn" />
  <!-- Tên phần mềm -->
  <add key="SoftName" value="Newtouch开发框架" />
  <!-- Phiên bản phần mềm -->
  <add key="Version" value="1.0" />
  <!-- Mã ủy quyền phần mềm Dự phòng kiểm thử -->
  <add key="LicenceKey" value="83eda07f-ead3-4050-bcee-4f41e57a7e16" />
  <!-- ================== 3:Tham số thư bên ngoài ================== -->
  <!-- Đ ặt tên hộp thư -->
  <add key="MailName" value="邮件中心" />
  <!-- Đ ặt đ ịa chỉ hộp thư -->
  <add key="MailUserName" value="sendbug@Newtouch.cn" />
  <!-- Đ ặt mật khẩu hộp thư -->
  <add key="MailPassword" value="123456" />
  <!-- Đ ặt máy chủ hộp thư -->
  <add key="MailHost" value="smtp.ym.163.com" />

  <add key="vs:EnableBrowserLink" value="false"/>
  <!-- ================== 4:Tham số in ================== -->
  <add key="CFPrint" value="false" />
  <!-- ================== 5:Cấu hình nhà thuốc ================== -->
  <add key="YFPZparm" value="mzyf,zyyf" />

  <!-- Cấu hình Module Id phần quan trọng -->
  <!-- cài đ ặt tham số hệ thống -->
  <add key="SysParameterConfigApp_ParentModule_EnCode" value="Sys_ParameterConfig"/>
  <!-- Reids bộ nhớ đ ệm Củakey trư ớc 缀 -->
  <add key="Reids_Cache_Prefix" value="$#C_S_R#$"/>
  <!-- ID tổ chức cấp cao nhất -->
  <add key="Top_OrganizeId" value="1"/>

  <!-- Host trang tĩnh -->
  <add key="SiteStaticHost" value="103.36.173.199:20103"/>
  <!--<add key="SiteStaticHost" value="localhost:9061"/>-->
  
  <!--Conn链接字符串có hay không sử dụng mã hóa -->
  <add key="Conn_DESEncrypted" value="true"/>
  <!--Redis Conn链接字符串có hay không sử dụng mã hóa -->
  <add key="Redis_Conn_DESEncrypted" value="true"/>
  
</appSettings>
                            <input type="text" id="txtINPUTCODE" class="form-control" placeholder="Số thẻ Số nhập viện Tên bệnh nhân" />
                        </td>
                    </tr>*@
                <tr>
                    <td class="formTitle">Số thẻ:</td>
                    <td class="formValue">
                        <input class="form-control " type="text" id="kh" value="" />
                    </td>
                    <td class="formTitle">Số nhập viện:</td>
                    <td class="formValue">
                        <input class="form-control " type="text" id="zyh" value="" />
                    </td>


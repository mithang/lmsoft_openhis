                    </td>
                </tr>
                <tr class="moreInfo">
                    <td class="formTitle">Số bệnh án:</td>
                    <td class="formValue">
                        <input class="form-control newtouch_Readonly" type="text" id="blh" value="" />
                    </td>
                    <td class="formTitle">Giới tính:</td>
                    <td class="formValue">
                        <input class="form-control newtouch_Readonly" readonly="readonly" type="text" id="xb" value="" />
                    </td>
                    <td class="formTitle">Loại bệnh nhân:</td>
                    <td class="formValue">

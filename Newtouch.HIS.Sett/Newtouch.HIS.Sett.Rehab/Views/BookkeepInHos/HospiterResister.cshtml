
@{
    ViewBag.Title = "HospiterResister";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<!DOCTYPE html>
<style type="text/css">
    span {
        color: red;
    }

    .btn-group label input {
        width: 25%;
        margin: 0;
    }

    #basicInfo table td, #InHospitalInfo table td {
        border: 0;
    }

    .active {
        background: rgb(238, 238, 238) !important;
    }
</style>
<script type="text/javascript" src="~/Content/js/HospiterRes/Register.js"></script>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title></title>
</head>
<body>
    <form id="form1">
        <div class="rows" style="margin-bottom: 1%;" id="basicInfo">
            <div class="panel panel-default" style="margin-bottom:0;">
                <div class="panel-heading navb-bg">
                    Thông tin cơ bản bệnh nhân
                </div>
                <table class="form" style="width:98%;border:0">
                    <tr>
                        <th class="formTitle">Số thẻ<span>*</span></th>
                        <td class="formValue">
                            <input type="text" id="kh" name="kh" class="form-control" />
                        </td>
                        <td>
                            <button type="button" class="btn btn-default" id="noCardRes" value="Đăng ký miễn thẻ" onclick="btn_NocardRes()">
                                Đăng ký miễn thẻ
                            </button>
                        </td>
                        <td class="formTitle">
                            Số nhập viện<span>*</span>
                        </td>
                        <td class="formValue"> <input type="text" id="zyh" class="form-control  newtouch_Readonly" /></td>
                        <td class="formTitle">
                            Họ tên
                        </td>
                        <td class="formValue">  <input type="text" id="xm" class="form-control newtouch_Readonly" /></td>
                        <td class="formTitle">

                            <label id="zjlx">Số CMND<span>*</span></label>
                        </td>
                        <td class="formValue">
                            <input type="text" id="zjh" class="form-control newtouch_Readonly" />
                        </td>
                    <tr>
                        <td class="formTitle">
                            Năm tháng sinh
                        </td>
                        <td class="formValue">
                            @*onfocus="WdatePicker()"*@
                            <input id="csny" type="text" class="form-control newtouch_Readonly" />
                        </td>
                        <td></td>
                        <td class="formTitle">Giới tính<span>*</span></td>
                        <td>
                            <div class="btn-group formValue" data-toggle="buttons">
                                <label class="btn btn-default" disabled>
                                    <input type="radio" id="xb" value="1" name="xb" class="form-control" />Nam
                                </label>
                                <label class="btn btn-default" disabled>
                                    <input type="radio" id="xb" value="0" name="xb" class="form-control" />Nữ
                                </label>
                            </div>
                        </td>
                        <td class="formTitle">Tuổi<span>*</span></td>
                        <td class="formValue">
                            <input type="text" id="nl" class="form-control newtouch_Readonly" />
                        </td>
                        <td class="formTitle">
                            Số bệnh án
                        </td>
                        <td class="formValue">
                            <input type="text" readonly="readonly" id="blh" class="form-control newtouch_Readonly" />
                        </td>
                    </tr>
                    <tr>
                        <td class="formTitle">Điện thoại</td>
                        <td class="formValue"><input type="text" id="dh" class="form-control newtouch_Readonly" /></td>
                        <td></td>
                        <td class="formTitle">Khu vực</td>
                        <td class="formValue">
                            <select id="dy" class="form-control newtouch_Readonly">
                                <option value="">==Vui lòng chọn==</option>
                                <option value="0">Địa phương</option>
                                <option value="1">Ngoại tỉnh</option>
                            </select>
                        </td>
                        <td class="formTitle">Hôn nhân<span>*</span></td>
                        <td class="formValue">
                            <select id="hf" class="form-control newtouch_Readonly">
                                <option value="">==Vui lòng chọn==</option>
                                <option value="0">Chưa kết hôn</option>
                                <option value="1">Đã kết hôn</option>
                            </select>
                        </td>
                        <td class="formValue"><input type="hidden" id="patid" /></td>
                    </tr>
                </table>
            </div>
        </div>
        <div id="InHospitalInfo" class="rows" style="margin-bottom: 1%;">
            <div class="panel panel-default" style="margin-bottom:0;">
                <div class="panel-heading navb-bg">Thông tin cơ bản nhập viện</div>
                <table class="form" style="width:98%;border:0">
                    <tr>
                        <td class="formTitle">Số nhập viện<span>*</span></td>
                        <td class="formValue"><input type="text" id="zyh2" class="form-control newtouch_Readonly" readonly="readonly" /></td>
                        <td class="formTitle">Huấn luyện viên sức khỏe</td>
                        <td class="formValue"><input type="text" id="jkjlmc" class="form-control" /></td>
                        <td class="formTitle">Bác sĩ</td>
                        <td class="formValue"><input type="text" id="doctormc" class="form-control" /></td>
                        <td class="formTitle">Giường bệnh</td>
                        <td class="formValue"><input type="text" id="cw" class="form-control" /></td>
                    </tr>
                    <tr>
                        <td class="formTitle">Chính sách hoàn trả<span>*</span></td>
                        <td class="formValue">  <input type="text" id="brxzmc" name="brxzmc" class="form-control" /></td>
                        <td class="formTitle">Chẩn đoán khi nhập viện 1</td>
                        <td class="formValue"><input type="text" id="zdmc1" class="form-control" /></td>
                        <td class="formTitle">Chẩn đoán khi nhập viện 2</td>
                        <td class="formValue"> <input type="text" id="zdmc2" class="form-control" /></td>
                        <td class="formTitle">Chẩn đoán khi nhập viện 3</td>
                        <td class="formValue"> <input type="text" id="zdmc3" class="form-control" /></td>
                    </tr>
                    <tr>
                        <td class="formTitle">Ngày nhập viện<span>*</span></td>
                        <td class="formValue">
                            @*<input size="16" type="text" id="ryrq" class="form_datetime form-control">*@
                            <input id="ryrq" type="text" class="form-control input-wdatepicker" onfocus="WdatePicker()" />
                        </td>
                        <td class="formTitle">Khoa<span>*</span></td>
                        <td class="formValue">   <input type="text" id="ksmc" name="ksmc" class="form-control" /></td>
                        <td class="formTitle">Khu bệnh<span>*</span></td>
                        <td class="formValue"> <input type="text" id="bqmc" name="bqmc" class="form-control" /></td>
                        <td class="formTitle">Tiền sử dị ứng</td>
                        <td class="formValue"> <input type="text" id="gms" class="form-control" /></td>
                    </tr>
                    <tr>
                        <td class="formTitle">Tình trạng bệnh khi nhập viện</td>
                        <td>
                            <div class="btn-group formValue" data-toggle="buttons">
                                <label class="btn btn-default">
                                    <input type="radio" id="rybq" value="0" name="rybq" class="form-control" />Bình thường
                                </label>
                                <label class="btn btn-default">
                                    <input type="radio" id="rybq" value="1" name="rybq" class="form-control" />Nguy kịch
                                </label>
                            </div>
                        </td>
                        <td class="formTitle">Đường nhập viện</td>
                        <td class="formValue">
                            <select class="form-control" id="rytj">
                                <option value="">==Vui lòng chọn==</option>
                                <option value="0">Ngoại trú</option>
                                <option value="1">Cấp cứu</option>
                                <option value="2">Chuyển từ cơ sở y tế khác</option>
                                <option value="3">120</option>
                            </select>
                        </td>
                        <td class="formTitle">Nghề nghiệp<span>*</span></td>
                        <td class="formValue">
                            <select class="form-control" id="zy" name="zy">
                                <option value="">==Vui lòng chọn==</option>
                                <option value="0">Khác</option>
                                <option value="1">Công nhân</option>
                                <option value="2">Công nhân đã nghỉ hưu</option>
                                <option value="3">Cán bộ</option>
                                <option value="4">Quân nhân</option>
                                <option value="5">Giáo viên</option>
                                <option value="6">Nông dân</option>
                            </select>
                        </td>
                        <td class="formTitle">Ăn uống</td>
                        <td class="formValue"> <input type="text" id="ys" class="form-control" /></td>
                    </tr>
                    <tr>
                        <td class="formTitle">Nơi sinh</td>
                        <td class="formValue">
                            <input type="text" id="cs_sheng" class="form-control" style="width:90px; float:left" />
                            <p style="float:right">Tỉnh (quận, thành phố)</p>
                        </td>
                        @*<td class="formTitle">Tỉnh (quận, thành phố)</td>*@
                        <td></td>
                        <td class="formValue">
                            <input type="text" id="cs_shi" class="form-control" style="width:125px; float:left" />
                            <p style="float:right">Thành phố</p>
                        </td>
                        @*<td class="formTitle">Thành phố</td>*@
                        <td></td>
                        <td class="formValue">
                            <input type="text" id="cs_xian" class="form-control" style="width:125px; float:left" />
                            <p style="float:right">Huyện</p>
                        </td>
                        @*<td class="formTitle">Huyện</td>*@
                    </tr>
                    <tr>
                        <td class="formTitle">Địa chỉ hiện tại</td>
                        <td class="formValue"><input type="text" id="xian_sheng" class="form-control" style="width:90px; float:left" /><p style="float:right">Tỉnh (quận, thành phố)</p></td>
                        @*<td class="formTitle">Tỉnh (quận, thành phố)</td>*@
                        <td></td>
                        <td class="formValue"> <input type="text" id="xian_shi" class="form-control" style="width:125px; float:left" /><p style="float:right">Thành phố</p></td>
                        @*<td class="formTitle">Thành phố</td>*@
                        <td></td>
                        <td class="formValue"> <input type="text" id="xian_xian" class="form-control" style="width:125px; float:left" /><p style="float:right">Huyện</p></td>
                        @*<td class="formTitle">Huyện</td>*@
                        <td class="formTitle">Địa chỉ</td>
                        <td class="formValue"><input type="text" id="xian_dz" class="form-control" /></td>
                    </tr>
                    <tr>
                        <td class="formTitle">Địa chỉ hộ khẩu</td>
                        <td class="formValue"><input type="text" id="hu_sheng" class="form-control" style="width:90px; float:left" /><p style="float:right">Tỉnh (quận, thành phố)</p></td>
                        @*<td class="formTitle">Tỉnh (quận, thành phố)</td>*@
                        <td></td>
                        <td class="formValue"> <input type="text" id="hu_shi" class="form-control" style="width:125px; float:left" /><p style="float:right">Thành phố</p></td>
                        @*<td class="formTitle">Thành phố</td>*@
                        <td></td>
                        <td class="formValue"> <input type="text" id="hu_xian" class="form-control" style="width:125px; float:left" /><p style="float:right">Huyện</p></td>
                        @*<td class="formTitle">Huyện</td>*@
                        <td class="formTitle">Địa chỉ</td>
                        <td class="formValue"><input type="text" id="hu_dz" class="form-control" /></td>
                    </tr>
                    <tr>
                        <td class="formTitle">Dân tộc<span>*</span></td>
                        <td class="formValue"> <input type="text" id="mzmc" name="mzmc" class="form-control" /></td>
                        <td class="formTitle">Quốc tịch<span>*</span></td>
                        <td class="formValue"> <input type="text" id="gjmc" name="gjmc" class="form-control" /></td>
                        <td class="formTitle">Hôn nhân<span>*</span></td>
                        <td class="formValue">
                            <select class="form-control" id="hy">
                                <option value="">==Vui lòng chọn==</option>
                                <option value="0">Chưa kết hôn</option>
                                <option value="1">Đã kết hôn</option>
                            </select>
                        </td>
                        <td class="formTitle">Mức cảnh báo<span>*</span></td>
                        <td class="formValue"> <input type="text" id="bje" name="bje" class="form-control" /></td>
                    </tr>
                    <tr>
                        <td class="formTitle">Người liên hệ khẩn cấp<span>*</span></td>
                        <td class="formValue"> <input type="text" id="lxr" name="lxr" class="form-control" /></td>
                        <td class="formTitle">Quan hệ người liên hệ khẩn cấp<span>*</span></td>
                        <td class="formValue">
                            <select id="lxrgx" name="lxrgx" class="form-control">
                                <option value="">==Vui lòng chọn==</option>
                                <option value="1">Vợ - chồng</option>
                                <option value="2">Cha - con trai</option>
                                <option value="3">Mẹ - con trai</option>
                                <option value="4">Cha - con gái</option>
                                <option value="5">Anh - em trai</option>
                                <option value="6">Chị - em trai</option>
                                <option value="0">Khác</option>
                            </select>
                        </td>
                        <td class="formTitle">Điện thoại di động khẩn cấp<span>*</span></td>
                        <td class="formValue"><input type="text" id="lxrdh" name="lxrdh" class="form-control" /></td>
                        <td class="formTitle">Điện thoại gia đình khẩn cấp</td>
                        <td class="formValue"> <input type="text" id="lxrjtdh" class="form-control" /></td>
                    </tr>
                    <tr>
                        <td class="formTitle">WeChat người liên hệ khẩn cấp</td>
                        <td class="formValue">  <input type="text" id="lxrWebchat" class="form-control" /></td>
                        <td class="formTitle">Email người liên hệ khẩn cấp</td>
                        <td class="formValue"><input type="text" id='lxrEmail' class="form-control" /></td>
                        <td class="formTitle">Địa chỉ người liên hệ khẩn cấp<span>*</span></td>
                        <td colspan="3" class="formValue">
                            <input type="text" id="lxrdz" name="lxrdz" class="form-control" style="width:101%" />
                        </td>
                    </tr>
                    <tr>
                        <td class="formTitle">Người liên hệ thứ hai</td>
                        <td class="formValue"> <input type="text" id="lxr2" class="form-control" /></td>
                        <td class="formTitle">Quan hệ người liên hệ thứ hai</td>
                        <td class="formValue">
                            <select id="lxrgx2" class="form-control">
                                <option value="">==Vui lòng chọn==</option>
                                <option value="0">Khác</option>
                                <option value="1">Vợ - chồng</option>
                                <option value="2">Cha - con trai</option>
                                <option value="3">Mẹ - con trai</option>
                                <option value="4">Cha - con gái</option>
                                <option value="5">Anh - em trai</option>
                                <option value="6">Chị - em trai</option>
                            </select>
                        </td>
                        <td class="formTitle">Điện thoại di động thứ hai</td>
                        <td class="formValue"> <input type="text" id="lxryddh2" class="form-control" /></td>
                        <td class="formTitle">Điện thoại gia đình thứ hai</td>
                        <td class="formValue"> <input type="text" id="lxrjtdh2" class="form-control" /></td>
                    </tr>
                    <tr>
                        <td class="formTitle">WeChat người liên hệ thứ hai</td>
                        <td class="formValue">  <input type="text" id="lxrWebchat2" class="form-control" /></td>
                        <td class="formTitle">Email người liên hệ thứ hai</td>
                        <td class="formValue"> <input type="text" id="lxrEmail2" class="form-control" /></td>
                        <td class="formTitle">Địa chỉ người liên hệ thứ hai</td>
                        <td colspan="3" class="formValue">
                            <input type="text" id="lxrdz2" class="form-control" style="width:101%" />
                            @*<textarea id="lxrdz2" cols="20" class="form-control" rows="1"></textarea>*@
                        </td>
                    </tr>
                </table>
                @Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
           {
               ShowKeyList = new int[] { 4, 6, 7, 8, 9 },
               F6Text = "Vòng tay",
               F7Text = "In thông tin nhập viện",
               F9Text = "Hủy nhập viện"

           })
    </form>
</body>
</html>


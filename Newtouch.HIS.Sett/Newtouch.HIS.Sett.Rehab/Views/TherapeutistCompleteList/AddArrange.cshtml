
@{
    ViewBag.Title = "AddArrange";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<form id="form1">
    <div style="padding-right:30px">
        <table class="form">
            <tr>
                <td class="formTitle">Mã nhân viên</td>
                <td class="formValue">
                    <input type="text" id="xm" class="form-control" />
                </td>
                <td class="formTitle">Họ tên</td>
                <td class="formValue">
                    <input type="text" id="xm" class="form-control newtouch_Readonly" />
                </td>
            <tr>
                <td class="formTitle">
                    Giới tính
                </td>
                <td class="formValue">
                    <div class="btn-group formValue" data-toggle="buttons">
                        <label class="btn btn-default" disabled>
                            <input type="radio" checked="checked" id="xb" value="1" name="xb" class="form-control" />Nam
                        </label>
                        <label class="btn btn-default" disabled>
                            <input type="radio" id="xb" value="0" name="xb" class="form-control" />Nữ
                        </label>
                    </div>
                </td>
                <td class="formTitle">Năm</td>
                <td class="formValue">
                    <select id="Cl" class="form-control">
                        <option value="-1">===Vui lòng chọn===</option>
                        <option value="PT">2015</option>
                        <option value="OT">2016</option>
                        <option value="ST" selected="selected">2017</option>
                    </select>
                </td>

            </tr>
            <tr>
                <td class="formTitle">Tháng</td>
                <td class="formValue">
                    <select id="Cl" class="form-control">
                        <option value="-1">===Vui lòng chọn===</option>
                        <option value="PT">1</option>
                        <option value="OT">2</option>
                        <option value="ST">3</option>
                        <option value="ST" selected="selected">4</option>
                        <option value="ST">5</option>
                        <option value="ST">6</option>
                    </select>
                </td>
                <td class="formTitle">Số ngày</td>
                <td class="formValue">
                    <input type="text" id="xm" class="form-control" />
                </td>
            </tr>

        </table>
    </div>

</form>


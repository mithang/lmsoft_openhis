
@{
    ViewBag.Title = "moreInfo";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<script>
    $(function () {
        gridList([]);
    });
    //Liên kết grid
    function gridList(mydata) {
        var $gridList = $("#gridList");
        $gridList.dataNewGrid({
            height: 130,
            shrinkToFit: true,
            unwritten: false,
            colModel: [
                 //{ label: "Khóa chính", name: "patid", hidden: true, key: true },
                { label: "Khóa chính", name: "patid", hidden: true },
                { label: 'Hạng mục thay thế', name: 'dlmc', width: 100, align: 'left', editor: "text" },
                { label: 'Hạng mục điều trị', name: 'sfxmmc', width: 300, align: 'left', editor: "text" },
                { label: 'Số lượng', name: 'dw', width: 100, align: 'left', editor: "text" },
                { label: 'Đơn giá', name: 'dj', width: 100, align: 'left', editor: "text" },
                { label: 'Số tiền', name: 'dj', width: 100, align: 'left', editor: "text" },
                { label: 'Thời gian', name: 'zfbl', width: 100, align: 'left', editor: "text" },
                { label: 'Nhà trị liệu', name: 'sl', width: 100, align: 'left', editor: "text" },
                { label: 'Thời gian bắt đầu', name: 'je', width: 100, align: 'left', editor: "text" }
            ]
        }, mydata);

        if (mydata.length > 0) {
            $('.ui-jqgrid-bdiv').find(".unwritten").remove();
        }
    }
</script>
<form id="form1" class="form">
    <div class="rows" style="margin-bottom: 1%; margin-top:5px;" id="HosBasicInfo">
        <div class="panel panel-default">
            <div class="panel-heading">
                Thông tin bệnh nhân
            </div>
            <table>
                <tr>
                    <td class="formTitle">
                        Số thẻ:
                    </td>
                    <td class="formValue">
                        <input type="text" id="kh" class="form-control newtouch_Readonly" value="C1221" />
                    </td>
                    <td class="formTitle">
                        Số nhập viện:
                    </td>
                    <td class="formValue">
                        <input type="text" id="zyh" class="form-control newtouch_Readonly" value="164193" />
                    </td>
                    <td class="formTitle">
                        Tính chất bệnh nhân:
                    </td>
                    <td class="formValue">
                        <input type="text" id="brxzmc" class="form-control newtouch_Readonly" value="自费" />
                    </td>
                </tr>
                <tr>
                    <td class="formTitle">
                        Trạng thái:
                    </td>
                    <td class="formValue">
                        <input type="text" id="zybz" class="form-control newtouch_Readonly" value="出院" />
                    </td>
                    <td class="formTitle">Họ tên:</td>
                    <td class="formValue">
                        <input type="text" id="xm" class="form-control newtouch_Readonly" value="张三" />
                    </td>
                    <td class="formTitle">Giới tính:</td>
                    <td>
                        <div class="btn-group formValue" data-toggle="buttons">
                            <label class="btn btn-default" disabled>
                                <input type="radio" checked="checked" id="xb" value="1" name="xb" class="form-control" />Nam
                            </label>
                            <label class="btn btn-default" disabled>
                                <input type="radio" id="xb" value="0" name="xb" class="form-control" />Nữ
                            </label>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td class="formTitle">Ngày sinh:</td>
                    <td class="formValue">
                        <input class="form-control newtouch_Readonly" disabled readonly="readonly" type="text" value="1993-05-02" id="csny" />
                    </td>
                    <td class="formTitle">Khoa hiện tại:</td>
                    <td class="formValue">
                        <input type="text" id="ksmc" class="form-control newtouch_Readonly" disabled="disabled" value="内一科" />
                    </td>
                    <td class="formTitle">Số giường bệnh:</td>
                    <td class="formValue">
                        <input type="text" id="cw" class="form-control newtouch_Readonly" disabled="disabled" value="34" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="rows" id="BookKeep" style="margin-bottom: 10px;">
        <div class="panel panel-default">
            <div class="panel-heading">
                Thông tin điều trị
            </div>
            <table>
                <tr>
                    <td class="formTitle">Hạng mục thay thế</td>
                    <td class="formValue"><input type="text" id="tdxm" class="form-control newtouch_Readonly" value="理疗" /></td>
                    <td class="formTitle">
                        Hạng mục điều trị:
                    </td>
                    <td class="formValue">
                        <input type="text" id="sfxm" class="form-control newtouch_Readonly" value="运动" />
                    </td>
                    <td class="formTitle">
                        Số lượng:
                    </td>
                    <td class="formValue">
                        <input type="text" id="sl" class="form-control newtouch_Readonly" value="1" />
                    </td>
                </tr>
                <tr>
                    <td class="formTitle">
                        Đơn giá: (tệ/lần)
                    </td>
                    <td class="formValue">
                        <input type="text" id="dj" class="form-control newtouch_Readonly" value="80" />
                    </td>
                    <td class="formTitle">
                        Nhà trị liệu:
                    </td>
                    <td class="formValue">
                        <input type="text" id="doctor" class="form-control newtouch_Readonly" value="童咪咪" />
                    </td>
                    <td class="formTitle">
                        Thời gian bắt đầu:
                    </td>
                    <td class="formValue">
                        <input id="jzrq" type="text" class="form-control input-wdatepicker newtouch_Readonly"
                               value="2017-03-17" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" style="width: 115%" />
                    </td>
                </tr>
                <tr>
                    <td class="formTitle">
                        Thời gian: (phút)
                    </td>
                    <td class="formValue">
                        <input type="text" id="sl" class="form-control newtouch_Readonly" value="20m" />
                    </td>
                    <td class="formTitle"></td>
                    <td class="formValue"></td>
                </tr>
            </table>
        </div>
    </div>
</form>


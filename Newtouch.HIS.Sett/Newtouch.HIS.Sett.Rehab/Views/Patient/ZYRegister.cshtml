                var resultObjArr = new Array();
                $.each(top.window.newtouchclients.sysStaffDutyList, function (idx, val) {
                    if (((val.StaffPY && val.StaffPY.indexOf(keyword.toLowerCase()) >= 0) || keyword.trim() == "")

    function ClearAll() {
        AbledSysBasicInfo();
        newtouch_globalevent_f4();
    }

    function newtouch_globalevent_f6() {
        PrintWDInfo();
    }

    function newtouch_globalevent_f7() {
        PrinyZYInfo();

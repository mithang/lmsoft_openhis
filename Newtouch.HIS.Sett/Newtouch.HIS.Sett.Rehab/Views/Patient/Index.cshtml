@{
    ViewBag.Title = "Tra cứu bệnh nhân";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<!DOCTYPE html>
<script>
    $(function () {
        gridList();
        $('.menuItem').on('click', window.parent.$.Newtouchtab.addTab);
    });
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/Patient/GetGridJson",
            height: $(window).height() - 128,
            colModel: [
                { label: "Khóa chính", name: "patid", hidden: true, key: true },
                { label: 'Số thẻ', name: 'CardNo', width: 100, align: 'left' },
                { label: 'Tính chất bệnh nhân', name: 'brxzmc', width: 100, align: 'left' },
                { label: 'Số bệnh án', name: 'blh', width: 100, align: 'left' },
                { label: 'Họ tên', name: 'xm', width: 50, align: 'left' },
                { label: 'Trình độ học vấn', name: 'xl', width: 50, align: 'left' },
                {
                    label: 'Giới tính', name: 'xb', width: 50, align: 'left',
                    formatter: function (cellvalue) {
                        if (cellvalue == "0") {
                            return "Nữ";
                        } else if (cellvalue == "1") {
                            return "Nam";
                        } else {
                            return "";
                        }
                    }
                },
                { label: 'Phiên âm', name: 'py', width: 100, align: 'left' },
                {
                    label: 'Năm tháng sinh', name: 'csny', width: 80, align: 'left',
                    formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' }
                },
                {
                    label: 'Loại giấy tờ', name: 'zjlx', width: 50, align: 'left',
                    formatter: function (cellvalue) {
                        if (cellvalue) {
                            if (cellvalue.trim() == "1") {
                                return "Chứng minh nhân dân";
                            } else if (cellvalue.trim() == "2") {
                                return "Hộ chiếu";
                            } else if (cellvalue.trim() == "3") {
                                return "Chứng nhận sĩ quan";
                            } else {
                                return "Khác";
                            }
                        }
                        return "";
                    }
                },
                 { label: 'Số giấy tờ', name: 'zjh', width: 150, align: 'left' },
                 { label: 'Tuổi', name: 'nl', width: 50, align: 'left' },
                 { label: 'Điện thoại', name: 'dh', width: 100, align: 'left' },
                 { label: 'Người liên hệ khẩn cấp', name: 'jjllr', width: 100, align: 'left' },
                 { label: 'Điện thoại người liên hệ', name: 'jjlrdh', width: 100, align: 'left' },
                 { label: 'CreateTime', name: 'CreateTime', hidden: true },

            ],
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            rowNum: '10',
            viewrecords: true
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword").val() },
            }).trigger('reloadGrid');
        });
    }
    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "Đăng ký nhập viện",
            url: "/PatientManage/HospiterRes/Register",
            width: "700px",
            height: "530px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_edit() {
        var keyValue = $("#gridList").jqGridRowValue().patid;
        $.modalOpen({
            id: "Details",
            title: "Xem thông tin cơ bản",
            url: "/PatientManage/HospiterRes/Register?keyValue=" + keyValue,
            width: "1200px",
            height: "700px",
            btn: null,
        });
    }
</script>
<html>
<head>
    <title></title>
</head>
<body>
    <div class="topPanel">
        <div class="toolbar">
            <div class="btn-group">
                <a id="NF-add" class="menuItem btn btn-primary" data-id="Register" href="/PatientManage/HospiterRes/Register"><i class="fa fa-plus"></i>Đăng ký nhập viện</a>
            </div>
            <div class="btn-group">
                <a id="NF-add" class="menuItem btn btn-primary" data-id="Register" href="/PatientManage/HospiterRes/Register"><i class="fa fa-plus"></i>Đăng ký ngoại trú</a>
            </div>
        </div>
        <div class="search">
            <table>
                <tr>
                    <td>
                        <div class="input-group">
                            <input id="txt_keyword" type="text" class="form-control" placeholder="Vui lòng nhập từ khóa cần tra cứu" style="width: 160px;">
                            <span class="input-group-btn">
                                <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                            </span>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>

</body>
</html>

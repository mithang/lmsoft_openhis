@{
    ViewBag.Title = "Thông tin cơ bản bệnh nhân";
}
<style>
    .MorePatientDetail {
        display: none;
    }

    .th_Required {
        position: relative;
    }

        .th_Required span {
            position: absolute;
            top: 11px;
            margin-left: 2px;
            color: red;
        }

        .th_Required input {
            float: left;
            width: 90%;
        }

        .th_Required select {
            float: left;
            width: 90%;
        }
</style>

<form name="form" style="margin:2px;">
    <table class="form MorePatientDetail" style="border-top: solid #DDDDDD 1px;">
        <tr>
            <th class="formTitle">Họ tên:</th>
            <td class="formValue th_Required">
                <input type="text" id="txtxm" name="txtxm" class="form-control" value="张三" />
                <span>*</span>
            </td>
            <th class="formTitle">Giới tính:</th>
            <td class="formValue th_Required">
                <div class="btn-group formValue" data-toggle="buttons">
                    <label class="btn btn-default">
                        <input type="radio" value="1" name="radio_xb" checked class="form-control " />Nam
                    </label>
                    <label class="btn btn-default" disabled>
                        <input type="radio" value="0" name="radio_xb" class="form-control " />Nữ
                    </label>
                </div>
                <span>*</span>
            </td>
            <th class="formTitle">Ngày sinh:</th>
            <td class="formValue">
                <input id="txtcsny" type="text" class="form-control input-wdatepicker " onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" value="1988-08-12" />
            </td>
            <th class="formTitle">Tuổi:</th>
            <td class="formValue">
                <input id="txtnl" type="text" class="form-control input-wdatepicker " onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
            </td>
            <th class="formTitle">Tính chất bệnh nhân:</th>
            <td class="formValue th_Required">
                <input type="text" id="brxz" name="brxz" class="form-control" value="自费">
                <span>*</span>
            </td>
        </tr>
        <tr>
            <th class="formTitle">Loại giấy tờ:</th>
            <td class="formValue">
                <select id="zjlx" class="form-control">
                    <option value="">==Vui lòng chọn==</option>
                    <option value="0" selected="selected">Chứng minh nhân dân</option>
                    <option value="1">Hộ chiếu</option>
                    <option value="2">Chứng nhận sĩ quan</option>
                </select>
            </td>
            <th class="formTitle">Số giấy tờ:</th>
            <td class="formValue th_Required">
                <input type="text" id="zjh" name="zjh" class="form-control" value="362232198808120844">
                <span>*</span>
            </td>
            <th class="formTitle">Trạng thái:</th>
            <td class="formValue th_Required">
                <input type="text" id="txtzt" name="txtzt" class="form-control" value="在院">
                <span>*</span>
            </td>
            <th class="formTitle">Chẩn đoán:</th>
            <td class="formValue">
                <input type="text" class="form-control " id="txtbingz" name="txtbingz" />
            </td>
            <th class="formTitle">Thời hạn hiệu lực:</th>
            <td class="formValue">
                <input type="text" id="txtyxq" class="form-control input-wdatepicker newtouch_Readonly" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
            </td>
        </tr>
        <tr>
            <th class="formTitle">Khu vực:</th>
            <td class="formValue">
                <select class="form-control" id="dy">
                    <option value="">==Vui lòng chọn==</option>
                    <option value="0">Địa phương</option>
                    <option value="1">Ngoại tỉnh</option>
                </select>
            </td>
            <th class="formTitle">Phương thức liên hệ:</th>
            <td class="formValue">
                <select id="zjlxfs" class="form-control">
                    <option value="">==Vui lòng chọn==</option>
                    <option value="0">Không</option>
                    <option value="1">Điện thoại</option>
                    <option value="2">Điện thoại di động</option>
                    <option value="3">WeChat</option>
                    <option value="4">Email</option>
                </select>
            </td>
            <th class="formTitle">Tình trạng hôn nhân:</th>
            <td class="formValue th_Required">
                <select id="hf" name="hf" class="form-control">
                    <option value="">==Vui lòng chọn==</option>
                    <option value="0">Chưa kết hôn</option>
                    <option value="1">Đã kết hôn</option>
                </select>
                <span>*</span>
            </td>
        </tr>
    </table>
    <div style="background-color:#fcfcfc; color:#00a0ea; height:15px; width:100%; text-align: center;"><i id="imoretag" tag="s" class="fa fa-angle-double-down" style="color:rgb(0, 160, 233);cursor:pointer; "></i></div>
</form>
<script src="~/Content/js/PatientManage/ShowPatientInfo.js"></script>
<script>
    $(function () {

        BindItemData();
    });

</script>
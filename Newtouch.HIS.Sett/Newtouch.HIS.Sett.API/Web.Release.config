<?xml version="1.0" encoding="utf-8"?>

<!-- về việc sử dụng web.config thông tin chi tiết về chuyển đ ổi,vui lòng truy cập http://go.microsoft.com/fwlink/?Linkid=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
 trong ví dụ dư ới đ ây,"SetAttributes"Chuyển đ ổi sẽ thay đ ổi 
 "connectionString"của, chỉ khi"Match"Bộ đ ịnh vị 
 tìm thấy giá trị là"MyDB"Của thuộc tính"name"Giờ sử dụng"ReleaseSQLServer".
 
 <connectionStrings>
 <add name="MyDB" 
 connectionString="Data Source=ReleaseSQLServer;Initial Catalog=MyReleaseDB;Integrated Security=True" 
 xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
 </connectionStrings>
 -->
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <!--
 
 trong ví dụ dư ới đ ây,"Replace"Chuyển đ ổi sẽ thay thế 
 web.config toàn bộ tệp <customErrors> mục.
 Xin lưu ý, do 
 tại <system.web> nút dư ới chỉ có một customErrors mục,vì vậy không cần sử dụng"xdt:Locator"Thuộc tính.
 
 <customErrors defaultRedirect="GenericError.htm"
 mode="RemoteOnly" xdt:Transform="Replace">
 <error statusCode="500" redirect="InternalError.htm"/>
 </customErrors>
 -->
  </system.web>
</configuration>
<body style="overflow: hidden;">
    <form id="form1" style="overflow: hidden;">

        <div class="login">
            @*         <div id='login_db' style='position: absolute; right: 10px; top: 10px; height: 100px; width: 200px; z-index: 1000; color: Red; font-size: 50px;'></div>*@

            <div class="login-head">
                <div class="login-head-a">
                    <img src="~/Content/img/NewTouch.png" title="" alt="" />
                </div>
                <div style="color:black;float:right;margin-right:20px;margin-top:5px;">@loginybshowcode<br />@loginybshowname</div>
            </div>
            <div class="login-con">
                <div class="login-a">
                    <div class="login-b">
                        <div class="login-b-a">
                            <a class="lo_mod tab_on">欢迎登录</a>

                        </div>
                        <div class="login-b-b">
                            <ul>

                                <li>
                                    <label for="userName" class="ui-label">
                                        <span class="ui-icon ui-icon-userDEF">
                                        </span>
                                    </label>
                                    <input id="txt_account" value="" type="text" placeholder="Đăng nhập tài khoản">
                                </li>
                                <li>
                                    <label for="userName" class="ui-label"><span class="ui-icon-ysh ui-icon-userDEF"></span></label>
                                    <input id="txt_password" value="" type="password" placeholder="登录密码">
                                </li>
                                @{
                                    if (isCheckChkCode)
                                    {
                                        <li>
                                            <input id="txt_code" type="text" placeholder="验证码" style="width: 130px;float:left;">
                                            <div style="width: 120px; float: left; padding-top: -15px; padding-left: 14px;">
                                                <img id="imgcode" class="authcode" src="~/Login/GetAuthCode" width="50" height="25" />
                                                <a id="switchCode" href="javascript:void(0);" style="text-decoration: none;">Tờ một đổi</a>
                                            </div>
                                        </li>
                                    }
                                }
                                <li class="login-x">
                                    <div class="login-x-a">
                                        <button id="login_button" type="button" style="background-color:#3b9df0;color:white">
                                            <span>Đăng nhập</span>
                                        </button>
                                    </div>
                                </li>
                            </ul>
                            <div class="login_tips"></div>
                        </div>
                    </div>
                </div>
            </div>
             <div class="login-foot" style="left:0px;width:100%;text-align:center;font-size:20px;bottom:20px;color:#9BA0A8">
                <span>
                    Copyright © 2025湖北天天数链技术有限公司
                    本系统软件源代码许可来源于<a href="https://open.tntlinking.com/communityTreaty" style="color:#9BA0A8">《天天开源软件（社区版）许可协议》</a>
                </span>
            </div>
        </div>
        <script type="">
            var s;//窗体分辨率自适应
            function resize() {
                s = window.screen.width / 1920;
                document.body.style.transformOrigin = '';
                document.body.style.transform = '' + s + '' + s + '';
                document.body.style.width = window.innerWidth / s + '';
                document.body.style.height = window.innerHeight / s + '';
            }
            window.onresize = function () {
                resize();
            }
            resize();
            (function ($) {
                $.login = {
                    formMessage: function (msg) {
                        $('').find('').remove();
                        $('').append('' + msg + '');
                    },
                    loginClick: function () {
                        var $username = $("");
                        var $password = $("");
                        var $code = $("");
                        if ($username.val() == "") {
                            $username.focus();
                            $.login.formMessage('');
                            return false;
                        } else if ($password.val() == "") {
                            $password.focus();
                            $.login.formMessage('');
                            return false;
                        } else if ($code.val() == "") {
                            $code.focus();
                            $.login.formMessage('');
                            return false;
                        } else {
                            $("").attr('', '').find('').html("");
                            $.ajax({
                                url: "",
                                data: { username: $username.val(), password: $.md5($password.val()), code: $code.val() },
                                type: "",
                                dataType: "",
                                success: function (data) {
                                    if (data.state == "") {
                                        $("").find('').html("");
                                        window.setTimeout(function () {
                                            window.location.href = "";
                                        }, 10);
                                    } else {
                                        $("").removeAttr('').find('').html("");
                                        $("").trigger("");
                                        $code.val('');
                                        $.login.formMessage(data.message);
                                    }
                                }
                            });
                        }
                    },
                    init: function () {
                        $('').height($(window).height());
                        $("").css("", ($(window).height() - $("").height()) / 2 - 50);
                        $(window).resize(function (e) {
                            $('').height($(window).height());
                            $("").css("", ($(window).height() - $("").height()) / 2 - 50);
                        });
                        $("").click(function () {
                            $("").attr("", "" + Math.random());
                        });
                        var loginErrorKey = "";
                        var appId = '';
                        if (appId) {
                            loginErrorKey = appId + "" + loginErrorKey;
                        }
                        document.cookie = appId + ''
                        var login_error = top.$.cookie(loginErrorKey);
                        if (login_error != null) {
                            switch (login_error) {
                                case "":
                                    $.login.formMessage("");
                                    break;
                                case "":
                                    $.login.formMessage("");
                                    break;
                                case "":
                                    $.login.formMessage("");
                                    break;
                            }
                            top.$.cookie(loginErrorKey, '', { path: "", expires: -1 });
                        }
                        $("").click(function () {
                            $.login.loginClick();
                        });
                        document.onkeydown = function (e) {
                            if (!e) e = window.event;
                            if ((e.keyCode || e.which) == 13) {
                                document.getElementById("").focus();
                                document.getElementById("").click();
                            }
                        }
                        $('').keyup(function () {
                            $.login.formMessage('');
                        });
                    }
                };
                $(function () {
                    $.login.init();
                });
            })(jQuery);
        </script>
    </form>

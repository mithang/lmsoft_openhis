
@{
    ViewBag.Title = "";
    Layout = "";
}


<div class="topPanel">
    @Html.Partial("")
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()" id="bedata"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keywordcx" type="text" class="form-control" placeholder="Tên/Mã" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_searchcx" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

@*, OrganizeId: $("").val()*@

<script>
    $(function () {
        gridList();
    })
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            height: $(window).height() - 128,
            postData: { keyword: $("").val(),OrganizeId:$("").val() },
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: '', name: '', width: 150, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 60, align: '' },
                { label: '', name: '', width: 170, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '', formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 } },
                { label: '', name: '', width: 120, align: '' },
                { label: '', name: '', width: 100, align: '', hidden: true },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
            ],

            pager: "",
            viewrecords: true,
            sortname: '',
            gridview: true,
            grouping: true,// 是否分组,Mặc định làfalse
            groupingView: {
                groupField: [''], // 按照哪一列进行分组
                //groupText: [''],
                groupColumnShow: [false],
            },
            rowNum: '',
            unwritten: false,
        });
        $("").click(function () {
            $("").jqGrid('', {
                postData: { keyword: $("").val(), OrganizeId: $("").val() },
            }).trigger('');
        });
    }
    $('').keydownEnterEvent(function () {
        $('').trigger('');
    })

    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + $('').val(),
            width: "",
            height: "",
            btn: null
        });
    }

    function btn_edit() {
        var keyValue = $("").jqGridRowValue().zhcode;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue+"" + $('').val(),
            width: "",
            height: "",
            btn: null
        });
    }

    function btn_delete() {

        var rowKey = $("").jqGrid('', "");
        var rowData = $("").jqGrid("", rowKey);//Theo nội dung trênrowKeyLấy tất cả dữ liệu của dòng này
        var zhcode = rowData.zhcode; //获得制定列的值 （ReservationTimeChocolModelcủaname）


        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.deleteForm({
            url: "",
            param: { keyValue: zhcode ,orgId:$('').val()},
            success: function () {
                $("").jqGrid('', {
                    postData: { keyword: $("").val(), OrganizeId: $("").val() },
                }).trigger('');
            }
        })
    }
</script>




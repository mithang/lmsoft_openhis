@using Newtouch.Infrastructure;
@{
    /**/

    //Có giao dịch với BHYT hay không
    var openYbSett = SysConfigReader.Bool("Outpatient_ChargeFee_OpenYbSett");
    var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
    //Nơi thuộc BHYT，Phân biệt hệ thống sẽ thực hiện logic BHYT ở đâu
    var medicalInsurance = SysConfigReader.String("Outpatient_MedicalInsurance");
    //Loại chứng từ khám bệnh có lấy từ phía BHYT hay không
    var YB_Jzpzl = SysConfigReader.String("YB_Jzpzl");
}
@if (openYbSett == true)
{
<div id="readCard" style="color:orangered;display:none;width:200px">
    @*<input type="button" id="btkhsr" value="Số giấy tờNhập" class="form-control" style="border-color:#00a0e9; margin-left: 0px;margin-top: 2px; height: 22px;width:44px;padding-left:0px; float: left;vertical-align:central;" onclick="GetPatSbkh()" />*@
    <i class="fa fa-id-card" style="font-size: 27px; float: left;vertical-align:central;" title="Đọc thẻ"></i>
    <select id="readCardCardType" class="form-control" style="margin-left: 0px;margin-top: 2px; height: 22px;width:70px;float: left;vertical-align:central;">
        @if (openYbSett == true)
        {
            <option value="2">Thẻ BHYT</option>
            <option value="3">Chứng từ điện tử</option>
            <option value="6">Quét mặt</option>
        }
        <option value="4">Chứng minh nhân dân</option>
        @*<option value="1">Thẻ từ tự trả</option>
            <option value="0">Thẻ từ thử nghiệm</option>*@
    </select>
    <input id="ckzddzsm" type="checkbox"  /><label for="zddzsm">(终端)扫码</label>
</div>
   
}

<script>
    var ybkCardType = "@((int)EnumCardType.YBJYK)";
    var medicalInsurance = '@medicalInsurance';
    var cqPatInfo = {};//Bệnh nhânĐọc thẻThông tin，confirmformSử dụng
    var errmsg = "";//Nhắc lỗi đọc thẻ
    var brxzobj = { brxz: "1", brxzmc: "Thông thườngBảo hiểm y tế" };
    $('#readCard i').click(function () {
         $.loading(true, 'ĐangTrongĐọc thẻ，Vui lòng đợi…');
         setTimeout("readCard();", 50);
     });
    $("#readCard").show();
     //Đọc thẻ
    function readCard(khxx) {
         switch (medicalInsurance) {
             case "shanghai":
                 if (!khxx && $('#readCardCardType').val() != "2") {
                     $.loading(false);
                     klxchoose();
                 } else {
                     GetSHReadCardIno(khxx);
                 }
                 break;
             case "tongyong"://Sử dụng chung BHYT quốc gia
                 var khxx = { "sbkh": "", "sfzh": "", "name": "", "ecToken": "" };
                 if ($('#readCardCardType').val() == "4") {
                     $.loading(false);
                     GetPatSfzh();
                 } else {
                     GetReadCardInfo(khxx);
                 }

                 break;
             default:
                 $.modalAlert("Nơi thuộc BHYTChưa设置，Vui lòng设置后再进DòngQuẹt thẻ", 'warning');
                 return;
         }
     }

     function GetSHReadCardIno(khxx)
     {
         var yibaoCardInfo;
         var sm01Info;
         var jzpzlx = $('#readCardCardType').val();
         var url ="http://127.0.0.1:33333/api/FifthPhaseYiBao/ybInterface_S000";
         var payoptype = { "cardtype": "1","orgId":'@(opr.OrganizeId)', "operatorId": '@(opr.rygh)', "operatorName": '@(opr.UserName)', "businessType": "01101", "officeId": "0201", "officeName": "Trong科" };
         if (jzpzlx=="0") {//Thẻ từ
             payoptype.cardtype = "0";
             payoptype.carddata = khxx.sbkh;
             url = "http://127.0.0.1:33333/api/FifthPhaseYiBao/ybInterface_SM01";
         }
         if (jzpzlx == "2") {//Thẻ bảo đảm
             payoptype.cardtype = "1";
         }
         if (jzpzlx == "3") {//Chứng từ điện tử
             payoptype.cardtype = "3";
             payoptype.carddata = khxx.sbkh;
             payoptype.ecQrCode = khxx.sbkh;
             payoptype.ecQrChannel = "1";
             url = "http://127.0.0.1:33333/api/FifthPhaseYiBao/ybInterface_SE01";
         }
         if (jzpzlx == "4") {//Chứng minh nhân dân cho đến hiện tại chỉ có thể dùng BHYT quốc gia
             payoptype.sfzh = khxx.sbkh;
             GetReadCardInfo(payoptype);
             return;
         }
         if (jzpzlx == "1") {
             $.loading(false);
             cqPatInfo.jzlx = jzpzlx;
             yibaoCardInfo = {kh:""};
             yibaoCardInfo.kh = khxx.sbkh;
             yibaoCardInfo.jzlx = jzpzlx;
             ReadCardCall({ yibaoCardInfo: yibaoCardInfo, ybkCardType: jzpzlx });
             return;
         }
         $.ajax({
             type: "POST",
             url: url,
             dataType: "json",
             data: payoptype,
             async: false,
             success: function (data) {
                 yibaoCardInfo = eval('(' + data + ')');
             },
             error: function (request, error, ex) {
                 errmsg = "Dịch vụ BHYT đọc thẻ không thể truy cập：[" + ex + "]";
             }
         });
         if (yibaoCardInfo) {
             if (yibaoCardInfo.xxfhm === "P001") {
                 sm01Info = yibaoCardInfo.sm01;//Tài khoảnThông tin(s000 、se01 、sm01)
                 cqPatInfo.xm = sm01Info.xm;
                 cqPatInfo.sfzh = sm01Info.sfzh;
                 cqPatInfo.xzqh = sm01Info.xzqh;
                 cqPatInfo.cblb = sm01Info.accountattr;
                 cqPatInfo.ecToken = sm01Info.ecToken;
                 cqPatInfo.sbkh = sm01Info.cardid;
                 cqPatInfo.accountattr = sm01Info.accountattr;
                 if (jzpzlx=="3") {
                     cqPatInfo.carddata = sm01Info.ecToken;
                 }
                 else if (jzpzlx == "0"||jzpzlx == "4") {
                     cqPatInfo.carddata = khxx.sbkh;
                 }
                 else {
                     cqPatInfo.carddata = "";
                 }
                 cqPatInfo.kh = sm01Info.kh;
                 var bkbz = sm01Info.accountattr.substr(11, 1);//Trợ giúp khó khăn G, A
                 var gbbz = sm01Info.accountattr.substr(1, 1);//Bảo hiểm cán bộ 1
                 var resultObjArr = new Array();
                 if (bkbz == "G" || bkbz == "A" || gbbz == "1") {
                     cqPatInfo.ybVer = "shanghaiV5";
                     cqPatInfo.cardtype = payoptype.cardtype;
                     cqPatInfo.jzlx = jzpzlx;
                     getbrxz(bkbz);
                     yibaoCardInfo.brxzdm = brxzobj.brxz;
                     yibaoCardInfo.brxzmc = brxzobj.brxzmc;
                     yibaoCardInfo.readCardCardType = jzpzlx;
                     yibaoCardInfo.kh = sm01Info.kh;
                     yibaoCardInfo.qtjz = jzpzlx != "1" ? cqPatInfo.sfzh : null;
                     yibaoCardInfo.ybVer = "shanghaiV5";
                     yibaoCardInfo.jzlx = jzpzlx;
                     ReadCardCall({ yibaoCardInfo: yibaoCardInfo, ybkCardType: jzpzlx });
                 }
                 else {
                     GetReadCardInfo(cqPatInfo);
                 }


             } else {
                 $.loading(false);
                 $.modalAlert("Dịch vụ BHYT(LấyBảo hiểm y tếTrung tâmThông tin bệnh nhânThất bại):" + yibaoCardInfo.fhxx, 'error');
             }
         } else {
             $.loading(false);
             $.modalAlert(errmsg, 'error');
         }
     }

    function getbrxz(brlx)
    {
        $.ajax({
            url: "/PatientManage/HospiterRes/GetBrxzbyxzlx",
            data: { xzlx: brlx },
            dataType: "json",
            async: false,
            cache: false,
            success: function (data) {
                if (!!data) {
                    $.each(data, function (idx, val) {
                        if (val.insutype && val.insutype == brlx) {
                            brxzobj.brxz = val.brxz;
                            brxzobj.brxzmc = val.brxzmc;
                        }
                    });
                }
                return brxzobj;
            },
            error: function (request, error, ex) {
                return brxzobj;
            }
        });

    }

     //Đọc thẻ LấyNhân viênThông tin
    function GetReadCardInfo(sbkobj) {
        debugger;
         var cardInfo1;
         var cardInfo2;
         var cardInfo3;
         var yibaoCardInfo;
         var patsbkh = null;
         var jzpzlx = $('#readCardCardType').val();
         var payoptype = { "mdtrt_cert_type": "02", "mdtrt_cert_no": sbkobj.sfzh, "operatorId": '@(opr.rygh)', "operatorName": '@(opr.UserName)', "businessType": "01101", "officeId": "0201", "officeName": "口腔科" };
         var url = "http://127.0.0.1:33333/api/YiBao/CardecInfo_1161";

        if (jzpzlx === "6") {//Quét mặt
            url = "http://127.0.0.1:33333/api/YiBao/CardecInfo_1164";
        }
        else if (jzpzlx === "4") {//Chứng minh nhân dân
            payoptype.mdtrt_cert_type = "02";
            payoptype.mdtrt_cert_no = sbkobj.sfzh;
            payoptype.psn_name = sbkobj.name;
            url = "http://127.0.0.1:33333/api/YiBao/CardecInfo_1163";
        }
        else if (jzpzlx === "3") {//Chứng từ điện tử
            //payoptype.mdtrt_cert_type = "01";
            //payoptype.mdtrt_cert_no = sbkobj.ecToken;
            //payoptype.psn_cert_type = "01";//Chứng minh nhân dân
            //payoptype.certno = sbkobj.sfzh;
            //payoptype.psn_name = sbkobj.xm;
            if ($('#ckzddzsm').is(':checked'))
                url = "http://127.0.0.1:33333/api/YiBao/CardecInfo_1162";
            else
                url = "http://127.0.0.1:33333/api/YiBao/CardecInfo_1162A";
        }
        else if (jzpzlx === "0") {
            payoptype.mdtrt_cert_type = "00";
            payoptype.mdtrt_cert_no = sbkobj.carddata;
        }

         if (jzpzlx === "1") {//Thẻ trong viện
             $.loading(false);
             $.modalAlert("院Trong卡Đọc thẻ接口Chưa开通", 'error');
         }
         else {
             $.ajax({
                 type: "POST",
                 url: url,
                 dataType: "json",
                 data: payoptype,
                 async: false,
                 success: function (data) {
                     yibaoCardInfo = eval('(' + data + ')');
                 },
                 error: function (request, error, ex) {
                     errmsg = "Dịch vụ BHYT đọc thẻ không thể truy cập：[" + ex + "]";
                 }
             });debugger
             if (yibaoCardInfo) {
                 if (yibaoCardInfo.infcode == "0" || yibaoCardInfo.infcode === 0) {
                     if (!yibaoCardInfo || !yibaoCardInfo.output.baseinfo || !yibaoCardInfo.output.insuinfo[0]) {
                         $.modalAlert("Đọc thẻThất bại:" + yibaoCardInfo.err_msg, 'error');
                         return;
                     }
                     if ('@YB_Jzpzl' === 'ON') {
                         var cardecinfo = yibaoCardInfo.output.cardecinfo;
                         switch (cardecinfo.mdtrt_cert_type) {
                             case "01"://Chứng từ điện tử
                                 jzpzlx = '3';
                                 payoptype.mdtrt_cert_type = "01";
                                 payoptype.mdtrt_cert_type = cardecinfo.mdtrt_cert_type;
                                 break;
                             case "02"://Chứng minh nhân dân
                                 jzpzlx = '4';
                                 break;
                             case "03"://Thẻ bảo hiểm xã hội
                                 jzpzlx = '2';
                                 sbkobj.sbkh = cardecinfo.mdtrt_cert_no;
                                 payoptype.mdtrt_cert_type = cardecinfo.mdtrt_cert_type;
                                 break;
                         }
                     }
                     cardInfo1 = yibaoCardInfo.output.baseinfo; //Bảo hiểm y tếThông tin cơ bản
                     if (yibaoCardInfo.output.insuinfo.length > 1)
                     {
                         for (var i = 0; i < yibaoCardInfo.output.insuinfo.length;i++) {
                             if (yibaoCardInfo.output.insuinfo[i].paus_insu_date)
                                 continue;
                             else {
                                 cardInfo2 = yibaoCardInfo.output.insuinfo[i];
                                 break;
                             }
                         }
                     } else
                         cardInfo2 = yibaoCardInfo.output.insuinfo[0];//Thông tin tham gia bảo hiểm
                     if (jzpzlx !== "3") {
                         cardInfo3 = yibaoCardInfo.output.cardecinfo;//Thông tin thẻ
                         cqPatInfo.sbkh = sbkobj.sbkh;
                     }
                     if (jzpzlx == "3") {
                         cardInfo3 = yibaoCardInfo.output.cardecinfo;//Thông tin thẻ
                         cqPatInfo.ecToken = cardInfo3.ecToken;
                     }
                     getbrxz(cardInfo2.insutype);
                     yibaoCardInfo.brxzdm = brxzobj.brxz;
                     yibaoCardInfo.brxzmc = brxzobj.brxzmc;

                     cqPatInfo.xm = cardInfo1.psn_name;
                     cqPatInfo.sfzh = cardInfo1.certno;
                     cqPatInfo.xzqh = cardInfo2.insuplc_admdvs;
                     cqPatInfo.cblb = cardInfo2.psn_type;
                     cqPatInfo.xzlx = cardInfo2.insutype;
                     cqPatInfo.grbh = cardInfo1.psn_no;
                     cqPatInfo.jzlx = jzpzlx;
                     cqPatInfo.ybVer = "gjyb";
                     cqPatInfo.mdtrt_cert_type = payoptype.mdtrt_cert_type;
                     cqPatInfo.mdtrt_cert_no = cqPatInfo.ecToken;

                     yibaoCardInfo.readCardCardType = jzpzlx;
                     yibaoCardInfo.kh = jzpzlx != "3" ? sbkobj.sbkh : null;
                     yibaoCardInfo.qtjz = cardInfo1.certno;
                     yibaoCardInfo.ybVer = "gjyb";
                     yibaoCardInfo.jzlx = jzpzlx;
                     //yibaoCardInfo.kh = jzpzlx=="01"?cardInfo1.certno:(jzpzlx=="02" ? cardInfo1.certno:cardInfo3.cardno) ;
                     //upxtbrxx({ kh: yibaoCardInfo.kh, zjh: yibaoCardInfo.qtjz, cbdbm: cqPatInfo.xzqh, cblb: cqPatInfo.cblb, grbh: cqPatInfo.grbh, xzlx: cqPatInfo.xzlx });
                     ReadCardCall({ yibaoCardInfo: yibaoCardInfo, ybkCardType: jzpzlx, cardInfo1: cardInfo1, cardInfo2: cardInfo2, cardInfo3: cardInfo3 });
                 } else {
                     $.loading(false);
                     $.modalAlert("Quẹt thẻThất bại:" + yibaoCardInfo.err_msg, 'error');
                 }

             } else {
                 $.loading(false);
                 $.modalAlert(errmsg, 'error');
             }
         }
    }

    //Theo dõi loại đọc thẻ
    $("#readCardCardType").change(function () {
        klxchoose();
    })

    //Hiển thị cửa sổ bật tương ứng
    function klxchoose() {
        var jzpzlx = $('#readCardCardType').val();
        switch (jzpzlx) {
            case "0":
            case "1":
            case "4":
                GetPatSfzh();
                break;
        }
    }

        //Nhập tay số thẻ bảo hiểm xã hội
        function GetPatSbkh() {
            $.modalOpen({
                id: "sbkhInput",
                title: "Số thẻNhập",
                url: "/OutpatientManage/OutpatientReg/OutPatientSbkhInput?t=" + Math.random() + "&medicalInsurance=" + medicalInsurance,
                width: "300px",
                height: "150px",
                callBack: function (iframeId) {
                    top.frames[iframeId].PatSbkhData();
                }
            });
        }
        //Nhập tay số thẻ bảo hiểm xã hội
        function GetPatSfzh() {
            $.modalOpen({
                id: "sfzhInput",
                title: "Số CMND/CCCDNhập",
                url: "/OutpatientManage/OutpatientReg/OutPatientSfzhInput?t=" + Math.random() + "&medicalInsurance=" + medicalInsurance,
                width: "300px",
                height: "150px",
                callBack: function (iframeId) {
                    top.frames[iframeId].PatSfzhData();
                }
            });
        }
</script>
@using Newtouch.Infrastructure;
@{
    /**/

    //Có giao dịch bảo hiểm y tế không
    var openYbSett = SysConfigReader.Bool("");
    var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
    //Địa bàn bảo hiểm y tế，区分系统将执行何处医保逻辑
    var medicalInsurance = SysConfigReader.String("");
    //Khám bệnh loại chứng từ có lấy đầu bảo hiểm y tế từ không
    var YB_Jzpzl = SysConfigReader.String("");
}
@if (openYbSett == true)
{
<div id="readCard" style="color:orangered;display:none;width:200px">
    @*<input type="button" id="btkhsr" value="证件号输入" class="form-control" style="border-color:#00a0e9; margin-left: 0px;margin-top: 2px; height: 22px;width:44px;padding-left:0px; float: left;vertical-align:central;" onclick="GetPatSbkh()" />*@
    <i class="fa fa-id-card" style="font-size: 27px; float: left;vertical-align:central;" title="Đọc thẻ"></i>
    <select id="readCardCardType" class="form-control" style="margin-left: 0px;margin-top: 2px; height: 22px;width:70px;float: left;vertical-align:central;">
        @if (openYbSett == true)
        {
            <option value="2">医保卡</option>
            <option value="3">Chứng từ điện tử</option>
            <option value="6">Quét khuôn mặt</option>
        }
        <option value="4">Chứng minh nhân dân</option>
        @*<option value="1">自费磁卡</option>
            <option value="0">测试磁卡</option>*@
    </select>
    <input id="ckzddzsm" type="checkbox"  /><label for="zddzsm">(终端)扫码</label>
</div>
   
}

<script>
    var ybkCardType = "";
    var medicalInsurance = '';
    var cqPatInfo = {};//Thông tin đọc thẻ bệnh nhân，confirmformSử dụng
    var errmsg = "";//读卡错误提示
    var brxzobj = { brxz: "", brxzmc: "" };
    $('').click(function () {
         $.loading(true, '');
         setTimeout("", 50);
     });
    $("").show();
     //Đọc thẻ
    function readCard(khxx) {
         switch (medicalInsurance) {
             case "":
                 if (!khxx && $('').val() != "") {
                     $.loading(false);
                     klxchoose();
                 } else {
                     GetSHReadCardIno(khxx);
                 }
                 break;
             case ""://通用使用国家医保
                 var khxx = { "": "", "": "", "": "", "": "" };
                 if ($('').val() == "") {
                     $.loading(false);
                     GetPatSfzh();
                 } else {
                     GetReadCardInfo(khxx);
                 }

                 break;
             default:
                 $.modalAlert("", '');
                 return;
         }
     }

     function GetSHReadCardIno(khxx)
     {
         var yibaoCardInfo;
         var sm01Info;
         var jzpzlx = $('').val();
         var url ="";
         var payoptype = { "": "","":'', "": '', "": '', "": "", "": "", "": "" };
         if (jzpzlx=="") {//Thẻ từ
             payoptype.cardtype = "";
             payoptype.carddata = khxx.sbkh;
             url = "";
         }
         if (jzpzlx == "") {//保障卡
             payoptype.cardtype = "";
         }
         if (jzpzlx == "") {//Chứng từ điện tử
             payoptype.cardtype = "";
             payoptype.carddata = khxx.sbkh;
             payoptype.ecQrCode = khxx.sbkh;
             payoptype.ecQrChannel = "";
             url = "";
         }
         if (jzpzlx == "") {//Chứng minh nhân dân 目前为止只能用国家医保
             payoptype.sfzh = khxx.sbkh;
             GetReadCardInfo(payoptype);
             return;
         }
         if (jzpzlx == "") {
             $.loading(false);
             cqPatInfo.jzlx = jzpzlx;
             yibaoCardInfo = {kh:""};
             yibaoCardInfo.kh = khxx.sbkh;
             yibaoCardInfo.jzlx = jzpzlx;
             ReadCardCall({ yibaoCardInfo: yibaoCardInfo, ybkCardType: jzpzlx });
             return;
         }
         $.ajax({
             type: "",
             url: url,
             dataType: "",
             data: payoptype,
             async: false,
             success: function (data) {
                 yibaoCardInfo = eval('' + data + '');
             },
             error: function (request, error, ex) {
                 errmsg = "" + ex + "";
             }
         });
         if (yibaoCardInfo) {
             if (yibaoCardInfo.xxfhm === "") {
                 sm01Info = yibaoCardInfo.sm01;//Thông tin tài khoản(s000 、se01 、sm01)
                 cqPatInfo.xm = sm01Info.xm;
                 cqPatInfo.sfzh = sm01Info.sfzh;
                 cqPatInfo.xzqh = sm01Info.xzqh;
                 cqPatInfo.cblb = sm01Info.accountattr;
                 cqPatInfo.ecToken = sm01Info.ecToken;
                 cqPatInfo.sbkh = sm01Info.cardid;
                 cqPatInfo.accountattr = sm01Info.accountattr;
                 if (jzpzlx=="") {
                     cqPatInfo.carddata = sm01Info.ecToken;
                 }
                 else if (jzpzlx == ""||jzpzlx == "") {
                     cqPatInfo.carddata = khxx.sbkh;
                 }
                 else {
                     cqPatInfo.carddata = "";
                 }
                 cqPatInfo.kh = sm01Info.kh;
                 var bkbz = sm01Info.accountattr.substr(11, 1);//帮困 G、A
                 var gbbz = sm01Info.accountattr.substr(1, 1);//Bảo hiểm cán bộ 1
                 var resultObjArr = new Array();
                 if (bkbz == "" || bkbz == "" || gbbz == "") {
                     cqPatInfo.ybVer = "";
                     cqPatInfo.cardtype = payoptype.cardtype;
                     cqPatInfo.jzlx = jzpzlx;
                     getbrxz(bkbz);
                     yibaoCardInfo.brxzdm = brxzobj.brxz;
                     yibaoCardInfo.brxzmc = brxzobj.brxzmc;
                     yibaoCardInfo.readCardCardType = jzpzlx;
                     yibaoCardInfo.kh = sm01Info.kh;
                     yibaoCardInfo.qtjz = jzpzlx != "" ? cqPatInfo.sfzh : null;
                     yibaoCardInfo.ybVer = "";
                     yibaoCardInfo.jzlx = jzpzlx;
                     ReadCardCall({ yibaoCardInfo: yibaoCardInfo, ybkCardType: jzpzlx });
                 }
                 else {
                     GetReadCardInfo(cqPatInfo);
                 }


             } else {
                 $.loading(false);
                 $.modalAlert("" + yibaoCardInfo.fhxx, '');
             }
         } else {
             $.loading(false);
             $.modalAlert(errmsg, '');
         }
     }

    function getbrxz(brlx)
    {
        $.ajax({
            url: "",
            data: { xzlx: brlx },
            dataType: "",
            async: false,
            cache: false,
            success: function (data) {
                if (!!data) {
                    $.each(data, function (idx, val) {
                        if (val.insutype && val.insutype == brlx) {
                            brxzobj.brxz = val.brxz;
                            brxzobj.brxzmc = val.brxzmc;
                        }
                    });
                }
                return brxzobj;
            },
            error: function (request, error, ex) {
                return brxzobj;
            }
        });

    }

     //Đọc thẻ Lấy thông tin nhân viên
    function GetReadCardInfo(sbkobj) {
        debugger;
         var cardInfo1;
         var cardInfo2;
         var cardInfo3;
         var yibaoCardInfo;
         var patsbkh = null;
         var jzpzlx = $('').val();
         var payoptype = { "": "", "": sbkobj.sfzh, "": '', "": '', "": "", "": "", "": "" };
         var url = "";

        if (jzpzlx === "") {//Quét khuôn mặt
            url = "";
        }
        else if (jzpzlx === "") {//Chứng minh nhân dân
            payoptype.mdtrt_cert_type = "";
            payoptype.mdtrt_cert_no = sbkobj.sfzh;
            payoptype.psn_name = sbkobj.name;
            url = "";
        }
        else if (jzpzlx === "") {//Chứng từ điện tử
            //payoptype.mdtrt_cert_type = "";
            //payoptype.mdtrt_cert_no = sbkobj.ecToken;
            //payoptype.psn_cert_type = "";//Chứng minh nhân dân
            //payoptype.certno = sbkobj.sfzh;
            //payoptype.psn_name = sbkobj.xm;
            if ($('').is(''))
                url = "";
            else
                url = "";
        }
        else if (jzpzlx === "") {
            payoptype.mdtrt_cert_type = "";
            payoptype.mdtrt_cert_no = sbkobj.carddata;
        }

         if (jzpzlx === "") {//院内卡
             $.loading(false);
             $.modalAlert("", '');
         }
         else {
             $.ajax({
                 type: "",
                 url: url,
                 dataType: "",
                 data: payoptype,
                 async: false,
                 success: function (data) {
                     yibaoCardInfo = eval('' + data + '');
                 },
                 error: function (request, error, ex) {
                     errmsg = "" + ex + "";
                 }
             });debugger
             if (yibaoCardInfo) {
                 if (yibaoCardInfo.infcode == "" || yibaoCardInfo.infcode === 0) {
                     if (!yibaoCardInfo || !yibaoCardInfo.output.baseinfo || !yibaoCardInfo.output.insuinfo[0]) {
                         $.modalAlert("" + yibaoCardInfo.err_msg, '');
                         return;
                     }
                     if ('' === '') {
                         var cardecinfo = yibaoCardInfo.output.cardecinfo;
                         switch (cardecinfo.mdtrt_cert_type) {
                             case ""://Chứng từ điện tử
                                 jzpzlx = '';
                                 payoptype.mdtrt_cert_type = "";
                                 payoptype.mdtrt_cert_type = cardecinfo.mdtrt_cert_type;
                                 break;
                             case ""://Chứng minh nhân dân
                                 jzpzlx = '';
                                 break;
                             case ""://Thẻ bảo hiểm xã hội
                                 jzpzlx = '';
                                 sbkobj.sbkh = cardecinfo.mdtrt_cert_no;
                                 payoptype.mdtrt_cert_type = cardecinfo.mdtrt_cert_type;
                                 break;
                         }
                     }
                     cardInfo1 = yibaoCardInfo.output.baseinfo; //Thông tin cơ bản bảo hiểm y tế
                     if (yibaoCardInfo.output.insuinfo.length > 1)
                     {
                         for (var i = 0; i < yibaoCardInfo.output.insuinfo.length;i++) {
                             if (yibaoCardInfo.output.insuinfo[i].paus_insu_date)
                                 continue;
                             else {
                                 cardInfo2 = yibaoCardInfo.output.insuinfo[i];
                                 break;
                             }
                         }
                     } else
                         cardInfo2 = yibaoCardInfo.output.insuinfo[0];//Thông tin tham gia bảo hiểm
                     if (jzpzlx !== "") {
                         cardInfo3 = yibaoCardInfo.output.cardecinfo;//Thông tin thẻ
                         cqPatInfo.sbkh = sbkobj.sbkh;
                     }
                     if (jzpzlx == "") {
                         cardInfo3 = yibaoCardInfo.output.cardecinfo;//Thông tin thẻ
                         cqPatInfo.ecToken = cardInfo3.ecToken;
                     }
                     getbrxz(cardInfo2.insutype);
                     yibaoCardInfo.brxzdm = brxzobj.brxz;
                     yibaoCardInfo.brxzmc = brxzobj.brxzmc;

                     cqPatInfo.xm = cardInfo1.psn_name;
                     cqPatInfo.sfzh = cardInfo1.certno;
                     cqPatInfo.xzqh = cardInfo2.insuplc_admdvs;
                     cqPatInfo.cblb = cardInfo2.psn_type;
                     cqPatInfo.xzlx = cardInfo2.insutype;
                     cqPatInfo.grbh = cardInfo1.psn_no;
                     cqPatInfo.jzlx = jzpzlx;
                     cqPatInfo.ybVer = "";
                     cqPatInfo.mdtrt_cert_type = payoptype.mdtrt_cert_type;
                     cqPatInfo.mdtrt_cert_no = cqPatInfo.ecToken;

                     yibaoCardInfo.readCardCardType = jzpzlx;
                     yibaoCardInfo.kh = jzpzlx != "" ? sbkobj.sbkh : null;
                     yibaoCardInfo.qtjz = cardInfo1.certno;
                     yibaoCardInfo.ybVer = "";
                     yibaoCardInfo.jzlx = jzpzlx;
                     //yibaoCardInfo.kh = jzpzlx==""?cardInfo1.certno:(jzpzlx=="" ? cardInfo1.certno:cardInfo3.cardno) ;
                     //upxtbrxx({ kh: yibaoCardInfo.kh, zjh: yibaoCardInfo.qtjz, cbdbm: cqPatInfo.xzqh, cblb: cqPatInfo.cblb, grbh: cqPatInfo.grbh, xzlx: cqPatInfo.xzlx });
                     ReadCardCall({ yibaoCardInfo: yibaoCardInfo, ybkCardType: jzpzlx, cardInfo1: cardInfo1, cardInfo2: cardInfo2, cardInfo3: cardInfo3 });
                 } else {
                     $.loading(false);
                     $.modalAlert("" + yibaoCardInfo.err_msg, '');
                 }

             } else {
                 $.loading(false);
                 $.modalAlert(errmsg, '');
             }
         }
    }

    //监控读卡类型
    $("").change(function () {
        klxchoose();
    })

    //展示相应的弹窗
    function klxchoose() {
        var jzpzlx = $('').val();
        switch (jzpzlx) {
            case "":
            case "":
            case "":
                GetPatSfzh();
                break;
        }
    }

        //Nhập tay số thẻ bảo hiểm xã hội
        function GetPatSbkh() {
            $.modalOpen({
                id: "",
                title: "",
                url: "" + Math.random() + "" + medicalInsurance,
                width: "",
                height: "",
                callBack: function (iframeId) {
                    top.frames[iframeId].PatSbkhData();
                }
            });
        }
        //Nhập tay số thẻ bảo hiểm xã hội
        function GetPatSfzh() {
            $.modalOpen({
                id: "",
                title: "",
                url: "" + Math.random() + "" + medicalInsurance,
                width: "",
                height: "",
                callBack: function (iframeId) {
                    top.frames[iframeId].PatSfzhData();
                }
            });
        }
</script>
@model System.Web.Mvc.HandleErrorInfo
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title></title>
    <style type="text/css">
        html, body {
            background-color: #f9f9f9;
            font: normal 62.5% Verdana, Arial, Helvetica, sans-serif, "微软雅黑";
            font-family: "Arial","SimSun";
            padding: 0;
            margin: 0;
            color: #000;
            font-size: 24px;
        }

        .text {
            width: 529px;
            height: 372px;
            margin: 50px auto;
            text-align: center;
        }

        .Prompt {
            line-height: 20px;
            float: right;
        }
    </style>
</head>
<body>
    <div class="text">
        <img src="@SiteUrl.GetStaticResourceScriptUrl("~/img/error_170503.png")" />
        <div class="Prompt">程序员开小差了，请联系管理员&nbsp;&nbsp;&nbsp;<a style="cursor:pointer;" title="查看异常详情" onclick="showException(); return false;">Bất thường chi tiết</a></div>
    </div>

    <div style="display: none">
        @if (Model != null && Model.Exception != null)
        {
            <h2><strong>页面访问时抛出异常： @Model.Exception.GetType().Name</strong></h2>
            <br />
            <p>
                Thực hiện ở @Model.ControllerName 控制器的 @Model.ActionName 操作的时候抛出该异常。
            </p>
            <p>Lỗi chi tiết:</p>
            <p>@Model.Exception.Message</p>
            <div class="ep-info-holder ep-intro closed J_ExpanHolder">
                <h4>调用堆栈</h4>
                <div class="info">
                    @Html.Raw(Model.Exception.StackTrace)
                </div>
                <div class="clearfix morebtn-holder">
                    <a class="a-btn o-link J_ExpanBtn"></a>
                </div>
            </div>
        }
    </div>

    <link href="@SiteUrl.GetStaticResourceScriptUrl("~/css/framework-font.css")" rel="stylesheet" />
    @Html.Partial("")
    <script src=""~/js/bootstrap/bootstrap.js""></script>
    <link href="@SiteUrl.GetStaticResourceScriptUrl("~/js/bootstrap/bootstrap.min.css")" rel="stylesheet" />
    <script src=""~/js/dialog/dialog.js""></script>
    <script src=""~/js/cookie/jquery.cookie.js""></script>
    <link href="@SiteUrl.GetStaticResourceScriptUrl("~/css/framework-theme.css")" rel="stylesheet" id="color-skin" />
    <script src=""~/js/framework-ui.js""></script>
    <script src=""~/js/Newtouch-ui.js""></script>
    <link href="@SiteUrl.GetStaticResourceScriptUrl("~/css/skins/_all-skins.css")" rel="stylesheet" />

    @if (Model != null && Model.Exception != null)
    {
        <script type="">
            function showException() {
                @*var data = {
                state: '',
                code: '',
                message: ''
            };
            data.exStackTrace = $('').html();
            $.xhrSuccessDataExCheckHandle(data);*@

                var exStackTrace = $('').html();
                exStackTrace = $.htmlEncode(exStackTrace);
                //exStackTrace = exStackTrace.replace('', '');
                top.layer.open({
                    type: 1,
                    title: '',
                    area: ['', ''],
                    closeBtn: 1,
                    shadeClose: true,
                    skin: '',
                    content: '' + '' + '' + exStackTrace + ''
                });
            }
        </script>
    }
    else
    {
        <script type="">
            function showException() {
                alert('');
            }
        </script>
    }
</body>
</html>

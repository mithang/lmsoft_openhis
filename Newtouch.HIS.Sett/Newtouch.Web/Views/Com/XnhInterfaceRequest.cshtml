@model dynamic

@{
    ViewBag.Title = "";
    Layout = "";

}
<style>
    #btn_clean {
        background-color: #fff;
        color: #00a9ea;
        font-weight: bolder;
    }
</style>
<form name="form1" autocomplete="off">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Request
        </div>
        <div style="padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle"><span class="required">*</span>Intferface：</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="txt_it" placeholder="S02" />
                    </td>
                    <td class="formValue">
                        <button type="button" class="btn btn-primary" id="btn_request" value="Yêu cầu" style="width: 100px;">Send</button>
                        <button type="button" class="btn btn-primary" id="btn_clean" value="Xóa" style="width: 100px;">Clean</button>
                    </td>
                </tr>
                <tr>
                    <th class="formTitle"><span class="required">*</span>BodyXml：</th>
                    <td class="formValue" colspan="2">
                        <textarea type="text" class="form-control" id="txt_body" rows="9" cols="20"></textarea>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="panel panel-default" style="margin-bottom: 0">
        <div class="panel-heading navb-bg">
            Response
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle">ResponseXml：</th>
                    <td class="formValue">
                        <textarea type="text" class="form-control" id="txt_response" rows="14" cols="20"></textarea>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</form>

<script lang="">
    $(function () {
        $("").click(function () {
            $("").val("");
            $.najax({
                url: "",
                data: { itn: $("").val(), body: $("").val() },
                type: "",
                dataType: "",
                success: function (rep) {
                    $("").val(rep.data);
                }
            });
        });
        $("").click(function () {
            $("").val("");
            $("").val("");
            $("").val("");
        });
    });

    //回车事件绑定
    $(document).keyup(function (event) {
        if (event.keyCode === 13) {
            $("").trigger("");
        }
    });
</script>
        function setup() {
            var tmp = get('');
            if (tmp && $.inArray(tmp, my_skins))
                change_skin(tmp);

            //Add the change skin listener
            $("").on('', function (e) {
                if ($(this).hasClass(''))
                    return;
                e.preventDefault();
                change_skin($(this).data(''));
            });

            //Add the layout manager
            $("").on('', function () {
                change_layout($(this).data(''));
            });

            $("").on('', function () {
                change_layout($(this).data(''));
                var slide = !AdminLTE.options.controlSidebarOptions.slide;
                AdminLTE.options.controlSidebarOptions.slide = slide;
                if (!slide)
                    $('').removeClass('');
            });

            $("").on('', function () {
                var sidebar = $("");
                if (sidebar.hasClass("")) {
                    sidebar.removeClass("")
                    sidebar.addClass("")
                } else {
                    sidebar.removeClass("")
                    sidebar.addClass("")
                }
            });

            $("").on('', function () {
                $(this).attr('', true);
                AdminLTE.pushMenu.expandOnHover();
                if (!$('').hasClass(''))
                    $("").click();
            });
        };
        function change_skin(cls) {
            $.each(my_skins, function (i) {
                $("").removeClass(my_skins[i]);
            });

            $("").addClass(cls);
            store('', cls);
            var pifu = "";
            var cssURL = ""~/css/skins/framework-theme-blue.css"";  //~/Content/css/framework-theme.css
            switch (cls) {
                case "": pifu = ""; cssURL = ""~/css/skins/framework-theme-blue.css""; break;

                case "": pifu = ""; cssURL = ""~/css/skins/framework-theme-red.css""; break;
                    @*case "": pifu = ""; cssURL = ""~/css/skins/framework-theme-yellow_tab.css""; break*@
                case "": pifu = ""; cssURL = ""~/css/skins/framework-theme-purple.css""; break;
                case "": pifu = ""; cssURL = ""~/css/skins/framework-theme-blue.css""; break;
                case "": pifu = ""; cssURL = ""~/css/skins/framework-theme-blue-left.css""; break;
                case "": pifu = ""; break;
                case "": pifu = ""; cssURL = ""~/css/skins/framework-theme-red-left.css""; break;
                case "": pifu = ""; cssURL = ""~/css/skins/framework-theme-yellow.css""; break;
                case "": pifu = ""; cssURL = ""~/css/skins/framework-theme-purple-left.css""; break;
                case "": pifu = ""; cssURL = ""~/css/skins/framework-theme-green-left.css""; break;
                default: break;
            }
            $("").css("", pifu);
            $("").attr("", cssURL);
            setlocalStorage("", cssURL); //localstorage
            return false;
        };
        function change_layout(cls) {
            $("").toggleClass(cls);
            AdminLTE.layout.fixSidebar();
            //Fix the problem with right sidebar and layout boxed
            if (cls == "")
                AdminLTE.controlSidebar._fix($(""));
            if ($('').hasClass('') && cls == '') {
                AdminLTE.pushMenu.expandOnHover();
                AdminLTE.layout.activate();
            }
            AdminLTE.controlSidebar._fix($(""));
            AdminLTE.controlSidebar._fix($(""));
        };
        function store(name, val) {
            if (typeof (Storage) !== "") {
                localStorage.setItem(name, val);
            } else {
                window.alert('');
            }
        };
        function get(name) {
            if (typeof (Storage) !== "") {
                return localStorage.getItem(name);
            } else {
                window.alert('');
            }
        }
    </script>
    <script type="">
        function showSwitchOrgPrompt(force) {
            $.modalOpen({
                id: "",
                title: "",
                url: "",
                width: "",
                height: "",
                btn: null,
                closeBtn: (!!force ? 0 : 1),
            });
        }

        $(function () {
            //Home/Index加载时强制选择医疗机构
            @Html.Raw(needChooseOrg ? "" : "")
        });
    </script>
    <script type="">
        //Home/Index页面加载完成之后 Tải lạiiframe
        $(window).load(function () {
            $('').each(function () {
                if (!!!$(this).attr('') && !!$(this).attr('')) {
                    $(this).attr('', $(this).attr(''));
                }
            });
        });
    </script>
</body>
</html>

<?xml version="1.0" encoding="utf-8"?>
<appSettings>
	<!-- ================== 1：Cấu hình liên quan đến hệ thống phát triển ================== -->
	<!-- Thời gian duy trì trạng thái đăng nhập（Đơn vị：phút）-->
	<add key="LoginStatusKeepMinute" value="30" />
	<!-- Đá ra khi đăng nhập đa thiết bị -->
	<add key="EnableMultipleLoginLimit" value="true" />
	<!-- Đá ra khi đăng nhập đa thiết bị-Cùng một tài khoản，Số lượng trực tuyến đồng thời tối đa -->
	<add key="MultipleLoginLimit_Count" value="10" />

	<!--Bật IP Lọc（Sau khi bật Bật IP Chính sách giới hạn truy cập（Chỉ mở cho một phần hoặc Hạn chế truy cập một phần）） -->
	<add key="Is_IPFilter" value="false" />

	<!--Bật liên kết khoa dược với người dùng（Khoa dược mà người dùng sẽ thao tác sau khi đăng nhập） -->
	<add key="Is_UserYfbmRelated" value="true" />

	<!-- của menu title Có hiển thị hay không Description（Chỉ khi true'mới hiển thị） -->
	<add key="IS_ShowDescToMenuTitle" value="true" />

	<!-- ================== 2：Cấu hình tham số phần mềm hệ thống ================== -->

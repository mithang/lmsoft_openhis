<?xml version="1.0" encoding="utf-8"?>
<appSettings>
	<!-- ================== 1：Cấu hình liên quan đến hệ thống phát triển ================== -->
	<!-- Thời gian duy trì trạng thái đăng nhập (đơn vị: phút)-->
	<add key="LoginStatusKeepMinute" value="30" />
	<!-- Đẩy nhau giữa nhiều thiết bị đầu cuối -->
	<add key="EnableMultipleLoginLimit" value="false" />
	<!-- Đẩy nhau giữa nhiều thiết bị đầu cuối-Cùng một tài khoản，Tối đa số trực tuyến đồng thời -->
	<add key="MultipleLoginLimit_Count" value="10" />

	<!--BậtIPLọc（Bật sau BậtIPChiến lược giới hạn truy cập（仅对部分开放 Hoặc Một phần truy cập giới hạn）） -->
	<add key="Is_IPFilter" value="false" />

	<!--启用用户药房部门关联（phòng ban nhà thuốc của thao tác cần sau người dùng đăng nhập） -->
	<add key="Is_UserYfbmRelated" value="true" />

	<!-- thực đơntitle是否显示Description（Có chỉtrue会显示） -->
	<add key="IS_ShowDescToMenuTitle" value="true" />

	<!-- ================== 2：Cấu hình tham số phần mềm hệ thống ================== -->
	<!-- Phiên bản phần mềm -->
	<add key="Version" value="1.00.00.00" />

	<!-- Một phần quan trọngModule IdCấu hình -->
	<!-- Reidsbộ nhớ đệmkey前缀 -->
	<add key="Reids_Cache_Prefix" value="$C_Sett$"/>
	<!-- Cơ quan tổ chức cấp cao nhấtId -->
	<add key="Top_OrganizeId" value="d8ee85f8-d8d1-4b5c-bd9e-1761f44242d8"/>
	<!-- Áp dụngId -->
	<add key="AppId" value="Sett"/>
	<add key="AppName" value="医疗云HIS系统"/>

	<!-- OptimaGiao diện cấu hình mã hóa -->
	<add key="Optima_API_Enhanced" value="false"/>
	<add key="Optima_API_passPhrase" value="JRs5=u?9m4=Nb^83hD7C"/>
	<add key="Optima_API_initVector" value="VsNk2&lt;SNp4-czWFh"/>
	<!-- Kiểm thử môi trường -->
	<add key="Optima_API_PatientInfo_GetPatientDischargeInfo_Url" value=""/>

	<!-- trạm tĩnhHost 公网ip-->
  	<add key="SiteStaticHost" value="http://localhost:8014/"/>
	<!-- 日志服务的Url Trường đã bỏ-->
	<add key="His.Log.URL" value="http://localhost:20106/"/>

	<!-- 老报表服务,Trường đã bỏ -->
	<add key="ReportServer.HOST" value="http://192.168.9.190:8009/"/>

	<!-- Trang đầu đăng nhập điểm đơnurl Trường đã bỏ -->
	<add key="SSOHomeHost" value="http://192.168.9.190:8005/Home/Index"/>
	<!-- 单点登出url Trường đã bỏ -->
	<add key="SSOOutLogin" value="http://192.168.9.190:8005/Login/OutLogin"/>

	<!-- 登录时是否显示验证码 -->
	<add key="Is_CheckChkCode" value="true"/>

	<!-- CIS API HOST -->
	<add key="SiteCISAPIHost" value="http://localhost:7003/"/>

	<!-- PDS API HOST -->
	<add key="SitePDSAPIHost" value="http://localhost:7004/"/>
	<!-- DRG API HOST  配置鉴权中心api Trường đã bỏ-->
	<add key="SiteDRGAPIHost" value="http://192.168.9.190:8015/"/>
	<!-- DRGGrouper API HOST Cấu hìnhapimanageĐịa chỉ Trường đã bỏ-->
	<add key="SiteManageAPIHost" value="http://192.168.9.190:8016/"/>
	<!-- Đường dẫn mặc định tệp quyển -->
	<add key="LocalFileBaseDir" value="C:\\"/>
	<!-- Đường dẫn truy cập mạng mặc định tệp quyểnHost -->
	<add key="LocalFileBaseNetUrl" value="http://localhost:19571/"/>

	<!-- Trangdomain（Trang miền khác lồng nhau，Và thực hiệnjs Miền cùng một thành cần đặt）-->
	<add key="Document_Domain" value="localhost"/>
	<!-- APIĐịa chỉ-Đổi lấy danh tính người dùng ủy quyền thống nhất settapiĐịa chỉ-->
	<add key="UAUserInfoGetAPI" value="http://localhost:7002/api/UA/GetUserInfo"/>
	<!-- CISCấu hình địa chỉ（Cấu hình đăng nhập ủy quyền thống nhất）（CISWebĐịa chỉ mạng ngoài） -->
	<add key="CIS_UALoginAddress" value="http://127.0.0.1:8003/Login/UALogin"/>
	<!-- CISCấu hình địa chỉ（Cấu hình làm nóng trước ủy quyền thống nhất）（CISWebĐịa chỉ mạng nội bộ） -->
	<add key="CIS_UALoginPreAddress2" value="http://127.0.0.1:8003"/>
	<!-- Cấu hình địa chỉ hệ thống phòng phẫu thuật（Cấu hình đăng nhập ủy quyền thống nhất）（ORWebĐịa chỉ mạng ngoài） -->
	<add key="OR_UALoginAddress" value="http://127.0.0.1:8006/Login/UALogin"/>

	<!-- Giới hạn tên miền địa chỉ truy cập（Baidu tương tựhttp会自动重定向到https）-->
	<add key="vs:EnableBrowserLink" value="false"/>
	<!--机构收支管理，Giới hạn tối đa tệp đính kèm 单位兆-->
	<add key="jgzsMaxSize" value="20"/>
	<add key="legalFileUploadExt" value=".jpg.rar.png.zip.doc.xlsx.docx.pdf.xls"/>

	<!-- AlipayConstantsCấu hình start -->
	<!-- Đường dẫn tài nguyên khóa bí mật-Tên thư mục -->
	<add key="AlipayConstants_KeyFolderName" value="Resources" />
	<add key="AlipayConstants_APPID" value="2016050301359091" />
	<!-- AlipayAPI - Đường dẫn lưu tệp （Hiện nay：Tạo trước giao dịch ngoại tuyến thu đơn thống nhất mã QR tạo） -->
	<add key="AlipayConstants_FileSaveBasePath" value="~/YfyMobile/" />

	<!-- AlipayConstantsCấu hình end -->

	<!-- Bảo hiểm y tế nông thôn mới start -->

	<add key="xnhLogAddress" value="~/log_xinnonghe_guigan"></add>
	<add key="ServiceName" value="~/log_xinnonghe_guigan"></add>
	<!-- Bảo hiểm y tế nông thôn mới end -->
	<!--程序文本日志 -->
	<add key="settLogAddress" value="~/log_sett_web" />
	<!--引用预约apiGiao diện phương thức -->
	<add key="HIS" value="6d5752a7-234a-403e-aa1c-df8b45d3469f"/>
	<!--Báo cáoreport 公网ip -->
	<add key="ReportUrl" value="http://127.0.0.1:8000/"/>
	<add key="ReportSystemCode" value="SETT"/>
</appSettings>
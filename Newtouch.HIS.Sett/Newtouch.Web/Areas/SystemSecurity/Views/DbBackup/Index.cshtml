@{
    ViewBag.Title = "";
    Layout = "";
}
<script>
    $(function () {
        gridList();
    })
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            height: $(window).height() - 96,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 200, align: '' },
                { label: '', name: '', width: 100, align: '' },
                {
                    label: '', name: '', width: 100, align: '',
                    formatter: function (cellvalue) {
                        if (cellvalue == "") {
                            return "";
                        } else if (cellvalue == "") {
                            return "";
                        }
                    }
                },
                {
                    label: '', name: '', width: 100, align: '',
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 300, align: '' }
            ]
        });
        $("").click(function () {
            var text = $(this).find('').html();
            var value = $(this).find('').attr('');
            $("").html(text).attr('', value)
        });
        $("").click(function () {
            var queryJson = {
                condition: $("").find('').attr(''),
                keyword: $("").val()
            }
            $gridList.jqGrid('', {
                postData: { queryJson: JSON.stringify(queryJson) },
            }).trigger('');
        });
    }
    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_delete() {
        $.deleteForm({
            url: "",
            param: { keyValue: $("").jqGridRowValue().Id },
            success: function () {
                $.currentWindow().$("").trigger("");
            }
        })
    }
    function btn_download() {
        var keyValue = $("").jqGridRowValue().Id;
        $.download("", "" + keyValue, '');
    }
</script>

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a id="NF-add" authorize="yes" class="btn btn-primary dropdown-text" onclick="btn_add()"><i class="fa fa-plus"></i>新建备份</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" id="NF-delete" authorize="yes" onclick="btn_delete()"><i class="fa fa-trash-o"></i>删除备份</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" id="NF-download" authorize="yes" onclick="btn_download()"><i class="fa fa-cloud-download"></i>下载备份</a>
        </div>
        @*<div class="operate">
            <ul class="nav nav-pills">
                <li class="first">Đã chọn<span>1</span>Mục</li>
                <li><a id="NF-delete" authorize="yes" onclick="btn_delete()"><i class="fa fa-trash-o"></i>删除备份</a></li>
                <li class="split"></li>
                <li><a id="NF-download" authorize="yes" onclick="btn_download()"><i class="fa fa-cloud-download"></i>下载备份</a></li>
            </ul>
            <a href="javascript:;" class="close"></a>
        </div>*@
             @*<script>$('').authorizeButton()</script>*@
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div id="txt_condition" class="btn-group">
                        <a class="btn btn-default dropdown-text" data-toggle="dropdown">Chọn điều kiện</a>
                        <a class="btn btn-default dropdown-toggle" data-toggle="dropdown"><span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li><a href="javascript:void()" data-value="DbName">数据库名</a></li>
                            <li><a href="javascript:void()" data-value="FileName">备份名称</a></li>
                        </ul>
                    </div>
                </td>
                <td style="padding-left: 2px;">
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Vui lòng nhập từ khóa cần tra cứu" style="width: 200px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>

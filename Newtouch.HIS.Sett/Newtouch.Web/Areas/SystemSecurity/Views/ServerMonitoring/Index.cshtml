    function loadGaugeIIS() {
        var myChart = echarts.init(document.getElementById(''));
        option = {
            series: [
                {
                    name: '',
                    type: '',
                    splitNumber: 10,       // 分割段数，Mặc định là5
                    axisLine: {            // 坐标轴线
                        lineStyle: {       // Thuộc tínhlineStyleĐiều khiển kiểu đường kẻ
                            color: [[0.2, ''], [0.8, ''], [1, '']],
                            width: 10
                        }
                    },
                    axisTick: {            // 坐标轴小标记
                        splitNumber: 10,   // Phần mỗisplit细分多少段

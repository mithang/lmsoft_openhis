        };
        myChart.setOption(option);
    }
    function loadChart() {
        var myChart = echarts.init(document.getElementById('maind'));
        option = {
            tooltip: {
                trigger: 'axis'
            },
            legend: {
                data: ['IISTỷ lệ sử dụng', 'CPUTỷ lệ sử dụng', 'ARMTỷ lệ sử dụng']
            },

            xAxis: {
                type: 'category',
                boundaryGap: false,
                data: ['周一', '周二', '周三', '周四', '周五', '周六', '周日']
            },
            yAxis: {
                type: 'value'
            },
            series: [
                {
                    name: 'IISTỷ lệ sử dụng', type: 'line',
                    data: [1720, 8132, 2101, 3134, 490, 5230, 6210]
                },
                {
                    name: 'CPUTỷ lệ sử dụng', type: 'line',
                    data: [2620, 4182, 5191, 4234, 2290, 1330, 9310]
                },
                {
                    name: 'ARMTỷ lệ sử dụng', type: 'line',
                    data: [2320, 1822, 7791, 23344, 22790, 5530, 5110]
                }
            ]
        };

        myChart.setOption(option);
    }
</script>

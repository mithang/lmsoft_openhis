@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}
@*<script src="~/Content/js/echarts/echarts.js"></script>*@
<script src="~/Content/js/echarts/echarts-all.js"></script>
@*<script src="~/Content/js/echarts/echarts.min.js" type="text/javascript"></script>*@
<script src="~/Content/js/echarts/infographic.js"></script>
<script>
    $(function () {
        loadGaugeIIS();
        loadGaugeCPU();
        loadGaugeRAM();
       loadChart();
    })
    function loadGaugeIIS() {
        var myChart = echarts.init(document.getElementById('maina'));
        option = {
            series: [
                {
                    name: 'Chỉ số nghiệp vụ',
                    type: 'gauge',
                    splitNumber: 10,       // Số đoạn chia，mặc định là5
                    axisLine: {            // Trục tọa độ
                        lineStyle: {       // Thuộc tínhlineStyleĐiều khiển kiểu đường kẻ
                            color: [[0.2, '#228b22'], [0.8, '#48b'], [1, '#ff4500']],
                            width: 10
                        }
                    },
                    axisTick: {            // Dấu nhỏ trên trục tọa độ
                        splitNumber: 10,   // Mỗi phầnsplitChia nhỏ thành bao nhiêu đoạn
                        length: 12,        // Thuộc tínhlengthĐiều khiển độ dài đường kẻ
                        lineStyle: {       // Thuộc tínhlineStyleĐiều khiển kiểu đường kẻ
                            color: 'auto'
                        }
                    },
                    axisLabel: {           // Nhãn văn bản trục tọa độ，Xem chi tiếtaxis.axisLabel
                        textStyle: {       // Các thuộc tính còn lại mặc định dùng kiểu văn bản toàn cục，Xem chi tiếtTEXTSTYLE
                            color: 'auto'
                        }
                    },
                    splitLine: {           // Đường phân cách
                        show: true,        // Hiển thị mặc định，Thuộc tínhshowĐiều khiển có hiển thị hay không
                        length: 30,         // Thuộc tínhlengthĐiều khiển độ dài đường kẻ
                        lineStyle: {       // Thuộc tínhlineStyle（Xem chi tiếtlineStyle）Điều khiển kiểu đường kẻ
                            color: 'auto'
                        }
                    },

                    detail: {
                        formatter: '{value}%',
                        textStyle: {       // Các thuộc tính còn lại mặc định dùng kiểu văn bản toàn cục，Xem chi tiếtTEXTSTYLE
                            color: 'auto',
                            fontWeight: 'bolder',
                            fontSize: 20
                        }
                    },
                    data: [{ value: 50 }]
                }
            ]
        };
        myChart.setOption(option);
    }
    function loadGaugeCPU() {
        var myChartCUP = echarts.init(document.getElementById('mainb'), infographicTheme());
        optionCUP = {
            series: [
                {
                    name: 'Chỉ số nghiệp vụ',
                    type: 'gauge',
                    splitNumber: 10,       // Số đoạn chia，mặc định là5
                    axisLine: {            // Trục tọa độ
                        lineStyle: {       // Thuộc tínhlineStyleĐiều khiển kiểu đường kẻ
                            color: [[0.2, '#228b22'], [0.8, '#48b'], [1, '#ff4500']],
                            width: 10
                        }
                    },
                    axisTick: {            // Dấu nhỏ trên trục tọa độ
                        splitNumber: 10,   // Mỗi phầnsplitChia nhỏ thành bao nhiêu đoạn
                        length: 12,        // Thuộc tínhlengthĐiều khiển độ dài đường kẻ
                        lineStyle: {       // Thuộc tínhlineStyleĐiều khiển kiểu đường kẻ
                            color: 'auto'
                        }
                    },
                    axisLabel: {           // Nhãn văn bản trục tọa độ，Xem chi tiếtaxis.axisLabel
                        textStyle: {       // Các thuộc tính còn lại mặc định dùng kiểu văn bản toàn cục，Xem chi tiếtTEXTSTYLE
                            color: 'auto'
                        }
                    },
                    splitLine: {           // Đường phân cách
                        show: true,        // Hiển thị mặc định，Thuộc tínhshowĐiều khiển có hiển thị hay không
                        length: 30,         // Thuộc tínhlengthĐiều khiển độ dài đường kẻ
                        lineStyle: {       // Thuộc tínhlineStyle（Xem chi tiếtlineStyle）Điều khiển kiểu đường kẻ
                            color: 'auto'
                        }
                    },

                    detail: {
                        formatter: '{value}%',
                        textStyle: {       // Các thuộc tính còn lại mặc định dùng kiểu văn bản toàn cục，Xem chi tiếtTEXTSTYLE
                            color: 'auto',
                            fontWeight: 'bolder',
                            fontSize: 20
                        }
                    },
                    data: [{ value: 50 }]
                }
            ]
        };
        myChartCUP.setOption(optionCUP);
        clearInterval(timeTicket);
        var timeTicket = setInterval(function () {
            optionCUP.series[0].data[0].value = (Math.random() * 100).toFixed(2) - 0;
            myChartCUP.setOption(optionCUP, true);
        }, 2000)
    }
    function loadGaugeRAM() {

@{
    ViewBag.Title = "";
    Layout = "";
}
<script>
    $(function () {
        gridList();
    })
    function gridList() {
        $("").dataGrid({
            treeGrid: true,
            treeGridModel: "",
            ExpandColumn: "",
            url: "" + Math.random(),
            height: $(window).height() - 90,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: '', name: '', width: 200, align: '' },
                { label: '', name: '', width: 150, align: '' },
                { label: '', name: '', width: 80, align: '' },
                {
                    label: "", name: "", width: 60, align: "",
                    formatter: function (cellvalue) {
                        return cellvalue == "" ? "" : "";
                    }
                },
                { label: "", name: "", index: "", width: 200, align: "" }
            ]
        });
    }
    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + Math.random(),
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_edit() {
        var keyValue = $("").jqGridRowValue().Id;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue + "" + Math.random(),
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_delete() {
        $.deleteForm({
            url: "",
            param: { keyValue: $("").jqGridRowValue().Id },
            success: function () {
                $("").resetSelection();
                $("").trigger("");
            }
        })
    }
    function btn_details() {
        var keyValue = $("").jqGridRowValue().Id;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue + "" + Math.random(),
            width: "",
            height: "",
            btn: null,
        });
    }
</script>
<div class="topPanel" style="border: 0px;">
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Vui lòng nhập từ khóa cần tra cứu" style="width: 200px;">
                        <span class="input-group-btn">
                            <button type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>新建分类</a>
        </div>
        <div class="operate">
            <ul class="nav nav-pills">
                <li class="first">Đã chọn<span>1</span>Mục</li>
                <li><a onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>修改分类</a></li>
                <li><a onclick="btn_details()"><i class="fa fa-search-plus"></i>查看分类</a></li>
            </ul>
            <a href="javascript:;" class="close"></a>
        </div>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <style>
        .ui-jqgrid {
            border-left: 0px;
            border-right: 0px;
            border-bottom: 0px;
        }
    </style>
</div>

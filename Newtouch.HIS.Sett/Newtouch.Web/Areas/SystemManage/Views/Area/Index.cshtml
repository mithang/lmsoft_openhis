@{
    ViewBag.Title = "";
    Layout = "";
}
<script>
    $(function () {
        gridList();
    })
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            treeGrid: true,
            treeGridModel: "",
            ExpandColumn: "",
            url: "",
            height: $(window).height() - 96,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: '', name: '', width: 200, align: '' },
                {
                    label: '', name: '', width: 80, align: '',
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                {
                    label: "", name: "", width: 60, align: "",
                    formatter: function (cellvalue) {
                        return cellvalue == true ? "" : "";
                    }
                },
                { label: '', name: '', width: 300, align: '' }
            ]
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: { keyword: $("").val() },
            }).trigger('');
        });
    }
    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_edit() {
        var keyValue = $("").jqGridRowValue().Id;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_delete() {
        $.deleteForm({
            url: "",
            param: { keyValue: $("").jqGridRowValue().Id },
            success: function () {
                $.currentWindow().$("").resetSelection();
                $.currentWindow().$("").trigger("");
            }
        })
    }
</script>

<div class="topPanel">
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Vui lòng nhập từ khóa cần tra cứu" style="width: 200px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a id="NF-add" authorize="yes" class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>新建区域</a>
        </div>
        <div class="operate">
            <ul class="nav nav-pills">
                <li class="first">Đã chọn<span>1</span>Mục</li>
                <li><a id="NF-edit" authorize="yes" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa miền quận</a></li>
                <li><a id="NF-delete" authorize="yes" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa miền quận</a></li>
            </ul>
            <a href="javascript:;" class="close"></a>
        </div>
             @*<script>$('').authorizeButton()</script>*@
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>

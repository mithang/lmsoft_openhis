@{
    ViewBag.Title = "";
    Layout = "";
}
<script>
    var keyValue = $.request("");
    $(function () {
        initControl();
        if (!!keyValue) {
            $.ajax({
                url: "",
                data: { keyValue: keyValue },
                dataType: "",
                async: false,
                success: function (data) {
                    $("").formSerialize(data);
                }
            });
        }
    });
    function initControl() {
        $("").bindSelect({
            url: ""
        });
    }
    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        $.submitForm({
            url: "" + keyValue,
            param: $("").formSerialize(),
            success: function () {
                $.currentWindow().$("").resetSelection();
                $.currentWindow().$("").trigger("");
            }
        })
    }
</script>

<form id="form1">
    <div style="padding-top: 20px; margin-right: 20px;">
        <table class="form">
            <tr>
                <th class="formTitle">Cấp trên</th>
                <td class="formValue">
                    <select id="F_ParentId" name="F_ParentId" class="form-control required">
                        <option value="0">Nút cha</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Tên</th>
                <td class="formValue">
                    <input id="F_FullName" name="F_FullName" type="text" class="form-control required" placeholder="Vui lòng nhập tên" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Sắp xếp</th>
                <td class="formValue">
                    <input id="F_SortCode" name="F_SortCode" type="text" class="form-control required" />
                </td>
            </tr>
            <tr>
                <th class="formTitle" style="height: 35px;">Tùy chọn</th>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">
                        <input id="F_EnabledMark" name="F_EnabledMark" type="checkbox" checked="checked"><label for="F_EnabledMark">Hiệu lực</label>
                    </div>
                </td>
            </tr>
            <tr>
                <th class="formTitle" valign="top" style="padding-top: 5px;">Ghi chú
                </th>
                <td class="formValue">
                    <textarea id="F_Description" name="F_Description" class="form-control" style="height: 60px;"></textarea>
                </td>
            </tr>
        </table>
    </div>
</form>

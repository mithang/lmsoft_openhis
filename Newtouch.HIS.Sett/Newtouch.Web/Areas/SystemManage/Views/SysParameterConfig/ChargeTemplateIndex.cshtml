
@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a id="NF-add" class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a id="NF-edit" class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa</a>
        </div>
        <div class="btn-group">
            <select id="yxbz" style="height:25px">
                <option value="1">Hiệu lực</option>
                <option value="0">Không hiệu lực</option>
            </select>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Vui lòng nhập từ khóa cần tra cứu" style="width: 200px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>

<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script type="">

    var $gridList = $("");
    $gridList.dataGrid({
        url: "",
        postData: { keyword: $("").val(), yxbz: $("").val() },
        height: $(window).height() - 146,
        colModel: [
            { label: "", name: "", hidden: true, key: true },
            { label: '', name: '', width: 100, align: '' },
            { label: '', name: '', width: 150, align: '' },
            {
                label: "", name: "", width: 60, align: "",
                formatter: function (cellvalue) {
                    if (cellvalue == "") {
                        return ""
                    } else if (cellvalue == "") {
                        return ""
                    } else {
                        return ""
                    }
                }
            },
            {
                label: "", name: "", width: 60, align: "",
                formatter: function (cellvalue) {
                    return cellvalue == "" ? "" : "";
                }
            },
            { label: '', name: '', width: 100, align: '' },
            { label: '', name: '', width: 100, align: '' },
            {
                label: '', name: '', width: 100, align: '',
                formatter: "", formatoptions: { srcformat: '', newformat: '' }
            },
        ],
        sortname: '',
        pager: "",
        viewrecords: true,
        rowNum: 15,
    });

    $("").click(function () {
        $("").jqGrid('', {
            postData: { keyword: $("").val(), yxbz: $("").val() },
            page: 1,
        }).trigger('');
    });

    //Sự kiện nhấn Enter
    $('').keydownEnterEvent(function () {
        $('').trigger('');
    })

    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    function btn_edit() {
        var keyValue = $("").jqGridRowValue().sfmbbh;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    function btn_delete() {

        var rowKey = $("").jqGrid('', "");
        var rowData = $("").jqGrid("", rowKey);//Theo nội dung trênrowKeyLấy tất cả dữ liệu của dòng này

        var keyValue = $("").jqGridRowValue().sfmbbh;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.deleteForm({
            url: "",
            param: { keyValue: keyValue },
            success: function () {
                $("").jqGrid('', {
                    postData: { keyword: $("").val(), yxbz: $("").val() },
                }).trigger('');
            }
        })
    }
</script>

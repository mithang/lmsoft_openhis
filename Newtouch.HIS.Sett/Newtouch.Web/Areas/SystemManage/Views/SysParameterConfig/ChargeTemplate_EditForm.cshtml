@{
    ViewBag.Title = "";
    Layout = "";
}

<form id="form1">
    <div style="margin-top: 10px; margin-left: 10px; margin-right: 10px;">
        <div style="padding-top: 20px; margin-right: 30px;">
            <table id="tb_xm" class="form">
                <tr>
                    <th class="formTitle">Khoa quyền：</th>
                    <td class="formValue">
                        <select id="dllDepartment" name="dllDepartment" class="form-control">
                            <option>==Vui lòng chọn==</option>
                        </select>
                    </td>
                    <th class="formTitle"><span class="required">*</span>Mã mẫu：</th>
                    <td class="formValue formDdlSelectorTd">
                        <input id="sfmb" name="sfmb" type="text" class="form-control required" value="" placeholder="Vui lòng nhập mã mẫu" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle"><span class="required">*</span>Tên mẫu：</th>
                    <td class="formValue">
                        <input id="sfmbmc" name="sfmbmc" type="text" class="form-control required" value="" placeholder="Vui lòng nhập tên mẫu" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>名称首拼：</th>
                    <td class="formValue formDdlSelectorTd">
                        <input id="py" name="py" type="text" class="form-control required" value=""  />
                    </td>
                </tr>
            </table>
            <table id="tb_com" class="form">
                <tr>
                    <td class="formTitle"><span class="required">*</span>Cờ ngoại trú/nhập viện：</td>
                    <td class="formValue">
                        <select id="mzzybz" name="mzzybz" class="form-control required">
                            <option value="">==Vui lòng chọn==</option>
                            <option value="0">Chung</option>
                            <option value="1">Ngoại trú</option>
                            <option value="2">Nhập viện</option>
                        </select>
                    </td>
                    <th class="formTitle">Tần suất：</th>
                    <td class="formValue">
                        <input type="text" id="yzpc" class="form-control" value="">
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Lượng điều trị một lần：</th>
                    <td class="formValue">
                        <input type="text" id="zll" class="form-control" value="">
                    </td>
                    <th class="formTitle"><span class="required">*</span>Số lượng：</th>
                    <td class="formValue">
                        <input type="text" id="sl" class="form-control" value="">
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Số lần thực hiện：</th>
                    <td class="formValue">
                        <input type="text" id="zxcs" class="form-control" value="">
                    </td>
                    <th class="formTitle">部位：</th>
                    <td class="formValue">
                        <input type="text" id="bw" class="form-control" value="">
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Khoa thực hiện：</th>
                    <td class="formValue">
                        <select id="zxks" name="zxks" class="form-control">
                            <option>==Vui lòng chọn==</option>
                        </select>
                    </td>
                    <th class="formTitle">Cách dùng：</th>
                    <td class="formValue">
                        <select id="yf" name="yf" class="form-control">
                            <option>==Vui lòng chọn==</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Loại phục hồi chức năng：</th>
                    <td class="formValue formDdlSelectorTd">
                        <select id="kflb" name="kflb" class="form-control" data-ItemType="RehabTreatmentMethod">
                            <option value="">==Vui lòng chọn==</option>
                        </select>
                    </td>
                    <th class="formTitle">Thời lượng đơn vị(phút)：</th>
                    <td class="formValue">
                        <input id="duration" type="text" class="form-control" value="" />
                    </td>
                </tr>
            </table>
            <table id="tb_op" class="form" hidden="hidden">
                <tr>
                    <th class="formTitle">Nhóm lớn thu phí：</th>
                    <td class="formValue formDdlSelectorTd">
                        <select id="sfdl" name="sfdl" class="form-control" >
                            <option value="">==Vui lòng chọn==</option>
                        </select>
                    </td>
                </tr>
            </table>
            <table id="tb_addxm" class="form">
                <tr>
                    <th class="formTitle"><b><span class="required">*</span>Thêm hạng mục：</b></th>
                    <td class="formValue">
                        <input id="txtSFXMSel" type="text" class="form-control" placeholder="Vui lòng nhập tên hạng mục hoặc Phiên âm" />
                    </td>
                    <th class="formTitle">Tùy chọn：</th>
                    <td class="formValue" style="padding-top: 1px;">
                        <div class="ckbox">
                            <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Hiệu lực</label>
                        </div>
                    </td>
                    <td>
                        &nbsp;&nbsp;&nbsp;
                        <i class="fa fa-minus-circle fa-lg" id="btn_Remove" style="cursor:pointer;" onclick="btn_removeItem()"></i>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</form>

<div class="rows" style="margin: 1% 5%;" id="divPatOutHospitalChargeListInfo">
    <table id="xmDetailListGridList"></table>
</div>

<script src=""~/Content/js/floatingselector.js""></script>
<link href="@SiteUrl.GetStaticResourceScriptUrl("~/Content/css/floatingselector.css", false)" rel="stylesheet" />
<script>
    var keyValue = $.request("");
    var opDept = '';
    $(function () {
        initControl();
        if (!!keyValue) {
            $.ajax({
                url: "",
                data: { keyValue: keyValue },
                dataType: "",
                async: false,
                success: function (data) {
                    $("").formSerialize(data.TemplateEntity);
                    debugger
                    $("").val(data.TemplateEntity.ks).trigger('');
                    $("").val(data.TemplateEntity.yfdm).trigger('');
                    if (data.SysList && data.SysList.length) {
                        if (data.SysList[0].kflb) {
                            $("").val(data.SysList[0].kflb).trigger('');
                        }
                        if (data.SysList[0].zxks) {
                            $("").val(data.SysList[0].zxks).trigger('');
                        }
                        //if (data.SysList[0].yf) {
                            
                        //}
                    }

                    initChargeItemGrid(data.SysList);
                }
            });
        }
        else {
            initChargeItemGrid([]);
        };
    });

    function initControl() {
        $("").html('').bindSelect({
            url: "",
        });
        //Cấu hình phẫu thuật Hạng mục phẫu thuật mặc định thì
        if (opDept != null && opDept != "") {
            $("").val(opDept).trigger('');

            if ($("").attr("")) {
                $("").attr("", false);
                $("").attr("", true);
            }

        }

        $("").html('').bindSelect({
            url: "",
        });
        $('').select2();
        $('').pcFloatingSelector({
            showtext: "",
            attrcols: ['', ''],
            itemdbclickhandler: function ($this) {
                $('').val($this.attr(''));
                $('').attr('', $this.attr(''));
                $('').attr('', $this.attr(''));
            }
        });

        //$("").change(function () {
        //    var dept = $("").val();
        //    if (dept == opDept) {
        //        if ($("").attr("")) {
        //            $("").attr("", false);
        //            $("").attr("", true);
        //        }
        //    }
        //    else {
        //        if ($("").attr("")) {
        //            $("").attr("", false);
        //            $("").attr("", true);
        //        }
        //    }
        //});

        //加载收费大类树
        $("").bindSelect({
            url: ""
        });


        //Tải cách dùng thuốc
        $("").bindSelect({
            url: "",
            id: "",
            text: ""
        });

    }

    //jGridKhai báo
    function initChargeItemGrid(data) {
        $('').newtouchLocalDataGrid({
            height: 100,
            unwritten: false,
            caption: "",
            colModel: [
                { label: '', name: '', hidden: true, key: true },
                { label: '', name: '', width: 140, align: '' },
                { label: '', name: '', hidden: true, align: '' },
                { label: '', name: '', width: 40, align: '' },
                { label: '', name: '', width: 70, align: '' },
                { label: '', name: '', width: 40, align: '' },
                //{ label: '', name: '', width: 60, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', hidden: true, align: '' },
                { label: '', name: '', width: 70, align: '' },
                { label: '', name: '', hidden: true },
                { label: '', name: '', width: 70, align: '' },
                { label: '', name: '', hidden: true },
                { label: '', name: '', width: 80, align: '' },
            ]
        }, data);
    }

    //Thu phí lớp nổi chọn hạng mục
    $('').sfxmFloatingSelector({
        djDecimalPlaces: 4,
        searchType: '',
        ajaxparameters: function ($thisinput) {
            return "" + '' + "" + $.trim($('').val());
        },
        itemdbclickhandler: function ($thistr) {
            var returnFlag = false;
            var allData = $("").getRowData_AllLine(undefined, true);
            $.each(allData, function () {
                var itemsfxm = this[""];
                if (itemsfxm && itemsfxm == $thistr.attr('')) {
                    returnFlag = true;
                    return;
                }
            });
            if (returnFlag) {
                return; //Không thể thêm lặp lại
            }
            btn_addItem($thistr);
        },
    });

    //Thêm hạng mục
    function btn_addItem($thistr) {
        var valsl = $('').val();
        var valduration = $('').val();
        var valzll = $('').val();
        var valzxcs = $('').val();
        var valbw = $('').val();
        var valkflb = $('').val();
        var textkflb = "";
        if (!!valkflb) { 
            textkflb = $('').find("").text();
        }
        if (((/^(\+|-)?\d+$/).test(valsl)) && (valsl < 0)) {
            $.modalAlert("", '');
            return;
        }
        if (((/^(\+|-)?\d+$/).test(valduration)) && (valduration < 0)) {
            $.modalAlert("", '');
            return;
        }
        if (((/^(\+|-)?\d+$/).test(valzll)) && (valzll < 0)) {
            $.modalAlert("", '');
            return;
        }
        if (((/^(\+|-)?\d+$/).test(valzxcs)) && (valzxcs < 0)) {
            $.modalAlert("", '');
            return;
        }

        if (!valsl && !valzll) {
            $.modalAlert("", '');
            return;
        }
        
        var valYzpc = $('').attr('');
        if (!$('').val() || $('').val() != $('').attr('')) {
            valYzpc = null;
        }

        $('').val('');
        $('').val("");
        $('').val('');
        $('').newtouchLocalDataGrid(null, [{
            sfxmCode: $thistr.attr(''),
            sfxmmc: $thistr.attr(''),
            py: $thistr.attr(''),
            dw: $thistr.attr(''),
            sl: valsl,
            zll: valzll,
            zxcs: valzxcs,
            bw: valbw,
            duration: valduration,
            kflb: valkflb,
            kflbmc: textkflb,
            zxks: $('').val(),
            //zxks: $thistr.attr(''),
            yzpc: valYzpc,
            dj: $thistr.attr(''),
        }]);
    }
    //
    function btn_removeItem() {
        var rowid = $("").jqGrid("", "");
        var data = $('').jqGrid('', rowid);
        $('').jqGrid("", rowid);
    };

    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        var postData = $("").formSerialize();

        //Phương thức thanh toán jsonChuỗi
        var xmArr = new Array();
        var rowIds = $("").getDataIDs();
        $.each(rowIds, function (idx, val) {
            var thisRowData = $("").jqGrid('', val);
            xmArr.push({
                sfxmCode: thisRowData[''],
                sfxmmc: thisRowData[''],
                py: thisRowData[''],
                dw: thisRowData[''],
                zxcs: thisRowData[''],
                bw: thisRowData[""],
                zll: thisRowData[''],
                sl: thisRowData[''],
                duration: thisRowData[''],
                kflb: thisRowData[''],
                dl: thisRowData[''],
                zxks: thisRowData[''],
                yzpc: thisRowData[''],
                dj: thisRowData[''],
            });
        });
        if (xmArr.length == 0) {
            $.modalAlert("", '');
            return false;
        }
        postData[''] = JSON.stringify(xmArr);
        debugger
        postData[''] = keyValue;  //Khóa chính，决定是新增还是修改
        postData[''] = $('').val();
        postData[''] = $('').val();
        postData[''] = $('').val();
        
        var yfop = $("");//Lấy mục đã chọn
        postData[''] = yfop.val();
        postData[''] = yfop.text();
        if ($('').val() =="") {
            postData[''] = null;
            postData[''] = null;
        }

        $.submitForm({
            url: "",
            param: postData,
            success: function () {
                $.currentWindow().$("").resetSelection();
                $.currentWindow().$("").trigger("");
                $.modalClose();
            }
        })
    }

    $('').focus(function () {
        var appid = '';
        var organizeId = top.$.cookie(appid + "");
        if (!!!keyValue && ($.trim($(this).val()) === '')) {
            $.ajax({
                url: "" + organizeId + "" + Math.random(),
                dataType: "",
                success: function (data) {
                    $('').val(data.data);
                }

            });
        }
    });

    //根据名称获取名称首拼
    $('').keyup(function () {
        $('').val($(this).toShouPin());
    })
    
</script>

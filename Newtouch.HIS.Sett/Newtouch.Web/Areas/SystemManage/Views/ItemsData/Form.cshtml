@{
    ViewBag.Title = "";
    Layout = "";
}
<script>
    var keyValue = $.request("");
    var itemId = $.request("");
    $(function () {
        if (!!keyValue) {
            $.ajax({
                url: "" + Math.random(),
                data: { keyValue: keyValue },
                dataType: "",
                async: false,
                success: function (data) {
                    $("").formSerialize(data);
                }
            });
        }
    });
    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        var postData = $("").formSerialize();
        postData[""] = itemId;
        $.submitForm({
            url: "" + keyValue,
            param: postData,
            success: function () {
                $.currentWindow().$("").trigger("");
            }
        })
    }
</script>

<form id="form1">
    <div style="padding-top: 20px; margin-right: 20px;">
        <table class="form">
            <tr>
                <th class="formTitle">Tên</th>
                <td class="formValue">
                    <input id="F_ItemName" name="F_ItemName" type="text" class="form-control required" placeholder="Vui lòng nhập tên" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Số hiệu</th>
                <td class="formValue">
                    <input id="F_ItemCode" name="F_ItemCode" type="text" class="form-control required" placeholder="Vui lòng nhập số hiệu" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Sắp xếp</th>
                <td class="formValue">
                    <input id="px" name="px" type="text" class="form-control required" />
                </td>
            </tr>
            <tr>
                <th class="formTitle" style="height: 35px;">Tùy chọn</th>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">
                        <input id="F_IsDefault" name="F_IsDefault" type="checkbox"><label for="F_IsDefault">Mặc định</label>
                    </div>
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Hiệu lực</label>
                    </div>
                </td>
            </tr>
            <tr>
                <th class="formTitle" valign="top" style="padding-top: 5px;">Ghi chú
                </th>
                <td class="formValue">
                    <textarea id="F_Description" name="F_Description" class="form-control" style="height: 60px;"></textarea>
                </td>
            </tr>
        </table>
    </div>
</form>

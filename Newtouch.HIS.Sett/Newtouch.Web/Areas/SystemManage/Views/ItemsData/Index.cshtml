@{
    ViewBag.Title = "";
    Layout = "";
}
<script>
    $(function () {
        $('').layout();
        treeView();
        gridList();
    });
    function treeView() {
        $("").treeview({
            url: "" + Math.random(),
            onnodeclick: function (item) {
                $("").val('');
                $('').trigger("");
            }
        });
    }
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            height: $(window).height() - 96,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: '', name: '', width: 150, align: '' },
                { label: '', name: '', width: 150, align: '' },
                { label: '', name: '', width: 80, align: '' },
                {
                    label: "", name: "", width: 60, align: "",
                    formatter: function (cellvalue) {
                        return cellvalue == true ? "" : "";
                    }
                },
                {
                    label: '', name: '', width: 80, align: '',
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                {
                    label: "", name: "", width: 60, align: "",
                    formatter: function (cellvalue) {
                        return cellvalue == "" ? "" : "";
                    }
                },
                { label: "", name: "", index: "", width: 200, align: "", sortable: false }
            ]
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                url: "",
                postData: { itemId: $("").getCurrentNode().id, keyword: $("").val(), r: Math.random() },
            }).trigger('');
        });
    }
    function btn_add() {
        var itemId = $("").getCurrentNode().id;
        var itemName = $("").getCurrentNode().text;
        if (!itemId) {
            return false;
        }
        $.modalOpen({
            id: "",
            title: itemName + "",
            url: "" + itemId + "" + Math.random(),
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_edit() {
        var itemName = $("").getCurrentNode().text;
        var keyValue = $("").jqGridRowValue().Id;
        $.modalOpen({
            id: "",
            title: itemName + "",
            url: "" + keyValue + "" + Math.random(),
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_delete() {
        $.deleteForm({
            url: "",
            param: { keyValue: $("").jqGridRowValue().Id },
            success: function () {
                $("").resetSelection();
                $("").trigger("");
            }
        })
    }
    function btn_details() {
        var keyValue = $("").jqGridRowValue().Id;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue + "" + Math.random(),
            width: "",
            height: "",
            btn: null,
        });
    }
    function btn_itemstype() {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + Math.random(),
            width: "",
            height: "",
            btn: null,
        });
    }
</script>
<div class="ui-layout" id="layout" style="height: 100%; width: 100%;">
    <div class="ui-layout-west">
        <div id="itemTree"></div>
    </div>
    <div class="ui-layout-center">
        <div class="topPanel">
            <div class="toolbar">
                <div class="btn-group">
                    <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
                </div>
                <div class="btn-group">
                    <a id="NF-add" authorize="yes" class="btn btn-primary dropdown-text" onclick="btn_add()"><i class="fa fa-plus"></i>新建字典</a>
                    <a class="btn btn-primary dropdown-toggle" data-toggle="dropdown"><span class="caret"></span></a>
                    <ul class="dropdown-menu pull-right">
                        <li><a id="NF-itemstype" authorize="yes" onclick="btn_itemstype()" href="javascript:void()">分类管理</a></li>
                    </ul>
                </div>
                <div class="operate">
                    <ul class="nav nav-pills">
                        <li class="first">Đã chọn<span>1</span>Mục</li>
                        <li><a id="NF-edit" authorize="yes" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa từ điển</a></li>
                        <li><a id="NF-Details" authorize="yes" onclick="btn_details()"><i class="fa fa-search-plus"></i>查看字典</a></li>
                    </ul>
                    <a href="javascript:;" class="close"></a>
                </div>
                     @*<script>$('').authorizeButton()</script>*@
            </div>
            <div class="search">
                <table>
                    <tr>
                        <td>
                            <div class="input-group">
                                <input id="txt_keyword" type="text" class="form-control" placeholder="Tên/Số hiệu" style="width: 200px;">
                                <span class="input-group-btn">
                                    <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                                </span>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="gridPanel">
            <table id="gridList"></table>
        </div>
    </div>
</div>

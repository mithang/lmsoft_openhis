@using Newtouch.Common.Operator;
@{
    ViewBag.Title = "";
    Layout = "";
    var opeator = OperatorProvider.GetCurrent();
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group" style="width:200px;">
                        <select id="MainType" name="MainType" class="form-control">
                            <option value="">==Vui lòng chọn==</option>
                        </select>
                    </div>
                </td>
            </tr>
        </table>
    </div>
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
            @if (opeator.IsAdministrator || opeator.IsRoot || true)
            {
                <a class="btn btn-primary dropdown-toggle" data-toggle="dropdown"><span class="caret"></span></a>
                <ul class="dropdown-menu pull-right">
                    <li><a onclick="btn_main()" href="javascript:void()">分类维护</a></li>
                </ul>
            }
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-pencil-square-o"></i>Xóa</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Đối chiếu tên/Đối chiếu mã" style="width: 200px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script>
    $(function () {
        gridList();

    })

    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            postData: { keyword: $("").val(), MainType: $('').val() },
            url: "",
            height: $(window).height() - 128,
            colModel: [
                 { label: "", name: "", hidden: true, key: true },
                { label: "", name: "", width: 80, align: "", formatter: function (cellvalue) { return cellvalue == "" ? "" : ""; } },
                  { label: "", name: "", width: 100, align: '' },
                  { label: '', name: '', width: 100, align: '' },
                  { label: "", name: "", width: 100, align: '' },
                  { label: '', name: '', width: 100, align: '' },
                  { label: '', name: '', width: 150, align: '' },
                  { label: '', name: '', width: 40, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 130, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 130, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
            ],
        });
        $("").click(function () {
            $("").jqGrid('', {
                postData: { keyword: $("").val(), MainType: $('').val() },
            }).trigger('');
        });
    }

    $("").bindSelect({
        url: "",
    });
    $("").change(function () {
        if ($("").length > 0) {
            //Xóa trống dòng đã chọn
            $("").resetSelection();
        }
        $("").trigger('');
    });

    function btn_add() {
        var MainTypeId = $('').val();
        var MainTypeText = $('').html();
        if (!!!MainTypeId || !!!MainTypeText) {
            $.modalAlert("", "");
            return;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + MainTypeId + "" + MainTypeText,
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("").resetSelection();
                    $("").trigger("");
                });
            }
        });
    }

    function btn_edit() {
        var MainTypeId = $('').val();
        var MainTypeText = $('').html();
        if (!!!MainTypeId || !!!MainTypeText) {
            $.modalAlert("", "");
            return;
        }
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + MainTypeId + "" + MainTypeText + "" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("").resetSelection();
                    $("").trigger("");
                });
            }
        });
    }

    //Xóa
    function btn_delete() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.deleteForm({
            url: "",
            param: { keyValue: keyValue },
            success: function () {
                $("").resetSelection();
                $("").trigger("");
            }
        });
    }

    function btn_main() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            btn: null,
        });

    }

</script>

@{
    ViewBag.Title = "";
    Layout = "";
}

<form id="form1">
    <div style="padding-top: 20px; margin-right: 30px;">
        <table class="form">
            <tr>
                <td class="formTitle">对照分类：</td>
                <td class="formValue">
                    <label id="MainTypeText"></label>
                    <input id="MainId" name="MainId" style="display:none;" type="text" class="form-control required" />
                </td>
            </tr>
            <tr>
                <td class="formTitle"><span class="required">*</span>Tên：</td>
                <td class="formValue">
                    <input id="Name" name="Name" type="text" class="form-control required" placeholder="Vui lòng nhập tên" />
                </td>
            </tr>
            <tr>
                <td class="formTitle"><span class="required">*</span>Mã：</td>
                <td class="formValue">
                    <input id="Code" name="Code" type="text" class="form-control required" placeholder="Vui lòng nhập mã" />
                </td>
            </tr>
            <tr>
                <td class="formTitle"><span class="required">*</span>Tên bên thứ ba：</td>
                <td class="formValue">
                    <input id="TTName" name="TTName" type="text" class="form-control required" placeholder="Vui lòng nhập tên bên thứ ba" />
                </td>
            </tr>
            <tr>
                <td class="formTitle"><span class="required">*</span>Mã bên thứ ba：</td>
                <td class="formValue">
                    <input id="TTCode" name="TTCode" type="text" class="form-control required" placeholder="Vui lòng nhập mã bên thứ ba" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Giải thích：</th>
                <td class="formValue">
                    <input id="TTExplain" name="TTExplain" type="text" class="form-control" placeholder="" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Sắp xếp：</th>
                <td class="formValue">
                    <input id="px" name="px" type="text" class="form-control" placeholder="" />
                </td>
            </tr>
            <tr>
                <th class="formTitle" style="height: 35px;">Trạng thái：</th>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Hiệu lực</label>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    var MainTypeId = $.request("");
    var MainTypeText = $.request("");
    var keyValue = $.request("");
    $(function () {
        if (!!!MainTypeId || !!!MainTypeText) {
            $.modalAlert("", "");
            $.modalClose();
            return;
        }
        $('').val(MainTypeId);
        $('').html(MainTypeText);

        initControl();

        if (!!keyValue) {
            $.ajax({
                url: "",
                data: { keyValue: keyValue },
                dataType: "",
                async: false,
                success: function (data) {
                    $("").formSerialize(data);
                }
            });
        }
    });

    function initControl() {

    }

    function AcceptClick(callBack) {
        if (!$('').formValid()) {
            return false;
        }

        var postData = $("").formSerialize();

        $.submitForm({
            url: "" + keyValue,
            param: postData,
            success: function () {
                callBack();
                $.modalClose();
            }
        })
    }
</script>


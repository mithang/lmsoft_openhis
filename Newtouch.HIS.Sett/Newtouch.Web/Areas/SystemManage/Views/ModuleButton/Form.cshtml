
@{
    ViewBag.Title = "";
    Layout = "";
}

<form id="form1">
    <div style="padding-top: 30px; margin-right: 30px;">
        <table class="form">
            <tr>
                <th class="formTitle">Tên</th>
                <td class="formValue">
                    <input id="Name" name="Name" type="text" class="form-control required" placeholder="Vui lòng nhập tên" />
                </td>
                <th class="formTitle">Số hiệu</th>
                <td class="formValue">
                    <input id="Code" name="Code" type="text" class="form-control required" placeholder="Vui lòng nhập số hiệu" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Kết nối</th>
                <td class="formValue">
                    <input id="UrlAddress" name="UrlAddress" type="text" class="form-control" />
                </td>
                <th class="formTitle">Sắp xếp</th>
                <td class="formValue">
                    <input id="px" name="px" type="text" class="form-control" />
                </td>
            </tr>
            <tr>
                <th class="formTitle" style="height: 35px;">Tùy chọn</th>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Hiệu lực</label>
                    </div>
                </td>
            </tr>
            <tr>
                <th class="formTitle" valign="top" style="padding-top: 5px;">
                    Mô tả
                </th>
                <td class="formValue" colspan="3">
                    <textarea id="Description" name="Description" class="form-control" style="height: 100px;"></textarea>
                </td>
            </tr>
        </table>
    </div>
</form>
<script>
    var keyValue = $.request("");
    var moduleId = $.request("");
    $(function () {
        initControl();
        if (!!keyValue) {
            $.ajax({
                url: "",
                data: { keyValue: keyValue },
                dataType: "",
                async: false,
                success: function (data) {
                    $("").formSerialize(data);
                }
            });
        }
    });
    function initControl() {

    }
    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        var postData = $("").formSerialize();
        postData[""] = moduleId;
        $.submitForm({
            url: "" + keyValue,
            param: postData,
            success: function () {
                top.modulebutton.$("").resetSelection();
                top.modulebutton.$("").trigger("");
            }
        })
    }
</script>

@using Newtouch.Common.Operator;
@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="topPanel" style="border: 0px;">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        @if (OperatorProvider.GetCurrent().IsRoot)
        {
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
            </div>
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
            </div>
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-pencil-square-o"></i>Xóa</a>
            </div>
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_authorg()"><i class="fa fa-plus"></i>Ủy quyền cơ quan</a>
            </div>
        }
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script>
    var moduleId = $.request("");
    $(function () {
        gridList();
    })
    function gridList() {
        $("").dataGrid({
            url: "" + moduleId,
            height: $(window).height() - 90,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: '', name: '', width: 100, align: '' },
                    { label: '', name: '', width: 200, align: '' },
                { label: '', name: '', width: 50, align: '' },
                {
                    label: "", name: "", width: 60, align: "",
                    formatter: function (cellvalue) {
                        return cellvalue == 1 ? "" : "";
                    }
                },
                { label: '', name: '', width: 180, align: '' },
                   { label: '', name: '', width: 40, align: '' },
                { label: "", name: "", width: 60, align: "", formatter: function (cellvalue) { return cellvalue == "" ? "" : ""; } },
                { label: '', name: '', width: 60, align: '' },
                { label: '', name: '', width: 80, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
                { label: '', name: '', width: 60, align: '' },
                { label: '', name: '', width: 80, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },

            ]
        });
    }
</script>

<script type="">

    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + moduleId,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    function btn_edit() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + moduleId + "" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    function btn_delete() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.deleteForm({
            url: "",
            param: { keyValue: $("").jqGridRowValue().Id },
            success: function () {
                $("").resetSelection();
                $("").trigger("");
            }
        })
    }

    function btn_authorg() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
</script>
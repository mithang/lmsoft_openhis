@using Newtouch.Common.Operator;
@{
    ViewBag.Title = "";
    Layout = "";
}

<form id="form1">
    <div style="padding: 20px 35px 0 2px;">
        <table class="form">
            <tr>
                <th class="formTitle">Tính chất bệnh nhân</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="brxz" name="brxz" required/>
                </td>
                <th class="formTitle">Nhóm lớn</th>
                <td class="formValue">
                    <select id="dl" name="dl" class="form-control" required>
                        <option value="">Vui lòng chọn</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Hạng mục thu phí</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="sfxm" name="sfxm" required />
                </td>
                <th class="formTitle">Hạng mục thuốc</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="yp" name="yp" required />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Người lập hồ sơ</th>
                <td class="formValue">
                    <input type="text" class="form-control newtouch_Readonly" id="CreatorCode" name="CreatorCode" value=@OperatorProvider.GetCurrent().UserCode />
                </td>
                <th class="formTitle">Ngày lập hồ sơ</th>
                <td class="formValue">
                    <input type="text" class="form-control newtouch_Readonly" id="CreateTime" name="CreateTime" value=@DateTime.Now.ToString("yyyy-MM-dd") />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Hiệu lực</th>
                <td class="formValue">
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt"></label>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</form>


<script>
    var keyValue = $.request("");
    $(function () {
        InitControl();
        if (!!keyValue) {
            $.ajax({
                url: "" + Math.random(),
                data: { keyValue: keyValue },
                dataType: "",
                async: false,
                success: function (data) {
                    $("").formSerialize(data);
                    $('').attr("",data.brxz)
                        .val(data.brxzmc);
                    $('').attr("",data.sfxm)
                        .val(data.sfxmmc);
                    $('').attr("", data.yp)
                        .val(data.ypmc);
                }
            });
        }
    })

    //Lớp nổi tính chất bệnh nhân
    $("").newtouchFloatingSelector({
        height: 200,
        width: 300,
        filter: function (keyword) {
            if (!keyword) {
                return null;
            }
            //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
            var resultObjArr = new Array();
            $.each(top.window.clients.sysPatientNatureList, function (idx, val) {
                if ((val.py && val.py.toLowerCase().indexOf(keyword.toLowerCase()) >= 0) || keyword.trim() == "") {
                    resultObjArr.push(val);
                }
            });
            return resultObjArr;

        },
        caption: "",
        colModel: [
            { label: '', name: '', widthratio: 25 },
            { label: '', name: '', widthratio: 25 },
            { label: '', name: '', widthratio: 25 },
            { label: '', name: '', widthratio: 25 }
        ],
        itemdbclickhandler: function ($thistr) {
            $("").val($thistr.attr(''))
                .attr('', $thistr.attr(''))
            return;
        }
    });

    //Hạng mục thu phí
    $('').newtouchFloatingSelector({
        width: 600,
        height: 280,
        caption: "",
        url: '',
        ajaxparameters: function () {
            if ($.trim($('').val()).length == 0) {
                return;
            }
            return "" + $.trim($('').val());
        },
        itemdbclickhandler: function ($thistr) {
            $('').attr('', $thistr.attr(''))
                .val($thistr.attr(''));
        },
        colModel: [{ label: '', name: '', widthratio: 10 },
            { label: '', name: '', widthratio: 15 },
            { label: '', name: '', widthratio: 10 },
            { label: '', name: '', widthratio: 7 },
            { label: '', name: '', widthratio: 8 },
            { label: '', name: '', widthratio: 10 },
            { label: '', name: '', widthratio: 13 }
        ]
    });

    //Hạng mục thuốc
    $('').newtouchFloatingSelector({
        width: 600,
        height: 280,
        caption: "",
        url: '',
        ajaxparameters: function () {
            if ($.trim($('').val()).length == 0) {
                return;
            }
            return "" + $.trim($('').val());
        },
        itemdbclickhandler: function ($thistr) {
            $('').attr('', $thistr.attr(''))
                .val($thistr.attr(''));
        },
        colModel: [{ label: '', name: '', widthratio: 15 },
            { label: '', name: '', widthratio: 15 },
            { label: '', name: '', widthratio: 7 },
            { label: '', name: '', widthratio: 8 },
            { label: '', name: '', widthratio: 10 },
            { label: '', name: '', widthratio: 13 },
            { label: '', name: '', widthratio: 13 },
            { label: '', name: '', widthratio: 13 },
            { label: '', name: '', widthratio: 13 }
        ]
    });

    function InitControl() {
        dlList();
    }

    function dlList() {
        $("").bindSelect({
            url: ""
        });
    }

    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        var params = $("").formSerialize();
        params[''] = $('').attr('');
        params[''] = $('').attr('');
        params[''] = $('').attr('');
        $.submitForm({
            url: "" + keyValue,
            param: params,
            success: function () {
                $.currentWindow().window.frames[''].$("").trigger("");
            }
        })
    }
</script>
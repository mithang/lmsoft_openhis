@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
    //预交金充值收据报表链接
    var yjjReportUrl = SysConfigReader.OrgReportLink("");
    var curOpr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
    var reportUrl = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("");
    var ReportSystemCode = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("");
}
<form id="form1">
    <div class="rows" style="margin-bottom: 1%;" id="basicInfo">
        <div class="panel panel-default" style="margin-bottom:0;">
            <div class="panel-heading navb-bg">
                Thông tin cơ bản bệnh nhân
            </div>
            <table class="form" style="margin-left: 10px;">
                <tr>
                    <th class="formTitle"><span style="color:red">*</span><label id="lbl_kh">Số bệnh án/Họ tên：</label> </th>
                    <td class="formValue" colspan="2">
                        <input type="text" id="keyword" name="keyword" class="form-control" placeholder="Ít nhất1ký tự vị" />
                    </td>
                    <td class="formTitle">
                        Họ tên：
                    </td>
                    <td class="formValue">
                        <label id="xm"></label>
                    </td>
                    <td class="formTitle">Giới tính：</td>
                    <td class="formValue">
                        <label id="xb"></label>
                    </td>
                    <td class="formTitle">Tuổi：</td>
                    <td class="formValue">
                        <label id="nlshow"></label>
                    </td>
                    <td class="formTitle">
                        <label id="zjlx">Số chứng minh nhân dân：</label>
                        <input hidden="hidden" id="hiddenzjlx" />
                    </td>
                    <td class="formValue" colspan="2">
                        <label id="zjh"></label>
                    </td>
                </tr>
                <tr>
                    <td class="formTitle">Điện thoại di động：</td>
                    <td class="formValue"><label id="phone"></label></td>
                    <td class="formTitle"></td>
                    <td class="formValue"></td>
                    <td class="formTitle"></td>
                    <td class="formValue">
                        <input type="hidden" id="brxzmc" />
                        <input type="text" hidden value="" id="patid" name="patid" />
                        <input type="text" hidden value="" id="zhCode" name="zhCode" />
                        <input type="text" hidden value="" id="zhxz" name="zhxz" />
                        <input type="text" hidden id="zhye" name="zhye" value="">
                    </td>
                    <td class="formTitle"></td>
                    <td class="formValue"></td>
                    <td class="formValue"><input type="hidden" id="patid" /></td>
                </tr>
            </table>
        </div>
    </div>
</form>
<!--Danh sách thu chi-->
<form id="formPat2">
    <div class="gridPanel" style="margin-top:10px;border-radius:5px;">
        <table id="gridList" rel="formPat2"></table>
    </div>
</form>
<!--Nạp tiền tạm ứng và hoàn phí-->
<div class="panel panel-default" style="margin-top:10px;">
    <div class="panel-heading navb-bg">
        Tiền tạm ứng
    </div>
    <div style="padding: 2px;padding-right:20px;">
        <table class="form">
            <tr>
                <th class="formTitle">Phương thức thanh toán：</th>
                <td class="formValue">
                    <select id="ddlzffs" name="zffs" class="form-control required"></select>
                </td>
                <th class="formTitle"><span class="required">*</span>Số tiền：</th>
                <td class="formValue">
                    <input id="txtmoney" name="txtmoney" type="text" class="form-control required" placeholder="Vui lòng nhập số tiền" />
                </td>
                <th class="formTitle">Số chứng từ：</th>
                <td class="formValue">
                    <input type="text" id="txtlpzh" class="form-control newtouch_Readonly" style="width: 49.5%;display: inline;" value="" />
                    <a id="receipt" class="btn btn-primary" onclick=""><i class="fa"></i>Số chứng từ</a>
                </td>
                <th class="formTitle"></th>
                <td class="formValue"></td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="ReceiptPanel"></table>
</div>
<!--Thanh công cụ nút-->
<div class="toolbar toolbarfloat">
    <a id="acc_addMoney" class="btn btn-primary" onclick="sjPrint()"><i class="fa fa-plus"></i> In bù</a>
    <a id="acc_addMoney" class="btn btn-primary" onclick="PayDeposit()"><i class="fa fa-plus"></i> Nạp tiền</a>
    <a id="acc_reMoney" class="btn btn-primary" onclick="Refund()"><i class="fa fa-minus"></i> Hoàn tiền</a>
    <a id="acc_reMoney" class="btn btn-primary" onclick="RefundAccount()"><i class="fa fa-minus"></i> Hoàn trả toàn bộ số dư</a>
    <a class="btn btn-primary" onclick="newtouch_globalevent_f5()"><span class="glyphicon glyphicon-refresh"> Làm mới</span></a>
</div>
<style>
    #yeCon {
        padding-left: 25px;
        color: red;
    }
</style>

<script>
    var reqzhxz = $.request("");
    var patid = "";
    $(function () {
        if (!reqzhxz) {
            reqzhxz = "";
        }
        else if (reqzhxz == "") {
            reqzhxz = '';
            $("").val(reqzhxz);
        }else if (reqzhxz == "") {
            reqzhxz = '';
            $("").val(reqzhxz);

        }
        $("").click(function () {
            showReceiptPanel(); //Bật lên cửa sổ số chứng từ
        });

        //Liên kết lớp nổi chọn hạng mục điều trị
        $('').newtouchBatchFloatingSelector({
            width: 500,
            height: 200,
            caption: "",
            clickautotrigger: true,
            url: "",
            ajaxparameters: function ($thisinput) {
                var keyword = $thisinput.val().trim();
                return "" + keyword+""+$.request("");
            },
            itemdbclickhandler: function ($thistr, $thisinput) {
                patid = $thistr.attr("");
                GetQuerypatientInfoAjax(patid);
            },
            colModel: [
               { label: '', name: '', hidden: true },
                { label: '', name: '', width: 80, align: '' },

                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', hidden: true, width: 100, align: '' },
                {
                    label: '', name: '', width: 70, align: '', formatter: function (cellvalue) {
                        return $.getGender(cellvalue);
                    }
                },
                { label: '', name: '', width: 100, align: '', formatter: function (cellvalue, a, b) {
                    return getAgeFromBirthTime({ begin: b.csny }).text;
                }
                },
                 { label: '', name: '', width: 60, align: '' },
                { label: '', name: '', align: '', hidden: true },
                { label: '', name: '', align: '', hidden: true },
                { label: '', name: '', align: '', hidden: true },
                { label: '', name: '', align: '', hidden: true },
                { label: '', name: '', align: '', hidden: true },
                { label: '', name: '', align: '', hidden: true },
                { label: '', name: '', align: '', hidden: true },
                { label: '', name: '', align: '', hidden: true },
                { label: '', name: '', align: '', hidden: true },
                { label: '', name: '', align: '', hidden: true },
                { label: '', name: '', align: '', hidden: true },
                { label: '', name: '', align: '', hidden: true },
            ]
        });
        gridListData([]);
        $(window).resize(function () {
            initLayout("");
        });

        $("").newtouchBindSelect({
            id: "",
            text: "",
            datasource: function () {
                //Duyệt nguồn dữ liệu
                var resultObjArr = new Array();
                $.each(top.clients.SysForCashPayList, function (idx, val) {
                    if (val.zhxz == '') {
                        resultObjArr.push(val);
                    }
                });
                return resultObjArr;
            }
        });
        GetSJPZH();
    });

    function GetQuerypatientInfoAjax(patid) {
        $.najax({
            type: "",
            url: ""PatAccountInfo"",
            data: { patid: patid, zhxz: $("").val() },
            dataType: "",
            cache: false,
            alertbierror: false,
            success: function (ajaxresp) {
                $.loading(false);
                var accPayInfoList = ajaxresp.data.accPayInfoList;
                var patInfo = ajaxresp.data.patInfo;
                if (patInfo != "") {
                    setPatInfoModel(ajaxresp.data.patInfo);
                }
                if (accPayInfoList.length > 0) {
                    gridListData(ajaxresp.data.accPayInfoList);
                }
            },
            errorCallback: function (rtnval) {
                if (rtnval.message == "") {
                    $.modalConfirm("", function (f) {
                        if (f) {
                            $.najax({
                                type: "",
                                url: "",
                                data: { patid: patid, zhxz: $("").val() },
                                dataType: "",
                                cache: false,
                                alertbierror: false,
                                success: function (res) {
                                    GetQuerypatientInfoAjax(patid);
                                    $('').jqGrid("");
                                }
                            });
                        }
                    })
                } else {
                    $.modalAlert(rtnval.message,"");
                }
            }
        });
    }

    //cửa sổ bật lên số chứng từ lấy
    function showReceiptPanel() {
        var cardNo = $("").val();
        if (cardNo) {
            $.modalOpen({
                id: "",
                title: "",
                url: "" + Math.random(),
                width: "",
                height: "",
                callBack: function (iframeId) {
                    top.frames[iframeId].ReceiptConfirm();
                }//Hàm callback xác nhận khi nhấn cửa sổ
            });
        } else {
            $.modalAlert("", '');
            $("").focus();
        }
    }

    //Lấy hiển thị giao diện thông tin cơ bản bệnh nhân
    function setPatInfoModel(patModel) {
        $("").html($.getGender(patModel.xb));
        $("").html((patModel.csny && patModel.csny.length >= 10 ? patModel.csny.substring(0, 10) : ""));
        $("").html(patModel.zjh);
        $("").html(patModel.xm);
        $("").html(getAgeFromBirthTime({ begin: patModel.csny }).text);
        $("").val(patModel.blh);
        $("").val(patModel.patid);
        $("").html(patModel.phone);
        $("").val(patModel.zjlx);
        $("").val(patModel.brxz);
        $("").val(patModel.zhCode);
        $("").val(patModel.zhxz);
        $("").val(patModel.blh);
    }

    //Danh sách thu chi tài khoản
    function gridListData(mydata) {
        $('').jqGrid("");
        var $gridList = $("");
        var zhye = "";
        if (mydata != [] && mydata.length > 0) {
            zhye = mydata[0].zhye.toFixed(2);
        }
        $("").val(zhye); //valueGán giá trị
        var captionCon = "";
        captionCon += '' ;
        captionCon += '';
        captionCon += "" + zhye + "";
        $gridList.dataNewGrid({
            height: $(window).height() - 330,
            autowidth: false,
            width: $("").width() - 10,
            caption: captionCon,
            colModel: [
                { label: '', name: '', width: 105, formatter: "",align: '' },
                { label: '', name: '', width: 105, formatter: "", align: '' },
                { label: '', name: '', width: 105, align: '' },
                { label: '', name: '', width: 105, align: '' },
                { label: '', name: '', width: 105, align: '' },
                { label: '', name: '', width: 125, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
                {
                    label: '', name: '', width: 105, align: '',
                    formatter: function (val) {
                        return $.enum.getDescByValue("", val)
                    }
                }, { label: '', name: '', hidden: true },
                 { label: '', name: '', hidden: true },
            ], gridComplete: function () {
                var ids = $gridList.getDataIDs();
                for (i = 0; i < ids.length; i++) {
                    var rowData = $gridList.getRowData(ids[i]);
                    if (rowData && rowData.szxz=="") {
                        $gridList.find('' + ids[i] + '').css("", "");
                    } else if (rowData && rowData.szxz == "") {
                        $gridList.find('' + ids[i] + '').css("", "");
                    }
                }
            },
            onSelectRow: function (rowid, status) {
                btn_edit();
            }
        }, mydata);

        if (mydata.length > 0) {
            $('').find("").remove();
        }
        $("").text("" + zhye + "");
    }

    var patid,
        zh,
        zhxz,
        zffsbh,
        zffsmc,
        zfmoney,
        pzh;
    //Đánh giá nạp tiền và hoàn tiền
    function CheckDeposit() {
        patid = $("").val();
        zh = $('').val();
        zhxz = $('').val();
        if (!!!patid) {
            $.modalAlert("", '');
            return false;
        }
        var reg = /^(-?\d+)(\.\d+)?$/;
        zfmoney = $("").val();
        var ddlzffs = $("");//Lấy mục đã chọn
        zffsbh = ddlzffs.val();//Lấy giá trị của mục đã chọn
        zffsmc = ddlzffs.text();//Lấy văn bản của mục đã chọn
        pzh = $("").val();
        if (zffsbh == -1 || zffsmc == "") {
            $.modalAlert("", '');
            return false;
        }
        if (zfmoney == "" || zfmoney == undefined) {
            $.modalAlert("", '');
            return false;
        } else {
            if (!reg.test(zfmoney)) {
                $.modalAlert("", '');
                return false;
            }
        }
        if (pzh == "" || pzh == undefined) {
            $.modalAlert("", '');
            return false;
        }
        return true;
    }

    //充值前台验证金额和是否选择支付类型
    function PayDeposit() {
        zfmoney = $("").val();
        if (parseFloat(zfmoney) < 0 || zfmoney == "" || isNaN(zfmoney) == true) {
            $.modalAlert("", '');
            return false;
        }
        if (CheckDeposit()) {
            PayDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid, zh, zhxz);
        }
    }

    //Nạp tiền tạm ứng
    function PayDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid,zh, zhxz) {
        $.loading(true, "");
        $.najax({
            type: "",
            url: "",
            data: {
                zffsbh: zffsbh, zffsmc: zffsmc,
                zfje: zfmoney, pzh: pzh, zh: zh,
                zhxz: zhxz,patid: patid,szxz:@Html.Raw((int)EnumSZXZ.cz)
            },
            dataType: "",
            cache: false,
            success: function (resdata) {
                if (resdata != null && resdata.data.flag) {
                    $.loading(false);
                    $.modalMsg("", '');
                    ClearMoney(); //Xóa trống
                    getZhInfo(zh); //Bản ghi thu chi tài khoản

                    var reqzhxz=$.request("")==''?'':''
                    var orgId = '';
                    //var uri = '' + "" + patid +""+resdata.data.szId;
                    var uri = '' + "" + "" + ''+ "" + orgId + "" + resdata.data.szId;
                    window.open(uri, "", "");
                }
            }, errorCallback: function (rtnval) {
                if (rtnval.message = "") {
                    GetSJPZH();
                }
                $.modalAlert(rtnval.message, "");
            }
        });
    }


    //Xóa trống
    function ClearMoney() {
        $('').jqGrid("");
        //Xóa trống hộp nhập số tiền
        $("").val("");
        $('').val("");
        //Lấy số chứng từ
        GetSJPZH();
        GetQuerypatientInfoAjax(patid);
    }

    //Lấy số chứng từ
    function GetSJPZH() {
        $.najax({
            type: "",
            url: "",
            data: {},
            dataType: "",
            cache: false,
            success: function (resdata) {
                if (resdata != null && resdata.data != "") {
                    $("").val(resdata.data);
                    return resdata.data;
                } else {
                    $("").val("");
                    return "";
                }
            }
        });
    }
    var gridIMoney = "";//số tiền thu chi của đã chọn hiện tại
    var gridIpzh = ""; //số chứng từ của đã chọn hiện tại
    var gridId = "";//đã chọn hiện tạiId
    var gridtId="";//đã chọn hiện tạiId，是否已退的根据
    //Nhấn sự kiện
    function btn_edit() {
        var szje = $("").jqGridRowValue().szje;
        var pzh = $("").jqGridRowValue().pzh;
        gridId = $("").jqGridRowValue().Id;
        gridtId = $("").jqGridRowValue().tId;
        gridIMoney = szje;
        gridIpzh = pzh;
        if (parseFloat(gridIMoney) > 0) {
            $("").val('' + szje);
        } else {
            return;
        }
        $("").val(pzh);
    }

    //充值收据补打
    function sjPrint()
    {
        var pzh = $("").val();
        if (gridIpzh == "" || pzh != gridIpzh) {
            $.modalAlert("", '');
            return false;
        }

        //var reqzhxz=$.request("")==''?'':''
        var orgId = '';
        //var uri = ''+"" + patid + ""+gridId;//+"" + reqzhxz
        var uri = '' + "" + "" + ''+ "" + orgId + "" + gridId;
        window.open(uri, "", "");
    }

    //Hoàn tiền
    function Refund() {
        var money = $("").val();
        var pzh = $("").val();
        var zhye = $("").val();
        if (parseFloat(money) > 0) {
            $.modalAlert("", '');
            return false;
        }
        if (gridIpzh == "" || pzh != gridIpzh) {
            $.modalAlert("", '');
            return false;
        }
        if (gridtId!="") {
            $.modalAlert("", '');
            return false;
        }
        if (gridIMoney != money.substring(1, money.length)) {
            $.modalAlert("", '');
            return false;
        }
        if (parseFloat(money) + parseFloat(zhye) < 0) {
            $.modalAlert("", '');
            return false;
        }

        if (CheckDeposit()) {
            ExitDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid,zh, zhxz,@Html.Raw(((int)EnumSZXZ.cz)));
        }
    }

    //Hoàn trả toàn bộ số dư
    function RefundAccount() {
        patid = $("").val();
        zh = $('').val();
        zhxz = $('').val();
        var money = $("").val();
        var zhye = $("").val();
        if (!!!patid) {
            $.modalAlert("", '');
            return false;
        }
        if (parseFloat(zhye) < 1) {
            $.modalAlert("", '');
            return false;
        }
        var reg = /^(-?\d+)(\.\d+)?$/;
        zfmoney = "" +$("").val();
        var ddlzffs = $("");//Lấy mục đã chọn
        zffsbh = ddlzffs.val();//Lấy giá trị của mục đã chọn
        zffsmc = ddlzffs.text();//Lấy văn bản của mục đã chọn
        if (zffsbh == -1 || zffsmc == "") {
            $.modalAlert("", '');
            return false;
        }
        $.loading(true, "");
        $.najax({
            type: "",
            url: "",
            data: {
                zffsbh: zffsbh, zffsmc: zffsmc, zfje: zfmoney,
                zh: zh, patid: patid, szxz:@Html.Raw(((int)EnumSZXZ.qk))
            },
            dataType: "",
            cache: false,
            success: function (resdata) {
                if (resdata != null) {
                    $.loading(false);
                    ClearMoney();
                    //Gọi danh sách thu chi tài khoản
                    getZhInfo(zh);
                    $.modalMsg("", '');
                }
            }
        });
    }

    //Hoàn tiền
    function ExitDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid,zh, zhxz) {
        $.loading(true, "");
        $.najax({
            type: "",
            url: "",
            data: {
                zffsbh: zffsbh, zffsmc: zffsmc, zfje: zfmoney,
                pzh: pzh, zh: zh, zhxz: zhxz, patid: patid,szxz:@Html.Raw(((int)EnumSZXZ.qk))
            },
            dataType: "",
            cache: false,
            success: function (resdata) {
                if (resdata != null && resdata.data) {
                    $.loading(false);
                    $.modalMsg("", '');
                    ClearMoney();
                    //Gọi danh sách thu chi tài khoản
                    getZhInfo(zh);

                }
            }
        });
    }

    //Tra cứu tài khoản
    function getZhInfo() {
        $.loading(true, "");
        $.najax({
            type: "",
            url: "",
            data: { zh: zh },
            dataType: "",
            cache: false,
            success: function (resdata) {
                if (resdata != null && resdata.data) {
                    $.loading(false);
                    gridListData(resdata.data);
                }
            }
        });
    }
</script>

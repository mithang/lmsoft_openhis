@using Newtouch.Common.Operator;

@{
    ViewBag.Title = "";
    Layout = "";
}

<form id="form1">
    <div style="padding: 20px 35px 0 2px;">
        <table class="form">
            <tr>
                <th class="formTitle">Tính chất bệnh nhân</th>
                <td class="formValue">
                    <select class="form-control" name="brxz" id="brxz" required>
                        <option value="">Vui lòng chọn</option>
                    </select>
                </td>
                <th class="formTitle">Nhóm lớn</th>
                <td class="formValue">
                    <select id="dl" name="dl" class="form-control" required>
                        <option value="">Vui lòng chọn</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Hạng mục thu phí</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="sfxm" name="sfxm" required/>
                </td>
                <th class="formTitle">服务费比例</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="fwfbl" name="fwfbl" required/>
                </td>
            </tr>
            <tr>
                <th class="formTitle">附加显示分类</th>
                <td class="formValue formDdlSelectorTd">
                    <input type="text" class="form-control" id="fjxsdl" name="fjxsdl" required/>
                </td>
                <th class="formTitle">Hiệu lực</th>
                <td class="formValue">
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt"></label>
                    </div>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Người lập hồ sơ</th>
                <td class="formValue">
                    <input type="text" class="form-control newtouch_Readonly" id="CreatorCode" name="CreatorCode" value=@OperatorProvider.GetCurrent().UserCode />
                </td>
                <th class="formTitle">Ngày lập hồ sơ</th>
                <td class="formValue">
                    <input type="text" class="form-control newtouch_Readonly" id="CreateTime" name="CreateTime" value=@DateTime.Now.ToString("yyyy-MM-dd") />
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    var keyValue = $.request("");
    $(function () {
        InitControl();
        if (!!keyValue) {
            $.ajax({
                url: "" + Math.random(),
                data: { keyValue: keyValue },
                dataType: "",
                async: false,
                success: function (data) {
                    $("").formSerialize(data);
                    $('').attr('', data.sfxm)
                      .val(data.sfxmmc);
                    $("").attr('', data.fjxsdl)
                        .val(data.fjxsdlmc);
                }
            });
        }
    })

    function InitControl() {
        dlList();
    }

    function dlList() {
        $("").bindSelect({
            url: ""
        });
    }
    //Tính chất bệnh nhân
    $("").newtouchBindSelect({
        datasource: function () {
            var resultObjArr = new Array();
            $.each(top.window.clients.sysPatientNatureList, function (idx, val) {
                resultObjArr.push( { id: val.brxz, text: val.brxzmc });
            });
            return resultObjArr;
        }
    });

    //Hạng mục thu phí
    $('').newtouchFloatingSelector({
        width: 600,
        height: 280,
        caption: "",
        url: '',
        ajaxparameters: function () {
            if ($.trim($('').val()).length == 0) {
                return;
            }
            return "" + $.trim($('').val());
        },
        itemdbclickhandler: function ($thistr) {
            $('').attr('', $thistr.attr(''))
                .attr('', $thistr.attr(''))
                .val($thistr.attr(''));
        },
        colModel: [{ label: '', name: '', widthratio: 10 },
            { label: '', name: '', widthratio: 15 },
            { label: '', name: '', widthratio: 10 },
            { label: '', name: '', widthratio: 7 },
            { label: '', name: '', widthratio: 8 },
            { label: '', name: '', widthratio: 10 },
            { label: '', name: '', widthratio: 13 }
        ]
    });

    //附加显示大类
    $("").newtouchFloatingSelector({
        height: 200,
        width: 350,
        id: '',
        url: '',
        ajaxmethod: '',
        ajaxreqdata: function () {
            var reqData = {};
            reqData.keyword = $("").val();
            return reqData;
        },
        caption: "",
        colModel: [
            { label: '', name: '', widthratio: 25 },
            { label: '', name: '', widthratio: 25 },
            { label: '', name: '', widthratio: 25 },
            { label: '', name: '', widthratio: 25 }
        ],
        itemdbclickhandler: function ($thistr) {
            $("").attr('', $thistr.attr(''))
                .val($thistr.attr(''));
            return;
        }

    });

    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        var params = $("").formSerialize();
        params[''] = $('').attr('');
        params[''] = $('').attr('');
        $.submitForm({
            url: "" + keyValue,
            param: params,
            success: function () {
                $.currentWindow().window.frames[''].$("").trigger("");
            }
        })
    }
</script>
@using Newtouch.Common.Operator;

@{
    ViewBag.Title = "";
    Layout = "";
}
<form id="form1">
    <div style="padding: 20px 35px 0 2px;">
        <table class="form">
            <tr>
                <th class="formTitle">Mã</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="dl" name="dl" required/>
                </td>
                <th class="formTitle">Nhóm lớn</th>
                <td class="formValue formDdlSelectorTd">
                    <input type="text" class="form-control" id="dlmc" name="dlmc" onblur="GetChineseSpell()" required />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Phiên âm</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="py" name="py" required/>
                </td>
                <th class="formTitle">Hiệu lực</th>
                <td class="formValue">
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt"></label>
                    </div>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Sắp xếp</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="px" name="px" />
                </td>
                <th class="formTitle">Người lập hồ sơ</th>
                <td class="formValue">
                    <input class="form-control newtouch_Readonly" id="CreatorCode" name="CreatorCode" value=@OperatorProvider.GetCurrent().UserCode type="text" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Ngày lập hồ sơ</th>
                <td class="formValue">
                    <input class="form-control newtouch_Readonly" id="CreateTime" name="CreateTime" value=@DateTime.Now.ToString("yyyy-MM-dd") type="text"/>
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    var keyValue = $.request("");
    $(function () {
        if (!!keyValue) {
            $.ajax({
                url: "" + Math.random(),
                data: { keyValue: keyValue },
                dataType: "",
                async: false,
                success: function (data) {
                    $("").formSerialize(data);
                }
            });
        }
    })

    //Phiên âm
    function GetChineseSpell()
    {
        var strText = $("").val();
        $.ajax({
            url: "" + Math.random(),
            data: { strText: strText },
            dataType: "",
            async: true,
            success: function (data) {
                $("").val(data);
            }
        });
    }

    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        $.submitForm({
            url: "" + keyValue,
            param: $("").formSerialize(),
            success: function () {
                $.currentWindow().window.frames[''].$("").resetSelection();
                $.currentWindow().window.frames[''].$("").trigger("");
                $.loading(false);
            }
        })
    }
</script>

@using Newtouch.Common.Operator;
@{
    ViewBag.Title = "";
    Layout = "";
}

<form id="form1">
    <div style="padding: 20px 35px 0 2px;">
        <table class="form">
            <tr>
                <td class="formTitle" hidden="hidden"><input type="text" id="ks" name="ks" class="form-control form-an" /></td>
                <td class="formTitle"><span class="rema">*</span>Khoa：</td>
                <td class="formValue"><input type="text" id="ksmc" name="ksmc" class="form-control form-an" /></td>
                <td class="formTitle">Bác sĩ：</td>
                <td class="formValue"><input type="text" id="doctor" class="form-control form-an" /></td>
                <td class="formValue" hidden="hidden"><input type="text" id="gh" class="form-control form-an" /></td>
                <td class="formValue" hidden="hidden"><input type="text" id="xm" class="form-control form-an" /></td>
            </tr>     
        </table>
    </div>
</form>

<script>
    var bddm = $.request("");
    $(function () {
        initControl();
        if (!!bddm) {
            $.ajax({
                url: "" + Math.random(),
                data: { bddm: bddm },
                dataType: "",
                async: false,
                success: function (data) {
                    $("").formSerialize(data);
                    $("").val(data.xm);
                }
            });
        }
    })

    function initControl() {
        ///Bác sĩ
        $("").newtouchFloatingSelector({
            height: 150,
            width: 250,
            clickautotrigger: true,
            filter: function (keyword) {
                //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
                var resultObjArr = new Array();

                $.each(top.window.clients.sysStaffDutyList, function (idx, val) {
                    if (((val.StaffPY && val.StaffPY.toLowerCase().indexOf(keyword.toLowerCase()) >= 0)
                        || (val.StaffName && val.StaffName.indexOf(keyword.toLowerCase()) >= 0)
                        || keyword.trim() == "")
                        && val.DutyCode == "") {
                        resultObjArr.push(val);
                    }
                });
                return resultObjArr;

            },
            caption: "",
            colModel: [
                {
                    label: '', name: '', widthratio: 33
                },
                {
                    label: '', name: '', widthratio: 33
                },
                { label: '', name: '', widthratio: 33 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("").attr("", $thistr.find("").html());
                $("").val($thistr.find('').html());
                $("").val($thistr.find("").html());
                $("").val($thistr.find("").html());
                return;
            }
        });

        ///Khoa
        $("").newtouchBatchFloatingSelector({
            height: 150,
            width: 250,
            clickautotrigger: true,
            filter: function (keyword) {
                //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
                var resultObjArr = new Array();
                $.each(top.window.clients.sysDepartList, function (idx, val) {
                    if ((val.py && val.py.indexOf(keyword.toLowerCase()) >= 0)
                        || (val.Name && val.Name.indexOf(keyword) >= 0)
                        || keyword.trim() == "") {
                        resultObjArr.push(val);
                    }
                });
                return resultObjArr;

            },
            caption: "",
            colModel: [
                { label: '', name: '', widthratio: 50 },
                { label: '', name: '', widthratio: 50 },
                { label: '', name: '', hidden: true }
            ],
            itemdbclickhandler: function ($thistr) {
                $("").val($thistr.find("").html());
                $("").attr("", $thistr.find("").html());
                $("").val($thistr.find('').html());
                return;
            },
        });
    }

    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        var params = $("").formSerialize();
        $.submitForm({
            url: "" + bddm,
            param: params,
            success: function () {
                $.currentWindow().$("").trigger("");
            }
        })
    }
</script>


@{
    ViewBag.Title = "";
    Layout = "";
}
<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a id="NF-add" class="btn btn-primary dropdown-text" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a id="NF-edit" class="btn btn-primary dropdown-text" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa thông tin</a>
        </div>
        <div class="btn-group">
            <a id="NF-delete" class="btn btn-primary dropdown-text" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa thông tin</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Tên bác sĩ" style="width: 200px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script>
    $(function () {
        initControl();
        gridList();
    });
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            height: 400,
            colModel: [
                { label: '', name: '', hidden: true },
                { label: '', name: '', width: 100, algin: '' },
                { label: '', name: '', width: 100, algin: '' },
                {
                    label: '', name: '', width: 100, algin: '',
                    formatter: function (cellvalue) {
                        if (cellvalue) {
                            return "";
                        } else {
                            return "";
                        }
                    }
                },
                { label: '', name: '', width: 100, algin: '' }
            ]
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: { keyword: $("").val() }, url: ""
            }).trigger('');
        })
    }

    function initControl() {

    }

    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    //Sửa
    function btn_edit() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var bddm = $("").jqGridRowValue().bddm;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + bddm,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    //Xóa
    function btn_delete() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var bddm = $("").jqGridRowValue().bddm;
        $.deleteForm({
            url: "",
            param: { bddm: bddm },
            success: function () {
                $("").trigger("");
            }
        })
    }
</script>


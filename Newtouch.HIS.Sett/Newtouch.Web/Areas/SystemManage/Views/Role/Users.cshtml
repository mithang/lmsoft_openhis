@{
    ViewBag.Title = "";
    Layout = "";
}

<script>
    var roleId = $.request("");
    $(function () {
        gridList();
    })
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            height: $(window).height() - 128,
            postData: { roleId: roleId },
            colModel: [
                { label: '', name: '', hidden: true },
                { label: '', name: '', width: 70, align: '' },
                { label: '', name: '', width: 100, align: '' },
                {
                    label: '', name: '', width: 40, align: '',
                    formatter: function (cellvalue, options, rowObject) {
                        if (cellvalue === true) {
                            return '';
                        }
                        else if (cellvalue === false) {
                            return '';
                        }
                        else {
                            return '';
                        }
                    }
                },
                {
                    label: '', name: '', width: 80, align: '',
                    formatter: function (cellvalue, options, rowObject) {
                        var mcelarr = $.jsonWhere(top.top.clients.department, function (v) { return v.Code == cellvalue });
                        return mcelarr == null || mcelarr.length == 0 ? "" : mcelarr[0].Name;
                    }
                },
               {
                   label: '', name: '', width: 150, align: '',
                   formatter: function (cellvalue, options, rowObject) {
                       var mcelarr = $.jsonWhere(top.top.clients.organize, function (v) { return v.Id == cellvalue });
                       return mcelarr == null || mcelarr.length == 0 ? "" : mcelarr[0].Name;
                   }
               },
            ],
            pager: "",
            sortname: '',
            viewrecords: true,
            multiselect: true,
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: { roleId: roleId, gh: $("").val(), name: $("").val() },
            }).trigger('');
        });
    }
    function btn_remove() {
        var ids = $("").jqGrid('', '');
        if (ids) {
            if (ids.join("")) {
                $.submitForm({
                    url: "",
                    close : false,
                    param: { roleId: roleId, userIds: ids.join("") },
                    success: function () {
                        $("").trigger('');
                    }
                });
            }
        }
    }
    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
        });
    }
</script>

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a id="NF-add" authorize="yes" class="btn btn-primary dropdown-text" onclick="btn_add()"><i class="fa fa-plus"></i>Thêm mới người dùng</a>
        </div>
        <div class="operate">
            <ul class="nav nav-pills">
                <li class="first">Đã chọn<span>1</span>Mục</li>
                <li><a id="NF-remove" authorize="yes" onclick="btn_remove()"><i class="fa fa-trash-o"></i>Người dùng xóa</a></li>
            </ul>
            <a href="javascript:;" class="close"></a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="gh" type="text" class="form-control" placeholder="Mã nhân viên" style="width: 200px;">
                        <input id="name" type="text" class="form-control" placeholder="Họ tên" style="width: 200px;margin-left:10px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

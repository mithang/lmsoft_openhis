
@{
    ViewBag.Title = "";
    Layout = "";
}

<script>
    var keyValue = $.request("");
    $(function () {
        initControl();
        $.ajax({
            url: "",
            data: { keyValue: keyValue },
            dataType: "",
            async: false,
            success: function (data) {
                $("").formSerialize(data);
                $("").find('').attr('', '');
                $("").find('').attr('', '');
            }
        });
    })
    function initControl() {
        $('').wizard().on('', function (e, data) {
            var $next = $("");
            if (data.direction == "") {
                switch (data.step) {
                    case 1:
                        $next.attr('', '');
                        break;
                    default:
                        break;
                }
            } else {
                $next.removeAttr('');
            }
        });
        $("").treeview({
            height: 493,
            showcheck: true,
            url: "",
            param: { roleId: keyValue }
        });
    }
</script>
<form id="form1">
    <div class="widget-body">
        <div id="wizard" class="wizard" data-target="#wizard-steps" style="border-left: none; border-top: none; border-right: none;">
            <ul class="steps">
                <li data-target="#step-1" class="active"><span class="step">1</span>Thông tin vai trò<span class="chevron"></span></li>
                <li data-target="#step-2"><span class="step">2</span>功能权限<span class="chevron"></span></li>
            </ul>
        </div>
        <div class="step-content" id="wizard-steps" style="border-left: none; border-bottom: none; border-right: none;">
            <div class="step-pane active" id="step-1" style="padding-left: 5px; padding-top: 20px; margin-right: 20px;">
                <table class="form">
                    <tr>
                        <th class="formTitle">Tên vai trò</th>
                        <td class="formValue">
                            <input id="Name" name="Name" type="text" class="form-control required" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Số hiệu vai trò</th>
                        <td class="formValue">
                            <input id="Code" name="Code" type="text" class="form-control" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Thứ tự hiển thị</th>
                        <td class="formValue">
                            <input id="px" name="px" type="text" class="form-control" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle" style="height: 35px;">Tùy chọn</th>
                        <td class="formValue" style="padding-top: 1px;">
                            <div class="ckbox">
                                <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Hiệu lực</label>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle" valign="top" style="padding-top: 5px;">
                            Ghi chú
                        </th>
                        <td class="formValue">
                            <textarea id="Description" name="Description" class="form-control" style="height: 60px;"></textarea>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Người tạo</th>
                        <td class="formValue">
                            <input id="CreatorCode" name="CreatorCode" type="text" class="form-control" />
                        </td>
                    </tr>
                    <tr>

                        <th class="formTitle">Thời gian tạo</th>
                        <td class="formValue">
                            <input id="CreateTime" name="CreateTime" type="text" class="form-control" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Người sửa</th>
                        <td class="formValue">
                            <input id="LastModifierCode" name="LastModifierCode" type="text" class="form-control" />
                        </td>

                    </tr>
                    <tr>
                        <th class="formTitle">Thời gian sửa</th>
                        <td class="formValue">
                            <input id="LastModifyTime" name="LastModifyTime" type="text" class="form-control" />
                        </td>
                    </tr>
                </table>
            </div>
            <div class="step-pane" id="step-2">
                <div id="permissionTree"></div>
            </div>
        </div>
        <div class="form-button" id="wizard-actions">
            <a id="btn_last" disabled class="btn btn-default btn-prev">上一步</a>
            <a id="btn_next" class="btn btn-default btn-next">下一步</a>
        </div>
    </div>
</form>


@using Newtouch.Common.Operator;
@{
    ViewBag.Title = "";
    Layout = "";
}
<div>
    请为医疗机构维护一个<span style="color:red;">医院管理员</span>Vai trò，Mã<span style="color:red;">HospAdministrator</span>
</div>
<div class="topPanel">
    @Html.Partial("")
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_users()"><i class="fa fa-pencil-square-o"></i>Người dùng vai trò</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Tên/Mã" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>
    $(function () {
        gridList();
    })
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            height: $(window).height() - 128,
            postData: { keyword: $("").val(), OrganizeId: $("").val() },
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: '', name: '', width: 150, align: '' },
                { label: '', name: '', width: 100, align: '' },
                  { label: '', name: '', width: 300, align: '' },
                { label: "", name: "", width: 80, align: "", formatter: function (cellvalue) { return cellvalue == "" ? "" : ""; } },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
                { label: '', name: '', width: 40, align: '' }
            ],
            pager: "",
            sortname: '',
            viewrecords: true,
            rowNum: '',
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: { keyword: $("").val(), OrganizeId: $("").val() },
            }).trigger('');
        });
    }

    //Sự kiện nhấn Enter
    $('').keydownEnterEvent(function () {
        $('').trigger('');
    })

    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            btn: null
        });
    }
</script>
<script>
    function btn_edit() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            btn: null
        });
    }
</script>
<script>
    function btn_delete() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.deleteForm({
            url: "",
            param: { keyValue: $("").jqGridRowValue().Id },
            success: function () {
                $.currentWindow().$("").trigger("");
            }
        })
    }
    function btn_users() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue + "" + $('').val(),
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    //Phương thức callback cây nhân viên người dùng
    function userStaffTreeCallback(data) {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            return;
        }
        var arr = new Array();
        $.each(data, function () {
            arr.push({ First: this.value, Second: this.Ex3 });  //First:UserId  Second:OrganizeId
        });
        if (keyValue) {
            $.submitForm({
                url: "" + keyValue,
                param: { userList: arr },
                success: function () {
                    $("").trigger("");
                    top.top.window.frames[''].$.modalClose();
                }
            });
        }
    }

</script>


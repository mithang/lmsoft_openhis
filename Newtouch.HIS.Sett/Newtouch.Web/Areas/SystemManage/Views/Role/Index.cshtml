@using Newtouch.Common.Operator;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<div>
    Vui lòng bảo trì một cho cơ sở y tế<span style="color:red;">Quản trị viên bệnh viện</span>Vai trò，Mã số<span style="color:red;">HospAdministrator</span>
</div>
<div class="topPanel">
    @Html.Partial("_OrganizeIdDDLToolbarSearchView")
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_users()"><i class="fa fa-pencil-square-o"></i>Người dùng vai trò</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Tên/Mã số" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>
    $(function () {
        gridList();
    })
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/SystemManage/Role/GetGridJson",
            height: $(window).height() - 128,
            postData: { keyword: $("#txt_keyword").val(), OrganizeId: $("#OrganizeId").val() },
            colModel: [
                { label: "Khóa chính", name: "Id", hidden: true, key: true },
                { label: 'Tên', name: 'Name', width: 150, align: 'left' },
                { label: 'Mã số', name: 'Code', width: 100, align: 'left' },
                  { label: 'Ghi chú', name: 'Description', width: 300, align: 'left' },
                { label: "Có hiệu lực", name: "zt", width: 80, align: "center", formatter: function (cellvalue) { return cellvalue == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
                { label: 'Người tạo', name: 'CreatorCode', width: 100, align: 'left' },
                { label: 'Thời gian tạo', name: 'CreateTime', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Sửa lần cuối', name: 'LastModifierCode', width: 100, align: 'left' },
                { label: 'Thời gian sửa lần cuối', name: 'LastModifyTime', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                { label: 'Sắp xếp', name: 'px', width: 40, align: 'left' }
            ],
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords: true,
            rowNum: '10',
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword").val(), OrganizeId: $("#OrganizeId").val() },
            }).trigger('reloadGrid');
        });
    }

    //Sự kiện Enter
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "Thêm vai trò mới",
            url: "/SystemManage/Role/Form",
            width: "550px",
            height: "570px",
            btn: null
        });
    }
</script>
<script>
    function btn_edit() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một thông tin", 'warning');
            return;
        }
        $.modalOpen({
            id: "Form",
            title: "Sửa vai trò",
            url: "/SystemManage/Role/Form?keyValue=" + keyValue,
            width: "550px",
            height: "570px",
            btn: null
        });
    }
</script>
<script>
    function btn_delete() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một thông tin", 'warning');
            return;
        }
        $.deleteForm({
            url: "/SystemManage/Role/DeleteForm",
            param: { keyValue: $("#gridList").jqGridRowValue().Id },
            success: function () {
                $.currentWindow().$("#gridList").trigger("reloadGrid");
            }
        })
    }
    function btn_users() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một thông tin", 'warning');
            return;
        }
        $.modalOpen({
            id: "FormRoleUsers",
            title: "Người dùng vai trò",
            url: "/SystemManage/User/Selector?from=rolerelatioinuser&cacheTime=0&callbackType=json&keyValue=" + keyValue + "&isShowEmpty=true&isContansChildOrg=false&organizeId=" + $('#OrganizeId').val(),
            width: "650px",
            height: "570px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    //Phương thức callback cây nhân viên người dùng
    function userStaffTreeCallback(data) {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            return;
        }
        var arr = new Array();
        $.each(data, function () {
            arr.push({ First: this.value, Second: this.Ex3 });  //First:UserId  Second:OrganizeId
        });
        if (keyValue) {
            $.submitForm({
                url: "/SystemManage/Role/submitRoleUser?roleId=" + keyValue,
                param: { userList: arr },
                success: function () {
                    $("#gridList").trigger("reloadGrid");
                    top.top.window.frames['FormRoleUsers'].$.modalClose();
                }
            });
        }
    }

</script>


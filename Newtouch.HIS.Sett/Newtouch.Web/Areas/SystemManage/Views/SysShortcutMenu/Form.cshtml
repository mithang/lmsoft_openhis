@{
    ViewBag.Title = "";
    Layout = "";
}

<form id="form1">
    <div style="padding-top: 20px; margin-right: 30px;">
        <table class="form">
            <tr>
                <th class="formTitle"><span class="required">*</span>Tên：</th>
                <td class="formValue">
                    <input id="Name" name="Name" type="text" class="form-control required" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Mã：</th>
                <td class="formValue">
                    <input id="Code" name="Code" type="text" class="form-control" />
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>Địa chỉ：</th>
                <td class="formValue">
                    <input id="UrlAddress" name="UrlAddress" type="text" class="form-control required" />
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>图片路径：</th>
                <td class="formValue">
                    <input id="ImgPath" name="ImgPath" type="text" class="form-control required" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Sắp xếp：</th>
                <td class="formValue">
                    <input id="px" name="px" type="text" class="form-control" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Tùy chọn：</th>
                <td class="formValue">
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" class="" /><label for="zt">Hiệu lực</label>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    var keyValue = $.request("");
    $(function () {
        initControl();
        if (!!keyValue) {
            $.ajax({
                url: "",
                data: { keyValue: keyValue },
                dataType: "",
                success: function (data) {
                    $("").formSerialize(data);
                }
            });
        }
    });

    function initControl() {
        
    }

    function AcceptClick(callBack) {
        if (!$('').formValid()) {
            return false;
        }
        var postData = $("").formSerialize();

        $.submitForm({
            url: "" + keyValue,
            param: postData,
            success: function () {
                callBack();
                $.modalClose();
            }
        });
    }
</script>

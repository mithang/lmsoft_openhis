@{
    ViewBag.Title = "";
    Layout = "";

    var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        @if (opr.IsRoot || opr.IsAdministrator)
        {
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
            </div>
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
            </div>
        }
        else
        {
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_authrole()"><i class="fa fa-gavel"></i>Ủy quyền vai trò</a>
            </div>
        }
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Tên/Mã" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script>
    $(function () {
        initControl();
        gridList();
    });
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            postData: {},
            url: "",
            height: $(window).height() - 128,
            colModel: [
                { label: "", name: "", width: 100, align: '', key: true, hidden: true },
                { label: "", name: "", width: 100, align: '' },
                { label: "", name: "", width: 150, align: '' },
                { label: "", name: "", width: 320, align: '' },
                { label: "", name: "", width: 320, align: '' },
                { label: "", name: "", width: 60, align: '' },
                { label: "", name: "", width: 80, align: "", formatter: function (cellvalue) { return cellvalue == "" ? "" : ""; } },
            ],
            viewrecords: true,
        });
        $("").click(function () {
            $("").jqGrid('', {
                postData: { keyword: $("").val() }, page: 1
            }).trigger('');
        });
    }

    function initControl() {

    }

</script>
@if (opr.IsRoot || opr.IsAdministrator)
{
    <script type="">

        function btn_add() {
            $.modalOpen({
                id: "",
                title: "",
                url: "",
                width: "",
                height: "",
                callBack: function (iframeId) {
                    $.currentWindow(iframeId).AcceptClick(function () {
                        $("").resetSelection();
                        $("").trigger("");
                    });
                }
            });
        }

        function btn_edit() {
            var keyValue = $("").jqGridRowValue().Id;
            if (!!!keyValue) {
                $.modalAlert("", '');
                return;
            }
            $.modalOpen({
                id: "",
                title: "",
                url: "" + keyValue,
                width: "",
                height: "",
                callBack: function (iframeId) {
                    $.currentWindow(iframeId).AcceptClick(function () {
                        $("").resetSelection();
                        $("").trigger("");
                    });
                }
            });
        }

    </script>
}
else
{
    <script type="">
        function btn_authrole() {
            var keyValue = $("").jqGridRowValue().Id;
            if (!!!keyValue) {
                $.modalAlert("", '');
                return;
            }
            $.modalOpen({
                id: "",
                title: "",
                url: "" + keyValue,
                width: "",
                height: "",
                callBack: function (iframeId) {
                    $.currentWindow(iframeId).AcceptClick(function () {

                    });
                }
            });
        }
    </script>
}
@{
    ViewBag.Title = "";
    Layout = "";
}
<script>
    var keyValue = $.request("");
    $(function () {
        initControl();
        if (!!keyValue) {
            $.ajax({
                //url: "" + Math.random(),
                url: "",
                data: { keyValue: keyValue },
                dataType: "",
                async: false,
                cache: false,
                success: function (data) {
                    $("").formSerialize(data);
                }
            });
        }
    });
    function initControl() {
        $("").bindSelect({
            url: "" + Math.random(),
        });
    }
    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        $.submitForm({
            url: "" + keyValue + "" + Math.random(),
            param: $("").formSerialize(),
            success: function () {
                $.currentWindow().$("").trigger("");
            }
        })
    }
</script>

<form id="form1">
    <div style="padding-top: 20px; margin-right: 20px;">
        <table class="form">
            <tr>
                <th class="formTitle">归属组织</th>
                <td class="formValue">
                    <select id="F_OrganizeId" name="F_OrganizeId" class="form-control required">
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Tên vị trí công tác</th>
                <td class="formValue">
                    <input id="F_FullName" name="F_FullName" type="text" class="form-control required" placeholder="Vui lòng nhập tên vị trí công tác" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Số hiệu vị trí công tác</th>
                <td class="formValue">
                    <input id="F_EnCode" name="F_EnCode" type="text" class="form-control required" placeholder="Vui lòng nhập số hiệu vị trí công tác" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Thứ tự hiển thị</th>
                <td class="formValue">
                    <input id="px" name="px" type="text" class="form-control" placeholder="请输入显示顺序" />
                </td>
            </tr>
            <tr>
                <th class="formTitle" style="height: 35px;">Tùy chọn</th>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Hiệu lực</label>
                    </div>
                </td>
            </tr>
            <tr>
                <th class="formTitle" valign="top" style="padding-top: 5px;">Ghi chú
                </th>
                <td class="formValue">
                    <textarea id="F_Description" name="F_Description" class="form-control" style="height: 60px;"></textarea>
                </td>
            </tr>
        </table>
    </div>
</form>

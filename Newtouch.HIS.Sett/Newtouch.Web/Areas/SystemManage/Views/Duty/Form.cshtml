@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<script>
    var keyValue = $.request("keyValue");
    $(function () {
        initControl();
        if (!!keyValue) {
            $.ajax({
                //url: "/SystemManage/Duty/GetFormJson?r=" + Math.random(),
                url: "/SystemManage/Duty/GetFormJson",
                data: { keyValue: keyValue },
                dataType: "json",
                async: false,
                cache: false,
                success: function (data) {
                    $("#form1").formSerialize(data);
                }
            });
        }
    });
    function initControl() {
        $("#F_OrganizeId").bindSelect({
            url: "/SystemManage/Organize/GetTreeSelectJson?r=" + Math.random(),
        });
    }
    function submitForm() {
        if (!$('#form1').formValid()) {
            return false;
        }
        $.submitForm({
            url: "/SystemManage/Duty/SubmitForm?keyValue=" + keyValue + "&r=" + Math.random(),
            param: $("#form1").formSerialize(),
            success: function () {
                $.currentWindow().$("#gridList").trigger("reloadGrid");
            }
        })
    }
</script>

<form id="form1">
    <div style="padding-top: 20px; margin-right: 20px;">
        <table class="form">
            <tr>
                <th class="formTitle">Tổ chức trực thuộc</th>
                <td class="formValue">
                    <select id="F_OrganizeId" name="F_OrganizeId" class="form-control required">
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Tên vị trí</th>
                <td class="formValue">
                    <input id="F_FullName" name="F_FullName" type="text" class="form-control required" placeholder="Vui lòng nhậpTên vị trí" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Mã vị trí</th>
                <td class="formValue">
                    <input id="F_EnCode" name="F_EnCode" type="text" class="form-control required" placeholder="Vui lòng nhậpMã vị trí" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Thứ tự hiển thị</th>
                <td class="formValue">
                    <input id="px" name="px" type="text" class="form-control" placeholder="Vui lòng nhậpThứ tự hiển thị" />
                </td>
            </tr>
            <tr>
                <th class="formTitle" style="height: 35px;">Tùy chọn</th>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Có hiệu lực</label>
                    </div>
                </td>
            </tr>
            <tr>
                <th class="formTitle" valign="top" style="padding-top: 5px;">Ghi chú
                </th>
                <td class="formValue">
                    <textarea id="F_Description" name="F_Description" class="form-control" style="height: 60px;"></textarea>
                </td>
            </tr>
        </table>
    </div>
</form>

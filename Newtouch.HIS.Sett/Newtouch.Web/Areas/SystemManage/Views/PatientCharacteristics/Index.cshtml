@{
    ViewBag.Title = "";
    Layout = "";
}
<script>
    $(function () {
        gridList();
    });
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            treeGrid: true,
            treeGridModel: "",
            ExpandColumn: "",
            postData: { keyword: $("").val() },
            url: "",
            height: 420,
            colModel: [
                { label: '', name: '', hidden: true, key: true },
                { label: '', name: '', width: 170, algin: '' },
                { label: '', name: '', width: 100, algin: '' },
                {
                    label: '', name: '', width: 100, algin: '',
                    formatter: function (cellvalue) {
                        return $.enum.getDescByValue("", cellvalue);
                    }
                },
                 {
                     label: '', name: '', width: 100, algin: '',
                     formatter: function (cellvalue) {
                         return $.enum.getDescByValue("", cellvalue);
                     }
                 },
                {
                    label: '', name: '', width: 100, algin: '', formatter: function (cellvalue) {
                        return $.enum.getDescByValue("", cellvalue);
                    }
                },
                { label: '', name: '', width: 80, algin: '', },
                { label: '', name: '', width: 100, algin: '', }
            ],
            pager: "",
            sortname: '',
            viewrecords: true
        });
        $("").click(function () {
            $gridList.jqGrid('',
                {
                    postData: { keyword: $("").val() }
                }).trigger('');
        });
    }

    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            showleftlalbel: true,
            callBack: function (iframeId, leftlabel) {
                top.frames[iframeId].submitForm(leftlabel);
            }
        });
    }

    function btn_edit() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var keyValue = $("").jqGridRowValue().brxzbh;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_delete() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        $.deleteForm({
            url: "",
            param: { keyValue: $("").jqGridRowValue().brxzbh },
            success: function () {
                $.currentWindow().$("").resetSelection();
                $.currentWindow().$("").trigger("");
            }
        });
    }
    function btn_details() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var keyValue = $("").jqGridRowValue().brxzbh;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            btn: null
        });
    }
</script>

<form>
    <div class="topPanel">
        <div class="toolbar">
            <div class="btn-group">
                <a id="NF-add" class="btn btn-primary dropdown-text" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
            </div>
            <div class="btn-group">
                <a id="NF-edit" class="btn btn-primary dropdown-text" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
            </div>
            <div class="btn-group">
                <a id="NF-delete" class="btn btn-primary dropdown-text" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa</a>
            </div>
            <div class="btn-group">
                <a id="NF-Details" class="btn btn-primary dropdown-text" onclick="btn_details()"><i class="fa fa-search-plus"></i>Xem</a>
            </div>
        </div>
        <div class="search">
            <table>
                <tr>
                    <td>
                        <div class="input-group">
                            <input id="txt_keyword" type="text" class="form-control" placeholder="Tên hạng mục/Mã hạng mục" style="width: 200px;">
                            <span class="input-group-btn">
                                <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                            </span>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>

@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Vui lòng nhập tài khoản" style="width: 200px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
                <td style="padding-left: 10px;">
                    <div id="time_horizon" class="btn-group">
                        <a class="btn btn-default" data-value="1">Hôm nay</a>
                        <a class="btn btn-default active" data-value="2">近7Ngày</a>
                        <a class="btn btn-default" data-value="3">近1Tháng cái</a>
                        <a class="btn btn-default" data-value="4">近3Tháng cái</a>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>
    $(function () {
        gridList();
    })

    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            height: $(window).height() - 128,
            colModel: [
                { label: '', name: '', hidden: true },
                {
                    label: '', name: '', width: 120, align: '',
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 100, align: '' },
                {
                    label: '', name: '', width: 80, align: '',
                    formatter: function (cellvalue) {
                        return $.enum.getDescByName("", cellvalue);
                    }
                },
                {
                    label: '', name: '', width: 230, align: '',
                    formatter: function (cellvalue, options, rowObject) {
                        if (cellvalue && IPAddressName) {
                            return cellvalue + "" + rowObject.IPAddressName;
                        }
                        else {
                            return "";
                        }
                    }
                },
                { label: '', name: '', width: 300, align: '' }
            ],
            pager: "",
            sortname: '',
            viewrecords: true
        });

        $("").click(function () {
            $("").removeClass("");
            $(this).addClass("");
            $('').trigger("");
        });

        $("").click(function () {
            var timeType = $("").attr('');
            var queryJson = {
                keyword: $("").val(),
                timeType: $("").attr(''),
            }
            $gridList.jqGrid('', {
                postData: { queryJson: JSON.stringify(queryJson) },
                page: 1,
            }).trigger('');
        });

        //回车触发查询事件
        $('').keydownEnterEvent(function () {
            $('').trigger('');
        })
    }

</script>
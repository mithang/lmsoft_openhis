
@{
    ViewBag.Title = "";
    Layout = "";
}

<script>
    var organizeId = $.request("");
    var keyValue = $.request("");
    var isShowEmpty = $.request("");
    var isExpand = $.request("");
    var callbackType = $.request("");
    var single = $.request("");
    var fromDialog = $.request("");
    var cacheTime = $.request("");
    var initIdSelected = $.request("");
    $(function () {
        initControl();
    })
    function initControl() {
        $("").treeview({
            height: 400,
            slimscroll: false,
            showcheck: true,
            url: "",
            param: { organizeId: organizeId, isExpand: isExpand, callbackType: callbackType, single: single, fromDialog: fromDialog, cacheTime: cacheTime, initIdSelected: initIdSelected }
        });
    }
    function submitForm() {
        var treeSeleData;
        if (callbackType == '') {
            treeSeleData = $("").getCheckedNodeObjArray();
            if (single == '' && treeSeleData.length != 1) {
                $.modalAlert('', '');
                return;
            }
        }
        else {
            treeSeleData = $("").getCheckedNodes();
            if (single == '' && treeSeleData.length != 1) {
                $.modalAlert('', '');
                return;
            }
            treeSeleData = String(treeSeleData);
        }

        if (false) {

        }
        else if (fromDialog) {
            //Mặc định hành vi，callbackMột trênDialogphương thức
            top.top.window.frames[fromDialog].staffTreeCallback(treeSeleData);
        }
        else {
            //Mặc định hành vi，callbackphương thức của trang một trên
            $.currentWindow().window.staffTreeCallback(treeSeleData);
        }
    }
</script>
<div>
    <div id="staffTree"></div>
</div>



@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="panel panel-default">
    <table class="form">
        <tr>
            <th class="formTitle"><span class="required">*</span>查询时间范围：</th>
            <td class="formValue">
                <input id="kssj" type="text" class="form-control input-wdatepicker" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" value="@DateTime.Now.AddDays(-3).ToString("yyyy-MM-dd")" />
            </td>
            <th style="text-align:center;width:50px;">Đến</th>
            <td class="formValue">
                <input id="jssj" type="text" class="form-control input-wdatepicker" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
            </td>
            <td class="formTitle">
                <input type="button" class="btn btn-default btn-md" id="btn_search" value="Tra cứu" />
            </td>
        </tr>
    </table>
</div>

<div class="gridPanel">
    <table id="gridList"></table>
</div>
<script>
    $(function () {
        gridList();
        $("").trigger("");
    });

    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            height: $(window).height() - 100,
            colModel: [
                { label: '', name: '', algin: '', width: 80 },
                { label: '', name: '', algin: '' },
                { label: '', name: '', algin: '', width: 80 },
                { label: '', name: '', algin: '' },
                { label: '', name: '', algin: '' },
                { label: '', name: '', algin: '' },
                { label: '', name: '', algin: '', width: 80 },
                {
                    label: '', name: '', align: '', width: 120, 
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                }
            ]
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: {
                    kssj: $("").val(),
                    jssj: $("").val()
                }, url: ""
            }).trigger('');
        })
    }
</script>


@using Newtouch.Common.Operator;
@{
    ViewBag.Title = "";
    Layout = "";
}

<form id="form1">
    <div style="padding: 20px 35px 0 2px;">
        <table class="form">
            <tr>
                <th class="formTitle">Chữ cái đầu：</th>
                <td class="formValue">
                    <input name="szm" type="text" class="form-control" id="szm" />
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>起始发票号：</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="qsfph" name="qsfph" required />
                </td>
                <th class="formTitle"><span class="required">*</span>Kết thúc số hóa đơn：</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="jsfph" name="jsfph" required />
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>Số hóa đơn hiện tại：</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="dqfph" name="dqfph" required />
                </td>
                <th class="formTitle">Hiệu lực</th>
                <td class="formValue">
                    <div class="ckbox">
                        <input id="zt" type="checkbox" checked="checked"><label for="zt"></label>
                    </div>
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>Người lĩnh dùng：</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="lyry" name="lyry" required />
                </td>
                <th class="formTitle">领用日期：</th>
                <td class="formValue">
                    <input id="lyrq" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    var fpdm = $.request("");
    $(function () {
        initControl();
        if (!!fpdm) {
            $.ajax({
                url: "" + Math.random(),
                data: { fpdm: fpdm },
                dataType: "",
                async: false,
                success: function (data) {
                    $("").formSerialize(data);
                    //Định dạngUTCNgày
                    $("").val(new Date(data.CreateTime).format(""));
                    $("").val(new Date(data.CreateTime).format(""));
                }
            });
        }
    })
    function initControl() {

    }

    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        var params = $("").formSerialize();
        $.submitForm({
            url: "" + fpdm,
            param: params,
            success: function () {
                $.currentWindow().$("").trigger("");
            }
        })
    }

    //Người lĩnh dùng
    $("").click(function () {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + '' + "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].AcceptClick(function (data) {
                    userStaffTreeCallback(data);
                });
            }
        });
    });
    //Phương thức callback cây nhân viên người dùng
    function userStaffTreeCallback(data) {
        $("").val(data[0].Code);
    }

</script>

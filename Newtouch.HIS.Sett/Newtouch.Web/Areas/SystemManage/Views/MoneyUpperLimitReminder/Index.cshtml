
@{
    ViewBag.Title = "";
    Layout = "";
}

<style>
   .newform-control {
        height: 24px;
        padding-top: 0px;
        padding-bottom: 0px;
        padding-right: 0px;
        padding-left: 5px;
        resize: none;
        border-radius: 4px;
        box-shadow: none;
        border: 1px solid #ddd;
    }
    .newformTitle {
        position: relative;
        left: 0px;
        text-align: right;
        white-space: nowrap;
        font-weight: normal;
        padding-right: 15px;
    }
.form-control:focus{
    -webkit-box-shadow:inset 0 0px 1px rgba(0,0,0,.075) !important;

}
</style>

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a id="NF-add" class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a id="NF-edit" class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a id="NF-delete" class="btn btn-primary dropdown-text" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <th class="newformTitle">Từ khóa：</th>
                <td>
                    <input id="keyword" type="text" class="newform-control form-control" placeholder="Khoa/Bác sĩ" style="width: 75%;">
                </td>
                <th class="newformTitle">Loại：</th>
                <td style="width: 28%;">
                    @Html.DropDownList("", Newtouch.Infrastructure.EnmuReminderType.金额上限提醒.ToDescSelectList(), "", new { @class = "", @style = "" })
                </td>
                <td>
                    <input type="button" id="btn_search" class="btn btn-primary" style="width:122%;margin-left:146%;" value="Tra cứu">
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>
    $(function () {
        gridList();

        $('').select2({
            minimumResultsForSearch: -1
        });
    });

    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            postData: getSearchPostData(),
            height: 400,
            colModel: [
            { label: "", name: "", width: 100, align: "", hidden: true },
            { label: "", name: "", width: 130, align: "" },
            { label: "", name: "", width: 130, align: "" },
            { label: "", name: "", width: 130, align: "" },
            {
                label: "", name: "", width: 130, align: "",
                formatter: function (cellvalue) {
                    if (cellvalue === 1) { return ""; }
                    else { return ""; }
                }
            },
            {
                label: "", name: "", width: 130, align: "", formatter: function (cellvalue) {
                    return cellvalue == "" ? "" : "";
                }
            },
            { label: '', name: '', width: 150, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
            { label: '', name: '', width: 150, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } }
            ],
            pager: "",
            sortname: '',
            viewrecords: true,
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: getSearchPostData()
            }).trigger('');
        })
    }
    //Điều kiện tra cứu
    function getSearchPostData() {
        var keyword = $("").val();
        var reminderType = $("").val();
        return { keyword: keyword, reminderType: reminderType };
    };

    //Sự kiện nhấn Enter
    $('').keydownEnterEvent(function () {
        $('').trigger('');
    })

    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    //Sửa
    function btn_edit() {
        var keyValue = $("").jqGridRowValue().sxtxId;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    //Xóa
    function btn_delete() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var sxtxId = $("").jqGridRowValue().sxtxId;
        $.deleteForm({
            url: "",
            param: { sxtxId: sxtxId },
            success: function () {
                $("").trigger('');
            }
        })
    }

</script>

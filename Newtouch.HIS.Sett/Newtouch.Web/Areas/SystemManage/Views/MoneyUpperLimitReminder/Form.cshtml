
@{
    ViewBag.Title = "";
    Layout = "";
}

<form id="form1">
    <div class="container" style="margin-top: 10px; margin-left: -4%; ">
        <ul class="nav nav-tabs" role="tablist" id="myTab" style="margin-left: 4%;">
            <li role="presentation"><a href="" role="tab" data-toggle="tab">Thông tin cơ bản</a></li>
        </ul>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade in active" style="padding-top: 20px; margin-right: 99px; margin-left:69px;" id="basicInfo">
                <table class="form">
                    <tr>
                        <th class="formTitle"><span class="required">*</span>提醒类型：</th>
                        <td class="formValue formDdlSelectorTd">
                            @Html.DropDownList("", Newtouch.Infrastructure.EnmuReminderType.金额上限提醒.ToDescSelectList(), "", new { @class = "" })
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">@*<span class="required">*</span>*@Khoa：</th>
                        <td class="formValue">
                            <input type="text" class="form-control" id="ks" name="ks" placeholder="请空格或关键字进行选择" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">@*<span class="required">*</span>*@Bác sĩ：</th>
                        <td class="formValue">
                            <input type="text" class="form-control " id="ys" name="ys" placeholder="请空格或关键字进行选择"/>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">金额上限（đồng）：</th>
                        <td class="formValue">
                            <input type="text" class="form-control required" id="jesx" name="jesx" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Hiệu lực：</th>
                        <td class="formValue">
                            <div class="ckbox">
                                <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt"></label>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</form>

<script>
    var sxtxId = $.request("");
    $(function () {
        $('').select2({
            minimumResultsForSearch: -1
        });

        if (!!sxtxId) {
            $.najax({
                url: "" + Math.random(),
                data: { sxtxId: sxtxId },
                dataType: "",
                async: false,
                success: function (data) {
                    $("").formSerialize(data);
                    $('').attr('', data.ksCode);
                    $('').attr('', data.ysGh);
                }
            });
        }
    })

    //Lớp nổi khoa
    $('').newtouchBatchFloatingSelector({
        width: 300,
        height: 250,
        clickautotrigger: true,
        //minlength: 2,
        caption: "",
        url: '',
        ajaxparameters: function ($thisinput) {
            return "" + $thisinput.val();
        },
        //itemdbclickhandler: function ($thistr) {
        //    $('').attr('', $thistr.attr(''))
        //        .val($thistr.attr(''));
        //    $('').attr('', '')
        //        .val(''); //Xóa trống bác sĩ
        //},
        colModel: [
            { label: '', name: '', widthratio: 40 },
            { label: '', name: '', widthratio: 60 }
        ]
    });

    //$('').focus(function () {
    //    if (!!!$('').attr('') || !!!$('').val()) {
    //        $.modalAlert("", '');
    //        return;
    //    }
    //});
    //$('').change(function () {
    //    if (!!!$('').attr('') || !!!$('').val()) {
    //        $.modalAlert("", '');
    //        return;
    //    }
    //});

    //Lớp nổi bác sĩ
    $('').newtouchBatchFloatingSelector({
        width: 300,
        height: 200,
        //minlength: 2,
        caption: "",
        clickautotrigger: true,
        url: '',
        ajaxparameters: function ($thisinput) {
            return "" + $thisinput.val() + "" +  $('').attr('');
        },
        //itemdbclickhandler: function ($thistr) {
        //    $('').attr('', $thistr.attr(''))
        //        .val($thistr.attr(''));
        //},
        //inputtextcheck: function (ysVal) {
        //    if (!!!$('').attr('') || !!!$('').val()) {
        //        return false;
        //    }
        //    return true;
        //},
        colModel: [
            { label: '', name: '', widthratio: 40 ,align: ''},
            { label: '', name: '', widthratio: 60, align: '' }
        ]
    });


    //Gửi
    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        if (isNaN($('').val())) {
            $.modalAlert("", '');
            return false;
        }
        var params = $("").formSerialize();
        //params.ks = $('').attr('');
        //params.ys = $('').attr('');
        $.submitForm({
            url: "" + sxtxId,
            param: params,
            success: function () {
                $.currentWindow().$("").resetSelection();
                $.currentWindow().$("").trigger("");
            }
        })
    }
</script>


@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-pencil-square-o"></i>Xóa</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Mã/Nội dung" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>
    $(function () {
        initControl();
        gridList();
    });
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            postData: {},
            url: "",
            height: $(window).height() - 128,
            colModel: [
                { label: "", name: "", width: 100, align: '', key: true, hidden: true },
                { label: "", name: "", width: 450, align: '' },
                { label: "", name: "", width: 350, align: '', sortable: false },
                { label: "", name: "", width: 100, align: '' },
                { label: "", name: "", width: 100, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
            ],
            rowNum: 10,
            pager: "",
            sortname: '',
            viewrecords: true,
        });
        $("").click(function () {
            $("").jqGrid('', {
                postData: { keyword: $("").val() }, page: 1
            }).trigger('');
        });
    }

    function initControl() {

    }

    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("").resetSelection();
                    $("").trigger("");
                });
            }
        });
    }

    function btn_edit() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("").resetSelection();
                    $("").trigger("");
                });
            }
        });
    }

    function btn_delete() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.deleteForm({
            url: "",
            param: { keyValue: keyValue },
            success: function () {
                $("").resetSelection();
                $("").trigger("");
            }
        });
    }

</script>
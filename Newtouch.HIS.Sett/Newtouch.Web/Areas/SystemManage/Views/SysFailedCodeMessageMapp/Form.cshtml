@{
    ViewBag.Title = "";
    Layout = "";
}

<form id="form1">
    <div style="padding-top: 20px; margin-right: 30px;">
        <table class="form">
            <tr>
                <th class="formTitle"><span class="required">*</span>Mã：</th>
                <td class="formValue">
                    <input id="code" name="code" type="text" class="form-control required" />
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>消息：</th>
                <td class="formValue">
                    <input id="msg" name="msg" type="text" class="form-control required" />
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    var keyValue = $.request("");
    $(function () {
        initControl();
        if (!!keyValue) {
            $.ajax({
                url: "",
                data: { keyValue: keyValue },
                dataType: "",
                success: function (data) {
                    $("").formSerialize(data);
                }
            });
        }
    });

    function initControl() {

    }

    function AcceptClick(callBack) {
        if (!$('').formValid()) {
            return false;
        }
        var postData = $("").formSerialize();

        $.submitForm({
            url: "" + keyValue,
            param: postData,
            success: function () {
                callBack();
                $.modalClose();
            }
        });
    }
</script>

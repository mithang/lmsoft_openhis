@{
    ViewBag.Title = "";
    Layout = "";

    var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-pencil-square-o"></i>Xóa</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Tên" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script>
    $(function () {
        gridList();
    })
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            treeGrid: true,
            treeGridModel: "",
            ExpandColumn: "",
            url: "",
            height: $(window).height() - 96,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: "", name: "", width: 80, align: "", formatter: function (cellvalue) { return cellvalue == "" ? "" : ""; } },
                { label: '', name: '', width: 180, align: '' },
                { label: '', name: '', width: 180, align: '' },
                {
                    label: "", name: "", width: 80, align: "", formatter: function (cellvalue) {
                        if (cellvalue) {
                            return '' + cellvalue + '';
                        }
                        else {
                            return "";
                        }
                    }
                },
                { label: '', name: '', width: 260, align: '' },
                {
                    label: '', name: '', width: 100, align: '',
                    formatter: function (cellvalue) {
                        if (cellvalue == "") {
                            return "";
                        }
                        else if (cellvalue == "") {
                            return "";
                        }
                        else if (cellvalue == "") {
                            return "";
                        }
                        else if (cellvalue == "") {
                            return "";
                        }
                        else if (cellvalue == "") {
                            return "";
                        }
                        else if (cellvalue == "") {
                            return "";
                        }
                    }
                },
                { label: '', name: '', width: 300, align: '' },
                { label: '', name: '', width: 100, align: '', formatter: function (cellvalue) { return !!cellvalue ? "" : ""; } },
                { label: '', name: '', width: 300, align: '' },
                    { label: '', name: '', width: 40, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 130, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 130, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
            ]
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: { keyword: $("").val() },
            }).trigger('');
        });
    }

    //回车触发查询事件
    $('').keydownEnterEvent(function () {
        $('').trigger('');
    })

    //Thêm mới
    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("").resetSelection();
                    $("").trigger("");
                });
            }
        });
    }

    //Sửa
    function btn_edit() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        var thisOrgId = $("").jqGridRowValue().OrganizeId;
        if (!!!thisOrgId && '' === '') {
            $.modalAlert("", '');
            return;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("").resetSelection();
                    $("").trigger("");
                });
            }
        });
    }

    //Xóa
    function btn_delete() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        var thisOrgId = $("").jqGridRowValue().OrganizeId;
        if (!!!thisOrgId && '' === '') {
            $.modalAlert("", '');
            return;
        }
        $.deleteForm({
            url: "",
            param: { keyValue: keyValue },
            success: function () {
                $("").resetSelection();
                $("").trigger("");
            }
        });
    }

</script>
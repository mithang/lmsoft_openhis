    <a class="btn btn-danger" onclick="btn_authcancelall()">Hủy tất cả</a>
</div>

<script>
    var keyValue = $.request("");
    $(function () {
        $("").treeview({
            height: 400,
            slimscroll: false,
            showcheck: true,
            url: "",
            param: { keyValue: keyValue }
        });
    });
    function submitForm() {
        var postData = {};
        postData[""] = String($("").getCheckedNodes());
        $.submitForm({
            url: "" + keyValue,
            param: postData,
            success: function () {
                //$.currentWindow().$("").trigger("");
            }
        })
    }
    function btn_authall() {
        $.modalConfirm("", function (flag) {
            if (flag) {
                var postData = {};
                $.submitForm({
                    url: "" + keyValue,
                    param: postData,
                    success: function () {
                        //$.currentWindow().$("").trigger("");
                    }
                });
            }
        });
    }
    function btn_authcancelall() {
        $.modalConfirm("", function (flag) {
            if (flag) {
                var postData = {};
                $.submitForm({
                    url: "" + keyValue,
                    param: postData,
                    success: function () {
                        //$.currentWindow().$("").trigger("");
                    }
                });
            }
        });
    }
</script>
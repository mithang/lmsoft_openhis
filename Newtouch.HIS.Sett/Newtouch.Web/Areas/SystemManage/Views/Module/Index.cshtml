@using Newtouch.Common.Operator;
@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        @if (OperatorProvider.GetCurrent().IsRoot)
        {
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
            </div>
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
            </div>
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-pencil-square-o"></i>Xóa</a>
            </div>
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_authorg()"><i class="fa fa-gavel"></i>Ủy quyền cơ quan</a>
            </div>
        }
        @if (OperatorProvider.GetCurrent().IsRoot || OperatorProvider.GetCurrent().IsAdministrator)
        {
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_modulebutton()"><i class="fa fa-gavel"></i>Nút thực đơn</a>
            </div>
        }
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Tên" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script>
    $(function () {
        gridList();
    })
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            treeGrid: true,
            treeGridModel: "",
            ExpandColumn: "",
            url: "",
            height: $(window).height() - 96,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: '', name: '', width: 200, align: '' },
                { label: '', name: '', width: 200, align: '' },
                { label: '', name: '', width: 260, align: '' },
                {
                    label: '', name: '', width: 100, align: '',
                    formatter: function (cellvalue) {
                        if (cellvalue == "") {
                            return "";
                        } else if (cellvalue == "") {
                            return "";
                        } else if (cellvalue == "") {
                            return "";
                        } else if (cellvalue == "") {
                            return "";
                        }
                    }
                },
                {
                    label: "", name: "", width: 100, align: "",
                    formatter: function (cellvalue) {
                        return cellvalue == 1 ? "" : "";
                    }
                },
                { label: '', name: '', width: 300, align: '' },
                { label: "", name: "", width: 80, align: "", formatter: function (cellvalue) { return cellvalue == "" ? "" : ""; } },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
                { label: '', name: '', width: 40, align: '' }
            ]
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: { keyword: $("").val() },
            }).trigger('');
        });
    }

    //Sự kiện nhấn Enter
    $('').keydownEnterEvent(function () {
        $('').trigger('');
    })

    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_delete() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.deleteForm({
            url: "",
            param: { keyValue: keyValue },
            success: function () {
                $.currentWindow().$("").resetSelection();
                $.currentWindow().$("").trigger("");
            }
        })
    }
    function btn_modulebutton() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            btn: null,
        });
    }

    function btn_authorg() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
</script>
@if (OperatorProvider.GetCurrent().IsRoot)
{
    <script type="">
        function btn_edit() {
            var keyValue = $("").jqGridRowValue().Id;
            if (!!!keyValue) {
                $.modalAlert("", '');
                return;
            }
            $.modalOpen({
                id: "",
                title: "",
                url: "" + keyValue,
                width: "",
                height: "",
                callBack: function (iframeId) {
                    top.frames[iframeId].submitForm();
                }
            });
        }
    </script>
}
</script>
<script type="">
    //Thanh toán di động
    var payingOrFailed = null;  //trueĐang thanh toán hoặc thanh toán thất bại
    function CheckPayOK() {

        var payMoney = 0;
        var alipayMoney = 0;
        var wechatMoney = 0;

        var djjesszffs = $('').val();

        if (djjesszffs == 13) {
            payMoney = $("").val();
        } else {
            if (djjesszffs == '') {
                alipayMoney = $("").val();
            }
            else if (djjesszffs == '') {
                wechatMoney = $("").val();

            }
            payMoney = alipayMoney + wechatMoney
        }

        if (payMoney <= 0) {
            //Không cần thanh toán di động
            payingOrFailed = null;
            return true;
        }

        if ((payingOrFailed === null || payingOrFailed === true) && payMoney > 0) {
            payMoney = parseFloat(payMoney).toFixed(2);
            var out_trade_no = (new Date()).getTime().toString();   //Có vấn đề không？
            ToPay(out_trade_no, '', payMoney, djjesszffs);
            payingOrFailed = true;
        }
        return !(payingOrFailed === true); //Đang thanh toán Trả vềtrue，Nếu không trả vềfalse
    }
    //Khởi tạo thanh toán
    function ToPay(out_trade_no, subject, total_amount, djjesszffs) {
        var title = '' + (subject.length <= 15 ? subject : subject.substring(0, 12) + "");
        var url = "";

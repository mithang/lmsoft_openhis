@{
    ViewBag.Title = "";
    Layout = "";
}
<script>
    var keyValue = $.request("");
    $(function () {
        initControl();
        $('').tab('');
        $("").treeview({
            height: 300,
            showcheck: true,
            url: "" + Math.random(),
            param: { userId: keyValue }
        });

        $("").treeview({
            height: 444,
            showcheck: true,
            url: "" + Math.random(),
            param: { userId: keyValue }
        });

        if (!!keyValue) {
            $.ajax({
                url: "" + Math.random(),
                data: { keyValue: keyValue },
                dataType: "",
                async: false,
                success: function (data) {
                    $("").formSerialize(data);
                    $("").val("").attr('', '');
                }
            });
        }
    });
    function initControl() {
        $("").bindSelect()
        $("").bindSelect()
        $("").bindSelect();
        $("").bindSelect({
            url: "" + Math.random(),
        });
        $("").bindSelect({
            url: "" + Math.random(),
        });
    }
    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        var postData = $("").formSerialize();
        postData[""] = String($("").getCheckedNodes());
        postData[""] = String($("").getCheckedNodes());
        $.submitForm({
            url: "" + keyValue + "" + Math.random(),
            param: postData,
            success: function () {
                $.currentWindow().$("").trigger("");
            }
        })
    }
</script>
<form id="form1">
    <div class="container" style="margin-top: 10px; margin-left: 10px; margin-right: 10px;">
        <ul class="nav nav-tabs" role="tablist" id="myTab">
            <li role="presentation"><a href="#basicInfo" role="tab" data-toggle="tab">Thông tin cơ bản</a></li>
            <li role="presentation"><a href="#userRole" role="tab" data-toggle="tab">Vai trò người dùng</a></li>
            <li role="presentation"><a href="#userDuty" role="tab" data-toggle="tab">Vị trí công tác người dùng</a></li>
        </ul>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade in active" style="padding-top: 20px; margin-right: 30px;" id="basicInfo">
                <table class="form">
                    <tr>
                        <th class="formTitle">Tài khoản</th>
                        <td class="formValue">
                            <input id="F_Account" name="F_Account" type="text" class="form-control required" placeholder="Vui lòng nhập tài khoản" />
                        </td>
                        <th class="formTitle">密码</th>
                        <td class="formValue">
                            <input id="F_UserPassword" name="F_UserPassword" type="password" class="form-control required" placeholder="请输入密码" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Công ty</th>
                        <td class="formValue">
                            <select id="F_OrganizeId" name="F_OrganizeId" class="form-control required"></select>
                        </td>
                        <th class="formTitle">Phòng ban</th>
                        <td class="formValue">
                            <select id="F_DepartmentId" name="F_DepartmentId" class="form-control required">
                                <option value="">==Vui lòng chọn==</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Họ tên</th>
                        <td class="formValue">
                            <input id="F_RealName" name="F_RealName" type="text" class="form-control required" placeholder="Vui lòng nhập họ tên" />
                        </td>
                        <th class="formTitle">Giới tính</th>
                        <td class="formValue">
                            <select id="F_Gender" name="F_Gender" class="form-control required">
                                <option value="true">Nam</option>
                                <option value="false">Nữ</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Điện thoại di động</th>
                        <td class="formValue">
                            <input id="F_MobilePhone" name="F_MobilePhone" type="text" class="form-control mobilephone" />
                        </td>
                        <th class="formTitle">生日</th>
                        <td class="formValue">
                            <input id="F_Birthday" name="F_Birthday" type="text" class="form-control input-wdatepicker" onfocus="WdatePicker()" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">WeChat</th>
                        <td class="formValue">
                            <input id="F_WeChat" name="F_WeChat" type="text" class="form-control" />
                        </td>
                        <th class="formTitle">Hộp thư</th>
                        <td class="formValue">
                            <input id="F_Email" name="F_Email" type="text" class="form-control email" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Loại</th>
                        <td class="formValue">
                            <select id="F_IsAdministrator" name="F_IsAdministrator" class="form-control">
                                <option value="false">Người dùng thông thường</option>
                                <option value="true">系统管理员</option>
                            </select>
                        </td>
                        <th class="formTitle">允许登录</th>
                        <td class="formValue">
                            <select id="zt" name="zt" class="form-control">
                                <option value="1">Có</option>
                                <option value="0">Không</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle" valign="top" style="padding-top: 5px;">
                            Ghi chú
                        </th>
                        <td class="formValue" colspan="3">
                            <textarea id="F_Description" name="F_Description" class="form-control" style="height: 60px;"></textarea>
                        </td>
                    </tr>
                </table>
            </div>
            <div role="tabpanel" class="tab-pane fade in" style="padding-top: 20px; margin-right: 30px;" id="userRole">
                <div id="roleList"></div>
            </div>
            <div role="tabpanel" class="tab-pane fade in" style="padding-top: 20px; margin-right: 30px;" id="userDuty">
                <div id="dutyList"></div>
            </div>
        </div>
    </div>
</form>

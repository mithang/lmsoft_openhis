@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="topPanel">
    @Html.Partial("")
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_roles()"><i class="fa fa-pencil-square-o"></i>Vai trò người dùng</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Họ tên/Tài khoản/Mã nhân viên" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>
    $(function () {
        initControl();
        gridList();
    })

    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            height: $(window).height() - 128,
            postData: { keyword: $("").val(), OrganizeId: $("").val() },
            colModel: [
               { label: '', name: '', hidden: true },
               { label: "", name: "", width: 60, align: "", formatter: function (cellvalue) { return cellvalue == "" ? "" : ""; } },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', hidden: true },
                {
                    label: '', name: '', width: 120, align: '',
                },
                {
                    label: '', name: '', width: 80, align: '',
                },
                {
                    label: "", name: "", width: 100, align: "",
                    formatter: function (cellvalue, options, rowObject) {
                        if (cellvalue === true) {
                            return '';
                        }
                        else {
                            return '';
                        }
                    }
                },
            ],
            pager: "",
            sortname: '',
            viewrecords: true
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: { keyword: $("").val(), OrganizeId: $("").val() },
                page: 1,
            }).trigger('');
        });
    }

    //Sự kiện nhấn Enter
    $('').keydownEnterEvent(function () {
        $('').trigger('');
    })

    function initControl() {

    }

    function btn_roles() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var thisOrgId = $("").jqGridRowValue().OrganizeId;
        if (!!!thisOrgId) {
            $.modalAlert("", '');
            return;
        }
        var keyValue = $("").jqGridRowValue().Id;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue + '' + thisOrgId,
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {

                });
            }
        });
    }



</script>
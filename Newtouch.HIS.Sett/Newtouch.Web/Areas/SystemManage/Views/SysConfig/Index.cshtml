@using Newtouch.Common.Operator;
@{
    ViewBag.Title = "";
    Layout = "";
    var opeator = OperatorProvider.GetCurrent();
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
            @if (opeator.IsAdministrator || opeator.IsRoot || true)
            {
                <a class="btn btn-primary dropdown-toggle" data-toggle="dropdown"><span class="caret"></span></a>
                <ul class="dropdown-menu pull-right">
                    <li><a onclick="btn_template()" href="javascript:void(0)">配置模板管理</a></li>
                </ul>
            }
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-pencil-square-o"></i>Xóa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_sync()"><i class="fa fa-pencil-square-o"></i>同步</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Cấu hình tên/Cấu hình mã" style="width: 200px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
    @*<div style="float:right;padding-right:100px;">
        <a title="查看所有配置项" onclick="btn_ShowAllConfig()" style="cursor:pointer;color:blue;text-decoration:underline;">查看所有配置项</a>
    </div>*@
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    @*<div id="gridPager"></div>*@
</div>

<script>
    $(function () {
        gridList();

    })


    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            postData: { keyword: $("").val() },
            url: "",
            height: $(window).height() - 128,
            colModel: [
                 { label: "", name: "", hidden: true, key: true },
                { label: "", name: "", width: 80, align: "", formatter: function (cellvalue) { return cellvalue == "" ? "" : ""; } },
                  { label: "", name: "", width: 200, align: ''},
                  { label: '', name: '', width: 150, align: '' },
                  { label: '', name: '', width: 150, align: '' },
                  { label: '', name: '', width: 200, align: '' },
                    { label: '', name: '', width: 40, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 130, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 130, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
            ],
        });
        $("").click(function () {
            $("").jqGrid('', {
                postData: { keyword: $("").val() },
            }).trigger('');
        });
    }

    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("").resetSelection();
                    $("").trigger("");
                });
            }
        });
    }

    function btn_edit() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("").resetSelection();
                    $("").trigger("");
                });
            }
        });
    }

    //Xóa
    function btn_delete() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        var IsA='';
        var IsR='';
        if (IsA == "" && IsR == "")
        {
            if ($("").jqGridRowValue().Value == "")
            {
                // == ""? 不好
                $.modalAlert("", '');
                return;
            }
        }
        $.deleteForm({
            url: "",
            param: { keyValue: keyValue },
            success: function () {
                $("").resetSelection();
                $("").trigger("");
            }
        });
    }
    function btn_sync() {
        $.modalConfirm("", function (r) {
            if (r) {
                $.loading(true, '');
                $.najax({
                    url: "",
                    type: "",
                    data: {orgId: ''},
                    dataType: "",
                    async: false,
                    success: function (data) {
                        $.modalAlert(data.message, data.state);
                        $('').trigger('');
                        $.loading(false);
                    }
                });
            } else {

            }
        });
    }
    

    function btn_ShowAllConfig() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            btn: null
        });
    }

    function btn_template()
    {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            btn: null,
        });

    }

</script>

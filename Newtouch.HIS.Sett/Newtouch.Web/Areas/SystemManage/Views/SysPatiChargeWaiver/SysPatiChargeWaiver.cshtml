@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a id="NF-add" class="btn btn-primary dropdown-text" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a id="NF-edit" class="btn btn-primary dropdown-text" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa thông tin</a>
        </div>
        <div class="btn-group">
            <a id="NF-delete" class="btn btn-primary dropdown-text" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa thông tin</a>
        </div>
        <div class="btn-group">
            <a id="NF-Details" class="btn btn-primary dropdown-text" onclick="btn_details()"><i class="fa fa-search-plus"></i>Xem thông tin</a>
        </div>
        @*<div class="operate">
            <ul class="nav nav-pills">
                <li class="first">Đã chọn<span>1</span>Mục</li>
                <li><a id="NF-edit" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa thông tin</a></li>
                <li><a id="NF-delete" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa thông tin</a></li>
                <li><a id="NF-Details" onclick="btn_details()"><i class="fa fa-search-plus"></i>Xem thông tin</a></li>
            </ul>
            <a href="javascript:;" class="close"></a>
        </div>*@
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Tính chất bệnh nhân" style="width: 200px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script>
    $(function () {
        gridList();
    });
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            treeGrid: true,
            treeGridModel: "",
            url: "",
            height: $(window).height - 96,
            colModel: [
                { label: '', name: '', hidden: true, key: true },
                { label: '', name: '', width: 100, algin: '' },
                { label: '', name: '', width: 100, algin: '' },
                { label: '', name: '', width: 100, algin: '' },
                { label: '', name: '', width: 100, algin: '' },
                {
                    label: '', name: '', width: 100, algin: '',
                    formatter: function (cellvalue) {
                        if (cellvalue == 0) {
                            return "";
                        } else {
                            return "";
                        }
                    }
                },
                {
                    label: '', name: '', width: 100, align: '',
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
               { label: '', name: '', width: 80, align: '' }
            ]
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: { keyword: $("").val() }
            }).trigger('');
        })
    }

    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    function btn_edit() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var keyValue = $("").jqGridRowValue().brsfjmbh;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_delete() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        $.deleteForm({
            url: "",
            param: { keyValue: $("").jqGridRowValue().brsfjmbh },
            success: function () {
                $.currentWindow().window.frames[''].$("").trigger("");
            }
        })
    }
    function btn_details() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var keyValue = $("").jqGridRowValue().brsfjmbh;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            btn: null,
        });
    }
</script>


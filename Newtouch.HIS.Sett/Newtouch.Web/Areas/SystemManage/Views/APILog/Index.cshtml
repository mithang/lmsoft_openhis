@{
    ViewBag.Title = "";
    Layout = "";
}
<style>
    .toolbar {
        width: 45% !important;
        margin: 10px 30px 12px;
    }

    .ui-jqgrid tr.jqgrow td {
        white-space: normal !important;
        height: auto;
        vertical-align: text-top;
        padding-top: 2px;
    }
</style>
<form>
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form">
            <tr>
                <th class="formTitle">Số bệnh án：</th>
                <td class="formValue">
                    <input type="text" class="form-control form-an" id="blh" />
                </td>
                <th class="formTitle">Họ tên：</th>
                <td class="formValue">
                    <input type="text" class="form-control form-an" id="xm" />
                </td>
                <th class="formTitle">Tải lên thời gian：</th>
                <td class="formValue" colspan="2">
                    <input id="kssj" type="text" class="form-control input-wdatepicker form-an" style="width:42%; float:left;" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    <span style="margin-left:1%;float:left;">—</span>
                    <input id="jssj" type="text" class="form-control input-wdatepicker form-an" style="width :42%;float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                </td>
                <td></td>
            </tr>
            <tr>
                <th class="formTitle">Loại bệnh nhân：</th>
                <td class="formValue formDdlSelectorTd">
                    <select id="brlx" class="form-control form-an">
                        <option value="-1">Tất cả</option>
                        <option value="Outpatient">Ngoại trú</option>
                        <option value="Inpatient">Nhập viện</option>
                    </select>
                </td>
                <th class="formTitle">Loại dữ liệu：</th>
                <td class="formValue formDdlSelectorTd">
                    <select id="wtjlbz" class="form-control form-an">
                        <option value="-1">Tất cả</option>
                        <option value=false>Bình thường</option>
                        <option value=true selected>问题</option>
                    </select>
                </td>
                <th class="formTitle">Nhà trị liệu：</th>
                <td class="formValue">
                    @*<input type="text" readonly="readonly" class="form-control formClearIgnore form-an" id="smryName" data-smry="@OperatorProvider.GetCurrent().rygh" data-staffId="@OperatorProvider.GetCurrent().StaffId" value=@OperatorProvider.GetCurrent().UserName />*@
                    <select id="smryName" class="form-control">
                        <option>==Vui lòng chọn==</option>
                    </select>
                </td>
                <th class="formTitle">是否已删除：</th>
                <td class="formValue">
                    <select id="isDeleted" class="form-control">
                        <option>Tất cả</option>
                        <option value=false selected>Bình thường</option>
                        <option value=true>Đã xóa</option>
                    </select>
                </td>
                <td class="formValue">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary form-an" style="width: 50px; margin-left: 40px;" value="Tra cứu" />
                </td>

            </tr>
        </table>
    </div>
    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
    <table class="form" style="width:255px;background-color:white;position: relative;bottom: 25px;left:235px;">
        <tr>
            <td style="width: 40px;">
                <label style="height:7px;width:25px; margin-left:20%;background-color:white; border:1px solid #ddd"></label>
            </td>
            <td>
                表示正常
            </td>
            <td style="width: 40px;">
                <label style="height:7px;width:25px;background-color:#f2dede; border:1px solid #ddd"></label>
            </td>
            <td>表示异常</td>
        </tr>
    </table>
</form>
<script>
    //Mặc định
    //var Editing_ysList = []; //Nhân viên trong vùng chỉnh sửa

    $(function () {
        gridList();
        //Editing_ysList = [{ id: $('').attr(''), gh: $('').attr(''), Name: $('').val(), ks: $('').attr(''), ksmc: $('').val() }];

    });

    //Nhà trị liệu
    $("").bindSelect({
        url: "",
        id: "",
        text: ""
    });

    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: ""GetListJson"",
            postData: getSearchPostData(),
            height: $(window).height() - 200,
            colModel: [
                { label: '', name: '', align: '', hidden: true },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 120, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 60, align: '' },
                { label: '', name: '', width: 120, align: '' },
                { label: '', name: '', hidden: true, formatter: "", align: '' },
                {
                    label: '', name: '', width: 60, align: '', formatter: function (val) {
                        switch (val) {
                            case "":
                                return ""
                                break;
                            case "":
                                return ""
                                break;
                            default:
                                return val;
                                break;
                        }
                    }
                },
                { label: '', name: '', width: 120, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
                { label: '', name: '', width: 267, align: '' }

            ],
            pager: "",
            sortname: '',
            viewrecords: true,
            ondblClickRow: function (rowid) {
                gridEditRow(rowid);
            }, gridComplete: function (data) {
                var ids = $("").jqGrid('');
                for (var i = 0; i < ids.length; i++) {

                    var rowData = $("").jqGrid('', ids[i]);
                    if (rowData) {
                        if (rowData.wtjlbz == '') {
                            $('' + ids[i] + '').css("", "");//.addClass('');
                        }
                    }
                }
            }
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: getSearchPostData(),
                page: 1,
            }).trigger('');
        });
    }

    //Điều kiện tra cứu
    function getSearchPostData() {
        var blh = $("").val();
        var xm = $("").val();
        var kssj = $("").val();
        var jssj = $("").val();
        var brlx = $("").val();
        var wtjlbz = $("").val();
        var isDeleted = $("").val();
        var rygh = $("").val();
        return { blh: blh, xm: xm, kssj: kssj, jssj: jssj, brlx: brlx, wtjlbz: wtjlbz, isDeleted: isDeleted, rygh: rygh };

    }
    //Hủy bỏ
    function newtouch_event_f8() {
        var data = $("").jqGrid('', undefined, false);
        if (data == "") {
            return;
        }
        var ids = $("").jqGrid("", "");
        if (!ids || ids.length == 0) {
            $.modalAlert("", '');
            return false;
        }
        var arraryData = [];
        for (var i = 0; i < ids.length; i++) {
            var rowData = $("").jqGrid('', ids[i]);
            arraryData.push(rowData.Id);
        }
        $.najax({
            url: ""Involid"",
            dataType: "",
            data: { list: arraryData },
            type: "",
            async: false,
            success: function (data) {
                $.loading(false);
                //Làm mới danh sách chưa xác nhận
                $('').trigger('');
                $.modalMsg("", '');
            },
            errCallback: function (err) {
                $.loading(false);
            }
        });

    }

</script>

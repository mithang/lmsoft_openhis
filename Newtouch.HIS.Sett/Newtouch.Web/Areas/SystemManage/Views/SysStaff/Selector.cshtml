@{
    ViewBag.Title = "";
    Layout = "";
}

<script>
    var from = $.request("");
    var organizeId = $.request("");
    var keyValue = $.request("");
    var isExpand = $.request("");
    var callbackType = $.request("");
    var single = $.request("");
    var isShowEmpty = $.request("");
    var initIdSelected = $.request("");
    var isContansChildOrg = $.request("");
    var dutyCode = $.request("");
    $(function () {
        initControl();
    })

    function initControl() {
        $("").treeview({
            height: 440,
            slimscroll: false,
            showcheck: true,
            url: "",
            param: { from: from, organizeId: organizeId, keyValue: keyValue, isExpand: isExpand, initIdSelected: initIdSelected, isContansChildOrg: isContansChildOrg, dutyCode: dutyCode, isShowEmpty: isShowEmpty },
            oncheckboxclick: function (a, ck) {
                window.treeaid = a.id;
                if (single == '' && ck == 1 && !a.hasChildren) {
                    //让其他的都不选中，但不包括其父级的
                    $.each($(''), function () {
                        if ($(this).attr('').indexOf(window.treeaid) == -1
                            && $(this).attr('').indexOf('') != -1) {
                            $(this).trigger('');
                        }
                    });
                }
            }
        });

    }

    function AcceptClick(callBack) {
        var treeSeleData;
        if (callbackType == '') {
            treeSeleData = $("").getCheckedNodeObjArray();
            if (single == '' && treeSeleData.length > 1) {
                $.modalAlert('', '');
                return;
            }
        }
        else {
            treeSeleData = $("").getCheckedNodes();
            if (single == '' && treeSeleData.length > 1) {
                $.modalAlert('', '');
                return;
            }
            treeSeleData = String(treeSeleData);
        }

        callBack(treeSeleData);
        $.modalClose();
    }
</script>
<div>
    <div id="staffTree"></div>
</div>



@{
    ViewBag.Title = "";
    Layout = "";
}
<script>
    var from = $.request("");
    var form = $.request("");
    var organizeId = $.request("");
    var isContansChildOrg = $.request("");
    var keyValue = $.request("");
    var isExpand = $.request("");
    var callbackType = $.request("");
    var single = $.request("");
    var isShowEmpty = $.request("");
    $(function () {
        initControl();
        $('').click(function () {
            initControl();
        });
    })
    //Sự kiện nhấn Enter
    $('').keydownEnterEvent(function () {
        $('').trigger('');
    })
    function initControl() {
        //$("").treeview({
        //    height: 440,
        //    slimscroll: false,
        //    showcheck: true,
        //    url: "",
        //    param: { from: from, organizeId: organizeId, isContansChildOrg: isContansChildOrg, keyValue: keyValue, isExpand: isExpand, isShowEmpty: isShowEmpty }
        //});
        var urladdr = "" + from + "" + isContansChildOrg + "" + keyValue + "" + isExpand + "" + callbackType + "" + single + "" + isShowEmpty + "" + organizeId;
        var keyword = $("").val();
        if (!!keyword) {
            urladdr += "" + keyword;
        }
        $("").treeview({
            height: 440,
            slimscroll: false,
            showcheck: true,
            url: urladdr,
            //param: { keyword: $("").val(),from: from, organizeId: organizeId, isContansChildOrg: isContansChildOrg, keyValue: keyValue, isExpand: isExpand, isShowEmpty: isShowEmpty }
        });
    }

    function AcceptClick(callBack) {
        var treeSeleData;
        if (callbackType == '') {
            treeSeleData = $("").getCheckedNodeObjArray();
            if (single == '' && treeSeleData.length != 1) {
                $.modalAlert('', '');
                return;
            }
        }
        else {
            treeSeleData = $("").getCheckedValues();  //Values对应的是UserId
            if (single == '' && treeSeleData.length != 1) {
                $.modalAlert('', '');
                return;
            }
            treeSeleData = String(treeSeleData);
        }
        $.each(treeSeleData, function (index, item) {
            treeSeleData[index].Ex3 = organizeId;
        });
        callBack(treeSeleData);
        $.modalClose();
    }
</script>
<form id="form1">
    <div class="topPanel">
        <div class="search">
            <table>
                <tr>
                    <td>
                        <div class="input-group">
                            <input id="txt_keyword" type="text" class="form-control" placeholder="Họ tên/Mã nhân viên" style="width: 180px;">
                            <span class="input-group-btn">
                                <button id="btn_search" type="button" class="btn btn-primary"><i class="fa fa-search"></i></button>
                            </span>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="widget-body">
        <div id="userStaffTree"></div>
    </div>
</form>



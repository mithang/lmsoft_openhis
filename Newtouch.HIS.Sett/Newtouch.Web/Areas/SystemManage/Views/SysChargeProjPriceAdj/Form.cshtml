@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
}

<link href="@SiteUrl.GetStaticResourceScriptUrl("~/Content/css/Shared/Form.css",false)" rel="stylesheet" />
<script src=""~/Content/js/SystemManage/SysChargeProjPriceAdj/Form.js"" type=""></script>

<form id="form1">
    <div style="padding: 20px 35px 0 2px;">
        <table class="form">
            <tr>
                <th class="formTitle">Hạng mục thu phí</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="sfxmmc" name="sfxmmc" required />
                </td>
                <th class="formTitle">Đơn giá</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="dj" name="dj" required />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Tỷ lệ tự chi trả</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="zfbl" name="zfbl" required />
                </td>
                <th class="formTitle">Tính chất tự chi trả</th>
                <td class="formValue">
                    @Html.DropDownList("", EnumZiFuXingZhi.KB.ToSomeDescSelectList(""), new { @class = "" })
                </td>
            </tr>
            <tr>
                <th class="formTitle">Cờ có hiệu lực</th>
                <td class="formValue">
                    @Html.DropDownList("", EnumSXBZ.Jssx.ToDescSelectList(), new { @class = "" })
                </td>
                <th class="formTitle">Hiệu lực</th>
                <td class="formValue">
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt"></label>
                    </div>
                </td>
            </tr>
            <tr>
                <th class="formTitle">定点生效日期</th>
                <td class="formValue">
                    <input id="ddsxrq" type="text" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    var keyValue = $.request("");
    $(function () {
        if (!!keyValue) {
            $.ajax({
                url: "" + Math.random(),
                data: { keyValue: keyValue },
                dataType: "",
                async: false,
                success: function (data) {
                    $("").formSerialize(data);
                    $('').attr('', data.sfxm)
                      .val(data.sfxmmc);
                }
            });
        }
    })



    //Hạng mục thu phí
    $('').newtouchFloatingSelector({
        width: 600,
        height: 280,
        caption: "",
        url: '',
        ajaxparameters: function () {
            if ($.trim($('').val()).length == 0) {
                return;
            }
            return "" + $.trim($('').val());
        },
        itemdbclickhandler: function ($thistr) {
            $('').attr('', $thistr.attr(''))
                .val($thistr.attr(''));
        },
        colModel: [{ label: '', name: '', widthratio: 10 },
            { label: '', name: '', widthratio: 15 },
            { label: '', name: '', widthratio: 10 },
            { label: '', name: '', widthratio: 7 },
            { label: '', name: '', widthratio: 8 },
            { label: '', name: '', widthratio: 10 },
            { label: '', name: '', widthratio: 13 }
        ]
    });


    $("").click(function () {
        $gridList.jqGrid('', {
            postData: { keyword: $("").val() }
        }).trigger('');
    })
    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    function btn_edit() {
        var keyValue = $("").jqGridRowValue().brsfjmbh;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_delete() {
        $.deleteForm({
            url: "",
            param: { keyValue: $("").jqGridRowValue().brsfjmbh },
            success: function () {
                $.currentWindow().$("").resetSelection();
                $.currentWindow().$("").trigger("");
            }
        })
    }
    function btn_details() {
        var keyValue = $("").jqGridRowValue().brsfjmbh;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            btn: null,
        });
    }

    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        var params = $("").formSerialize();
        params[''] = $('').attr('');
        $.submitForm({
            url: "" + keyValue,
            param: params,
            success: function () {
                $.currentWindow().window.frames[''].$("").trigger("");
            }
        })
    }
</script>





@{
    ViewBag.Title = "";
    Layout = "";
}
<style>
    thead tr th {
        background-color: #eee;
        line-height: 30px;
        padding-left: 15px;
    }

    tbody tr td {
        line-height: 30px;
        padding-left: 15px;
    }
</style>

<table class="form" style="width:96%;">
    <tr>
        <td class="formTitle">Số thẻ：</td>
        <td class="formValue">
            <input class="form-control" type="text" id="kh" value="" />
        </td>
        <td class="formTitle"><button id="khBT" class="btn btn-primary dropdown-text">Tra cứu hóa đơn</button></td>
        <td class="formTitle"></td>
        <td class="formValue"></td>
    </tr>
</table>
<div class="gridPanel">
    <table id="gridListFPH"></table>
</div>
<table class="form" style="width:96%;">
    <tr>
        <td class="formTitle">Số hóa đơn：</td>
        <td class="formValue">
            <input class="form-control" type="text" id="fph" value="" />
        </td>

        <td class="formTitle">Tự chi trả theo phân loại：</td>
        <td class="formValue">
            <input class="form-control" type="text" id="flzf" value="" />
        </td>
        <td class="formTitle">Tự chi trả：</td>
        <td class="formValue">
            <input class="form-control" type="text" id="zf" value="" />
        </td>
    </tr>
    <tr>

        <td class="formTitle">Từ：</td>
        <td class="formValue">

            <input class="form-control form_datetime" type="text" id="ks" value="@DateTime.Now.AddMonths(-1).ToString("yyy-MM-dd")" />
        </td>
        <td class="formTitle">Đến：</td>
        <td class="formValue">
            <input class="form-control form_datetime" type="text" id="js" value="@DateTime.Now.ToString("yyy-MM-dd")" />
        </td>
    </tr>
    <tr>
        <td class="formTitle">Ghi sổ：</td>
        <td class="formValue">
            <input class="form-control" type="text" id="jz" value="" />
        </td>
        <td class="formTitle">Tự chi trả：</td>
        <td class="formValue">
            <input class="form-control" type="text" value="" id="zifei" />
        </td>
        <td class="formTitle"></td>
        <td class="formValue">
            <button id="sub" class="btn btn-primary dropdown-text">Tra cứu</button>
        </td>
    </tr>

</table>
<br />
<table class="form" style="width:60%;border:solid 1px #ccc;" id="tableStyle">
    <thead>
        <tr>
            <th>Loại bệnh nhân</th>

            <th>Khoa đăng ký khám</th>

            <th>Bác sĩ</th>
        </tr>
    </thead>
    <tbody>
        <tr>

            <td id="brlx"></td>

            <td id="ghks"></td>

            <td id="ys"></td>
        </tr>
    </tbody>
</table>
<br />
<div class="gridPanel">
    <table id="gridListTuifei"></table>
</div>

<br />

<table class="form" style="width:80%;">
    <tr>
        <td class="formTitle">
            <a id="btnReturn" class="btn btn-primary"> F1：Hoàn phí</a>

        </td>
        <td class="formValue">
            <a id="acc_reMoney" class="btn btn-primary">F5:Xóa</a>
        </td>
        <td class="formTitle">Tự chi trả：</td>
        <td class="formValue">
            <input class="form-control" type="text" id="zifu" value="" />
        </td>
        <td class="formTitle">应退：</td>
        <td class="formValue">
            <input class="form-control" type="text" id="yingtui" value="" />
        </td>
    </tr>


</table>
<script>
    $(function () {
        $("").datetimepicker({
            format: '',
            minView: 2,
            autoclose: true
        });
        $("").click(function () {
            newtouch_globalevent_f4();
            newtouch_event_f4();
        });
        function newtouch_event_f4() {
            $('').jqGrid("");   //Xóa dòng tất cả

        }

        $("").click(function () {
            $.loading(true, "");

            var kh = $("").val();
            $.ajax({
                type: "",
                url: ""btnQueryFph"",
                data: { kh: kh },
                dataType: "",
                success: function (ajaxresp) {
                    debugger
                    if (ajaxresp.state == '') {
                        $.loading(false);
                        if (ajaxresp.data.length > 0) {
                            $('').jqGrid("");
                            gridListFPH(ajaxresp.data);
                        } else {
                            $.modalAlert("", ajaxresp.state);
                        }
                    }
                    if (ajaxresp.state == '') {
                        $.modalAlert(ajaxresp.message, ajaxresp.state);
                    }
                },
                error: function (err) {
                    alert(err)
                },
                complete: function () {
                    $.loading(false);
                }
            });
        });

        function gridListFPH(mydata) {
            var $gridList = $("");
            $gridList.dataNewGrid({
                height: 100,
                colModel: [
                          { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
          { label: '', name: '', hidden: true },
          { label: '', name: '', hidden: true },
                 { label: '', name: '', hidden: true },
                 { label: '', name: '', hidden: true },

                      { label: '', name: '', width: 100, align: '' },
                        { label: '', name: '', width: 100, align: '' },
                          { label: '', name: '', width: 100, align: '' },

                    {
                        label: '', name: '', width: 100, align: '', formatter: function (cellvalue) {
                            return cellvalue && cellvalue.length >= 10 ? cellvalue.substring(0, 10) : ""
                        }
                    },
                    { label: '', name: '', width: 300, align: '' }

                ]
            }, mydata);
            if (mydata.length > 0) {
                $('').find("").remove();
            }

        }



        $("").click(function () {
            $.loading(true, "");

            var jsnm = $("").jqGridRowValue().jsnm;
            $.ajax({
                type: "",
                url: ""GetMZJSByJsnm"",
                data: { jsnm: jsnm },
                dataType: "",
                success: function (ajaxresp) {
                    debugger
                    if (ajaxresp.state == '' && ajaxresp.data != null) {
                        if (ajaxresp.data.length > 0) {
                            var result = ajaxresp.data[0];
                            $("").html(result.BRXZMC);
                            $("").html(result.KSMC);
                            $("").html(result.RYMC);
                            getDetail(jsnm);
                        } else {
                            $.modalAlert("", ajaxresp.state);
                        }


                    } else {
                        $.modalAlert(ajaxresp.message, ajaxresp.state);
                    }
                },
                error: function (err) {
                    alert(err)
                },
                complete: function () {
                    $.loading(false);
                }
            });
        });
        //
        function getDetail(jsnm) {
            $.ajax({
                type: "",
                url: ""GetGridViewMxByJsnm"",
                data: { jsnm: jsnm },
                dataType: "",
                success: function (ajaxresp) {
                    debugger
                    if (ajaxresp.state == '') {
                        $('').jqGrid("");
                        gridListTuifei(ajaxresp.data);
                    } else {
                        $.modalAlert(ajaxresp.message, ajaxresp.state);

                    }
                }

            });
        }
        function gridListTuifei(mydata) {
            var $gridList = $("");
            $gridList.dataNewGrid({
                height: 100,
                multiselect: true,
                colModel: [

                      { label: '', name: '', width: 100, align: '' },
                        { label: '', name: '', width: 80, align: '' },
                          { label: '', name: '', width: 100, align: '' },
                            { label: '', name: '', width: 80, align: '' },
                               { label: '', name: '', width: 80, align: '' },
                            { label: '', name: '', width: 80, align: '' },
                                      { label: '', name: '', width: 80, align: '' },
                            {
                                label: '', name: '', width: 80, align: '', editable: true
                            },
                    { label: '', name: '', width: 80, align: '' },
                    {
                        label: '', name: '', width: 80, align: '', formatter: function (cellvalue) {
                            return cellvalue ? "" : ""
                        }
                    }
                ]
            }, mydata);
            if (mydata.length > 0) {
                $('').find("").remove();
            }
        }

        //双击就加载当前选择的收费详细数据
        $("").click(function () {
            debugger

            var kh = $("").val();
            var test = jQuery("").jqGrid('', '');
            var checkbox = $("");
            if (0 == 0&&!confirm("")) {
                $.modalAlert("", "");

            } else {
                $.loading(true, "");
                var jsnm = $("").jqGridRowValue().jsnm;
                var RefundVO = $("").jqGrid("");
                if (RefundVO && jsnm && kh) {
                    $.ajax({
                        type: "",
                        url: ""btnReturn"",
                        data: { kh:kh,jsnm: jsnm, RefundVO: RefundVO },
                        dataType: "",
                        success: function (ajaxresp) {
                            debugger
                            $.modalAlert(ajaxresp.message, ajaxresp.state);
                        },
                        error: function (err) {
                            $.modalAlert(ajaxresp.message, ajaxresp.state);
                        },
                        complete: function () {
                            $.loading(false);
                        }
                    });
                } else {
                    $.modalAlert("", "");
                }

            }
        });
    })

    function btn_edit() {
        debugger
        var data = $("").jqGridRowValue();
        if (data) {
            $("").val(data.fph);
            $("").val(data.flzffy);
            $("").val(data.zffy);
            $("").val(data.jzfy);
            $("").val(data.zlfy);
            $("").val(data.zffy);
            $("").val(data.xjzf);
        }

    }
</script>

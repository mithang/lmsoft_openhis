                { label: '', name: '', width: 150, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', hidden: true, align: '' },
                {
                    label: '', name: '', width: 60, align: '', formatter: function (cellvalue)
                    {
                        return cellvalue == "" ? "" : "";
                    }
                },
                {
                    label: '', name: '', width: 60, align: '', formatter: function (cellvalue)
                    {
                        return cellvalue == "" ? "" : "";
                    }
                },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', hidden: true, align: '' }

            ],
            pager: "",
            sortname: '',
            viewrecords: true,


            { label: '', name: '', width: 150, align: '' },
            { label: '', name: '', width: 150, align: '' }

        ]
    });

    //Enter 跳到下一个控件
    function enterEvent()
    {
        //回车键
        $("").keypress(function (e) {
            if (e.keyCode == 13) {
                if ($("").val().trim().length == 28) {
                    $("").val().substring(0, 10);
                }
                $("").focus();
            }

        });
        $("").keypress(function (e) {
            if (e.keyCode == 13) {
                $("").focus();
            }
        });
        $("").keypress(function (e) {
            if (e.keyCode == 13) {
                $("").focus();
            }
        });

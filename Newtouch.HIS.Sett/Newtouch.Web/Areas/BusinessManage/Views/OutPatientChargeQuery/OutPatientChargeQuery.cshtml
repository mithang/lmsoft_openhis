            //                $("").append("");
            //                //加载页面下方的费用大类合计
            //                for (i = 0; i < ajaxresp.data.dlhj.length; i++) {
            //                    $("").append("" + ajaxresp.data.dlhj[i].dlmc + "");
            //                    $("").append("" + ajaxresp.data.dlhj[i].jehj + "");
            //                }
            //                $("").append("");
            //                $("").append("");
            //            }
            //        }
            //    });
            //},
            //Grid Tải gọi sau hoàn thành
            gridComplete: function () {
                 afterCompleteFunction();
            },
        });
        $("").click(function () {
            $gridJSList.jqGrid('', {
                postData: { kh: $("").val(), fph: $("").val(), xm: $("").val(), syy: $("").val(), CreateTimestart: $("").val(), CreateTimeEnd: $("").val() },
            }).trigger('');
        });

    }

    //Đã trả lại/In lại 背景色为红色 
    function afterCompleteFunction()
    {
        var ids = $("").getDataIDs();
        for (i = 0; i < ids.length; i++) {
            var rowData = $("").getRowData(ids[i]);
            if (rowData.isRed == "")
            {
                $("" + ids[i]).find("").css("", "");
            }
        }
    }

    //双击事件
    function btn_edit()
    {
        ////每次双击，Xóa trống chi tiết trước đó trước và tổng cộng
        $('').jqGrid("");
        $("").remove();
        $.ajax({
            type: "",
            url: "",
            data: { jsnm: $("").jqGridRowValue().jsnm },
            dataType: "",
            success: function (ajaxresp) {
                if (ajaxresp.state == '') {
                    $('').newtouchLocalDataGrid(null, ajaxresp.data.ghRecordsDetails);
                    //动态加载合计信息
                    $("").append("")
                    $("").append("");
                    //加载页面下方的费用大类合计
                    for (i = 0; i < ajaxresp.data.dlhj.length; i++) {
                        $("").append("" + ajaxresp.data.dlhj[i].dlmc + "");
                        $("").append("" + ajaxresp.data.dlhj[i].jehj + "");
                    }
                    $("").append("");
                    $("").append("");
                }
            }
        });
    }

    //Chi tiết quyết toán ngoại trú jGridKhai báo
    $('').newtouchLocalDataGrid({
        height: 100,
        unwritten: false,
        sortable: false,
        colModel: [
            { label: '', name: '',width:150, key: true },
            { label: '', name: '', width: 150, align: '' },

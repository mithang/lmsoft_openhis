
@{
    ViewBag.Title = "";
    Layout = "";

    var from = (ViewBag.from as string) ?? "";
}

<form id="formReceipt">
    <div style="margin-top:40px;margin-right:40px;">
        <table class="form">
            <tr>
                <th class="formTitle dialogText">Số hóa đơn:</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="txtfph" name="txtfph" required value="">
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    //Cái trướcwindowĐối tượng
    var prevWindow;
    if ('' != '') {
        prevWindow = top.top.frames[''];
        debugger
    }
    else {
        prevWindow = $.currentWindow();
    }

    $.ajax({
        url: "",  //Lấy
        dataType: "",
        async: false,
        success: function (data) {
            $("").val(data);
            prevWindow.$("").val(data);
        }
    });

    //Xác nhận số hóa đơn xác minh
    function checkFPH() {
        $.loading(true, '');
        $.ajax({
            url: "",
            data: { inputFPH: $("").val() },
            type: "",
            dataType: "",
            async: false,
            success: function (data) {
                $.loading(false);
                if (data.state == "") {
                    prevWindow.$("").val($("").val());
                    $.modalClose();
                }
                else {
                    prevWindow.$("").val("");
                    $.modalMsg(data.message, data.state);
                }
            },
            error: function (data) {
                $.modalMsg(data.message, data.state);
            },
            complete: function () {
                $.loading(false);
            }
        });
    }

</script>

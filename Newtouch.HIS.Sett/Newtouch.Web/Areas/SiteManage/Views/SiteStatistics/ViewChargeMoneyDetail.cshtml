
@{
    ViewBag.Title = "";
    Layout = "";
}
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script lang="">
    var year = $.request("");
    var siteId = $.request("");
    var month = $.request("");
    var dlcode = $.request("");
    var type = $.request("");
    var $gridList = $("");

    $(function () {
        gridList();
    });

    //get data
    function gridList() {
        $gridList.dataGrid({
            url: "",
            height: window.$(window).height() - 45,
            postData: getSearchData(),
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 180, align: '' },
                {
                    label: '', name: '', width: 90, align: '',
                    formatter: '', formatoptions: { decimalPlaces: 2 }
                },
                {
                    label: '', name: '', width: 90, align: '',
                    formatter: '', formatoptions: { decimalPlaces: 2 }
                },
                {
                    label: '', name: '', width: 120, align: '',
                    formatter: '', formatoptions: { decimalPlaces: 2 }
                }
            ],
            viewrecords: true,
            unwritten: false
        });
    }

    function getSearchData() {
        return { year: year, siteId: siteId, month: month, dlcode: dlcode, type: type };
    }
</script>

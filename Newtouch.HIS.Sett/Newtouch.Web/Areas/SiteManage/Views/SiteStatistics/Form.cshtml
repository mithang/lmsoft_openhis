<script lang="">
    var id = 0;
    var keyValue = $.request("");
    var $CbGridList = $("");
    var cbjson = [];
    var fjjson = [];
    var mzsf = 0.00;
    var zysf = 0.00;
    var zsf = 0.00;
    var SiteCostEarningVO = {};
    var ContentType = "";//Loại tệp đính kèm
    var fjmc = "";//Tên tệp đính kèm
    var fjPath = "";//Tên tệp đính kèm
    var fileExt = "";
    var files = [];

    //Khởi tạo hộp thả xuống năm tháng
    (function initYearMonthSelect() {
        var date = new Date;
        //Mặc định chọn tháng trước
        var defaultSelYear = 1900 + date.getYear();
        var defaultSelMonth = date.getMonth();
        if (defaultSelMonth === 0) {
            defaultSelYear--;
            defaultSelMonth = 12;
        }
        //Năm
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.yearArr && top.clients.yearArr.length) {
                    $.each(top.clients.yearArr, function () {
                        resultObjArr.push({ id: this, text: this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: defaultSelYear,
        });
        //Tháng
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.monthArr && top.clients.monthArr.length) {
                    $.each(top.clients.monthArr, function () {
                        resultObjArr.push({ id: this, text: parseInt(this) < 10 ? "" + this : this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: defaultSelMonth,
        });

    })();


    $(function () {
        $('').tab('');
        $("").bindSelect({
            url: ""getCurrentTreeOrgIds"",
        });

        CbGridList(null);

        if (!!keyValue) {
            $.loading(true, "");
            $.najax({
                url: "" + keyValue,
                dataType: "",
                success: function (data) {
                    rtndata = JSON.parse(data.message);
                    $('').val(rtndata.srxx.siteId).trigger("");
                    //$('')
                    //Thông tin thu nhập
                    $('').val(rtndata.srxx.year).trigger("");
                    $('').val(rtndata.srxx.month).trigger("");
                    //if (rtndata.srxx.fjPath !== "") {
                    //    $('').attr("", "" + keyValue).html(rtndata.srxx.fjmc);
                    //    fjmc = rtndata.srxx.fjmc;
                    //    fjPath = rtndata.srxx.fjPath;
                    //    ContentType = rtndata.srxx.ContentType;
                    //}
                    if (rtndata.fjxx != null && rtndata.fjxx.length > 0) {
                        files = rtndata.fjxx;
                    }
                    renderFiles();
                    //Chi tiết thu nhập
                    $.each(rtndata.srxxList, function () {
                        mzsf += this.mzsfje;
                        zysf += this.zysfje;
                    });
                    CRGridList(rtndata.srxxList);
                    //Chi tiết chi phí
                    cbjson = rtndata.cbxxList;
                    CbGridList(cbjson);
                },
                complete: function () {
                    $.loading(false);
                }
            });
            //禁用站点，Thông tin chi phí，Tệp đính kèm
            $('').attr("", "").css("", "");
            $('').attr("", "").css("", "");
            $('').attr("", "").css("", "");
        }
        else {
            CRGridList();//声明收入信息
            ajaxCR();//Yêu cầu dữ liệu thu nhập
            loadlastmonthcbxx();//thông tin chi phí yêu cầu tháng cái trên
        }
        $('').change(function () {
            if (keyValue == "") {
                ajaxCR();
            }
        });

        $('').change(function () {
            bindkm($(this).val());
        });
        $('').change(function () {
            $('').val("");
        });

        $("").change(function (e) {
            //   var file = e.delegateTarget.files[0];
            //window.uploadfile = file;
            //var str = '';
            var t_files = this.files;
            for (var i = 0, len = t_files.length; i < len; i++) {
                if (t_files[i].name === "") { }
                else {
                    //$('').removeAttr("").html('');
                    var n1 = t_files[i].name.lastIndexOf('') + 1;
                    fileExt = t_files[i].name.substring(n1, n1 + 3).toLowerCase();
                    fjmc = t_files[i].name;
                    if (fileExt !== "" && fileExt !== "" && fileExt !== "" && fileExt !== ""
                        && fileExt !== "" && fileExt !== "" && fileExt !== "" && fileExt !== "" && fileExt !== "") {
                        $.modalAlert("", '');
                        $("").val("");
                        return false;
                    }

                    if (t_files[i].size / 1024 / 2014 > @ViewData[""]) {
                        $.modalAlert("" +@ViewData[""]+"", '');
                        $("").val("");
                        return false;
                    }
                    files.push(t_files[i]);
                    //str += '' + t_files[i].name + '' + t_files[i].size / 1024 / 2014 + '';
                }
            }
            renderFiles();
        });

        //Xóa trốngiconSự kiện
        $('').on('', '', function () {
            $(this).hide();
        });
    });

    // 渲染附件信息到页面上
    function renderFiles() {
        var htmlstring = '';
        for (var i = 0; i < files.length; i++) {
            var file = files[i];
            htmlstring += '';
            if (file.Id != null && file.Id != undefined) {
                htmlstring += "" + i + "" + rtndata.fjxx[i].Id + "" + rtndata.fjxx[i].fjmc + "";
            } else {
                htmlstring += file.name;
            }
            htmlstring +='' + i + '';
        }
        $('').html(htmlstring);
    }

    function removeFile(idx) {
        files.splice(idx, 1);
        renderFiles();
    }



    //Khởi tạo Lớp nổi
    function initInlineFunc(rowid) {
        $('' + rowid + "").css('', '').attr('', '');
        $('' + rowid + "").css('', '').attr('', '');
        $('' + rowid + "").formatCurrency();
        $('' + rowid + "").formatCurrency();
    }
    //Xóa trống thông tin chi phí
    function clearcbInfo() {
        $('').val("").trigger("");
        $('').val("").trigger("");
        $('').val("");
        $('').val("");
    }
    function getSearchPostData() {
        var site = $('').val();
        var year = $('').val();
        var month = $('').val();
        return { site: site, year: year, month: month };
    }

    function bindkm(cblb) {
        $("").bindSelect({
            url: "" + cblb,
        });
    };
    //get data
    function CbGridList(data) {
        $CbGridList.newtouchLocalDataGrid({
            height: window.$(window).height() - 250,
            width: 580,
            colModel: [
                { label: '', name: '', hidden: true },
                { label: '', name: '', width: 220, align: '' },
                { label: '', name: '', hidden: true },
                { label: '', name: '', width: 250, align: '' },
                { label: '', name: '', width: 200, align: '', formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 } },
                { label: '', name: '', hidden: true }
            ], ondblClickRow: function (rowid) {
                gridEditRow(rowid);
            },
            onSelectRow: function (rowid) {
                $('').removeAttr('');
                $('').removeAttr('');
            },
            unwritten: false
        }, data);
    }

    //Thông tin thu nhập
    function CRGridList(data) {
            $('').newtouchLocalDataGrid({
                height: window.$(window).height() - 230,
                editurl: "",
                colModel: [
                    { label: '', name: '', hidden: true },
                    { label: '', name: '',hidden: true },
                    { label: '', name: '', width: 80, hidden: true },
                    { label: '', name: '', hidden: true },
                    { label: '', name: '', width: 80, align: '' },
                    {
                        label: '', name: '', width: 60, align: '',
                        formatter: function (cellvalue, options, rowObject) {
                            if (rowObject.dlmc === "") {
                                return cellvalue;
                            }
                            var t = rowObject.intype === "" ? "" : "";
                            return "" + rowObject.dlCode + "" + t + "" + cellvalue + "";
                            //return "" + rowObject.dlCode + "" +rowObject.intype+ "" + cellvalue + "";
                        }
                    },
                    { label: '', name: '', width: 80, formatter: '', formatoptions: { thousandsSeparator: "",decimalPlaces: 2 }, align: '' },
                    {
                        label: '', name: '', width: 60, align: '', formatter: function (cellvalue, options, rowObject) {
                            if (rowObject.dlmc === "") {
                                return cellvalue;
                            }
                            return "" + rowObject.dlCode + "" + cellvalue + "";
                        }
                    }   ,
                    { label: '', name: '', width: 80, formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 }, align: '' },
                    { label: '', name: '', width: 100, formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 }, editable: true, align: '', editwidth: "" },
                    {
                        label: '', name: '', width: 100, editwidth: "", align: '', formatter: '', formatoptions: { decimalPlaces: 2 }, editable: true, editrules: { required: true }, editoptions: {
                            dataEvents: [
                                {
                                    type: '',
                                    fn: function (e) {
                                        var cellval = $(this).val();
                                        if (cellval.replace(/(^\s*)|(\s*$)/g, "") == "") {
                                            $.modalAlert("", '');
                                            return;
                                        }
                                        if (isNaN(cellval)) {
                                            $.modalAlert("", '');
                                            $(this).val('');
                                            return;
                                        }
                                        var row = $(e.target).closest('');
                                        var rowid = row.attr('');
                                        CalculateEachLinece(rowid);   //Tính chênh lệch
                                    }
                                }
                            ]
                        }
                    },
                    { label: '', name: '', width: 80, editable: true, editwidth: "", align: '' },
                    { label: '', name: '', width: 80, align: '', editwidth: "", editable: true }

                ],
                unwritten: false,
                footerrow: true,
                rownumbers: false,
                gridComplete: function () {
                    //Bật hộp chỉnh sửa trong dòng
                    EnableInlineEditBox();
                    var sum_mzzxje = $("").getCol('', false, '');
                    var sum_zyzxje = $("").getCol('', false, '');
                    //var sum_zsr = $("").getCol('', false, '');
                    //var sum_hssr = $("").getCol('', false, '');
                    //var sum_ce = $("").getCol('', false, '');
                    zsf = $.addNum(mzsf, zysf);
                    $("").footerData('', { "": '', mzsfje: '' + mzsf + '', mzzxje: sum_mzzxje, zysfje: '' + zysf + '', zyzxje: sum_zyzxje, zsr: zsf });
                    //$('').html('' + mzsf + '' + "" + '' + zysf + ''+ "" + '' +zsf+'');
                    $('').formatCurrency();
                    $('').formatCurrency();

                }
            }, data);
            //Thực đơn cấp hai
            $('').jqGrid('', {
                useColSpanStyle: true,
                groupHeaders: [
                    {
                        startColumnName: '',
                        numberOfColumns: 2,
                        titleText: ''
                    }, {
                        startColumnName: '',
                        numberOfColumns: 2,
                        titleText: ''
                    }]
            });
    }
    //Yêu cầu dữ liệu thu nhập
    function ajaxCR() {
        //新增已收集时，Nút giới hạn
        if (keyValue == null || keyValue==="") {
            $.najax({
                url: "",
                dataType: "",
                type: "",
                data: getSearchPostData(),
                loadingtext: "",
                success: function (resp) {
                    if (resp) {
                        //禁用按钮
                        $('').attr('', '');
                        $('').attr('', '');
                        $('').attr('', '');
                        $('').css('','');
                    } else {
                        $('').removeAttr('', '');
                        $('').removeAttr('', '');
                        $('').removeAttr('', '');
                        $('').css('','');
                    }
                }
            });
        }
        mzsf = 0.00;
        zysf = 0.00;
        $.najax({
            url: "",
            dataType: "",
            type: "",
            data: getSearchPostData(),
            loading: true,
            loadingtext: "",
            success: function (resp) {
                $("").clearGridData();
                $.each(resp, function () {
                    mzsf += this.mzsfje;
                    zysf += this.zysfje;
                });
                $('').newtouchLocalDataGrid(null, resp);
            }
        });
    }

    function loadlastmonthcbxx() {
        $.najax({
            url: "",
            dataType: "",
            type: "",
            data: getSearchPostData(),
            success: function (resp) {
                cbjson = resp;
                fillDataToGrid();
            }
        });
    }

    function CalculateEachLinece(rowid) {
        var currRowzsr = $('' + rowid + '').val();
        var currRowhssr = $('' + rowid + '').val();
        var ce = $.accSub(currRowzsr, currRowhssr);
        if (ce) {
            $('' + rowid + '').val(ce);
        }
    }

    function btnclick(shzt) {
        validatesave();
        if (formatSiteCostEarningVO(shzt)) {
            var formData = new FormData();
            for (var i = 0; i < files.length; i++) {
                if (files[i].Id == undefined || files[i].Id==="") {
                    formData.append('' + i, files[i]);
                }
            }
            formData.append('', JSON.stringify(SiteCostEarningVO.srxx));
            formData.append('', JSON.stringify(SiteCostEarningVO.srxxList));
            formData.append('', JSON.stringify(cbjson));
            formData.append('', JSON.stringify(SiteCostEarningVO.fjxx));
            formData.append('', keyValue);
            var options = {
                url: '',
                data: formData,
                type: '',
                cache: false,
                processData: false,
                contentType:false,
                beforeSubmit: function () {
                    if (!DataValidate()) {
                        return false;
                    }
                    return true;
                },
                success: function (resp) {
                    resp = JSON.parse(resp);
                    if (resp.state == "") {
                        $.modalMsg("", "");
                        $.currentWindow().$('').jqGrid(""); //xóa chi tiếtgrid
                        $.currentWindow().$("").trigger("");
                        $.modalClose();
                    } else {
                        //开启编辑模式
                        EnableInlineEditBox();
                        $.modalAlert(resp.message, "");
                    }

                }
            }
            $.ajax(options);
        }
    }

    //Gửi
    function AcceptClick(callback, shzt) {
        var form = $("");
        var options = {
            url: '',
            type: '',
            beforeSubmit: function () {
                if (!DataValidate()) {
                    return false;
                }
                validatesave();
                return true;
            },
            success: function (resp) {
                rtndata = JSON.parse(JSON.parse(resp).data);
                if (rtndata.result !== "") {
                    fjPath = rtndata.path;
                    $.ajax({
                        url: "",
                        dataType: "",
                        type: "",
                        data: formatSiteCostEarningVO(shzt),
                        loadingtext: "",
                        success: function () {
                            $.modalClose();
                            callback();
                        }, error: function (resp) {
                        }
                    });
                }

            }
        }
        form.ajaxSubmit(options);
    }

    function validatesave() {
        //Lấy tất cả các dòngId，Duyệt để hộp chỉnh sửa ở trạng thái đã lưu
        var rowIds = $("").jqGrid('');
        if (rowIds.length < 1) {
            $.modalAlert("", '');
            return false;
        }
        for (var i = 0; i < rowIds.length; i++) {
            var saveResult = $("").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);
        }
        //
        if (!saveResult) {
            EnableInlineEditBox();    //Khởi động lại và bật chỉnh sửa Nếu không lần sauSavekhi đó sẽ trả vềfalse
            return false;   //Lưu thất bại，Thìreturn
        }
    }

    //数据效验
    function DataValidate() {
        if ($("").val() === "") {
            $.modalAlert("", '');
            return false;
        }
        if ($("").val() === "") {
            $.modalAlert("", '');
            return false;
        }
        if ($("").val() === "") {
            $.modalAlert("", '');
            return false;
        }
        var input_fcbl = $('').val();
        if (!((/^(\+|-)?\d+$/).test(input_fcbl)) || input_fcbl < 0 || input_fcbl > 100) {
            $.modalAlert("", '');
            return false;
        }
        return true;
    }
    function formatSiteCostEarningVO(shzt) {
        var griddata = $("").jqGrid('', null, true);
        if (griddata.length < 1) {
            $.modalAlert("", '');
            return false;
        }
        $.each(griddata, function () {    //Loại bỏaction
            for (var i = 0; i < $(this).length; i++) {
                $(this)[i].mzsfje = $($(this)[i].mzsfje).toNumber().text();
                $(this)[i].zysfje = $($(this)[i].zysfje).toNumber().text();
            }
        });
        SiteCostEarningVO.srxxList = griddata;
        SiteCostEarningVO.fjxx = [];
        var srxx = {};
        srxx.siteId = $('').val();
        srxx.year = $('').val();
        srxx.month = $('').val();
        srxx.zsr = zsf;
        srxx.mzsfzje = mzsf;
        srxx.zysfzje = zysf;
        srxx.shzt = shzt;
        srxx.jgssfdbl = $('').val();
        SiteCostEarningVO.srxx = srxx;
        SiteCostEarningVO.cbxxList = cbjson;
        if (files && files.length>0) {
            for (var i = 0; i < files.length; i++) {
                if (files[i].Id !== null && files[i].Id !== undefined) {
                    var fjxx = {};
                    fjxx.ContentType = files[i].ContentType;
                    fjxx.fjmc = files[i].fjmc;
                    fjxx.fjPath = files[i].fjPath;
                    SiteCostEarningVO.fjxx.push(fjxx);
                }
            }

        }
        return SiteCostEarningVO;//{ srxx: SiteCostEarningVO.srxx, srxxList: SiteCostEarningVO.srxxList, cbxxList: cbjson, keyValue: keyValue };
    }

    var editingNewid = null;    //Dòng đang sửa
    var editingId = null;    //Dòng đang sửa

    //Thêm chi phí
    function btn_bottombutton_add() {
        if (editingNewid || editingId) {
            return; //Đang ở trạng thái sửa，thì không thể nhấn nút thêm   CầndisableXử lý
        }
        if (validatecbinfo()) {
            var item = {
                lbmc: $("").find("").text(),
                cblb: $('').val(),
                kmcode: $('').val(),
                kmmc: $("").find("").text(),
                je: $("").val(),
                Id: Math.random().toString() + new Date().getMilliseconds()
            };
            if (typeof (cbjson) == '') {
                cbjson = [];
            }
            cbjson.push(item)
            fillDataToGrid();
            clearcbInfo();//Xóa trống thông tin chi phí
        }
    }

    //Xác minh thông tin chi phí
    function validatecbinfo() {
        var cblb = $('').val();
        if (!cblb) {
            $.modalAlert("", '');
            return false;
        }
        var kmmc = $('').val();
        if (!kmmc) {
            $.modalAlert("", '');
            return false;
        }
        var je = $('').val();
        if (!je) {
            $.modalAlert("", '');
            return false;
        }
        return true;

    };

    //Yêu cầu Chỉnh sửa Dòng
    function gridEditRow(rowid) {
        if (rowid) {
            var rowData = $("").jqGrid('', rowid);
            if (rowData) {
                rowDataArr = $.jsonWhere(cbjson, function (v) {
                    return v && v.Id == rowData.Id;
                });
                if (!rowDataArr || rowDataArr.length == 0) {
                    return; //Tại sao không tìm thấy
                }
                rowData = rowDataArr[0];  //Thông quarowData.newidLấy dữ liệu dòng đó từ mảng đối tượng
                editingNewid = rowData.Id;    //Dòng đang sửa
                //Tuần tự hóa vào vùng chỉnh sửa
                $('').val(rowData.cblb).trigger("");
                $('').val(rowData.kmcode).trigger("");
                $('').val(rowData.je);
                $('').val(rowData.Id);

                $('').attr('', '');
                $('').show();
                $('').attr('', '');
            }
        }
    }

    //Sửa chi phí
    function btn_bottombutton_edit() {
        if (editingNewid) {
            //Gửi sửa đổi
            var data = getEditRowData();
            if (!(validatecbinfo())) {
                //Dữ liệu đã đầy đủ chưa，Kiểm tra các mục bắt buộc
                return;
            }
            data.Id = editingNewid;
            //Kiểm tra mục trùng lặp

            //Trước tiên trongxmtìm trong mảng
            var matchedIndex = -1;
            for (var ii = 0; ii < cbjson.length; ii++) {
                if (cbjson[ii].Id == data.Id) {
                    matchedIndex = ii;
                    break;
                }
            }
            if (matchedIndex == -1) {
                return; //Có lẽ là bất thường
            }
            cbjson.remove(matchedIndex);   //Xóa mục này
            cbjson.unshift(data);   //Thêm dưới dạng mục mới    //”Đầu mảng“

            //Lại đưaxmMảng hiển thị tớigrid
            fillDataToGrid();

            clearcbInfo();

            editingNewid = null;    //Dòng đang sửa

            bottomButtonsReset();

        }
        else {
            //Đăng ký sửa LấygridDòng đang được chọn hiện tại
            var seleId = $('').jqGrid('', '');
            if (seleId) {
                //Yêu cầu sửa dòng đó
                gridEditRow(seleId);
            }
        }
    };

    //Đặt lại nút
    function bottomButtonsReset() {
        $('').removeAttr('');
        $('').attr('', '');
        $('').attr('', '');
        $('').hide();
    }

    function getEditRowData() {
        var item = {
            lbmc: $("").find("").text(),
            kmmc: $("").find("").text(),
            cblb: $('').val(),
            kmcode: $('').val(),
            je: $("").val(),
            Id: $('').val()
        };
        return item;
    }

    //Xóa chi phí
    function btn_bottombutton_delete() {
        //LấygridDòng đang được chọn hiện tại
        var rowid = $('').jqGrid('', '');
        //Yêu cầu xóa dòng đó
        if (rowid) {
            var rowData = $("").jqGrid('', rowid);
            if (rowData) {
                if (rowData.Id == editingNewid) {
                    $.modalAlert("", '');
                    return; //Dòng này đang ở trạng thái chỉnh sửa，Không thể xóa
                }
                var matchedIndex = -1;

                if (cbjson.length > 0) {
                    for (var ii = 0; ii < cbjson.length; ii++) {
                        if (cbjson[ii].Id === rowData.Id) {
                            matchedIndex = ii;
                        }
                    }
                }
                cbjson.remove(matchedIndex);   //Xóa

                //Lại đưaxmMảng hiển thị tớigrid
                fillDataToGrid();
            }
        }
    };

    //TớiCbGridList gridđiền dữ liệu vào trong
    function fillDataToGrid() {
        $("").resetSelection();
        $("").clearGridData();
        $("").newtouchLocalDataGrid({ posttofirst: false }, cbjson);
    }

    //Hủy sửa
    function btn_bottombutton_canceldel() {
        clearcbInfo();
        editingNewid = null;    //Dòng đang sửa
        bottomButtonsReset();
        $("").resetSelection();
    };

    //Bật hộp chỉnh sửa trong dòng
    function EnableInlineEditBox() {
        //GridTải xong bật chỉnh sửa trong dòng   1.Lấy tất cả các dòng trướcId  2.Gọi duyệteditRowPhương thức
        var rowIds = $("").jqGrid('');
        $.each(rowIds, function () {
            //打开编辑模式
            $("").jqGrid('', this, false, initInlineFunc);
        });
    }

    function reload() {
        $.modalConfirm("", function (flag) {
            if (!flag) {
                return;
            }
            else {
                mzsf = 0.0;
                zysf = 0.0;
                ajaxCR();
            }
        });
    }

    //查看收费金额详情
    function btn_detail(dlcode, type) {
        var year = $('').val();
        var siteId = $('').val();
        var month = $('').val();
        $.modalOpen({
            id: "",
            title: "",
            url: "" + year + "" + siteId + "" + month + "" + dlcode + "" + type,
            width: "",
            height: "",
            btn: null,
        });
    }
</script>

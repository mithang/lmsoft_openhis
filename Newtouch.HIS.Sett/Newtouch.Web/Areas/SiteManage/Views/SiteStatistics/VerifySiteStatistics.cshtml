@using Newtouch.Common.Operator
@using Newtouch.Infrastructure;
@model dynamic

@{
    ViewBag.Title = "";
    Layout = "";
}
<style>
    .form .formTitle {
        position: relative;
        text-align: right;
        white-space: nowrap;
        font-weight: normal;
        width: 55px;
        padding-right: 15px;
    }
</style>
<link rel="stylesheet" type="text/css" href="~/Content/css/bootstrap-multiselect.css">
<script type="" src=""></script>
<form>
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form">
            <tr>
                <td class="formTitle">
                    Cơ quan：
                </td>
                <td class="formValue" style="width:125px;">
                    <select id="siteId" name="siteId" class="form-control" multiple="multiple">
                    </select>
                </td>
                <th class="formTitle">Năm：</th>
                <td class="formValue" style="width:75px;">
                    <select id="year" name="year" class="form-control" style="width:65px">
                        <option value="-1">Tất cả</option>
                    </select>
                </td>
                <th class="formTitle">Tháng：</th>
                <td class="formValue" style="width:75px;">
                    <select id="month" name="month" class="form-control" style="width:65px">
                        <option value="-1">Tất cả</option>
                    </select>
                </td>
                <th class="formTitle">Kiểm duyệt trạng thái：</th>
                <td class="formValue" style="width:65px;">
                    @Html.DropDownList("", Newtouch.Infrastructure.EnumOrgshzt.DS.ToDescSelectList(), "", new { @class = "", @style = "" })
                </td>
                <td>
                    <input type="button" id="btn_search" class="btn btn-md btn-primary form-an" value="Tra cứu" style="margin-left:35px;width:50px" />
                </td>
            </tr>
        </table>
    </div>
    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>
<script lang="">
        //Khởi tạo hộp thả xuống năm tháng
        (function initYearMonthSelect() {
            var date = new Date;
            //Mặc định chọn tháng trước
            var defaultSelYear = 1900 + date.getYear();
            var defaultSelMonth = date.getMonth();
            if (defaultSelMonth == 0) {
                defaultSelYear--;
                defaultSelMonth = 12;
            }
            //Năm
            $("").newtouchBindSelect({
                datasource: function () {
                    var resultObjArr = new Array();
                    if (top.clients.yearArr && top.clients.yearArr.length) {
                        $.each(top.clients.yearArr, function () {
                            resultObjArr.push({ id: this, text: this });
                        });
                    }
                    return resultObjArr;
                },
                selectedValue: defaultSelYear,
            });
            //Tháng
            $("").newtouchBindSelect({
                datasource: function () {
                    var resultObjArr = new Array();
                    if (top.clients.monthArr && top.clients.monthArr.length) {
                        $.each(top.clients.monthArr, function () {
                            resultObjArr.push({ id: this, text: parseInt(this) < 10 ? "" + this : this });
                        });
                    }
                    return resultObjArr;
                },
                selectedValue: defaultSelMonth,
            });

        })();

    $(function () {
            $("").multiselect("").multiselect({
            url: ""getAllOrgIds"",
            selectedValue: '',
            includeSelectAllOption: false,
            enableClickableOptGroups: true,
            enableCollapsibleOptGroups: true,
            selectAllText: "",
            nonSelectedText: "",
            allSelectedText: "",
            nSelectedText:"",
            onBuiltAsyncOptions: function (res) {
                // 这里的代码是ajaxTạo hoàn thànhoptions之后执行
                $("").trigger("");
                gridList();
            },
        });
            $('').change(function () {
                $("").trigger("");
            });
            //隐藏未提交选项
            $("").hide();
            $("").val('').trigger("");
        });

        //get data
        function gridList() {
            var $gridList = $("");
            $gridList.dataGrid({
                url: "",
                height: window.$(window).height() - 150,
                postData: getSearchData(),
                colModel: [
                    { label: "", name: "", hidden: true, key: true },
                    { label: '', name: '', width: 150, align: '' },
                    { label: '', name: '', width: 60, align: '' },
                    { label: '', name: '', width: 50, align: '' },
                    {
                        label: '', name: '', width: 110, align: '',
                        formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 }
                    },
                    {
                        label: '', name: '', width: 90, align: '',
                        formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 }
                    },
                    {
                        label: '', name: '', width: 80, align: '',
                        formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 }
                    },
                    {
                        label: '', name: '', width: 90, align: '',
                        formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 }
                    },
                    {
                        label: '', name: '', width: 90, align: '',
                        formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 }
                    },
                    {
                        label: '', name: '', width: 90, align: '',
                        formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 }
                    },
                    {
                        label: '', name: '', width: 90, align: '',
                        formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 }
                    },
                    {
                        label: '', name: '', width: 80, align: '',
                        formatter: function (cellvalue) {
                            return $.enum.getDescByValue("", cellvalue);
                        }
                    }
                ],
                pager: "",
                sortname: '',
                viewrecords: true,
                unwritten: false,
                ondblClickRow: function (rowid) {
                    ShowDetail(rowid);
                }
            });

            //Tra cứu
            $("").click(function () {
                $("").jqGrid('', {
                    postData: getSearchData(),
                }).trigger('');
            });
        }

        function getSearchData() {
            var siteId = $('').val();
            var year = $('').val();
            var month = $('').val();
            var shzt = $('').val();
            return { siteId: siteId.join(''), year: year, month: month, shzt: shzt, verify: true };
        }

        //Sửa
        function ShowDetail() {
            var keyValue = $("").jqGridRowValue().Id;
            if (!!!keyValue) {
                $.modalAlert("", '');
                return;
            }
            $.modalOpen({
                id: "",
                title: "",
                url: "" + keyValue,
                width: "",
                height: "",
                btn: null
            });
        }
</script>

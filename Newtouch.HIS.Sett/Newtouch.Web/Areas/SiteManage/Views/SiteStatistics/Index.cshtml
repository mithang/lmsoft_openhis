@model dynamic
@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
}
<style>
    .form .formTitle {
        position: relative;
        text-align: right;
        white-space: nowrap;
        font-weight: normal;
        width: 55px;
        padding-right: 15px;
    }
</style>
<link rel="stylesheet" type="text/css" href="~/Content/css/bootstrap-multiselect.css">
<script type="" src=""></script>
<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a id="inputedit" class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a id="inputdel" class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-pencil-square-o"></i>Xóa</a>
        </div>
    </div>
    <div style="height:45px !important;">
        <table class="form" style="width:750px;height:45px !important;">
            <tr>
                <td class="formTitle">
                    Cơ quan：
                </td>
                <td class="formValue" style="width:125px;">
                    <select id="siteId" name="siteId" class="form-control" multiple="multiple">
                    </select>
                </td>
                <th class="formTitle">Năm：</th>
                <td class="formValue" style="width:75px;">
                    <select id="year" name="year" class="form-control" style="width:65px">
                        <option value="-1">Tất cả</option>
                    </select>
                </td>
                <th class="formTitle">Tháng：</th>
                <td class="formValue" style="width:75px;">
                    <select id="month" name="month" class="form-control" style="width:65px">
                        <option value="-1">Tất cả</option>
                    </select>
                </td>
                <th class="formTitle">Kiểm duyệt trạng thái：</th>
                <td class="formValue" style="width:65px;">
                    @Html.DropDownList("", Newtouch.Infrastructure.EnumOrgshzt.DS.ToDescSelectList(), "", new { @class = "", @style = "" })
                </td>
                <td>
                    <input type="button" id="btn_search" class="btn btn-md btn-primary form-an" value="Tra cứu" style="margin-left:35px;width:50px" />
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>
<script lang="">

    //Khởi tạo hộp thả xuống năm tháng
    (function initYearMonthSelect() {
        var date = new Date;
        //Mặc định chọn tháng trước
        var defaultSelYear = 1900 + date.getYear();
        var defaultSelMonth = date.getMonth();
        if (defaultSelMonth == 0) {
            defaultSelYear--;
            defaultSelMonth = 12;
        }
        //Năm
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.yearArr && top.clients.yearArr.length) {
                    $.each(top.clients.yearArr, function () {
                        resultObjArr.push({ id: this, text: this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: defaultSelYear,
        });
        //Tháng
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.monthArr && top.clients.monthArr.length) {
                    $.each(top.clients.monthArr, function () {
                        resultObjArr.push({ id: this, text: parseInt(this) < 10 ? "" + this : this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: defaultSelMonth,
        });

    })();

    $(function () {
        $("").multiselect("").multiselect({
            url: ""getCurrentOrgIds"",
            selectedValue: '',
            includeSelectAllOption: false,
            enableClickableOptGroups: true,
            enableCollapsibleOptGroups: true,
            selectAllText: "",
            nonSelectedText: "",
            allSelectedText: "",
            onBuiltAsyncOptions: function (res) {
                // 这里的代码是ajaxTạo hoàn thànhoptions之后执行
                $("").trigger("");
                gridList();
            },
        });
      
        $('').change(function () {
            $("").trigger("");
        });
        
    });

    //get data
    function gridList() {
        var $gridList = window.$("");
        $gridList.dataGrid({
            url: "",
            height: window.$(window).height() - 120,
            postData: getSearchData(),
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: '', name: '', width: 150, align: '' },
                { label: '', name: '', width: 60, align: '' },
                { label: '', name: '', width: 50, align: '' },
                {
                    label: '', name: '', width: 100, align: '',
                    formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 }
                },
                {
                    label: '', name: '', width: 90, align: '',
                    formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 }
                },
                {
                    label: '', name: '', width: 80, align: '',
                    formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 }
                },
                {
                    label: '', name: '', width: 100, align: '',
                    formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 }
                },
                {
                    label: '', name: '', width: 90, align: '',
                    formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 }
                },
                {
                    label: '', name: '', width: 90, align: '',
                    formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 }
                },
                {
                    label: '', name: '', width: 90, align: '',
                    formatter: '', formatoptions: { thousandsSeparator: "", decimalPlaces: 2 }
                },
                {
                    label: '', name: '', width: 60, align: '',
                    formatter: function (cellvalue) {
                        return $.enum.getDescByValue("", cellvalue);
                    }
                },
                {
                    label: '', name: '', width: 60, align: '',
                    formatter: function (cellvalue, options, rowObject) {
                        return "" + rowObject.Id + "";
                    }
                }],
            pager: "",
            sortname: '',
            viewrecords: true,
            unwritten: false,
            ondblClickRow: function () {
                btn_edit();
            }, onSelectRow: function (rowid, status) {
                var shzt = $("").jqGridRowValue().shzt;
                if (shzt == "" || shzt == "" || shzt == "") {
                    if (shzt != "") {
                        $('').attr('', true);
                    }
                    $('').attr('', '');
                } else {
                    $('').removeAttr('', '');
                    $('').removeAttr('', '');
                }
            }
        });

        //Tra cứu
        $("").click(function () {
            $("").jqGrid('', {
                postData: getSearchData(),
            }).trigger('');
        });
    }

    function getSearchData() {
        var siteId = $('').val() == null ? "" : $('').val().join('');
        var year = $('').val();
        var month = $('').val();
        var shzt = $('').val();
        return { siteId: siteId , year: year, month: month, shzt: shzt };
    }

    //Thêm mới
    function btn_add() {
        window.$.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            btn: null
        });
    }

    //Sửa
    function btn_edit() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return false;
        }
        if ($("").jqGridRowValue().shzt !== ""&&$("").jqGridRowValue().shzt !== "" && $("").jqGridRowValue().shzt !== "") {
            return false;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            btn: null
        });
    }
    //查看详情
    function btn_detail(keyValue) {
         if (!!!keyValue) {
            $.modalAlert("", '');
            return false;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue+"",
            width: "",
            height: "",
            btn: null,
        });
    }

    //Xóa
    function btn_delete() {
        window.$.modalConfirm("", function (flag) {
            if (!flag) {
                return false;
            }
            return true;
        });
        var keyValue = window.$("").jqGridRowValue().Id;
        if (!!!keyValue) {
            window.$.modalAlert("", '');
            return false;
        }
        window.$.deleteForm({
            url: "",
            param: { keyValue: keyValue },
            success: function () {
                $.modalMsg("","");
                $('').jqGrid(""); //xóa chi tiếtgrid
                $("").trigger("");
            }
        });
        return true;
    }
</script>
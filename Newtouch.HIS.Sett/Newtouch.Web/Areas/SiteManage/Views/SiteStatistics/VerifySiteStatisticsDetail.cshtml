@using Newtouch.Infrastructure;
@model dynamic

@{
    ViewBag.Title = "";
    Layout = "";
}
<script type="" src=""></script>
<script type="">
    var keyValue = $.request("");
    var from = $.request("");
    $(function () {
        if (!!keyValue) {
            $.najax({
                url: "" + keyValue,
                dataType: "",
                type: "",
                success: function (data) {
                    var rtndata = JSON.parse(data.message);
                    $("").formSerialize(rtndata.srxx);
                    //Thông tin thu nhập
                    initsrxxtable(rtndata.srxxList, rtndata.srxx.siteId);
                    //Chi tiết chi phí
                    initcbxxtable(rtndata.cbxxList);
                    $('').html(rtndata.srxx.jgss).formatCurrency();
                    $('').html(rtndata.srxx.grsss).formatCurrency();
                    $('').html(rtndata.srxx.year);
                    $('').html(rtndata.srxx.month);
                    $('').html(rtndata.srxx.zdmc);
                    $('').html(rtndata.srxx.cjr);
                    $('').html(rtndata.srxx.shr);
                    //Thông tin tệp đính kèm
                    var fjhtml = "";
                    if (rtndata.fjxx != null && rtndata.fjxx.length > 0)
                    {
                        for (var i = 0; i < rtndata.fjxx.length; i++) {
                            fjhtml += "" + i + "" + rtndata.fjxx[i].Id+"" + rtndata.fjxx[i].fjmc + "";
                            $('' + i).attr("", "" + rtndata.fjxx[i].Id);
                        }

                    }
                    $('').html(fjhtml);
                    $('').formatCurrency();
                    //$('').attr("", "" + keyValue);
                    $('').attr("", "");
                    if (rtndata.srxx.shzt == '' && from !== "") {
                        $('').html('');
                    }
                    if (rtndata.srxx.shzt !== '' || from=="") {
                        $('').attr("", "");
                        $('').attr("", "");
                    }
                    if (rtndata.srxx.shzt==''&&from!="") {
                        $('').attr("", "");
                    }
                }
            });
        }
    });

    function initsrxxtable(srxxList, siteId) {
        var html = "";
        var zsr = 0.00;
        var zhssr = 0.00;
        var zce = 0.00;
        var fczsr = 0.00;
        $.each(srxxList, function () {
            zce += this.ce;
            zhssr += this.hssr;
            zsr += this.zsr;
            fczsr += this.hssr * this.fcbl / 100;
            html += "" + this.dlmc + "";
            html += "" + this.dlCode + "" + siteId + "" + this.mzsfje + "";
            html += "" + this.mzzxje + "";
            html += "" + this.dlCode + "" + siteId + "" + this.zysfje + "";
            html += "" + this.zyzxje + "";
            html += "" + this.zsr + "";
            html += "" + (this.hssr || "") + "";
            html += "" + (this.fcbl || "") + "";
            html += "" + (this.ce || "")  + "";
            html += "" + (this.tzsm || "")+"" + (this.tzsm || "") + "";
            html += "";
        });
        html += "";
        html += "" + zsr + "";
        html += "" + zhssr + "";
        html += "" + fczsr + "";
        html += "" + zce + "";
        html += "";
        html += "";
        $('').after(html);
    }

    //查看收费金额详情
    function btn_detail(dlcode, type, siteId) {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + $('').val() + "" + siteId + "" + $('').val() + "" + dlcode + "" + type,
            width: "",
            height: "",
            btn: null
        });
    }

    function initcbxxtable(cbxxList) {
        var gd = [];
        var fd = [];
        for (var i = 0; i < cbxxList.length; i++) {
            var item = cbxxList[i];
            if (item.cblb === '') {
                fd.push(item);
            } else {
                gd.push(item);
            }
        }

        var len = fd.length > gd.length ? fd.length : gd.length;
        if (len > 0) {
            var html = ""+
                 "" +
                "" + len + 1 + "" +
                "" +
                "" +
                "" + len + 1 + "" +
                "" +
                "" +
                "";

            for (var i = 0; i < len; i++) {
                var gdObj = gd[i] || null;
                var fdObj = fd[i] || null;

                if (gdObj && fdObj) {
                    html += "" +
                        "" + gdObj.kmmc + "" +
                        "" + gdObj.je + "" +

                        "" + fdObj.kmmc + "" +
                        "" + fdObj.je + "" +
                        "";

                } else if (gdObj && !fdObj) {
                    html += "" +
                        "" + gdObj.kmmc + "" +
                        "" + gdObj.je + "" +

                        "" +
                        "" +
                        "";
                } else if (!gdObj && fdObj) {
                    html += "" +
                        "" +
                        "" +

                        "" + fdObj.kmmc + "" +
                        "" + fdObj.je + "" +
                        "";
                }
            }
        }
      
        $('').after(html);
    }

    function btnclick(shzt) {
        $.najax({
            url: "" + keyValue + "" + shzt,
            dataType: "",
            success: function () {
                $.modalMsg("", "");
                $.currentWindow().$('').jqGrid(""); //xóa chi tiếtgrid
                $.currentWindow().$("").trigger("");
                $.modalClose();
            }
        });
    }

    function cxsh() {
        window.$.modalConfirm("", function (flag) {
            if (flag) {
               
                btnclick('');
            }
        });
    }
</script>
<style>
    .dv-panel {
        width: 100%;
        /*height: 690px;*/
        overflow-y: auto;
    }

    table {
        margin: 10px;
        border: 1px double #000;
        height: 98%;
        width: 98%;
    }

    .th1 {
        text-align: center;
        font-size: large;
        padding: 5px;
    }

    .th2 {
        text-align: center;
        font-size: medium;
        padding: 5px;
    }

    .sp-content {
        display: block;
        font-size: small;
        font-weight: bold;
    }

    th, td {
        border: 1px solid #000000;
        text-align: center;
        vertical-align: middle;
        width: 110px;
        padding: 3px 10px;
    }

    .title-content {
        font-size: x-small;
        font-weight: bold;
    }
    .money, .monright {
        text-align: right;
    }
</style>
<div class="dv-panel">
    <table align="center" id="form1">
        <tr>
            <th class="th1" colspan="10">Thống kê thu chi trạm</th>
        </tr>
        <tr>
            <td colspan="10" style="text-align: left;">
                <span class="sp-content">Thống kê thời gian：<label id="year"></label>Năm<label id="month"></label>Tháng</span>
                <span class="sp-content">Trạm thuộc：<label id="zdmc"></label></span>
            </td>
        </tr>
        <tr><th class="th2" colspan="10">Thống kê thu nhập</th></tr>
        <tr>
            <td rowspan="2" class="title-content" style="min-width: 53px;">Khoa</td>
            <td colspan="2" class="title-content">Thu nhập ngoại trú</td>
            <td colspan="2" class="title-content">Thu nhập nhập viện</td>
            <td class="title-content" rowspan="2">Tổng thu nhập</td>
            <td class="title-content" rowspan="2">Xác minh thu nhập</td>
            <td class="title-content" rowspan="2">分成比例</td>
            <td class="title-content" rowspan="2">Chênh lệch</td>
            <td class="title-content" rowspan="2">调整说明</td>
        </tr>
        <tr>

            <td class="title-content">Thu phí số tiền(đồng)</td>
            <td class="title-content">Thực hiện số tiền(đồng)</td>
            <td class="title-content">Thu phí số tiền(đồng)</td>
            <td class="title-content">Thực hiện số tiền(đồng)</td>
        </tr>
        <tbody id="srcol"></tbody>
        <tbody id="cbcol"></tbody>

        <tr>
            <td class="title-content">机构实收(đồng)</td>
            <td colspan="9" style="text-align: left;">
                <span id="jgss"></span>
                <span style="float:right">
                    (Thu nhập xác minh nhóm lớn thu phí cái mỗi*(每个收费大类分成比例))之和减(共担成本之和*(1-共担成本分担比例))
                </span>
            </td>
        </tr>
        <tr>
            <td class="title-content">GRSThực thu(đồng)</td>
            <td colspan="9" style="text-align: left;">
                <span id="grsss"></span>   <span style="float:right">
    (Thu nhập xác minh nhóm lớn thu phí cái mỗi*(1-每个收费大类分成比例))之和减(共担成本之和*共担成本分担比例)-GRSChi phí
</span>
            </td>
        </tr>
        <tr><th class="th2" colspan="11"></th></tr>
        <tr>
            <td class="title-content">制表人</td>
            <td style="text-align: left;"><label id="cjr"></label></td>
            <td class="title-content">Kiểm duyệt người</td>
            <td colspan="7" style="text-align: left;"><label id="shr"></label></td>
        </tr>
        <tr>
            <td class="title-content">费用支持文件</td>
            <td colspan="9" style="text-align: left;"><div id="fjcontent"></div></td>
        </tr>

    </table>
</div>
<input type="button" id="btn_shtg" onclick="btnclick('@Html.Raw(((int)EnumOrgshzt.TG).ToString())')" class="btn btn-primary btn-md" value="Kiểm duyệt thông qua" style="float: right;margin-top: 10px;margin-bottom: 10px;margin-right: 10px;" />
<input type="button" id="btn_shbtg" onclick="btnclick('@Html.Raw(((int)EnumOrgshzt.WTG).ToString())')" class="btn btn-primary btn-md" value="Kiểm duyệt thông qua không" style="float: right;margin-top: 10px;margin-bottom: 10px;margin-right: 10px;" />
<input type="button" hidden id="btn_cxsh" onclick="cxsh()" class="btn btn-primary btn-md" value="Hủy kiểm duyệt" style="float: right;margin-top: 10px;margin-bottom: 10px;margin-right: 20px;" />
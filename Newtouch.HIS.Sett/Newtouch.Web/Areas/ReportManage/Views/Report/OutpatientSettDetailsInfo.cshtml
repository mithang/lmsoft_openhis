@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="rows">
    <div class="panel panel-default">
        <table class="form">
            <tr>
                <th class="formTitle">Ngày bắt đầu：</th>
                <td class="formValue">
                    <input id="kssj" type="text" class="form-control input-wdatepicker form-an"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" value="@(DateTime.Now.ToString("yyyy-MM-01"))" />
                </td>
                <th class="formTitle">Ngày kết thúc：</th>
                <td class="formValue">
                    <input id="jssj" type="text" class="form-control input-wdatepicker form-an"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" value="@(DateTime.Now.ToString("yyyy-MM-dd"))" />
                </td>
                <th class="formTitle">Khoa：</th>
                <td class="formValue">
                    <select id="depa" class="form-control">
                        <option value="">Tất cả</option>
                    </select>
                </td>
                <th class="formTitle">Nhân viên thao tác：</th>
                <td class="formValue">
                    <div class="row">
                        <div class="col-md-9">
                            <input type="text" class="form-control" id="txtsyy" value="" />
                        </div>
                        <div class="col-md-3" style="text-align:right;">
                            <input type="button" class="btn btn-default btn-md" style="width:45px" id="btnsyy" value="Tra cứu" />
                        </div>
                    </div>
                </td>
                <td class="formValue"></td>
            </tr>
            <tr>
                <th class="formTitle">Tính chất bệnh nhân：</th>
                <td class="formValue">
                    <input type="text" id="brxzmc" name="brxzmc" class="form-control form-an">
                </td>
                <th class="formTitle"></th>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
                <th></th>
                <td></td>
            </tr>
        </table>
    </div>
</div>

<div class="ui-layout" id="layout" style="height:100%;width:100%;">
    <iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
            scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
</div>

<script type="">
    var reportServerHOST = '';
    var orgId = '';
    var isHospAdministrator = '';
    var curUserCode = '';

    var uri = '';


    function submit() {

        if ($('').val().length == 0) {
            $.modalAlert("", "");
            return;
        }
        if ($('').val().length == 0) {
            $.modalAlert("", "");
            return;
        }
        if ($('').val() > $('').val()) {
            $.modalAlert("", "");
            return;
        }
        var url = getUrl();

        url += "" + $('').val();
        url += "" + $.getDate({ date: $('').val() }) + '';
        url += "" + $('').val();
        //url += "" + $('').val();
        url += "" + $("").val();
        var brxz = '';
        if ($('').attr('') == $('').val()) {
            brxz = $('').attr('');
        }
        url += "" + brxz;

        setTimeout("", 10);
        $("").attr('', url);
    }

    $("").load(function () {
        $.loading(false);
    });

    $(function () {
        var h = $(window).height() - 55
        $('').css('', h);
        init();

        setTimeout(function () { submit(); }, 100);
    });

    function getUrl() {
        if (uri.StartWith('')) {
            uri = uri.substr(1);
        }
        var srcUrl = uri;
        srcUrl = reportServerHOST + srcUrl;

        //Lấy kiểu tùy chỉnh
        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
        }
        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
            else {
                srcUrl += "";
            }
            srcUrl += "";
            srcUrl += orgId;
        }
        return srcUrl;
    }

</script>
<script type="">
    function init() {
        //Hộp thả xuống liên kết nhà trị liệu
        $("").bindSelect({
            id: "",
            text: "",
            url: "",
            dropdownAutoWidth: true
        });

        $('').change(function () {
            submit();
        });

        //Tính chất chi phí
        $("").newtouchBatchFloatingSelector({
            height: 250,
            width: 400,
            clickautotrigger: true,
            filter: function (keyword) {
                //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
                var resultObjArr = new Array();
                $.each(top.window.clients.sysPatientNatureList, function (idx, val) {
                    resultObjArr.push(val);
                });
                return resultObjArr;
            },
            caption: "",
            colModel: [
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', widthratio: 25 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("").attr("", $thistr.attr(''))
                    .attr("", $thistr.attr(''));
                $("").val($thistr.attr(''));

                submit();
                return;
            }
        });

    }

    //Người thao tác
    $("").click(function () {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + orgId + "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].AcceptClick(function (data) {
                    userStaffTreeCallback(data);
                });
            }
        });
    });

    //Phương thức callback cây nhân viên người dùng
    function userStaffTreeCallback(data) {
        $("").val(data[0].Code);
    }
</script>
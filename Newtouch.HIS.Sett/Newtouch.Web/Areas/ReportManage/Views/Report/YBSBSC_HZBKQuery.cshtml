
@{
    ViewBag.Title = "";
    Layout = "";
    var reportUrl = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("");
    var ReportSystemCode = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("");
}

<div class="rows">
	<div class="panel panel-default">
		<table class="form">
			<tr>
				<th class="formTitle">Ngày bắt đầu：</th>
				<td class="formValue">
					<input id="ksrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px"
						   onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
						   onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
						   value="@DateTime.Now.ToString("yyyy-MM-01")" />
				</td>
				<th class="formTitle">Ngày kết thúc：</th>
				<td class="formValue">
					<input id="jsrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px"
						   onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
						   onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
						   value="@DateTime.Now.ToString("yyyy-MM-dd")" />
				</td>
				<th class="formTitle"></th>
				<td class="formValue" style="padding-left:20px;">
					<input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
				</td>
			</tr>
		</table>
	</div>
</div>
<p style="color:red;">查询有数据会弹出下载提示</p>
<div class="ui-layout" id="layout" style="height:100%;width:100%;">
	<div class="tab-pane fade in active" id="mjz">
		<iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
				scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
	</div>
</div>

<script>
	var tabaction = "";//Chuyển thẻ Ngoại trú mặc định
	 var isHospAdministrator = '';
    var curUserCode = '';
    var OrgId = '';
	var reportServerHOST = '';
	$(function () {
		var h = $(window).height() - 100;
		$('').css('', h);
	});


	function tabchange(action) {
		tabaction = action;
		submit();
	}
	function submit() {
		if ($('').val().length == 0 || $('').val().length == 0) {
			$.modalAlert("", "");
			return;
		}
		var uri = '' + "" + "" + '' + "" + OrgId + "" + $('').val() + "" + $('').val();
		$("").attr('', uri);

		DCQuery(tabaction);
	}

	function DCQuery(type) {
		if ($('').val().length == 0 || $('').val().length == 0) {
			$.modalAlert("", "");
			return;
		}
		var predata = {
			types: type,
			ksrq: $('').val(),
			jsrq: $('').val(),
		};
		$.ajax({
			type: "",
			url: "",
			data: predata,
			dataType: "",
			async: false,
			success: function (data) {
				var refinfo = data;
				console.log(data);

				if (refinfo.path != "") {
					window.location.target = "";
					window.location.href = refinfo.path;
					//window.open(refinfo.path);
				}
			},
			error: function(ex) {
				console.log(ex);
			}
		});
	}

	$("").load(function () {
		$.loading(false);
	});

</script>

@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="rows">
    <div class="panel panel-default">
        <table class="form">
            <tr>
                <th class="formTitle">Năm：</th>
                <td class="formValue">
                    <select id="year" name="year">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <th class="formTitle">Tháng：</th>
                <td class="formValue">
                    <select id="month" name="month">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <th class="formTitle">Nhà trị liệu：</th>
                <td class="formValue">
                    <input id="zls" name="zls" type="text" class="form-control" />
                    <input id="zlsId" name="zlsId" type="text" class="form-control" style="display:none;" />
                    <input id="zlsGh" name="zlsGh" type="text" class="form-control" style="display:none;" />
                </td>
                <th class="formTitle"></th>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
                <th></th>
                <td></td>
            </tr>
        </table>
    </div>
</div>

<div class="ui-layout" id="layout" style="height:100%;width:100%;">
    <iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
            scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
</div>

<script type="">
    var reportServerHOST = '';
    var orgId = '';
    var isHospAdministrator = '';
    var curUserCode = '';

    var uri = '';

    function submit() {

        if ($('').val().length == 0) {
            $.modalAlert("", "");
            return;
        }
        if ($('').val().length == 0) {
            $.modalAlert("", "");
            return;
        }

        var url = getUrl();

        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $('').val();

        setTimeout("", 10);
        $("").attr('', url);
    }

    $("").load(function () {
        $.loading(false);
    });

    $(function () {
        var h = $(window).height() - 55
        $('').css('', h);

        init();

        setTimeout(function () { submit(); }, 100);
    });

    function init() {
        //Chọn nhà trị liệu
        $('').click(function () {
            var initIdSelected = $('').val();
            $.modalOpen({
                id: "",
                title: "",
                url: "" + initIdSelected,
                showleftlalbel: false,
                width: "",
                height: "",
                callBack: function (iframeId) {
                    top.frames[iframeId].AcceptClick(function (data) {
                        staffTreeCallback(data);
                    });
                }
            });
        });

        //Khởi tạo hộp thả xuống năm tháng
        var date = new Date;
        //Năm
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.yearArr && top.clients.yearArr.length) {
                    $.each(top.clients.yearArr, function () {
                        resultObjArr.push({ id: this, text: this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: 1900 + date.getYear(),
        });
        //Tháng
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.monthArr && top.clients.monthArr.length) {
                    $.each(top.clients.monthArr, function () {
                        resultObjArr.push({ id: this, text: parseInt(this) < 10 ? "" + this : this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: date.getMonth() + 1,
        });

    }

    //Cây nhân viên Chọn Callback
    function staffTreeCallback(treeSeleData) {

        $('').val(treeSeleData[0].text);
        $('').val(treeSeleData[0].id);
        $('').val(treeSeleData[0].value);
    }

    function getUrl() {
        var srcUrl = uri;
        srcUrl = reportServerHOST + srcUrl;
        
        //Lấy kiểu tùy chỉnh
        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
        }
        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
            else {
                srcUrl += "";
            }
            srcUrl += "";
            srcUrl += orgId;
        }

        if (false) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
            else {
                srcUrl += "";
            }
            srcUrl += "";
            srcUrl += curUserCode;
        }

        if (false) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
            else {
                srcUrl += "";
            }
            srcUrl += "";
            srcUrl += isHospAdministrator;
        }

        return srcUrl;
    }

</script>

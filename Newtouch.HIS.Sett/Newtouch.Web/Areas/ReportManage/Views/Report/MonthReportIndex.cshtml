
@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="rows">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form">
            <tr>
                <th class="formTitle">Năm：</th>
                <td class="formValue">
                    <select id="year" name="year">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <th class="formTitle">Tháng：</th>
                <td class="formValue">
                    <select id="month" name="month">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
                <td class="formValue"></td>
                <td class="formValue"></td>
                <td class="formValue"></td>
            </tr>
        </table>
    </div>
</div>
<div id="divNavNew" class="rows hide">
    <div class="panel panel-default">
        <div class="panel-body">
            <span id="span"></span>固定报表尚未生成，Nhấn<a id="btnToNewReport" class="text-primary">Tạo báo cáo mới</a>
        </div>
        <div></div>
    </div>
</div>

<div class="gridPanel">
    <table id="gridList"></table>
</div>

@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
    ShowKeyList = new[] { 6, 7, 9 },
    F6Text = "",
    F7Text = "",
    F9Text = "",
})

<script type="">
    window.newtouch_globalconfig.f4opions = {
        container: ""  //None
    };

    var details = [];
    var isregenerate = false;

    $('').select2({ minimumResultsForSearch: -1 });
    $('').select2({ minimumResultsForSearch: -1 });

    function initGridList(dlColArr) {
        var colModelArr = [
                {
                    label: "", name: "", width: 60, align: "", formatter: function (cellvalue) {
                        return cellvalue == "" ? "" : (cellvalue == "" ? "" : "");
                    }
                },
                { label: "", name: "", width: 80, align: "" },
                {
                    label: "", name: "", width: 120, align: "", formatter: function (cellvalue) {
                        return cellvalue === "" ? "" : cellvalue;
                    }
                },
                { label: "", name: "", width: 80, align: "" },
        ];
        if (dlColArr && dlColArr.length && dlColArr.length > 0) {
            $.each(dlColArr, function () {
                colModelArr.push(this);
            });
        }
        //Khai báo Chi tiết hạng mục grid
        $("").newtouchLocalDataGrid({
            height: $(window).height() - 190,
            unwritten: false,
            colModel: colModelArr,
            caption: '',
        });
    }
    initGridList();

    $('').click(function () {
        newtouch_event_f4();
        var year = $('').val();
        var month = $('').val();
        if (year && month) {
            $.najax({
                url: '',
                data: { year: year, month: month },
                loading: true,
                success: function (ajaxresp) {
                    if (!!ajaxresp.data && ajaxresp.data && ajaxresp.data.length > 0) {
                        $('').addClass('');
                        //Tạo đã báo cáo 呈现之
                        formatRespData(ajaxresp.data);
                        //Ngày tạo báo cáo
                        var caption = year + '' + $.zeroPrefixInteger(month, 2) + '';
                        caption += '' + $.getDate({ date: new Date(ajaxresp.data[0].CreateTime) });
                        caption += '';
                        caption += getFeeTotal(ajaxresp.data).toFixed(2);
                        caption += '';
                        $("").setCaption(caption);

                        $('').removeAttr('');   //Lại tạo Nút Thao tác có thể
                        $('').removeAttr('');   //XuấtExcel Thao tác có thể
                    }
                    else {
                        $('').html(year + '' + $.zeroPrefixInteger(month, 2) + '');
                        $('').removeClass('');
                    }
                }
            });
        }
    });

    $('').change(function () {
        if (details && details.length && details.length > 0) {
            $('').trigger('');
        }
        else {
            newtouch_event_f4();
        }
    });

    $('').click(function () {
        newtouch_event_f4();
        loadRealTimeData();
    });

    function loadRealTimeData() {
        var year = $('').val();
        var month = $('').val();
        if (year && month) {
            $.najax({
                url: '',
                data: { year: year, month: month },
                loading: true,
                success: function (ajaxresp) {
                    if (!!ajaxresp.data && ajaxresp.data.length && ajaxresp.data.length > 0) {
                        formatRespData(ajaxresp.data);

                        var caption = year + '' + $.zeroPrefixInteger(month, 2) + '';
                        caption += '';
                        caption += getFeeTotal(ajaxresp.data).toFixed(2);
                        caption += '';
                        $("").setCaption(caption);

                        $('').removeAttr('');   //Tạo báo cáo Nút Thao tác có thể
                    }
                    else {
                        //Lấy dữ liệu thất bại
                        $.modalAlert("", '');
                    }
                },
                error: function () {
                    //Lấy dữ liệu thất bại
                    $.modalAlert("", '');
                }
            });
        }
    }

    function newtouch_event_f4() {
        details = null;
        isregenerate = false;
        $('').addClass('');
        $('').html('');  //先清除掉gridnội dung
        initGridList();
        $('').attr('', '');
        $('').attr('', '');
        $('').attr('', '');
    }
    $('').attr('', '');
    $('').attr('', '');
    $('').attr('', '');

    function formatRespData(data) {
        details = data;
        var dlColArr = [];
        $.each(data, function () {
            var isContains = false;
            if (this.dl) {
                for (var iiii = 0; iiii < dlColArr.length ; iiii++) {
                    if (dlColArr[iiii].name == this.dl) {
                        isContains = true;
                        break;
                    }
                }
                if (!isContains) {
                    dlColArr.push({
                        label: this.dlmc, name: this.dl, width: 80, align: "", formatter: ""
                    });
                }
            }
        });
        $('').html('');  //先清除掉gridnội dung
        initGridList(dlColArr);
        //Dữ liệu hiển thị
        //Xử lýdata Đến 目标格式（Cột nhóm lớn có）
        $("").newtouchLocalDataGrid({ posttofirst: false, actions: '' }, formatDlData(data));
        //Hiển thịdata中补差哪一行
        var buchaRow = $.jsonWhere(data, function (v) {
            return !!v.bz && !!v.dlje;    //这是一补差记录
        });
        if (buchaRow && buchaRow.length && buchaRow.length == 1) {
            buchaRow = buchaRow[0];
            //插入到gridListDòng một cuối cùng
            $("").newtouchLocalDataGrid({ posttofirst: false, actions: '' }, [
                { zyhmzh: '' + buchaRow.dlje.toFixed(2), brxm: '' + buchaRow.bz }]);
            var $tds = $('').not('');
            var tdslength = $tds.length;
            $('').attr('', (tdslength + 1));
            $tds.remove();
        }
        //本月合计：
        //插入到gridListDòng một cuối cùng
        $("").newtouchLocalDataGrid({ posttofirst: false, actions: '' }, [
            { zyhmzh: '' + getFeeTotal(data).toFixed(2) }]);
        var $tds = $('').not('');
        var tdslength = $tds.length;
        $('').attr('', (tdslength + 1));
        $tds.remove();
    }

    //resp data to data
    //Xử lýdata Đến 目标格式（Cột nhóm lớn có）
    function formatDlData(data) {
        var respData = [];
        $.each(data, function () {
            if (this.dl) {
                for (var iiii = 0; iiii < respData.length ; iiii++) {
                    if (respData[iiii].patientType === this.patientType
                        && respData[iiii].blh === this.blh
                        && respData[iiii].zyhmzh === this.zyhmzh
                        && respData[iiii].brxm === this.brxm) {
                        respData[iiii][this.dl] = this.dlje;
                        return; //return， 而不是continue
                    }
                }
                var newPatientData = { patientType: this.patientType, blh: this.blh, zyhmzh: this.zyhmzh, brxm: this.brxm };
                newPatientData[this.dl] = this.dlje;
                respData.push(newPatientData);
            }
        });
        return respData;
    }

    //F6Tạo báo cáo 固化 Điều chỉnh Trang lớp nổi
    function newtouch_event_f6() {
        var year = $('').val();
        var month = $('').val();
        if (!details || !details.length || details.length == 0) {
            $.modalAlert("", '');
            return;
        }
        $.modalOpen({
            id: "",
            title: year + '' + $.zeroPrefixInteger(month, 2) + '' + '',
            url: '' + year + '' + month + '' + isregenerate + ''
                + getFeeTotal(details),
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitMonthReport();
            }
        });
    };

    //F9 Yêu cầu báo cáo tạo lại
    function newtouch_event_f9() {
        $.modalConfirm("", function (flag) {
            if (flag) {
                isregenerate = true;
                $('').attr('', '');   //先让其disabled
                $('').attr('', '');    //先让其disabled
                loadRealTimeData();
            }
        });
    }

    function getFeeTotal(data) {
        var total = 0;
        $.each(data, function () {
            total = $.addNum(total, this.dlje);
        });
        return total;
    }

    function init() {
        //Khởi tạo hộp thả xuống năm tháng
        var date = new Date;
        //Năm
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.yearArr && top.clients.yearArr.length) {
                    $.each(top.clients.yearArr, function () {
                        resultObjArr.push({ id: this, text: this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: 1900 + date.getYear(),
        });
        //Tháng
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.monthArr && top.clients.monthArr.length) {
                    $.each(top.clients.monthArr, function () {
                        resultObjArr.push({ id: this, text: parseInt(this) < 10 ? "" + this : this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: date.getMonth() + 1,
        });

    }
    init();
</script>

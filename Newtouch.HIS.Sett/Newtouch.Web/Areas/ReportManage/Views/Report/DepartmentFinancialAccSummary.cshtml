@{
    ViewBag.Title = "";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<div class="rows">
    <div class="panel panel-default">
        <table class="form">
            <tr>
                <th class="formTitle">Ngày bắt đầu：</th>
                <td class="formValue">
                    <input id="kssj" type="text" class="form-control input-wdatepicker form-an"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" value="@(DateTime.Now.ToString("yyyy-MM-01"))" />
                </td>
                <th class="formTitle">Ngày kết thúc：</th>
                <td class="formValue">
                    <input id="jssj" type="text" class="form-control input-wdatepicker form-an"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" value="@(DateTime.Now.ToString("yyyy-MM-dd"))" />
                </td>
                <th class="formTitle">Khoa：</th>
                <td class="formValue">
                    <select id="depa" class="form-control">
                        <option value="">Tất cả</option>
                    </select>
                </td>
                <th class="formTitle">Tính chất bệnh nhân：</th>
                <td class="formValue">
                    <input type="text" id="brxzmc" name="brxzmc" class="form-control form-an">
                </td>
                <td class="formValue"></td>
            </tr>
            <tr>
                <th class="formTitle">Nhân viên thao tác：</th>
                <td class="formValue">
                    <div class="row">
                        <div class="col-md-9">
                            <input type="text" class="form-control" id="txtsyy" value="" />
                        </div>
                        <div class="col-md-3" style="text-align:right;">
                            <input type="button" class="btn btn-default btn-md" style="width:45px" id="btnsyy" value="Tra cứu" />
                        </div>
                    </div>
                </td>
                <th class="formTitle">Loại quyết toán：</th>
                <td class="formValue">
                    <select id="jslx" class="form-control">
                        <option value="0">==Tất cả==</option>
                        <option value="1">Ngoại trú</option>
                        <option value="2">Nhập viện</option>
                    </select>
                </td>
                <th class="formTitle"></th>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
            </tr>
        </table>
    </div>
</div>

<div class="ui-layout" id="layout" style="height:100%;width:100%;">
    <iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
            scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
</div>

<script type="text/javascript">
    var reportServerHOST = '@(ViewBag.ReportServerHOST)';
    var orgId = '@(ViewBag.OrgId)';
    var isHospAdministrator = '@(ViewBag.IsHospAdministrator)';
    var curUserCode = '@(ViewBag.CurUserCode)';

    var uri = 'ReportServer/Pages/ReportViewer.aspx?%2FHIS.Report.1%2F%E7%A7%91%E5%AE%A4%E8%B4%A2%E5%8A%A1%E6%A0%B8%E7%AE%97%E6%B1%87%E6%80%BB%E8%A1%A8&rs:Command=Render';


    function submit() {

        if ($('#kssj').val().length == 0) {
            $.modalAlert("Thiếu thời gian bắt đầu", "error");
            return;
        }
        if ($('#jssj').val().length == 0) {
            $.modalAlert("Thiếu thời gian kết thúc", "error");
            return;
        }
        if ($('#kssj').val() > $('#jssj').val()) {
            $.modalAlert("Thời gian bắt đầu không được lớn hơn thời gian kết thúc", "error");
            return;
        }
        var url = getUrl();

        url += "&kssj=" + $('#kssj').val();
        url += "&jssj=" + $.getDate({ date: $('#jssj').val() }) + ' 23:59:59';
        url += "&dept=" + $('#depa').val();
        url += "&czy=" + $("#txtsyy").val();
        url += "&jslx=" + $('#jslx').val();
        var brxz = '';
        if ($('#brxzmc').attr('data-brxzmc') == $('#brxzmc').val()) {
            brxz = $('#brxzmc').attr('data-brxz');
        }
        url += "&brxz=" + brxz;

        setTimeout("$.loading(true, 'Đang tải trang báo cáo...');", 10);
        $("#iframerightiframerightiframerightttt").attr('src', url);
    }

    $("#iframerightiframerightiframerightttt").load(function () {
        $.loading(false);
    });

    $(function () {
        var h = $(window).height() - 55
        $('#layout iframe').css('height', h);
        init();

        setTimeout(function () { submit(); }, 100);
    });

    function getUrl() {
        if (uri.StartWith('/')) {
            uri = uri.substr(1);
        }
        var srcUrl = uri;
        srcUrl = reportServerHOST + srcUrl;

        //Lấy kiểu tùy chỉnh
        if (true) {
            if (srcUrl.indexOf('&rc:') == -1) {
                srcUrl += "&rc:Stylesheet=MyStyleSheet";
            }
        }
        if (true) {
            if (srcUrl.indexOf('&rs:') == -1) {
                srcUrl += "&rs:";
            }
            else {
                srcUrl += "&";
            }
            srcUrl += "orgId=";
            srcUrl += orgId;
        }
        return srcUrl;
    }

</script>
<script type="text/javascript">
    function init() {
        //Hộp thả xuống liên kết kỹ thuật viên trị liệu
        $("#depa").bindSelect({
            id: "Code",
            text: "Name",
            url: "/OutpatientManage/OutpatientRegSchedule/GetSysDepartmentList",
            dropdownAutoWidth: true
        });

        $('#depa').change(function () {
            submit();
        });

        $('#jslx').bindSelect();

        $('#jslx').change(function () {
            submit();
        });

        //Tính chất chi phí
        $("#brxzmc").newtouchBatchFloatingSelector({
            height: 250,
            width: 400,
            clickautotrigger: true,
            filter: function (keyword) {
                //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
                var resultObjArr = new Array();
                $.each(top.window.clients.sysPatientNatureList, function (idx, val) {
                    resultObjArr.push(val);
                });
                return resultObjArr;
            },
            caption: "Tính chất chi phí",
            colModel: [
                { label: 'Số hiệu', name: 'brxzbh', widthratio: 25 },
                { label: 'Mã', name: 'brxz', widthratio: 25 },
                { label: 'Tên', name: 'brxzmc', widthratio: 25 },
                { label: 'Phiên âm', name: 'py', widthratio: 25 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#brxzmc").attr("data-brxzmc", $thistr.attr('data-brxzmc'))
                    .attr("data-brxz", $thistr.attr('data-brxz'));
                $("#brxzmc").val($thistr.attr('data-brxzmc'));

                submit();
                return;
            }
        });

    }

    //Người thao tác
    $("#btnsyy").click(function () {
        $.modalOpen({
            id: "FormUsers",
            title: "Chọn nhân viên thao tác",
            url: "/SystemManage/User/Selector?from=mzshoufeicaozuoyuan&organizeId=" + orgId + "&isExpand=true&callbackType=json&single=true",
            width: "300px",
            height: "400px",
            callBack: function (iframeId) {
                top.frames[iframeId].AcceptClick(function (data) {
                    userStaffTreeCallback(data);
                });
            }
        });
    });
    //Phương thức callback cây nhân viên người dùng
    function userStaffTreeCallback(data) {
        $("#txtsyy").val(data[0].Code);
    }

</script>
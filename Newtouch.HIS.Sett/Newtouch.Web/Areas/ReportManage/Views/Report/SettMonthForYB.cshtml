@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="rows">
    <div class="panel panel-default">
        <table class="form">
            <tr>
                <th class="formTitle">申报类型：</th>
                <td class="formValue">
                    <select id="sblx" class="form-control">
                        <option value="1">Bảo hiểm y tế</option>
                        <option value="2">居保</option>
                    </select>
                </td>
                <th class="formTitle">Quyết toán phần tháng：</th>
                <td class="formValue">
                    <input id="ksrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM' })"
                           onfocus="WdatePicker({ dateFmt: 'yyyy-MM', onpicked: function () { refReport(); } })"
                           value="@DateTime.Now.ToString("yyyy-MM")" />
                </td>
                <th class="formTitle"></th>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
                <th></th>
                <td></td>
                <th></th>
                <td></td>
                <th></th>
                <td></td>
                <th></th>
                <td></td>
            </tr>
        </table>
    </div>
</div>

<div class="ui-layout" id="layout" style="height:100%;width:100%;">
    <iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
            scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
</div>

<script type="">
    var reportServerHOST = '';
    var orgId = '';
    var isHospAdministrator = '';
    var curUserCode = '';
    var uri = '';

    function submit() {

        if ($('').val().length == 0 ) {
            $.modalAlert("", "");
            return;
        }

        //同步费用
        $.ajax({
            url: "",
            dataType: "",
            type: "",
            async: false,
            success: function (data) {
            }
        })
        var url = getUrl();
        var bdate = new Date($('').val()).format('');

        url += "" + bdate + "" + bdate + "" + $('').val();

        setTimeout("", 10);
        $("").attr('', url);
    }

    $("").load(function () {
        $.loading(false);
    });

    $(function () {
        var h = $(window).height() - 55
        $('').css('', h);

    });

    //Làm mới danh sách
    function refReport() {
        $("").trigger('');
    }

    function getUrl() {
        if (uri.StartWith('')) {
            uri = uri.substr(1);
        }
        var srcUrl = uri;
        srcUrl = reportServerHOST + srcUrl;

        //Lấy kiểu tùy chỉnh
        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
        }
        if (false) {
            srcUrl += "" + curUserCode;
        }
        if (false) {
            srcUrl += "" + isHospAdministrator;
        }

        return srcUrl;
    }

</script>


@{
    ViewBag.Title = "";
    Layout = "";
}

<style>
    div[id$='_oReportDiv'] {
        background: red;
    }
</style>
<div class="rows">
    <div class="panel panel-default">
        <table class="form">
            <tr>
                <th class="formTitle">Khoa：</th>
                <td class="formValue">
                    <select id="depa" class="form-control">
                        <option value="">Tất cả</option>
                    </select>
                </td>
                <th class="formTitle">Bác sĩ：</th>
                <td class="formValue">
                    <select id="doctor" class="form-control">
                        <option value="">Tất cả</option>
                    </select>
                </td>
                <th class="formTitle">Ngày bắt đầu：</th>
                <td class="formValue">
                    <input id="kssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
                           onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', onpicked: function () { refReport(); } })"
                           value="@DateTime.Now.AddDays(-7).ToString("yyyy-MM-dd")" />
                </td>
                <th class="formTitle">Ngày kết thúc：</th>
                <td class="formValue">
                    <input id="jssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
                           onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', onpicked: function () { refReport(); } })"
                           value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </td>
                <th class="formTitle"></th>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
                <th></th>
                <td></td>
                <th></th>
                <td></td>
            </tr>
        </table>
    </div>
</div>
<div class="ui-layout" id="layout" style="height:100%;width:100%;">
    <iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
            scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
</div>
<script type="">
    var reportServerHOST = '';
    var orgId = '';
    var uri = '';
    function submit() {
        if ($('').val().length == 0) {
            $.modalAlert("", "");
            return;
        }
        if ($('').val().length == 0) {
            $.modalAlert("", "");
            return;
        }
        if ($('').val() > $('').val()) {
            $.modalAlert("", "");
            return;
        }
        var url = getUrl();

        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $('').val();
        setTimeout("", 10);
        $("").attr('', url);
    }

    $("").load(function () {
        $.loading(false);
    });

    $(function () {
        var h = $(window).height() - 55;
        $('').css('', h);
    });

    function getUrl() {
        if (uri.StartWith('')) {
            uri = uri.substr(1);
        }
        var srcUrl = uri;
        srcUrl = reportServerHOST + srcUrl;

        //Lấy kiểu tùy chỉnh
        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
        }
        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
            else {
                srcUrl += "";
            }
            srcUrl += "";
            srcUrl += orgId;
        }
        return srcUrl;
    }

    $('').change(function () {
       
        $('').trigger("");
    });
</script>
<script type="">
    function funcOrganizeIdChange() {
        orgId = $("").val();
        //Hộp thả xuống liên kết nhà trị liệu
        $("").bindSelect({
            id: "",
            text: "",
            url: "",
            dropdownAutoWidth: true
        });

        $("").bindSelect({
            id: "",
            text: "",
            url: "" + orgId,
            dropdownAutoWidth: true
        });

        submit();
    }
</script>
@Html.Partial("")



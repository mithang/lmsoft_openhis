
@{
    ViewBag.Title = "";
    Layout = "";
}
<div class="rows">
    <div class="panel panel-default">
        <table class="form">
            <tr>
                <th class="formTitle">Thu phí ngày bắt đầu：</th>
                <td class="formValue">
                    <input id="kssj" type="text" class="form-control input-wdatepicker form-an"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" value="@(DateTime.Now.ToString("yyyy-MM-01"))" />
                </td>
                <th class="formTitle">Ngày kết thúc：</th>
                <td class="formValue">
                    <input id="jssj" type="text" class="form-control input-wdatepicker form-an"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" value="@(DateTime.Now.ToString("yyyy-MM-dd"))" />
                </td>
                <th class="formTitle">Loại：</th>
                <td class="formValue">
                    <select id="type" name="type" class="form-control form-an">
                        <option value="">==Vui lòng chọn==</option>
                        <option value="outpatient">Ngoại trú</option>
                        <option value="inpatient">Nhập viện</option>
                    </select>
                </td>
                <th class="formTitle"></th>
                <td class="formValue"></td>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="ui-layout" id="layout" style="height:100%;width:100%;">
    <iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
            scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
</div>
<script type="">
    var reportServerHOST = '';
    var orgId = '';
    var isHospAdministrator = '';
    var curUserCode = '';
    var uri = '';
    function search() {
        submit();
    }
    function submit() {
        if ($('').val().length == 0) {
            $.modalAlert("", "");
            return;
        }
        if ($('').val().length == 0) {
            $.modalAlert("", "");
            return;
        }
        if ($('').val() > $('').val()) {
            $.modalAlert("", "");
            return;
        }

        var url = getUrl();
        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + ($('').val() == null ? "" : $('').val());

        setTimeout("", 10);
        $("").attr('', url);
    }

    $("").load(function () {
        $.loading(false);
    });

    $(function () {
        var h = $(window).height() - 55
        $('').css('', h);

        //Liên kết lớp nổi chọn hạng mục điều trị
        $('').newtouchBatchFloatingSelector({
            width: 500,
            height: 200,
            caption: "",
            clickautotrigger: true,
            url: "",
            ajaxparameters: function ($thisinput) {
                var keyword = $thisinput.val().trim();
                var orgId = $("").val();
                return "" + keyword + "" + orgId;
            },
            itemdbclickhandler: function ($thistr, $thisinput) {
                if (!!$thistr.attr('')) {
                    $("").val($thistr.attr(''));
                    $("").attr("", $thistr.attr(''));
                }
            },
            colModel: [
                 { label: '', name: '', hidden: true },
                 { label: '', name: '', width: 100, align: '' },
                 { label: '', name: '', width: 120, align: '' },
                 { label: '', name: '', hidden: true, width: 100, align: '' },
                 {
                     label: '', name: '', width:70, align: '', formatter: function (cellvalue) {
                         return $.getGender(cellvalue);
                     }
                 },
                    {
                        label: '', name: '', width: 100, align: '', formatter: function (cellvalue, a, b) {
                            return getAgeFromBirthTime({ begin: b.csny }).text;
                        }
                    },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true }
            ]
        });
        setTimeout(function () { submit(); }, 100);
    });

    function getUrl() {
        if (uri.StartWith('')) {
            uri = uri.substr(1);
        }
        var srcUrl = uri;
        srcUrl = reportServerHOST + srcUrl;
        //Lấy kiểu tùy chỉnh
        if (srcUrl.indexOf('') === -1) {
            srcUrl += "";
        }
        if (srcUrl.indexOf('') === -1) {
            srcUrl += "";
        }
        else {
            srcUrl += "";
        }
        srcUrl += "";
        srcUrl += orgId;
        return srcUrl;
    }

</script>
<script type="">
    function funcOrganizeIdChange() {
        $("").val('');
        orgId = $("").val();
        //submit();
    }
</script>
@Html.Partial("")
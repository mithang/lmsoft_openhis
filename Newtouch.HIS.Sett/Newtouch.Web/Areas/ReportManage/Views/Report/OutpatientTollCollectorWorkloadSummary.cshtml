</div>

<script type="">
    var reportServerHOST = '';
    var orgId = '';
    var isHospAdministrator = '';
    var curUserCode = '';
    
    


    var uri = '';


    function submit() {

        if ($('').val().length == 0) {
            $.modalAlert("", "");
            return;
        }
        if ($('').val().length == 0) {
            $.modalAlert("", "");
            return;
        }
        if ($('').val() > $('').val()) {
            $.modalAlert("", "");
            return;
        }
        var url = getUrl();

        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $("").val();

        setTimeout("", 10);
        $("").attr('', url);
        
    }

    $("").load(function () {
        $.loading(false);
    });

    $(function () {
        var h = $(window).height() - 55
        $('').css('', h);
        init();

        setTimeout(function () { submit(); }, 100);
    });

    function getUrl() {
        if (uri.StartWith('')) {
            uri = uri.substr(1);
        }
        var srcUrl = uri;
        srcUrl = reportServerHOST + srcUrl;

        //Lấy kiểu tùy chỉnh
        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
        }
        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
            else {
                srcUrl += "";
            }
            srcUrl += "";
            srcUrl += orgId;
        }
        return srcUrl;
    }

</script>
<script type="">
    function init() {
        //Người thao tác
        $("").click(function () {
            $.modalOpen({
                id: "",
                title: "",
                url: "" + orgId + "",
                width: "",
                height: "",
                callBack: function (iframeId) {
                    top.frames[iframeId].AcceptClick(function (data) {
                        userStaffTreeCallback(data);
                    });
                }
            });
        });
        //Phương thức callback cây nhân viên người dùng
        function userStaffTreeCallback(data) {
            $("").val(data[0].Code);
        }

    }
</script>
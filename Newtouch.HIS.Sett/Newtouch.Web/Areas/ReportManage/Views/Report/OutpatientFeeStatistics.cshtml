
@{
    ViewBag.Title = "";
    Layout = "";
}
<style>
    div[id$='_oReportDiv'] {
        background: red;
    }
</style>
<div class="rows">
    <div class="panel panel-default">
        <table class="form">
            <tr>
                <th class="formTitle">Điều trị ngày bắt đầu：</th>
                <td class="formValue">
                    <input id="kssj" type="text" class="form-control input-wdatepicker form-an"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" value="@(DateTime.Now.ToString("yyyy-MM-01"))" />
                </td>
                <th class="formTitle">Ngày kết thúc：</th>
                <td class="formValue">
                    <input id="jssj" type="text" class="form-control input-wdatepicker form-an"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" value="@(DateTime.Now.ToString("yyyy-MM-dd"))" />
                </td>
                <th class="formTitle">Nhà trị liệu：</th>
                <td class="formValue formDdlSelectorTd">
                    <select id="zls" name="zls" class="form-control form-an">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <th class="formTitle">Loại hạng mục：</th>
                <td class="formValue">
                    <select id="xmtype" name="xmtype" class="form-control form-an">
                        <option value="">==Vui lòng chọn==</option>
                        <option value="zlxm" selected>Hạng mục điều trị</option>
                        <option value="fzlxm">Hạng mục không điều trị</option>
                    </select>
                </td>
                <th class="formTitle">Loại：</th>
                <td class="formValue">
                    <select id="type" name="type" class="form-control form-an">
                        <option value="">==Vui lòng chọn==</option>
                        <option value="outpatient">Ngoại trú</option>
                        <option value="inpatient">Nhập viện</option>
                    </select>
                </td>

                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="ui-layout" id="layout" style="height:100%;width:100%;">
    <iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
            scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
</div>
<script type="">
    var reportServerHOST = '';
    var orgId = '';
    var thisorgId = '';
    var isHospAdministrator = '';
    var curUserCode = '';
    var curUsergh = '';
    //var uri = '';
    var uri = '';
    function submit() {
        if ($('').val().length == 0) {
            $.modalAlert("", "");
            return;
        }
        if ($('').val().length == 0) {
            $.modalAlert("", "");
            return;
        }
        if ($('').val() > $('').val()) {
            $.modalAlert("", "");
            return;
        }
        var url = getUrl();

        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + ($('').val() == null ? "" : $('').val());
        url += "" + ($('').val() == null ? "" : $('').val());

        setTimeout("", 10);
        $("").attr('', url);
    }

    $("").load(function () {
        $.loading(false);
    });

    $(function () {
        var h = $(window).height() - 55;
        $('').css('', h);
    });

    function getUrl() {
        if (uri.StartWith('')) {
            uri = uri.substr(1);
        }
        var srcUrl = uri;
        srcUrl = reportServerHOST + srcUrl;

        var tempIsHospAdministrator = isHospAdministrator;
        if (checkIsShowAll()) {
            tempIsHospAdministrator = "";
            curUserCode = "";
        }
        //Lấy kiểu tùy chỉnh
        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
        }
        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
            else {
                srcUrl += "";
            }
            srcUrl += "";
            srcUrl += orgId;
        }

        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
            else {
                srcUrl += "";
            }
            srcUrl += "";
            srcUrl += curUserCode;
        }

        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
            else {
                srcUrl += "";
            }
            srcUrl += "";
            srcUrl += tempIsHospAdministrator;
        }

        return srcUrl;
    }

    $('').change(function () {
        if ($(this).val() == "") {//非治疗项目不区分门诊住院
            $("").val("").trigger("").attr("", "").css("", "");
        } else if ($(this).val() == "") {
            $('').val("").trigger("").removeAttr('').css("", "");
        }
        $('').trigger("");
    });
    $('').change(function () {
        $('').trigger("");
    });
    $('').change(function () {
        $('').trigger("");
    });
</script>
<script type="">
    function funcOrganizeIdChange() {
        orgId = $("").val();
        //Hộp thả xuống liên kết nhà trị liệu
        $("").bindSelect({
            id: "",
            text: "",
            url: "" + orgId
        });

        if (!checkIsShowAll()) {
            $("").val(curUsergh).trigger("").attr("", "").css("", "");
        }
        else {
            $("").removeAttr("").css("", "");
        }

        submit();
    }
</script>
<script type="">
    function checkIsShowAll() {
        if (isHospAdministrator && false) {
            return true;
        }
        //GRS非管理 可查看下级机构所有治疗师数据
        if (false && isHospAdministrator == "" && orgId != thisorgId) {
            return true;
        }
        var matchedCurZls = $.jsonWhere($("").find(''), function (v) {
            return $(v).attr('') == curUsergh;
        });
        if (!isHospAdministrator && matchedCurZls.length == 1) {
            //Hiện tại là không là nhà trị liệu Nhưng 不是HospAdministrator
            //仅查看自己的
            return false;
        }
        else {
            return true;
        }
    }
</script>
@Html.Partial("")
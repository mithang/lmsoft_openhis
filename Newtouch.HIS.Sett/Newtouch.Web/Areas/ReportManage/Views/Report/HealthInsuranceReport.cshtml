<script type="">
	var reportServerHOST = '';
    var organId = '';


 

	function submit() {
		if ($('').val().length == 0) {
			$.modalAlert("", "");
			return;
		}
		if ($('').val().length == 0) {
			$.modalAlert("", "");
			return;
		}
		if ($('').val() > $('').val()) {
			$.modalAlert("", "");
			return;
		}
		var url = getUrl();
		url += "" + organId;
		url += "" + $('').val();
		url += "" + $.getDate({ date: $('').val() }) + '';
		//url += "" + $('').val();
		//url += "" + $('').val();
		//url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $('').val();
        var dj = $('').val();
        if (dj=="") {
          dj = 0;

        }
  

        url += "" + dj;
        var bq = $('').val();
        if (bq == null) {
       
            url += "" +"";
        } else {
            url += "" + $('').val();
        } 
		url += "" + $('').val();
        setTimeout("", 10);
        $("").attr('', url);
    }

    $("").load(function () {
        $.loading(false);
	});

    $(function () {
        var h = $(window).height() - 65
        $('').css('', h);
		init();
    });
    $("").bindSelect({
        url: "",
    });

    $("").change(function () {
        $("").trigger('');
    });
    //Làm mới danh sách
    function refReport() {
        $("").trigger('');
    }

    function getUrl() {
        var reportServerHOST = '';
        reportServerHOST += "";
        console.log(reportServerHOST);
		//ReportServer/Pages/ReportViewer.aspx?%2fHIS.Report.1%2f医院垫支明细&rs:Command=Render
        //Lấy kiểu tùy chỉnh
        if (true) {
            if (reportServerHOST.indexOf('') == -1) {
                reportServerHOST += "";
            }
        }
        return reportServerHOST;
    }
</script>


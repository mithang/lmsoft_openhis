<div class="rows">
	<div class="panel panel-default">
		<table class="form">
			<tr>
				<th class="formTitle">Tra cứu loại：</th>
				<td class="formValue">
					<select id="tjfw" class="form-control">
						<option value="Ngoại trú">Ngoại trú</option>

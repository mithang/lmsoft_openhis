    <div class="dv-right">
        <iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
                scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
    </div>
    </div>


    <script>
	 var isHospAdministrator = '';
    var curUserCode = '';
    var OrgId = '';
	var reportServerHOST = '';
        var rightWidth = $("", parent.document).width() - $("").width() - 60;
        $("").width(rightWidth);
        $(function () {
            submit();
            gridList("");
        });
        function qingchu() {
            // Lấy dòng đã chọn tất cảid
            var jqGridRowid = $("").jqGrid("", "");
            for (var i = 0; i < jqGridRowid.length; i++) {
                $("").setSelection(jqGridRowid[i], false);
                i--;
            }
            xzstr = "";
        }
        function sfxmsx() {
            $("").jqGrid('', {
                postData: { xzstr: "", py: $("").val() },
            }).trigger('');
        }
        var xzstr = "";
        function guolv() {
            $("").val("");
            if (xzstr == "") {
                if ($("").val() != "") {
                    $("").jqGrid('', {
                        postData: { xzstr: "", py: $("").val(), sfdl: $("").val()  },
                    }).trigger('');
                } else {
                    $("").jqGrid('', {
                        postData: { xzstr: "", py: $("").val() },
                    }).trigger('');
                }
            } else {
                $("").jqGrid('', {
                    postData: { xzstr: xzstr, py: $("").val(), sfdl: $("").val()  },
                }).trigger('');
            }
        }
        function huifu() {
            $("").val("");
            $("").jqGrid('', {
                postData: { xzstr: "", py: "", sfdl: ""},
            }).trigger('');
        }
        function selsfdl() {
            if ($("").val() == "") {
                xzstr = "";
                $("").click();
            } else {
                $("").click();
            }
            //$("").jqGrid('', {
            //    postData: { xzstr: xzstr, py: $("").val(), sfdl: $("").val()  },
            //}).trigger('');
        }
        function gridList(strdata) {
            var $gridList = $("");
            $gridList.dataGrid({
                postData: { xzstr: strdata, sfdl: $("").val() },
                url: "",
                height: $(window).height() - 210,
                colModel: [
                    { label: '', name: '', align: '', width: 30, hidden: true, key: true },
                    { label: '', name: '', align: '', width: 100 },
                    { label: '', name: '', align: '', width: 30 },
                    { label: '', name: '', align: '', width: 30 },
                ],
                rowNum:50,
                viewrecords: true,
                multiselect: true,
                pager: "",
                sortname: '',
                viewrecords: true,
                beforeSelectRow: function (rowIndex, s) {
                    if (xzstr.indexOf(rowIndex) != -1) {
                        xzstr = xzstr.replace(rowIndex + "", "");
                    } else {
                        xzstr += rowIndex + "";
                    }
                },
                //当表格所有数据都加载完成而且其他的处理也都完成时触发此事件，Sắp xếp，翻页同样也会触发此事件
                gridComplete: function () {
                    //if ($("").val() != "") {
                    //    var ids = new Array();
                    //    //getDataIDs()Trả về hiện tạigriddữ liệu tất cả trongid
                    //    ids = $("" + this.id).getDataIDs();
                    //    //选择或反选指定行。NếuonselectrowChoture则会触发事件onSelectRow，onselectrowMặc định làture
                    //    $.each(ids, function () {
                    //        //$("").setSelection(this, true);
                    //        xzstr += this + "";
                    //    })
                        
                    //}
                    if ($("").prop("")==true) {
                        var ids = new Array();
                        //getDataIDs()Trả về hiện tạigriddữ liệu tất cả trongid
                        ids = $("" + this.id).getDataIDs();
                        xzstr = "";
                        //选择或反选指定行。NếuonselectrowChoture则会触发事件onSelectRow，onselectrowMặc định làture
                        $.each(ids, function () {
                            $("").setSelection(this, true);
                            xzstr += this + "";
                        });
                    }
                    if ($("").prop("") == true) {
                        $.each(xzstr.split(''), function () {
                            if (this != null && this != "") {
                                $("").setSelection(this, true);
                            }
                        });
                    }
                }

            });
        }
	//大类名称绑定下拉框
	$("").bindSelect({
		id: "",
		text: "",
		url: "",
		dropdownAutoWidth: true
	});

	$("").bindSelect({
		id: "",
		text: "",
		url: "" + OrgId,
		dropdownAutoWidth: true
	});
	//$('').sfxmFloatingSelector({
	//	djDecimalPlaces: 4,
	//	searchType: "",
	//	leftshift: 150, //Lệch trái tổng thể
	//	ajaxparameters: function ($thisinput) {
	//		return "" + $.trim($thisinput.val());
	//	},
	//	itemdbclickhandler: function ($thistr) {
	//		$('').val($thistr.attr(''));
	//		$("").attr("", $thistr.find("").html());
	//	}
	//});

	function submit() {
		if ($('').val().length == 0 || $('').val().length == 0) {
			$.modalAlert("", "");
			return;
		}
		var url = getUrl();
		$("").attr('', url);
	}

	$("").load(function () {
		$.loading(false);
	});

	$(function () {
        var h = $(window).height() - 90
		$('').css('', h);

	});
	 //Làm mới danh sách
    function refReport() {
        $("").trigger('');
    }

    function getUrl() {
        var srcUrl2 = '' + "" + "" + '' + "" + OrgId + "" + $('').val() + "" + $('').val() + "" + $('').val() + "" + $('').val() + "" + $('').val() + "" + xzstr;
            return srcUrl2;
    }

    </script>


@{
    ViewBag.Title = "";
    Layout = "";
}

<form id="form1">
    <div style="padding-top: 20px; margin-right: 55px;">
        <table class="form">
            <tr>
                <th class="formTitle">Tháng：</th>
                <td class="formValue">
                    <label id="lblYearMonth"></label>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Chi phí：</th>
                <td class="formValue">
                    <label id="lblCalcZje"></label>
                </td>
            </tr>
            <tr>
                <th class="formTitle">补差调整：</th>
                <td class="formValue">
                    <input id="balance" type="text" class="form-control" placeholder="调整金额" />
                </td>
            </tr>
            <tr>
                <th class="formTitle" valign="top" style="padding-top: 5px;">
                    调整原因：
                </th>
                <td class="formValue">
                    <textarea id="balanceReason" class="form-control" style="height: 60px;"></textarea>
                </td>
            </tr>
            <tr>
                <th class="formTitle">费用合计：</th>
                <td class="formValue">
                    <label id="lblResultZje"></label>
                </td>
            </tr>
        </table>
    </div>
</form>

<script type="">
    var year = $.request("");
    var month = $.request("");
    var calcZje = $.request("");
    var isregenerate = $.request(""); //Lại tạo Cờ

    $('').html(year + '' + $.zeroPrefixInteger(month, 2));
    $('').html(parseFloat(calcZje).toFixed(2));
    $('').html(parseFloat(calcZje).toFixed(2));

    $('').keyup(function () {
        //重新计算合计
        var tzje = $('').val();
        if (tzje) {
            if (isNaN(parseFloat(tzje))) {
                $('').html(parseFloat(calcZje).toFixed(2));
            }
            else {
                $('').html((parseFloat(calcZje) + parseFloat(tzje)).toFixed(2));
            }
        }
        else {
            $('').html(parseFloat(calcZje).toFixed(2));
        }
    });

    //
    function submitMonthReport() {
        var balance = $('').val();
        var balanceReason = $('').val();
        var resultZje = $('').html();
        var details = $.currentWindow().details;
        if (!year || !month) {
            $.modalAlert("", '');
            return;
        }
        if (!calcZje || !resultZje) {
            $.modalAlert("", '');
            return;
        }
        if (!isNaN(parseFloat(resultZje)) && parseFloat(resultZje) <= 0) {
            $.modalAlert("", '');
            return;
        }
        if (!balanceReason && balance) {
            $.modalAlert("", '');
            return;
        }
        if (!details || !details.length || details.length == 0) {
            $.modalAlert("", '');
            return;
        }
        $.submitForm({
            url: '',
            param: {
                year: year, month: month, calcZje: calcZje, balance: balance, balanceReason: balanceReason
                , resultZje: resultZje, details: details, isregenerate: isregenerate
            },
            success: function (ajaxresp) {
                $.currentWindow().$('').trigger('');
            }
        });
    }

</script>
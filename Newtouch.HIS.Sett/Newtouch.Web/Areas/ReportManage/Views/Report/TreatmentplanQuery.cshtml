@{
    ViewBag.Title = "";
    Layout = "";
    //Liên kết báo cáo
    var reportUrl = SysConfigReader.OrgReportLink();
}

<div class="rows">
    <div class="panel panel-default">
        <table class="form">
            <tr>
                <th class="formTitle">Ngày bắt đầu：</th>
                <td class="formValue">
                    <input id="kssj" type="text" class="form-control input-wdatepicker form-an" style="width: 140px;"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss'})" value="@(DateTime.Now.ToString("yyyy-MM-01 00:00:00"))" />
                </td>
                <th class="formTitle" style="padding-right:5px;">Ngày kết thúc：</th>
                <td class="formValue">
                    <input id="jssj" type="text" class="form-control input-wdatepicker form-an" style="width:140px"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" value="@(DateTime.Now.ToString("yyyy-MM-dd 23:59:59"))" />
                </td>
                <th class="formTitle"><label id="mzzylab">Số nhập viện/Số ngoại trú：</label></th>
                <td class="formValue">
                    <input id="zyh" name="zyh" type="text" class="form-control" />
                    <input id="mzh" name="mzh" type="text" class="form-control" style="display:none;" />
                </td>
                <th class="formTitle">Nhập viện/Ngoại trú：</th>
                <td class="formValue">
                    <select id="mzorzy" onchange="panduan()" class="form-control" >
                        <option value="">Vui lòng chọn</option>
                        <option value="mz">Ngoại trú</option>
                        <option value="zy" checked="checked">Nhập viện</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Thực hiện bác sĩ：</th>
                <td class="formValue"><input type="text" id="doctormc" name="doctormc" class="form-control form-an" /></td>
                <th class="formTitle">Khoa thực hiện：</th>
                <td class="formValue">
                    <input type="text" id="jzks" class="form-control formClearIgnore" />
                </td>
                <th class="formTitle">Hạng mục：</th>
                <td class="formValue"><input type="text" id="sfxmmc" class="form-control formClearIgnore" /></td>
                <th class="formTitle"></th>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
            </tr>
        </table>
    </div>
    <input type="text" id="zxys" hidden="hidden" />
</div>

<div class="ui-layout" id="layout" style="height:100%;width:100%;">
    <iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
            scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
</div>

<script type="">
    function panduan() {
        if ($('').val() == "") {
            $('').text("");
            $('').css("", "");
            $('').css("", "");
            $('').val("");
        }
        else if ($('').val() == "") {
            $('').text("");
            $('').css("", "");
            $('').css("", "");
            $('').val("");
        }
    }
   
    //Liên kết lớp nổi chọn hạng mục điều trị
    $('').newtouchBatchFloatingSelector({
        width: 500,
        height: 200,
        caption: "",
        clickautotrigger: true,
        url: "",
        ajaxparameters: function ($thisinput) {
            var keyword = $thisinput.val().trim();
            var zyh = $("").val();
            return "" + zyh;
        },
        itemdbclickhandler: function ($thistr, $thisinput) {
            if (!!$thistr.attr('')) {
                if ($thistr.attr('') !== "" && $thistr.attr('') !== undefined && $thistr.attr('') !== null) {
                    $('').val($.getDate({ date: $thistr.attr('') }));
                }
                if ($thistr.attr('') !== "" && $thistr.attr('') !== undefined && $thistr.attr('') !== null) {
                    $('').val($.getDate({ date: $thistr.attr('') }));
                } else {
                    $('').val($.getDate());
                }
                $('').val($thistr.attr(''));
            }
        },
        colModel: [
            { label: '', name: '', width: 100 },
            { label: '', name: '', hidden: true },
            { label: '', name: '', hidden: true },
            { label: '', name: '', width: 100, align: '' },
            { label: '', name: '', width: 120, align: '' },
            { label: '', name: '', hidden: true, width: 100, align: '' },
            {
                label: '', name: '', width: 50, align: '', formatter: function (cellvalue) {
                    return $.getGender(cellvalue);
                }
            },
            {
                label: '', name: '', width: 50, align: '', formatter: function (cellvalue, a, b) {
                    return getAgeFromBirthTime({ begin: b.csny }).text;
                }
            }
        ]
    });
   //Liên kết lớp nổi chọn hạng mục điều trị
    $('').sfxmFloatingSelector({
        djDecimalPlaces: 4,
        searchType: "",
        leftshift: 150, //Lệch trái tổng thể
        ajaxparameters: function ($thisinput) {
            return "" + $.trim($thisinput.val());
        },
        itemdbclickhandler: function ($thistr) {
            $('').val($thistr.attr(''));
            $("").attr("", $thistr.find("").html());
        }
    });

    $('').newtouchFloatingSelector({
            width: 400,
            height: 180,
            caption: "",
            clickautotrigger: true,
            url: '',
            ajaxmethod: '',
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = '';
                return reqData;
            },
            itemdbclickhandler: function ($thistr) {
                $('').attr('', $thistr.attr(''))
                    .val($thistr.attr(''));
            },
            colModel: [{ label: '', name: '', widthratio: 30 },
                { label: '', name: '', widthratio: 30 },
                { label: '', name: '', widthratio: 30 }
            ]
        });
    $("").newtouchFloatingSelector({
        height: 200,
        width: 300,
        clickautotrigger: true,
        filter: function (keyword) {
            //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
            var resultObjArr = new Array();
            $.each(top.window.clients.sysStaffDutyList, function (idx, val) {
                if (((val.StaffPY && val.StaffPY.toLowerCase().indexOf(keyword.toLowerCase()) >= 0)
                    || (val.StaffName && val.StaffName.indexOf(keyword.toLowerCase()) >= 0)
                    || keyword.trim() == "")
                    && val.DutyCode == "") {
                    resultObjArr.push(val);
                }
            });
            return resultObjArr;

        },
        caption: "",
        colModel: [
            {
                label: '', name: '', widthratio: 25
            },
            {
                label: '', name: '', widthratio: 25
            },
            { label: '', name: '', widthratio: 25 }
        ],
        itemdbclickhandler: function ($thistr) {
            $("").attr("", $thistr.find("").html());
            $("").val($thistr.find('').html());
            return;
        }
    });
    

    function submit() {
        if ($('').val()=="") {
            $.modalAlert("", "");
            return;
        }
        
        if ($('').val().length == 0) {
            $.modalAlert("", "");
            return;
        }
        if ($('').val().length == 0) {
            $.modalAlert("", "");
            return;
        }
        if ($('').val() > $('').val()) {
            $.modalAlert("", "");
            return;
        }
        var zxys = "";
        var zxks = "";
        var zlxm = "";
        if ($("").val() != null && $("").val() != "") {
             zxys = $("").attr("");
        }
        if ($("").val() != null && $("").val() != "") {
            zxks = $("").attr("");
        }
        if ($("").val() != null && $("").val() != "") {
            zlxm = $("").attr("");
        }
        var url = getUrl($('').val());
        if ($('').val() == "") {
            url += "" + $('').val() + "" + $('').val() + "" + $('').val() + "" + zxks + "" + zxys + "" + zlxm;
        }
        else {
            url += "" + $('').val() + "" + $('').val() + "" + $('').val() + "" + zxks + "" + zxys + "" + zlxm;
        }
        setTimeout("", 10);
        $("").attr('', url);
    }

    $("").load(function () {
        $.loading(false);
    });

    $(function () {
        var h = $(window).height() - 55
        $('').css('', h);
        init();
    });

    //Làm mới danh sách
    function refReport() {
        $("").trigger('');
    }

    function getUrl(mzorzy) {
        var reportServerHOST = '';
        if (mzorzy == "") {
            reportServerHOST += ""
        }
        else {
            reportServerHOST += ""
        }
        //Lấy kiểu tùy chỉnh
        if (true) {
            if (reportServerHOST.indexOf('') == -1) {
                reportServerHOST += "";
            }
        }

        return reportServerHOST;
    }

</script>

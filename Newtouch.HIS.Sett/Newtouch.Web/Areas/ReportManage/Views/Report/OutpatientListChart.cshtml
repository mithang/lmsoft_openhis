<script type="">
    var reportServerHOST = '';
    var orgId = '';
    var isHospAdministrator = '';
    var curUserCode = '';
    var uri = '';



    function submit() {

        if ($('').val().length == 0) {
            $.modalAlert("", "");
            return;
        }
        if ($('').val().length == 0) {
            $.modalAlert("", "");
            return;
        }
        if ($('').val() > $('').val()) {
            $.modalAlert("", "");
            return;
        }
        var url = getUrl();

        url += "" + $('').val();
        url += "" + $('').val();
        var patid;
        if ($("").attr("") != undefined && $("").attr("").length != 0 && $("").val() != "") {
            patid = $("").attr("");
        } else {
            patid = "";
        }
        url += "" + patid;

        var tjr;
        if ($('').val() != "") {
            tjr = $('').val();
        } else {
            tjr = "";
        }
        url += "" + tjr;
        setTimeout("", 10);
        $("").attr('', url);
    }

    $("").load(function () {
        $.loading(false);
    });

    $(function () {
        var h = $(window).height() - 55
        $('').css('', h);

        //Liên kết lớp nổi chọn hạng mục điều trị
        $('').newtouchBatchFloatingSelector({
            width: 500,
            height: 200,
            caption: "",
            clickautotrigger: true,
            url: "",
            ajaxparameters: function ($thisinput) {
                var keyword = $thisinput.val().trim();
                var orgId = $("").val();
                return "" + keyword + "" + orgId;
            },
            itemdbclickhandler: function ($thistr, $thisinput) {
                if (!!$thistr.attr('')) {
                    $("").val($thistr.attr(''));
                    $("").attr("", $thistr.attr(''));
                }
            },
            colModel: [
                 { label: '', name: '', hidden: true },
                 { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 120, align: '' },
                 { label: '', name: '', hidden: true, width: 100, align: '' },
                 {
                     label: '', name: '', width: 70, align: '', formatter: function (cellvalue) {
                         return $.getGender(cellvalue);
                     }
                 },
                  {
                      label: '', name: '', width: 100, align: '', formatter: function (cellvalue, a, b) {
                          return getAgeFromBirthTime({ begin: b.csny }).text;
                      }
                  },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true }
            ]
        });
        setTimeout(function () { submit(); }, 100);
    });

    function getUrl() {
        if (uri.StartWith('')) {
            uri = uri.substr(1);
        }
        var srcUrl = uri;
        srcUrl = reportServerHOST + srcUrl;

        //Lấy kiểu tùy chỉnh
        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
        }
        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
            else {
                srcUrl += "";
            }
            srcUrl += "";
            srcUrl += orgId;
        }

        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
            else {
                srcUrl += "";
            }
            srcUrl += "";
            srcUrl += curUserCode;
        }

        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
            else {
                srcUrl += "";
            }
            srcUrl += "";
            srcUrl += isHospAdministrator;
        }

        return srcUrl;
    }

</script>
<script type="">
    function funcOrganizeIdChange() {
        orgId = $("").val();
    }
</script>

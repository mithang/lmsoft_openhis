    function getUrl() {
        var ksrq = $("").val() + "";
        var jsrq = $("").val() + "";
        var ks = $("").val() != "" ? $("").attr("") : "";
        var srcUrl2 = '' + "" + "" + '' + "" + '' + "" + ksrq + "" + jsrq + "" + ks;
        return srcUrl2;
    }

</script>

<script type="">
    function init() {
        //Người thao tác
        $("").click(function () {
            $.modalOpen({
                id: "",
                title: "",
                url: "" + orgId + "",
                width: "",
                height: "",
                callBack: function (iframeId) {
                    top.frames[iframeId].AcceptClick(function (data) {
                        userStaffTreeCallback(data);
                    });
                }
            });
        });
        //Phương thức callback cây nhân viên người dùng
        function userStaffTreeCallback(data) {
            $("").val(data[0].Code);
        }

    }
    var kszdlist;
    $.ajax({
        type: "",
        url: "",
        dataType: "",
        async: false,
        success: function (data) {
            kszdlist = data;

        }
    });
    //Khoa
    $("").newtouchBatchFloatingSelector({
        height: 200,
        width: 300,
        clickautotrigger: true,
        //url: '',
        filter: function (keyword) {
            //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
            var resultObjArr = new Array();
            $.each(kszdlist, function (idx, val) {
                if ((val.py && val.py.toLowerCase().indexOf(keyword) >= 0)
                    || (val.Name && val.Name.indexOf(keyword) >= 0)
                    || keyword.trim() == "") {
                    resultObjArr.push(val);
                }
            });
            return resultObjArr;

        },
        caption: "",
        colModel: [
            { label: '', name: '', widthratio: 30 },
            { label: '', name: '', widthratio: 50 },
            { label: '', name: '', hidden: true }
        ],
        itemdbclickhandler: function ($thistr) {
            $("").attr("", $thistr.find("").html());
            $("").val($thistr.find('').html());
            return;
        },
    });
</script>


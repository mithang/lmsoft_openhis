
@{
    ViewBag.Title = "";
    Layout = "";
}
<script src=""~/js/highcharts/highcharts.js""></script>
<script src=""~/js/highcharts/modules/exporting.js""></script>
<style type="text/css">
    #perIndicatortable {
        width: 100%;
        text-align: center;
        border-spacing: 1px;
        background-color: white;
        border: 1px solid;
    }

        #perIndicatortable th, #perIndicatortable td {
            text-align: center;
            height: 30px;
            border: 1px solid;
        }
</style>
<table class="form">
    <tr>
        <th class="formTitle">Năm</th>
        <td class="formValue">
            <input id="year" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("yyyy")" onfocus="WdatePicker({ dateFmt: 'yyyy', onpicking: dateChange})" />
        </td>
        <td colspan="4"></td>
    </tr>
</table>
<div id="container" style="min-width: 310px; height: 400px; margin: 0 auto"></div>
<input class="form-control btn btn-default" id="reset" type="button" value="Đặt lại" style="width: 50px;height: 25px;position: relative;top: -45px;right: -1050px;display:none">
<table id="perIndicatortable" cellspacing="10">
    <thead>
        <tr>
            <th id="thyear"></th>
            <th>Jan</th>
            <th>Feb</th>
            <th>Mar</th>
            <th>Apr</th>
            <th>May</th>
            <th>Jun</th>
            <th>Jul</th>
            <th>Aug</th>
            <th>Sep</th>
            <th>Oct</th>
            <th>Nov</th>
            <th>Dec</th>
        </tr>
    </thead>
    <tbody id="tbody"></tbody>
</table>

<script>
    var perIndicatorObj = [];
    for (i = 0; i < 12; i++) {
        perIndicatorObj.push({ zrc: 0, pjrc: 0 });
    }
    function aaaaaa(orgId, year) {
        if (orgId == "") {
            perIndicatorObj = [];
            for (i = 0; i < 12; i++) {
                perIndicatorObj.push({ zrc: 0, pjrc: 0 });
            }
            ShowChart();
            $.modalAlert("", '');
            return;
        }
        $.ajax({
            url: "" + Math.random() + "" + orgId + "" + year,
            dataType: "",
            async: false,
            success: function (data) {
                if (data) {
                    perIndicatorObj = data;
                }
            }
        });
    }

    //Yêu cầu
    aaaaaa($('').val(), $('').val());
    //图表
    ShowChart();

    function dateChange(dp) {
        var year = dp.cal.getNewDateStr();
        //Yêu cầu
        aaaaaa($('').val(), year);
        //图表
        ShowChart();
    }

    function ShowChart() {
        $('').highcharts({
            credits: { enabled: false },
            chart: {
                zoomType: ''
            },
            title: {
                text: ''
            },
            subtitle: {
                text: ''
            },
            xAxis: [{
                categories: ['', '', '', '', '', '',
                    '', '', '', '', '', ''],
                crosshair: true,
            }],
            yAxis: [{ // Primary yAxis
                crosshair: true,
                labels: {
                    format: '',   //Tổng lượt người
                    style: {
                        color: Highcharts.getOptions().colors[1]
                    }
                },
                title: {
                    text: '',
                    style: {
                        color: Highcharts.getOptions().colors[1]
                    }
                }
            }, { // Secondary yAxis
                title: {
                    text: '',
                    style: {
                        color: Highcharts.getOptions().colors[1]
                    }
                },
                labels: {
                    format: '',   //Lượt người bình quân
                    style: {
                        color: Highcharts.getOptions().colors[1]
                    }
                },
                opposite: true
            }],
            tooltip: {
                shared: true,
                animation: true,
                shadow: true,
            },
            legend: {
                //layout: '',
                //align: '',
                //x: 120,
                //verticalAlign: '',
                //y: 100,
                //floating: true,
                //backgroundColor: (Highcharts.theme && Highcharts.theme.legendBackgroundColor) || ''
                align: '',
                verticalAlign: '',
                x: 0,
                y: 0
            },
            series: [{
                name: '',  //Tổng lượt người
                type: '',
                color: Highcharts.getOptions().colors[0],
                data: [perIndicatorObj[0].zrc, perIndicatorObj[1].zrc, perIndicatorObj[2].zrc, perIndicatorObj[3].zrc, perIndicatorObj[4].zrc, perIndicatorObj[5].zrc, perIndicatorObj[6].zrc, perIndicatorObj[7].zrc, perIndicatorObj[8].zrc, perIndicatorObj[9].zrc, perIndicatorObj[10].zrc, perIndicatorObj[11].zrc],
                tooltip: {
                    valueSuffix: '' //Đơn vị
                },
                events: {
                    click: function (e) {
                        //$('').css("", "");
                        //$('').css("", "");
                        $('').css("", "");
                        LoadMonthChart(e.point.x);
                    }
                }
            },
            {
                name: '',   //Lượt người bình quân
                type: '',
                color: Highcharts.getOptions().colors[6],
                yAxis: 1,
                data: [perIndicatorObj[0].pjrc, perIndicatorObj[1].pjrc, perIndicatorObj[2].pjrc, perIndicatorObj[3].pjrc, perIndicatorObj[4].pjrc, perIndicatorObj[5].pjrc, perIndicatorObj[6].pjrc, perIndicatorObj[7].pjrc, perIndicatorObj[8].pjrc, perIndicatorObj[9].pjrc, perIndicatorObj[10].pjrc, perIndicatorObj[11].pjrc],
                tooltip: {
                    valueSuffix: '' //Đơn vị
                },
                events: {
                    click: function (e) {
                        //$('').css("", "");
                        //$('').css("", "");
                        $('').css("", "");
                        LoadMonthChart(e.point.x);
                    }
                }
            }],

        });
        if ($('').html()) {
            $('').remove();
        }
        if ($('').html()) {
            $('').remove();
        }
        $('').html($('').val());
        var str = "";
        for (i = 0; i < 12; i++) {
            str += "" + perIndicatorObj[i].zrc + "";
        }
        str += "";
        $('').append(str);

        var str = "";
        for (i = 0; i < 12; i++) {
            str += "" + perIndicatorObj[i].pjrc + "";
        }
        str += "";
        $('').append(str);

    }

    function LoadMonthChart(month) {
        month++;
        var orgId = $('').val();
        var year = $('').val();
        if (orgId == "") {
            $.modalAlert("", '');
            return;
        }
        $.ajax({
            url: "" + Math.random() + "" + orgId + "" + year + "" + month,
            dataType: "",
            async: false,
            success: function (data) {
                if (data != null && data != null) {
                    GetMonthNumChart(data, month);
                }
            }
        });
    }

    function GetMonthNumChart(data, month) {
        var rtnobj = mGetDate(data, month);
        $('').highcharts({
            credits: { enabled: false },
            chart: {
                zoomType: ''
            },
            title: {
                text: ''
            },
            subtitle: {
                text: new Date().getFullYear() + '' + month + ""
            },
            xAxis: [{
                categories: rtnobj.str,
                crosshair: true,
            }],
            yAxis: [{ // Primary yAxis
                crosshair: true,
                labels: {
                    format: '',   //Tổng lượt người
                    style: {
                        color: Highcharts.getOptions().colors[1]
                    }
                },
                title: {
                    text: '',
                    style: {
                        color: Highcharts.getOptions().colors[1]
                    }
                }
            }, { // Secondary yAxis
                title: {
                    text: '',
                    style: {
                        color: Highcharts.getOptions().colors[1]
                    }
                },
                labels: {
                    format: '',   //Lượt người bình quân
                    style: {
                        color: Highcharts.getOptions().colors[1]
                    }
                },
                opposite: true
            }],
            tooltip: {
                shared: true,
                animation: true,
                shadow: true,
            },
            legend: {
                align: '',
                verticalAlign: '',
                x: 0,
                y: 0
            },
            series: [{
                name: '',  //Tổng lượt người
                type: '',
                color: Highcharts.getOptions().colors[0],
                data: rtnobj.zrc,
                tooltip: {
                    valueSuffix: '' //Đơn vị
                }
            },
            {
                name: '',   //Lượt người bình quân
                type: '',
                color: Highcharts.getOptions().colors[6],
                yAxis: 1,
                data: rtnobj.pjrc,
                tooltip: {
                    valueSuffix: '' //Đơn vị
                }
            }],

        });
        if ($('').html()) {
            $('').remove();
        }
        if ($('').html()) {
            $('').remove();
        }
        $('').html($('').val());
        var str = "";
        for (i = 0; i < 12; i++) {
            str += "" + perIndicatorObj[i].zrc + "";
        }
        str += "";
        $('').append(str);

        var str = "";
        for (i = 0; i < 12; i++) {
            str += "" + perIndicatorObj[i].pjrc + "";
        }
        str += "";
        $('').append(str);
    }

    var weekday = new Array(7)
    weekday[0] = ""
    weekday[1] = ""
    weekday[2] = ""
    weekday[3] = ""
    weekday[4] = ""
    weekday[5] = ""
    weekday[6] = ""

    function mGetDate(data, month) {
        var rtnobj = {};
        rtnobj.str = [];
        rtnobj.pjrc = [];
        rtnobj.zrc = [];
        var date = new Date();
        var year = date.getFullYear();
        var d = new Date(year, month, 0);
        var d = d.getDate();
        var currentdate = year + '' + (month < 10 ? ('' + month) : month);
        for (var i = 1; i < (d + 1); i++) {
            var currenttime = currentdate + '' + (i < 10 ? ('' + i) : i);
            rtnobj.str.push(i + "" + weekday[new Date(currenttime).getDay()]);
            var isPush = false;
            $.each(data, function (i, v) {
                if (v.col == currenttime) {
                    rtnobj.pjrc.push(v.pjrc);
                    rtnobj.zrc.push(v.zrc);
                    isPush = true;
                }
            });
            if (!isPush) {
                rtnobj.pjrc.push(0);
                rtnobj.zrc.push(0);
            }
        }
        return rtnobj;
    }

    $('').click(function () {
        //$('').css("", "");
        //$('').css("", "");
        $('').css("", "");
        aaaaaa($('').val(), $('').val());
        ShowChart();
    });
</script>

<script type="">
    function funcOrganizeIdChange() {
        //Yêu cầu
        aaaaaa($('').val(), $('').val());
        //图表
        ShowChart();

    }
</script>
@Html.Partial("")
@{
    ViewBag.Title = "Theo dõi thuốc";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<head>
    <meta charset="utf-8">
    <style>
        .bk {
            border-radius: 5px;
            background-color: white;
        }
        .down_border {
            border-bottom: 1px solid #e6e6e6;
        }
        .ui-jqgrid .ui-jqgrid-bdiv {
            overflow-x: hidden;
        }
    </style>
</head>

<div class="panel panel-default">
    <input type="hidden" id="kssj" />
    <input type="hidden" id="jssj" />
    <table class="form">
        <tr>
            <th class="formTitle" id="xzsjtext">Loại：</th>
            <td class="formValue" style="width:150px">
                <select id="dateType" class="form-control" onchange="updateSjType()">
                    <option value="1">Năm</option>
                    <option value="2">Tháng</option>
                    <option value="3">Ngày</option>
                </select>
            </td>
            <th class="formTitle" id="xzsjtext">Thời gian：</th>
            <td class="formValue" style="width:150px">
                <input id="rSJ" type="text" class="form-control input-wdatepicker" @*onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"*@>
            </td>

            <td class="formValue" style="padding-left:20px;">
                <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
            </td>

        </tr>
    </table>
</div>

<div id="main_div" style="display:flex;flex-wrap:wrap;align-content:space-between;">

    <div style="display:flex;flex-direction:row;height:37%;width:100%;justify-content:space-between;">

        <div class="bk" style="width:49.5%;height:100%">
            <div class="panel-heading down_border">
                <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>Xếp hạng khối lượng công việc bác sĩ ngoại trú
            </div>
            <table id="gridJSListmzysgzl"></table>
        </div>

        <div class="bk" style="width:49.5%;height:100%">
            <div class="panel-heading down_border">
                <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>Xếp hạng thu nhập khoa ngoại trú
            </div>
            <table id="gridJSListmzkssr"></table>
        </div>

    </div>

    <div style="width:100%;height:30%" class="bk">
        <div class="panel-heading down_border">
            <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>Xếp hạng khoa nghiệp vụ nội trú
        </div>
        <table id="gridJSListzyywks"></table>
    </div>

    <div style="width:100%;height:30%" class="bk">
        <div class="panel-heading down_border">
            <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>Xếp hạng nghiệp vụ bác sĩ
        </div>
        <table id="gridJSListysyw"></table>
    </div>

</div>

<script>
    var myDate = new Date();
    $(function () {

        $('#main_div').height($(window).height() - 60);
        init();
        gridJSListData();
    });

    function submit() {
        getSearchData();
        var kssj = $("#kssj").val();
        var jssj = $("#jssj").val();
        var $gridJSListmzysgzl = $("#gridJSListmzysgzl");
        $gridJSListmzysgzl.jqGrid('setGridParam', {
            postData: { kssj: kssj, jssj: jssj},
            url: '/DeanInquiryManage/BusinessRanking/GetMzysgzl',
            page: 1,
        }).trigger('reloadGrid');

        var $gridJSListmzkssr = $("#gridJSListmzkssr");
        $gridJSListmzkssr.jqGrid('setGridParam', {
            postData: { kssj: kssj, jssj: jssj },
            url: "/DeanInquiryManage/BusinessRanking/GetMzkssr",
            page: 1,
        }).trigger('reloadGrid');


        var $gridJSListzyywks = $("#gridJSListzyywks");
        $gridJSListzyywks.jqGrid('setGridParam', {
            postData: { kssj: kssj, jssj: jssj },
            url: "/DeanInquiryManage/BusinessRanking/GetZyywks",
            page: 1,
        }).trigger('reloadGrid');
    }
    function init() {
        $("#dateType").val("2");
        $('#rSJ').attr('onfocus', "WdatePicker({ dateFmt: 'yyyy-MM' })");
        $('#rSJ').val(myDate.getFullYear() + "-" + (parseInt(myDate.getMonth()) + 1));
        getSearchData();
    }
    function gridJSListData() {
        var kssj = $("#kssj").val();
        var jssj = $("#jssj").val();
        //var gridSort = 'mzl asc';
        var $gridJsList = $("#gridJSListmzysgzl");
        $gridJsList.dataGrid({
            height: 230,
            autowidth: true,//Nếu shrinkToFit là true và đã đặt width Giá trị，thì chiều rộng mỗi cột sẽ dựa theo width tỷ lệ để thu phóng；
            shrinkToFit: true, //Nếu đặt thành true，thì Grid chiều rộng sẽ tự động tính lại dựa theo chiều rộng của container cha。**
            url: "/DeanInquiryManage/BusinessRanking/GetMzysgzl",
            postData: { kssj: kssj, jssj: jssj },
            colModel: [
                { label: 'Bác sĩ', name: 'ys',  align: 'left' },
                { label: 'Khoa ngoại trú', name: 'mzks',align: 'left' },
                { label: 'Số lượng ngoại trú', name: 'mzl', align: 'left' }
            ],
            sortname: gridSort,
            viewrecords: true
        });

        //var gridSort = 'ypzb desc,mzsr desc';
        var $gridJsList = $("#gridJSListmzkssr");
        $gridJsList.dataGrid({
            height: 230,
            autowidth: true,//Nếu shrinkToFit là true và đã đặt width Giá trị，thì chiều rộng mỗi cột sẽ dựa theo width tỷ lệ để thu phóng；
            shrinkToFit: true, //Nếu đặt thành true，thì Grid chiều rộng sẽ tự động tính lại dựa theo chiều rộng của container cha。**
            url: "/DeanInquiryManage/BusinessRanking/GetMzkssr",
            postData: { kssj: kssj, jssj: jssj },
            colModel: [
                { label: 'Khoa ngoại trú', name: 'mzks',  align: 'center' },
                { label: 'Thu nhập ngoại trú', name: 'mzsr', align: 'left' },
                { label: 'Thu nhập thuốc', name: 'ypsr', align: 'left' },
                { label: 'Tỷ lệ thuốc', name: 'ypzb',align: 'left' }
            ],
            sortname: gridSort,
            viewrecords: true
        });

        var gridSort = 'CreateTime asc';
        var $gridJsList = $("#gridJSListzyywks");
        $gridJsList.dataGrid({
            height: 170,
            autowidth: true,//Nếu shrinkToFit là true và đã đặt width Giá trị，thì chiều rộng mỗi cột sẽ dựa theo width tỷ lệ để thu phóng；
            shrinkToFit: true, //Nếu đặt thành true，thì Grid chiều rộng sẽ tự động tính lại dựa theo chiều rộng của container cha。**
            url: "/DeanInquiryManage/BusinessRanking/GetZyywks",
            postData: { kssj: kssj, jssj: jssj },
            colModel: [
                { label: 'Khoa nội trú', name: 'zyks', align: 'center' },
                { label: 'bqCode', name: 'bqCode', align: 'center',hidden: true },
                { label: 'Số người xuất viện', name: 'cyrs', align: 'center' },
                { label: 'Số người nhập viện', name: 'ryrs', align: 'center' },
                { label: 'Số người phẫu thuật', name: 'ssrs', align: 'center' },
                { label: 'Tổng chi phí nội trú（ đồng）', name: 'zyzfy',align: 'center' },
                { label: 'Chi phí bình quân mỗi lượt', name: 'cjfy', align: 'center' },
                { label: 'Số ngày nội trú bình quân', name: 'pjzyts',align: 'center' }
            ],
            sortname: gridSort,
            viewrecords: true,
            onCellSelect : function (row) {
                var rowObj = $gridJsList.jqGrid('getRowData', row);
                var $gridysListys = $("#gridJSListysyw");
                $gridysListys.jqGrid('setGridParam', {
                    postData: { kssj: kssj, jssj: jssj, bqCode: rowObj.bqCode },
                    page: 1,
                    url: "/DeanInquiryManage/BusinessRanking/GetYsyw",
                }).trigger('reloadGrid');

            },
            loadComplete: function (data) {
                if (data.length > 0)
                {
                    var firstRow = data[0];
                    var $gridysListys = $("#gridJSListysyw");
                    $gridysListys.jqGrid('setGridParam', {
                        postData: { kssj: kssj, jssj: jssj, bqCode: firstRow.bqCode },
                        page: 1,
                        url: "/DeanInquiryManage/BusinessRanking/GetYsyw",
                    }).trigger('reloadGrid');
                }
            }
        });

        var gridSort = 'CreateTime asc';
        var $gridysListys = $("#gridJSListysyw");
        $gridysListys.dataGrid({
            height: 170,
            autowidth: true,//Nếu shrinkToFit là true và đã đặt width Giá trị，thì chiều rộng mỗi cột sẽ dựa theo width tỷ lệ để thu phóng；
            shrinkToFit: true, //Nếu đặt thành true，thì Grid chiều rộng sẽ tự động tính lại dựa theo chiều rộng của container cha。**
            url: "",
            colModel: [
                { label: 'Bác sĩ', name: 'ys', align: 'center' },
                { label: 'Số người xuất viện', name: 'cyrs', align: 'center' },
                { label: 'Số người nhập viện', name: 'ryrs', align: 'center' },
                { label: 'Số người phẫu thuật', name: 'ssrs', align: 'center' },
                { label: 'Tổng chi phí nội trú（ đồng）', name: 'zyzfy',align: 'center' },
                { label: 'Chi phí bình quân mỗi lượt', name: 'cjfy',align: 'center' },
                { label: 'Số ngày nội trú bình quân', name: 'pjzyts', align: 'center' }
            ],
            sortname: gridSort,
            viewrecords: true
        });

    }
    //Thay đổi loại thời gian
    function updateSjType() {
        $('#rSJ').val("");
        let dateType = $("#dateType").val();
        if (dateType == "1") {//Năm
            $('#rSJ').attr('onfocus', "WdatePicker({ dateFmt: 'yyyy' })");
            $('#rSJ').val(myDate.getFullYear());
        }
        if (dateType == "2") {//Tháng
            $('#rSJ').attr('onfocus', "WdatePicker({ dateFmt: 'yyyy-MM' })");
            $('#rSJ').val(myDate.getFullYear() + "-" + (parseInt(myDate.getMonth()) + 1));
        }
        if (dateType == "3") {//Ngày
            $('#rSJ').attr('onfocus', "WdatePicker({ dateFmt: 'yyyy-MM-dd' })");
            $('#rSJ').val(myDate.getFullYear() + "-" + (parseInt(myDate.getMonth()) + 1) + "-" + myDate.getDate());
        }
        getSearchData();
    }

    //Lắp ráp tham số yêu cầu
    function getSearchData() {
        let ksrq = '';
        let jsrq = '';
        let dateType = $("#dateType").val();
        let nowDate = $("#rSJ").val();
        if (dateType == "1") {//Năm
            ksrq = nowDate + "-" + "01-01 00:00:00";
            jsrq = nowDate + "-" + "12-31 23:59:59";
        }
        if (dateType == "2") {//Tháng
            let array = nowDate.split("-");
            ksrq = array[0] + "-" + array[1] + "-01 00:00:00";
            let days = getDaysInMonth(array[0], array[1]);
            jsrq = array[0] + "-" + array[1] + "-" + days + " 23:59:59";
        }
        if (dateType == "3") {//Ngày
            ksrq = nowDate + " 00:00:00";
            jsrq = nowDate + " 23:59:59";
        }

        $('#kssj').val(ksrq);
        $('#jssj').val(jsrq);
    }

    //Lấy số ngày trong tháng theo năm tháng
    function getDaysInMonth(year, month) {
        return new Date(year, month, 0).getDate();
    }
</script>

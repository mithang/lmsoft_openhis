@{
    ViewBag.Title = "";
    Layout = "";
}

<head>
    <meta charset="utf-8">
    <style>
        .bk {
            border-radius: 5px;
            background-color: white;
        }
        .down_border {
            border-bottom: 1px solid #e6e6e6;
        }
        .ui-jqgrid .ui-jqgrid-bdiv {
            overflow-x: hidden;
        }
    </style>
</head>

<div class="panel panel-default">
    <input type="hidden" id="kssj" />
    <input type="hidden" id="jssj" />
    <table class="form">
        <tr>
            <th class="formTitle" id="xzsjtext">Loại：</th>
            <td class="formValue" style="width:150px">
                <select id="dateType" class="form-control" onchange="updateSjType()">
                    <option value="1">Năm</option>
                    <option value="2">Tháng</option>
                    <option value="3">Ngày</option>
                </select>
            </td>
            <th class="formTitle" id="xzsjtext">Thời gian：</th>
            <td class="formValue" style="width:150px">
                <input id="rSJ" type="text" class="form-control input-wdatepicker" @*onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"*@>
            </td>

            <td class="formValue" style="padding-left:20px;">
                <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
            </td>

        </tr>
    </table>
</div>

<div id="main_div" style="display:flex;flex-wrap:wrap;align-content:space-between;">

    <div style="display:flex;flex-direction:row;height:37%;width:100%;justify-content:space-between;">

        <div class="bk" style="width:49.5%;height:100%">
            <div class="panel-heading down_border">
                <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>Xếp hạng khối lượng công việc bác sĩ ngoại trú
            </div>
            <table id="gridJSListmzysgzl"></table>
        </div>

        <div class="bk" style="width:49.5%;height:100%">
            <div class="panel-heading down_border">
                <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>Xếp hạng thu nhập khoa ngoại trú
            </div>
            <table id="gridJSListmzkssr"></table>
        </div>

    </div>

    <div style="width:100%;height:30%" class="bk">
        <div class="panel-heading down_border">
            <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>住院业务科室排名
        </div>
        <table id="gridJSListzyywks"></table>
    </div>

    <div style="width:100%;height:30%" class="bk">
        <div class="panel-heading down_border">
            <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>医生业务排名
        </div>
        <table id="gridJSListysyw"></table>
    </div>

</div>

<script>
    var myDate = new Date();
    $(function () {

        $('').height($(window).height() - 60);
        init();
        gridJSListData();
    });

    function submit() {
        getSearchData();
        var kssj = $("").val();
        var jssj = $("").val();
        var $gridJSListmzysgzl = $("");
        $gridJSListmzysgzl.jqGrid('', {
            postData: { kssj: kssj, jssj: jssj},
            url: '',
            page: 1,
        }).trigger('');

        var $gridJSListmzkssr = $("");
        $gridJSListmzkssr.jqGrid('', {
            postData: { kssj: kssj, jssj: jssj },
            url: "",
            page: 1,
        }).trigger('');


        var $gridJSListzyywks = $("");
        $gridJSListzyywks.jqGrid('', {
            postData: { kssj: kssj, jssj: jssj },
            url: "",
            page: 1,
        }).trigger('');
    }
    function init() {
        $("").val("");
        $('').attr('', "");
        $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1));
        getSearchData();
    }
    function gridJSListData() {
        var kssj = $("").val();
        var jssj = $("").val();
        //var gridSort = '';
        var $gridJsList = $("");
        $gridJsList.dataGrid({
            height: 230,
            autowidth: true,//NếushrinkToFitChotruevà đã thiết lậpwidthGiá trị，thì chiều rộng mỗi cột sẽ theowidththu phóng theo tỷ lệ；
            shrinkToFit: true, //Nếu đặt làtrue，ThìGridchiều rộng sẽ tự tính lại theo chiều rộng của vùng chứa cha。**
            url: "",
            postData: { kssj: kssj, jssj: jssj },
            colModel: [
                { label: '', name: '',  align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '', align: '' }
            ],
            sortname: gridSort,
            viewrecords: true
        });

        //var gridSort = '';
        var $gridJsList = $("");
        $gridJsList.dataGrid({
            height: 230,
            autowidth: true,//NếushrinkToFitChotruevà đã thiết lậpwidthGiá trị，thì chiều rộng mỗi cột sẽ theowidththu phóng theo tỷ lệ；
            shrinkToFit: true, //Nếu đặt làtrue，ThìGridchiều rộng sẽ tự tính lại theo chiều rộng của vùng chứa cha。**
            url: "",
            postData: { kssj: kssj, jssj: jssj },
            colModel: [
                { label: '', name: '',  align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '',align: '' }
            ],
            sortname: gridSort,
            viewrecords: true
        });

        var gridSort = '';
        var $gridJsList = $("");
        $gridJsList.dataGrid({
            height: 170,
            autowidth: true,//NếushrinkToFitChotruevà đã thiết lậpwidthGiá trị，thì chiều rộng mỗi cột sẽ theowidththu phóng theo tỷ lệ；
            shrinkToFit: true, //Nếu đặt làtrue，ThìGridchiều rộng sẽ tự tính lại theo chiều rộng của vùng chứa cha。**
            url: "",
            postData: { kssj: kssj, jssj: jssj },
            colModel: [
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '',hidden: true },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '',align: '' }
            ],
            sortname: gridSort,
            viewrecords: true,
            onCellSelect : function (row) {
                var rowObj = $gridJsList.jqGrid('', row);
                var $gridysListys = $("");
                $gridysListys.jqGrid('', {
                    postData: { kssj: kssj, jssj: jssj, bqCode: rowObj.bqCode },
                    page: 1,
                    url: "",
                }).trigger('');

            },
            loadComplete: function (data) {
                if (data.length > 0)
                {
                    var firstRow = data[0];
                    var $gridysListys = $("");
                    $gridysListys.jqGrid('', {
                        postData: { kssj: kssj, jssj: jssj, bqCode: firstRow.bqCode },
                        page: 1,
                        url: "",
                    }).trigger('');
                }
            }
        });

        var gridSort = '';
        var $gridysListys = $("");
        $gridysListys.dataGrid({
            height: 170,
            autowidth: true,//NếushrinkToFitChotruevà đã thiết lậpwidthGiá trị，thì chiều rộng mỗi cột sẽ theowidththu phóng theo tỷ lệ；
            shrinkToFit: true, //Nếu đặt làtrue，ThìGridchiều rộng sẽ tự tính lại theo chiều rộng của vùng chứa cha。**
            url: "",
            colModel: [
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '', align: '' }
            ],
            sortname: gridSort,
            viewrecords: true
        });

    }
    //Thay đổi loại thời gian
    function updateSjType() {
        $('').val("");
        let dateType = $("").val();
        if (dateType == "") {//Năm
            $('').attr('', "");
            $('').val(myDate.getFullYear());
        }
        if (dateType == "") {//Tháng
            $('').attr('', "");
            $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1));
        }
        if (dateType == "") {//Ngày
            $('').attr('', "");
            $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1) + "" + myDate.getDate());
        }
        getSearchData();
    }

    //Lắp ráp tham số yêu cầu
    function getSearchData() {
        let ksrq = '';
        let jsrq = '';
        let dateType = $("").val();
        let nowDate = $("").val();
        if (dateType == "") {//Năm
            ksrq = nowDate + "" + "";
            jsrq = nowDate + "" + "";
        }
        if (dateType == "") {//Tháng
            let array = nowDate.split("");
            ksrq = array[0] + "" + array[1] + "";
            let days = getDaysInMonth(array[0], array[1]);
            jsrq = array[0] + "" + array[1] + "" + days + "";
        }
        if (dateType == "") {//Ngày
            ksrq = nowDate + "";
            jsrq = nowDate + "";
        }

        $('').val(ksrq);
        $('').val(jsrq);
    }

    //Lấy số ngày trong tháng theo năm tháng
    function getDaysInMonth(year, month) {
        return new Date(year, month, 0).getDate();
    }
</script>

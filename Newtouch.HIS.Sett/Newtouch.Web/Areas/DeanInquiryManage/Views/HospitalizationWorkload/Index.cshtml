@{
    ViewBag.Title = "";
    Layout = "";
}
<head>
    <meta charset="utf-8">
    <script src=""></script>
    <style>

        .bk {
            border-radius: 10px;
            background-color: white;
        }

        .selectbtn {
            border: 0px;
            background-color: white;
        }
        .down_border {
            border-bottom: 1px solid #e6e6e6;
        }
        .ui-jqgrid .ui-jqgrid-bdiv {
            overflow-x: hidden;
        }
    </style>
</head>

<div class="panel panel-default">
    <input type="hidden" id="kssj" />
    <input type="hidden" id="jssj" />
    <table class="form">
        <tr>

            <th class="formTitle" id="xzsjtext">Loại：</th>
            <td class="formValue" style="width:150px">
                <select id="dateType" class="form-control" onchange="updateSjType()">
                    <option value="1">Năm</option>
                    <option value="2">Tháng</option>
                    <option value="3">Ngày</option>
                </select>
            </td>
            <th class="formTitle" id="xzsjtext">Thời gian：</th>
            <td class="formValue" style="width:150px">
                <input id="rSJ" type="text" class="form-control input-wdatepicker" @*onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"*@>
            </td>

            <td class="formValue" style="padding-left:20px;">
                <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
            </td>

        </tr>
    </table>
</div>
<div id="main_div" style="display:flex;flex-direction:column;justify-content:space-between;flex-wrap:wrap;">

    <div style="display:flex;flex-direction:row;justify-content:space-between;flex-wrap:wrap;height:50%">
        <div style="width:33%;display:flex;flex-direction:column" class="bk">
            <div class="panel-heading down_border">
                <i class="fa fa-area-chart fa-lg" style="margin-right:5px;"></i>Xuất viện xu hướng số người
            </div>
            <div id="main1" style="width:100%;height:100%;"></div>
        </div>
        <div style="width:33%;display:flex;flex-direction:column" class="bk">
            <div class="panel-heading down_border">
                <i class="fa fa-area-chart fa-lg" style="margin-right:5px;"></i>Xu hướng số người nhập viện
            </div>
            <div id="main2" style="width:100%;height:100%;"></div>
        </div>

        <div style="width:33%;display:flex;flex-direction:column" class="bk">
            <div class="panel-heading down_border">
                <i class="fa fa-area-chart fa-lg" style="margin-right:5px;"></i>Xu hướng số người chuyển viện
            </div>
            <div id="main3" style="width:100%;height:100%;"></div>
        </div>
    </div>

    <div style="display:flex;flex-direction:column;width:100%;height:24%" class="bk">

        <div style="text-align:left;">
            <div class="panel-heading down_border">
                <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>Nhập viện chi tiết khối lượng công việc khoa
            </div>
            <table id="gridJSListhzrjfyfx"></table>
        </div>

    </div>

    <div style="display:flex;flex-direction:column;width:100%;height:24%" class="bk">
        <div class="panel-heading down_border">
            <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>Chi tiết khối lượng công việc bác sĩ
        </div>
        <table id="gridJSListmzxyfx"></table>
    </div>
</div>

<script>
    var myDate = new Date();
    $(function () {
        $('').height($(window).height() - 60);
        init();
        gridJSListData();
        GetMonthNumChart();
    });

    function init() {
        $("").val("");
        $('').attr('', "");
        $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1));
        getSearchData();
    }
    function initEcharts(time,ry,cy,zz) {

        var myChart1 = echarts.init(document.getElementById(''));
        var myChart2 = echarts.init(document.getElementById(''));
        var myChart3 = echarts.init(document.getElementById(''));
        window.addEventListener('', function () {
            myChart1.resize();
            myChart2.resize();
            myChart3.resize();
        });
        var option1 = {
            xAxis: {
                type: '',
                boundaryGap: false,
                data: time
            },
            yAxis: {
                type: ''
            },
            tooltip: {
                trigger: '' 
            },
            series: [
                {
                    data: cy,
                    type: '',
                    areaStyle: {}
                }
            ]
        };

        var option2 = {
            xAxis: {
                type: '',
                boundaryGap: false,
                data: time
            },
            yAxis: {
                type: ''
            },
            tooltip: {
                trigger: ''
            },
            series: [
                {
                    data: ry,
                    type: '',
                    areaStyle: {}
                }
            ]
        };

        var option3 = {
            xAxis: {
                type: '',
                boundaryGap: false,
                data: time
            },
            yAxis: {
                type: ''
            },
            tooltip: {
                trigger: ''
            },
            series: [
                {
                    data: zz,
                    type: '',
                    areaStyle: {}
                }
            ]
        };

        myChart1.setOption(option1);
        myChart2.setOption(option2);
        myChart3.setOption(option3);
    }

    function gridJSListData() {
        var gridSort = '';
        var $gridJsList = $("");
        $gridJsList.dataGrid({
            height: 120,
            autowidth: true,//NếushrinkToFitChotruevà đã thiết lậpwidthGiá trị，thì chiều rộng mỗi cột sẽ theowidththu phóng theo tỷ lệ；
            shrinkToFit: true, //Nếu đặt làtrue，ThìGridchiều rộng sẽ tự tính lại theo chiều rộng của vùng chứa cha。**
            url: "",
            postData: { kssj: $('').val(), jssj: $('').val()},
            colModel: [
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '', hidden: true },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' }
            ],
            sortname: gridSort,
            viewrecords: true,
            onCellSelect: function (row) {
                var rowObj = $gridJsList.jqGrid('', row);
                console.log("", rowObj.bqCode)
                var $gridysList = $("");
                $gridysList.jqGrid('', {
                    postData: { kssj: $('').val(), jssj: $('').val(), bq: rowObj.bqCode },
                    page: 1,
                    
                    url: "",
                }).trigger('');

            }, loadComplete: function (data) {
                if (data.length > 0) {
                    var firstRow = data[0];
                    //var $gridysList = $("");
                    //$gridysList.jqGrid('', {
                    //    postData: { kssj: $('').val(), jssj: $('').val(), bq: firstRow.bqCode },
                    //    page: 1,
                    //    url: "",
                    //}).trigger('');
                    YSGZMXList(firstRow.bqCode)
                } else {
                    $("").jqGrid("", true);
                }
            }
        });
    }
    function YSGZMXList(bqCode) {
        var gridSort = '';
        var $gridysList = $("");
        $gridysList.dataGrid({
            height: 120,
            autowidth: true,//NếushrinkToFitChotruevà đã thiết lậpwidthGiá trị，thì chiều rộng mỗi cột sẽ theowidththu phóng theo tỷ lệ；
            shrinkToFit: true, //Nếu đặt làtrue，ThìGridchiều rộng sẽ tự tính lại theo chiều rộng của vùng chứa cha。**
            url: "",
            postData: { kssj: $('').val(), jssj: $('').val(), bq: bqCode },
            colModel: [
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' }
            ],
            sortname: gridSort,
            viewrecords: true
        });
    }
    function GetMonthNumChart() {
        var time = [];
        var ryqs = [];
        var cyqs = [];
        var zzqs = [];
        $.ajax({
            type: "",
            url: "",
            data: { kssj: $('').val(), jssj: $('').val() },
            dataType: "",
            async: false,
            success: function (lastdata) {
                if (lastdata != null) {
                    for (var i = 0; i < lastdata.length; i++) {
                       
                        ryqs[i] = lastdata[i].rysl;
                        time[i] = lastdata[i].mount;
                        cyqs[i] = lastdata[i].cysl;
                        zzqs[i] = lastdata[i].zysl;
                    }
                }
               
                initEcharts(time, ryqs, cyqs, zzqs);
            }
        });
    }

    function submit() {
        getSearchData();
        GetMonthNumChart();
        var $gridJsList = $("");
        $gridJsList.jqGrid('', {
            postData: { kssj: $('').val(), jssj: $('').val() },
        }).trigger('');
    }

    //Thay đổi loại thời gian
    function updateSjType() {
        $('').val("");
        let dateType = $("").val();
        if (dateType == "") {//Năm
            $('').attr('', "");
            $('').val(myDate.getFullYear());
        }
        if (dateType == "") {//Tháng
            $('').attr('', "");
            $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1));
        }
        if (dateType == "") {//Ngày
            $('').attr('', "");
            $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1) + "" + myDate.getDate());
        }
        getSearchData();
    }

    //Lắp ráp tham số yêu cầu
    function getSearchData() {
        let ksrq = '';
        let jsrq = '';
        let dateType = $("").val();
        let nowDate = $("").val();
        if (dateType == "") {//Năm
            ksrq = nowDate + "" + "";
            jsrq = nowDate + "" + "";
        }
        if (dateType == "") {//Tháng
            let array = nowDate.split("");
            ksrq = array[0] + "" + array[1] + "";
            let days = getDaysInMonth(array[0], array[1]);
            jsrq = array[0] + "" + array[1] + "" + days + "";
        }
        if (dateType == "") {//Ngày
            ksrq = nowDate + "";
            jsrq = nowDate + "";
        }

        $('').val(ksrq);
        $('').val(jsrq);
    }

    //Lấy số ngày trong tháng theo năm tháng
    function getDaysInMonth(year, month) {
        return new Date(year, month, 0).getDate();
    }
</script>

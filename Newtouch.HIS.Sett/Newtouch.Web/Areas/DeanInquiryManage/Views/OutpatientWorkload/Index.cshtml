@{
    ViewBag.Title = "Khối lượng công việc ngoại trú";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<head>
    <meta charset="utf-8">
    <script src="~/Content/js/echarts.min.js"></script>
    <style>
        .bk {
            border-radius: 10px;
            background-color: white;
        }
        .down_border {
            border-bottom: 1px solid #e6e6e6;
        }
        .ui-jqgrid .ui-jqgrid-bdiv {
            overflow-x: hidden;
        }
    </style>
</head>

<div  class="panel panel-default">
    <table class="form">
        <tr>
            <th class="formTitle" id="xzsjtext">Loại：</th>
            <td class="formValue" style="width:150px">
                <select id="dateType" class="form-control" onchange="updateSjType()">
                    <option value="1">Năm</option>
                    <option value="2">Tháng</option>
                    <option value="3">Ngày</option>
                </select>
            </td>
            <th class="formTitle" id="xzsjtext">Thời gian：</th>
            <td class="formValue" style="width:150px">
                <input id="rSJ" type="text" class="form-control input-wdatepicker" />
            </td>
            <td class="formValue" style="padding-left:20px;">
                <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
            </td>
        </tr>
    </table>

    <div id="main_div">
        <div style="width:100%;height:48%;background-color:#ffffff;">
            <div class="panel-heading down_border">
                <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>Khối lượng công việc khoa ngoại trú
            </div>
            <table id="gridJSListmzksgzl"></table>
        </div>

        <div style="width:100%;margin-top:15px;height:48%;background-color:#ffffff;">
            <div class="panel-heading down_border">
                <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>Khối lượng công việc bác sĩ
            </div>
            <table id="gridJSListysgzl"></table>
        </div>
    </div>
</div>
<script>

    var myDate = new Date();
    $(function () {

        $('#main_div').height($(window).height() - 60);
        //Mặc định đặt loại thời gian là tháng
        $("#dateType").val("2");
        $('#rSJ').attr('onfocus', "WdatePicker({ dateFmt: 'yyyy-MM' })");
        $('#rSJ').val(myDate.getFullYear() + "-" + (parseInt(myDate.getMonth()) + 1));
        gridJSListData();
    });

    //Lấy số ngày trong tháng theo năm tháng
    function getDaysInMonth(year, month) {
        return new Date(year, month, 0).getDate();
    }
    //Thay đổi loại thời gian
    function updateSjType() {
        $('#rSJ').val("");
        let dateType = $("#dateType").val();
        if (dateType == "1") {//Năm
            $('#rSJ').attr('onfocus', "WdatePicker({ dateFmt: 'yyyy' })");
            $('#rSJ').val(myDate.getFullYear());
        }
        if (dateType == "2") {//Tháng
            $('#rSJ').attr('onfocus', "WdatePicker({ dateFmt: 'yyyy-MM' })");
            $('#rSJ').val(myDate.getFullYear() + "-" + (parseInt(myDate.getMonth()) + 1));
        }
        if (dateType == "3") {//Ngày
            $('#rSJ').attr('onfocus', "WdatePicker({ dateFmt: 'yyyy-MM-dd' })");
            $('#rSJ').val(myDate.getFullYear() + "-" + (parseInt(myDate.getMonth()) + 1) + "-" + myDate.getDate());
        }
    }

    function submit() {
        $("#gridJSListmzksgzl").jqGrid('setGridParam', {
            postData: getSearchData(),
        }).trigger('reloadGrid');
    }
    //Lắp ráp tham số yêu cầu
    function getSearchData() {
        let ksrq = '';
        let jsrq = '';
        let dateType = $("#dateType").val();
        let nowDate = $("#rSJ").val();
        if (dateType == "1") {//Năm
            ksrq = nowDate + "-" + "01-01 00:00:00";
            jsrq = nowDate + "-" + "12-31 23:59:59";
        }
        if (dateType == "2") {//Tháng
            let array = nowDate.split("-");
            ksrq = array[0] + "-" + array[1] + "-01 00:00:00";
            let days = getDaysInMonth(array[0], array[1]);
            jsrq = array[0] + "-" + array[1] + "-" + days + " 23:59:59";
        }
        if (dateType == "3") {//Ngày
            ksrq = nowDate + " 00:00:00";
            jsrq = nowDate + " 23:59:59";
        }
        return { ksrq: ksrq, jsrq: jsrq};
    }
    function getSearchData(ks) {
        let ksrq = '';
        let jsrq = '';
        let dateType = $("#dateType").val();
        let nowDate = $("#rSJ").val();
        if (dateType == "1") {//Năm
            ksrq = nowDate + "-" + "01-01 00:00:00";
            jsrq = nowDate + "-" + "12-31 23:59:59";
        }
        if (dateType == "2") {//Tháng
            let array = nowDate.split("-");
            ksrq = array[0] + "-" + array[1] + "-01 00:00:00";
            let days = getDaysInMonth(array[0], array[1]);
            jsrq = array[0] + "-" + array[1] + "-" + days + " 23:59:59";
        }
        if (dateType == "3") {//Ngày
            ksrq = nowDate + " 00:00:00";
            jsrq = nowDate + " 23:59:59";
        }
        return { ksrq: ksrq, jsrq: jsrq, ks: ks };
    }
    function gridJSListData()
    {
        var gridSort = 'CreateTime asc';
        var $gridJsList = $("#gridJSListmzksgzl");
        $gridJsList.dataGrid({
            height: 300,
            autowidth: true,//Nếu shrinkToFit là true và đã đặt width Giá trị，thì chiều rộng mỗi cột sẽ dựa theo width tỷ lệ để thu phóng；
            shrinkToFit: true, //Nếu đặt thành true，thì Grid chiều rộng sẽ tự động tính lại dựa theo chiều rộng của container cha。**
            url: "/DeanInquiryManage/OutpatientWorkload/GetMzksgzl",
            postData: getSearchData(),
            colModel: [
                { label: 'Khoa ngoại trú', name: 'mzks',  align: 'left' },
                { label: 'Lượt khám chữa bệnh ngoại trú', name: 'mzzlrc',  align: 'left' },
                { label: 'Số lượng đơn thuốc', name: 'cfsl',  align: 'left' },
                { label: 'Số đơn thuốc đã kê', name: 'kycfs',  align: 'left' },
                { label: 'Số đơn thuốc đã phát', name: 'fycfs',  align: 'left' },
                { label: 'Số đơn thuốc phục hồi', name: 'kfcfs', align: 'left' },
                { label: 'DepartmentCode', name: 'DepartmentCode', align: 'left', hidden: true }
            ],
            sortname: gridSort,
            viewrecords: true,
            onSelectRow: function (rowid) {
                var rowObj = $gridJsList.jqGrid('getRowData', rowid);
                console.log("bqCode", rowObj.DeptmentCode)
                var $gridysList = $("#gridJSListysgzl");
                $gridysList.jqGrid('setGridParam', {
                    postData: getSearchData(rowObj.DepartmentCode),
                    url: "/DeanInquiryManage/OutpatientWorkload/GetYsgzl",
                }).trigger('reloadGrid');
            },
            loadComplete: function () {
                var ids = $('#gridJSListmzksgzl').getDataIDs();//trả về bảng dữ liệu của ID Mảng["66","39"..] 
                var rowData = $("#gridJSListmzksgzl").getRowData(ids[0]);
                if (rowData != null) {
                    if (rowData.rowData != "") {
                        YSGZLGrid(rowData.DepartmentCode);
                    }
                }
            }
        });

    }
    function YSGZLGrid(ks) {

        var gridSort = 'CreateTime asc';
        var $gridJsList = $("#gridJSListysgzl");
        $gridJsList.dataGrid({
            height: $(window).height() * 0.5 - 150,
            autowidth: true,//Nếu shrinkToFit là true và đã đặt width Giá trị，thì chiều rộng mỗi cột sẽ dựa theo width tỷ lệ để thu phóng；
            shrinkToFit: true, //Nếu đặt thành true，thì Grid chiều rộng sẽ tự động tính lại dựa theo chiều rộng của container cha。**
            url: "/DeanInquiryManage/OutpatientWorkload/GetYsgzl",
            postData:getSearchData(ks),
            colModel: [
                { label: 'Bác sĩ', name: 'Name', align: 'left' },
                { label: 'Lượt khám chữa bệnh ngoại trú', name: 'mzzlrc', align: 'left' },
                { label: 'Số lượng đơn thuốc', name: 'cfsl', align: 'left' },
                { label: 'Số đơn thuốc đã kê', name: 'kycfs', align: 'left' },
                { label: 'Số đơn thuốc đã phát', name: 'fycfs', align: 'left' },
                { label: 'Số đơn thuốc phục hồi', name: 'kfcfs', align: 'left' }
            ],
            sortname: gridSort,
            viewrecords: true
        });

    }
</script>

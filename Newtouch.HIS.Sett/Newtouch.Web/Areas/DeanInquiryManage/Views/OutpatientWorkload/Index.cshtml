@{
    ViewBag.Title = "";
    Layout = "";
}
<head>
    <meta charset="utf-8">
    <script src=""></script>
    <style>
        .bk {
            border-radius: 10px;
            background-color: white;
        }
        .down_border {
            border-bottom: 1px solid #e6e6e6;
        }
        .ui-jqgrid .ui-jqgrid-bdiv {
            overflow-x: hidden;
        }
    </style>
</head>

<div  class="panel panel-default">
    <table class="form">
        <tr>
            <th class="formTitle" id="xzsjtext">Loại：</th>
            <td class="formValue" style="width:150px">
                <select id="dateType" class="form-control" onchange="updateSjType()">
                    <option value="1">Năm</option>
                    <option value="2">Tháng</option>
                    <option value="3">Ngày</option>
                </select>
            </td>
            <th class="formTitle" id="xzsjtext">Thời gian：</th>
            <td class="formValue" style="width:150px">
                <input id="rSJ" type="text" class="form-control input-wdatepicker" />
            </td>
            <td class="formValue" style="padding-left:20px;">
                <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
            </td>
        </tr>
    </table>

    <div id="main_div">
        <div style="width:100%;height:48%;background-color:#ffffff;">
            <div class="panel-heading down_border">
                <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>Khối lượng công việc khoa ngoại trú
            </div>
            <table id="gridJSListmzksgzl"></table>
        </div>

        <div style="width:100%;margin-top:15px;height:48%;background-color:#ffffff;">
            <div class="panel-heading down_border">
                <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>Khối lượng công việc bác sĩ
            </div>
            <table id="gridJSListysgzl"></table>
        </div>
    </div>
</div>
<script>

    var myDate = new Date();
    $(function () {

        $('').height($(window).height() - 60);
        //Mặc định đặt loại thời gian là tháng
        $("").val("");
        $('').attr('', "");
        $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1));
        gridJSListData();
    });

    //Lấy số ngày trong tháng theo năm tháng
    function getDaysInMonth(year, month) {
        return new Date(year, month, 0).getDate();
    }
    //Thay đổi loại thời gian
    function updateSjType() {
        $('').val("");
        let dateType = $("").val();
        if (dateType == "") {//Năm
            $('').attr('', "");
            $('').val(myDate.getFullYear());
        }
        if (dateType == "") {//Tháng
            $('').attr('', "");
            $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1));
        }
        if (dateType == "") {//Ngày
            $('').attr('', "");
            $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1) + "" + myDate.getDate());
        }
    }

    function submit() {
        $("").jqGrid('', {
            postData: getSearchData(),
        }).trigger('');
    }
    //Lắp ráp tham số yêu cầu
    function getSearchData() {
        let ksrq = '';
        let jsrq = '';
        let dateType = $("").val();
        let nowDate = $("").val();
        if (dateType == "") {//Năm
            ksrq = nowDate + "" + "";
            jsrq = nowDate + "" + "";
        }
        if (dateType == "") {//Tháng
            let array = nowDate.split("");
            ksrq = array[0] + "" + array[1] + "";
            let days = getDaysInMonth(array[0], array[1]);
            jsrq = array[0] + "" + array[1] + "" + days + "";
        }
        if (dateType == "") {//Ngày
            ksrq = nowDate + "";
            jsrq = nowDate + "";
        }
        return { ksrq: ksrq, jsrq: jsrq};
    }
    function getSearchData(ks) {
        let ksrq = '';
        let jsrq = '';
        let dateType = $("").val();
        let nowDate = $("").val();
        if (dateType == "") {//Năm
            ksrq = nowDate + "" + "";
            jsrq = nowDate + "" + "";
        }
        if (dateType == "") {//Tháng
            let array = nowDate.split("");
            ksrq = array[0] + "" + array[1] + "";
            let days = getDaysInMonth(array[0], array[1]);
            jsrq = array[0] + "" + array[1] + "" + days + "";
        }
        if (dateType == "") {//Ngày
            ksrq = nowDate + "";
            jsrq = nowDate + "";
        }
        return { ksrq: ksrq, jsrq: jsrq, ks: ks };
    }
    function gridJSListData()
    {
        var gridSort = '';
        var $gridJsList = $("");
        $gridJsList.dataGrid({
            height: 300,
            autowidth: true,//NếushrinkToFitChotruevà đã thiết lậpwidthGiá trị，thì chiều rộng mỗi cột sẽ theowidththu phóng theo tỷ lệ；
            shrinkToFit: true, //Nếu đặt làtrue，ThìGridchiều rộng sẽ tự tính lại theo chiều rộng của vùng chứa cha。**
            url: "",
            postData: getSearchData(),
            colModel: [
                { label: '', name: '',  align: '' },
                { label: '', name: '',  align: '' },
                { label: '', name: '',  align: '' },
                { label: '', name: '',  align: '' },
                { label: '', name: '',  align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '', hidden: true }
            ],
            sortname: gridSort,
            viewrecords: true,
            onSelectRow: function (rowid) {
                var rowObj = $gridJsList.jqGrid('', rowid);
                console.log("", rowObj.DeptmentCode)
                var $gridysList = $("");
                $gridysList.jqGrid('', {
                    postData: getSearchData(rowObj.DepartmentCode),
                    url: "",
                }).trigger('');
            },
            loadComplete: function () {
                var ids = $('').getDataIDs();//Bảng dữ liệu trả vềIDMảng["",""..] 
                var rowData = $("").getRowData(ids[0]);
                if (rowData != null) {
                    if (rowData.rowData != "") {
                        YSGZLGrid(rowData.DepartmentCode);
                    }
                }
            }
        });

    }
    function YSGZLGrid(ks) {

        var gridSort = '';
        var $gridJsList = $("");
        $gridJsList.dataGrid({
            height: $(window).height() * 0.5 - 150,
            autowidth: true,//NếushrinkToFitChotruevà đã thiết lậpwidthGiá trị，thì chiều rộng mỗi cột sẽ theowidththu phóng theo tỷ lệ；
            shrinkToFit: true, //Nếu đặt làtrue，ThìGridchiều rộng sẽ tự tính lại theo chiều rộng của vùng chứa cha。**
            url: "",
            postData:getSearchData(ks),
            colModel: [
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' }
            ],
            sortname: gridSort,
            viewrecords: true
        });

    }
</script>

<script>

    var myDate = new Date();
    $(function () {

        $('').height($(window).height() - 60);
        //Mặc định đặt loại thời gian là tháng
        $("").val("");
        $('').attr('', "");
        $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1));
        initEchartsByKSXYPM(1);
        initEchartsByLSQS(1);
        gridJSListData();
        
    });

    function submit() {
        initEchartsByKSXYPM(1);
        initEchartsByLSQS(1);

        $("").jqGrid('', {
            postData: getSearchData(),
        }).trigger('');
        //$("").jqGrid('', {
        //    postData: getSearchData(),
        //}).trigger('');
    }
    //Lấy số ngày trong tháng theo năm tháng
    function getDaysInMonth(year, month) {
        return new Date(year, month, 0).getDate();
    }
    //Thay đổi loại thời gian
    function updateSjType() {
        $('').val("");
        let dateType = $("").val();
        if (dateType == "") {//Năm
            $('').attr('', "");
            $('').val(myDate.getFullYear());
        }
        if (dateType == "") {//Tháng
            $('').attr('', "");
            $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1));
        }
        if (dateType == "") {//Ngày
            $('').attr('', "");
            $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1) + "" + myDate.getDate());
        }
    }
    //Lắp ráp tham số yêu cầu
    function getSearchData() {
        let ksrq = '';
        let jsrq = '';
        let dateType = $("").val();
        let nowDate = $("").val();
        if (dateType == "") {//Năm
            ksrq = nowDate + "" + "";
            jsrq = nowDate + "" + "";
        }
        if (dateType == "") {//Tháng
            let array = nowDate.split("");
            ksrq = array[0] + "" + array[1] + "";
            let days = getDaysInMonth(array[0], array[1]);
            jsrq = array[0] + "" + array[1] + "" + days + "";
        }
        if (dateType == "") {//Ngày
            ksrq = nowDate + "";
            jsrq = nowDate + "";
        }
        return { ksrq: ksrq, jsrq: jsrq, rtype: dateType };
    }
    function getSearchData(type) {
        let ksrq = '';
        let jsrq = '';
        let dateType = $("").val();
        let nowDate = $("").val();
        if (dateType == "") {//Năm
            ksrq = nowDate + "" + "";
            jsrq = nowDate + "" + "";
        }
        if (dateType == "") {//Tháng
            let array = nowDate.split("");
            ksrq = array[0] + "" + array[1] + "";
            let days = getDaysInMonth(array[0], array[1]);
            jsrq = array[0] + "" + array[1] + "" + days + "";
        }
        if (dateType == "") {//Ngày
            ksrq = nowDate + "";
            jsrq = nowDate + "";
        }
        return { ksrq: ksrq, jsrq: jsrq, rtype: dateType, type: type};
    }
    //Xu hướng lịch sử
    function initEchartsByLSQS(type) {
        $.ajax({
            type: "",
            url: "",
            dataType: "",
            data: getSearchData(type),
            success: function (ajaxresp) {

                var myChart2 = echarts.init(document.getElementById(''));
                var option2 = {
                    legend: {},
                    tooltip: {},
                    dataset: {
                        source: ajaxresp
                        //    [
                        //    { product: '', '': 43.3 },
                        //    { product: '', '': 83.1 },
                        //    { product: '', '': 86.4 },
                        //    { product: '', '': 72.4 },
                        //    { product: '', '': 72.4 }
                        //]
                    },
                    xAxis: { type: '' },
                    yAxis: {},
                    series: [
                        {
                            type: '',
                            barWidth: '',
                            encode: {
                                //""Ánh xạ cột tớiXTrục
                                x: '',
                                //""Ánh xạ cột tớiYTrục
                                y: ''

                            }
                        }
                    ]
                };
                myChart2.setOption(option2);
            }
        });
    }
    //Xếp hạng hiệu quả khoa
    function initEchartsByKSXYPM(type) {
        
        $.ajax({
            type: "",
            url: "",
            dataType: "",
            data: getSearchData(type),
            success: function (ajaxresp) {
                var myChart1 = echarts.init(document.getElementById(''));
                var option1 = {
                    legend: {},
                    tooltip: {},
                    dataset: {
                        source: ajaxresp
                    },
                    xAxis: { type: '' },
                    yAxis: {},
                    series: [
                        {
                            type: '',
                            barWidth: '',
                            encode: {
                                //""Ánh xạ cột tớiXTrục
                                x: '',
                                //""Ánh xạ cột tớiYTrục
                                y: ''

                            }
                        }
                    ]
                };
                myChart1.setOption(option1);
            }
        });
    }
    function initEchartsByKSXYPM(type) {
        
        $.ajax({
            type: "",
            url: "",
            dataType: "",
            data: getSearchData(type),
            success: function (ajaxresp) {
                var myChart1 = echarts.init(document.getElementById(''));
                var option1 = {
                    legend: {},
                    tooltip: {},
                    dataset: {
                        source: ajaxresp
                    },
                    xAxis: { type: '' },
                    yAxis: {},
                    series: [
                        {
                            type: '',
                            barWidth: '',
                            encode: {
                                //""Ánh xạ cột tớiXTrục
                                x: '',
                                //""Ánh xạ cột tớiYTrục
                                y: ''

                            }
                        }
                    ]
                };
                myChart1.setOption(option1);
            }
        });
    }
    function gridJSListData() {
        var gridSort = '';
        var $gridJsList = $("");
        $gridJsList.dataGrid({
            height: 100,
            autowidth: true,//NếushrinkToFitChotruevà đã thiết lậpwidthGiá trị，thì chiều rộng mỗi cột sẽ theowidththu phóng theo tỷ lệ；
            shrinkToFit: true, //Nếu đặt làtrue，ThìGridchiều rộng sẽ tự tính lại theo chiều rộng của vùng chứa cha。**
            url: "",
            postData: getSearchData(),
            colModel: [
                { label: '', name: '',align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '', hidden: true }
            ],
            onSelectRow: function (rowid) {
                var rowObj = $gridJsList.jqGrid('', rowid);
                console.log("", rowObj.DeptmentCode)
                var $gridysList = $("");
                $gridysList.jqGrid('', {
                    postData: getSearchData(rowObj.DeptmentCode),
                    url: "",
                }).trigger('');
            },
            sortname: gridSort,
            viewrecords: true,
            loadComplete: function () {
                var ids = $('').getDataIDs();//Bảng dữ liệu trả vềIDMảng["",""..] 
                var rowData = $("").getRowData(ids[0]);
                if (rowData != null) {
                    if (rowData.rowData != "") {
                        YSXY(rowData.DeptmentCode);
                    }
                }
            }
        });
    }
    //医生收益
    function YSXY(dpCode) {

        var gridSort = '';
        var $gridJsList = $("");
        $gridJsList.dataGrid({
            height: 100,
            autowidth: true,//NếushrinkToFitChotruevà đã thiết lậpwidthGiá trị，thì chiều rộng mỗi cột sẽ theowidththu phóng theo tỷ lệ；
            shrinkToFit: true, //Nếu đặt làtrue，ThìGridchiều rộng sẽ tự tính lại theo chiều rộng của vùng chứa cha。**
            url: "",
            postData: getSearchData(dpCode),
            colModel: [
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' }
            ],
            sortname: gridSort,
            viewrecords: true
        });
    }
</script>

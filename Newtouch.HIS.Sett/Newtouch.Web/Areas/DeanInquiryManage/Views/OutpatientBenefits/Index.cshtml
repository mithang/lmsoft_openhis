@{
    ViewBag.Title = "Hiệu quả ngoại trú";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<head>
    <meta charset="utf-8">
    <script src="~/Content/js/echarts.min.js"></script>
    <style>
        .bk {
            border-radius: 10px;
            background-color: white;
        }
        .selectbtn {
            border: 0px;
            background-color: white;
        }
        .down_border {
            border-bottom: 1px solid #e6e6e6;
        }
        .ui-jqgrid .ui-jqgrid-bdiv {
            overflow-x: hidden;
        }
    </style>
</head>

<div class="panel panel-default">
    <table class="form">
        <tr>
            <th class="formTitle" id="xzsjtext">Loại：</th>
            <td class="formValue" style="width:150px">
                <select id="dateType" class="form-control" onchange="updateSjType()">
                    <option value="1">Năm</option>
                    <option value="2">Tháng</option>
                    <option value="3">Ngày</option>
                </select>
            </td>
            <th class="formTitle" id="xzsjtext">Thời gian：</th>
            <td class="formValue" style="width:150px">
                <input id="rSJ" type="text" class="form-control input-wdatepicker"/>
            </td>
            <td class="formValue" style="padding-left:20px;">
                <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
            </td>
        </tr>
    </table>
</div>
<div id="main_div" style="display:flex;flex-direction:column;justify-content:space-between;flex-wrap:wrap;">

    <div style="display:flex;flex-direction:row;justify-content:space-between;flex-wrap:wrap;height:50%">
        <div style="width:49.8%;display:flex;flex-direction:column" class="bk">
            <div class="panel-heading down_border">
                <i class="fa fa-bar-chart fa-lg" style="margin-right:5px;"></i>Xếp hạng hiệu quả khoa
            </div>
            <div style="width:100%;height:25px;">
                <input type="button" id="btn_zlrc" onclick="initEchartsByKSXYPM(1);" value="Lượt khám chữa bệnh" style="height:100%;width:20%" class="selectbtn" />
                <input type="button" id="btn_sjzlsr" onclick="initEchartsByKSXYPM(2);" value="Thu nhập khám chữa bệnh thực tế" style="height:100%;width:20%" class="selectbtn" />
                @*<input type="button" id="btn_rjzlfy" onclick="submitpm(3);" value="Chi phí khám chữa bệnh bình quân đầu người" style="height:100%;width:20%" class="selectbtn" />
                <input type="button" id="btn_pjzlsc" onclick="subsubmitpmmit(4);" value="Thời lượng khám chữa bệnh bình quân" style="height:100%;width:20%" class="selectbtn" />
                <input type="button" id="btn_fzl" onclick="submitpm(5);" value="Tỷ lệ tái khám" style="height:100%;width:20%;" class="selectbtn" />*@
            </div>
            <div id="main1" style="width:100%;height:100%;"></div>
        </div>
        <div style="width:49.8%;display:flex;flex-direction:column" class="bk">
            <div class="panel-heading down_border">
                <i class="fa fa-area-chart fa-lg" style="margin-right:5px;"></i>Xu hướng lịch sử
            </div>
            <div style="width:100%;height:19px;">
                <input type="button" id="btn_zlrc" onclick="initEchartsByLSQS(1);" value="Lượt khám chữa bệnh" style="height:100%;width:20%" class="selectbtn" />
                <input type="button" id="btn_sjzlsr" onclick="initEchartsByLSQS(2);" value="Thu nhập khám chữa bệnh thực tế" style="height:100%;width:20%" class="selectbtn" />
                @*<input type="button" id="btn_rjzlfy" onclick="submit();" value="Chi phí khám chữa bệnh bình quân đầu người" style="height:100%;width:20%" class="selectbtn" />
                <input type="button" id="btn_pjzlsc" onclick="submit();" value="Thời lượng khám chữa bệnh bình quân" style="height:100%;width:20%" class="selectbtn" />
                <input type="button" id="btn_fzl" onclick="submit();" value="Tỷ lệ tái khám" style="height:100%;width:20%;" class="selectbtn" />*@
            </div>
            <div id="main2" style="width:100%;height:100%;"></div>
        </div>
    </div>

    <div style="display:flex;flex-direction:column;width:100%;height:24%" class="bk">

        <div style="text-align:left;">
            <div class="panel-heading down_border">
                <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>Chi tiết hiệu quả ngoại trú
            </div>
            <table id="gridJSListhzrjfyfx"></table>
        </div>

    </div>

    <div style="display:flex;flex-direction:column;width:100%;height:24%" class="bk">
        <div class="panel-heading down_border">
            <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>Hiệu quả bác sĩ
        </div>
        <table id="gridJSListmzxyfx"></table>
    </div>
</div>

<script>

    var myDate = new Date();
    $(function () {

        $('#main_div').height($(window).height() - 60);
        //Mặc định đặt loại thời gian là tháng
        $("#dateType").val("2");
        $('#rSJ').attr('onfocus', "WdatePicker({ dateFmt: 'yyyy-MM' })");
        $('#rSJ').val(myDate.getFullYear() + "-" + (parseInt(myDate.getMonth()) + 1));
        initEchartsByKSXYPM(1);
        initEchartsByLSQS(1);
        gridJSListData();
        
    });

    function submit() {
        initEchartsByKSXYPM(1);
        initEchartsByLSQS(1);

        $("#gridJSListhzrjfyfx").jqGrid('setGridParam', {
            postData: getSearchData(),
        }).trigger('reloadGrid');
        //$("#gridJSListmzxyfx").jqGrid('setGridParam', {
        //    postData: getSearchData(),
        //}).trigger('reloadGrid');
    }
    //Lấy số ngày trong tháng theo năm tháng
    function getDaysInMonth(year, month) {
        return new Date(year, month, 0).getDate();
    }
    //Thay đổi loại thời gian
    function updateSjType() {
        $('#rSJ').val("");
        let dateType = $("#dateType").val();
        if (dateType == "1") {//Năm
            $('#rSJ').attr('onfocus', "WdatePicker({ dateFmt: 'yyyy' })");
            $('#rSJ').val(myDate.getFullYear());
        }
        if (dateType == "2") {//Tháng
            $('#rSJ').attr('onfocus', "WdatePicker({ dateFmt: 'yyyy-MM' })");
            $('#rSJ').val(myDate.getFullYear() + "-" + (parseInt(myDate.getMonth()) + 1));
        }
        if (dateType == "3") {//Ngày
            $('#rSJ').attr('onfocus', "WdatePicker({ dateFmt: 'yyyy-MM-dd' })");
            $('#rSJ').val(myDate.getFullYear() + "-" + (parseInt(myDate.getMonth()) + 1) + "-" + myDate.getDate());
        }
    }
    //Lắp ráp tham số yêu cầu
    function getSearchData() {
        let ksrq = '';
        let jsrq = '';
        let dateType = $("#dateType").val();
        let nowDate = $("#rSJ").val();
        if (dateType == "1") {//Năm
            ksrq = nowDate + "-" + "01-01 00:00:00";
            jsrq = nowDate + "-" + "12-31 23:59:59";
        }
        if (dateType == "2") {//Tháng
            let array = nowDate.split("-");
            ksrq = array[0] + "-" + array[1] + "-01 00:00:00";
            let days = getDaysInMonth(array[0], array[1]);
            jsrq = array[0] + "-" + array[1] + "-" + days + " 23:59:59";
        }
        if (dateType == "3") {//Ngày
            ksrq = nowDate + " 00:00:00";
            jsrq = nowDate + " 23:59:59";
        }
        return { ksrq: ksrq, jsrq: jsrq, rtype: dateType };
    }
    function getSearchData(type) {
        let ksrq = '';
        let jsrq = '';
        let dateType = $("#dateType").val();
        let nowDate = $("#rSJ").val();
        if (dateType == "1") {//Năm
            ksrq = nowDate + "-" + "01-01 00:00:00";
            jsrq = nowDate + "-" + "12-31 23:59:59";
        }
        if (dateType == "2") {//Tháng
            let array = nowDate.split("-");
            ksrq = array[0] + "-" + array[1] + "-01 00:00:00";
            let days = getDaysInMonth(array[0], array[1]);
            jsrq = array[0] + "-" + array[1] + "-" + days + " 23:59:59";
        }
        if (dateType == "3") {//Ngày
            ksrq = nowDate + " 00:00:00";
            jsrq = nowDate + " 23:59:59";
        }
        return { ksrq: ksrq, jsrq: jsrq, rtype: dateType, type: type};
    }
    //Xu hướng lịch sử
    function initEchartsByLSQS(type) {
        $.ajax({
            type: "Post",
            url: "/DeanInquiryManage/OutpatientBenefits/GetLsqs",
            dataType: "json",
            data: getSearchData(type),
            success: function (ajaxresp) {

                var myChart2 = echarts.init(document.getElementById('main2'));
                var option2 = {
                    legend: {},
                    tooltip: {},
                    dataset: {
                        source: ajaxresp
                        //    [
                        //    { product: '2019', '2015': 43.3 },
                        //    { product: '2020', '2015': 83.1 },
                        //    { product: '2021', '2015': 86.4 },
                        //    { product: '2022', '2015': 72.4 },
                        //    { product: '2023', '2015': 72.4 }
                        //]
                    },
                    xAxis: { type: 'category' },
                    yAxis: {},
                    series: [
                        {
                            type: 'bar',
                            barWidth: '25%',
                            encode: {
                                //Chuyển"amount"cột ánh xạ tới X trục
                                x: 'Name',
                                //Chuyển"product"cột ánh xạ tới Y trục
                                y: 'keyword'

                            }
                        }
                    ]
                };
                myChart2.setOption(option2);
            }
        });
    }
    //Xếp hạng hiệu quả khoa
    function initEchartsByKSXYPM(type) {
        
        $.ajax({
            type: "Post",
            url: "/DeanInquiryManage/OutpatientBenefits/GetKSXYPM",
            dataType: "json",
            data: getSearchData(type),
            success: function (ajaxresp) {
                var myChart1 = echarts.init(document.getElementById('main1'));
                var option1 = {
                    legend: {},
                    tooltip: {},
                    dataset: {
                        source: ajaxresp
                    },
                    xAxis: { type: 'category' },
                    yAxis: {},
                    series: [
                        {
                            type: 'bar',
                            barWidth: '25%',
                            encode: {
                                //Chuyển"amount"cột ánh xạ tới X trục
                                x: 'Name',
                                //Chuyển"product"cột ánh xạ tới Y trục
                                y: 'keyword'

                            }
                        }
                    ]
                };
                myChart1.setOption(option1);
            }
        });
    }
    function initEchartsByKSXYPM(type) {
        
        $.ajax({
            type: "Post",
            url: "/DeanInquiryManage/OutpatientBenefits/GetKSXYPM",
            dataType: "json",
            data: getSearchData(type),
            success: function (ajaxresp) {
                var myChart1 = echarts.init(document.getElementById('main1'));
                var option1 = {
                    legend: {},
                    tooltip: {},
                    dataset: {
                        source: ajaxresp
                    },
                    xAxis: { type: 'category' },
                    yAxis: {},
                    series: [
                        {
                            type: 'bar',
                            barWidth: '25%',
                            encode: {
                                //Chuyển"amount"cột ánh xạ tới X trục
                                x: 'Name',
                                //Chuyển"product"cột ánh xạ tới Y trục
                                y: 'keyword'

                            }
                        }
                    ]
                };
                myChart1.setOption(option1);
            }
        });
    }
    function gridJSListData() {
        var gridSort = 'CreateTime asc';
        var $gridJsList = $("#gridJSListhzrjfyfx");
        $gridJsList.dataGrid({
            height: 100,
            autowidth: true,//Nếu shrinkToFit là true và đã đặt width Giá trị，thì chiều rộng mỗi cột sẽ dựa theo width tỷ lệ để thu phóng；
            shrinkToFit: true, //Nếu đặt thành true，thì Grid chiều rộng sẽ tự động tính lại dựa theo chiều rộng của container cha。**
            url: "/DeanInquiryManage/OutpatientBenefits/GetMzxymx",
            postData: getSearchData(),
            colModel: [
                { label: 'Khoa ngoại trú', name: 'mzks',align: 'left' },
                { label: 'Lượt khám ngoại trú', name: 'mzzlrc',align: 'left' },
                { label: 'Thu nhập ngoại trú（ đồng）', name: 'mzsr',align: 'left' },
                { label: 'Chi phí điều trị bình quân đầu người（ đồng）', name: 'rjfy', align: 'left' },
                { label: 'Tỷ lệ chi phí tự trả（%）', name: 'zffyzb', align: 'left' },
                { label: 'Tỷ lệ chi phí bảo hiểm y tế（%）', name: 'ybfyzb', align: 'left' },
                { label: 'Thời lượng điều trị bình quân', name: 'pjzlsc',align: 'left' },
                { label: 'Tỷ lệ tái khám', name: 'fzl', align: 'left' },
                { label: 'DeptmentCode', name: 'DeptmentCode', align: 'left', hidden: true }
            ],
            onSelectRow: function (rowid) {
                var rowObj = $gridJsList.jqGrid('getRowData', rowid);
                console.log("bqCode", rowObj.DeptmentCode)
                var $gridysList = $("#gridJSListmzxyfx");
                $gridysList.jqGrid('setGridParam', {
                    postData: getSearchData(rowObj.DeptmentCode),
                    url: "/DeanInquiryManage/OutpatientBenefits/GetYsxy",
                }).trigger('reloadGrid');
            },
            sortname: gridSort,
            viewrecords: true,
            loadComplete: function () {
                var ids = $('#gridJSListhzrjfyfx').getDataIDs();//trả về bảng dữ liệu của ID Mảng["66","39"..] 
                var rowData = $("#gridJSListhzrjfyfx").getRowData(ids[0]);
                if (rowData != null) {
                    if (rowData.rowData != "") {
                        YSXY(rowData.DeptmentCode);
                    }
                }
            }
        });
    }
    //Thu nhập bác sĩ
    function YSXY(dpCode) {

        var gridSort = 'CreateTime asc';
        var $gridJsList = $("#gridJSListmzxyfx");
        $gridJsList.dataGrid({
            height: 100,
            autowidth: true,//Nếu shrinkToFit là true và đã đặt width Giá trị，thì chiều rộng mỗi cột sẽ dựa theo width tỷ lệ để thu phóng；
            shrinkToFit: true, //Nếu đặt thành true，thì Grid chiều rộng sẽ tự động tính lại dựa theo chiều rộng của container cha。**
            url: "/DeanInquiryManage/OutpatientBenefits/GetYsxy",
            postData: getSearchData(dpCode),
            colModel: [
                { label: 'Bác sĩ', name: 'mzks', align: 'left' },
                { label: 'Lượt khám ngoại trú', name: 'mzzlrc', align: 'left' },
                { label: 'Thu nhập ngoại trú（ đồng）', name: 'mzsr', align: 'left' },
                { label: 'Chi phí điều trị bình quân đầu người（ đồng）', name: 'rjzlfy', align: 'left' },
                { label: 'Tỷ lệ chi phí tự trả（%）', name: 'zffyzb', align: 'left' },
                { label: 'Tỷ lệ chi phí bảo hiểm y tế（%）', name: 'ybfyzb', align: 'left' },
                { label: 'Thời lượng điều trị bình quân', name: 'pjzlsc', align: 'left' },
                { label: 'Tỷ lệ tái khám', name: 'fzl', align: 'left' }
            ],
            sortname: gridSort,
            viewrecords: true
        });
    }
</script>

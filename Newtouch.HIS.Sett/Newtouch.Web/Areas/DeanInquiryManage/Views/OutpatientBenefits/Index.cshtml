                <input type="button" id="btn_sjzlsr" onclick="initEchartsByLSQS(2);" value="Thu nhập chẩn trị thực tế" style="height:100%;width:20%" class="selectbtn" />
                @*<input type="button" id="btn_rjzlfy" onclick="submit();" value="人均诊疗费用" style="height:100%;width:20%" class="selectbtn" />
                <input type="button" id="btn_pjzlsc" onclick="submit();" value="平均诊疗时长" style="height:100%;width:20%" class="selectbtn" />
                <input type="button" id="btn_fzl" onclick="submit();" value="Tỷ lệ tái khám" style="height:100%;width:20%;" class="selectbtn" />*@

@{
    ViewBag.Title = "";
    Layout = "";
}
<head>
    <meta charset="utf-8">
    <script src=""></script>

    <style>
        .banner {
            width: 16.3%;
            height: 80px;
            text-align: center;
        }
        .banner_title {
            padding-top:5px;
            height: 30%;
            font-size: 15px;
            font-weight: bold;
        }
        .banner_data {
            width: 100%;
            height: 30%;
            font-weight: bold;
            font-size: 18px;
        }
        .banner_down {
            display: flex;
            justify-content: space-around;
            font-size: 15px;
        }
        /*边框*/
        .bk {
            background-color: #ffffff;
        }
        /*Phông chữ*/
        .font {
            font-weight: bold;
            text-align: center;
        }
        .down_border {
            border-bottom: 1px solid #e6e6e6;
        }
        .ui-jqgrid .ui-jqgrid-bdiv {
            overflow-x: hidden;
        }
    </style>

</head>

<div>
    <div class="panel panel-default">
        <table class="form">
            <tr>
                <th class="formTitle" id="xzsjtext">Loại：</th>
                <td class="formValue" style="width:150px">
                    <select id="dateType" class="form-control" onchange="updateSjType()">
                        <option value="1">Năm</option>
                        <option value="2">Tháng</option>
                        <option value="3">Ngày</option>
                    </select>
                </td>
                <th class="formTitle" id="xzsjtext">Thời gian：</th>
                <td class="formValue" style="width:150px">
                    <input id="rSJ" type="text" class="form-control input-wdatepicker" @*onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"*@>
                </td>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
            </tr>
        </table>
    </div>

    <div id="main_div" style="display:flex;flex-direction:column;justify-content:space-between;flex-wrap:wrap;">
        <div>
            <div class="panel-heading down_border" style="background-color:#ffffff;">
                <i class="fa fa-line-chart fa-lg" style="margin-right:5px;"></i>Tất cả phân tích chi phí nhập viện
            </div>
            <div style="display:flex;justify-content:space-between;color:#ffffff;">
                <div class="banner" style="background-color: #fc8675;">
                    <div class="banner_title">Nhập viện chi phí tổng(đồng)</div>
                    <div class="banner_data" id="zfy">
                    </div>
                    <div class="banner_down">
                        <p id="zfy_tb">0</p>
                        <p id="zfy_hb">0</p>
                    </div>
                </div>
                <div class="banner" style="background-color: #65cea7;">
                    <div class="banner_title">Phí thuốc(đồng)</div>
                    <div class="banner_data" id="ypf">
                        
                    </div>
                    @*<div  class="banner_down">
                        <p ></p>
                        <p ></p>
                    </div>*@
                </div>

                <div class="banner" style="background-color: #f3ce85;">
                    <div class="banner_title" >Phí vật tư tiêu hao(đồng)</div>
                    <div class="banner_data" id="hcf">
                    </div>
                    @*<div  class="banner_down">
                        <p >+2.35%So với kỳ trước</p>
                        <p >+1.22%So với cùng kỳ</p>
                    </div>*@
                </div>

                <div class="banner" style="background-color: #00c0ef">
                    <div class="banner_title">Chi phí chẩn trị(đồng)</div>
                    <div class="banner_data" id="zlf">
                    </div>
                    @*<div  class="banner_down">
                        <p >+2.35%So với kỳ trước</p>
                        <p >+1.22%So với cùng kỳ</p>
                    </div>*@
                </div>

                <div class="banner" style="background-color: #60A7D0;">
                    <div class="banner_title">Số người xuất viện</div>
                    <div class="banner_data" id="cyrs">
                    </div>
                    <div  class="banner_down">
                        <p id="cyrs_tb"></p>
                        <p id="cyrs_hb"></p>
                    </div>
                </div>

                <div class="banner" style="background-color:#72B63F">
                    <div class="banner_title">次均住院费用</div>
                    <div class="banner_data" id="jczyfy">
                    </div>
                    <div  class="banner_down">
                        <p id="jczyfy_tb"></p>
                        <p id="jczyfy_hb"></p>
                    </div>
                </div>

            </div>
        </div>

        <div style="width:100%;height:30%" class="bk">
            <div style="text-align:left;">
                <div class="panel-heading down_border">
                    <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>Phân tích chi phí khoa
                </div>
                <table id="gridJSListksfyfx"></table>
            </div>

        </div>
        <div class="panel-heading down_border" style="background-color:#ffffff;">
            <i class="fa fa-pie-chart fa-lg" style="margin-right:5px;"></i>Xuất viện phân tích chi phí bệnh nhân
        </div>
        <div style="display:flex;flex-direction:row;justify-content: space-between;width:100%;height:50%">
            <div style="width:49.8%;height:100%;margin-bottom:2px" class="bk">
                <table id="gridJSListcyhzfyfx"></table>
            </div>
            <div id="main" style="width:49.8%;height:100%;" class="bk"></div>
        </div>
    </div>
</div>
<script>

    var myDate = new Date();
    $(function () {

        $('').height($(window).height() - 60);
        //Mặc định đặt loại thời gian là tháng
        $("").val("");
        $('').attr('', "");
        $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1));

        getData();//banner
        gridJSListData();
        initEcharts();
    });
    function submit() {
        getData();//banner
        $("").jqGrid('', {
            postData: getSearchData(),
        }).trigger('');
        $("").jqGrid('', {
            postData: getSearchData(),
        }).trigger('');
        
        initEcharts();
    }
    //Thay đổi loại thời gian
    function updateSjType() {
        $('').val("");
        let dateType = $("").val();
        if (dateType == "") {//Năm
            $('').attr('', "");
            $('').val(myDate.getFullYear());
        }
        if (dateType == "") {//Tháng
            $('').attr('', "");
            $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1));
        }
        if (dateType == "") {//Ngày
            $('').attr('', "");
            $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1) + "" + myDate.getDate());
        }
    }
    //Lấy số ngày trong tháng theo năm tháng
    function getDaysInMonth(year, month) {
        return new Date(year, month, 0).getDate();
    }
    //Lắp ráp tham số yêu cầu
    function getSearchData() {
        let ksrq = '';
        let jsrq = '';
        let dateType = $("").val();
        let nowDate = $("").val();
        if (dateType == "") {//Năm
            ksrq = nowDate + "" + "";
            jsrq = nowDate + "" + "";
        }
        if (dateType == "") {//Tháng
            let array = nowDate.split("");
            ksrq = array[0] + "" + array[1] + "";
            let days = getDaysInMonth(array[0], array[1]);
            jsrq = array[0] + "" + array[1] + "" + days + "";
        }
        if (dateType == "") {//Ngày
            ksrq = nowDate + "";
            jsrq = nowDate + "";
        }
        return { ksrq: ksrq, jsrq: jsrq, rtype: dateType };
    }
    //抬头
    function getData() {
        $.ajax({
            type: "",
            url: "",
            dataType: "",
            data: getSearchData(),
            success: function (ajaxresp) {
                if ($("").val() == "") {
                    document.getElementById('').innerText = ajaxresp.zfy;
                    document.getElementById('').innerText = "" + ajaxresp.zfy_hb;
                    document.getElementById('').innerText = "" + ajaxresp.zfy_tb;
                    document.getElementById('').innerText = ajaxresp.ypf;
                    document.getElementById('').innerText = ajaxresp.hcf;
                    document.getElementById('').innerText = ajaxresp.zlf;
                    document.getElementById('').innerText = ajaxresp.cyrs;
                    document.getElementById('').innerText = "" + ajaxresp.cyrs_hb;
                    document.getElementById('').innerText = "" + ajaxresp.cyrs_tb;
                    document.getElementById('').innerText = ajaxresp.jczyfy;
                    document.getElementById('').innerText = "" + ajaxresp.jczyfy_hb;
                    document.getElementById('').innerText = "" + ajaxresp.jczyfy_tb;
                }
                else {
                    document.getElementById('').innerText = ajaxresp.zfy;
                    document.getElementById('').innerText = "";
                    document.getElementById('').innerText = "";
                    document.getElementById('').innerText = ajaxresp.ypf;
                    document.getElementById('').innerText = ajaxresp.hcf;
                    document.getElementById('').innerText = ajaxresp.zlf;
                    document.getElementById('').innerText = ajaxresp.cyrs;
                    document.getElementById('').innerText = "";
                    document.getElementById('').innerText = "";
                    document.getElementById('').innerText = ajaxresp.jczyfy;
                    document.getElementById('').innerText = "";
                    document.getElementById('').innerText = "";
                }
            }
        });
    }

    function gridJSListData()
    {
        var gridSort = '';
        var $gridJsList = $("");
        $gridJsList.dataGrid({
            height: 150,
            autowidth: true,//NếushrinkToFitChotruevà đã thiết lậpwidthGiá trị，thì chiều rộng mỗi cột sẽ theowidththu phóng theo tỷ lệ；
            shrinkToFit: true, //Nếu đặt làtrue，ThìGridchiều rộng sẽ tự tính lại theo chiều rộng của vùng chứa cha。**
            url: "",
            postData: getSearchData(),
            colModel: [
                { label: '', name: '',align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '',align: '' }
            ],
            sortname: gridSort,
            viewrecords: true
        });

        var gridSort = '';
        var $gridJsList = $("");
        $gridJsList.dataGrid({
            height: $(window).height() * 0.5 - 100,
            autowidth: true,//NếushrinkToFitChotruevà đã thiết lậpwidthGiá trị，thì chiều rộng mỗi cột sẽ theowidththu phóng theo tỷ lệ；
            shrinkToFit: true, //Nếu đặt làtrue，ThìGridchiều rộng sẽ tự tính lại theo chiều rộng của vùng chứa cha。**
            url: "",
            postData: getSearchData(),
            colModel: [
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' },
                { label: '', name: '', align: '' }
            ],
            sortname: gridSort,
            viewrecords: true,
            onSelectRow_page: function (rowid) {
            },
            gridComplete: function (gridJszbList) {

            },
            ondblClickRow: function (row) {
            }
        });

    }


    function initEcharts() {
        $.ajax({
            type: "",
            url: "",
            data: getSearchData(),
            dataType: "",
            success: function (ajaxresp) {
                var arr = [];
                arr.push('')
                for (var i = 0; i < ajaxresp.length; i++) {
                    arr.push(ajaxresp[i].nf);
                }
                //重新组装数据，处理不能映射饼图的问题
                let stat1 = [];
                stat1.push(arr)
                if (ajaxresp.length > 0) {
                    stat1.push(['', ajaxresp[0].次均总费用, ajaxresp[1].次均总费用, ajaxresp[2].次均总费用, ajaxresp[3].次均总费用, ajaxresp[4].次均总费用, ajaxresp[5].次均总费用, ajaxresp[6].次均总费用]);
                    stat1.push(['', ajaxresp[0].次均药费, ajaxresp[1].次均药费, ajaxresp[2].次均药费, ajaxresp[3].次均药费, ajaxresp[4].次均药费, ajaxresp[5].次均药费, ajaxresp[6].次均药费]);
                    stat1.push(['', ajaxresp[0].次均耗材费, ajaxresp[1].次均耗材费, ajaxresp[2].次均耗材费, ajaxresp[3].次均耗材费, ajaxresp[4].次均耗材费, ajaxresp[5].次均耗材费, ajaxresp[6].次均耗材费]);
                    stat1.push(['', ajaxresp[0].次均检验检查费, ajaxresp[1].次均检验检查费, ajaxresp[2].次均检验检查费, ajaxresp[3].次均检验检查费, ajaxresp[4].次均检验检查费, ajaxresp[5].次均检验检查费, ajaxresp[6].次均检验检查费]);
                    stat1.push(['', ajaxresp[0].次均治疗费, ajaxresp[1].次均治疗费, ajaxresp[2].次均治疗费, ajaxresp[3].次均治疗费, ajaxresp[4].次均治疗费, ajaxresp[5].次均治疗费, ajaxresp[6].次均治疗费]);
                    stat1.push(['', ajaxresp[0].次均其他费, ajaxresp[1].次均其他费, ajaxresp[2].次均其他费, ajaxresp[3].次均其他费, ajaxresp[4].次均其他费, ajaxresp[5].次均其他费, ajaxresp[6].次均其他费]);
                }
                var myChart = echarts.init(document.getElementById(''));
                window.addEventListener('', function () {
                    myChart.resize();
                });
                option = {
                    legend: {
                        orient: '',
                        bottom: ''
                    },
                    tooltip: {
                        trigger: '',
                        showContent: false
                    },
                    dataset: {
                        source: stat1
                    },
                    xAxis: { type: '' },
                    yAxis: { gridIndex: 0 },
                    grid: { top: '' },
                    series: [
                        {
                            type: '',
                            smooth: true,
                            seriesLayoutBy: '',
                            emphasis: { focus: '' }
                           
                        },
                        {
                            type: '',
                            smooth: true,
                            seriesLayoutBy: '',
                            emphasis: { focus: '' }
                        },
                        {
                            type: '',
                            smooth: true,
                            seriesLayoutBy: '',
                            emphasis: { focus: '' }
                        },
                        {
                            type: '',
                            smooth: true,
                            seriesLayoutBy: '',
                            emphasis: { focus: '' }
                        },
                        {
                            type: '',
                            smooth: true,
                            seriesLayoutBy: '',
                            emphasis: { focus: '' }
                        },
                        {
                            type: '',
                            smooth: true,
                            seriesLayoutBy: '',
                            emphasis: { focus: '' }
                        },
                        {
                            type: '',
                            id: '',
                            radius: '',
                            center: ['', ''],
                            emphasis: {
                                focus: ''
                            },
                            label: {
                                 //formatter: ''
                                formatter: "" + ajaxresp[0].nf+""
                            },  
                            encode: {
                                itemName: '',
                                value: ajaxresp[0].nf,
                                tooltip: ajaxresp[0].nf
                            }
                        }
                    ]
                };
                
                myChart.on('', function (event) {
                    const xAxisInfo = event.axesInfo[0];
                    if (xAxisInfo) {
                        const dimension = xAxisInfo.value + 1;
                        myChart.setOption({
                            series: {
                                id: '',
                                label: {
                                    formatter: '' + dimension + ''
                                },
                                encode: {
                                    value: dimension,
                                    tooltip: dimension
                                }
                            }
                        });
                    }
                });
                myChart.setOption(option);
            }
        })
    }
</script>

@{
    ViewBag.Title = "";
    Layout = "";
}
<head>
    <meta charset="utf-8">
    <script src=""></script>
    <style>

        .content {
            height: 49.5%;
            width: 100%;
            display: flex;
            flex-direction: row;
            justify-content: space-between;
        }

        .bk {
            border-radius: 10px;
            background-color: white;
        }
        .down_border {
            border-bottom: 1px solid #e6e6e6;
        }
        .ui-jqgrid .ui-jqgrid-bdiv {
            overflow-x: hidden;
        }
    </style>
</head>

<div class="panel panel-default">
    <input type="hidden" id="kssj" />
    <input type="hidden" id="jssj" />
    <table class="form">
        <tr>
            <th class="formTitle" id="xzsjtext">Loại：</th>
            <td class="formValue" style="width:150px">
                <select id="dateType" class="form-control" onchange="updateSjType()">
                    <option value="1">Năm</option>
                    <option value="2">Tháng</option>
                    <option value="3">Ngày</option>
                </select>
            </td>
            <th class="formTitle" id="xzsjtext">Thời gian：</th>
            <td class="formValue" style="width:150px">
                <input id="rSJ" type="text" class="form-control input-wdatepicker" @*onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"*@>
            </td>
            <th class="formTitle">Loại thuốc：</th>
            <td class="formValue" style="width:150px">
                <select id="ypsx" class="form-control">
                    <option value="Tất cả">Tất cả</option>
                    <option value="西药费">西药</option>
                    <option value="中药费">中药</option>
                    <option value="中成药费">中成药</option>
                </select>
            </td>

            <td class="formValue" style="padding-left:20px;">
                <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
            </td>

        </tr>
    </table>

</div>

<div id="main_div" style="display:flex;flex-wrap:wrap;align-content:space-between;">

    <div class="content">
        <div style="width:49.8%" class="bk">
            <div class="panel-heading down_border">
                <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>药品销量排名TOP50
            </div>
            <table id="gridJSListypxlpm"></table>
        </div>
        <div style="width:49.8%" class="bk">
            <div class="panel-heading down_border">
                <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>Lượng đơn mở bác sĩ
            </div>
            <table id="gridJSListyskdl"></table>
        </div>
    </div>

    <div class="content">
        <div style="width:49.8%;margin-bottom:2px" class="bk">
            <div class="panel-heading down_border">
                <i class="fa fa-table fa-lg" style="margin-right:5px;"></i>药品损益分析
            </div>
            <table id="gridJSListypsyfx"></table>
        </div>
        <div style="width:24.7%;" class="bk">
            <div class="panel-heading down_border">
                <i class="fa fa-pie-chart fa-lg" style="margin-right:5px;"></i>药品报损分析
            </div>
            <div id="main" style="height:370px" class="bk"></div>
        </div>
        <div style="width:24.7%;" class="bk">
            <div class="panel-heading down_border">
                <i class="fa fa-pie-chart fa-lg" style="margin-right:5px;"></i>药品报溢分析
            </div>
            <div id="main1" style="height:370px" class="bk"></div>
        </div>
    </div>

</div>

<script>
    var myDate = new Date();
    $(function () {
        $('').height($(window).height() - 60);
        $('').height($(window).height() * 0.5 - 118);
        $('').height($(window).height() * 0.5 - 118);
        init();
        gridJSListData();
        GetMonthNumChart();
     
       

    });

    function gridJSListData() {
        var gridSort = '';
        var $gridJsList = $("");
        var ypsx = $("").val();
        $gridJsList.dataGrid({
            height: $(window).height() * 0.5 - 118,
            postData: { kssj: $('').val(), jssj: $('').val(), type: ypsx},
            url: "",
            autowidth: true,//NếushrinkToFitChotruevà đã thiết lậpwidthGiá trị，thì chiều rộng mỗi cột sẽ theowidththu phóng theo tỷ lệ；
            shrinkToFit: true, //Nếu đặt làtrue，ThìGridchiều rộng sẽ tự tính lại theo chiều rộng của vùng chứa cha。**
            colModel: [
                { label: '', name: '', align: '', hidden: true },
                { label: '', name: '',align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '',align: '' }
            ],
            sortname: gridSort,
            viewrecords: true,
            onSelectRow_page: function (rowid) {
            },
            gridComplete: function (gridJszbList) {

            },
            onCellSelect: function (row) {
                var rowObj = $gridJsList.jqGrid('', row);
            
                var $gridysList = $("");
                $gridysList.jqGrid('', {
                    postData: { kssj: $('').val(), jssj: $('').val(), Ypcode: rowObj.ypdm},
                    page: 1,
                    url:"",
                }).trigger('');

            }, loadComplete: function (data) {
                if (data.length >0) {
                    var firstRow = data[0];
                    //var $gridysList = $("");
                    //$gridysList.jqGrid('', {
                    //    postData: { kssj: $('').val(), jssj: $('').val(), Ypcode: firstRow.ypdm },
                    //    page: 1,
                    //    url: "",
                    //}).trigger('');

                    var gridSort = '';
                    var $gridysList = $("");
                    $gridysList.dataGrid({
                        height: $(window).height() * 0.5 - 118,
                        autowidth: true,//NếushrinkToFitChotruevà đã thiết lậpwidthGiá trị，thì chiều rộng mỗi cột sẽ theowidththu phóng theo tỷ lệ；
                        shrinkToFit: true, //Nếu đặt làtrue，ThìGridchiều rộng sẽ tự tính lại theo chiều rộng của vùng chứa cha。**
                        url: "",
                        postData: { kssj: $('').val(), jssj: $('').val(), Ypcode: firstRow.ypdm },
                        colModel: [
                            { label: '', name: '', align: '' },
                            { label: '', name: '', align: '' },
                            { label: '', name: '', align: '' }
                        ],
                        sortname: gridSort,
                        viewrecords: true
                    });
                } else {
                    $("").jqGrid("", true);
                }
            }
        });
        
        var gridSort = '';
        var $ypsyfx = $("");
        $ypsyfx.dataGrid({
            height: $(window).height() * 0.5 - 118,
            postData: { kssj: $('').val(), jssj: $('').val() },
            url: "",
            autowidth: true,//NếushrinkToFitChotruevà đã thiết lậpwidthGiá trị，thì chiều rộng mỗi cột sẽ theowidththu phóng theo tỷ lệ；
            shrinkToFit: true, //Nếu đặt làtrue，ThìGridchiều rộng sẽ tự tính lại theo chiều rộng của vùng chứa cha。**
            colModel: [
                { label: '', name: '',align: '' },
                { label: '', name: '',align: '' },
                { label: '', name: '',align: '' }
            ],
            sortname: gridSort,
            viewrecords: true
        });

    }
    function init() {
        $("").val("");
        $('').attr('', "");
        $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1));
        getSearchData();
    }
    function initEcharts(bs,by) {
        var myChart = echarts.init(document.getElementById(''));
        var myChart1 = echarts.init(document.getElementById(''));
   
        var option = {
            tooltip: {
                trigger: ''
            },
            legend: {
                top: '',
                left: ''
            },
            series: [
                {
                    name: '',
                    type: '',
                    radius: ['', ''],
                    avoidLabelOverlap: false,
                    label: {
                        show: false,
                        position: ''
                    },
                    emphasis: {
                        label: {
                            show: true,
                            fontSize: 40,
                            fontWeight: ''
                        }
                    },
                    labelLine: {
                        show: false
                    },
                    data: bs,
                }
            ]
        };

        var option1 = {
            tooltip: {
                trigger: ''
            },
            legend: {
                top: '',
                left: ''
            },
            series: [
                {
                    name: '',
                    type: '',
                    radius: ['', ''],
                    avoidLabelOverlap: false,
                    label: {
                        show: false,
                        position: ''
                    },
                    emphasis: {
                        label: {
                            show: true,
                            fontSize: 40,
                            fontWeight: ''
                        }
                    },
                    labelLine: {
                        show: false
                    },
                    data: by,
                }
            ]
        };
        myChart.setOption(option);
        myChart1.setOption(option1);
    };
    
    function GetMonthNumChart() {
        var bs = [];
        var by = [];
        $.ajax({
            type: "",
            url: "",
            data: { kssj: $('').val(), jssj: $('').val()},
            dataType: "",
            async: false,
            success: function (lastdata) {
                if (lastdata != null) {
                    for (var i = 0; i < lastdata.length; i++) {
                        var obj = {};
                        if (lastdata[i].lsjze < 0) {
                            obj.name = lastdata[i].syyy;
                            obj.value = lastdata[i].sl;
                            bs[i] = obj;
                             
                        } else
                        {
                            obj.name = lastdata[i].syyy;
                            obj.value = lastdata[i].sl;
                            by[i] = obj;
                        }
                        
                        
                    }
                    initEcharts(bs, by);
                    
                }
            }
        });
    }
    function submit() {
        getSearchData();
        GetMonthNumChart();
        var $gridJsList = $("");
        $gridJsList.jqGrid('', {
            postData: { kssj: $('').val(), jssj: $('').val(), type: $('').val() },
        }).trigger('');

        var $gridJsListsy = $("");
        $gridJsListsy.jqGrid('', {
            postData: { kssj: $('').val(), jssj: $('').val(), type: $('').val() },
        }).trigger('');
    }

    //Thay đổi loại thời gian
    function updateSjType() {
        $('').val("");
        let dateType = $("").val();
        if (dateType == "") {//Năm
            $('').attr('', "");
            $('').val(myDate.getFullYear());
        }
        if (dateType == "") {//Tháng
            $('').attr('', "");
            $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1));
        }
        if (dateType == "") {//Ngày
            $('').attr('', "");
            $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1) + "" + myDate.getDate());
        }
        getSearchData();
    }

     //Lắp ráp tham số yêu cầu
    function getSearchData() {
        let ksrq = '';
        let jsrq = '';
        let dateType = $("").val();
        let nowDate = $("").val();
        if (dateType == "") {//Năm
            ksrq = nowDate + "" + "";
            jsrq = nowDate + "" + "";
        }
        if (dateType == "") {//Tháng
            let array = nowDate.split("");
            ksrq = array[0] + "" + array[1] + "";
            let days = getDaysInMonth(array[0], array[1]);
            jsrq = array[0] + "" + array[1] + "" + days + "";
        }
        if (dateType == "") {//Ngày
            ksrq = nowDate + "";
            jsrq = nowDate + "";
        }

        $('').val(ksrq);
        $('').val(jsrq);
    }

    //Lấy số ngày trong tháng theo năm tháng
    function getDaysInMonth(year, month) {
        return new Date(year, month, 0).getDate();
    }
</script>

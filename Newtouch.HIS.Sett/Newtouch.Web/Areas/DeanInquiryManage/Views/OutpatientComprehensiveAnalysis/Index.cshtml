@{
    ViewBag.Title = "";
    Layout = "";
}
<head>
    <meta charset="utf-8">
    <script src=""></script>

    <style>
        /*边框*/
        .bk {
            background-color: #ffffff;
        }
        /*Phông chữ*/
        .font {
            font-weight: bold;
            text-align: center;
        }
        .down_border {
            border-bottom: 1px solid #e6e6e6;
        }
    </style>

</head>

<div>
    <div class="panel panel-default">
        <table class="form">
            <tr>
                <th class="formTitle" id="xzsjtext">Loại：</th>
                <td class="formValue" style="width:150px">
                    <select id="dateType" class="form-control" onchange="updateSjType()">
                        <option value="1">Năm</option>
                        <option value="2">Tháng</option>
                        <option value="3">Ngày</option>
                    </select>
                </td>
                <th class="formTitle" id="xzsjtext">Thời gian：</th>
                <td class="formValue" style="width:150px">
                    <input id="rSJ" type="text" class="form-control input-wdatepicker" @*onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"*@>
                </td>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
            </tr>
        </table>
    </div>
    <div id="main_div">
        <div style="display:flex;justify-content:space-between;margin-top:20px;color:#ffffff;">
            <div style="width:19.8%;height:25%;text-align:center;background-color:#fc8675;">
                <h4>Lượt người ngoại trú(Lần)</h4>
                <div style="width:50%;height:62.5%;float:left;line-height:50px;" >
                    <text id="mzrc" style="font-size:20px;" class="font"></text>
                </div>
                <div style="width:50%;height:62.5%;float:right;">
                    <div style="height:50%;" class="font">
                        <text id="mzrc_hb" style="font-size:13px;"></text>
                    </div>
                    <div style="height:50%" class="font">
                        <text id="mzrc_tb" style="font-size:13px;"></text>
                    </div>
                </div>
            </div>

            <div style="width:19.6%;height:25%;text-align:center;background-color:#65cea7;">
                <h4>Số người ngoại trú(Người)</h4>
                <div style="width:50%;height:62.5%;float:left;line-height:50px;">
                    <text id="mzrs" style="font-size:20px;" class="font"></text>
                </div>
            </div>

            <div style="width:19.6%;height:25%;text-align:center;background-color:#f3ce85;">
                <h4>Tỷ lệ tái khám(%)</h4>
                <div style="width:50%;height:62.5%;float:left;line-height:50px;">
                    <text id="fzl" style="font-size:20px;" class="font"></text>
                </div>
            </div>

            <div style="width:19.6%;height:25%;text-align:center;background-color:#00c0ef;">
                <h4>诊次费用(đồng/Lần)</h4>
                <div style="width:50%;height:62.5%;float:left;line-height:50px;">
                    <text id="zcfy" style="font-size:20px;" class="font"></text>
                </div>
                <div style="width:50%;height:62.5%;float:right;">
                    <div style="height:50%;" class="font">
                        <text id="zcfy_hb" style="font-size:13px;"></text>
                    </div>
                    <div style="height:50%" class="font">
                        <text id="zcfy_tb" style="font-size:13px;"></text>
                    </div>
                </div>
            </div>

            <div style="width:19.6%;height:25%;text-align:center;background-color:#fc8675;">
                <h4>平均诊疗时长(Phút)</h4>
                <div style="width:50%;height:62.5%;float:left;line-height:50px;">
                    <text id="pjzlsc" style="font-size:20px;" class="font"></text>
                </div>
                <div style="width:50%;height:62.5%;float:right;">
                    <div style="height:50%;" class="font">
                        <text id="pjzlsc_hb" style="font-size:13px;"></text>
                    </div>
                    <div style="height:50%" class="font">
                        <text id="pjzlsc_tb" style="font-size:13px;"></text>
                    </div>
                </div>
            </div>

        </div>

        <div style="margin-top:20px;background-color:#ffffff;height:75%">
            @*<div style="text-align:left;" class="font">
                <span><img src="~/Content/img/report.png" style="width:30px;height:30px;"></span>
                <span style="margin-top: 20px;">Phân tích bệnh nhân ngoại trú</span>
            </div>*@
            <div class="panel-heading down_border" style="font-size: 15px;">
                <i class="fa fa-area-chart fa-lg" style="padding-right:5px;"></i>Phân tích bệnh nhân ngoại trú
            </div>
            <div style="display:flex;width:100%;justify-content:space-between;background-color: #f1f4f6;height:100%">
                <div id="main1" style="width:33%;height:100%;display:flex;justify-content:center;margin-bottom:2px;padding-top:30px;" class="bk"></div>
                <div id="main2" style="width:33%;height:100%;display:flex;justify-content:center;margin-bottom:2px;padding-top:30px;" class="bk"></div>
                <div id="main3" style="width:33%;height:100%;display:flex;justify-content:center;margin-right:2px;margin-bottom:2px;padding-top:30px;" class="bk"></div>
            </div>

        </div> 

    </div>

</div>

<script>

    var myDate = new Date();
    $(function () {
        $('').height($(window).height() - 60);
        //Mặc định đặt loại thời gian là tháng
        $("").val("");
        $('').attr('', "");
        $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1));
        
        getData();
        initEcharts();
    });
    function submit() {
        getData();
        initEcharts();
    }
    //Thay đổi loại thời gian
    function updateSjType() {
        $('').val("");
        let dateType = $("").val();
        if (dateType == "") {//Năm
            $('').attr('', "");
            $('').val(myDate.getFullYear());
        }
        if (dateType == "") {//Tháng
            $('').attr('', "");
            $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth())+1));
        }
        if (dateType == "") {//Ngày
            $('').attr('', "");
            $('').val(myDate.getFullYear() + "" + (parseInt(myDate.getMonth()) + 1) + "" + myDate.getDate());
        }
    }
    //Lấy số ngày trong tháng theo năm tháng
    function getDaysInMonth(year, month) {
        return new Date(year, month, 0).getDate();
    }
    //抬头
    function getData()
    {
        $.ajax({
            type: "",
            url: "",
            dataType: "",
            data: getSearchData(),
            success: function (ajaxresp) {
                if ($("").val() == "") {
                    document.getElementById('').innerText = ajaxresp.mzrc;
                    document.getElementById('').innerText = "" + ajaxresp.mzrc_hb + "";
                    document.getElementById('').innerText = "" + ajaxresp.mzrc_tb + "";
                    document.getElementById('').innerText = ajaxresp.mzrs;
                    document.getElementById('').innerText = ajaxresp.fzl;
                    document.getElementById('').innerText = ajaxresp.zcfy;
                    document.getElementById('').innerText = "" + ajaxresp.zcfy_hb + "";
                    document.getElementById('').innerText = "" + ajaxresp.zcfy_tb + "";
                    document.getElementById('').innerText = ajaxresp.pjzlsc;
                    document.getElementById('').innerText = "" + ajaxresp.pjzlsc_hb + "";
                    document.getElementById('').innerText = "" + ajaxresp.pjzlsc_tb + "";
                }
                else {
                    document.getElementById('').innerText = ajaxresp.mzrc;
                    document.getElementById('').innerText = "";
                    document.getElementById('').innerText = "";
                    document.getElementById('').innerText = ajaxresp.mzrs;
                    document.getElementById('').innerText = ajaxresp.fzl;
                    document.getElementById('').innerText = ajaxresp.zcfy;
                    document.getElementById('').innerText = "";
                    document.getElementById('').innerText = "";
                    document.getElementById('').innerText = ajaxresp.pjzlsc;
                    document.getElementById('').innerText = "";
                    document.getElementById('').innerText ="";
                }
            }
        });
    }
    //Lắp ráp tham số yêu cầu
    function getSearchData() {
        let ksrq = '';
        let jsrq = '';
        let dateType = $("").val();
        let nowDate = $("").val();
        if (dateType == "") {//Năm
            ksrq = nowDate + "" + "";
            jsrq = nowDate + "" + "";
        }
        if (dateType == "") {//Tháng
            let array = nowDate.split("");
            ksrq = array[0] + "" + array[1] + "";
            let days = getDaysInMonth(array[0], array[1]);
            jsrq = array[0] + "" + array[1] + "" + days + "";
        }
        if (dateType == "") {//Ngày
            ksrq = nowDate + "";
            jsrq = nowDate + "";
        }
        return { ksrq: ksrq, jsrq: jsrq, rtype: dateType };
    }
    function initEcharts()
    {
        $.ajax({
            type: "",
            url: "",
            data: getSearchData(),
            dataType: "",
            success: function (ajaxresp) {
                var myChart2 = echarts.init(document.getElementById(''));
                var myChart3 = echarts.init(document.getElementById(''));
                var myChart1 = echarts.init(document.getElementById(''));

                var option1 = {
                    title: {
                        text: '',
                        left: ''
                    },
                    tooltip: {//tooltip 鼠标移动到图上显示的标签
                        trigger: ''
                    },
                    legend: {//左边数据（图例）
                        orient: '',
                        bottom: ''
                    },
                    series: [
                        {
                            name: '',
                            type: '',
                            radius: '',
                            data: [
                                { value: ajaxresp.hzxzb_yb, name: '' },
                                { value: ajaxresp.hzxzb_zf, name: '' }
                            ],
                            emphasis: {// 高亮样式
                                itemStyle: {
                                    shadowBlur: 10,
                                    shadowOffsetX: 0,
                                    shadowColor: ''
                                }
                            }
                        }
                    ]
                };

                var option2 = {
                    title: {
                        text: '',
                        subtext: '',
                        left: ''
                    },
                    tooltip: {//tooltip 鼠标移动到图上显示的标签
                        trigger: ''
                    },
                    legend: {//左边数据（图例）
                        orient: '',
                        bottom: ''
                    },
                    series: [
                        {
                            name: '',
                            type: '',
                            radius: '',
                            data: [
                                { value: ajaxresp.mzhzxbzb_m, name: '' },
                                { value: ajaxresp.mzhzxbzb_w, name: '' }
                            ],
                            emphasis: {
                                itemStyle: {
                                    shadowBlur: 10,
                                    shadowOffsetX: 0,
                                    shadowColor: ''
                                }
                            }
                        }
                    ]
                };

                var option3 = {
                    title: {
                        text: '',
                        left: ''
                    },
                    tooltip: {

                    },
                    xAxis: {
                        data: ["", "", "", "", ""]
                    },
                    yAxis: {},
                    series: [{
                        barWidth: '',
                        name: '',
                        type: '',
                        data: [ajaxresp.age_3, ajaxresp.age_3_16, ajaxresp.age_17_65, ajaxresp.age_65_75, ajaxresp.age_75]
                    }]
                };

                myChart1.setOption(option1);
                myChart2.setOption(option2);
                myChart3.setOption(option3);
            }
        });
    }
</script>

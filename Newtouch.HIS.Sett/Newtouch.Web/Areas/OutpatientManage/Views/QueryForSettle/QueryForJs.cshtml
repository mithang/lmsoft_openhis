@{
    ViewBag.Title = "";
    Layout = "";
}
@Html.Partial("")
<style>
    table tr td span {
        font-size:25px;
        color:lightcoral;
    }
</style>
<div class="panel">
    <div style="border-bottom:1px solid rgb(221, 221, 221);">
        <table class="form">
            <tr>
                <th class="formTitle">Tra cứu loại：</th>
                <td class="formValue">
                    <select id="jslx" class="form-control">
                        <option value="0">Chưa quyết toán</option>
                        <option value="1">Đã quyết toán</option>
                    </select>
                </td>
                <th class="formTitle">Số bảo hiểm xã hội：</th>
                <td class="formValue">
                    <input id="sbbh" name="sbbh" type="text" class="form-control" placeholder="Vui lòng nhập số hiệu bảo hiểm xã hội" />
                </td>
                <td>
                    <input type="button" id="btn_search" class="btn btn-primary form-an" style="width:40%;margin-left:10%;" value="Tra cứu" />
                </td>
                <td></td>
                <td></td>
            </tr>           
        </table>
    </div>
    <div id="wjs" style="border-bottom:1px solid rgb(221, 221, 221);margin-top:20px;">
        <table class="table" id="tb1">
            <tr>
                <th class="formTitle">Số bảo hiểm xã hội</th>
                <th class="formTitle">Mã bệnh viện</th>
                <th class="formTitle">Số quyết toán</th>
                <th class="formTitle">Tên tính chất chi phí</th>
                <th class="formTitle">Có tự chi trả không</th>
            </tr>
            <tr>                
                <td><span id="DAC001"></span></td>
                <td><span id="AAZ107"></span></td>
                <td><span id="DKE005"></span></td>
                <td><span id="AKE556_C"></span></td>
                <td><span id="DKE164"></span></td>
            </tr>
            <tr>
                <th class="formTitle">Tên tính chất bảo hiểm y tế</th>
                <th class="formTitle">Tên loại bảo hiểm y tế</th> 
                <th class="formTitle">Tổng chi phí</th>
                <th class="formTitle">Thanh toán tiền mặt</th>
                <th class="formTitle">一般可报费用</th>
            </tr>
            <tr>
                <td><span id="DKC003_C"></span></td>
                <td><span id="DKC002_C"></span></td>
                <td><span id="ZFY"></span></td>
                <td><span id="XJZF"></span></td>
                <td><span id="YBFY"></span></td>
            </tr>
            <tr>
                <th class="formTitle">Chi phí tổng đặc biệt</th>
                <th class="formTitle">特殊自理费用</th>
                <th class="formTitle">基本帐户支付</th>
                <th class="formTitle">公补帐户支付</th>
                <th class="formTitle">Thời gian quyết toán</th>
            </tr>
            <tr>
                <td><span id="TSFY"></span></td>
                <td><span id="TSFYZL"></span></td>
                <td><span id="JBZF"></span></td>
                <td><span id="GBZF"></span></td>
                <td><span id="AKE293"></span></td>
            </tr>
        </table>
    </div>
    <div id="yjs" style="border-bottom:1px solid rgb(221, 221, 221);margin-top:20px;display:none;height:500px;overflow-y:auto">
        <table class="table" id="tb2">
            <tr>
                <th>Số bảo hiểm xã hội</th>
                <th>Mã bệnh viện</th>
                <th>Số quyết toán</th>
                <th>Tính chất chi phí</th>
                <th>Có tự chi trả không</th>
                <th>Tính chất bảo hiểm y tế</th>
                <th>Loại bảo hiểm y tế</th>
                <th>Thời gian quyết toán</th>
                <th>Tổng chi phí</th>
                <th>Thanh toán tiền mặt</th>
                <th>一般可报费用</th>
                <th>Chi phí tổng đặc biệt</th>
                <th>特殊自理费用</th>
                <th>基本帐户支付</th>
                <th>公补帐户支付</th>
            </tr>
        </table>
    </div>
</div>
<script type="">
    $("").click(function () {  
        var jslx = $("").val();//Loại quyết toán
        var sbbh = $("").val();//Số bảo hiểm xã hội
        if (sbbh == "") {
            $.modalAlert("", '');
            return false;
        }
        $.loading(true);
        setTimeout(function () {
            if (jslx == "") {
                $("").show()
                $("").hide();
                var wjsobj = $.yibao.QUnSettleFee(sbbh);
                $.loading(false);
                if (wjsobj && wjsobj.Code == 0) {
                    $("").html(wjsobj.Data.DAC001);
                    $("").html(wjsobj.Data.AAZ107);
                    $("").html(wjsobj.Data.DKE005);
                    $("").html(wjsobj.Data.AKE556_C);
                    $("").html(wjsobj.Data.DKE164);
                    $("").html(wjsobj.Data.DKC003_C);
                    $("").html(wjsobj.Data.DKC002_C);
                    $("").html(wjsobj.Data.AKE293);
                    $("").html(wjsobj.Data.ZFY);
                    $("").html(wjsobj.Data.XJZF);
                    $("").html(wjsobj.Data.YBFY);
                    $("").html(wjsobj.Data.TSFY);
                    $("").html(wjsobj.Data.TSFYZL);
                    $("").html(wjsobj.Data.JBZF);
                    $("").html(wjsobj.Data.GBZF);
                }
                else {
                    $("").html("");
                    $("").html("");
                    $("").html("");
                    $("").html("");
                    $("").html("");
                    $("").html("");
                    $("").html("");
                    $("").html("");
                    $("").html("");
                    $("").html("");
                    $("").html("");
                    $("").html("");
                    $("").html("");
                    $("").html("");
                    $("").html("");
                }
            }
            else {
                $("").hide()
                $("").show();
                $("").empty("");
                var jsobj = $.yibao.QSettleFee(sbbh);
                $.loading(false);
                if (jsobj && jsobj.Code == 0) {
                    var tb = document.getElementById("");
                    var td;
                    for (var i = 0; i < jsobj.Data.length; i++) {
                        var tr = tb.insertRow(i + 1);//Thêm dòng mới，iThì là vị trí của thêm cần
                        td = tr.insertCell();
                        td.innerHTML = jsobj.Data[i].DAC001;
                        td = tr.insertCell();
                        td.innerHTML = jsobj.Data[i].AAZ107;
                        td = tr.insertCell();
                        td.innerHTML = jsobj.Data[i].DKE005;
                        td = tr.insertCell();
                        td.innerHTML = jsobj.Data[i].AKE556_C;
                        td = tr.insertCell();
                        td.innerHTML = jsobj.Data[i].DKE164;
                        td = tr.insertCell();
                        td.innerHTML = jsobj.Data[i].DKC003_C;
                        td = tr.insertCell();
                        td.innerHTML = jsobj.Data[i].DKC002_C;
                        td = tr.insertCell();
                        td.innerHTML = jsobj.Data[i].AKE293;
                        td = tr.insertCell();
                        td.innerHTML = jsobj.Data[i].ZFY;
                        td = tr.insertCell();
                        td.innerHTML = jsobj.Data[i].XJZF;
                        td = tr.insertCell();
                        td.innerHTML = jsobj.Data[i].YBFY;
                        td = tr.insertCell();
                        td.innerHTML = jsobj.Data[i].TSFY;
                        td = tr.insertCell();
                        td.innerHTML = jsobj.Data[i].TSFYZL;
                        td = tr.insertCell();
                        td.innerHTML = jsobj.Data[i].JBZF;
                        td = tr.insertCell();
                        td.innerHTML = jsobj.Data[i].GBZF;
                    }
                }
            }
        }, 1000);
    })
</script>

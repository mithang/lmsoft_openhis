@{
    ViewBag.Title = "Hủy đăng ký khám";
    Layout = "~/Views/Shared/_Index.cshtml";
}
@Html.Partial("_YibaoCommonView")
<style>
    table tr td {
        word-wrap: break-word;
        word-break: break-all;
    }
</style>
<div style="display: flex;flex-direction:row;">
    <section class="panel" style="width:50%;">
        <header class="panel-heading">
            Tra cứu thông tin thẻ
        </header>
        <div class="panel-body" style="width:100%">
            <div style="display: flex;flex-direction:column;align-items:center;">
                <div style="margin-bottom:10px;width:100%;text-align:center;">
                    <i class="fa fa-address-card-o" style="font-size:40px"></i>
                </div>
                <div style="text-align:center;margin-bottom:20px;">
                    <span id="btn_getcard" class="btn btn-primary" style="height:50px;font-size:25px;">Tra cứu thông tin thẻ</span>
                </div>
                <div style="text-align:center;margin-bottom:10px;width:100%">
                    <div id="cardinfo" style="border-bottom:1px solid rgb(221, 221, 221);overflow:auto">
                        <table class="table">
                            <tr>
                                <th>Loại giấy tờ</th>
                                <th>Số giấy tờ</th>
                                <th>Họ tên</th>
                                <th>Số điện thoại di động</th>
                                <th>Nơi cư trú</th>
                                <th>Số BHXH</th>
                                <th>Số dư tài khoản cơ bản</th>
                            </tr>
                            <tr>
                                <td id="AAA029_C"></td>
                                <td id="AAE135"></td>
                                <td id="AAC003"></td>
                                <td id="DAC304"></td>
                                <td id="AAE006"></td>
                                <td id="DAC001"></td>
                                <td id="JBZHYE"></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="panel" style="width:50%;">
        <header class="panel-heading">
            Hủy đăng ký khám BHYT
        </header>
        <div class="panel-body" style="width:100%">
            <div style="display: flex;flex-direction:column;align-items:center;">
                <div style="margin-bottom:10px;width:100%;text-align:center;">
                    <i class="fa fa-user-times" style="font-size:40px"></i>
                </div>
                <div style="width:70%;margin-bottom:20px;">
                    <input id="jsh" name="jsh" type="text" class="form-control" placeholder="Vui lòng nhập số quyết toán" />
                </div>
                <div style="text-align:center;margin-bottom:10px;">
                    <span id="btn_denyreg" class="btn btn-primary" style="height:50px;font-size:25px;">Hủy đăng ký khám BHYT</span>
                </div>
                <div style="text-align:center;margin-bottom:10px;">
                    <span id="message" class="btn" style="font-size:15px;color:coral;display:inline-block;width:80%;word-wrap:break-word;white-space:normal;"></span>
                </div>
            </div>
        </div>
    </section>
</div>
<div style="display: flex;flex-direction:row;">
    <section class="panel" style="width:50%;">
        <header class="panel-heading">
            Tra cứu danh mục BHYT
        </header>
        <div class="panel-body" style="width:100%">
            <div style="display: flex;flex-direction:column;align-items:center;">
                <div style="margin-bottom:10px;width:100%;text-align:center;">
                    <i class="fa fa-folder-open-o" style="font-size:30px"></i>
                </div>
                <div style="width:100%;margin-bottom:10px;display: flex;flex-direction:row;align-items:center;">
                    <input id="DKE085" type="text" class="form-control" placeholder="Vui lòng nhập loại hạng mục" />&nbsp;&nbsp;&nbsp;
                    <input id="DKE166" type="text" class="form-control" placeholder="Vui lòng nhập mã phía BHXH" />
                </div>
                <div style="width:100%;margin-bottom:20px;display: flex;flex-direction:row;align-items:center;">
                    <input id="DKE012" type="text" class="form-control" placeholder="Vui lòng nhập mã phía bệnh viện" />&nbsp;&nbsp;&nbsp;
                    <input id="AKE002" type="text" class="form-control" placeholder="Vui lòng nhập tên hạng mục" />
                </div>
                <div style="text-align:center;margin-bottom:10px;">
                    <span id="btn_qcatalog" class="btn btn-primary" style="height:50px;font-size:25px;">Tra cứu danh mục BHYT</span>
                </div>
            </div>
        </div>
    </section>
    <section class="panel" style="width:50%;">
        <header class="panel-heading">
            Danh mục BHYT
            <i class="fa fa-copy" style="font-size:20px" onclick="Copy(document.getElementById('catalog'));"></i>
        </header>
        <div class="panel-body" style="width:100%">
            <div style="display: flex;flex-direction:column;align-items:center;">
                <div style="margin-bottom:10px;width:100%;text-align:center;height:200px;overflow-y:auto">
                    <span style="word-wrap:break-word;white-space:normal;width:100%;" id="catalog"></span>
                </div>
            </div>
        </div>
    </section>
</div>
<div style="display: flex;flex-direction:row;">
    <section class="panel" style="width:50%;">
        <header class="panel-heading">
            HủyHISĐăng ký khám
        </header>
        <div class="panel-body" style="width:100%">
            <div style="display: flex;flex-direction:column;align-items:center;">
                <div style="margin-bottom:10px;width:100%;text-align:center;">
                    <i class="fa fa-user-times" style="font-size:40px"></i>
                </div>
                <div style="width:70%;margin-bottom:20px;">
                    <input id="ghmzh" name="ghmzh" type="text" class="form-control" placeholder="Vui lòng nhậpHISSố khám ngoại trú" />
                </div>
                <div style="text-align:center;margin-bottom:10px;">
                    <span id="btn_denyhisreg" class="btn btn-primary" style="height:50px;font-size:25px;">HủyHISĐăng ký khám</span>
                </div>
            </div>
        </div>
    </section>
    <section class="panel" style="width:50%;">
        <header class="panel-heading">
            Kiểm tra kết nối BHYT
        </header>
        <div class="panel-body" style="width:100%">
            <div style="display: flex;flex-direction:column;align-items:center;">
                <div style="text-align:center;margin-bottom:10px;">
                    <span id="btn_YibaoConnectedTest" class="btn btn-primary" style="height:50px;font-size:25px;">Kiểm tra kết nối BHYT</span>
                </div>
            </div>
        </div>
    </section>
</div>
<script type="text/javascript">
    //Tra cứu thông tin thẻ
    $("#btn_getcard").click(function () {
        $.loading(true);
        setTimeout(function () {
            var card = $.yibao.GetCardInfo(null);
            $.loading(false);
            if (card && card.Code == 0) {
                $("#AAA029_C").html(card.Data.AAA029_C);
                $("#AAE135").html(card.Data.AAE135);
                $("#AAC003").html(card.Data.AAC003);
                $("#DAC304").html(card.Data.DAC304);
                $("#AAE006").html(card.Data.AAE006);
                $("#DAC001").html(card.Data.DAC001);
                $("#JBZHYE").html(card.Data.JBZHYE);
            } else {
                $("#AAA029_C").html("Không");
                $("#AAE135").html("Không");
                $("#AAC003").html("Không");
                $("#DAC304").html("Không");
                $("#AAE006").html("Không");
                $("#DAC001").html("Không");
                $("#JBZHYE").html("Không");
            }
        }, 1000);
    });
    //Hủy đăng ký khám
    $("#btn_denyreg").click(function () {
        $("#message").html("");
        var jsh = $("#jsh").val();//Số quyết toán
        if (jsh == "") {
            $.modalAlert("Số quyết toán không được trống", 'warning');
            return false;
        } else {
            $.loading(true);
            setTimeout(function () {
                var denyreg = $.yibao.DenyReg(jsh);
                $.loading(false);
                if (denyreg && denyreg.Code == 0) {
                    $("#message").html("Thao tác thành công");
                } else {
                    $("#message").html(denyreg.ErrorMsg);
                }
            }, 1000);
        }
    });
    //Tra cứu danh mục BHYT
    $("#btn_qcatalog").click(function () {
        var DKE085 = $("#DKE085").val();//Loại hạng mục
        var DKE166 = $("#DKE166").val();//Mã phía BHXH
        var DKE012 = $("#DKE012").val();//Mã phía bệnh viện
        var AKE002 = $("#AKE002").val();//Tên hạng mục
        if (DKE085 == "") {
            $.modalAlert("Loại hạng mục không được trống", 'warning');
            return false;
        }
        if (DKE166 == "" && DKE012 == "" && AKE002 == "") {
            $.modalAlert("Mã phía BHXH/Mã phía bệnh viện/Tên hạng mục ít nhất có một mục", 'warning');
            return false;
        }
        $.loading(true);
        setTimeout(function () {
            var obj = $.yibao.QCatalog(DKE085, DKE166, DKE012, AKE002);
            $.loading(false);
            if (obj) {
                $("#catalog").html(obj);
            }
        }, 1000);
    });
    //Sao chép vào bảng tạm
    function Copy(obj) {
        var rng = document.body.createTextRange();
        rng.moveToElementText(obj);
        rng.scrollIntoView();
        rng.select();
        rng.execCommand("Copy");
        rng.collapse(false);
    }
    //HủyHISĐăng ký khám
    $('#btn_denyhisreg').click(function () {
        var ghmzh = $("#ghmzh").val();//Số khám ngoại trú đăng ký khám
        if (!!!ghmzh) {
            $.modalAlert("Số khám ngoại trú không được trống", 'warning');
            return false;
        } else {
            $.najax({
                type: "POST",
                data: {
                    mzh: ghmzh
                },
                url: "/OutpatientManage/OutpatientReg/UnSettedRegBackNum",
                dataType: "json",
                loadingtext: "Đang yêu cầuHISHủy đăng ký khám，Vui lòng chờ…",
                success: function (ajaxresp) {
                    $.modalAlert('Ngoại trúHISTrả số khám thành công', 'success');
                    $("#ghmzh").val('');
                    return;
                }
            });
        }
    });
    //Kiểm tra kết nối BHYT
    $('#btn_YibaoConnectedTest').click(function () {
        $.najax({
            type: "POST",
            url: "/OutpatientManage/OutpatCharge/YibaoConnectedTest",
            dataType: "json",
            loadingtext: "Đang yêu cầu kiểm tra kết nối BHYT，Vui lòng chờ…",
            success: function (ajaxresp) {
                $.modalAlert('' + JSON.stringify(ajaxresp));
                return;
            }
        });
    });
</script>

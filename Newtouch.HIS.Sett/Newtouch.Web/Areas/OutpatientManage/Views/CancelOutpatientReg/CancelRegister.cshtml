
@{
    ViewBag.Title = "";
    Layout = "";
}
<form>
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form">
            <tr>
                <th class="formTitle">Số bệnh án：</th>
                <td class="formValue">
                    <input type="text" class="form-control form-an" id="blh" />
                </td>
                <th class="formTitle">Họ tên/Phiên âm：</th>
                <td class="formValue">
                    <input type="text" class="form-control form-an" id="xm" />
                </td>
                <th class="formTitle">Đăng ký thời gian：</th>
                <td class="formValue" colspan="2">
                    <input id="kssj" type="text" class="form-control input-wdatepicker form-an" style="width:42%; float:left;" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    <span style="margin-left:1%;float:left;">—</span>
                    <input id="jssj" type="text" class="form-control input-wdatepicker form-an" style="width :42%;float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                </td>
                <td class="formValue">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary form-an" style="width: 50px; margin-left: 40px;" value="Tra cứu" />
                </td>
            </tr>
        </table>
    </div>
    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>
@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 4, 8 },
    F8Text = ""
})
<script>
    $(function () {
        gridList();
    });

    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            postData: getSearchPostData(),
            height: $(window).height() - 195,
            colModel: [
                { label: '', name: '', width: 120, align: '', hidden: true },
                { label: '', name: '', width: 90, align: '' },
                { label: '', name: '', width: 90, align: '' },
                { label: '', name: '', width: 90, align: '' },
                {
                    label: '', name: '', width: 80, align: '',
                    formatter: function (cellvalue) {
                        return $.getGender(cellvalue);
                    }
                },
                {
                    label: '', name: '', width: 100, align: '',
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 160, align: '' },
                {
                    label: '', name: '', width: 140, align: '',
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },

            ],
            pager: "",
            sortname: '',
            multiselect: true,
            viewrecords: true,
        });
        $("").click(function () {
            if ($('').val() && $('').val() && ($('').val() > $('').val())) {
                $.modalAlert("", '');
                return;
            }
            $gridList.jqGrid('', {
                postData: getSearchPostData(),
            }).trigger('');
        });
    }

    //Điều kiện tra cứu
    function getSearchPostData() {
        var blh = $("").val();
        var xm = $("").val();
        var kssj = $("").val();
        var jssj = $("").val();
        return { blh: blh, xm: xm, kssj: kssj, jssj: jssj };

    }

    //Hủy đăng ký
    function newtouch_event_f8() {
        var data = $("").jqGrid('', undefined, false);
        if (data == "") {
            return;
        }
        var ids = $("").jqGrid("", "");
        if (!ids || ids.length == 0) {
            $.modalAlert("", '');
            return false;
        }
        var arraryData = [];
        for (var i = 0; i < ids.length; i++) {
            var rowData = $("").jqGrid('', ids[i]);
            arraryData.push({ ghnm: rowData.ghnm });
        }
        $.najax({
            url: "",
            dataType: "",
            data: { list: arraryData },
            type: "",
            async: false,
            success: function (data) {
                $.loading(false);
                //刷新未回收列表
                $('').trigger('');
                $.modalAlert('', '');
            },
            errCallback: function (err) {
                $.loading(false);
            }
        });

    }

</script>

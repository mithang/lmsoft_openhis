
@{
    ViewBag.Title = "";
    Layout = "";
}
<style>
   .table-responsive{
        border:0;
    }
</style>

<!--Danh sách hóa đơn-->
<form id="tabGrid" style="margin:2px;margin-top:10px;">
    <div class="gridPanel">
        <table id="gridListFPH" rel="tabGrid"></table>
    </div>
</form>

<script> 
     
    $(function () {
        var fapiaodata = localStorage.getItem("");
        gridListFPH(JSON.parse(fapiaodata));
    });

    //Tải danh sách hóa đơn
    function gridListFPH(mydata) {
        var $gridList = $("");
        $gridList.dataNewGrid({
            height: 500, 
            caption: "",
            colModel: [
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                {
                    label: '', name: '', width: 100, align: '', formatter: function (cellvalue) {
                        return cellvalue && cellvalue.length >= 10 ? cellvalue.substring(0, 10) : ""
                    }
                },
                { label: '', name: '', width: 100, align: '' }
            ]
        }, mydata);
        if (mydata.length > 0) {
            $('').find("").remove();
        }
    }

 

    //Sự kiện nhấn chuột danh sách hóa đơn 
    function btn_edit() {
        var data = $("").jqGridRowValue();
        if (data) {
            //input控件取消了，Đặt ởtdTrong
            $.currentWindow().loadFpData(data); //主页中的方法
            PatSearchConfirm();
          
        } else {
            $.modalAlert("", "");
        }

    }

    //Xác nhận Gọi từ trang chính
    function PatSearchConfirm() {
        var $gridList = $("");
        var kh = $gridList.jqGridRowValue().kh;
        var zyh = $gridList.jqGridRowValue().zyh;
        var xm = $gridList.jqGridRowValue().xm;
        var obj = new Object();
        obj.kh = kh;
        obj.zyh = zyh;
        obj.xm = xm; 
        //Đóng cửa sổ
        ReceiptCancle();
    }

    //Hủy
    function ReceiptCancle() {
        $.modalClose();
    }
</script>


@{
    ViewBag.Title = "";

    Layout = "";
}

<style>
    thead tr th {
        background-color: #eee;
        line-height: 30px;
        padding-left: 15px;
    }

    tbody tr td {
        line-height: 30px;
        padding-left: 15px;
    }

    .cellvalue {
        width: 90%;
        line-height: 25px;
    }

    .redBord {
        border-color: red;
    }
</style>
<div class="panel panel-default" style="margin-bottom:0;">
    <div class="panel-heading navb-bg">
        Tra cứu hoàn phí ngoại trú
    </div>
    <div style="padding: 2px;padding-right:20px;">
        <table class="form" style="width:96%;">
            <tr>
                <td class="formTitle">Số thẻ：</td>
                <td class="formValue">
                    <input id="kh" type="text" class="form-control form-control-focus" placeholder="Vui lòng nhập số thẻ">

                </td>
                <td class="formTitle">Từ：</td>
                <td class="formValue">

                    <input class="form-control input-wdatepicker" type="text" onfocus="WdatePicker({
                                onpicked: function () {getAge($(this).val());return true;}})" id="ks" value="@DateTime.Now.AddMonths(-1).ToString("yyy-MM-dd")" />
                </td>
                <td class="formTitle">Đến：</td>
                <td class="formValue">
                    <input class="form-control input-wdatepicker" type="text" onfocus="WdatePicker({
                                onpicked: function () {getAge($(this).val());return true;}})" id="js" value="@DateTime.Now.AddDays(1).ToString("yyy-MM-dd")" />
                </td>
                <td class="formTitle"></td>
                <td class="formValue">
                    <button id="BtnQuery" class="btn btn btn-default btn-md dropdown-text">Tra cứu</button>
                </td>
            </tr>
        </table>
    </div>
</div>
<br />
<form id="tabGrid">
    <table class="form" style="border:solid 1px #ddd;" id="tableStyle">
        <thead>
            <tr>
                <th>Loại bệnh nhân</th>
                <th>Khoa đăng ký khám</th>
                <th>Bác sĩ</th>
                <th>Số hóa đơn</th>
                <th>Ghi sổ</th>
                <th>Tự chi trả</th>
                <th>Tự chi trả theo phân loại</th>
                <th>Tự chi trả</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td id="brlx"></td>
                <td id="ghks"></td>
                <td id="ys"></td>
                <td id="fph"></td>
                <td id="jz"></td>
                <td id="zifei"></td>
                <td id="flzf"></td>
                <td id="zf"></td>
            </tr>
        </tbody>
    </table>
    <br />
    <div class="gridPanel">
        <table id="gridListTuifei" rel="tabGrid"></table>
    </div>
</form>

<br />
<div class="panel panel-default" style="margin-bottom:0;">
    <div class="panel-heading navb-bg">
        Hoàn phí
    </div>
    <div style="padding: 2px;padding-right:20px;">
        <table class="form" style="width:96%;">
            <tr>
                <td class="formTitle">Tự chi trả：</td>
                <td class="formValue">
                    <input class="form-control newtouch_Readonly" type="text" id="zifu" value="" />
                </td>
                <td class="formTitle">应退：</td>
                <td class="formValue">
                    <input class="form-control newtouch_Readonly" type="text" id="yingtui" value="" />
                </td>
                <td class="formTitle"></td>
                <td class="formValue"></td>
                <td class="formTitle"></td>
                <td class="formValue"></td>
            </tr>
        </table>
    </div>
</div>

@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 4, 6 },
    F6Text = ""
})

<script>

    $(function() {
        //Tải lại khi thay đổi kích thước cửa sổ trình duyệtjqGridchiều rộng của
        $(window).resize(function() {
            initLayout("");
        });

        var txt_keyword = document.getElementById('');
        txt_keyword.addEventListener('',
            function(event) {
                event = event || window.event;
                if (event.keyCode === 13) {

                    btnQueryFph();
                }
            });

        //Xóa trống
        newtouch_event_f4();

        $("").html("");
        gridListTuifei([]); //Danh sách hoàn phí


        //Tra cứu
        $("").click(function() {
            clearFPYSInfo();
            if ($("").val() === "") {
                $.modalAlert("", "");
                return;
            }
            btnQueryFph();

        });
    });

    var jsnm; //获取从弹出窗口中得到的结算内码

    //Xóa trống thông tin bác sĩ hóa đơn
    function clearFPYSInfo() {
        $("").html("");
        $("").html("");
        $("").html("");
        $("").html("");
        $("").html("");
        $("").html("");
        $("").html("");
        $("").html("");
    }

    function btnQueryFph() {
        var obj = new Object;
        obj.kh = $.trim($("").val());
        obj.startTime = $.trim($("").val());
        obj.endTime = $.trim($("").val());
        GetQueryFphAjax(obj);
    }

    //Tra cứu hóa đơn
    function GetQueryFphAjax(obj) {
        $.loading(true, ""); 
        $.najax({
            type: "",
            url: ""btnQueryFph"",
            data: obj,
        dataType: "",
        cache: false,
        success: function (ajaxresp) {
            localStorage.setItem("", JSON.stringify(ajaxresp.data));
            $('').jqGrid("");
            $('').jqGrid("");
            //Bật lên cửa sổ danh sách hóa đơn
            $.modalOpen({
                id: "",
                title: "",
                url: "" + Math.random(),
                width: "",
                height: "",
                callBack: function (iframeId) {
                    top.frames[iframeId].PatSearchConfirm(); //Trong sự kiện cửa sổ bật lên
                    //Gọi thông tin quyết toán hóa đơn tra cứu

                }//Hàm callback xác nhận khi nhấn cửa sổ
            });
            
        },
        errorCallback: function (err) {
            $.loading(false);
        },
        complete: function () {
            isLoadingIIII = false;
            $.loading(false);
        }
    }); 
    }

    function getDetail(jsnm) {
        $.najax({
            type: "",
            url: ""GetGridViewMxByJsnm"",
            data: { jsnm: jsnm },
            cache: false,
            dataType: "",
            success: function (ajaxresp) {
                $('').jqGrid("");
                gridListTuifei(ajaxresp.data);
                $("").click(function () {
                    var czh = $(this).attr("");
                    if (czh != "") {
                        var isTrue = $(this).is('');
                        if (isTrue) {
                            $("" + czh + "").prop("", "");

                        } else {
                            $("" + czh + "").attr("", false);
                        }
                    }
                });
            },
            errorCallback: function (err) {
            },
            complete: function () {
                 isLoadingIIII = false;
                $.loading(false);
            }

        });
    }

    //Danh sách hoàn phí
    function gridListTuifei(mydata) {
        var $gridList = $("");
        $gridList.dataNewGrid({
            height: 180,
            autowidth: false,
            width: $("").width() - 2,
            caption: "",
            colModel: [
                    { label: '', name: '', hidden: true },
                    { label: '', name: '', hidden: true },
                    { label: '', name: '', hidden: true },
                    { label: '', name: '', hidden: true },
                    { label: '', name: '', hidden: true },
                    { label: '', name: '', width: 150, align: '' },
                    { label: '', name: '', width: 80, align: '' },
                    { label: '', name: '', hidden: true },
                    { label: '', name: '', hidden: true },
                    { label: '', name: '', hidden: true },
                    { label: '', name: '', hidden: true },
                    { label: '', name: '', hidden: true },
                    { label: '', name: '', width: 150, align: '' },
                    { label: '', name: '', width: 80, align: '' },
                    { label: '', name: '', width: 80, align: '' },
                    { label: '', name: '', width: 80, align: '' },
                    { label: '', name: '', width: 80, align: '' },
                    {
                        label: '', name: '', width: 80, align: '',
                        formatter: function (cellvalue) {
                            return "" +
                                cellvalue +
                                "";
                        }
                    },
                    { label: '', name: '', width: 80, align: '' },
                    {
                        label: '', name: '', width: 80, align: '', editable: true, edittype: '', formatter: function (cellvalue) {
                            var IS_RETURNAndCzh = cellvalue.split("");
                            return IS_RETURNAndCzh[0] == '' ? "" + IS_RETURNAndCzh[1] + "" : "" + IS_RETURNAndCzh[0] + ""
                        }
                    }
            ]
        }, mydata);
        if (mydata.length > 0) {
            $('').find("").remove();
        }
    }

    //Hoàn phí
    function Refund() {
        var flag = true;
        var tuifei = $("").jqGrid('', '');
        var IS_RETURN = $("").find("");
        var RETURNS_SL = $("").find("");

        var refund = 0;
        var count = 0;
        if (RETURNS_SL.length > 0) {
            RETURNS_SL.each(function () {
                var tsl = $(this).val();
                if (tuifei[count].SL < tsl) {
                    $.modalAlert("", "");
                    $(this).addClass("");
                    flag = false;

                } else {
                    tuifei[count].RETURNS_SL = tsl;
                }
                count++;
            });
        }
        count = 0;
        if (IS_RETURN.length > 0) {
            IS_RETURN.each(function () {
                var isTrue = $(this).is('');
                if (isTrue) {
                    tuifei[count].IS_RETURN = true;


                } else {
                    tuifei[count].IS_RETURN = false;
                }
                count++;
            });
        } else {
            $.modalAlert("", "");
            flag = false;
        }

        for (var j = 0; j < tuifei.length; j++) {
            if (tuifei[j].IS_RETURN) {

                refund = refund + parseFloat(tuifei[j].DJ) * tuifei[j].RETURNS_SL;
            }
        }

        if (flag) {
            var kh = $("").val();
            var refundData = JSON.stringify(tuifei).toString();
            $.modalConfirm("", function (flag) {
                if (flag) {
                    $.loading(true, "");

                    if (jsnm && kh) {
                        $.najax({
                            type: "",
                            async: false,
                            url: ""btnReturn"",
                            data: { kh: kh, jsnm: jsnm, refundData: refundData },
                            dataType: "",
                            cache: false,
                            success: function (ajaxresp) {
                                var msg = "";
                                if (ajaxresp.data) {
                                    msg = msg + $("").val();
                                } else {
                                    msg = msg + refund;
                                }
                                $.modalAlert(msg, ajaxresp.state);
                                $("").val("");
                                $("").val("");
                                $('').jqGrid("");
                                clearFPYSInfo();//Xóa dữ liệu
                            },
                            errorCallback: function (err) {
                                $.loading(false);
                            },
                            complete: function () {
                                $.loading(false);
                            }
                        });
                    } else {
                        $.modalAlert("", "");
                    }
                }
            }, false);
        }

    }


    //Tra cứu bản ghi quyết toán
    function chajilu(jsnm) {
        $.loading(true, "");
        $.najax({
            type: "",
            url: ""GetMZJSByJsnm"",
            data: { jsnm: jsnm },
            dataType: "",
            cache: false,
            success: function (ajaxresp) {
                if (ajaxresp.state === '' && ajaxresp.data != null && ajaxresp.data.length>0) {
                    var result = ajaxresp.data[0];
                    $("").html(result.BRXZMC);
                    $("").html(result.KSMC);
                    $("").html(result.RYMC);
                    getDetail(jsnm);

                }
            },
            errorCallback: function (err) {
            },
            complete: function () {
                isLoadingIIII = false;
                $.loading(false);
            }
        });
    }

    ///Tải hóa đơn và Thông tin chi phí khác
    function loadFpData(data) {
        jsnm = data.jsnm;
        $("").html(data.fph);
        $("").html(data.flzffy);
        $("").html(data.zffy);
        $("").html(data.jzfy);
        $("").html(data.zlfy);
        $("").val(data.zffy);
        $("").val(data.zje);
        chajilu(data.jsnm);
    }

    //Phím tắt：Xóa
    function newtouch_event_f4() {
        clearFPYSInfo();
        $('').jqGrid("");
    }

    //Phím tắt：F6：Hoàn phí
    function newtouch_event_f6() {
        Refund();
    }

</script>

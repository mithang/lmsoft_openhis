@{
    ViewBag.Title = "";
    Layout = "";
}

<style type="text/css">
    #divTmx .panel-heading {
        background-color: #fcfbfb !important;
    }

        #divTmx .panel-heading span {
            margin-right: 15px;
            font-weight: bold;
            line-height: 20px;
        }

    #divTmx #tje {
        font-weight: bold;
    }

    #divTmx ul li {
        margin-left: 0;
        font-size: 14px;
        line-height: 24px;
    }
</style>

<div style="vertical-align:middle;">
    <div id="divTmx">
        <div class="panel panel-default" style="margin: 20px;">
            <div class="panel-heading navb-bg">
                <span>Thời gian quyết toán：<span id="settTime"></span></span>
                <span>Số tiền quyết toán：<span id="zje"></span></span>
                <span>Số tiền thanh toán：<span id="xjzf"></span></span>
                <br />
                <span>Phương thức thanh toán：<span id="xjzffsmc"></span></span>
                <span>Ngày thu phí：<span id="sfrq"></span></span>
            </div>
            <div style="padding-right:20px;">
                <table class="form">
                    <thead>
                        <tr>
                            <td class="formValue" style="padding-left:10px;">
                                Hoàn phí chi tiết
                            </td>
                            <td class="formValue" style="width:160px;">
                                Tên
                            </td>
                            <td class="formValue">
                                Đơn giá
                            </td>
                            <td class="formValue">
                                Số lượng
                            </td>
                            <td class="formValue">
                                Số lượng trả lại
                            </td>
                            <td class="formValue">
                                Số tiền trả lại
                            </td>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
        <div style="margin: 20px;">
            <ul class="nav nav-pills" style="position: fixed;right: 80px;bottom: 20px;">
                <li>Hoàn phí nhân viên：<span>@(Newtouch.Common.Operator.OperatorProvider.GetCurrent().UserName)</span></li>
                <li>Hoàn phí ngày：<span>@(DateTime.Now.ToString(""))</span></li>
                <li>Hoàn phí thời gian：<span>@(DateTime.Now.ToString(""))</span></li>
                <li>合计退费：<span id="tje"></span>&nbsp;&nbsp;&nbsp;<span id="mzyjj"  style="display:none;"><input type="checkbox" checked="checked" id="yjjth" name="yjjth" /> Tài khoản tạm ứng trả lại </span>
                </li>
            </ul>
        </div>
    </div>
</div>
<script type="">
    var thisJszb = sessionStorage.getItem("");
    var data = sessionStorage.getItem("");
    var mzh = $.request("");
    if (!!thisJszb || !!data) {
        var thisJszb = JSON.parse(thisJszb);
        var data = JSON.parse(data);
    }
    //if (thisJszb.xjzffsmc.indexOf("")!==-1)
    //    $("").show();
    $(function () {
        if (!!!thisJszb || !!!data) {
            return;
        }
        $('').html($.getTime({ date: thisJszb.CreateTime }));
        var zje = thisJszb.jszje;
        $('').html(thisJszb.jszje ? thisJszb.jszje.toFixed(2) : '');
        $('').html(thisJszb.jsxjzf ? thisJszb.jsxjzf.toFixed(2) : '');
        $('').html($.getDate({ date: thisJszb.sfrq }));
        $('').html(thisJszb.xjzffsmc);

        var tmxZje = 0;
        $.each(data, function () {
            var mxtje = this.dj * this.tsl;
            tmxZje += mxtje;
            $('').append('' + this.mc + '' + this.dj + '' + this.sl + '' + this.tsl + '' + roundingBy4she6ru5chengshuang(mxtje, 2) + '');
        });
        var strTje = roundingBy4she6ru5chengshuang(tmxZje, 2);
        if (thisJszb.jszje == tmxZje && thisJszb.jsxjzf != thisJszb.jszje) {
            //Bản ghi quyết toán tự chi trả toàn bộ không
            strTje += '' + thisJszb.jsxjzf.toFixed(2) + '';
        }
        if (thisJszb.xjzffsmc.split("").length - 1 == 1 && (thisJszb.xjzffsmc.indexOf("") !== -1 || thisJszb.xjzffsmc.indexOf("") !== -1 || (thisJszb.xjzffsmc.indexOf("") !== -1))) {
            strTje += '';
        } else {
            strTje += '';
        }
        $('').html(strTje);
    });

    function AcceptClick(callBack) {
        var postData = {};
        postData.mzh = mzh;
        postData.jsnm = thisJszb.jsnm;
        var tjsxmDictObj = {};
        var tjsxmDictZtObj = {};//Thu phí bộ nhóm
        var expectedTmxZje = 0;
        var expectedTmxZtZje = 0;//Thu phí số tiền bộ nhóm
        var cfnmlist = ""; //组套所属处方
        debugger
        $.each(data, function () {
            if (this.ztId) {
                tjsxmDictZtObj[this.ztId] = this.tsl;
                expectedTmxZtZje += this.dj * this.tsl;
                cfnmlist += this.cfnm + "";
            }
            else {
                tjsxmDictObj[this.jsmxnm] = this.tsl;
                expectedTmxZje += this.dj * this.tsl;
            }
            
        });
        if (expectedTmxZje > 0) {
            postData.tjsxmDict = tjsxmDictObj;
        }
        else {
            postData.tjsxmDictZt = tjsxmDictZtObj;
        }
        if (tjsxmDictZtObj != "" || tjsxmDictZtObj != null) {
            postData.tjsxmDictZt = tjsxmDictZtObj;
        }
        postData.expectedTmxZje = ovpraseFloat(expectedTmxZje).toFixed(4);
        postData.expectedTmxZjeZt = ovpraseFloat(expectedTmxZtZje).toFixed(4);
        postData.cfnmArray = cfnmlist;
        $.submitForm({
            url: "",
            param: postData,
            success: function(ajaxResp) {
                callBack(ajaxResp);
                
                $.modalClose();
            }
        });
    }
    function ovpraseFloat(val) {
        if (!val) {
            val = 0.00;
        }
        return parseFloat(val);
    }
</script>

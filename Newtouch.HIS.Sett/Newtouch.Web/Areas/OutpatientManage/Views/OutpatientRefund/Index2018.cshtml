        //Số giao dịch
        const tradeNo = function () {
            const now = new Date()
            const year = now.getFullYear();
            let month = now.getMonth() + 1;
            let day = now.getDate();
            let hour = now.getHours();
            let minutes = now.getMinutes();
            let seconds = now.getSeconds();
            String(month).length < 2 ? (month = Number("" + month)) : month;
            String(day).length < 2 ? (day = Number("" + day)) : day;
            String(hour).length < 2 ? (hour = Number("" + hour)) : hour;
            String(minutes).length < 2 ? (minutes = Number("" + minutes)) : minutes;
            String(seconds).length < 2 ? (seconds = Number("" + seconds)) : seconds;
            const yyyyMMddHHmmss = `${year}${month}${day}${hour}${minutes}${seconds}`;
            return yyyyMMddHHmmss + '' + Math.random().toString(36).substr(2, 9);
        };


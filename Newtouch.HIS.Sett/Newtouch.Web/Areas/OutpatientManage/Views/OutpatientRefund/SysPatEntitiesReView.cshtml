@{
    ViewBag.Title = "";
    Layout = "";
    var from = (ViewBag.from as string) ?? "";
}
<style>
    .table-responsive {
        border: 0;
    }

    .ui-jqgrid .ui-jqgrid-pager .ui-pager-table {
        width: 90%;
    }
</style>

<div style="border-bottom:1px solid rgb(221, 221, 221);margin:0px 10px 0px 10px;">
    <div class="search">
        <table class="form">
            <tr>
                <th class="formTitle" style="width:60px;">Số bệnh án：</th>
                <td class="formValue">
                    <input id="txt_blh" name="txt_blh" type="text" class="form-control form-an" placeholder="Vui lòng nhập số bệnh án" />
                </td>
                <th class="formTitle" style="width:60px;">Số ngoại trú：</th>
                <td class="formValue">
                    <input id="txt_mzh" name="txt_mzh" type="text" class="form-control form-an" placeholder="Vui lòng nhập số ngoại trú" />
                </td>
                <th class="formTitle" style="width:60px;">Họ tên：</th>
                <td class="formValue">
                    <input id="txt_xm" name="txt_xm" type="text" class="form-control form-an form-an-end" placeholder="Vui lòng nhập họ tên hoặc phiên âm đầu" />
                </td>

            </tr>
            <tr>
                <th class="formTitle" style="width:60px;">Ngày thu phí：</th>
                <td class="formValue" colspan="3">
                    <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; float:left;" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-01' })" />
                    <span style="margin-left:2%;float:left;">—</span>
                    <input id="jssj" type="text" class="form-control input-wdatepicker" style="width :41%;float:left;margin-left:2%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                </td>
                <th></th>
                <td style="padding-left: 20px;">
                    <button type="button" id="btn_search" class="btn btn-primary btn-md" style="width:50px;">&nbsp;Tra cứu&nbsp;</button>
                </td>
            </tr>
        </table>
    </div>
</div>
<!--Thông tin bệnh nhân Bao gồm số bệnh án  Họ tên -->
<form id="formPatSer" style="margin:2px;margin-top:10px;">
    <div class="gridPanel">
        <table id="patGridList" rel="formPatSer"></table>
        <div id="gridPager" style="padding-right:20%"></div>
    </div>
</form>

<script>
    //Cái trướcwindowĐối tượng
    var prevWindow;
    if ('' !== '') {
        prevWindow = top.top.frames[''];
    }
    else {
        prevWindow = $.currentWindow();
    }

    var jiuzhenbiaozhi = $.request("");

    $(function () {

        var obj = new Object;
        obj.mzh = $.request("");
        obj.blh = $.request("");
        var searInfo = new PatSearchInfo();
        //Tải dữ liệu
        searInfo.init(obj);

        $('').keyupEnterEvent(function () {
            $('').trigger('');
        });

        //Tra cứu
        $("").click(function () {
            $("").jqGrid('', {
                postData: {
                    blh: $("").val(), mzh: $("").val(), xm: $("").val(),
                    kssj: $("").val(), jssj: $("").val()
                    , jiuzhenbiaozhi: jiuzhenbiaozhi
                },
                url: ""PatSearchInfo""
            }).trigger('');
        });
    });
    var PatSearchInfo = (function () {
        //Tải danh sách
        var loadGrid = function (data) {
            var $gridList = $("");
            $gridList.dataGrid({
                height: $(window).height() - 200,
                autowidth: false,
                width: $("").width() - 10,
                url: ""PatSearchInfo"",
                postData: { blh: $("").val(), mzh: $("").val(), xm: $("").val(), kssj: $("").val(), jssj: $("").val(), jiuzhenbiaozhi: jiuzhenbiaozhi },
                caption: '',
                colModel: [
                    { label: '', name: '', hidden: true },
                    { label: '', name: '', width: 100, align: '' },
                    { label: '', name: '', width: 100, align: '', hidden: true },
                    { label: '', name: '', width: 100, align: '', hidden: true },
                    { label: '', name: '', width: 100, align: '', key: true },
                    {
                        label: '', name: '', width: 120, align: '', formatter: function (cellvalue) {
                            return cellvalue.length > 19 ? cellvalue.substring(0, 19).replace(/T/g, '') : ""
                        }
                    },
                    { label: '', name: '', width: 120, align: '' },
                    { label: '', name: '', hidden: true, width: 100, align: '' },
                    {
                        label: '', name: '', width: 60,  align: '', formatter: function (cellvalue) {
                            return $.getGender(cellvalue);
                        }
                    },
                    {
                        label: '', name: '', width: 60, align: '', formatter: function (cellvalue, options, rowObject) {
                            return getAgeFromBirthTime({ begin: rowObject.csny }).text;
                        }
                    }
                ],
                pager: "",
                sortname: '',
                viewrecords: true
            });
        };

        var myPatSearchInfo = function (data) {

        }

        //Sự kiện tải
        myPatSearchInfo.prototype.init = function (data) {
            if (data.blh === "") {
                $("").val("");
            } else {
                $("").val(data.blh);
            }
            if (data.mzh === "") {
                $("").val("");
            } else {
                $("").val(data.mzh);
            }
            loadGrid(data);
        };
        return myPatSearchInfo;
    }());

    //jqGrid Nhấp đúp để chọn một dòng
    function btn_edit() {
        PatSearchConfirm();
    }

    function PatDbGrid() {
        var $gridList = $("");
        var SelectData = $gridList.jqGrid("", "");
        if (SelectData) {
            var rowData = $gridList.jqGridRowValue();
            var obj = new Object();
            obj.blh = rowData.blh;
            obj.mzh = rowData.mzh;
            obj.nlshow = rowData.nlshow;
            obj.xm = rowData.xm;
            obj.xb = rowData.xb;
            obj.brxz = rowData.brxz;
            obj.brxzmc = rowData.brxzmc;
            obj.patid = rowData.patid;
            prevWindow.GetQueryFphAjax(obj);
            //Đóng cửa sổ
            ReceiptCancle();
        } else {
            $.modalAlert("", '');
        }
    }
    //Xác nhận Gọi từ trang chính
    function PatSearchConfirm() {
        PatDbGrid();
    }

    //Hủy
    function ReceiptCancle() {
        $.modalClose();
    }
</script>

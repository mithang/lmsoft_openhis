@{
    ViewBag.Title = "";

    Layout = "";
}
<style>
    .form .formTitle {
        width: 85px;
    }


    thead tr th {
        background-color: #eee;
        line-height: 30px;
        padding-left: 15px;
    }

    tbody tr td {
        line-height: 30px;
        padding-left: 15px;
    }

    .cellvalue {
        width: 90%;
        line-height: 25px;
    }

    .redBord {
        border-color: red;
    }
</style>
<div class="panel panel-default" style="margin-bottom:0;">
    <div class="panel-heading navb-bg">
        Tra cứu hoàn phí ngoại trú
    </div>
    <div style="padding: 2px;padding-right:20px;">
        <table class="form">
            <tr>
                <td class="formTitle">Số bệnh án：</td>
                <td class="formValue">
                    <input id="blh" type="text" class="form-control form-control-focus" placeholder="Vui lòng nhập số bệnh án">
                </td>
                <td class="formValue">
                    <input type="button" class="btn btn-default btn-md btn-default-color" style="width: 25px;" id="btnsyy" value="Tra cứu" onclick="GetPatSerarchView($('#blh').val());" />
                </td>
                <td class="formTitle">Thao tác ngày：起</td>
                <td class="formValue">
                    <input class="form-control input-wdatepicker" type="text" onfocus="WdatePicker({
                                onpicked: function () {getAge($(this).val());return true;}})" id="ks" value="@DateTime.Now.AddMonths(-1).ToString("yyy-MM-dd")" />
                </td>
                <td class="formTitle">Đến：</td>
                <td class="formValue">
                    <input class="form-control input-wdatepicker" type="text" onfocus="WdatePicker({
                                onpicked: function () {getAge($(this).val());return true;}})" id="js" value="@DateTime.Now.AddDays(1).ToString("yyy-MM-dd")" />
                </td>
                <td class="formTitle"></td>
                <td class="formValue">
                    <button id="BtnQuery" class="btn btn btn-primary btn-md dropdown-text">Tra cứu</button>
                </td>
            </tr>
        </table>
    </div>
</div>
<form id="tabGrid" style="margin-top: 10px;">
    <div class="gridPanel">
        <table id="gridListTuifei" rel="tabGrid"></table>
    </div>
</form>
@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 4, 6 },
    F6Text = ""
})
<script>

    $(function () {
        //Tải lại khi thay đổi kích thước cửa sổ trình duyệtjqGridchiều rộng của
        $(window).resize(function () {
            initLayout("");
        });

        var txt_keyword = document.getElementById('');
        txt_keyword.addEventListener('',
            function (event) {
                event = event || window.event;
                if (event.keyCode === 13) {
                    if ($(this).val() == null || $(this).val() == undefined || $(this).val() == "") {
                        $.modalAlert("", '');
                        return false;
                    }
                    btnQuery();
                }
            });

        //Xóa trống
        newtouch_event_f4();
        gridListTuifei([]); //Danh sách hoàn phí

        //Tra cứu
        $("").click(function () {
            if ($('').val() && $('').val() && ($('').val() > $('').val())) {
                $.modalAlert("", '');
                return;
            }
            if ($("").val() === "") {
                $.modalAlert("", "");
                return;
            }
            btnQuery();
        });
    });

    var jsnm; //获取从弹出窗口中得到的结算内码

    //Tra cứu nhân viên
    function GetPatSerarchView(blh) {
        $.modalOpen({
            id: "",
            title: "",
            //url: "" + Math.random() + "" + blh,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
                //Gọi tra cứu số thẻ và số nhập viện
                //getPatInfoAjax(result);
            }
        });
    }

    function btnQuery() {
        var obj = new Object;
        obj.blh = $.trim($("").val());
        obj.startTime = $.trim($("").val());
        obj.endTime = $.trim($("").val());
        GetQueryFphAjax(obj);
    }

    //Tra cứu lịch sử
    function GetQueryFphAjax(obj) {
        $.loading(true, "");
        $.najax({
            type: "",
            url: ""btnQuery"",
            data: obj,
            dataType: "",
            cache: false,
            alerterror: false,
            success: function (ajaxresp) {
                if (ajaxresp.state === '') {
                    localStorage.setItem("", JSON.stringify(ajaxresp.data));//Quyết toán dữ liệu
                    $('').jqGrid("");
                    $('').jqGrid("");
                    //Bật lên cửa sổ danh sách lịch sử
                    $.modalOpen({
                        id: "",
                        title: "",
                        url: "" + Math.random(),
                        width: "",
                        height: "",
                        callBack: function (iframeId) {
                            top.frames[iframeId].btn_edit(); //Trong sự kiện cửa sổ bật lên
                            //Gọi thông tin quyết toán hóa đơn tra cứu

                        }
                    });
                } else if (ajaxresp.state === '') {
                    //cửa sổ giao diện bật lên nhân viên chọn tải
                    GetPatSerarchView($("").val());
                }
            },
            errorCallback: function (err) {
                $.loading(false);
            },
            complete: function () {
                $.loading(false);
            }
        });
    }

    function getDetail(jsnm) {
        $.najax({
            type: "",
            url: ""GetGridViewMxByJsnm"",
            data: { jsnm: jsnm },
            cache: false,
            dataType: "",
            success: function (ajaxresp) {
                $('').jqGrid("");
                gridListTuifei(ajaxresp.data);
                jsnm = ajaxresp.data[0].jsnm;
                var je = Number(0.00);
                $("").html('');
            },
            errorCallback: function (err) {
            },
            complete: function () {
                $.loading(false);
            }

        });
    }

    //Danh sách hoàn phí
    function gridListTuifei(mydata) {
        var lastRowId;
        var $gridList = $("");
        $gridList.dataNewGrid({
            height: $(window).height() - 210,
            //autowidth: false,
            width: $("").width() - 2,
            caption: "",
            multiselect: true,
            editurl: "",  //Dữ liệu gửi máy chủ tới không chỉnh sửa dòng
            //onSelectRow_page: function (rowid, status) {
            //    if (rowid && lastRowId && rowid !== lastRowId) {   //&&: 相当于true/fase(判断是否有值)
            //        $gridList.saveRow(lastRowId, function (result) {
            //            // return false;   //Xác minh nội dung nhập có hợp lệ không，Hủy lưu và quay lạifalse    //Không hiệu lực V.v. sửa chữa
            //        }); //先保存处于编辑状态的那一行    //function checksave
            //    }
            //    lastRowId = rowid;
            //    $gridList.jqGrid('', rowid, true, null, function (result) {
            //        return false;   //Xác minh nội dung nhập có hợp lệ không，Hủy lưu và quay lạifalse    //Không hiệu lực V.v. sửa chữa
            //    }, null, null, function () {
            //    });
            //},
            onSelectRow: function (rowid) {
                $("" + $.jgrid.jqID(rowid) + "").focus();
            },
            gridComplete: function () {
                //Bật hộp chỉnh sửa trong dòng
                EnableInlineEditBox();
            },
            colModel: [
                { label: "", name: "", align: "", hidden: true },
                { label: "", name: "", align: "", hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                {
                    label: '', name: '', width: 120, align: '', editable: true
                    //,
                    //editrules: { integer: true }
                },
                {
                    label: "", name: "", width: 80, align: "", formatter: function (val) {
                        return val.length > 0 ? parseInt(val) : 0;
                    }
                },
                { label: "", name: "", width: 150, align: "" },
                { label: "", name: "", width: 50, align: "", hidden: true },
                { label: "", name: "", width: 100, align: "" },
                { label: "", name: "", width: 40, align: "" },
                { label: "", name: "", width: 60, align: "" },
                {
                    label: "", name: "", width: 60, align: "", formatter: function (cellvalue) {
                        return Number(cellvalue).toFixed(4);
                    }
                },
                { label: "", name: "", width: 180, align: "" },
                {
                    label: "", name: "", width: 60, align: "", formatter: function (cellvalue) {
                        return Number(cellvalue).toFixed(2);
                    }
                },
                { label: "", name: "", width: 160, align: "" },
                {
                    label: "", name: "", width: 80, align: "", formatter: function (cellvalue) {
                        return cellvalue && cellvalue.length >= 10 ? cellvalue.substring(0, 10) : "";
                    }
                }
            ]
        }, mydata);
        if (mydata.length > 0) {
            $('').find("").remove();
        }
    }
    //Bật hộp chỉnh sửa trong dòng
    function EnableInlineEditBox() {
        //GridTải xong bật chỉnh sửa trong dòng   1.Lấy tất cả các dòng trướcId  2.Gọi duyệteditRowPhương thức
        var rowIds = $("").jqGrid('');
        for (var i = 0; i < rowIds.length; i++) {
            $("").jqGrid('', rowIds[i], true, null, null, null, null, function (callbackRowId) {     //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.

            });
        }
    }

    //Hoàn phí
    function Refund() {
        var flag = true;
        var blh = $("").val();
        if (!blh) {
            $.modalAlert("", '');
            return;
        }
        var tuifei = $("").jqGrid('', '');
        if (!tuifei || tuifei.length === 0) {
            $.modalAlert("", '');
            return;
        }
        var selrowid = $("").jqGrid("", "");
        if (selrowid.length < 1) {
            flag = false;
            $.modalAlert("", '');
            return;
        }

        //Lấy tất cả các dòngId
        var rowIds = $("").jqGrid('');
        for (var i = 0; i < rowIds.length; i++) {
            //Duyệt để hộp chỉnh sửa ở trạng thái đã lưu
            $("").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);
            var rowData = $("").jqGrid('', rowIds[i]);
            if (!rowData) {
                break;
            }
            if (!(/^(\+|-)?\d+$/.test(rowData.RETURNS_SL))) {
                $.modalAlert("" + rowData.YPMC + "", '');
                EnableInlineEditBox();
                return;
            }
            if (parseInt(rowData.RETURNS_SL) > parseInt(rowData.SL)) {
                $.modalAlert("" + rowData.YPMC + "", '');
                EnableInlineEditBox();
                return;
            }
            if (parseInt(rowData.RETURNS_SL) < 1) {
                $.modalAlert("" + rowData.YPMC + "", '');
                EnableInlineEditBox();
                return;
            }
        }
        var rowid = $("").jqGrid("", "");
        $.each(tuifei, function (idx, val) {
            val.RETURNS_SL = 0;
            $.each(rowid, function (idx2, val2) {
                if (val2 != undefined && val2 == (idx + 1)) {
                    val.RETURNS_SL = $('').jqGrid('', val2).RETURNS_SL;
                }
            });
        });

        var refundData = JSON.stringify(tuifei).toString();
        $.modalConfirm("", function (flag) {
            if (flag) {
                $.loading(true, "");
                var jsnm = tuifei[0].jsnm;
                if (jsnm && blh) {
                    $.najax({
                        type: "",
                        async: false,
                        url: ""btnReturn"",
                        data: { blh: blh, jsnm: jsnm, refundData: refundData },
                        dataType: "",
                        cache: false,
                        success: function (ajaxresp) {
                            var msg = "";
                            $.modalAlert(msg, ajaxresp.state);
                            $('').jqGrid("");
                        },
                        errorCallback: function (err) {
                            $.loading(false);
                        },
                        complete: function () {
                            $.loading(false);
                        }
                    });
                } else {
                    $.modalAlert("", "");
                }
            }
        }, false);

    }

    //Phím tắt：Xóa
    function newtouch_event_f4() {
        $('').jqGrid("");
    }

    //Phím tắt：F6：Hoàn phí
    function newtouch_event_f6() {
        Refund();
    }
</script>

@{
    ViewBag.Title = "";
    Layout = "";
}
<!--Quyết toán danh sách-->
<form style="margin:2px;margin-top:10px;">
    <div class="gridPanel" style="margin: 5px 10px;">
        <table id="gridList"></table>
    </div>
</form>
<script>
    $(function () {
        var jsdata = sessionStorage.getItem("");
        var jsondata = JSON.parse(jsdata);
        gridList(jsondata);
    });

    //Tải danh sách quyết toán
    function gridList(mydata) {
        var $gridList = $("");
        $gridList.newtouchLocalDataGrid({
            height: $(window).height() - 80,
            unwritten: false,
            posttofirst: false,
            colModel: [
                { label: '', name: '', key: true, hidden: true },
                { label: '', name: '', hidden:true},
                {
                    label: '', name: '', width: 80, align: "",
                    formatter: function (val) {
                        return $.enum.getDescByValue("", val);
                    }
                },
                {
                    label: '', name: '', width: 130, align: ""
                    , formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                {
                    label: '', name: '', width: 80, align: "",
                    formatter: function (val) {
                        if (val || val == 0) {
                            return val.toFixed(2);
                        } else {
                            return '';
                        }
                    }
                },
                { label: '', name: '', width: 100, align: ""},
                { label: '', name: '', width: 100, align: "", formatter: "", formatoptions: { srcformat: '', newformat: '' } },
                { label: '', name: '', width: 80, align: "" },
            ]
            , ondblClickRow: function (rowid) {
                var frameId = window.name;
                top.$('' + frameId + '').siblings('').find('').trigger('');
            }
        }, mydata);
    }

    function AcceptClick(callBack) {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var rowData = $("").jqGrid('', seleRowid);
        if (rowData.jslx == '') {
            if (rowData.ghly!='')
            {
                $.modalAlert('', '');
                return;
            }
            var allData = $("").jqGrid("");
            for (var i = 0; i < allData.length ; i++) {
                if (allData[i].jsnm != rowData.jsnm
                    && !(allData[i].jslx == '')
                    && (!!allData[i].jszje && parseFloat(allData[i].jszje) != 0)) {
                    $.modalAlert('', '');
                    return;
                }
            }
        }
        if (!(!!rowData.jszje && parseFloat(rowData.jszje) != 0)) {
            $.modalAlert('', '');
            return;
        }
        callBack(rowData.jsnm);
        $.modalClose();
    }

</script>

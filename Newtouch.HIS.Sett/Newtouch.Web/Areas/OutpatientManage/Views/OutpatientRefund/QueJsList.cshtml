
@{
    ViewBag.Title = "";
    Layout = "";
}
<style>
    .table-responsive {
        border: 0;
    }
</style>
<!--Quyết toán danh sách-->
<form id="tabGrid" style="margin:2px;margin-top:10px;">
    <div class="gridPanel" style="margin: 5px;">
        <table id="gridList" rel="tabGrid"></table>
    </div>
</form>
<script>

    $(function () {
        var jsdata = localStorage.getItem("");
        gridListFPH(JSON.parse(jsdata));
    });

    //Tải danh sách quyết toán
    function gridListFPH(mydata) {
        var $gridList = $("");
        $gridList.dataNewGrid({
            height: 150,
            colModel: [
                { label: '', width: 60, name: '' },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', width: 70, align: '' },
                { label: '', name: '', width: 70, align: '' },
                {
                    label: '', name: '', width: 80, align: '', formatter: function (cellvalue) {
                        return cellvalue && cellvalue.length >= 10 ? cellvalue.substring(0, 10) : "";
                    }
                },
                { label: '', name: '', width: 70, align: '' },
                {
                    label: '', name: '', width: 80, align: '', formatter: function (cellvalue) {
                        return Number(cellvalue).toFixed(2);
                    }
                }
            ]
        }, mydata);
        if (mydata.length > 0) {
            $('').find("").remove();
        }
    }


    //function submitForm() {
    //    btn_edit();
    //}
    //Quyết toán sự kiện nhấn chuột danh sách
    function btn_edit() {
        var data = $("").jqGridRowValue();
        if (data) {
            var seleRowid = jQuery("").jqGrid("", "");
            if (!(seleRowid)) {
                $.modalAlert("", '');
                return;
            }
            $.currentWindow().$("").val(data.blh);
            $.currentWindow().getDetail(data.jsnm); //主页中的方法
            PatSearchConfirm();
        } else {
            $.modalAlert("", "");
        }

    }

    //Xác nhận Gọi từ trang chính
    function PatSearchConfirm() {
        var $gridList = $("");
        var blh = $gridList.jqGridRowValue().blh;
        var xm = $gridList.jqGridRowValue().xm;
        var obj = new Object();
        obj.blh = blh;
        obj.xm = xm;
        //Đóng cửa sổ
        ReceiptCancle();
    }

    //Hủy
    function ReceiptCancle() {
        $.modalClose();
    }
</script>

@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="panel panel-default">
    <table class="form">
        <tr>
            <th class="formTitle">Ngày bắt đầu：</th>
            <td class="formValue">
                <input id="ksrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px"
                       onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
                       onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', onpicked: function () { refReport(); } })"
                       value="@DateTime.Now.AddDays(-7).ToString("yyyy-MM-dd")" />
            </td>
            <th class="formTitle">Ngày kết thúc：</th>
            <td class="formValue">
                <input id="jsrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px"
                       onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
                       onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', onpicked: function () { refReport(); } })"
                       value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </td>
            <th class="formTitle">Phương thức thanh toán：</th>
            <td class="formValue">
                <select id="payType" data-EnumType="EnumPayStatus">
                    <option value="">==Tất cả==</option>
                </select>
            </td>
            <th class="formTitle"></th>
            <td class="formValue" style="padding-left:20px;">
                <input type="button" id="btn_search" onclick="submit();" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
            </td>
        </tr>
    </table>
    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
    <div class="gridPanel">
        <table id="gridListRefd"></table>
        @*<div id="gridPagerRefd"></div>*@
    </div>
</div>
<script>
    $(function() {
        InitGrid();
        RefundGrid();
    });

    function InitGrid() {
        var $gridJsList = $("");
        $gridJsList.dataGrid({        
            height:300,
            url: "",
            postData: { ksrq: $("").val(), jsrq: $("").val(), payType: 1 },
            colModel: [
                { label: '', name: '', width: 110, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 60, align: '' },
                 {
                     label: '', name: '', width: 160, align: ""
                 },
                { label: '', name: '', width: 200, align: '' },
                { label: '', name: '', width: 150, formatter: "", formatoptions: { srcformat: '', newformat: '' }},
                {
                    label: '', name: '', width: 150, align: '', formatter: function (cellvalue) {
                        return cellvalue ? cellvalue.toFixed(2) : "";
                    }
                },
                {
                    label: '', name: '', width: 150, align: '', formatter: function (cellvalue) {
                        return cellvalue ? cellvalue.toFixed(2) : "";
                    }
                },
                
            ],
            pager: "",
            sortname: "",
            viewrecords: true,
            //caption:""
            onSelectRow: function (rowid) {
                btn_selectrow(rowid);
            },
            //gridComplete: function (gridJszbList) {
            //    jszbList = null;
            //    if (gridJszbList && gridJszbList.rows) {
            //        jszbList = gridJszbList.rows;
            //    }
            //}
        });
        $("").click(function () {
            $('').jqGrid("");//Xóa trống chi tiết trước
            $gridJsList.jqGrid('', {
                postData: { ksrq: $("").val(), jsrq: $("").val(), payType: 1 } ,
                url: '',
                page: 1
            }).trigger('');
        });       

    }

    function RefundGrid() {
        var $gridJsList = $("");
        $gridJsList.dataGrid({
            height: 200,
            postData: { outTradeNo: "", tradeNo: ""},
            colModel: [                                   
                //{ label: '', name: '', width: 60, align: '' },
                {
                    label: '', name: '', width: 160, align: ""
                },
                { label: '', name: '', width: 50, align: '' },
                {
                    label: '', name: '', width: 150, align: '', formatter: function (cellvalue) {
                        return cellvalue ? cellvalue.toFixed(2) : "";
                    }
                },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 150, formatter: "", formatoptions: { srcformat: '', newformat: '' }},
                {
                    label: '', name: '', width: 160, align: ""
                },
                { label: '', name: '', width: 110, align: '' }
            ],
            //pager: "",
            sortname: "",
            //viewrecords: true,
            caption:""
        });
    }

    function btn_selectrow(rowid) {
        if (rowid != null && rowid != undefined) {
            var row = $('').jqGrid("", rowid);
            if (row != null) {
                $('').jqGrid("");//Xóa trống chi tiết trước
                $('').jqGrid('', {
                    postData: { outTradeNo: row.OutTradeNo, tradeNo: ""} ,
                    url: '',
                    page: 1
                }).trigger('');
            }
        }
    }
</script>
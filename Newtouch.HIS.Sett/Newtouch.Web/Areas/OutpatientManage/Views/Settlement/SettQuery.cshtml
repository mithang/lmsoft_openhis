@{
    Layout = "";
}

<form>
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form">
            <tr>
                <th class="formTitle">Từ khóa：</th>
                <td class="formValue">
                    <input id="txt_keyword" type="text" class="form-control form-an" placeholder="Họ tên/Số bệnh án/Số ngoại trú">
                </td>
                <th class="formTitle">Ngày quyết toán：</th>
                <td class="formValue" colspan="2">
                    <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; float:left;" value="@DateTime.Now.AddMonths(-6).ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    <span style="margin-left:1%;float:left">—</span>
                    <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:43%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                </td>
                <th class="formTitle" style="height: 35px;"></th>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">
                        <input id="containsTF" name="containsTF" type="checkbox" checked="checked"><label for="containsTF">含退费</label>
                    </div>
                </td>
                <td class="formValue">
                    <input type="button" id="btn_search" class="btn btn-primary" style="width:36%;margin-left: 10%;" value="Tra cứu" />
                </td>
                <th class="formTitle"></th>
                <td class="formValue"></td>
            </tr>
        </table>
    </div>
    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>
@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 9 },
    F9Text = "",
})

<script>
    $(function () {
        initControl();
        gridList();
    })

    var gridOptins = {
        url: "",
        height: $(window).height() - 185,
        postData: getSearchPostData(),
        colModel: [
            { label: '', name: '', width: 105, align: '', key: true },
            { label: '', name: '', hidden: true },
            { label: '', name: '', hidden: true },
            { label: '', name: '', width: 50, align: '' },
             {
                 label: '', name: '', width: 35, align: '', formatter: function (cellvalue) {
                     return $.getGender(cellvalue);
                 }
             },
            { label: '', name: '', width: 60, align: '' },
            { label: '', name: '', width: 100, align: '' },
             {
                 label: '', name: '', width: 50, align: '', formatter: function (cellvalue) {
                     return cellvalue == 2 ? "" : (cellvalue == 1 ? "" : "");
                 }
             },
            {
                label: '', name: '', width: 80, align: '',
                formatter: "", formatoptions: { srcformat: '', newformat: '' }
            },
            { label: '', name: '', width: 100, align: '' },
            {
                label: '', name: '', width: 60, align: '', formatter: moneyFormat
            },
            {
                label: '', name: '', width: 60, align: '', formatter: moneyFormat
            },
            { label: '', name: '', width: 80, align: '' },
            {
                label: '', name: '', width: 80, align: '', formatter: moneyFormat
            },
            {
                label: '', name: '', width: 80, align: '', formatter: moneyFormat
            },
            {
                label: '', name: '', width: 80, align: '', formatter: moneyFormat
            },
        ],
        pager: "",
        rowNum: 10,
        sortname: '',
        viewrecords: true
    };

    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid(gridOptins);
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: getSearchPostData(),
                page: 1,
            }).trigger('');
        });
    }

    function getSearchPostData() {
        return { keyword: $("").val(), kssj: $("").val(), jssj: $("").val(), containsTF: $("").is("") };
    }

    function moneyFormat(cellvalue, a, b) {
        var str = cellvalue ? cellvalue.toFixed(2) : "";
        if (b.jszt && b.jszt == '' && parseFloat(cellvalue) > 0) {
            str = '' + str;
        }
        return str;
    }

    //Sự kiện nhấn Enter
    $('').keydownEnterEvent(function () {
        $('').trigger('');
    })

    $('').click(function () {
        setTimeout("", 100);
    });

    function initControl() {

    }

    var exportCols = null;
    function newtouch_event_f9() {
        exportCols = new Array();
        $.each(gridOptins.colModel, function () {
            if (!(this.hidden === true)) {
                exportCols.push({ Heading: this.label, Name: this.name, Width: this.width });
            }
        });
        Export();
    }

    function Export() {
        var url = "" + Math.random();
        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $("").is("");
        url += "" + "";  //列宽度标准列
        var cols = JSON.stringify(exportCols);
        top.$.cookie('', cols, { path: "" });
        //url += "" + encodeURIComponent(cols);

        window.open(url);
    }

</script>



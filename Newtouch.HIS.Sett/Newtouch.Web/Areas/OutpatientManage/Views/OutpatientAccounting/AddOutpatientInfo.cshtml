@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
}
<script>
    var keyValue = $.request("");
    var sfzh;
    var age;
    var vcity = {
        11: "",
        12: "",
        13: "",
        14: "",
        15: "",
        21: "",
        22: "",
        23: "",
        31: "",
        32: "",
        33: "",
        34: "",
        35: "",
        36: "",
        37: "",
        41: "",
        42: "",
        43: "",
        44: "",
        45: "",
        46: "",
        50: "",
        51: "",
        52: "",
        53: "",
        54: "",
        61: "",
        62: "",
        63: "",
        64: "",
        65: "",
        71: "",
        81: "",
        82: "",
        91: ""
    };
    $(function () {
        init();
        if (!!keyValue) {
            $("").val(keyValue);
        }
        $('').bind("",
            function (e) {
                if (((e.keyCode === 13 && e.type === "") || e.type === "") && $('').val() === "") {
                    var len = $(this).val().length;
                    var sfzh = $(this).val();
                    if (len === 15 || len === 18) {
                        var csrq;
                        csrq = sfzh.substr(6, 8);
                        if ((len === 15 && csrq) || len === 18) {
                            csrq = csrq.replace(/(.{4})(.{2})/, "");
                            //Lấy giới tính
                            var xb;
                            if (parseInt(sfzh.charAt(16) / 2) * 2 != sfzh.charAt(16))
                                xb = 1;
                            else
                                xb = 0;
                            //Lấy tuổi
                            var myDate = new Date();
                            var month = myDate.getMonth() + 1;
                            var day = myDate.getDate();
                            age = myDate.getFullYear() - sfzh.substring(6, 10) - 1;
                            if (sfzh.substring(10, 12) < month ||
                                sfzh.substring(10, 12) == month && sfzh.substring(12, 14) <= day) {
                                age++;
                            }
                            $('').val(csrq);
                            if (xb == 0) {
                                if ($("").parent().hasClass('')) {
                                    $("").parent().removeClass('');
                                }
                                $("").attr("", ''); //Nữ
                                $("").parent().addClass('');
                            } else {
                                if ($("").parent().hasClass('')) {
                                    $("").parent().removeClass('');
                                }
                                $("").attr("", ''); //Nam
                                $("").parent().addClass('');
                            }
                            $('').val(age);
                        }
                    }
                }
            });

        //Phiên âm lấy họ tên theo
        $('').blur(function () {
            $('').val($(this).toPinyin());

        });
        $("").keyupEnterEvent(function () {
            submitForm();
        });
    });

    function init() {
        //Quốc tịch
        $("").newtouchBindSelect({
            id: "",
            text: "",
            datasource: function () {
                var resultObjArr = new Array();
                if (top.window.newtouchclients.sysNationalityList) {
                    $.each(top.window.newtouchclients.sysNationalityList,
                        function (idx, val) {
                            resultObjArr.push(val);
                        });
                }
                return resultObjArr;
            }
        });

    }

    function submitForm() {
        var data = $("").formSerialize();
        if (AddData_Check()) {
            $.submitForm({
                url: "",
                param: data,
                success: function () {
                    $.loading(false);
                    if ($.currentWindow().$("").length === 1) {
                        //门诊挂号免卡登记
                        $.currentWindow().searchPatInfo(data.blh);
                        $.modalClose();
                    }
                }
            });
        }
    }

    checkCard = function () {
        var card = $("").val().toUpperCase();
        $("").val(card);
        if ($('').val() !== "") {
            if (card === '') {
                $.modalAlert('', '');
                return false;
            }
            return true;
        }

        //是否为空
        if (card === '') {
            $.modalAlert('', '');
            // $("").focus;
            return false;
        }
        //Kiểm tra độ dài，Loại
        if (isCardNo(card) === false) {
            $.modalAlert('', '');
            //$("").focus;
            return false;
        }
        //Kiểm tra phần tỉnh
        if (checkProvince(card) === false) {
            $.modalAlert('', '');
            //$("").focus;
            return false;
        }
        //校验生日
        if (checkBirthday(card) === false) {
            $.modalAlert('', '');
            //$("").focus();
            return false;
        }
        //检验位的检测
        if (checkParity(card) === false) {
            $.modalAlert('', '');
            // $("").focus();
            return false;
        }
        return true;
    };


    //检查号码是否符合规范，Bao gồm độ dài，Loại
    isCardNo = function (card) {
        //身份证号码为15位或者18Vị，15位时全为数字，18位前17位为数字，最后一位是校验位，Số cho có thể hoặc Ký tựX
        var reg = /(^\d{15}$)|(^\d{17}(\d|X)$)/;
        if (reg.test(card) === false) {
            return false;
        }

        return true;
    };

    //取身份证前两位,Kiểm tra phần tỉnh
    checkProvince = function (card) {
        var province = card.substr(0, 2);
        if (vcity[province] == undefined) {
            return false;
        }
        return true;
    };

    //检查生日是否正确
    checkBirthday = function (card) {
        var len = card.length;
        //Chứng minh nhân dân15位时，Tỉnh cho thứ tự（3Vị）Thành phố（3Vị）Năm（2Vị）Tháng（2Vị）Ngày（2Vị）Chữ số kiểm tra（3Vị），皆为数字
        if (len == '') {
            var re_fifteen = /^(\d{6})(\d{2})(\d{2})(\d{2})(\d{3})$/;
            var arr_data = card.match(re_fifteen);
            var year = arr_data[2];
            var month = arr_data[3];
            var day = arr_data[4];
            var birthday = new Date('' + year + '' + month + '' + day);
            return verifyBirthday('' + year, month, day, birthday);
        }
        //Chứng minh nhân dân18位时，Tỉnh cho thứ tự（3Vị）Thành phố（3Vị）Năm（4Vị）Tháng（2Vị）Ngày（2Vị）Chữ số kiểm tra（4Vị），校验位末尾可能为X
        if (len == '') {
            var re_eighteen = /^(\d{6})(\d{4})(\d{2})(\d{2})(\d{3})([0-9]|X)$/;
            var arr_data = card.match(re_eighteen);
            var year = arr_data[2];
            var month = arr_data[3];
            var day = arr_data[4];
            var birthday = new Date(year + '' + month + '' + day);
            return verifyBirthday(year, month, day, birthday);
        }
        return false;
    };

    //Kiểm tra ngày
    verifyBirthday = function (year, month, day, birthday) {
        var now = new Date();
        var now_year = now.getFullYear();
        //年月日是否合理
        if (birthday.getFullYear() == year && (birthday.getMonth() + 1) == month && birthday.getDate() == day) {
            //判断年份的范围（3岁到100岁之间)
            var time = now_year - year;
            if (time >= 3 && time <= 100) {
                return true;
            }
            return false;
        }
        return false;
    };

    //校验位的检测
    checkParity = function (card) {
        //15位转18Vị
        card = changeFivteenToEighteen(card);
        sfzh = card;
        var len = card.length;
        if (len == '') {
            var arrInt = new Array(7, 9, 10, 5, 8, 4, 2, 1, 6, 3, 7, 9, 10, 5, 8, 4, 2);
            var arrCh = new Array('', '', '', '', '', '', '', '', '', '', '');
            var cardTemp = 0, i, valnum;
            for (i = 0; i < 17; i++) {
                cardTemp += card.substr(i, 1) * arrInt[i];
            }
            valnum = arrCh[cardTemp % 11];
            if (valnum == card.substr(17, 1)) {
                return true;
            }
            return false;
        }
        return false;
    };

    //15位转18位身份证号
    changeFivteenToEighteen = function (card) {
        if (card.length == '') {
            var arrInt = new Array(7, 9, 10, 5, 8, 4, 2, 1, 6, 3, 7, 9, 10, 5, 8, 4, 2);
            var arrCh = new Array('', '', '', '', '', '', '', '', '', '', '');
            var cardTemp = 0, i;
            card = card.substr(0, 6) + '' + card.substr(6, card.length - 6);
            for (i = 0; i < 17; i++) {
                cardTemp += card.substr(i, 1) * arrInt[i];
            }
            card += arrCh[cardTemp % 11];
            return card;
        }
        return card;
    };

    function AddData_Check() {
        var blh = $("").val();
        if (blh == null || blh === "" || blh == undefined) {
            $.modalAlert("", '');
            $("").focus();
            return false;
        }
        var xm = $("").val();
        if (xm == null || xm === "" || xm == undefined) {
            $.modalAlert("", '');
            $("").focus();
            return false;
        }
        var zjlx = $("").val();
        if (zjlx == null || zjlx === "" || zjlx == undefined) {
            $.modalAlert("", '');
            $("").focus();
            return false;
        }
        //var zjh = $("").val();
        ////暂时去除身份验证----liixn 20190816
        //if (!checkCard()) {
        //    return false;
        //}
        var csny = $("").val();
        if (csny == null || csny === "" || csny == undefined) {
            $.modalAlert("", '');
            $("").focus();
            return false;
        }

        var nl = $("").val();
        if (nl == null || nl === "" || nl == undefined) {
            $.modalAlert("", '');
            $("").focus();
            return false;
        }

        //Giới tính
        var xb = false;
        $('').each(function () {
            var $this = $(this);
            if ($this.parent().hasClass("")) {
                xb = true;
                $("").val();
            }
        });
        if (!xb) {
            $.modalAlert("", '');
            return false;
        }
        return true;
    }

    /*根据出生日期算出年龄*/
    function jsGetAge(strBirthday) {
        var returnAge;
        var strBirthdayArr = strBirthday.split("");
        var birthYear = strBirthdayArr[0];
        var birthMonth = strBirthdayArr[1];
        var birthDay = strBirthdayArr[2];

        d = new Date();
        var nowYear = d.getFullYear();
        var nowMonth = d.getMonth() + 1;
        var nowDay = d.getDate();

        if (nowYear == birthYear) {
            returnAge = 0;//同年 Cho thì0Tuổi
        }
        else {
            var ageDiff = nowYear - birthYear; //年之差
            if (ageDiff > 0) {
                if (nowMonth == birthMonth) {
                    var dayDiff = nowDay - birthDay;//日之差
                    if (dayDiff < 0) {
                        returnAge = ageDiff - 1;
                    }
                    else {
                        returnAge = ageDiff;
                    }
                }
                else {
                    var monthDiff = nowMonth - birthMonth;//月之差
                    if (monthDiff < 0) {
                        returnAge = ageDiff - 1;
                    }
                    else {
                        returnAge = ageDiff;
                    }
                }
            }
            else {
                returnAge = -1;//Trả về-1 表示出生日期输入错误 晚于今天
            }
        }
        $("").val(returnAge);
    }
</script>
<style>
    body {
        overflow: hidden;
    }

    .formTitle span {
        color: red;
    }

    .tab-content #basicInfo table tr td {
        border: 0;
    }
</style>
<form id="form1">
    <input type="hidden" id="py" name="py" />
    <table class="form" style="width: 98%; border: 0; margin-top: 10px">
        <tr>
            <td class="formTitle"><span class="required">*</span>Số bệnh án：</td>
            <td class="formValue">
                <input type="text" id="blh" class="form-control form-an ">
            </td>
            <td class="formTitle"><span>*</span>Họ tên bệnh nhân：</td>
            <td class="formValue">
                <input type="text" id="xm" name="xm" class="form-control form-an ">
            </td>
            <td class="formTitle">Điện thoại di động：</td>
            <td class="formValue">
                <input type="text" id="phone" name="phone" class="form-control form-an ">
            </td>
        </tr>
        <tr>
            <td class="formTitle"><span>*</span>Loại giấy tờ：</td>
            <td class="formValue">
                @Html.DropDownList("", EnumZJLX.sfz.ToDescSelectList(), "", new { @class = "" })
            </td>
            <td class="formTitle"><span>*</span>Số giấy tờ：</td>
            <td class="formValue">
                <input type="text" id="zjh" name="zjh" class="form-control form-an ">
            </td>
            <td class="formTitle"><span>*</span>Năm sinh：</td>
            <td class="formValue">
                <input id="csny" type="text" class="form-control form-an  input-wdatepicker" onfocus="WdatePicker({
    onpicked: function () {jsGetAge($(this).val());return true;}})" />
            </td>
        </tr>
        <tr>
            <td class="formTitle"><span>*</span>Tuổi：</td>
            <td class="formValue">
                <input type="text" id="nl" name="nl" class="form-control form-an ">
            </td>
            <td class="formTitle"><span>*</span>Giới tính：</td>
            <td class="formValue">
                <div class="btn-group" data-toggle="buttons">
                    <label class="btn btn-default">
                        <input type="radio" id="xb" value="1" name="xb" class="form-control form-an ">
                        Nam
                    </label>
                    <label class="btn btn-default">
                        <input type="radio" id="xb" value="0" name="xb" class="form-control form-an ">
                        Nữ
                    </label>
                </div>
            </td>
            <td class="formTitle">Người giới thiệu：</td>
            <td class="formValue">
                <input type="text" id="jsr" name="jsr" class="form-control form-an form-an-end">
            </td>
        </tr>
    </table>
</form>

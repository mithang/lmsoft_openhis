
@{
    ViewBag.Title = "";
    Layout = "";
    var from = (ViewBag.from as string) ?? "";
}
<style>
    .table-responsive {
        border: 0;
    }

    .ui-jqgrid .ui-jqgrid-pager .ui-pager-table {
        width: 90%;
    }
</style>

<div class="topPanel" style="border-bottom:1px solid rgb(221, 221, 221);margin-bottom: 1%;">
    <div class="search">
        <table class="form">
            <tr>
                <th class="formTitle" style="width:50px">Số bệnh án：</th>
                <td class="formValue">
                    <input id="txt_blh" name="txt_blh" type="text" class="form-control form-an" placeholder="Vui lòng nhập số bệnh án" />
                </td>
                <th class="formTitle" style="width:50px">Họ tên：</th>
                <td class="formValue">
                    <input id="txt_xm" name="txt_xm" type="text" class="form-control form-an form-an-end" placeholder="Vui lòng nhập họ tên hoặc phiên âm đầu" />
                </td>
                <th class="formTitle" style="width:50px">Số giấy tờ：</th>
                <td class="formValue" style="width:150px">
                    <input id="txt_zjh" name="txt_zjh" type="text" class="form-control form-an form-an-end" placeholder="Vui lòng nhập chứng minh nhân dân" />
                </td>
                <td style="padding-left: 10px;">
                    <button type="button" id="btn_search" class="btn btn-primary btn-md">&nbsp;Tra cứu&nbsp;</button>
                </td>
            </tr>
        </table>
    </div>
</div>
<!--Thông tin bệnh nhân Bao gồm số bệnh án  Họ tên -->
<form id="formPatSer" style="margin:2px;margin-top:10px;">
    <div class="gridPanel">
        <table id="patGridList" rel="formPatSer"></table>
        <div id="gridPager" style="padding-right:20%"></div>
    </div>
</form>

<script>
    //Cái trướcwindowĐối tượng
    var prevWindow;
    if ('' !== '') {
        prevWindow = top.top.frames[''];
    }
    else {
        prevWindow = $.currentWindow();
    }

    $(function () {

        var obj = new Object;
        obj.blh = $.request("");
        var searInfo = new PatSearchInfo();
        //Tải dữ liệu
        searInfo.init(obj);

        $('').keyupEnterEvent(function () {
            $('').trigger('');
        });

        //Tra cứu
        $("").click(function () {
            $("").jqGrid('', {
                postData: {
                    blh: $("").val(), xm: $("").val(), zjh: $("").val()
                },
                page: 1,
                url: ""PatSearchInfo""
            }).trigger('');
        });
    });
    var PatSearchInfo = (function () {
        //Tải danh sách
        var loadGrid = function (data) {
            var $gridList = $("");
            $gridList.dataGrid({
                height: $(window).height() - 200,
                autowidth: false,
                width: $("").width() - 2,
                url: ""PatSearchInfo"",
                postData: { blh: $("").val(), xm: $("").val(), zjh: $("").val() },
                caption: '',
                colModel: [
                    { label: '', name: '', hidden: true },
                    { label: '', name: '', width: 50, align: '' },
                    { label: '', name: '', width: 70, align: '' },
                    { label: '', name: '', hidden: true, width: 120, align: '' },
                    {
                        label: '', name: '', width: 45, align: '', formatter: function (cellvalue) {
                            return $.getGender(cellvalue);
                        }
                    },
                    {
                        label: '', name: '', width: 45, align: '', formatter: function (cellvalue, options, rowObject) {
                            return getAgeFromBirthTime({ begin: rowObject.csny }).text;
                        }
                    },
                    { label: '', name: '', width: 150, align: '' },
                    { label: '', name: '', width: 80, align: '' },
                    { label: '', name: '', width: 80, align: '' },
                    { label: '', name: '', width: 60, align: '' },
                    { label: '', name: '', width: 80, align: '', hidden: true, },
                    { label: '', name: '', width: 80, align: '', hidden: true, },
                     { label: '', name: '', hidden: true }
                ],
                pager: "",
                sortname: '',
                viewrecords: true
            });
        };

        var myPatSearchInfo = function (data) {

        }

        //Sự kiện tải
        myPatSearchInfo.prototype.init = function (data) {
            if (data.blh === "") {
                $("").val("");
            } else {
                $("").val(data.blh);
            }
            loadGrid(data);
        };
        return myPatSearchInfo;
    }());

    //jqGrid Nhấp đúp để chọn một dòng
    function btn_edit() {
        PatSearchConfirm();
    }

    function PatDbGrid() {
        var $gridList = $("");
        var blh = $gridList.jqGridRowValue().blh;
        var obj = new Object();
        obj.blh = blh;
        obj.nlshow = $gridList.jqGridRowValue().nlshow;
        obj.xm = $gridList.jqGridRowValue().xm;
        obj.patid = $gridList.jqGridRowValue().patid;
        obj.startTime = $.currentWindow().$("").val();
        obj.endTime = $.currentWindow().$("").val();
        obj.CardId = $gridList.jqGridRowValue().CardId;
        prevWindow.GetQueryFphAjax(obj);
        //Đóng cửa sổ
        ReceiptCancle();
    }
    //Xác nhận Gọi từ trang chính
    function PatSearchConfirm() {
        PatDbGrid();
    }

    //Hủy
    function ReceiptCancle() {
        $.modalClose();
    }
</script>



        $("").html(patModel.jsr);
        $("").html(patModel.xm);
        $("").html(getAgeFromBirthTime({ begin: patModel.csny }).text);
        $("").html(patModel.phone);
        if (patModel.sycs) {
            $('').html("" + patModel.sycs + "");
        }
        $("").val(patModel.brxz);
        $("").html(patModel.mzh);
        //Tải thông tin bệnh nhân

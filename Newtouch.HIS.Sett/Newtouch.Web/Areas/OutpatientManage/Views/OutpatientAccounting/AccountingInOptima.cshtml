            var data = $("").jqGrid('', rowid);
            $('').removeAttr('');
            $('').removeAttr('');
            $('').removeAttr('');
        },
        gridComplete: function (data) {
            var ids = $("").jqGrid('');
            for (var i = 0; i < ids.length; i++) {
                var rowData = $("").jqGrid('', ids[i]);
                if (rowData) {
                    if (rowData.jfbId && rowData.jfbId != '') {//Đã xác nhận

        //$('').html('');
        if ('' === '') {
            $('').val('')
        } else {
            $('').html('');
        }
        $('').val('');
        $('').val('');
        $('').val('');
        $('').html('');
        $('').removeAttr('');
        $("").val("").trigger("");
        $('').val('');
        $("").val('');
        $('').val('');
        wqrje = '';
        ymzje = '';
        $("").html(wqrje);
        $("").html(ymzje);
        oldxmList = [];   //Các hạng mục đã gửi trước đâyList
        newxmList = [];   //Hạng mục mớiList
        var Editing_ysList = [];
        var Del_xmlist = [];//Đã xóalist
        editingNewid = null;    //Dòng đang sửa
        patInfoObj = {};//Thông tin cá nhânObjectĐối tượng
        bottomButtonsReset();
    }

    //Nhấn Enter số bệnh án
    $("").keydown(function (event) {
        var keyword = $.trim($("").val());
        if (event.keyCode === 13) {
            setTimeout(function () {
                if (keyword == null || keyword == undefined || keyword == "") {
                    $.modalAlert("", '');
                    return false;
                } else {
                    searchPatInfo('', keyword);
                }
            }, 0);
            event.preventDefault ? event.preventDefault() : (event.returnValue = false);
        }
    });

    //Thông tin cơ bản bệnh nhân lấy số bệnh án theo
    function searchPatInfo(IsBlh, keyword) {
        $.loading(true, "");
        $.ajax({
            type: "",
            url: "",
            data: { IsBlh: IsBlh, mzh: keyword },
            dataType: "",
            cache: true,
            async: true,
            success: function (ajaxresp) {
                if (ajaxresp.state === '') {
                    $("").clearGridData();
                    oldxmList = [];   //Các hạng mục đã gửi trước đâyList
                    newxmList = [];   //Hạng mục mớiList
                    funcDoPageClear(); //Xóa
                    if (ajaxresp.data.length > 1) {
                        GetPatSerarchView(keyword);
                    } else {
                        if (!!ajaxresp.data.OutpatAccInfoDto) {
                            respblh = ajaxresp.data.OutpatAccInfoDto.mzh;
                            setPatInfoModel(ajaxresp.data.OutpatAccInfoDto); //Gán thông tin cơ bản cá nhân
                        }
                        if ((!!ajaxresp.data.OptimAccInfoDto) && ajaxresp.data.OptimAccInfoDto.length > 0) {
                            newxmList = ajaxresp.data.OptimAccInfoDto;
                        }
                        fillDataToGrid();
                    }

                } else if (ajaxresp.state === '') {
                    $.modalAlert("", '');
                }
            },
            complete: function () {
                $.loading(false);
            }
        });
    }


    //Tra cứu
    function GetQueryFphAjax(obj) {
        searchPatInfo("", obj.mzh);
    }

    function funcDoPageClear() {
        $("").newtouchLocalDataGrid(null, oldxmList);
        $("").html('');
    }

    //填充病人基本信息
    function fillInfo(rep) {
        setPatInfoModel(rep);
    }

    //Khởi tạo thông tin bệnh nhân
    function setPatInfoModel(patModel) {
        $('').formSerialize(patModel);

        $("").val('' === "" ? patModel.blh : patModel.mzh);
        $("").html('' === "" ? patModel.mzh : patModel.blh);
        $("").html($.getGender(patModel.xb));
        $("").html((patModel.csny && patModel.csny.length >= 10 ? patModel.csny.substring(0, 10) : ""));
        $("").html(patModel.zjh);
        $("").html(patModel.jsr);
        $("").html(patModel.xm);
        $("").html(getAgeFromBirthTime({ begin: patModel.csny }).text);
        $("").html(patModel.phone);
        $("").val(patModel.ghrq && patModel.ghrq.length >= 10 ? patModel.ghrq.substring(0, 10) : "");
        if (patModel.sycs) {
            $('').html("" + patModel.sycs + "");
        }
        $("").val(patModel.brxz);
        //Tải thông tin bệnh nhân
        patInfoObj.xm = patModel.xm; //Họ tên
        patInfoObj.xb = patModel.xb; //Giới tính
        patInfoObj.csny = patModel.csny;
        patInfoObj.patid = patModel.patid; //Mã nội bộ bệnh nhân
        patInfoObj.blh = patModel.blh; //Số bệnh án
        patInfoObj.zjh = patModel.zjh; //Số giấy tờ
        patInfoObj.jsr = patModel.jsr; //Người giới thiệu
        patInfoObj.brxz = patModel.brxz;//Tính chất bệnh nhân
        patInfoObj.mzh = patModel.mzh;//Số ngoại trú
        patInfoObj.ghsj = patModel.ghsj;//Ngày điều trị
        var type = patModel.zjlx;
        switch (type) {
            case "":
                type = "";
                break;
            case "":
                type = "";
                break;
            case "":
                type = "";
                break;
            default:
                type = "";
                break;
        }
        $("").html(type);
        patInfoObj.zjlx = patModel.zjlx; //Loại giấy tờ
    }

    //Liên kết Chọn nhà trị liệu Cây
    $('').focus(function () {
        if ($(this).hasClass('') && Editing_ysList.length > 0) {
            return; //刚从上一个节点自动跳过来的
        }

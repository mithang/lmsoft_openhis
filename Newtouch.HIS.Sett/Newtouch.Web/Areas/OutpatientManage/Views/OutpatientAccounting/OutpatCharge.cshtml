        var txtSl = $('').val();
        if (txtDj && txtSl) {
            if (!isNaN(txtDj) && !isNaN(txtSl)) {
                resultZje = roundingBy4she6ru5chengshuang((parseFloat(txtDj) * parseFloat(txtSl)), 2);
            }
        }
        $('').html(resultZje);
    }


    //Kiểm tra dữ liệu đang chỉnh sửa（Chờ gửi）tính đầy đủ của
    function checkEditingRowData(rowData) {
        if (!rowData.ysList || rowData.ysList.length === 0 || rowData.ysList[0].gh == "") {
            $.modalAlert("", '');
        }
        else if (!rowData.sfxmCode || !rowData.sfxmmc || !rowData.yzlx || !rowData.sfdlCode || !rowData.sfdlmc) {
            $.modalAlert("", '');
        }
        else if (rowData.dw === "") {
            $.modalAlert("", '');
        }
        else if (rowData.yzlx === '' && (rowData.duration === "" || rowData.duration === "" || isNaN(rowData.duration))) {
            $.modalAlert("", '');
        }
        else if (!((/^(([1-9][0-9]*\.[0-9][0-9]*)|([0]\.[0-9][0-9]*)|([1-9][0-9]*)|([0]{1}))$/).test(rowData.dj))) {
            $.modalAlert("", '');
        }
        else if (rowData.dj === "" || isNaN(rowData.dj)) {
            $.modalAlert("", '');
        }
        else if (rowData.jzsj === "") {
            $.modalAlert("", '');
        }
        else if (rowData.sl === "" || isNaN(rowData.sl)) {
            $.modalAlert("", '');
        } else if (rowData.kflb == "") {
            $.modalAlert("", '');
        }
        else {
            return true;
        }
        return false;
    }


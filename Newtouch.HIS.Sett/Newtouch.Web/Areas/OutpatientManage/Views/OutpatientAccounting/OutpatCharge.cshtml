    function gridList() {
        if ($("").val() == "" && $("").val() == "") {
            $.modalAlert("", '');
            return;
        }
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            postData: { begindate: $("").val(), enddate: $("").val() },
            height: $(window).height() - 195,
            colModel: [
                { label: '', name: '', width: 60, align: '' },
                { label: '', name: '', width: 50, align: '' },
                {
                    label: '', name: '', width: 50, align: '', formatter: function (val) {
                        return val > 0 ? parseInt(val).toFixed(2) : "";
                    }
                },
                { label: '', name: '', width: 100, align: '', key: true },
                 {
                     label: '', name: '', width: 80, align: '', formatter: function (val) {
                         return val.length > 9 ? val.substring(0, 10) : "";
                     }
                 }
            ],
            rowNum: '',
            viewrecords: true,
            ondblClickRow: function (rowid) {
                gridEditRegisterRow(rowid);
            },
        });
        $("").click(function () {
            if ($("").val() == "" && $("").val() == "") {
                $.modalAlert("", '');
                return;
            }
            if ($('').val() && $('').val() && ($('').val() > $('').val())) {
                $.modalAlert("", '');
                return;
            }
            $gridList.jqGrid('', {
                postData: { begindate: $("").val(), enddate: $("").val() }
            }).trigger('');
        });
    }

@{
    ViewBag.Title = "";
    Layout = "";

    var curOpr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}
<form name="form1">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form">
            <tr>
                <th class="formTitle">Họ tên/Số ngoại trú/Phiên âm：</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="txtxm" name="txtxm" />
                </td>
                <th class="formTitle">Nhân viên thao tác：</th>
                <td class="formValue">
                    <div class="row">
                        <div class="col-md-9">
                            <input type="text" class="form-control" id="txtsyy" value="" />
                        </div>
                        <div class="col-md-3" style="text-align:right;">
                            <input type="button" class="btn btn-default btn-md" style="width:45px" id="btnsyy" value="Tra cứu" />
                        </div>
                    </div>
                </td>
                <td style="width:20px"></td>
                <th class="formTitle" id="thCZRQ">Thao tác ngày：</th>
                <td class="formValue" colspan="2">
                    <input id="txtCreateTimestart" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:42%; float:left;" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    <span style="margin-left:2%;float:left;">—</span>
                    <input id="txtCreateTimeEnd" type="text" class="form-control input-wdatepicker formClearIgnore" style="width :41%;float:left;margin-left:2%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                </td>
                <td class="formValue">
                    <input type="button" id="btn_search" class="btn btn-primary btn-md" style="margin-left:10px;width:40px;" value="Tra cứu" />
                </td>
                <th></th>
                <td></td>
            </tr>
            <tr></tr>
        </table>
    </div>
    <div class="gridPanel">
        <table id="gridJSList"></table>
        <div id="gridPager"></div>
    </div>
</form>

<script>
    $(function () {
        //Tải lại khi thay đổi kích thước cửa sổ trình duyệtjqGridchiều rộng của
        $(window).resize(function () {
            initLayout("");
        });
        //Bản ghi chính quyết toán
        gridJSListData();
    });
    //Tra cứu quyết toán đăng ký khám ngoại trú
    function gridJSListData() {
        var gridSort = '';

        var $gridJsList = $("");
        $gridJsList.dataGrid({
            postData: getSearchPostData(),
            height: $(window).height() - 178,
            url: "",
            colModel: [
                { label: '', name: '', hidden: true, align: '' },
                {
                    label: '', name: '', width: 120, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                {
                    label: '', name: '', width: 120, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 80, align: '' },
                
                { label: '', name: '', width: 70, align: '' },
                {
                    label: '', name: '', width: 50, align: '', formatter: function (cellvalue) {
                        return cellvalue==""?"":"";
                    }
                },
                { label: '', name: '', width: 120, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 100, align: '', hidden: true, },
                { label: '', name: '', width: 80, align: '', hidden: true },
                {
                    label: '', name: '', width: 70, align: '', formatter: function (cellvalue) {
                        return cellvalue ? cellvalue.toFixed(2) : "";
                    }
                },
                {
                    label: '', name: '', width: 70, align: '', formatter: function (cellvalue) {
                        return cellvalue ? cellvalue.toFixed(2) : "";
                    }
                },
                {
                    label: '', name: '', width: 70, align: '', formatter: function (cellvalue) {
                        return cellvalue ? cellvalue.toFixed(2) : "";
                    }
                },
                {
                    label: '', name: '', width: 100, align: '', hidden: true, formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                {
                    label: '', name: '', width: 60, align: "",
                    formatter: function (val) {
                        return $.enum.getDescByValue("", val);
                    }
                },
                { label: '', name: '', width: 80, align: '' },
               
                { label: '', name: '', align: '', hidden: true },
            ],
            pager: "",
            sortname: gridSort,
            viewrecords: true,
            footerrow: true,
            gridComplete: function (gridJszbList) {
                var rowNum = parseInt($(this).getGridParam(''), 10);
                if (rowNum > 0) {
                    var jszje = jQuery(this).getCol('', false, '');
                    var jsxjzf = jQuery(this).getCol('', false, '');
                    var jsjz = jQuery(this).getCol('', false, '');
                    $("").show();
                    $(this).footerData("", { "": "", "": jszje, "": jsxjzf, "": jsjz });
                } else {
                    $("").hide();
                }
            },
        });
        $("").click(function () {
            $gridJsList.jqGrid('', {
                postData: getSearchPostData(),
            }).trigger('');
        });
    }
    function getSearchPostData() {
        var xm = $("").val();
        var syy = $("").val();
        var createTimestart =  $("").val();
        var createTimeEnd =  $("").val();
        var sfrqTimestart = $("").val();
        var sfrqTimeEnd = $("").val();
        return {
            kh: "", fph: "", xm: xm, syy: syy, CreateTimestart: createTimestart, CreateTimeEnd: createTimeEnd
            , sfrqTimestart: sfrqTimestart, sfrqTimeEnd: sfrqTimeEnd
        };
    };


    //Người thao tác
    $("").click(function () {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + '' + "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].AcceptClick(function (data) {
                    userStaffTreeCallback(data);
                });
            }
        });
    });


    $(function () {
        var h = $(window).height() - 55
        $('').css('', h);
        setTimeout(function () { }, 100);
    });


</script>
@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
}
@Html.Partial("")
<form name="form1">
    <div class="panel panel-default" style="margin-bottom: 0%;background-color:lavender">
        <div class="panel-heading navb-bg">
            Nhập viện trả lại lần quyết toán bệnh nhân bảo hiểm y tế
        </div>
        <div style="padding-top:1%;padding-bottom:1%; padding-left:7%;" id="divInpatientBasicInfo">
            <table class="form">
                <tr>
                    <th class="formTitle">prm_yka103：</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="yka103" style="float:left;" />
                    </td>
                    <th class="formTitle">Số nhập viện：</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="zyh" style="float:left;" />
                    </td>
                    <td class="formValue">
                        <input type="button" id="btn_jsht" class="btn btn-primary" style="width:40%;margin-left:10px;" value="Quyết toán trả lại lần" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="panel panel-default" style="margin-bottom: 0%;">
        <div class="panel-heading navb-bg">
            Điều kiện lọc giao dịch không chắc chắn
        </div>
        <div style="padding-top:1%;padding-bottom:1%; padding-left:7%;" id="divInpatientBasicInfo">
            <table class="form">
                <tr>

                    <td class="formValue">
                        <input type="text" class="form-control" id="jybh" style="float:left;" />
                    </td>
                    <td class="formValue" colspan="2">
                        <input type="button" id="btn_search" class="btn btn-primary" style="width:15%; margin-left:10px;" value="Tra cứu" />
                        <input type="button" id="btn_confirm" class="btn btn-primary" style="width:15%;margin-left:10px;" value="Thực hiện" />
                        <input type="button" id="btn_cancel" class="btn btn-primary" style="width:15%;margin-left:10px;" value="Hủy" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel" style="margin-top:1%">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>
<script>
    //Tra cứu
    $('').click(function() {
        loadDataResult();
    });
    //Thực hiện
    $('').click(function() {
        confirm_yb();
    });
    //Hủy
    $('').click(function() {
        cancel_yb();
    });
    $('').click(function () {
        ybjsht();
    });

    function ybjsht() {
        var yka103 = $("").val();
        var zyh = $("").val();
        if (!yka103) {
            $.modalAlert("", '');
            return;
        }
        if (!zyh) {
            $.modalAlert("", '');
            return;
        }
        $.najax({
            url: '' + zyh,
            loadingtext: "",
            type: '',
            success: function (ybPreSettleReq) {
                var ybjshtReturn;
                var jshtData = {
                    prm_akc190: ybPreSettleReq.data.jzbh,
                    prm_aac001: ybPreSettleReq.data.sbbh,
                    prm_yab003: ybPreSettleReq.data.fzxbh,
                    prm_aka130: ybPreSettleReq.data.zhifuleibie,
                    prm_yka103: yka103,
                    prm_aae011: "",
                    prm_aae036: $.getTime(),
                    prm_aae013: "",
                    prm_ykb065: ybPreSettleReq.data.sbbf,
                    prm_ykc141: ""
                };
                $.ajax({
                    type: "",
                    url: "",
                    contentType: '',
                    data: JSON.stringify(jshtData),
                    dataType: "",
                    async: false,
                    success: function (data) {
                        ybjshtReturn = eval('' + data + '');
                    }
                });
                if (ybjshtReturn.Code == 0) {
                    $.modalAlert("", '');
                    var parameter1 = { "": ybjshtReturn.jylsh, "": ybjshtReturn.jyyzm };
                    $.ajax({
                        url: "",
                        data: parameter1,
                        dataType: "",
                        async: false,
                        success: function (data) {
                        }
                    });
                } else {
                    $.modalAlert(ybjshtReturn.ErrorMsg, '');
                }

                var ybReturn;
                var mnjsData = {
                    prm_akc190: ybPreSettleReq.data.jzbh,
                    prm_aac001: ybPreSettleReq.data.sbbh,
                    prm_yab003: ybPreSettleReq.data.fzxbh,
                    prm_aka130: ybPreSettleReq.data.zhifuleibie,
                    prm_aae036: "",
                    prm_ykb065: ybPreSettleReq.data.sbbf,
                    prm_ykc141: ""
                };
                $.ajax({
                    type: "",
                    url: "",
                    contentType: '',
                    data: JSON.stringify(mnjsData),
                    dataType: "",
                    async: false,
                    success: function (data) {
                        ybReturn = eval('' + data + '');
                    }
                });

                if (ybReturn.Code == 0) {
                    $.modalAlert("", '');
                    var parameter = { "": ybReturn.jylsh, "": ybReturn.jyyzm };
                    $.ajax({
                        url: "",
                        data: parameter,
                        dataType: "",
                        async: false,
                        success: function (data) {
                        }
                    });
                } else {
                    $.modalAlert(ybReturn.ErrorMsg, '');
                }
            }
        });
    }


    //ajaxTải dữ liệu
    function loadDataResult() {
        //Xóa trốngGrid
        $('').jqGrid("");
        /*
        var str = '' +
            '' +
            '';
        var yb_getuncertaintytrade = eval('' + str + '');
        yb_getuncertaintytrade.output.sqldata.row.push('');
        $('').jqGrid('', {
            datatype: '',
            data: yb_getuncertaintytrade.output.sqldata.row
        }).trigger("");
        */

        var jybh = $.trim($("").val());
        var yb_getuncertaintytradeInfo;// = $.guianyibao.YibaoGetUncertaintyTrade(jybh);
        var parameter = { "": jybh };
        $.ajax({
            url: "", 
            data: parameter,
            dataType: "",
            async: false,
            success: function (data) {
                yb_getuncertaintytradeInfo = eval('' + data + '');
            }
        });
        if (yb_getuncertaintytradeInfo && yb_getuncertaintytradeInfo.Code == 0) {
            var yb_getuncertaintytrade = yb_getuncertaintytradeInfo.Data;
            if (!yb_getuncertaintytrade) {
                $.modalAlert("", '');
                return;
            }
            var nullobj= {
                yke014: "", yke015: ""
            }
            yb_getuncertaintytrade.push(nullobj);
            $('').jqGrid('',
                {
                    datatype: '',
                    data: yb_getuncertaintytrade
                }).trigger("");
        } else
            $.modalAlert("", '');
    }

    window.newtouch_globalconfig.f4opions = {
        container: ""
    };

    //Giao dịch không chắc chắn
    $('').newtouchLocalDataGrid({
        caption: '',
        height: $(window).height() - 180,
        unwritten: false,
        editurl: "",
        colModel: [
            { label: "", name: "", width: 100, align: "" },
            { label: "", name: "", width: 180, align: "" }
        ],
        multiselect: true
    });

    function confirm_yb() {
        //Lấy dòng đã chọnId
        var selRowIds = $("").jqGrid('', '');
        if (selRowIds.length == 0) {
            $.modalAlert("", '');
            return;
        }
        if (!confirm("")) {
            return;
        }
        var IsSuccess = true;
        //Đánh giá số lượng trả lại
        for (var i = 0; i < selRowIds.length; i++) {
            var rowData = $("").jqGrid('', selRowIds[i]);
            if (!rowData) {
                $.modalAlert("", '');
                break;
            }
            $.najax({
                url: "",
                data: { jylsh: rowData[""] },
                dataType: '',
                async: false,
                success: function (rep) {
                    if (rep == "") {
                        IsSuccess = false;
                        $.modalAlert("" + rowData[""] + "", '');
                    } else {
                        alert(rep);
                        try {
                            var ybjySettReturn;// = $.guianyibao.YibaoConfirm(rowData[""], rep);
                            var parameter = { "": rowData[""], "": rep };
                            $.ajax({
                                url: "", 
                                data: parameter,
                                dataType: "",
                                async: false,
                                success: function (data) {
                                    ybjySettReturn = eval('' + data + '');
                                }
                            });
                            if (!ybjySettReturn || !(ybjySettReturn.Code == 0)) {
                                $.modalAlert("" + jylsh + "", '');
                                IsSuccess = false;
                            }
                        } catch (err) {
                            IsSuccess = false;
                            $.modalAlert("" + err, '');
                        }
                    }
                }
            });
            if (!IsSuccess) {
                loadDataResult();
                return;
            }
        }
        $.modalAlert("", '');
        loadDataResult();
    }

    function cancel_yb() {
        //Lấy dòng đã chọnId
        var selRowIds = $("").jqGrid('', '');
        if (selRowIds.length == 0) {
            $.modalAlert("", '');
            return;
        }
        if (!confirm("")) {
            return;
        }

        //Đánh giá số lượng trả lại
        for (var i = 0; i < selRowIds.length; i++) {
            var rowData = $("").jqGrid('', selRowIds[i]);
            if (!rowData) {
                $.modalAlert("", '');
                break;
            }
            var ybjySettReturn;// = $.guianyibao.YibaoCancle(rowData[""]);
            var parameter = { "": rowData[""] };
            $.ajax({
                url: "", 
                data: parameter,
                dataType: "",
                async: false,
                success: function (data) {
                    ybjySettReturn = eval('' + data + '');
                }
            });
            if (!(ybjySettReturn.Code == 0)) {
                $.modalAlert("" + jylsh + "", '');
                loadDataResult();
                return;
            }
        }
        $.modalAlert("", '');
        loadDataResult();
    }

</script>

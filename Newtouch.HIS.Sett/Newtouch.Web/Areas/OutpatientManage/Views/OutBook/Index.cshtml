@using Newtouch.Infrastructure

@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="topPanel">
    <div class="search">
    <table>
        <tr>
            <td>
                <div class="input-group">
                    <input id="txt_keyword" type="text" class="form-control" placeholder="Khoa" style="width: 180px;">
                    <span class="input-group-btn">
                        <button id="btn_search" type="button" class="btn btn-primary"><i class="fa fa-search"></i></button>
                    </span>
                </div>
            </td>
        </tr>
    </table>
</div>
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Bác sĩ</a>
        </div>
        <div class="btn-group">
            <a id="NF-add" class="btn btn-primary dropdown-text" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_set()"><i class="fa fa-pencil-square-o"></i>Đặt lịch trực</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_create()"><i class="fa fa-pencil-square-o"></i>Tạo lịch trực</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_createtime()"><i class="fa fa-pencil-square-o"></i>维护排班时间</a>
        </div>
    </div>
    
</div>

<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>
<script>
    var OrganizeId = '';

    $(function () {
        GridInit();
    });

    function GridInit() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            autowidth: true,
            height: $(window).height() - 118,
            colModel: [
                { label: "", name: "", hidden: true },
                {
                    label: "", name: "", width: 130, align: '', formatter: function (val) {
                        return $.enum.getDescByValue("", val);
                    }
                },
                { label: "", name: "", width: 130, align: '' },
                { label: "", name: "", width: 130, align: '' },
                { label: "", name: "", width: 130, align: '' },
                { label: "", name: "", width: 130, align: '' },
                { label: "", name: "", width: 130, align: '' },
                {
                    label: "", name: "", width: 130, align: '', formatter: function (val) {
                        if (val == "") {
                            return "";
                        }
                        else if (val == "") {
                            return "";
                        }
                    }
                },
                {
                    label: "", name: "", hidden: true 
                },
                {
                    label: "", name: "", hidden: true
                },
                {
                    label: "", name: "", hidden: true
                }
            ],
            sortname: "",
            rowNum: 10,
            pager: "",
            viewrecords: true,
            ondblClickRow: function () {
                btn_set();
            },
        });
        $("").click(function () {
            $("").jqGrid('', {
                postData: { keyword: $("").val() }, page: 1
            }).trigger('');
        });
    }


    function btn_edit() {
        var keyValue = $("").jqGridRowValue().ghpbId;
        var ks = $("").jqGridRowValue().ks;
        var ys = $("").jqGridRowValue().ys;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return false;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue + "" + ks+""+ys,
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("").resetSelection();
                    $("").trigger("");
                });
            }
        });
    }

    function btn_set() {
        var ghpbId = $("").jqGridRowValue().ghpbId;
        //var OrganizeId = $("").jqGridRowValue().OrganizeId;
        if (!!!ghpbId) {
            $.modalAlert("", '');
            return false; 
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + ghpbId + "" + OrganizeId+"",
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("").resetSelection();
                    $("").trigger("");
                });
            }
        });
    }

    //Thêm mới lịch trực
    function btn_add() {
        var ghpbId = 0;
        //var OrganizeId = $("").jqGridRowValue().OrganizeId;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + ghpbId + "" + OrganizeId+"",
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("").resetSelection();
                    $("").trigger("");
                });
            }
        });
    }

    //Tạo lịch trực
    function btn_create() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            btn: null,
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("").resetSelection();
                    $("").trigger("");
                });
            }
        });
    }
    //Tạo thời gian lịch trực
    function btn_createtime() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                });
            }
        });
    }
</script>

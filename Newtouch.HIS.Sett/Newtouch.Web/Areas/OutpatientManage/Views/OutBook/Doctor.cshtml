
@{
    ViewBag.Title = "";
    Layout = "";
}

<form id="form1">
</form>


<script>
    var keyValue = $.request("");
    var ks = $.request("");
    var ys = $.request("");

    $.ajax({
        url: "",
        //data: { keyValue: keyValue },
        dataType: "",
        success: function (data) {
            var html = "";
            for ( i = 0; i < data.length; i++){
                //html += "" + data[i].gh + "" + data[i].Name + "";
                html += "" + data[i].gh + "" + data[i].Name + "";
            }
            $("").html(html);
            //Mặc định tải đã chọn
            if (ys != null) {
                if (ys.indexOf("") == -1) {
                    $("" + ys + "").prop("", true);
                } else {
                    var ysList = ys.split("");
                    for (i = 0; i < ysList.length; i++) {
                        $("" +ysList[i] + "").prop("", true);
                    }
                }
            }
        }
    });

    function AcceptClick(callBack) {
        var checkId = $("");
        var ghList = [];
        for (i = 0; i < checkId.length; i++) {
            ghList.push(checkId[i].value);
        }
        $.submitForm({
            url: "",
            param: { ks: ks, ghList: ghList },
            success: function () {
                callBack();
                $.modalClose();
            }
        });
    }
</script>
                EnableRehabInlineEditBox();    //Khởi động lại và bật chỉnh sửa Nếu không lần sauSavekhi đó sẽ trả vềfalse
                $.modalAlert("", '');
                return;
            }
            $.each(gridzljyData, function () {    //Loại bỏaction
                for (var i = 0; i < $(this).length; i++) {
                    delete $(this)[i].action;
                }
            });
            $("").show();
            $("").hide();
            $("").hide();

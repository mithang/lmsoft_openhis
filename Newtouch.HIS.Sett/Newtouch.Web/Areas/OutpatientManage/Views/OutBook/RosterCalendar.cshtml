                }
                now.setDate(now.getDate() - lastDay) //Thời gian hiện tại lần đặt thời gian 否则影响后面时间的获取
                now.setDate(1)

                $('').html(now.getFullYear() + '' + (now.getMonth() + 1) + '')
            }


                        }
                        else if (val == "") {
                            return "";
                        }
                        else if (val == "") {
                            return "";
                        }
                        else if (val == "") {
                            return "";
                        }
                    }
                },
            ],
            sortname: "",
            rowNum: 10,
            pager: "",
            viewrecords: true,
        });
    }
</script>

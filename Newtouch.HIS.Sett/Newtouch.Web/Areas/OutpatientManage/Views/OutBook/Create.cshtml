
@{

    ViewBag.Title = "";
    Layout = "";
}

<!DOCTYPE html>

<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>


<script>

    $(function () {
        GridInit();
    });
    
    function GridInit() {
        var $gridList = $("");
        var myDate = new Date(); 
        var time = myDate.getFullYear() + "" +(myDate.getMonth() + 1) + "" + myDate.getDate() + "" +"";
        $gridList.dataGrid({
            url: ""+time,
            autowidth: true,
            height: $(window).height() - 118,
            colModel: [
                { label: "", name: "", hidden: true },
                { label: "", name: "", width: 40, align: '' },
                {
                    label: "", name: "", width: 120, align: '', formatter: function (val) {
                        if (val.indexOf("")) {
                            return val.replace('', '');
                        } else {
                            return val;
                        }
                    }
                },
                { label: "", name: "", width: 80, align: '', hidden: true },
                { label: "", name: "", width: 100, align: '' },
                { label: "", name: "", width: 80, align: '', hidden: true},
                { label: "", name: "", width: 80, align: '' },
                {
                    label: "", name: "", width: 60, align: '', formatter: function (val) {
                        if (val == "") {
                            return "";
                        }
                        else if (val == "") {
                            return "";
                        } else if (val == "") {
                            return "";
                        }
                        else if (val == "") {
                            return "";
                        }
                        else if (val == "") {
                            return "";
                        }
                        else if (val == "") {
                            return "";
                        }
                        else if (val == "") {
                            return "";
                        }
                        else if (val == "") {
                            return "";
                        }
                        else if (val == "") {
                            return "";
                        }
                        else if (val == "") {
                            return "";
                        }
                        else if (val == "") {
                            return "";
                        }
                    }
                },
                { label: "", name: "", width: 90, align: '' },
                { label: "", name: "", width: 80, align: '' },
                { label: "", name: "", width: 60, align: '' },
                { label: "", name: "", width: 80, align: '' },
                { label: "", name: "", width: 80, align: '' },
                { label: "", name: "", width: 60, align: '' },
                {
                    label: "", name: "", width: 100, align: '', formatter: function (val) {
                        if (val == "") {
                            return "";
                        }
                        else if (val == "") {
                            return "";
                        }
                    }
                },
                { label: "", name: "", width: 80, align: '' },
                { label: "", name: "", width: 120, align: '' },
                {
                    label: "", name: "", width: 80, align: '', formatter: function (val) {
                        if (val == "") {
                            return "";
                        }
                        else if (val == "") {
                            return "";
                        }
                        else if (val == "") {

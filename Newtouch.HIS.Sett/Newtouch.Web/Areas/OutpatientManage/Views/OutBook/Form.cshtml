    //确定按钮点击事件
    function AcceptClick(callBack) {
        debugger;
        if (!$('').formValid()) {
            return false;
        }
        var postData = $("").formSerialize();
        postData.zt = postData.zt == true ? "" : "";
        if (postData.sfxmmc == "") {

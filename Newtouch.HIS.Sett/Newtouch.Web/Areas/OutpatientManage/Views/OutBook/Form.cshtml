        if ($('').prop('')) {
            if (ghpbId != null && ghpbId != "" && ghpbId != "") {
                $.ajax({
                    url: "" + ghpbId,
                    dataType: "",
                    async: false,
                    success: function () {
                    }
                });
            }
            else {
                for (var i = 1; i <= 1; i++) {
                    var aa = document.getElementsByName('' + i);
                    postData.hy1 = aa[0].value;
                    postData.hy2 = aa[1].value;

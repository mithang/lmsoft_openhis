        }
        if (postData.zlxmmc == "") {
            postData.zlxm = "";
        }
        if (postData.ksmz == "") {
            postData.ks = "";
        }
        if (postData.mjzbz == '' && (postData.ys == '' || postData.ysxm == '')) {
            $.modalAlert("", '');

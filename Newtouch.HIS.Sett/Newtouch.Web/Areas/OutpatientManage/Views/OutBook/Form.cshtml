                    postData.hy7 = aa[6].value;
                    postData.sjd = $('' + i).val();
                    $.ajax({
                        url: "" + ghpbId,
                        dataType: "",
                        data: postData,
                        async: false,
                        success: function () {
                        }
                    });
                    if (i == inttime - 1) {
                        callBack();
                        $.modalClose();
                    }
                }
            }
        } else {
            if (ghpbId != null && ghpbId != "") {
                $.ajax({
                    url: "" + ghpbId,
                    dataType: "",
                    async: false,
                    success: function () {
                    }
                });
            }
            $.submitForm({
                url: "" + ghpbId,
                param: postData,
                success: function () {
                    callBack();
                    $.modalClose();
                }
            })
        }
    }



                async: false,
                success: function (data) {
                    if (data != null && data != "") {
                        jzsjd();
                        $('').prop('', true);
                        var aa = document.getElementsByName('');
                        for (var i = 0; i < aa.length; i++) {
                            $.ajax({
                                url: "" + ghpbId + ""+aa[i].value,
                                dataType: "",
                                async: false,
                                success: function (data1) {
                                    if (data1 != null && data1 != "") {
                                        if (data1[0].isBook == "") {
                                            $('').prop('', true);
                                        } else { $('').prop('', true);}
                                        document.getElementsByName("" + (i + 1) + "")[0].value = data1[0].hy1;
                                        document.getElementsByName("" + (i + 1) + "")[1].value = data1[0].hy2;
                                        document.getElementsByName("" + (i + 1) + "")[2].value = data1[0].hy3;
                                        document.getElementsByName("" + (i + 1) + "")[3].value = data1[0].hy4;
                                        document.getElementsByName("" + (i + 1) + "")[4].value = data1[0].hy5;
                                        document.getElementsByName("" + (i + 1) + "")[5].value = data1[0].hy6;
                                        document.getElementsByName("" + (i + 1) + "")[6].value = data1[0].hy7;
                                    }
                                }
                            });
                        }
                    } else {
                        if (pdsj) {
                            $('').prop('', true);
                            $.ajax({
                                url: "" + ghpbId,
                                dataType: "",
                                async: false,
                                success: function (data) {
                                    $("").formSerialize(data);
                                    if (data && data.isBook == "") {
                                        $('').prop('', true);
                                    } else { $('').prop('', true); }
                                }
                            });
                        } else {
                            jzsjd();
                        }
                        
                    }
                }
            });
        }
    }

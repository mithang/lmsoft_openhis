@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
    //开启治疗项目组合
    var zlxmzhconf = SysConfigReader.String("");
}
<ul id="myTab" class="nav nav-tabs">
    <li class="active"><a href="#BookTab" data-toggle="tab">Danh sách đặt trước</a></li>
    <li><a href="#onlineBook" data-toggle="tab">Đặt trước trực tuyến</a></li>
</ul>
<div class="tab-content" style="margin-top:1%">
    <div class="tab-pane fade in active" id="BookTab">
        <form name="form1">
            <div class="panel panel-default">
                <table class="form">
                    <tr>

                        <th class="formTitle"> Từ khóa</th>
                        <td class="formValue">
                            <input type="text" class="form-control" id="keyValue" name="KeyValue" placeholder="Họ tên hoặc Số giấy tờ" />
                        </td>
                        <th class="formTitle">Trạng thái đặt trước</th>
                        <td class="formValue">
                            <select id="sel_yyzt" class="form-control required" data-EnumType="EnumMzyyzt">
                                <option value="">Vui lòng chọn</option>
                            </select>
                        </td>
                        <th class="formTitle">预约来源</th>
                        <td class="formValue">
                            <select id="sel_yyly" class="form-control required" data-EnumType="EnumMzghly">
                                <option value="">Vui lòng chọn</option>
                            </select>
                        </td>
                        <th class="formTitle">Ngày đặt trước：</th>
                        <td class="formValue" colspan="2">
                            <input id="txtyykssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:42%; float:left;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                            <span style="margin-left:2%;float:left;">—</span>
                            <input id="txtyyjssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width :41%;float:left;margin-left:2%;" value="@DateTime.Now.AddDays(3).ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        </td>

                        <td class="formValue"></td>
                    </tr>
                    <tr>
                        <th class="formTitle">
                            <span class="required">*</span>Khoa：
                        </th>
                        <td class="formValue">
                            <input type="text" class="form-control" id="txtkschoose" />
                        </td>
                        <th class="formTitle"><span class="required">*</span>Loại ngoại trú：</th>
                        <td class="formValue formDdlSelectorTd">
                            <select id="sel_mzlx" class="form-control required" data-EnumType="EnumOutPatientType">
                                <option value="">Vui lòng chọn</option>
                            </select>

                        </td>
                        <td class="formValue" colspan="2">
                            <input type="button" id="btn_search" class="btn btn-primary btn-md" style="margin-left:10px;width:40px;" value="Tra cứu" />
                            <input type="button" id="btn_CancalYy" class="btn btn-primary btn-md" style="margin-left:10px;" value="Hủy đặt trước" />
                        </td>
                    </tr>
                </table>
            </div>
            <div class="gridPanel">
                <table id="patGridList"></table>
                <div id="gridPager"></div>
            </div>
        </form>
    </div>
    <div class="tab-pane fade" id="onlineBook">
            <div class="panel panel-default">
                <table class="form">
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Số bệnh án/Họ tên：</th>
                        <td class="formValue">
                            <input type="hidden" id="patid" />
                            <input type="text" class="form-control" id="blh" placeholder="Ít nhất1ký tự vị" />
                        </td>
                        <th class="formTitle">
                            <input type="button" class="btn btn-default btn-md btn-default-color" id="btnsyy" value="Tra cứu" onclick="GetPatSerarchView($('#blh').val());" />
                        </th>
                        <th class="formTitle">Họ tên：</th>
                        <td class="formValue" style="width:80px;">
                            <label id="xm"></label>
                        </td>
                        <th class="formTitle">Giới tính：</th>
                        <td class="formValue">
                            <label id="xb"></label>
                        </td>
                        <th class="formTitle">Tuổi：</th>
                        <td class="formValue">
                            <label id="nlshow"></label>
                        </td>
                        <td class="formTitle">Số thẻ：</td>
                        <td class="formValue">
                            <label id="CardTypeName"></label>
                            <label id="kh"></label>
                        </td>
                    </tr>
                    <tr>
                        <td class="formTitle">
                            <label id="zjlx">Số giấy tờ：</label>
                        </td>
                        <td class="formValue">
                            <label id="zjh"></label>
                            <input type="text" style="display:none;" id="hiddenzjlx" />
                        </td>
                        <th class="formTitle">Khám lần đầu/tái khám：</th>
                        <td class="formValue">
                            <label id="txtcfz"></label>
                        </td>
                        <td class="formTitle"></td>
                        <td class="formValue"></td>
                        <td class="formTitle"></td>
                        <td class="formValue"></td>
                        <td class="formTitle"></td>
                        <td class="formValue"></td>
                    </tr>
                </table>
                <div class="panel-heading navb-bg">
                    Lọc lịch trực
                </div>
                <table class="form">
                    <tr>
                        <th class="formTitle">Thời gian ：</th>
                        <td class="formValue">
                            <input type="text" id="czrq" class="form-control input-wdatepicker formClearIgnore" style="height:20px;width:100px" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' });xzsj()" />
                        </td>
                        <th class="formTitle">Loại ngoại trú：</th>
                        <td class="formValue">
                            <select id="mjzbz" class="form-control required" data-EnumType="EnumOutPatientType">
                                <option value="">Vui lòng chọn</option>
                            </select>
                        </td>
                        <th class="formTitle">Khoa：</th>
                        <td class="formValue">
                            <input type="text" class="form-control" id="txtyykschoose" />
                        </td>

                        <th class="formTitle">Bác sĩ lịch trực：</th>
                        <td class="formValue"><input type="text" id="doctormc2" name="doctormc2" class="form-control form-an" /></td>
                        <td class="formValue" colspan="2">
                            <input type="button" id="btn_searchrl" class="btn btn-primary btn-md" style="margin-left:10px;width:40px;" value="Tra cứu" />
                            <input type="button" id="btn_yy" class="btn btn-primary btn-md" style="margin-left:10px;width:40px;" value="Đặt trước" />
                        </td>
                        <th class="formTitle"></th>
                    </tr>
                </table>
            </div>
            <div class="gridPanel">
                <table id="patGridList2"></table>
                @*<div id="gridPager2"></div>*@
            </div>
    </div>

</div>


<script>
    $(function () {
        $(window).resize(function () {
            initLayout("");
        });

        InitBindSel();
        gridList();

    });
    function InitBindSel()
    {
        //Khoa
        $("").newtouchBatchFloatingSelector({
            height: 200,
            width: 300,
            clickautotrigger: true,
            filter: function (keyword) {
                //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
                var resultObjArr = new Array();
                $.each(top.window.clients.sysDepartList, function (idx, val) {
                    if ((val.py && val.py.toLowerCase().indexOf(keyword) >= 0)
                        || (val.Name && val.Name.indexOf(keyword) >= 0)
                        || keyword.trim() == "") {
                        resultObjArr.push(val);
                    }
                });
                return resultObjArr;

            },
            caption: "",
            colModel: [
                { label: '', name: '', widthratio: 30 },
                { label: '', name: '', widthratio: 50 },
                { label: '', name: '', hidden: true }
            ],
            itemdbclickhandler: function ($thistr) {
                $("").attr("", $thistr.find("").html());
                $("").val($thistr.find('').html());
                $("").trigger("");
                return;
            },
        });
        //Khoa
        $("").newtouchBatchFloatingSelector({
            height: 200,
            width: 300,
            clickautotrigger: true,
            filter: function (keyword) {
                //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
                var resultObjArr = new Array();
                $.each(top.window.clients.sysDepartList, function (idx, val) {
                    if ((val.py && val.py.toLowerCase().indexOf(keyword) >= 0)
                        || (val.Name && val.Name.indexOf(keyword) >= 0)
                        || keyword.trim() == "") {
                        resultObjArr.push(val);
                    }
                });
                return resultObjArr;

            },
            caption: "",
            colModel: [
                { label: '', name: '', widthratio: 30 },
                { label: '', name: '', widthratio: 50 },
                { label: '', name: '', hidden: true }
            ],
            itemdbclickhandler: function ($thistr) {
                $("").attr("", $thistr.find("").html());
                $("").val($thistr.find('').html());
                $("").trigger("");
                return;
            },
        });
        ///Bác sĩ
        $("").newtouchFloatingSelector({
            height: 200,
            width: 480,
            clickautotrigger: true,
            filter: function (keyword) {
                //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
                var resultObjArr = new Array();

                $.each(top.window.clients.sysStaffDutyList, function (idx, val) {
                    if (((val.StaffPY && val.StaffPY.toLowerCase().indexOf(keyword.toLowerCase()) >= 0)
                        || (val.StaffName && val.StaffName.indexOf(keyword.toLowerCase()) >= 0)
                        || keyword.trim() == "")
                        && val.DutyCode == "") {
                        resultObjArr.push(val);
                    }
                });
                return resultObjArr;

            },
            caption: "",
            colModel: [
                {
                    label: '', name: '', widthratio: 25
                },
                {
                    label: '', name: '', widthratio: 25
                },
                { label: '', name: '', widthratio: 25 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("").attr("", $thistr.find("").html());
                $("").val($thistr.find('').html());
                $("").trigger("");
                return;
            }
        });
    }

    function gridList()
    {
        var $gridList = $("");
        $gridList.dataGrid({
            width:"",
            height: $(window).height() - 225,
            url: "",
            postData: getSearchPostData(),
            autowidth: true,
            caption: '',
            colModel: [
                { label: '', name: '', hidden: true, },
                {
                    label: '', name: '', width: 60, align: '',
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                { label: '', name: '', width: 50, align: '' },
                {
                    label: '', name: '', width: 30, align: '', formatter: function (val) {
                        return val == "" ? "" : "";
                    }
                },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 120, align: '', hidden: true },
                { label: '', name: '', width: 55, align: '', },
                { label: '', name: '', hidden: true },
                { label: '', name: '', width: 100, align: '', hidden: true },
                { label: '', name: '', width: 120, align: '', hidden: true },
                {
                    label: '', name: '', width: 60, align: '', formatter: function (val) {
                        return $.enum.getDescByValue("", val);
                    }
                },
                { label: '', name: '', width: 120, align: '', hidden: true },
                {
                    label: '', name: '', width: 60, align: '', formatter: function (val) {
                        return $.enum.getDescByName("", val);
                    }
                },
                {
                    label: '', name: '', width: 60, align: '', formatter: function (val) {
                        return $.enum.getDescByValue("", val);
                    }
                },
                { label: '', name: '', hidden: true, width: 120, align: '', hidden: true },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 120, align: '' },
                { label: '', name: '', width: 120, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 40, align: '' }
            ],
            pager: "",
            sortname: '',
            multiselect: false,
            viewrecords: true
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: getSearchPostData(),
            }).trigger('');
        });
        $("").change(function () {
            $gridList.jqGrid('', {
                postData: getSearchPostData(),
            }).trigger('');
        });

        var $gridList2 = $("");
        $gridList2.dataGrid({
            autowidth: false,
            height: $(window).height() - 225,
            url: "",
            postData: getyySearchPostData(),
            caption: '',
            colModel: [
                { label: '', name: '', width: 120 },
                {
                    label: '', name: '', width: 100, formatter: "",
                    formatoptions: { srcformat: '', newformat: '' }
                },
                {
                    label: '', name: '', width: 80, formatter: function (val) {
                        return $.enum.getDescByValue("", val);
                    }
                },
                { label: '', name: '', width: 105 },
                { label: '', name: '', width: 120 },
                { label: '', name: '', width: 120 },
                { label: '', name: '', width: 70 },
                
                { label: '', name: '', width: 60 },
                { label: '', name: '', width: 50 },
                {
                    label: '', name: '', width: 50, formatter: function (cellvalue, options, rowobject) {
                        return (rowobject.TotalNum - rowobject.YYNum)
                    }
                },
                {
                    label: '', name: '', width: 60, formatter: function (val) {
                        return $.enum.getDescByValue("", val);
                    }
                },
                { label: '', name: '', width: 120 },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
            ],
            //pager: "",
            //sortname: '',
            viewrecords: true,
        });
        $("").click(function () {
            $gridList2.jqGrid('', {
                postData: getyySearchPostData(),
            }).trigger('');
        });
        $("").change(function () {
            $gridList2.jqGrid('', {
                postData: getyySearchPostData(),
            }).trigger('');
        });
    }
    function getSearchPostData()
    {
        return {
            yykssj: $("").val(), yyjssj: $("").val(), yyzt: $("").val(), ghly: $("").val(),
            keyValue: $("").val(), isfeegroup: '', mzlx: $("").val(), ks: $("").val()//attr("")
        };
    }
    function getyySearchPostData()
    {
        return {
            pbks: $("").val(), mzlx: $("").val(), ys: $("").val(),
            OutDate: $("").val()
        };
    }


    //Bật lên tra cứu bệnh nhân
    function GetPatSerarchView(blh) {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + Math.random() + "" + blh,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
            }
        });
    }
    var patModel = null;
    function GetQueryFphAjax(obj, funcSuccCallback) {
        newtouch_event_f4();
        $.najax({
            url: "",
            data: obj,
            dataType: "",
            async: false,
            success: function (rep) {
                if (rep.data && !!!rep.data.brxz) {
                    $.modalAlert("", '');
                    return false;
                }
                if (rep.data && !!!rep.data.CardTypeName) {
                    $.modalAlert("", '');
                    return false;
                }
                patModel = rep.data;
                $("").html($.getGender(patModel.xb));
                $("").html(patModel.zjh);
                $("").html(patModel.xm);
                $("").val(patModel.blh);
                $("").html(getAgeFromBirthTime({ begin: patModel.csny.replace('', '') }).text);
                $("").html(patModel.kh);
                $("").val(patModel.patid);
                $("").html('' + patModel.CardTypeName + '');
                if (patModel.fzbz === 0) {
                    $("").html("");
                }
                else {
                    $("").html("");
                }
            }
        });
    }
    //Đặt trước
    $("").click(function () {
        if (!patModel) {
            $.modalAlert("", "");
            return;
        }
        var seleRow = check();
        if (!!!seleRow) {
            return;
        }
        $.najax({
            url: "",
            dataType: "",
            loadingtext: "",
            data: { OutDate: seleRow.OutDate, cardNo: patModel.kh, ScheduId: seleRow.ghpbId, brxz: patModel.brxz },
            type: "",
            success: function (ajaxresp) {
                $.modalAlert("", "");
                $("").trigger("");
            }
        });
       
    });
    function check()
    {
        var seleRow = $("").jqGridRowValue();
        if (!!!seleRow.ghpbId)
        {
            $.modalAlert("", "");
            return;
        }
        if (seleRow.TotalNum==='') {
            $.modalAlert("", "");
            return;
        }
        if (seleRow.YYNum === '') {
            $.modalAlert("", "");
            return;
        }
        if (seleRow.IsBook === '') {
            $.modalAlert("", "");
            return;
        }
        if (seleRow.OutDate < $.getDate()) {
            $.modalAlert("", "");
            return;
        }
        return seleRow;
    }


    //Hủy đặt trước
    $("").click(function () {
        var seleRow = $("").jqGridRowValue();
        if (!!!seleRow.BookId) {
            $.modalAlert("", "");
            return;
        }
        if (seleRow.AppId!="")
        {
            $.modalAlert("", "");
            return;
        }
        $.najax({
            url: "",
            dataType: "",
            loadingtext: "",
            data: { BookId: seleRow.BookId },
            type: "",
            success: function (ajaxresp) {
                $.modalAlert("", "");
                $("").trigger("");
            }
        });
     
    });

    function newtouch_event_f4() {
        patModel = null;
        $("").val("");
        $("").val("");
        $("").html("");
        $("").html("");
        $("").html("");
        $("").html('');
        $("").html("");
        $("").html("");
        $("").html("");
    }

</script>
@using Newtouch.Infrastructure;
@{

    ViewBag.Title = "";
    Layout = "";
}

<!DOCTYPE html>

<form id="form1">
    <div style="padding: 20px 35px 0 2px;">
    <table class="form" id="tabletime">
        <tr>
            <th class="formTitle">时间段选择:</th>
            <td>
                <i id="zdCircle" class="fa fa-plus-circle plusToggleCircle" aria-hidden="true" style="margin-left: 10px; color: #6ff3ad; font-size: large;" onclick="btn_addtime()"></i>
            </td>
        </tr>
        <tr id="trtime1">
            <th class="formTitle">Thời gian bắt đầu ：</th>
            <td class="formValue">
                <input id="begintime1" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("HH:mm")" onfocus="WdatePicker({ dateFmt: 'HH:mm' })" />
            </td>
            <th class="formTitle">Thời gian kết thúc ：</th>
            <td class="formValue">
                <input id="endtime1" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("HH:mm")" onfocus="WdatePicker({ dateFmt: 'HH:mm' })" />
            </td>
        </tr>
    </table>
        </div>
</form>

<script>
    var inttime = 2;
    var sjd = $.request("");
    $(function () {
        $.ajax({
            url: "",
            dataType: "",
            async: false,
            success: function (data) {
                for (var i = 0; i < data.length; i++) {
                    if (i == 0) {
                        $('').val(data[i].split('')[0]);
                        $('').val(data[i].split('')[1]);
                    } else {
                    var thisHtml = '' + inttime + '' + inttime + '' + inttime + '' + data[i].split('')[0] + '' + inttime + '' + data[i].split('')[1]  + '';
                        $('').append(thisHtml);
                        inttime += 1;
                    }
                }
            }
        });
        if (sjd != null && sjd != "") {
            if (sjd.split('').length == 0) {
                $('').val(sjd.split('')[0]);
                $('').val(sjd.split('')[1]);
            } else {
            for (var i = 0; i < sjd.split('').length; i++) {
                if (i == 0) {
                    $('').val(sjd.split('')[0]);
                    $('').val(sjd.split('')[i].split('')[1]);
                }
                else {
                    var thisHtml = '' + inttime + '' + inttime + '' + inttime + '' + sjd.split('')[i].split('')[0]+'' + inttime + '' + sjd.split('')[i].split('')[1]+'';
                    $('').append(thisHtml);
                    inttime += 1;
                }
                }
            }
        }
    });
    function btn_addtime() {
        var thisHtml = '' + inttime + '' + inttime + '' + inttime + '' + inttime + '';
        $('').append(thisHtml);
        inttime += 1;
    }
    function btn_clertime(inttimetr) {
        $('' + inttimetr).html('');
    }
    function AcceptClick(callBack) {
        var timestr = "";
        for (var i = 1; i < inttime; i++) {
            if ($('' + i).val() != null && $('' + i).val() != null && $('' + i).val() != "" && $('' + i).val() != "") {
                if ($('' + i).val().substring(3, 6) != '' && $('' + i).val().substring(3, 6) != '') {
                    $.modalAlert("", '');
                    return false;
                }
                if ($('' + i).val().substring(3, 6) != '' && $('' + i).val().substring(3, 6) != '') {
                    $.modalAlert("", '');
                    return false;
                }
                if ($('' + i).val() == $('' + i).val()) {
                    $.modalAlert("", '');
                    return false;
                }
                for (var j = 1; j < inttime; j++) {
                    if ($('' + j).val() != null && $('' + j).val() != null && $('' + j).val() != "" && $('' + j).val() != "") {
                        var begintimej = new Date(""+$('' + j).val());
                        var begintimei = new Date("" +$('' + i).val());
                        var endtimej = new Date("" +$('' + j).val());
                        var endtimi = new Date("" + $('' + i).val());
                        
                        if (begintimej == endtimej) {
                            $.modalAlert("", '');
                            return false;
                        }
                        if (begintimei == endtimi) {
                            $.modalAlert("", '');
                            return false;
                        }
                        if (begintimej > endtimej) {
                            $.modalAlert("", '');
                            return false;
                        }
                        if (begintimei > endtimi) {
                            $.modalAlert("", '');
                            return false;
                        }
                        if (begintimej > begintimei && begintimej < endtimi) {
                            $.modalAlert("", '');
                            return false;
                        }
                        if (endtimej > begintimei && endtimej < endtimi) {
                            $.modalAlert("", '');
                            return false;
                        }
                    }
                }
                timestr += $('' + i).val() + "" + $('' + i).val() + "";
            }
        }
        timestr = timestr.substring(0, timestr.length - 1);
        $.ajax({
            url: ""+timestr,
            dataType: "",
            async: false,
            success: function (data) {
                callBack(timestr);
                $.modalClose();
            }
        });
    }
</script>

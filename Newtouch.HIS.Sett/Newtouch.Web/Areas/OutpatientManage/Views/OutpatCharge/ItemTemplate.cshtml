
@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="gridPanel">
    <table id="parentGridList"></table>
    <table id="childGridList"></table>
</div>

<script type="">
    var ks = $.request("");
    var tempList = [], //Danh sách mẫu
        detailList = []; //Danh sách hạng mục dưới mẫu
    $(function () {
        tempInit();
    })

    function tempInit() {
        $.loading(true);
        $.ajax({
            type: "",
            url: "" + Math.random(),
            data: { ks: ks },
            dataType: "",
            success: function (ajaxresp) {
                if (ajaxresp.state == '') { 
                    tempList = ajaxresp.data.tempList;
                    detailList = ajaxresp.data.tempDetailList;
                    gridList(tempList); //Liên kết danh sách mẫu 

                } else if (ajaxresp.state == '') {
                    $.newtouchAlert(ajaxresp);
                    return false;
                }
            },
            error: function (err) {
                funcDoPageClear(); //Xóa
            },
            complete: function () {
                $.loading(false);
            } 
        });
    }


    function gridList(tempList) {
        var $gridList = $("");
        $gridList.dataNewGrid({  
            height: 150,
            caption: "",
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: "", name: "", width: 80, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 50, align: '' },
            ]
        }, tempList);

        if (tempList.length > 0) {
            $('').find("").remove();
        }
    }

    function btn_selectrow(rowid) { 
        $('').jqGrid("");
        var sfmbbh = $("").jqGridRowValue().sfmbbh;
        var tempDetail = [];
        for (var i = 0; i < detailList.length; i++) {
            if(detailList[i].ItemCode == sfmbbh){
                tempDetail = detailList[i].tempDetailList;
            }
        } 
        $("").dataNewGrid({ 
            height: 200,
            caption: "",
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true } 
            ],
            multiselect: true
        }, tempDetail);

        if (tempDetail.length > 0) {
            $('').find("").remove();
        }
    }

    //多选
    function grid_checkedit() {
        
    }

    //ChargeIndexTrang Gọi
    //在主页面进行调用
    function submitForm() {
        var rowid = $("").jqGrid("", "");
        var obj = [];
        if (rowid) {
            for (var i = 0; i < rowid.length; i++) {
                obj[i] = new Object();
                obj[i] = $('').jqGrid('', rowid[i]);
            }
        } 
        return obj;
    }
</script>


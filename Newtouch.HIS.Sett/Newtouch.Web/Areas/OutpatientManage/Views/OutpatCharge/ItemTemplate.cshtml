
@{
    ViewBag.Title = "ItemTemplate";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="gridPanel">
    <table id="parentGridList"></table>
    <table id="childGridList"></table>
</div>

<script type="text/javascript">
    var ks = $.request("ks");
    var tempList = [], //Danh sách mẫu
        detailList = []; //Danh sách hạng mục dưới mẫu
    $(function () {
        tempInit();
    })

    function tempInit() {
        $.loading(true);
        $.ajax({
            type: "POST",
            url: "/OutpatientManage/OutpatCharge/GetChargeItemData?r=" + Math.random(),
            data: { ks: ks },
            dataType: "json",
            success: function (ajaxresp) {
                if (ajaxresp.state == 'success') { 
                    tempList = ajaxresp.data.tempList;
                    detailList = ajaxresp.data.tempDetailList;
                    gridList(tempList); //Liên kết danh sách mẫu 

                } else if (ajaxresp.state == 'error') {
                    $.newtouchAlert(ajaxresp);
                    return false;
                }
            },
            error: function (err) {
                funcDoPageClear(); //Xóa
            },
            complete: function () {
                $.loading(false);
            } 
        });
    }


    function gridList(tempList) {
        var $gridList = $("#parentGridList");
        $gridList.dataNewGrid({  
            height: 150,
            caption: "Danh sách mẫu",
            colModel: [
                { label: "Khóa chính", name: "sfmbbh", hidden: true, key: true },
                { label: "Mã mẫu", name: "sfmb", width: 80, align: 'left' },
                { label: 'Tên mẫu', name: 'sfmbmc', width: 100, align: 'left' },
                { label: 'Khoa thực hiện', name: 'ksmc', width: 50, align: 'left' },
            ]
        }, tempList);

        if (tempList.length > 0) {
            $('.ui-jqgrid-bdiv').find(".unwritten").remove();
        }
    }

    function btn_selectrow(rowid) { 
        $('#childGridList').jqGrid("clearGridData");
        var sfmbbh = $("#parentGridList").jqGridRowValue().sfmbbh;
        var tempDetail = [];
        for (var i = 0; i < detailList.length; i++) {
            if(detailList[i].ItemCode == sfmbbh){
                tempDetail = detailList[i].tempDetailList;
            }
        } 
        $("#childGridList").dataNewGrid({ 
            height: 200,
            caption: "Danh sách hạng mục",
            colModel: [
                { label: "Khóa chính", name: "sfmbbh", hidden: true, key: true },
                { label: 'Số lượng', name: 'sl', width: 50, align: 'left' },
                { label: 'Mã hạng mục', name: 'py', width: 50, align: 'left' },
                { label: 'Tên', name: 'sfxmmc', width: 50, align: 'left' },
                { label: 'Đơn vị', name: 'dw', width: 50, align: 'left' },
                { label: 'Đơn giá', name: 'dj', width: 50, align: 'left' },
                { label: 'Mã BHYT', name: 'ybdm', width: 100, align: 'left' },
                { label: 'Loại chi phí', name: 'dlmc', width: 50, align: 'left' },
                { label: 'Quy cách', name: 'gg', width: 50, align: 'left' },
                { label: 'Liều lượng', name: 'jl', width: 50, align: 'left' },
                { label: 'Cách dùng', name: 'yf', width: 50, align: 'left' },
                { label: 'Tần suất', name: 'pl', width: 50, align: 'left' },
                { label: 'Dạng bào chế', name: 'jx', width: 50, align: 'left' },
                { label: 'dlmc', name: 'dlmc', hidden: true },
                { label: 'dl', name: 'dl', hidden: true },
                { label: 'sfxm', name: 'sfxm', hidden: true },
                { label: 'sfxmbh', name: 'sfxmbh', hidden: true },
                { label: 'zfxz', name: 'zfxz', hidden: true },
                { label: 'zfbl', name: 'zfbl', hidden: true } 
            ],
            multiselect: true
        }, tempDetail);

        if (tempDetail.length > 0) {
            $('.ui-jqgrid-bdiv').find(".unwritten").remove();
        }
    }

    //Chọn nhiều
    function grid_checkedit() {
        
    }

    //ChargeIndexTrang Gọi
    //Gọi tại trang chính
    function submitForm() {
        var rowid = $("#childGridList").jqGrid("getGridParam", "selarrrow");
        var obj = [];
        if (rowid) {
            for (var i = 0; i < rowid.length; i++) {
                obj[i] = new Object();
                obj[i] = $('#childGridList').jqGrid('getRowData', rowid[i]);
            }
        } 
        return obj;
    }
</script>


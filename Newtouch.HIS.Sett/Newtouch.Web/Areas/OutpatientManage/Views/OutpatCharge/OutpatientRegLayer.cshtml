@{
    ViewBag.Title = "";
    Layout = "";

    var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
    var zlxmzhconf = SysConfigReader.String(""); //开启治疗项目组合
    var zhxmCode = SysConfigReader.String(""); //Thu phí ngoại trú_免费挂号_Thu phí kết hợp hạng mục
}
<table class="form" style="margin: 5px 10px 5px 0;width:98%;">
    <tr>
        <th class="formTitle">Lý do khám：</th>
        <td class="formValue">
            <select id="jzyy" name="jzyy" class="form-control">
                <option value="">==Vui lòng chọn==</option>
            </select>
        </td>
        <th class="formTitle"><span class="required">*</span>Loại ngoại trú：</th>
        <td class="formValue formDdlSelectorTd">
            <select id="sel_mzlx" class="form-control required" data-EnumType="EnumOutPatientType">
                <option value="">Vui lòng chọn</option>
            </select>
        </td>
        <th class="formTitle"><span class="required">*</span>Khoa：</th>
        <td class="formValue">
            <input type="text" class="form-control" id="txtkschoose" />
        </td>
    </tr>
    <tr>
        <th class="formTitle"><span class="required">*</span>Lịch trực đăng ký khám：</th>
        <td class="formValue">
            <input type="text" class="form-control" id="txtghpbchoose" />
        </td>
        <th class="formTitle">Loại bệnh bệnh đặc biệt：</th>
        <td class="formValue">
            <select id="sel_tsbbz" name="sel_tsbbz" class="form-control"></select>
        </td>
        <td></td>
        <td></td>
    </tr>
    <tr>
        <th class="formTitle">Tính chất chi phí：</th>
        <td class="formValue">
            <label id="brxzmc" name="brxzmc"></label>
            <input type="hidden" id="grbh" />
            <input type="hidden" id="cbdbm" />
        </td>
        <td class="formTitle">Khoa đăng ký khám：</td>
        <td class="formValue">
            <input type="hidden" id="txtghpbId" />
            <input type="hidden" id="txtghks" />
            <label id="txtghksmc"></label>
        </td>
        <td class="formTitle">Bác sĩ：</td>
        <td class="formValue">
            <input type="hidden" id="txtghysgh" />
            <label id="txtghysmc"></label>
        </td>
    </tr>
    <tr>
        <td class="formTitle">Số thẻ：</td>
        <td class="formValue">
            <label id="CardTypeName"></label>
            <label id="kh"></label>
        </td>
        <td class="formTitle">Phí đăng ký khám： </td>
        <td class="formValue">
            <input type="hidden" id="txtghfxm" />
            <label id="newghf"></label>
        </td>
        <th class="formTitle">Phí chẩn trị：</th>
        <td class="formValue">
            <input type="hidden" id="txtzlxm" />
            <label id="newzlf"></label>
        </td>
    </tr>
    <tr>
        <th class="formTitle">Tổng số tiền：</th>
        <td class="formValue">
            <label id="newtotalfees"></label>
        </td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
    </tr>
</table>
<script>
    var blh = $.request("");
    var fyyGhpbId = null;//Đăng ký khám đặt trước không

    //Thông tin cơ bản trả về tìm kiếm số bệnh án theo
    function GetOutpatientBasicInfo() {
        $.najax({
            url: "",
            data: { blh: blh },
            dataType: "",
            async: false,
            success: function (rep) {
                patModel = rep.data;
                $("").html('' + patModel.CardTypeName + '');
                $("").html(patModel.kh);
                $("").val(patModel.grbh);
                $("").val(patModel.cbdbm);
                $("").attr("", "");
                $("").attr("", "");
                $("").html("");
            }
        });
    }
    GetOutpatientBasicInfo();

    $('').bindSelect();

    //就诊原因下拉初始化 Mặc định trạng thái đã chọn thông thường
    $('').itemDetailsBindSelect({ itemtype: '' });
    var jzyydefaultSelVal = null;
    $.each($(''), function () {
        if ($(this).text() == '') {
            jzyydefaultSelVal = $(this).attr('');
        }
    });
    if (jzyydefaultSelVal) {
        $('').val(jzyydefaultSelVal).trigger('');
    }

    //Khoa
    $("").newtouchBatchFloatingSelector({
        height: 200,
        width: 300,
        clickautotrigger: true,
        filter: function (keyword) {
            //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
            var resultObjArr = new Array();
            $.each(top.window.clients.sysDepartList, function (idx, val) {
                if ((val.py && val.py.toLowerCase().indexOf(keyword) >= 0)
                    || (val.Name && val.Name.indexOf(keyword) >= 0)
                    || keyword.trim() == "") {
                    resultObjArr.push(val);
                }
            });
            return resultObjArr;
        },
        caption: "",
        colModel: [
            { label: '', name: '', widthratio: 30 },
            { label: '', name: '', widthratio: 50 },
            { label: '', name: '', hidden: true }
        ],
        itemdbclickhandler: function ($thistr) {
            $("").attr("", $thistr.find("").html());
            $("").val($thistr.find('').html());
            return;
        },
    });

    var ghpbUrl = "";
    var colModel = [];
    ScheduleList();
    function ScheduleList() {
        if (@zlxmzhconf == 1) {
            //Thu phí kết hợp hạng mục
            ghpbUrl = "";
            colModel = [
                { label: '', name: '', widthratio: 20 },
                { label: '', name: '', widthratio: 15 },
                { label: '', name: '', widthratio: 20 },
                { label: '', name: '', widthratio: 15 },
                { label: '', name: '', widthratio: 10 },
                { label: '', name: '', widthratio: 20 },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
            ];
        }
        else {
            ghpbUrl = "";
            colModel = [
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', widthratio: 20 },
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
            ];
        }
    }

    //Lớp nổi lịch trực đăng ký khám
    $("").newtouchBatchFloatingSelector({
        height: 230,
        width: 700,
        clickautotrigger: true,
        id: '',
        url: ghpbUrl,
        ajaxmethod: '',
        ajaxreqdata: function () {
            return {
                pbks: $("").val(),
                keyword: $("").val(),
                mzlx: $("").val(),
                withFees: false
            };
        },
        caption: "",
        colModel: colModel,
        itemdbclickhandler: function ($thistr) {
            if (!patModel) {
                $.modalAlert("", "");
                return;
            }
            fyyGhpbId = $thistr.attr('');
            ghpbchooseBind($thistr);
            return;
        }
    });

    function ghpbchooseBind($thistr) {
        if ($("").val() === "") {
            $("").val($thistr.attr('')).trigger('');
        }
        $("").val($thistr.attr(''));
        //Hạng mục đăng ký khámCode
        $("").val($thistr.attr(''));
        $("").val('');
        //Hạng mục chẩn trịCode
        $("").val($thistr.attr(''));
        $("").val($thistr.attr(''));
        $("").html($thistr.attr(''));
        $("").val($thistr.attr(''));
        $("").html($thistr.attr(''));
        //
        $("").html('');
        $("").html('');
        $("").html('');
        //Lấy phí đăng ký khám Phí chẩn trị Phí thẻ từ Phí phôi
        if ('' == 1) {
            GHFeesGroup(function (feesList) {
                $("").val($thistr.attr(''));   //Đặt ở đây，phía sau dùng để đánh giá có hoàn thành việc chọn lịch trực thành công không
                $("").html(parseFloat(feesList.ghf).toFixed(2));
                $("").html(parseFloat(feesList.zlf).toFixed(2));
                $("").html(parseFloat(feesList.totalfees).toFixed(2));
            });
        }
        else {
            GHFees(function (feesList) {
                $("").val($thistr.attr(''));   //Đặt ở đây，phía sau dùng để đánh giá có hoàn thành việc chọn lịch trực thành công không
                $("").html(parseFloat(feesList.ghf).toFixed(2));
                $("").html(parseFloat(feesList.zlf).toFixed(2));
                $("").html(parseFloat(feesList.totalfees).toFixed(2));
            });
        }
    }

    //Lấy chi phí kết hợp đăng ký khám
    function GHFeesGroup(funcSuccCallback) {
        $.najax({
            url: "",
            dataType: "",
            data: { ghlx: $("").val(), zlxm: $("").val(), isCkf: false, isGbf: false },
            type: "",
            success: function (data) {
                if (funcSuccCallback) {
                    var feesList = {};
                    feesList.ghf = data.ghfPrice;
                    feesList.zlf = data.zlfPrice;
                    feesList.totalfees = data.totalfees;
                    funcSuccCallback(feesList);
                }
            }
        });
    }

    //Lấy phí đăng ký khám
    function GHFees(funcSuccCallback) {
        $.najax({
            url: "",
            dataType: "",
            data: { ghlx: $("").val(), zlxm: $("").val(), isCkf: false, isGbf: false },
            type: "",
            success: function (data) {
                if (funcSuccCallback) {
                    var feesList = {};
                    feesList.ghf = data.ghfPrice;
                    feesList.zlf = data.zlfPrice;
                    feesList.totalfees = data.totalfees;
                    funcSuccCallback(feesList);
                }
            }
        });
    }

    $('').change(function () {
        $("").val('');
        $("").val("");
        $("").html('');
        $("").html('');
        $("").html('');
        cq_fillTsbbz();
    });

    function cq_fillTsbbz() {
        $("").empty();

        var brxz = $('').attr('');
        var mzlx = $('').val();
        $("").append("");
        if (mzlx == "" || mzlx == "" || mzlx == "") {
            $.ajax({
                type: "",
                url: "",
                data: { mllx: mzlx },
                dataType: "",
                async: false,
                success: function (ajaxresp) {
                    $.each(ajaxresp, function () {
                        var option = "" + this.mtbbzmldm + "" + this.mtbbzflmc + "";
                        $("").append(option);
                    });
                }
            });
        }
        if ((!!brxz && brxz != "") && (mzlx == "" || mzlx == "" || mzlx == "" || mzlx == "" || mzlx == "")) {
            var rybh = $("").val();
            var list = cq_fetchTsbbz(rybh);
            if ($.isArray(list) && list.length > 0) {
                $.each(list, function (index, value) {
                    var prefix = value.opsp_dise_name;
                    var d = prefix.indexOf("");
                    var option = "" + value.opsp_dise_code + "" + value.opsp_dise_name + "";
                    if (mzlx == "" && prefix.indexOf("") != -1) {
                        $("").append(option);
                    }
                    else if ((mzlx == "" || mzlx == "" || mzlx == "") && prefix.indexOf("") == -1) {
                        $("").append(option);
                    }
                    else if (mzlx == "" && prefix.indexOf("") != -1) {
                        $("").append(option);
                    }
                    else if (mzlx == "" && prefix.indexOf("") != -1) {
                        $("").append(option);
                    }
                });
            }
        }
    }
    function cq_fetchTsbbz(rybh) {
        var bzList = [];
        var tsbData = { psn_no: rybh, peratorId: '', operatorId: '', operatorName: '', insuplc_admdvs: $("").val() };
        $.ajax({
            type: "",
            url: "",
            dataType: "",
            data: tsbData,
            async: false,
            success: function (data) {
                var TbMzReg = eval('' + data + '');
                if (TbMzReg) {
                    if (TbMzReg.infcode == "" && !!TbMzReg.output.feedetail) {
                        bzList = TbMzReg.output.feedetail;
                    }
                    else {
                        $.modalAlert("" + TbMzReg.err_msg, '');
                    }
                }
            },
            error: function () {
                $.modalAlert("", '');
            }
        });
        return bzList;
    }

    //Gửi
    function AcceptClick(callback) {
        mzyyghId = "";
        var regInfo = getRegInfo();
        if (!regInfo) {
            return;
        }

        var result = ConfirmFee(regInfo);
        callback(result);
    }

    var MZJS = {};
    MZJS.jzxx = null;
    MZJS.ghdata = null;
    MZJS.msg = "";

    MZJS.clear = function () {
        MZJS.jzxx = null;
        MZJS.qzjzxh = "";
        MZJS.qzmzh = "";
        MZJS.ysxx = null;
        MZJS.regInfo = null;
        MZJS.msg = "";
        MZJS.mxxx = null;
        MZJS.ybjyFeeReturn = null;
    };

    //Xác nhận số tiền
    function ConfirmFee( regInfo) {
        MZJS.clear();
        $.najax({
            url: "",
            data: { patid: regInfo.patid, ghpbId: regInfo.ghpbId, ks: regInfo.ks, ys: regInfo.ys, mjzbz: regInfo.mjzbz, QueueNo: "", OutDate: null, isYbjy: false },
            dataType: "",
            async: false,
            success: function (rep) {
                MZJS.qzjzxh = rep.data.jzxh;
                MZJS.qzmzh = rep.data.mzh;
                MZJS.ysxx = rep.data.ysxx;
                MZJS.regInfo = regInfo;
            },
            alertbierror: false,
            errorCallback: function (rep) {
                var themsg = "";
                if (rep && rep.message) {
                    themsg += "" + rep.message;
                }
                $.modalAlert(themsg, '');
                return;
            }
        });
        //Quyết toán bệnh nhân tự chi trả
        /* 初始化上下文对象 */
        return SaveMethod({ qzjzxh: MZJS.qzjzxh, qzmzh: MZJS.qzmzh });
    }

    //Thực hiện lưu cụ thể
    function SaveMethod(elseJsonObj) {
        var regInfo = getRegInfo();
        if (!!!regInfo) {
            return;
        }
        var ret = null;
	    var medicalReg;
        $.najax({
            url: "",
            dataType: "",
            loadingtext: "",
            data: {
                patid: regInfo.patid, kh: regInfo.kh,
                mjzbz: regInfo.mjzbz, ks: regInfo.ks, ys: regInfo.ys,
                ksmc: regInfo.ksmc, ysmc: regInfo.ysmc,
                ghly: regInfo.ghly, jzyy: regInfo.jzyy,
                ghxm: regInfo.ghxm,
                ghpbId: regInfo.ghpbId,
                zlxm: regInfo.zlxm,
                fph: "",
                sfrq: $.getDate(),
                isCkf: regInfo.isCkf, isGbf: regInfo.isGbf,
                feeRelated: {
                    fph: "",
                    sfrq: $.getDate(),
                    ecToken: "",
                    ecToken: "",
                    zje: 0,
                    ssk: null,
                    zhaoling: 0,
                    yjjzfje: 0,
                    djjess:0
                },
                brxz: regInfo.brxz,
                qzjzxh: elseJsonObj.qzjzxh,
                qzmzh: elseJsonObj.qzmzh,
                ybjsh: elseJsonObj.ybjsh,
                mzyyghId: regInfo.yyghId,//mzyyghId,
                jzid:elseJsonObj.jzid,
                bzbm:regInfo.bzbm,
                bzmc:regInfo.bzmc,
                jzlx:elseJsonObj.jzlx
            },
            type: "",
            async: false,
            success: function (ajaxresp) {
                ret = ajaxresp.data;
            },
            alertbierror: false,
            errorCallback: function (rep) {
                $.xhrSuccessDataExCheckHandle(rep, true);
            }
        });
        return ret;
    }

    function getRegInfo() {
        var regInfo = {};
        regInfo.patid = patModel.patid;
        if (!regInfo.patid) {
            $.modalAlert("", '');
            return false;
        }
        regInfo.kh = $("").html();
        if (!regInfo.kh) {
            $.modalAlert("", '');
            return false;
        }
        regInfo.brxz = $('').attr('');
        regInfo.brxzmc = $('').attr('');
        if (!(!!regInfo.brxz || regInfo.brxz == '')) {
            $.modalAlert("", '');
            return false;
        }

        //Đánh giá chọn tính chất chi phí
        //Tự chi trả Không bảo hiểm y tế đi
        //Tự chi trả bảo hiểm y tế Bảo hiểm y tế đi  //医保卡患者也可选择‘Tự chi trả’
        if (patModel.brxz !== regInfo.brxz && regInfo.brxzmc != '') {
            if (patModel.brxzmc == '' || patModel.brxzmc == '') {
                $.modalAlert("" + patModel.brxzmc + "", '');
                return false;
            }
            else if (regInfo.brxzmc != '') {
                $.modalAlert("", '');
                return false;
            }
        }

        regInfo.mjzbz = $("").val();
        regInfo.jzyy = $("").val();
        regInfo.ks = $("").val();
        regInfo.ksmc = $("").html();
        regInfo.ys = $("").val();
        regInfo.ysmc = $("").html();
        regInfo.ghly = "";//Không xử lý đăng ký khám đặt trước
        regInfo.ghxm = $("").val();
        regInfo.zlxm = '';//Hạng mục kết hợp
        regInfo.isCkf = false;
        regInfo.isGbf = false;
        regInfo.ghpbId = $("").val();
        regInfo.ghf = $("").html();
        regInfo.zlf = $("").html();
        regInfo.totalfees = $("").html();
        regInfo.zjlx = patModel.zjlx;
        regInfo.zjh = patModel.zjh;
        regInfo.blh = $("").val();
        regInfo.cblb = patModel.cblb;
        regInfo.xzlx = patModel.xzlx;
        regInfo.grbh = $("").val();
        //regInfo.ecToken = $("").val();
        //regInfo.cbdbm = $("").val();
        if (!!!regInfo.ghpbId) {
            $.modalAlert("", '');
            return false;
        }
        var bzInfo = cq_getCurrentTsbbz();
        if (!bzInfo.rs) {
            $.modalAlert("", '');
            return false;
        }
        else {
            regInfo.bzbm = bzInfo.ryzd;
            regInfo.bzmc = bzInfo.ryzdmc;
        }
        regInfo.zje = !!parseFloat(regInfo.totalfees) ? parseFloat(regInfo.totalfees) : 0;
        if (regInfo.zje < 0) {
            $.modalAlert("", '');
            return false;
        }
        return regInfo;
    }

    function cq_getCurrentTsbbz() {
        var info = { rs: true, ryzd: "", yllb: "", ryzdmc: "" };
        var brxz = $('').attr('');
        var mzlx = $('').val();
        if ((!!brxz && brxz != "") && (mzlx == "" || mzlx == "" || mzlx == "" || mzlx == "" || mzlx == "" || mzlx == "" || mzlx == "")) {
            var bzbm = $("").val();
            var bzmc = $("").find("").text();
            if (!!!bzbm) {
                info.rs = false;
            }
            else {
                info.ryzd = bzbm;
                info.ryzdmc = bzmc;
                if (mzlx == "" || mzlx == "" || mzlx == "") {
                    info.yllb = "";
                }
                else if (mzlx == "") {
                    info.yllb = "";
                }
                else if (mzlx == "") {
                    info.yllb = "";
                }
                else if (mzlx == "") {
                    info.yllb = "";
                }
                else if (mzlx == "") {
                    info.yllb = "";
                }
            }
        }

        return info;
    }

</script>
@using System.Web.Mvc.Html
@using Newtouch.Infrastructure
@{
    ViewBag.Title = "";
    Layout = "";
}
<style>
    .table-responsive {
        border: 0;
    }

    .ui-jqgrid .ui-jqgrid-pager .ui-pager-table {
        width: 90%;
    }
</style>
<div class="topPanel">
    <table class="form">
        <tr>
            <th class="formTitle" style="width:50px;">Số thẻ：</th>
            <td class="formValue" style="width: 80px;">
                <input id="txt_kh" name="txt_blh" type="text" class="form-control newtouch_Readonly" placeholder="Số thẻ" />
            </td>
            <th class="formTitle" style="width:55px;">Loại thẻ：</th>
            <td class="formValue" style="width: 100px;">
                @Html.DropDownList("", EnumCardType.XNHJYK.ToDescSelectList(), "", new { @class = "" })
            </td>
            <th class="formTitle" style="width:75px;">Đăng ký khám thời gian：</th>
            <td class="formValue">
                <input id="gh_kssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width: 88px; float:left;" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                <span style="margin-left:2px; float: left; line-height: 25px;">—</span>
                <input id="gh_jssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width: 88px;float:left;margin-left:2%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
            </td>
            <td class="formTitle" style="width: 50px;">
                <button type="button" id="btn_search" class="btn btn-primary btn-md">Tra cứu</button>
            </td>
        </tr>
    </table>
</div>
<div class="gridPanel">
    <table id="opalGridList"></table>
</div>
<script>
    var $gridList = $("");
    var kh = $.request("");
    var cardType = $.request("");
    var zjh = $.request("");
    $(function () {
        $("").val(kh);
        $("").val(cardType);
        gridList();
        $("").click(function () {
            if ($("").val() === "") $("").val(""yyyy-MM-01"");
            if ($("").val() === "") $("").val(""yyyy-MM-dd"");
            $gridList.jqGrid("");
            $gridList.jqGrid('', {
                postData: param(),
                url: ""
            }).trigger('');
        });
    });

    //Khởi tạo
    function gridList() {
        $gridList.dataGrid({
            height: $(window).height() - 130,
            postData: param(),
            url: "",
            colModel: [
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', hidden: true },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true }
            ],
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                PatDbGrid(rowid);
            }
        });
    }

    function param() {
        return { kssj: $("").val(), jssj: $("").val(), kh: kh,zjh:zjh, cardType: cardType};
    }

    function PatDbGrid(rowId) {
        var rowData = $gridList.jqGrid('', rowId);
        var obj = new Object();
        obj.blh = rowData.blh;
        obj.mzh = rowData.mzh;
        obj.xm = rowData.xm;
        obj.xb = rowData.xb;
        obj.csny = rowData.csny;
        obj.brxzmc = rowData.brxzmc;
        obj.brxz = rowData.brxz;
        obj.CardTypeName = rowData.CardTypeName;
        $.currentWindow().chooseOneMzjl(obj);
        $.modalClose();
    }
</script>

@{
    ViewBag.Title = "";
    Layout = "";
}
<style>
    span {
    color:red
    }
</style>
<form id="form1">
    <table class="form" style="width: 98%; border: 0">
        <tr>
            <td class="formTitle">
                <span>*</span>Số thẻ：
            </td>
            <td class="formValue">
                <input type="text" id="kh" class="form-control form-an">
            </td>
            <td class="formTitle"><span>*</span>Số bệnh án：</td>
            <td class="formValue">
                <input type="text" id="blh" class="form-control form-an">
                <input hidden id="py" />
                <input hidden id="txtghks" />
                <input hidden id="txtghys" />
                <input hidden id="txtghksmc">
                <input hidden id="txtghpbId" />
            </td>
        </tr>
        <tr>
            <td class="formTitle"><span>*</span>Họ tên bệnh nhân：</td>
            <td class="formValue">
                <input type="text" id="xm" name="xm" class="form-control form-an">
            </td>
            <th class="formTitle">
                <span class="required">*</span>Lịch trực đăng ký khám：
            </th>
            <td class="formValue">
                <input type="text" class="form-control" id="txtghpbchoose" />
            </td>
            
        </tr>
        <tr>
            <td class="formTitle"><span>*</span>Tính chất bệnh nhân：</td>
            <td class="formValue">
                <input type="text" id="brxzmc" name="brxzmc" class="form-control form-an">
            </td>
            <td class="formTitle"><span>*</span>Giới tính：</td>
            <td class="formValue">
                <div class="btn-group" data-toggle="buttons">
                    <label class="btn btn-default">
                        <input type="radio" id="xb" value="1" name="xb" class="form-control form-an">
                        Nam
                    </label>
                    <label class="btn btn-default">
                        <input type="radio" id="xb" value="2" name="xb" class="form-control form-an">
                        Nữ
                    </label>
                </div>
            </td>
        </tr>
    </table>
</form>

<script>
    $(function () {
        initControl();
        //Phiên âm lấy họ tên theo
        $('').keyup(function () {
            $('').val($(this).toShouPin());
        });

        $("").attr("", "");
        $("").val("");
    });

    function initControl() {
        ///Chính sách hoàn trả
        $("").newtouchBatchFloatingSelector({
            height: 200,
            width: 400,
            clickautotrigger: true,
            filter: function (keyword) {
                //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
                var resultObjArr = new Array();
                $.each(top.window.clients.sysPatientNatureList, function (idx, val) {
                    if ((val.py && val.py.toLowerCase().indexOf(keyword.toLowerCase()) >= 0) ||
                        keyword.trim() == "" ||
                        (val.brxzmc && val.brxzmc.toLowerCase().indexOf(keyword) >= 0)) {
                        resultObjArr.push(val);
                    }
                });
                return resultObjArr;

            },
            caption: "",
            colModel: [
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', widthratio: 25 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("").attr("", $thistr.attr(''));
                $("").val($thistr.attr(''));
                return;
            }
        });


        //Lớp nổi lịch trực đăng ký khám
        $("").newtouchBatchFloatingSelector({
            height: 150,
            width: 400,
            clickautotrigger: true,
            id: '',
            url: '',
            ajaxmethod: '',
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = $("").val();
                reqData.mzlx = "";//Mặc định ngoại trú thông thường
                return reqData;
            },
            caption: "",
            colModel: [
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', widthratio: 20 },
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
            ],
            itemdbclickhandler: function ($thistr) {
                $("").val($thistr.attr(''));
                $("").val('');
                $("").val($thistr.attr(''));
                $("").val($thistr.attr(''));
                $("").html($thistr.attr(''));
                $("").val($thistr.attr(''));
                return;
            }
        });

        $("").attr("", "").css("", "");
        $("").attr("", "").css("", "");
        $.ajax({
            url: "",
            data: { khsc: true, blhsc: true },
            dataType: "",
            async: false,
            cache: false,
            success: function (data) {
                $('').val(data.kh);
                $('').val(data.blh);
            }
        });
    }

    function submitForm(callBack) {
        var result = checkNotNull();
        if (result) {
            var data = $("").formSerialize();
            data.brxz = $("").attr("");
            data.ks = $('').val();
            data.ghpbId = $('').val();
            data.ys = $('').val();
            $.submitForm({
                url: ""SubmitPhysicalexamForm"",
                param: { dto: data },
                success: function (resp) {
                    if (resp.state == "") {
                        var respjson = JSON.parse(resp.data);
                        data.mzh = respjson.Item1;
                        data.patid = respjson.Item2;
                        data.cardType = "";
                    }
                    callBack(data);
                    $.modalClose();
                }
            });
        }
    }


    function checkNotNull() {
        //Số thẻ
        var kh = $("").val();
        if (!kh) {
            $.modalAlert("", '');
            return false;
        }
        //Số bệnh án
        var blh = $("").val();
        if (!blh) {
            $.modalAlert("", '');
            return false;
        }
        //Họ tên
        var xm = $("").val();
        if (!xm) {
            $.modalAlert("", '');
            return false;
        }

        //Tính chất bệnh nhân
        var brxzmc = $("").val();
        if (!brxzmc) {
            $.modalAlert("", '');
            return false;
        }

        //Phiên âm
        var py = $("").val();
        if (!py) {
            if (!!$("").val()) {
                py = $("").toShouPin();
            }
            if (!py) {
                $.modalAlert("", '');
                return false;
            }
            else {
                $("").val(py);
            }
        }

        //Giới tính
        var xb = false;
        $('').each(function () {
            var $this = $(this);
            if ($this.parent().hasClass("")) {
                xb = true;
                $("").val();
            }
        });
        if (!xb) {
            $.modalAlert("", '');
            return false;
        }

        if (!!!$('').val()) {
            $.modalAlert("", '');
            return false;
        }

        return true;
    }
</script>
@{
    ViewBag.Title = "";
    Layout = "";
}

<script>
    $(function ()
    {
        gridList();

        selectGridAll();
    });

    function selectGridAll()
    {
        var jqGrid = $("");
        // 拿到所有行id
        var jqGridIDs = jqGrid.getDataIDs();
        for (var i = 0; i < jqGridIDs.length; i++) {
            jqGrid.setSelection(jqGridIDs[i], true);
        }
    }

    function GetCfInfo()
    {
        var PrescriptionInfo = sessionStorage.getItem("");
        if (PrescriptionInfo)
        {
            sessionStorage.removeItem("")
            return $.parseJSON(PrescriptionInfo);
        }
    }

    function gridList()
    {
        var $gridList = $("");
        $gridList.newtouchLocalDataGrid(
        {
            multiselect: true,
            unwritten: false,
            height: 150,
            colModel: [
                { label: "", name: "", key: true, hidden: true },
                { label: "", name: "", width: 130, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 50, align: '' }
            ]
        });
        $gridList.newtouchLocalDataGrid(null, GetCfInfo());
    }

    function submitForm(callback)
    {
        //Lấy dòng đã chọnId
        var selRowIds = $("").jqGrid('', '');
        if (selRowIds.length == 0) {
            $.modalAlert("", '');
            return;
        }

        //cflist
        var cflist = [];//查询处方详情
        for (var i = 0; i < selRowIds.length; i++) {
            var rowData = $("").jqGrid('', selRowIds[i]);
            if (!rowData) {
                break;
            }
            cflist.push(rowData);
        }

        callback(cflist);

        $.modalClose();
    }
</script>

<div class="gridPanel">
    <table id="chooseCfGrid"></table>
</div>

    function SingleCfSett()
    {
        setTimeout(function () {
            if (!Ybjzgh())
                return;
            CQjzdj();
            if (MZJS.jzxx == null) {
                return;
            }
            $.loading(true, '');
            setTimeout(function () {
                var jsstate = true;

                /* 撤销所有已上传待结算明细 */
                if (!CQmxcx()) {
                    return;
                }

                /* 逐个处方与医保结算 */
                while (MZJS.moveNext()) {
                    MZJS.waitSubmitItems();
                    CQmxsc();
                    if (MZJS.current().error == 1) {
                        continue;
                    }
                    if (MZJS.current().mxxx == null) {
                        jsstate = false;
                        break;
                    }
                    CQybjs();
                    if (MZJS.current().ybjyFeeReturn == null) {
                        jsstate = false;
                        break;
                    }
                }

                /* 医保结算冲正 */
                if (!jsstate) {
                    var errMsg = "" + MZJS.current().msg + "";
                    for (var m = MZJS.index; m >= 0; m--) {
                        if (MZJS.cfList[m].error != 0) {
                            continue;
                        }
                        var ret = CQybjs_cz(MZJS.cfList[m].ybjyFeeReturn, { cfh: MZJS.cfList[m].cfh, xmzje: MZJS.cfList[m].xmzje });
                        if (!ret.rs) {
                            errMsg = errMsg + "" + ret.msg + "";
                        }
                    }
                    $.loading(false);
                    if (errMsg.length > 0) {
                        $.modalAlert(errMsg, '');
                    }
                    return;
                }

                $.loading(false);

                /* Xác nhận thu phí vàHISCổng vào quyết toán */
                CQybjs_confirm();
            }, 50);
        }, 50);
    }

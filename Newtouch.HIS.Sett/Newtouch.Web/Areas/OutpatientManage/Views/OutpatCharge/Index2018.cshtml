    /* 构造处方收费对象(医保结算场景) */
    MZJS.buildFeeRelated_ybjz = function (index, feeRelated) {
        var item = MZJS.cfList[index];
        /* 处方明细全自费无需医保交易 */
        if (item.error == 1) {
            return MZJS.buildFeeRelated_zfjz(index, feeRelated);

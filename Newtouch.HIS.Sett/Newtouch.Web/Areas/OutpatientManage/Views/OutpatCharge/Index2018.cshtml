    //Lấy chi tiết
    function getEditRowData() {

        var tempCfh = "";
        if ($('').val() == "") {
            //Thuốc
            var rowid = $('').jqGrid('', '');//判断是否有选中处方
            if (rowid) {
                var rowData = $("").jqGrid('', rowid);
                if (!rowData.newid || !rowData.cfh) {
                    //选择的处方不能追加明细,Đơn thuốc mới
                    $("").prop("", "");
                    $('').trigger("");
                    tempCfh = currentNewPreNo;
                }
                else {
                    //用选中那条记录的处方号
                    tempCfh = rowData.cfh;
                }
            }
            else {
                //判断是否新处方号
                if ($('').is('')) {
                    //Đơn thuốc mới
                    tempCfh = currentNewPreNo;
                }
                else {
                    //旧处方
                    if ($('').val()) {
                        //当前编辑域记录已有处方号
                        tempCfh = $('').val();
                    }
                    else if (lastcfh) {
                        //上一条用的处方号（中间开项目不算上一次）
                        tempCfh = lastcfh;
                    }
                    else {
                        //第一次默认新处方
                        $("").prop("", "");
                        $('').trigger("");
                        tempCfh = currentNewPreNo;
                    }
                }
            }
        }
        var data = {
            cfh: tempCfh,
            sfxmCode: $('').val(),
            sfxmmc: $('').val(),
            yzlx: $('').val(),
            zll: $('').val(),
            zlcs: $('').val(),
            dj: '' === ''
                ? $('').val()
                : $('').html(),
            dw: $('').html(),
            sl: $('').val(),
            sfdlCode: $('').val(),
            sfdlmc: $('').val(),
            dwjls: $('').val(),
            jjcl: $('').val(),
            zje: $('').html(),
            jl: $('').val(),
            jldw: $('').val(),
            zfbl: $('').val(),
            zfxz: $('').val()
        };
        lastcfh = data.cfh;
        return data;
    }


    function setPatInfoModel(patModel) {
        $('#rightPart').formSerialize(patModel);
        $("#mzh").val(patModel.mzh);
        $("#blh").html(patModel.blh);
        $("#xb").html($.getGender(patModel.xb));
        $("#csny").html((patModel.csny && patModel.csny.length >= 10 ? patModel.csny.substring(0, 10) : ""));
        $("#zjh").html(patModel.zjh);
        $("#xm").html(patModel.xm);
        $("#nlshow").html(getAgeFromBirthTime({ begin: patModel.csny }).text);
        $("#phone").html(patModel.phone);
        $("#brxzmc").html(patModel.brxzmc);
        $("#jiuzhenbiaozhi").html($.enum.getDescByValue('EnumOutpatientJzbz', patModel.jiuzhenbiaozhi));
        //Tải thông tin bệnh nhân
        patInfoPostObj.xm = patModel.xm; //Họ tên
        patInfoPostObj.xb = patModel.xb; //Giới tính
        patInfoPostObj.csny = patModel.csny;
        patInfoPostObj.patid = patModel.patid; //Mã nội bộ bệnh nhân
        patInfoPostObj.blh = patModel.blh; //Số hồ sơ bệnh án
        patInfoPostObj.zjh = patModel.zjh; //Số giấy tờ
        patInfoPostObj.brxz = patModel.brxz;//Tính chất bệnh nhân
        patInfoPostObj.mzh = patModel.mzh;//Số khám ngoại trú
        patInfoPostObj.brxzmc = patModel.brxzmc; //Tên tính chất bệnh nhân
        patInfoPostObj.jiuzhenbiaozhi = patModel.jiuzhenbiaozhi; //Cờ khám bệnh
        patInfoPostObj.ghnm = patModel.ghnm;//Mã nội bộ đăng ký khám
        patInfoPostObj.ys = patModel.ys;//Bác sĩ
    }

    //Kiểm tra dữ liệu đang chỉnh sửa（Chờ gửi）tính đầy đủ
    function checkEditingRowData(rowData) {
        if (true) {
            //Thông thường，Số lượng
            if (!((/^(\+|-)?\d+$/).test(rowData.sl)) || rowData.sl < 1) {
                $.modalAlert("Số lượng lớn hơn0số nguyên", 'warning');
                return;
            }
            if (!!!rowData.sl || isNaN(rowData.sl)) {
                $.modalAlert("Thiếu số lượng", 'warning');
                return;
            }
        }
        if (!rowData.sfxmCode || !rowData.sfxmmc || !rowData.yzlx || !rowData.sfdlCode || !rowData.sfdlmc) {
            $.modalAlert("Vui lòng chọn hạng mục thu phí", 'warning');
        }
        else if (!!!rowData.dw) {
            $.modalAlert("Thiếu thông tin đơn vị hạng mục", 'warning');
        }
        else if (!((/^(([1-9][0-9]*\.[0-9][0-9]*)|([0]\.[0-9][0-9]*)|([1-9][0-9]*)|([0]{1}))$/).test(rowData.dj))) {
            $.modalAlert("Đơn giá không nhỏ hơn0con số", 'warning');
        }
        else if (rowData.dj == "" || isNaN(rowData.dj)) {
            $.modalAlert("Thiếu thông tin đơn giá hạng mục", 'warning');
        }
        else {
            return true;
        }
        return false;
    }


<script>
    var openYbSett = '' === ''; //Cấu hình công tắc：Bệnh nhân bảo hiểm y tế có sử dụng quy trình giao dịch bảo hiểm y tế không
    var isYbjyjz; //Lần khám hiện tại có đi theo giao dịch bảo hiểm y tế không
    //
    var leftdata = [];//左边数据源
    var respmzh; //Xác minh số ngoại trú（Đổi không có）
    var editingNewid = null; //Dòng đang sửa
    var patInfoPostObj = {}; //Thông tin cá nhânObjectĐối tượng Phía máy chủ gửi tới cần
    var lastcfh; //上一条用的处方号（中间开项目不算上一次）
    var currentNewPreNo;
    $(function () {
        $("").newtouchLocalDataGrid(null, []);
        $("").html('' === ''
            ? ""
            : "");
        hideEditBotton();
        $("").click(function () {
            if ($(this).find("").hasClass("")) {
                $("").setGridHeight($(window).height() - 245);
            }
            else {
                $("").setGridHeight($(window).height() - 265);
            }
        });
        $('').trigger('');
        //
        initGridPatList();
        //否则看不到loading效果
        setTimeout("", 50);
    });

    //Phần tử trong trang，Tính tổng số tiền Phiên bản số lượng
    function reCalcZjeFromsl() {
        var resultZje = "";
        var txtDj = '' === '' ? $("").val() : $("").html();
        var txtSl = $('').val();
        if (txtDj && txtSl) {
            if (!isNaN(txtDj) && !isNaN(txtSl)) {
                resultZje = roundingBy4she6ru5chengshuang((parseFloat(txtDj) * parseFloat(txtSl)), 2);
            }
        }
        $('').html(resultZje);
    }

    ///Ẩn nút chỉnh sửa
    function hideEditBotton() {
        $('').hide();
    }
    //Hiển thị nút chỉnh sửa
    function showEditBotton() {
        $('').attr('', '');
        $('').attr('', '');
        $('').show();
    }

    //展开项目计费输入面板
    $('').click(function () {
        $(this).hide();
        $('').show();
        $('').show();
        showEditBotton();
        $("").setGridHeight($(window).height() - $("").outerHeight(true) - 89);
    });

    //隐藏项目计费输入面板
    $('').click(function () {
        $('').hide();
        $('').show().hide();
        $('').show();
        hideEditBotton();
        $("").setGridHeight($(window).height() - $("").outerHeight(true) - 89);
    });

    //gridPatList结构
    function initGridPatList() {
        $("").newtouchLocalDataGrid({
            height: $(window).height() - 125,
            unwritten: false,
            rownumbers: false,
            colModel: [
                { label: '', name: '', width: 60, align: '' },
                { label: '', name: '', width: 70, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true }
            ],
            ondblClickRow: function (rowid) {
                var rowData = $("").jqGrid('', rowid);
                var mzh = rowData.mzh;
                //计费
                GetQueryFphAjax({ mzh: mzh });
            },
            gridComplete: function () {

            }
        });
    }

    //Làm mới danh sách bệnh nhân
    function gridPatList() {
        $.najax({
            type: "",
            url: "",
            loading: true,
            loadingtext: "",
            success: function (ajaxresp) {
                leftdata = ajaxresp;
                var $gridPatList = $("");
                $gridPatList.resetSelection();
                $gridPatList.clearGridData();
                $gridPatList.newtouchLocalDataGrid({ posttofirst: false }, leftdata);
            }
        });
    }

    //Tải chưa thu phí tất cả
    function loadAllUnsetted(mzh) {
        $.najax({
            type: "",
            url: "" + mzh,
            dataType: "",
            cache: false,
            async: true,
            loadingtext: "",
            success: function (ajaxresp) {
                FillgridFeeList(ajaxresp);
            }
        });
    }

    $("").newtouchLocalDataGrid({
        height: $(window).height() - 225,
        unwritten: false,
        colModel: [
            { label: "", name: "", align: "", hidden: true },
            {
                label: "", name: "", width: 50, align: "", formatter: function (cellvalue) {
                    if (cellvalue == "") {
                        return ""
                    }
                    else if (cellvalue == "") {
                        return "";
                    }
                    else {
                        return "";
                    }
                }
            },
            { name: "", hidden: true },
            { label: "", name: "", width: 130, align: "" },
            { name: "", hidden: true },
            { label: "", name: "", width: 170, align: "" },
            { name: "", align: "", hidden: true },
            { label: "", name: "", width: 50, align: "", hidden: true },
            { name: "", hidden: true },
            { label: "", name: "", width: 70, align: "" },
            { label: "", name: "", width: 40, align: "" },
            {
                label: "", name: "", width: 80, align: "", formatter: ""
                , formatoptions: { decimalPlaces: 4, defaultValue: '' }
            },
            {
                label: "", name: "", width: 80, align: "", formatoptions: { decimalPlaces: 2, defaultValue: '' }
            },
            { label: "", name: "", hidden: true },
            { label: "", name: "", hidden: true },
            { label: "", name: "", hidden: true },
            { label: "", name: "", hidden: true }
        ],
        onSelectRow: function (rowid) {
            $('').removeAttr('');
            $('').removeAttr('');
        },
        ondblClickRow: function (rowid) {
            var rowData = $("").jqGrid('', rowid);
            sfxmgridDbclickRow(rowData);
        }
    });
    //Hạng mục điều trị Lớp nổi
    var searchTypePart1 = "";
    var searchTypePart2 = "";
    if ('' == '') {
        searchTypePart1 += '';
    }
    $('').sfxmFloatingSelector({
        djDecimalPlaces: 4,
        searchType: searchTypePart1 + "" + searchTypePart2,
        leftshift: 100, //Lệch trái tổng thể
        ajaxparameters: function ($thisinput) {
            return "" + $.trim($thisinput.val()) + "";
        },
        itemdbclickhandler: function ($thistr, $thisinput) {
            if (!patModel) {
                $.modalAlert("", "");
                return;
            }
            if ($thistr.attr('') == '') {
                $.modalAlert("", '');
                return;
            }
            if ($thisinput.attr('') === '') {
                if ($thistr.attr('') === "") {
                    //Thuốc
                    $('').html($thistr.attr(''));
                    $('').val('');
                }

                Container($thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                var djVal = parseFloat($thistr.attr('')).toFixed(4);
                '' === '' ? $('').val(djVal) : $('').html(djVal);
                $('').html($thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
            }
        }
    });

    //Thêm
    function newtouch_event_f2() {
        if (editingNewid) {
            return; //Đang ở trạng thái sửa，thì không thể nhấn nút thêm   CầndisableXử lý
        }

        if (!patInfoPostObj.mzh) {
            $.modalAlert("", '');
            return;
        }
        if (patInfoPostObj.mzh !== respmzh) {
            $.modalAlert("", '');
            return;
        }

        var data = getEditRowData();
        if (!(CheckreAdddata(data) && checkEditingRowData(data))) {    //Dữ liệu đã đầy đủ chưa，Kiểm tra các mục bắt buộc
            return;
        }
        var addgoon = function () {
            //Kiểm tra mục trùng lặp

            if (!(CheckreAdddata(data) && checkEditingRowData(data))) {    //Dữ liệu đã đầy đủ chưa，Kiểm tra các mục bắt buộc
                return;
            }
            reCalcZjeFromsl();
            data.zje = $('').html();
            data.newid = Math.random().toString() + new Date().getMilliseconds();   //newid()
            gridMxList.unshift(data);   //Thêm dưới dạng mục mới //”Đầu mảng“

            //Lại đưaxmMảng hiển thị tớigrid
            fillDataToGrid();
            Clearjzxm();
        }

        if (data && parseFloat(data.dj) < '') {
            $.modalAlert("", '');
            return;
        }
        else if (data && parseFloat(data.dj) == '') {
            $.modalConfirm("", function (flag) {
                if (!flag) {
                    return;
                }
                else {
                    addgoon();
                }
            });
        }
        else {
            addgoon();
        }
    }

    //Sửa
    function newtouch_event_f3() {
        if (editingNewid) {
            var data = getEditRowData();
            if (!(checkEditingRowData(data))) {
                //Dữ liệu đã đầy đủ chưa，Kiểm tra các mục bắt buộc
                return;
            }
            reCalcZjeFromsl();
            data.zje = $('').html();
            updategoon = function () {

                data.newid = editingNewid;
                //Kiểm tra mục trùng lặp

                //Trước tiên trongxmtìm trong mảng
                if (editingNewid) {
                    var matchedIndex = -1;
                    for (var ii = 0; ii < gridMxList.length; ii++) {
                        if (gridMxList[ii].newid == data.newid) {
                            matchedIndex = ii;
                            break;
                        }
                    }
                    if (matchedIndex == -1) {
                        return; //Có lẽ là bất thường
                    }
                    gridMxList.remove(matchedIndex);   //Xóa mục này
                    gridMxList.unshift(data);   //Thêm dưới dạng mục mới    //”Đầu mảng“
                }

                //Lại đưaxmMảng hiển thị tớigrid
                fillDataToGrid();
                Clearjzxm();

                editingNewid = null;    //Dòng đang sửa

                middleButtonsReset();
            }
            if (data && parseFloat(data.dj) < '') {
                $.modalAlert("", '');
                return;
            }
            else if (data && parseFloat(data.dj) == '') {
                $.modalConfirm("", function (flag) {
                    if (!flag) {
                        return;
                    }
                    else {
                        updategoon();
                    }
                });
            }
            else {
                updategoon();
            }
        }
        else {
            $('').attr('', '');
            //LấygridDòng đang được chọn hiện tại
            var seleId = $('').jqGrid('', '');
            if (seleId) {
                //Yêu cầu sửa dòng đó
                gridEditRow(seleId);
            }
            else {
                return;
            }
        }
    }

    //F4Xóa
    function newtouch_event_f4() {
        isYbjyjz = null;
        gridMxList = [];
        patInfoPostObj = {};    //Thông tin cá nhânObjectĐối tượng Phía máy chủ gửi tới cần
        editingNewid = null;    //Dòng đang sửa
        patModel = null;
        lastcfh = "";//最后编辑的处方号
        respmzh = "";//Xác minh số ngoại trú（Đổi không có）
        $("").clearGridData();
        $('').html('');
        $("").html('');
        $('').val('');
        $('').removeAttr('');
        currentNewPreNo = "";
        Clearjzxm();
        middleButtonsReset();
    };

    //Xóa
    function newtouch_event_f6() {
        //LấygridDòng đang được chọn hiện tại
        var rowid = $('').jqGrid('', '');
        //Yêu cầu xóa dòng đó
        if (rowid) {
            var rowData = $("").jqGrid('', rowid);
            if (rowData) {
                if (!!rowData.newid) {
                    //dữ liệu xóa gửi chưa
                    if (gridMxList.length > 0) {
                        for (var jj = (gridMxList.length - 1) ; jj >= 0 ; jj--) {
                            if (gridMxList[jj].newid == rowData.newid) {
                                gridMxList.remove(jj);   //Xóa
                            }
                        }
                    }
                }
                else {
                    //Xóa có thể hạng mục？
                    $.modalAlert('', '');
                    return;
                }
            }
            //Lại đưaxmMảng hiển thị tớigrid
            fillDataToGrid();
        }
    }

    //Lấy chi tiết
    function getEditRowData() {
        var tempCfh = "";
        if ($('').val() == "") {
            //Thuốc
            var rowid = $('').jqGrid('', '');//判断是否有选中处方
            if (rowid) {
                var rowData = $("").jqGrid('', rowid);
                if (!rowData.newid || !rowData.cfh) {
                    //选择的处方不能追加明细,Đơn thuốc mới
                    $("").prop("", "");
                    $('').trigger("");
                    tempCfh = currentNewPreNo;
                }
                else {
                    //用选中那条记录的处方号
                    tempCfh = rowData.cfh;
                }
            }
            else {
                //判断是否新处方号
                if ($('').is('')) {
                    //Đơn thuốc mới
                    tempCfh = currentNewPreNo
                }
                else {
                    //旧处方
                    if ($('').val()) {
                        //当前编辑域记录已有处方号
                        tempCfh = $('').val();
                    }
                    else if (lastcfh) {
                        //上一条用的处方号（中间开项目不算上一次）
                        tempCfh = lastcfh
                    }
                    else {
                        //第一次默认新处方
                        $("").prop("", "");
                        $('').trigger("");
                        tempCfh = currentNewPreNo;
                    }
                }
            }
        }
        var data = {
            cfh: tempCfh,
            sfxmCode: $('').val(),
            sfxmmc: $('').val(),
            yzlx: $('').val(),
            dj: '' === ''
                ? $('').val()
                : $('').html(),
            dw: $('').html(),
            sl: $('').val(),
            sfdlCode: $('').val(),
            sfdlmc: $('').val(),
            zje: $('').html(),
            jl: $('').val(),
            jldw: $('').val(),
            zfbl: $('').val(),
            zfxz: $('').val()
        };
        lastcfh = data.cfh;
        return data;
    }

    //双击收费项目
    function sfxmgridDbclickRow(rowData) {
        if (!!rowData.newid) {
            if (rowData.yzlx == "") {
                //Thuốc
                Container("");
                $('').val(rowData.jl);
                $('').val(rowData.jldw);
            }
            else {
                //Hạng mục
                Container("");
            }
            if (rowData) {
                editingNewid = rowData.newid;
                //Tuần tự hóa vào vùng chỉnh sửa
                $('').val(rowData.cfh);
                $('').val(rowData.sfxmmc);
                $('').val(rowData.sfxmCode);
                $('').val(rowData.yzlx == "" ? "" : "");
                $('').val(rowData.sfdlCode);
                $('').val(rowData.sfdlmc);
                $('').html(rowData.dw);
                if ('' === '') {
                    $('').val(rowData.dj)
                }
                else {
                    $('').html(rowData.dj);
                }
                $('').val(rowData.sl);

                $('').trigger('');
                $('').attr('', '');
                $('').show();
                $('').attr('', '');
                $('').removeAttr('');
            }
        }
        else {
            $.modalAlert("", "");
            return;
        }
    }

    //中间几个按钮禁用
    function middleButtonsReset() {
        $('').removeAttr('');
        $('').attr('', '');
        $('').attr('', '');
        $('').hide();
    }

    //Xác nhận
    function newtouch_event_f8() {
        var xmzje = waitSubmitItems();
        if (!patInfoPostObj.mzh) {
            $.modalAlert("", '');
            return;
        }
        if (!newinputxmList || newinputxmList.length === 0) {
            $.modalAlert("", '');
            return;
        }
        if (patInfoPostObj.mzh !== respmzh) {
            $.modalAlert("", '');
            return;
        }

        $.submitForm({
            url: ""AdditionalSubmit"",
            param: { bacDto: patInfoPostObj, xmList: newinputxmList },
            success: function (ajaxresp) {
                //计费刷新
                GetQueryFphAjax({ mzh: patInfoPostObj.mzh });
            }
        });
    }

    var newinputxmList;  //Nhập mới
    var cfnmList;  //后台已存在的处方
    var extxmnmList;  //后台已存在的计费项目

    //Chờ gửi 计费整理
    function waitSubmitItems() {
        var xmzje = '';
        newinputxmList = [];  //Nhập mới
        cfnmList = [];  //后台已存在的处方
        extxmnmList = [];  //后台已存在的计费项目
        $.each(gridMxList, function (i, item) {
            if (item.newid != null) {
                newinputxmList.push(item);    //nhập mới
            }
            else if (!!item.cfnm) {
                var cfnmExist = false;
                for (var iiiii = 0; iiiii < cfnmList.length; iiiii++) {
                    if (cfnmList[iiiii] == item.cfnm) {
                        cfnmExist = true;
                        break;
                    }
                }
                if (!cfnmExist) {
                    cfnmList.push(item.cfnm);
                }
            }
            else if (!!item.xmnm) {
                extxmnmList.push(item.xmnm);
            }
            xmzje = roundingBy4she6ru5chengshuang(parseFloat(item.zje) + parseFloat(xmzje), 2);
        });

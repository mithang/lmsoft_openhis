    //Chờ gửi Sắp xếp tính phí
    function waitSubmitItems() {
        var xmzje = '0.00';
        newinputxmList = [];  //Nhập mới
        cfnmList = [];  //Đơn thuốc đã tồn tại ở phía máy chủ
        extxmnmList = [];  //Hạng mục tính phí đã tồn tại ở phía máy chủ
        $.each(gridMxList, function (i, item) {
            if (item.newid != null) {
                newinputxmList.push(item);    //mới nhập
            }
            else if (!!item.cfnm) {
                var cfnmExist = false;
                for (var iiiii = 0; iiiii < cfnmList.length; iiiii++) {
                    if (cfnmList[iiiii] == item.cfnm) {
                        cfnmExist = true;
                        break;
                    }
                }
                if (!cfnmExist) {
                    cfnmList.push(item.cfnm);
                }
            }
            else if (!!item.xmnm) {
                extxmnmList.push(item.xmnm);
            }
            xmzje = roundingBy4she6ru5chengshuang(parseFloat(item.zje) + parseFloat(xmzje), 2);
        });
        return xmzje;
    }


    function FillgridFeeList(data) {
        $.each(data, function () {
            var newRowData = {
                newid: null,   //newid()
                cfh: this.cfh,
                cfnm: this.cfnm,
                xmnm: this.xmnm,    //20181010Hạng mục tính phí riêng chưa thu phí
                sfxmCode: this.sfxmCode,
                sfxmmc: this.sfxmmc,
                sfdlCode: this.sfdlCode,
                sfdlmc: this.sfdlmc,
                yzlx: this.yzlx,
                sl: this.sl,
                dw: this.dw,
                dj: this.dj.toFixed(2),
                zje: this.zje.toFixed(2),
            };
            gridMxList.unshift(newRowData);   //Thêm dưới dạng mục mới //”Đầu mảng“

@{
    Layout = "";
    //
    var relatedFPH = SysConfigReader.Bool("");
    //
    var withYjj = SysConfigReader.Bool("");
}
<style type="text/css">
    .form .formValue {
        padding: 3px 5px;
    }
</style>

<div style="margin:15px 40px;">
    <table>
        <tr>
            <td>
                Chọn bản ghi quyết toán trước nợ phí：
            </td>
            <td>
                <div class="input-group" style="width:200px;">
                    <select id="seleJs" name="seleJs" class="form-control"></select>
                </div>
            </td>
        </tr>
    </table>
    <div class="gridPanel" style="margin:10px 0;">
        <table id="gridJsmxList"></table>
    </div>

    <div class="panel panel-default" style="margin-top:10px;">
        <div>
            <table class="form">
                <tr>
                    <th class="formTitle"><span style="color:red">*</span>Ngày thu phí：</th>
                    <td class="formValue">
                        <input id="sfrq" type="text" class="form-control  form-an input-wdatepicker" style="float: left; margin-left: 5px; width:90%" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    </td>
                    @if (relatedFPH == true)
                    {
                        <th class="formTitle"><span style="color:red">*</span>Số hóa đơn：</th>
                        <td class="formValue">
                            <label id="txtfph"></label>
                            <div style="position:absolute;top:5px;right:20px;">
                                <input type="button" class="btn btn-default btn-md" style="margin-left:6px;" value="Chọn số hóa đơn" onclick="ShowInvoicePanel()" />
                            </div>
                        </td>
                    }
                    else
                    {
                        <th class="formTitle"></th>
                        <td class="formValue"></td>
                    }
                </tr>
                <tr>
                    <th class="formTitle">折前应收款：</th>
                    <td class="formValue">
                        ￥<label id="zqysk"></label>
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Tỷ lệ chiết khấu：</th>
                    <td class="formValue">
                        <input id="zkbl" type="text" class="form-control  form-an" style="width:80%;float:left;margin-left: 5px;" /><span style="line-height:25px; margin-left:10px">%</span>
                    </td>
                    <th class="formTitle">Số tiền chiết khấu：</th>
                    <td class="formValue">
                        <input id="zkje" type="text" class="form-control  form-an" style="width:90%" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">折后应收款：</th>
                    <td class="formValue">
                        ￥<label id="zhysk"></label>
                    </td>
                </tr>
                <tr id="trYjjzf" style="display:none;">
                    <th class="formTitle">Số dư tiền tạm ứng：</th>
                    <td class="formValue">
                        ￥<label id="yjjye"></label>
                    </td>
                    <td class="formValue">
                        <div class="ckbox">
                            <input id="ckyjjzfyeqt" type="checkbox"><label for="ckyjjzfyeqt">Hoàn trả toàn bộ số dư</label>
                        </div>
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Phương thức thanh toán：</th>
                    <td class="formValue">
                        <select id="zffs1" class="form-control  form-an" style="width:90%">
                            <option value="">==Vui lòng chọn==</option>
                        </select>
                    </td>
                    <th class="formTitle">Thu tiền：</th>
                    <td class="formValue">
                        <input type="text" id="zfje1" class="form-control form-an" style="width:90%" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Phương thức thanh toán：</th>
                    <td class="formValue">
                        <select id="zffs2" class="form-control form-an" style="width:90%">
                            <option value="">==Có thể chọn==</option>
                        </select>
                    </td>
                    <th class="formTitle">Thu tiền：</th>
                    <td class="formValue">
                        <input type="text" id="zfje2" class="form-control form-an" style="width:90%" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Tổng số tiền thực thu：</th>
                    <td class="formValue">￥<label id="hjssk">0.00</label></td>
                </tr>
                <tr>
                    <th class="formTitle">Tiền thừa：</th>
                    <td class="formValue">￥<label id="zhaoling">0.00</label></td>
                </tr>
            </table>
        </div>
    </div>
</div>
<script type="">
    var mzh = $.request('');

    //Số dư tiền tạm ứng
    var yjjye = 0;
    var withYjj = '';
    //Tổng số tiền quyết toán
    var zje = 0;
    //Thanh toán khoản phải thu Khoản phải thu khi quyết toán（zje = Có thể báo cáo + Khoản phải thu khi quyết toán + V.v.）
    var orglxjzfys = 0;
    //Khi có chiết khấu không bằng original
    var xjzfys = orglxjzfys;    //Khi có chiết khấu sẽ không bằng

    $(function () {
        if (withYjj == '') {
            $.najax({
                url: "" + $.request(""),
                cache: false,
                async: false,
                alertbierror: false,
                success: function (zhyeData) {
                    if (zhyeData && zhyeData.data) {
                        yjjye = zhyeData.data;
                    }
                }
            });
        }

        if (yjjye) {
            $('').show();
            $('').html(parseFloat(yjjye).toFixed(2));
        }

        //Phương thức thanh toán tiền mặt1
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                $.each(top.clients.SysForCashPayList, function (key, value) {
                    if (!yjjye && value.xjzffs == '') {
                        return; //Tài khoản hiện tại không có số dư tiền tạm ứng，thì không hiển thị phương thức thanh toán này
                    }
                    var sele = false;
                    if (!!yjjye && yjjye >= xjzfys) {
                        if (value.xjzffs == '') {
                            sele = true;
                        }
                    }
                    else if (value.xjzffsmc == "") {
                        sele = true;
                    }
                    if (sele) {
                        $('').append('' + value.xjzffs + '' + value.xjzffsmc + '');
                    }
                    else {
                        $('').append('' + value.xjzffs + '' + value.xjzffsmc + '');
                    }
                });
                return resultObjArr;
            }
        });

        //Phương thức thanh toán tiền mặt2
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                $.each(top.clients.SysForCashPayList, function (key, value) {
                    if (value.xjzffs == '') {
                        return; //Không hiển thị phương thức thanh toán này
                    }
                    $('').append('' + value.xjzffs + '' + value.xjzffsmc + '');
                });
                return resultObjArr;
            }
        });

        $("").click(function () {
            if ($('').is('')) {
                //Phương thức thanh toán tiền tạm ứng，‘Hoàn trả toàn bộ số dư’
                if (!!yjjye && yjjye >= xjzfys) {
                    //
                    $("").val('').trigger('');
                    $('').val(yjjye.toFixed(2));
                    //
                    $('').val('').trigger('');
                    //
                    hjsskZhaolingCal();
                }
            }
        });

        initFPH();

        $("").bindSelect({
            url: "" + mzh,
            id: "",
            text: "",
        });

        $("").trigger('');
    });

    $("").newtouchLocalDataGrid({
        height: 85,
        unwritten: false,
        colModel: [
            { label: '', name: '', hidden: true },
            { label: '', name: '', width: 160, align: '' },
            { label: '', name: '', width: 70, align: '' },
            {
                label: '', name: '', width: 100, align: '',
                formatter: function (cellvalue) {
                    if (!!cellvalue) {
                        return cellvalue.toFixed(4);
                    } else {
                        return '';
                    }
                }
            },
        ]
    });

    var jsnm;
    $("").change(function () {
        reset();
        jsnm = $("").val();
        var jsText = $("").html();
        var jeText = jsText.substring(12);
        zje = xjzfys = orglxjzfys = parseFloat(jeText);
        if (!xjzfys) {
            return;
        }
        $('').html(xjzfys.toFixed(2));
        $('').html(xjzfys.toFixed(2));
        $('').val(xjzfys.toFixed(2));
        $('').html(xjzfys.toFixed(2));
        $('').html('');
        if (!!yjjye && yjjye >= xjzfys) {
            //Tiền tạm ứng
            $('').val('').trigger('');
        }
        else {
            //Tiền mặt
            $('').val('').trigger('');
        }
        //
        $.najax({
            url: "",
            data: { jsnm: jsnm },
            success: function (ajaxResp) {
                $("").clearGridData();
                $("").newtouchLocalDataGrid(null, ajaxResp);
            }
        });
    });

    //Liên quan số tiền
    function reset() {
        $('').val('');
        $('').val('');
        $('').html('');
        $('').html('');
        if ($('').is('')) {
            $('').trigger('');
        }
        $('').val('').trigger('');
        $('').val('');
        $('').val('').trigger('');
        $('').val('');
        $('').html('');
        $('').html('');
    }

    //Gửi
    function AcceptClick(callback) {
        var feeRelated = getPostData();
        if (feeRelated) {
            var updateDto = {};
            updateDto.jsnm = jsnm;
            updateDto.sfrq = feeRelated.sfrq;
            updateDto.fph = feeRelated.fph;
            //Phía máy chủ gửi tới
            $.submitForm({
                url: ""SubmitArrearageSettedUpdate"",
                param: { updateDto: updateDto, feeRelated: feeRelated },
                success: function (ajaxresp) {
                    if (callback) {
                        callback();
                    }
                }
            });
        }
    }

    function getPostData() {
        var sfrq = $('').val();
        var fph = $('').html();
        var zffs1 = $('').val();
        !(!!zffs1 || zffs1 == '') ? $('').val('') : undefined;
        var zfje1 = $('').val();
        zfje1 = (!!zffs1 || zffs1 == '') && !!parseFloat(zfje1) ? parseFloat(zfje1) : 0;
        if (zffs1 == '' && yjjye) {
            if (!(zfje1 == yjjye || zfje1 <= xjzfys)) {
                $.modalAlert("", "");
                return false;
            }
        }
        //
        var zffs2 = $('').val();
        !(!!zffs2 || zffs2 == '') ? $('').val('') : undefined;
        var zfje2 = $('').val();
        zfje2 = (!!zffs2 || zffs2 == '') && !!parseFloat(zfje2) ? parseFloat(zfje2) : 0;
        //
        var zkje = $('').val();
        zkje = !!parseFloat(zkje) ? parseFloat(zkje) : 0;
        var zkbl = $('').val();
        zkbl = !!parseInt(zkbl) ? (parseInt(zkbl) / 100).toFixed(2) : 0;
        var hjssk = $('').html();
        hjssk = !!parseFloat(hjssk) ? parseFloat(hjssk) : 0;
        var zhaoling = $('').html();
        zhaoling = !!parseFloat(zhaoling) ? parseFloat(zhaoling) : 0;
        //
        if (!!!sfrq) {
            $.modalAlert('', '');
            return false;
        }
        if ($.getDate() < sfrq) {
            $.modalAlert('', '');
            return false;
        }
        //
        if ($('').length == 0) {
            fph = null;
        }
        else {
            if (!fph) {
                $.modalAlert('', '');
                return false;
            }
        }
        //
        if (hjssk != zfje1 + zfje2) {
            $.modalAlert("", "");
            return false;
        }
        if (hjssk != xjzfys + zhaoling || zhaoling < 0) {
            $.modalAlert("", "");
            return false;
        }
        return {
            sfrq: sfrq, fph: fph
            , zffs1: zffs1, zfje1: zfje1, zffs2: zffs2, zfje2: zfje2
            , zje: zje, orglxjzfys: orglxjzfys, zkje: zkje, zkbl: zkbl, xjzfys: xjzfys
            , ssk: hjssk, zhaoling: zhaoling
        };
    }

    //common start

    //Vào trang，Tải số hóa đơn
    function initFPH() {
        if (!($("").length == 1)) {
            return;
        }
        $.najax({
            url: "" + Math.random(),
            dataType: "",
            cache: false,
            success: function (data) {
                $("").html(data);
            }
        });
    }

    //Cửa sổ bật lên số hóa đơn
    function ShowInvoicePanel() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].checkFPH();//Hàm callback xác nhận khi nhấn cửa sổ
            }
        });
    }

    //
    $('').keyup(function () {
        hjsskZhaolingCal();
        if ($('').is('')) {
            $('').trigger('');
        }
    });
    $('').change(function () {
        hjsskZhaolingCal();
        if ($('').is('')) {
            $('').trigger('');
        }
    });

    //Tính toán Theo Thanh toán khoản phải thu、Phương thức thanh toán Tính tổng số tiền thực thu、Tiền thừa
    function hjsskZhaolingCal() {
        if (!$('').val() && $('').val() != 0) {
            //Chưa chọn phương thức thanh toán，Số tiền tương ứng phải đặt thành0.00
            $('').val('');
        }
        var zfje1 = $('').val();
        if (!zfje1) {
            zfje1 = '';
        }
        if (!$('').val() && $('').val() != 0) {
            //Chưa chọn phương thức thanh toán，Số tiền tương ứng phải đặt thành0.00
            $('').val('');
        }
        var zfje2 = $('').val();
        if (!zfje2) {
            zfje2 = '';
        }
        var hjssk = parseFloat(zfje1) + parseFloat(zfje2);  //Tổng thực thu nhiều phương thức thanh toán
        $('').html(hjssk.toFixed(2));
        $('').html(parseFloat(hjssk - xjzfys).toFixed(2));
    }

    //Nếu có chức năng chiết khấustart

    //
    $('').keyup(function () {
        discountCal();
    });

    //Tỷ lệ chiết khấu，Số tiền chiết khấu Tính chiết khấu
    function discountCal() {
        var zkje = $('').val();
        var zkbl = $('').val();
        var je = calZkhMoney(orglxjzfys.toFixed(2), zkje, zkbl);
        if (je === false) {
            //Tính chiết khấu thất bại 只能重置折扣
            $('').val('');
            $('').val('');
            xjzfys = orglxjzfys;
        }
        else {
            xjzfys = je;
        }
        //
        $('').html(xjzfys);
        $('').val(xjzfys);
        //
        $('').val('').trigger('');
        //
        if ($('').is('')) {
            $('').trigger('');
        }
        //
        hjsskZhaolingCal();
    }

    //根据折扣比例和折扣金额计算 Số tiền sau chiết khấu
    function calZkhMoney(je, zkje, zkbl) {
        if (je == 0) {
            return 0;
        }
        if (validMoney(je, zkje, zkbl)) {
            if (zkbl) {
                //Tỷ lệ chiết khấu
                var decimalbl = ((100 - parseInt(zkbl)) / 100).toFixed(2);
                je = roundingBy4she6ru5chengshuang(parseFloat(parseFloat(je) * decimalbl), 2);
            }
            if (zkje) {
                if (parseFloat(zkje) > parseFloat(je)) {
                    $.modalAlert('', '');
                    return false;
                }
                //Số tiền chiết khấu
                je = roundingBy4she6ru5chengshuang(parseFloat((parseFloat(je) - parseFloat(zkje))), 2);
            }
            return parseFloat(je);
        }
        else {
            return false;
        }
    }

    //Xác minh định dạng số tiền có đúng không
    function validMoney(zqje, zkje, zkbl) {
        if (zqje == '' || zqje == '') {
            $.modalAlert('', '');
            return false;
        }
        //Số tiền chiết khấu
        var reg = /(^[1-9]([0-9]+)?(\.[0-9]{1,2})?$)|(^(0){1}$)|(^[0-9]\.[0-9]([0-9])?$)/;
        if (!!zkje) {
            if (!reg.test(zkje) || zkje == '') {
                $.modalAlert('', '');
                return false;
            }
        }

        if (parseFloat(zkje) > parseFloat(zqje)) {
            $.modalAlert('', '');
            return false;
        }

        //Tỷ lệ chiết khấu
        var blreg = /(^[1-9][0-9]$)|(^100&)|(^[1-9]$)$/;
        if (!!zkbl) {
            if (!reg.test(zkbl)) {
                $.modalAlert('', '');
                return false;
            }
        }
        if (parseInt(zkbl) > 100) {
            $.modalAlert('', '');
            return false;
        }
        return true;
    }

    //Nếu có chức năng chiết khấuend

    //common end

</script>

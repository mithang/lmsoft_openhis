
@{
    ViewBag.Title = "";  
    Layout = "";
}

<div class="gridPanel" > 
    <table id="brxzGridList"></table> 
</div>

<style>
    .ui-jqgrid {border:0px;}
</style>
 
<script>   
    var brxzdata =localStorage.getItem("");
    var brxzdataJson = JSON.parse(brxzdata); 
    $(function () {
        gridList(brxzdataJson);
        localStorage.removeItem("");
    });

    function gridList(tempList) {
        var $gridList = $("");
        $gridList.dataNewGrid({
            height: 100, 
            colModel: [
                { label: '', name: '', width: 10, hidden: true },
                { label: '', name: '', width: 100},
                { label: '', name: '', width: 10, hidden: true },
                { label: '', name: '', width: 10, hidden: true }
            ],
        }, tempList);

        if (tempList.length > 0) {
            $('').find("").remove();
        }
    }

    //jqGrid Nhấp đúp để chọn một dòng
    function btn_edit() {
        PatSearchConfirm();
    }

    function PatDbGrid() {
        var $gridList = $("");
        var brxz = $gridList.jqGridRowValue().brxz;
        var brxzmc = $gridList.jqGridRowValue().brxzmc;
        var brxzbh = $gridList.jqGridRowValue().brxzbh;
        var obj = new Object();
        obj.brxz = brxz;
        obj.brxzmc = brxzmc;
        obj.brxzbh = brxzbh;
        $.currentWindow().getChargeInfoAjax(obj);
        //Đóng cửa sổ
        ReceiptCancle();
    }

    //Xác nhận Gọi từ trang chính
    function PatSearchConfirm() {
        PatDbGrid();
    }

    //Hủy
    function ReceiptCancle() {
        $.modalClose();
    }
</script>
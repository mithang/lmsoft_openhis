
@{
    ViewBag.Title = "";
    Layout = "";
}

<script>
    $(function () {
        gridList();
    });

    ///获取处方列表
    function GetPrescriptionInfo() {
        var PrescriptionInfo = sessionStorage.getItem("");
        if (PrescriptionInfo) {
            sessionStorage.removeItem("")
            return $.parseJSON(PrescriptionInfo);
        }

    }

    function gridList() {
        var $gridList = $("");
        $gridList.newtouchLocalDataGrid({
            multiselect: true,
            unwritten: false,
            height: 150,
            colModel: [
                { label: "", name: "", key: true, hidden: true },
                { label: "", name: "", width: 200, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width:80, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 50, align: '' }
            ]
        });
        $gridList.newtouchLocalDataGrid(null, GetPrescriptionInfo());
    }


    function submitForm(callback) {
        //Lấy dòng đã chọnId
        var selRowIds = $("").jqGrid('', '');
        if (selRowIds.length == 0) {
            $.modalAlert("", '');
            return;
        }
        //cfnm
        var cfnmList = [];//查询处方详情的处方内码list
        for (var i = 0; i < selRowIds.length; i++) {
            var rowData = $("").jqGrid('', selRowIds[i]);
            if (!rowData) {
                break;
            }
            cfnmList.push(parseInt(rowData.cfnm));
        }
        $.ajax({
            type: "",
            url: "",
            data: { cfnmList: cfnmList },
            dataType: "",
            cache: false,
            async: true,
            success: function (ajaxresp) {
                callback(ajaxresp, cfnmList);
                $.modalClose();
            },
            complete: function () {
                $.loading(false);
            }
        });
    }
</script>
<div class="gridPanel">
    <table id="parentgridList"></table>
</div>
        obj.dj = $("#dj").val();
        obj.dw = $("#dw").val();
        obj.sl = $("#sl").val();
        obj.sfxm = sfxmcbh;
        obj.sfxmdlmc = sfxmdlmc;
        obj.xmbh = sfxmbh;

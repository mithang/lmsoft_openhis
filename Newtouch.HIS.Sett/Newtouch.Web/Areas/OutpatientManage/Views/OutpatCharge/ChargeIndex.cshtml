    //Lưu Đánh giá
    function CheckSave() {
        if (kh === "" || patInfoObj == null || patInfoObj.patid == "" || patInfoObj.brxz === "") {
            $.modalAlert("", '');
            return false;
        }
        if (fph == "") {
            $.modalAlert("", '');
            return false;
        }

        if (gridIds == "" || gridIds == undefined) {
            $.modalAlert("", '');
            return false;
        }

        if (parseFloat(ysk) == 0) {
            grid_checkedit();
        }

        var reg = /(^[1-9]([0-9]+)?(\.[0-9]{1,2})?$)|(^(0){1}$)|(^[0-9]\.[0-9]([0-9])?$)/;
        zfje = $("").val();  //Số tiền thanh toán
        var ddlzffs = $("");//Lấy mục đã chọn
        xjzffs = ddlzffs.val();//Lấy giá trị của mục đã chọn
        zffsmc = ddlzffs.text();//Lấy văn bản của mục đã chọn
        xjzffsbh = ddlzffs.attr(""); //Lấydata-*自定义属性

        fph = $("").val();
        if (xjzffs == -1 || zffsmc == "") {
            $.modalAlert("", '');
            return false;
        }
        if (zfje == "" || zfje == undefined) {
            $.modalAlert("", '');
            return false;
        } else {
            if (!reg.test(zfje)) {
                $.modalAlert("", '');
                return false;
            }
        }
        if (parseFloat(zfje) < parseFloat(ysk)) {
            $.modalAlert("", '');
            return false;
        } else {
            zl = parseFloat(zfje) - parseFloat(ysk);
            zl = zl.toFixed(2);
            $("").val(zl);
            //结算窗体
            showBillSuccessDialog(ysk, zfje, 0, zl);
        }
    }


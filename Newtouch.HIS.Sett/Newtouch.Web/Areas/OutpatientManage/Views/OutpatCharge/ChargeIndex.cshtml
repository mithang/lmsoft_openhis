@Html.Partial("")
<div style="clear:both;"></div>
<!--Thanh công cụ nút-->
<div class="toolbar toolbarfloat">
    <a class="btn btn-primary" onclick="newtouch_globalevent_f4()"><i class="fa fa-close"></i> F4:Xóa</a>
    <a class="btn btn-primary" onclick="ChangeCF()"><i class="fa fa-edit"></i>换方</a>
    <a class="btn btn-primary" onclick="newtouch_globalevent_f8()"><i class="fa fa-save"></i> F8:Lưu</a>
    <a class="btn btn-primary" onclick="ItemPlate()"><i class="fa "></i>模版</a>
    <a class="btn btn-primary" onclick="DeleteGrid()"><i class="fa fa-delete"></i>Xóa</a>
</div>

<script>
    $(function () {
        localStorage.clear();
        loadPage();
        //Tải lại khi thay đổi kích thước cửa sổ trình duyệtjqGridchiều rộng của
        $(window).resize(function () {
            initLayout("");
        });
        var txtKeyword = document.getElementById('');
        txtKeyword.addEventListener('', function (event) {
            event = event || window.event;
            if (event.keyCode === 13) {
                var keyword = $.trim($("").val());
                searchPatInfo(keyword);
            }
        });

        //卡号回车
        $("").keyup(function (event) {
            var keyword = $.trim($("").val());
            if (event.keyCode === 13) {
                if (keyword == null) {
                    $.modalAlert("", '');
                    return false;
                } else {
                    searchPatInfo(keyword);
                }
            }
        });

        //Hạng mục thu phíbindLớp nổi
        loadYpItemData();

        //挂号回车
        bindGHSource(mzghData);

        //Bác sĩbingLớp nổi
        bindDoctors();

        GetNewCFH(); //获取新处方号

        //科室回车
        $("").keyup(function (event) {
            var ks = $("").val();
            if (event.keyCode === 13) {
                if (ks == null) {
                    $.modalAlert("", '');
                    return false;
                } else {
                    //đánh giá thêm thông tin nhập
                    AddData_Check();
                }
            }
        });

        //组号回车
        $("").keyup(function (event) {
            if ($(this).hasClass('')) {
                return; //刚从上一个节点自动跳过来的
            }
            if (event.keyCode == 13) {
                //đánh giá thêm thông tin nhập
                AddData_Check();
            }
        });

        //支付金额回车
        $("").keyup(function (event) {
            if (event.keyCode == 13) {
                zfje = $("").val();  //Số tiền thanh toán
                ysk = $("").val(); //Khoản phải thu
                zl = parseFloat(zfje) - parseFloat(ysk);
                zl = zl.toFixed(2);
                $("").val(zl);
            }
        });

        //Chọn tất cả
        $("").bind("", function () {
            grid_checkedit();
            if ($(this)[0].checked == true) {
                //Đã chọn
            }
        });

    });

    //初始化页面txtysk
    function loadPage() {
        GetInvoiceListByEmpCode(); //Lấy số hóa đơn
        $('').jqGrid("");//Dữ liệu xóa trống trước
        gridListData([]); //TảijqGrid

        //Số nhóm thành
        $("").val(0);
        //Lấy ngày
        $("").val($.getDate);
        //金额初始化为0
        $("").text("");
        $("").text("");
        $("").val("");
        $("").removeAttr("").css("", "");
        myCFData = [];
        myCFCount = 0;
        localStorage.removeItem("");
    }

    var mzghData = [], //Dữ liệu đăng ký khám ngoại trú
        mzghDocVo = null, //Đăng ký khám ngoại trú-Khoa chuyên gia
        myCFData = [],    //处方列表数据集合
        myCFCount = 0,   //处方列表行数
        iszhbrxz = false, //Đánh giá tính chất bệnh nhân có tính chất bệnh nhân kết hợp không
        zh_sbrxz = "", //首、末病人性质
        zh_sbrxzmc = "",
        zh_mbrxz = "",
        zh_mbrxzmc = "",
        zh_sbrxzbh = 0,
        zh_mbrxzbh = 0,
        lsCfh = "",     //临时处方号
        sfxmbh = "",   //Hạng mục thu phíint型编号
        sfxmcbh = "",   //Hạng mục thu phíchar型编号
        sfxmzfbl = "",  //收费项目自负比例
        sfxmdlmc = "",  //Thu phí tên nhóm lớn hạng mục
        sfxmdl = "",    //Thu phí nhóm lớn hạng mục
        sfxmzfxz = "",  //收费项目自负性质
        sfxmtype = "",  //Thu phí loại hạng mục（Ví dụ：Hạng mục đăng ký khám、药品处方类项目、Kiểm nghiệm、Kiểm tra）
        sfxmypgg = "", //Quy cách thuốc
        sfxmNbdl = "", //Nhóm lớn bảo hiểm nông nghiệp
        sfxmYbdm = "", //Mã bảo hiểm y tế
        sfxmkeyword = "", //存取收费项目输入条件
        //ysksbh = "", //Số hiệu khoa bác sĩ
        mzgh = "", //Đăng ký khám
        ks = "", //KhoaCODE
        ysbh = "", //Số hiệu bác sĩ
        ys = "", //Bác sĩCODE
        lsysbh = "", //Sử dụng giờ số chuyên gia cho đăng ký khám khi
        ghnm = "", //Mã nội bộ đăng ký khám
        brxz = "", //Tính chất bệnh nhân
        patInfoObj = {}, //Thông tin cá nhânObjectĐối tượng
        mzYbjylx = 0,//Loại giao dịch bảo hiểm y tế
        mjzbz = "", //门急诊标识
        stateSave = true,//Đánh giá dữ liệu có thay đổi không
        isYbbr = false,//是否医保病人
        isNdzdbxm = false,//是否尿毒症大病项目
        isPtdbxz = false,//是否普通大病
        lsCzh = "",//Số nhóm thành
        yfCode = "",//Mã nhà thuốc
        ypbzdm = "",//包装代码
        sfxmfwf = "", //Thu phí phí dịch vụ hạng mục
        cffwf = new Object(),  //处方收费项目服务费后台返回数据
        jeNum = 0, //Số tiền hạng mục hiện tại （Bao gồm phí dịch vụ）
        dqzje = 0, //Số tiền tổng hiện tại
        cfzje = 0, //处方总金额
        dqcfhList = [], //存放当前处方号
        messCFXM = "", //相同药品的错误信息
        kh = "";//Số thẻ

    //Lấy số hóa đơn
    function GetInvoiceListByEmpCode() {
        $.najax({
            url: "" + Math.random(),  //Chú ý
            dataType: "",
            async: false,
            success: function (data) {
                $("").val(data);
                fph = data;
            }
        });
    }

    //Cửa sổ bật lên số hóa đơn
    function ShowInvoicePanel() {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + Math.random(),
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].checkFPH();//Hàm callback xác nhận khi nhấn cửa sổ
            }
        });
    }

    //Thông tin cơ bản bệnh nhân lấy số thẻ theo
    function searchPatInfo(keyword) {
        if (keyword === '') {
            return false;
        }
        kh = keyword;
        $.najax({
            type: "",
            url: "",
            data: { kh: keyword, brxz: "" },
            dataType: "",
            success: function (ajaxresp) {
                funcDoPageClear();//Xóa
                var mzghbrxzData = ajaxresp.data.patInfo.brxzList;
                if (mzghbrxzData && mzghbrxzData.length && mzghbrxzData.length > 1) {
                    //Bật lên cửa sổ của tính chất bệnh nhân cái nhiều
                    bindBrxz();
                }
                else if (mzghbrxzData == null)//Tính chất bệnh nhân cái một có chỉ
                {
                    setPatInfoModel(ajaxresp.data.patInfo); //Gán thông tin cơ bản cá nhân
                    mzghData = ajaxresp.data.ghItemList; //Liên kết thông tin đăng ký khám
                    mzghDocVo = ajaxresp.data.ghDocVo; //Thông tin chuyên gia
                }
            },
            errorCallback: function (ajaxresp) {
                window.newtouch_globalevent_f4(); //Xóa
            }
        });
    };

    //Xóa thao tác
    var funcDoPageClear = function () {
        loadPage();
    };

    //Khởi tạo thông tin bệnh nhân
    function setPatInfoModel(patModel) {
        $('').formSerialize(patModel);
        $("").val($.getGender(patModel.xb));
        $("").val((patModel.csny && patModel.csny.length >= 10 ? patModel.csny.substring(0, 10) : ""));
        $("").val(patModel.fzbz == "" ? "" : "");
        brxz = patModel.brxz;
        //Tải thông tin bệnh nhân
        patInfoObj.kh = patModel.kh;  //Số thẻ bệnh nhân
        patInfoObj.xm = patModel.xm; //Họ tên
        patInfoObj.xb = patModel.xb; //Giới tính
        patInfoObj.csny = patModel.csny;
        patInfoObj.patid = patModel.patid; //Mã nội bộ bệnh nhân
        patInfoObj.brxz = patModel.brxz;  //Tính chất bệnh nhân
        patInfoObj.brxzbh = patModel.brxzbh; //Số hiệu tính chất bệnh nhân
        patInfoObj.brxzmc = $("").val();
        patInfoObj.blh = patModel.blh; //Số bệnh án
        patInfoObj.zjh = patModel.zjh; //Số giấy tờ
        patInfoObj.zjlx = patModel.zjlx; //Loại giấy tờ
    }

    //Tải tính chất bệnh nhân
    function bindBrxz() {
        localStorage.setItem("", JSON.stringify(mzghbrxzData));
        $.modalOpen({
            id: "",
            title: "",
            url: "" + Math.random(),
            width: "",
            height: "",
            callBack: function (iframeId) {

            }
        });
    }

    //Tính chất bệnh nhân theo phía máy chủ và Số thẻajaxTra cứu dữ liệu nhân viên
    function getChargeInfoAjax(patobj) {
        var cardNo = $("").val();
        $.najax({
            type: "",
            url: "" + Math.random(),
            data: { kh: cardNo, brxz: patobj.brxz },
            dataType: "",
            success: function (ajaxresp) {
                funcDoPageClear();//Xóa
                setPatInfoModel(ajaxresp.data.patInfo); //Gán thông tin cơ bản cá nhân
                mzghData = ajaxresp.data.ghItemList; //Liên kết thông tin đăng ký khám
                mzghDocVo = ajaxresp.data.ghDocVo; //Thông tin chuyên gia
            },
            errorCallback: function (err) {
                $.loading(false);
                newtouch_globalevent_f4(); //Xóa
            },
            complete: function () {
                $.loading(false);
            }
        });
    }


    //Tải dữ liệu đăng ký khám
    function bindGHSource() {
        $("").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 200,
            width: 600,
            filter: function () {
                return mzghData;
            },
            caption: "",
            colModel: [
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', widthratio: 25, hidden: true },
                { label: '', name: '', widthratio: 25, hidden: true },
                { label: '', name: '', widthratio: 25, hidden: true },
                { label: '', name: '', widthratio: 25, hidden: true },
                { label: '', name: '', widthratio: 25, hidden: true },
                { label: '', name: '', widthratio: 25, hidden: true },
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', widthratio: 15 },
                { label: '', name: '', widthratio: 35 }
            ],
            itemdbclickhandler: function ($thistr) {
                //Gán giá trị
                $("").val($thistr.attr(""));
                $("").val($thistr.attr(""));
                $("").val($thistr.attr("") === "" ? "" : "");

                ghnm = $thistr.attr("");
                //ysksbh = $thistr.attr("");
                mzgh = $thistr.attr("");
                ks = $thistr.attr("");
                mjzbz = $thistr.attr("");
                var lsys = $thistr.attr("");

                $.each(top.window.clients.doctorInHosBookkeep, function (idx, val) {
                    if (val.ks === ks && val.StaffGh === lsys) {
                        ys = val.StaffGh;
                        $("").val(val.StaffName);
                    }
                });
                if (mzghDocVo != null && mzghDocVo.ry) {
                    $("").val(mzghDocVo.rymc);
                    ys = mzghDocVo.gh;
                    if (mjzbz !== "") {
                        //ysksbh = mzghDocVo.ksbh;
                        ks = mzghDocVo.ks;
                    }
                }
            }
        });
    }

    //Tải thông tin bác sĩ
    function bindDoctors() {
        ///Bác sĩ
        $("").newtouchFloatingSelector({
            height: 300,
            width: 500,
            filter: function (keyword) {
                if (ghnm == "") {
                    $modelAlert("", "");
                    return false;
                }
                if (!keyword) {
                    return false;
                }
                //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
                var resultObjArr = new Array();//
                $.each(top.window.clients.doctorInHosBookkeep, function (idx, val) {
                    if ($.trim(keyword).length == 0 || (val.py && val.py.toUpperCase().indexOf(keyword.toUpperCase()) >= 0) || (val.rymc && val.rymc.indexOf(keyword.toLowerCase()) >= 0) || (val.gh && val.gh.indexOf(keyword.toLowerCase()) >= 0) || (val.kspy && val.kspy.indexOf(keyword.toUpperCase()) >= 0)) {
                        if (ghnm && val.ks == ks) {
                            resultObjArr.push(val);
                        }
                    }
                });
                return resultObjArr;

            },
            caption: "",
            colModel: [
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', widthratio: 25, hidden: true },
                { label: '', name: '', widthratio: 25, hidden: true },
                { label: '', name: '', widthratio: 25 },
                //{ label: '', name: '', widthratio: 25, hidden: true },
                { label: '', name: '', widthratio: 25, hidden: true }

            ],
            itemdbclickhandler: function ($thistr) {
                $("").val($thistr.attr(""));
                $("").val($thistr.attr(""));
                ys = $thistr.attr("");
                if (mjzbz != "") {
                    //ysksbh = $thistr.attr("");
                    ks = $thistr.attr("");
                }
            },
        });

    }



    //Nhập đánh giá thông tin
    function AddData_Check() {
        kh = $("").val();
        if (kh == null || kh == undefined) {
            $.modalAlert("", '');
            $("").focus();
            return false;
        }
        else {
            var txtczh = $("").val();
            //if (lsCzh != "") {
            if (txtczh == "") {
                $.modalAlert("", '');
                $("").focus();
                return false;
            }
            //} else {
            //$("").val(0);
            //}
        }
        var sfxm = $("").val();
        if (sfxm == null || sfxm === "" || sfxm == undefined) {
            $.modalAlert("", '');
            $("").focus();
            return false;
        }
        var sl = $("").val();
        if (sl == null || sl == "" || sl == undefined) {
            $.modalAlert("", '');
            $("").focus();
            return false;
        }
        var dj = $("").val();
        if (dj == null || dj === "" || dj == undefined) {
            $.modalAlert("", '');
            $("").focus();
            return false;
        }
        mzgh = $("").val();
        if (mzgh == null || mzgh === "" || mzgh == undefined) {
            $.modalAlert("", '');
            $("").focus();
            return false;
        }
        var ys = $("").val();
        if (ys == null || ys === "" || ys == undefined) {
            $.modalAlert("", '');
            $("").focus();
            return false;
        }
        var ks = $("").val();
        if (ks == null || ks == "" || ks == undefined) {
            $.modalAlert("", '');
            $("").focus();
            return false;
        }
        loadCFHAndInfo(); //后台调取处方号和服务费
    }

    //添加处方数据
    function AddCFData() {
        var obj = new Object();
        var messCfxm = "";
        if (sfxmtype === "")//Hạng mục
        {
            obj.cfh = "";
        }
        if (sfxmtype == "")//Thuốc
        {
            obj.cfh = lsCfh;
            //同一处方不能录入相同的药品
            messCfxm = cheYPEqual(sfxmcbh, yfCode);
        }

        obj.xmmc = $("").val(); //Hạng mục
        obj.dj = $("").val();
        obj.dw = $("").val();

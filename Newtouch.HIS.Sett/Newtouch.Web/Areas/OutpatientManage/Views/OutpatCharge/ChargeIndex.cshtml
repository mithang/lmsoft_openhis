            dqzje = parseFloat(dqzje) + parseFloat(jeNum);
        } else {
            dqzje = parseFloat(jeNum);
        }

        dqzje = dqzje.toFixed(2);
        $("#txtysk").val(dqzje);

        if (sfxmtype === "2")//Thuốc
        {
            if (cfzje !== 0) {
                cfzje = parseFloat(cfzje) + parseFloat(jeNum);
            } else {
                cfzje = parseFloat(jeNum);
            }
            cfzje = cfzje.toFixed(2);
        }
        $("#lblzje").text(cfzje); //Tổng số tiền

        checkedAll();
        clearItemXM();
    }

    //Xét thuốc giống nhau có nhập cùng một đơn thuốc hay không
    function cheYPEqual(sfxmcbh, yfCode) {
        var res = "";
        var cflength = myCFData.length;
        if (cflength > 0) {
            for (var i = 0; i < cflength; i++) {
                var obj = myCFData[i];
                if (obj.cfh !== "") { //Thuốc
                    if (lsCfh !== "" && lsCfh === obj.cfh) {
                        if (yfCode === obj.yfdm) {
                            if (sfxmcbh === obj.sfxmcbh) {
                                res = "Đơn thuốc hiện tại đã có thuốc đã chọn，Xác nhận thêm nữa không?？";
                            }
                        }
                        else {
                            res = "error";
                        }
                    }
                }
                else {
                    if (sfxmcbh === obj.sfxmcbh) {
                        res = "Hiện đã có hạng mục đã chọn，Xác nhận thêm nữa không?？";
                    }
                }
            }
        }
        return res;
    }


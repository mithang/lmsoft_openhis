        obj.je = jeNum;
        obj.ksmc = $("#ks").val();
        obj.ysmc = $("#ys").val();
        obj.xmnm = 0;
        obj.ghnm = ghnm;
        obj.mjzbz = mjzbz;
        //obj.ksbh = ysksbh;

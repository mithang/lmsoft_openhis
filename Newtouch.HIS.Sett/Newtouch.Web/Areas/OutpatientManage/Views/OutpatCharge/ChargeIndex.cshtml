        obj.dl = sfxmdl;
        obj.zfxz = sfxmzfxz;
        obj.xmtype = sfxmtype;
        obj.pt_nm = 0;
        obj.pt_zdmxnm = 0;
        obj.czh = $("#czh").val(); //Số nhóm
        obj.yfdm = yfCode;
        obj.ypbzdm = ypbzdm;
        obj.fwfdj = sfxmfwf; //Phí dịch vụ hạng mục thu phí
        obj.nbdl = sfxmNbdl;
        obj.ybdm = sfxmYbdm;
        //Nếu đã thêm hạng mục hoặc thuốc  Xét Mã hiện tại đã tồn tại hay chưa
        if (myCFData) {
            for (var i = 0; i < myCFData.length; i++) {
                if (myCFData[i].sfxmbh === sfxmbh) {
                    $.modalAlert("Thuốc hiện tại đã tồn tại，hoặc hạng mục hiện tại đã tồn tại", 'warning');
                    clearItem();
                    return false;
                }
            }
        }
        obj = $.extend(obj, patInfoObj); //ĐưapatInfoObjGiá trị trong đối tượng Bổ sung vào objBên trong đối tượng
        myCFData.push(obj);

    //Tải hạng mục mẫu đã chọn
    function loadTempDetail(tempDetailData) {
        var tempData = [];
        var tempJe = 0;
        for (var i = 0; i < tempDetailData.length; i++) {
            var obj = new Object();
            obj.cfh = "";
            obj.xmmc = tempDetailData[i].sfxmmc; //Hạng mục
            obj.dj = tempDetailData[i].dj;
            obj.dw = tempDetailData[i].dw;
            obj.sl = tempDetailData[i].sl;
            obj.sfxm = tempDetailData[i].sfxm;
            obj.sfxmdlmc = tempDetailData[i].dlmc;
            obj.xmbh = tempDetailData[i].sfxmbh;
            obj.sfxmzfbl = parseFloat(tempDetailData[i].zfbl);
            obj.sfxmypgg = tempDetailData[i].gg;
            obj.dl = tempDetailData[i].dl;
            obj.zfxz = tempDetailData[i].zfxz;
            var sfxmfwf = 0;
            var je = ((parseFloat(obj.dj) + parseFloat(sfxmfwf)) * (parseFloat(obj.sl))).toFixed(2);
            //Số tiền = （Đơn giá + Phí dịch vụ bổ sung）* Số lượng

            obj.fwfdj = sfxmfwf; //Phí dịch vụ hạng mục thu phí
            obj.je = je;
            obj.brxzmc = $("#brxzmc").val();
            obj.ksmc = $("#ks").val();
            obj.ysmc = $("#ys").val();
            obj.xmnm = 0;
            obj.ghnm = ghnm;
            obj.mjzbz = mjzbz;
            obj.ksbh = ysksbh;
            obj.ysbh = ysbh;
            obj.ks = ks;
            obj.ys = ys;
            obj.xmtype = 4; //Hạng mục mẫu
            obj.pt_nm = 0;
            obj.pt_zdmxnm = 0;
            obj.czh = 0; //Số nhóm
            obj.yfdm = "";
            obj.ypbzdm = "";
            obj.nbdl = tempDetailData[i].nbdl;
            obj.ybdm = tempDetailData[i].ybdm;

            obj = $.extend(obj, patInfoObj);
            tempData.push(obj);
            if (tempJe != 0) {
                tempJe = parseFloat(tempJe) + parseFloat(obj.je);
            } else {
                tempJe = parseFloat(obj.je);
            }
            tempJe = tempJe.toFixed(2);

        }
        //Gộp hai mảng
        myCFData.push.apply(myCFData, tempData);
        myCFCount++;
        $('#listGrid').jqGrid("clearGridData");//Xóa trống dữ liệu trước
        gridListData(myCFData);

        $("#lbldqxmje").text(tempJe);//Số tiền hạng mục hiện tại
        if (dqzje != 0) {
            dqzje = parseFloat(dqzje) + parseFloat(tempJe);
        } else {
            dqzje = parseFloat(tempJe);
        }
        dqzje = dqzje.toFixed(2);
        //$("#lblzje").text(dqzje); //Tổng số tiền
        $("#txtysk").val(dqzje);

        checkedAll();

        clearItemXM(); //Xóa trống hạng mục
    }


    //Xóa F4
    function newtouch_event_f4() {
        funcDoPageClear();
    }


    //Đổi đơn thuốc F6
    function ChangeCF() {
        if (myCFData.length > 0) {
            //Xét dữ liệu đã thay đổi hay không stateSave=false
            clearHfItem();
        } else {
            $("#kh").focus();
            return false;
        }
    }

    //Đổi đơn thuốc và xóa trống
    function clearHfItem() {
        clearItemXM(); //Xóa trống hạng mục，Không xóa đăng ký khám và bác sĩ、Khoa
        GetNewCFH(); //Lấy số đơn thuốc mới
    }


    //Sau khi thêm một đơn thuốc thì xóa trống dữ liệu hạng mục trước đó
    function clearItem() {
        $("#sfxm").val("");
        $("#sl").val("");
        $("#dw").val("");
        $("#dj").val("");
        $("#ys").val("");
        $("#ks").val("");
        $("#mzgh").val("");
        $("#sfxm").focus();
    }

    function clearItemXM() {
        $("#sfxm").val("");
        $("#sl").val("");
        $("#dw").val("");
        $("#dj").val("");
        $("#sfxm").focus();
        $("#mzgh,#ys,#ks").attr("disabled", "disabled").css("background-color", "rgb(238, 238, 238)");
    }

    //Đổi đơn thuốc lấy số đơn thuốc mới
    function GetNewCFH() {
        $.loading(true);
        $.najax({
            type: "POST",
            url: "/OutpatientManage/OutpatCharge/GetCfh?r=" + Math.random(),
            data: { sfxmtype: sfxmtype },
            dataType: "json",
            success: function (ajaxresp) {
                lsCfh = ajaxresp.data; //Số đơn thuốc tạm thời
                $("#lbldqcfh").text(lsCfh);
            },
            errorCallback: function (err) {
                $.loading(false);
            },
            complete: function () {
                $.loading(false);
            }
        });

    }

    var ysk = 0, //Khoản phải thu
        zfje = 0, //Số tiền thanh toán
        zl = 0, //Tiền thừa
        xjzffs, //Phương thức thanh toán tiền mặt
        xjzffsbh, //Số hiệu
        zffsmc,
        gridIds, //Dòng đã chọnid
        fph; //Số hóa đơn

    //Lưu Xét
    function CheckSave() {
        if (kh === "" || patInfoObj == null || patInfoObj.patid == "" || patInfoObj.brxz === "") {
            $.modalAlert("Thông tin cơ bản bệnh nhân trống", 'warning');
            return false;
        }
        if (fph == "") {
            $.modalAlert("Vui lòng chọn số hóa đơn", 'warning');
            return false;
        }

        if (gridIds == "" || gridIds == undefined) {
            $.modalAlert("Không có dữ liệu cần lưu và quyết toán", 'warning');
            return false;
        }

        if (parseFloat(ysk) == 0) {
            grid_checkedit();
        }

        var reg = /(^[1-9]([0-9]+)?(\.[0-9]{1,2})?$)|(^(0){1}$)|(^[0-9]\.[0-9]([0-9])?$)/;
        zfje = $("#txtmoney").val();  //Số tiền thanh toán
        var ddlzffs = $("#ddlzffs option:selected");//Lấy mục đã chọn
        xjzffs = ddlzffs.val();//Lấy giá trị của mục đã chọn
        zffsmc = ddlzffs.text();//Lấy văn bản của mục đã chọn
        xjzffsbh = ddlzffs.attr("data-xjzffsbh"); //Lấydata-*Thuộc tính tùy chỉnh

        fph = $("#txtfph").val();
        if (xjzffs == -1 || zffsmc == "") {
            $.modalAlert("Phương thức thanh toán là bắt buộc", 'warning');
            return false;
        }
        if (zfje == "" || zfje == undefined) {
            $.modalAlert("Số tiền thanh toán là bắt buộc", 'warning');
            return false;
        } else {
            if (!reg.test(zfje)) {
                $.modalAlert("Vui lòng nhập đúng định dạng số tiền", 'warning');
                return false;
            }
        }
        if (parseFloat(zfje) < parseFloat(ysk)) {
            $.modalAlert("Số tiền thực trả không được nhỏ hơn số tiền phải trả", 'warning');
            return false;
        } else {
            zl = parseFloat(zfje) - parseFloat(ysk);
            zl = zl.toFixed(2);
            $("#txtzl").val(zl);
            //Biểu mẫu quyết toán
            showBillSuccessDialog(ysk, zfje, 0, zl);
        }
    }

    //Bật cửa sổ xác nhận số tiền
    function showBillSuccessDialog(ysk, ssk, srce, zl) {
        var url = "/HospitalizationManage/Settlement/SettSuccessDialog?r=" + Math.random() + "&yingshoukuan=" + ysk
            + "&ssk=" + ssk
            + "&srce=" + srce
            + "&zhaoling=" + zl;
        $.modalOpen({
            id: "FormShowBillSuccessDialog",
            title: "Xác nhận quyết toán",
            url: url,
            width: "320px",
            height: "260px",
            callBack: function (iframeId) {
                $.modalClose("FormShowBillSuccessDialog");   //Đóng biểu mẫu số tiền quyết toán
                var allJson = $("#listGrid").jqGrid('getRowData_AllLine', true); //Lấy của dòng đã chọnJsonDữ liệu
                SaveAjax(JSON.parse(allJson));
            }
        });
    }

    //Lưu F8
    function newtouch_event_f8() {
        //Xét có chọn đơn thuốc hay không trước、Phương thức thanh toán、Số tiền
        CheckSave();
        //Hộp bật lên
    }

    //Lưu ajax Phía máy chủ thêm đơn thuốc và hạng mục、Quyết toán
    function SaveAjax(allJson) {
        //Truyền dữ liệu đơn thuốc lên phía máy chủ
        $.najax({
            type: "POST",
            url: "/OutpatientManage/OutpatCharge/AddCfInfo",
            data: { chargeDto: allJson, kh: kh, fph: fph, xjzffs: xjzffs, xjzffsbh: xjzffsbh, zfje: zfje, ysk: ysk, zl: zl },
            dataType: "json",
            cache: false, //Sửa chữaieBộ nhớ đệm
            success: function (ajaxresp) {
                $.modalAlert("Lưu thành công", 'success');
                newtouch_globalevent_f4();//Xóa
            },
            errorCallback: function (err) {
                newtouch_globalevent_f4();//Xóa
                $.loading(false);
            },
            complete: function () {
                lsCfh = "";
                $.loading(false);
            }
        });
    }


    //jqGridHộp chọn nhiều Sau khi chọn một mục sẽ thay đổi số tiền phải thu
    function grid_checkedit() {
        ysk = 0;
        gridIds = $("#listGrid").jqGrid('getGridParam', 'selarrrow'); //Lấy của dòng đã chọnid
        //Cũng có thể
        //var zzzzzfje = 0;
        //var allJson = $("#listGrid").jqGrid('getRowData_AllLine', true); //Lấy của dòng đã chọnJsonDữ liệu
        //var allArr = JSON.parse(allJson);
        //for (var i = 0; i < allArr.length; i++) {
        //    var skje = allArr[i].je;
        //    console.log(skje);
        //    zzzzzfje += parseFloat(skje);
        //}
        //console.log(zzzzzfje);

        if (gridIds != "" && gridIds != undefined) {
            for (var i = 0; i < gridIds.length; i++) {
                var rowData = $("#listGrid").jqGrid("getRowData", gridIds[i]);//Theo phần trênidLấy tất cả dữ liệu của dòng này
                var xmje = rowData.je; //Lấy giá trị cột đã chỉ định （auditStatus làcolModelcủaname）
                ysk = parseFloat(ysk) + parseFloat(xmje);
            }
        }
        ysk = ysk.toFixed(2);
        $("#txtysk").val(ysk); //Khoản phải thu thay đổi theo lựa chọn

        //của dòng hiện đang chọncfh Nếu không trống thì là thuốc，Nếu trống thì là hạng mục thu phí
        var gr = $("#listGrid").jqGrid('getGridParam', 'selrow');//Dòng hiện đang nhấp
        var dqcfobj = $("#listGrid").jqGrid("getRowData", gr);
        var dqcfje = 0;
        if (dqcfobj != "") {
            //Thuốc
            for (var i = 0; i < myCFData.length; i++) {
                if (myCFData[i].cfh == dqcfobj.cfh) {
                    if (dqcfje != 0) {
                        dqcfje = parseFloat(dqcfje) + parseFloat(myCFData[i].je);
                    } else {
                        dqcfje = parseFloat(myCFData[i].je);
                    }
                }
            }

        } else {//Hạng mục
            dqcfje = $("#listGrid").jqGridRowValue()[0].je;
        }

        dqcfje = dqcfje.toFixed(2);
        $("#lbldqxmje").text(dqcfje); //Số tiền đơn thuốc hiện tại
    }


    //Mặc định chọn tất cả
    function checkedAll() {
        $("#tabGrid input[type=checkbox]").attr("checked", true);
        $("#tabGrid tbody input[type=checkbox]").each(function (i) {
            $("#listGrid").jqGrid('setSelection', i + 1); //Thiết lậpjqGridĐã chọn
        });
        //Hộp chọn tất cả
        var $checkAll = $("#tabGrid table thead").find("input");
        //body của các dòngcheckboxKhung
        var $tbr = $("#tabGrid table tbody").find("input");
        $checkAll.prop('checked', $tbr.find('input:checked').length == $tbr.length ? true : false);
    }


</script>

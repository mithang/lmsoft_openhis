        if (gridIds != "" && gridIds != undefined) {
            for (var i = 0; i < gridIds.length; i++) {
                var rowData = $("").jqGrid("", gridIds[i]);//Theo nội dung trênidLấy tất cả dữ liệu của dòng này
                var xmje = rowData.je; //获得指定列的值 （auditStatus ChocolModelcủaname）
                ysk = parseFloat(ysk) + parseFloat(xmje);
            }
        }
        ysk = ysk.toFixed(2);
        $("").val(ysk); //应收款随着选择改变

        //dòng đã chọn hiện tạicfh Không nếu trống là thuốc，Nếu trống là hạng mục thu phí
        var gr = $("").jqGrid('', '');//Dòng nhấn hiện tại
        var dqcfobj = $("").jqGrid("", gr);
        var dqcfje = 0;
        if (dqcfobj != "") {
            //Thuốc
            for (var i = 0; i < myCFData.length; i++) {
                if (myCFData[i].cfh == dqcfobj.cfh) {
                    if (dqcfje != 0) {
                        dqcfje = parseFloat(dqcfje) + parseFloat(myCFData[i].je);
                    } else {
                        dqcfje = parseFloat(myCFData[i].je);
                    }
                }
            }

        } else {//Hạng mục
            dqcfje = $("").jqGridRowValue()[0].je;
        }

        dqcfje = dqcfje.toFixed(2);
        $("").text(dqcfje); //当前处方金额
    }


    //默认全选
    function checkedAll() {
        $("").attr("", true);
        $("").each(function (i) {
            $("").jqGrid('', i + 1); //ĐặtjqGridĐã chọn
        });
        //全选框
        var $checkAll = $("").find("");
        //body dòng mỗicheckbox框
        var $tbr = $("").find("");
        $checkAll.prop('', $tbr.find('').length == $tbr.length ? true : false);
    }


</script>

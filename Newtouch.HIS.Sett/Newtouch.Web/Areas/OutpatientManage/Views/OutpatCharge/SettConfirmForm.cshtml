<script type="text/javascript">
    //Thanh toán di động
    var payingOrFailed = null;  //trueĐang thanh toán hoặc thanh toán thất bại
    function CheckPayOK(settInfo) {
        //&&Cần thanh toán
        var needPay = '@(needPay)' == 'True';
        if (!needPay) {
            return true;
        }
        var payMoney = 0;
        var alipayMoney = 0;
        var wechatMoney = 0;
        //if (settInfo.zfje1 > 0) {
        //    if (settInfo.zffs1 == '10') {
        //        alipayMoney = settInfo.zfje1;
        //    }
        //    else if (settInfo.zffs1 == '11') {
        //        wechatMoney = settInfo.zfje1;
        //    }
        //}
        //if (settInfo.zfje2 > 0) {
        //    if (settInfo.zffs2 == '10') {
        //        alipayMoney = settInfo.zfje2;
        //    }
        //    else if (settInfo.zffs2 == '11') {
        //        wechatMoney = settInfo.zfje2;
        //    }
        //}
        var djjesszffs = $('#djjesszffs option:selected').val()

        if (djjesszffs == 13) {
            alipayMoney = settInfo.djjess;
        } else {
            if (settInfo.zfje1 > 0) {
                if (settInfo.zffs1 == '10') {
                    alipayMoney = settInfo.zfje1;
                }
                else if (settInfo.zffs1 == '11') {
                    wechatMoney = settInfo.zfje1;
                }
            }
            if (settInfo.zfje2 > 0) {
                if (settInfo.zffs2 == '10') {
                    alipayMoney = settInfo.zfje2;
                }
                else if (settInfo.zffs2 == '11') {
                    wechatMoney = settInfo.zfje2;
                }
            }
        }

        if (alipayMoney > 0 && wechatMoney > 0) {
            $.modalAlert('Lựa chọn phương thức thanh toán không đúng', 'error');
            return false;    //Lựa chọn phương thức thanh toán không đúng
        }
        payMoney = alipayMoney + wechatMoney;
        if (payMoney <= 0) {
            //Không cần thanh toán di động
            payingOrFailed = null;
            return true;
        }
        if (payMoney > 0 && !!settInfo.zffs1 && !!settInfo.zffs2) {
            $.modalAlert('Thanh toán di động<br/>Không hỗ trợ chọn nhiều phương thức thanh toán', 'error');
            return false;    //Lựa chọn phương thức thanh toán không đúng
        }
        if (payMoney > 0 && settInfo.zhaoling != 0) {
            $.modalAlert('Thanh toán di động không được có tiền thừa', 'error');
            return false;
        }
        if ((payingOrFailed === null || payingOrFailed === true) && needPay && payMoney > 0) {
            payMoney = ovpraseFloat(payMoney).toFixed(2);
            var out_trade_no = (new Date()).getTime().toString();   //Có vấn đề hay không？
            ToPay(out_trade_no, '门诊收费', payMoney, djjesszffs);
            payingOrFailed = true;
        }
        return !(payingOrFailed === true); //Đang thanh toán Trả vềtrue，Nếu không sẽ trả vềfalse
    }
    //Khởi tạo thanh toán
    function ToPay(out_trade_no, subject, total_amount,djjesszffs) {
        var title = 'Thanh toán bằng mã thanh toán-' + (subject.length <= 15 ? subject : subject.substring(0, 12) + "...");
        var url = "/PayManage/MicroPay/MicroPay";
        url += '?out_trade_no=' + out_trade_no;
        url += '&subject=' + subject;
        url += '&total_amount=' + total_amount;
        url += '&djjesszffs=' + djjesszffs;
        url += '&patid=' + $.request("patid");
        $.modalOpen({
            id: "ToPay",
            title: title,
            url: url,
            width: "400px",
            height: "210px",
            callBack: function (iframeId) {
                top.frames[iframeId].AcceptClick(function (data) {
                    //pay success callback
                    PaySuccessHandle(data);
                });
            }
        });
    }
    //Thanh toán thành công-Tiếp tục gửi quyết toán
    var outTradeNo;
    function PaySuccessHandle(data) {
        payingOrFailed = false;

        outTradeNo = data.outTradeNo;
        //Sửa phương thức thanh toán di động
        if (data.payType == 1 && $('#zffs1').val() == '11') {
            $('#zffs1').val("10").trigger('change');
        }
        if (data.payType == 2 && $('#zffs1').val() == '10') {
            $('#zffs1').val("11").trigger('change');
        }
        AcceptClick(theAcceptClickCallBack);
    }
	//Điều khiển khung nhập
    function inputnum(obj, val) {
        
		obj.value = obj.value.replace(/[^\d.]/g, ""); //Xóa"Số"và"."ký tự ngoài
		obj.value = obj.value.replace(/^\./g, ""); //Kiểm tra ký tự đầu tiên là số
		obj.value = obj.value.replace(/\.{2,}/g, ""); //Chỉ giữ lại mục đầu tiên, Xóa phần thừa
		obj.value = obj.value.replace(".", "$#$").replace(/\./g, "").replace("$#$", ".");
		obj.value = obj.value.replace(/^(\-)*(\d+)\.(\d\d).*$/, '$1$2.$3'); //Chỉ được nhập hai chữ số thập phân
    }

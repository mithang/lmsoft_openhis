<script>
    
    //Số dư tiền tạm ứng
    var yjjye = 0;
    var withYjj = '';
    var sfyxzk = '';
    var sfyxdzzf = '';
    var SettPayBalance='';
    var medicalInsurance = '';
    var defaultPayMethod = "";
    //Tổng số tiền quyết toán
    var zje = ovpraseFloat($.request(""));
    //Thanh toán khoản phải thu Khoản phải thu khi quyết toán（zje = Có thể báo cáo + Khoản phải thu khi quyết toán + V.v.）
    var orglxjzfys = ovpraseFloat($.request(""));
    //Khi có chiết khấu không bằng original
    var xjzfys = orglxjzfys;    //Khi có chiết khấu sẽ không bằng
    //Liên quan bảo hiểm y tế
    var ybjyFeeReturn = JSON.parse(sessionStorage.getItem(''));
    var isYbjy = $.request("");
    var isXnh = $.request("") === "" ? true : false;
    var brxz = $.request("");
    var brxzmc = $.request("");
    var isjm = $.request("");
    var strdyjylsh = "";
    var ybPatInfo = JSON.parse(sessionStorage.getItem(''));
	var zhdyList = "";
	var postdata = { comport: 1, context: "", typemc: "" };
    $('').html(brxzmc);
    if (isYbjy === '' || isXnh) {
        $('').html('');
        //新版国家医保
        if (ybPatInfo.ybVer === "") {
		var ybzje = 0.000;//Tổng số tiền bảo hiểm y tế
		var xjzfje = 0.000;//Số tiền mặt thanh toán bảo hiểm y tế
        var zhzf = 0.000;//Thanh toán tài khoản
        var tczf = 0.000;
        var mzjzje = 0.000;//Số tiền cứu trợ dân chính
        if (!!ybjyFeeReturn) {
            mzjzje = ovpraseFloat(ybjyFeeReturn.maf_pay);
            tczf = ovpraseFloat(ybjyFeeReturn.hifp_pay);
            //tczf = (tczf - mzjzje).toFixed(2);
			//Số tiền mặt thanh toán bảo hiểm y tế
            xjzfje = ovpraseFloat(ybjyFeeReturn.psn_cash_pay);
			//Thanh toán tài khoản
            zhzf = ovpraseFloat(ybjyFeeReturn.acct_pay);
			//Tổng số tiền bảo hiểm y tế
			ybzje = ovpraseFloat(ybjyFeeReturn.ybzje);

			xjzfys = zje - ybzje + xjzfje;
			xjzfys = ovpraseFloat(xjzfys).toFixed(2);
			orglxjzfys = xjzfys;
			mzjzje = (mzjzje).toFixed(2);
        } else {
			//Bất thường
			orglxjzfys = xjzfys = zje = 0;
			$.modalAlert("", "");
			$.modalClose();
		}
		$('').remove();
		$('').remove();
		$('').show();
		$('').html(zje);//Tổng chi phí
		$('').html((ovpraseFloat(xjzfje)).toFixed(2));//Thanh toán tiền mặt bảo hiểm y tế
		$('').html((ovpraseFloat(zje) - ovpraseFloat(ybzje)).toFixed(2));//自费计费
		$('').html(ybzje);
		!!ybjyFeeReturn.acct_pay && $('').html(ovpraseFloat(ybjyFeeReturn.acct_pay).toFixed(2));
		!!ybjyFeeReturn.hifp_pay && $('').html((ovpraseFloat(ybjyFeeReturn.hifp_pay)));
		!!ybjyFeeReturn.hifob_pay && $('').html(ovpraseFloat(ybjyFeeReturn.hifob_pay).toFixed(2));
		!!ybjyFeeReturn.cvlserv_pay && $('').html(ovpraseFloat(ybjyFeeReturn.cvlserv_pay).toFixed(2));
		!!ybjyFeeReturn.maf_pay && $('').html(mzjzje);


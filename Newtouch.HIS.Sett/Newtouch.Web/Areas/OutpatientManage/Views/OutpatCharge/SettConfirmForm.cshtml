    //Tiền tạm ứng dùng có thể quyết toán ngoại trú
    var withYjj = SysConfigReader.Bool("");
    bool? relatedFPH = false;
    if (HttpContext.Current.Request.Params[""] == "")
    {
        //Đăng ký khám thu phí
        relatedFPH = SysConfigReader.Bool("");
    }
    else
    {
        //Thu phí ghi sổ
        relatedFPH = SysConfigReader.Bool("");
    }
    if (relatedFPH == true)
    {
        //Phương thức in phiếu thu phí
        var invoicePrintMethod = SysConfigReader.String("");
        if (invoicePrintMethod == "")
        {
            //以AXIn，这里不生成发票号    //是后更新方式
            relatedFPH = false;
        }
    }
    //Địa bàn bảo hiểm y tế，区分系统将执行何处医保逻辑
    var medicalInsurance = SysConfigReader.String("");
    var sfyxzk = SysConfigReader.Bool("");

    var sfyxdzzf = SysConfigReader.Bool("", false);
    //结算金额分币误差控制
    var SettPayBalance = SysConfigReader.Bool("", false);
    //是否移动支付
    var needPay = SysConfigReader.Bool("") ?? false;
    //Mặc định phương thức thanh toán
    var defaultPayMethod = SysConfigReader.String("");
    var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}

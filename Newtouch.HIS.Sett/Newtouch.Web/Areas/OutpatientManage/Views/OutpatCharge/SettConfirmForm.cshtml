<script>
    
    //Số dư tiền tạm ứng
    var yjjye = 0;
    var withYjj = '@(withYjj)';
    var sfyxzk = '@(sfyxzk)';
    var sfyxdzzf = '@(sfyxdzzf)';
    var SettPayBalance='@(SettPayBalance)';
    var medicalInsurance = '@medicalInsurance';
    var defaultPayMethod = "@(defaultPayMethod)";
    //Tổng số tiền quyết toán
    var zje = ovpraseFloat($.request("zje"));
    //Thanh toán khoản phải thu Khoản phải thu khi quyết toán（zje = Có thể thanh toán bảo hiểm + Khoản phải thu khi quyết toán + v.v.）
    var orglxjzfys = ovpraseFloat($.request("xjzfys"));
    //Khi có chiết khấu sẽ không bằng nhau original
    var xjzfys = orglxjzfys;    //Khi có chiết khấu sẽ không bằng nhau
    //Liên quan đến BHYT
    var ybjyFeeReturn = JSON.parse(sessionStorage.getItem('ybjyFeeReturn'));
    var isYbjy = $.request("isYbjy");
    var isXnh = $.request("isXnh") === "1" ? true : false;
    var brxz = $.request("brxz");
    var brxzmc = $.request("brxzmc");
    var isjm = $.request("isjm");
    var strdyjylsh = "";
    var ybPatInfo = JSON.parse(sessionStorage.getItem('cqPatInfo'));
	var zhdyList = "";
	var postdata = { comport: 1, context: "", typemc: "" };
    $('#brxzmc').html(brxzmc);
    if (isYbjy === 'true' || isXnh) {
        $('#tdZqysk').html('Khoản phải thu：');
        //BHYT quốc gia phiên bản mới
        if (ybPatInfo.ybVer === "gjyb") {
		var ybzje = 0.000;//Tổng số tiền BHYT
		var xjzfje = 0.000;//Số tiền mặt BHYT chi trả
        var zhzf = 0.000;//Thanh toán bằng tài khoản
        var tczf = 0.000;
        var mzjzje = 0.000;//Số tiền cứu trợ dân chính
        if (!!ybjyFeeReturn) {
            mzjzje = ovpraseFloat(ybjyFeeReturn.maf_pay);
            tczf = ovpraseFloat(ybjyFeeReturn.hifp_pay);
            //tczf = (tczf - mzjzje).toFixed(2);
			//Số tiền mặt BHYT chi trả
            xjzfje = ovpraseFloat(ybjyFeeReturn.psn_cash_pay);
			//Thanh toán bằng tài khoản
            zhzf = ovpraseFloat(ybjyFeeReturn.acct_pay);
			//Tổng số tiền BHYT

@{
    ViewBag.Title = "";
    Layout = "";
}

<script>
    $(function ()
    {
        gridList();

        selectGridAll();
    });

    function selectGridAll()
    {
        var jqGrid = $("");
        // 拿到所有行id
        var jqGridIDs = jqGrid.getDataIDs();
        for (var i = 0; i < jqGridIDs.length; i++) {
            jqGrid.setSelection(jqGridIDs[i], true);
        }
    }

    function GetMzhInfo()
    {
        var PrescriptionInfo = sessionStorage.getItem("");
        if (PrescriptionInfo)
        {
            sessionStorage.removeItem("")
            return $.parseJSON(PrescriptionInfo);
        }
    }

    function gridList()
    {
        var $gridList = $("");
        $gridList.newtouchLocalDataGrid(
        {
            multiselect: false,
            unwritten: false,
            height: 150,
                colModel: [
                    { label: '', name: '', width: 120, align: '' },
                    { label: '', name: '', width: 120, align: '' },
                    { label: "", name: "", width: 130, align: '' },
                    { label: '', name: '', width: 80, align: '' },
                    { label: '', name: '', width: 50, align: '' },
                    { label: '', name: '', width: 50, align: '' },
            ]
        });
        $gridList.newtouchLocalDataGrid(null, GetMzhInfo());
    }

    function submitForm(callback)
    {
        var seleRow = $("").jqGridRowValue();
        var mzh = seleRow.mzh;
        if (!!!mzh) {
            $.modalAlert("", "");
            return;
        }
        callback(mzh);
        $.modalClose();
    }
</script>

<div class="gridPanel">
    <table id="chooseMzhGrid"></table>
</div>


@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="topPanel">
    @Html.Partial("_OrganizeIdDDLToolbarSearchView")
    <div class="toolbar">
        <div class="btn-group">
            <a id="NF-add" class="btn btn-primary dropdown-text" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a id="NF-edit" class="btn btn-primary dropdown-text" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa thông tin</a>
        </div>
        @*<div class="btn-group">
                <a id="NF-delete" class="btn btn-primary dropdown-text" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa thông tin</a>
            </div>
            <div class="btn-group">
                <a id="NF-Details" class="btn btn-primary dropdown-text" onclick="btn_details()"><i class="fa fa-search-plus"></i>Xem thông tin</a>
            </div>*@
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Bác sĩ" style="width: 200px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script>
    $(function () {
        initControl();
        gridList();
    });
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            treeGrid: true,
            treeGridModel: "adjacency",
            url: "/OutpatientManage/OutpatientRegSchedule/GetOutpatientRegistScheduleList",
            postData: getSearchPostData(),
            height: 400,
            colModel: [
                { label: 'orgId', name: 'orgId', hidden: true },
                { label: 'ghpbId', name: 'ghpbId', hidden: true },
                {
                    label: 'Loại ngoại trú', name: 'mjzbz', width: 80, algin: 'left',
                    formatter: function (cellvalue) {
                        return $.enum.getDescByValue("EnumOutPatientType", cellvalue);
                    }
                },
                { label: 'Hạng mục đăng ký khám', name: 'sfxmmc', width: 100, algin: 'left' },
                { label: 'Hạng mục khám chữa bệnh', name: 'zlxmmc', width: 100, algin: 'left' },
                { label: 'Khoa', name: 'departmentName', width: 100, algin: 'left' },
                { label: 'Bác sĩ chuyên gia', name: 'staffName', width: 100, algin: 'left' },
                //{ label: 'Bệnh chuyên khoa', name: 'ghzbmc', width: 100, algin: 'left' },
                {
                    label: 'Thứ Hai', name: 'zyi', width: 60, algin: 'left',
                    formatter: function (cellvalue) {
                        if (cellvalue == 0) {
                            return "Không";
                        }
                        if (cellvalue == 1) {
                            return "Cả ngày";
                        }
                        if (cellvalue == 2) {
                            return "Buổi sáng";
                        }
                        if (cellvalue == 3) {
                            return "Buổi chiều";
                        }
                        return "";
                    }
                },
                {
                    label: 'Thứ Ba', name: 'zer', width: 60, algin: 'left',
                    formatter: function (cellvalue) {
                        if (cellvalue == 0) {
                            return "Không";
                        }
                        if (cellvalue == 1) {
                            return "Cả ngày";
                        }
                        if (cellvalue == 2) {
                            return "Buổi sáng";
                        }
                        if (cellvalue == 3) {
                            return "Buổi chiều";
                        }
                        return "";
                    }
                },
                {
                    label: 'Thứ Tư', name: 'zsan', width: 60, algin: 'left',
                    formatter: function (cellvalue) {
                        if (cellvalue == 0) {
                            return "Không";
                        }
                        if (cellvalue == 1) {
                            return "Cả ngày";
                        }
                        if (cellvalue == 2) {
                            return "Buổi sáng";
                        }
                        if (cellvalue == 3) {
                            return "Buổi chiều";
                        }
                        return "";
                    }
                },
                {
                    label: 'Thứ Năm', name: 'zsi', width: 60, algin: 'left',
                    formatter: function (cellvalue) {
                        if (cellvalue == 0) {
                            return "Không";
                        }
                        if (cellvalue == 1) {
                            return "Cả ngày";
                        }
                        if (cellvalue == 2) {
                            return "Buổi sáng";
                        }
                        if (cellvalue == 3) {
                            return "Buổi chiều";
                        }
                        return "";
                    }
                },
                {
                    label: 'Thứ Sáu', name: 'zwu', width: 60, algin: 'left',
                    formatter: function (cellvalue) {
                        if (cellvalue == 0) {
                            return "Không";
                        }
                        if (cellvalue == 1) {
                            return "Cả ngày";
                        }
                        if (cellvalue == 2) {
                            return "Buổi sáng";
                        }
                        if (cellvalue == 3) {
                            return "Buổi chiều";
                        }
                        return "";
                    }
                },
                {
                    label: 'Thứ Bảy', name: 'zlv', width: 60, algin: 'left',
                    formatter: function (cellvalue) {
                        if (cellvalue == 0) {
                            return "Không";
                        }
                        if (cellvalue == 1) {
                            return "Cả ngày";
                        }
                        if (cellvalue == 2) {
                            return "Buổi sáng";
                        }
                        if (cellvalue == 3) {
                            return "Buổi chiều";
                        }
                        return "";
                    }
                },
                {
                    label: 'Chủ Nhật', name: 'zri', width: 60, algin: 'left',
                    formatter: function (cellvalue) {
                        if (cellvalue == 0) {
                            return "Không";
                        }
                        if (cellvalue == 1) {
                            return "Cả ngày";
                        }
                        if (cellvalue == 2) {
                            return "Buổi sáng";
                        }
                        if (cellvalue == 3) {
                            return "Buổi chiều";
                        }
                        return "";
                    }
                },
                {
                    label: 'Hiệu lực', name: 'zt', width: 100, algin: 'left',
                    formatter: function (cellvalue) {
                        if (cellvalue == 0) {
                            return "Không";
                        } else {
                            return "Có";
                        }
                    }
                },
                {
                    label: 'Ngày lập hồ sơ', name: 'CreateTime', width: 100, align: 'left',
                    formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' }
                },
               { label: 'Nhân viên lập hồ sơ', name: 'CreatorCode', width: 80, align: 'left' }
            ]

        });

        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: getSearchPostData()
            }).trigger('reloadGrid');
        })
        //$("#btn_search").trigger('click');
    }

    function getSearchPostData() {
        var keyword = $("#txt_keyword").val();
        var organizeId = $("#OrganizeId").val();
        return { keyword: keyword, organizeId: organizeId };
    };


    function initControl() {

    }

    function btn_add() {
        $.modalOpen({
            id: "FormFIEdit",
            title: "Bảo trì lịch trực đăng ký khám",
            url: "/OutpatientManage/OutpatientRegSchedule/Form",
            width: "700px",
            height: "500px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    //Sửa
    function btn_edit() {
        var seleRowid = jQuery("#gridList").jqGrid("getGridParam", "selrow");
        if (!(seleRowid)) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        var ghpbId = $("#gridList").jqGridRowValue().ghpbId;
        var OrganizeId = $("#gridList").jqGridRowValue().OrganizeId;
        $.modalOpen({
            id: "FormFIEdit",
            title: "Sửa thông tin",
            url: "/OutpatientManage/OutpatientRegSchedule/Form?ghpbId=" + ghpbId + "&orgId=" + OrganizeId,
            width: "700px",
            height: "500px",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    //Xóa
    function btn_delete() {
        var seleRowid = jQuery("#gridList").jqGrid("getGridParam", "selrow");
        if (!(seleRowid)) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        var ghpbId = $("#gridList").jqGridRowValue().ghpbId;
        var OrganizeId = $("#gridList").jqGridRowValue().OrganizeId;
        $.deleteForm({
            url: "/OutpatientManage/OutpatientRegSchedule/DeleteForm",
            param: { ghpbId: ghpbId, OrganizeId: OrganizeId },
            success: function () {
                $("#gridList").trigger("reloadGrid");
            }
        })
    }
    //Chi tiết
    function btn_details() {
        var seleRowid = jQuery("#gridList").jqGrid("getGridParam", "selrow");
        if (!(seleRowid)) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        var count = $("#gridList").getGridParam("reccount");
        if (count = 0) {
            $.modalAlert("Chưa chọn dòng", 'warning');
            return;
        }
        var ghpbId = $("#gridList").jqGridRowValue().ghpbId;
        var OrganizeId = $("#gridList").jqGridRowValue().OrganizeId;
        $.modalOpen({
            id: "Details",
            title: "Xem cơ quan",
            url: "/OutpatientManage/OutpatientRegSchedule/Form?ghpbId=" + ghpbId + "&orgId=" + OrganizeId,
            width: "700px",
            height: "500px",
            btn: null,
        });
    }
</script>


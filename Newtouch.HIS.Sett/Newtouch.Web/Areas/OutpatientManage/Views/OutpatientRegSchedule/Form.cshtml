@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
}

<form id="form1">
    <div style="padding: 20px 35px 0 2px;">
        <table class="form">
            <tr>
                <th class="formTitle"><span class="required">*</span>Tổ chức：</th>
                <td class="formValue" colspan="3">
                    <select id="OrganizeId" name="OrganizeId" class="form-control required">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>Loại ngoại trú：</th>
                <td class="formValue" colspan="3">
                    <select id="mjzbz" name="mjzbz" class="form-control required" data-EnumType="EnumOutPatientType">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Hạng mục đăng ký khám ：</th>
                <td class="formValue" colspan="3">
                    <input type="text" class="form-control" id="ghlx" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Hạng mục chẩn trị ：</th>
                <td class="formValue" colspan="3">
                    <input type="text" class="form-control" id="zlxm" />
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>Khoa ：</th>
                <td class="formValue" colspan="3">
                    <input type="text" class="form-control required" id="ks" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Bác sĩ chuyên gia ：</th>
                <td class="formValue" colspan="3">
                    <input type="text" class="form-control" id="ys" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Thứ Hai ：</th>
                <td class="formValue">
                    @Html.DropDownList("", EnumRegSchedule.none.ToDescSelectList(), "", new { @class = "" })
                </td>
                <th class="formTitle">Thứ Ba ：</th>
                <td class="formValue">
                    @Html.DropDownList("", EnumRegSchedule.none.ToDescSelectList(), "", new { @class = "" })
                </td>
                <th class="formTitle">Thứ Tư ：</th>
                <td class="formValue">
                    @Html.DropDownList("", EnumRegSchedule.none.ToDescSelectList(), "", new { @class = "" })
                </td>
            </tr>
            <tr>
                <th class="formTitle">Thứ Năm ：</th>
                <td class="formValue">
                    @Html.DropDownList("", EnumRegSchedule.none.ToDescSelectList(), "", new { @class = "" })
                </td>
                <th class="formTitle">Thứ Sáu ：</th>
                <td class="formValue">
                    @Html.DropDownList("", EnumRegSchedule.none.ToDescSelectList(), "", new { @class = "" })
                </td>
                <th class="formTitle">Thứ Bảy ：</th>
                <td class="formValue">
                    @Html.DropDownList("", EnumRegSchedule.none.ToDescSelectList(), "", new { @class = "" })
                </td>
            </tr>
            <tr>
                <th class="formTitle">Chủ Nhật ：</th>
                <td class="formValue">
                    @Html.DropDownList("", EnumRegSchedule.none.ToDescSelectList(), "", new { @class = "" })
                </td>
                <th class="formTitle">Lượng đăng ký khám tổng ：</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="zhl" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Hiệu lực</th>
                <td class="formValue">
                    <div class="ckbox">
                        <input id="zt" type="checkbox" checked="checked"><label for="zt"></label>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    var ghpbId = $.request("");
    var OrganizeId = $.request("");
    $(function () {
        initControl();
        if (!!ghpbId) {
            $.ajax({
                url: "" + Math.random(),
                data: { ghpbId: ghpbId, OrganizeId: OrganizeId },
                dataType: "",
                async: false,
                success: function (data) {
                    $("").formSerialize(data);
                    $('').attr('', data.ghlx)
                        .attr('', data.sfxmmc)
                              .val(data.sfxmmc);
                    $('').attr('', data.zlxm)
                        .attr('', data.zlxmmc)
                        .val(data.zlxmmc);
                    $('').attr('', data.ys)
                            .val(data.staffName);
                    $('').attr('', data.ks)
                            .val(data.departmentName);
                }
            });
        }
    })
    function initControl() {
        //Hộp thả xuống tổ chức
        $("").bindSelect({
            url: "",
        });
    }

    //Hạng mục đăng ký khám
    $('').newtouchFloatingSelector({
        width: 600,
        height: 220,
        caption: "",
        clickautotrigger: true,
        url: '',
        ajaxparameters: function () {
            return "" + $.trim($('').val()) + "";
        },
        itemdbclickhandler: function ($thistr) {
            $('').attr('', $thistr.attr(''))
                .attr('', $thistr.attr(''))
                .val($thistr.attr(''));
        },
        colModel: [{ label: '', name: '', widthratio: 15 },
            { label: '', name: '', widthratio: 25 },
            { label: '', name: '', widthratio: 15 },
            { label: '', name: '', widthratio: 8 },
            { label: '', name: '', widthratio: 10 },
            { label: '', name: '', widthratio: 15 },
        ]
    });

    //Hạng mục chẩn trị
    $('').newtouchFloatingSelector({
        width: 600,
        height: 180,
        caption: "",
        clickautotrigger: true,
        url: '',
        ajaxparameters: function () {
            return "" + $.trim($('').val()) + "";
        },
        itemdbclickhandler: function ($thistr) {
            $('').attr('', $thistr.attr(''))
                .attr('', $thistr.attr(''))
                .val($thistr.attr(''));
        },
        colModel: [{ label: '', name: '', widthratio: 15 },
            { label: '', name: '', widthratio: 25 },
            { label: '', name: '', widthratio: 15 },
            { label: '', name: '', widthratio: 8 },
            { label: '', name: '', widthratio: 10 },
            { label: '', name: '', widthratio: 15 },
        ]
    });

    //Khoa
    $('').newtouchFloatingSelector({
        width: 400,
        height: 180,
        caption: "",
        clickautotrigger: true,
        url: '',
        ajaxmethod: '',
        ajaxreqdata: function () {
            var reqData = {};
            reqData.keyword = $("").val();
            return reqData;
        },
        itemdbclickhandler: function ($thistr) {
            $('').attr('', $thistr.attr(''))
                .val($thistr.attr(''));
        },
        colModel: [{ label: '', name: '', widthratio: 30 },
            { label: '', name: '', widthratio: 30 },
            { label: '', name: '', widthratio: 30 }
        ]
    });

    //Bác sĩ
    $('').newtouchFloatingSelector({
        width: 400,
        height: 180,
        caption: "",
        clickautotrigger: true,
        url: '',
        ajaxmethod: '',
        ajaxparameters: function () {
            if ($.trim($('').val()).length == 0) {
                return;
            }
            return "" + $.trim($('').val());
        },
        itemdbclickhandler: function ($thistr) {
            $('').attr('', $thistr.attr(''))
                .val($thistr.attr(''));
        },
        colModel: [{ label: '', name: '', widthratio: 30 },
            { label: '', name: '', widthratio: 30 },
            { label: '', name: '', widthratio: 30 }
        ]
    });

    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        var params = $("").formSerialize();
        params.ghlx = $('').attr('');
        if ($('').val() != $('').attr('')) {
            params.ghlx = '';
        }
        params.zlxm = $('').attr('');
        if ($('').val() != $('').attr('')) {
            params.zlxm = '';
        }
        params.ks = $('').attr('');
        params.ys = $('').attr('');
        if (!params.ks) {
            return false;
        }
        if (params.mjzbz == 3 && !!!params.ys) {
            $.modalAlert('', '');
            return;
        }
        $.submitForm({
            url: "" + ghpbId,
            param: params,
            success: function () {
                $.currentWindow().$("").trigger("");
            }
        })
    }

</script>
@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
    var reportUrl = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("");
    var ReportSystemCode = Newtouch.Core.Common.Utils.ConfigurationHelper.GetAppConfigValue("");
    var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}
<form name="form1" autocomplete="off">
    <div class="panel panel-default" style="">
        <ul id="myTab" class="nav nav-tabs">
            <li class="active"><a href="#ghmx" data-toggle="tab">Chi tiết đăng ký khám bệnh nhân</a></li>
            <li><a href="#ghtj" data-toggle="tab">Thống kê bác sĩ khoa</a></li>
        </ul>
        <div class="tab-content" style="margin-top:0%">
            <div style="padding: 2px;padding-right:20px;" class="tab-pane fade in active" id="ghmx">
                <table class="form">
                    <tr>
                        <th class="formTitle">Ngày đăng ký khám：</th>
                        <td class="formValue" colspan="2">
                            <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; float:left;" value="@DateTime.Now.AddDays(-3).ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                            <span style="margin-left:1%;float:left">—</span>
                            <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:43%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        </td>
                        <th class="formTitle">Khoa đăng ký khám：</th>
                        <td class="formValue">
                            <input type="text" class="form-control" id="txtksmc" />
                        </td>

                        <th class="formTitle"></th>
                        <td class="formValue" colspan="2">
                            <input type="button" class="btn btn-primary btn-md" id="btnsyy" value="Tra cứu" />
                            <input type="button" class="btn btn-primary btn-md" style="margin-left:10px;width:40px;margin-left:10px;" onclick="Excelbuttion()" value="Xuất" />
                        </td>

                    </tr>

                </table>
                <div style="margin-top:2px;">
                    <div class="gridPanel">
                        <table id="registedList"></table>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" ;style="background-color: #fff; height:100%;width:100%" id="ghtj">
                <table class="form">
                    <tr>
                        <th class="formTitle">Ngày đăng ký khám：</th>
                        <td class="formValue" colspan="2">
                            <input id="tjkssj" type="text" class="form-control input-wdatepicker" style="width:42%; float:left;" value="@DateTime.Now.AddDays(-3).ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                            <span style="margin-left:1%;float:left">—</span>
                            <input id="tjjssj" type="text" class="form-control input-wdatepicker" style="width:43%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        </td>
                        <th class="formTitle">Khoa đăng ký khám：</th>
                        <td class="formValue">
                            <input type="text" class="form-control" id="txttjksmc" />
                        </td>
                        <th class="formTitle">
                            <input type="button" class="btn btn-primary btn-md" id="btncx" onclick="bntcxClick();" value="Tra cứu" />
                        </th>
                        <td class="formValue"></td>
                        <th></th>
                        <td></td>
                    </tr>
                </table>
                <div class="ui-layout" id="layout" style="width:100%;">
                    <iframe class="ui-layout-center" style="width:100%;height:430px" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
                            scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
                </div>
            </div>
        </div>
    </div>

</form>

<script>
    $(function () {
        var h = $(window).height() - 100
        $('').css('', h);
	    gridlist();
	    bntcxClick();
		$("").click(function() {
			var $gridList = $("");
			$gridList.jqGrid('', {
				postData: postdata(),
			}).trigger('');

		});

		var kszdlist;
		$.ajax({
			type: "",
			url: "",
			dataType: "",
			async: false,
			success: function (data) {
				kszdlist = data;

			}
		});


		//Khoa
		$("").newtouchBatchFloatingSelector({
			height: 200,
			width: 300,
			clickautotrigger: true,
			//url: '',
			filter: function (keyword) {
				//Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
				var resultObjArr = new Array();
				$.each(kszdlist, function (idx, val) {
					if ((val.py && val.py.toLowerCase().indexOf(keyword) >= 0)
						|| (val.Name && val.Name.indexOf(keyword) >= 0)
						|| keyword.trim() == "") {
						resultObjArr.push(val);
					}
				});
				return resultObjArr;

			},
			caption: "",
			colModel: [
				{ label: '', name: '', widthratio: 30 },
				{ label: '', name: '', widthratio: 50 },
				{ label: '', name: '', hidden: true }
			],
			itemdbclickhandler: function ($thistr) {
				$("").attr("", $thistr.find("").html());
				$("").val($thistr.find('').html());
				return;
			},
		});
	    //Khoa
		$("").newtouchBatchFloatingSelector({
		    height: 200,
		    width: 300,
		    clickautotrigger: true,
		    //url: '',
		    filter: function (keyword) {
		        //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
		        var resultObjArr = new Array();
		        $.each(kszdlist, function (idx, val) {
		            if ((val.py && val.py.toLowerCase().indexOf(keyword) >= 0)
						|| (val.Name && val.Name.indexOf(keyword) >= 0)
						|| keyword.trim() == "") {
		                resultObjArr.push(val);
		            }
		        });
		        return resultObjArr;

		    },
		    caption: "",
		    colModel: [
				{ label: '', name: '', widthratio: 30 },
				{ label: '', name: '', widthratio: 50 },
				{ label: '', name: '', hidden: true }
		    ],
		    itemdbclickhandler: function ($thistr) {
		        $("").attr("", $thistr.find("").html());
		        $("").val($thistr.find('').html());
		        return;
		    },
		});
	});

	function postdata() {
		return {
			ksrq: $("").val(),
			jsrq: $("").val(),
			keywordo: $("").val() != "" ? $("").attr(""):"",
		};

	}
	var colModel;
	function gridlist() {

		 colModel = [
			{ label: '', name: '', key: true, hidden: true },

			{ label: '', name: '', width: 80, align: '' },
			{ label: '', name: '', width: 100, align: '' },
			{ label: '', name: '', width: 70, align: '' },
			{ label: '', name: '', width: 130, align: '' },
			{
				label: '', name: '', width: 40, align: '',
				formatter: function (val) {
					return $.getGender(val);
				}
			},
			{
				label: '', name: '', width: 50, align: '',
				formatter: function (val) {
					if (val == '') {
						return '';
					}
					else if (val == '') {
						return '';
					}
					else {
						return '';
					}
				}
			},
			{ label: '', name: '', width: 100, align: '' },
			{ label: '', name: '', hidden: true },
			{ label: '', name: '', hidden: true },
			{ label: '', name: '', width: 50, align: '' },
			{
				label: '', name: '', width: 50, align: '',
				formatter: function (val) {
					if (val == '') {
						return '';
					}
					else if (val == '') {
						return '';
					}
					else if (val == '') {
						return '';
					}
					else {
						return '';
					}
				}
			},
			{
				label: '', name: '', width: 100, align: '',
				formatter: "", formatoptions: { srcformat: '', newformat: '' }
			},
			{
				label: '', name: '', width: 60, align: '',
				formatter: function (cellvalue) {
					return $.enum.getDescByValue("", cellvalue);
				}
			},
			{ label: '', name: '', width: 100, align: '' },
			{ label: '', name: '', hidden: true },
			{ label: '', name: '', hidden: true },
			{ label: '', name: '', width: 50, align: '' },
			{
				label: '', name: '', width: 120, align: '',
				formatter: "", formatoptions: { srcformat: '', newformat: '' }
			 },
			 { label: '', name: '', width: 80, align: '' },
			 { label: '', name: '', width: 60, align: '' },
			 { label: '', name: '', width: 70, align: '' },
			 { label: '', name: '', width: 120, align: '',},
		];

		var $gridList = $("");
		$gridList.dataGrid({
			url: "",
			height: $(window).height() - 165,
			caption: "",
			postData: postdata(),
			colModel: colModel,
			gridComplete: function () {
				var ids = $gridList.getDataIDs();

				var thrc = 0;
				for (i = 0; i < ids.length; i++) {
					var rowData = $gridList.getRowData(ids[i]);
					if (rowData && rowData.syth == "") {
						thrc += 1;
					}
				}
				$("").html("" + ids.length + "");
				$("").html("" + thrc + "");
				//console.log(ids);
			},
		});

	}

	var exportCols = null;
	function Excelbuttion() {
		
		exportCols = new Array();
		var colsChooseSourceArr = new Array();
		$.each(colModel, function () {
			if (!(this.hidden === true)) {
				if (this.label != "") {
					exportCols.push({ Heading: this.label, Name: this.name, Width: this.width });
					colsChooseSourceArr.push({ Heading: this.label, Name: this.name });
				}
			}
		});
		var url = "";
		var cols = JSON.stringify(colsChooseSourceArr);
		cols = encodeURIComponent(cols);
		url += "" + cols;
		$.modalOpen({
			id: "",
			title: "",
			url: url,
			width: "",
			height: "",
			callBack: function (iframeId) {
				//Kết quả
				var restArr = top.frames[iframeId].GetChoosedCols();
				if (!!!restArr || !!!restArr.length || restArr.length == 0) {
					$.modalAlert("", '');
					return false;
				}
				var isContainFilter = top.frames[iframeId].GetIsContainFilter();
				//Đóng cửa sổ chọn
				$.modalClose("");
				//
				exportCols = $.jsonWhere(exportCols, function (v) {
					var matched = false;
					for (var iIndex = 0; iIndex < restArr.length; iIndex++) {
						if (restArr[iIndex] == v.Name) {
							matched = true;
						}
					}
					return matched;
				});
				//Xuất
				Export(isContainFilter);
			}
		});
	}

	function Export(isContainFilter) {

		var url = "" + Math.random();
		url += "" + $("").val();
		url += "" + $("").val();
		url += "" + $("").attr("");
		url += "" + $("").val();
		url += "" + isContainFilter;
		url += "" + "";  //列宽度标准列
		var cols = JSON.stringify(exportCols);
		top.$.cookie('', cols, { path: "" });
		//url += "" + encodeURIComponent(cols);

		window.open(url);
	}
	function bntcxClick() {
	    if ($('').val().length == 0 || $('').val().length == 0) {
	        $.modalAlert("", "");
	        return;
	    }
	    var url = getUrl();
	    $("").attr('', url);
	}
	function getUrl() {
	    var ksrq = $("").val()+"";
	    var jsrq = $("").val()+"";
	    var ks = $("").val() != "" ? $("").attr("") : "";
	    var srcUrl2 = '' + "" + "" + '' + "" + '' + "" + ksrq + "" + jsrq + "" + ks;
	    return srcUrl2;
	}
</script>
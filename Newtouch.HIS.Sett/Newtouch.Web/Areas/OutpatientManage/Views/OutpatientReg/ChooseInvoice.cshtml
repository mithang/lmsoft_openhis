@{
    ViewBag.Title = "";
    Layout = "";

    var from = (ViewBag.from as string) ?? "";
}

<form id="formReceipt">
    <div style="margin-top:40px;margin-right:40px;">
        <table class="form">
            <tr>
                <th class="formTitle dialogText">Số hóa đơn:</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="txtfph" name="txtfph" required value="">
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    //Cái trướcwindowĐối tượng
    var prevWindow;
    if ('' !== '') {
        prevWindow = top.top.frames[''];
    }
    else {
        prevWindow = $.currentWindow();
    }

    $.najax({
        url: "",  //Lấy
        dataType: "",
        async: false,
        success: function (data) {
            $("").val(data);
            prevWindow.$("").val(data);
            prevWindow.$("").html(data);    //text or label
        }
    });

    //Xác nhận số hóa đơn xác minh
    function checkFPH() {
        var ttheFph = $("").val();
        if (!!!ttheFph) {
            $.modalMsg('', '');
            return;
        }
        $.najax({
            url: "",
            data: { inputFPH: ttheFph },
            type: "",
            dataType: "",
            async: false,
            success: function (data) {
                if (data.state === "") {
                    prevWindow.$("").val(ttheFph);
                    prevWindow.$("").html(ttheFph);
                    if (prevWindow.chooseFPHSuccessCallback) {
                        prevWindow.chooseFPHSuccessCallback(ttheFph);
                    }
                    $.modalClose();
                }
                else {
                    prevWindow.$("").val("");
                    prevWindow.$("").html("");
                    $.newtouchAlert(data);
                }
            },
            error: function (data) {
                $.modalMsg(data.message, data.state);
            }
        });
    }

</script>

    //Thông tin cơ bản trả về tìm kiếm số bệnh án theo
    function GetQueryFphAjax(obj, funcSuccCallback) {

        //Xóa trống
        newtouch_event_yygh();
        newtouch_event_f4();
        $.najax({
            url: "",
            data: obj,
            dataType: "",
            async: false,
            success: function (rep) {
                if (rep.data && !!!rep.data.brxz) {
                    $.modalAlert("", '');
                    return false;
                }
                if (rep.data && !!!rep.data.CardTypeName) {
                    $.modalAlert("", '');
                    return false;
                }
                patModel = rep.data;
                $("").html($.getGender(patModel.xb));
                $("").html(patModel.zjh);
                $("").html(patModel.cblb);
                $("").html(patModel.xzlx);
                $("").html(patModel.grbh);
                $("").html(patModel.ecToken);
                $("").html(patModel.cbdbm);
                var rylbmc=$.enum.getDescByValue("",patModel.cblb);
                $("").html(rylbmc);
                $("").html(patModel.xm);
                $("").val(patModel.phone);
                $("").html(getAgeFromBirthTime({ begin: patModel.csny.replace('','') }).text);
                $("").val(patModel.blh);
                $("").html('' + patModel.CardTypeName + '');
                $("").html(patModel.kh);
                $("").val(patModel.patid);
                $("").val(patModel.zjlx); 
                if (!!patModel.brxz && patModel.brxzmc) {
                    $("").attr("", patModel.brxzmc)
                        .attr("", patModel.brxz).attr("", patModel.brxzlb);
                    $("").val(patModel.brxzmc);
                }
                else {
                    $("").attr("", '').attr("", '');
                    $("").val('');
                }
                if (patModel.fzbz === 0) {
                    $("").html("");
                }
                else {
                    $("").html("");

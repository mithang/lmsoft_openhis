
@{
    ViewBag.Title = "";
    Layout = "";
}
<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a id="NF-add" class="btn btn-primary dropdown-text" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a id="NF-edit" class="btn btn-primary dropdown-text" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a id="NF-delete" class="btn btn-primary dropdown-text" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa</a>
        </div>
        <div class="btn-group">
            <a id="NF-Details" class="btn btn-primary dropdown-text" onclick="btn_details()"><i class="fa fa-search-plus"></i>Xem</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Số bệnh án" style="width: 200px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>
<script>
    $(function () {
        //Tải lại khi thay đổi kích thước cửa sổ trình duyệtjqGridchiều rộng của
        $(window).resize(function () {
            initLayout("");
        });
        gridList();

        $("").keyupEnterEvent(function () {
            $("").trigger("");
        });
    });

    //Chi tiết
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            postData: getSearchPostData(),
            height: $(window).height() - 130,
            colModel: [
                { label: "", name: "", width: 100, align: "", hidden: true },
                { label: "", name: "", width: 90, align: "" },
                { label: "", name: "", width: 80, align: "" },
                {
                    label: "", name: "", width: 80, align: "", formatter: function (cellvalue, a, b) {
                        return getAgeFromBirthTime({ begin: b.csny }).text;
                    }
                },
                { label: "", name: "", width: 130, align: "" },
                { label: "", name: "", width: 130, align: "" },
                { label: "", name: "", width: 130, align: "", hidden: true },
                { label: "", name: "", width: 100, align: "", hidden: true },
                {
                    label: "",
                    name: "",
                    width: 100,
                    align: "",
                    formatter: "",
                    formatoptions: { srcformat: '', newformat: '' }
                },
                {
                    label: "",
                    name: "",
                    width: 100,
                    align: "",
                    formatter: "",
                    formatoptions: { srcformat: '', newformat: '' }
                },
                { label: "", name: "", width: 100, align: "" },
                { label: "", name: "", width: 100, align: "" }
            ],
            pager: "",
            sortname: '',
            viewrecords: true
        });
        $("").click(function () {
            $gridList.jqGrid('',
                {
                    postData: getSearchPostData(),
                    page: 1,
                    url: ""
                }).trigger('');
        });
    }

    //Điều kiện tra cứu
    function getSearchPostData() {
        var keyword = $("").val();
        return { keyword: keyword };
    };

    //Tạo mới
    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    //Sửa
    function btn_edit() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var sbbabId = $("").jqGridRowValue().sbbabId;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + sbbabId,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    //Xóa
    function btn_delete() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var sbbabId = $("").jqGridRowValue().sbbabId;
        $.deleteForm({
            url: "",
            param: { sbbabId: sbbabId },
            success: function () {
                $("").trigger("");
            }
        });
    }

    //Chi tiết
    function btn_details() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var count = $("").getGridParam("");
        if (count === 0) {
            $.modalAlert("", '');
            return;
        }
        var sbbabId = $("").jqGridRowValue().sbbabId;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + sbbabId,
            width: "",
            height: "",
            btn: null
        });
    }

</script>

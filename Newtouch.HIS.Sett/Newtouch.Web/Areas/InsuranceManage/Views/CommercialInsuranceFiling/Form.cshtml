@using Newtouch.Common.Operator;
@{
    ViewBag.Title = "";
    Layout = "";
}
<form id="form1">
    <div class="container" style="margin-top: 10px; margin-left: -4%; ">
        <ul class="nav nav-tabs" role="tablist" id="myTab" style="margin-left: 4%;">
            <li role="presentation"><a role="tab" data-toggle="tab">Thông tin cơ bản</a></li>
        </ul>
        <div class="tab-content">
            <div role="tabpanel" id="divPatInfo" class="tab-pane fade in active" style="padding-top: 20px; margin-right: 30px;">
                <table class="form">
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Số bệnh án：</th>
                        <td class="formValue">
                            <input type="text" class="form-control" style="width:56%; float:left" id="blh" required />
                            &nbsp;&nbsp;<input type="button" class="btn btn-default btn-md btn-default-color" title="Chọn bệnh nhân nhập viện" style="width: 25px;" id="btnsyy" value="Tra cứu" onclick="GetPatSerarchView($('#blh').val());">
                        </td>
                        <th class="formTitle">保险公司：</th>
                        <td class="formValue">
                            <input id="bxName" class="form-control" type="text">
                        </td>

                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Mã nội bộ bệnh nhân：</th>
                        <td class="formValue">
                            <input type="text" class="form-control newtouch_Readonly" id="patId" required />
                        </td>
                        <th class="formTitle">Họ tên：</th>
                        <td class="formValue">
                            <input type="text" class="form-control newtouch_Readonly" id="xm" required />
                        </td>

                    </tr>
                    <tr>
                        <th class="formTitle">Tuổi：</th>
                        <td class="formValue">
                            <input type="text" class="form-control newtouch_Readonly" id="nlshow" required />
                        </td>
                        <th class="formTitle">Hiệu lực</th>
                        <td class="formValue">
                            <div class="ckbox">
                                <input id="zt" type="checkbox" checked="checked"><label for="zt"></label>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        >
                        <th class="formTitle"><span class="required">*</span>Ngày bắt đầu：</th>
                        <td class="formValue">
                            <input id="ksrq" type="text" class="form-control input-wdatepicker" value="" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" required />
                        </td>
                        <th class="formTitle"><span class="required">*</span>Ngày kết thúc：</th>
                        <td class="formValue">
                            <input id="jsrq" type="text" class="form-control input-wdatepicker" value="" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" required />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Tổng số lần：</th>
                        <td class="formValue">
                            <input type="text" class="form-control" id="zcs" required />
                        </td>
                        <th class="formTitle"><span class="required">*</span>Số lần còn lại：</th>
                        <td class="formValue">
                            <input type="text" class="form-control newtouch_Readonly" id="sycs" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Người lập hồ sơ：</th>
                        <td class="formValue">
                            <input class="form-control newtouch_Readonly" id="CreatorCode" value=@OperatorProvider.GetCurrent().UserCode type="text" required />
                        </td>
                        <th class="formTitle"><span class="required">*</span>Ngày lập hồ sơ：</th>
                        <td class="formValue">
                            <input class="form-control newtouch_Readonly" id="CreateTime" value=@DateTime.Now.ToString("yyyy-MM-dd") type="text" required />
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</form>
<script>
    var sbbabId = $.request("");
    $(function () {
        if (!!sbbabId) {
            $.ajax({
                url: "" + Math.random(),
                data: { sbbabId: sbbabId },
                dataType: "",
                async: false,
                success: function (data) {
                    $("").formSerialize(data);
                    if (data[""]) {
                        $("").attr("", data[""]);
                    }
                    $("").val((data.ksrq && data.ksrq.length >= 10 ? data.ksrq.substring(0, 10) : ""));
                    $("").val((data.jsrq && data.jsrq.length >= 10 ? data.jsrq.substring(0, 10) : ""));
                }
            });
            $("").removeAttr("").css("", "");
        }

    });

    //Tra cứu bệnh nhân ngoại trú
    function GetPatSerarchView(blh) {
        if (!!!blh) {
            blh = '';
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + Math.random() + "" + blh,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
            }//Hàm callback xác nhận khi nhấn cửa sổ
        });
    }

    //Bệnh nhân đã chọn
    function GetQueryFphAjax(selePatInfo) {
        $('').val(selePatInfo.blh);
        $("").val(selePatInfo.patid);
        $("").val(selePatInfo.xm);
        $("").val(selePatInfo.nlshow);
        // ajaxLoadDataResult();
    }

    ///Chính sách hoàn trả
    $("").newtouchFloatingSelector({
        height: 200,
        width: 300,
        filter: function (keyword) {
            if (!keyword) {
                return null;
            }
            //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
            var resultObjArr = new Array();
            $.each(top.window.clients.commercialInsuranceList, function (idx, val) {
                if ((val.bxCode && val.bxCode.toLowerCase().indexOf(keyword.toLowerCase()) >= 0) || keyword.trim() === "") {
                    resultObjArr.push(val);
                }
            });
            return resultObjArr;

        },
        caption: "",
        colModel: [
            {
                label: '', name: '', widthratio: 25
            },
            {
                label: '', name: '', widthratio: 25
            },
            { label: '', name: '', widthratio: 25 }
        ],
        itemdbclickhandler: function ($thistr) {
            $("").attr("", $thistr.find("").html());
            $("").val($thistr.find('').html());
            return;
        }
    });

    $("").bind("", function (e) {
        if ((e.keyCode === 13 && e.type === "") || e.type === "" || e.type === "") {
            $('').val($('').val());
        }
    });
    //Gửi
    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        var params = $("").formSerialize();
        params[""] = $("").attr("");
        $.submitForm({
            url: "" + sbbabId,
            param: params,
            success: function () {
                $.currentWindow().$("").trigger("");
            }
        });
    }

</script>

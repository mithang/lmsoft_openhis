
@{
    ViewBag.Title = "";
    Layout = "";
}
<form id="form1">
    <div class="topPanel">
        <div class="toolbar">
            <div class="btn-group">
                <a id="NF-add" class="btn btn-primary dropdown-text" onclick="AddCommercialInsurance()"><i class="fa fa-plus"></i>Tạo mới</a>
            </div>
            <div class="btn-group">
                <a id="NF-edit" class="btn btn-primary dropdown-text" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
            </div>
            <div class="btn-group">
                <a id="NF-delete" class="btn btn-primary dropdown-text" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa</a>
            </div>
            <div class="btn-group">
                <a id="NF-Details" class="btn btn-primary dropdown-text" onclick="btn_details()"><i class="fa fa-search-plus"></i>Xem</a>
            </div>
        </div>
        <div class="search">
            <table>
                <tr>
                    <td>
                        <div class="input-group">
                            <input id="txt_keyword" type="text" class="form-control" placeholder="Vui lòng nhập từ khóa cần tra cứu(Số bệnh án)" style="width: 200px;">
                            <span class="input-group-btn">
                                <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                            </span>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div style="margin-top: 10px;">
        <table id="gridCInsuranceList"></table>
    </div>
    <div class="gridPanel">
        <table id="gridCInsuranceList"></table>
        <div id="gridPager" rel="form1"></div>
    </div>
</form>
<script>
    $(function () {
        //Tải lại khi thay đổi kích thước cửa sổ trình duyệtjqGridchiều rộng của
        $(window).resize(function () {
            initLayout("");
        });
        gridCInsuranceList();
    });
    function gridCInsuranceList() {
        var $gridCInsuranceList = $("");
        $gridCInsuranceList.dataGrid({
            height: $(window).height() - 130,
            url: "",
            colModel: [
                { label: '', name: '', hidden: true, key: true },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 120, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 120, align: '' },
                 { label: '', name: '', width: 120, align: '' },
                { label: '', name: '', width: 120, align: '' }
            ],
            multiselect: false,
            pager: "",
            sortname: '',
            viewrecords: true
        });
        $("").click(function () {
            $gridCInsuranceList.jqGrid('',
                {
                    postData: { code: $("").val(), engName: $("").val() },
                    page: 1,
                    url: ""
                }).trigger('');
        });
    }

    function AddCommercialInsurance() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();

            }
        });
    }

    function btn_edit() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", "");
            return;
        }
        var keyValue = $("").jqGridRowValue().Id;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_delete() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", "");
            return;
        }
        $.deleteForm({
            url: "",
            param: { keyValue: $("").jqGridRowValue().Id },
            success: function () {
                $.currentWindow().$("").resetSelection();
                $.currentWindow().$("").trigger("");
            }
        });
    }
    function btn_details() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", "");
            return;
        }
        var keyValue = $("").jqGridRowValue().Id;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            btn: null
        });
    }
</script>

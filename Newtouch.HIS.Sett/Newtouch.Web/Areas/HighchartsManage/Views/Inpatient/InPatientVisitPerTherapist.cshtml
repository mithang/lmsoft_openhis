                        <input type="radio" name="datatype" id="datatype" checked="checked" class="toggle" value="total">Tổng chi phí
                    </label>
                    <label class="btn btn-default">
                        <input type="radio" name="datatype" id="datatype" value="avg" class="toggle">Chi phí bình quân
                    </label>
                </div>
            </td>
            <td class="formValue"></td>
            <td class="formValue"></td>

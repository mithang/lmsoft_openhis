<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>仪表盘1</title>
    <link href="~/Content/css/framework-theme.css" rel="stylesheet" />
    <script src=""></script>
    <script src=""></script>
    <script>
        $(function () {
            $('').highcharts({

                chart: {
                    type: '',
                    plotBackgroundColor: null,
                    plotBackgroundImage: null,
                    plotBorderWidth: 0,
                    plotShadow: false
                },

                title: {
                    text: ''
                },

                pane: {
                    startAngle: -150,
                    endAngle: 150,
                    background: [{
                        backgroundColor: {
                            linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 },
                            stops: [
                                [0, ''],
                                [1, '']
                            ]
                        },
                        borderWidth: 0,
                        outerRadius: ''
                    }, {
                        backgroundColor: {
                            linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 },
                            stops: [
                                [0, ''],
                                [1, '']
                            ]
                        },
                        borderWidth: 1,
                        outerRadius: ''
                    }, {
                        // default background
                    }, {
                        backgroundColor: '',
                        borderWidth: 0,
                        outerRadius: '',
                        innerRadius: ''
                    }]
                },

                // the value axis
                yAxis: {
                    min: 0,
                    max: 200,

                    minorTickInterval: '',
                    minorTickWidth: 1,
                    minorTickLength: 10,
                    minorTickPosition: '',
                    minorTickColor: '',

                    tickPixelInterval: 30,
                    tickWidth: 2,
                    tickPosition: '',
                    tickLength: 10,
                    tickColor: '',
                    labels: {
                        step: 2,
                        rotation: ''
                    },
                    title: {
                        text: ''
                    },
                    plotBands: [{
                        from: 0,
                        to: 120,
                        color: '' // green
                    }, {
                        from: 120,
                        to: 160,
                        color: '' // yellow
                    }, {
                        from: 160,
                        to: 200,
                        color: '' // red
                    }]
                },

                series: [{
                    name: '',
                    data: [80],
                    tooltip: {
                        valueSuffix: ''
                    }
                }]

            },
         // Add some life
         function (chart) {
             if (!chart.renderer.forExport) {
                 setInterval(function () {
                     var point = chart.series[0].points[0],
                         newVal,
                         inc = Math.round((Math.random() - 0.5) * 20);

                     newVal = point.y + inc;
                     if (newVal < 0 || newVal > 200) {
                         newVal = point.y - inc;
                     }

                     point.update(newVal);

                 }, 3000);
             }
         });
        });
    </script>
</head>
<body>
    <div id="container" style="min-width: 310px; height: 400px; margin: 0 auto"></div>
</body>
</html>

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>流程图</title>
    <link href="~/Content/css/framework-theme.css" rel="stylesheet" />
    <script src=""></script>
    <script src=""></script>
    <script>
        $(function () {
            var chart = new Highcharts.Chart({
                chart: {
                    renderTo: '',
                    events: {
                        load: function () {

                            // Draw the flow chart
                            var ren = this.renderer,
                                colors = Highcharts.getOptions().colors,
                                rightArrow = ['', 0, 0, '', 100, 0, '', 95, 5, '', 100, 0, '', 95, -5],
                                leftArrow = ['', 100, 0, '', 0, 0, '', 5, 5, '', 0, 0, '', 5, -5];



                            // Separator, client from service
                            ren.path(['', 120, 40, '', 120, 330])
                                .attr({
                                    '': 2,
                                    stroke: '',
                                    dashstyle: ''
                                })
                                .add();

                            // Separator, CLI from service
                            ren.path(['', 420, 40, '', 420, 330])
                                .attr({
                                    '': 2,
                                    stroke: '',
                                    dashstyle: ''
                                })
                                .add();

                            // Headers
                            ren.label('', 20, 40)
                                .css({
                                    fontWeight: ''
                                })
                                .add();
                            ren.label('', 220, 40)
                                .css({
                                    fontWeight: ''
                                })
                                .add();
                            ren.label('', 440, 40)
                                .css({
                                    fontWeight: ''
                                })
                                .add();

                            // SaaS client label
                            ren.label('', 0, 90)
                                .attr({
                                    fill: colors[0],
                                    stroke: '',
                                    '': 2,
                                    padding: 5,
                                    r: 5
                                })
                                .css({
                                    color: ''
                                })
                                .add()
                                .shadow(true);

                            // Arrow from SaaS client to Phantom JS
                            ren.path(rightArrow)
                                 .attr({
                                     '': 2,
                                     stroke: colors[3]
                                 })
                                .translate(95, 95)
                                .add();

                            ren.label('', 90, 75)
                                .css({
                                    color: colors[3]
                                })
                                .add();

                            ren.label('', 210, 82)
                                .attr({
                                    stroke: '',
                                    '': 2,
                                    padding: 5,
                                    r: 5,
                                    width: 100,
                                    fill: colors[1]
                                })
                                .css({
                                    color: ''
                                })
                                .add()
                                .shadow(true);

                            // Arrow from Phantom JS to Batik
                            ren.path(['', 250, 110, '', 250, 185, '', 245, 180, '', 250, 185, '', 255, 180])
                                 .attr({
                                     '': 2,
                                     stroke: colors[3]
                                 })
                                 .add();

                            ren.label('', 255, 120)
                                .css({
                                    color: colors[3]
                                })
                                .add();

                            ren.label('', 210, 200)
                                .attr({
                                    stroke: '',
                                    '': 2,
                                    padding: 5,
                                    r: 5,
                                    width: 100,
                                    fill: colors[1]
                                })
                                .css({
                                    color: ''
                                })
                                .add()
                                .shadow(true);

                            // Arrow from Batik to SaaS client
                            ren.path(['', 235, 185, '', 235, 155, '', 235, 130, 235, 130, 215, 130,
                                      '', 95, 130, '', 100, 125, '', 95, 130, '', 100, 135])
                                 .attr({
                                     '': 2,
                                     stroke: colors[3]
                                 })
                                 .add();

                            ren.label('', 100, 110)
                                .css({
                                    color: colors[3]
                                })
                                .add();

                            // Browser label
                            ren.label('', 30, 200)
                                .attr({
                                    fill: colors[0],
                                    stroke: '',
                                    '': 2,
                                    padding: 5,
                                    r: 5
                                })
                                .css({
                                    color: '',
                                    width: ''
                                })
                                .add()
                                .shadow(true);



                            // Arrow from Browser to Batik
                            ren.path(rightArrow)
                                 .attr({
                                     '': 2,
                                     stroke: colors[1]
                                 })
                                .translate(95, 205)
                                 .add();

                            ren.label('', 110, 185)
                                .css({
                                    color: colors[1]
                                })
                                .add();

                            // Arrow from Batik to Browser
                            ren.path(leftArrow)
                                 .attr({
                                     '': 2,
                                     stroke: colors[1]
                                 })
                                .translate(95, 215)
                                 .add();

                            ren.label('', 100, 215)
                                .css({
                                    color: colors[1]
                                })
                                .add();

                            // Script label
                            ren.label('', 450, 82)
                                .attr({
                                    fill: colors[2],
                                    stroke: '',
                                    '': 2,
                                    padding: 5,
                                    r: 5
                                })
                                .css({
                                    color: '',
                                    width: ''
                                })
                                .add()
                                .shadow(true);

                            // Arrow from Script to PhantomJS
                            ren.path(leftArrow)
                                 .attr({
                                     '': 2,
                                     stroke: colors[2]
                                 })
                                .translate(330, 90)
                                 .add();

                            ren.label('', 340, 70)
                                .css({
                                    color: colors[2]
                                })
                                .add();

                            // Arrow from PhantomJS to Script
                            ren.path(rightArrow)
                                 .attr({
                                     '': 2,
                                     stroke: colors[2]
                                 })
                                .translate(330, 100)
                                 .add();

                            ren.label('', 330, 100)
                                .css({
                                    color: colors[2]
                                })
                                .add();


                        }
                    }
                },
                title: {
                    text: ''
                }

            });
        });
    </script>
</head>
<body>
    <div id="container" style="width: 600px; height: 250px; margin: 0 auto"></div>
</body>
</html>

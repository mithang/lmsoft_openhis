
@{
    ViewBag.Title = "";
    Layout = "";
}
<script src=""~/js/highcharts/highcharts.js""></script>
<script src=""~/js/highcharts/modules/exporting.js""></script>
<script>
    $(function () {
        GetOutpatientVisitNum();
        GetOutpatientVisitPerNum();
    });

    function GetOutpatientVisitNum() {
        var OutpatientList = [];
        //Biểu đồ đường gấp Lấy số người khám
        $.ajax({
            url: "" + Math.random(),
            dataType: "",
            async: false,
            success: function (data) {
                if (data.data) {
                    OutpatientList = data.data;
                } else {
                    for (var i = 0; i < 12; i++) {
                        OutpatientList.push([0]);
                    }
                }
            }
        });
        $('').highcharts({
            chart: {
                zoomType: ''
            },
            title: {
                text: '',
            },
            xAxis: {
                categories: ['', '', '', '', '', '', '', '', '', '', '', '']
            },
            yAxis: {
                min: 0,
                title: {
                    text: ''
                },
                plotLines: [{
                    value: 0,
                    width: 1,
                    color: ''
                }]
            },
            tooltip: {
                valueSuffix: '',
                headerFormat: "",
                pointFormat: '',
                footerFormat: '',
            },
            series: [{
                showInLegend: false,
                name: "",
                data: [
                        OutpatientList[0].num, OutpatientList[1].num, OutpatientList[2].num, OutpatientList[3].num, OutpatientList[4].num, OutpatientList[5].num, OutpatientList[6].num, OutpatientList[7].num, OutpatientList[8].num, OutpatientList[9].num, OutpatientList[10].num, OutpatientList[11].num
                ]
            }]
        });
    }

    function GetOutpatientVisitPerNum() {
        var OutpatientList = [];
        //Biểu đồ đường gấp Lấy lần người khám bệnh
        $.ajax({
            url: "" + Math.random(),
            dataType: "",
            async: false,
            success: function (data) {
                if (data.data) {
                    OutpatientList = data.data;
                } else {
                    for (var i = 0; i < 12; i++) {
                        OutpatientList.push([0]);
                    }
                }
            }
        });
        $('').highcharts({
            chart: {
                zoomType: ''
            },
            title: {
                text: '',
            },
            xAxis: {
                categories: ['', '', '', '', '', '', '', '', '', '', '', '']
            },
            yAxis: {
                min: 0,
                title: {
                    text: ''
                },
                plotLines: [{
                    value: 0,
                    width: 1,
                    color: ''
                }]
            },
            tooltip: {
                valueSuffix: '',
                headerFormat: "",
                pointFormat: '',
                footerFormat: '',
            },
            series: [{
                showInLegend: false,
                name: "",
                data: [
                        OutpatientList[0].num, OutpatientList[1].num, OutpatientList[2].num, OutpatientList[3].num, OutpatientList[4].num, OutpatientList[5].num, OutpatientList[6].num, OutpatientList[7].num, OutpatientList[8].num, OutpatientList[9].num, OutpatientList[10].num, OutpatientList[11].num
                ]
            }]
        });
    }
</script>
<div class="rows" style="margin-bottom: 1%; overflow: hidden;">
    <div style="float: left; width: 49%;">
        <div style="height: 350px;border: 1px solid #e6e6e6; background-color: #fff;">
            <div class="panel panel-default">
                <div class="panel-body" style="padding-bottom: 0px;">
                    <div id="salarychart" style="height: 285px; width: 100%; padding-right: 10px;"></div>
                </div>
            </div>
        </div>
    </div>
    <div style="float: right; width: 49%;">
        <div style="height: 350px; border: 1px solid #e6e6e6; background-color: #fff;">
            <div class="panel panel-default">
                <div class="panel-body" style="padding-bottom: 0px;">
                    <div id="PerNumchart" style="height: 285px; width: 108%; padding-right: 10px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
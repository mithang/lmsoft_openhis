    function GetDate() {
        var nowdays = new Date();
        var year = nowdays.getFullYear();
        var month = nowdays.getMonth();
        if (month == 0) {
            month = 12;
            year = year - 1;
        }
        if (month < 10) {
            month = "" + month;
        }
        var firstDay = year + "" + month + "" + "" + "";//ngày một thứ của tháng cái trên

        $("").val(firstDay);

        var myDate = new Date(year, month, 0);
        var lastDay = year + "" + month + "" + myDate.getDate() + "";//ngày một cuối cùng của tháng cái trên
        $("").val(lastDay);
    }
</script>

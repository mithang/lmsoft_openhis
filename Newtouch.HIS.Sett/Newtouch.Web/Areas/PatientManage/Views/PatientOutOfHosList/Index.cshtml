
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script src="~/Content/js/CreateControl.js" type="text/javascript"></script>
<style>
    td, th {
        padding: 13px;
    }
</style>
<script type="text/javascript">
    $(function () {
        debugger;
        var Report = ReportViewer.Report;
        // Report.LoadFromURL("../../../../ReportTemplate/Danh sách bệnh nhân xuất viện.grf");
        GetDate();
    }
        );

    function GetDate() {
        var nowdays = new Date();
        var year = nowdays.getFullYear();
        var month = nowdays.getMonth();
        if (month == 0) {
            month = 12;
            year = year - 1;
        }
        if (month < 10) {
            month = "0" + month;
        }
        var firstDay = year + "-" + month + "-" + "01" + " 00:00:00";//Ngày đầu tiên của tháng trước

        $("#ryrq").val(firstDay);

        var myDate = new Date(year, month, 0);
        var lastDay = year + "-" + month + "-" + myDate.getDate() + " 23:59:59";//Ngày cuối cùng của tháng trước
        $("#cyrq").val(lastDay);
    }
</script>
<form id="form1" class="form">
    <table style="width:95%">
        <tr>
            <td>Ngày nhập viện:</td>
            <td class="formValue">
                <input id="ryrq" type="text" class="form-control input-wdatepicker" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
            </td>
            <td class="formValue"><input id="cyrq" type="text" class="form-control input-wdatepicker" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" /></td>
            <td>Cột sắp xếp:</td>
            <td class="formValue">
                <select id="px" class="form-control">
                    <option value="">==Vui lòng chọn==</option>
                    <option value="0">Ngày xuất viện</option>
                    <option value="1">Số nhập viện</option>
                    <option value="2">Loại bệnh nhân</option>
                    <option value="3">Họ tên</option>
                    <option value="4">Ngày sinh</option>
                </select>
            </td>
            <td class="formValue">
                <select id="sj" class="form-control">
                    <option value="">==Vui lòng chọn==</option>
                    <option value="0">Tăng dần</option>
                    <option value="1">Giảm dần</option>
                </select>
            </td>
        </tr>
    </table>
</form>

@using Newtouch.Infrastructure;
@{
    Layout = "";
    var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}

<style>
    .formTitle span {
        color: red;
    }
    
</style>

<form id="form1">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Thông tin cơ bản
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade in active" id="basicInfo">
                <input type="hidden" id="py" name="py" />
                <input type="hidden" id="patid" name="patid" />
                <input type="hidden" id="brxz" name="brxz">
                <div id="divJbjyFee" class="tab-pane fade in active">
                    <table class="form" style="width: 98%; border: 0">
                        <tr>
                            <td class="formTitle">
                                <span>*</span>Số thẻ
                            </td>
                            <td class="formValue">
                                <input type="text" id="kh" class="form-control form-an">
                                
                            </td>
                            <td class="formValue" colspan="2">
                                @Html.Partial("")
                            </td>
                            <td class="formTitle"><span>*</span>Loại thẻ</td>
                            <td class="formValue">
                                @Html.DropDownList("", EnumCardType.XNK.ToDescSelectList(), new { @class = "", onchange = "" })
                            </td>
                        </tr>
                        <tr>
                            <td class="formTitle"><span>*</span>Họ tên bệnh nhân</td>
                            <td class="formValue">
                                <input type="text" id="xm" name="xm" class="form-control form-an">
                            </td>
                            <td class="formTitle"><span>*</span>Tính chất bệnh nhân</td>
                            <td class="formValue">
                                <input type="text" id="brxzmc" name="brxzmc" class="form-control form-an">
                            </td>
                            <td class="formTitle">参保类别编码</td>
                            <td class="formValue"><input type="text" id="cblb" class="form-control form-an" /></td>
                        
                        </tr>
                        <tr>
                            <td class="formTitle">参保类别</td>
                            <td class="formValue">
                                @*@Html.DropDownList("", EnumCblb.none.ToDescSelectList(), new { @class = "" })*@
                                <input type="text" id="cblbmc" name="cblbmc" class="form-control form-an">
                            </td>
                            <td class="formTitle"><span></span>参保地编码</td>
                            <td class="formValue">
                                <input type="text" id="cbdbm" name="cbdbm" class="form-control form-an">
                            </td>
                            <td class="formTitle"><span></span>Loại hình bảo hiểm</td>
                            <td class="formValue">
                                <input type="text" id="xzlx" name="xzlx" class="form-control form-an">
                            </td>
                            
                        </tr>
                        <tr>
                            <td class="formTitle">Mã cá nhân</td>
                            <td class="formValue">
                                <input type="text" id="grbh" name="grbh" class="form-control form-an">
                            </td>
                            <td class="formTitle">异地</td>
                            <td class="formValue">
                                @Html.DropDownList("", EnumYd.f.ToDescSelectList(), new { @class = "", onchange = "" })
                            </td>
                            <td class="formValue" colspan="2">
                                <input type="button" id="btn_tianjia" style="float:right;width:60px;" onclick="SubmitCard()" class="btn btn-md btn-primary form-an" value="Thêm" />
                            </td>

                        </tr>

                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="panel-heading navb-bg">
        就诊卡列表
    </div>
    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>



<script>
    var khpz = "";
    var khvalue = "";
    $("").show();
    $("").css('', '');
    $("").css('', "");
    $("").css('', "");
    $(function () {
        $("").attr("", "").css("", "");
        $("").attr("", "").css("", "");
        var patId = $.request("");
        var xms = $.request("");
        $("").val(xms);
        $("").val(patId);
        if (khpz == "") {
            $.ajax({
                url: "",
                data: { khsc: true, blhsc: true },
                dataType: "",
                async: false,
                cache: false,
                success: function (data) {
                    $('').val(data.kh);
                    khvalue = data.kh;
                }
            });
        }
        GetCardInfos(patId);

    })

    function TypeFunc(values) {
        if (values == "") {
            $("").val(khvalue);
            $("").attr("", "").css("", "");
        }
        else {
            $('').attr("", false).css("", "");
            $("").val("");
        }
    }

    function GetCardInfos(patIds) {
        $("").dataGrid(
            {
                url: "",
                postData: { patId: patIds },
                colModel: [
                    { label: '', name: '', width: 100, align: '', hidden: true },
                    { label: '', name: '', width: 100, align: '', hidden: true },
                    { label: '', name: '', width: 100, align: '' },
                    {
                        label: '', name: '', width: 100, align: '', formatter: function (cellvalue) {
                            return $.enum.getDescByValue("", cellvalue);
                        }
                    },
                    {
                        label: '', name: '', width: 100, align: '', formatter: function (cellvalue) {
                            return $.enum.getDescByValue("", cellvalue);
                        }
                    },
                    {
                        label: '', name: '', width: 100, align: '', formatter: function (cellvalue) {
                            return $.enum.getDescByValue("", cellvalue);
                        }
                    },
                    {
                        label: "", name: "", width: 160, align: '', formatter(val, option, row) {
                            return "" + option.rowId + "";

                        }
                    }
                ],
                viewrecords: false,
                width: "",
                autowidth: true,
                height: $(window).height() - 235,
            });
    }


    function SubmitCard() {
        var checkss = checkNotNulls();
        if (checkss) {
            var data = $("").formSerialize();
            $.ajax({
                url: "",
                dataType: "",
                async: false,
                data: { "": data },
                type: "",
                success: function (req) {
                    if (req.message == "") {
                        $("").jqGrid('', {
                            postData: { patId: data.patid },
                        }).trigger('');
                        if (khpz == "") {
                            $.ajax({
                                url: "",
                                data: { khsc: true, blhsc: true },
                                dataType: "",
                                async: false,
                                cache: false,
                                success: function (data) {
                                    $("").prop("", true);
                                    $("").attr("", "").css("", "");
                                    $('').val(data.kh);
                                    khvalue = data.kh;
                                }
                            });
                        }
                        $.modalAlert("", '');
                    }
                    else {
                        $.modalAlert("", '');
                    }

                },
                error: function () {
                }
            });
        }


    }

    function CardVoidss(rowid) {
        var rowdata = $('').jqGrid('', rowid);
        $.modalConfirm("", function (flag) {
            if (flag) {
                $.ajax({
                    url: "",
                    dataType: "",
                    async: false,
                    data: { "": rowdata.CardId },
                    type: "",
                    success: function (req) {
                        if (req.message == "") {
                            $("").jqGrid('', {
                                postData: { patId: rowdata.patId },
                            }).trigger('');
                            $.modalAlert("", '');
                        }

                    },
                    error: function () {
                    }
                });
            }
        });


    }


    function checkNotNulls() {
        //Họ tên
        var xm = $("").val();
        if (!xm) {
            $.modalAlert("", '');
            return false;
        }

        //Tính chất bệnh nhân
        var brxzmc = $("").val();
        if (!brxzmc) {
            $.modalAlert("", '');
            return false;
        }

        //Số thẻ
        var khs = $("").val();
        if (!khs) {
            $.modalAlert("", '');
            return false;
        }
        return true;
    }

    $("").newtouchBatchFloatingSelector({
        height: 200,
        width: 300,
        clickautotrigger: true,
        filter: function (keyword) {
            
            //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
            var resultObjArr = new Array();
            $.each(top.window.clients.sysPatientNatureList, function (idx, val) {
                if ((val.py && val.py.toLowerCase().indexOf(keyword.toLowerCase()) >= 0) ||
                    keyword.trim() == "" ||
                    (val.brxzmc && val.brxzmc.toLowerCase().indexOf(keyword) >= 0)) {
                    resultObjArr.push(val);
                }
            });
            return resultObjArr;

        },
        caption: "",
        colModel: [
            { label: '', name: '', widthratio: 25 },
            { label: '', name: '', widthratio: 25 },
            { label: '', name: '', widthratio: 25 }
        ],
        itemdbclickhandler: function ($thistr) {
            if ($thistr.attr('') === "") {
                //Đánh giá có đọc thẻ cần không
                if ($("").val() === "" || $("").val() === "") {
                    $.modalAlert("", '');
                    return;
                }
            }
            $("").val($thistr.attr(''));
            $("").val($thistr.attr(''));
            return;
        }
    });

    ////医保业务
    function ReadCardCall(readCardObj) {
        $.loading(false);
        
        if (!!readCardObj.cardInfo2.psn_type) {
            var ybklx = $('').val();
            //$('').val(ybkCardType);
            $('').val(readCardObj.yibaoCardInfo.kh);
            var rylbmc = $.enum.getDescByValue("", readCardObj.cardInfo2.psn_type);
            $("").val(rylbmc);
            $("").val(readCardObj.cardInfo2.psn_type);
            $("").val(readCardObj.cardInfo2.insutype);
            $("").val(readCardObj.cardInfo1.psn_no);
            $("").val(readCardObj.cardInfo2.insuplc_admdvs);
            var ybPatInfo2 = readCardObj.yibaoCardInfo.output.insuinfo[0];//Thông tin tham gia bảo hiểm
            if (!!ybPatInfo2.insuplc_admdvs && ybPatInfo2.insuplc_admdvs.substring(0, 2) == "") {
                $('').val("");
            } else {
                $('').val("");
            }
            $("").val(@((int)EnumCardType.YBJYK));
            var resultObjArr = new Array();
            $.each(top.window.clients.sysPatientNatureList, function (idx, val) {
                if (val.xzlx && val.xzlx == ybPatInfo2.insutype) {
                    resultObjArr.push(val);
                }
            });
            if (!!resultObjArr) {
                if (resultObjArr.length == 0) {
                    var instype = "";
                    instype = ybPatInfo2.insutype;
                    $.ajax({
                        url: "",
                        data: { xzlx: instype },
                        dataType: "",
                        async: false,
                        cache: false,
                        success: function (data) {
                            if (!!data) {
                                $("").val(data.brxzmc).attr("", data.brxz);
                            }
                            else {
                                $("").val('').attr("", '');
                            }
                        }
                    });
                }
                else {
                    $("").val(resultObjArr[0].brxzmc).attr("", resultObjArr[0].brxz);
                }

            }
            else {
                $("").val('').attr("", '');
            }
        }
    }
</script>



@{
    ViewBag.Title = "";
    Layout = "";
}
<script>
    var patientData = localStorage.getItem("");
    var patientdataJson = JSON.parse(patientData);
    $(function () {
        if (!!patientdataJson) {
            var $gridList = $("");
            $gridList.dataNewGrid({
                height: $(window).height() - 128,
                colModel: [
                    { label: "", name: "", hidden: true, key: true },
                    { label: '', name: '', width: 100, align: '' },
                    { label: '', name: '', width: 100, align: '' },
                    { label: '', name: '', width: 100, align: '' },
                    { label: '', name: '', width: 50, align: '' },
                    { label: '', name: '', width: 50, align: '' },
                    {
                        label: '', name: '', width: 50, align: '',
                        formatter: function (cellvalue) {
                            return $.getGender(cellvalue);
                        }
                    },
                    { label: '', name: '', width: 100, align: '' },
                    {
                        label: '', name: '', width: 80, align: '',
                        formatter: "", formatoptions: { srcformat: '', newformat: '' }
                    },
                    {
                        label: '', name: '', width: 50, align: '',
                        formatter: function (cellvalue) {
                            if (cellvalue) {
                                if (cellvalue.trim() == "") {
                                    return "";
                                } else if (cellvalue.trim() == "") {
                                    return "";
                                } else if (cellvalue.trim() == "") {
                                    return "";
                                } else {
                                    return "";
                                }
                            }
                            return "";
                        }
                    },
                     { label: '', name: '', width: 150, align: '' },
                     { label: '', name: '', width: 50, align: '' },
                     { label: '', name: '', width: 100, align: '' },
                     { label: '', name: '', width: 100, align: '' },
                     { label: '', name: '', width: 100, align: '' },
                     { label: '', name: '', hidden: true },

                ],
                pager: "",
                sortname: '',
                rowNum: '',
                viewrecords: true
            }, patientdataJson);
            if (patientdataJson.length > 0) {
                $('').find("").remove();
            }
        }
    });

    function btn_edit() {
        var rowid = $("").jqGrid("", "");
        var obj = new Object();
        if (rowid != "" && rowid != undefined) {
            obj = $('').jqGrid('', rowid);
            if (obj && obj.patid) {
                $.ajax({
                    url: "",
                    data: { "": obj.patid },
                    dataType: '',
                    async: false,
                    success: function (rep) {
                        $.currentWindow().fillInfo(rep);

                    }
                });
            }
        }
        $.loading(false);
        $.modalClose();
    }
</script>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>
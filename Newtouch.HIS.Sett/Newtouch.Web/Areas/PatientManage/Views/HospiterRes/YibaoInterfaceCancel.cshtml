@{
    Layout = "";
    //Địa bàn bảo hiểm y tế，区分系统将执行何处医保逻辑
    var medicalInsurance = SysConfigReader.String("");
    var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}

<style>
    .title {
        width: 60px;
    }
</style>
<form>
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form">
            <tr>
                <th class="formTitle">Thuộc tính：</th>
                <td class="formValue" colspan="1">
                    <select id="isjs" name="isjs" class="form-control">
                        <option value="yj" selected="selected">Đã kết</option>
                        <option value="wj">未结</option>
                        <option value="cz">冲正</option>
                    </select>
                </td>
                <th class="formTitle">Loại：</th>
                <td class="formValue" style="width:70px">
                    <select id="lx" name="lx" class="form-control">
                        <option value="mz">Ngoại trú</option>
                        <option value="zy" selected="selected">Nhập viện</option>
                    </select>
                </td>
                <th class="formTitle">Từ khóa：</th>
                <td class="formValue" style="width:100px">
                    <input id="txt_keyword" type="text" class="form-control form-an" placeholder="Họ tên/Số ngoại trú/Số nhập viện">
                </td>
                <td class="formTitle">
                    <input type="button" id="btn_search" class="btn btn-primary" value="Tra cứu" />
                </td>
                <td class="formTitle">
                    <input type="button" id="btn_settRefund" class="btn btn-primary" value="结算冲正" />
                </td>
                <td class="formValue">
                    <input type="button" style="display:none" id="btn_cyblRefund" class="btn btn-primary" value="出院办理冲正" />
                </td>
                <td class="formValue">
                    <input type="button" style="display:none" id="btn_ImpactIs" class="btn btn-primary" value="【2061】冲正" />
                    @*<input type="button"  id="btn_mzcz" class="btn btn-primary" value="【2061】入院登记冲正" />*@
                </td>
            </tr>
        </table>
    </div>
    <div class="gridPanel">

        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>

<script>
    var medicalInsurance = '';
    $(function () {
        gridList();
    })
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            height: $(window).height() - 145,
            postData: { keyword: $("").val(), lx: $("").val(), isjs: $("").val()},
            colModel: [
                { label: '', name: '', width: 70, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 90, align: '' },
                { label: '', name: '', width: 70, align: '' },
                { label: '', name: '', width: 110, align: '' },
                { label: '', name: '', width: 100, align: ''},
                {
                    label: '', name: '', width: 120, align: '',
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 70, align: '' },
                { label: '', name: '', width: 200, align: '' },
                { label: '', name: '', width: 60, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 50, align: '', hidden: true },
                { label: '', name: '', width: 50, align: '', hidden: true }
            ],
            pager: "",
            sortname: '',
            viewrecords: true
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: { keyword: $("").val(), lx: $("").val(), isjs: $("").val() },
            }).trigger('');
        });

        $('').change(function () {
            if ($("").val() == "") {
                $('').css('', '');
                $('').css('', '');
                $('').css('', '');
            }
            else if ($("").val() == "") {
                $('').css('', '');
                $('').css('', '');
                $('').css('', '');
            } else {
                $('').css('', '');
                $('').css('', '');
                $('').css('', '');
            }
            $('').trigger('');
        });
        $('').change(function () {
            $('').trigger('');
        })

        //撤销单边结算，前提:HIS医保记录表已存取医保结算返回数据
        $("").click(function () {
            var seleRow = $("").jqGridRowValue();
            var zymzh = seleRow.zymzh;
            if (!!!zymzh) {
                $.modalAlert("", "");
                return;
            }
            if ($("").val()=="")
            {
                switch (seleRow.dbz)
                {
                    case "":
                        var cqybjyDenySettleReturn;
                        var payoptype = { hisId: seleRow.zymzh, '': seleRow.setl_id, '': '', '': '', '': seleRow.mdtrt_id, '': seleRow.psn_no, "": seleRow.cbdbm };
                        $.ajax({
                            type: "",
                            url: "",
                            dataType: "",
                            data: payoptype,
                            async: false,
                            success: function (data) {
                                cqybjyDenySettleReturn = eval('' + data + '');
                            },
                            error: function (request, error, ex) {
                                $.modalAlert("" + ex + "", '');
                                return;
                            }
                        });
                        if (cqybjyDenySettleReturn.infcode == "") {
                            $.ajax({
                                type: "",
                                url: "",
                                dataType: "",
                                data: payoptype,
                                async: true,
                                success: function (data) {
                                    var cxcyReturn = eval('' + data + '');
                                    if (cxcyReturn.infcode == '') {
                                        $.modalAlert('', '');
                                    }
                                    else {
                                        $.modalAlert('' + cxcyReturn.err_msg + '', '');
                                        return;
                                    }
                                },
                                error: function (request, error, ex) {
                                    $.modalAlert("" + ex + "", '');
                                    return;
                                }
                            });
                        } else {
                            $.modalAlert('' + cqybjyDenySettleReturn.err_msg + '', '');
                        }
                        break;

                    case "":
                        if (medicalInsurance == "") {
                            var payoptype = { '': seleRow.setl_id, '': '', '': seleRow.zymzh, '': '', '': '' };//Loại hình bảo hiểm mặc định，1、Bảo hiểm y tế；2、Bảo hiểm tai nạn lao động；3、Bảo hiểm sinh sản；
                            lxybcz(payoptype);
                        }
                        break;

                    default:
                        break;
                }

            }
            else if ($("").val() == "")
            {
                switch (seleRow.dbz)
                {
                    case "":
                        var mzSettleReturn;
                        var mzpayoptype = { "": seleRow.setl_id, "": seleRow.mdtrt_id, "": seleRow.psn_no, operatorId: '', "": '', insuplc_admdvs: seleRow.cbdbm, hisId: seleRow.zymzh };
                        $.ajax({
                            type: "",
                            url: "",
                            dataType: "",
                            data: mzpayoptype,
                            async: false,
                            success: function (data) {
                                mzSettleReturn = eval('' + data + '');
                            },
                            error: function (request, error, ex) {
                                $.modalAlert("" + ex + "", '');
                                return;
                            }
                        });
                        if (mzSettleReturn.infcode == "" ) {
                            $.modalAlert('', '');
                        }
                        else {
                            $.modalAlert('' + mzSettleReturn.err_msg + '', '');
                        }
                        break;
                    case "":
                        if (medicalInsurance == "") {
                            var payoptype = { '': seleRow.setl_id, '': '', '': seleRow.zymzh, '': '', '': '' };//Loại hình bảo hiểm mặc định，1、Bảo hiểm y tế；2、Bảo hiểm tai nạn lao động；3、Bảo hiểm sinh sản；
                            lxybcz(payoptype);
                        }
                        break;
                    case "":
                        
                        var tmx;
                        var tjscfh = [];
                        $.najax({
                            type: "",
                            url: "" + seleRow.jsnm,
                            dataType: "",
                            loading: false,
                            async:false,
                            success: function (detailList) {
                                if (detailList && detailList.length) {
                                    tmx = detailList;
                                }
                            }
                        });
                        if (tmx && tmx.length == 0) {
                            $.modalAlert('', '');
                            return;
                        }
                        var tjsxmDictObj = {};
                        var iskt = true;
                        $.each(tmx, function () {
                            if (this.ktsl <= 0)
                                iskt = false;
                            tjsxmDictObj[this.jsmxnm] = this.tsl;
                            if ($.inArray(this.cfh, tjscfh) < 0) {
                                tjscfh.push(this.cfh);
                            }
                        });
                        if (!iskt) {
                            $.modalAlert('', '');
                            return;
                        }
                        var ybjyCqFeeReturn = {
                            jylsh: "",//值不可修改，后台会判断，Cho nếu111111111，则不再写入医保结算落地表--Trùng Khánh
                            cqtczf: 0,
                            zhzf: 0,
                            gwybz: 0,
                            cqxjzf: 0,
                            delpje: 0,
                            zhye: 0,
                            mzjzje: 0,
                            zxjssj: $.getDate()
                        };
                        var cqybjyDenySettleReturn = ybjyCqFeeReturn;
                        cqybjyDenySettleReturn.yjlsh = "";
                        var mztfProDto = { ZFY: seleRow.medfee_sumamt, XJZF: seleRow.xjzf };
                        YbHISRefundSettlement(zymzh,seleRow.jsnm,tjsxmDictObj,
                            ovpraseFloat(seleRow.medfee_sumamt).toFixed(4),
                            cqybjyDenySettleReturn.jylsh,//Hoàn phí quyết toán sauID
                            ybjyCqFeeReturn.jylsh,
                            ybjyCqFeeReturn,
                            cqybjyDenySettleReturn,//Hoàn phí đối tượng trả về giao dịch sau
                            mztfProDto,
                            function (hisSuccessAjaxResp) {
                                if (hisSuccessAjaxResp && hisSuccessAjaxResp.message !== '') {
                                    $.modalAlert(hisSuccessAjaxResp.message, '');
                                } else {
                                    $.modalAlert("", '');
                                    //Cập nhật cờ trả lại
                                    if (tjscfh.length > 0) {
                                        UpdateChargeTbz(tjscfh);
                                    }
                                }
                            });
                        break;
                    default:
                        break;
                }
            }
            $('').trigger('');
        });

        //离休冲正
        function lxybcz(payoptype)
        {
            var cqybjyDenySettleReturn;
            $.ajax({
                type: "",
                url: "",
                dataType: "",
                data: payoptype,
                async: false,
                success: function (data) {
                    cqybjyDenySettleReturn = eval('' + data + '');
                },
                error: function (request, error, ex) {
                    $.modalAlert("" + ex + "", '');
                    return;
                }
            });
            $.loading(false);
            if (cqybjyDenySettleReturn && cqybjyDenySettleReturn.Code == "") {
                $.modalAlert('', '');
            } else {
                $.modalAlert('' + cqybjyDenySettleReturn.ErrorMsg, '');
            }
        }

        //Giao dịch bảo hiểm y tế HISXác nhận hoàn phí
        function YbHISRefundSettlement(zymzh, jsnm,tjsxmDict, tmxZje, hcybjsh, newwjybjsh, newybfeeRelated, hcybfeeRelated, guianMztfProDto, funcSuccCallback) {
            $.najax({
                type: "",
                data: {
                    mzh: zymzh, jsnm:jsnm, tjsxmDict: tjsxmDict, expectedTmxZje: tmxZje
                    , hcybjsh: hcybjsh, newwjybjsh: newwjybjsh
                    , hcybfeeRelated: hcybfeeRelated
                    , newybfeeRelated: newybfeeRelated
                    , guianMztfProDto: guianMztfProDto
                    , outpId: null
                },
                url: "",
                dataType: "",
                loadingtext: "",
                success: function (ajaxresp) {
                    if (funcSuccCallback) {
                        if (ajaxresp && ajaxresp.data) {
                        }
                        funcSuccCallback(ajaxresp);
                    }
                }
            }); $.loading(false);
        }
        function ovpraseFloat(val) {
            if (!val) {
                val = 0;
            }
            return parseFloat(val);
        }

        //Cập nhậtCISCờ trả lại
        function UpdateChargeTbz(tcfh) {
            $.ajax({
                type: "",
                data: { tcfh: tcfh },
                url: "",
                dataType: ""
          });
         }

        //2405Hủy xuất viện
        $("").click(function () {
            var seleRow = $("").jqGridRowValue();
            var zymzh = seleRow.zymzh;
            if (!!!zymzh) {
                $.modalAlert("", "");
                return;
            }
            var cycxpayoptype = { hisId: seleRow.zymzh, '': '', '': '', '': seleRow.mdtrt_id, '': seleRow.psn_no, "": seleRow.cbdbm };
            $.ajax({
                type: "",
                url: "",
                dataType: "",
                data: cycxpayoptype,
                async: true,
                success: function (data) {
                    var cxcyReturn = eval('' + data + '');
                    if (cxcyReturn.infcode == '') {
                        $.modalAlert('', '');
                    }
                    else {
                        $.modalAlert('' + cxcyReturn.err_msg + '', '');
                    }
                },
                error: function (request, error, ex) {
                    $.modalAlert("" + ex + "", '');
                }
            });
        });

        $("").click(function () {
            //2601入参
            var ImpactIs = { hisId: "", '': '', '': '', '': "", '': "", '': "", "": "" };
            $.ajax({
                type: "",
                url: "",
                dataType: "",
                data: ImpactIs,
                async: false,
                success: function (data) {
                    var mzImpactIs = eval('' + data + '');
                    if (mzImpactIs.infcode == '') {
                        $.modalAlert('', '');
                    }
                    else {
                        $.modalAlert('', '');
                    }
                },
                error: function (request, error, ex) {
                    $.modalAlert("" + ex + "", '');
                    return;
                }
            });
        });


        /*2601冲正可冲正 2207Quyết toán ngoại trú 2208Hủy quyết toán ngoại trú
          2304Quyết toán nhập viện 2305Nhập viện hủy quyết toán 2401Làm thủ tục nhập viện*/
        $("").click(function () {
            var seleRow = $("").jqGridRowValue();
            var omsgid = seleRow.medins_setl_id;
            var oinfon = seleRow.infno;
            if (!!!omsgid && !!!oinfon) {
                $.modalAlert("", "");
                return;
            }
            var mzImpactIs;
            //2405入参
            var cycxpayoptype = { hisId: seleRow.zymzh, '': '', '': '', '': seleRow.mdtrt_id, '': seleRow.psn_no, "": seleRow.cbdbm };
            //2601入参
            var ImpactIs = { hisId: seleRow.zymzh, '': '', '': '', '': seleRow.medins_setl_id, '': seleRow.infno, '': seleRow.psn_no, "": seleRow.cbdbm };
            $.ajax({
                type: "",
                url: "",
                dataType: "",
                data: ImpactIs,
                async: false,
                success: function (data) {
                    mzImpactIs = eval('' + data + '');
                    if (mzImpactIs.infcode == '') {
                        $.modalAlert('', '');
                    }
                    else {
                        $.modalAlert('' +seleRow.infno+ '' + mzImpactIs.err_msg + '', '');
                    }
                },
                error: function (request, error, ex) {
                    $.modalAlert("" + ex + "", '');
                    return;
                }
            });
            if (mzImpactIs.infcode == '') {
                if(seleRow.infno =='')
                {
                    $.ajax({
                        type: "",
                        url: "",
                        dataType: "",
                        data: cycxpayoptype,
                        async: true,
                        success: function (data) {
                            var cxcyReturn = eval('' + data + '');
                            if (cxcyReturn.infcode == '') {
                                $.modalAlert('', '');
                            }
                            else {
                                $.modalAlert('' + cxcyReturn.err_msg + '', '');
                            }
                        },
                        error: function (request, error, ex) {
                            $.modalAlert("" + ex + "", '');
                        }
                    });
                }
                if (seleRow.infno == '')
                {
                    $.ajax({
                        type: "",
                        url: "" + seleRow.zymzh,
                        dataType: "",
                        async: false,
                        success: function (data) {
                        }
                    });
                }

            }
        });
    }
</script>
@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
    var from = (ViewBag.from as string) ?? "";
}

<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>
<script>
    var $gridList = $("");

    $(function () {
        gridList();
        var data = JSON.parse(localStorage.getItem(""));
        if (!!data) {
            $('').newtouchLocalDataGrid(null, data);
            localStorage.removeItem("");
        }
    });


    function gridList() {
        $gridList.newtouchLocalDataGrid({
            unwritten: false,
            height: $(window).height() - 70,
            colModel: [
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', width: 100, align: '' },
                {
                    label: '', name: '', width: 30, align: '', formatter: function (cellvalue) {
                        return $.getGender(cellvalue);
                    }
                },
                { label: '', name: '', width: 160, align: '' },
                { label: '', name: '', width: 50, align: '' },
                {
                    label: '', name: '', width: 90, align: '',
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                { label: '', name: '', width: 160, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 75, align: '' },
                { label: '', name: '', width: 85, align: '' },
                { label: '', name: '', width: 85, align: '' },
            ],
            pager: "",
            sortname: '',
            rowNum: '',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                PatDbGrid(rowid);
            }
        });
    }

    function PatDbGrid(rowId) {
        var rowData = $gridList.jqGrid('', rowId);
        var obj = new Object();
        obj.xnhgrbm = rowData.memberId;
        obj.xnhylzh = rowData.medicalNo;
        obj.xm = rowData.memberName;
        obj.xb = rowData.memberSex;
        obj.zjlx =@((int)EnumZJLX.sfz);
        obj.brxzmc = "";
        obj.brxzcode = "";
        obj.zjh = rowData.idCard;
        obj.csny = rowData.birthday;
        obj.xian_dz = rowData.areaName;
        obj.zhye = rowData.account;
        $.currentWindow().GetSelectedpatient(obj);
        $.modalClose();
    }
</script>




@{
    Layout = "";
}

<style>
 
</style>
<form>
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form">
            <tr>
                <th class="formTitle">Từ khóa：</th>
                <td class="formValue">
                    <input type="text" class="form-control form-an" id="xm" placeholder="Họ tên/Phiên âm/Số bệnh án/Số giấy tờ" />
                </td>
                @*<th class="formTitle">Số thẻ：</th>
        <td class="formValue" width="120">
            <input type="text" class="form-control form-an" id="kh" />
        </td>*@
                <td class="formTitle">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary form-an" value="Tra cứu" />

                </td>

                <th class="formTitle"></th>
                <td class="formValue"></td>
                <th class="formTitle"></th>
                <td class="formValue"></td>
            </tr>
        </table>
       
        <div class="panel-heading navb-bg">
            日志列表
        </div>
        <div class="gridPanel">
            <table id="gridList"></table>
            <div id="gridPager"></div>
        </div>
    </div>

</form>


<script>
    $(function () {
        pageInit();
    });
    function pageInit() {
        $("").dataGrid(
            {
                url: "",
                postData: getSearchPostData(),
                colModel: [
                    { label: '', name: '', width: 100, align: '', hidden: true },
                    { label: '', name: '', width: 100, align: '', hidden: true },
                    { label: '', name: '', width: 100, align: '' },
                    {
                        label: '', name: '', width: 70, align: '',
                        formatter: function (cellvalue) {
                            return $.getGender(cellvalue);
                        }
                    },
                    { label: '', name: '', width: 100, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
                    { label: '', name: '', width: 100, align: '' },
                    { label: '', name: '', width: 120, align: '' },
                    { label: '', name: '', width: 150, align: '' },
                    { label: '', name: '', width: 100, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
                ],
                rowNum: 15,
                rowList: [10, 20, 30],
                pager: '',
                sortname: '',
                viewrecords: true,
                sortorder: "",
                height: $(window).height() - 175,
                ondblClickRow: function (rowid) {
                    XiangQin(rowid);
                },
            });
        
    }

    function XiangQin(rowData) {
        var rowData = $('').jqGrid('', rowData);
        $.modalOpen({
            id: "",
            title: "",
            url: "" + rowData.Id,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].$.modalClose();
            }
        });
        
    }
    $("").click(function () {
        $("").jqGrid('', {
            postData: getSearchPostData(),
            page: 1,
        }).trigger('');

    });
    //Điều kiện tra cứu
    function getSearchPostData() {
        var xm = $("").val();
        return { xm: xm };

    }
</script>

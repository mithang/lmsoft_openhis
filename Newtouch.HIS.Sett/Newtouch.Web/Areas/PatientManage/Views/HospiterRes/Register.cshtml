    function cq_fetchTsbbz(rybh) {
        var bzList = [];
        var tsbData = { psn_no: cqPatInfo.grbh, operatorId: '', operatorName: '', insuplc_admdvs: cqPatInfo.xzqh, hisId:  $("").val() };
        $.ajax({
            type: "",
            url: "",
            dataType: "",
            data: tsbData,
            async: false,
            success: function (data) {
                var TbMzReg = eval('' + data + '');
                if (TbMzReg) {
                    if (TbMzReg.infcode == "" && !!TbMzReg.output.feedetail) {
                        bzList = TbMzReg.output.feedetail;
                    }
                    else {
                        $.modalAlert("" + medicalReg.err_msg, '');
                    }
                }
            },
            error: function () {
                $.modalAlert("", '');
            }
        });
        return bzList;
    }
    //Thông quainsutype Lấybrxz
    function brxzRelInsutype(insutype) {
        var resultObjArr = new Array();
        $.each(top.window.clients.sysPatientNatureList, function (idx, val) {
            if (val.xzlx && val.xzlx == insutype) {
                resultObjArr.push(val);
            }
        });
        if (!!resultObjArr) {

            if (resultObjArr.length == 0) {
                $.ajax({
                    url: "",
                    data: { xzlx: insutype },
                    dataType: "",
                    async: false,
                    cache: false,
                    success: function (data) {
                        if (!!data) {
                            $("").val(data.brxzmc).attr("", data.brxz);
                        }
                        else {
                            $("").val('').attr("", '');
                        }
                    }
                });
            }
            else {
                $("").val(resultObjArr[0].brxzmc).attr("", resultObjArr[0].brxz);
            }
            return resultObjArr[0];
        }
        else
            return null;
    }


    function yibaoValidateFirstVisit(cardInfo) {

	    if (!!cardInfo) {
		    //1.Đánh giá có khám lần đầu không（初诊新建，Thông tin bệnh nhân tải tái khám）
	        //Phương thức xác minh khám lần đầu：1.Số chứng minh nhân dân+Họ tên，2：Số bảo hiểm xã hội
	        var paramVo = { kh: cardInfo.kh, jzpzlx: cardInfo.jzlx };
	        if (cardInfo.output) {
	            paramVo.sfzh = cardInfo.output.baseinfo.certno;
	            paramVo.xm = cardInfo.output.baseinfo.psn_name;
	            paramVo.kh = cardInfo.kh;
	            paramVo.jzpzlx = cardInfo.jzlx;
	        }
		    $.ajax({
			    type: "",
			    url: ""ValidateYbFirstVisit"",
		        data: paramVo,
			    dataType: "",
			    async: false,
			    success: function (resp) {
				    if (!!resp.data) {
					    if (resp.data.sbbh == cardInfo.kh||resp.data.zjh==cardInfo.qtjz) {//Tái khám
					        GetQueryFphAjax({ blh: null, kh: cardInfo.kh, zjh: paramVo.sfzh, cardType: cardInfo.jzlx },
							    function () {
								    if (patModel) {
								    }
							    });
					    } else {//Khám lần đầu
						    $.ajax({
							    type: "",
							    url: "",
							    data: { patid: resp.data.patid, brxz: "" },
							    dataType: "",
							    async: false,
							    success: function(r) {
								    if (!!r.data && !!r.data.CardNo) {
								        cardInfo.kh = r.data.CardNo;
								    }
								    localStorage.setItem("", JSON.stringify(cardInfo));
								    btn_NocardRes();
							    }
						    });
					    }
				    } else {
					    localStorage.setItem("", JSON.stringify(cardInfo));
					    btn_NocardRes();
				    }
			    }
		    });
	    }
    }

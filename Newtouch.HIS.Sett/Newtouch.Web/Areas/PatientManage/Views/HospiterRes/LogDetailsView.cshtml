
@{
    Layout = "";
}

<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>


<script>
    $(function () {
        var Id = $.request("");
        pageInit();
        GetData(Id);
    });
    function pageInit() {
        $("").dataGrid(
            {
                //url: "",
                colModel: [
                    { label: '', name: '', width: 100, align: '' },
                    { label: '', name: '', width: 150, align: '' },
                    { label: '', name: '', width: 120, align: '' },
                ],
                viewrecords: false,
                width: "",
                autowidth: true,
                height: $(window).height()-55,
            });
    }

    function GetData(Id) {
        $.ajax({
            url: "",
            dataType: "",
            async: false,
            data: { "": Id },
            type: "",
            success: function (req) {
                if (req.length>0) {
                    var datanames = (req[0].datanames).split('');
                var datavalue_old = (req[0].datavalue_old).split('');
                var datavalue_new = (req[0].datavalue_new).split('');
                for (var i = 0; i < datanames.length; i++) {
                    for (var j = i; j < datavalue_old.length; j++) {
                        for (var k = i; k < datavalue_new.length; k++) {

                            $("").jqGrid("", i+1, {
                                '': datanames[i],
                                '': datavalue_old[j] == "" ? "" : datavalue_old[j],
                                '': datavalue_new[k] == "" ? "" : datavalue_new[k]
                            });
                            //$("").jqGrid("", i + 1);
                            break;
                        }
                        break;
                    }
                }
                }
                
            },
            error: function () {
            }
        });

    }
</script>


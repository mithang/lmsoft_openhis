@{
    ViewBag.Title = "";
    Layout = "";

    var isOpenSfqr = (ViewBag.IsOpenSfqr as bool?) ?? false;
    var TZPZ_OutpatientRegister = ViewBag.TZPZ_OutpatientRegister ?? "";
}
<style>
    .rema {
        color: red;
    }
</style>
<script type="">
    var mzhpz;
    var objblh = "";
    $(function () {
        patInfoObj = {}
        mzhpz = $("").val();
        if (mzhpz == "") {
            $("").attr("", "").css("", "");
            $('').attr("", "");
            $('').html("");
        }

        $("").val($.getDate());

        if ('' == '' && top.window.clients.doctorInHosBookkeep.length == 1) {
            $("").attr("", top.window.clients.doctorInHosBookkeep[0].StaffGh);
            $("").val(top.window.clients.doctorInHosBookkeep[0].StaffName);
            $("").val(top.window.clients.doctorInHosBookkeep[0].ksmc);
            $("").attr("", top.window.clients.doctorInHosBookkeep[0].ks);
        }
        //Lớp nổi bác sĩ
        $("").newtouchBatchFloatingSelector({
            height: 200,
            width: 300,
            clickautotrigger: true,
            filter: function (keyword) {
                //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
                var resultObjArr = new Array();//
                $.each(top.window.clients.doctorInHosBookkeep, function (idx, val) {
                    if ($.trim(keyword).length == 0 ||
                        (val.py && val.py.toUpperCase().indexOf(keyword.toUpperCase()) >= 0) ||
                        (val.StaffName && val.StaffName.indexOf(keyword.toLowerCase()) >= 0) ||
                        (val.gh && val.gh.indexOf(keyword.toLowerCase()) >= 0) ||
                        (val.kspy && val.kspy.indexOf(keyword.toUpperCase()) >= 0) || keyword.trim() == '') {
                        resultObjArr.push(val);
                    }
                });
                return resultObjArr;

            },
            caption: "",
            colModel: [
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', widthratio: 25, hidden: true },
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', widthratio: 25, hidden: true }

            ],
            itemdbclickhandler: function ($thistr) {
                $("").val($thistr.attr(""));
                $("").attr("", $thistr.attr(""));
                $("").val($thistr.attr(""));
                $("").attr("", $thistr.attr(""));
            },
        });

        //Nguồn bệnh nhân
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                $.each($.itemDetails.getItems(''), function () {
                    $('').append('' + this.Code + '' + this.Name + '');
                });
                return resultObjArr;
            }
        });

        //Quan hệ người liên hệ khẩn cấp
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                $.each($.itemDetails.getItems(''), function () {
                    $('').append('' + this.Code + '' + this.Name + '');
                });
                return resultObjArr;
            }
        });

        //Liên kết lớp nổi chọn hạng mục điều trị
        $('').newtouchBatchFloatingSelector({
            width: 500,
            height: 200,
            caption: "",
            url: ""PatSearchInfo"",
            ajaxparameters: function ($thisinput) {
                var keyword = $thisinput.val().trim();
                return "" + keyword;
            },
            itemdbclickhandler: function ($thistr, $thisinput) {
                objblh = $thistr.attr('');
                GetQueryFphAjax({ patid: $thistr.attr(''), blh: objblh });
            },
            colModel: [
                 { label: '', name: '', hidden: true },
                 { label: '', name: '', width: 130, align: '' },
                 { label: '', name: '', width: 120, align: '' },
                 { label: '', name: '', hidden: true, width: 100, align: '' },
                 {
                     label: '', name: '', width:70, align: '', formatter: function (cellvalue) {
                         return $.getGender(cellvalue);
                     }
                 },
                {
                    label: '', name: '', width: 100, align: '', formatter: function (cellvalue, a, b) {
                        return getAgeFromBirthTime({ begin: b.csny }).text;
                    }
                },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                   { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
                 { label: '', name: '', align: '', hidden: true },
            ]
        });

        $("").keyupEnterEvent(function () {
            btn_Save();
        });
    });

    function btn_NocardRes() {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + new Date(),
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
                $("").prop('', false);
            }
        });
    }

    //Bật lên tra cứu bệnh nhân
    function GetPatSerarchView(blh) {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + Math.random() + "" + blh,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
            }
        });
    }

    //Gọi tra cứu bệnh nhân
    function GetQueryFphAjax(obj) {
        //Đánh giá có đăng ký lặp lại không
        AllowRegh(obj.blh);
        //Xóa trống
        ClearAll();
        //Lấy thông tin cơ bản bệnh nhân
        CallbackPatientQuery(obj.blh);
    }

    //Thông tin cơ bản trả về tìm kiếm số bệnh án theo
    function CallbackPatientQuery(blh) {
        $.ajax({
            url: "",
            data: { blh: blh },
            dataType: "",
            async: false,
            success: function (rep) {
                if (rep.data == null) return;
                $("").find("" + rep.data[""] + "").attr("", true).trigger('');
                var patModel = rep.data;
                objblh = patModel.blh;
                $("").html($.getGender(patModel.xb));
                $("").html((patModel.csny && patModel.csny.length >= 10 ? patModel.csny.substring(0, 10) : ""));
                $("").html(patModel.zjh);
                $("").html(patModel.jsr);
                $("").html(patModel.xm);
                $("").html(getAgeFromBirthTime({ begin: patModel.csny }).text);
                $("").val(patModel.blh);
                $("").html(patModel.kh);
                $("").val(patModel.patid);
                $("").html(patModel.phone);
                $("").html(patModel.csny);
                $("").val(patModel.zjlx);
                $("").prop('', true);
                $("").val(patModel.brxz);
                $("").find("" + rep.data[""] + "").attr("", true).trigger('');//.val(patModel.lxrgx);
                $("").val(patModel.lxr);
                $("").val(patModel.lxrdh);
            }
        });
    }

    function AbledSysBasicInfo() {
        $("").html("");
        $("").html("");
        $("").html("");
        $("").html("");
        $("").html("");
        $("").html("");
        //$("").html("");
        $("").html("");
        $("").val("");
        $("").html("");
        $("").val("");
        objblh = "";
        patInfoObj = {};
    }

    function ClearAll() {
        AbledSysBasicInfo();
        newtouch_globalevent_f4();

        if ('' == '' && top.window.clients.doctorInHosBookkeep.length == 1) {
            $("").attr("", top.window.clients.doctorInHosBookkeep[0].StaffGh);
            $("").val(top.window.clients.doctorInHosBookkeep[0].StaffName);
            $("").val(top.window.clients.doctorInHosBookkeep[0].ksmc);
            $("").attr("", top.window.clients.doctorInHosBookkeep[0].ks);
        }
    }

    function newtouch_event_f4() {
        AbledSysBasicInfo();
        $("").val("");
        $("").prop('', true);
    }

    function newtouch_globalevent_f6() {
        btn_Save();
    }

    function checkNotNull() {
        var patid = $("").val();
        if (!patid) {
            $.modalAlert("", '');
            return false;
        }
        if (objblh === "" || !objblh) {
            $.modalAlert("", '');
            return false;
        }
        var validator = $('').validate();
        validator.settings = {
            rules: {
                blh: { required: true },
                mzh: { required: true },
                ksmc: { required: true },
                doctormc: { required: true },
                ghrq: { required: true },
                lxr: { maxlength: 10 },
                lxrdh: { isPhone: true }
            },
            messages: {
                blh: { required: "" },
                mzh: { required: "" },
                ksmc: { required: "" },
                doctormc: { required: "" },
                ghrq: { required: "" },
                lxrdh: { isPhone: "" }
            },
            showErrors: function (errorMap, errorList) {
                if (!$.isEmptyObject(errorList)) {
                    if (Array.isArray(errorList) && errorList.length == 0) {
                        return;
                    }
                    $.modalAlert(errorList[0].message, '');
                }
            }
        }
        if (mzhpz === "" && !$("").val()) {
            $.modalAlert("", '');
            return;
        }
        if (!validator.form()) {
            return false;
        }
        return true;
    }

    function btn_Save() {
        var result = checkNotNull();
        if (result) {
            var data = $("").formSerialize();
            data[""] = $("").html();
            data[""] = $("").attr("");
            data[""] = $("").val();
            data[""] = $("").attr("");
            data[""] = $("").html();
            data[""] = objblh;
            data[""] = $.getGenderCode($("").html());
            data[""] = $("").val();
            data[""] = $("").html();
            data[""] = $("").html();
            $.submitForm({
                url: "",
                loading: "",
                param: data,
                successwithtipmsg: false,
                success: function (data) {
                    var message = "";
                    if ('' !== '') {
                        var mzh = data.data;
                        if (data.message === "") {
                            message = "";
                        }
                        else if (data.message === "") {
                            message = "";
                        }
                        ClearAll();
                        $.modalConfirm(message, function (flag) {
                            if (flag) {
                                top.top.$.Newtouchtab.triggerMenuItemClick({ m1: '', m2: '' });
                                sessionStorage.setItem("", mzh);
                                return true;
                            }
                        });
                    } else {
                        if (data.message === "") {
                            message = "";
                        }
                        else {
                            message = "";
                        }
                        ClearAll();
                        $.modalAlert(message, '');
                        return;
                    }
                }
            });
        }
    }

    ///Đánh giá hôm nay có đăng ký lặp lại không
    function AllowRegh(p) {
        $.ajax({
            url: ""AllowRegh"",
            data: { blh: p },
            //dataType: "",
            success: function (rep) {
                if (rep == "") {
                    $.modalConfirm("", function (flag) {
                        if (!flag) {
                            ClearAll();
                            return;
                        }
                    });
                }
            }
        });
    }
</script>
<form id="form1">
    <div class="rows" style="margin-bottom: 1%;" id="basicInfo">
        <div class="panel panel-default" style="margin-bottom:0;">
            <div class="panel-heading navb-bg">
                Thông tin cơ bản bệnh nhân
            </div>
            <table class="form" style="margin-left: 10px;">
                <tr>
                    <th class="formTitle"><span class="rema">*</span><label id="lbl_kh">Số bệnh án/Họ tên：</label> </th>
                    <td class="formValue" colspan="2">
                        <input type="text" id="blh" name="blh" class="form-control" placeholder="Ít nhất1ký tự vị" />
                    </td>
                    <td colspan="2">
                        <button type="button" class="btn btn-primary" id="noCardRes" value="Tạo mới" onclick="btn_NocardRes()">
                            Tạo mới
                        </button>
                        &nbsp;&nbsp;
                        <input type="button" class="btn btn-default btn-md btn-default-color" id="btnsyy" value="Tra cứu" onclick="GetPatSerarchView($('#blh').val());" />
                    </td>
                    <td class="formTitle">
                        Họ tên：
                    </td>
                    <td class="formValue">
                        <label id="xm"></label>
                    </td>
                    <td class="formTitle">Giới tính：</td>
                    <td class="formValue">
                        <label id="xb"></label>
                    </td>
                    <td class="formTitle">Tuổi：</td>
                    <td class="formValue">
                        <label id="nlshow"></label>
                    </td>
                    <td class="formTitle">
                        <label id="zjlx">Số chứng minh nhân dân：</label>
                        <input hidden="hidden" id="hiddenzjlx" />
                    </td>
                    <td class="formValue" colspan="2">
                        <label id="zjh"></label>
                    </td>
                </tr>
                <tr>
                    <td class="formTitle">Điện thoại di động：</td>
                    <td class="formValue"><label id="phone"></label></td>
                    <td class="formTitle">
                        <label>Số thẻ：</label>
                    </td>
                    <td class="formValue">
                        <label id="kh"></label>
                    </td>
                    <td class="formValue">
                        <input type="hidden" id="patid" />
                        <input type="hidden" id="brxzmc" />
                        <label id="csny" hidden="hidden"></label>
                        <input type="hidden" id="mzhpz" value="@ViewBag.mzhpz" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div id="InHospitalInfo" class="rows" style="margin-bottom: 1%;">
        <div class="panel panel-default" style="margin-bottom:0;">
            <div class="panel-heading navb-bg">Thông tin cơ bản ngoại trú</div>
            <table class="form" style="width:98%;border:0">
                <tr>
                    <td class="formTitle"><span id="mzlog" class="rema">*</span>Số ngoại trú：</td>
                    <td class="formValue"><input type="text" id="mzh" class="form-control form-an" /></td>
                    <td class="formTitle"><span class="rema">*</span>Bác sĩ：</td>
                    <td class="formValue"><input type="text" id="doctormc" name="doctormc" class="form-control form-an formClearIgnore" /></td>
                    <td class="formTitle"><span class="rema">*</span>Đăng ký ngày：</td>
                    <td class="formValue">
                        <input id="ghrq" type="text" name="ghrq" class="form-control input-wdatepicker form-an formClearIgnore"
                               onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" />
                    </td>
                    <td class="formTitle">Nguồn bệnh nhân：</td>
                    <td class="formValue formDdlSelectorTd">
                        <select class="form-control form-an-end" id="brly" name="brly">
                            <option value="">==Vui lòng chọn==</option>
                        </select>
                    </td>
                    <td class="formValue" style="padding-top: 1px; left:10px">
                        <div class="ckbox">
                            <input id="xlbrbz" name="xlbrbz" class="formClearIgnore" type="checkbox" checked="checked"><label for="xlbrbz">是否复诊</label>
                        </div>
                        <input type="hidden" id="ksmc" name="ksmc" class="form-control form-an newtouch_Readonly" />
                    </td>
                </tr>
                <tr>
                    <td class="formTitle">Người liên hệ khẩn cấp：</td>
                    <td class="formValue"><input type="text" name="lxr" id="lxr" class="form-control form-an" /></td>
                    <td class="formTitle">Quan hệ người liên hệ：</td>
                    <td class="formValue formDdlSelectorTd">
                        <select id="lxrgx" name="lxrgx" class="form-control form-an">
                            <option value="">==Vui lòng chọn==</option>
                        </select>
                    </td>
                    <td class="formTitle">Điện thoại người liên hệ：</td>
                    <td class="formValue">
                        <input id="lxrdh" type="text" name="lxrdh" class="form-control form-an" />
                    </td>
                    <td class="formTitle">
                        Người giới thiệu：
                    </td>
                    <td class="formValue">
                        <input id="tjr" type="text" name="tjr" class="form-control form-an-end" />
                    </td>
                    <td class="formValue"></td>
                </tr>
            </table>
        </div>
    </div>
    @Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
{
    ShowKeyList = new int[] { 4, 6 },
    F6Text = ""
})
</form>

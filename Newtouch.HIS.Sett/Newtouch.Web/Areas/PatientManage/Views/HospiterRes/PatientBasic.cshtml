@if (openYbSett == true || openXnhSett == true)
{
    <script type="">
        var patientform = JSON.parse(localStorage.getItem(""));
        var khsc = true;
        var blhsc = true;
        $(function () {
            debugger;
            if (!!patientform) {
                fillForm();
                localStorage.removeItem("");
            }
            else {
                brxzinit();

            }

            if (!!keyValue) {
                $("").attr("", "").css("", "");
                $("").attr("", "").css("", "");
                $.najax({
                    url: "" + new Date(),
                    data: { "": keyValue },
                    dataType: '',
                    async: false,
                    success: function (rep) {
                        if (rep.state !== '') {
                            $("").formSerialize(rep);
                            cityref = rep;
                            if (rep[""]) {
                                $("").attr("", rep[""]);
                            }
                            if (rep[""]) {
                                var type = rep[""].trim();
                                switch (type) {
                                    case "":
                                        type = "";
                                        break;
                                    case "":
                                        type = "";
                                        break;
                                    case "":
                                        type = "";
                                        break;
                                    default:
                                        break;
                                }
                            }

                            if (rep[""]) {
                                $("").val(rep[""]).trigger('');
                            }
                            if (rep[""]) {
                                $("").val(rep[""]).trigger('');
                            }
                            if (rep[""] && rep[""]) {
                                $("").attr("", rep[""]);
                                $("").val(rep[""]);
                            }

                            if (rep[""]) {
                                $("").find("" + rep[""] + "").attr("", true).trigger('');
                            }
                            setAge(rep.csny);
                        }
                        else {
                            $.modalClose();
                        }
                    },
                    errorCallback: function (err) {
                        $.loading(false);
                    }
                });
            }
            else {
                //是新登记
                if (khpz === '') {
                    $("").attr("", "").css("", "");
                }
                if (blhpz == '') {
                    //Tạo tự động số bệnh án
                    $("").attr("", "").css("", "");
                }
                if (khpz === '' || blhpz === '') {
                    //同步请求后台 获取最新虚拟卡号/Tự động tạo số bệnh án
                    $.ajax({
                        url: "",
                        data: { khsc: khsc, blhsc: blhsc },
                        dataType: "",
                        async: false,
                        cache: false,
                        success: function (data) {
                            $('').val(data.kh);
                            $('').val(data.blh);
                        }
                    });
                    if (!!patientform) {
                        if (!!patientform.blh) {
                            $('').val(patientform.blh);
                        }

                        if (!!patientform.kh) {
                            $('').val(patientform.kh);
                        }
                    } else {

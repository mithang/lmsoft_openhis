                                    //$.CataComparison.getItem('', '', ""); //固定为医保,Quẹt thẻ bảo hiểm y tế có chỉ(1,Bảo hiểm y tế)
                                    if (!ybfyxzCompResult.Name) {
                                        $.modalAlert("", '');

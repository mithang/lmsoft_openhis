                        localStorage.setItem("", JSON.stringify(yibaoCardInfo));
                        GetQueryFphAjax({ blh: null, kh: cardInfo.prm_aac001, zjh: null, cardType: ybkCardType },
                            function () {
                                if (patModel) {
                                    //Gán giá trị đối chiếu tính chất bệnh nhân 默认用最新的费用性质 Cho cần cònpatModel.brxz patModel.brxzmc
                                    var ybfyxzCompResult = {

    //Đọc thẻ Gọi01,13Giao diện
    function GetReadCardInfo(sbkobj, boolVal) {
        if (!sbkobj && boolVal==true) {
            $.modalAlert("Vui lòng nhập thẻ BHXH", 'error');
            return;
        }

        var cardInfo;
        var yibaoCardInfo;
        var cqcardInfo;
        var cqyibaoCardInfo;
        var patsbkh = null;
        if (sbkobj) {
            patsbkh = sbkobj;
        }
        if (!patsbkh) {
            var rzfsInfo = { "rzfs": $('#readCardCardType').val() == "04" ? "01" : "02" };
            $.ajax({
                type: "POST",
                url: "http://127.0.0.1:22222/api/CQYiBao/ReadCard",
                dataType: "json",
                data: rzfsInfo,
                async: false,
                success: function (data) {
                    cqyibaoCardInfo = eval('(' + data + ')');
                }
            });
        }
        else {
            cqyibaoCardInfo = { "Code": "1", "Data": { "sbkh": patsbkh } };
        }

        if (cqyibaoCardInfo) {
            $.loading(false);
            if (cqyibaoCardInfo.Code === "1") {
                cqcardInfo = cqyibaoCardInfo.Data; //Đối tượng phản hồi BHYT
                if (!cqcardInfo.sbkh) {
                    $.modalAlert("Đọc thẻ thất bại：Chưa lấy được số thẻ BHXH", 'error');
                    return;
                }

                var payoptype = { "sbkh": cqcardInfo.sbkh, "xzlb": "1" };//Loại hình bảo hiểm mặc định，1、Bảo hiểm y tế；2、Bảo hiểm tai nạn lao động；3、Bảo hiểm thai sản；
                $.ajax({
                    type: "POST",
                    url: "http://127.0.0.1:22222/api/CQYiBao/PatAccountInfo",
                    dataType: "json",
                    data: payoptype,
                    async: false,
                    success: function (data) {
                        yibaoCardInfo = eval('(' + data + ')');
                    }
                });
                if (yibaoCardInfo) {
                    if (yibaoCardInfo.Code === "1") {
                        if (!yibaoCardInfo.Data || !yibaoCardInfo.Data.patInfo || !yibaoCardInfo.Data.accountInfo) {
                            $.modalAlert("Gọi giao diện BHYT01và13，Lấy thông tin nhân viên và tài khoản thất bại！", 'error');
                            return;
                        }
                        cardInfo = yibaoCardInfo.Data.patInfo; //Đối tượng phản hồi BHYT

                        if (!!cardInfo.fsyy) {
                            $.modalAlert("Thẻ này đã bị phong tỏa：" + cardInfo.fsyy, 'error');
                            return;
                        }
                        yibaoCardInfo.readCardCardType = $('#readCardCardType').val();
                        yibaoCardInfo.kh = cqcardInfo.sbkh;
                        localStorage.setItem("patientform", JSON.stringify(yibaoCardInfo));
                        //Gán giá trị
                        SetValue(cardInfo, yibaoCardInfo.Data.accountInfo);
                        $("#kh").html(cqcardInfo.sbkh);
                        //$("#txtybye").html(yibaoCardInfo.Data.accountInfo.zhye); /////191108 Số dư thẻ，Khi đọc thẻ có liên kết trả về thông tin thẻ hay không，Khác biệt giữa thẻ Kim Bảo và thẻ BHXH？？？

                        var param = "07|" + cqcardInfo.sbkh;
                        var payoptype = { "inStr": param };//Loại hình bảo hiểm mặc định，1、Bảo hiểm y tế；2、Bảo hiểm tai nạn lao động；3、Bảo hiểm thai sản；
                        $.ajax({
                            type: "POST",
                            url: "http://127.0.0.1:22222/api/CQYiBao/BusinessCall",
                            dataType: "json",
                            data: payoptype,
                            async: false,
                            success: function (data) {
                                $("#tbinfo").html(data);
                                if (data != "1|##")
                                {
                                    $("#tbbzbm").empty();
                                    var arr = new Array();
                                    arr = data.substring(2).split("$");
                                    for (var i = 0; i <= arr.length - 1; i++) {
                                        var op = new Array();
                                        var val = arr[i];
                                        op = val.split("|");
                                        arr[i] = op[0];
                                    }
                                    var o =  document.getElementById("tbbzbm");
                                    var len = arr.length;
                                    for (var j = 0; j < len; j++) {
                                        var op = document.createElement("option");
                                        op.setAttribute("value", arr[j]);
                                        op.innerHTML = arr[j];
                                        o.appendChild(op);
                                    }
                                    $("#tbbzbm").trigger("change");
                                }
                                
                            }
                        });
                        $.ajax({
                            type: "POST",
                            url: "http://127.0.0.1:22222/api/CQYiBao/GetNewOldCard",
                            dataType: "json",
                            data: payoptype,
                            async: false,
                            success: function (data) {
                                var newoldkh = eval('(' + data + ')');
                                if (newoldkh)
                                {
                                    if (newoldkh.Code === "1" && !!newoldkh.Data) {
                                        $("#ybkhInfo").html(newoldkh.Data.ybkh);
                                        $("#sbkhInfo").html(newoldkh.Data.sbkh);
                                    }
                                }
                                
                            }
                        });

                        //$.ajax({
                        //    type: "POST",
                        //    url: "http://127.0.0.1:22222/api/CQYiBao/GetYbTbExaminationInfo",
                        //    dataType: "json",
                        //    data: { "sbkh": patsbkh },
                        //    async: false,
                        //    success: function (data) {
                        //        var TbMzReg = eval('(' + data + ')');
                        //        if (TbMzReg) {
                        //            if (TbMzReg.Code === "1" && !!TbMzReg.Data) {
                        //                
                        //                $("#tbinfo").html(data);
                                      
                        //            }
                             
                        //        }
                        //    }
                        //});


                    } else {
                        $.modalAlert("Quẹt thẻ thất bại:" + yibaoCardInfo.ErrorMsg, 'error');
                    }
                } else {
                    $.modalAlert("Quẹt thẻ lấy thông tin BHYT thất bại！Nguyên nhân thất bại：Trung tâm BHYT không trả về thông tin，Vui lòng thử lại！", 'error');
                }
            }
            else {
                $.modalAlert("Đọc thẻ thất bại:" + cqyibaoCardInfo.ErrorMsg, 'error');
            }
        }



    }


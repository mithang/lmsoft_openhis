                try {
                    //= $.guianyibao.ReadIdCard(); //Đọc thẻ chứng minh nhân dân，Trả về thông tin danh tính thẻ
                    $.ajax({
                        url: "",
                        data: {},
                        dataType: "",
                        async: false,

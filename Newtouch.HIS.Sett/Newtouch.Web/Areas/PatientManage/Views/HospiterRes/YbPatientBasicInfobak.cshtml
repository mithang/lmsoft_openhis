    //Đọc thẻ Gọi01,13Giao diện
    function GetReadCardInfo(sbkobj, boolVal) {
        if (!sbkobj && boolVal==true) {
            $.modalAlert("", '');
            return;
        }

        var cardInfo;
        var yibaoCardInfo;
        var cqcardInfo;
        var cqyibaoCardInfo;
        var patsbkh = null;
        if (sbkobj) {
            patsbkh = sbkobj;
        }
        if (!patsbkh) {
            var rzfsInfo = { "": $('').val() == "" ? "" : "" };
            $.ajax({
                type: "",
                url: "",
                dataType: "",
                data: rzfsInfo,
                async: false,
                success: function (data) {
                    cqyibaoCardInfo = eval('' + data + '');
                }
            });
        }
        else {
            cqyibaoCardInfo = { "": "", "": { "": patsbkh } };
        }

        if (cqyibaoCardInfo) {
            $.loading(false);
            if (cqyibaoCardInfo.Code === "") {
                cqcardInfo = cqyibaoCardInfo.Data; //Đối tượng phản hồi bảo hiểm y tế

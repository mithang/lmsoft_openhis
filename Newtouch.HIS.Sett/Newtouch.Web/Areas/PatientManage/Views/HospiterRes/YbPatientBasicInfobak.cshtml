                        if (!yibaoCardInfo.Data || !yibaoCardInfo.Data.patInfo || !yibaoCardInfo.Data.accountInfo) {
                            $.modalAlert("", '');
                            return;
                        }
                        cardInfo = yibaoCardInfo.Data.patInfo; //Đối tượng phản hồi bảo hiểm y tế

                        if (!!cardInfo.fsyy) {
                            $.modalAlert("" + cardInfo.fsyy, '');
                            return;
                        }
                        yibaoCardInfo.readCardCardType = $('').val();
                        yibaoCardInfo.kh = cqcardInfo.sbkh;
                        localStorage.setItem("", JSON.stringify(yibaoCardInfo));
                        //Gán giá trị

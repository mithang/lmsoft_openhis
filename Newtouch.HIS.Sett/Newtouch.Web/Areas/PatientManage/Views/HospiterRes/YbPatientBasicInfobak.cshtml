                                    }
                                    patModel.brxz = ybfyxzCompResult.Code;
                                    patModel.brxzmc = ybfyxzCompResult.Name;
                                    $("").attr("", ybfyxzCompResult.Name)
                                        .attr("", ybfyxzCompResult.Code);
                                    $("").val(ybfyxzCompResult.Name);
                                }
                            });
                        $("").html(cardInfo.prm_akc087);
                    } else {
                        $.modalAlert("" + yibaoCardInfo.ErrorMsg, '');
                    }

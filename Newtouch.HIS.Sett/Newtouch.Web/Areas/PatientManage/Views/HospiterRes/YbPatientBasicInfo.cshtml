            $('.1201-show').hide();
            $('.time-show').hide();
            $('.35-show').hide();
            $("#page_num").val(1);
            $("#page_size").val(100);
        } else if (type.startsWith("35")) {
            $('.1201-show').hide(); // Ẩn thông tin cơ sở y tế
            $('.time-show').show();
            $('.35-show').show();
            $('.3607-show').hide();
        } else if (type === "5101") {
            $('.3607-show').hide();
            $('.1201-show').hide();
            $('.time-show').hide();
            $('.35-show').hide();
        } else {
            $.modalAlert("Loại không thể nhận dạng", 'error');
        }
    }


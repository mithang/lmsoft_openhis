
@{
    ViewBag.Title = "";
    Layout = "";
}
<script>
    $(function () {
        gridList();
    });

    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            height: $(window).height() - 195,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 50, align: '' },
                {
                    label: '', name: '', width: 50, align: '',
                    formatter: function (cellvalue) {
                        return $.getGender(cellvalue);
                    }
                },
                { label: '', name: '', width: 100, align: '' },
                {
                    label: '', name: '', width: 80, align: '',
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                {
                    label: '', name: '', width: 70, align: '',
                    formatter: function (cellvalue) {
                        if (cellvalue) {
                            if (cellvalue.trim() === "") {
                                // EnumZJLX
                                return "";
                            } else if (cellvalue.trim() === "") {
                                return "";
                            } else if (cellvalue.trim() === "") {
                                return "";
                            } else {
                                return "";
                            }
                        }
                        return "";
                    }
                },
                 { label: '', name: '', width: 150, align: '' },
                 {
                     label: '', name: '', width: 50, align: '', formatter: function (cellvalue, a, b) {
                         return getAgeFromBirthTime({ begin: b.csny }).text;
                     }
                 },
                 { label: '', name: '', width: 100, align: '' },
                 { label: '', name: '', width: 100, align: '' },
                 { label: '', name: '', width: 100, align: '' },
                 { label: '', name: '', hidden: true },

            ],
            pager: "",
            sortname: '',
            rowNum: '',
            viewrecords: true
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: { keyword: $("").val(), kh: $("").val(), blh: $("").val() }
            }).trigger('');
        });
    }
</script>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>


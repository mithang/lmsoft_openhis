
@{
    ViewBag.Title = "";
    Layout = "";
}

<style>
    .table-responsive {
        border: 0px solid #ddd;
    }
</style>

<form>
    <div class="topPanel" style="border-bottom:1px solid rgb(221, 221, 221);margin-bottom: -1%;">
        <table class="form">
            <tr>
                <td style="width:2%">
                    <div class="toolbar" style="margin-top: 1%;">
                        <div class="btn-group">
                            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
                        </div>
                    </div>
                </td>
                <th class="formTitle">Số nhập viện：</th>
                <td class="formValue">
                    <input id="txt_zyh" name="txt_zyh" type="text" class="form-control" placeholder="Vui lòng nhập số nhập viện" />
                </td>
                <th class="formTitle">Họ tên：</th>
                <td class="formValue">
                    <input id="txt_xm" name="txt_xm" type="text" class="form-control" placeholder="Vui lòng nhập họ tên hoặc phiên âm đầu" />

                </td>
                <td style="padding-left:20px;" class="formValue">
                    <input type="button" id="btn_search" style="margin-left:3%; width:35%; margin-top:-2%;" class="btn btn-primary" value="Tra cứu" />
                </td>
            </tr>
        </table>
    </div>
    <!--Thông tin bệnh nhân Bao gồm số thẻ Số nhập viện  Họ tên -->
    <div id="formPatSer" class="gridPanel" style="margin-top:1%; margin-left:1%">
        <table id="patGridList"></table>
        <div id="gridPager"></div>
    </div>
</form>
<script>

    var brzybzType = $.request("");

    //Cái trướcwindowĐối tượng
    var prevWindow;

    var from = $.request("");

    if (!!from) {
        prevWindow = top.top.frames[from];
    }
    else {
        prevWindow = $.currentWindow();
    }

    $(function () {
        var obj = new Object;
        obj.zyh = $.request("");
        obj.xm = decodeURI(decodeURI($.request("")));
        var searInfo = new PatSearchInfo();
        //Tải dữ liệu
        searInfo.init(obj);

        //Tra cứu
        $("").click(function () {
            $("").jqGrid('', {
                postData: { zyh: $("").val(), xm: $("").val(), r: Math.random() },
            }).trigger('');
        });
    });

    //Enter
    $('').keydownEnterEvent(function() {
        $("").trigger('');
    });

    var PatSearchInfo = (function () {
        //Tải danh sách
        var loadGrid = function (data) {
            var $gridList = $("");
            var reqUrl = "" + brzybzType + "" + Math.random();
            $gridList.dataGrid({
                height: $(window).height() - 200,
                autowidth: false,
                width: $("").width() - 2,
                url: reqUrl,
                postData: { zyh: $("").val(), xm: $("").val() },
                caption: '',
                colModel: [
                    { label: '', name: '', hidden: true },
                    { label: '', name: '', width: 100, align: '' },
                    { label: '', name: '', width: 100, align: '', key: true },
                    { label: '', name: '', width: 100, align: '' },
                    {
                        label: '', name: '', width:70, align: '', formatter: function (cellvalue) {
                            return $.getGender(cellvalue);
                        }
                    },
                    {
                        label: '', name: '', width: 100, align: '', formatter: function (cellvalue, a, b) {
                            return getAgeFromBirthTime({ begin: b.csny }).text;
                        }
                    },
                    { label: '', name: '', width: 15, align: '' },
                    { label: '', name: '', hidden: true },
                    { label: '', name: '', hidden: true }
                ],
                pager: "",
                sortname: '',
                viewrecords: true
            });
        };

        var myPatSearchInfo = function (data) {

        }

        //Sự kiện tải
        myPatSearchInfo.prototype.init = function (data) {
            if (data.zyh === "") {
                $("").val("");
            }
            else {
                $("").val(data.zyh);
            }
            if (data.xm === "") {
                $("").val("");
            }
            else {
                $("").val(data.xm);
            }

            loadGrid(data);
        };

        return myPatSearchInfo;
    }());

    //jqGrid Nhấp đúp để chọn một dòng
    function btn_edit() {
        PatSearchConfirm();
    }

    //Xác nhận Gọi từ trang chính
    function PatSearchConfirm() {
        PatDbGrid();
    }

    function PatDbGrid() {
        var $gridList = $("");
        var kh = $gridList.jqGridRowValue().kh;
        var zyh = $gridList.jqGridRowValue().zyh;
        var xm = $gridList.jqGridRowValue().xm;
        var obj = new Object();
        obj.kh = kh;
        obj.zyh = zyh;
        obj.xm = xm;
        obj.patid = $gridList.jqGridRowValue().patid;
        obj.brxz = $gridList.jqGridRowValue().brxz;
        obj.cyzd = $gridList.jqGridRowValue().cyzd;
        if (!!!obj.zyh) {
            $.modalMsg("", "");
            return;
        }
        prevWindow.getPatInfoAjax(obj);

        //Đóng cửa sổ
        ReceiptCancle();
    }

    //Hủy
    function ReceiptCancle() {
        $.modalClose();
    }
</script>
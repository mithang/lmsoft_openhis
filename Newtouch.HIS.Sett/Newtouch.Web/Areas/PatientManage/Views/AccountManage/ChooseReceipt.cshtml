
@{
    ViewBag.Title = "";
    Layout = "";
}
 
<form id="formReceipt">
    <div style="margin-top:40px;margin-right:40px;">
        <table class="form">
            <tr>
                <th class="formTitle dialogText">Số chứng từ：</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="txtpzh" name="txtpzh" required value="">
                </td>  
            </tr> 
        </table>
        <div class="errorDiv"> 
            <span id="lblMsg"></span>
        </div>
    </div>
</form>

<script>
    $(function () { 
        var sjh = $.currentWindow().$("").val();
        if(sjh){
            $("").val(sjh);
        } else
        {
            //Lấy số chứng từ biên lai
            GetReceiptByEmpCode(); 
        }
    })

    function GetReceiptByEmpCode() {
        $.najax({
            url: "",
            dataType: "",
            async: false,
            cache: false,
            success: function (data) {  
                if (data.data) {
                    $("").val(""); 
                    $("").text(data.data);
                } 
            }
        });
    }

    //Xác nhận
    function ReceiptConfirm()
    { 
        var pzh = $("").val(); 
        if (checkPZH(pzh))
        {
            checkExitPZH(pzh);
        }
    }

    //前台验证凭证号规则
    function checkPZH(pzh)
    { 
        var szm = pzh.substring(0, 1);
        var reg = new RegExp("");
        //Không ký tự cái một thứ số hóa đơn nếu là số，Chữ cái đầu cho thì
        if (!reg.test(szm))
        {
            szm = pzh.substring(0, 1);
            if (!reg.test(pzh.substring(1,pzh.length-1)))
            { 
                var msg = "";   
                $("").text(msg); 
                return false;
             }
        }
        else
        {
            szm = "";
            if (!reg.test(pzh))
            { 
                var msg = ""; 
                $("").text(msg); 
                return false;
            }
        }
        return true;
    }

    //Số chứng từ xác minh phía máy chủ
    function checkExitPZH(pzh)
    { 
        $.najax({
            type: "",
            url: "",
            data: { pzh: pzh },
            dataType: "",
            cache: false,
            success: function (resdata) { 
                if (resdata.data) {
                    $.currentWindow().$("").val(pzh);
                    $.modalClose();
                } 
            },
            errorCallback: function (errdata) {
                $.modalClose();
            }
        });
    }

    //Hủy
    function ReceiptCancle() 
    {
        $.modalClose();
    }
</script>

@{
    ViewBag.Title = "";
    Layout = "";
}
<div class="topPanel" style="margin-bottom: 1%;">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control form-control-focus" placeholder="Vui lòng nhập số thẻ、Số nhập viện、Họ tên" style="width: 200px;">
                    </div>
                </td>
                <td style="padding-left:12px;">
                    <div class="btn-group" id="btnKeywordTypeGourp" style="margin-top:0;">
                        <button type="button" data-keywordtype="kh" class="btn active btn-default">&nbsp;Thẻ&nbsp;Số&nbsp;</button>
                        <button type="button" data-keywordtype="zyh" class="btn btn-default">Số nhập viện</button>
                        <button type="button" data-keywordtype="xm" class="btn btn-default">&nbsp;姓&nbsp;名&nbsp;</button>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>

<!--Thông tin cơ bản-->
@Html.Partial("")  
<!--Danh sách thu chi-->
<form id="formPat2"> 
        <div class="gridPanel" style="margin-top:10px;border-radius:5px;">
            <table id="gridList" rel="formPat2"></table>
        </div> 
</form>
<!--Nạp tiền tạm ứng và hoàn phí-->
@Html.Partial("")
<!--Thanh công cụ nút-->
<div class="toolbar toolbarfloat">
    <a id="acc_addMoney" class="btn btn-primary" onclick="PayDeposit()"><i class="fa fa-plus"></i> Nạp tiền</a>
    <a id="acc_reMoney" class="btn btn-primary" onclick="Refund()"><i class="fa fa-minus"></i> Hoàn tiền</a>
    <a class="btn btn-primary" onclick="newtouch_globalevent_f5()"><span class="glyphicon glyphicon-refresh"> Chọn tài khoản</span></a>
</div>
<style>
    #yeCon{
        padding-left:25px;
        color:red; 
    }
</style>

<script>
    $(function () {
        $('').on('', '', function () {
            if (!$(this).hasClass('')) {
                $(this).siblings('').removeClass('').removeClass('').addClass('');
                $(this).removeClass('').addClass('');
            }
        });
        //搜索框
        var txt_keyword = document.getElementById('');
        txt_keyword.addEventListener('', function (event) {
            event = event || window.event;
            if (event.keyCode == 13) {
                searchPatInfo();
            }
        });

        gridListData([]);
        $(window).resize(function () {
            initLayout("");
        });
    });
     

    //Enter\Sự kiện tra cứu
    function searchPatInfo() {
        $.loading(true, ""); 
        var keyword = $.trim($("").val());
        if (keyword == "") {
            $.modalAlert("", '');
            return false;
        }
        var zyh = null;
        var kh = null;
        var xm = null;
        if ($('').attr('') == '') {
            kh = keyword;
        }
        else if ($('').attr('') == '') {
            zyh = keyword;
        }
        else {
            xm = keyword;
        }
       
        var patobj = new Object();
        patobj.kh = kh;
        patobj.zyh = zyh;
        patobj.xm = xm;
        getPatInfoAjax(patobj);
    }

    //Phía máy chủajaxTra cứu dữ liệu nhân viên
    function getPatInfoAjax(patobj) { 
        $.najax({
            type: "",
            url: "",
            data: { zyh: patobj.zyh, kh: patobj.kh, xm: patobj.xm },
            dataType: "",
            cache: false,
            success: function (ajaxresp) {
                $.loading(false);
                var patInfoList = ajaxresp.data.patInfoList;
                if (patInfoList && patInfoList.length > 0) {
                    if (patInfoList.length == 1) {
                        setPatInfoModel(ajaxresp.data.patInfo);
                        gridListData(ajaxresp.data.accPayInfoList);
                    } else {
                        //cửa sổ giao diện bật lên nhân viên chọn tải
                        GetPatSerarchView(patobj.zyh, patobj.xm, patInfoList);
                    }
                }
            },
            error: function (err) {
                $.loading(false);
            },
            complete: function () {
                $.loading(false);
            }
        });
    }


    //Lấy hiển thị giao diện thông tin cơ bản bệnh nhân
    function setPatInfoModel(patModel) { 
        $('').formSerialize(patModel);
        //获取网页中的单选按钮，挑选其中name=angel，value=0của，让其选中
        //$("" + patmodel[idname] + "").attr("", '');
        $("").val($.getGender(patModel.xb));
        $("").val(patModel.xm);//Người tất cả
        $("").val((patModel.ryrq && patModel.ryrq.length >= 10 ? patModel.ryrq.substring(0, 10) : ""));
        var nl = !(patModel.csny == null || undefined) ? GetAgeByCsny(patModel.csny) : "";
        $("").val(nl);
        $("").val("");
    }

    //Danh sách thu chi tài khoản
    function gridListData(mydata) { 
        $('').jqGrid("");
        var $gridList = $("");
        var zhye = 0;
        if (mydata != [] && mydata.length > 0) {
            zhye = mydata[0].zhye;
            //zhye = zhye.toFixed(2);
        } 
        $("").val(zhye); //valueGán giá trị
        var captionCon = "";
        captionCon += "" + zhye + ""; 
        $gridList.dataNewGrid({
            height: 150, 
            autowidth: false,
            width: $("").width() - 10,
            caption: captionCon,
            colModel: [
                { label: '', name: '', hidden: true, key: true },
                { label: '', name: '', width: 105, align: ''},
                //{
                //    label: '', name: '', width: 105, align: '', formatter: function (cellvalue) {
                //        return cellvalue ? cellvalue.toFixed(2) : "";
                //      }
                //},
                {   label: '', name: '', width: 105, align: ''},
                //{
                //    label: '', name: '', width: 105, align: '', formatter: function (cellvalue) {
                //        return cellvalue ? cellvalue.toFixed(2) : "";
                //    }
                //},
                { label: '', name: '', width: 105, align: '' },
                { label: '', name: '', width: 105, align: '' },
                { label: '', name: '', width: 105, align: '' },
                { label: '', name: '', width: 200, align: '' },
                { label: '', name: '', width: 105, align: '' }
            ]
        }, mydata);
        
        if (mydata.length>0) {
            $('').find("").remove();
        }
        $("").text("" + zhye + "");
    }

    var patid,
        zyh,
        zh,
        zhxz,
        zhbh,
        zffsbh,
        zffsmc,
        zfmoney,
        pzh;
    //Đánh giá nạp tiền và hoàn tiền
    function CheckDeposit() { 
        patid = $("").val();
        zyh = $("").val();
        zh = $("").val();
        zhxz = $("").val();
        zhbh = $("").val();
        if (zyh == "" || patid == "" || zh == "" || zhbh == "" || zhxz == "") {
            $.modalAlert("", '');
            return false;
        }
        //var reg = /(^[1-9]([0-9]+)?(\.[0-9]{1,2})?$)|(^(0){1}$)|(^[0-9]\.[0-9]([0-9])?$)/;
        var reg = /^(-?\d+)(\.\d+)?$/;
        zfmoney = $("").val();
        var ddlzffs = $("");//Lấy mục đã chọn
        zffsbh = ddlzffs.val();//Lấy giá trị của mục đã chọn
        zffsmc = ddlzffs.text();//Lấy văn bản của mục đã chọn
        //pzh = $("").text();
        pzh = $("").val();
        if (zffsbh == -1 || zffsmc == "") { 
            $.modalAlert("", '');
            return false;
        }
        if (zfmoney == "" || zfmoney == undefined) {
            $.modalAlert("", '');
            return false;
        } else {
            if (!reg.test(zfmoney)) {  
                $.modalAlert("", '');
                return false;
            }
        }
        if (pzh == "" || pzh == undefined) { 
            $.modalAlert("", '');
            return false;
        }
        return true;
    }

    //充值前台验证金额和是否选择支付类型
    function PayDeposit() { 
        zfmoney = $("").val();
        if(parseFloat(zfmoney)<0)
        {
            $.modalAlert("", ''); 
            return false;
        }
        if (CheckDeposit())
        {
            PayDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid, zyh, zh, zhxz, zhbh); 
        }
    }

    //Nạp tiền tạm ứng
    function PayDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid, zyh, zh, zhxz, zhbh)
    {
        $.loading(true, "");
        $.najax({
            type: "",
            url: "",
            data: { zffsbh: zffsbh, zffsmc: zffsmc, zfje: zfmoney, pzh: pzh, zhbh: zhbh, zh: zh,zhxz:zhxz, patid: patid, zyh: zyh },
            dataType: "",
            cache: false,
            success: function (resdata) {
                if (resdata!=null && resdata.data)
                {
                    $.loading(false);
                    $.modalAlert("", ''); 
                    ClearMoney(); //Xóa trống
                    getZhInfo(zh); //Bản ghi thu chi tài khoản
                }
            },
            errorCallback: function (err) { 
                //$.modalAlert("", '');
                $.loading(false);
            },
            complete: function () {
                $.loading(false);
            }
        }); 
    }
 

    //Xóa trống
    function ClearMoney() {
        $('').jqGrid("");
        //Xóa trống hộp nhập số tiền
        $("").val("");
        //Ngày chứng từ
        var d = new Date();
        var date = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate();
        $("").val(date);
        //Lấy số chứng từ
        GetSJPZH();
    }

    //Lấy số chứng từ
    function GetSJPZH() {
        $.ajax({
            type: "",
            url: "",
            data: { },
            dataType: "",
            cache: false,
            success: function (resdata) {
                if (resdata != null && resdata.data != "") {
                    $("").val(resdata.data);
                    return resdata.data;
                } else {
                    $("").val("");
                    return "";
                }
            }
        });
    }

    //Tra cứu nhân viên
    function GetPatSerarchView(zyh, xm, infoList) {
        var encodexm = encodeURI(encodeURI(xm));
        if (infoList) {
            $.modalOpen({
                id: "",
                title: "",
                url: "" + Math.random() + "" + zyh + "" + encodexm,
                width: "",
                height: "",
                callBack: function (iframeId) { 
                    top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
                }//Hàm callback xác nhận khi nhấn cửa sổ
            });
        } else {
            $.modalAlert("", '');
            $("").focus();
        }
    }

    var gridIMoney = "";//số tiền thu chi của đã chọn hiện tại
    var gridIpzh = ""; //số chứng từ của đã chọn hiện tại
    //点击双击事件
    function btn_edit() {
        var szje = $("").jqGridRowValue().szje;
        var pzh = $("").jqGridRowValue().pzh;
        gridIMoney = szje;
        gridIpzh = pzh;
        if (parseFloat(gridIMoney)>0)
        {
            $("").val(-szje);
        } else
        {
            gridIMoney = -szje;
            $("").val(szje);
        }
        //$("").text(pzh);
        $("").val(pzh);
    }

    //Hoàn tiền
    function Refund()
    { 
        var money = $("").val();
        //var pzh = $("").text();
        var pzh = $("").val();
        var zhye = $("").val();
        if(parseFloat(money)+parseFloat(gridIMoney)<0){ 
            $.modalAlert("", '');
            return false;
        }
        if (parseFloat(money) + parseFloat(zhye) < 0) {
            $.modalAlert("", ''); 
            return false;
        }
        if (parseFloat(money) > 0)
        {
            $.modalAlert("", ''); 
            return false;
        } 
        if (gridIpzh == "" || pzh != gridIpzh)
        {
            $.modalAlert("", ''); 
            return false; 
        }
        if (CheckDeposit())
        { 
            ExitDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid, zyh, zh, zhxz, zhbh);
        }
    }


    //Hoàn tiền
    function ExitDepositPost(zffsbh, zffsmc, zfmoney, pzh, patid, zyh, zh, zhxz, zhbh) {
        $.loading(true, "");
        $.najax({
            type: "",
            url: "",
            data: { zffsbh: zffsbh, zffsmc: zffsmc, zfje: zfmoney, pzh: pzh, zhbh: zhbh, zh: zh, zhxz: zhxz, patid: patid, zyh: zyh },
            dataType: "",
            cache: false,
            success: function (resdata) {
                if (resdata != null && resdata.data) {
                    $.loading(false); 
                    $.modalAlert("", '');
                    ClearMoney();
                    //Gọi danh sách thu chi tài khoản
                    getZhInfo(zh);
                    
                }
            },
            errorCallback: function (err) { 
                $.loading(false);
            },
            complete: function () {
                $.loading(false);
            }
        });
    }

    //Tra cứu tài khoản
    function getZhInfo() {
        //GetBasicZhInfoJson
        $.loading(true, "");
        $.najax({
            type: "",
            url: "",
            data: {zh: zh},
            dataType: "",
            cache: false,
            success: function (resdata) { 
                if (resdata != null && resdata.data) {
                    $.loading(false);
                    gridListData(resdata.data);
                }
            },
            errorCallback: function (err) {
                $.loading(false);
            },
            complete: function () {
                $.loading(false);
            }
        });
    }



    //Lại tra cứu
    function searchPatInfoAgin() {
        //Gọi danh sách thu chi tài khoản
        var obj = new Object();
        obj.zyh = $("").val();
        obj.kh = $("").val();
        obj.xm = $("").val();
        getPatInfoAjax(obj); //Lại gọi tra cứu
    }
</script>

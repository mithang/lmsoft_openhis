
@{
    ViewBag.Title = "";
    Layout = "";
}

<style>
    .table-responsive {
        border: 0px solid #ddd;
    }
</style>

<form>
    <div class="topPanel" style="border-bottom:1px solid rgb(221, 221, 221);margin-bottom: -1%;">
        <table class="form">
            <tr>
                <td style="width:2%">
                    <div class="toolbar" style="margin-top: 1%;">
                        <div class="btn-group">
                            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
                        </div>
                    </div>
                </td>
                <th class="formTitle">Số bệnh án：</th>
                <td class="formValue">
                    <input id="txt_blh" name="txt_blh" type="text" class="form-control" placeholder="Vui lòng nhập số bệnh án" />
                </td>
                <th class="formTitle">Họ tên：</th>
                <td class="formValue">
                    <input id="txt_xm" name="txt_xm" type="text" class="form-control" placeholder="Vui lòng nhập họ tên" />

                </td>
                <td style="padding-left:20px;" class="formValue">
                    <input type="button" id="btn_search" style="margin-left:3%; width:35%; margin-top:-2%;" class="btn btn-primary" value="Tra cứu" />
                </td>
            </tr>
        </table>
    </div>
    <!--Thông tin bệnh nhân Bao gồm số thẻ Số bệnh án Họ tên -->
    <div id="formPatSer" class="gridPanel" style="margin-top:1%; margin-left:1%">
        <table id="patGridList"></table>
        <div id="gridPager"></div>
    </div>
</form>

<script>

    //Cái trướcwindowĐối tượng
    var prevWindow;

    var from = $.request("");
    if (!!from) {
        prevWindow = top.top.frames[from];
    }
    else {
        prevWindow = $.currentWindow();
    }

    $(function () {
        var obj = new Object;
        obj.blh = $.request("");
        obj.xm = $.request("");
        var searInfo = new PatSearchInfo();
        //Tải dữ liệu
        searInfo.init(obj);

        //Tra cứu
        $("").click(function () {
            $("").jqGrid('', {
                postData: { blh: $("").val(), xm: $("").val(), r: Math.random() },
            }).trigger('');
        });
    });

    //Enter
    $('').keydownEnterEvent(function () {
        $("").trigger('');
    })

    var PatSearchInfo = (function () {
        //Tải danh sách
        var loadGrid = function (data) {
            var $gridList = $("");
            $gridList.dataGrid({
                height: $(window).height() - 200,
                autowidth: false,
                width: $("").width() - 2,
                url: ""+ Math.random(),
                postData: { blh: $("").val(), xm: $("").val() },
                caption: '',
                colModel: [
                    { label: '', name: '', width: 130, align: '',hidden:true },
                    { label: '', name: '', width: 150, align: '' },
                    { label: '', name: '', width: 140, align: '' },
                    {
                        label: '', name: '', width:70, align: '', formatter: function (cellvalue) {
                            return $.getGender(cellvalue);
                        }
                    },
                    {
                        label: '', name: '', width: 100, align: '', formatter: function (cellvalue, a, b) {
                            //return getAgeFromBirthTime({ begin: b.csny }).text;
                            return '';
                        }
                    },
                ],
                pager: "",
                sortname: '',
                viewrecords: true
            });
        };
        var myPatSearchInfo = function (data) {

        }
        //Sự kiện tải
        myPatSearchInfo.prototype.init = function (data) {
            if (!data.blh || data.blh === "") {
                $("").val("");
            } else {
                $("").val(data.blh);
            }
            if (!data.xm || data.xm === "") {
                $("").val("");
            } else {
                $("").val(data.xm);
            }

            loadGrid(data);
        };

        return myPatSearchInfo;
    }());

    //jqGrid Nhấp đúp để chọn một dòng
    function btn_edit() {
        PatSearchConfirm();
    }

    //Xác nhận Gọi từ trang chính
    function PatSearchConfirm() {
        PatDbGrid();
    }

    //双击
    function PatDbGrid() {
        var $gridList = $("");
        var patId = $gridList.jqGridRowValue().patId;
        var blh = $gridList.jqGridRowValue().blh;
        var xm = $gridList.jqGridRowValue().xm;
        var nlshow = $gridList.jqGridRowValue().nlshow;
        var obj = new Object();
        obj.patId = patId;
        obj.blh = blh;
        obj.xm = xm;
        obj.nlshow = nlshow;
        if (!!!obj.blh) {
            $.modalMsg("", "");
            return;
        }
        prevWindow.getPatInfoAjax(obj);

        //Đóng cửa sổ
        ReceiptCancle();
    }

    //Hủy
    function ReceiptCancle() {
        $.modalClose();
    }


</script>


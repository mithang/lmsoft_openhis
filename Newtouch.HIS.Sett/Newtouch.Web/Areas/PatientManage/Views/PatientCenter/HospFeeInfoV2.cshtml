
@{

    Layout = null;
}



<div style="padding-left:10px;">
    <table id="gridzdList"></table>
    <div id="gridzdPager"></div>
</div>




<script>
    $(function () {

        ZdListGrid();

    })

    function ZdListGrid() {
        var $gridList = $("");
        $gridList.dataGrid({
            postData: {

                //zyh: $("").text(),
                //zyh: $("").val(),
                zyh: "",
            },
            url: "",
            autowidth: true,
            height: $(window).height() - 120,
            colModel: [
                { label: "", name: "", hidden: true },
                //{
                //    label: "", name: "", width: 60, align: '', formatter: function (row, option, data) {
                //        debugger
                //        return '' + option.rowid + '';
                //    }
                //},
                //{ label: "", name: "", width: 60, align: '', editor: "" },
                { label: "", name: "", width: 60, align: '', editor: "" },
                { label: "", name: "", width: 180, align: '', editor: "" },
                { label: "", name: "", width: 100, align: '', editor: "" },
                { label: "", name: "", hidden: true },
                { label: "", name: "", width: 80, align: '', editor: "" },
                { label: "", name: "", hidden: true },
                { label: "", name: "", width: 60, align: '', editor: "" },
                { label: "", name: "", hidden: true },
                {
                    label: "", name: "", width: 80, align: '', editor: "", formatter: function (row, option, data) {
                        if (data.ZDOrder == 1) {
                            return "";
                        }
                        else
                            return "";
                    }
                },
                { label: "", name: "", hidden: true },
                {
                    label: "", name: "", width: 80, align: '', editor: "", formatter: function (row, option, data) {
                        if (data.zt == "") {
                            return "";
                        }
                        else {
                            return "";
                        }
                    }
                }
            ],
            sortname: "",
            rowNum: 15,
            pager: "",
            viewrecords: false

        });
        jQuery("").jqGrid('');

    }


</script>


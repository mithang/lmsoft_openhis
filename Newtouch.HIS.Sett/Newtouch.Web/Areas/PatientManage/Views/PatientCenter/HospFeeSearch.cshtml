@{
    Layout = null;
}
<div style="padding-left:10px;">
    <table id="gridFeeList"></table>
    <table id="gridFeeIDetail"></table>
</div>

<script>
    var _zyh = "";
    var gridFeeList = $("");
    var gridFeeListHight = 0;
    var gridFeeIDetailHight = 0;

    function AdaptiveResolution() {
        gridFeeListHight = $(window).height() - 450;
        gridFeeIDetailHight = $(window).height() - gridFeeListHight - 230;
    }

    AdaptiveResolution();
    // 在窗口大小改变时监听resizeSự kiện cập nhật vàdivchiều cao
    $(window).on('', function () {
        AdaptiveResolution();
        FeeGrid(_zyh)
    });

    function FeeGrid(zyh_) {
        var captionCon = "" + "" + "";
        _zyh = zyh_;
        gridFeeList.dataGrid({
            caption: captionCon,
            height: gridFeeListHight,
            colModel: [
                {
                    label: '', name: '', width: 80, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' },
                    cellattr: function (rowId, cellValue, rawObject, cellText, rowData) {
                        return '' + rawObject.Sfrq + '' + "" + '';
                    }
                },
                {
                    label: '', name: '', width: 80, align: '', formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' },
                    cellattr: function (rowId, cellValue, rawObject, cellText, rowData) {
                        return '' + rawObject.Sfrq + '' + rawObject.CWDlCode + '';
                    }
                },
                {
                    label: '', name: '', width: 80, align: '', formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' },
                    cellattr: function (rowId, cellValue, rawObject, cellText, rowData) {
                        return '' + rawObject.Sfrq + '' + rawObject.HLDlCode + '';
                    }
                },
                {
                    label: '', name: '', width: 80, align: '', formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' },
                    cellattr: function (rowId, cellValue, rawObject, cellText, rowData) {
                        return '' + rawObject.Sfrq + '' + rawObject.ZLDlCode + '';
                    }
                },
                {
                    label: '', name: '', width: 70, align: '', formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' },
                    cellattr: function (rowId, cellValue, rawObject, cellText, rowData) {
                        return '' + rawObject.Sfrq + '' + rawObject.QTDlCode + '';
                    }
                },
                {
                    label: '', name: '', width: 80, align: '', formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' },
                    cellattr: function (rowId, cellValue, rawObject, cellText, rowData) {
                        return '' + rawObject.Sfrq + '' + rawObject.XYDlCode + '';
                    }
                },
                {
                    label: '', name: '', width: 60, align: '', formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' },
                    cellattr: function (rowId, cellValue, rawObject, cellText, rowData) {
                        return '' + rawObject.Sfrq + '' + rawObject.ZCYDlCode + '';
                    }
                },
                {
                    label: '', name: '', width: 60, align: '', formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' },
                    cellattr: function (rowId, cellValue, rawObject, cellText, rowData) {
                        return '' + rawObject.Sfrq + '' + rawObject.HYDlCode + '';
                    }
                },
                {
                    label: '', name: '', width: 60, align: '', formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' },
                    cellattr: function (rowId, cellValue, rawObject, cellText, rowData) {
                        return '' + rawObject.Sfrq + '' + rawObject.JCDlCode + '';
                    }
                },
                {
                    label: '', name: '', width: 60, align: '', formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' },
                    cellattr: function (rowId, cellValue, rawObject, cellText, rowData) {
                        return '' + rawObject.Sfrq + '' + rawObject.CLDlCode + '';
                    }
                },
                {
                    label: '', name: '', width: 70, align: '', formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }
                },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
            ],
            viewrecords: true,
            ondblClickRow: function (rowIndex, s) {
                //getItemsbySfdl(rowIndex);
            },
            onSelectRow_page: function (rowid) {
                //btn_selectrow(rowid);
            },
            gridComplete: function () {
                getFeeZje();
            },
        });
        gridFeeList.jqGrid('', {
            postData: {
                zyh: zyh_
            },
            url: "" + Math.random(),
        }).trigger('');
        $('').jqGrid("");//Mỗi lần nhấn chuột，Xóa trống chi tiết trước đó trước và tổng cộng
    }

    function cellClickHandler(sfrq, dlCode) {
        $('').jqGrid("");//Mỗi lần nhấn chuột，Xóa trống chi tiết trước đó trước và tổng cộng
        $.najax({
            type: "",
            url: "",
            data: { zyh: _zyh, dlCode: dlCode, sfrq: sfrq },
            dataType: "",
            success: function (ajaxresp) {
                $('').newtouchLocalDataGrid(null, ajaxresp);
            }
        });
    }

    //Quyết toán chi tiết nhóm lớn jGridKhai báo
    $('').newtouchLocalDataGrid({
        height: gridFeeIDetailHight,
        caption: "",
        unwritten: false,
        colModel: [
            {
                label: '', name: '', width: 80, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' }
            },
            { label: '', name: '', width: 80, align: '' },
            { label: '', name: '', width: 80, align: '' },
            { label: '', name: '', width: 80, align: '' },
            { label: '', name: '', width: 60, align: '' },
            { label: '', name: '', width: 50, align: '' },
            { label: '', name: '', width: 50, align: '' },
            { label: '', name: '', width: 70, align: '' },
            { label: '', name: '', width: 60, align: '' },
            { label: '', name: '', width: 60, align: '' },
            { label: '', name: '', width: 50, align: '' },
            { label: '', name: '', width: 60, align: '' },
            { label: '', name: '', width: 80, align: '' },
            { label: '', name: '', width: 80, align: '' },
            {
                label: '', name: '', width: 80, align: '', formatter: function (cellvalue) {
                    return cellvalue ? cellvalue.toFixed(2) : "";
                }
            },
        ],
        viewrecords: true,
        ondblClickRow: function (row) {
            btn_clickrow();
        }
    });

    //Tổng số tiền
    function getFeeZje() {
        var zje = 0;
        var ids = gridFeeList.getDataIDs();//Bảng dữ liệu trả vềIDMảng["",""..]
        for (var i = 0; i < ids.length; i++) {
            var rowData = gridFeeList.getRowData(ids[i]);
            if (!!rowData.HJ) {
                zje += parseFloat(rowData.HJ);
            }
        }
        $("").text(parseFloat(zje).toFixed(2));
    }
</script>



@{
    Layout = null;
}
<div>
    <table id="gridListpresett"></table>
</div>
<div id="dv_settpre" style="border:1px solid #ff6a00;border-radius:5px;">
    <table class="form" style="margin:5px 5px;">
        <tr style="border-bottom:1px solid #ddd0d0;border-bottom-left-radius:5px;border-bottom-right-radius:5px;color:#ff0000;font-weight:bold;">
            <th class="formTitle">预结算操作时间：</th>
            <td class="formValue" colspan="2"><label id="lbpre_czrq"></label></td>
            <th class="formTitle"></th>
            <td class="formValue"></td>
            <th class="formTitle"></th>
            <td class="formValue"></td>
        </tr>
        <tr>
            <th class="formTitle">Tổng chi phí：</th>
            <td class="formValue">￥<label id="lbpre_medfee_sumamt">0.00</label></td>
            <th class="formTitle">Tổng thanh toán tiền mặt：</th>
            <td class="formValue">￥<label id="lbpre_xjzf">0.00</label></td>
            <th class="formTitle">Tính phí tiền mặt ngoài bảo hiểm y tế：</th>
            <td class="formValue">￥<label id="lbpre_fybxjzf">0.00</label></td>

        </tr>
        <tr>
            <th class="formTitle">Tính phí tiền mặt bảo hiểm y tế：</th>
            <td class="formValue">￥<label id="lbpre_psn_cash_pay">0.00</label></td>
            <th class="formTitle">Thanh toán chung：</th>
            <td class="formValue">￥<label id="lbpre_hifp_pay">0.00</label></td>
            <th class="formTitle">Trợ cấp công chức：</th>
            <td class="formValue">￥<label id="lbpre_cvlserv_pay">0.00</label></td>
        </tr>
        <tr>
            <th class="formTitle">Thanh toán tài khoản：</th>
            <td class="formValue">￥<label id="lbpre_acct_pay">0.00</label></td>
            <th class="formTitle">单病种医疗垫支：</th>
            <td class="formValue">￥<label id="lbpre_hosp_part_amt">0.00</label></td>

            <th class="formTitle">Thanh toán bồi thường lớn：</th>
            <td class="formValue">￥<label id="lbpre_hifob_pay">0.00</label></td>
        </tr>
        <tr>
            <th class="formTitle">Chi bảo hiểm y tế doanh nghiệp：</th>
            <td class="formValue">￥<label id="lbpre_hifes_pay">0.00</label></td>
            <th class="formTitle">Chi bệnh nặng dân cư：</th>
            <td class="formValue">￥<label id="lbpre_hifmi_pay">0.00</label></td>
            <th class="formTitle">Chi quỹ cứu trợ y tế：</th>
            <td class="formValue">￥<label id="lbpre_maf_pay">0.00</label></td>
        </tr>
        <tr>
            <th class="formTitle">Thanh toán chung tài khoản：</th>
            <td class="formValue">￥<label id="lbpre_acct_mulaid_pay">0.00</label></td>
            <th class="formTitle">Khác：</th>
            <td class="formValue">￥<label id="lbpre_oth_pay">0.00</label></td>
            <th class="formTitle">Số tiền phù hợp phạm vi chính sách：</th>
            <td class="formValue">￥<label id="lbpre_inscp_scp_amt">0.00</label></td>
        </tr>
        <tr>
            <th class="formTitle">Mức khởi trả thanh toán thực tế：</th>
            <td class="formValue">￥<label id="lbpre_act_pay_dedc">0.00</label></td>
        </tr>
    </table>
</div>

<script>
    $(function () {

    });
    function gridListPresett(zyh) {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            postData: { zyh: zyh },
            height: 200,
            colModel: [
                { label: '', name: '', hidden: true },
                {
                    label: '', name: '', width: 120, align: '',
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                { label: '', name: '', width: 80, align: '' },
                {
                    label: '', name: '', width: 50, align: '',
                    formatter: function (cellvalue, options, rowObject) {
                        if (cellvalue && cellvalue=="") {
                            return "";
                        }
                        else {
                            return "";
                        }
                    }
                },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 80, align: '' }
            ],
            onSelectRow: function (rowIndex, s) {
                getPresettInfo();
            },
            gridComplete: function () {
                var ids = $('').getDataIDs();//Bảng dữ liệu trả vềIDMảng["",""..] 
                var rowData = $("").getRowData(ids[0]);
                getPresettInfo(rowData.prejs_id);
            },
            caption:""
        });
    }

    function getPresettInfo(presettid) {
        var keyValue = "";
        if (!presettid) {
            keyValue = $("").jqGridRowValue().prejs_id;
        }
        else {
            keyValue = presettid;
        }

        if (!keyValue) {
            $.modalAlert("", '');      
        }
        $.najax({
            url: "",
            data: { presettid: keyValue },
            dataType: "",
            async: false,
            success: function (data) {
                if (data != null) {
                    for (var e in data) {
                        if (!!$("" + e) && data[e] != null) {
                            if (data[e] === 0) {
                                $("" + e).html("");
                            }
                            else if (e == "") {
                                var text = $.getTime({ date: data[e] });
                                $("" + e).html(text);
                            }
                            else if (!!parseFloat(data[e])) {
                                $("" + e).html(parseFloat(data[e]).toFixed(2));
                            }
                            else {
                                $("" + e).html(data[e]);
                            }
                        }
                    }
                }
                $("").html((parseFloat(data.psn_cash_pay) + parseFloat(data.medfee_sumamt) - parseFloat(data.medfee_sumamt)).toFixed(2));
                $("").html((parseFloat(data.medfee_sumamt) - parseFloat(data.medfee_sumamt)).toFixed(2));
            }
        });
    }


</script>


<script>
    $(function () {
        $("").click(function () {
            //Làm mới thông tin quyết toán
            $("").jqGrid('', {
                postData: { zyh: $("").text(), jsxz: $("").val() }
            }).trigger('');
            $("").each(function () {
                $(this).html("");
            });
        });
    });
    function gridListSett(zyh) {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            postData: { zyh: zyh },
            height: 200,
            colModel: [
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                {
                    label: '', name: '', width: 120, align: '',
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                { label: '', name: '', width: 80, align: '' },
                //{ label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                {
                    label: '', name: '', width: 80, align: '', formatter: function (val) {
                        return $.enum.getDescByValue("", val);
                    }
                },
                {
                    label: '', name: '', width: 80, align: '', formatter: function (val) {
                        if (val == "") {
                            return "";
                        }
                        else 
                            return "";
                    }
                },
                { label: '', name: '', width: 100, align: '' },
                //{ label: '', name: '', width: 80, align: '' },
                //{ label: '', name: '', width: 80, align: '' }
            ],
            ondblClickRow: function (rowIndex, s) {
                getSettInfo();
            },
            //gridComplete: function () {
            //    var ids = $('').getDataIDs();//Bảng dữ liệu trả vềIDMảng["",""..] 
            //    var rowData = $("").getRowData(ids[0]);
            //    getSettInfo(rowData.jsnm, rowData.setl_id);
            //},
            //caption: ""
        });
    }
    function getSettInfo(jsnm, settid) {
        var setttime = "";
        if (!jsnm) {
            jsnm = $("").jqGridRowValue().jsnm;
            settid = $("").jqGridRowValue().setl_id;
            setttime = $("").jqGridRowValue().setl_time;
        }

        if (!jsnm) {
            $.modalAlert("", '');
        }
        $.najax({
            url: "",
            data: { jsnm: jsnm, settid: settid },
            dataType: "",
            async: false,
            success: function (data) {
                if (data != null) {
                    for (var e in data) {
                        if (!!$("" + e) && data[e] != null) {
                            if (data[e] === 0) {
                                $("" + e).html("");
                            }
                            else if (e == "" && !setttime) {
                                var text = $.getTime({ date: data[e] });
                                $("" + e).html(text);
                            }
                            else if (!!parseFloat(data[e])) {
                                $("" + e).html(parseFloat(data[e]).toFixed(2));
                            }
                            else {
                                $("" + e).html(data[e]);
                            }
                        }
                    }
                }
                if (!!settid) {
                    $("").html((parseFloat(data.psn_cash_pay) + parseFloat(data.medfee_sumamt) - parseFloat(data.medfee_sumamt)).toFixed(2));
                    $("").html((parseFloat(data.medfee_sumamt) - parseFloat(data.medfee_sumamt)).toFixed(2));
                }
                $("").html(setttime);
            }
        });
    }

</script>
    function gridListAccount(zyh) {
            $.ajax({
                url: "",
                dataType: "",
                async: false,
                data: { "": zyh },
                //data: { "": "" },
                type: "",
                success: function (mydata) {
                    $('').jqGrid("");
                    var $gridList = $("");
                    var zhye = "";
                    if (mydata != [] && mydata.length > 0) {
                        zhye = mydata[0].zhye.toFixed(2);
                    }
                    var captionCon = "";
                    captionCon += '';
                    captionCon += '';
                    captionCon += "" + zhye + "";
                    $gridList.dataNewGrid({
                        height: $(window).height() - 160,
                        autowidth: true,
                        //width: $(window).width() + 10,
                        caption: captionCon,
                        colModel: [
                            { label: '', name: '', width: 110, formatter: "", align: '' },
                            { label: '', name: '', width: 110, formatter: "", align: '' },
                            { label: '', name: '', width: 150, align: '' },
                            { label: '', name: '', width: 110, align: '' },
                            { label: '', name: '', width: 120, align: '' },
                            { label: '', name: '', width: 180, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
                            {
                                label: '', name: '', width: 110, align: '',
                                formatter: function (val) {
                                    return $.enum.getDescByValue("", val)
                                }
                            }, { label: '', name: '', hidden: true },
                            { label: '', name: '', hidden: true },
                        ],
                        gridComplete: function () {
                            var ids = $gridList.getDataIDs();
                            for (i = 0; i < ids.length; i++) {
                                var rowData = $gridList.getRowData(ids[i]);
                                if (rowData && rowData.szxz == "") {
                                    $gridList.find('' + ids[i] + '').css("", "");
                                } else if (rowData && rowData.szxz == "") {
                                    $gridList.find('' + ids[i] + '').css("", "");
                                }
                            }
                        },
                        onSelectRow: function (rowid, status) {
                            btn_edit();
                        }
                        //, gridComplete: function () {
                        //    $("").width($("").width());

                        //}
                    }, mydata);

                    if (mydata.length > 0) {
                        $('').find("").remove();
                    }
                    $("").text("" + zhye + "");
                },
            })

        }




    </script>

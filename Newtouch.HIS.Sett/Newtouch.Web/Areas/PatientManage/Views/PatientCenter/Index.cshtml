<script>
    var zyh = $.request("");
    debugger;
    $(function () {
        $("").height(window.innerHeight-90);
        tabInit();
        $.najax({
            url: "",
            data: { zyh: zyh },
            dataType: "",
            success: function (data) {
                if (data != null && !!data.zyh) {
                    debugger
                    GetPatQueryAjax({ patid: data.patid, zyh: data.zyh });  
                }
                else {
                    $.modalAlert("", '');
                }
                if (data.zybz == "" || data.zybz == "") {
                    $("").hide();
                }
            }
        });
    });
    function getHistory() {
        alert("")
    }
    //tabKhởi tạo
    function tabInit() {
        $('').on('', function (e) {
            switch ($(this).attr('')) {
                case "": 
                    $("").show();
                    $("").hide();
                    $("").hide();
                    $("").hide();
                    $("").hide();
                    FeeListGrid("","");
                    break;
                case "":
                    $("").hide();
                    $("").show();
                    $("").hide();
                    $("").hide();
                    $("").hide();
                    ZdListGrid($("").text());
                   break;
                case "":
                    $("").hide();
                    $("").hide();
                    $("").show();
                    $("").hide();
                    $("").hide();
                    gridListAccount($("").text());
                    break;
                case "":
                    $("").hide();
                    $("").hide();
                    $("").hide();
                    $("").show();
                    $("").hide();
                    gridListPresett($("").text());
                    break;
                case "":
                    $("").hide();
                    $("").hide();
                    $("").hide();
                    $("").hide();
                    $("").show();
                    gridListSett($("").text());
                    break;
            }

        });

        $('').trigger('');
    }


    //Tra cứu nhân viên
    function GetPatSerarchView(blh) {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + Math.random() + "" + blh,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
            }
        });
    }

    function GetPatQueryAjax(obj) {
        PatinfoClear();
        if (obj != null && !!obj.zyh) {
            $.najax({
                url: "",
                data: { patid: obj.patid, zyh: obj.zyh },
                dataType: "",
                async: false,
                success: function (data) {
                    if (data != null) {
                        for (var e in data) {
                            if (!!$("" + e) && data[e] != null) {
                                if (e == "") {                        
                                    $("" + e).html($.enum.getDescByValue("", data[e]));
                                }
                                else if (e == "") {
                                    $("" + e).html($.enum.getDescByValue("", data[e]));
                                    if (data[e] == '' || data[e] == '') {
                                        $("").hide();
                                    }
                                    else {
                                        $("").show();
                                    }
                                }
                                else if (e == "") {
                                    var cyjdrq = data.cyjdrq2 != null ? data.cyjdrq2 : data.cqsj;
                                    $("").html(cyjdrq);
                                }
                                else if (data[e] === 0)
                                {
                                    $("" + e).html("");
                                }
                                else {
                                    $("" + e).html(data[e]);
                                }
                            }
                        }                          
                    }
                    
                }
            });

            //Làm mới tra cứu giao dịch bảo hiểm y tế
            $("").jqGrid('', {
                postData: { zyh: obj.zyh }
            }).trigger('');
            //Làm mới thông tin quyết toán
            $("").jqGrid('', {
                postData: { zyh: obj.zyh }
            }).trigger('');
            $("").jqGrid('', {
                postData: { zyh: obj.zyh,group:"" }
            }).trigger('');

            $('').trigger('');
        }
         
    }

    function PatinfoClear() {
        $("").each(function () {
            $(this).html("");
        });
        $("").each(function () {
            $(this).html("");
        });
        $("").each(function () {
            $(this).html("");
        });
        $("").html("");
    }
</script>


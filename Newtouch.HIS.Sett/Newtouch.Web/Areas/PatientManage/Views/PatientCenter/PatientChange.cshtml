
@{
    ViewBag.Title = "";
    Layout = "";
    var from = (ViewBag.from as string) ?? "";
}
<style>
    .table-responsive {
        border: 0;
    }

    .ui-jqgrid .ui-jqgrid-pager .ui-pager-table {
        width: 90%;
    }
</style>

<div class="topPanel" style="border-bottom:1px solid rgb(221, 221, 221);margin-bottom: 1%;">
    <div class="search">
        <table class="form">
            <tr>
                <th class="formTitle">Số bệnh án/Họ tên：</th>
                <td class="formValue" colspan="2">
                    <input id="txt_keyword" name="txt_keyword" type="text" class="form-control form-an" placeholder="Vui lòng nhập số bệnh án/Họ tên/首拼" />
                </td>
                <th class="formTitle">Số ngoại trú：</th>
                <td class="formValue">
                    <input id="txt_mzh" name="txt_mzh" type="text" class="form-control form-an" placeholder="Vui lòng nhập số ngoại trú" />
                </td>
                <th class="formTitle">Số nhập viện：</th>
                <td class="formValue">
                    <input id="txt_zyh" name="txt_zyh" type="text" class="form-control form-an" placeholder="Vui lòng nhập số nhập viện" />
                </td>
                @*<th class="formTitle">Họ tên：</th>
                <td class="formValue">
                    <input id="txt_xm" name="txt_xm" type="text" class="form-control form-an form-an-end" placeholder="Vui lòng nhập họ tên hoặc phiên âm đầu" />
                </td>*@
                <td style="padding-left: 20px;">
                    <button type="button" id="btn_search" class="btn btn-primary btn-md">&nbsp;Tra cứu&nbsp;</button>
                </td>
            </tr>
            <tr>

            </tr>
        </table>
    </div>
</div>
<!--Thông tin bệnh nhân Bao gồm số bệnh án  Họ tên -->
<form id="formPatSer" style="margin:2px;margin-top:10px;">
    <div class="gridPanel">
        <table id="patGridList" rel="formPatSer"></table>
        <div id="gridPagerpat" style="padding-right:20%"></div>
    </div>
</form>

<script>
    var ywlx = $.request("");
    var zyh = "";
    var mzh = "";
    //Cái trướcwindowĐối tượng
    var prevWindow;
    var patcenter;
    if ('' !== '') {
        prevWindow = top.top.frames[''];
    }
    else {
        prevWindow = $.currentWindow();
    }

    $(function () {

        var obj = new Object;
        obj.blh = $.request("");
        obj.ywlx = ywlx;
        var searInfo = new PatSearchInfo();
        //Tải dữ liệu
        searInfo.init(obj);

        //$('').keyupEnterEvent(function () {
        //    $('').trigger('');
        //});
        if (ywlx == "") {
            zyh = $("").val();
        }
        getPatientlist();
        //Tra cứu
        $("").click(function () {
            getPatientlist();
            //$("").jqGrid('', {
            //    postData: getPostdata(),
            //    page: 1,
            //    url: ""
            //}).trigger('');
        });
    });
    var PatSearchInfo = (function () {
        //Tải danh sách
        var loadGrid = function (data) {
            var $gridList = $("");
            $gridList.dataGrid({
                datatype: '',
                altRows: true,
                height: $(window).height() - 200,
                autowidth: false,
                width: $("").width() - 10,
                //url: "",
                postData: getPostdata(),
                caption: '',
                colModel: [
                    { label: '', name: '', hidden: true, key: true },
                    { label: '', name: '', width: 60, align: '' },
                    { label: '', name: '', width: 60, align: '' },
                    { label: '', name: '', width: 60, align: '' },
                    {
                        label: '', name: '', width: 60, align: '', formatter: function (cellvalue) {
                            return $.enum.getDescByValue("", cellvalue);
                        }
                    },
                    { label: '', name: '', width: 120, align: '' },
                    { label: '', name: '', hidden: true, width: 120, align: '' },
                    {
                        label: '', name: '', width: 70, align: '', formatter: function (cellvalue) {
                            return $.getGender(cellvalue);
                        }
                    },
                    {
                        label: '', name: '', width: 50, align: ''
                    },
                    { label: '', name: '', width: 100, align: '' },
                     { label: '', name: '', hidden: true }
                ],
                pager: "",
                sortname: '',
                viewrecords: true,
                rowNum: 1000,
                rowList: [1000]
            });

            
        };

        var myPatSearchInfo = function (data) {

        }

        //Sự kiện tải
        myPatSearchInfo.prototype.init = function (data) {
            if (data.blh === "") {
                $("").val("");
            } else {
                $("").val(data.blh);
            }
            loadGrid(data);
        };
        return myPatSearchInfo;
    }());

    //jqGrid Nhấp đúp để chọn một dòng
    function btn_edit() {
        PatSearchConfirm();
    }

    function PatDbGrid() {
        var $gridList = $("");
        var blh = $gridList.jqGridRowValue().blh;
        var obj = new Object();
        obj.blh = blh;
        obj.zyh = $gridList.jqGridRowValue().zyh;
        obj.nlshow = $gridList.jqGridRowValue().nlshow;
        obj.xm = $gridList.jqGridRowValue().xm;
        obj.patid = $gridList.jqGridRowValue().patid;
        obj.startTime = $.currentWindow().$("").val();
        obj.endTime = $.currentWindow().$("").val();
        var pat = patcenter.find(p => p.zyh == obj.zyh);
        prevWindow.GetPatQueryAjax(pat);
        //Đóng cửa sổ
        ReceiptCancle();
    }
    //Xác nhận Gọi từ trang chính
    function PatSearchConfirm() {
        PatDbGrid();
    }

    //Hủy
    function ReceiptCancle() {
        $.modalClose();
    }

    function getPostdata() {
        var zyh = "";
        var mzh = "";
        if (ywlx == "") {
            zyh = $("").val();
        }
        else if (ywlx == "") {
            mzh = $("").val();
        }
        return { blh: $("").val(), keyword: $("").val(), mzh: mzh, zyh: zyh, ywlx: ywlx };
    }

    function getPatientlist()
    {
        $.najax({
            url: "",
            data: getPostdata(),
            dataType: "",
            async: false,
            success: function (data) {
                patcenter = data.rows;
                var reader = {
                    root: function (obj) { return data.rows; },
                    page: function (obj) { return data.page; },
                    total: function (obj) { return data.total; },
                    records: function (obj) { return data.records; }
                }
                $("").setGridParam({ data: data.zyinfolist, localReader: reader }).trigger('');
            }
        });
    }
</script>




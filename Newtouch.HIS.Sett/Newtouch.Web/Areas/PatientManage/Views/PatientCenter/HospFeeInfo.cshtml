    function FeeListGrid(zyh,group) {
        var gridFeeList = $("");
        var captionCon = "" + "" + "";
        gridFeeList.dataGrid({
            postData: {
                zyh: zyh, group: group              
            },
            url: "",
            autowidth: false,
            height: $(window).height() - 180,
            colModel: [                { label: '', name: '', hidden: true },                { label: '', name: '', width: 200, align: '' },                {                    label: '', name: '', width: 900, align: '', formatter: ""                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }                },            ],  
            viewrecords: false,
            ondblClickRow: function (rowIndex, s) {
                getItemsbySfdl(rowIndex);
            },
            gridComplete: function () {
                getFeeZje();
            },
            caption: captionCon

        });
    }

    function getItemsbySfdl(id) {
        
        var zyh = $("").text();
        //zyh = "";
        var rowData = $("").jqGrid('', id);
        if (!!rowData) {
            var sfdl = rowData.dlCode;
            var sfxm = rowData.dlmc;
            $.modalOpen({
                id: "",
                title: sfxm+"",
                url: "" + sfdl + "" + zyh,
                width: "",
                height: "",
                btn: null,
                callBack: function (iframeId) {
                }
            });
        }
    }

    function getFeeZje() {
        //Tổng số tiền
        var zje = 0;
        var ids = $("").getDataIDs();//Bảng dữ liệu trả vềIDMảng["",""..] 
        for (var i = 0; i < ids.length; i++) {
            var rowData = $("").getRowData(ids[i]);
            if (!!rowData.je) {
                zje += parseFloat(rowData.je);
            }
            if (zje) {
                $("").text(parseFloat(zje).toFixed(2));
                $("").text(parseFloat(zje).toFixed(2));
            }
        }
    }
</script>


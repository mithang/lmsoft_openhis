@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
    var brzybzType = ((int)EnumZYBZ.Djz).ToString();
    var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}
<form>
    <div class="gridPanel" style="margin-top:1%">
        <table id="gridList"></table>
        @*<div id="gridPager"></div>*@
        <table id="detailGrid"></table>
    </div>
</form>
<script>
    var colModel;
    var zyh = $.request('');
    var $gridList = $("");
    var $detailGrid = $("");
    $(function () {
        gridListData();
        bindGridList();
        displayDetailInfo([]);
    });
    function bindGridList() {
        colModel = [
            {
                label: '', name: '', align: '', width: 90, key: true
            },
            { label: '', name: '', align: '', width: 120 },
            { label: '', name: '', align: '', width: 50 },
            { label: '', name: '', align: '', width: 60 },
            { label: '', name: '', align: '', width: 130 },
            { label: '', name: '', align: '', width: 50 },
            { label: '', name: '', align: '', width: 60 },
            { label: '', name: '', align: '', width: 50 },
            { label: '', name: '', align: '', width: 50 },
            { label: '', name: '', align: '', width: 50 },
            { label: '', name: '', align: '', width: 80 },
            { label: '', name: '', align: '', width: 100 },

        ];
        $.ajax({
            type: "",
            url: "",//QueryNumMedicalSettlement_4104
            data: { hisId: zyh, operatorId: '', operatorName: '', orgId: '' },
            dataType: "",
            async: false,
            success: function (data) {
                debugger;
                var tfReturn = eval('' + data + '');
                if (tfReturn) {
                    if (tfReturn.infcode == 0 || tfReturn.infcode == "") {
                        $gridList.newtouchLocalDataGrid({
                            autowidth: false,
                            unwritten: false,
                            caption: "",
                            colModel: colModel,
                        }, tfReturn.output.data);
                        // hàm gọi bảng thông tin chi tiết hiển thị
                        displayDetailInfo(tfReturn.output.data[0].detailinfo);
                    }
                    else {
                        $.modalAlert("" + tfReturn.err_msg, '');
                        return;
                    }
                }
            }, error: function () {
                $.loading(false);
                $.modalAlert("", '');
                return;
            }
        });

    }
    function gridListData() {
        var $gridList = $("");
        var captionCon = "";
        $gridList.dataGrid({
            height: $(window).height() - 300,
            caption: captionCon,
            multiselect: false,
            unwritten: false,
            colModel: [
                {
                    label: '', name: '', align: '', width: 90, key: true
                },
                { label: '', name: '', align: '', width: 120 },
                { label: '', name: '', align: '', width: 50 },
                { label: '', name: '', align: '', width: 60 },
                { label: '', name: '', align: '', width: 130 },
                { label: '', name: '', align: '', width: 50 },
                { label: '', name: '', align: '', width: 60 },
                { label: '', name: '', align: '', width: 50 },
                { label: '', name: '', align: '', width: 50 },
                { label: '', name: '', align: '', width: 50 },
                { label: '', name: '', align: '', width: 80 },
                { label: '', name: '', align: '', width: 100 },

            ],
            //pager: "",
            viewrecords: true
        });
    }

    // hàm hiển thị thông tin chi tiết
    function displayDetailInfo(detailData) {
        var $detailGrid = $("");
        var detailColModel = [
            { label: '', name: '', align: '', width: 50 },
            { label: '', name: '', align: '', width: 150 },
            { label: '', name: '', align: '', width: 50 },
            { label: '', name: '', align: '', width: 150 },
            { label: '', name: '', align: '', width: 50 }
        ];

        // 创建并填充detailGridBảng
        $detailGrid.newtouchLocalDataGrid({
            autowidth: true,
            unwritten: false,
            caption: "",
            colModel: detailColModel,
        }, detailData.length > 0 ? detailData : [{/* Empty row to show column headers */ }]);
    }
</script>
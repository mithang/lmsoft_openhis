<script type="">
    $(function () {
        go();

    });

    //递归调用each step
    function go(stepFuncName) {
        if (!!!stepFuncName) {
            stepFuncName = "" + 1;
            //stepFuncName = "" + 7;
        }
        setTimeout(function () {
            var func = window[stepFuncName];
            if (!!!func) {
                console.log('');
                return;
            }
            var indx = parseInt(stepFuncName.substring("".length));
            var $iTemp = $('');
            $iTemp.appendTo($('' + (indx - 1) + ''));
            var callback = function (isStepSuccess) {
                $iTemp.remove();
                if (isStepSuccess === true) {
                    $('' + (indx - 1) + '').append('');
                    //Tiếp tục một dưới gọistep function
                    if ($('').length > indx) {
                        go("" + (indx + 1));
                    }
                }
                else {
                    $('' + (indx - 1) + '').append('');
                }
            };
            var flag = func(callback);
            if (flag === true || flag === false) {
                //同步返回模式
                callback(flag);
            }
            else {
                //回调模式
            }
        }, 50);
    }

</script>

@using Newtouch.Infrastructure;
@{
    Layout = "";

    var isZFtoYB = SysConfigReader.Bool("", false).Value;
    var isYBtoZF = SysConfigReader.Bool("", false).Value;

    //Có giao dịch bảo hiểm y tế không
    var openYbSett = SysConfigReader.Bool("");
    //Có giao dịch bảo hiểm nông thôn mới không
    var openXnhSett = SysConfigReader.Bool("");
    //Địa bàn bảo hiểm y tế，区分系统将执行何处医保逻辑
    var medicalInsurance = SysConfigReader.String("");
    var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
    var openManualinputCard = SysConfigReader.Bool("", false).Value;
    var reportUrl = SysConfigReader.OrgReportLink("");
}
<style>
    .title {
        width: 60px;
    }
</style>
<form>
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form">
            <tr>
                <th class="formTitle" style="width:70px;padding-right:12px;">Từ khóa：</th>
                <td class="formValue">
                    <input id="txt_keyword" type="text" class="form-control form-an" placeholder="Họ tên/Số bệnh án/Số nhập viện">
                </td>
                <th class="formTitle">Ngày xuất viện：</th>
                <td class="formValue" colspan="2">
                    <input id="cykssj" type="text" class="form-control input-wdatepicker" style="width:42%; float:left;" value="@DateTime.Now.AddMonths(-2).ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    <span style="margin-left:1%;float:left">—</span>
                    <input id="cyjssj" type="text" class="form-control input-wdatepicker" style="width:43%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                </td>
                <th class="formTitle" style="width:70px;padding-right:12px;">Tải lên trạng thái：</th>
                <td class="formValue">
                    <select id="sczt" name="sczt" class="form-control">
                        <option value="">Tất cả</option>
                        <option value="1">Chưa tải lên</option>
                        <option value="2">Đã tải lên</option>
                    </select>
                </td>
                <th class="formTitle" style="width:70px;padding-right:12px;">Gửi trạng thái：</th>
                <td class="formValue">
                    <select id="tjzt" name="tjzt" class="form-control">
                        <option value="">Tất cả</option>
                        <option value="1">Chưa gửi</option>
                        <option value="2">Đã gửi</option>
                    </select>
                </td>
                <td class="formValue title">
                    <input type="button" id="btn_search" class="btn btn-primary" style="width:36%;margin-left: 10%;" value="Tra cứu" />
                </td>
            </tr>
            <tr>
                <td class="formValue" colspan="6">
                    <input type="button" id="btn_jsqd" class="btn btn-info" style="width:19%;display:inline-block;" value="(4101A)Quyết toán tải lên danh sách" />
                    <input type="button" id="btn_jsqdsubmit" class="btn btn-info" style="width:21%;display:inline-block;" value="(4102)Quyết toán gửi trạng thái danh sách" />
                    <input type="button" id="btn_jsqdquery" class="btn btn-info" style="width:21%;display:inline-block;" value="(4103)Quyết toán tra cứu thông tin danh sách" />
                    <input type="button" id="btn_querynum" class="btn btn-info" style="width:27.5%;display:inline-block;" value="(4105)Tra cứu kết quả thống kê số lượng danh sách quyết toán" />
                </td>
                <td class="formValue" colspan="4">
                    <input type="button" id="btn_jsqdall" class="btn btn-info" style="display:inline-block;" value="Quyết toán tải lên tất cả danh sách" />
                    <input type="button" id="btn_jsqdsubmitall" class="btn btn-info" style="display:inline-block;" value="Quyết toán gửi tất cả trạng thái danh sách" />
                    <input type="button" id="btn_jsqdSubmitRevoke" class="btn btn-info" style="width:21%;display:inline-block;" value="Quyết toán hủy gửi danh sách" />
                </td>
               
                <th class="formTitle"></th>
                <td class="formValue" colspan="2"></td>
            </tr>
        </table>
    </div>
    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>

<script>
    $(function () {
        initControl();
        gridList();
    })
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            height: $(window).height() - 128,
            postData: { keyword: $("").val(), sczt: $("").val(), tjzt: $("").val(), cykssj: $("").val(), cyjssj: $("").val() },
            colModel: [
                { label: '', name: '', width: 60, align: '', key: true },
                { label: '', name: '', width: 60, align: '' },
                { label: '', name: '', width: 60, align: '' },
                { label: '', name: '', hidden: true },
                { label: '', name: '', width: 60, align: '' },
                { label: '', name: '', width: 40, align: '' },
                {
                    label: '', name: '', width: 40, align: '', formatter: function (cellvalue, a, b) {
                        return getAgeFromBirthTime({ begin: b.csny }).text;
                    }
                },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                
            ],
            pager: "",
            sortname: '',
            sortorder:"",
            viewrecords: true,
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: { keyword: $("").val(), sczt: $("").val(), tjzt: $("").val(), cykssj: $("").val(), cyjssj: $("").val() },
            }).trigger('');
        });
    }
    //Sự kiện nhấn Enter
    $('').keydownEnterEvent(function () {
        $('').trigger('');
    })
    $('').change(function () {
        $('').trigger('');
    });
    function initControl() {

    }
</script>
<script type="">
    var orgId = '';
        var openYbSett = '' === ''; //Cấu hình công tắc：Bệnh nhân bảo hiểm y tế có sử dụng quy trình giao dịch bảo hiểm y tế không

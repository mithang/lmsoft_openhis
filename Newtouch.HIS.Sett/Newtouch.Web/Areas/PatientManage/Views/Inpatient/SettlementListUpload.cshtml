            }
        });
        @*var url = getUrl();

        url += "" + zyh + "" +  '';
        window.open(url);*@
    });
    //Quyết toán tra cứu số lượng danh sách
    $('').click(function () {
        var kssj = $("").val();
        var jssj = $("").val();
        $.modalOpen({
            id: "",
            title: "",
            url: "" + kssj + "" + jssj,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    });

    function upqddata()
    {
        $.ajax({
            url: "",
            data: { kssj: $('').val(), jssj: $('').val()+"" },
            dataType: "",
            async: false,
            cache: false,
            success: function (ckdata) {
                var data = ckdata.data;
                if (data != null && data != "") {
                    $.loading("");
                    for (var i = 0; i < data.split('').length; i++) {
                        var dbscobj = { mdtrt_id: "", psn_no: "", hisId: data.split('')[i], operatorId: '', operatorName: '', orgId: '', insuplc_admdvs: "" };
                        $.ajax({
                            type: "",
                            url: "",
                            data: dbscobj,
                            dataType: "",
                            async: false,
                            success: function (data) {
                                var tfReturn = eval('' + data + '');
                                if (tfReturn) {
                                    if (tfReturn.infcode == 0 || tfReturn.infcode == "") {
                                        $.loading(false);
                                        $.modalAlert("", '');
                                        $('').trigger('');
                                        return;
                                    }
                                    else {
                                        $.loading(false);
                                        $.modalAlert("" + tfReturn.err_msg, '');
                                        $('').trigger('');
                                        return;
                                    }
                                }
                            }, error: function () {
                                $.loading(false);
                                $.modalAlert("", '');
                                return;
                            }
                        });
                    }
                } else {
                    $.loading(false);
                    $.modalAlert("", '');
                    return;
                }
            }
        });
    }

    function upqddataupdate(zyh, stas_type)
    {
        var dbscobj = { mdtrt_id: "", psn_no: "", hisId: zyh, operatorId: '', operatorName: '', orgId: '', insuplc_admdvs: "", stas_type: stas_type };
        $.ajax({
            type: "",
            url: "",
            data: dbscobj,
            dataType: "",
            async: false,
            success: function (data) {
                var tfReturn = eval('' + data + '');
                if (tfReturn) {
                    if (tfReturn.infcode == 0 || tfReturn.infcode == "") {
                        $.loading(false);
                        $('').trigger('');
                        if (stas_type == "") {
                            $.modalAlert("", '');
                        } else {
                            $.modalAlert("", '');
                        }
                        return;
                    }
                    else {
                        $.loading(false);
                        $('').trigger('');
                        if (stas_type == "") {
                            $.modalAlert("" + tfReturn.err_msg, '');
                        } else {
                            $.modalAlert("" + tfReturn.err_msg, '');
                        }
                        return;
                    }
                }
            }, error: function (request, error, ex) {
                $.loading(false);
                $.modalAlert("" + ex + "", '');
                return;
            }
        });
    }
    function uploadData(upobj) {
            var seleRow = check1();
            if (!!!seleRow) {
                return;
            }
            var isBrxzOk = seleRow.brxz == '';
            if (isBrxzOk) {
                $.modalAlert("", "");
                return;
            }
            var zyh = seleRow.zyh;

            if (seleRow.sczt=="") {
                $.modalAlert("", "");
                return;
            }
            var dbscobj = { mdtrt_id: "", psn_no: "", hisId: zyh, operatorId: '', operatorName: '', orgId: '', insuplc_admdvs: "" };
            var upUrl;
            switch (upobj) {
                case '':
                    upUrl = "";
                    break;
            }
            $.loading("");
            $.ajax({
                type: "",
                url: upUrl,
                data: dbscobj,
                dataType: "",
                async: false,
                success: function (data) {
                    var tfReturn = eval('' + data + '');
                    if (tfReturn) {
                        if (tfReturn.infcode === 0 || tfReturn.infcode === "") {
                            $.loading(false);
                            $('').trigger('');
                            $.modalAlert("" + zyh + "", '');
                        }
                        else {
                            $.loading(false);
                            $('').trigger('');
                            $.modalAlert("" + tfReturn.err_msg, '');
                            
                        }
                    }
                }, error: function () {
                    $.loading(false);
                    $.modalAlert("", '');
                }
            });
    }

    function check1() {
            var seleRow = $("").jqGridRowValue();
            var zyh = seleRow.zyh;
            if (!!!zyh) {
                $.modalAlert("", "");
                return;
            }
            else if (seleRow.zybz == '') {
                $.modalAlert("", "");
                return;
            }
            if (!medicalInsurance) {
                $.modalAlert("", "");
                return;
            }
            return seleRow;
    }

    function btn_edit() {
        var keyValue = $("").jqGridRowValue().zyh;
        if (!!!keyValue) {
            return;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    function getUrl() {
        var srcUrl = '';

        //Lấy kiểu tùy chỉnh
        if (true) {
            if (srcUrl.indexOf('') == -1) {
                srcUrl += "";
            }
        }
        if (false) {
            srcUrl += "" + curUserCode;
        }
        if (false) {
            srcUrl += "" + isHospAdministrator;
        }

        return srcUrl;
    }
</script>
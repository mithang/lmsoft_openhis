            return;
        }
        var isBrxzOk = seleRow.brxz == '';
        if (isBrxzOk) {
            $.modalAlert("", "");
            return;
        }
        var zyh = seleRow.zyh;
        if (seleRow.sczt == "") {
            $.modalAlert("", "");
            return;
        }
        if (seleRow.sczt == "") {
            $.modalAlert("", "");
            return;
        }
        upqddataupdate(zyh, "")

    });
    //Quyết toán gửi tất cả danh sách
    $('').click(function () {
        upqddataupdate("", "")
    });
    //Quyết toán tra cứu thông tin danh sách
    $('').click(function () {
        var seleRow = check1();
        if (!!!seleRow) {
            return;
        }
        var isBrxzOk = seleRow.brxz == '';
        if (isBrxzOk) {
            $.modalAlert("", "");

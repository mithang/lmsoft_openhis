        }
        var zyh = seleRow.zyh;
        var dbscobj = { setl_id: seleRow.setl_id, psn_no: seleRow.psn_no, hisId: seleRow.zyh, operatorId: '', operatorName: '', orgId: '', insuplc_admdvs: "" };
        $.ajax({
            type: "",
            url: "",
            data: dbscobj,
            dataType: "",
            async: false,
            success: function (data) {
                var tfReturn = eval('' + data + '');
                if (tfReturn) {
                    if (tfReturn.infcode == 0 || tfReturn.infcode == "") {
                        $.loading(false);
                        $.modalAlert("", '');

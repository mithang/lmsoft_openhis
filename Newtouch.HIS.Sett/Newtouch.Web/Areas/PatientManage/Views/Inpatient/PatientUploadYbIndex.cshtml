    function uploadData(upobj) {
        var seleRow = check();
        if (!!!seleRow) {
            return;
        }
        var isBrxzOk = seleRow.brxz == '';
        if (isBrxzOk) {
            $.modalAlert("", "");
            return;
        }
        var zyh = seleRow.zyh;
        var cbdbm = seleRow.cbdbm;
        var dbscobj = { mdtrt_id: seleRow.mdtrt_id, psn_no: seleRow.psn_no, hisId: zyh, operatorId: '', operatorName: '', orgId: '', insuplc_admdvs: cbdbm };
        var upUrl;
        switch (upobj) {
            case '':
                upUrl = "";
                break;
            case '':
                upUrl = "";
                //upUrl = "";
                break;
            case '':
                upUrl = "";
                break;
            case '':
                upUrl = "";
                break;
            case '':
                upUrl = "";
                break;
            case '':
                upUrl = "";
                break;
            case '':
                upUrl = "";
                break;
            case '':
                upUrl = "";
                break;
            case "":
                upUrl = "";
                break;
            case "":
                upUrl = "";
                break;
            case "":
                upUrl = "";
                break;
            case '':
                upUrl = "";
                break;
        }
        $.loading("");
        $.ajax({
            type: "",
            url: upUrl,
            data: dbscobj,
            dataType: "",
            async: false,
            success: function (data) {
                var tfReturn = eval('' + data + '');
                if (tfReturn) {
                    if (tfReturn.infcode == "") {
                        $.loading(false);
                        $.modalAlert("" + zyh + "", '');
                    }
                    else {
                        $.loading(false);
                        $.modalAlert(""+zyh+"" + tfReturn.err_msg, '');
                    }
                }
            }, error: function (request, error, ex) {
                $.loading(false);
                $.modalAlert("" + upobj + "" + ex + "", '');
            }
        });
    }

    function check() {
        var seleRow = $("").jqGridRowValue();
        var zyh = seleRow.zyh;

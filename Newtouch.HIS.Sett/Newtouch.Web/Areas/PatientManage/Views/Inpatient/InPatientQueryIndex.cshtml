<script type="">
    $("").click(function () { exportJsonExcelFunction(); });
    let _options = {};
    export function exportJsonExcelFunction() {
        const dataSource = $("").jqGridRowValue();
        let option = {}, tableData = [], tableTitle;
        if (!dataSource || dataSource.length === 0) {
            $.modalAlert("", "");
            return;
        }
        tableTitle = ['', '', '', '', '', '', '', '', '', ''];
        dataSource.map((item) => {
            let row = {
                '': item.cwmc,
                '': item.xm,
                '': item.sexValue,
                '': item.nlshow,
                '': item.zy,
                '': item.ryrq,
                '': item.zzdmc,
                '': item.inHosDays,
                '': item.doctor,
                '': ''
            };
            tableData.push(row);
        });
        var year = new Date().getFullYear();
        var month = new Date().getMonth() - 1;
        option.fileName = year + "" + month + "" + new Date().getDay() + "" + '';
        option.datas = [
            {
                sheetName: '',
                sheetData: tableData,
                sheetHeader: tableTitle,
                sheetFileter: tableTitle,
                columnWidths: [7, 20, 5, 10, 10, 11, 20, 10, 10, 10]
            }
        ];
        exportExcel(option);
    }

    const exportExcel = function (options) {
        _options = {
            fileName: options.fileName || "",
            datas: options.datas,
            saveAsBlob: options.saveAsBlob || false,
            workbook: {
                SheetNames: [],
                Sheets: {},
            },

        };
        saveExcel();
    }
    function saveExcel() {
        let wb = _options.workbook;

        _options.datas.forEach(function (data, index) {
            let sheetHeader = data.sheetHeader || null;
            let sheetData = data.sheetData;
            let sheetName = data.sheetName || "" + (index + 1);
            let sheetFilter = data.sheetFilter || null;
            let columnWidths = data.columnWidths || [];

            sheetData = changeData(sheetData, sheetFilter);

            if (sheetHeader) {
                sheetData.unshift(sheetHeader);
            }

            let ws = sheetChangeData(sheetData);

            ws[""] = [];

            ws[""] = columnwidths(columnWidths);
            //ws[""] = pageMagins();
            //ws[""] = pageSetupFunction();
            wb.SheetNames.push(sheetName);
            wb.Sheets[sheetName] = ws;
        });

        let wbout = XLSX.write(wb, {
            bookType: "",
            bookSST: false,
            type: "",
        });
        if (!_options.saveAsBlob) {
            saveAs(
                new Blob([s2ab(wbout)], {
                    type: "",
                }),
                _options.fileName + ""
            );
        } else {
            return new File([s2ab(wbout)], _options.fileName + "", {
                type: "",
                lastModified: Date.now(),
            });
        }
    }


    function changeData(data, filter) {
        let sj = data,
            f = filter,
            re = [];
        Array.isArray(data)
            ? (function () {
                //Đối tượng
                f
                    ? (function () {
                        //存在过滤
                        sj.forEach(function (obj) {
                            let one = [];
                            filter.forEach(function (no) {
                                one.push(obj[no]);
                            });
                            re.push(one);
                        });
                    })()
                    : (function () {
                        //不存在过滤
                        sj.forEach(function (obj) {
                            let col = Object.keys(obj);
                            let one = [];
                            col.forEach(function (no) {
                                one.push(obj[no]);
                            });
                            re.push(one);
                        });
                    })();
            })()
            : (function () {
                re = sj;
            })();
        return re;
    };

    // 转换数据
    function sheetChangeData(data) {
        let ws = {};
        let range = {
            s: {
                c: 10000000,
                r: 10000000,
            },
            e: {
                c: 0,
                r: 0,
            },
        };
        for (let R = 0; R != data.length; ++R) {
            for (let C = 0; C != data[R].length; ++C) {
                if (range.s.r > R) range.s.r = R;
                if (range.s.c > C) range.s.c = C;
                if (range.e.r < R) range.e.r = R;
                if (range.e.c < C) range.e.c = C;
                let cell = {
                    v: data[R][C],
                };

                console.log(cell);
                if (cell.v == null) continue;
                let cell_ref = XLSX.utils.encode_cell({
                    c: C,
                    r: R,
                });

                if (typeof cell.v === "") cell.t = "";
                else if (typeof cell.v === "") cell.t = "";
                else if (cell.v instanceof Date) {
                    cell.t = "";
                    cell.z = XLSX.SSF._table[14];
                    cell.v = datenum(cell.v);
                } else if (/^hyperlink:/.test(cell.v)) {
                    cell.l = {
                        Target: cell.v.replace(/^hyperlink:/, ""),
                    };
                    cell.v = cell.v.replace(/^hyperlink:/, "");
                } else cell.t = "";
                ws[cell_ref] = cell;
            }
        }
        if (range.s.c < 10000000) ws[""] = XLSX.utils.encode_range(range);
        return ws;
    };

    function s2ab(s) {
        let buf = new ArrayBuffer(s.length);
        let view = new Uint8Array(buf);
        for (let i = 0; i != s.length; ++i) view[i] = s.charCodeAt(i) & 0xff;
        return buf;
    };
    //Số hiệu ngày
    function datenum(v, date1904) {
        if (date1904) v += 1462;
        let epoch = Date.parse(v);
        return (epoch - new Date(Date.UTC(1899, 11, 30))) / (24 * 60 * 60 * 1000);
    };
    //列宽
    function columnwidths(columnWidths) {
        let out = [];
        out = columnWidths.map(function (item) {
            return { width: item ? Number(item) : 20 };
        });
        return out;
    }


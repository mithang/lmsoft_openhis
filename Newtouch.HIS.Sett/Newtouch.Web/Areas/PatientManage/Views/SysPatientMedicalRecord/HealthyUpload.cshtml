@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
}

<form name="form1" autocomplete="off">
    <div class="panel panel-default" style="">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <div style="padding: 0px;padding-right:0px;">
            <table class="form">
                <tr>
                    <th class="formTitle">Ngày tải lên：</th>
                    <td class="formValue">
                        <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; float:left;" value="@DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd  00:00:00")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                        <span style="margin-left:0;float:left">—</span>
                        <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:43%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd  HH:mm:ss")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                    </td>

                    <th class="formTitle">Tải lên loại：</th>
                    <td class="formValue">
                        <select id="selsclx">
                            <option value="">Tất cả</option>
                            <option value="TB_YL_MZ_Medical_Record">Bảng bản ghi khám bệnh ngoại trú</option>
                            <option value="TB_CIS_Prescription_Detail">门诊处方明细表</option>
                            <option value="TB_HIS_MZ_Fee_Detail">Bảng chi tiết thu phí ngoại trú</option>
                            <option value="TB_YL_ZY_Medical_Record">Nhập viện bảng bản ghi khám bệnh</option>
                            <option value="TB_CIS_DrAdvice_Detail">Nhập viện bảng chi tiết y lệnh</option>
                            <option value="TB_HIS_ZY_Fee_Detail">Nhập viện bảng chi tiết thu phí</option>
                            <option value="TB_RIS_Report">医学影像检查报告表</option>
                            <option value="TB_Operation_Detail">Bảng chi tiết phẫu thuật</option>
                            <option value="TB_DIC_Department">bảng từ điển khoa của bệnh viện</option>
                            <option value="TB_DIC_Practitioner">医护人员字典表</option>
                            <option value="TB_DIC_MEDICINES">Bảng từ điển danh mục thuốc</option>
                            <option value="TB_DIC_Materials">Bảng từ điển danh mục thuốc không</option>
                        </select>&nbsp;&nbsp;&nbsp;
                        <input type="button" class="btn btn-primary btn-md" id="btnsyy" value="Tra cứu" />
                    </td>
                    <th class="formTitle"></th>
                    <th class="formValue"></th>

                </tr>

            </table>

        </div>
    </div>
    <div style="margin-top:10px;">
        <div class="gridPanel">
            <table id="registedList"></table>
            <div id="gridPager"></div>
        </div>
    </div>
</form>
<script>
    $(function () {
        gridlist();
    });
    function postdata() {
        return {
            ksrq: $("").val(),
            jsrq: $("").val(),
            tabname: $("").val(),
        };

    }
    function gridlist() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            height: $(window).height() - 205,
            caption: "",
            postData: postdata(),
            colModel:  [
			{ label: '', name: '', key: true, hidden: true },

			{ label: '', name: '', width: 160, align: '' },
			{ label: '', name: '', width: 160, align: '' },
			{ label: '', name: '', width: 100, align: '' },
            {
                label: '', name: '', width: 120, align: '',
                formatter: "", formatoptions: { srcformat: '', newformat: '' }
            },
            { label: '', name: '', width: 100, align: '' }
			
            ],
            pager: "",
            sortname: '',
            multiselect: false,
            viewrecords: true
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: postdata(),
            }).trigger('');
        });
    }
   
</script>


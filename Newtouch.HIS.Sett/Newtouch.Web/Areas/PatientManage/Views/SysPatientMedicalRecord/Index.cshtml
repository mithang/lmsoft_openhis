@{
    ViewBag.Title = "";
    Layout = "";

    var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        @*<div class="btn-group">
            <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-pencil-square-o"></i>Xóa</a>
        </div>*@
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Tên tệp đính kèm" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script>
    var blh = $.request("");

    $(function () {
        gridList();
    })
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            treeGrid: true,
            treeGridModel: "",
            ExpandColumn: "",
            url: "" + blh,
            height: $(window).height() - 96,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: "", name: "", width: 80, align: "", formatter: function (cellvalue) { return cellvalue == "" ? "" : ""; } },
                { label: "", name: "", hidden: true },
                { label: "", name: "", hidden: true },
                { label: '', name: '', width: 120, align: '' },
                { label: '', name: '', width: 40, align: '', hidden: true },
                {
                    label: '', name: '', width: 120, align: '',
                    formatter: function (cellvalue, a, rowdata) {
                        if (!!cellvalue) {
                            return '' + rowdata.attachUrl + '' + encodeURIComponent(cellvalue) + '' + cellvalue + '';
                        }
                        else {
                            return "";
                        }
                    }
                },
                { label: '', name: '', width: 130, align: '', hidden: true },
                { label: '', name: '', width: 130, align: '', hidden: true },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 120, align: '' },
                { label: '', name: '', width: 260, align: '' },
            ]
        });
        $("").click(function () {
            $gridList.jqGrid('', {

            }).trigger('');
        });
    }

    //回车触发查询事件
    $('').keydownEnterEvent(function () {
        $('').trigger('');
    })

    //Thêm mới
    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + blh,
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("").resetSelection();
                    $("").trigger("");
                });
            }
        });
    }

    //Sửa
    function btn_edit() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        if (!!$("").jqGridRowValue().ParentId) {
            keyValue = $("").jqGridRowValue().ParentId;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("").resetSelection();
                    $("").trigger("");
                });
            }
        });
    }

    function cabck(msg) {
        $.modalClose("");
        $.modalAlert((!!msg ? msg : ""), '');
        $('').trigger('');
    }

    //Xóa
    function btn_delete() {
        return;
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        if (!!!$("").jqGridRowValue().ParentId) {
            //这是父级
            $.deleteForm({
                url: "",
                param: { keyValue: keyValue },
                success: function () {
                    $("").resetSelection();
                    $("").trigger("");
                }
            });
        }
        else {
            //这是子级

        }
    }

</script>
@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="rows">
    <div class="panel panel-default">
        <table class="form">
            <tr>
                <th class="formTitle">Năm：</th>
                <td class="formValue">
                    <select id="year" name="year" class="formClearIgnore">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <th class="formTitle">Tháng：</th>
                <td class="formValue">
                    <select id="month" name="month" class="formClearIgnore">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <td class="formValue" style="padding-left:20px;">
                    <input type="button" id="btn_search" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                </td>
                <td class="formValue" colspan="2">
                    <input type="button" id="btn_gene" class="btn btn-primary btn-md" value="Tạo" style="width:55px;display:inline-block;display:none;" />
                    <input type="button" id="btn_regene" class="btn btn-warning btn-md" value="Lại tạo" style="display:inline-block;display:none;" />
                </td>
                <td class="formValue"></td>
            </tr>
        </table>
    </div>
</div>
<div class="ui-layout" id="layout" style="height:100%;width:100%;">
    <iframe class="ui-layout-center" style="width:100%;" id="iframerightiframerightiframerightttt" name="iframerightiframerightiframerightttt"
            scrolling="auto" allowtransparency="true" frameborder="0"></iframe>
</div>
<script type="">
    //Biến toàn cục
    var orgId = '';
    //ReportingService Host
    var reportServerHOST = '';


</script>
<script type="">
    //Khởi tạo hộp thả xuống năm tháng
    (function initYearMonthSelect() {
        var date = new Date;
        //Mặc định chọn tháng trước
        var defaultSelYear = 1900 + date.getYear();
        var defaultSelMonth = date.getMonth();
        if (defaultSelMonth == 0) {
            defaultSelYear--;
            defaultSelMonth = 12;
        }
        //Năm
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.yearArr && top.clients.yearArr.length) {
                    $.each(top.clients.yearArr, function () {
                        resultObjArr.push({ id: this, text: this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: defaultSelYear,
        });
        //Tháng
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.monthArr && top.clients.monthArr.length) {
                    $.each(top.clients.monthArr, function () {
                        resultObjArr.push({ id: this, text: parseInt(this) < 10 ? "" + this : this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: defaultSelMonth,
        });

    })();
</script>
<script type="">
    var showType = "";
    var submit = function () {
        $.najax({
            type: "",
            url: "" + $('').val()
                + "" + $('').val(),
            loading: true,
            loadingtext: '',
            cache: false,
            success: function (ajaxresp) {
                if (ajaxresp.flag === false) {
                    showType = ""  //Chưa tạo
                }
                else {
                    showType = ""  //当月已生成过固定报表
                }
                searchReport(); //Tra cứu báo cáo
            }
        });
    };
    $('').click(function () {
        newtouch_globalevent_f4();

        submit();
    });
    $("").load(function () {
        $.loading(false);
        if (showType == "") {
            $('').show();
            $('').hide();
        }
        else {
            $('').show();
            $('').hide();
        }
    });
</script>
<script type="">
    //Tra cứu báo cáo
    function searchReport() {
        var url = reportServerHOST + "";
        url += "";
        url += "" + orgId;
        url += "" + $('').val();
        url += "" + $('').val();

        if (showType == "") {
            setTimeout("", 10);
        }
        else {
            setTimeout("", 10);
        }

        $("").attr('', url);
    }
</script>
<script type="">
    //Tạo báo cáo
    $("").click(function () {
        ReqDoGenerate();
    });
    //Lại tạo báo cáo
    $("").click(function () {
        $.modalConfirm("", function (flag) {
            if (flag) { 
                ReqDoGenerate(true);
            }
        });
    });

    function ReqDoGenerate(isReGene) {
        $.najax({
            type: "",
            url: "",
            data: { year: $('').val(), month: $('').val(), isReGene: isReGene },
            dataType: "",
            loadingtext: "",
            success: function (ajaxResp) {
                $.modalMsg('', '');
                setTimeout("", 1000); //Lại tra cứu báo cáo
            }
        });
    }
</script>
<script type="">
    $(function () {
        var h = $(window).height() - 55;
        $('').css('', h);

    });
</script>
<script type="">
    function newtouch_event_f4() {
        $('').hide();
        $('').hide();

    }
</script>
<script type="">
    function funcOrganizeIdChange() {
        orgId = $("").val();
        submit();
    }
</script>
@Html.Partial("")

@{
    ViewBag.Title = "";
    Layout = "";
}

<div style="margin:5px 100px 0 5px;color:#666;">
    算法（Cấu hình）Giải thích：<span style="color:red;">1</span>) ''Không cấu hình lặp lại có thể；<span style="color:red;">2</span>) Tỷ lệ、固定金额两种方式至少配置一种，都有配置则取和
</div>
<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Mã nhóm lớn/Tên nhóm lớn/Mã hạng mục/Tên hạng mục" style="width: 220px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>

<script>
    $(function () {
        gridList()
    })
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            postData: { keyword: $("").val() },
            url: "",
            height: $(window).height() - 120,
            colModel: [
                 { label: "", name: "", hidden: true, key: true },
                 { label: "", name: "", width: 60, align: "", formatter: function (cellvalue) { return cellvalue == "" ? "" : ""; } },
                 { label: "", name: "", width: 100, align: '' },
                 { label: "", name: "", width: 100, align: '' },
                 { label: "", name: "", width: 150, align: '' },
                 { label: "", name: "", width: 90, align: '', formatter: function (cellvalue, options, rowObject) { if (!!cellvalue) { return cellvalue; } else { if (!!rowObject.sfxmCode && !!!rowObject.blhgdje) return 0; else return ""; } } },
                 { label: "", name: "", width: 70, align: '', formatter: function (cellvalue) { if (!!cellvalue || cellvalue == 0) { return cellvalue + "" } else { return ""; } } },
                 { label: '', name: '', width: 100, align: '', formatter: function (cellvalue) { if (!!cellvalue) { return cellvalue; } else { return ""; } } },
                 { label: '', name: '', width: 300, align: '' },
                { label: '', name: '', width: 40, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 130, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 130, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
            ],
        });
        $("").click(function () {
            $("").jqGrid('', {
                postData: { keyword: $("").val() },
            }).trigger('');
        });
    }

    //Sự kiện nhấn Enter
    $('').keydownEnterEvent(function () {
        $('').trigger('');
    })

    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("").resetSelection();
                    $("").trigger("");
                });
            }
        });
    }

    function btn_edit() {
        var keyValue = $("").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("", '');
            return;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("").resetSelection();
                    $("").trigger("");
                });
            }
        });
    }

</script>


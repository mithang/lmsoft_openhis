
@{
    ViewBag.Title = "";
    Layout = "";
}

<!DOCTYPE html>
<script>
    $(function () {
        gridList();
    })
    function gridList() {
        var $gridList = $("");
        $gridList.newtouchLocalDataGrid({
            height: $(window).height() - 210,
            datatype: "",
            unwritten: false,
            colModel: [
                 { label: "", name: "", hidden: true },
                 { label: '', name: '', width: 100, align: '', editor: "" },
                 { label: '', name: '', width: 100, align: '', editor: "" },
                 { label: '', name: '', width: 100, align: '', editor: "" },
                 { label: '', name: '', width: 100, align: '', editor: "" },
                 { label: '', name: '', width: 100, align: '', editor: "" },
                 { label: '', name: '', width: 100, align: '', editor: "" },
                 { label: '', name: '', width: 100, align: '', editor: "" },
                 { label: '', name: '', width: 100, align: '', editor: "" }
            ],
            pager: "",
            sortname: '',
            rowNum: '',
            viewrecords: true
        });

        var mydata = [
            { id: "", sfxm: "", dlmc: "", py: "", dw: "", dj: "", flmc: "", zfbl: "", ybdm: "", wjdm: "", mzzybz: "", je: "", czsj: "", xsry: "" },
            { id: "", sfxm: "", dlmc: "", py: "", dw: "", dj: "", flmc: "", zfbl: "", ybdm: "", wjdm: "", mzzybz: "", je: "", czsj: "", xsry: "" },
            { id: "", sfxm: "", dlmc: "", py: "", dw: "", dj: "", flmc: "", zfbl: "", ybdm: "", wjdm: "", mzzybz: "", je: "", czsj: "", xsry: "" }
        ];
        for (var i = 0; i <= mydata.length; i++) {
            $gridList.jqGrid('', i + 1, mydata[i]);
        }
    }
    function btn_edit() {
        var keyValue = $("").jqGridRowValue().sfxmbh;
        $.modalOpen({
            id: "",
            title: "",
            url: "",//"" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_delete() {
        $.deleteForm({
            url: "",//"",
            param: { keyValue: $("").jqGridRowValue().sfxmbh },
            success: function () {
                $("").trigger("");
            }
        })
    }
    function btn_details() {
        var keyValue = $("").jqGridRowValue().sfxmbh;
        $.modalOpen({
            id: "",
            title: "",
            url: "",//"" + keyValue,
            width: "",
            height: "",
            btn: null,
        });
    }
    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        $.submitForm({
            url: "",//"" + keyValue,
            param: $("").formSerialize(),
            success: function () {
                $("").resetSelection();
                $("").trigger("");
                $.loading(false);
            }
        })
    }
</script>

    function submitForm() {
        if (checkNotNull()) {
            var data = $("").formSerialize();
            data[""] = $("").attr("");
            data[""] = $("").attr("");
            data[""] = $("").attr("");
            data[""] = $("").attr("");
            $.submitForm({
                url: "" + keyValue,
                param: data,
                success: function () {
                    //$.currentWindow().$("").resetSelection();
                    //$.currentWindow().$("").trigger("");
                    $.currentWindow().window.frames[''].$("").resetSelection();
                    $.currentWindow().window.frames[''].$("").trigger("");
                    $.loading(false);
                }
            })
        }
    }


    function checkNotNull() {
        var validator = $('').validate();
        validator.settings = {
            rules: {
                sfxmmc: { required: true },
                py: { required: true },
                dw: { required: true },
                dj: { required: true },
                zfbl: { required: true },
                zfxz: { required: true },
                mzzybz: { required: true },
                ssbz: { required: true },
                tsbz: { required: true },
                jsbz: { required: true },
                sfbz: { required: true },
                zt: { required: true },
                dl: { required: true },
            },
            messages: {
                sfxmmc: { required: "" },
                py: { required: "" },
                dw: { required: "" },
                dj: { required: "" },
                zfbl: { required: "" },
                zfxz: { required: "" },
                mzzybz: { required: "" },
                ssbz: { required: "" },
                tsbz: { required: "" },
                jsbz: { required: "" },
                sfbz: { required: "" },
                zt: { required: "" },
                dl: { required: "" },
            },
            showErrors: function (errorMap, errorList) {
                if (!$.isEmptyObject(errorList)) {
                    $.modalAlert(errorList[0].message, '');
                }
            }
        }
        if (!validator.form()) {
            return false;
        }
        //Trạng thái
        var zt = false;
        $('').each(function () {
            var $this = $(this);
            if ($this.parent().hasClass("")) {
                zt = true;
                $("").val()
            }
        });
        if (!zt) {
            $.modalAlert("", '');
            return false;
        }
        return true;
    }
</script>
<style>
    span {

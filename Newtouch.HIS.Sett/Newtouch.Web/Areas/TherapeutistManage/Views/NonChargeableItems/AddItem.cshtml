<script>

    var keyValue = $.request("");
    $(function () {
        InitControl();
        $.ajax({
            url: "" + Math.random(),
            data: { keyValue: keyValue },
            dataType: "",
            async: false,
            success: function (data) {
                $("").formSerialize(data);
                if (data[""]) {
                    $("").attr("", data[""]);
                }
                if (data[""]) {
                    $("").attr("", data[""]);
                }
                if (data[""]) {
                    $("").attr("", data[""]);
                }
                if (data[""]) {

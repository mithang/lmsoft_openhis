@{
    ViewBag.Title = "";
    Layout = "";
}

<script>
    $(function () {
        $(window).resize(function () {
            initLayout("");
        });
        var data = localStorage.getItem("");
        if (!data) {
            return;
        }
        var keyValue = JSON.parse(data);
        $("").html(keyValue[""] + "" + keyValue[""]);
        $("").html(keyValue[""]);
        $("").html(keyValue[""]);
        $.najax({
            type: "",
            url: "",
            data: keyValue,
            cache: false,
            dataType: "",
            success: function (ajaxresp) {
                gridList(ajaxresp);
            },
            errorCallback: function (err) {
            },
            complete: function () {
                $.loading(false);
            }

        });
    });
    //Liên kếtgrid
    function gridList(mydata) {
        var $gridList = $("");
        var lastRowId;
        $gridList.dataNewGrid({
            height: $(window).height() - 185,
            editurl: "",
            footerrow: true,
            colModel: [
                { name: "", hidden: true, },
                { name: "", label: "", hidden: true, },
                { label: "", name: "", align: '' },
                { label: '', name: '', width: 100, align: '' },
                {
                    label: '', name: '', width: 100, editable: true, align: "", summaryType: ''
                },
                {
                    label: '', name: '', width: 260, editable: true, align: ""
                }
            ],
            onSelectRow_page: function (rowid, status) {
                if (rowid && lastRowId && rowid !== lastRowId) {   //&&: 相当于true/fase(判断是否有值)
                    $gridList.saveRow(lastRowId, function (result) {
                        // return false;   //Xác minh nội dung nhập có hợp lệ không，Hủy lưu và quay lạifalse    //Không hiệu lực V.v. sửa chữa
                    }); //先保存处于编辑状态的那一行    //function checksave
                }
                lastRowId = rowid;
                $gridList.jqGrid('', rowid, true, null, function (result) {
                    return false;   //Xác minh nội dung nhập có hợp lệ không，Hủy lưu và quay lạifalse    //Không hiệu lực V.v. sửa chữa
                }, null, null, function () {
                });

            },
            gridComplete: function () {
                //Bật hộp chỉnh sửa trong dòng
                //EnableInlineEditBox();
                var rowNum = parseInt($(this).getGridParam(''), 10);
                if (rowNum > 0) {
                    $("").show();
                    var sc = jQuery(this).getCol('', false, '');
                    $(this).footerData("", { "": "", "": "" + sc + "" });
                } else {
                    $("").hide();
                }
            },
            userDataOnFooter: true,
        }, mydata);
    }

    //Bật hộp chỉnh sửa trong dòng
    function EnableInlineEditBox() {
        //GridTải xong bật chỉnh sửa trong dòng   1.Lấy tất cả các dòng trướcId  2.Gọi duyệteditRowPhương thức
        var rowIds = $("").jqGrid('');
        for (var i = 0; i < rowIds.length; i++) {

            $("").jqGrid('', rowIds[i], true, null, null, null, null, function (callbackRowId) {     //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.
            });
        }
    }

    function submitForm() {
        var ysgh = $("").html();
        var par = {};
        var dic = [];
        //Lấy tất cả các dòngId，Duyệt để hộp chỉnh sửa ở trạng thái đã lưu
        var rowIds = $("").jqGrid('');
        for (var i = 0; i < rowIds.length; i++) {
            $("").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);
        }
        var data = JSON.parse($("").jqGrid(''), true);
        dic.push({ '': ysgh, '': data });
        par[""] = dic;
        $.submitForm({
            url: "",
            param: par,
            success: function () {
                $.currentWindow().$("").resetSelection();
                $.currentWindow().$("").trigger("");
                $.loading(false);
                $.modalClose();
            }
        });
    }
</script>
<div class="rows" style="margin: 5px 10px">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Thông tin nhà trị liệu
        </div>
        <table class="form">
            <tr>
                <td class="formTitle">
                    Mã nhân viên：
                </td>
                <td class="formValue">
                    <label id="ysgh"></label>
                </td>
                <td class="formTitle">
                    Họ tên:
                </td>
                <td class="formValue">
                    <label id="NAME"></label>
                </td>
                <td class="formTitle">
                    Tháng năm：
                </td>
                <td class="formValue">
                    <label id="ny"></label>
                </td>
            </tr>
        </table>
    </div>
</div>
<form id="tabGrid" class="form">
    <div class="gridPanel">
        <table id="gridList" rel="tabGrid"></table>
    </div>
</form>



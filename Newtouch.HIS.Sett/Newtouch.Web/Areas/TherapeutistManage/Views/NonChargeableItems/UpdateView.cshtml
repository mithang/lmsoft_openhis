@{
    ViewBag.Title = "UpdateView";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<script>
    $(function () {
        $(window).resize(function () {
            initLayout("tabGrid");
        });
        var data = localStorage.getItem("needupdateData");
        if (!data) {
            return;
        }
        var keyValue = JSON.parse(data);
        $("#ny").html(keyValue["syear"] + "-" + keyValue["smonth"]);
        $("#ysgh").html(keyValue["ysgh"]);
        $("#NAME").html(keyValue["NAME"]);
        $.najax({
            type: "POST",
            url: "/TherapeutistManage/NonChargeableItems/GetFormJson",
            data: keyValue,
            cache: false,
            dataType: "json",
            success: function (ajaxresp) {
                gridList(ajaxresp);
            },
            errorCallback: function (err) {
            },
            complete: function () {
                $.loading(false);
            }

        });
    });
    //Gắngrid
    function gridList(mydata) {
        var $gridList = $("#gridList");
        var lastRowId;
        $gridList.dataNewGrid({
            height: $(window).height() - 185,
            editurl: "clientArray",
            footerrow: true,
            colModel: [
                { name: "Id", hidden: true, },
                { name: "type", label: "type", hidden: true, },
                { label: "Ngày", name: "jzsj", align: 'left' },
                { label: 'Thời lượng(Min)', name: 'sc', width: 100, align: 'left' },
                {
                    label: 'Điều chỉnh thời lượng(Min)', name: 'tzsc', width: 100, editable: true, align: "left", summaryType: 'sum'
                },
                {
                    label: 'Điều chỉnh理Do', name: 'tzly', width: 260, editable: true, align: "left"
                }
            ],
            onSelectRow_page: function (rowid, status) {
                if (rowid && lastRowId && rowid !== lastRowId) {   //&&: Tương đương vớitrue/fase(Xét xem có giá trị hay không)
                    $gridList.saveRow(lastRowId, function (result) {
                        // return false;   //Kiểm tra nội dung nhập có hợp lệ không，Hủy lưu và quay lạifalse    //Không hiệu lực v.v. cần sửa
                    }); //Trước tiên lưu dòng đang ở trạng thái chỉnh sửa    //function checksave
                }
                lastRowId = rowid;
                $gridList.jqGrid('editRow', rowid, true, null, function (result) {
                    return false;   //Kiểm tra nội dung nhập có hợp lệ không，Hủy lưu và quay lạifalse    //Không hiệu lực v.v. cần sửa
                }, null, null, function () {
                });

            },
            gridComplete: function () {
                //Bật hộp chỉnh sửa trong dòng
                //EnableInlineEditBox();
                var rowNum = parseInt($(this).getGridParam('records'), 10);
                if (rowNum > 0) {
                    $(".ui-jqgrid-sdiv").show();
                    var sc = jQuery(this).getCol('sc', false, 'sum');
                    $(this).footerData("set", { "Source": "<font color='red'>Hiện tại页点击Tổng cộng<font>", "sc": "<font color='red'>" + sc + "<font>Điểm钟" });
                } else {
                    $(".ui-jqgrid-sdiv").hide();
                }
            },
            userDataOnFooter: true,
        }, mydata);
    }

    //Bật hộp chỉnh sửa trong dòng
    function EnableInlineEditBox() {
        //GridTải xong thì bật chỉnh sửa trong dòng   1.Trước tiên lấy tất cả các dòngId  2.Duyệt và gọieditRowPhương thức
        var rowIds = $("#gridList").jqGrid('getDataIDs');
        for (var i = 0; i < rowIds.length; i++) {

            $("#gridList").jqGrid('editRow', rowIds[i], true, null, null, null, null, function (callbackRowId) {     //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.
            });
        }
    }

    function submitForm() {
        var ysgh = $("#ysgh").html();
        var par = {};
        var dic = [];
        //Lấy tất cả các dòngId，Duyệt để hộp chỉnh sửa ở trạng thái đã lưu
        var rowIds = $("#gridList").jqGrid('getDataIDs');
        for (var i = 0; i < rowIds.length; i++) {
            $("#gridList").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);
        }
        var data = JSON.parse($("#gridList").jqGrid('getRowData_AllLine'), true);
        dic.push({ 'key': ysgh, 'value': data });
        par["vo"] = dic;
        $.submitForm({
            url: "/TherapeutistManage/NonChargeableItems/submitUpdateTime",
            param: par,
            success: function () {
                $.currentWindow().$("#HisgridList").resetSelection();
                $.currentWindow().$("#HisgridList").trigger("reloadGrid");
                $.loading(false);
                $.modalClose();
            }
        });
    }
</script>
<div class="rows" style="margin: 5px 10px">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Nhà trị liệuThông tin
        </div>
        <table class="form">
            <tr>
                <td class="formTitle">
                    Mã nhân viên：
                </td>
                <td class="formValue">
                    <label id="ysgh"></label>
                </td>
                <td class="formTitle">
                    Họ tên:
                </td>
                <td class="formValue">
                    <label id="NAME"></label>
                </td>
                <td class="formTitle">
                    Năm-tháng：
                </td>
                <td class="formValue">
                    <label id="ny"></label>
                </td>
            </tr>
        </table>
    </div>
</div>
<form id="tabGrid" class="form">
    <div class="gridPanel">
        <table id="gridList" rel="tabGrid"></table>
    </div>
</form>



        ];
        for (var i = 0; i <= mydata.length; i++) {
            $gridList.jqGrid('', i + 1, mydata[i]);
        }
    }
    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_edit() {
        var keyValue = $("").jqGridRowValue().sfxmbh;
        $.modalOpen({
            id: "",
            title: "",
            url: "",//"" + keyValue,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    function btn_delete() {
        $.deleteForm({
            url: "",//"",
            param: { keyValue: $("").jqGridRowValue().sfxmbh },
            success: function () {
                $("").trigger("");
            }
        })
    }
    function btn_details() {
        var keyValue = $("").jqGridRowValue().sfxmbh;
        $.modalOpen({
            id: "",
            title: "",
            url: "",//"" + keyValue,
            width: "",
            height: "",
            btn: null,
        });
    }
    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        $.submitForm({
            url: "",//"" + keyValue,
            param: $("").formSerialize(),
            success: function () {
                $("").resetSelection();
                $("").trigger("");
                $.loading(false);
            }
        })
    }
</script>
<form id="form1">

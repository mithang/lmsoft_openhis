<script>
    $(function () {
        gridList();
        $('').on('', window.parent.$.Newtouchtab.addTab);
    })
    function gridList() {
        var $gridList = $("");
        $gridList.newtouchLocalDataGrid({
            height: $(window).height() - 185,
            datatype: "",
            unwritten: false,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                //{ label: "", name: "", width: 80, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                 {
                     label: '', name: '', width: 80, align: '',
                     formatter: function (cellvalue) {
                         if (cellvalue == "") {
                             return "";
                         } else if (cellvalue == "") {
                             return "";
                         } else if (cellvalue == "") {
                             return "";
                         } else {
                             return "";
                         }
                     }
                 }, {

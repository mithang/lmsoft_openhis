                     formatter: function (cellvalue) {
                         if (cellvalue == 0) {
                             return ""
                         } else {
                             return ""
                         }
                     }
                 },
    {
        label: '', name: '', width: 50, align: '',
        formatter: function (cellvalue) {
            if (cellvalue == 0) {
                return ""
            } else {
                return ""
            }
        }
    },
    {
        label: '', name: '', width: 50, align: '',
        formatter: function (cellvalue) {
            if (cellvalue == 0) {
                return ""
            } else {
                return ""
            }
        }
    },
    { label: '', name: '', width: 50, align: '' },
    {
        label: '', name: '', width: 50, align: '',
        formatter: function (cellvalue) {
            if (cellvalue == 0) {
                return ""
            } else {
                return ""
            }
        }
    }],
            pager: "",
            sortname: '',
            rowNum: '',
            viewrecords: true
        });

        var mydata = [
            { id: "", sfxm: "", sfxmmc: "", py: "", dw: "", dj: "", dlmc: "", flmc: "", zfbl: "", ybdm: "", wjdm: "", mzzybz: "", ssbz: "", sfbz: 1 },

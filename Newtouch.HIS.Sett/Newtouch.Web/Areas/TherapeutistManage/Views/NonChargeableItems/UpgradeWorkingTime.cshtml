@{
    ViewBag.Title = "";
    Layout = "";
}
<script>
    var Editing_ysList = []; //Nhân viên trong vùng chỉnh sửa
    $(function () {
        $('').click(function () {
            var initIdSelected = "";
            $.each(Editing_ysList,
                function () {
                    initIdSelected += this.id + "";
                });
            $.modalOpen({
                id: "",
                title: "",
                url: "" + initIdSelected,
                showleftlalbel: false,
                width: "",
                height: "",
                callBack: function (iframeId) {
                    top.frames[iframeId].AcceptClick(function (data) {
                        staffTreeCallback(data);
                    });
                }
            });
        });

        init();
        gridList();

    });

    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            shrinkToFit: false,
            postData: getSearchPostData(),
            height: $(window).height() - 185,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 80, align: '' },
                {
                    label: '', name: '', width: 80, align: '',
                    formatter: function (cellvalue) {
                        return parseInt(cellvalue) < 10 ? "" + cellvalue : cellvalue
                    }
                },
                {
                    label: '', name: '', width: 80, align: '', formatter: function (cellvalue, options, rowObject) {
                        return (rowObject.sc / 60).toFixed(2) + "";
                    }
                }
            ],
            pager: "",
            sortname: '',
            rowNum: '',
            viewrecords: true
        });
        $("").click(function () {
            $gridList.jqGrid('',
                {
                    postData: getSearchPostData(),
                    url: ""
                }).trigger('');
        });
        $gridList.closest("").css({ '': '' });
    }

    function getSearchPostData() {
        var postData = {};
        postData.year = $('').val();
        postData.month = $('').val();
        postData.ysgh = "";
        if (!postData.year || !postData.month) {
            return;
        }
        if (Editing_ysList.length > 0) {
            postData.ysgh = Editing_ysList[0].gh;
        }
        return postData;
    }

    //Cây nhân viên Chọn Callback
    function staffTreeCallback(treeSeleData) {
        Editing_ysList = [];
        var zlsNames = "";
        $.each(treeSeleData, function () {
            zlsNames += this.text + "";
            Editing_ysList.push({ id: this.id, gh: this.value, Name: this.text, ks: this.Ex1, ksmc: this.Ex2 });
        })
        if (zlsNames.length > 0) {
            zlsNames = zlsNames.substring(0, zlsNames.length - 1);
        }

        $('').val(zlsNames);
    }

    function init() {
        var date = new Date();
        //Năm
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.yearArr && top.clients.yearArr.length) {
                    $.each(top.clients.yearArr, function () {
                        resultObjArr.push({ id: this, text: this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: 1900 + date.getYear(),
        });
        //Tháng
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.monthArr && top.clients.monthArr.length) {
                    $.each(top.clients.monthArr, function () {
                        resultObjArr.push({ id: this, text: parseInt(this) < 10 ? "" + this : this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: date.getMonth() + 1,
        });

        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                $.each(top.window.clients.sysDepartList, function (idx, val) {
                    resultObjArr.push({ id: val.Code, text: val.Name });
                });
                return resultObjArr;
            }
        });
    }

    function btn_edit() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", "");
            return;
        }
        var data = $("").jqGridRowValue();
        localStorage.setItem("", JSON.stringify(data));
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
</script>
<form id="form1">
    <div class="panel panel-default" style="margin-top:5px;">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <div style="padding: 2px; padding-right: 20px;">
            <table class="form">
                <tr>
                    <td class="formTitle">Năm：</td>
                    <td class="formValue">
                        <select id="Year" class="form-control">
                            <option value="-1">===Vui lòng chọn===</option>
                        </select>
                    </td>
                    <td class="formTitle">Tháng：</td>
                    <td class="formValue">
                        <select id="Month" class="form-control">
                            <option value="-1">===Vui lòng chọn===</option>
                        </select>
                    </td>
                    @*<th class="formTitle">Khoa：</th>
                        <td class="formValue">
                            <select id="ks" class="form-control">
                                <option value="-1">===Vui lòng chọn===</option>
                            </select>
                        </td>*@
                    <th class="formTitle">Nhà trị liệu：</th>
                    <td class="formValue">
                        <input id="zls" type="text" class="form-control" />
                    </td>
                    <td class="formValue" colspan="3">
                        <input type="button" id="btn_search" class="btn btn-primary" style="width: 50px; margin-left: 40px;" value="Tra cứu" />
                        <input type="button" class="btn btn-primary" onclick="btn_edit()" style="width: 55px; margin-left: 40px;" value="调整时长" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel" id="tabGrid">
        <table id="HisgridList" rel="tabGrid"></table>
        <div id="gridPager" rel="form1"></div>
    </div>
</form>

@{
    ViewBag.Title = "AddArrange";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    $(function () {
        gridList();
        init();

    });

    function init() {
        var date = new Date();
        //Năm
        $("#Year").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.yearArr && top.clients.yearArr.length) {
                    $.each(top.clients.yearArr, function () {
                        resultObjArr.push({ id: this, text: this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: 1900 + date.getYear(),
        });
        //Tháng
        $("#Month").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.monthArr && top.clients.monthArr.length) {
                    $.each(top.clients.monthArr, function () {
                        resultObjArr.push({ id: this, text: parseInt(this) < 10 ? "0" + this : this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: date.getMonth() + 1,
        });
    }
    function gridList() {
        var lastRowId;
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/TherapeutistManage/TherapeutistCompleteList/GetAllRehabDoctor",
            shrinkToFit: true,
            height: $(window).height() - 130,
            colModel: [
                { label: "Khóa chính", name: "Id", hidden: true, key: true },
                { label: 'Họ tên', name: 'Name', width: 150, align: 'left' },
                { label: 'Mã nhân viên', name: 'gh', width: 150, align: 'left' },
                { label: 'Số ngày', name: 'ts', width: 90, editable: true, align: "left" }
            ],
            viewrecords: true,
            onSelectRow_page: function (rowid, status) {
                if (rowid && lastRowId && rowid !== lastRowId) {   //&&: Tương đương vớitrue/fase(Xét xem có giá trị hay không)
                    $gridList.saveRow(lastRowId, function (result) {
                        // return false;   //Kiểm tra nội dung nhập có hợp lệ không，Hủy lưu và quay lạifalse    //Không hiệu lực v.v. cần sửa
                    }); //Trước tiên lưu dòng đang ở trạng thái chỉnh sửa    //function checksave
                }
                lastRowId = rowid;
                $gridList.jqGrid('editRow', rowid, true, null, function (result) {
                    return false;   //Kiểm tra nội dung nhập có hợp lệ không，Hủy lưu và quay lạifalse    //Không hiệu lực v.v. cần sửa
                }, null, null, function () {
                });
            },
            gridComplete: function () {
                //Bật hộp chỉnh sửa trong dòng
                EnableInlineEditBox();
            }
        });
    }

    //Bật hộp chỉnh sửa trong dòng
    function EnableInlineEditBox() {
        //GridTải xong thì bật chỉnh sửa trong dòng   1.Trước tiên lấy tất cả các dòngId  2.Duyệt và gọieditRowPhương thức
        var rowIds = $("#gridList").jqGrid('getDataIDs');
        for (var i = 0; i < rowIds.length; i++) {

            $("#gridList").jqGrid('editRow', rowIds[i], true, null, null, null, null, function (callbackRowId) {     //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.
            });
        }
    }

    function submitForm() {
        var year = $("#Year").val();
        var month = $("#Month").val();
        if (year == '-1' || month == '-1') {
            $.modalAlert("Vui lòng chọnNăm-tháng", "warning");
            return;
        }
        var par = {};
        var dic = [];
        var rowIds = $("#gridList").jqGrid('getDataIDs');
        for (var i = 0; i < rowIds.length; i++) {
            //Duyệt để hộp chỉnh sửa ở trạng thái đã lưu
            $("#gridList").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);
            var rowData = $("#gridList").jqGrid('getRowData', rowIds[i]);
            if (!rowData) {
                break;
            }
            if (!(/^(\+|-)?\d+$/.test(rowData.ts))) {
                $.modalAlert("Mã nhân viên（" + rowData.gh + "）Số ngày不是数字，Vui lòng xác nhận。", 'warning');
                return;
            }
            if ((rowData.ts > 31)) {
                $.modalAlert("Không được lớn hơn31天，Vui lòng xác nhận。", 'warning');
                return;
            }
        }
        var data = $("#gridList").jqGrid('getRowData_AllLine', undefined, false);
        var key = year + "," + month;
        dic.push({ 'key': key, 'value': data });
        par["vo"] = dic;
        $.najax({
            type: "POST",
            url: "/TherapeutistManage/TherapeutistCompleteList/AddRehabDoctorRange",
            data: par,
            dataType: "json",
            success: function () {
                $.loading(false);
                $.modalClose();
                $.modalMsg("Thao tác thành công", 'success');
            }
        })
    }

    function getSearchPostData() {
        var postData = {};
        postData.year = $('#Year').val();
        postData.month = $('#Month').val();

        if (!postData.year || !postData.month) {
            return;
        }
        return postData;
    }
</script>
<form>
    <div class="topPanel" style="border-bottom:1px solid rgb(221, 221, 221);margin-bottom: -1%;">
        <table class="form">
            <tr>
                <td class="formTitle"><span style="color:red">*</span>Năm</td>
                <td class="formValue">
                    <select id="Year" class="form-control">
                        <option value="-1">==Vui lòng chọn==</option>
                    </select>
                </td>
                <td class="formTitle"><span style="color:red">*</span>Tháng：</td>
                <td class="formValue">
                    <select id="Month" class="form-control">
                        <option value="-1">==Vui lòng chọn==</option>
                    </select>
                </td>
                <td class="formValue"></td>
            </tr>
        </table>
    </div>
    <div id="formPatSer" class="gridPanel" style="margin-top:1%; margin-left:1%">
        <table id="gridList"></table>
    </div>
</form>


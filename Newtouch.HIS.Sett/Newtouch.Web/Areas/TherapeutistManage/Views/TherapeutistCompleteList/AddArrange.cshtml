@{
    ViewBag.Title = "";
    Layout = "";
}
<script>
    $(function () {
        gridList();
        init();

    });

    function init() {
        var date = new Date();
        //Năm
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.yearArr && top.clients.yearArr.length) {
                    $.each(top.clients.yearArr, function () {
                        resultObjArr.push({ id: this, text: this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: 1900 + date.getYear(),
        });
        //Tháng
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.monthArr && top.clients.monthArr.length) {
                    $.each(top.clients.monthArr, function () {
                        resultObjArr.push({ id: this, text: parseInt(this) < 10 ? "" + this : this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: date.getMonth() + 1,
        });
    }
    function gridList() {
        var lastRowId;
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            shrinkToFit: true,
            height: $(window).height() - 130,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: '', name: '', width: 150, align: '' },
                { label: '', name: '', width: 150, align: '' },
                { label: '', name: '', width: 90, editable: true, align: "" }
            ],
            viewrecords: true,
            onSelectRow_page: function (rowid, status) {
                if (rowid && lastRowId && rowid !== lastRowId) {   //&&: 相当于true/fase(判断是否有值)
                    $gridList.saveRow(lastRowId, function (result) {
                        // return false;   //Xác minh nội dung nhập có hợp lệ không，Hủy lưu và quay lạifalse    //Không hiệu lực V.v. sửa chữa
                    }); //先保存处于编辑状态的那一行    //function checksave
                }
                lastRowId = rowid;
                $gridList.jqGrid('', rowid, true, null, function (result) {
                    return false;   //Xác minh nội dung nhập có hợp lệ không，Hủy lưu và quay lạifalse    //Không hiệu lực V.v. sửa chữa
                }, null, null, function () {
                });
            },
            gridComplete: function () {
                //Bật hộp chỉnh sửa trong dòng
                EnableInlineEditBox();
            }
        });
    }

    //Bật hộp chỉnh sửa trong dòng
    function EnableInlineEditBox() {
        //GridTải xong bật chỉnh sửa trong dòng   1.Lấy tất cả các dòng trướcId  2.Gọi duyệteditRowPhương thức
        var rowIds = $("").jqGrid('');
        for (var i = 0; i < rowIds.length; i++) {

            $("").jqGrid('', rowIds[i], true, null, null, null, null, function (callbackRowId) {     //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.
            });
        }
    }

    function submitForm() {
        var year = $("").val();
        var month = $("").val();
        if (year == '' || month == '') {
            $.modalAlert("", "");
            return;
        }
        var par = {};
        var dic = [];
        var rowIds = $("").jqGrid('');
        for (var i = 0; i < rowIds.length; i++) {
            //Duyệt để hộp chỉnh sửa ở trạng thái đã lưu
            $("").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);
            var rowData = $("").jqGrid('', rowIds[i]);
            if (!rowData) {
                break;
            }
            if (!(/^(\+|-)?\d+$/.test(rowData.ts))) {
                $.modalAlert("" + rowData.gh + "", '');
                return;
            }
            if ((rowData.ts > 31)) {
                $.modalAlert("", '');
                return;
            }
        }
        var data = $("").jqGrid('', undefined, false);
        var key = year + "" + month;
        dic.push({ '': key, '': data });
        par[""] = dic;
        $.najax({
            type: "",
            url: "",
            data: par,
            dataType: "",
            success: function () {
                $.loading(false);
                $.modalClose();
                $.modalMsg("", '');
            }
        })
    }

    function getSearchPostData() {
        var postData = {};
        postData.year = $('').val();
        postData.month = $('').val();

        if (!postData.year || !postData.month) {
            return;
        }
        return postData;
    }
</script>
<form>
    <div class="topPanel" style="border-bottom:1px solid rgb(221, 221, 221);margin-bottom: -1%;">
        <table class="form">
            <tr>
                <td class="formTitle"><span style="color:red">*</span>Năm</td>
                <td class="formValue">
                    <select id="Year" class="form-control">
                        <option value="-1">==Vui lòng chọn==</option>
                    </select>
                </td>
                <td class="formTitle"><span style="color:red">*</span>Tháng：</td>
                <td class="formValue">
                    <select id="Month" class="form-control">
                        <option value="-1">==Vui lòng chọn==</option>
                    </select>
                </td>
                <td class="formValue"></td>
            </tr>
        </table>
    </div>
    <div id="formPatSer" class="gridPanel" style="margin-top:1%; margin-left:1%">
        <table id="gridList"></table>
    </div>
</form>


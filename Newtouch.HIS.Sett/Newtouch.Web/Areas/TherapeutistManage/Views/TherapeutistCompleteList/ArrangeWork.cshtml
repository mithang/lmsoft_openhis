@{
    ViewBag.Title = "";
    Layout = "";
}
<style>
    #zls {
        width: 180px;
    }

    @@media screen and (max-width:1000px) {
        #zls {
            width: 100px;
        }
    }
</style>
<script>
    var Editing_ysList = []; //Nhân viên trong vùng chỉnh sửa
    $(function () {
        init();
        gridList();
        $('').click(function () {
            var initIdSelected = "";
            $.each(Editing_ysList,
                function () {
                    initIdSelected += this.id + "";
                });
            $.modalOpen({
                id: "",
                title: "",
                url: "" + initIdSelected,
                showleftlalbel: false,
                width: "",
                height: "",
                callBack: function (iframeId) {
                    top.frames[iframeId].AcceptClick(function (data) {
                        staffTreeCallback(data);
                    });
                }
            });
        });
    });

    function init() {
        var date = new Date;
        //Năm
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.yearArr && top.clients.yearArr.length) {
                    $.each(top.clients.yearArr, function () {
                        resultObjArr.push({ id: this, text: this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: 1900 + date.getYear(),
        });
        //Tháng
        $("").newtouchBindSelect({
            datasource: function () {
                var resultObjArr = new Array();
                if (top.clients.monthArr && top.clients.monthArr.length) {
                    $.each(top.clients.monthArr, function () {
                        resultObjArr.push({ id: this, text: parseInt(this) < 10 ? "" + this : this });
                    });
                }
                return resultObjArr;
            },
            selectedValue: date.getMonth() + 1,
        });
    }

    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            shrinkToFit: true,
            width: $("").width() - 2,
            postData: getSearchPostData(),
            height: $(window).height() - 185,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: '', name: '', width: 150, align: '' },
                { label: '', name: '', width: 150, align: '' },
                { label: '', name: '', width: 80, align: '' },
                {
                    label: '', name: '', width: 50, align: '', formatter: function (cellvalue) {
                        return parseInt(cellvalue) < 10 ? "" + cellvalue : cellvalue
                    }
                },
                { label: '', name: '', align: '' }
            ],
            pager: "",
            sortname: '',
            rowNum: '',
            viewrecords: true
        });
        $("").click(function () {
            $gridList.jqGrid('',
                {
                    postData: getSearchPostData(),
                    url: ""
                }).trigger('');
        });
    }

    function getSearchPostData() {
        var postData = {};
        postData.year = $('').val();
        postData.month = $('').val();
        postData.ysgh = "";
        if (!postData.year || !postData.month) {
            return;
        }
        if (Editing_ysList.length > 0) {
            postData.ysgh = Editing_ysList[0].gh;
        }
        return postData;
    }

    //Cây nhân viên Chọn Callback
    function staffTreeCallback(treeSeleData) {
        Editing_ysList = [];
        var zlsNames = "";
        $.each(treeSeleData, function () {
            zlsNames += this.text + "";
            Editing_ysList.push({ id: this.id, gh: this.value, Name: this.text, ks: this.Ex1, ksmc: this.Ex2 });
        })
        if (zlsNames.length > 0) {
            zlsNames = zlsNames.substring(0, zlsNames.length - 1);
        }

        $('').val(zlsNames);
    }
    function btn_add() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    //Chỉnh sửa
    function btn_edit() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var Id = $("").jqGridRowValue().Id;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + Id,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }

    //Xóa
    function btn_delete() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var Id = $("").jqGridRowValue().Id;
        $.deleteForm({
            url: "",
            param: { keyvalue: Id },
            success: function () {
                $("").trigger("");
            }
        });
    }

    //Chi tiết
    function btn_details() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var count = $("").getGridParam("");
        if (count === 0) {
            $.modalAlert("", '');
            return;
        }
        var Id = $("").jqGridRowValue().Id;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + Id,
            width: "",
            height: "",
            btn: null
        });
    }
    function btn_single() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
</script>
<form id="form1">
    <div class="topPanel">
        <div class="toolbar" style="padding-left:30px">
            <div class="btn-group">
                <a id="NF-add" class="btn btn-primary dropdown-text" href="javascript:void()" onclick="btn_single()"><i class="fa fa-plus"></i>Tạo mới</a>
                <a class="btn btn-primary dropdown-toggle" data-toggle="dropdown"><span class="caret"></span></a>
                <ul class="dropdown-menu pull-right">
                    <li><a id="NF-add" authorize="yes" onclick="btn_add()" href="javascript:void()">批量新建</a></li>
                    <li><a id="NF-add" authorize="yes" onclick="btn_single()" href="javascript:void()">单独新建</a></li>
                </ul>
            </div>
            <div class="btn-group">
                <a id="NF-edit" class="btn btn-primary dropdown-text" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
            </div>
            <div class="btn-group">
                <a id="NF-delete" class="btn btn-primary dropdown-text" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa</a>
            </div>
        </div>
        <div>
            <table class="form search" style="width:65%">
                <tr>
                    <td class="formTitle">Năm：</td>
                    <td class="formValue">
                        <select id="Year" class="form-control">
                            <option value="-1">===Vui lòng chọn===</option>
                        </select>
                    </td>
                    <td class="formTitle">Tháng：</td>
                    <td class="formValue">
                        <select id="Month" class="form-control">
                            <option value="-1">===Vui lòng chọn===</option>
                        </select>
                    </td>
                    <td class="formTitle"></td>
                    <td class="formTitle">
                        <div class="input-group">
                            <input type="text" id="zls" class="form-control" placeholder="Họ tên nhà trị liệu" />
                            <span class="input-group-btn">
                                <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                            </span>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel" id="tabGrid">
        <table id="HisgridList" rel="tabGrid"></table>
        <div id="gridPager"></div>
    </div>
</form>


@{
    ViewBag.Title = "";
    Layout = "";
}
<script src=""~/js/highcharts/highcharts.js""></script>
<script src=""~/js/highcharts/modules/exporting.js""></script>
<script>
    var captionCon = "";
    var time;
    var type;
    $(function () {
        loadChart();
        gridList();
    });

    function loadChart() {
        var OutpatientList = [];
        var InpatientList = [];
        $.ajax({
            url: "" + Math.random(),
            dataType: "",
            async: false,
            success: function (data) {
                if (data.data) {
                    OutpatientList = data.data.OutpatientList;
                    InpatientList = data.data.InpatientList
                } else {
                    for (var i = 0; i < 12; i++) {
                        OutpatientList.push([0]);
                        InpatientList.push([0]);
                    }
                }
            }
        })
        $('').highcharts({
            chart: {
                type: ''
            },
            title: {
                text: ''
            },
            xAxis: {
                categories: [
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    ''
                ]
            },
            yAxis: {
                min: 0,
                title: {
                    text: ''
                }
            },
            tooltip: {
                headerFormat: '',
                pointFormat: '' +
                '',
                footerFormat: '',
                shared: true,
                useHTML: true
            },
            plotOptions: {
                column: {
                    pointPadding: 0.2,
                    borderWidth: 0
                },
                series: {
                    cursor: '',
                    point: {
                        events: {
                            click: function () {
                                time = this.x;
                                type = this.series.name;
                                $("").text(type + "" + this.category + "");
                                $("").trigger('');
                            }
                        }
                    },
                    marker: {
                        lineWidth: 1
                    }
                }
            },
            series: [{
                name: "",
                data: [
                        OutpatientList[0].num, OutpatientList[1].num, OutpatientList[2].num, OutpatientList[3].num, OutpatientList[4].num, OutpatientList[5].num, OutpatientList[6].num, OutpatientList[7].num, OutpatientList[8].num, OutpatientList[9].num, OutpatientList[10].num, OutpatientList[11].num
                ]
            }, {
                name: "",
                data: [
                           InpatientList[0].num, InpatientList[1].num, InpatientList[2].num, InpatientList[3].num, InpatientList[4].num, InpatientList[5].num, InpatientList[6].num, InpatientList[7].num, InpatientList[8].num, InpatientList[9].num, InpatientList[10].num, InpatientList[11].num
                ]
            }]
        });
    }
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "" + Math.random(),
            caption: captionCon,
            postData: {},
            height: $(window).height() - 320,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: "", name: "", width: 80 },
                { label: '', name: "", width: 80, align: '' },
                { label: '', name: '', width: 100, align: '' }
            ],
            pager: "",
            sortname: '',
            rowNum: '',
            viewrecords: true
        });
        $("").click(function () {
            $gridList.jqGrid('',
                {
                    postData: { time: time, type: type },
                    url: "" + Math.random(),
                }).trigger('');
        });
    }


</script>
<div class="bar-chart">
    <div class="panel panel-default">
        <div id="bar" style="height: 200px; width: 100%;"></div>
    </div>
</div>
<div class="gridPanel">
    <input type="hidden" id="btn_search" />
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

            $('' +  String(this) + '').css('','');

        });

    }
    //Khởi tạo Lớp nổi
    function initRehabInlineFunc(rowid) {
        //部分列只读
        //$("" + rowid + "").attr('','');

        //var currlineCfh = $("").getRowData(rowid).cfh;
      
        ////Lớp nổi hạng mục
        $("" + rowid + "").sfxmFloatingSelector({
            djDecimalPlaces: 4,
            searchType: "",
            leftshift:200,
            ajaxparameters: function ($thisinput) {
            	return "" + brlx + "" + $.trim($thisinput.val());
            },
            itemdbclickhandler: function ($this) {
                $("" + rowid + "").val($this.attr(''))
                $("" + rowid + "").val($this.attr(''))
                $("" + rowid + "").val($this.attr(''))
                $("" + rowid + "").val($this.attr(''))
            },
        });
        //Lớp nổi tần suất
        $("" + rowid + "").pcFloatingSelector({
            showtext: '',
            attrcols: ['', ''],
            itemdbclickhandler: function ($this) {
                $("" + rowid + "").val($this.attr(''));
                $("" + rowid + "").val($this.attr(''));
            }
        });

        //部位浮层
        $("" + rowid + "").bwFloatingSelector({
            showtext: '',
            attrcols: ['', ''],
            checkItemActivity: function ($li, $thisinput) {
                var selected = false;//默认没有选中当前值
                var selectval = $thisinput.val();
                if (selectval) {
                    selectval = selectval.split('');
                    $.each(selectval, function () {
                        if (this == $li.html()) {
                            selected = true;
                        }
                    });
                }
                return selected;
            },
            itemdbclickhandler: function ($this) {
                var mcval = "";
                if (typeof ($this) !== "") {
                    $.each($this, function () {
                        mcval += this.attr('') + "";

                    });
                    if (mcval.length > 0) {
                        mcval = mcval.substring(0, mcval.length - 1);
                    };
                }
                $("" + rowid + "").val(mcval);
            },
        });
        $("" + rowid + "").newtouchBatchFloatingSelector({
            height: 170,
            width: 300,
            caption: "",
            url: '',
            clickautotrigger: true,
            ajaxparameters: function ($thisinput) {
                return '' + $("" + rowid + "").val();
            },
            colModel: [
                { label: '', name: '', widthratio: 40 },
                { label: '', name: '', widthratio: 60 },
                { label: '', name: '', hidden: true }
            ],
            itemdbclickhandler: function ($thistr) {
                $("" + rowid + "").val($thistr.find("").html());
                $("" + rowid + "").val($thistr.find('').html());
                return;
            },
        });

    }

    function checkItemActivity($li, $thisinput) {
        var selected = false;//默认没有选中当前值
        var selectval = $thisinput.val();
        if (selectval) {
            selectval = selectval.split('');
            $.each(selectval, function () {
                if (this == $li.html()) {
                    selected = true;
                }
            });
        }
        return selected;
    }
    //新治疗建议 Nút
    function newZljyRowData() {
        var dataRow = {
            jyId: null, //Chưa lưu cơ sở dữ liệu đến
            action: getRehbActionStr()
        };
        $("").jqGrid("", undefined, dataRow, "");
    }

    function newZljyAfterRowData(selRowId) {
        //获取当前添加的处方号
        var selRowData = $("").getRowData(selRowId);

        //新加一行
        var dataRow = {
            jyId: null, //Chưa lưu cơ sở dữ liệu đến
            action: getRehbActionStr()
        };
        $("").jqGrid("", undefined, dataRow, "", selRowId);
    }

    function getRehbActionStr() {
        return "";
    }
    //Xóa chi tiết
    function deleteRehRowData(selRowId, recalc) {
        if (!!selRowId) {
            var rowData = $("").jqGrid('', selRowId);
            if (rowData.jyId != null && rowData.jyId.length > 0) {
                delRowDataIds.push(rowData.jyId);
            }
            $("").jqGrid("", selRowId);
        }
    }

    //Chọn mẫu
    function GetTemplate() {
        xmjf = [];
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                var data = top.frames[iframeId].submitForm();
                $.each(data, function () {
                    var newRowData = {
                        jyId: "",
                        itemCode: this.sfxm,
                        itemName: this.sfxmmc,
                        pcmc: this.yzpcmc,
                        pc: this.yzpc,
                        mczll:this.zll,
                        sl: this.sl,
                        zxksdm: this.zxks,
                        zxksmc: this.zxksmc,
                        bw:this.bw,
                        bz: "",
                        action: getRehbActionStr()
                    };
                    xmjf.unshift(newRowData);   //Thêm dưới dạng mục mới //”Đầu mảng“
                });
                //Lại đưaxmMảng hiển thị tớigrid
                //$('').jqGrid("");
                $("").newtouchLocalDataGrid(null, xmjf);
            }
        });
    }

    //Thêm mới
    function newtouch_event_f2() {
        if ($('').val() == "" || $('').val().length == 0) {
            $.modalAlert("", '');
            return;
        }
        newZljyRowData();
    }
    function newtouch_event_f7() {

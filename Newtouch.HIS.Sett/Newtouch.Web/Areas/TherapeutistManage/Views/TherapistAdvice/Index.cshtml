    //Lưu
    function newtouch_event_f8() {
        if ($('').val()=="" || $('').val().length==0) {
            $.modalAlert("", '');
            return;
        }
       
        //Lấy tất cả các dòngId，Duyệt để hộp chỉnh sửa ở trạng thái đã lưu
        var rowIds = $("").jqGrid('');
        //alert(rowIds.length);
        if (rowIds.length == 0) {
            $.modalAlert("", '');
            return;
        }
        for (var i = 0; i < rowIds.length; i++) {
            var saveResult = $("").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);

            if (!saveResult) {
                EnableRehabInlineEditBox();    //Khởi động lại và bật chỉnh sửa Nếu không lần sauSavekhi đó sẽ trả vềfalse
                return;   //Lưu thất bại，Thìreturn
            }
        }
        var gridzljyData = $("").jqGrid('');
        gridzljyData.push($("").jqGrid('', rowIds[rowIds.length - 1]));
        if (!gridzljyData || gridzljyData.length == 0) {
            EnableRehabInlineEditBox();    //Khởi động lại và bật chỉnh sửa Nếu không lần sauSavekhi đó sẽ trả vềfalse
            $.modalAlert("", '');
            return;
        }
        $.each(gridzljyData, function () {    //Loại bỏaction
            for (var i = 0; i < $(this).length; i++) {
                delete $(this)[i].action;
            }
        });
        $.najax({
            url: "",
            dataType: "",
            data: { mxList: gridzljyData, blh: $('').val(), delRowIds:JSON.stringify(delRowDataIds), brlx: brlx, mzzyh: $('').val() },
            type: "",
            success: function (data) {
                $.modalAlert("", '');
                GetPatZLJYAjax($('').val());
                window.$('').trigger('');
            },
            complete: function () {
                EnableRehabInlineEditBox();    //Khởi động lại và bật chỉnh sửa Nếu không lần sauSavekhi đó sẽ trả vềfalse
            }
        });
    }

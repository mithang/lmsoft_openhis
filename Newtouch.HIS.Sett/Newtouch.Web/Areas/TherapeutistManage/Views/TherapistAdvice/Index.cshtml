    //根据选择的病人加载病人信息及治疗建议列表
    function GetPatZLJYAjax(mzzyh) {
        //$.loading(true, "");
        $.ajax({
            type: "",
            url: ""GetPatZLJYInfo"",
            data: { mzzyh: mzzyh, brlx: brlx },
        dataType: "",
        cache: true,
        async: true,
        success: function (ajaxresp) {
            if (ajaxresp.state === '') {
                setPatInfoModel(ajaxresp.data.MzZyPatInfoDto); //Gán thông tin cơ bản cá nhân
                $('').jqGrid("");
                $.each(ajaxresp.data.TherapistAdviceDto, function () {
                    this.action = getRehbActionStr();
                })
                $("").newtouchLocalDataGrid(null, ajaxresp.data.TherapistAdviceDto);
            } else if (ajaxresp.state === '') {
                $.modalAlert("", '');
            }
        },
        complete: function () {
            $.loading(false);
        }
    });
    }


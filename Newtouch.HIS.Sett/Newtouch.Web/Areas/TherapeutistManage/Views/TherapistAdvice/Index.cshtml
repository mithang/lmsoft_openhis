    //治疗建议列表
    function gridzljy() {
        var $gridzljy = $("");
        $gridzljy.jqGrid({
            datatype: '',
            data: kflocaldata,
            height: $(window).height() - 230,
            //altRows: true,//隔行换色
            shrinkToFit: true,   //true:按比例初始化列宽度 false:Sử dụngcolModel指定的宽度
            autowidth: true,
            rownumbers: true,  //是否显示序号
            multiselect: true,
            editurl: "",  //Dữ liệu gửi máy chủ tới không chỉnh sửa dòng
            unwritten: false,
            colModel: [
                { label: '', name: '', width: 120, align: '', hidden: true },
                {
                    label: '', name: '', width: 120, editwidth: '', align: '', editable: true, hidden: true
                },
                {
                    label: '', name: '', width: 400, editwidth: '', align: '', editrules: { required: true }, editable: true, autocomplete: ''
                },
                { label: '', name: '', width: 100, editwidth: '', align: '', editrules: { required: true }, editable: true },
                { label: '', name: '', width: 100, editwidth: '', align: '', editable: true },
                { label: '', name: '', editwidth: '', align: '', editable: true, hidden: true },

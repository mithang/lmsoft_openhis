                        dataEvents: [
                                {
                                    type: '',
                                    fn: function (e) {
                                        var cellval = $(this).val();
                                        if (cellval.replace(/(^\s*)|(\s*$)/g, "") == "") {
                                            $.modalAlert("", '');
                                            return;
                                        }
                                        if (isNaN(cellval)) {
                                            $.modalAlert("", '');
                                            $(this).val('')


@{
    ViewBag.Title = "";
    Layout = "";
}

<style>
    .table-responsive {
        border: 0px solid #ddd;
    }
</style>

<form>
    <div style="border-bottom:1px solid rgb(221, 221, 221);">
        <table class="form">
            <tr>
                <th class="formTitle">Số bệnh án：</th>
                <td class="formValue">
                    <input id="blh" name="blh" type="text" class="form-control" placeholder="Vui lòng nhập số bệnh án" />
                </td>
                <th class="formTitle">Họ tên：</th>
                <td class="formValue">
                    <input id="xm" name="xm" type="text" class="form-control" placeholder="Vui lòng nhập họ tên" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Thời gian bắt đầu：</th>
                <td class="formValue">
                    <input id="kssj" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                </td>
                <th class="formTitle">Thời gian kết thúc：</th>
                <td  class="formValue">
                    <input id="jssj" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                </td>
                <td class="formValue">
                    <input type="button" id="btn_search" class="btn btn-primary" style="margin-left: 60px;" value="Tra cứu" />
                </td>
            </tr>
        </table>
    </div>
    <!--处方信息 Bao gồm số thẻ Số bệnh án Họ tên -->
    <div id="prediv" class="gridPanel" style="margin-top:1%; margin-left:1%">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>

<script>

    //Cái trướcwindowĐối tượng
    var prevWindow;

    var from = $.request("");
    if (!!from) {
        prevWindow = top.top.frames[from];
    }
    else {
        prevWindow = $.currentWindow();
    }

    $(function () {
        var obj = new Object;
        obj.blh = $.request("");
        obj.kssj = $.request("");
        obj.jssj = $.request("");
        var searInfo = new preSearchInfo();
        //Tải dữ liệu
        searInfo.init(obj);

        //Tra cứu
        $("").click(function () {
            $("").jqGrid('', {
                postData: { blh: $("").val(), xm: $("").val(), kssj: $("").val(), jssj: $("").val(), r: Math.random() },
            }).trigger('');
        });
    });

    var preSearchInfo = (function () {
        //Tải danh sách
        var loadGrid = function (data) {
            var $gridList = $("");
            $gridList.newtouchLocalDataGrid({
                height: $(window).height() - 200,
                //autowidth: false,
                //width: $("").width() - 2,
                //url: ""+ Math.random(),
                //postData: { blh: $("").val(), xm: $("").val() },
                caption: '',
                unwritten: false,
                colModel: [
                    { label: '', name: '', width: 150, align: '' },
                    { label: '', name: '', width: 120, align: '' },
                    { label: '', name: '', width: 100, align: '' },
                    { label: '', name: '', width: 120, align: '' }
                ],
                pager: "",
                sortname: '',
                viewrecords: true
            });

            $("").newtouchLocalDataGrid(null, mydata);
        };

        var mydata = [
               {
                   cfh: '', je: '', ys: '', CreateTime: ''
               },
               {
                   cfh: '', je: '', ys: '', CreateTime: ''
               },
               {
                   cfh: '', je: '', ys: '', CreateTime: ''
               }
        ];
     
        var myPreSearchInfo = function (data) {

        }
        //Sự kiện tải
        myPreSearchInfo.prototype.init = function (data) {
            if (!!!data.blh) {
                $("").val("");
            } else {
                $("").val(data.blh);
            }
            if (!!!data.kssj) {
                $("").val("");
            } else {
                $("").val(data.kssj);
            }
            if (!!!data.jssj) {
                $("").val("");
            } else {
                $("").val(data.jssj);
            }

            loadGrid(data);
        };

        return myPreSearchInfo;
    }());

    //jqGrid Nhấp đúp để chọn một dòng
    function btn_edit() {
        PreSearchConfirm();
    }

    //Xác nhận Gọi từ trang chính
    function PreSearchConfirm() {
        DbClickGrid();
    }

    //双击
    function DbClickGrid() {
        var $gridList = $("");
        var patId = $gridList.jqGridRowValue().patId;
        var cfh = $gridList.jqGridRowValue().cfh;
        var obj = new Object();
        obj.patId = patId;
        obj.cfh = cfh;
        if (!!!obj.cfh) {
            $.modalMsg("", "");
            return;
        }
        prevWindow.getPatInfoAjax(obj);

        //Đóng cửa sổ
        ReceiptCancle();
    }

    //Hủy
    function ReceiptCancle() {
        $.modalClose();
    }


</script>





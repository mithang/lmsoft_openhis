
@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="panel panel-default" style="margin-bottom: 4px;">
    <div class="panel-heading navb-bg">
        Điều kiện lọc
    </div>
    <div style="padding-right:20px;">
        <table class="form">
            <tr>
                <th class="formTitle">Số bệnh án：</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="blh" placeholder="" style="width: 48%; float: left;" />
                    <input type="button" class="btn btn-default btn-md btn-default-color" style="width: 15%;margin-left: 2%;" title="Chọn bệnh nhân" value="Tra cứu" onclick="GetPatSerarchView($('#blh').val());">
                </td>
                <th class="formTitle">Họ tên：</th>
                <td class="formValue">
                    <input type="text" class="form-control" id="xm" placeholder="" />
                </td>
                <th class="formTitle">计费时间：</th>
                <td class="formValue" colspan="2">
                    <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; float:left;" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    <span style="margin-left:2%;float:left;">—</span>
                    <input id="jssj" type="text" class="form-control input-wdatepicker" style="width :41%;float:left;margin-left:2%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                </td>
                <td></td>
                <td>
                    <input type="button" id="btn_search" class="btn btn-primary form-an" style="width:40%;margin-left:10%;" value="Tra cứu" onclick="SerarchPresList()" />
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="panel panel-default" style="margin-bottom: 4px;">
    <div class="panel-heading navb-bg">
        Thông tin bệnh nhân
    </div>
    <div style="padding-right:20px;">
        <table class="form">
            <tr>
                <th class="formTitle">Số bệnh án：</th>
                <td class="formValue">
                    <label id="type">R25639</label>
                </td>
                <th class="formTitle">Họ tên：</th>
                <td class="formValue">
                    <label id="xm">大白</label>
                </td>
                <th class="formTitle">Giới tính：</th>
                <td class="formValue">
                    <label id="xb">Nữ</label>
                </td>
                <th class="formTitle">Tuổi：</th>
                <td class="formValue">
                    <label id="nl">26</label>
                </td>
            </tr>
            <tr>
                <td class="formTitle">Số bảo hiểm：</td>
                <td class="formValue">
                    <label id="bxh">35010343123456743</label>
                </td>
                <td class="formTitle">费别：</td>
                <td class="formValue">
                    <label id="fb">Tự chi trả</label>
                </td>
                <td class="formTitle">Chẩn đoán lâm sàng：</td>
                <td class="formValue">
                    <label id="lczd">腰痛</label>
                </td>
                <th class="formTitle">施术部位：</th>
                <td class="formValue">
                    <label id="ssbw">腰背部 膈腧 心腧 督腧</label>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>
@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 4, 6 },
    F6Text = ""
})

<script>
    $(function () {
        var mydata = [,
       {
           cfh: '', kflb: '', xmmc: '', sl: '', dj: 30.00, tsl: '', dw: '', sc: '', je: 30.00, sfrq: ''
       },
       {
           cfh: '', kflb: '', xmmc: '', sl: '', dj: 30.00, tsl: '', dw: '', sc: '', je: 90.00, sfrq: ''
       },
       {
           cfh: '', kflb: '', xmmc: '', sl: '', dj: 30.00, tsl: '', dw: '', sc: '', je: 120.00, sfrq: ''
       },
       {
           cfh: '', kflb: '', xmmc: '', sl: '', dj: 30.00, tsl: '', dw: '', sc: '', je: 90.00, sfrq: ''
       }
        ];
        gridList(mydata);
    })

    //Tra cứu bệnh nhân
    function GetPatSerarchView(blh) {
        if (!!!blh) {
            blh = '';
        };
        $.modalOpen({
            id: "",
            title: "",
            url: "" + Math.random() + "" + blh,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid();
            }//Hàm callback xác nhận khi nhấn cửa sổ
        });
    }

    //Bệnh nhân đã chọn callback
    function getPatInfoAjax(selePatInfo) {
        $('').val(selePatInfo.blh)
        $('').attr('', selePatInfo.patId);
        $('').val(selePatInfo.xm);
    }

    //处方查询
    function SerarchPresList() {
        if ($("").val() == "") {
            $.modalAlert("", '');
            return false;
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + Math.random() + "" + $("").val() + "" + $('').val() + "" + $('').val(),
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].DbClickGrid();
            }//Hàm callback xác nhận khi nhấn cửa sổ
        });
    }

    //处方明细
    function gridList(mydata) {
        var $gridList = $("");
        $gridList.newtouchLocalDataGrid({
            //url: "" + Math.random(),
            //postData: getSearchPostData(),
            height: $(window).height() - 310,
            unwritten: false,
            caption: "",
            colModel: [
            { label: "", name: "", width: 150, align: "" },
            { label: "", name: "", width: 80, align: "" },
            { label: "", name: "", width: 100, align: "" },
            { label: "", name: "", width: 80, align: "" },
            {
                label: "", name: "", width: 80, align: "",
                formatter: function (val) {
                    if (val) {
                        return val.toFixed(4);
                    } else {
                        return '';
                    }
                }
            },
            { label: "", name: "", width: 100, editable: true, editrules: { integer: true, minValue: 1 }, align: "" },
            { label: "", name: "", width: 60, align: "" },
            { label: "", name: "", width: 80, align: "" },
            {
                label: "", name: "", width: 80, align: "",
                formatter: function (val) {
                    if (val) {
                        return val.toFixed(2);
                    } else {
                        return '';
                    }
                }
            },
            {
                label: "", name: "", width: 100, align: "",
                formatter: "", formatoptions: { srcformat: '', newformat: '' }
            }
            ],
            multiselect: true,
            pager: "",
            sortname: '',
            viewrecords: true,
            onSelectRow: function (rowid) {
                $("" + $.jgrid.jqID(rowid) + "").focus();
            },
            gridComplete: function () {
                //Bật hộp chỉnh sửa trong dòng
                EnableInlineEditBox();
            }
        },mydata);
        $("").click(function () {
            if ($('').val() && $('').val() && ($('').val() > $('').val())) {
                $.modalAlert("", '');
                return;
            }
            $gridList.jqGrid('', {
                postData: getSearchPostData()
            }).trigger('');
        })
    }

    //Bật hộp chỉnh sửa trong dòng
    function EnableInlineEditBox() {
        var rowIds = $("").jqGrid('');
        for (var i = 0; i < rowIds.length; i++) {

            $("").jqGrid('', rowIds[i], true, null, null, null, null, function (callbackRowId) {
            });
        }
    }

    //Điều kiện tra cứu
    function getSearchPostData() {
        var keyword = $("").val();
        var blh = $("").val();
        var xm = $("").val();
        var kssj = $("").val();
        var jssj = $("").val();
        return { blh: blh, xm: xm, keyword: keyword, kssj: kssj, jssj: jssj };
    };

</script>


    //Tải lên
    $('').click(function () {
        var seleRow = check();
        // dữ liệu lấy cần tải lên
        var orgId = '';
        var operatorId = '';
        var operatorName = '';
        var crkId = seleRow.length > 1 ? "" : seleRow[0].mlbm_id;
        if ($("").val() === '') {
            $.modalAlert("", '');
            return;
        }
        if (!!!seleRow) {
            return;
        }
        if (seleRow.length > 1) {
            // 弹出确认框，Xác nhận tải lên
            $.modalConfirm("", function(f) {
                if (f){
                    uploadData(orgId, operatorId, operatorName, crkId);
                }
            });
        } else {
            // Chọn dữ liệu dòng một，直接上传
            uploadData(orgId, operatorId, operatorName, crkId);
        }
        function uploadData(orgId, operatorId, operatorName, crkId) {
            var tradiNumber = $("").val();
            var data;
            var upUrl;
            // TheotradiNumber来选择不同的接口
            switch (tradiNumber) {
                case '':
                    upUrl = "";
                    data = {
                        "": orgId,
                        "": operatorId,
                        "": operatorName,
                        "": crkId
                    };
                    break;
                case '':
                    upUrl = "";
                    data = {
                        "": orgId,
                        "": operatorId,
                        "": operatorName,
                        "": crkId
                    };
                    break;
                case '':
                    upUrl = "";
                    data = {
                        "": orgId,
                        "": operatorId,
                        "": operatorName,
                        "": crkId
                    };
                    break;
                case '':
                    upUrl = "";
                    data = {
                        "": orgId,
                        "": operatorId,
                        "": operatorName,
                        "": crkId
                    };
                    break;
                case '':
                    upUrl = "";
                    data = {
                        "": orgId,
                        "": operatorId,
                        "": operatorName,
                        "": crkId
                    };
                    break;
                case '':
                    upUrl = "";
                    data = {
                        "": orgId,
                        "": operatorId,
                        "": operatorName,
                    };
                    break;
                case '':
                    upUrl = "";
                    data = {
                        "": orgId,
                        "": operatorId,
                        "": operatorName
                    };
                    break;
                default:
                    $.modalAlert("", '');
                    return;
            }

            // 发起上传请求
            $.najax({
                url: upUrl,
                dataType: "",
                data: data,
                type: "",
                success: function(response) {
                    $.modalAlert("", '');
                    $.modalClose();
                },
                error: function(error) {
                    $.modalAlert("", '');
                }
            });
        }

    });


		//var setl_id = rowData.setl_id;
		if (rowData.patId == null) {
			$.modalAlert("", "");
			return;
		}
		if ($('').val() == "" || $('').val() == "" || $('').val() == "") {
			$.modalOpen({
				id: "",
				async: false,
				title: "",
				url: "" + rowData.zyh + "" + $('').val(),
				width: "",
				height: "",
				callBack: function (iframeId) {
					$.modalClose("");
				}
			});
		}

	}


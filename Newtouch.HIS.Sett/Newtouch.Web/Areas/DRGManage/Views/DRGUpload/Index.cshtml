
@{
    Layout = "";
}


<style>
    @@media screen and (min-width:600px) {
        #btn_ {
            width: 160px;
        }

        .form .formTitle {
            width: 55px;
        }

        .form .formValue {
            width: 100px;
        }
    }

    @@media screen and (min-width:1000px) {
        .form .formTitle {
            width: 25px;
        }

        .form .formValue {
            width: 60px;
        }
    }
</style>
<form>
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form">
            <tr>
                <th class="formTitle">Thời gian quyết toán：</th>
                <td class="formValue" style="width:150px;">
                    <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; float:left;" value="@DateTime.Now.AddMonths(-6).ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    <span style="margin-left:1%;float:left">—</span>
                    <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:43%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                </td>
                <th class="formTitle" style="width:70px;padding-right:12px;">Tình hình tải lên：</th>
                <td class="formValue">
                    <select id="scqk" name="scqk" class="form-control">
                        <option value="">==Vui lòng chọn==</option>
                        <option value="0">Đã tải lên</option>
                        <option value="1">Tải lên thất bại</option>
                        <option value="2">Chưa tải lên</option>
                    </select>
                </td>
                <th class="formTitle">Họ tên：</th>
                <td class="formValue">
                    <input id="zyh" name="zyh" type="text" autocomplete="off" class="form-control" />
                </td>
                <td class="formValue">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary form-an" style="width: 50px; margin-left: 40px;" value="Tra cứu" />

                </td>
                <th class="formTitle" colspan="2">
                    <input type="button" id="btn_upload" class="btn btn-md btn-primary form-an" style="width: 50px; margin-left: 40px;" value="Tải lên" />

                </th>

                <th class="formTitle"></th>
                <td class="formValue"></td>
            </tr>
        </table>
    </div>
    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>
<script>
    $(function () {
        gridList();

        $("").keyupEnterEvent(function () {
            $("").trigger("");
        });
    });

    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            postData: getSearchPostData(),
            height: $(window).height() - 128,
            colModel: [
                { label: '', name: '', width: 100, align: '', hidden: true },
                //{ label: '', name: '', width: 160, align: '' },
                { label: '', name: '', width: 160, align: '' },
                { label: '', name: '', width: 160, align: '' },
                { label: '', name: '', width: 160, align: '' },
                { label: '', name: '', width: 160, align: '' },
                { label: '', name: '', width: 160, align: '' },
                { label: '', name: '', width: 160, align: '' },
                { label: '', name: '', width: 160, align: '' },
                { label: '', name: '', width: 160, align: '' },
                { label: '', name: '', width: 160, align: '' },
                { label: '', name: '', width: 160, align: '' },
                { label: '', name: '', width: 160, align: '' },
                { label: '', name: '', width: 160, align: '' },
                { label: '', name: '', width: 160, align: '' },
                { label: '', name: '', width: 160, align: '' },

            ],
            pager: "",
            sortname: '',
            rowNum: '',
            viewrecords: true,
            multiselect: true,
            //onSelectRow: function (rowid) {
            //    $("" + $.jgrid.jqID(rowid) + "").focus();
            //},
        });
        $("").click(function () {
            $gridList.jqGrid('', {
                postData: getSearchPostData(),
                page: 1,
            }).trigger('');
        });
    }

    //Điều kiện tra cứu
    function getSearchPostData() {
        var kssj = $("").val();
        var jssj = $("").val();
        var scqk = $("").text();
        var zyh = $("").val();
        return { kssj: kssj, jssj: jssj, scqk: scqk, zyh: zyh };

    }

    //Tải lên
    $('').click(function () {
        var seleRow = check();
        if (!!!seleRow) {
            return;
        }

        //console.log(seleRow);
        $.najax({
            url: "",
            dataType: "",
            data: { list: seleRow },
            type: "",
            success: function (data) {
                //callBack();
                $.modalAlert("", '');
                $.modalClose();
            }
        });
    });

    function check() {
        //Lấy dòng đã chọn
        var seleRow = $("").jqGridRowValue();
        var setl_id = seleRow.setl_id;
        if (seleRow.length == 0) {
            $.modalAlert("", "");
            return;
        }
        return seleRow;

        //var selRowIds = $("").jqGrid('', '');
        //if (selRowIds.length == 0) {
        //    $.modalAlert("", '');
        //    return;
        //}

        ////Lấy tất cả các dòngId，Duyệt để hộp chỉnh sửa ở trạng thái đã lưu
        //var rowIds = $("").jqGrid('');
        //return selRowIds;
    }


    //Liên kết lớp nổi chọn số nhập viện
    $('').newtouchBatchFloatingSelector({
        width: 500,
        height: 200,
        caption: "",
        clickautotrigger: true,
        url: "",
        ajaxparameters: function ($thisinput) {
            var keyword = $thisinput.val().trim();
            var zyh = $("").val();
            return "" + zyh;
        },
        itemdbclickhandler: function ($thistr, $thisinput) {
            if (!!$thistr.attr('')) {
                //if ($thistr.attr('') !== "" && $thistr.attr('') !== undefined && $thistr.attr('') !== null) {
                //    $('').val($.getDate({ date: $thistr.attr('') }));
                //}
                //if ($thistr.attr('') !== "" && $thistr.attr('') !== undefined && $thistr.attr('') !== null) {
                //    $('').val($.getDate({ date: $thistr.attr('') }));
                //} else {
                //    $('').val($.getDate());
                //}
                $('').val($thistr.attr(''));
                //submit();
            }
        },
        colModel: [
            { label: '', name: '', width: 100 },
            { label: '', name: '', hidden: true },
            { label: '', name: '', hidden: true },
            { label: '', name: '', width: 100, align: '', formatter: function (cellvalue) { if (cellvalue == "") return 3; if (cellvalue == "") return 1; } },
            { label: '', name: '', width: 120, align: '' },
            { label: '', name: '', hidden: true, width: 100, align: '' },
            {
                label: '', name: '', width: 50, align: '', formatter: function (cellvalue) {
                    return $.getGender(cellvalue);
                }
            },
            {
                label: '', name: '', width: 50, align: '', formatter: function (cellvalue, a, b) {
                    return getAgeFromBirthTime({ begin: b.csny }).text;
                }
            }
        ]
    });
</script>


                //{
                //    label: 'Trạng thái đang nằm viện', name: 'zybz', width: 60, align: 'left', formatter: function (cellvalue) {
                //        if (cellvalue) {
                //            switch (cellvalue) {
                //                case "0":
                //                case "1":
                //                case "2":
                //                case "7":
                //                    return "Đang nằm viện";
                //                    break;
                //                case "3":
                //                    return "Đã xuất viện";
                //                    break;
                //                case "9":
                //                    return "Đã hủy";
                //                    break;

                //            }
                //        }
                //    }
                //},
                //{ label: 'Ngày bắt đầu quyết toán', name: 'jsksrq', width: 140, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                //{ label: 'Ngày kết thúc quyết toán', name: 'jsjsrq', width: 140, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                //{ label: 'Tổng số tiền', name: 'zje', width: 80, align: 'left', formatter: 'number', formatoptions: { thousandsSeparator: ",", decimalPlaces: 2 } },
                //{ label: 'Thời gian quyết toán', name: 'CreateTime', width: 150, align: 'left' },
                //{ label: 'Nhân viên quyết toán', name: 'CreatorCode', width: 100, align: 'left' },
                //{
                //    label: 'Trạng thái quyết toán', name: 'jszt', width: 80, align: 'left', formatter: function (cellvalue) {
                //        if (cellvalue == "1") {
                //            return "Đã quyết toán";
                //        }
                //        if (cellvalue == "2") {
                //            return "Đã hoàn trả";
                //        }
                //        return "Khác"
                //    }
                //},
                //{
                //    label: 'Tính chất quyết toán', name: 'jsxz', width: 80, align: 'left', formatter: function (cellvalue) {
                //        if (cellvalue == "1") {
                //            return "Quyết toán xuất viện";
                //        }
                //        if (cellvalue == "2") {
                //            return "Quyết toán chi phí";
                //        }
                //        return "Khác"
                //    } }
            ],
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords: true,
            gridComplete: completeMethod//Sau khi bảng tải xong thực hiện phương thức thống kê
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: getpostData(),
            }).trigger('reloadGrid');
        });
    }
    function completeMethod() {
        var zje = $(this).getCol('zje', false, 'sum');
        var xj = $(this).getCol('xj', false, 'sum');
        var jz = $(this).getCol('jz', false, 'sum');
        $(this).footerData('set', { "sfsj": 'Tổng cộng:', zje: zje, xj: xj, jz: jz }, false);
    }
    jQuery("#grid").jqGrid('navGrid', '#pager', {
        edit: false,
        add: false,
        del: false,
        search: false
    });
    function getpostData() {
        return {
            keyword: $("#txt_keyword").val(), jsksrq: $("#jsksrq").val(), jsjsrq: $("#jsjsrq").val(),zybz:$('#zybz').val()
        };
    }

    //Sự kiện nhấn Enter
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    $('#zybz').change(function () {
        $('#btn_search').trigger('click');
    });
</script>

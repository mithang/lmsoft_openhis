            colModel: [
                { label: 'Số nhập viện', name: 'zyh', width: 50, align: 'left', key: true },
                { label: 'Họ tên', name: 'xm', width: 60, align: 'left' },
                { label: 'Tuổi', name: 'nlshow', width: 40, align: 'left' },
                { label: 'Khoa', name: 'ks', width: 60, align: 'left' },
                { label: 'Bác sĩ điều trị chính', name: 'zzys', width: 60, align: 'left' },
                { label: 'Thời gian nhập viện', name: 'ryrq', width: 60, align: 'left' },
                { label: 'Chẩn đoán nhập viện', name: 'ryzd', width: 100, align: 'left' },
                { label: 'Thời gian xuất viện', name: 'cyrq', width: 60, align: 'left' },
                { label: 'Chẩn đoán xuất viện', name: 'cyzd', width: 200, align: 'left' },
                { label: 'Thời gian thu phí', name: 'sfsj', width: 110, align: 'left' },
                { label: 'Tổng chi phí', name: 'zje', width: 60, align: 'left'},
                { label: 'Tiền mặt', name: 'xj', width: 60, align: 'left' },
                { label: 'Ghi sổ', name: 'jz', width: 60, align: 'left' },
                { label: 'Loại quyết toán', name: 'jslx', width: 60, align: 'left' },

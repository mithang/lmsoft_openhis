
@{
    ViewBag.Title = "";
    //Layout = null;
    Layout = "";
}

<style type="text/css">
    table {
        width: 95%;
        line-height: 35px;
        font-weight: bold;
        margin-top: 15px;
    }

        table th {
            text-align: right;
            width: 50%;
        }

        table td {
            text-align: left;
            width: 50%;
        }
</style>

<table>
    <tbody>
        <tr>
            <th>Khoản phải thu：</th>
            <td>@ViewBag.yingshoukuan</td>
        </tr>
        <tr>
            <th>Số tiền thực thu：</th>
            <td>@ViewBag.ssk</td>
        </tr>
        <tr>
            <th>舍入差额：</th>
            <td>@ViewBag.srce</td>
        </tr>
        <tr>
            <th>Tiền thừa：</th>
            <td style="color:red;">@ViewBag.zhaoling</td>
        </tr>
    </tbody>
</table>


@using Newtouch.Tools;
@using Newtouch.Infrastructure;
@model Newtouch.HIS.Domain.DTO.OutputDto.HosSettPatClassifyChargePreviewDto
@{
    ViewBag.Title = "";
    Layout = "";
}

<style type="text/css">
    .table {
        margin-bottom: 1%;
    }

        .table > tbody > tr > td, .table > tbody > tr > th {
            font-weight: normal;
            border: 0;
            line-height: 1.0;
            padding:5px 1px;
        }
</style>

<div style="margin:2% 7% 0 7%;">
    <table class="table">
        <tr>
            <th class="text-right">Số nhập viện：</th>
            <td class="text-left">
                @Model.HospSettPatInfo.zyh
            </td>
            <th class="text-right">Số thẻ：</th>
            <td class="text-left">
                @Model.HospSettPatInfo.kh
            </td>
            <th class="text-right">Họ tên：</th>
            <td class="text-left">
                @Model.HospSettPatInfo.xm
            </td>
            <th class="text-right">Giới tính：</th>
            <td class="text-left">@(Model.HospSettPatInfo.xb == null ? "" : ((EnumSex)(Model.HospSettPatInfo.xb.ToInt(-1))).GetDescription(""))</td>
        </tr>
        <tr>
            <th class="text-right">Tuổi：</th>
            <td class="text-left">
                @Model.HospSettPatInfo.csny.ToAge()
            </td>
            <th class="text-right">Ghi sổ：</th>
            <td class="text-left">
                @Model.jzfy.ToString("")
            </td>
            <th class="text-right">Tự chi trả theo phân loại：</th>
            <td class="text-left">
                @Model.flzf.ToString("")
            </td>
            <th class="text-right">Tự chi trả：</th>
            <td class="text-left">
                @Model.zifu.ToString("")
            </td>
        </tr>
        <tr>
            <th class="text-right"></th>
            <td class="text-left"></td>
            <th class="text-right"></th>
            <td class="text-left"></td>
            <th class="text-right">Tự chi trả：</th>
            <td class="text-left">
                @Model.zifei.ToString("")
            </td>
            <th class="text-right">Khác：</th>
            <td class="text-left">
                @Model.jmje.ToString("")
            </td>
        </tr>
    </table>
</div>

<div class="rows" style="margin:0 3%;margin-top: 0.5%;">
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading">
            Quyết toán chi phí
        </div>
        <div class="panel-body" style="padding: 5px 15px;">
            <div>
                @*款项操作*@
                <table class="form">
                    <tr>
                        <td class="formValue">
                            <select id="ddlZYJSChargeType" class="form-control required"></select>
                        </td>
                        <td class="formValue" style="width:100px;">
                            <input type="text" id="txtszje" class="form-control form-control-focus" />
                        </td>
                        <td class="formValue">
                            &nbsp;
                            <i class="fa fa-plus-circle fa-lg" id="btn_Add" style="cursor:pointer;" onclick="btn_add()"></i>
                            &nbsp;&nbsp;
                            <i class="fa fa-minus-circle fa-lg" id="btn_Remove" style="cursor:pointer;" onclick="btn_delete()"></i>
                        </td>
                        <td class="formValue">
                            帐户余额：@Model.zhye
                        </td>
                    </tr>
                </table>
                <table id="tbZhszGridList"></table>
            </div>
            <div style="margin-top:1%;">
                <table class="table" style="margin-left:2%;font-size:14px;">
                    <tr>
                        <th class="text-right"></th>
                        <td class="text-left"></td>
                        <th class="text-right"></th>
                        <td class="text-left"></td>
                        <th class="text-right" style="font-weight:700;">Khoản phải thu：</th>
                        <td class="text-left" id="tdYsk">
                            <span>@Model.yingshoukuan.ToString("")</span>
                        </td>
                    </tr>
                    <tr>
                        <th class="text-right" style="font-weight:700;color:red;">Tiền thừa：</th>
                        <td class="text-left" id="tdZhaoling" style="color:red;">
                            <span>@Model.zhaoling.ToString("")</span>
                        </td>
                        <th class="text-right">舍入差额：</th>
                        <td class="text-left">
                            @Model.srce.ToString("")
                        </td>
                        <th class="text-right" style="font-weight:700;">Số tiền thực thu：</th>
                        <td class="text-left" id="tdSsk">
                            <span>@Model.ssk.ToString("")</span>
                        </td>
                    </tr>
                </table>
            </div>
            <div style="margin-top:1%;">
                <table>
                    <tr class="form">
                        <td class="formValue">
                            <input type="text" class="form-control" id="txtfph" readonly="readonly" disabled value="@Model.fph" placeholder="Vui lòng chọn số hóa đơn" />
                        </td>
                        <td class="formValue">
                            <input type="button" class="btn btn-default btn-md" value="Chọn số hóa đơn " onclick="ShowInvoicePanel()" />
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

<script type="">
    //患者交款记录 jGridKhai báo
    $('').newtouchLocalDataGrid({
        height: 80,
        unwritten: false,
        sortable: false,
        colModel: [
            { label: '', name: '', hidden: true },
            { label: '', name: '', width: 100, align: '' },
            { label: '', name: '', width: 100, align: '' },
            { label: '', name: '', width: 200, align: '' }
        ]
    });

    var yjjzhzhxz = '';
    var yjjzhzffs = "";//对应的xjzffs
    var yjjzhzffsmc = "";//对应的xjzffs

    $("").newtouchBindSelect({
        id: "",
        text: "",
        datasource: function () {
            //Duyệt nguồn dữ liệu
            var resultObjArr = new Array();
            if(top.clients && top.clients.SysForCashPayList){
                $.each(top.clients.SysForCashPayList, function (idx, val) {
                    if (val.zhxz == yjjzhzhxz || val.zhxz == '') {
                        if (val.zhxz == yjjzhzhxz) {
                            yjjzhzffs = val.xjzffs;
                            yjjzhzffsmc = val.xjzffsmc;
                        }
                        resultObjArr.push(val);
                    }
                });
            }
            return resultObjArr;
        }
    });

    $(function () {
        if (!yjjzhzhxz || !yjjzhzffs || !yjjzhzffsmc || $('' + yjjzhzffs + '').length == 0) {
            throw new Error('');
        }

        $("").val($('').attr(''));
        $('' + yjjzhzffs + '').attr('', '').trigger("");

        $('').newtouchLocalDataGrid(null, [{ zffs: yjjzhzffs, zffsmc: yjjzhzffsmc, zfje: '', zfzh: """" }]);
    });

    function btn_add() {
        var chargeType = $("").val();
        var chargeTypeText = $("").text();
        var szje = $("").val();
        $("").val('');  //
        if (szje) {
            szje = parseFloat(szje).toFixed(2);
            if (szje == 0 || isNaN(szje) || szje > 200000) {
                return;
            }
        }
        if (chargeType && chargeTypeText && szje) {
            //Phương thức thanh toán loại một Đánh giá thêm lặp lại
            if (chargeType == yjjzhzffs) {
                return;
            }
            $('').newtouchLocalDataGrid(null, [{ zffs: chargeType, zffsmc: chargeTypeText, zfje: szje, zfzh: "" }]);
        }
        reCalcZhaoling();
    };

    function btn_delete() {
        var rowid = jQuery("").jqGrid("", "");
        if ($("").jqGrid('', rowid)[""] == yjjzhzffs) {
            return; //Tài khoản tiền tạm ứng 记录不能删
        }
        if (rowid) {
            $('').jqGrid("", rowid);
        }
        reCalcZhaoling();
    };

    //Lại tính tiền thừa
    function reCalcZhaoling() {
        var ysk = $.trim($("").text());
        var ssk = 0;
        var rowIds = $("").getDataIDs();
        $.each(rowIds, function (idx, val) {
            var zfjestr = $("").jqGrid('', val)[""];
            if (zfjestr) {
                var zfje = parseFloat(parseFloat(zfjestr).toFixed(2));
                ssk += zfje;
            }
        });
        $('').html(ssk.toFixed(2));
        $('').html((ssk - ysk).toFixed(2));
    }

    $('').keydown(function (event) {
        event = event || window.event;
        if (event.keyCode == 13) {
            if ($('').length == 1) {
                btn_add();
            }
        }
    });

    //Cửa sổ bật lên số hóa đơn
    function ShowInvoicePanel() {
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.InvoiceNoChoosePanel.checkFPH();    //Hàm callback xác nhận khi nhấn cửa sổ
            }
        });
    }

    //Gửi quyết toán
    function submitSett() {
        var postData = {};
        postData[''] = '';
        postData[''] = $('').val(); //'';
        postData[''] = '';  //
        postData[''] = '';  //
        //期望的结算金额 Ngăn thay đổi trong quá trình
        postData[''] = @(Model.expectedjsje);
        //期望的找零 Ngăn thay đổi trong quá trình
        postData[''] = $('').text();
        if($('').text() && parseFloat($.trim($('').text())) < 0){
            $.modalAlert("", '');
            return;
        }
        //期望的结算金额 Ngăn thay đổi trong quá trình
        postData[''] = $('').text();
        //Phương thức thanh toán jsonChuỗi
        var xjzfArr = new Array();
        var rowIds = $("").getDataIDs();
        $.each(rowIds, function (idx, val) {
            var thisRowData = $("").jqGrid('', val);
            xjzfArr.push({xjzffs : thisRowData[''], zfje : parseFloat(thisRowData['']), zfzh : parseInt(thisRowData[''])});
        });
        postData[''] = JSON.stringify(xjzfArr);

        $.submitForm({
            url: "",
            param: postData,
            successwithtipmsg: false,
            success: function (data) {
                //弹另外一个层 Quyết toán kết quả 方法定义在IndexTrong
                $.currentWindow().window.showSettSuccessDialog(data.data.yingshoukuan, data.data.ssk, data.data.srce, data.data.zhaoling);
                $.currentWindow().window.newtouch_globalevent_f4();
            }
        })
    }

</script>
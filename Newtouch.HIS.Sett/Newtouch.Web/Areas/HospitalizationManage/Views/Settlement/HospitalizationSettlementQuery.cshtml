        //srcUrl = reportServerHOST + srcUrl;
        window.open(srcUrl);
    })

    //Đơn quyết toán xuất viện bảo hiểm y tế
    $("").click(function () {
        var zyh = $("").jqGridRowValue().zyh;
        var brxzmc = $("").jqGridRowValue().brxzmc;

        if (!!zyh) {
            if (brxzmc != "") {
                var srcUrl = '' + "" + "" + '' + "" + orgId + "" + jsnms;
                window.open(srcUrl);
                //var jsdurl = reportServerHOST + "" + orgId + "" + zyh;
                //window.open(jsdurl);
            } else {
                $.modalAlert("", "");
            }
        }
            else {
                $.modalAlert("", "");
            }
    });
</script>

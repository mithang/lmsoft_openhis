        $('').jqGrid("");
        $.najax({
            type: "",
            url: "",
            data: { jsnm: $("").jqGridRowValue().jsnm },
            dataType: "",
            success: function (ajaxresp) {
                $('').newtouchLocalDataGrid(null, ajaxresp);
            }
        });

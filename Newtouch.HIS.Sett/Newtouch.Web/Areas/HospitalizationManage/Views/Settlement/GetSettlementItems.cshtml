
@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="gridPanel" style="margin-top:10px;">
    <div>
        <table class="form">
            <tr>
                <th class="formTitle">Thu phí tên：</th>
                <td class="formValue">
                    <input id="sfmc" type="text" class="form-control" placeholder="Thu phí tên" />
                </td>
                <td class="formValue">
                    &nbsp;&nbsp;
                    <input type="button" id="btn_search" class="btn btn-primary" value=" 查 询 " />
                </td>
            </tr>
        </table>
    </div>
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>
<script>
    var zyh = $.request("");
    var dlCode = $.request("");
    var jsnms = $.request("");
    $(function () {
        gridInit();
    });
    $('').click(function () {
        //$("").clearGridData();

        var mc = $('').val();
        $("").jqGrid('', {
            postData: { zyh: zyh, dlCode: dlCode, jsnms: jsnms, mc: mc },
        }).trigger(''); //Lại tải bảng hiện tại
    });
    function gridInit() {
        var $gridList = $("");
        $gridList.dataGrid({
            postData: { zyh: zyh, dlCode: dlCode,jsnms: jsnms,mc:"" },
            url: "",
            height: $(window).height() - 120,
            colModel: [
                { label: '', name: '', align: '', width: 80 },
                { label: '', name: '', align: '', width: 40 },
                { label: '', name: '', align: '', width: 150 },
                { label: '', name: '', align: '', width: 60 },
                { label: '', name: '', align: '', width: 60 },
                {
                    label: '', name: '', align: '', width: 60, formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }
                },
                { label: '', name: '', align: '', width: 30 },
                { label: '', name: '', align: '', hidden: true },
                {
                    label: '', name: '', align: '', width: 60, formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }
                },
                { label: '', name: '', align: '', width: 50 },
                { label: '', name: '', align: '', width: 100 },

            ],
            pager: "",
            sortname: '',
            viewrecords: true,
            //rowNum:20
        });
    }
</script>


@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control form-control-focus" placeholder="Vui lòng nhập số thẻ/Số nhập viện" style="width: 200px;">
                    </div>
                </td>
                <td style="padding-left:12px;">
                    <div class="btn-group" id="btnKeywordTypeGourp" style="margin-top:0;">
                        <button type="button" data-keywordtype="kh" class="btn active btn-restore">&nbsp;Thẻ&nbsp;&nbsp;Số&nbsp;</button>
                        <button type="button" data-keywordtype="zyh" class="btn btn-default">Số nhập viện</button>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>

<div style="float:left;width:75%;">

    <div class="rows" style="margin-bottom: 1%;" id="divPatHospitalizationSettBasicInfo">
        <div class="panel panel-default" style="margin-top:10px; margin-bottom:0;">
            <div class="panel-heading navb-bg">
                Thông tin bệnh nhân nhập viện
            </div>
            <table class="form" style="width:96%;">
                <tr>
                    <td class="formTitle">Số thẻ：</td>
                    <td class="formValue">
                        <input class="form-control" disabled readonly="readonly" type="text" id="kh" value="" />
                    </td>
                    <td class="formTitle">Số nhập viện：</td>
                    <td class="formValue">
                        <input class="form-control" disabled readonly="readonly" type="text" id="zyh" value="" />
                    </td>
                    <td class="formTitle">Số bệnh án：</td>
                    <td class="formValue">
                        <input class="form-control" disabled readonly="readonly" type="text" id="blh" value="" />
                    </td>
                </tr>
                <tr>
                    <td class="formTitle">Họ tên：</td>
                    <td class="formValue">
                        <input class="form-control" disabled readonly="readonly" type="text" id="xm" value="" />
                    </td>
                    <td class="formTitle">Giới tính：</td>
                    <td class="formValue">
                        <input class="form-control" disabled readonly="readonly" type="text" id="xb" value="" />
                    </td>
                    <td class="formTitle">住院科别：</td>
                    <td class="formValue">
                        <input class="form-control" disabled readonly="readonly" type="text" id="ksmc" value="" />
                    </td>
                </tr>
                <tr>
                    <td class="formTitle">Loại bệnh nhân：</td>
                    <td class="formValue">
                        <input class="form-control" disabled readonly="readonly" type="text" id="brxzmc" value="" />
                    </td>
                    <td class="formTitle">Tiền tạm ứng：</td>
                    <td class="formValue">
                        <input class="form-control" disabled readonly="readonly" type="text" value="" id="zhyjj" />
                    </td>
                    <td class="formTitle">医保证号：</td>
                    <td class="formValue">
                        <input class="form-control" disabled readonly="readonly" type="text" value="" id="pzh" />
                    </td>
                </tr>
                <tr>
                    <td class="formTitle">Ngày nhập viện：</td>
                    <td class="formValue">
                        <input class="form-control" disabled readonly="readonly" type="text" value="" id="ryrq" />
                    </td>
                    <td class="formTitle">Ngày xuất viện：</td>
                    <td class="formValue">
                        <input class="form-control" disabled readonly="readonly" type="text" value="" id="cyrq" />
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <div class="rows" style="margin-bottom: 1%;" id="divPatHospitalizationSettFeeInfo">
        <div class="panel panel-default" style="margin-bottom:0;">
            <div class="panel-heading navb-bg">
                Thông tin quyết toán
            </div>
            <table class="form" style="width:96%;">
                <tr>
                    <td class="formTitle">Loại quyết toán：</td>
                    <td class="formValue">
                        <input class="form-control" disabled readonly="readonly" type="text" value="" id="txtSettType" />
                    </td>
                    <td class="formTitle">Số tiền quyết toán：</td>
                    <td class="formValue">
                        <input class="form-control" disabled readonly="readonly" type="text" value="" id="txtSettJSJE" />
                    </td>
                    <td class="formTitle"></td>
                    <td class="formValue"></td>
                </tr>
            </table>
        </div>
    </div>

    <div class="rows" style="margin-bottom: 1%;" id="divPatHospitalizationChargeListInfo">
        <table id="chargeGridList"></table>
    </div>

</div>


<div class="rows" style="margin-top:0.5%;float:left;width:24%;margin-left:1%;">
    <table id="dlFeeGridList"></table>
</div>
@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 4, 8 }
})

<script type="">
    $('').on('', '', function () {
        if (!$(this).hasClass('')) {
            $(this).siblings('').removeClass('').removeClass('').addClass('');
            $(this).removeClass('').addClass('');
        }
    });

    var txt_keyword = document.getElementById('');
    txt_keyword.addEventListener('', function (event) {
        event = event || window.event;
        if (isLoadingIIII) {
            stopDefault(event); //Trong quá trình tải dữ liệu，阻止默认行为
            return false;
        }
        if (event.keyCode == 13) {
            ajaxLoadDataResult();
        }
    });

    //ajaxLoadResult
    var isLoadingIIII = false;  //是否正在从后台加载数据
    function ajaxLoadDataResult() {
        if (!isLoadingIIII) {
            isLoadingIIII = true;
            var keyword = $.trim($("").val());
            if (keyword == '') {
                isLoadingIIII = false;
                return false;
            }
            $.loading(true, "");
            var zyh = null;
            var kh = null;
            if ($('').attr('') == '') {
                kh = keyword;
            }
            else {
                zyh = keyword;
            }
            $.najax({
                type: "",
                url: "",
                data: { zyh: zyh, kh: kh },
                dataType: "",
                success: function (ajaxresp) {
                    //Nhập viện thông tin cơ bản bệnh nhân
                    $('').formSerialize(ajaxresp.data.HospSettPatInfo);
                    $("").val($.getGender(ajaxresp.data.HospSettPatInfo.xb));
                    $("").val((ajaxresp.data.HospSettPatInfo.ryrq && ajaxresp.data.HospSettPatInfo.ryrq.length >= 10 ? ajaxresp.data.HospSettPatInfo.ryrq.substring(0, 10) : ""));
                    $("").val((ajaxresp.data.HospSettPatInfo.cyrq && ajaxresp.data.HospSettPatInfo.cyrq.length >= 10 ? ajaxresp.data.HospSettPatInfo.cyrq.substring(0, 10) : ""));
                    $('').val(ajaxresp.data.zhyjj.toFixed(2));
                    //患者交款历史
                    for (i = 0; i < ajaxresp.data.ChargeList.length; i++) {
                        ajaxresp.data.ChargeList[i].zyh = ajaxresp.data.HospSettPatInfo.zyh;
                        ajaxresp.data.ChargeList[i].xm = ajaxresp.data.HospSettPatInfo.xm;
                    }
                    $('').newtouchLocalDataGrid(null, ajaxresp.data.ChargeList);
                    //Thông tin chứng từ
                    $('').newtouchLocalDataGrid(null, ajaxresp.data.DLFeeList);
                    //Thông tin quyết toán
                    $('').val('');
                    $('').val(ajaxresp.data.jsje.toFixed(2));
                },
                errorCallback: function (data) {
                    funcDoPageClear();
                },
                complete: function () {
                    isLoadingIIII = false;
                    $.loading(false);
                }
            });
        }
    }

    window.newtouch_globalconfig.f4opions = {
        container: ""
    };

    //患者交款记录 jGridKhai báo
    $('').newtouchLocalDataGrid({
        height: 100,
        unwritten: false,
        sortable: false,
        caption: "",
        colModel: [
            { label: '', name: '', width: 100, align: '' },
            { label: '', name: '', width: 100, align: '' },
            {
                label: '', name: '', width: 100, align: '', formatter: function (cellvalue) {
                    return cellvalue ? cellvalue.toFixed(2) : "";
                }
            },
            { label: '', name: '', width: 100, align: '' },
            {
                label: '', name: '', width: 100, align: '', formatter: function (cellvalue) {
                    return cellvalue && cellvalue.length >= 10 ? cellvalue.substring(0, 10) : ""
                }
            },
            { label: '', name: '', width: 100 }
        ]
    });

    //患者交款记录 jGridKhai báo
    $('').newtouchLocalDataGrid({
        height: 240,
        unwritten: false,
        sortable: false,
        caption: "",
        colModel: [
            { label: '', name: '', width: 60, align: '' },
            {
                label: '', name: '', width: 50, align: '', formatter: function (cellvalue) {
                    return cellvalue ? cellvalue.toFixed(2) : "";
                }
            }
        ]
    });

    //Xóa thao tác
    var funcDoPageClear = function () {
        newtouch_globalevent_f4();
    };

    function newtouch_event_f4() {
        $('').jqGrid("");   //Xóa dòng tất cả
        $('').jqGrid("");
    }

    //Quyết toán
    function newtouch_event_f8() {
        var zyh = $.trim($('').val());
        var jsje = $.trim($('').val());
        var cyrq = $.trim($('').val());
        var url = "" + zyh + "" + jsje + "" + cyrq + "" + Math.random();
        if (zyh && jsje) {
            $.modalOpen({
                id: "",
                title: "",
                url: url,
                width: "",
                height: "",
                callBack: function (iframeId) {
                    top.frames[iframeId].submitSett();
                }
            });
        }
    }

    function showSettSuccessDialog(yingshoukuan, ssk, srce, zhaoling) {
        var url = "" + yingshoukuan
            + "" + ssk
            + "" + srce
            + "" + zhaoling;
        $.modalOpen({
            id: "",
            title: "",
            url: url,
            width: "",
            height: "",
            //btn: [''],
            //btnclass: [''],
            btn: null,
            callBack: function (iframeId) {
                //top.top.window.frames[''].$.modalClose();
            }
        });
    }

</script>

<div class="toolbar" style="float:right;width:80%;margin:10px;text-align:right;">
    <a class="btn btn-primary btn-md" onclick="newtouch_globalevent_f4()">
        <i class="fa fa-close"> F4:Xóa</i>
    </a>
    <a class="btn btn-primary btn-md" onclick="newtouch_globalevent_f8()">
        <i class="fa fa-save"></i>F8:Lưu
    </a>
</div>

<script type="">
    $('').on('', '', function () {
        if (!$(this).hasClass('')) {
            $(this).siblings('').removeClass('').removeClass('').addClass('');
            $(this).removeClass('').addClass('');
        }
    });

    var txt_keyword = document.getElementById('');
    txt_keyword.addEventListener('', function (event) {
        event = event || window.event;
        if (isLoadingIIII) {
            stopDefault(event); //Trong quá trình tải dữ liệu，阻止默认行为
            return false;
        }
        if (event.keyCode == 13) {
            ajaxLoadDataResult();
        }
    });

    //ajaxLoadResult
    var isLoadingIIII = false;  //是否正在从后台加载数据
    function ajaxLoadDataResult() {
        if (!isLoadingIIII) {
            isLoadingIIII = true;
            var keyword = $.trim($("").val());
            if (keyword == '') {
                isLoadingIIII = false;
                return false;
            }
            $.loading(true, "");
            var zyh = null;
            var kh = null;
            if ($('').attr('') == '') {
                kh = keyword;
            }
            else {
                zyh = keyword;
            }
            $.najax({
                type: "",
                url: "",
                data: { zyh: zyh, kh: kh },
                dataType: "",
                success: function (ajaxresp) {
                    //Nhập viện thông tin cơ bản bệnh nhân
                    $('').formSerialize(ajaxresp.data.SettPatInfo);
                    $("").val($.getGender(ajaxresp.data.SettPatInfo.xb));
                    $("").val((ajaxresp.data.SettPatInfo.ryrq && ajaxresp.data.SettPatInfo.ryrq.length >= 10 ? ajaxresp.data.SettPatInfo.ryrq.substring(0, 10) : ""));
                    $("").val((ajaxresp.data.SettPatInfo.cyrq && ajaxresp.data.SettPatInfo.cyrq.length >= 10 ? ajaxresp.data.SettPatInfo.cyrq.substring(0, 10) : ""));
                    $("").val((ajaxresp.data.SettPatInfo.zyts && ajaxresp.data.SettPatInfo.zyts > 0 ? ajaxresp.data.SettPatInfo.zyts.toFixed(1) : ""));
                    $("").html(getAgeFromBirthTime({ begin: ajaxresp.data.SettPatInfo.csny }).text);

                    $("").val(ajaxresp.data.LastUnCancelledSett.jsnm);
                    $("").val(ajaxresp.data.LastUnCancelledSett.zje.toFixed(2));
                    $("").val(ajaxresp.data.LastUnCancelledSett.xjzf.toFixed(2));
                    $("").val((ajaxresp.data.LastUnCancelledSett.zje - ajaxresp.data.LastUnCancelledSett.xjzf).toFixed(2));

                    $("").val('');

                    $('').val('');
                },
                errorCallback: function (data) {
                    funcDoPageClear();
                },
                complete: function () {
                    isLoadingIIII = false;
                    $.loading(false);
                }
            });
        }
    }

    window.newtouch_globalconfig.f4opions = {
        container: ""
    };

    //Xóa thao tác
    var funcDoPageClear = function () {
        newtouch_globalevent_f4();
    };

    //Hủy quyết toán
    function newtouch_event_f8() {
        var zyh = $.trim($('').val());
        var jsnm = $.trim($('').val());
        if (!zyh || !jsnm) {
            return;
        }
        var cancelReason = $.trim($('').val());
        if (!cancelReason) {
            $.modalAlert("", '');
            //$('').trigger('');
            return;
        }
        postData = {};
        postData[''] = zyh;
        //期望的结算内码 Ngăn thay đổi trong quá trình
        postData[''] = jsnm;
        postData[''] = cancelReason;
        $.submitForm({
            url: "",
            param: postData,
            success: function (data) {
                location.href = location.href;
            }
        });

    }

</script>

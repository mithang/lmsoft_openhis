@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
}
<form name="form1">
    <div class="panel panel-default" style="margin-bottom: 0%;">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <div style="padding-top:1%;padding-bottom:1%; padding-right:7%;" id="divInpatientBasicInfo">
            <table class="form">
                <tr>
                    <th class="formTitle">Số nhập viện：</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="zyh" style="width:49%;float:left;" />
                        &nbsp;&nbsp;<input type="button" class="btn btn-default btn-md btn-default-color" title="Chọn bệnh nhân nhập viện" style="width: 25%;" id="btnsyy" value="Tra cứu" onclick="GetPatSerarchView($('#zyh').val());">
                    </td>
                    <th class="formTitle">Ngày ghi sổ：</th>
                    <td class="formValue" colspan="3">
                        <input id="kssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:29%; float:left;" value="@DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        <span style="margin-left:5%;float:left;">—</span>
                        <input id="jssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width :29%;float:left; margin-left:5%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    </td>
                    @*<td class="formValue">
                        <input type="button" id="btn_search" class="btn btn-primary" style="width:40%;margin-left:10%;" value="Tra cứu" />
                    </td>*@
                </tr>
                <tr>
                    <th class="formTitle">Loại hạng mục：</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="xmlb" name="xmlb" style="width:90%;float:left;" placeholder="Ít nhất1ký tự vị" />
                    </td>
                    <th class="formTitle">Tên hạng mục：</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="xmmc" style="width:90%;float:left;" />
                    </td>
                    <td class="formValue">
                        <input type="button" id="btn_search" class="btn btn-primary" style="width:40%;margin-left:25%;" value="Tra cứu" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="panel panel-default" style="margin-bottom: 1%;" id="divPatInfo">
        <table class="form">
            <tr>
                <th class="formTitle">Họ tên：</th>
                <td class="formValue">
                    <label id="xm"></label>
                </td>
                <th class="formTitle">Giới tính：</th>
                <td class="formValue">
                    <label id="xb"></label>
                </td>
                <th class="formTitle">Tuổi：</th>
                <td class="formValue">
                    <label id="nlshow"></label>
                </td>
                <th class="formTitle">Số giấy tờ：</th>
                <td class="formValue" colspan="3">
                    <label id="zjh"></label>
                </td>
            </tr>
            <tbody class="dispTbody" style="display:none;">
                <tr>
                    <th class="formTitle">Chẩn đoán nhập viện：</th>
                    <td class="formValue">
                        <label id="ryzdmc"></label>
                    </td>
                    <th class="formTitle">Trạng thái đang nằm viện：</th>
                    <td class="formValue">
                        <label id="zybz"></label>
                    </td>
                    <th class="formTitle">Chính sách hoàn trả：</th>
                    <td class="formValue">
                        <label id="brxzmc"></label>
                    </td>
                    <th class="formTitle">Ngày sinh：</th>
                    <td class="formValue">
                        <label id="csny"></label>
                    </td>
                    <th class="formTitle">Ngày nhập viện：</th>
                    <td class="formValue">
                        <label id="ryrq"></label>
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="fa_icontoggle"><i class="fa fa-angle-double-down icontoggle" style="color:rgb(0, 160, 233);cursor:pointer;"></i></div>
    </div>
    <div class="gridPanel" style="margin-top:1%">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>
@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 4, 6 },
    F6Text = ""
})
<script>
    var from = $.request("");
    var zfy = 0.0000;
    $(function () {

        $('').newtouchBatchFloatingSelector({
            width: 250,
            height: 200,
            caption: "",
            clickautotrigger: true,
            url: "",
            ajaxparameters: function ($thisinput) {
                var keyword = $thisinput.val().trim();
                return "" + keyword;
            },
            itemdbclickhandler: function ($thistr, $thisinput) {
                $('').val($thistr.attr(''))
            },
            colModel: [
                { label: '', name: '', width: 150, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', hidden: true, width: 100, align: '' }
            ]
        });
    });
    //Tra cứu
    $('').click(function() {
        if ($('').val() && $('').val() && ($('').val() > $('').val())) {
            $.modalAlert("", '');
            return;
        }
        ajaxLoadDataResult($.trim($("").val()));
    });
    //Tra cứu bằng Enter
    $('').keydownEnterEvent(function () {
        ajaxLoadDataResult($.trim($("").val()));
    });

    //Nhập viện tra cứu bệnh nhân
    function GetPatSerarchView(zyh) {
        if (!!!zyh) {
            zyh = '';
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + '' + "" + Math.random() + "" + zyh,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
            }//Hàm callback xác nhận khi nhấn cửa sổ
        });
    }

    //Bệnh nhân đã chọn
    function getPatInfoAjax(selePatInfo) {
        $('').val(selePatInfo.zyh);
        ajaxLoadDataResult(selePatInfo.zyh);
        //$("").trigger('');
    }
    //var arraylist = new Array();
    //ajaxTải dữ liệu
    function ajaxLoadDataResult(zyh) {
        //Xóa trốngGrid
        $('').jqGrid("");

        //var zyh = $.trim($("").val());
        if (zyh == '') {
            $.modalAlert("", '');
            return false;
        }
        var xmlb = $.trim($("").val());
        var xmmc = $.trim($("").val());

        $.najax({
            type: "",
            url: "",
            data: { zyh: zyh, kssj: $('').val(), jssj: $('').val(), xmlb: xmlb, xmmc: xmmc, conf: from },
            dataType: "",
            //async: false,
            success: function (ajaxresp) {
                if (!ajaxresp.data) {
                    $.modalAlert("", '');
                    return;
                }
                debugger;
                //Thông tin bệnh nhân nhập viện
                $('').formSerialize(ajaxresp.data.InpatientSettPatInfo, true);
                $('').html(getAgeFromBirthTime({ begin: ajaxresp.data.InpatientSettPatInfo.csny }).text);
                $('').text((ajaxresp.data.InpatientSettPatInfo.csny && ajaxresp.data.InpatientSettPatInfo.csny.length >= 10 ? ajaxresp.data.InpatientSettPatInfo.csny.substring(0, 10) : ""))
                $("").text($.getGender(ajaxresp.data.InpatientSettPatInfo.xb));
                $("").text(ajaxresp.data.InpatientSettPatInfo.zybz == '' ? '' : (ajaxresp.data.InpatientSettPatInfo.zybz == '' ? '' : ''));
                $("").text((ajaxresp.data.InpatientSettPatInfo.ryrq && ajaxresp.data.InpatientSettPatInfo.ryrq.length >= 10 ? ajaxresp.data.InpatientSettPatInfo.ryrq.substring(0, 10) : ""));

                //Chi tiết tính phí、分页；Tổng cộng số tiền
                //拼接药品和项目，重新排序集合
                //var c = ajaxresp.data.InpatientSettleItemBO.TreatmentItemList.concat(ajaxresp.data.InpatientSettleItemBO.DrugList).sort(function (a, b) { return new Date(a.tdrq) - new Date(b.tdrq); });
                var c = ajaxresp.data.InpatientSettleItemBO.TreatmentItemList.sort(function (a, b) { return new Date(a.tdrq) - new Date(b.tdrq); });
                //console.info(c);
                //arraylist = c;
                //$("").jqGrid('', {
                //    data: arraylist,
                //    datatype: ''
                //}).trigger("");
                $("").newtouchLocalDataGrid(null, c);
                zfy = 0.00;
                $.each(c, function () {
                    zfy += this.je;
                });
                $("").jqGrid("", "" + ""
                    + zfy.toFixed(2) + "");
            },
            errorCallback: function (data) {
                newtouch_globalevent_f4();
            }
        });
    }

    window.newtouch_globalconfig.f4opions = {
        container: ""
    };

    function newtouch_event_f4() {
        $('').jqGrid("");
    }


    //Chi tiết tính phí
    $('').newtouchLocalDataGrid({
        caption: '',
        height: $(window).height() - 310,
        unwritten: false,
        editurl: "",
        //rownumbers: true,
        colModel: [
            
            { label: "", name: "", width: 100, align: "", hidden: true },
            { label: "", name: "", width: 130, align: "", hidden: true },
            { label: "", name: "", width: 130, align: "", hidden: true },
            { label: "", name: "", width: 100, align: "", hidden: true },
            { label: "", name: "", width: 100, align: "", hidden: true },
            { label: "", name: "", width: 100, align: "", hidden: true },
            { label: "", name: "", width: 130, align: "" },
            { label: "", name: "", width: 130, align: "" },
            { label: "", name: "", width: 130, align: "" },
            { label: "", name: "", width: 100, align: "" },
            { label: "", name: "", width: 130, align: "" },
            { label: "", name: "", width: 100, align: "" },
            {
                label: "", name: "", width: 100, align: "",
                formatter: function (val) {
                    if (val) {
                        return val.toFixed(4);
                    } else {
                        return ""
                    }
                }
            },
            {
                label: "", name: "", width: 100, align: "",
                formatter: function (val) {
                    if (val) {
                        return val.toFixed(2);
                    } else {
                        return ""
                    }
                }
            },
            { label: "", name: "", width: 100, editable: true, editrules: { numeric: true, minValue: 0.5 }, align: "" },
            { label: "", name: "", width: 25, align: "", hidden: true },
            { label: "", name: "", width: 25, align: "", hidden: true },
            { label: "", name: "", width: 25, align: "", hidden: true },
            { label: "", name: "", width: 25, align: "", hidden: true },
            {
                label: "", name: "", width: 100, align: "",
                formatter: "", formatoptions: { srcformat: '', newformat: '' }
            }
        ],
        multiselect: true,
        gridComplete: function () {
           
            //Bật hộp chỉnh sửa trong dòng
            EnableInlineEditBox();
        },
        onSelectRow: function (rowid) {
            $("" + $.jgrid.jqID(rowid) + "").focus();
        }
        
    });

    //Bật hộp chỉnh sửa trong dòng
    function EnableInlineEditBox() {
        //GridTải xong bật chỉnh sửa trong dòng   1.Lấy tất cả các dòng trướcId  2.Gọi duyệteditRowPhương thức
        var rowIds = $("").jqGrid('');
        for (var i = 0; i < rowIds.length; i++) {
            $("").jqGrid('', rowIds[i], true, null, null, null, null, function (callbackRowId) {     //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.

            });

        }
    }

    //Xác nhận hoàn phí
    function newtouch_event_f6() {
        //Lấy dòng đã chọnId
        var selRowIds = $("").jqGrid('', '');
        if (selRowIds.length == 0) {
            $.modalAlert("", '');
            return;
        }
        //Lấy tất cả các dòngId，Duyệt để hộp chỉnh sửa ở trạng thái đã lưu
        var rowIds = $("").jqGrid('');
        for (var i = 0; i < rowIds.length; i++) {
            $("").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);
        }
        //Đánh giá số lượng trả lại
        for (var i = 0; i < selRowIds.length; i++) {
            var rowData = $("").jqGrid('', selRowIds[i]);
            if (!rowData) {
                break;
            }
            if (rowData.tsl.replace(/(^\s*)|(\s*$)/g, "") == "") {
                $.modalAlert("" + rowData.sfxmmc + "", '');
                //Bật hộp chỉnh sửa trong dòng
                EnableInlineEditBox();
                return;
            }
            if (rowData.tsl <= 0 || isNaN(rowData.tsl)) {
                //Bật hộp chỉnh sửa trong dòng
                EnableInlineEditBox();
                return;
            }
            if (parseFloat(rowData.tsl) > parseFloat(rowData.sl)) {
                $.modalAlert("" + rowData.sfxmmc + "", '');
                //Bật hộp chỉnh sửa trong dòng
                EnableInlineEditBox();
                return;
            }
        }

        //true:Dòng đã chọnJSON.stringify(ajaxresp.data)
        var data = $("").jqGrid('', true, false);
        //setItem/getItem
        localStorage.setItem("", data);
        //弹出退费确认窗体
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                RefundMethod();
            },
            //弹窗点“X”事件和''Sự kiện
            cancelCallBack: function (iframeId) {

                //Bật hộp chỉnh sửa trong dòng
                EnableInlineEditBox();
            }
        });
    }

    //Thực hiện lưu cụ thể
    function RefundMethod() {
        //Lấy dữ liệu dòng đã chọn tất cả
        var needRefundData = $("").jqGrid('', true);
        for (var i = 0; i < needRefundData.length; i++) {
            var je = roundingBy4she6ru5chengshuang((parseFloat(needRefundData[i].dj) * parseFloat(needRefundData[i].tsl)), 2);
            //ChoGridgán giá trị số tiền trả lại trường của trong
            $('').jqGrid('', needRefundData[i].jqRowId, '', je);
        }
        var lastdata = $("").jqGrid('', true, false);
        $.najax({
            url: "",
            dataType: "",
            data: { data: lastdata, zyh: $.trim($("").val()) },
            type: "",
            success: function (data) {
                top.top.window.frames[''].$.modalClose();
                $.modalAlert("", '');
                //Xóa trốngGrid
                $('').jqGrid("");
                $("").trigger('');
            }
        });
    }

</script>


@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="panel panel-default" style="margin-bottom:0;">
    <div class="panel-heading navb-bg">
        Nhập viện tra cứu hoàn phí
    </div>
    <div style="padding: 2px;padding-right:20px;">
        <table class="form" style="width:100%;">
            <tr>
                <td class="formTitle">Số nhập viện：</td>
                <td class="formValue">
                    <input id="zyh" type="text" class="form-control " placeholder="Vui lòng nhập số nhập viện">
                </td>
                <td class="formTitle">Họ tên bệnh nhân：</td>
                <td class="formValue">
                    <input class="form-control newtouch_Readonly" type="text" id="brxm" value="" />
                </td>

                <td class="formTitle">Tên hạng mục：</td>
                <td class="formValue">
                    <input class="form-control" type="text" id="sfxm" value="" />
                </td>
                <td class="formTitle">Khoa thực hiện：</td>
                <td class="formValue">
                    <input class="form-control" type="text" id="zxks" value="" />
                </td>
                <td class="formTitle"></td>
                <td class="formValue" rowspan="2">
                    <button id="BtnQuery" class="btn btn btn-default btn-md dropdown-text" style="width:50px;">Tra cứu</button>
                </td>
            </tr>

        </table>
    </div>
</div>

<br />
<form id="tabGrid">
    <div class="gridPanel">
        <table id="refundGridList" rel="tabGrid"></table>
    </div>
    <br />
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading navb-bg">
            Hoàn phí
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form" style="width:96%;" id="tslTable">
                <tr>
                    <td class="formTitle">Số lượng trả lại：</td>
                    <td class="formValue">
                        <input class="form-control" type="text" id="tsl" value="" />
                        <input class="form-control" type="hidden" id="bianhao" value="" />
                        <input class="form-control" type="hidden" id="IsYP" value="" />
                    </td>
                    <td class="formTitle"></td>
                    <td class="formValue"></td>
                    <td class="formTitle"></td>
                    <td class="formValue"></td>
                    <td class="formTitle"></td>
                    <td class="formValue"></td>
                </tr>
            </table>
        </div>
    </div>

    <br />
    <div class="gridPanel">
        <table id="gridListDetail" rel="tabGrid"></table>
    </div>
</form>
@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new[] { 4, 8 },
    F8Text = ""
})
<script>
    $(function () {
        //Tải lại khi thay đổi kích thước cửa sổ trình duyệtjqGridchiều rộng của
        $(window).resize(function () {
            initLayout("");
        });

        var txt_keyword = document.getElementById('');
        txt_keyword.addEventListener('', function (event) {
            event = event || window.event;
            if (event.keyCode == 13) {
                GetPatInfo();
            }
        });


        $("").hide();

        initControl();
        gridListData([]);
        gridListDetail([]);
        $("").click(function () {
            newtouch_globalevent_f4();
            newtouch_event_f4();
        });


        $("").click(function () {
            if (checkTSL()) {
                return false;
            }
        });
        $("").children().children().click(function () {
            $(this).clone(true).appendTo($("").children());//复制当前点击的节点，并将它追加到《ul》元素中，当添加参数时复制它的事件

        });
        function GetPatInfo() {
            var zyh = $("").val();
            $.najax({
                type: "",
                url: ""GetPatInfoByZyh"",
                data: {
                    zyh: zyh,
                    time: new Date()
                },
                cache: false,
                dataType: "",
                success: function (ajaxresp) {
                    $("").val(ajaxresp.data);
                    $("").click();
                },
                errorCallback: function (err) {
                },
                complete: function () {
                    isLoadingIIII = false;
                    $.loading(false);
                }
            });
        }
        $("").click(function () {
            $('').jqGrid("");

            var zyh = $("").val();

            if (zyh.length > 0) {

                var brxm = $("").val();
                var yrh = $("").val();
                var zxks = $("").val();
                var xmmc = $("").val();
                $.loading(true, "");
                $.najax({
                    type: "",
                    url: ""BtnQuery"",
                    data: {
                        zyh: zyh,
                        brxm: brxm,
                        yrh: yrh,
                        zxks: zxks,
                        xmmc: xmmc
                    },
                    dataType: "",
                    cache: false,
                    success: function (ajaxresp) {
                        $("").css("", "");
                        $('').jqGrid("");
                        gridListData(ajaxresp.data);
                    },
                    errorCallback: function (err) {
                    },
                    complete: function () {
                        isLoadingIIII = false;
                        $.loading(false);
                    }
                });

            } else {
                $.modalAlert("", "");
            }

        });

      
    });

      //Nhấn kết quả hoàn phí trả về hoàn phí
    function newtouch_event_f8() {
        if (checkTSL()) {
                $.modalConfirm("", function (flag) {
                    if (flag) {
                        $.loading(true, "");
                        $.najax({
                            type: "",
                            url: ""btnTuiFei"",
                            data: {
                                cxzyjfbbh: $("").val(),
                                is_sfxm: $("").val(),
                                refundNum: $("").val()

                            },
                            dataType: "",
                            cache: false,
                            success: function (ajaxresp) {
                                $('').jqGrid("");
                                $.modalAlert("", "");
                                $("").click();
                                $("").val(""); //Xóa trống số lượng trả lại
                            },
                            error: function (err) {
                                $.loading(false)
                            },
                            complete: function () {
                                isLoadingIIII = false;
                                $.loading(false);
                            }
                        });
                        return true;
                    }
                }, false);
            }

    }
        function checkTSL() {
            var sl = $("").jqGridRowValue().SL;
            var tem = $("").val();
            if (parseInt(sl) < parseInt(tem)) {
                $.modalAlert("", "");
                return false;
            }
            if (sl==undefined || tem == "" || parseInt(tem) < 0) {
                $.modalAlert("", "");
                return false;
            }
            return true;

        }
        //thu phí dữ liệu chi tiết tải chọn hiện tại

        function GetDetail() {
            $.loading(true, "");
            var data = $("").jqGridRowValue();

            $.najax({
                type: "",
                url: ""Detail"",
                data: {
                    zyh: data.ZYH,
                    xsebh: data.XSEBH,
                    sfxm: data.SFXM,
                    CreateTime: data.CreateTime,
                    is_sfxm: data.IS_SFXM
                },
                dataType: "",
                cache: false,
                success: function (ajaxresp) {
                    $("").val(ajaxresp.data[0].JFBBH);
                    $("").val(data.IS_SFXM);
                    $('').jqGrid("");
                    gridListDetail(ajaxresp.data);
                    return;
                },
                errorCallback: function (err) {

                },
                complete: function () {
                    isLoadingIIII = false;
                    $.loading(false);
                }
            });
        }

        //Thu phí sự kiện nhấn chuột danh sách
        function btn_selectrow() {
            $.loading(true, "");
            var data = $("").jqGridRowValue();

            $.najax({
                type: "",
                url: ""Detail"",
                data: {
                    zyh: data.ZYH,
                    xsebh: data.XSEBH,
                    sfxmbh: data.SFXMBH,
                    CreateTime: data.CreateTime,
                    is_sfxm: data.IS_SFXM
                },
                dataType: "",
                cache: false,
                success: function (ajaxresp) {
                    $("").val(ajaxresp.data[0].JFBBH);
                    $("").val(data.IS_SFXM);
                    $('').jqGrid("");
                    gridListDetail(ajaxresp.data);
                    return;

                },
                error: function (err) {
                    $.loading(false);
                },
                complete: function () {
                    isLoadingIIII = false;
                    $.loading(false);
                }
            });
        }


        function gridListDetail(mydata) {
            var $gridList = $("");
            $gridList.dataNewGrid({
                height: 100,
                autowidth:false,
                width: $("").width() - 20,
                caption: "",
                colModel: [
                    { label: '', name: '', hidden: true, key: true },
                    { label: '', name: '', hidden: true, key: true },
                    {
                        label: '', name: '', width: 150, align: ''
                    },
                    { label: '', name: '', width: 300, align: '' },
                    { label: '',name:'',hidden:true},
                    { label: '', name: '', width: 100, align: '' },
                    { label: '', name: '', width: 100, align: '' },
                    { label: '', name: '', width: 100, align: '' }
                ], sortname: ''
            }, mydata);
            if (mydata.length > 0) {
                $('').find("").remove();
            }
        }
        function gridListData(mydata) {
            var $gridList = $("");
            $gridList.dataNewGrid({
                height: 100,
                autowidth: false,
                width: $("").width() - 20,
                caption: "",
                colModel: [
                    { label: '', name: '', hidden: true, key: true },
                    { label: '', name: '', hidden: true, key: true },
                    { label: '', name: '', hidden: true, key: true },
                    { label: '', name: '', hidden: true, key: true },

                    {
                        label: '', name: '', width: 150, align: ''
                    },
                    { label: '', name: '', width: 300, align: '' },
                    { label: '', name: '', width: 100, align: '' },
                    { label: '', name: '', width: 100, align: '' },
                    { label: '', name: '', width: 100, align: '' }

                ]
            }, mydata);
            if (mydata.length > 0) {
                $('').find("").remove();
            }
        }
        function newtouch_event_f4() {
            $('').jqGrid("");   //Xóa dòng tất cả
            $('').jqGrid("");
        }


        //Tải hạng mục thu phí，医生下拉框的值
        function initControl() {
            ///Hạng mục thu phí
            $("").sfxmFloatingSelector({
                djDecimalPlaces: 4,
                ajaxparameters: function ($thisinput) {
                    return "" + $.trim($thisinput.val());
                },
                itemdbclickhandler: function ($thistr) {
                    $("").val($thistr.attr(""));
                }
            });

            ///Khoa
            $("").newtouchBatchFloatingSelector({
                height: 170,
                width: 250,
                clickautotrigger: true,
                filter: function (keyword) {
                    //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
                    var resultObjArr = new Array();
                    $.each(top.window.clients.sysDepartList, function (idx, val) {
                        if ((val.py && val.py.indexOf(keyword.toLowerCase()) >= 0)
                            || (val.Name && val.Name.indexOf(keyword) >= 0)
                            || keyword.trim() == "") {
                            resultObjArr.push(val);
                        }
                    });
                    return resultObjArr;
                },
                caption: "",
                colModel: [
                    { label: '', name: '', widthratio: 50 },
                    { label: '', name: '', widthratio: 20 },
                    { label: '', name: '', hidden: true }
                ],
                itemdbclickhandler: function ($thistr) {
                    $("").attr("", $thistr.find("").html());
                    $("").val($thistr.find('').html());
                    return;
                },
            });
        }
</script>

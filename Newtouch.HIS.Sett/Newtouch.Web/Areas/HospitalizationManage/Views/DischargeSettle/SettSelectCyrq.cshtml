@{
    ViewBag.Title = "";
    Layout = "";
}
<form id="form1">
    <div style="padding-top: 20px; margin-right: 55px;">
        <table class="form">
            <tr>
                <th class="formTitle"><span class="required">*</span>Ngày xuất viện：</th>
                <td class="formValue">
                    <input class="form-control input-wdatepicker required" id="cyrq" name="cyrq"
                           value=@DateTime.Now.ToString("yyyy-MM-dd") type="text"
                           onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    var cyrq = $.request("");
    if (cyrq) {
        $('').val($.getDate({ date: cyrq }));
        //$('').attr('', '');
    }
    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        var date = $('').val();
        if ($.getDate() < date) {   //一样的格式，可以直接比较大小
            $.modalAlert("", '');
            return false;
        }
        return date;
    }
</script>

@{
	ViewBag.Title = "SimulateForm";
	Layout = "~/Views/Shared/_Form.cshtml";
}

<div class="gridPanel" style="margin-top:1%">
	<table id="gridList"></table>
	<div id="gridPager"></div>
</div>
<script>
	var zyh = $.request("zyh");
	var sfxmCode = $.request("sfxmCode");
	var zzfbz = $.request("zzfbz");
	var dj = $.request("dj");
	$(function () {
		gridInit();
	});

	function gridInit() {
		var $gridList = $("#gridList");
		$gridList.dataGrid({
			postData: { zyh: zyh, sfxmCode: sfxmCode, zzfbz: zzfbz, dj: dj },
			url: "/HospitalizationManage/DischargeSettle/GetDetailedQuery",
			height: $(window).height() - 80,
			colModel: [
				{ label: 'Loại lớn thu phí', name: 'dlmc', align: 'center', width: 60 },
				{ label: 'Thuộc tính', name: 'zfxz', align: 'center', width: 40 },
				{ label: 'Tên thuốc', name: 'sfxmmc', align: 'left', width: 150 },
				{ label: 'Quy cách', name: 'gg', align: 'center', width: 60 },
				{ label: 'Đơn vị', name: 'jfdw', align: 'center', width: 60 },
				{
					label: 'Đơn giá', name: 'dj', align: 'center', width: 60, formatter: "number"
					, formatoptions: { decimalPlaces: 2, defaultValue: '0.0000' }
				},
				{ label: 'Số lượng', name: 'sl', align: 'center', width: 30 },
				{ label: 'zyh', name: 'zyh', align: 'center', hidden: true, },
				{
					label: 'Chi phí', name: 'je', align: 'center', width: 60, formatter: "number"
					, formatoptions: { decimalPlaces: 2, defaultValue: '0.0000' }
				},
				{ label: 'Có tự trả hay không', name: 'zzfbz', align: 'center', width: 50 },
				{ label: 'Ngày định giá', name: 'tdrq', align: 'center', width: 100 },

			],
			pager: "#gridPager",
			sortname: 'sfxmmc',
			viewrecords: true,
		});
	}
</script>
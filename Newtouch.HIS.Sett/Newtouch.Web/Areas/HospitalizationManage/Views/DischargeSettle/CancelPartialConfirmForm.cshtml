
@{
    ViewBag.Title = "";
    Layout = "";

    //Mặc định phương thức thanh toán
    var defaultPayMethod = SysConfigReader.String("");
    //Quyết toán nhập viện có thể dùng tiền tạm ứng
    var withYjj = SysConfigReader.Bool("");
}
<div id="divCQYbFee" class="panel panel-default" style="margin-top:10px;margin-left:10px;margin-right: 10px;">
    <div style="height:auto;">
        <table class="form">
            <tr>
                <th class="formTitle">Chênh lệch thanh toán hoàn trả：</th>
                <td class="formValue">￥<label id="th_zfce" style="color:red">0.00</label></td>
                </tr>
            <tr>
                <th class="formTitle">Phương thức thanh toán：</th>
                <td class="formValue">
                    <select id="zffs1" class="form-control  form-an" style="width:90%">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
            </tr>
        </table>
    </div>
</div>
<script type="">
    var defaultPayMethod = "";
    var jsnm = $.request("");
    var prevWindow = $.currentWindow();
    var withYjj = '';
    var yjjye = 0;
    $(function () {
        init();
        //Phương thức thanh toán tiền mặt1
        $("").newtouchBindSelect({
            datasource: function () {
                //var resultObjArr = new Array();
                $.each(top.clients.SysForCashPayList, function (key, value) {
                    var sele = false;

                    //if (!yjjye && value.xjzffs == '') {
                    //    return; //Tài khoản hiện tại không có số dư tiền tạm ứng，thì không hiển thị phương thức thanh toán này
                    //}
                    if (value.xjzffs == defaultPayMethod) {
                        sele = true;
                    }
                    if (sele) {
                        $('').append('' + value.xjzffs + '' + value.xjzffsmc + '');
                    }
                    else {
                        $('').append('' + value.xjzffs + '' + value.xjzffsmc + '');
                    }
                });
                //return resultObjArr;
            }
        });
    })

    function init() {
        $.najax({
            type: "",
            data: { jsnm: jsnm },
            url: ""Getrefunds_available"",
            dataType: "",
            async: false,
            loading: false,
            success: function (resp) {
                if (resp.state == '') {
                    $('').html(resp.data);
                }
            }
        });

        if (withYjj == '') {
            $.najax({
                url: "" + $.request(""),
                cache: false,
                async: false,
                alertbierror: false,
                success: function (zhyeData) {
                    if (zhyeData && zhyeData.data) {
                        yjjye = zhyeData.data;
                    }
                }
            });
        }
    }

    function submitform() {
        if ($('').val()=="") {
            $.modalAlert("", "");
            return;
        }
        
        prevWindow.CancelTheLastMidwaySett($('').val(), $("").text(),jsnm);
        $.modalClose();
    }
</script>


@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
}
<style>
    .editable {
        width: 70% !important;
    }
</style>
<div class="gridPanel">
    <table id="gridList"></table>
</div>
<script type="">
    var zyh = $.request("");
    var searchTime = $.request("");
    $(function () {
        initgridList();

        setTimeout(function () {
            $.loading(true, '');
            CQmxsc(function () {
                setTimeout(function () {
                    GetApprovalXm();
                });
            });
        },
            50);
    });


    function initgridList() {
        $('').dataGrid({
            unwritten: false,
            postData: {},
            editurl: "",
            multiselect: true,
            viewrecords: true,
            height: 350,
            sortable: false,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: "", name: "", hidden: true },
                { label: "", name: "", hidden: true },
                { label: "", name: "", width: 90, editable: true, edittype: '', editoptions: { value: { 0: "", 1: "" } } },
                { label: "", name: "", width: 80 },
                { label: "", name: "", width: 80 },
                { label: "", name: "", width: 100 },
                {
                    label: "", name: "", width: 120,
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                { label: "", name: "", width: 60 },
                {
                    label: "", name: "", width: 60, align: "", formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }
                },
                {
                    label: "", name: "", width: 60, align: "", formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }
                },
            ],
            gridComplete: function (data) {
                EnableInlineEditBox();
            }
        });
    }

    function CQmxsc(funcSuccCallback) {
        var n = 1;
        var ybzje = 0.00;
        var succTimes = 0;
        var mxnum = 0;
        //Tải lên lại mỗi lần，Trước tiên hủy các đơn thuốc đã tải lên trước đây mà，chưa quyết toán，否则会重复上传
        $.ajax({
            type: "",
            url: "",
            data: { zymzh: zyh, type: '' },
            dataType: "",
            async: false,
            success: function (hcdata) {
                if (hcdata && hcdata.data && hcdata.data.length > 0) {
                    $.each(hcdata.data, function (i, item) {
                        $.ajax({
                            type: "",
                            url: "",
                            data: item,
                            dataType: "",
                            async: false,
                            success: function (data) {
                                var tfReturn = eval('' + data + '');
                                if (tfReturn && tfReturn.Code === "") {
                                    $.najax({
                                        type: "",
                                        data: { zymzh: zyh, cfh: item.cfh },
                                        url: "",
                                        dataType: "",
                                        async: false,
                                        loading: false,
                                        success: function () {

                                        }
                                    });
                                } else {
                                    $.modalAlert("" + tfReturn.ErrorMsg + "", '');
                                }
                            }
                        });
                    });
                }
            }
        });
        for (var i = 0; i < n; i++) {
            $.najax({
                url: "",
                loading: false,
                async: false,
                type: '',
                data: getSearchCQPostData(i),
                success: function (ajaxResp) {
                    if (ajaxResp && ajaxResp.updata != null) {
                        //ybzje += ajaxResp.ybzje;
                        if (i == 0) {
                            n = ajaxResp.total;
                            mxnum = ajaxResp.records;
                            // zfzje = ajaxResp.zfzje;
                            ///Giờ lần một thứ，Chi tiết xóa tiến hành trước，Số lần tổng đến lấy đồng thời（Số dòng tổng/10），进行循环调用上传
                            ////Tải lên lại mỗi lần，Trước tiên hủy các đơn thuốc đã tải lên trước đây mà，chưa quyết toán，否则会重复上传
                            //$.ajax({
                            //    type: "",
                            //    url: "",
                            //    data: { zymzh: zyh, type: '' },
                            //    dataType: "",
                            //    async: false,
                            //    success: function (hcdata) {
                            //        if (hcdata && hcdata.data && hcdata.data.length > 0) {
                            //            $.each(hcdata.data, function (i, item) {
                            //                $.ajax({
                            //                    type: "",
                            //                    url: "",
                            //                    data: item,
                            //                    dataType: "",
                            //                    async: false,
                            //                    success: function (data) {
                            //                        var tfReturn = eval('' + data + '');
                            //                        if (tfReturn && tfReturn.Code === "") {
                            //                            $.najax({
                            //                                type: "",
                            //                                data: { zymzh: zyh, cfh: item.cfh },
                            //                                url: "",
                            //                                dataType: "",
                            //                                async: false,
                            //                                loading: false,
                            //                                success: function () {

                            //                                }
                            //                            });
                            //                        } else {
                            //                            $.modalAlert("" + tfReturn.ErrorMsg + "", '');
                            //                        }
                            //                    }
                            //                });
                            //            });
                            //        }
                            //    }
                            //});
                        }
                        //Tải lên cần chi tiết có nếu，Giao diện tải lên gọi thì
                        if (ajaxResp.updata.cflist.length > 0) {
                            var cfmxjsh = new Array();
                            $.each(ajaxResp.updata.cflist, function (index, value) {
                                var cfArr = new Array();
                                cfArr.push(value);
                                var upDataReturn;// = $.guianyibao.ZyFeemxXr(JSON.stringify(ajaxResp.updata));
                                var ybresp = { zymzh: ajaxResp.updata.zymzh, cflist: cfArr };
                                $.ajax({
                                    type: "",
                                    url: "",
                                    data: ybresp,
                                    dataType: "",
                                    async: false,
                                    success: function (data) {
                                        upDataReturn = eval('' + data + '');
                                        upDataReturn.Data.retCfList[0].cfh = value.cfh;
                                        upDataReturn.Data.retCfList[0].yynm = value.yynm;
                                    }
                                });

                                if (upDataReturn.Code === "") {
                                    $.najax({
                                        type: "",
                                        data: {
                                            entityList: upDataReturn.Data.retCfList, cflist: cfArr, zymzh: ajaxResp.updata.zymzh, jytype: ""
                                        },
                                        url: "",
                                        dataType: "",
                                        async: false,
                                        loading: false,
                                        success: function () {

                                        }
                                    });

                                } else {
                                    $.loading(false);
                                    $.modalAlert("" + upDataReturn.ErrorMsg, '');
                                    n = 1;//Thoát khỏi vòng lặp
                                    return;
                                }
                            });
                            succTimes++;
                        }

                    } else {
                        $.loading(false);
                        $.modalAlert("", '');
                        n = 1;//Thoát khỏi vòng lặp
                        return;
                    }
                },
                error: function () {
                    $.loading(false);
                    $.modalAlert("", '');
                    n = 1;//Thoát khỏi vòng lặp
                    return;
                }
            });
        }

        $.najax({
            type: "",
            data: {
                mzzyh:zyh
            },
            url: "",
            dataType: "",
            async: false,
            loading: false,
            success: function (ajaxResp) {
                ybzje = ajaxResp.ybzje;
            }
        });
        $.loading(false);

        if ((succTimes == n) && funcSuccCallback) {
            setTimeout(function () {
                var mxxx = { mxnum: mxnum, ybzje: ybzje };
                funcSuccCallback(mxxx);
            }, 50);
        }
    }

    //Điều kiện tra cứu
    function getSearchCQPostData(n) {
        var pagination = {
            rows: 10,
            page: 1,
            //page: n + 1,
            sidx: ''
        };
        return { pagination: pagination, zyh: zyh };

    }

    function GetApprovalXm() {
        var parameter1 = { "": zyh, "": "", "": searchTime, "": "" };
        var parameter2 = { "": zyh, "": "", "": searchTime, "": "" };
        var spGsfReturn = {};
        var spBdbReturn = {};
        $.ajax({
            loading: "",
            type: "",
            url: "",
            data: parameter1,
            dataType: "",
            async: false,
            success: function (data) {
                spGsfReturn = eval('' + data + '');
            }
        });

        $.ajax({
            type: "",
            url: "",
            data: parameter2,
            dataType: "",
            async: false,
            success: function (data) {
                spBdbReturn = eval('' + data + '');
            }
        });

        var Gsfcfmxlshstr ="";
        var Bdbcfmxlshstr="";
        if (!!spGsfReturn && !!spBdbReturn && spGsfReturn.Code === "" && spBdbReturn.Code === "") {
            if (!!spGsfReturn.Data && spGsfReturn.Data.cfmxlshList.length > 0) {
                $.loading(false);
                Gsfcfmxlshstr = spGsfReturn.Data.cfmxlshList.map(p => p.cfmxlsh).join("")+'';
            }
            if (!!spBdbReturn.Data && spBdbReturn.Data.cfmxlshList.length > 0) {
                $.loading(false);
                Bdbcfmxlshstr = spBdbReturn.Data.cfmxlshList.map(p => p.cfmxlsh).join("") + '';
            }
            var cfmxlshstr = Gsfcfmxlshstr + Bdbcfmxlshstr + '';
            $("").jqGrid('', {
                url: "" + cfmxlshstr + "" + zyh,
            }).trigger('');
        } else {
            $.loading(false);
            $.modalAlert("", '');
            return;
        }
    }

    //Bật chỉnh sửa trong dòng
    function EnableInlineEditBox() {
        var ids = $("").getDataIDs();
        if (ids.length > 0) {
            $.each(ids, function () {
                var rowid = String(this);
                //打开编辑模式
                $("").jqGrid('', rowid, true, null, null, null, null, function (callbackRowId) {     //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.
                });
            });
        }
    }

    function submitform() {
        //Lấy dòng đã chọnId
        var selRowIds = $("").jqGrid('', '');
        if (selRowIds.length === 0) {
            $.modalAlert("", '');
            return;
        }
        var rowIds = $("").jqGrid('');
        for (var i = 0; i < rowIds.length; i++) {
            var saveResult = $("").saveRow(rowIds[i], null, null, null, function (callbackRowId) { }, null, null);

            if (!saveResult) {
                EnableInlineEditBox();    //Khởi động lại và bật chỉnh sửa Nếu không lần sauSavekhi đó sẽ trả vềfalse
                return;   //Lưu thất bại，Thìreturn
            }
        }

        var flag = false;
        var gridListData = $("").jqGrid('', null, true);
        if (gridListData.length < 1) {
            $.modalAlert("", '');
            return;
        }


        if (flag) {
            EnableInlineEditBox();
            return;
        }
        var cfhlist = [];
        $.each(gridListData, function () {    //Loại bỏaction
            for (var i = 0; i < $(this).length; i++) {
                if (this.spbj == undefined || this.spbj == "" || this.spbj == "") {
                    $.modalAlert("", "");
                    flag = true;
                    return false;
                }

                var postdata = { zyh: zyh, cfmxlsh: $(this)[i].jylsh, spbj: $(this)[i].spbj == "" ? "" : "", xzlb: "" }
                var cfh = $(this)[i].cfh;
                //21Giao diện：Thu phí cao bảo hiểm y tế(高蛋白)Phê duyệt chi phí
                $.ajax({
                    type: "",
                    url: "",
                    data: postdata,
                    dataType: "",
                    async: false,
                    success: function (data) {
                        var tfReturn = eval('' + data + '');
                        if (tfReturn && tfReturn.Code === "") {
                            cfhlist.push(cfh);
                        } else {
                            $.modalAlert("" + tfReturn.ErrorMsg + "", '');
                        }
                    }
                });
            }
        });

        if (flag) {
            EnableInlineEditBox();
            return;
        }

        $.ajax({
            type: "",
            url: "" + cfhlist.join(''),
            dataType: "",
            async: false,
            success: function (data) {
                if (data && data.state === "") {
                    $.modalClose();
                    //GetApprovalXm();
                } else {
                    $.modalAlert("" + tfReturn.ErrorMsg, '');
                }
            }
        });
    };
</script>


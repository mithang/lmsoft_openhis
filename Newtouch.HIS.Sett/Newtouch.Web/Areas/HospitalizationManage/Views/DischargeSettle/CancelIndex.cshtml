<script type="">
    //医保逻辑

    //Lấy bệnh nhân quyết toán Thông tin bệnh nhân
    function funcGetSettPatientInfo(funcSuccCallback) {
        $.najax({
            url: '' + patModel.zyh,
            loadingtext: "",
            type: '',
            success: function (ajaxResp) {
                //
                if (funcSuccCallback) {
                    setTimeout(function () {

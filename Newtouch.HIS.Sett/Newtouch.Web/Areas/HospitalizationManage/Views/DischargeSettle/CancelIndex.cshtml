    function gzyb_Cyblcx(funcSuccCallback) {
        $.najax({
            url: "",
            data: { zyh: zyh },
            dataType: '',
            async: false,
            success: function (rep) {
                if (rep) {
                    var gzyb_Cyblcx = new Object();
                    gzyb_Cyblcx.prm_akc190 = rep.prm_akc190;//Khám bệnh số hiệu
                    gzyb_Cyblcx.prm_aka130 = rep.prm_aka130;//Loại thanh toán
                    gzyb_Cyblcx.prm_ykc141 = '';//Họ tên người xử lý
                    //gzyb_Cyblcx.prm_aae036 = curTime;//Thời gian xử lý
                    gzyb_Cyblcx.prm_aae036 = $.getTime();//Thời gian xử lý
                    $.najax({
                        url: "",
                        data: { format: "" },
                        dataType: '',
                        async: false,
                        success: function (strTime) {
                            gzyb_Cyblcx.prm_aae036 = strTime; //Thời gian xử lý
                        }
                    });
                    gzyb_Cyblcx.prm_yab003 = rep.prm_yab003;//Mã trung tâm phân
                    gzyb_Cyblcx.prm_aac001 = rep.prm_aac001;//Số thẻ
                    gzyb_Cyblcx.prm_ykb065 = rep.prm_ykb065;//社会保险办法
                    var gzyb_CyblcxOut;// = $.guianyibao.ZyCyblht(gzyb_Cyblcx); //Gọi giao diện làm thủ tục xuất viện
                    $.ajax({
                        type: "",
                        url: "",
                        contentType: '',
                        data: JSON.stringify(gzyb_Cyblcx),
                        dataType: "",
                        async: false,
                        success: function (data) {
                            gzyb_CyblcxOut = eval('' + data + '');
                        }
                    });
                    if (gzyb_CyblcxOut) {
                        if (gzyb_CyblcxOut.Code != 0) {
                            $.loading(false);
                            $.modalAlert(gzyb_CyblcxOut.ErrorMsg, "");
                            return;
                        }
                    } else {
                        $.loading(false);
                        $.modalAlert("", "");
                        return;
                    }
                } else {
                    $.loading(false);
                    $.modalAlert("", "");
                    return;
                }
            }
        });

        $.loading(false);
        //
        if (funcSuccCallback) {
            setTimeout(function () {
                funcSuccCallback();
            }, 50);
        }
    }

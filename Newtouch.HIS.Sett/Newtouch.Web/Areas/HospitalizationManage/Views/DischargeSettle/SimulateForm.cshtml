    });

    function init() {
        if (isYbjyjz) {
            if (medicalInsurance == "") {
            	setTimeout(function(){ 
                    $.loading(true, '');
                    setTimeout(function() {
                            CQmxsc(function(mxxx) {
                                $.loading(true, '');
                                setTimeout(function () {
                                    CQybjs(mxxx);
                                        //CQsppd(mxxx,
                                        //    function() {
                                        //        setTimeout(function() {

                                        //                CQybjs(mxxx);
                                        //            },
                                        //            50);
                                        //    });
                                    },
                                    50);

                            });
                        },
                        50);

                    },
		            50)};
            
        }
    }

    var patInfo;
    function initPatientInfo(data) {
        patInfo = data;
        $('').html(data.zyh);
        $('').html(data.sbbh);
        $('').html(data.fzxbh);
        $('').html(data.zhifuleibie);
        $('').html(data.sbbf);
        $('').html(parseFloat(hisfyze).toFixed(2));
    }
    //审批判定，Gọi22接口查看是否有未审批数据
    function CQsppd(mxxx, funcSuccCallback) {
        var parameter1 = { "": zyh, "": "", "": $.getDate({ date: ryrq }), "": "" };
        var parameter2 = { "": zyh, "": "", "": $.getDate({ date: ryrq }), "": "" };
        var spGsfReturn;
        var spBdbReturn;
        $.ajax({
            type: "",
            url: "",
            data: parameter1,
            dataType: "",
            async: false,
            success: function (data) {
                spGsfReturn = eval('' + data + '');
            }
        });
        $.ajax({
            type: "",
            url: "",
            data: parameter2,
            dataType: "",
            async: false,
            success: function (data) {
                spBdbReturn = eval('' + data + '');
            }
        });
        if (!!spGsfReturn && !!spBdbReturn && spGsfReturn.Code === "" && spBdbReturn.Code === "") {
            if (!!spGsfReturn.Data && spGsfReturn.Data.cfmxlshList.length > 0) {
                $.loading(false);
                $.modalAlert("", '');
                return;
            }
            if (!!spGsfReturn.Data && spBdbReturn.Data.cfmxlshList.length > 0) {
                $.loading(false);
                $.modalAlert("", '');
                return;
            }
        } else {
            $.loading(false);
            $.modalAlert("", '');
            return;
        }
        if (funcSuccCallback) {
            funcSuccCallback(mxxx);
        }
    }


</script>

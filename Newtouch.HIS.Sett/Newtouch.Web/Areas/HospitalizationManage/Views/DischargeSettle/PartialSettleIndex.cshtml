            return;
        }

        var startTime = $('#startTime').html();
        if (!!!startTime) {
            $.modalAlert("Chưa chỉ định thời gian bắt đầu quyết toán", 'error');
            return;
        }
        if (!!!zyh) {
            $.modalAlert("Vui lòng chọn bệnh nhân nội trú", 'error');
            return;
        }
        var thisSettEndTime = $('#endTime').val();
        if (!!!thisSettEndTime) {
            $.modalAlert("Chưa chỉ định thời gian kết thúc quyết toán", 'error');
            return;
        }

        if (startTime > thisSettEndTime) {
            $.modalAlert("Thời gian bắt đầu không thể lớn hơn thời gian kết thúc", "warning");
            return;
        }
        var allLine = $("#gridList").jqGrid('getRowData_AllLine', null, true);
        if (!!!allLine || allLine.length == 0) {
            $.modalAlert("Không có chi phí chưa kết", 'error');
            return;

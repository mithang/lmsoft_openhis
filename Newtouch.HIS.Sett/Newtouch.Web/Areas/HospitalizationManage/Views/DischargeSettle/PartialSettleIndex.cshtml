    /* Lấy số hóa đơn */
    function CQGetFph() {
        var rs = false;
        var msg = "";
        var fph = "";

        $.ajax({
            type: "POST",
            url: "/OutpatientManage/OutpatientReg/GetInvoice?r=" + Math.random(),
            data: {},
            dataType: "text",
            async: false,
            success: function (data) {
                if (!!!data) {
                    msg = "HIS Dịch vụ(Lấy số hóa đơn)Thông tin trả về trống";
                    return;
                }
                if (data.indexOf("{") >= 0 || data.indexOf("<") >= 0) {
                    msg = "HIS Dịch vụ(Lấy số hóa đơn)Nội dung trả về sai：" + data;
                    return;
                }
                rs = true;
                fph = data;
            },
            error: function (request, error, ex) {
                msg = "HIS Dịch vụ(Lấy số hóa đơn)Không thể truy cập：[" + ex + "]";
            }
        });

        return { rs: rs, fph: fph, msg: msg };
    }

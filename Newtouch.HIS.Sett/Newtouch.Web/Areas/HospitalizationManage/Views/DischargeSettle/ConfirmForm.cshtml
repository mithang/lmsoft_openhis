<script type="">
    //Thanh toán di động
    var payingOrFailed = null;  //trueĐang thanh toán hoặc thanh toán thất bại
    function CheckPayOK(settInfo) {
        //&&Thanh toán cần
        var needPay = '' == '';
        if (!needPay) {
            return true;
        }
        var payMoney = 0;
        var alipayMoney = 0;
        var wechatMoney = 0;
        if (settInfo.zfje1 > 0) {
            if (settInfo.zffs1 == '') {
                alipayMoney = settInfo.zfje1;
            }
            else if (settInfo.zffs1 == '') {
                wechatMoney = settInfo.zfje1;
            }
        }
        if (settInfo.zfje2 > 0) {
            if (settInfo.zffs2 == '') {
                alipayMoney = settInfo.zfje2;
            }
            else if (settInfo.zffs2 == '') {
                wechatMoney = settInfo.zfje2;
            }
        }
        if (alipayMoney > 0 && wechatMoney > 0) {
            $.modalAlert('', '');
            return false;    //Lựa chọn phương thức thanh toán sai
        }
        payMoney = alipayMoney + wechatMoney;
        if (payMoney <= 0) {
            //Không cần thanh toán di động
            payingOrFailed = null;
            return true;
        }
        if (payMoney > 0 && !!settInfo.zffs1 && !!settInfo.zffs2) {
            $.modalAlert('', '');
            return false;    //Lựa chọn phương thức thanh toán sai
        }
        if (payMoney > 0 && settInfo.zhaoling != 0) {
            $.modalAlert('', '');
            return false;
        }
        if ((payingOrFailed === null || payingOrFailed === true) && needPay && payMoney > 0) {
            payMoney = ovpraseFloat(payMoney).toFixed(2);
            var out_trade_no = (new Date()).getTime().toString();   //Có vấn đề không？
            ToPay(out_trade_no, '', payMoney);
            payingOrFailed = true;
        }
        return !(payingOrFailed === true); //Đang thanh toán Trả vềtrue，Nếu không trả vềfalse
    }
    //Khởi tạo thanh toán
    function ToPay(out_trade_no, subject, total_amount) {
        var title = '' + (subject.length <= 15 ? subject : subject.substring(0, 12) + "");
        var url = "";
        url += '' + out_trade_no;
        url += '' + subject;
        url += '' + total_amount;
        $.modalOpen({
            id: "",
            title: title,
            url: url,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].AcceptClick(function (data) {
                    //pay success callback
                    PaySuccessHandle(data);
                });
            }
        });
    }
    //Thanh toán thành công-Tiếp tục gửi quyết toán
    var outTradeNo;
    function PaySuccessHandle(data) {
        payingOrFailed = false;

        outTradeNo = data.outTradeNo;
        //Di động sửa chữa phương thức thanh toán
        if (data.payType == 1 && $('').val() == '') {
            $('').val("").trigger('');
        }
        if (data.payType == 2 && $('').val() == '') {
            $('').val("").trigger('');
        }
        AcceptClick(theAcceptClickCallBack);
    }

    //预交金充值通道
    function InpAccountDeposit() {
        var czje = ovpraseFloat(xjzfys.toFixed(2) - yjjye.toFixed(2)).toFixed(2);
        $.modalOpen({
            id: "",
            title: "",
            url: ""+czje,
            width: "",
            height: "",
            callBack: function (iframeId) {
                var xz = '';
                top.frames[iframeId].SubmitAccountDeposit(patid, xz); //Trong sự kiện cửa sổ bật lên
                $.reload();
            }
        });
    }

    function yjjRefresh() {
        //Xử lý tiền tạm ứng
        if (!!yjjye && yjjye >= xjzfys.toFixed(2) && $("").val() == "") {
            $("").hide();
            if ($('').is('')) {
                $('').val(ovpraseFloat(yjjye).toFixed(2));
            }
            $('').val('').trigger('');
            hjsskZhaolingCal();
           
        }
        else if (!!yjjye && yjjye < xjzfys.toFixed(2) && $("").val() == "") {
            //$("").html(ovpraseFloat(xjzfys - yjjye).toFixed(2));
            $("").show();
        }
    }
</script>

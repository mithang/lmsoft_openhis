@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="gridPanel" style="margin-top:1%">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>
<script>
	var zyh = $.request("");
	var sfxmCode = $.request("");
    $(function () {
        gridInit();

        $(window).resize(function () {
            $("").setGridWidth($(window).width());
        })

    });
  

    function gridInit() {
        var $gridList = $("");
        $gridList.dataGrid({
			postData: { zyh: zyh, sfxmCode: sfxmCode },
            url: "",
            height: $(window).height() - 80,
            colModel: [
                { label: '', name: '', align: '', width: 60 },
                { label: '', name: '', align: '', width:40 },
                { label: '', name: '', align: '', width: 150 },
                { label: '', name: '', align: '', width: 60 },
                { label: '', name: '', align: '', width: 50 },
                {
                    label: '', name: '', align: '', width: 50,formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' } },
                { label: '', name: '', align: '', width: 30 },
                { label: '', name: '', align: '', hidden: true, },
                {
                    label: '', name: '', align: '', width: 30, formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }
                },
                { label: '', name: '', align: '', width: 50 },
                { label: '', name: '', align: '', width: 70 },
                { label: '', name: '', align: '', width: 100 },
			],
            pager: "",
            sortname: '',
            viewrecords: true,
        });
	}
</script>
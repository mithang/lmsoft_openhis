@using Newtouch.Infrastructure;
@{
	ViewBag.Title = "Index";
	Layout = "~/Views/Shared/_Index.cshtml";
	//Có thể quyết toán hay không Bệnh nhân trong khu bệnh
	var isSettContainsBQZ = SysConfigReader.Bool("HOSP_Sett_Contains_BQZ", false).Value;
	var brzybzType = ((int)EnumZYBZ.Djz).ToString();
	//if (isSettContainsBQZ)
	//{
	brzybzType += "," + ((int)EnumZYBZ.Bqz).ToString();
	//}
	//có vàCPOEGiao diện liên thông
	//var interfaceWithCPOE = SysConfigReader.Bool("HOSP_INTERFACE_WITH_CPOE", false).Value;

	//Có giao dịch với BHYT hay không
	var openYbSett = SysConfigReader.Bool("Inpatient_Sett_OpenYbSett");
	//Có giao dịch với bảo hiểm nông thôn mới hay không
	var openXnhSett = SysConfigReader.Bool("Inpatient_Sett_OpenXnhSett");
	//Nơi tham gia BHYT，Phân biệt hệ thống sẽ thực hiện logic BHYT ở đâu
	var medicalInsurance = SysConfigReader.String("Inpatient_MedicalInsurance");

	var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}
<div class="rows" style="margin-bottom: 1%;">
	<div class="panel panel-default" style="margin-bottom:0;">
		@*<div class="panel-heading navb-bg">
				Thông tin bệnh nhân nội trú
			</div>*@
		<table class="form" style="width:96%;">
			<tbody>
				<tr>
					<th class="formTitle">Số nhập viện：</th>
					<td class="formValue">
						<input class="form-control" type="text" id="zyh" value="" style="width:49%;float:left;" />
						&nbsp;&nbsp; <input type="button" class="btn btn-default btn-md btn-default-color" style="width: 25%;" title="Chọn bệnh nhân nội trú" id="zy_btnsyy" value="Tra cứu" onclick="GetPatSerarchView();">
					</td>
					<th class="formTitle">Ngày hết hạn chi phí：</th>
					<td class="formValue" colspan="1">
						<input id="jssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="float:left" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd  HH:mm:ss' })" />
					</td>
					<th class="formTitle">Tên hạng mục：</th>
					<td class="formValue">
						<input type="text" class="form-control" id="xmmc" style="width:90%;float:left;" />
					</td>
                    <td class="formValue" style="width:500px;float:left;">
                        <input type="button" class="btn btn-default btn-md btn-default-color" style="width: 15%;" title="Tra cứu" id="zy_cx" value="Tra cứu">
                        <input type="button" class="btn btn-default btn-md btn-default-color" style="width: 15%;" title="Chưa tải lên" id="zy_btwsc" value="Chưa tải lên">
                        <input type="button" class="btn btn-default btn-md btn-default-color" style="width: 15%;" title="Đã tải lên" id="zy_btysc" value="Đã tải lên">
                        <input type="button" class="btn btn-default btn-md btn-default-color" style="width: 15%;" title="Tải lên chi phí" id="zy_btsc" value="Tải lên chi phí">
                        <input type="button" class="btn btn-default btn-md btn-default-color" style="width: 15%;" title="Hoàn trả chi phí" id="zy_bft" value="Hoàn trả chi phí">
                        <input type="button" class="btn btn-default btn-md btn-default-color" style="width: 15%;" title="Hoàn trả toàn bộ chi phí" id="zy_qt" value="Hoàn trả toàn bộ chi phí">
                        <input type="button" class="btn btn-default btn-md btn-default-color" style="width: 15%;" title="Quyết toán trước" id="zy_btyjs" value="Quyết toán trước">
                        <input type="button" class="btn btn-default btn-md btn-default-color" style="width: 15%;" title="[2405]Hủy xuất viện" id="zy_cyjscx" value="[2405]Hủy xuất viện">
                        <input type="button" class="btn btn-default btn-md btn-default-color" style="width: 15%;" title="Kiểm tra trong quá trình" id="zy_szsh" value="Kiểm tra trong quá trình">
                        <input id="ckgrzhbz" type="checkbox" checked="checked" /><label for="ckgrzhbz">Cờ tài khoản cá nhân</label>
                    </td>
				</tr>
				<tr>
					<th class="formTitle">Họ tên：</th>
					<td class="formValue" colspan="8">
						<label id="xm"></label><label style="width:15%"></label><span>Tính chất:</span> <label id="brxz"></label>
						<label style="width:15%"></label> <span>Giới tính:</span> <label id="xb"></label>
						<label style="width:15%"></label><span>Ngày nhập viện:</span> <label id="ryrq"></label>
						<label style="width:15%"></label><span>Ngày xuất viện:</span> <label id="cyrq"></label>
					</td>
					@*<th class="formTitle">Giới tính：</th>
						<td class="formValue">
							<label id="xb"></label>

						</td>*@
					@*<th class="formTitle" style="width:50px;">Ngày nhập viện：</th>
						<td class="formValue">
							<label id="ryrq"></label>
						</td>
						<th class="formTitle">Ngày xuất viện：</th>
						<td class="formValue">
							<label id="cyrq"></label>
						</td>*@

				</tr>
				<tr>
					<th class="formTitle">Chẩn đoán nhập viện：</th>
					<td class="formValue" colspan="8">
						<label id="ryzdmc"></label>
						<label style="width:15%"></label><span>Số dư tài khoản:</span><label id="zhye"></label>
					</td>
				</tr>
			</tbody>
			@*<tbody>
					<tr>
						<th class="formTitle"></th>
						<td class="formValue" colspan="2">
							<label></label>
						</td>
						<th class="formTitle">Số ngày nằm viện：</th>
						<td class="formValue">
							<label id="zyts"></label>
						</td>
						<th class="formTitle">Ngày sinh：</th>
						<td class="formValue">
							<label id="csny"></label>
						</td>
						 <th class="formTitle">Tuổi：</th>
						<td class="formValue">
							<label id="nlshow"></label>
						</td>
						<th class="formTitle">Chẩn đoán xuất viện：</th>
						<td class="formValue">
							<label id="cyzd"></label>
						</td>
					</tr>
				</tbody>*@
		</table>
	</div>
</div>
<ul id="myTab" class="nav nav-tabs">
	<li class="active"><a href="#newyj" data-toggle="tab">Chi tiết</a></li>
	<li><a href="#yj" data-toggle="tab">Tổng hợp nhóm lớn</a></li>
</ul>
<div class="tab-content" style="margin-top:1%">
	<div class="tab-pane fade in active" id="newyj">
		<table id="gridList"></table>
		<div id="gridPager"></div>
	</div>
	<div class="tab-pane fade" id="yj">
		<table id="gridList2"></table>
		<div id="gridPager2"></div>
	</div>
</div>

<script>
    var openYbSett = '@openYbSett' === 'True'; //Cấu hình công tắc：Bệnh nhân BHYT có sử dụng quy trình giao dịch BHYT hay không
    var openXnhSett = '@openXnhSett' === 'True'; //Cấu hình công tắc：Bệnh nhân bảo hiểm nông thôn mới có sử dụng quy trình giao dịch BHYT nông thôn mới hay không
    var isYbjyjz; //Lần khám hiện tại có giao dịch BHYT hay không
    var isXnhjyjz;
    var medicalInsurance = '@medicalInsurance';
    var cqPatInfo = {}; //Tải lên thông tin cần thiết BHYT
    var $gridList = $("#gridList");
	var $gridList2 = $("#gridList2");
    $(function () {
        gridListData();
        gridListData2();

        $('#myTab li:eq(1) a').tab('hidden');
        $('#myTab li:eq(1) a').click(function() {
            $('#myTab li:eq(1) a').tab('show'); //Sẽ kích hoạtgrid2Tải kiểu
        });
        $('#myTab li:eq(0) a').click(function () {
            setTimeout("$('#myTab li:eq(0) a').tab('show');", 200); //Hiển thị
        });

    });

    //Tra cứu bệnh nhân(Nhập viện)
    function GetPatSerarchView() {
        $.modalOpen({
            id: "patSearch",
            title: "Tra cứu bệnh nhân",
            url: "/PatientManage/AccountManage/PatSearchView?brzybzType=" + '@(brzybzType)' + "&t=" + Math.random() + "&zyh=" + $("#zyh").val(),
            width: "700px",
            height: "600px",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
                //Gọi tra cứu số thẻ và số nhập viện
            }//Hàm callback khi nhấn xác nhận trên cửa sổ
        });
    }

    //Bệnh nhân đã chọn callback
    function getPatInfoAjax(selePatInfo) {
        //Xóa một chút
        newtouch_event_f4();
        //
        patModel = null;
        jszje = 0.00;
        if (selePatInfo && selePatInfo.zyh) {
            $('#zyh').val(selePatInfo.zyh);
            ajaxLoadDataResult(selePatInfo.zyh);
            ajaxLoadDataResult2(selePatInfo.zyh);
            GetPatInfo(selePatInfo.zyh);
        }
        else {
            $('#zyh').val('');
        }
    }

    function GetPatInfo(zyh)
    {
        $.ajax({
            type: "POST",
            url: "/PatientManage/HospiterRes/GetCQjzdjInfo",
            data: { zyh: zyh },
            dataType: "json",
            cache: false,
            async: false,
            success: function (payoptype) {
                if (payoptype) {
                    cqPatInfo = payoptype;
                }
            }
        });
    }

    //
    var patModel = null;
    //
    var jszje = 0.00;
    var scbz = false;//trueTải lên tất cả false"Tải lên mục đã chọn
    var isnewyb = "0";//0  BHYT quốc gia 1 BHYT Thượng Hải giai đoạn năm
    //Theozyh Thông tin cơ bản bệnh nhân、Thông tin tính phí
    function ajaxLoadDataResult(zyh) {

        $.najax({
            type: "POST",
            url: "/HospitalizationManage/DischargeSettle/GetZybrInfo",
            data: { zyh: zyh,jslx: 'mnjs' },
            dataType: "json",
            success: function (ajaxresp) {
                //Thông tin bệnh nhân nội trú
                patModel = ajaxresp.data.InpatientSettPatInfo;

                isYbjyjz = openYbSett && patModel.brxzlb == '1';

                $('#xm').html(patModel.xm);
                $('#xb').html($.getGender(patModel.xb));
                $('#brxz').html(patModel.brxzmc);
                $("#nlshow").html(getAgeFromBirthTime({ begin: patModel.csny }).text);
                //$('#ryzd').html(patModel.ryzdmc);
                $('#cyzd').html(patModel.cyzd);
				$('#zyts').html(patModel.zyts);
				$('#ryzdmc').html(patModel.ryzdmc);
				$('#zhye').html(patModel.zhye);
                $('#csny').html(patModel.csny ? patModel.csny.substring(0, 10) : '');
                $('#ryrq').html(patModel.ryrq ? patModel.ryrq.substring(0, 10) : '');
                $('#cyrq').html(patModel.cyrq ? patModel.cyrq.substring(0, 10) : '');
                var bkbz = patModel.cblb.substr(11, 1);
				var gbbz = patModel.cblb.substr(1, 1);//Bảo hiểm cán bộ 1
				if (patModel.cblb.length>=16) {
					if (bkbz == "G" || bkbz == "A" || gbbz == "1") {
						isnewyb = "1";
					}
				}

                if (ajaxresp.data.InpatientSettPatInfo) {
                    loadJfmxByZyh(zyh, null);
                }
                else {
                    $.modalAlert("Chưa phát sinh chi phí，Không thể quyết toán", 'warning');
                    return false;
                }
            },
            errorCallback: function (data) {
                newtouch_globalevent_f4();
                $('#zyh').trigger('focus');
            }
        });
	}

    //Theozyh Thông tin cơ bản bệnh nhân、Thông tin tính phí
    function ajaxLoadDataResult2(zyh) {
        $.najax({
            type: "POST",
            url: "/HospitalizationManage/DischargeSettle/GetInpatientSettleStatusDetail",
            data: { zyh: zyh, jslx: 'mnjs' },
            dataType: "json",
            success: function (ajaxresp) {
                //Thông tin bệnh nhân nội trú
                //patModel = ajaxresp.data.InpatientSettPatInfo;

                @*isYbjyjz = openYbSett && patModel.brxz == '1' && patModel.CardType == "@((int)Newtouch.Infrastructure.EnumCardType.YBJYK)";
                isXnhjyjz = openXnhSett && patModel.brxz == '8' && patModel.CardType == "@((int)Newtouch.Infrastructure.EnumCardType.XNHJYK)";*@

                //$('#xm').html(patModel.xm);
                //$('#xb').html($.getGender(patModel.xb));
                //$("#nlshow").html(getAgeFromBirthTime({ begin: patModel.csny }).text);
                ////$('#ryzd').html(patModel.ryzdmc);
                //$('#cyzd').html(patModel.cyzd);
                //$('#zyxz').html(patModel.brxzmc);
                //$('#zyts').html(patModel.zyts);
                //$('#csny').html(patModel.csny ? patModel.csny.substring(0, 10) : '');
                //$('#ryrq').html(patModel.ryrq ? patModel.ryrq.substring(0, 10) : '');
                //$('#cyrq').html(patModel.cyrq ? patModel.cyrq.substring(0, 10) : '');

                if (ajaxresp.data.GroupFeeVOList && ajaxresp.data.GroupFeeVOList.length) {
                    loadJfmxByZyh2(ajaxresp.data.GroupFeeVOList);
                }
                else {
                    $.modalAlert("Chưa phát sinh chi phí，Không thể quyết toán", 'warning');
                    return false;
                }
            },
            errorCallback: function (data) {
                newtouch_globalevent_f4();
                $('#zyh').trigger('focus');
            }
        });
    }

    //Chi tiết chi phí
    function loadJfmxByZyh() {
        $('#zy_cx').click();
    }
    //Tra cứu
    $('#zy_cx').click(function () {
        mxsczt = "";
        $gridList.jqGrid('setGridParam', {
            postData: { zyh: patModel.zyh, sczt: "", jssj: $('#jssj').val(), xmmc: $('#xmmc').val(), isnewyb: isnewyb },
            url: "/HospitalizationManage/DischargeSettle/GetZyUploadDetail",
        }).trigger('reloadGrid');
        setJe(patModel.zyh, mxsczt);

        ajaxLoadDataResult2(patModel.zyh)
    })
    //Chưa tải lên
    $('#zy_btwsc').click(function () {
        var mxsczt = "未上传";
        $gridList.jqGrid('setGridParam', {
            postData: { zyh: patModel.zyh, sczt: "未上传", jssj: $('#jssj').val(), xmmc: $('#xmmc').val(), isnewyb: isnewyb },
            url: "/HospitalizationManage/DischargeSettle/GetZyUploadDetail",
        }).trigger('reloadGrid');
        setJe(patModel.zyh, mxsczt);
    })
    //Đã tải lên
    $('#zy_btysc').click(function () {
        var mxsczt = "已上传";
        $gridList.jqGrid('setGridParam', {
            postData: { zyh: patModel.zyh, sczt: "已上传", jssj: $('#jssj').val(), xmmc: $('#xmmc').val(), isnewyb: isnewyb },
            url: "/HospitalizationManage/DischargeSettle/GetZyUploadDetail",
        }).trigger('reloadGrid');
        setJe(patModel.zyh, mxsczt);
    })
    //Quyết toán trước
    $('#zy_btyjs').click(function () {
        setTimeout(function () {
            $.loading(true, 'Đang thực hiện quyết toán trước，Vui lòng chờ...');
            setTimeout(function () {
                ybpreeSettCall();
            }, 50);
        }, 50);
    })

    $('#zy_szsh').click(function () {
        if (!patModel || !patModel.zyh) {
            $.modalAlert("Số nhập viện trống", 'warning');
            return;
        }
        var rcszsh = { "zyh": patModel.zyh, "operatorId": '@(opr.UserCode)', "operatorName": '@(opr.UserName)',"orgId":'@opr.OrganizeId' }
        $.ajax({
            type: "POST",
            url: "http://127.0.0.1:33333/api/YiBao/Undereview_3102",
            data: rcszsh,
            dataType: "json",
            async: false,
            success: function (data) {
                var bfDataReturn = eval('(' + data + ')');
                if (bfDataReturn.infcode === 0 || bfDataReturn.infcode === "0") {
                    var error = "";
                    if (bfDataReturn.output.result.length > 0) {
                        for (var i = 0; i < bfDataReturn.output.result.length; i++) {
                            if (bfDataReturn.output.result[i].vola_cont != null || bfDataReturn.output.result[i].vola_cont != "") {
                                error += "【" + bfDataReturn.output.result[i].vola_cont + "】";
                            }
                        }
                        if (error != "") {
                            $.modalAlert("Thông tin vi phạm kiểm tra trong quá trình：" + error, 'error');
                        }
                        else {
                            $.modalAlert("Đã hoàn thành kiểm tra，Không có thông tin vi phạm!", 'success');
                        }
                    } else {
                        $.modalAlert("Đã hoàn thành kiểm tra，Không có thông tin vi phạm!", 'success');
                    }
                }
                else {
                    $.modalAlert("Kiểm tra thất bại：" + bfDataReturn.err_msg, 'error');
                }
            },
            error: function (request, error, ex) {
                $.modalAlert("Dịch vụ BHYT【3102】(Kiểm tra trong quá trình)Không thể truy cập：[" + ex + "]", 'error');
            }
        });
    })

    //Hủy quyết toán xuất viện
    $('#zy_cyjscx').click(function () {
        if (patModel.zyh == null || patModel.zyh=="") {
            $.modalAlert("Vui lòng chọn số nhập viện！", 'error');
            return;
        }
       $.ajax({
		    type: "POST",
		    url: "/PatientManage/HospiterRes/GetCQjzdjInfo",
		    data: { zyh: patModel.zyh },
		    dataType: "json",
		    cache: false,
		    async: false,
		    success: function (payoptype) {
		    	if (!payoptype) {
				    $.loading(false);
				    $.modalAlert("Lấy đăng ký khám nội trú thất bại", 'error');
				    return;
		    	}
                payoptype.mdtrt_cert_type = cqPatInfo.jzlx;
		    	payoptype.orgId = "@opr.OrganizeId";
                cqPatInfo.grbh = payoptype.psn_no;
                mdid = payoptype.mdtrt_id;
                var payoptype = { hisId: patModel.zyh, 'operatorId': '@(opr.rygh)', 'operatorName': '@(opr.UserName)', 'mdtrt_id': mdid, 'psn_no': cqPatInfo.grbh, "insuplc_admdvs": cqPatInfo.insuplc_admdvs };
                UpOutMdtrtinfo(payoptype);
                $.modalAlert("Hủy quyết toán xuất viện thành công！", 'warning');
		    }
	    });
    })
    //Tải lên chi phí
    $('#zy_btsc').click(function () {
        var jfbbhlist = [];
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        if (selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn chi tiết cần tải lên trước", 'warning');
            return;
        }
        if (!isYbjyjz) {
            $.modalAlert("Bệnh nhân tự chi trả không được giao dịch BHYT", 'warning');
            return;
        }
        if (scbz)//Tất cả
        {
            ybBussiness();
        }
        else
        {
            $.each(selRowIds, function (i,item) {
                jfbbhlist.push(item.substring(2));
            })
            jfbbhlist =jfbbhlist.join(',')
            ybBussiness(jfbbhlist);
        }
    })
    //Hoàn trả một phần
    $('#zy_bft').click(function () {
        if (!patModel) {
            $.modalAlert("Vui lòng tra cứu thông tin bệnh nhân trước!", 'error');
            return;
        }
        if (!isYbjyjz) {
            $.modalAlert("Bệnh nhân tự chi trả không được giao dịch BHYT", 'warning');
            return;
        }
        var tjfbbhlist = [];
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        if (selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn chi tiết cần hoàn trả trước", 'warning');
            return;
        }
        if (isnewyb=="1") {
            $.modalAlert("Bệnh nhân hiện tại tạm thời không thể hoàn phí riêng，Vui lòng chọn chi phí hoàn trả toàn bộ，Và tải lên lại", 'warning');
            return;
        }
        $.each(selRowIds, function (i, item) {
            tjfbbhlist.push(item);
        })
        tjfbbhlist = tjfbbhlist.join(',');
        cqPatInfo.feedetl_sn = tjfbbhlist;
        $.ajax({
            type: "POST",
            url: "http://127.0.0.1:33333/api/YiBao/HospitaUpDscginfo_2302V2",
            data: cqPatInfo,
            dataType: "json",
            async: false,
            success: function (data) {
                var bfDataReturn = eval('(' + data + ')');
                if (bfDataReturn.infcode == "0") {
                    $.modalAlert("Hoàn trả chi phí thành công!", 'success');
                    $('#zy_cx').click();
                }
                else {
                    $.modalAlert("Hoàn trả chi phí thất bại：" + bfDataReturn.err_msg, 'error');
                }
            },
            error: function (request, error, ex) {
                $.modalAlert("Dịch vụ BHYT【2302】(Hủy chi tiết chi phí nội trú)Không thể truy cập：[" + ex + "]", 'error');
            }
        });
    })
    //Hoàn trả toàn bộ
    $('#zy_qt').click(function () {
        var errmsg = "";
        if(!patModel)
        {
            $.modalAlert("Vui lòng tra cứu thông tin bệnh nhân trước!", 'error');
            return;
        }
        if (!isYbjyjz) {
            $.modalAlert("Bệnh nhân tự chi trả không được giao dịch BHYT", 'warning');
            return;
        }
        $.modalConfirm("Sẽ hoàn trả tất cả chi phí đã tải lên của bệnh nhân này，Xác nhận có tiếp tục hay không？",
           function (flag) {
               if (!flag) {
                   return;
               } else {
                   if (isnewyb == "1") {

@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
    //是否可结算 bệnh nhân của trong khu bệnh
    var isSettContainsBQZ = SysConfigReader.Bool("", false).Value;
    var brzybzType = ((int)EnumZYBZ.Djz).ToString();
    //if (isSettContainsBQZ)
    //{
    brzybzType += "" + ((int)EnumZYBZ.Bqz).ToString();
    //}
    //有与CPOEGiao diện tương thông
    //var interfaceWithCPOE = SysConfigReader.Bool("", false).Value;

    //Có giao dịch bảo hiểm y tế không
    var openYbSett = SysConfigReader.Bool("");
    //Có giao dịch bảo hiểm nông thôn mới không
    var openXnhSett = SysConfigReader.Bool("");
    //Địa bàn bảo hiểm y tế，区分系统将执行何处医保逻辑
    var medicalInsurance = SysConfigReader.String("");

    var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}

<div class="rows" style="margin-bottom: 1%;">
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading navb-bg">
            Thông tin bệnh nhân nhập viện
        </div>
        <table class="form" style="width:96%;">
            <tbody>
                <tr>
                    <th class="formTitle">Số nhập viện：</th>
                    <td class="formValue">
                        <input class="form-control" type="text" id="zyh" value="" />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-default btn-md btn-default-color" title="Chọn bệnh nhân nhập viện" id="zy_btnsyy" value="Tra cứu" onclick="GetPatSerarchView();">
                    </td>
                    <th class="formTitle">Họ tên：</th>
                    <td class="formValue">
                        <label id="xm"></label>
                    </td>
                    <th class="formTitle">Giới tính：</th>
                    <td class="formValue">
                        <label id="xb"></label>
                    </td>
                    <th class="formTitle">Tuổi：</th>
                    <td class="formValue">
                        <label id="nlshow"></label>
                    </td>
                    <th class="formTitle">Chẩn đoán xuất viện：</th>
                    <td class="formValue">
                        <label id="cyzd"></label>
                    </td>
                </tr>
            </tbody>
            <tbody>
                <tr>

                    <th class="formTitle">Tính chất chi phí：</th>
                    <td class="formValue" colspan="2">
                        <label id="zyxz"></label>
                    </td>
                    <th class="formTitle">Số ngày nhập viện：</th>
                    <td class="formValue">
                        <label id="zyts"></label>
                    </td>
                    <th class="formTitle">Ngày sinh：</th>
                    <td class="formValue">
                        <label id="csny"></label>
                    </td>
                    <th class="formTitle">Ngày nhập viện：</th>
                    <td class="formValue">
                        <label id="ryrq"></label>
                    </td>
                    <th class="formTitle">Ngày xuất viện：</th>
                    <td class="formValue">
                        <label id="cyrq"></label>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<div class="gridPanel" style="margin-top:1%">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 4, 8 },
    F8Text = ""
})

<script>
    var openYbSett = '' === ''; //Cấu hình công tắc：Bệnh nhân bảo hiểm y tế có sử dụng quy trình giao dịch bảo hiểm y tế không
    var openXnhSett = '' === ''; //Cấu hình công tắc：Bệnh nhân bảo hiểm nông thôn mới có sử dụng quy trình giao dịch bảo hiểm nông thôn mới không
    var isYbjyjz; //Lần khám hiện tại có đi theo giao dịch bảo hiểm y tế không
    var isXnhjyjz;
    var medicalInsurance = '';

    $(function () {
        gridListData();
    });

    //Tra cứu bệnh nhân(Nhập viện)
    function GetPatSerarchView() {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + '' + "" + Math.random() + "" + $("").val(),
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
                //Gọi tra cứu số thẻ và số nhập viện
            }//Hàm callback xác nhận khi nhấn cửa sổ
        });
    }

    //Bệnh nhân đã chọn callback
    function getPatInfoAjax(selePatInfo) {
        //Xóa một chút
        newtouch_globalevent_f4();
        //
        patModel = null;
        jszje = 0.00;
        if (selePatInfo && selePatInfo.zyh) {
            $('').val(selePatInfo.zyh);
            ajaxLoadDataResult(selePatInfo.zyh);
        }
        else {
            $('').val('');
        }
    }

    //
    var patModel = null;
    //
    var jszje = 0.00;

    //Theozyh Thông tin cơ bản bệnh nhân、Thông tin tính phí
    function ajaxLoadDataResult(zyh) {
        $.najax({
            type: "",
            url: "",
            data: { zyh: zyh, jslx: '' },
            dataType: "",
            success: function (ajaxresp) {
                //Thông tin bệnh nhân nhập viện
                patModel = ajaxresp.data.InpatientSettPatInfo;

                isYbjyjz = openYbSett && patModel.brxz == '' && patModel.CardType == "";
                isXnhjyjz = openXnhSett && patModel.brxz == '' && patModel.CardType == "";

                $('').html(patModel.xm);
                $('').html($.getGender(patModel.xb));
                $("").html(getAgeFromBirthTime({ begin: patModel.csny }).text);
                //$('').html(patModel.ryzdmc);
                $('').html(patModel.cyzd);
                $('').html(patModel.brxzmc);
                $('').html(patModel.zyts);
                $('').html(patModel.csny ? patModel.csny.substring(0, 10) : '');
                $('').html(patModel.ryrq ? patModel.ryrq.substring(0, 10) : '');
                $('').html(patModel.cyrq ? patModel.cyrq.substring(0, 10) : '');

                if (ajaxresp.data.GroupFeeVOList && ajaxresp.data.GroupFeeVOList.length) {
                    loadJfmxByZyh(ajaxresp.data.GroupFeeVOList);
                }
                else {
                    $.modalAlert("", '');
                    return false;
                }
            },
            errorCallback: function (data) {
                newtouch_globalevent_f4();
                $('').trigger('');
            }
        });
    }

    //Tổng cộng số tiền
    function loadJfmxByZyh(data) {
        //$('').jqGrid("");   //早F4
        $("").newtouchLocalDataGrid(null, data);
        //Tổng số tiền
        var zje = 0;
        $.each(data, function () {
            if (this.je) {
                zje += this.je;
            }
        });
        if (zje) {
            jszje = zje.toFixed(2);;
            $("").text(zje.toFixed(2));
        }
    }

    function newtouch_event_f4() {
        $('').html('');
        $('').html('');
        $('').html('');
        //$('').html('');
        $('').html('');
        $('').html('');
        $('').html('');
        $('').html('');
        $('').html('');
        $('').html('');
        patModel = null;
        jszje = 0.00;
        $('').text('');
        $('').jqGrid("");
    }

    //Liên kếtgrid
    function gridListData() {
        var captionCon = "" + "" + "";
        var $gridList = $("");
        $gridList.newtouchLocalDataGrid({
            height: $(window).height() - 225,
            unwritten: false,
            caption: captionCon,
            colModel: [
                { label: '', name: '', hidden: true },
                { label: '', name: '', width: 100, align: '' },
                {
                    label: '', name: '', width: 500, align: '', formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }
                },
            ],
            onSelectRow: function (rowIndex, s) {
                getItemsbySfdl(rowIndex);
            }
        });
    }

    //Lưu quyết toán
    function newtouch_event_f8() {
        //if (isXnhjyjz) {
        //    $.modalAlert("", '');
        //    return;
        //}
        if (!patModel || !patModel.zyh) {
            $.modalAlert("", '');
            return;
        }
        var data = $("").jqGrid('');
        if (!(data && data.length)) {
            $.modalAlert("", '')
            return;
        }
        if (!patModel.ryrq) {
            $.modalAlert("", '');
            return;
        }

        hisSubmit();
    }

    //
    function hisSubmit() {
        //
        var zyh = patModel.zyh;
        var ryrq = $.getDate({ date: patModel.ryrq });
        var zje = jszje;
        //
        var openUrl = "" + zyh;
        openUrl += "" + (!!ryrq ? ryrq : '');
        openUrl += "" + zje;
        openUrl += "" + isYbjyjz;
        openUrl += "" + isXnhjyjz; 
        openUrl += "" + medicalInsurance;
        $.modalOpen({
            id: "",
            title: "",
            url: openUrl,
            width: "",
            height: "",
            btn: [''],
            callBack: function (iframeId) {
                $.modalClose(iframeId);
                return;
            }
        });
    }
    function getItemsbySfdl(id) {
        var rowData = $("").jqGrid('', id);
        if (!!rowData) {
            var sfdl = rowData.dlCode;
            $.modalOpen({
                id: "",
                title: "",
                url: "" + sfdl + "" + $("").val(),
                width: "",
                height: "",
                btn: null,
                callBack: function (iframeId) {
                }
            });
        }
    }
</script>

@{

    Layout = "";
}
<form>
    <div class="topPanel" style="border-bottom:1px solid rgb(221, 221, 221);margin-bottom: -1%;">
        <table class="form">
            <tr>
                <td style="width:2%">
                    <div class="toolbar" style="margin-top: 1%;">
                        <div class="btn-group">
                            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
                        </div>
                    </div>
                </td>
                <th class="formTitle">Tìm kiếm hạng mục：</th>
                <td class="formValue">
                    <input id="dlCode" name="dlCode" type="text" class="form-control" placeholder="按照项目编码项目名称或简拼" />
                </td>
              
                <td style="padding-left:20px;" class="formValue">
                    <input type="button" id="btn_search" style="margin-left:3%; width:35%; margin-top:-2%;" class="btn btn-primary" value="Tra cứu" />
                </td>
            </tr>
        </table>
    </div>
    <div class="gridPanel" style="margin-top:1%">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>


<script>
    var zyh = $.request("");
    var dlCode = $.request("");
    $(function () {
        gridInit();
        $("").click(function () {
            $("").jqGrid('', {
                postData: { keyword: $("").val() },
            }).trigger('');
        });
    });

    function gridInit() {
        var $gridList = $("");
        $gridList.dataGrid({
            postData: { zyh: zyh, keyword: dlCode },
            url: "",
            height: $(window).height() - 120,
            colModel: [
                { label: '', name: '', align: '', width: 100 },
                { label: '', name: '', align: '', width: 40 },
                { label: '', name: '', align: '', width: 150 },
                { label: '', name: '', align: '', width: 60 },
                { label: '', name: '', align: '', width: 60 },
                {
                    label: '', name: '', align: '', width: 60, formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }
                },
                { label: '', name: '', align: '', width: 30 },
                { label: '', name: '', align: '', hidden: true, },
                {
                    label: '', name: '', align: '', width: 60, formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }
                },
                { label: '', name: '', align: '', width: 80 },
                { label: '', name: '', align: '', hidden: true, },
                //{ label: '', name: '', align: '', width: 100 },

            ],
            pager: "",
            sortname: '',
            viewrecords: true,
            //rowNum:20
            onSelectRow: function (rowIndex, s) {
                getItemsbySfdl(rowIndex);
            }
        });
    }

    function getItemsbySfdl(id) {
        var rowData = $("").jqGrid('', id);
        var smxmCode = rowData.sfxm;
        if (!!rowData) {
            $.modalOpen({
                id: "",
                title: "",
                url: "" + smxmCode + "" + zyh,
                width: "",
                height: "",
                btn: null,
                callBack: function (iframeId) {
                }
            });
        }
    }
</script>
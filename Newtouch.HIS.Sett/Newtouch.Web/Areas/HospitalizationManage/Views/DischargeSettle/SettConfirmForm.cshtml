    //根据折扣比例和折扣金额计算 Số tiền sau chiết khấu
    function calZkhMoney(je, zkje, zkbl) {
        if (je == 0) {
            return 0;
        }
        if (validMoney(je, zkje, zkbl)) {
            if (zkbl) {
                //Tỷ lệ chiết khấu
                var decimalbl = (parseInt(zkbl) / 100).toFixed(2);
                je = roundingBy4she6ru5chengshuang(ovpraseFloat(ovpraseFloat(je) * decimalbl), 2);
            }
            if (zkje) {
                if (ovpraseFloat(zkje) > ovpraseFloat(je)) {
                    $.modalAlert('', '');
                    return false;
                }
                //Số tiền chiết khấu
                je = roundingBy4she6ru5chengshuang(ovpraseFloat((ovpraseFloat(je) - ovpraseFloat(zkje))), 2);
            }
            return ovpraseFloat(je);
        }
        else {
            return false;
        }
    }

    //Xác minh định dạng số tiền có đúng không
    function validMoney(zqje, zkje, zkbl) {
        if (zqje == '' || zqje == '') {
            $.modalAlert('', '');
            return false;
        }
        //Số tiền chiết khấu
        var reg = /(^[1-9]([0-9]+)?(\.[0-9]{1,2})?$)|(^(0){1}$)|(^[0-9]\.[0-9]([0-9])?$)/;
        if (!!zkje) {
            if (!reg.test(zkje) || zkje == '') {
                $.modalAlert('', '');
                return false;
            }
        }

        if (ovpraseFloat(zkje) > ovpraseFloat(zqje)) {
            $.modalAlert('', '');
            return false;
        }

        //Tỷ lệ chiết khấu
        var blreg = /(^[1-9][0-9]$)|(^100&)|(^[1-9]$)$/;
        if (!!zkbl) {
            if (!reg.test(zkbl)) {
                $.modalAlert('', '');
                return false;
            }
        }
        if (parseInt(zkbl) > 100) {
            $.modalAlert('', '');
            return false;
        }
        return true;
    }
    //Tính toán Theo Thanh toán khoản phải thu、Phương thức thanh toán Tính tổng số tiền thực thu、Tiền thừa  不支持多种支付方式
    function hjsskZhaolingCal() {
        var djje = 0.00; //代缴金额
        if (!$('').val() && $('').val() != 0) {
            //Chưa chọn phương thức thanh toán，Số tiền tương ứng phải đặt thành0.00
            $('').val('');
            djje = xjzfys.toFixed(2);
        }
        var zfje1 = $('').val();
        if (!zfje1) {
            zfje1 = '';
        }

        var hjssk = ovpraseFloat(zfje1);  //Tổng thực thu nhiều phương thức thanh toán
        djje = ovpraseFloat(xjzfys - hjssk).toFixed(2);
        if (djje < 0) {
            djje = 0.00;
        }
        $('').html(ovpraseFloat(djje).toFixed(2));  //待缴
        $('').html(hjssk + ovpraseFloat(djje));
        var zhaoling = ovpraseFloat(hjssk - xjzfys);
        if (zhaoling < 0) {
            zhaoling = 0.00;
        }
        $('').html(zhaoling.toFixed(2));
    }

    function hjsskZhaolingCalNew() {
        var yjjzf = ovpraseFloat($("").text().trim()).toFixed(2);//Khấu trừ tiền tạm ứng
        var djje = 0.00; //代缴金额
        //var djjess = ovpraseFloat($("").val());  //Thực thu tại cửa sổ
        var djjess=CalculatedAmount();//窗口实收合计
        var zhaoling = 0.00;
        var hjssk = 0.00;
        var yjjtye = ovpraseFloat($("").text().trim()).toFixed(2);
        if (!!yjjzf && ovpraseFloat(yjjzf)>=0) {
            xjzfys=sswrjeCz();
            djje = (ovpraseFloat(xjzfys) - ovpraseFloat(yjjzf)).toFixed(2);
            if (ovpraseFloat(djje) < 0) {
                //djje = 0.00;
                $("").html(ovpraseFloat(0).toFixed(2));
               
                if (djjess<=0) {
                    $("").val(ovpraseFloat(djje).toFixed(2));
                    djjess = ovpraseFloat($("").val());
                }

                $('').html((ovpraseFloat(yjjzf) + ovpraseFloat(djjess)).toFixed(2));
                zhaoling = (Math.abs(ovpraseFloat(djje)) + djjess + ovpraseFloat(yjjtye)).toFixed(2);
                $('').html(zhaoling);
            }
            else {
                $("").html(ovpraseFloat(djje).toFixed(2));
                if (djjess <= 0) {
                    $("").val(ovpraseFloat(djje).toFixed(2));
                    djjess = ovpraseFloat($("").val());
                }

                hjssk = (ovpraseFloat(yjjzf) + ovpraseFloat(djjess)).toFixed(2);
                $('').html(hjssk);
                zhaoling = (ovpraseFloat(hjssk) - ovpraseFloat(xjzfys) + ovpraseFloat(yjjtye)).toFixed(2);
                $('').html(zhaoling);
            }
        }
    }
    //多支付方式金额合计
    function CalculatedAmount()
    {
        var cksshj=ovpraseFloat($("").val());
        var number = $('').length;
        for (var i = 1; i <= number-1; i++){
            cksshj=cksshj+ovpraseFloat($(""+i).val());
        }
        return cksshj.toFixed(2);
    }
    //common end
</script>

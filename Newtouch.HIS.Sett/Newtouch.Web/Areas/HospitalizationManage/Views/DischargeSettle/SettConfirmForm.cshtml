<script>
    var medicalInsurance = '';
    var defaultPayMethod = "";
    var SettPayBalance='';
    var sfyxdzzf = '';
    var zyh = $.request("");
    var ryrq = $.request("");
    var cyrq = $.request("");
    var ztjs = $.request("");
    var patid = $.request("");
    if (!!cyrq) {
        cyrq = $.getDate({ date: cyrq });   //Định dạng
    }

    ///Quyết toán giữa chừng
    if (ztjs) {
        //$('').hide();

    }
    var interfaceWithCPOE = '';
    //Số dư tiền tạm ứng
    var yjjye = 0;
    var withYjj = '';
    var yjjzffs = "";
    //Tổng số tiền quyết toán
    var zje = ovpraseFloat($.request(""));
    //Thanh toán khoản phải thu Khoản phải thu khi quyết toán（zje = Có thể báo cáo + Khoản phải thu khi quyết toán + V.v.）
    var orglxjzfys = ovpraseFloat($.request(""));
    //Khi có chiết khấu không bằng original
    var xjzfys = orglxjzfys;    //Khi có chiết khấu sẽ không bằng

    //Liên quan bảo hiểm y tế
    var ybjyFeeReturn;
    var isYbjy = $.request("");
    var brxz = $.request("");
    var brxzmc = $.request("");
    var strdyjylsh = "";//抵用账户流水号，Bảo hiểm y tế Trùng Khánh，为了更新抵用落地表的jsnm
    var xnhjyFeeReturn;
    var isXnhjy = $.request("");
    var cqPatInfo = JSON.parse(sessionStorage.getItem(''));
    var zhdyList = "";
    if (isYbjy == '') {
        ybjyFeeReturn = JSON.parse(sessionStorage.getItem(''));
        if (!!ybjyFeeReturn) {
            if (!medicalInsurance) {
                $.modalAlert("", '');
                $.modalClose();
            }
            if (cqPatInfo.ybVer === "")
	        {
                $('').show();
                $('').remove();
	            var mzjzje = 0.000;//Số tiền cứu trợ dân chính
	            var xjzfje = 0.000;//Số tiền mặt thanh toán bảo hiểm y tế
	            var zfxjzf = 0.000;//Số tiền thanh toán tiền mặt ngoài bảo hiểm y tế

	            //Số tiền mặt thanh toán bảo hiểm y tế
	            xjzfje = ovpraseFloat(ybjyFeeReturn.psn_cash_pay) ;
	            //Số tiền mặt ngoài bảo hiểm y tế
	            zfxjzf = ovpraseFloat(ybjyFeeReturn.his_hisfyze) -
			        ovpraseFloat(ybjyFeeReturn.ybzje);
	            //Tính thanh toán tiền mặt
	            var calc_xjzf = ovpraseFloat(ybjyFeeReturn.psn_cash_pay) +
			        ovpraseFloat(ybjyFeeReturn.his_hisfyze) -
			        ovpraseFloat(ybjyFeeReturn.ybzje);
	            ybjyFeeReturn.calc_xjzf = calc_xjzf;
	            //
	            zje = ovpraseFloat(ybjyFeeReturn.his_hisfyze);
	            orglxjzfys = ovpraseFloat(ybjyFeeReturn.calc_xjzf);
	            xjzfys = orglxjzfys;    //Khi có chiết khấu sẽ không bằng

	            mzjzje = ovpraseFloat(ybjyFeeReturn.maf_pay);
	            !!ybjyFeeReturn.his_hisfyze && $('').html(ovpraseFloat(ybjyFeeReturn.his_hisfyze).toFixed(2));
	            !!ybjyFeeReturn.calc_xjzf && $('').html(ovpraseFloat(ybjyFeeReturn.calc_xjzf).toFixed(2));//Tổng thanh toán tiền mặt
	            !!zfxjzf && $('').html(zfxjzf.toFixed(2));//Thanh toán tiền mặt ngoài bảo hiểm y tế
	            !!xjzfje && $('').html(xjzfje.toFixed(2));//Thanh toán tiền mặt bảo hiểm y tế
	            !!ybjyFeeReturn.acct_pay && $('').html(ovpraseFloat(ybjyFeeReturn.acct_pay).toFixed(2));
	            !!ybjyFeeReturn.hifp_pay && $('').html((ovpraseFloat(ybjyFeeReturn.hifp_pay)));
	            !!ybjyFeeReturn.hifob_pay && $('').html(ovpraseFloat(ybjyFeeReturn.hifob_pay).toFixed(2));
	            !!ybjyFeeReturn.cvlserv_pay && $('').html(ovpraseFloat(ybjyFeeReturn.cvlserv_pay).toFixed(2));

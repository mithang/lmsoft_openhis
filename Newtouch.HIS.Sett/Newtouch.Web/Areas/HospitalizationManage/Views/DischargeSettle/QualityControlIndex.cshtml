@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
    var brzybzType = ((int)EnumZYBZ.Djz).ToString();
    var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}

<div class="rows" style="margin-bottom: 1%;">
    <div class="panel panel-default" style="margin-bottom:0;">
        @*<div class="panel-heading navb-bg">
                Thông tin bệnh nhân nhập viện
            </div>*@
        <table class="form" style="width:96%;">
            <tbody>
                <tr>
                    <th class="formTitle">Số nhập viện：</th>
                    <td class="formValue">
                        <input class="form-control" type="text" id="zyh" value="" style="width:49%;float:left;" />
                        &nbsp;&nbsp; <input type="button" class="btn btn-default btn-md btn-default-color" style="width: 25%;" title="Chọn bệnh nhân nhập viện" id="zy_btnsyy" value="Tra cứu" onclick="GetPatSerarchView();">
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Họ tên：</th>
                    <td class="formValue" colspan="7">
                        <label id="xm"></label><label style="width:15%"></label><span>Tính chất:</span> <label id="brxz"></label>
                        <label style="width:15%"></label> <span>Giới tính:</span> <label id="xb"></label>
                        <label style="width:15%"></label><span>Ngày nhập viện:</span> <label id="ryrq"></label>
                        <label style="width:15%"></label><span>Ngày xuất viện:</span> <label id="cyrq"></label>

                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<div class="gridPanel" style="margin-top:1%">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>

    var $gridList = $(""); 
    $(function () {
        gridListData();

    });

    //Tra cứu bệnh nhân(Nhập viện)
    function GetPatSerarchView() {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + '' + "" + Math.random() + "" + $("").val(),
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
                //Gọi tra cứu số thẻ và số nhập viện
            }//Hàm callback xác nhận khi nhấn cửa sổ
        });
    }

    //Bệnh nhân đã chọn callback
    function getPatInfoAjax(selePatInfo) {
        //Xóa một chút
        newtouch_event_f4();
        //
        patModel = null;
        jszje = 0.00;
        if (selePatInfo && selePatInfo.zyh) {
            $('').val(selePatInfo.zyh);
            ajaxLoadDataResult(selePatInfo.zyh);
            GetPatInfo(selePatInfo.zyh);
        }
        else {
            $('').val('');
        }
    }

    function GetPatInfo(zyh)
    {
        $.ajax({
            type: "",
            url: "",
            data: { zyh: zyh },
            dataType: "",
            cache: false,
            async: false,
            success: function (payoptype) {
                if (payoptype) {
                    cqPatInfo = payoptype;
                }
            }
        });
    }

    //
    var patModel = null;
    //
    var jszje = 0.00;
    var scbz = false;//trueTải lên tất cả false"Tải lên đã chọn

    //Theozyh Thông tin cơ bản bệnh nhân、Thông tin tính phí
    function ajaxLoadDataResult(zyh) {
        $.najax({
            type: "",
            url: "",
            data: { zyh: zyh,jslx: '' },
            dataType: "",
            success: function (ajaxresp) {
                //Thông tin bệnh nhân nhập viện
                patModel = ajaxresp.data.InpatientSettPatInfo;

                //isYbjyjz = openYbSett && patModel.brxz != '' && patModel.CardType == "";

                $('').html(patModel.xm);
                $('').html($.getGender(patModel.xb));
                $('').html($.getGender(patModel.brxz == '' ? '' : ''));
                $('').val(patModel.zybz);
                $("").html(getAgeFromBirthTime({ begin: patModel.csny }).text);
                //$('').html(patModel.ryzdmc);
                $('').html(patModel.cyzd);
                $('').html(patModel.zyts);
                $('').html(patModel.csny ? patModel.csny.substring(0, 10) : '');
                $('').html(patModel.ryrq ? patModel.ryrq.substring(0, 10) : '');
                $('').html(patModel.cyrq ? patModel.cyrq.substring(0, 10) : '');
                if (ajaxresp.data.InpatientSettPatInfo) {
                    //loadJfmxByZyh();
                    bindGridList();
                }
                else {
                    $.modalAlert("", '');
                    return false;
                }
            },
            errorCallback: function (data) {
                newtouch_globalevent_f4();
                $('').trigger('');
            }
        });
    }

    function bindGridList() {
        $gridList.jqGrid('', {
            postData: { zyh: patModel.zyh, sczt: "", jssj: $('').val(), xmmc: $('').val(), cybz: $('').val(), orgId: '' },
            url: "",
        }).trigger('');
    }

    function gridListData() {
        var $gridList = $("");
        var captionCon = "";
        $gridList.dataGrid({
            height: $(window).height() - 80,
            caption: captionCon,
            multiselect: true,
            unwritten: false,
            colModel: [
                {
                    label: '', name: '', align: '', width: 50, key: true },
                {label: '', name: '', align: '', width: 50 },
                { label: '', name: '', align: '', width: 150 },
                { label: '', name: '', align: '', width: 60 },
                { label: '', name: '', align: '', width: 170 },
                { label: '', name: '', align: '', width: 30 },
                { label: '', name: '', align: '', width: 50 },
                { label: '', name: '', align: '', width: 50 },
                { label: '', name: '', align: '', width: 50 },
                { label: '', name: '', align: '', width: 50},
                { label: '', name: '', align: '', width: 50 },
                { label: '', name: '', align: '', width: 50 },
                //{ label: '', name: '', align: '', width: 50 },
               
            ],
            pager: "",
            sortname: '',
            viewrecords: true,
            onSelectAll: function (aRowids, status) {
                scbz = status;
            }
        });
    }


    function newtouch_event_f4() {
        $('').html('');
        $('').html('');
        $('').html('');
        //$('').html('');
        $('').html('');
        $('').html('');
        $('').html('');
        $('').html('');
        $('').html('');
        patModel = null;
        jszje = 0.00;
        scbz = false;
        $('').text('');
        $('').jqGrid("");
    }

</script>
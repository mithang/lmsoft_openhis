
@{
	ViewBag.Title = "";
	Layout = "";
}
@Html.Partial("")

<!-- Hiển thị bảo hiểm y tế Thượng Hải -->
<div id="divCQYbFee" class="panel panel-default" style="margin-top:10px;margin-left:10px;margin-right: 10px;">
	<div class="panel-heading navb-bg" style="height:13px;">
		Thông tin chi phí
	</div>
	<div style="height:auto;">
        <table class="form">
            <tr>
                <th class="formTitle">Tổng chi phí：</th><!--Sử dụng-->
                <td class="formValue">￥<label id="ZFY">0.00</label></td>
                <th class="formTitle">Tổng thanh toán tiền mặt：</th>
                <td class="formValue">￥<label id="XJZF">0.00</label></td>
                <th class="formTitle">Tính phí tiền mặt bảo hiểm y tế：</th><!--Sử dụng-->
                <td class="formValue">￥<label id="YBJF">0.00</label></td>

            </tr>
            <tr>
                <th class="formTitle">Tính phí tiền mặt ngoài bảo hiểm y tế：</th><!--Số tiền không có mã bảo hiểm y tế-->
                <td class="formValue">￥<label id="ZFJF">0.00</label></td>
                <th class="formTitle">当年帐户支付数：</th>
                <td class="formValue">￥<label id="curaccountpay">0.00</label></td>
                <th class="formTitle">历年帐户支付数：</th>
                <td class="formValue">￥<label id="hisaccountpay">0.00</label></td>
            </tr>
            <tr>
                <th class="formTitle">自负段现金支付数：</th>
                <td class="formValue">￥<label id="zfdxjzfs">0.00</label></td>
                <th class="formTitle">自负段历年支付数：</th>
                <td class="formValue">￥<label id="zfdlnzhzfs">0.00</label></td>

                <th class="formTitle">统筹段帐户支付数：</th>
                <td class="formValue">￥<label id="tcdzhzfs">0.00</label></td>
            </tr>
            <tr>
                <th class="formTitle">统筹段现金支付数：</th>
                <td class="formValue">￥<label id="tcdxjzfs">0.00</label></td>
                <th class="formTitle">Số thanh toán chung：</th>
                <td class="formValue">￥<label id="tczfs">0.00</label></td>
                <th class="formTitle">附加段帐户支付数：</th>
                <td class="formValue">￥<label id="fjdzhzfs">0.00</label></td>
            </tr>
            <tr>
                <th class="formTitle">附加段现金支付数：</th>
                <td class="formValue">￥<label id="fjdxjzfs">0.00</label></td>
                <th class="formTitle">附加支付数：</th>
                <td class="formValue">￥<label id="fjzfs">0.00</label></td>
                <th class="formTitle">当年帐户余额：</th>
                <td class="formValue">￥<label id="curaccountamt">0.00</label></td>
            </tr>
            <tr>
                <th class="formTitle">历年帐户余额：</th>
                <td class="formValue">￥<label id="hisaccountamt">0.00</label></td>
                <th class="formTitle">附加段共济账户支付：</th>
                <td class="formValue">￥<label id="fjdgjzhzfs">0.00</label></td>
                <th class="formTitle">起付段共济账户支付：</th>
                <td class="formValue">￥<label id="qfdgjzhzfs">0.00</label></td>
                @*
                <th class="formTitle">医保结算范围总额：</th>
                <td class="formValue">￥<label id="ybjsfwfyze">0.00</label></td>
                <th class="formTitle">非医保结算范围总额：</th>
                <td class="formValue">￥<label id="fybjsfwfyze">0.00</label></td>*@

            </tr>
            <tr>
                <th class="formTitle">统筹段共济账户支付：</th>
                <td class="formValue">￥<label id="tcdgjzhzfs">0.00</label></td>
                <th class="formTitle">预结算账户余额：</th>
                <td class="formValue">￥<label id="yjs">0.00</label></td>
                @*
                <th class="formTitle">自费段共济账户支付：</th>
                <td class="formValue">￥<label id="zfdgjzhzfs">0.00</label></td>*@

            </tr>
        </table>
	</div>
</div>
@Html.Partial("")



<script type="">
    var ybjyFeeReturn;
    var hisfyze = $.request("");
    var zhye = $.request("");
	$(function () {
		init();
	});

    function init() {
        debugger; 
        ybjyFeeReturn = JSON.parse(sessionStorage.getItem(''));
        ybjyFeeReturn = ybjyFeeReturn.xxnr;
		if (!!ybjyFeeReturn) {
		    var xjzfje = 0.000;//Số tiền mặt thanh toán bảo hiểm y tế
		    var zfxjzf = 0.000;//Số tiền thanh toán tiền mặt ngoài bảo hiểm y tế
		    var yjs = 0.000;//Số dư tài khoản sau tiền tạm ứng
		    //Số tiền mặt thanh toán bảo hiểm y tế
		    xjzfje = ovpraseFloat(ybjyFeeReturn.qfdxjzfs) + ovpraseFloat(ybjyFeeReturn.tcdxjzfs)
                + ovpraseFloat(ybjyFeeReturn.fjdxjzfs);
		    //Số tiền mặt ngoài bảo hiểm y tế
		    zfxjzf = ovpraseFloat(hisfyze) -
				ovpraseFloat(ybjyFeeReturn.ybjsfwfyze);
		    //Tính thanh toán tiền mặt
		    var calc_xjzf = ovpraseFloat(zfxjzf) +
				ovpraseFloat(xjzfje) ;
		    ybjyFeeReturn.calc_xjzf = calc_xjzf;

		    orglxjzfys = ovpraseFloat(ybjyFeeReturn.calc_xjzf);
		    xjzfys = orglxjzfys;    //Khi có chiết khấu sẽ không bằng

		    yjs = calc_xjzf - zhye;//Tính số dư tài khoản sau tiền tạm ứng

		    !!hisfyze && $('').html(ovpraseFloat(hisfyze).toFixed(2));
		    !!ybjyFeeReturn.calc_xjzf && $('').html(ovpraseFloat(ybjyFeeReturn.calc_xjzf).toFixed(2));//Tổng thanh toán tiền mặt
		    !!zfxjzf && $('').html(zfxjzf.toFixed(2));//Thanh toán tiền mặt ngoài bảo hiểm y tế
		    !!xjzfje && $('').html(xjzfje.toFixed(2));//Thanh toán tiền mặt bảo hiểm y tế

		    !!ybjyFeeReturn.curaccountpay && $('').html(ovpraseFloat(ybjyFeeReturn.curaccountpay).toFixed(2));
		    !!ybjyFeeReturn.hisaccountpay && $('').html(ovpraseFloat(ybjyFeeReturn.hisaccountpay).toFixed(2));
		    !!ybjyFeeReturn.zfdxjzfs && $('').html(ovpraseFloat(ybjyFeeReturn.zfdxjzfs).toFixed(2));
		    !!ybjyFeeReturn.zfdlnzhzfs && $('').html(ovpraseFloat(ybjyFeeReturn.zfdlnzhzfs).toFixed(2));

		    !!ybjyFeeReturn.tcdzhzfs && $('').html(ovpraseFloat(ybjyFeeReturn.tcdzhzfs).toFixed(2));
		    !!ybjyFeeReturn.tcdxjzfs && $('').html((ovpraseFloat(ybjyFeeReturn.tcdxjzfs)));
		    !!ybjyFeeReturn.tczfs && $('').html(ovpraseFloat(ybjyFeeReturn.tczfs).toFixed(2));
		    !!ybjyFeeReturn.fjdzhzfs && $('').html(ovpraseFloat(ybjyFeeReturn.fjdzhzfs).toFixed(2));
		    !!ybjyFeeReturn.fjdxjzfs && $('').html(ovpraseFloat(ybjyFeeReturn.fjdxjzfs).toFixed(2));

		    !!ybjyFeeReturn.fjzfs && $('').html(ovpraseFloat(ybjyFeeReturn.fjzfs).toFixed(2));

		    !!ybjyFeeReturn.curaccountamt && $('').html(ovpraseFloat(ybjyFeeReturn.curaccountamt).toFixed(2));
		    !!ybjyFeeReturn.hisaccountamt && $('').html(ovpraseFloat(ybjyFeeReturn.hisaccountamt).toFixed(2));
		    !!ybjyFeeReturn.ybjsfwfyze && $('').html(ovpraseFloat(ybjyFeeReturn.ybjsfwfyze).toFixed(2));
		    !!ybjyFeeReturn.fybjsfwfyze && $('').html(ovpraseFloat(ybjyFeeReturn.fybjsfwfyze).toFixed(2));
		    //共济账户
		    !!ybjyFeeReturn.fjdgjzhzfs && $('').html(ovpraseFloat(ybjyFeeReturn.fjdgjzhzfs).toFixed(2));
		    //!!ybjyFeeReturn.zfdgjzhzfs && $('').html(ovpraseFloat(ybjyFeeReturn.zfdgjzhzfs).toFixed(2));
		    !!ybjyFeeReturn.qfdgjzhzfs && $('').html(ovpraseFloat(ybjyFeeReturn.qfdgjzhzfs).toFixed(2));
		    !!ybjyFeeReturn.tcdgjzhzfs && $('').html(ovpraseFloat(ybjyFeeReturn.tcdgjzhzfs).toFixed(2));
		}
		else {
			$.modalAlert("", "");
		}
	}
	function ovpraseFloat(val) {
		if (!val) {
			val = 0;
		}
		return parseFloat(val);
	}
</script>

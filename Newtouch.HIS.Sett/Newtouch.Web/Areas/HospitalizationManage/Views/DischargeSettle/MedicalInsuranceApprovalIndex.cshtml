@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "MedicalInsuranceApprovalIndex";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<style>
    .editable {
        width: 70% !important;
    }
</style>
<div class="rows" style="margin-bottom: 1%;">
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading navb-bg">
            Thông tin bệnh nhân nội trú
        </div>
        <table class="form" style="width:96%;">
            <tbody>
                <tr>
                    <th class="formTitle">Số nhập viện：</th>
                    <td class="formValue">
                        <input class="form-control" type="text" id="zyh" value="" />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-default btn-md btn-default-color" title="Chọn bệnh nhân nội trú" style="" id="zy_btnsyy" value="Tra cứu" onclick="GetPatSerarchView();">
                    </td>
                    <th class="formTitle">
                        Ngày：
                    </th>
                    <td class="formValue">
                        <input id="searchTime" style="min-width:100px" type="text" class="form-control input-wdatepicker form-an"
                               onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', onpicked: function () {} })" value="@(System.DateTime.Now.ToString("yyyy-MM-dd"))" />

                    </td>
                    <th class="formTitle">
                        Chẩn đoán xuất viện：
                    </th>
                    <td class="formValue">
                        <label id="cyzd"></label>
                    </td>
                    <td class="formValue">
                        <input type="button" id="btn_search" class="btn btn-primary" style="float: right;margin-right: 10px;" value="Tra cứu" />
                    </td>

                </tr>
            </tbody>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>
@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 4, 6 },
    F6Text = "Phê duyệt"
})
<script type="text/javascript">
    var zyh;
    $(function () {
        initgridList();
    });

    $("#btn_search").click(function () {
        if (!zyh) {
            $.modalAlert("Vui lòng chọn bệnh nhân", 'warning');
            return;
        }
        $("#gridList").jqGrid('setGridParam', {
            url: "@Url.Action("GetCurrentpatientcharge")",
            postData: { zyh: zyh },
        }).trigger('reloadGrid');
    })

    function initgridList() {
        $('#gridList').dataGrid({
            unwritten: false,
            viewrecords: true,
            height: $(window).height() - 175,
            sortable: false,
            colModel: [
                { label: "jfbbh", name: "jfbbh", hidden: true, key: true },
                { label: "Khoản mục thu phí", name: "sfxmmc", width: 180 },
                { label: "Loại lớn", name: "dlmc", width: 80 },
                { label: "Mã bảo hiểm y tế", name: "ybbm", width: 80 },
                {
                    label: "Thời gian xuất", name: "CreateTime", width: 130,
                    formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }
                },
                { label: "Đơn vị", name: "dw", width: 50 },
                { label: "Đơn giá", name: "dj", width: 60 },
                {
                    label: "Số lượng", name: "sl", width: 60, align: "left", formatter: "number"
                    , formatoptions: { decimalPlaces: 2, defaultValue: '0.00' }
                },
                {
                    label: "Tổng số tiền", name: "je", width: 60, align: "left", formatter: "number"
                    , formatoptions: { decimalPlaces: 2, defaultValue: '0.00' }
                },
            ]
        });
    }

    function newtouch_event_f4() {
        $('#gridList').jqGrid("clearGridData");//Xóa chi tiết trước
        $('#zyh').val('');
        $('#searchTime').val('');
    }

    function newtouch_event_f6() {
        $.modalOpen({
            id: "ApprovalSearch",
            title: "Tra cứu phê duyệt",
            url: "/HospitalizationManage/DischargeSettle/MedicalInsuranceApproval?zyh=" + zyh + "&searchTime=" + $('#searchTime').val(),
            width: "700px",
            height: "500px",
            btn: ['Phê duyệt', 'Đóng'],
            callBack: function (iframeId) {
                top.frames[iframeId].submitform();
                //top.frames[iframeId].$.modalClose(); //Trong sự kiện cửa sổ bật lên
            }
        });
    }

    function GetPatSerarchView() {
        $.modalOpen({
            id: "patSearch",
            title: "Tra cứu bệnh nhân",
            url: "/PatientManage/AccountManage/PatSearchView?brzybzType=" + '@((int)EnumZYBZ.Bqz + "," + (int)EnumZYBZ.Djz)' + "&t=" + Math.random() + "&zyh=" + zyh,
            width: "700px",
            height: "600px",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
                //Gọi tra cứu số thẻ và số nhập viện
            }//Hàm callback khi nhấn xác định tại cửa sổ
        })
    };

    //Bệnh nhân đã chọn callback
    function getPatInfoAjax(selePatInfo) {
        if (selePatInfo && selePatInfo.zyh) {
            zyh = selePatInfo.zyh;
            $('#zyh').val(selePatInfo.zyh);
            $.najax({
                type: "POST",
                url: "/HospitalizationManage/DischargeSettle/GetCYZD",
                data: { zyh: selePatInfo.zyh},
                dataType: "json",
                success: function (ajaxresp) {
                    if (ajaxresp.data) {
                        var zdmc = ajaxresp.data;
                        $('#cyzd').html(zdmc);
                        $("#btn_search").trigger("click");
                    }
                },
                errorCallback: function () {
                    newtouch_globalevent_f4();
                    $('#zyh').trigger('focus');
                }
            });
        }
        else {
            $('#zyh').val('');
        }
    }

</script>
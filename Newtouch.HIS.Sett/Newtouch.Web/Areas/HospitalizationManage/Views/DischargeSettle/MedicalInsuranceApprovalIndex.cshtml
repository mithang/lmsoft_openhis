@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
}

<style>
    .editable {
        width: 70% !important;
    }
</style>
<div class="rows" style="margin-bottom: 1%;">
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading navb-bg">
            Thông tin bệnh nhân nhập viện
        </div>
        <table class="form" style="width:96%;">
            <tbody>
                <tr>
                    <th class="formTitle">Số nhập viện：</th>
                    <td class="formValue">
                        <input class="form-control" type="text" id="zyh" value="" />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-default btn-md btn-default-color" title="Chọn bệnh nhân nhập viện" style="" id="zy_btnsyy" value="Tra cứu" onclick="GetPatSerarchView();">
                    </td>
                    <th class="formTitle">
                        Ngày：
                    </th>
                    <td class="formValue">
                        <input id="searchTime" style="min-width:100px" type="text" class="form-control input-wdatepicker form-an"
                               onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', onpicked: function () {} })" value="@(System.DateTime.Now.ToString("yyyy-MM-dd"))" />

                    </td>
                    <th class="formTitle">
                        Chẩn đoán xuất viện：
                    </th>
                    <td class="formValue">
                        <label id="cyzd"></label>
                    </td>
                    <td class="formValue">
                        <input type="button" id="btn_search" class="btn btn-primary" style="float: right;margin-right: 10px;" value="Tra cứu" />
                    </td>

                </tr>
            </tbody>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>
@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 4, 6 },
    F6Text = ""
})
<script type="">
    var zyh;
    $(function () {
        initgridList();
    });

    $("").click(function () {
        if (!zyh) {
            $.modalAlert("", '');
            return;
        }
        $("").jqGrid('', {
            url: ""GetCurrentpatientcharge"",
            postData: { zyh: zyh },
        }).trigger('');
    })

    function initgridList() {
        $('').dataGrid({
            unwritten: false,
            viewrecords: true,
            height: $(window).height() - 175,
            sortable: false,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: "", name: "", width: 180 },
                { label: "", name: "", width: 80 },
                { label: "", name: "", width: 80 },
                {
                    label: "", name: "", width: 130,
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                { label: "", name: "", width: 50 },
                { label: "", name: "", width: 60 },
                {
                    label: "", name: "", width: 60, align: "", formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }
                },
                {
                    label: "", name: "", width: 60, align: "", formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }
                },
            ]
        });
    }

    function newtouch_event_f4() {
        $('').jqGrid("");//Xóa trống chi tiết trước
        $('').val('');
        $('').val('');
    }

    function newtouch_event_f6() {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + zyh + "" + $('').val(),
            width: "",
            height: "",
            btn: ['', ''],
            callBack: function (iframeId) {
                top.frames[iframeId].submitform();
                //top.frames[iframeId].$.modalClose(); //Trong sự kiện cửa sổ bật lên
            }
        });
    }

    function GetPatSerarchView() {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + '' + "" + Math.random() + "" + zyh,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
                //Gọi tra cứu số thẻ và số nhập viện
            }//Hàm callback xác nhận khi nhấn cửa sổ
        })
    };

    //Bệnh nhân đã chọn callback
    function getPatInfoAjax(selePatInfo) {
        if (selePatInfo && selePatInfo.zyh) {
            zyh = selePatInfo.zyh;
            $('').val(selePatInfo.zyh);
            $.najax({
                type: "",
                url: "",
                data: { zyh: selePatInfo.zyh},
                dataType: "",
                success: function (ajaxresp) {
                    if (ajaxresp.data) {
                        var zdmc = ajaxresp.data;
                        $('').html(zdmc);
                        $("").trigger("");
                    }
                },
                errorCallback: function () {
                    newtouch_globalevent_f4();
                    $('').trigger('');
                }
            });
        }
        else {
            $('').val('');
        }
    }

</script>
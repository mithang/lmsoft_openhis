    //Quyết toán nội trú
    function realSettle(gzyb_CyblOut, ybRealSettleReq) {
        var ybjyPreSettReturn;// = $.guianyibao.ZyFeejs(JSON.stringify(ybPreSettleReq));
        $.ajax({
            type: "POST",
            url: "http://127.0.0.1:12345/api/YiBao/ZyFeejs",
            contentType: 'application/json',
            data: JSON.stringify(ybRealSettleReq),
            dataType: "json",
            async: false,
            success: function (data) {
                ybjyPreSettReturn = eval('(' + data + ')');
            }
        });
        //
        $.loading(false);
        if (ybjyPreSettReturn.Code == 0) {
            var ybReturnData = ybjyPreSettReturn.Data;
            ybReturnData.astr_jylsh = ybjyPreSettReturn.jylsh;
            ybReturnData.astr_jyyzm = ybjyPreSettReturn.jyyzm;
            //his Xác nhận quyết toán（Bao gồm xác nhận quyết toán bảo hiểm y tế）
            //Lắp ráp tham số yêu cầu
            ybReturnData.prm_akc190 = ybRealSettleReq.prm_akc190,
                ybReturnData.prm_yab003 = ybRealSettleReq.prm_yab003,
                ybReturnData.prm_aka130 = ybRealSettleReq.prm_aka130,
                ybReturnData.prm_ykb065 = ybRealSettleReq.prm_ykb065,
                ybReturnData.prm_hisfyze = ybRealSettleReq.prm_hisfyze,
                ybReturnData.prm_yka110 = ybRealSettleReq.prm_yka110,
                ybReturnData.prm_aae013 = ybRealSettleReq.prm_aae013,
                ybReturnData.prm_aae011 = ybRealSettleReq.prm_aae011,
                ybReturnData.prm_ykc141 = ybRealSettleReq.prm_ykc141,
                //
                ybReturnData.his_hisfyze = jszje,
                //
                ybReturnData.cyblastr_jylsh = gzyb_CyblOut.jylsh,
                ybReturnData.cyblastr_jyyzm = gzyb_CyblOut.jyyzm,
                hisSubmit(true, ybReturnData,false,null);
        }
        else {
            var ybReturn;
            var cyblhtData = {
                prm_akc190: ybRealSettleReq.prm_akc190,
                prm_aac001: ybRealSettleReq.prm_aac001,
                prm_yab003: ybRealSettleReq.prm_yab003,
                prm_aka130: ybRealSettleReq.prm_aka130,
                prm_aae036: "",
                prm_ykb065: ybRealSettleReq.prm_ykb065,
                prm_ykc141: "ly"
            };
            $.ajax({
                type: "POST",
                url: "http://127.0.0.1:12345/api/YiBao/ZyCyblht",
                contentType: 'application/json',
                data: JSON.stringify(cyblhtData),
                dataType: "json",
                async: false,
                success: function (data) {
                    ybReturn = eval('(' + data + ')');
                }
            });
            if (ybReturn.Code == 0) {
                var parameter = { "astr_jylsh": ybReturn.jylsh, "astr_jyyzm": ybReturn.jyyzm };
                $.ajax({
                    url: "http://127.0.0.1:12345/api/YiBao/YibaoConfirm",
                    data: parameter,
                    dataType: "json",
                    async: false,
                    success: function (data) {
                    }
                });
            }
            $.modalAlert(ybjyPreSettReturn.ErrorMsg, 'error');
            return;
        }
    }

    //Dự quyết toán bảo hiểm y tế
    function preSettle(ybPreSettleReq, funcSuccCallback) {
        //Dự quyết toán
        var ybReturn;
        var mnjsData = {
            prm_akc190: ybPreSettleReq.prm_akc190,
            prm_aac001: ybPreSettleReq.prm_aac001,
            prm_yab003: ybPreSettleReq.prm_yab003,
            prm_aka130: ybPreSettleReq.prm_aka130,
            prm_ykb065: ybPreSettleReq.prm_ykb065,
            prm_hisfyze: ybPreSettleReq.prm_hisfyze //Dùng tổng chi phí phần bảo hiểm y tế（Không bao gồm phần hoàn toàn tự trả không giao dịch với bảo hiểm y tế）
        };
        $.ajax({
            type: "POST",
            url: "http://127.0.0.1:12345/api/YiBao/ZyMnjs",
            contentType: 'application/json',
            data: JSON.stringify(mnjsData),
            dataType: "json",
            async: false,
            success: function (data) {
                ybReturn = eval('(' + data + ')');
            }
        });
        $.loading(false);
        if (ybReturn && ybReturn.Code==0) {
            setTimeout(function () {
                funcSuccCallback();
            }, 50);
        }
        else {
            $.loading(false);
            $.modalAlert(ybReturn.ErrorMsg, 'error');
            return;
        }
    }

    //Thao tác làm thủ tục xuất viện bảo hiểm y tế Quý Châu-Số nhập viện
    function gzyb_Cybl(funcSuccCallback) {
        if (!patModel.cyrq) {
            $.loading(false);
            $.modalAlert("Ngày xuất viện trống", 'error');
            return;
        }
        var isSuccess = false;
        var gzyb_CyblOut;
        $.najax({
            url: "/PatientManage/HospiterRes/GetGuianRyblOutInfoByZyh",
            data: { zyh: patModel.zyh },
            dataType: 'json',
            async: false,
            success: function (rep) {
                if (rep) {
                    var gzyb_Cybl = new Object();
                    gzyb_Cybl.prm_akc190 = rep.prm_akc190; //Mã khám bệnh
                    gzyb_Cybl.prm_aac001 = rep.prm_aac001; //Số thẻ
                    gzyb_Cybl.prm_aka130 = rep.prm_aka130; //Loại thanh toán
                    gzyb_Cybl.prm_akc195 = "9"; //Nguyên nhân xuất viện (1、Khỏi bệnh；2、Đỡ hơn；3、Tử vong；4 Chuyển viện;5 Quyết toán giữa chừng cho bệnh tâm thần(Chỉ sử dụng cho quyết toán giữa chừng bao khoán theo ngày của bệnh tâm thần);9 Khác)
                    gzyb_Cybl.prm_akc194 = patModel.cyrq.replace('T', ' '); //Ngày xuất viện
                    gzyb_Cybl.prm_akc196 = patModel.cyzdicd10; //Chẩn đoán xuất viện
                    gzyb_Cybl.prm_ykc015 = patModel.ksmc; //Khoa xuất viện(Khoa là tiếng Trung,không thể là mã)
                    gzyb_Cybl.prm_ykc016 = patModel.cw; //Giường xuất viện
                    gzyb_Cybl.prm_ykc017 = '@(opr.UserName)'; //Tên người thực hiện
                    //gzyb_Cybl.prm_ykc018 = curTime; //Thời gian thực hiện xuất viện
                    gzyb_Cybl.prm_ykc018 = $.getTime(); //Thời gian thực hiện xuất viện
                    $.najax({
                        url: "/Com/GetSysNowDate",
                        data: { format: "yyyy-MM-dd HH:mm:ss" },
                        dataType: 'text',
                        async: false,
                        success: function (strTime) {
                            gzyb_Cybl.prm_ykc018 = strTime; //Thời gian thực hiện xuất viện
                        }
                    });
                    gzyb_Cybl.prm_yab003 = rep.prm_yab003; //Mã trung tâm phân
                    gzyb_Cybl.prm_ykd065 = ""; //Mã chẩn đoán phụ khi xuất viện
                    gzyb_Cybl.prm_ykd018 = ""; //Mã chẩn đoán bệnh xuất viện thứ nhất
                    gzyb_Cybl.prm_ykd019 = ""; //Mã chẩn đoán bệnh xuất viện thứ hai
                    gzyb_Cybl.prm_ykd020 = ""; //Mã chẩn đoán bệnh xuất viện thứ ba
                    gzyb_Cybl.prm_ykd021 = ""; //Mã chẩn đoán bệnh xuất viện thứ tư
                    gzyb_Cybl.prm_ykd022 = ""; //Mã chẩn đoán bệnh xuất viện thứ năm
                    gzyb_Cybl.prm_ykd023 = ""; //Mã chẩn đoán bệnh xuất viện thứ sáu
                    gzyb_Cybl.prm_ykd024 = ""; //Mã chẩn đoán bệnh xuất viện thứ bảy
                    gzyb_Cybl.prm_ykd025 = ""; //Mã chẩn đoán bệnh xuất viện thứ tám
                    gzyb_Cybl.prm_ykb065 = rep.prm_ykb065; //Biện pháp bảo hiểm xã hội
                   // var gzyb_CyblOut;// = $.guianyibao.ZyCybl(JSON.stringify(gzyb_Cybl)); //Gọi giao diện làm thủ tục xuất viện
                    $.ajax({
                        type: "POST",
                        url: "http://127.0.0.1:12345/api/YiBao/ZyCybl",
                        contentType: 'application/json',
                        data: JSON.stringify(gzyb_Cybl),
                        dataType: "json",
                        async: false,
                        success: function (data) {
                            gzyb_CyblOut = eval('(' + data + ')');
                        }
                    });
                    if (gzyb_CyblOut) {
                        if (gzyb_CyblOut.Code != 0) {
                            $.loading(false);
                            $.modalAlert("Làm thủ tục xuất viện bảo hiểm y tế thất bại：" + gzyb_CyblOut.ErrorMsg, 'error');
                            return;
                        }
                        else{
                            isSuccess = true;
                        }
                    } else {
                        $.loading(false);
                        $.modalAlert("Lấy thông tin phản hồi làm thủ tục xuất viện bảo hiểm y tế thất bại", 'error');
                        return;
                    }
                } else {
                    $.loading(false);
                    $.modalAlert("Không thể lấy thông tin bảo hiểm y tế làm thủ tục nhập viện", 'error');
                    return;
                }
            }
        });

        $.loading(false);
        //
        if (isSuccess && funcSuccCallback) {
            setTimeout(function () {
                funcSuccCallback(gzyb_CyblOut);
            }, 50);
        }
    }
</script>

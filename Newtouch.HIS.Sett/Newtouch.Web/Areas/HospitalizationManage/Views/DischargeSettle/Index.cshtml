    function GetSelectedpatient(obj) {
        if (!!obj) {
            obj.readCardCardType = $('').val();
            $.ajax({
                type: "",
                url: ""GetZyhByGrbm"",
                data: { xnhgrbm: obj.xnhgrbm, sfjs: "" },
            dataType: "",
                async: false,
                success: function (resp) {
                    if (!!resp.data) {
                        ajaxLoadDataResult({ zyh: resp.data });

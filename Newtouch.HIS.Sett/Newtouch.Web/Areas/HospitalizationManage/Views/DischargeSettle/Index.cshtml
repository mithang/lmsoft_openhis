        var fph = "";

        $.ajax({
            type: "",
            url: "" + Math.random(),
            data: {},
            dataType: "",
            async: false,
            success: function (data) {
                if (!!!data) {
                    msg = "";
                    return;
                }
                if (data.indexOf("") >= 0 || data.indexOf("") >= 0) {
                    msg = "" + data;
                    return;
                }
                rs = true;
                fph = data;
            },
            error: function (request, error, ex) {
                msg = "" + ex + "";
            }
        });

        return { rs: rs, fph: fph, msg: msg };
    }


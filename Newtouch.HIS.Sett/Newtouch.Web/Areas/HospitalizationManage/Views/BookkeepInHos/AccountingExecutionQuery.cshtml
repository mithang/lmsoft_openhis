
@{
    ViewBag.Title = "";
    Layout = "";

    var reqFrom = HttpContext.Current.Request.QueryString[""];
}

<form name="form1">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle">Hủy trạng thái：</th>
                    <td class="formValue">
                        <select id="cxzt" name="cxzt" class="form-control">
                            <option value="">==Tất cả==</option>
                            <option value="0">Đã hủy</option>
                            <option value="1">Bình thường</option>
                        </select>
                    </td>
                    @if (!(reqFrom == ""))
                    {
                        <th class="formTitle">Trạng thái thu phí：</th>
                        <td class="formValue">
                            <select id="sfzt" name="sfzt" class="form-control">
                                <option value="">==Tất cả==</option>
                                <option value="0">Chưa thu phí</option>
                                <option value="1">Đã thu phí</option>
                            </select>
                        </td>
                    }
                    <th class="formTitle">Nhà trị liệu：</th>
                    <td class="formValue">
                        <select id="zls" name="zls" class="form-control">
                            <option value="">==Tất cả==</option>
                        </select>
                    </td>
                    <th class="formTitle">Từ khóa：</th>
                    <td class="formValue" style="width:145px;">
                        <input type="text" style="width:145px;" class="form-control" id="keyword" placeholder="" />
                    </td>
                    @if (reqFrom == "")
                    {
                        <th class="formTitle">Thời gian thao tác：</th>
                        <td class="formValue" colspan="2">
                            <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; float:left;" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                            <span style="margin-left:1%;float:left">—</span>
                            <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:43%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        </td>
                        <td class="formValue">
                            <input type="button" id="btn_search" class="btn btn-primary" style="width:36%;margin-left: 10%;" value="Tra cứu" />
                        </td>
                    }
                </tr>
                @if (!(reqFrom == ""))
                {
                    <tr>
                        <th class="formTitle">Thời gian thao tác：</th>
                        <td class="formValue" colspan="2">
                            <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; float:left;" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                            <span style="margin-left:1%;float:left">—</span>
                            <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:43%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        </td>
                        <td class="formValue">
                            <input type="button" id="btn_search" class="btn btn-primary" style="width:36%;margin-left: 10%;" value="Tra cứu" />
                        </td>
                    </tr>
                }
            </table>
        </div>
    </div>
    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>
@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 9 },
    F9Text = "",
})
<script>
    var from = $.request("");
    if (!!!from) {
        from = "";
    }
    if (from === '') {
        $('').attr('', '');
    }
    else {
        $('').attr('', '');
    }

    $(function () {
        $("").bindSelect({
            url: "" + "",
            id: "",
            text: ""
        });

        //Hủy trạng thái Tự động kích hoạt tra cứu
        $('').change(function () {
            $('').trigger('');
        });

        //Trạng thái thu phí Tự động kích hoạt tra cứu
        $('').change(function () {
            $('').trigger('');
        });

        //治疗师切换 Tự động kích hoạt tra cứu
        $('').change(function () {
            $('').trigger('');
        });

        gridList();
    });

    //Chi tiết
    var gridOptins = {
        url: "",
        postData: getSearchPostData(),
        height: $(window).height() - (from == "" ? 200 : 225),
        colModel: [
        { label: "", name: "", width: 100, align: "", hidden: true },
        { label: "", name: "", width: 80, align: "" },
        {
            label: "", name: "", width: 40, align: "",
            formatter: function (cellvalue, a, b) {
                if (cellvalue == '') {
                    return ""
                }
                else {
                    return "";
                }
            }
        },
        {
            label: "", name: "", width: 60, align: "",
            hidden: (from == "" ? true : undefined),
            formatter: function (cellvalue) {
                if (cellvalue == '') {
                    return ""
                }
                else if (cellvalue == '') {
                    return "";
                }
                return "";
            }
        },
        { label: "", name: "", width: 70, align: "" },
        { label: "", name: "", width: 70, align: "" },
        { label: (from == "" ? "" : ""), name: "", width: (from == "" ? 100 : 70), align: "" },
        {
            label: "", name: "", width: 60, align: "",
            formatter: function (cellvalue) {
                return $.itemDetails.getNameByCode("", cellvalue);
            }
        },
        { label: "", name: "", width: 180, align: "" },
        { label: "", name: "", width: 40, align: "" },
        { label: "", name: "", width: 40, align: "" },
        { label: "", name: "", width: 50, align: "" },
        {
            label: "", name: "", width: 55, align: "", formatter: ""
                , formatoptions: { decimalPlaces: 2, defaultValue: '' }
        },
        {
            label: "", name: "", width: 60, align: "",
            formatter: function (cellvalue) {
                return $.enum.getDescByValue("", cellvalue);
            }
        },
        {
            label: "", name: "", width: 55, align: "", formatter: ""
                , formatoptions: { decimalPlaces: 2, defaultValue: '' }
        },
        {
            label: "", name: "", width: 80, align: "",
            formatter: "", formatoptions: { srcformat: '', newformat: '' }
            }, {label: "", name: "", width: 120, align: ""},
        {
            label: "", name: "", width: 120, align: "",
            formatter: "", formatoptions: { srcformat: '', newformat: '' }
        },
        ],
        //multiselect: true,
        pager: "",
        sortname: '',
        viewrecords: true,
        gridComplete: function () {
            var ids = $("").getDataIDs();
            for (i = 0; i < ids.length; i++) {
                var rowData = $("").getRowData(ids[i]);
                if (rowData && rowData.zt) {
                    if (rowData.zt == "") {
                        $("" + ids[i]).find("").addClass('');
                    }
                }
            }
        },
    };
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid(gridOptins);
        $("").click(function () {
            if ($('').val() && $('').val() && ($('').val() > $('').val())) {
                $.modalAlert("", '');
                return;
            }
            $gridList.jqGrid('',
                {
                    postData: getSearchPostData(),
                    page: 1,
                    url: ""
                }).trigger('');
        });
    }
    //Điều kiện tra cứu
    function getSearchPostData() {
        var keyword = $("").val();
        var kssj = $("").val();
        var jssj = $("").val();
        var zls = $("").val();
        var cxzt = $("").val();
        var sfzt = $("").val();
        return { keyword: keyword, kssj: kssj, jssj: jssj, zls: zls, cxzt: cxzt, sfzt: sfzt, from: from };
    };

    //XuấtExcel Cột
    var exportCols = null;
    function newtouch_event_f9() {
        exportCols = new Array();
        var colsChooseSourceArr = new Array();
        $.each(gridOptins.colModel, function () {
            if (!(this.hidden === true)) {
                exportCols.push({ Heading: this.label, Name: this.name, Width: this.width });
                colsChooseSourceArr.push({ Heading: this.label, Name: this.name });
            }
        });
        var url = "";
        var cols = JSON.stringify(colsChooseSourceArr);
        cols = encodeURIComponent(cols);
        url += "" + cols;
        $.modalOpen({
            id: "",
            title: "",
            url: url,
            width: "",
            height: "",
            callBack: function (iframeId) {
                //Kết quả
                var restArr = top.frames[iframeId].GetChoosedCols();
                if (!!!restArr || !!!restArr.length || restArr.length == 0) {
                    $.modalAlert("", '');
                    return false;
                }
                var isContainFilter = top.frames[iframeId].GetIsContainFilter();
                //Đóng cửa sổ chọn
                $.modalClose("");
                //
                exportCols = $.jsonWhere(exportCols, function (v) {
                    var matched = false;
                    for (var iIndex = 0; iIndex < restArr.length; iIndex++) {
                        if (restArr[iIndex] == v.Name) {
                            matched = true;
                        }
                    }
                    return matched;
                });
                //Xuất
                Export(isContainFilter);
            }
        });
    }

    function Export(isContainFilter) {
        var url = "" + Math.random();
        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + from;
        url += "" + isContainFilter;
        url += "" + "";  //列宽度标准列
        var cols = JSON.stringify(exportCols);
        top.$.cookie('', cols, { path: "" });
        //url += "" + encodeURIComponent(cols);

        window.open(url);
    }

</script>
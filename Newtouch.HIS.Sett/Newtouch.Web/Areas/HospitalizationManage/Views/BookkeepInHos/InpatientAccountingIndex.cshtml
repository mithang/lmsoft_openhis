@{
    ViewBag.Title = "";
    Layout = "";

    var zyjzDjEditable = (ViewBag.zyjz_dj_editable as bool?) ?? false;
}

<div class="rows" style="margin-bottom: 1%;">
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading navb-bg">
            Thông tin bệnh nhân nhập viện
        </div>
        <table class="form" style="width:96%;">
            <tbody>
                <tr>
                    <th class="formTitle">Số nhập viện：</th>
                    <td class="formValue" colspan="2">
                        <input class="form-control form-control-focus" type="text" id="zyh" value="" style="width:49%;float:left;" />
                        &nbsp;&nbsp;<input type="button" class="btn btn-default btn-md btn-default-color" title="Chọn bệnh nhân nhập viện" style="width: 17%;" id="btnsyy" value="Tra cứu" onclick="GetPatSerarchView($('#zyh').val());">
                    </td>
                    <td class="formValue">
                        <input type="button" id="btn_search" class="btn btn-primary btn-md" value="&nbsp;&nbsp;查&nbsp;&nbsp;询&nbsp;&nbsp;">
                    </td>
                    <th class="formTitle">Họ tên：</th>
                    <td class="formValue">
                        <label id="xm"></label>
                    </td>
                    <th class="formTitle">Giới tính：</th>
                    <td class="formValue">
                        <label id="xb"></label>
                    </td>
                    <th class="formTitle">Tuổi：</th>
                    <td class="formValue">
                        <label id="nlshow"></label>
                    </td>
                    <th class="formTitle">Số giấy tờ：</th>
                    <td class="formValue">
                        <label id="zjh"></label>
                    </td>
                </tr>
            </tbody>
            <tbody class="dispTbody" style="display:none;">
                <tr>
                    <th class="formTitle">Chẩn đoán nhập viện：</th>
                    <td class="formValue" colspan="2">
                        <label id="ryzd"></label>
                    </td>
                    <th class="formTitle">Số điện thoại di động：</th>
                    <td class="formValue">
                        <label id="phone"></label>
                    </td>
                    <th class="formTitle">Ngày sinh：</th>
                    <td class="formValue">
                        <label id="csny"></label>
                    </td>
                    <th class="formTitle">Ngày nhập viện：</th>
                    <td class="formValue">
                        <label id="ryrq"></label>
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="fa_icontoggle"><i class="fa fa-angle-double-down icontoggle" style="color:rgb(0, 160, 233);cursor:pointer;"></i></div>
    </div>
</div>
<div class="rows" style="margin-bottom: 1%;">
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading navb-bg">
            Hạng mục ghi sổ
        </div>
        <div id="divSLMX" style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle"><span class="required">*</span>Hạng mục thu phí：</th>
                    <td class="formValue">
                        <input id="sfxmmc" type="text" class="form-control  form-an" />
                        <input id="sfxmCode" type="text" style="display:none;" class="form-control" />
                        <!-- Loại y lệnh 1Thuốc 2Hạng mục thu phí -->
                        <input id="yzlx" type="text" style="display:none;" class="form-control" />

                        <input id="sfdlCode" type="text" style="display:none;" class="form-control" />
                        <input id="sfdlmc" type="text" style="display:none;" class="form-control" />
                    </td>
                    <th class="formTitle">Thời lượng đơn vị：</th>
                    <td class="formValue">
                        <input id="duration" type="text" class="form-control  form-an" value="" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Đơn vị：</th>
                    <td class="formValue">
                        <label id="dw"></label>
                    </td>
                    <th class="formTitle"><span class="required">*</span>Đơn giá(đồng)：</th>
                    <td class="formValue">
                        @if (zyjzDjEditable)
                        {
                            <input id="dj" name="dj" type="text" class="form-control newtouch_Readonly" />
                        }
                        else
                        {
                            <label id="dj"></label>
                        }
                    </td>
                    <th class="formTitle"></th>
                    <td class="formValue" style="padding-top: 1px;">
                        <div class="ckbox">
                            <input id="ttbz" name="ttbz" type="checkbox"><label for="ttbz">团体治疗</label>
                        </div>
                    </td>
                </tr>
                <tr>
                    <th class="formTitle"><span class="required">*</span>Số lượng：</th>
                    <td class="formValue">
                        <input id="sl" type="text" class="form-control  form-an" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Nhà trị liệu：</th>
                    <td class="formValue">
                        <input id="zlsList" readonly="readonly" type="text" class="form-control form-an" value="" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Loại phục hồi chức năng：</th>
                    <td class="formValue">
                        <select id="kflb" name="kflb" class="form-control">
                            <option value="">==Vui lòng chọn==</option>
                        </select>
                    </td>
                    <th class="formTitle"><span class="required">*</span>Ngày ghi sổ：</th>
                    <td class="formValue">
                        <input id="tdrq" type="text" class="form-control input-wdatepicker formClearIgnore" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" value="@(System.DateTime.Now.ToString("yyyy-MM-dd"))" />
                    </td>
                    <th class="formTitle">Ghi chú：</th>
                    <td class="formValue">
                        <input id="bz" type="text" class="form-control form-an form-an-end" value="" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>

@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 2, 3, 6, 9 },
    F2Text = "",
    F3Text = "",
    F6Text = "",
    F9Text = "",
    F9Hidden = true
})

<div>
    <table id="gridMX"></table>
</div>


@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 4, 7, 8 },
    F7Text = "",
    F8Text = ""
})

<script type="">

    //Tải loại phục hồi chức năng
    $("").bindSelect({
        url: "",
    });
    $("").val('').trigger('');

    $('').attr('', '');
    $('').attr('', '');

    //Khai báo Chi tiết hạng mục grid
    $("").newtouchLocalDataGrid({
        height: $(window).height() - 350,
        unwritten: false,
        colModel: [
            { label: "", name: "", width: 80, align: "", hidden: true },
            { label: "", name: "", width: 80, align: "", hidden: true },
            {
                label: "", name: "", width: 80, align: "",
                formatter: "", formatoptions: { srcformat: '', newformat: '' }
            },
            { label: "", name: "", width: 150, align: "", hidden: true },
            { label: "", name: "", width: 200, align: "" },
            { label: "", name: "", width: 150, align: "", hidden: true },
            { label: "", name: "", width: 50, align: "", hidden: true },
            { label: "", name: "", width: 50, align: "" },
            { label: "", name: "", width: 40, align: "" },
            { label: "", name: "", width: 60, align: "" },
            {
                label: "", name: "", width: 60, align: "", formatter: "", hidden: true
                    , formatoptions: { decimalPlaces: 4, defaultValue: '' }
            },
            { label: "", name: "", width: 40, align: "" },
            {
                label: "", name: "", width: 180, align: "", formatter: function (cellvalue) {
                    return getYsNamesByList(cellvalue);
                }
            },
            {
                label: "", name: "", width: 65, align: "", formatter: function (cellvalue) {
                    return cellvalue === true ? ""
                        : "";
                }
            },
            { label: "", name: "", width: 160, align: "" },
            { label: "", name: "", width: 50, align: "", hidden: true },
            { label: "", name: "", width: 50, align: "", hidden: true },
        ],
        ondblClickRow: function (rowid) {
            gridEditRow(rowid);
        },
        onSelectRow: function (rowid) {
            $('').removeAttr('');
            $('').removeAttr('');
        },
        gridComplete: function (data) {
            var ids = $("").jqGrid('');
            for (var i = 0; i < ids.length; i++) {
                var rowData = $("").jqGrid('', ids[i]);
                if (rowData && rowData.qrzt) {
                    if (rowData.qrzt === '') {
                        $('' + ids[i] + '').addClass('');
                    }
                }
            }
        }
    });

    //Liên kết Chọn nhà trị liệu Cây
    $('').focus(function () {
        var initIdSelected = "";
        $.each(Editing_ysList, function () {
            initIdSelected += this.id + "";
        })
        $.modalOpen({
            id: "",
            title: "",
            url: "" + initIdSelected,
            showleftlalbel: false,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].AcceptClick(function (data) {
                    staffTreeCallback(data);
                });
            }
        });
    });

    //Cây nhà trị liệu Chọn Callback
    function staffTreeCallback(treeSeleData) {
        var zlsNames = "";
        Editing_ysList = [];
        $.each(treeSeleData, function () {
            zlsNames += this.text + "";
            Editing_ysList.push({ id: this.id, gh: this.value, Name: this.text, ks: this.Ex1, ksmc: this.Ex2 });
        })
        if (zlsNames.length > 0) {
            zlsNames = zlsNames.substring(0, zlsNames.length - 1);
            //Cái một dưới cho 焦点
            //$(this).trigger('');
            $('').trigger('');
        }
        $('').val(zlsNames);
    }

    $('').keyupEnterEvent(function () {
        $('').trigger('');
    });

    $('').keyupEnterEvent(function (event) {
        if ($('').hasClass('')) { //Khuyết điểm-Từ cái trướcenterđã qua
            $('').removeClass('')
            return;
        }
        $('').trigger('');
    });

    //Liên kết lớp nổi chọn hạng mục điều trị
    $('').newtouchBatchFloatingSelector({
        width: 800,
        height: 280,
        caption: "",
        clickautotrigger: true,
        url: '',
        ajaxparameters: function ($thisinput) {
            return "" + $.trim($thisinput.val());
        },
        itemdbclickhandler: function ($thistr, $thisinput) {
            if ($thisinput.attr('') == '') {
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                '' === ''
                    ? $('').val($thistr.attr(''))
                    : $('').html($thistr.attr(''));
                $('').html($thistr.attr(''));
                if ($thistr.attr('') != "") {
                    $('').val($thistr.attr(''));
                }
                $('').val('');
            }
        },
        colModel: [
            { label: '', name: '', widthratio: 8 },
            { label: '', name: '', widthratio: 12 },
            { label: '', name: '', widthratio: 8, hidden: true },
            { label: '', name: '', widthratio: 8 },
            { label: '', name: '', widthratio: 8, hidden: true },
            { label: '', name: '', widthratio: 8 },
            { label: '', name: '', widthratio: 6 },
            {
                label: '', name: '', widthratio: 12, formatter: function (cellvalue) {
                    return !!cellvalue ? parseFloat(cellvalue).toFixed(4) : '';
                }
            },
            {
                label: '', name: '', widthratio: 6, formatter: function (cellvalue) {
                    return !!cellvalue ? cellvalue : '';
                }
            },
            { label: '', name: '', widthratio: 36 }
        ]
    });

    //按创建时间 倒叙 排列， 最新创建的 在最前
    var oldxmList = [];   //Các hạng mục đã gửi trước đâyList
    var newxmList = [];   //Hạng mục mớiList

    //TớigridMX gridđiền dữ liệu vào trong
    function fillDataToGrid() {
        $("").resetSelection();
        $("").clearGridData();
        $("").newtouchLocalDataGrid({ posttofirst: false }, oldxmList);
        for (var i = 0; i <= newxmList.length; i++) {
            $("").newtouchLocalDataGrid(null, newxmList[newxmList.length - i]);
        }
    }

    fillDataToGrid();

    //Mảng bác sĩ phân tích，Lấy chuỗi tên bác sĩ
    function getYsNamesByList(ysList) {
        if (ysList) {
            //Nhà trị liệu phân tích[{},{}]Lấy chuỗi
            var str = "";
            $.each(ysList, function () {
                str += this.Name + '';
            });
            if (str.length > 0) {
                str = str.substring(0, str.length - 1);
            }
            return str;
        }
        return "";
    }

    //Kiểm tra dữ liệu đang chỉnh sửa（Chờ gửi）tính đầy đủ của
    function checkEditingRowData(rowData) {
        if (!rowData.ysList || rowData.ysList.length == 0) {
            $.modalAlert("", '');
        }
        if (!rowData.tdrq) {
            $.modalAlert("", '');
        }
        else if (!rowData.sfxmCode || !rowData.sfxmmc || !rowData.yzlx || !rowData.sfdlCode || !rowData.sfdlmc) {
            $.modalAlert("", '');
        }
        else if (rowData.dw == "") {
            $.modalAlert("", '');
        }
        else if (rowData.yzlx == '' && (rowData.duration == "" || isNaN(rowData.duration))) {
            //Hạng mục điều trị Cần mới Thời lượng
            $.modalAlert("", '');
        }
        else if (rowData.dj == "" || isNaN(rowData.dj)) {
            $.modalAlert("", '');
        }
        else if (rowData.sl == "" || isNaN(rowData.sl)) {
            $.modalAlert("", '');
        }
        else if (rowData.kflb == "") {
            $.modalAlert("", '');
        }
        else {
            return true;
        }
        return false;
    }

    //Nút Sự kiện start

    //键入住院号 Tìm kiếm
    $('').click(function () {
        var zyh = $('').val();
        newtouch_globalevent_f4();
        $('').val(zyh);
        ajaxLoadDataResult();
    });

    var respZyh;

    function ajaxLoadDataResult() {
        var zyh = $('').val();
        if (zyh) {
            $.najax({
                type: "",
                url: "" + zyh,
                loading: true,
                success: function (ajaxresp) {

                    respZyh = ajaxresp.data.patInfo.zyh;

                    $('').html(ajaxresp.data.patInfo.xm);
                    $('').html($.getGender(ajaxresp.data.patInfo.xb));
                    $("").html(getAgeFromBirthTime({ begin: ajaxresp.data.patInfo.csny }).text);
                    $('').html(ajaxresp.data.patInfo.ryzdmc);
                    $('').html(ajaxresp.data.patInfo.zjh);
                    $('').html(ajaxresp.data.patInfo.phone);
                    $('').html(ajaxresp.data.patInfo.csny ? ajaxresp.data.patInfo.csny.substring(0, 10) : '');
                    $('').html(ajaxresp.data.patInfo.ryrq ? ajaxresp.data.patInfo.ryrq.substring(0, 10) : '');

                    //oldxmList = ajaxresp.data.jzjhList;

                    fillDataToGrid();

                    $('').trigger('');

                    if (true) {     //Công tắc
                        setTimeout('' + ajaxresp.data.patInfo.zyh + '', 50);
                    }
                },
                errorCallback: function (err) {
                    newtouch_globalevent_f4();
                    $('').trigger('');
                },
                complete: function () {
                }
            });
        }
        else {
            GetPatSerarchView();
        }
    }

    //Bệnh nhân đã chọn callback
    function getPatInfoAjax(selePatInfo) {
        $('').val(selePatInfo.zyh);
        ajaxLoadDataResult();
    }

    //Nhập viện tra cứu bệnh nhân
    function GetPatSerarchView(zyh) {
        if (!!!zyh) {
            zyh = '';
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + Math.random() + "" + zyh,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
                //Gọi tra cứu số thẻ và số nhập viện
            }//Hàm callback xác nhận khi nhấn cửa sổ
        });
    }

    //Mặc định hiện tại cho
    var default_Editing_ysList = [{ id: '', gh: '', Name: '', ks: '', ksmc: '' }]; //Nhà trị liệu trong vùng chỉnh sửa
    var Editing_ysList = []; //Nhà trị liệu trong vùng chỉnh sửa

    function setDefaultYsList() {
        if (default_Editing_ysList && default_Editing_ysList.length > 0 && default_Editing_ysList[0].id) {
            Editing_ysList = default_Editing_ysList;
            $('').val(Editing_ysList[0].Name);
        }
    }

    setDefaultYsList();

    //Lấy dữ liệu đối tượng của vùng chỉnh sửa
    function getEditRowData() {
        var data = {
            tdrq: $('').val(),
            sfxmCode: $('').val(),
            sfxmmc: $('').val(),
            yzlx: $('').val(),
            duration: $('').val(),
            dj: '' === ''
                ? $('').val()
                : $('').html(),
            dw: $('').html(),
            sl: $('').val(),
            sfdlCode: $('').val(),
            sfdlmc: $('').val(),
            bz: $('').val(),
            ttbz: $('').is('') ? "" : "",
            kflb: $('').val(),
        };
        //Nhà trị liệu
        data.ysList = Editing_ysList;

        return data;
    }

    var editingNewid = null;    //Dòng đang sửa
    var editingOuterId = null;    //Dòng đang sửa

    //Yêu cầu Chỉnh sửa Dòng
    function gridEditRow(rowid) {
        if (rowid) {
            var rowData = $("").jqGrid('', rowid);
            if (rowData) {
                if (rowData.newid) {
                    //Có lẽ thuộc vềnewxmList start
                    rowDataArr = $.jsonWhere(newxmList, function (v) {
                        return v && v.newid == rowData.newid;
                    });
                    if (!rowDataArr || rowDataArr.length == 0) {
                        return; //Tại sao không tìm thấy
                    }
                    rowData = rowDataArr[0];  //Thông quarowData.newidLấy dữ liệu dòng đó từ mảng đối tượng
                    if (true) { //&&Có thể chỉnh sửa
                        editingNewid = rowData.newid;    //Dòng đang sửa
                        editingOuterId = rowData.outerId;   //Dòng đang sửa
                    }
                    else {
                        return;
                    }
                    //Có lẽ thuộc vềnewxmList end
                }
                else {
                    //Không chỉnh sửa có thể

                }
                //Tuần tự hóa vào vùng chỉnh sửa
                $('').val($.getDate({ date: new Date(rowData.tdrq) }));
                //Nhà trị liệu
                Editing_ysList = rowData.ysList;
                $('').val(getYsNamesByList(rowData.ysList)); //Nhà trị liệu
                $('').val(rowData.sfxmmc);
                $('').val(rowData.sfxmCode);
                $('').val(rowData.yzlx);
                $('').val(rowData.sfdlCode);
                $('').val(rowData.sfdlmc);
                $('').html(rowData.dw);
                '' === ''
                    ? $('').val(rowData.dj)
                    : $('').html(rowData.dj);
                $('').val(rowData.duration);
                $('').val(rowData.sl);
                $('').val(rowData.bz);
                rowData.ttbz == "" ? $('').prop("", true) : $('').removeAttr('');
                $('').val(rowData.kflb).trigger('');

                $('').attr('', '');
                $('').show();

                $('').attr('', '');
            }
        }
    }

    //Thêm nút
    function newtouch_event_f2() {
        if (editingNewid) {
            return; //Đang ở trạng thái sửa，thì không thể nhấn nút thêm   CầndisableXử lý
        }

        var data = getEditRowData();
        if (!(checkEditingRowData(data))) {    //Dữ liệu đã đầy đủ chưa，Kiểm tra các mục bắt buộc
            return;
        }

        //Kiểm tra mục trùng lặp

        data.newid = Math.random().toString() + new Date().getMilliseconds();   //newid()

        newxmList.unshift(data);   //Thêm dưới dạng mục mới //”Đầu mảng“

        //Lại đưaxmMảng hiển thị tớigrid
        fillDataToGrid();

        $('').val('');
        $('').val('');
        $('').val('');
        $('').val('');
        $('').val('');
        $('').html('');
        '' === ''
            ? $('').val('')
            : $('').html('');
        $('').val('');
        $('').val('');
        $('').removeAttr('');
        //$('').val('').trigger('');

        $('').trigger('');
    }

    //Nút sửa
    function newtouch_event_f3() {
        if (editingNewid) {
            //Gửi sửa đổi
            var data = getEditRowData();
            if (!(checkEditingRowData(data))) {    //Dữ liệu đã đầy đủ chưa，Kiểm tra các mục bắt buộc
                return;
            }
            if (data.yzxz == '') {
                data.EndDate = data.StartDate;
            }

            data.newid = editingNewid;
            data.outerId = editingOuterId;

            //Kiểm tra mục trùng lặp

            //Trước tiên trongxmtìm trong mảng
            var matchedIndex = -1;
            for (var ii = 0; ii < newxmList.length; ii++) {
                if (newxmList[ii].newid == data.newid) {
                    matchedIndex = ii;
                    break;
                }
            }
            if (matchedIndex == -1) {
                return; //Có lẽ là bất thường
            }
            newxmList.remove(matchedIndex);   //Xóa mục này
            newxmList.unshift(data);   //Thêm dưới dạng mục mới    //”Đầu mảng“

            //Lại đưaxmMảng hiển thị tớigrid
            fillDataToGrid();

            $('').val('');
            $('').val('');
            $('').val('');
            $('').val('');
            $('').val('');
            $('').html('');
            '' === ''
                ? $('').val('')
                : $('').html('');
            $('').val('');
            $('').removeAttr('');
            //$('').val('').trigger('');
            $('').val('');

            editingNewid = null;    //Dòng đang sửa
            editingOuterId = null;    //Dòng đang sửa

            bottomButtonsReset();

            $('').trigger('');
        }
        else {
            //LấygridDòng đang được chọn hiện tại
            var seleId = $('').jqGrid('', '');
            if (seleId) {
                //Yêu cầu sửa dòng đó
                gridEditRow(seleId);
            }
        }
    }

    //F4Xóa
    function newtouch_event_f4() {
        $("").clearGridData();

        oldxmList = [];   //Các hạng mục đã gửi trước đâyList
        newxmList = [];   //Hạng mục mớiList
        Editing_ysList = [];
        editingNewid = null;    //Dòng đang sửa
        editingOuterId = null;  //Dòng đang sửa

        bottomButtonsReset();

        setDefaultYsList();
    };

    //F7Sử dụng mẫu
    function newtouch_event_f7() {
        var ksList = "";
        $.each(Editing_ysList, function (idx, val) {
            ksList += val.ks + "";
        });
        if (ksList) {
            ksList = ksList.substring(0, ksList.length - 1);
            $.modalOpen({
                id: "",
                title: "",
                url: "" + ksList,
                width: "",
                height: "",
                callBack: function (iframeId) {
                    var data = top.frames[iframeId].submitForm();
                    $.each(data, function () {
                        var newRowData = {
                            tdrq: $.getDate(),
                            sfxmCode: this.sfxm,
                            sfxmmc: this.sfxmmc,               //    ？？？？
                            yzlx: "",  //Hạng mục
                            duration: this.duration,
                            dj: this.dj,
                            dw: this.dw,
                            sl: this.sl,
                            sfdlCode: this.dl,
                            sfdlmc: this.dlmc,
                            bz: '',
                            ttbz: "",
                            kflb: '',
                        };
                        newRowData.ysList = Editing_ysList;

                        newRowData.newid = Math.random().toString() + new Date().getMilliseconds();   //newid()
                        if (newRowData.sfxmCode && newRowData.sfdlCode && newRowData.dj && newRowData.dw && newRowData.sl) {
                            newRowData.dj = parseFloat(newRowData.dj);
                            newRowData.sl = parseInt(newRowData.sl);
                            newxmList.unshift(newRowData);   //Thêm dưới dạng mục mới //”Đầu mảng“
                        }
                    });

                    top.frames[iframeId].$.modalClose();

                    fillDataToGrid();
                }
            });
        }
        else {
            $.modalAlert("", '');
        }
    }

    //F8提交至服务器
    function newtouch_event_f8() {
        var paramData = {};
        paramData.zyh = $('').val();

        paramData.xmList = newxmList;
        if (!paramData.zyh) {
            $.modalAlert("", '');
            return;
        }
        if (paramData.zyh != respZyh) {
            $.modalAlert("", '');
            return;
        }
        if (!paramData.xmList || paramData.xmList.length == 0) {
            $.modalAlert("", '');
            return;
        }

        for (var k = 0, length = paramData.xmList.length; k < length; k++) {
            if (!checkEditingRowData(paramData.xmList[k])) {
                return;
            }
        }

        $.submitForm({
            url: '',
            param: paramData,
            success: function (data) {

                newtouch_globalevent_f4();

                $('').trigger('');
            }
        });
    };


    //F6Xóa khỏi danh sách
    function newtouch_event_f6() {
        //LấygridDòng đang được chọn hiện tại
        var rowid = $('').jqGrid('', '');
        if (rowid) {
            //Yêu cầu xóa dòng đó
            if (rowid) {
                var rowData = $("").jqGrid('', rowid);
                if (rowData) {
                    if (!rowData.newid) {   //Dòng này không thể xóa
                        $.modalAlert("", '');
                        return;
                    }
                    if (rowData.newid == editingNewid) {
                        $.modalAlert("", '');
                        return; //Dòng này đang ở trạng thái chỉnh sửa，Không thể xóa
                    }

                    var matchedIndex = -1;
                    for (var ii = 0; ii < newxmList.length; ii++) {
                        if (newxmList[ii].newid == rowData.newid) {
                            matchedIndex = ii;
                            break;
                        }
                    }

                    if (matchedIndex == -1) {
                        return; //Có lẽ là bất thường
                    }

                    newxmList.remove(matchedIndex);   //Xóa mục này

                    //Lại đưaxmMảng hiển thị tớigrid
                    fillDataToGrid();

                    //Không ảnh hưởng gì đến các dòng khác
                }
            }
        }
    }

    //F9Hủy sửa
    function newtouch_event_f9() {
        $('').val($.getDate());
        $('').val('');
        $('').val('');
        $('').val('');
        $('').val('');
        $('').val('');
        $('').html('');
        '' === ''
          ? $('').val('')
          : $('').html('');
        $('').val('');
        $('').removeAttr('');
        //$('').val('').trigger('');
        $('').val('');
        //$('').val('');

        editingNewid = null;    //Dòng đang sửa
        editingOuterId = null;    //Dòng đang sửa

        $("").resetSelection();

        bottomButtonsReset();

        $('').trigger('');
    }

    //
    function bottomButtonsReset() {
        $('').removeAttr('');
        $('').attr('', '');
        $('').attr('', '');
        $('').hide();
    }

    //Nút Sự kiện end

    //加载同步治疗记录
    function loadSyncedTreatmentRecord(zyh) {
        if (zyh) {
            $.najax({
                type: "",
                url: "" + zyh,
                loading: true,
                loadingtext: "",
                success: function (ajaxresp) {
                    if (ajaxresp && ajaxresp.data && ajaxresp.data && ajaxresp.data.length > 0) {
                        $.each(ajaxresp.data, function () {
                            var newRowData = {
                                tdrq: this.CreatedDate,
                                sfxmCode: this.serviceCode,
                                sfxmmc: this.serviceDescription,
                                yzlx: "",
                                duration: this.duration,
                                dj: this.dj,
                                dw: this.dw,
                                sl: this.sl,
                                sfdlCode: this.sfdlCode,
                                sfdlmc: this.sfdlmc,
                                bz: '',
                                ttbz: "",
                                kflb: this.kflb,
                                ysList: [{ id: this.StaffId, gh: this.therapistId, Name: this.therapistName, ks: this.ks, ksmc: this.ksmc }],
                                outerId: this.outerId
                            };

                            newRowData.newid = Math.random().toString() + new Date().getMilliseconds();   //newid()
                            newxmList.unshift(newRowData);   //Thêm dưới dạng mục mới //”Đầu mảng“
                        });

                        fillDataToGrid();

                        //$.modalMsg("" + ajaxresp.data.length + '', '', 1200);
                    }
                }
            });
        }
    }



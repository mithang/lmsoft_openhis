@{
    ViewBag.Title = "";
    Layout = "";
}
<style>
    * {
        font-size: 14px;
    }

    #colsWarp > label {
        display: block;
    }

    #colsWarp > div {
        display: inline-block;
        margin-right: 30px;
        width: 110px;
    }
</style>
<div id="colsWarp" style="padding:20px 20px 0;">
    <label id="lbl1">
        Chọn xuấtExcelcột bao gồm
        <span style="font-size:8px;cursor:pointer;">
            （
            <label>
                <input id="ckChooseAll" type="checkbox">Chọn tất cả
            </label>
            ）
        </span>
    </label>
</div>
<div style="padding:20px 20px 0;">
    <label>Chọn xuấtExcel是否包含筛选条件</label>
    <div class="checkbox">
        <label>
            <input id="ckContainFilter" type="checkbox">Bao gồm điều kiện lọc
        </label>
    </div>
</div>

<script>
    var cols = $.request("");
    cols = decodeURIComponent(cols);
    cols = JSON.parse(cols);

    $.each(cols, function () {
        $('').append('' + this.Name + '' + this.Heading + '');
    });

    $('').click(function () {
        if (!$('').is('')) {
            $('').not('').prop("", false);
        }
        else {
            $('').not('').prop("", true);
        }
    })

    //cột lấy đã chọn
    function GetChoosedCols() {
        var restArr = new Array();
        $.each($('').not(''), function () {
            if ($(this).attr('')) {
                restArr.push($(this).attr(''));
            }
        });
        return restArr;
    }

    //是否导出筛选条件
    function GetIsContainFilter() {
        return $('').is('');
    }

</script>


@{
    ViewBag.Title = "";
    Layout = "";
}
<script type="">
    var keyValue = $.request("");
    var f = $.request("");
    var zt = $.request("");
    $(function () {
        if (!!keyValue) {
            gridList();
        }
    });
    //Chi tiết
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            height: $(window).height() - 120,
            postData: { jzjhmxId: keyValue, from: f },
            colModel: [
            { label: "", name: "", align: "", hidden: true, key: true },
            { label: "", name: "", width: 100, align: "", hidden: true },
            { label: "", name: "", width: 70, align: "" },
            { label: "", name: "", hidden: true, align: "" },
            { label: (f == "" ? "" : ""), name: "", width: (f == "" ? 100 : 70), align: "", hidden: true },

            { label: "", name: "", width: 80, align: "" },
            { label: "", name: "", width: 80, align: "" },
            { label: "", name: "", width: 120, align: "" },
            { label: "", name: "", width: 80, align: "" },
            { label: "", name: "", width: 40, align: "" },
            { label: "", name: "", width: 40, align: "" },
            {
                label: "", name: "", width: 60, align: "",
                formatter: function (cellvalue) {
                    return $.enum.getDescByValue("", cellvalue);
                }
            },
            { label: "", name: "", width: 55, align: "", formatter: "", formatoptions: { decimalPlaces: 2, defaultValue: '' } },
            {
                label: "", name: "", width: 80, align: "",
                formatter: "", formatoptions: { srcformat: '', newformat: '' }
            },
            {
                label: "", name: "", width: 140, align: "",
                formatter: "", formatoptions: { srcformat: '', newformat: '' }
            },
			{
			    label: "", name: "", width: 50, align: "",
			    formatter: function (cellvalue, a, b) {
			        if (cellvalue == '') {
			            return ""
			        }
			        else {
			            return "";
			        }
			    }
			}],
            pager: "",
            rowNum: '',
            sortname: '',
            viewrecords: true,
            gridComplete: function () {
                var ids = $("").getDataIDs();
                for (i = 0; i < ids.length; i++) {
                    var rowData = $("").getRowData(ids[i]);
                    if (rowData && rowData.zt) {
                        if (rowData.zt == "") {
                            $("" + ids[i]).find("").addClass('');
                        }
                    }
                }
            },
            ondblClickRow: function (rowid) {
                updateExc();
            }
        });
    }

    function cancelExc() {
        //181015已完成可以撤
        //if (zt == "") {
        //    $.modalAlert("", '');
        //    return;
        //}

        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var data = $("").jqGridRowValue();
        if (data.zt == "") {
            $.modalAlert("", '');
            return;
        }
        if (data) {
            $.najax({
                type: "",
                url: "" + data.zxId + "" + data.jzjhmxId + "" + f,
                loading: true,
                success: function (ajaxresp) {
                    $("").resetSelection();
                    $("").clearGridData();
                    $("").trigger("");
                }
            });
        }
    }

    function updateExc() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var data = $("").jqGridRowValue();
        if (data.zt == "") {
            $.modalAlert("", '');
            return;
        }

        $.modalOpen({
            id: "",
            title: "",
            url: "" + data.zxId + "" + f,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.UpdateExecForm.submitForm(function () {
                    $("").resetSelection();
                    $("").clearGridData();
                    $("").jqGrid('',
                    {
                        postData: { jzjhmxId: keyValue, from: f },
                        url: ""
                    }).trigger('');
                });

            }
        });
    }
</script>
<form name="form1">
    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
    <input type="button" onclick="updateExc()" class="btn btn-primary btn-md" value="Sửa" style="float: right;margin-top: 10px;margin-right: 20px;" />
    <input type="button" id="cancelExce" onclick="cancelExc()" class="btn btn-primary btn-md" value="Hủy thực hiện" style="float: right;margin-top: 10px;margin-right: 20px;" />
</form>

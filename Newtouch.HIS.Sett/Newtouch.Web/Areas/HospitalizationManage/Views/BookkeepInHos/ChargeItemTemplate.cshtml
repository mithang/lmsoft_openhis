            autoScroll: true,
            url: "" + sfmbbh,
            height: 200,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: '', name: '', width: 70, align: '' },
                { label: '', name: '', width: 130, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 40, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', hidden: true, width: 50, align: '' },
                { label: '', name: '', width: 50, align: '', hidden: true },
                { label: '', name: '', width: 50, align: '', hidden: true },
                { label: '', name: '', width: 100, align: '', hidden: true },
                { label: '', name: '', width: 50, align: '' },
                { label: '', name: '', width: 50, align: '', hidden: true },

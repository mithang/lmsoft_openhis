@{
    ViewBag.Title = "";
    Layout = "";
}
<script>
    var keyValue = $.request("");
    $(function () {
        gridList();
    });
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            treeGrid: true,
            url: "" + keyValue,
            height: 150,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: "", name: "", width: 80, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 50, align: '' },
            ]
        });
    }

    function btn_loaddata(rowid) {
        //yxzje = '';
        //$('').html(yxzje);
        $('').jqGrid("");

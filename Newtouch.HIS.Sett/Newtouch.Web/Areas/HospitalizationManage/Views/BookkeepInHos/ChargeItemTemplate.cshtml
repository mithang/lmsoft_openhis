                //} else {
                //    yxzje = (parseFloat(yxzje) - xzzje).toFixed(2);
                //}
                //$('').html(yxzje);
            }
        });
        var grid = $('').jqGrid()[0].grid;
        $('').jqGrid().setGridParam({ url: '' + sfmbbh });
        grid.populate();
    }


    function submitForm() {
        var rowid = $("").jqGrid("", "");
        var obj = [];
        if (rowid != "" && rowid != undefined) {
            for (var i = 0; i < rowid.length; i++) {
                obj[i] = new Object();
                obj[i] = $('').jqGrid('', rowid[i]);
            }
        }
        return obj;
    }
</script>

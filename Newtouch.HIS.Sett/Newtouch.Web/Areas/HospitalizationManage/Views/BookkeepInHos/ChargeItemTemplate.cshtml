                { label: '', name: '', hidden: true, align: '' },
                { label: '', name: '', hidden: true, align: '' },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
            ],
            multiselect: true,
            onSelectRow: function (rowid, status) {
                //var data = $("").jqGrid('', rowid);
                //var xzzje = parseFloat(data.dj) * parseFloat(data.sl);
                //if (status) {

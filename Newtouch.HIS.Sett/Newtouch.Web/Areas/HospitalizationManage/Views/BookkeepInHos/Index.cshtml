    //Kiểm tra dữ liệu đang chỉnh sửa（Chờ gửi）tính đầy đủ của
    function checkEditingRowData(rowData) {
        var ryrq = new Date($('').html());
        var cyrq = new Date($('').html());
        var cqrq = new Date($('').html());
        var cqrq = $('').html();
        var ztjsrq = new Date($('').html());
        if (!rowData.tdrq) {
            $.modalAlert("", '');
        } else if (ryrq > new Date(rowData.tdrq)) {
            $.modalAlert("" + $('').html(), '');
        } else if (!!cyrq && cyrq < new Date(rowData.tdrq) && ryrq) {
            $.modalAlert("" + $('').html(), '');
        } else if (!!cqrq && cqrq < new Date(rowData.tdrq)) {
            $.modalAlert("" + $('').html(), '');
        }
        else if (!!ztjsrq && ztjsrq < new Date(rowData.tdrq)) {
            $.modalAlert("" + $('').html(), '');
        }
        else if (!rowData.ksmc || !rowData.ysmc || !rowData.ys || !rowData.ks) {
            $.modalAlert("", '');
        }
        else if (!rowData.dl || !rowData.dlmc || !rowData.sfxm || !rowData.sfxmmc
            || !rowData.dw) {
            $.modalAlert("", '');
        }
        else if (!rowData.dj) {
            $.modalAlert("", '');
        }
        else if (!rowData.yzlx) {
            $.modalAlert("", '');
        }
        else if (rowData.yzlx == "" && (!rowData.zxksmc || !rowData.zxks)) {
            $.modalAlert("", '');
        }
        else if (!rowData.sl) {
            $.modalAlert("", '');
        }
        //手术系统来源则允许小数位
        else if (requestfrom == "") {
            if (!((/^[0-9]+([.]{1}[0-9]{1,2})?$/).test(rowData.sl)) || rowData.sl < 0) {
                $.modalAlert("", '');
            } else {
                return true;
            }
        }
        else if (!((/^[0-9]+([.]{1}[0-9]{1,2})?$/).test(rowData.sl)) || rowData.sl < 0) {
            $.modalAlert("", '');
        }
        else {
            return true;
        }
        return false;
    }


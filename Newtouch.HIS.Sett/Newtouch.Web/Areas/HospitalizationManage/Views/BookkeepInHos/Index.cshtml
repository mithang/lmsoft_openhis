<script>
    var requestfrom = $.request("");
    var xmjf = [];
    var selectedZyh = null;
    var editingNewid = null;

    $(function () {
        initControl();
        gridListData();
    });

    //Tra cứu bằng Enter
    $('').keydownEnterEvent(function() {
        getPatInfoAjax({ zyh: $('').val() });
    });

    //Tra cứu bệnh nhân(Nhập viện)
    function GetPatSerarchView() {
        $.modalOpen({
            id: "",
            title: "",
            url: "" + '' + "" + Math.random() + "" + '',
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
                //Gọi tra cứu số thẻ và số nhập viện
            }//Hàm callback xác nhận khi nhấn cửa sổ
        });
    }

    //Bệnh nhân đã chọn callback
    function getPatInfoAjax(selePatInfo) {
        //Xóa một chút
        newtouch_globalevent_f4();
        //
        if (selePatInfo && selePatInfo.zyh) {
            selectedZyh = selePatInfo.zyh;
            $('').val(selePatInfo.zyh);
            ajaxLoadDataResult(selectedZyh);
        }
        else {
            selectedZyh = '';
            $('').val('');
        }
    }

    //仅清除输入域的内容
    function clearJZInfo() {
        newtouch_globalevent_f4(null, {
            container: "",
            inner: false
        });
    }

    //Xóa dữ liệu dòng một trong của nó
    function delData() {
        var $gridList = $("");
        var id = $gridList.jqGrid("", "");
        if (id) {
            var rowData = $("").jqGrid('', id);
            var matchedIndex = -1;
            if (xmjf.length > 0) {
                for (var ii = 0; ii < xmjf.length; ii++) {
                    if (xmjf[ii].newid === rowData.newid) {
                        matchedIndex = ii;
                    }
                }
            }
            if (matchedIndex === -1) {
                return; //Có lẽ là bất thường
            }
            xmjf.remove(matchedIndex);   //Ghi sổ mới xóa
            fillDataToGrid();
        }
        else {
            $.modalAlert("", '');
        }
    }

    //Lại liên kếtgrid
    function fillDataToGrid() {
        $('').jqGrid("");
        $("").newtouchLocalDataGrid(null, xmjf);
    }

    //Liên kếtgrid
    function gridListData() {
        var $gridList = $("");
        $gridList.newtouchLocalDataGrid({
            height: $(window).height() - 360,
            unwritten: false,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: '', name: '', width: 70, align: '', editor: "" },
                { label: '', name: '', width: 250, align: '', editor: "" },
                { label: '', name: '', width: 100, align: '', editor: "" },
                { label: '', name: '', width: 100, align: '', editor: "" },
                {
                    label: '', name: '', width: 100, align: '', editor: "", formatter: ""
                    , formatoptions: { decimalPlaces: 4, defaultValue: '' }
                },
                { label: '', name: '', width: 100, align: '', editor: "" },
                { label: '', name: '', width: 100, align: '', editor: "" },
                { label: '', name: '', width: 100, align: '', editor: "" },
                { label: '', name: '', width: 100, align: '', editor: "" },
                { label: '', name: '', width: 100, align: '', editor: "" },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', width: 100, align: '', editor: "", hidden: true },
                { label: '', name: '', width: 100, align: '', editor: "", hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true },
                { label: '', name: '', hidden: true }
            ],
            onSelectRow: function (rowid) {
                $('').removeAttr('');
                $('').removeAttr('');
            },
            ondblClickRow: function (rowid) {
                gridEditRow(rowid);
            },
        });
    }

    //Tải thông tin cơ bản nhập viện
    function ajaxLoadDataResult(zyh) {
        $.najax({
            type: "",
            url: "" + zyh,
            success: function (ajaxresp) {
                var patModel = ajaxresp.data.patInfo;
                var ztjs = ajaxresp.data.zjrq
                $('').html(patModel.xm);
                $('').html($.getGender(patModel.xb));
                $('').html(getAgeFromBirthTime({ begin: patModel.csny }).text);
                $('').html(patModel.ryzdmc);
                $('').html(patModel.zjh);
                $('').html(patModel.phone);
                $('').html(patModel.csny ? patModel.csny.replace("", "").substring(0, 16) : '');
                $('').html(patModel.ryrq ? patModel.ryrq.replace("", "").substring(0, 16) : '');
                $('').html(patModel.cyrq ? patModel.cyrq.replace("", "").substring(0, 16) : '');
                $('').html(patModel.cqrq ? patModel.cqrq.replace("", "").substring(0, 16) : '');
                $("").val(patModel.ysmc);
                $("").attr("", patModel.ysgh);
                $("").attr("", patModel.ksCode);
                $("").val(patModel.ksmc);
                $('').html(ztjs ? ztjs.replace("", "") : '');
            },
            errorCallback: function (err) {
                newtouch_globalevent_f4();
                $('').trigger('');
            }
        });
    }

    //Tải hạng mục thu phí，医生下拉框的值
    function initControl() {
        //Hạng mục thu phí Lớp nổi
        @*var searchType = "";
        var dllb = '';
        if ('' == '') {
            searchType += '';
            dllb += "";
            if ('' == '') {
                searchType += '';
            }
        }*@
        $("").sfxmFloatingSelector({
            djDecimalPlaces: 4,
            searchType: "",//searchType,
            ajaxparameters: function ($thisinput) {
                var dllb = ''; //Hạng mục
                if ($("").prop("") == true) {
                    return "" + dllb + "" + $("").attr("") + "" + $thisinput.val();
                };
                return "" + dllb + "" + $thisinput.val();
            },
            itemdbclickhandler: function ($thistr) {
                if (!selectedZyh) {
                    $.modalAlert("", '');
                    return;
                }
                $("").val($thistr.attr(''));
                $('').html($thistr.attr(''));
                $("").html($thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr('')==''? '':$thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                if ($("").val() == "") //Khoa thực hiện cho nhà thuốc mặc định thì thuốc cho nếu
                {
                    $("").val("");

                }
                return;
            }
        });

        $("").val($.getTime());
        $('').newtouchFloatingSelector({
            width: 400,
            height: 180,
            caption: "",
            clickautotrigger: true,
            url: '',
            ajaxmethod: '',
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = '';
                return reqData;
            },
            itemdbclickhandler: function ($thistr) {
                $('').attr('', $thistr.attr(''))
                    .val($thistr.attr(''));
            },
            colModel: [{ label: '', name: '', widthratio: 30 },
            { label: '', name: '', widthratio: 30 },
            { label: '', name: '', widthratio: 30 }
            ]
        });
        $("").prop('', '');
        ///Bác sĩ
        $("").newtouchFloatingSelector({
            height: 240,
            width: 500,
            focusautotrigger: true,
            filter: function (keyword) {
                if (!selectedZyh) {
                    $.modalAlert("", '');
                    return;
                }
                //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
                var resultObjArr = new Array();
                if (!!top.window.clients.doctorInHosBookkeep) {
                    $.each(top.window.clients.doctorInHosBookkeep, function (idx, val) {
                        if (keyword.trim() == "" || (val.py && val.py.indexOf(keyword.toUpperCase()) >= 0)
                            || (val.StaffName && val.StaffName.indexOf(keyword.toUpperCase()) >= 0)
                            || (val.StaffGh && val.StaffGh.indexOf(keyword.toUpperCase()) >= 0)
                            || (val.ks && val.ks.indexOf(keyword.toUpperCase()) >= 0)
                            || (val.ksmc && val.ksmc.indexOf(keyword.toUpperCase()) >= 0)) {
                            resultObjArr.push(val);
                        }
                    });
                }

                return resultObjArr;
            },
            caption: "",
            colModel: [
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', widthratio: 25 },
                { label: '', name: '', widthratio: 25 },
            ],
            itemdbclickhandler: function ($thistr) {
                $("").val($thistr.attr(''));
                $("").attr("", $thistr.attr(''));
                $("").attr("", $thistr.attr(''));
                $("").val($thistr.attr(''));
                return;
            }
        });
        $("").prop('', '');

        $("").newtouchBatchFloatingSelector({
            height: 150,
            width: 250,
            clickautotrigger: true,
            filter: function (keyword) {
                //Duyệt nguồn dữ liệu，Dùngkeywordđể lọc ra kết quả
                if (!keyword) {
                    keyword = '';
                }
                var resultObjArr = new Array();
                $.each(top.window.clients.sysDepartList, function (idx, val) {
                    if ((val.py && val.py.toLowerCase().indexOf(keyword.toLowerCase()) >= 0)
                        || (val.Name && val.Name.indexOf(keyword) >= 0)
                        || keyword.trim() == "") {
                        resultObjArr.push(val);
                    }
                });
                return resultObjArr;
            },
            caption: "",
            colModel: [
                { label: '', name: '', widthratio: 50 },
                { label: '', name: '', widthratio: 50 },
                { label: '', name: '', hidden: true }
            ],
            itemdbclickhandler: function ($thistr) {
                $("").attr("", $thistr.find("").html());
                $("").val($thistr.find('').html());
                return;
            },
        });
        $("").val('');
        $("").attr("", '');
    }


    //Lưu thao tác
    function btn_Save() {
        debugger
        if (!selectedZyh) {
            $.modalAlert("", '');
            return;
        }
        $.najax({
            url: "",
            data: { zyh: $('').val(), ItemFeeVO: xmjf },
            dataType: '',
            type: "",
            //async: false,
            success: function (data) {
                if (data.message == "") {
                    $.modalAlert(data.message, '');
                    newtouch_globalevent_f4();
                    $('').trigger('');
                }
                else {
                    $.modalAlert(data.message, '');
                }
            },
            error: function (err) {
                $.modalAlert(err, '');
            }
        });
    }

    //Chọn mẫu
    function GetTemplate() {
        if (!selectedZyh) {
            $.modalAlert("", '');
            return;
        }
        var ys = $("").val();
        var ks = $("").val();
        var kscode = $("").attr("");

        var url = "";
        if (kscode == '' && requestfrom =="") {
            url = "" + kscode;
        }
        if (ys && ks && $('').attr("") && $('').attr("")) {
            $.modalOpen({
                id: "",
                title: "",
                url: url,
                width: "",
                height: "",
                callBack: function (iframeId) {
                    var data = top.frames[iframeId].submitForm();
                    if ($("").val() == null || $("").val() == null) {
                        $.modalAlert("", '');
                        return;
                    }
                    $.each(data, function () {
                        var newRowData = {
                            newid: Math.random().toString() + new Date().getMilliseconds(),
                            sl: this.sl,
                            je: roundingBy4she6ru5chengshuang(this.sl * this.dj, 2),
                            tdrq: $("").val(),
                            ksmc: $('').val(),
                            ks: $('').attr(""),
                            ys: $('').attr(""),
                            zxks: '',
                            zxksmc: '',
                            ysmc: $('').val(),
                            dl: this.dl,
                            dlmc: this.dlmc,
                            sfxm: this.sfxm,
                            sfxmmc: this.sfxmmc,
                            dw: this.dw,
                            dj: this.dj,
                            yzlx: 2,    //2Hạng mục
                            zfbl: this.zfbl,
                            zfxz: this.zfxz,
                            //cls: this.cls,
                            //yfdm: this.yfdm,
                        };
                        xmjf.unshift(newRowData);   //Thêm dưới dạng mục mới //”Đầu mảng“
                    });
                    //Lại đưaxmMảng hiển thị tớigrid
                    fillDataToGrid();
                }
            });
        }
        else {
            $.modalAlert("", '');
        }
    }

    function newtouch_event_f4() {
        $('').jqGrid("");   //Xóa dòng tất cả

        selectedZyh = null;
        xmjf = [];
        editingNewid = null;
    }

    function newtouch_event_f8() {
        btn_Save();
    }

    function newtouch_event_f7() {
        GetTemplate();
    }

    function newtouch_event_f6() {
        delData();
    }

    function newtouch_event_f2() {
        debugger
        var newRowData = getEditRowData();
        if (!(checkEditingRowData(newRowData))) {
            //Dữ liệu đã đầy đủ chưa，Kiểm tra các mục bắt buộc
            return;
        }

        newRowData.newid = Math.random().toString() + new Date().getMilliseconds();

        xmjf.unshift(newRowData);   //Thêm dưới dạng mục mới //”Đầu mảng“
        fillDataToGrid();
        clearJZInfo();

        //setTimeout("", 100);
    }

    $('').keydownEnterEvent(function (event) {
        if ($('').hasClass('')) { //Khuyết điểm-Từ cái trướcenterđã qua
            $('').removeClass('')
            return;
        }
        if (editingNewid) {
            $('').trigger('');
        }
        else {
            $('').trigger('');
        }
        return false;
    });

    //Yêu cầu Chỉnh sửa Dòng
    function gridEditRow(rowid) {
        if (rowid) {
            var rowData = $("").jqGrid('', rowid);
            if (rowData) {
                rowDataArr = $.jsonWhere(xmjf, function (v) {
                    return v && v.newid == rowData.newid;
                });
                if (!rowDataArr || rowDataArr.length == 0) {
                    return; //Tại sao không tìm thấy
                }
                rowData = rowDataArr[0];  //Thông quarowData.newidLấy dữ liệu dòng đó từ mảng đối tượng
                editingNewid = rowData.newid;    //Dòng đang sửa
                //Tuần tự hóa vào vùng chỉnh sửa
                $('').val(rowData.sl);
                $('').val(rowData.ksmc);
                $('').attr('', rowData.ks);
                $('').val(rowData.zxksmc);
                $('').attr('', rowData.zxks);
                $('').val(rowData.ysmc);
                $('').attr('', rowData.ys);
                $('').val(rowData.dl);
                $('').val(rowData.dlmc);
                $('').val(rowData.sfxmmc);
                $('').val(rowData.sfxm);
                $('').html(rowData.dw);
                $('').html(rowData.dj);
                $('').val(rowData.yzlx);
                $('').val(rowData.zfxz);
                $('').val(rowData.zfbl);
                $('').val(rowData.cls);
                $('').val(rowData.yfdm);
                if (!!rowData.tdrq) {
                    $('').val($.getDate({ date: rowData.tdrq, ute: true }));
                }

                $('').attr('', '');
                $('').show();

                $('').attr('', '');
            }
        }
    }

    //Nút sửa
    function newtouch_event_f3() {
        if (editingNewid) {
            //Gửi sửa đổi
            var data = getEditRowData();
            if (!(checkEditingRowData(data))) {
                //Dữ liệu đã đầy đủ chưa，Kiểm tra các mục bắt buộc
                return;
            }
            var updategoon = function () {
                data.newid = editingNewid;
                //Kiểm tra mục trùng lặp

                //Trước tiên trongxmtìm trong mảng
                var matchedIndex = -1;
                for (var ii = 0; ii < xmjf.length; ii++) {
                    if (xmjf[ii].newid == data.newid) {
                        matchedIndex = ii;
                        break;
                    }
                }
                if (matchedIndex == -1) {
                    return; //Có lẽ là bất thường
                }
                xmjf.remove(matchedIndex);   //Xóa mục này
                xmjf.unshift(data);   //Thêm dưới dạng mục mới    //”Đầu mảng“

                //Lại đưaxmMảng hiển thị tớigrid
                fillDataToGrid();

                clearJZInfo();

                editingNewid = null;    //Dòng đang sửa

                bottomButtonsReset();

                //setTimeout("", 100);
            }
            if (data && (parseFloat(data.dj) < '' || parseFloat(data.dj) == '')) {
                $.modalConfirm("", function (flag) {
                    if (!flag) {
                        return;
                    }
                    else {
                        updategoon();
                    }
                });
            }
            else {
                updategoon();
            }
        }
        else {
            //Đăng ký sửa LấygridDòng đang được chọn hiện tại
            var seleId = $('').jqGrid('', '');
            if (seleId) {
                //Yêu cầu sửa dòng đó
                gridEditRow(seleId);
            }
        }
    }


    //Yêu cầu Chỉnh sửa Dòng
    function gridEditRow(rowid) {
        if (rowid) {
            var rowData = $("#gridMX").jqGrid('getRowData', rowid);
            if (rowData) {
                //20180910add Đã gửi thì không thể sửa
                if (!rowData.newid) {
                    $.modalAlert("Ghi sổ đã gửi，Không thể sửa", 'warning');
                    return;
                }
                //20180910add Đã gửi thì không thể sửa
                if (rowData.newid) {
                    //hẳn là thuộc về newxmList start
                    rowDataArr = $.jsonWhere(newxmList, function (v) {
                        return v && v.newid == rowData.newid;
                    });
                    if (!rowDataArr || rowDataArr.length == 0) {
                        return; //Tại sao không tìm thấy
                    }
                    rowData = rowDataArr[0];  //Thông qua rowData.newid Lấy dòng dữ liệu này từ mảng đối tượng
                    if (true) { //&&Có thể chỉnh sửa
                        editingJzjhmxId = null;
                        editingNewid = rowData.newid;    //Dòng đang sửa
                    }
                    else {
                        return;
                    }
                    //hẳn là thuộc về newxmList end
                }
                else if (rowData.jzjhmxId) {
                    //hẳn là thuộc về oldxmList start
                    //Yêu cầu chỉnh sửa dòng đã gửi
                    if (rowData.zxzt == "已完成" || rowData.zxzt == "已停止" || rowData.zxzt == "执行中") {
                        //oldxmList nhiều lần sửa trong rowData.zxzt undifined cũng không vấn đề
                        $.modalAlert("Đã thực hiện/Đã hoàn thành/Bản ghi đã dừng không thể sửa", 'warning');
                        return;
                    }
                    $('#sfxmmc').attr('disabled', 'disabled').addClass('newtouch_Readonly');//Không thể sửa khoản mục thu phí
                    rowDataArr = $.jsonWhere(oldxmList, function (v) {
                        return v && v.jzjhmxId == rowData.jzjhmxId;
                    });
                    if (!rowDataArr || rowDataArr.length == 0) {
                        return; //Tại sao không tìm thấy
                    }
                    rowData = rowDataArr[0];  //Thông qua rowData.jzjhmxId Lấy dòng dữ liệu này từ mảng đối tượng
                    if (true) { //&&Có thể chỉnh sửa
                        editingJzjhmxId = rowData.jzjhmxId;
                        editingNewid = null;    //Dòng đang sửa
                    }
                    else {
                        return;
                    }
                    //hẳn là thuộc về oldxmList end
                }
                if (!(from == 'mz')) {
                    $('[name=yzxz][value="' + rowData.yzxz + '"]').trigger('click');
                }
                //old new common
                //Tuần tự hóa vào vùng chỉnh sửa
                $('#sfxmmc').val(rowData.sfxmmc);
                $('#sfxmCode').val(rowData.sfxmCode);
                $('#yzlx').val(rowData.yzlx);
                $('#sfdlCode').val(rowData.sfdlCode);
                $('#sfdlmc').val(rowData.sfdlmc);
                $('#dw').html(rowData.dw);
                '@(jhjzDjEditable.ToString().ToLower())' === 'true'
                    ? $('#dj').val(parseFloat(!!rowData.dj ? rowData.dj : 0).toFixed(2))
                    : $('#dj').html(parseFloat(!!rowData.dj ? rowData.dj : 0).toFixed(2));
                $('#zll').val(rowData.zll);
                $('#sl').val(rowData.sl);
                $('#bz').val(rowData.bz);
                if (!!rowData.jzsj) {
                    $('#jzsj').val($.getDate({ date: rowData.jzsj, ute: true }));
                }
                if (!!rowData.StartDate) {
                    if ($.getDate({ date: rowData.StartDate }) > '2000-01-01') {
                        $('#StartDate').val($.getDate({ date: rowData.StartDate, ute: true }));
                    }
                    else {
                        //Bắt buộc bổ sung ngày kê đơn
                        $('#StartDate').val('');
                    }
                }
                $('#jzjhmxId').val(rowData.jzjhmxId);
                $('#mz_czlx').val(rowData.czlx);
                $('#dwjls').val(rowData.dwjls);
                $('#jjcl').val(rowData.jjcl);
                $('#btn_bottombutton_f6').attr('disabled', 'disabled');
                $('#btn_bottombutton_f9').show();

                $('#btn_bottombutton_f2').attr('disabled', 'disabled');
            }
        }
    }

    //Nút thêm
    function newtouch_event_f2() {
        if (editingNewid || editingJzjhmxId) {
            return; //Đang ở trạng thái sửa，là không thể nhấn nút thêm   Cần disable Xử lý
        }

        if (from == "mz") {
            if (!patInfoObj.mzh) {
                $.modalAlert("Thiếu thông tin cơ bản của bệnh nhân", 'warning');

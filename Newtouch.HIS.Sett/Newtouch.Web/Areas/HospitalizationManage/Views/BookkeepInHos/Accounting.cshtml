@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "Accounting";
    Layout = "~/Views/Shared/_Form.cshtml";

    var jhjzDjEditable = (ViewBag.jhjz_dj_editable as bool?) ?? false;
    var from = Context.Request.QueryString["from"];
}
<style>
    .toolbar {
        width: 45% !important;
        margin: 10px 30px 12px;
    }
</style>
<div class="rows mz" style="margin-bottom: 1%;display:none;">
    <form class="rows" style="margin-bottom: 1%;" id="formPat1">
        <div class="panel panel-default">
            <div class="panel-heading navb-bg">
                Thông tin cơ bản ngoại trú
            </div>
            <div style="padding: 2px;padding-right:20px;" id="divPatInfo">
                <table class="form">
                    <tr>
                        <th class="formTitle"><span class="required">*</span><label id="lbl_mzh">Số bệnh án/Họ tên：</label></th>
                        <td class="formValue">
                            <input type="text" class="form-control" id="mzh" name="mzh" placeholder="Ít nhất 1 ký tự" />
                            <label id="mz_blh" hidden="hidden"></label>
                            <label id="jzjhmxId" hidden="hidden"></label>
                            <label id="dwjls" hidden="hidden"></label>@*Số lượng đo mỗi lần，so sánh với liều điều trị mỗi lần*@
                            <label id="jjcl" hidden="hidden"></label>@*Số lượng đo mỗi lần，so sánh với liều điều trị mỗi lần*@
                            <label id="mz_czlx" hidden="hidden"></label>@*Loại thao tác Thêm mới 0/Sửa 1/Xóa 2*@
                        <td class="formValue" colspan="1">
                            <input type="button" class="btn btn-default btn-md btn-default-color" id="mz_btnsyy" value="Tra cứu" onclick="GetPatSerarchView($('#mzh').val());" />
                            <input type="hidden" id="mz_brxz" />
                        </td>
                        <th class="formTitle">Họ tên：</th>
                        <td class="formValue">
                            <label id="mz_xm" style="width: 150%"></label>
                        </td>
                        <th class="formTitle">Giới tính：</th>
                        <td class="formValue">
                            <label id="mz_xb"></label>
                        </td>
                        <th class="formTitle">Tuổi：</th>
                        <td class="formValue">
                            <label id="mz_nl"></label>
                        </td>
                    </tr>
                    <tbody class="dispTbody" style="display:none;">
                        <tr>
                            <td class="formTitle">Số giấy tờ：</td>
                            <td class="formValue" colspan="2">
                                <label id="mz_zjh"></label>
                            </td>
                            <td class="formTitle">Số điện thoại：</td>
                            <td class="formValue seWidth">
                                <label id="mz_phone"></label>
                            </td>
                            <th class="formTitle">Ngày sinh：</th>
                            <td class="formValue seWidth">
                                <label id="mz_csny"></label>
                            </td>
                            <th class="formTitle" hidden>Thời gian khám bệnh：</th>
                            <td class="formValue" colspan="2" hidden>
                                <label id="mz_ghsj"></label>
                            </td>
                            <th class="formTitle" hidden>Người giới thiệu：</th>
                            <td class="formValue">
                                <label id="mz_jsr" hidden></label>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="fa_icontoggle"><i class="fa fa-angle-double-down icontoggle" style="color:rgb(0, 160, 233);cursor:pointer;"></i></div>
            </div>
        </div>
    </form>
</div>
<div class="rows zy" style="margin-bottom: 1%;">
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading navb-bg">
            Thông tin bệnh nhân nội trú
        </div>
        <table class="form" style="width:96%;">
            <tbody>
                <tr>
                    <th class="formTitle">Số bệnh án/Họ tên：</th>
                    <td class="formValue">
                        <input class="form-control" type="text" id="zyh" value="" placeholder="Ít nhất 1 ký tự" />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-default btn-md btn-default-color" title="Chọn bệnh nhân nội trú" id="zy_btnsyy" value="Tra cứu" onclick="GetPatSerarchView($('#zyh').val());">
                        <input hidden="hidden" id="btn_search" />
                    </td>
                    <th class="formTitle">Họ tên：</th>
                    <td class="formValue">
                        <label id="zy_xm"></label>
                    </td>
                    <th class="formTitle">Giới tính：</th>
                    <td class="formValue">
                        <label id="zy_xb"></label>
                    </td>
                    <th class="formTitle">Tuổi：</th>
                    <td class="formValue">
                        <label id="zy_nl"></label>
                    </td>
                    <th class="formTitle">Tính chất bệnh nhân：</th>
                    <td class="formValue">
                        <label id="zy_brxzmc"></label>
                    </td>
                </tr>
            </tbody>
            <tbody class="dispTbody" style="display:none;">
                <tr>
                    <th class="formTitle">Số giấy tờ：</th>
                    <td class="formValue" colspan="2">
                        <label id="zy_zjh"></label>
                    </td>
                    <th class="formTitle">Chẩn đoán nhập viện：</th>
                    <td class="formValue">
                        <label id="zy_ryzd"></label>
                    </td>
                    <th class="formTitle">Số điện thoại：</th>
                    <td class="formValue">
                        <label id="zy_phone"></label>
                    </td>
                    <th class="formTitle">Ngày sinh：</th>
                    <td class="formValue">
                        <label id="zy_csny"></label>
                    </td>
                    <th class="formTitle">Ngày nhập viện：</th>
                    <td class="formValue">
                        <label id="zy_ryrq"></label>
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="fa_icontoggle"><i class="fa fa-angle-double-down icontoggle" style="color:rgb(0, 160, 233);cursor:pointer;"></i></div>
    </div>
</div>
<div class="rows" style="margin-bottom: 1%;">
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading navb-bg" id="divPanelJzxm">
            Khoản mục ghi sổ
        </div>
        <div id="divSLMX" style="padding: 2px;padding-right:20px;">
            @if (from == "mz")
            {
                @Html.Partial("AccountingOutpatientInputArea")
            }
            else
            {
                @Html.Partial("AccountingInpatientInputArea")
            }
        </div>
    </div>
</div>
@Html.Partial("_MiddleButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 2, 3, 6, 9 },
    F2Text = "Thêm",
    F3Text = "Sửa",
    F6Text = "Xóa",
    F9Text = "Hủy sửa",
    F9Hidden = true
})
<style>
    .danger {
        background-color: #274b6d
    }
    .info {
        background-color: #d9edf7
    }
    .complete {
        background-color: #6ff3ad
    }
</style>
<div>
    <table id="gridMX"></table>
</div>
<table style="width:420px;height:20px; margin-top:10px;margin-left:10px; float:left; color:#274b6d">
    <tr>
        <td>
            <label style="height:7px;width:25px;background-color:#6ff3ad; border:1px solid #ddd"></label>
        </td>
        <td>Biểu thị đã hoàn thành</td>
        <td>
            <label style="height:7px;width:25px;background-color:#d9edf7; border:1px solid #ddd"></label>
        </td>
        <td>Biểu thị đang thực hiện</td>
        <td>
            <label style="height:7px;width:25px;background-color:#f2dede; border:1px solid #ddd"></label>
        </td>
        <td>Biểu thị đã dừng</td>
        <td>
            <label style="height:7px;width:25px;background-color:white;  border:1px solid #ddd"></label>
        </td>
        <td>Biểu thị chưa thực hiện</td>
    </tr>
</table>
@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 4, 7, 8 },
    F7Text = "Mẫu",
    F8Text = "Gửi"
})
<script type="text/javascript">
    var respblh;//Kiểm tra số bệnh án
    var from = $.request("from");
    var patInfoObj = {};//Ghi sổ ngoại trú，Đối tượng thông tin cơ bản của bệnh nhân

    $('#btn_bottombutton_f3').attr('disabled', 'disabled');
    $('#btn_bottombutton_f6').attr('disabled', 'disabled');

    //Sau khi hoàn thành đăng ký ngoại trú，Chuyển sang，Khởi tạo
    var keyValue = sessionStorage.getItem("mzh");
    if (!!keyValue) {
        from = "mz";
        GetQueryFphAjax({ mzh: keyValue });
        sessionStorage.removeItem("mzh")
    }

    if (from == 'mz') {
        $('.mz').css("display", "block");
        $('.zy').css("display", "none");
        $('#jzsj').val($.getDate());
    }
    else {
        $('#StartDate').val($.getDate());
    }

    //Khai báo Chi tiết khoản mục grid
    $("#gridMX").newtouchLocalDataGrid({
        height: $(window).height() - 330,
        unwritten: false,
        colModel: [
            { label: "newid", name: "newid", width: 80, align: "left", hidden: true },
            { label: "jzjhmxId", name: "jzjhmxId", width: 80, align: "left", hidden: true },
            {
                label: 'Dài hạn/Tạm thời', name: 'yzxz', width: 60, hidden: (from == "mz" ? true : undefined), formatter: function (cellvalue) {
                    return cellvalue == "1" ? "Tạm thời" : "Dài hạn";
                }
            },
            { label: "Khoản mục thu phí", name: "sfxmCode", align: "left", hidden: true },
            { label: "Khoản mục thu phí", name: "sfxmmc", width: 250, align: "left" },
            { label: "Loại y lệnh", name: "yzlx", width: 150, align: "left", hidden: true },
            { label: "Loại", name: "sfdlCode", width: 50, align: "left", hidden: true },
            { label: "Loại chi phí", name: "sfdlmc", width: 55, align: "left" },
            { label: "Đơn vị", name: "dw", width: 40, align: "left" },
            {
                label: "Đơn giá( đồng)", name: "dj", width: 60, align: "left", formatter: "number"
                    , formatoptions: { decimalPlaces: 2, defaultValue: '0.00' }
            },
            { label: "Liều điều trị mỗi lần", name: "zll", width: 70, align: "left" },
            { label: (from == "mz" ? "Tổng số lần" : "Số lần"), name: "sl", width: 40, align: "left" },
            {
                label: "Trạng thái thực hiện", name: "zxzt", width: 65, align: "left", formatter: function (cellvalue) {
                    return cellvalue == 0 ? "Chưa thực hiện"
                        : cellvalue == 1 ? "Đang thực hiện"
                        : cellvalue == 2 ? "Đã hoàn thành"
                        : cellvalue == 3 ? "Đã dừng"
                        : ""; //Ngược lại hẳn là chưa gửi
                }
            },
            { label: "Thời gian thực hiện cuối cùng", name: "LastEexcutionTime", width: 50, align: "left", hidden: true },
            { label: "Ghi chú", name: "bz", align: "left", hidden: true },
            {
                label: "Ngày thu phí", name: "jzsj", width: 100, hidden: (from == "mz" ? undefined : true), formatter: function (val) {
                    if (!!val) {
                        return $.getDate({ date: val });
                    }
                    return "";
                }
            },
            {
                label: "Ngày kê đơn", name: "StartDate", width: 100, hidden: (from == "mz" ? true : undefined), formatter: function (val) {
                    if (!!val) {
                        var date = $.getDate({ date: val });
                        if (date < '2000-01-01') {
                            return '';  //Một phần dữ liệu lịch sử 1970-01-01
                        }
                        return date;
                    }
                    return "";
                }
            },
            { label: "czlx", name: "czlx", hidden: true },
            { label: "dwjls", name: "dwjls", hidden: true }
        ],
        ondblClickRow: function (rowid) {
            gridEditRow(rowid);
        },
        onSelectRow: function (rowid) {
            $('#btn_bottombutton_f3').removeAttr('disabled');
            $('#btn_bottombutton_f6').removeAttr('disabled');
        },
        gridComplete: function (data) {
            var ids = $("#gridMX").jqGrid('getDataIDs');
            for (var i = 0; i < ids.length; i++) {
                var rowData = $("#gridMX").jqGrid('getRowData', ids[i]);
                if (rowData && rowData.zxzt) {
                    if (rowData.zxzt === 'Đang thực hiện') {
                        $('#gridMX tr[id="' + ids[i] + '"]').addClass('info');
                    }
                    else if (rowData.zxzt === 'Đã hoàn thành') {
                        $('#gridMX tr[id="' + ids[i] + '"]').addClass('complete');
                    }
                    else if (rowData.zxzt === 'Đã dừng') {
                        $('#gridMX tr[id="' + ids[i] + '"]').addClass('danger');
                    }
                }
            }
        }
    });

    //Liên kết lớp nổi chọn khoản mục điều trị
    $('#mzh,#zyh').newtouchBatchFloatingSelector({
        width: 500,
        height: 200,
        caption: "Chọn bệnh nhân",
        clickautotrigger: true,
        url: "@Url.Action("PatAccountingSearchInfo")",
        ajaxparameters: function ($thisinput) {
            var keyword = $thisinput.val().trim();
            return "keyword=" + keyword + "&from=" + from +"&brzybzType=" + '@((int)EnumZYBZ.Bqz + "," + (int)EnumZYBZ.Djz)';
        },
        itemdbclickhandler: function ($thistr, $thisinput) {
            if (from =="mz") {
                GetQueryFphAjax({ mzh: $thistr.attr('data-mzh') });
            } else if (from=="zy") {
                getPatInfoAjax({ zyh: $thistr.attr('data-mzh') });
            }
           
        },
        colModel: [
            { label: 'Khóa chính', name: 'patid', hidden: true },
            { label: 'Số bệnh án', name: 'blh', width: 100, align: 'center' },
            { label: 'brxz', name: 'brxz', align: 'center', hidden: true },
            { label: 'Tính chất bệnh nhân', name: 'brxzmc', width: 80, align: 'center'},
            { label: from == 'mz' ? "Mã ngoại trú" : "Số nhập viện", name: 'mzh', width: 120, align: 'center', key: true },
            //{
            //    label: 'Thời gian đăng ký khám', name: 'ghsj', width: 120, align: 'left', hidden: true , formatter: function (cellvalue) {
            //        return cellvalue.length > 19 ? cellvalue.substring(0, 19).replace(/T/g, ' ') : ""
            //    }
            //},
            { label: 'Họ tên', name: 'xm', width: 90, align: 'center' },
            { label: 'Năm tháng sinh', name: 'csny', hidden: true, width: 100, align: 'center', hidden: true  },
            {
                label: 'Giới tính', name: 'xb', width: 40, align: 'center', formatter: function (cellvalue) {
                    return $.getGender(cellvalue);
                }
            },
            {
                label: 'Tuổi', name: 'nlshow', width: 50, align: 'center', formatter: function (cellvalue, options, rowObject) {
                    return getAgeFromBirthTime({ begin: rowObject.csny }).text;
                }
            }
        ]
    });

    $('#bz').keydownEnterEvent(function (event) {
        if ($('#bz').hasClass('form-an-cur')) { //Khuyết điểm-Từ cái trước enter chuyển sang
            $('#bz').removeClass('form-an-cur')
            return;
        }
        if (editingNewid || editingJzjhmxId) {
            $('#btn_bottombutton_f3').trigger('click');
        } else {
            $('#btn_bottombutton_f2').trigger('click');
        }
        return false;
    });

    //Liên kết lớp nổi chọn khoản mục điều trị
    $('#sfxmmc').sfxmFloatingSelector({
        djDecimalPlaces: 4,
        searchType: 'sfxm.dwjls',
        width: 850,
        ajaxparameters: function ($thisinput) {
            return "dllb=2&mzzybz=" + (from == 'mz' ? "1" : "2") + "&keyword=" + $.trim($thisinput.val());
        },
        clickautotrigger: true,
        itemdbclickhandler: function ($thistr, $thisinput) {
            if ($thisinput.attr('id') == 'sfxmmc') {
                $('#sfxmmc').val($thistr.attr('data-sfxmmc'));
                $('#sfxmCode').val($thistr.attr('data-sfxmCode'));
                $('#sfdlCode').val($thistr.attr('data-sfdlCode'));
                $('#yzlx').val($thistr.attr('data-yzlx'));
                $('#sfdlmc').val($thistr.attr('data-sfdlmc'));
                '@(jhjzDjEditable.ToString().ToLower())' === 'true'
                     ? $('#dj').val($thistr.attr('data-dj'))
                     : $('#dj').html($thistr.attr('data-dj'));
                $('#dw').html($thistr.attr('data-dw'));
                $('#dwjls').val($thistr.attr('data-dwjls'));
                $('#jjcl').val($thistr.attr('data-jjcl'));
                if (!(from == 'mz')) {
                    $('#sl').val('1');
                }
            }
        }
    });

    //Theo thời gian tạo Thứ tự ngược Sắp xếp， Mới tạo nhất Ở phía trước nhất
    var oldxmList = [];   //Khoản mục lịch sử đã gửi List
    var newxmList = [];   //Khoản mục mới List

    //Tới gridMX grid điền dữ liệu vào trong
    function fillDataToGrid() {
        $("#gridMX").resetSelection();
        $("#gridMX").clearGridData();
        $("#gridMX").newtouchLocalDataGrid({ posttofirst: false }, oldxmList);
        for (var i = 0; i <= newxmList.length; i++) {
            $("#gridMX").newtouchLocalDataGrid(null, newxmList[newxmList.length - i]);
        }
    }

    fillDataToGrid();

    //Kiểm tra dữ liệu đang chỉnh sửa（Chờ gửi）tính đầy đủ của
    function checkEditingRowData(rowData) {
        if (!rowData.sfxmCode || !rowData.sfxmmc || !rowData.yzlx || !rowData.sfdlCode || !rowData.sfdlmc) {
            $.modalAlert("Vui lòng chọn khoản mục thu phí", 'warning');
        }
        else if (rowData.dw == "") {
            $.modalAlert("Thiếu thông tin đơn vị khoản mục", 'warning');
        }
        else if (rowData.jjcl == "" || isNaN(rowData.jjcl)) {
            $.modalAlert("Thiếu chiến lược định giá của khoản mục", 'warning');
        }
        else if (rowData.dwjls == "" || isNaN(rowData.dwjls)) {
            $.modalAlert("Thiếu số lượng đo đơn vị của khoản mục", 'warning');
        }
        else if (rowData.yzlx == '2' && (rowData.zll == "" || isNaN(rowData.zll))) {
            $.modalAlert("Thiếu liều điều trị mỗi lần của khoản mục", 'warning');
        }
        else if (!((/^(\+|-)?\d+$/).test(rowData.zll)) || rowData.zll < 1) {
            $.modalAlert("Liều điều trị mỗi lần lớn hơn 0 số nguyên", 'warning');
        }
        else if (parseInt(rowData.dwjls) > parseInt(rowData.zll)) {
            $.modalAlert("Liều điều trị mỗi lần không thể nhỏ hơn số lượng đo mỗi lần", 'warning');
        }
        else if (!((/^(([1-9][0-9]*\.[0-9][0-9]*)|([0]\.[0-9][0-9]*)|([1-9][0-9]*)|([0]{1}))$/).test(rowData.dj))) {
            $.modalAlert("Đơn giá không nhỏ hơn 0 số", 'warning');
        }
        else if (rowData.dj == "" || isNaN(rowData.dj)) {
            $.modalAlert("Thiếu thông tin đơn giá khoản mục", 'warning');
        }
        else if (!rowData.jzsj && from == 'mz') {
            $.modalAlert("Thiếu ngày thu phí", 'warning');
        }
        else if (!rowData.StartDate && !(from == 'mz')) {
            $.modalAlert("Thiếu ngày kê đơn", 'warning');
        }
        else if (rowData.sl == "" || isNaN(rowData.sl)) {
            $.modalAlert("Thiếu số lần thực hiện", 'warning');
        }
        else if (!((/^(\+|-)?\d+$/).test(rowData.sl)) || rowData.sl < 1) {
            $.modalAlert("Số lần thực hiện lớn hơn 0 số nguyên", 'warning');
        }
        else {
            return true;
        }
        return false;
    }

    //Nút Sự kiện start

    //Nhập số nhập viện Tìm kiếm
    $('#btn_search').click(function () {
        var zyh = $('#zyh').val();
        newtouch_globalevent_f4();
        $('#zyh').val(zyh);
        ajaxLoadDataResult();
    });

    var respZyh;

    //Tải thông tin cơ bản nội trú
    function ajaxLoadDataResult() {
        var zyh = $('#zyh').val();
        if (zyh) {
            $.najax({
                type: "GET",
                url: "/HospitalizationManage/BookkeepInHos/GetAccountingStatusDetail?zyh=" + zyh,
                loading: true,
                success: function (ajaxresp) {
                    respZyh = ajaxresp.data.patInfo.zyh;
                    setPatInfoModel(ajaxresp.data.patInfo);
                    oldxmList = ajaxresp.data.jzjhList;

                    fillDataToGrid();
                    Clearjzxm();
                },
                errorCallback: function (err) {
                    newtouch_globalevent_f4();
                    $('#zyh').trigger('focus');
                }
            });
        }
        else {
            GetPatSerarchView();
        }
    }

    //Tải thông tin cơ bản ngoại trú，Lấy theo số bệnh án hoặc mã ngoại trú
    function GetQueryFphAjax(obj) {
        $.loading(true, "Đang yêu cầu dữ liệu...");
        $.ajax({
            type: "POST",
            url: "/OutpatientManage/OutpatientAccounting/GetpatientAccountInfoV4",
            data: { mzh: obj.mzh },
            dataType: "json",
            cache: true,
            async: true,
            success: function (ajaxresp) {
                if (ajaxresp.state === 'success') {
                    $("#gridMX").clearGridData();
                    oldxmList = [];   //Khoản mục lịch sử đã gửi List
                    newxmList = [];   //Khoản mục mới List
                    if (ajaxresp.data.length > 1) {
                        GetPatSerarchView(keyword);
                    } else {
                        if (!!ajaxresp.data.OutpatAccInfoDto) {
                            respblh = ajaxresp.data.OutpatAccInfoDto.mzh;
                            setPatInfoModel(ajaxresp.data.OutpatAccInfoDto); //Gán thông tin cơ bản cá nhân
                        }
                        if ((!!ajaxresp.data.OptimAccInfoDto) && ajaxresp.data.OptimAccInfoDto.length > 0) {
                            ajaxresp.data.OptimAccInfoDto.forEach(function (val, idx) {
                                ajaxresp.data.OptimAccInfoDto[idx].newid = null;//Xóa newid Giá trị，Đảm bảo logic ghi sổ nội trú và ngoại trú nhất quán
                            });
                            oldxmList = ajaxresp.data.OptimAccInfoDto;
                        }
                        fillDataToGrid();
                        Clearjzxm();
                    }
                } else if (ajaxresp.state === 'error') {
                    $.modalAlert("Tra cứu thất bại", 'error');
                }
            },
            complete: function () {
                $.loading(false);
            }
        });
    }


    //F6 Xóa khỏi danh sách
    function newtouch_event_f6() {
        //Lấy grid Dòng đang được chọn hiện tại
        var rowid = $('#gridMX').jqGrid('getGridParam', 'selrow');
        //Yêu cầu xóa dòng này
        if (rowid) {
            var rowData = $("#gridMX").jqGrid('getRowData', rowid);
            if (rowData) {
                if (!rowData.newid) {   //Dòng này không thể xóa，hẳn là thuộc về oldxmList
                    $.modalAlert("Ghi sổ đã gửi，Không thể xóa", 'warning');
                    return;
                }
                if (rowData.newid == editingNewid) {
                    $.modalAlert("Dòng này đang ở trạng thái chỉnh sửa，Không thể xóa", 'warning');
                    return; //Dòng này đang ở trạng thái chỉnh sửa，Không thể xóa
                }

                if (!!rowData.jzjhmxId) {
                    rowData.czlx = "2";
                }
                var matchedIndex = -1;

                if (newxmList.length > 0) {
                    for (var ii = 0; ii < newxmList.length; ii++) {
                        if (newxmList[ii].newid === rowData.newid) {
                            matchedIndex = ii;
                        }
                    }
                }

                if (matchedIndex === -1) {
                    if (oldxmList.length > 0) {
                        for (var ii = 0; ii < oldxmList.length; ii++) {
                            if (oldxmList[ii].jzjhmxId === rowData.jzjhmxId) {
                                matchedIndex = ii;
                            }
                        }
                    }
                    if (matchedIndex === -1) {
                        return; //hẳn là bất thường
                    }
                    oldxmList.remove(matchedIndex);   //Loại bỏ ghi sổ lịch sử
                } else {
                    newxmList.remove(matchedIndex);   //Loại bỏ ghi sổ mới
                }
                //chuyển lại xm mảng hiển thị tới grid
                fillDataToGrid();

                //Không ảnh hưởng tới các mục khác
            }
        }
    }


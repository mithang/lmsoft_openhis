    //Yêu cầu Chỉnh sửa Dòng
    function gridEditRow(rowid) {
        if (rowid) {
            var rowData = $("").jqGrid('', rowid);
            if (rowData) {
                //20180910add Không thể sửa của đã gửi
                if (!rowData.newid) {
                    $.modalAlert("", '');
                    return;
                }
                //20180910add Không thể sửa của đã gửi
                if (rowData.newid) {
                    //Có lẽ thuộc vềnewxmList start
                    rowDataArr = $.jsonWhere(newxmList, function (v) {
                        return v && v.newid == rowData.newid;
                    });
                    if (!rowDataArr || rowDataArr.length == 0) {
                        return; //Tại sao không tìm thấy
                    }
                    rowData = rowDataArr[0];  //Thông quarowData.newidLấy dữ liệu dòng đó từ mảng đối tượng
                    if (true) { //&&Có thể chỉnh sửa
                        editingJzjhmxId = null;
                        editingNewid = rowData.newid;    //Dòng đang sửa
                    }
                    else {
                        return;
                    }
                    //Có lẽ thuộc vềnewxmList end
                }
                else if (rowData.jzjhmxId) {
                    //Có lẽ thuộc vềoldxmList start
                    //dòng yêu cầu đã gửi chỉnh sửa
                    if (rowData.zxzt == "" || rowData.zxzt == "" || rowData.zxzt == "") {
                        //oldxmListsửa lần nhiều của trong rowData.zxzt undifined 也没问题
                        $.modalAlert("", '');
                        return;
                    }
                    $('').attr('', '').addClass('');//Không thể sửa hạng mục thu phí
                    rowDataArr = $.jsonWhere(oldxmList, function (v) {
                        return v && v.jzjhmxId == rowData.jzjhmxId;
                    });
                    if (!rowDataArr || rowDataArr.length == 0) {
                        return; //Tại sao không tìm thấy
                    }
                    rowData = rowDataArr[0];  //Thông quarowData.jzjhmxIdLấy dữ liệu dòng đó từ mảng đối tượng
                    if (true) { //&&Có thể chỉnh sửa
                        editingJzjhmxId = rowData.jzjhmxId;
                        editingNewid = null;    //Dòng đang sửa
                    }
                    else {
                        return;
                    }
                    //Có lẽ thuộc vềoldxmList end
                }
                if (!(from == '')) {
                    $('' + rowData.yzxz + '').trigger('');
                }
                //old new common
                //Tuần tự hóa vào vùng chỉnh sửa
                $('').val(rowData.sfxmmc);
                $('').val(rowData.sfxmCode);
                $('').val(rowData.yzlx);
                $('').val(rowData.sfdlCode);
                $('').val(rowData.sfdlmc);
                $('').html(rowData.dw);
                '' === ''
                    ? $('').val(parseFloat(!!rowData.dj ? rowData.dj : 0).toFixed(2))
                    : $('').html(parseFloat(!!rowData.dj ? rowData.dj : 0).toFixed(2));
                $('').val(rowData.zll);
                $('').val(rowData.sl);
                $('').val(rowData.bz);
                if (!!rowData.jzsj) {
                    $('').val($.getDate({ date: rowData.jzsj, ute: true }));
                }
                if (!!rowData.StartDate) {
                    if ($.getDate({ date: rowData.StartDate }) > '') {
                        $('').val($.getDate({ date: rowData.StartDate, ute: true }));
                    }
                    else {
                        //强制补录开单日期
                        $('').val('');
                    }
                }
                $('').val(rowData.jzjhmxId);
                $('').val(rowData.czlx);
                $('').val(rowData.dwjls);
                $('').val(rowData.jjcl);
                $('').attr('', '');
                $('').show();

                $('').attr('', '');
            }
        }
    }


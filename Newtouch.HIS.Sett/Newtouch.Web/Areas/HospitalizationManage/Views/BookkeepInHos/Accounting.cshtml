    function mzsubmit() {
        var paramData = [];
        patInfoObj.brxz = $("").val();
        //paramData.xmList = newxmList;
        var resultxmList = [];
        $.each(newxmList, function () {
            resultxmList.push(this);
        });

        //oldxmListchỉnh sửa trong pushĐếnresultxmListTrong Đồng thời Máy chủ gửi tới
        $.each(oldxmList, function () {
            if (this.czlx !== undefined && this.czlx !== null) {
                //zxzt undifined 一定是 Gửi lịch sử ， Và Sửa lần này
                resultxmList.unshift(this);   //Thêm dưới dạng mục mới    //”Đầu mảng“
            }
        });
        paramData.xmList = resultxmList;
        if (!patInfoObj.mzh) {
            $.modalAlert("", '');
            return;
        }
        if (!paramData.xmList || paramData.xmList.length === 0) {
            $.modalAlert("", '');
            return;
        }
        if (patInfoObj.mzh !== respblh) {
            $.modalAlert("", '');
            return;
        }
        $.submitForm({
            url: "",
            param: { bacDto: patInfoObj, xmList: paramData.xmList },
            success: function (ajaxresp) {
                newtouch_globalevent_f4();
                $('').trigger('');
            }
        });
    }

    function zysubmit() {
        var paramData = {};
        paramData.zyh = $('').val();

        var resultxmList = [];
        $.each(newxmList, function () {
            resultxmList.push(this);
        });

        //oldxmListchỉnh sửa trong pushĐếnresultxmListTrong Đồng thời Máy chủ gửi tới
        $.each(oldxmList, function () {
            if (this.czlx !== undefined && this.czlx !== null) {
                //zxzt undifined 一定是 Gửi lịch sử ， Và Sửa lần này
                resultxmList.unshift(this);   //Thêm dưới dạng mục mới    //”Đầu mảng“
            }
        });
        paramData.xmList = resultxmList;
        if (!paramData.zyh) {
            $.modalAlert("", '');
            return;
        }
        if (paramData.zyh != respZyh) {
            $.modalAlert("", '');
            return;
        }
        if (!paramData.xmList || paramData.xmList.length == 0) {
            $.modalAlert("", '');
            return;
        }

        for (var k = 0, length = paramData.xmList.length; k < length; k++) {
            if (!checkEditingRowData(paramData.xmList[k])) {
                return;
            }
        }

        $.submitForm({
            url: '',
            param: paramData,
            success: function (data) {
                newtouch_globalevent_f4();
                $('').trigger('');
            }
        });
    }


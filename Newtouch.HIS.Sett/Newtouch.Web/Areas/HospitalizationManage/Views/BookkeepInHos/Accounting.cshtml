                        </td>
                        <th class="formTitle">Họ tên：</th>
                        <td class="formValue">
                            <label id="mz_xm" style="width: 150%"></label>
                        </td>
                        <th class="formTitle">Giới tính：</th>
                        <td class="formValue">
                            <label id="mz_xb"></label>
                        </td>
                        <th class="formTitle">Tuổi：</th>
                        <td class="formValue">
                            <label id="mz_nl"></label>
                        </td>
                    </tr>
                    <tbody class="dispTbody" style="display:none;">

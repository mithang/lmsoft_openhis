                $.modalAlert("Thiếu thông tin cơ bản của bệnh nhân", 'warning');
                return;
            }
            if (zyh != respZyh) {
                $.modalAlert("Lỗi：Trong quá trình nhập，Số nhập viện thay đổi", 'warning');
                return;
            }
        }
        var addgoon = function () {
            data.czlx = "0";//Thêm mới
            data.zxzt = 0;//Mặc định chưa thực hiện
            //Kiểm tra mục trùng lặp

            data.newid = Math.random().toString() + new Date().getMilliseconds();   //newid()

            newxmList.unshift(data);   //Thêm dưới dạng mục mới //”Đầu trước nhất của mảng“

            //chuyển lại xm mảng hiển thị tới grid
            fillDataToGrid();

            $('#sfxmmc').val('');
            $('#sfxmCode').val('');
            $('#yzlx').val('');
            $('#sfdlCode').val('');
            $('#sfdlmc').val('');
            $('#dw').html('');
            '@(jhjzDjEditable.ToString().ToLower())' === 'true'
                ? $('#dj').val('')
                : $('#dj').html('');
            $('#zll').val('');
            $('#dwjls').val('');
            $('#jjcl').val('');
            $('#sl').val('');
            $("#mz_czlx").val('');
            setTimeout("$('#sfxmmc').trigger('focus');$('#sfxmmc').trigger('click');", 100);
        }
        var data = getEditRowData();
        if (!(CheckreAdddata(data) && checkEditingRowData(data))) {    //Dữ liệu có đầy đủ hay không，Kiểm tra mục bắt buộc
            return;
        }
        if (data && parseFloat(data.dj) < '0') {
            $.modalAlert("Đơn giá không nhỏ hơn 0 số", 'warning');
            return;
        }
        else if (data && parseFloat(data.dj) == '0') {
            $.modalConfirm("Đơn giá là 0，Xác nhận có thêm hay không", function (flag) {
                if (!flag) {
                    return;
                }
                else {
                    addgoon();
                }
            });
        }
        else {
            addgoon();
        }
    }

    //Nút sửa
    function newtouch_event_f3() {
        if (editingNewid && editingJzjhmxId) {
            $.modalConfirm("Chương trình bất thường，Sẽ tự động làm mới trang", function (flag) {
                location.href = location.href;
            });
            return; //Lỗi chương trình
        }
        if (editingNewid || editingJzjhmxId) {
            //Gửi sửa đổi
            var data = getEditRowData();
            if (!(checkEditingRowData(data))) {    //Dữ liệu có đầy đủ hay không，Kiểm tra mục bắt buộc
                return;
            }
            var updategoon = function () {

                data.newid = editingNewid;
                data.jzjhmxId = editingJzjhmxId;
                data.zxzt = 0;//Dữ liệu sau khi sửa mặc định chưa thực hiện
                if (!!data.jzjhmxId) {//Xác định có phải dữ liệu mới thêm hay không
                    data.czlx = "1";//Sửa
                    $('#sfxmmc').removeAttr('disabled', 'disabled').removeClass('newtouch_Readonly');
                }
                //Kiểm tra mục trùng lặp

                //Trước tiên tại xm tìm trong mảng
                if (editingNewid) {
                    var matchedIndex = -1;
                    for (var ii = 0; ii < newxmList.length; ii++) {
                        if (newxmList[ii].newid == data.newid) {
                            matchedIndex = ii;
                            break;
                        }
                    }
                    if (matchedIndex == -1) {
                        return; //hẳn là bất thường
                    }
                    newxmList.remove(matchedIndex);   //Loại bỏ mục này
                    newxmList.unshift(data);   //Thêm dưới dạng mục mới    //”Đầu trước nhất của mảng“
                }
                else {  //editingJzjhmxId
                    var matchedIndex = -1;
                    for (var ii = 0; ii < oldxmList.length; ii++) {
                        if (oldxmList[ii].jzjhmxId == data.jzjhmxId) {
                            matchedIndex = ii;
                            data.LastEexcutionTime = oldxmList[ii].LastEexcutionTime;//Thời gian thực hiện cuối cùng đừng để mất，Mặc dù không cần truyền tới phía máy chủ
                            break;
                        }
                    }
                    if (matchedIndex == -1) {
                        return; //hẳn là bất thường
                    }
                    oldxmList.remove(matchedIndex);   //Loại bỏ mục này
                    oldxmList.unshift(data);   //Thêm dưới dạng mục mới    //”Đầu trước nhất của mảng“
                }

                //chuyển lại xm mảng hiển thị tới grid
                fillDataToGrid();
                $('#sfxmmc').val('');
                $('#sfxmCode').val('');
                $('#yzlx').val('');
                $('#sfdlCode').val('');
                $('#sfdlmc').val('');
                $('#dw').html('');
                '@(jhjzDjEditable.ToString().ToLower())' === 'true'
                    ? $('#dj').val('')
                    : $('#dj').html('');
                $('#zll').val('');
                $('#dwjls').val('');
                $('#jjcl').val('');
                $('#sl').val('');
                $('#mz_czlx').val('');
                $('#jzjhmxId').val('');
                //$('#bz').val('');

                editingNewid = null;    //Dòng đang sửa
                editingJzjhmxId = null;    //Dòng đang sửa

                bottomButtonsReset();

                setTimeout("$('#sfxmmc').trigger('focus');$('#sfxmmc').trigger('click');", 100);
            }
            if (data && parseFloat(data.dj) < '0') {
                $.modalAlert("Đơn giá không nhỏ hơn 0 số", 'warning');
                return;
            }
            else if (data && parseFloat(data.dj) == '0') {
                $.modalConfirm("Đơn giá là 0，Xác nhận có sửa hay không", function (flag) {
                    if (!flag) {
                        return;
                    }
                    else {
                        updategoon();
                    }
                });
            }
            else {
                updategoon();
            }
        }
        else {
            //Lấy grid Dòng đang được chọn hiện tại
            var seleId = $('#gridMX').jqGrid('getGridParam', 'selrow');
            if (seleId) {
                //Yêu cầu sửa dòng này

            $('').val('');
            $('').val('');
            $('').val('');
            $("").val('');
            setTimeout("", 100);
        }
        var data = getEditRowData();
        if (!(CheckreAdddata(data) && checkEditingRowData(data))) {    //Dữ liệu đã đầy đủ chưa，Kiểm tra các mục bắt buộc
            return;
        }
        if (data && parseFloat(data.dj) < '') {

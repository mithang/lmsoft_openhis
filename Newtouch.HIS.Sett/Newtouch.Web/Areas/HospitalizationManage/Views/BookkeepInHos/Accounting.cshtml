@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 4, 7, 8 },
    F7Text = "",
    F8Text = ""
})
<script type="">
    var respblh;//Xác minh số bệnh án
    var from = $.request("");
    var patInfoObj = {};//Ghi sổ ngoại trú，Đối tượng thông tin cơ bản bệnh nhân

    $('').attr('', '');
    $('').attr('', '');

    //Sau hoàn thành đăng ký ngoại trú，跳转过来，Khởi tạo
    var keyValue = sessionStorage.getItem("");
    if (!!keyValue) {
        from = "";
        GetQueryFphAjax({ mzh: keyValue });
        sessionStorage.removeItem("")
    }

    if (from == '') {
        $('').css("", "");
        $('').css("", "");
        $('').val($.getDate());
    }
    else {
        $('').val($.getDate());
    }

    //Khai báo Chi tiết hạng mục grid
    $("").newtouchLocalDataGrid({
        height: $(window).height() - 330,
        unwritten: false,
        colModel: [
            { label: "", name: "", width: 80, align: "", hidden: true },
            { label: "", name: "", width: 80, align: "", hidden: true },
            {
                label: '', name: '', width: 60, hidden: (from == "" ? true : undefined), formatter: function (cellvalue) {
                    return cellvalue == "" ? "" : "";
                }
            },
            { label: "", name: "", align: "", hidden: true },
            { label: "", name: "", width: 250, align: "" },
            { label: "", name: "", width: 150, align: "", hidden: true },
            { label: "", name: "", width: 50, align: "", hidden: true },
            { label: "", name: "", width: 55, align: "" },
            { label: "", name: "", width: 40, align: "" },
            {
                label: "", name: "", width: 60, align: "", formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }
            },
            { label: "", name: "", width: 70, align: "" },
            { label: (from == "" ? "" : ""), name: "", width: 40, align: "" },
            {
                label: "", name: "", width: 65, align: "", formatter: function (cellvalue) {
                    return cellvalue == 0 ? ""
                        : cellvalue == 1 ? ""
                        : cellvalue == 2 ? ""
                        : cellvalue == 3 ? ""
                        : ""; //Nên nếu không là chưa gửi
                }
            },
            { label: "", name: "", width: 50, align: "", hidden: true },
            { label: "", name: "", align: "", hidden: true },
            {
                label: "", name: "", width: 100, hidden: (from == "" ? undefined : true), formatter: function (val) {
                    if (!!val) {
                        return $.getDate({ date: val });
                    }
                    return "";
                }
            },
            {
                label: "", name: "", width: 100, hidden: (from == "" ? true : undefined), formatter: function (val) {
                    if (!!val) {
                        var date = $.getDate({ date: val });
                        if (date < '') {
                            return '';  //Dữ liệu lịch sử một phần một1970-01-01
                        }
                        return date;
                    }
                    return "";
                }
            },
            { label: "", name: "", hidden: true },
            { label: "", name: "", hidden: true }
        ],
        ondblClickRow: function (rowid) {
            gridEditRow(rowid);
        },
        onSelectRow: function (rowid) {
            $('').removeAttr('');
            $('').removeAttr('');
        },
        gridComplete: function (data) {
            var ids = $("").jqGrid('');
            for (var i = 0; i < ids.length; i++) {
                var rowData = $("").jqGrid('', ids[i]);
                if (rowData && rowData.zxzt) {
                    if (rowData.zxzt === '') {
                        $('' + ids[i] + '').addClass('');
                    }
                    else if (rowData.zxzt === '') {
                        $('' + ids[i] + '').addClass('');
                    }
                    else if (rowData.zxzt === '') {
                        $('' + ids[i] + '').addClass('');
                    }
                }
            }
        }
    });

    //Liên kết lớp nổi chọn hạng mục điều trị
    $('').newtouchBatchFloatingSelector({
        width: 500,
        height: 200,
        caption: "",
        clickautotrigger: true,
        url: ""PatAccountingSearchInfo"",
        ajaxparameters: function ($thisinput) {
            var keyword = $thisinput.val().trim();
            return "" + keyword + "" + from +"" + '';
        },
        itemdbclickhandler: function ($thistr, $thisinput) {
            if (from =="") {
                GetQueryFphAjax({ mzh: $thistr.attr('') });
            } else if (from=="") {
                getPatInfoAjax({ zyh: $thistr.attr('') });
            }
           
        },
        colModel: [
            { label: '', name: '', hidden: true },
            { label: '', name: '', width: 100, align: '' },
            { label: '', name: '', align: '', hidden: true },
            { label: '', name: '', width: 80, align: ''},
            { label: from == '' ? "" : "", name: '', width: 120, align: '', key: true },
            //{
            //    label: '', name: '', width: 120, align: '', hidden: true , formatter: function (cellvalue) {
            //        return cellvalue.length > 19 ? cellvalue.substring(0, 19).replace(/T/g, '') : ""
            //    }
            //},
            { label: '', name: '', width: 90, align: '' },
            { label: '', name: '', hidden: true, width: 100, align: '', hidden: true  },
            {
                label: '', name: '', width: 40, align: '', formatter: function (cellvalue) {
                    return $.getGender(cellvalue);
                }
            },
            {
                label: '', name: '', width: 50, align: '', formatter: function (cellvalue, options, rowObject) {
                    return getAgeFromBirthTime({ begin: rowObject.csny }).text;
                }
            }
        ]
    });

    $('').keydownEnterEvent(function (event) {
        if ($('').hasClass('')) { //Khuyết điểm-Từ cái trướcenterđã qua
            $('').removeClass('')
            return;
        }
        if (editingNewid || editingJzjhmxId) {
            $('').trigger('');
        } else {
            $('').trigger('');
        }
        return false;
    });

    //Liên kết lớp nổi chọn hạng mục điều trị
    $('').sfxmFloatingSelector({
        djDecimalPlaces: 4,
        searchType: '',
        width: 850,
        ajaxparameters: function ($thisinput) {
            return "" + (from == '' ? "" : "") + "" + $.trim($thisinput.val());
        },
        clickautotrigger: true,
        itemdbclickhandler: function ($thistr, $thisinput) {
            if ($thisinput.attr('') == '') {
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                '' === ''
                     ? $('').val($thistr.attr(''))
                     : $('').html($thistr.attr(''));
                $('').html($thistr.attr(''));
                $('').val($thistr.attr(''));
                $('').val($thistr.attr(''));
                if (!(from == '')) {
                    $('').val('');
                }
            }
        }
    });

    //按创建时间 倒叙 排列， 最新创建的 在最前
    var oldxmList = [];   //Các hạng mục đã gửi trước đâyList
    var newxmList = [];   //Hạng mục mớiList

    //TớigridMX gridđiền dữ liệu vào trong
    function fillDataToGrid() {
        $("").resetSelection();
        $("").clearGridData();
        $("").newtouchLocalDataGrid({ posttofirst: false }, oldxmList);
        for (var i = 0; i <= newxmList.length; i++) {
            $("").newtouchLocalDataGrid(null, newxmList[newxmList.length - i]);
        }
    }

    fillDataToGrid();

    //Kiểm tra dữ liệu đang chỉnh sửa（Chờ gửi）tính đầy đủ của
    function checkEditingRowData(rowData) {
        if (!rowData.sfxmCode || !rowData.sfxmmc || !rowData.yzlx || !rowData.sfdlCode || !rowData.sfdlmc) {
            $.modalAlert("", '');
        }
        else if (rowData.dw == "") {
            $.modalAlert("", '');
        }
        else if (rowData.jjcl == "" || isNaN(rowData.jjcl)) {
            $.modalAlert("", '');
        }
        else if (rowData.dwjls == "" || isNaN(rowData.dwjls)) {
            $.modalAlert("", '');
        }
        else if (rowData.yzlx == '' && (rowData.zll == "" || isNaN(rowData.zll))) {
            $.modalAlert("", '');
        }
        else if (!((/^(\+|-)?\d+$/).test(rowData.zll)) || rowData.zll < 1) {
            $.modalAlert("", '');
        }
        else if (parseInt(rowData.dwjls) > parseInt(rowData.zll)) {
            $.modalAlert("", '');
        }
        else if (!((/^(([1-9][0-9]*\.[0-9][0-9]*)|([0]\.[0-9][0-9]*)|([1-9][0-9]*)|([0]{1}))$/).test(rowData.dj))) {
            $.modalAlert("", '');
        }
        else if (rowData.dj == "" || isNaN(rowData.dj)) {
            $.modalAlert("", '');
        }
        else if (!rowData.jzsj && from == '') {
            $.modalAlert("", '');
        }
        else if (!rowData.StartDate && !(from == '')) {
            $.modalAlert("", '');
        }
        else if (rowData.sl == "" || isNaN(rowData.sl)) {
            $.modalAlert("", '');
        }
        else if (!((/^(\+|-)?\d+$/).test(rowData.sl)) || rowData.sl < 1) {
            $.modalAlert("", '');
        }
        else {
            return true;
        }
        return false;
    }

    //Nút Sự kiện start

    //键入住院号 Tìm kiếm
    $('').click(function () {
        var zyh = $('').val();
        newtouch_globalevent_f4();
        $('').val(zyh);
        ajaxLoadDataResult();
    });

    var respZyh;

    //Tải thông tin cơ bản nhập viện
    function ajaxLoadDataResult() {
        var zyh = $('').val();
        if (zyh) {
            $.najax({
                type: "",
                url: "" + zyh,
                loading: true,
                success: function (ajaxresp) {
                    respZyh = ajaxresp.data.patInfo.zyh;
                    setPatInfoModel(ajaxresp.data.patInfo);
                    oldxmList = ajaxresp.data.jzjhList;

                    fillDataToGrid();
                    Clearjzxm();
                },
                errorCallback: function (err) {
                    newtouch_globalevent_f4();
                    $('').trigger('');
                }
            });
        }
        else {
            GetPatSerarchView();
        }
    }

    //Tải thông tin cơ bản ngoại trú，根据病历号或者门诊号获取
    function GetQueryFphAjax(obj) {
        $.loading(true, "");
        $.ajax({
            type: "",
            url: "",
            data: { mzh: obj.mzh },
            dataType: "",
            cache: true,
            async: true,
            success: function (ajaxresp) {
                if (ajaxresp.state === '') {
                    $("").clearGridData();
                    oldxmList = [];   //Các hạng mục đã gửi trước đâyList
                    newxmList = [];   //Hạng mục mớiList
                    if (ajaxresp.data.length > 1) {
                        GetPatSerarchView(keyword);
                    } else {
                        if (!!ajaxresp.data.OutpatAccInfoDto) {
                            respblh = ajaxresp.data.OutpatAccInfoDto.mzh;
                            setPatInfoModel(ajaxresp.data.OutpatAccInfoDto); //Gán thông tin cơ bản cá nhân
                        }
                        if ((!!ajaxresp.data.OptimAccInfoDto) && ajaxresp.data.OptimAccInfoDto.length > 0) {
                            ajaxresp.data.OptimAccInfoDto.forEach(function (val, idx) {
                                ajaxresp.data.OptimAccInfoDto[idx].newid = null;//Xóa trốngnewidGiá trị，保证住院和门诊记账逻辑一致
                            });
                            oldxmList = ajaxresp.data.OptimAccInfoDto;
                        }
                        fillDataToGrid();
                        Clearjzxm();
                    }
                } else if (ajaxresp.state === '') {
                    $.modalAlert("", '');
                }
            },
            complete: function () {
                $.loading(false);
            }
        });
    }

    //Khởi tạo thông tin bệnh nhân
    function setPatInfoModel(patModel) {
        if (from == '') {
            $("").val('' === "" ? patModel.blh : patModel.mzh);
            $("").html('' === "" ? patModel.mzh : patModel.blh);
            $("").html($.getGender(patModel.xb));
            $("").html((patModel.csny && patModel.csny.length >= 10 ? patModel.csny.substring(0, 10) : ""));
            $("").html(patModel.zjh);
            $("").html(patModel.jsr);
            $("").html(patModel.xm);
            $("").html(getAgeFromBirthTime({ begin: patModel.csny }).text);
            $("").html(patModel.phone);
            if (patModel.sycs) {
                $('').html("" + patModel.sycs + "");
            }
            $("").val(patModel.brxz);
            //Tải thông tin bệnh nhân
            patInfoObj.xm = patModel.xm; //Họ tên
            patInfoObj.xb = patModel.xb; //Giới tính
            patInfoObj.csny = patModel.csny;
            patInfoObj.patid = patModel.patid; //Mã nội bộ bệnh nhân
            patInfoObj.blh = patModel.blh; //Số bệnh án
            patInfoObj.zjh = patModel.zjh; //Số giấy tờ
            patInfoObj.brxz = patModel.brxz;//Tính chất bệnh nhân
            patInfoObj.mzh = patModel.mzh;//Số ngoại trú
        } else {
            $('').html(patModel.xm);
            $('').html($.getGender(patModel.xb));
            $("").html(getAgeFromBirthTime({ begin: patModel.csny }).text);
            $('').html(patModel.ryzdmc);
            $('').html(patModel.zjh);
            $('').html(patModel.phone);
            $('').html(patModel.csny ? patModel.csny.substring(0, 10) : '');
            $('').html(patModel.ryrq ? patModel.ryrq.substring(0, 10) : '');
            $('').html(patModel.brxzmc);
        }

    }

    //Bệnh nhân đã chọn callback
    function getPatInfoAjax(selePatInfo) {
        $('').val(selePatInfo.zyh);
        ajaxLoadDataResult();
    }

    //Tra cứu bệnh nhân(门诊或者住院)
    function GetPatSerarchView(keyword) {
        if (from == '') {//Thông tin bệnh nhân ngoại trú
            var blh = '' === "" ? keyword : null;
            var mzh = '' === "" ? null : keyword;
            $.modalOpen({
                id: "",
                title: "",
                url: "" + Math.random() + "" + mzh + "" + blh,
                width: "",
                height: "",
                callBack: function (iframeId) {
                    top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
                }
            });
        } else {//Thông tin bệnh nhân nhập viện
            var zyh;
            if (keyword != "" && typeof (keyword) != undefined) {
                zyh = keyword;
            }
            $.modalOpen({
                id: "",
                title: "",
                url: "" + '' + "" + Math.random() + "" + zyh,
                width: "",
                height: "",
                callBack: function (iframeId) {
                    top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
                    //Gọi tra cứu số thẻ và số nhập viện
                }//Hàm callback xác nhận khi nhấn cửa sổ
            });
        }

    }

    //Lấy dữ liệu đối tượng của vùng chỉnh sửa
    function getEditRowData() {
        var data = {
            yzxz: (from == '' ? ($('').val() == 1 ? "" : "") : $('').val()),
            sfxmCode: $('').val(),

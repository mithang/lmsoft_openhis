    //Nút sửa
    function newtouch_event_f3() {
        if (editingNewid && editingJzjhmxId) {
            $.modalConfirm("", function (flag) {
                location.href = location.href;
            });
            return; //Chương trình lỗi
        }
        if (editingNewid || editingJzjhmxId) {
            //Gửi sửa đổi
            var data = getEditRowData();
            if (!(checkEditingRowData(data))) {    //Dữ liệu đã đầy đủ chưa，Kiểm tra các mục bắt buộc
                return;
            }
            var updategoon = function () {

                data.newid = editingNewid;
                data.jzjhmxId = editingJzjhmxId;
                data.zxzt = 0;//thực hiện chưa mặc định dữ liệu sửa sau
                if (!!data.jzjhmxId) {//Đánh giá có thêm mới dữ liệu không
                    data.czlx = "";//Sửa
                    $('').removeAttr('', '').removeClass('');
                }
                //Kiểm tra mục trùng lặp

                //Trước tiên trongxmtìm trong mảng
                if (editingNewid) {
                    var matchedIndex = -1;
                    for (var ii = 0; ii < newxmList.length; ii++) {
                        if (newxmList[ii].newid == data.newid) {
                            matchedIndex = ii;
                            break;
                        }
                    }
                    if (matchedIndex == -1) {
                        return; //Có lẽ là bất thường
                    }
                    newxmList.remove(matchedIndex);   //Xóa mục này
                    newxmList.unshift(data);   //Thêm dưới dạng mục mới    //”Đầu mảng“
                }
                else {  //editingJzjhmxId
                    var matchedIndex = -1;
                    for (var ii = 0; ii < oldxmList.length; ii++) {
                        if (oldxmList[ii].jzjhmxId == data.jzjhmxId) {
                            matchedIndex = ii;
                            data.LastEexcutionTime = oldxmList[ii].LastEexcutionTime;//最后执行时间不要丢，虽然不需要传到服务器端
                            break;
                        }
                    }
                    if (matchedIndex == -1) {
                        return; //Có lẽ là bất thường
                    }
                    oldxmList.remove(matchedIndex);   //Xóa mục này
                    oldxmList.unshift(data);   //Thêm dưới dạng mục mới    //”Đầu mảng“
                }

                //Lại đưaxmMảng hiển thị tớigrid
                fillDataToGrid();
                $('').val('');
                $('').val('');
                $('').val('');
                $('').val('');
                $('').val('');
                $('').html('');
                '' === ''
                    ? $('').val('')
                    : $('').html('');
                $('').val('');
                $('').val('');
                $('').val('');
                $('').val('');
                $('').val('');
                $('').val('');
                //$('').val('');

                editingNewid = null;    //Dòng đang sửa
                editingJzjhmxId = null;    //Dòng đang sửa

                bottomButtonsReset();

                setTimeout("", 100);
            }
            if (data && parseFloat(data.dj) < '') {
                $.modalAlert("", '');
                return;
            }
            else if (data && parseFloat(data.dj) == '') {
                $.modalConfirm("", function (flag) {
                    if (!flag) {
                        return;
                    }
                    else {
                        updategoon();
                    }
                });
            }
            else {
                updategoon();
            }
        }
        else {
            //LấygridDòng đang được chọn hiện tại
            var seleId = $('').jqGrid('', '');
            if (seleId) {
                //Yêu cầu sửa dòng đó
                gridEditRow(seleId);
            }
        }
    }


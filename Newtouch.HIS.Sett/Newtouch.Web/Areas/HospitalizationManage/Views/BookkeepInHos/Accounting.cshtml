    //F6Xóa khỏi danh sách
    function newtouch_event_f6() {
        //LấygridDòng đang được chọn hiện tại
        var rowid = $('').jqGrid('', '');
        //Yêu cầu xóa dòng đó
        if (rowid) {
            var rowData = $("").jqGrid('', rowid);
            if (rowData) {
                if (!rowData.newid) {   //Dòng này không thể xóa，Có lẽ thuộc vềoldxmList
                    $.modalAlert("", '');
                    return;
                }
                if (rowData.newid == editingNewid) {
                    $.modalAlert("", '');
                    return; //Dòng này đang ở trạng thái chỉnh sửa，Không thể xóa
                }

                if (!!rowData.jzjhmxId) {
                    rowData.czlx = "";
                }
                var matchedIndex = -1;

                if (newxmList.length > 0) {
                    for (var ii = 0; ii < newxmList.length; ii++) {
                        if (newxmList[ii].newid === rowData.newid) {
                            matchedIndex = ii;
                        }
                    }
                }

                if (matchedIndex === -1) {
                    if (oldxmList.length > 0) {
                        for (var ii = 0; ii < oldxmList.length; ii++) {
                            if (oldxmList[ii].jzjhmxId === rowData.jzjhmxId) {
                                matchedIndex = ii;
                            }
                        }
                    }
                    if (matchedIndex === -1) {
                        return; //Có lẽ là bất thường
                    }
                    oldxmList.remove(matchedIndex);   //Ghi sổ lịch sử xóa
                } else {
                    newxmList.remove(matchedIndex);   //Ghi sổ mới xóa
                }
                //Lại đưaxmMảng hiển thị tớigrid
                fillDataToGrid();

                //Không ảnh hưởng gì đến các dòng khác
            }
        }
    }


@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="rows" style="margin-bottom: 1%;">
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading navb-bg">
            Thông tin bệnh nhân nhập viện
        </div>
        <table class="form" style="width:96%;">
            <tbody>
                <tr>
                    <th class="formTitle">Số nhập viện：</th>
                    <td class="formValue">
                        <input class="form-control" type="text" id="zyh" value="" />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-default btn-md btn-default-color" title="Chọn bệnh nhân nhập viện" style="" id="zy_btnsyy" value="Tra cứu" onclick="GetPatSerarchView($('#zyh').val());">
                    </td>
                    <th class="formTitle">Thời gian bắt đầu：</th>
                    <td class="formValue" style="width:113px;">
                        <label id="startTime"></label>
                    </td>
                    <th class="formTitle">Thời gian kết thúc：</th>
                    <td class="formValue" style="width:143px;">
                        <input id="endTime" type="text" class="form-control input-wdatepicker form-an formClearIgnore"
                               onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss', onpicked: function () { thenreload(); } })" value="@(System.DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))" />
                    </td>
                    <th class="formTitle">Họ tên：</th>
                    <td class="formValue">
                        <label id="zy_xm"></label>
                    </td>
                    <th class="formTitle">Giới tính：</th>
                    <td class="formValue">
                        <label id="zy_xb"></label>
                    </td>
                </tr>
            </tbody>
            <tbody class="dispTbody" style="display:none;">
                <tr>
                    <th class="formTitle">Tuổi：</th>
                    <td class="formValue" colspan="2">
                        <label id="zy_nl"></label>
                    </td>
                    <th class="formTitle">Số giấy tờ：</th>
                    <td class="formValue">
                        <label id="zy_zjh"></label>
                    </td>
                    <th class="formTitle">Chẩn đoán nhập viện：</th>
                    <td class="formValue">
                        <label id="zy_ryzd"></label>
                    </td>
                    <th class="formTitle">Ngày sinh：</th>
                    <td class="formValue">
                        <label id="zy_csny"></label>
                    </td>
                    <th class="formTitle">Ngày nhập viện：</th>
                    <td class="formValue">
                        <label id="zy_ryrq"></label>
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="fa_icontoggle"><i class="fa fa-angle-double-down icontoggle" style="color:rgb(0, 160, 233);cursor:pointer;"></i></div>
    </div>
</div>
<ul id="myTab" class="nav nav-tabs">
    <li class="active"><a href="#wj" data-toggle="tab">Chi phí chưa kết</a></li>
    <li><a href="#yj" data-toggle="tab">历史已结</a></li>
</ul>
<div id="myTabContent" class="tab-content">
    <div class="tab-pane fade in active" id="wj">
        <div class="gridPanel">
            <table id="gridList"></table>
        </div>
    </div>
    <div class="tab-pane fade" id="yj">
        <div class="gridPanel">
            <table id="gridList2"></table>
        </div>
        <div style="margin:3px 0;">
            <span style="color:red;font-weight:bold;">*.撤销功能限制为撤销列表中最后一次结算</span>
        </div>
    </div>
</div>

<div class="rows" style="margin-bottom: 1%;margin-top: 1%;">
    <div class="panel panel-default" style="margin-bottom:0;padding:10px;">
        <table class="form" style="width:96%;">
            <tbody>
                <tr>
                    <th class="formTitle">Chi phí chưa kết：</th>
                    <td class="formValue" style="width:100px;">
                        <label id="lblSumje" style="color:red;font-weight: bold;font-size: large;"></label>
                    </td>
                    <th class="formTitle" style="width:105px;">Thời gian kết thúc quyết toán lần trên：</th>
                    <td class="formValue">
                        <label id="lastValidMidwaySettTime"></label>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 6, 8 },
    F8Text = "",
    F6Text = "",
    F6Hidden = true,
    F8Hidden = true,
})
<script type="">

    //Thông qualstruyền qua số nhập viện
    var fromzyh = sessionStorage.getItem('');
    var defaultShow = sessionStorage.getItem('');
    if (fromzyh) {
        $('').val(fromzyh);
        sessionStorage.removeItem('');
    }
    if (defaultShow) {
        sessionStorage.removeItem('');
    }

    $(function () {
        initgridList1();

        $('').tab(''); //Sẽ kích hoạtgrid2Tải kiểu

        if (!(defaultShow === '')) {
            setTimeout("", 200); //显示未结
        }

        if (!!$('').val()) {
            ajaxLoadDataResult();
        }
    });

    function initgridList1() {
        $('').dataGrid({
            unwritten: false,
            url: "",
            postData: { zyh: $("").val(), endTime: $("").val() },
            height: $(window).height() - 300,
            sortable: false,
            colModel: [
                { label: "", name: "", width: 180, align: "" },
                {
                    label: "", name: "", width: 80, align: "", formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }
                },
                {
                    label: "", name: "", width: 80, align: "", formatter: ""
                        , formatoptions: { decimalPlaces: 2, defaultValue: '' }
                },
            ],
            gridComplete: function (data) {
                var sumje = 0.00;
                $.each(data, function () {
                    sumje += this.zje;
                });
                if (sumje != 0) {
                    $('').html(sumje.toFixed(2));
                }
                else {
                    $('').html('');
                }
            }
        });
    }

    var flagIsFirstInitGrid2 = true;
    $('').on('', function (e) {
        var targetHref = $(e.target).attr('');
        $('').hide();
        if (targetHref && targetHref.indexOf('') != -1) {
            $('').show();
            if (flagIsFirstInitGrid2) {
                flagIsFirstInitGrid2 = false;
                initgridList2();
            }
            else {
                reloadGrid2();
            }
        }
        else {
            $('').show();
        }
    })

    function initgridList2() {
        $('').dataGrid({
            unwritten: false,
            url: "",
            postData: { zyh: $("").val() },
            height: $(window).height() - 300,
            sortable: false,
            colModel: [
                { label: "", name: "", width: 140, align: "", hidden: true },
                { label: "", name: "", width: 140, align: "", hidden: true },
                {
                    label: "", name: "", width: 80, align: "", formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }
                },
                {
                    label: "", name: "", width: 140, align: "",
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                {
                    label: "", name: "", width: 140, align: "",
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                { label: "", name: "", width: 100, align: "" },
                {
                    label: "", name: "", width: 140, align: "",
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                }
            ],
        });
    }

    function thenreload() {
        //加载未结
        reloadGrid();
        reloadLastValidMidwaySettTime();

        var targetHref = $('').attr('');
        if (targetHref && targetHref.indexOf('') != -1) {
            reloadGrid2();  //当前已是已结
        }
    }

    function reloadGrid() {
        $("").jqGrid('', {
            postData: { zyh: $("").val(), endTime: $("").val() },
        }).trigger('');

    }

    function reloadGrid2() {
        $("").jqGrid('', {
            postData: { zyh: $("").val() },
        }).trigger('');

    }

    function reloadLastValidMidwaySettTime() {
        //Cập nhật‘Thời gian kết thúc quyết toán cuối cùng’
        $('').html('');
        if (!!$('').val()) {
            $.najax({
                url: "" + $("").val(),
                success: function (ajaxresp) {
                    if (ajaxresp.data) {
                        $('').html($.getTime({ date: ajaxresp.data }));
                        $('').html($.getTime({ date: ajaxresp.data }));
                    }
                },
            });
        }
    }

    //Tra cứu bệnh nhân
    function GetPatSerarchView(keyword) {
        var zyh = keyword;
        if (!!!keyword) {
            zyh = '';
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + '' + "" + Math.random() + "" + zyh,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
                //Gọi tra cứu số thẻ và số nhập viện
            }//Hàm callback xác nhận khi nhấn cửa sổ
        });

    }

    //Bệnh nhân đã chọn callback
    function getPatInfoAjax(selePatInfo) {
        $('').val($.getTime()); //update endTime
        $('').val(selePatInfo.zyh);
        ajaxLoadDataResult();
    }

    //Tải thông tin cơ bản nhập viện
    function ajaxLoadDataResult() {
        $('').html('');   //只有切换住院号的时候，才切换开始日期

        var zyh = $('').val();
        if (!!zyh) {
            $.najax({
                type: "",
                url: "" + zyh,
                loading: true,
                success: function (ajaxresp) {
                    setPatInfoModel(ajaxresp.data.patInfo);

                    thenreload();
                },
                errorCallback: function (err) {
                    newtouch_globalevent_f4();
                    $('').trigger('');
                }
            });
        }
        else {
            GetPatSerarchView();
        }
    }

    //Khởi tạo thông tin bệnh nhân
    function setPatInfoModel(patModel) {
        $('').html(patModel.xm);
        $('').html($.getGender(patModel.xb));
        $('').html(getAgeFromBirthTime({ begin: patModel.csny }).text);
        $('').html(patModel.ryzdmc);
        $('').html(patModel.zjh);
        $('').html(patModel.phone);
        $('').html(patModel.csny ? patModel.csny.substring(0, 10) : '');
        $('').html(patModel.ryrq ? patModel.ryrq.substring(0, 10) : '');

        $('').html(patModel.ryrq ? patModel.ryrq.substring(0, 10) : '');

    }

    function newtouch_event_f8() {
        var zyh = $('').val();
        var startTime = $('').html();
        if (!!!startTime) {
            $.modalAlert("", '');
            return;
        }
        if (!!!zyh) {
            $.modalAlert("", '');
            return;
        }
        var thisSettEndTime = $('').val();
        if (!!!thisSettEndTime) {
            $.modalAlert("", '');
            return;
        }
        var allLine = $("").jqGrid('', null, true);
        if (!!!allLine || allLine.length == 0) {
            $.modalAlert("", '');
            return;
        }
        //Gửi
        var postData = { zyh: zyh, startTime: startTime, endTime: thisSettEndTime };
        $.submitForm({
            type: "",
            url: "",
            param: postData,
            success: function (ajaxresp) {
                sessionStorage.setItem('', $('').val());
                location.href = location.href;
            },
        });

    }

    function newtouch_event_f6() {
        var zyh = $('').val();
        if (!!!zyh) {
            $.modalAlert("", '');
            return;
        }
        var allLine = $("").jqGrid('', null, true);
        if (!!!allLine || allLine.length == 0) {
            $.modalAlert("", '');
            return;
        }
        //Gửi
        var postData = { zyh: zyh };
        $.submitForm({
            type: "",
            url: "",
            param: postData,
            success: function (ajaxresp) {
                sessionStorage.setItem('', $('').val());
                sessionStorage.setItem('', '');
                location.href = location.href;
            },
        });

    }

</script>
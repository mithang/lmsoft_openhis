@{
    ViewBag.Title = "";
    Layout = "";
}
<form id="form1">
    <div style="padding-top: 20px; margin-right: 55px;">
        <table class="form">
            <tr>
                <th class="formTitle"><span class="required">*</span>Dừng thời gian：</th>
                <td class="formValue">
                    <input class="form-control input-wdatepicker required" id="PreStopDate" name="PreStopDate"
                           value=@DateTime.Now.ToString("yyyy-MM-dd") type="text"
                           onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        var date = $('').val();
        if ($.getDate() > date) {
            $.modalAlert('');
        }
        return date;
    }
</script>


@{
    ViewBag.Title = "";
    Layout = "";
}

<script>
    var keyValue = $.request("");
    var f = $.request("");
    $(function () {
        $("").bindSelect({
            url: "" + "",
            id: "",
            text: ""
        });

        //Tải loại phục hồi chức năng
        $("").bindSelect({
            url: "",
        });

        if (!!keyValue) {
            $.najax({
                type: "",
                async: false,
                url: ""GetFormJson"",
                data: { keyValue: keyValue, from: f },
                dataType: "",
                cache: false,
                success: function (data) {
                    if (data) {
                        $("").formSerialize(data);
                        $('').val(data.zlsgh).trigger('');
                        $('').val(data.kflb).trigger('');
                        $('').val(data.zlrq.substring(0, 10));
                    }
                }
            });
        }

    });

    function submitForm(callback) {
        if (!$('').formValid()) {
            return false;
        }
        var data = {};
        var zxitem = {};
        var zxsj = $('').val();
        var zlsgh = $('').val();
        var kflb = $('').val();
        if (keyValue && zxsj && zlsgh && kflb) {
            zxitem = { zxId: keyValue, zxsj: zxsj, zlsgh: zlsgh, kflb: kflb };
        }
        data[""] = zxitem;
        data.from = f;
        $.submitForm({
            url: ""updateExc"",
            param: data,
            success: function () {
                callback();
            }
        });
    }
</script>
<form id="form1">
    <table class="form" style="margin-top: 10px; width: 95%">
        <tr>
            <td class="formTitle">Ngày điều trị：</td>
            <td class="formValue">
                <input id="zxrq" value="@(DateTime.Now.ToString("yyyy-MM-dd"))" type="text" class="form-control input-wdatepicker" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" />
            </td>
            <th class="formTitle">Nhà trị liệu：</th>
            <td class="formValue formDdlSelectorTd">
                <select id="zlsgh" name="zlsgh" class="form-control">
                    <option value="">==Vui lòng chọn==</option>
                </select>
        </tr>
        <tr>
            <th class="formTitle">Loại phục hồi chức năng：</th>
            <td class="formValue">
                <select id="kflb" name="kflb" class="form-control">
                    <option value="">==Vui lòng chọn==</option>
                </select>
            </td>
            <th class="formTitle">Hạng mục thu phí：</th>
            <td class="formValue">
                <input type="text" class="form-control newtouch_Readonly" id="sfxmmc" />
            </td>

        </tr>
        <tr>
            <th class="formTitle">Họ tên bệnh nhân：</th>
            <td class="formValue">
                <input type="text" class="form-control newtouch_Readonly" id="xm" />
            </td>
            <th class="formTitle">Điều trị lượng：</th>
            <td class="formValue">
                <input type="text" class="form-control newtouch_Readonly" id="zll" />
            </td>
        </tr>
        <tr>

            <th class="formTitle">Số lượng：</th>
            <td class="formValue">
                <input type="text" class="form-control newtouch_Readonly" id="sl" />
            </td>
            <th class="formTitle">Đơn vị：</th>
            <td class="formValue">
                <input type="text" class="form-control newtouch_Readonly" id="dw" />
            </td>
        </tr>
    </table>
</form>


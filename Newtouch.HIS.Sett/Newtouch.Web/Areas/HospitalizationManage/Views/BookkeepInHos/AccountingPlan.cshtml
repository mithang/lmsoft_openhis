
@{
    ViewBag.Title = "";
    Layout = "";

    var from = Context.Request.QueryString[""];
}
<style>
    .toolbar {
        width: 57% !important;
    }

    .gw_num {
        border: 1px solid #dbdbdb;
        width: 44px;
        line-height: 26px;
        overflow: hidden;
        resize: none;
        border-radius: 4px;
        box-shadow: none;
    }

        .gw_num em {
            display: block;
            height: 26px;
            width: 11px;
            float: left;
            color: #7A7979;
            border-right: 1px solid #dbdbdb;
            text-align: center;
            cursor: pointer;
        }

        .gw_num .num {
            display: block;
            float: left;
            text-align: center;
            width: 20px;
            font-style: normal;
            font-size: 14px;
            line-height: 24px;
            border: 0;
        }

        .gw_num em.add {
            float: right;
            border-right: 0;
            border-left: 1px solid #dbdbdb;
        }
</style>
<form name="form1">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    @if (!(from == ""))
                    {
                        <th class="formTitle">Tạm dài：</th>
                        <td class="formValue">
                            <select id="yzxz" name="yzxz" class="form-control">
                                <option value="">==Tất cả==</option>
                                <option value="1">Tạm</option>
                                <option value="2">Dài</option>
                            </select>
                        </td>
                    }
                    <th class="formTitle">Thực hiện trạng thái：</th>
                    <td class="formValue">
                        <select id="zxzt" name="zxzt" class="form-control" data-EnumType="EnumJzjhZXZT">
                            <option value="">==Tất cả==</option>
                        </select>
                    </td>
                    <th class="formTitle">Từ khóa：</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="keyword" placeholder="Họ tên bệnh nhân/Số bệnh án/Số ngoại trú">
                    </td>
                    <th class="formTitle">计划录入时间：</th>
                    <td class="formValue" colspan="2">
                        <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; float:left;" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })">
                        <span style="margin-left:1%;float:left">—</span>
                        <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:43%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })">
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-primary btn_search" style="margin-left: 10%;" value="Tra cứu">
                    </td>
                </tr>
                <tr class="mzrow">
                    <th class="formTitle">Trạng thái thu phí：</th>
                    <td class="formValue">
                        <select id="sfzt" name="sfzt" class="form-control" data-EnumType="">
                            <option value="">==Tất cả==</option>
                            <option value="1">Đã thu phí</option>
                            <option value="2">Chưa thu phí</option>
                        </select>
                    </td>
                    <th class="formTitle">再收费提醒：</th>
                    <td class="formValue">
                        <div class="gw_num">
                            <em class="jian">-</em>
                            <input type="text" value="" class="num" id="zsftx" />
                            <em class="add">+</em>
                        </div>
                    </td>
                    <th class="formTitle" style="left:-90px">
                        <span style="line-height:26px">剩余次数提醒：</span>
                    </th>
                    <td class="formValue">
                        <div class="gw_num" style="margin-left:-95px">
                            <em class="jian">-</em>
                            <input type="text" value="" class="num" id="sycstx" />
                            <em class="add">+</em>
                        </div>
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-primary btn_searchmz" style="margin-left: -95px;" value="Tra cứu" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
    <table style="width:400px;height:20px; margin-top:10px;margin-left:10px; float:left; color:#274b6d">
        <tr>
            <td>注：可双击已执行次数大于0的记录查看执行详情</td>
        </tr>
    </table>
</form>
@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 4, 7, 9 },
    F7Text = "",
    F9Text = "",
})
<script>
    var from = $.request("");
    if (!!!from) {
        from = "";
    }

    if (from === '') {
        $('').attr('', '');
        $('').css("", "");
    }
    else {
        $('').attr('', '');
        $("").remove();
    }

    $(function () {

        //执行状态切换 Tự động kích hoạt tra cứu
        $('').change(function () {
            $('').trigger('');
        });
        //执行状态切换 Tự động kích hoạt tra cứu
        $('').change(function () {
            $('').trigger('');
        });
        //Thực hiện trạng thái thu phí Tự động kích hoạt tra cứu
        $('').change(function () {
            $('').trigger('');
        });

        gridList();
    });

    //关键字回车
    $('').keydownEnterEvent(function () {
        $('').trigger('');
    })

    //Chi tiết
    var $gridList = $("");
    var gridOptins = {
        url: "",
        postData: getSearchPostData(),
        height: from == "" ? $(window).height() - 235 : $(window).height() - 205,
        colModel: [
        { label: "", name: "", key: true, hidden: true },
        {
            label: "", name: "", width: 30, align: "", formatter: function (cellvalue, a, b) {
                return cellvalue == "" ? "" : (cellvalue == "" ? "" : "");
            }, hidden: from == "" ? true : undefined
        },
        {
            label: "", name: "", width: 80, hidden: (from == "" ? true : undefined), formatter: function (val) {
                if (!!val) {
                    var date = $.getDate({ date: val });
                    if (date < '') {
                        return '';  //Dữ liệu lịch sử một phần một1970-01-01
                    }
                    return date;
                }
                return "";
            }
        },
        {
            label: "", name: "", width: 80, align: "",
            formatter: function (cellvalue, a, b) {
                return $.enum.getDescByValue("", cellvalue);
            }
        },
        { label: "", name: "", width: 80, align: "" },
        { label: "", name: "", width: 80, align: "" },
        { label: (from == "" ? "" : ""), name: "", width: (from == "" ? 100 : 70), align: "" },
        { label: "", name: "", width: 180, align: "" },
        { label: "", name: "", width: 75, align: "" },
        { label: "", name: "", width: 40, align: "" },
        { label: "", name: "", width: 60, align: "" },
        { label: (from == "" ? "" : ""), name: "", width: 45, align: "" },
        { label: "", name: "", width: 40, align: "" },
        { label: "", name: "", width: 55, align: "" },
        {
            label: "", name: "", width: 100, align: "",
            formatter: "", formatoptions: { srcformat: '', newformat: '' }
        },
            {
                label: "", name: "", width: 100, align: "", hidden: from == "" ? undefined : true,
                formatter: "", formatoptions: { srcformat: '', newformat: '' }
            },
        {
            label: "", name: "", width: 120, align: "",
            formatter: "", formatoptions: { srcformat: '', newformat: '' }
        },
        {
            label: "", name: "", width: 100, align: "",
            formatter: "", formatoptions: { srcformat: '', newformat: '' }
        },
        { label: "", name: "", width: 150, align: "" },
        ],
        multiselect: true,
        pager: "",
        sortname: '',
        viewrecords: true,
        gridComplete: function () {
            var ids = $("").getDataIDs();
            for (i = 0; i < ids.length; i++) {
                var rowData = $("").getRowData(ids[i]);
                if (rowData && rowData.zxzt) {
                    if (rowData.zxzt == "") {
                        $("" + ids[i]).find("").addClass('');
                    }
                    if (rowData.zxzt == "") {
                        $("" + ids[i]).find("").addClass('');
                    }
                    if (rowData.zxzt == "") {
                        $("" + ids[i]).find("").addClass('');
                    }
                }
            }
        },
        ondblClickRow: function (rowid) {
            var rowObj = $gridList.jqGrid('', rowid);
            EditRow(rowObj);
        }
    };
    function gridList() {
        $gridList.dataGrid(gridOptins);
        $('').click(function () {
            if ($('').val() && $('').val() && ($('').val() > $('').val())) {
                $.modalAlert("", '');
                return;
            }
            $gridList.jqGrid('',
                {
                    postData: getSearchPostData(),
                    page: 1,
                    url: ""
                }).trigger('');
        });
    }
    //Điều kiện tra cứu
    function getSearchPostData() {
        var keyword = $("").val();
        var kssj = $("").val();
        var jssj = $("").val();
        var yzxz = $("").val();
        var zxzt = $("").val();
        var zsftx = $('').val();
        var sycstx = $('').val();
        var sfzt = $("").val();
        return { keyword: keyword, kssj: kssj, jssj: jssj, yzxz: yzxz, zxzt: zxzt, sfzt: sfzt, from: from, zsftx: zsftx, sycstx: sycstx };
    };

    //Chấm dứt
    function newtouch_event_f7() {
        var jzjhmxIdStr = "";
        var allData = $("").jqGrid('', true, true);
        $.each(allData, function () {
            if (this.jzjhmxId && this.zxzt !== '' && this.zxzt !== '') {
                jzjhmxIdStr += this.jzjhmxId + '';
            }
        });
        if (!jzjhmxIdStr) {
            if (allData.length > 0) {
                $.modalAlert("", '');
            }
            else {
                $.modalAlert("", '');
            }
            return;
        }
        StopPlan(jzjhmxIdStr);
    }

    function StopPlan(jzjhmxIdStr) {
        //Lấy dòng đã chọnId
        $.najax({
            type: "",
            url: "",
            data: { jzjhmxIdStr: jzjhmxIdStr, from: from },
            dataType: "",
            success: function (ajaxresp) {
                $.modalAlert(ajaxresp.message, '');
                //Lại tải
                $('').trigger('');
            },
        });
    }

    //Xóa thao tác
    function newtouch_event_f4() {
        $('').jqGrid("");
        $('').jqGrid("");
        $('').val('');
        $('').val('');
    }

    function EditRow(rowObj) {
        if (rowObj && rowObj.yzxcs > 0) {
            $.modalOpen({
                id: "",
                title: "",
                url: "" + rowObj.jzjhmxId + "" + from + "" + rowObj.zxzt,
                width: "",
                height: "",
                btn: null
            });
        }
    }

    //XuấtExcel Cột
    var exportCols = null;
    function newtouch_event_f9() {
        exportCols = new Array();
        var colsChooseSourceArr = new Array();
        $.each(gridOptins.colModel, function () {
            if (!(this.hidden === true)) {
                exportCols.push({ Heading: this.label, Name: this.name, Width: this.width });
                colsChooseSourceArr.push({ Heading: this.label, Name: this.name });
            }
        });
        var url = "";
        var cols = JSON.stringify(colsChooseSourceArr);
        cols = encodeURIComponent(cols);
        url += "" + cols;
        $.modalOpen({
            id: "",
            title: "",
            url: url,
            width: "",
            height: "",
            callBack: function (iframeId) {
                //Kết quả
                var restArr = top.frames[iframeId].GetChoosedCols();
                if (!!!restArr || !!!restArr.length || restArr.length == 0) {
                    $.modalAlert("", '');
                    return false;
                }
                var isContainFilter = top.frames[iframeId].GetIsContainFilter();
                //Đóng cửa sổ chọn
                $.modalClose("");
                //
                exportCols = $.jsonWhere(exportCols, function (v) {
                    var matched = false;
                    for (var iIndex = 0; iIndex < restArr.length; iIndex++) {
                        if (restArr[iIndex] == v.Name) {
                            matched = true;
                        }
                    }
                    return matched;
                });
                //Xuất
                Export(isContainFilter);
            }
        });
    }

    function Export(isContainFilter) {
        var url = "" + Math.random();
        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + $('').val();
        url += "" + from;
        url += "" + isContainFilter;
        url += "" + "";  //列宽度标准列
        var cols = JSON.stringify(exportCols);
        top.$.cookie('', cols, { path: "" });
        //url += "" + encodeURIComponent(cols);

        window.open(url);
    }

</script>

<script>
    $(document).ready(function () {
        //加的效果
        $("").click(function () {
            var n = $(this).prev().val();
            if (isNaN(parseInt(n))) {
                num = 1;    //addTừ1Bắt đầu
            } else {
                var num = parseInt(n) + 1;
            }
            $(this).prev().val(num);
        });
        //减的效果
        $("").click(function () {
            var n = $(this).next().val();
            if (isNaN(parseInt(n)) || parseInt(n) < 1) {
                num = 0;
            } else {
                var num = parseInt(n) - 1;
            }
            $(this).next().val(num);
        });
    });
    var patter_num = /^[0-9]*$/;
    $('').keyup(function () {
        var fob = $(this).val();
        if (!patter_num.test(fob)) {
            $.modalAlert("", '');
            $(this).val("");
            $(this).focus();
            return;
        };
    });
</script>


@{
    ViewBag.Title = "";
    Layout = "";
}
<style>
    .editable {
        width: 70% !important;
    }

    .ul-hj {
        float: right;
        padding: 0;
        margin: 10px 30px;
    }

        .ul-hj li {
            list-style: none;
            float: right;
            line-height: 25px;
            margin-left: 10px;
        }

    .sp-bottom-title {
        font-weight: bolder;
    }

    .sp-bottom-value {
        color: #ff0000;
    }
</style>
<div class="rows" style="float:left;width:25%;">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <table class="form" style="width:95%">
            <tr>
                <th class="formTitle">&nbsp;&nbsp; <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>&nbsp;&nbsp;Họ tên/Số bệnh án：</th>
                <td class="formValue">
                    <input id="keyword" type="text" class="form-control" />
                </td>
            </tr>
        </table>
        <div class="gridPanel">
            <table id="gridListsearch"></table>
        </div>
    </div>
</div>
<div class="rows" style="float:left;width:74.5%;margin-left:5px;">
    <div class="gridPanel">
        <table id="gridList"></table>
    </div>
    @Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel
    {
        ShowKeyList = new[] { 8 },
        F8Text = "",
        WapperInlineStyle = ""
    })
    <ul class="ul-hj">
        <li><span class="sp-bottom-title">治疗项目合计：</span><span class="sp-bottom-value" id="sp_zlxmhj">___</span></li>
        <li><span class="sp-bottom-title">治疗金额合计：</span><span class="sp-bottom-value" id="sp_zljehj">___</span></li>
        <li><span class="sp-bottom-title">Số người bệnh nhân：</span><span class="sp-bottom-value" id="sp_hzrs">___</span></li>
    </ul>
</div>
<script type="">
    var leftdata = [];//初始化的病人信息这不是可以吗小垃圾
    var redata = [];//thông tin bệnh nhân lọc sau
    var selectpat = [];//thông tin bệnh nhân của đã chọn
    var from = $.request("");
    var item_selected = [];
    $(function () {
        gridList();
        gridListSearch();
    });

    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            postData: getSearchPostData(),
            rownumbers: false,
            height: $(window).height() - 83,
            colModel: [
                { label: "", name: "", hidden: true, key: true },
                { label: "", name: "", hidden: true },
                {
                    label: "", name: "", width: 30, align: "", formatter: function (cellvalue, a, b) {
                        return cellvalue == "" ? "" : (cellvalue == "" ? "" : "");
                    }, hidden: from == "" ? true : undefined
                },
                { label: "", name: "", width: 100, align: "", editable: true, edittype: '' },
                { label: "", name: "", width: 115, align: "", editable: true, edittype: ''},
                { label: "", name: "", width: 65, align: "" },
                { label: "", name: "", width: 150, align: "" },
                { label: (from == "" ? "" : ""), name: "", width: 45, align: "" },
                { label: "", name: "", width: 40, align: "" },
                { label: "", name: "", width: 65, align: "" },
                {
                    label: "", name: "", width: 55, align: "", formatter: function (cellvalue, a, b) {
                        if (!(from == "") && b.yzxz == "") {
                            return "";  //长不显示剩余次数
                        }
                        else {
                            return parseFloat(b.zcs == undefined ? 0 : b.zcs) - parseFloat(b.yzxcs == undefined ? 0 : b.yzxcs);
                        }
                    }
                },
                {
                    label: "", name: "", width: 80, align: ""
                    , formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                {
                    label: "", name: "", width: 40, align: "", formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }
                },
                { label: "", name: "", width: 65, align: "" },
                { label: "", name: "", width: 80, align: "" },
                {
                    label: "", name: "", width: 70, align: "", formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }
                },
                {
                    label: "", name: "", width: 120, align: ""
                , formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                { label: "", name: "", width: 160, align: "" }
            ],
            unwritten: false,
            viewrecords: true,
            multiselect: true,//复选框
            onSelectRow: function (rowid, status) {
                statisticalImplementFrequencyAndZje();
                if (status) {
                    $("").jqGrid('', rowid, true, null, null, null, null, function (callbackRowId) {     //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.
                    });

                } else {
                    $("").saveRow(rowid, null, null, null, function (callbackRowId) { }, null, null);
                }
            },
            gridComplete: function () {
                $gridList.setColProp('', {
                    edittype: '', editoptions: {
                        value: getzlsList()
                    },
                    formatter: ""
                });
                $gridList.setColProp('', {
                    edittype: '', editoptions: {
                        value: getkflbList(),
                    }, formatter: "", formatter: ""
                });
            },
            onSelectAll: function (aRowids, status) {
                statisticalImplementFrequencyAndZje();
                EnableInlineEditBox();
            }
        });
    }

    function getzlsList() {
        var str = "";
        orgId = '';
        $.najax({
            type: "",
            url: "" + orgId,
            loading: true,
            async: false,
            success: function (data) {
                if (data != null) {
                    var jsonobj = eval(data);
                    var length = jsonobj.length;
                    for (var i = 0; i < length; i++) {
                        if (i != length - 1) {
                            str += jsonobj[i].StaffGh + "" + jsonobj[i].StaffName + "";
                        } else {
                            str += jsonobj[i].StaffGh + "" + jsonobj[i].StaffName;// 这里是option里面的 value:label
                        }
                    }

                }
            }
        });
        return str;
    }

    function getkflbList() {
        var kflbs = top.$.itemDetails.getItems('');
        var obj = {};
        $.each(kflbs, function () {
            if (true) {
                obj[this.Code] = this.Name;
            }
        });
        return obj;
    }

    //Bật hộp chỉnh sửa trong dòng
    function EnableInlineEditBox() {
        //GridTải xong bật chỉnh sửa trong dòng   1.Lấy tất cả các dòng trướcId  2.Gọi duyệteditRowPhương thức
        var rowIds = $("").jqGrid('');
        for (var i = 0; i < rowIds.length; i++) {
            $("").jqGrid('', rowIds[i], true, null, null, null, null, function (callbackRowId) {     //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.
            });
        }
    }

    function getSearchPostData() {
        var postData = {};
        var zyhStr = '';
        var allData = $("").jqGrid('', true, true);
        $.each(allData, function () {
            if (this.zyh) {
                zyhStr += this.zyh + '';
            }
        });

        if (from == '') {
            postData.from = '';
        }
        postData.zyhStr = zyhStr;
        return postData;
    }

    function gridListSearch() {
        var a = from == "" ? "" : "";
        var $gridList = $("");
        $gridList.newtouchLocalDataGrid({
            height: $(window).height() - 120,
            colModel: [
                { label: '', name: '', width: 60, align: '' },
                { label: '', name: '', width: 85, align: '' },
                { label: a, name: '', width: 85, align: '', key: true },
                { label: "", name: '', align: '', hidden: true }
            ],
            rowNum: '',
            viewrecords: true,
            multiselect: true,//复选框
            unwritten: false,
            rownumbers: false,
            onSelectRow: function (rowid, status) {
                research();
            },
            beforeSelectRow: function (rowid, e) {
                var _this = this;
                var index = item_selected.indexOf(item_selected, rowid);
                if (index == -1) {
                    item_selected.push(rowid);
                }
                else {
                    item_selected = item_selected.pull(item_selected, rowid);
                }
            },
            onSelectAll: function (aRowids, status) {
                research();
            }, afterInsertRow: function (rowid, rowdata, rowelem) {
                $.each(selectpat, function (idx) {
                    if (rowdata.zyh.indexOfIgnoreCase(this.zyh) > -1) {
                        $("").jqGrid('', rowid, false); //ĐặtjqGridĐã chọn
                    }
                });
            },
        });
        $.najax({
            type: "",
            url: "" + from,
            loading: true,
            success: function (ajaxresp) {
                $("").resetSelection();
                $("").clearGridData();
                $("").newtouchLocalDataGrid({
                    posttofirst: false
                }, ajaxresp);
                leftdata = $("").jqGrid('', null, true);
            }
        });
    }

    $('').click(function () {
        research();
    });

    function research() {
        statisticalNumber();
        $("").jqGrid('', {
            postData: getSearchPostData()
        }).trigger('');
    }

    //Thống kê số người thực hiện
    function statisticalNumber() {
        var t = 0;
        $("").each(function() {
            ++t;
        });
        $("").html(t);
    }

    //Thống kê số lần thực hiện và Tổng số tiền
    function statisticalImplementFrequencyAndZje() {
        var tt = 0;
        var zje = 0.00;
        $("").each(function (index, item) {
            ++tt;
            var trObj = $(item).parent().parent().parent();
            var zll = parseFloat(trObj.find("").html());
            var dj = parseFloat(trObj.find("").html());
            var c = zll * dj;
            zje += c;
        });
        $("").html(tt);
        $("").html(zje);
    }

    //F8提交至服务器
    function newtouch_event_f8() {
        var jzjhmxIdStr = "";
        var zxItem = [];
        //Lấy tất cả các dòngId，Duyệt để hộp chỉnh sửa ở trạng thái đã lưu
        var rowIds = $("").jqGrid('');
        for (var i = 0; i < rowIds.length; i++) {
            $("").saveRow(rowIds[i], null, null, null, function (callbackRowId) {

            }, null, null);
        }

        var selRowIds = $("").jqGrid('', '');
        //Đánh giá
        for (var i = 0; i < selRowIds.length; i++) {
            var rowData = $("").jqGrid('', selRowIds[i]);
            if (!rowData) {
                break;
            }
            if (!rowData.kflb) {
                $.modalAlert("", '');
                break;
            }
            if (!rowData.zlsgh) {
                $.modalAlert("", '');
                break;
            }
            zxItem.push({ jzjhmxId: rowData.jzjhmxId, kflb: rowData.kflb, zlsgh: rowData.zlsgh });
        }
        if (zxItem == [] || zxItem.length < 1) {
            $.modalAlert("", '');
            return;
        }
        var paramData = {};
        paramData.jzjhmxIdStr = jzjhmxIdStr;
        paramData.from = from;
        paramData.zxItem = zxItem;
        $.modalOpen({
            id: "",
            title: "",
            url: ""ExecutionDateComfirm"",
            width: "",
            height: "",
            callBack: function (iframeId) {
                //Ngày thu phí đã điền
                var obj = top.frames[iframeId].checkEditingRowData();
                if (obj) {
                    paramData.zxrq = obj.zxrq + "" + new Date().toLocaleTimeString('', { hour12: false });
                    var sfxmmc = "";
                    //Đánh giá
                    for (var i = 0; i < selRowIds.length; i++) {
                        var rowData = $("").jqGrid('', selRowIds[i]);
                        if (!rowData) {
                            break;
                        }

                        if (rowData.LastEexcutionTime.substring(0, 10) == obj.zxrq) {
                            sfxmmc += rowData.sfxmmc + "";
                            break;
                        }
                    }
                    if (sfxmmc == "") {
                        submitform(paramData);
                    } else {
                        $.modalConfirm(sfxmmc + "", function (flag) {
                            if (flag) {
                                submitform(paramData);
                                return;
                            }
                        });
                    }
                }
            }
        });
    };

    function submitform(paramData) {
        $.submitForm({
            url: '',
            param: paramData,
            success: function (data) {
                $.modalClose("");
                gridListSearch();
                $("").clearGridData();
            }
        });
    }

    //搜索待执行的病人信息
    $('').keyup(function () {
        if (leftdata != null && leftdata.length > 0) {
            selectpat = $("").jqGrid('', true, true);
            $("").resetSelection();
            $("").clearGridData();
            redata = [];
            redatazyh = [];//bệnh nhân tìm kiếm saurowid
            var $this = $(this).val();
            for (var i = 0; i < leftdata.length; i++) {
                if (leftdata[i].blh.indexOfIgnoreCase($this) > -1 ||
                    leftdata[i].xm.indexOfIgnoreCase($this) > -1 ||
                    leftdata[i].py.indexOfIgnoreCase($this) > -1 ||
                    $this.trim() == '') {
                    redata.push(leftdata[i]);
                    redatazyh.push(leftdata[i].zyh);
                }
            }
            if (selectpat != [] && selectpat.length > 0) {
                    for (var j = 0; j < selectpat.length; j++) {//bệnh nhân của đã chọn
                        if ($.inArray(selectpat[j].zyh, redatazyh) < 0) {
                            redata.unshift(selectpat[j]);
                        };
                    }
            }
            $("").newtouchLocalDataGrid({
                posttofirst: false
            }, redata);
        }
    });
</script>

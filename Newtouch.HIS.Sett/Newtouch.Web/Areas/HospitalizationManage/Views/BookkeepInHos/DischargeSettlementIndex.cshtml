@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "DischargeSettlementIndex";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<div class="rows" style="margin-bottom: 1%;">
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading navb-bg">
            Thông tin bệnh nhân nội trú
        </div>
        <table class="form" style="width:96%;">
            <tbody>
                <tr>
                    <th class="formTitle">Số nhập viện：</th>
                    <td class="formValue">
                        <input class="form-control" type="text" id="zyh" value="" />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-default btn-md btn-default-color" title="Chọn bệnh nhân nội trú" id="zy_btnsyy" value="Tra cứu" onclick="GetPatSerarchView($('#zyh').val());">
                    </td>
                    <th class="formTitle">Ngày xuất viện：</th>
                    <td class="formValue" style="width:143px;">
                        <input id="cyrq" type="text" class="form-control input-wdatepicker form-an formClearIgnore"
                               onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" value="@(System.DateTime.Now.ToString("yyyy-MM-dd"))" />
                    </td>
                    <th class="formTitle">Họ tên：</th>
                    <td class="formValue">
                        <label id="zy_xm"></label>
                    </td>
                    <th class="formTitle">Giới tính：</th>
                    <td class="formValue">
                        <label id="zy_xb"></label>
                    </td>
                    <th class="formTitle">Tuổi：</th>
                    <td class="formValue">
                        <label id="zy_nl"></label>
                    </td>
                </tr>
            </tbody>
            <tbody class="dispTbody" style="display:none;">
                <tr>
                    <th class="formTitle">Số giấy tờ：</th>
                    <td class="formValue" colspan="2">
                        <label id="zy_zjh"></label>
                    </td>
                    <th class="formTitle">Chẩn đoán nhập viện：</th>
                    <td class="formValue">
                        <label id="zy_ryzd"></label>
                    </td>
                    <th class="formTitle">Số điện thoại：</th>
                    <td class="formValue">
                        <label id="zy_phone"></label>
                    </td>
                    <th class="formTitle">Ngày sinh：</th>
                    <td class="formValue">
                        <label id="zy_csny"></label>
                    </td>
                    <th class="formTitle">Ngày nhập viện：</th>
                    <td class="formValue">
                        <label id="zy_ryrq"></label>
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="fa_icontoggle"><i class="fa fa-angle-double-down icontoggle" style="color:rgb(0, 160, 233);cursor:pointer;"></i></div>
    </div>
</div>
<div class="gridPanel" style="margin-top:1%">
    <table id="gridList"></table>
</div>
<div class="rows" style="margin-bottom: 1%;">
    <div class="panel panel-default" style="margin-bottom:0;padding:10px;">
        <table class="form" style="width:96%;">
            <tbody>
                <tr>
                    <th class="formTitle">Chi phí đã kết：</th>
                    <td class="formValue" style="width:100px;">
                        <label id="lblSumje" style="color:red;font-weight: bold;font-size: large;"></label>
                    </td>
                    <th class="formTitle" style="width:125px;">Có tồn tại bản ghi chi phí chưa kết hay không：</th>
                    <td class="formValue">
                        <label id="isExistUnSetted"></label>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
@Html.Partial("_BottomButtonsView", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 8 },
    F8Text = "Xác nhận xuất viện"
})
<script type="text/javascript">

    $(function () {
        gridList();

        //Đi quyết toán
        $('#isExistUnSetted').parent('td').on('click', 'a', function () {
            //Thông qua ls Truyền số nhập viện sang
            sessionStorage.setItem('zyh', $('#zyh').val());
            top.top.$.Newtouchtab.triggerMenuItemClick({ m1: "Quản lý nội trú", m2: "Quyết toán chi phí" });
        });

    });

    function gridList() {
        $('#gridList').dataGrid({
            caption: "Danh sách chi phí đã kết",
            unwritten: false,
            url: "/HospitalizationManage/BookkeepInHos/GetMidwaySettedListJson",
            postData: {},
            height: $(window).height() - 300,
            sortable: false,
            colModel: [
                { label: "jsnm", name: "jsnm", width: 140, align: "left", hidden: true },
                { label: "Số nhập viện", name: "zyh", width: 140, align: "left", hidden: true },
                {
                    label: "Số tiền quyết toán", name: "zje", width: 80, align: "left", formatter: "number"
                    , formatoptions: { decimalPlaces: 2, defaultValue: '0.00' }
                },
                {
                    label: "Thời gian bắt đầu quyết toán", name: "jsksrq", width: 140, align: "left",
                    formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }
                },
                {
                    label: "Thời gian kết thúc quyết toán", name: "jsjsrq", width: 140, align: "left",
                    formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }
                },
                { label: "Nhân viên quyết toán", name: "CreatorCode", width: 100, align: "left" },
                {
                    label: "Thời gian quyết toán", name: "CreateTime", width: 140, align: "left",
                    formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' }
                }
            ],
            viewrecords: true,
            gridComplete: function (data) {
                var sumje = 0.00;
                $.each(data, function () {
                    sumje += this.zje;
                });
                if (sumje != 0) {
                    $('#lblSumje').html(sumje.toFixed(2));
                }
                else {
                    $('#lblSumje').html('');
                }
            }
        });
    }

    function reloadGrid() {
        $("#gridList").jqGrid('setGridParam', {
            postData: { zyh: $("#zyh").val() },
        }).trigger('reloadGrid');

        //Có tồn tại bản ghi chưa quyết toán hay không
        $('#isExistUnSetted').html('');
        $.najax({
            url: "/HospitalizationManage/BookkeepInHos/CheckIsExistUnSetted?zyh=" + $("#zyh").val(),
            success: function (ajaxresp) {
                if (ajaxresp.data === true) {
                    $('#isExistUnSetted').html('<a title="Nhấn vào tôi để đi quyết toán" style="color:red;cursor:pointer;">Có</a>');
                }
                else if (ajaxresp.data === false) {
                    $('#isExistUnSetted').html('Không');
                }
            },
        });

    }

    //Tra cứu bệnh nhân
    function GetPatSerarchView(keyword) {
        var zyh = keyword;
        if (!!!keyword) {
            zyh = '';
        }
        $.modalOpen({
            id: "patSearch",
            title: "Tra cứu bệnh nhân",
            url: "/PatientManage/AccountManage/PatSearchView?brzybzType=" + '@((int)EnumZYBZ.Bqz + "," + (int)EnumZYBZ.Djz)' + "&t=" + Math.random() + "&zyh=" + zyh,
            width: "700px",
            height: "600px",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
                //Gọi tra cứu số thẻ và số nhập viện
            }//Hàm callback khi nhấn xác định tại cửa sổ
        });

    }

    //Bệnh nhân đã chọn callback
    function getPatInfoAjax(selePatInfo) {
        $('#zyh').val(selePatInfo.zyh);
        ajaxLoadDataResult();
    }

    //Tải thông tin cơ bản nội trú
    function ajaxLoadDataResult() {
        var zyh = $('#zyh').val();
        if (zyh) {
            $.najax({
                type: "GET",
                url: "/HospitalizationManage/BookkeepInHos/GetInpatientAccountingStatusDetail?zyh=" + zyh,
                loading: true,
                success: function (ajaxresp) {
                    setPatInfoModel(ajaxresp.data.patInfo);

                    reloadGrid();
                },
                errorCallback: function (err) {
                    newtouch_globalevent_f4();
                    $('#zyh').trigger('focus');
                }
            });
        }
        else {
            GetPatSerarchView();
        }
    }

    //Khởi tạo thông tin bệnh nhân
    function setPatInfoModel(patModel) {
        $('#zy_xm').html(patModel.xm);
        $('#zy_xb').html($.getGender(patModel.xb));
        $('#zy_nl').html(getAgeFromBirthTime({ begin: patModel.csny }).text);
        $('#zy_ryzd').html(patModel.ryzdmc);
        $('#zy_zjh').html(patModel.zjh);
        $('#zy_phone').html(patModel.phone);
        $('#zy_csny').html(patModel.csny ? patModel.csny.substring(0, 10) : '');
        $('#zy_ryrq').html(patModel.ryrq ? patModel.ryrq.substring(0, 10) : '');

    }

    function newtouch_event_f8() {
        var zyh = $('#zyh').val();
        if (!!!zyh) {
            $.modalAlert("Vui lòng chọn bệnh nhân nội trú", 'error');
            return;
        }
        var isExistUnSetted = $('#isExistUnSetted').html();
        if (isExistUnSetted.indexOf('Có') != -1) {
            $.modalConfirm("Tồn tại chi phí chưa kết，Đi quyết toán", function (flag) {
                if (flag) {
                    $('#isExistUnSetted a').trigger('click');
                }
            });
            return;
        }
        var allLine = $("#gridList").jqGrid('getRowData_AllLine', null, true);
        if (!!!allLine || allLine.length == 0) {
            $.modalAlert("Chưa từng phát sinh chi phí，Không thể xuất viện", 'error');
            return;
        }
        //Gửi
        var postData = { zyh: zyh, cyrq: $('#cyrq').val() };
        $.submitForm({
            type: "POST",
            url: "/HospitalizationManage/BookkeepInHos/DischargeSettlement",
            param: postData,
            success: function (ajaxresp) {
                location.href = location.href;
            },
        });

    }

</script>
@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
}

<div class="rows" style="margin-bottom: 1%;">
    <div class="panel panel-default" style="margin-bottom:0;">
        <div class="panel-heading navb-bg">
            Thông tin bệnh nhân nhập viện
        </div>
        <table class="form" style="width:96%;">
            <tbody>
                <tr>
                    <th class="formTitle">Số nhập viện：</th>
                    <td class="formValue">
                        <input class="form-control" type="text" id="zyh" value="" />
                    </td>
                    <td class="formValue">
                        <input type="button" class="btn btn-default btn-md btn-default-color" title="Chọn bệnh nhân nhập viện" id="zy_btnsyy" value="Tra cứu" onclick="GetPatSerarchView($('#zyh').val());">
                    </td>
                    <th class="formTitle">Ngày xuất viện：</th>
                    <td class="formValue" style="width:143px;">
                        <input id="cyrq" type="text" class="form-control input-wdatepicker form-an formClearIgnore"
                               onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" value="@(System.DateTime.Now.ToString("yyyy-MM-dd"))" />
                    </td>
                    <th class="formTitle">Họ tên：</th>
                    <td class="formValue">
                        <label id="zy_xm"></label>
                    </td>
                    <th class="formTitle">Giới tính：</th>
                    <td class="formValue">
                        <label id="zy_xb"></label>
                    </td>
                    <th class="formTitle">Tuổi：</th>
                    <td class="formValue">
                        <label id="zy_nl"></label>
                    </td>
                </tr>
            </tbody>
            <tbody class="dispTbody" style="display:none;">
                <tr>
                    <th class="formTitle">Số giấy tờ：</th>
                    <td class="formValue" colspan="2">
                        <label id="zy_zjh"></label>
                    </td>
                    <th class="formTitle">Chẩn đoán nhập viện：</th>
                    <td class="formValue">
                        <label id="zy_ryzd"></label>
                    </td>
                    <th class="formTitle">Số điện thoại di động：</th>
                    <td class="formValue">
                        <label id="zy_phone"></label>
                    </td>
                    <th class="formTitle">Ngày sinh：</th>
                    <td class="formValue">
                        <label id="zy_csny"></label>
                    </td>
                    <th class="formTitle">Ngày nhập viện：</th>
                    <td class="formValue">
                        <label id="zy_ryrq"></label>
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="fa_icontoggle"><i class="fa fa-angle-double-down icontoggle" style="color:rgb(0, 160, 233);cursor:pointer;"></i></div>
    </div>
</div>
<div class="gridPanel" style="margin-top:1%">
    <table id="gridList"></table>
</div>
<div class="rows" style="margin-bottom: 1%;">
    <div class="panel panel-default" style="margin-bottom:0;padding:10px;">
        <table class="form" style="width:96%;">
            <tbody>
                <tr>
                    <th class="formTitle">已结费用：</th>
                    <td class="formValue" style="width:100px;">
                        <label id="lblSumje" style="color:red;font-weight: bold;font-size: large;"></label>
                    </td>
                    <th class="formTitle" style="width:125px;">是否存在未结费用记录：</th>
                    <td class="formValue">
                        <label id="isExistUnSetted"></label>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 8 },
    F8Text = ""
})
<script type="">

    $(function () {
        gridList();

        //去结算
        $('').parent('').on('', '', function () {
            //Thông qualstruyền qua số nhập viện
            sessionStorage.setItem('', $('').val());
            top.top.$.Newtouchtab.triggerMenuItemClick({ m1: "", m2: "" });
        });

    });

    function gridList() {
        $('').dataGrid({
            caption: "",
            unwritten: false,
            url: "",
            postData: {},
            height: $(window).height() - 300,
            sortable: false,
            colModel: [
                { label: "", name: "", width: 140, align: "", hidden: true },
                { label: "", name: "", width: 140, align: "", hidden: true },
                {
                    label: "", name: "", width: 80, align: "", formatter: ""
                    , formatoptions: { decimalPlaces: 2, defaultValue: '' }
                },
                {
                    label: "", name: "", width: 140, align: "",
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                {
                    label: "", name: "", width: 140, align: "",
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                },
                { label: "", name: "", width: 100, align: "" },
                {
                    label: "", name: "", width: 140, align: "",
                    formatter: "", formatoptions: { srcformat: '', newformat: '' }
                }
            ],
            viewrecords: true,
            gridComplete: function (data) {
                var sumje = 0.00;
                $.each(data, function () {
                    sumje += this.zje;
                });
                if (sumje != 0) {
                    $('').html(sumje.toFixed(2));
                }
                else {
                    $('').html('');
                }
            }
        });
    }

    function reloadGrid() {
        $("").jqGrid('', {
            postData: { zyh: $("").val() },
        }).trigger('');

        //是否存在未结记录
        $('').html('');
        $.najax({
            url: "" + $("").val(),
            success: function (ajaxresp) {
                if (ajaxresp.data === true) {
                    $('').html('');
                }
                else if (ajaxresp.data === false) {
                    $('').html('');
                }
            },
        });

    }

    //Tra cứu bệnh nhân
    function GetPatSerarchView(keyword) {
        var zyh = keyword;
        if (!!!keyword) {
            zyh = '';
        }
        $.modalOpen({
            id: "",
            title: "",
            url: "" + '' + "" + Math.random() + "" + zyh,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid(); //Trong sự kiện cửa sổ bật lên
                //Gọi tra cứu số thẻ và số nhập viện
            }//Hàm callback xác nhận khi nhấn cửa sổ
        });

    }

    //Bệnh nhân đã chọn callback
    function getPatInfoAjax(selePatInfo) {
        $('').val(selePatInfo.zyh);
        ajaxLoadDataResult();
    }

    //Tải thông tin cơ bản nhập viện
    function ajaxLoadDataResult() {
        var zyh = $('').val();
        if (zyh) {
            $.najax({
                type: "",
                url: "" + zyh,
                loading: true,
                success: function (ajaxresp) {
                    setPatInfoModel(ajaxresp.data.patInfo);

                    reloadGrid();
                },
                errorCallback: function (err) {
                    newtouch_globalevent_f4();
                    $('').trigger('');
                }
            });
        }
        else {
            GetPatSerarchView();
        }
    }

    //Khởi tạo thông tin bệnh nhân
    function setPatInfoModel(patModel) {
        $('').html(patModel.xm);
        $('').html($.getGender(patModel.xb));
        $('').html(getAgeFromBirthTime({ begin: patModel.csny }).text);
        $('').html(patModel.ryzdmc);
        $('').html(patModel.zjh);
        $('').html(patModel.phone);
        $('').html(patModel.csny ? patModel.csny.substring(0, 10) : '');
        $('').html(patModel.ryrq ? patModel.ryrq.substring(0, 10) : '');

    }

    function newtouch_event_f8() {
        var zyh = $('').val();
        if (!!!zyh) {
            $.modalAlert("", '');
            return;
        }
        var isExistUnSetted = $('').html();
        if (isExistUnSetted.indexOf('') != -1) {
            $.modalConfirm("", function (flag) {
                if (flag) {
                    $('').trigger('');
                }
            });
            return;
        }
        var allLine = $("").jqGrid('', null, true);
        if (!!!allLine || allLine.length == 0) {
            $.modalAlert("", '');
            return;
        }
        //Gửi
        var postData = { zyh: zyh, cyrq: $('').val() };
        $.submitForm({
            type: "",
            url: "",
            param: postData,
            success: function (ajaxresp) {
                location.href = location.href;
            },
        });

    }

</script>
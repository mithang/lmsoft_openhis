	function AcceptClick(callBack) {
		var dzsjinput = {
			daycollate: $("#daycollate").val(), //Ngày đối soát Định dạng ngày 8 Không được để trống
			daycount: $("#daycount").val(),//Số lượng mã giao dịch trung tâm ngày đối soát Định dạng số B Không được để trống
			totalcuraccpay: $("#totalcuraccpay").val(), //Tổng số tiền tài khoản thanh toán trong năm Định dạng số A Không được để trống
			totalhisaccpay: $("#totalhisaccpay").val(), //Tổng số tiền tài khoản thanh toán các năm trước Định dạng số A Không được để trống
			totalcashpay: $("#totalcashpay").val(), //Tổng số tiền mặt tự trả Định dạng số A Không được để trống
			totaltcpay: $("#totaltcpay").val(), //Tổng số tiền thanh toán từ quỹ chung Định dạng số A Không được để trống
			totaldffjpay: $("#totaldffjpay").val(), //Tổng số tiền thanh toán bổ sung Định dạng số A Không được để trống
			totalflzf: $("#totalflzf").val(), //Tổng số tiền tự trả phân loại Định dạng số A Không được để trống
			totalfybjsfw: $("#totalfybjsfw").val(), //Tổng chi phí ngoài phạm vi quyết toán bảo hiểm y tế
		};
		callBack(dzsjinput);
		$.modalClose();
	}
</script>
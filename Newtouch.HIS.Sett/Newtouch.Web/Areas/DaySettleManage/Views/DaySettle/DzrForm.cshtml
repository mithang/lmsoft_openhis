<script>

	function checkMoney(obj) {
		obj.value = obj.value.replace(/[^\d.]/g, "");  //Xóa“Số”Và“.”以外的字符
		obj.value = obj.value.replace(/\.{2,}/g, ""); //只保留第一个. 清除多余的
		obj.value = obj.value.replace("", "").replace(/\./g, "").replace("", "");
		obj.value = obj.value.replace(/^(\-)*(\d+)\.(\d\d).*$/, '');//只能输入两个小数
		if (obj.value.indexOf("") < 0 && obj.value != "") {//以上已经过滤，此处控制的是如果没有小数点，首位不能为类似于 01、02số tiền
			obj.value = parseFloat(obj.value);
		}
	}

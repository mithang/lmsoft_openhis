							$("").val(refinfo[i].daycount);
							$("").val(refinfo[i].totalcashpay);
							$("").val(refinfo[i].totalcuraccpay);
							$("").val(refinfo[i].totaldffjpay);
							$("").val(refinfo[i].totalflzf);
							$("").val(refinfo[i].totalfybjsfw);
							$("").val(refinfo[i].totalhisaccpay);
							$("").val(refinfo[i].totaltcpay);

						} else {
							$("" + refinfo[i].typetext+"").val(refinfo[i].daycount);
							$("" + refinfo[i].typetext +"").val(refinfo[i].totalcashpay);
							$("" + refinfo[i].typetext +"").val(refinfo[i].totalcuraccpay);
							$("" + refinfo[i].typetext +"").val(refinfo[i].totaldffjpay);
							$("" + refinfo[i].typetext +"").val(refinfo[i].totalflzf);
							$("" + refinfo[i].typetext +"").val(refinfo[i].totalfybjsfw);
							$("" + refinfo[i].typetext +"").val(refinfo[i].totalhisaccpay);
							$("" + refinfo[i].typetext +"").val(refinfo[i].totaltcpay);
						}
					}
				} else {
					$.modalAlert($("").val()+"", '');
				}
				
			}
		});
	}

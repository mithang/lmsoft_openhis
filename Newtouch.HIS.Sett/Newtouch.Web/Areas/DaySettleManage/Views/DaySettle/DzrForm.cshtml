<script>

	function checkMoney(obj) {
		obj.value = obj.value.replace(/[^\d.]/g, "");  //Xóa“Số”và“.”ký tự khác
		obj.value = obj.value.replace(/\.{2,}/g, "."); //chỉ giữ lại ký tự đầu tiên. xóa các ký tự thừa
		obj.value = obj.value.replace(".", "$#$").replace(/\./g, "").replace("$#$", ".");
		obj.value = obj.value.replace(/^(\-)*(\d+)\.(\d\d).*$/, '$1$2.$3');//chỉ được nhập hai chữ số thập phân
		if (obj.value.indexOf(".") < 0 && obj.value != "") {//đã lọc ở trên，Ở đây kiểm soát nếu không có dấu thập phân，ký tự đầu tiên không thể giống như 01、02 số tiền
			obj.value = parseFloat(obj.value);
		}
	}
	function clickcssj() {
		$.ajax({
			type: "POST",
			url: "/DaySettleManage/DaySettle/Newdzfysj",
			data: { rq: $("#txtCreateTime").val()},
			dataType: "json",
			async: false,
			success: function (data) {
				var refinfo = data;
				console.log(refinfo);
				if (refinfo.length > 0) {
					$("#daycollate").val(refinfo[0].daycollate);
					for (var i = 0; i < refinfo.length; i++) {
						if (refinfo[i].typetext == "all") {
							$("#daycount").val(refinfo[i].daycount);
							$("#totalcashpay").val(refinfo[i].totalcashpay);
							$("#totalcuraccpay").val(refinfo[i].totalcuraccpay);
							$("#totaldffjpay").val(refinfo[i].totaldffjpay);
							$("#totalflzf").val(refinfo[i].totalflzf);
							$("#totalfybjsfw").val(refinfo[i].totalfybjsfw);
							$("#totalhisaccpay").val(refinfo[i].totalhisaccpay);
							$("#totaltcpay").val(refinfo[i].totaltcpay);

						} else {
							$("#" + refinfo[i].typetext+"daycount").val(refinfo[i].daycount);
							$("#" + refinfo[i].typetext +"totalcashpay").val(refinfo[i].totalcashpay);
							$("#" + refinfo[i].typetext +"totalcuraccpay").val(refinfo[i].totalcuraccpay);
							$("#" + refinfo[i].typetext +"totaldffjpay").val(refinfo[i].totaldffjpay);
							$("#" + refinfo[i].typetext +"totalflzf").val(refinfo[i].totalflzf);
							$("#" + refinfo[i].typetext +"totalfybjsfw").val(refinfo[i].totalfybjsfw);
							$("#" + refinfo[i].typetext +"totalhisaccpay").val(refinfo[i].totalhisaccpay);
							$("#" + refinfo[i].typetext +"totaltcpay").val(refinfo[i].totaltcpay);
						}
					}
				} else {
					$.modalAlert($("#txtCreateTime").val()+"Chưa phát sinh bất kỳ chi phí quyết toán nào！", 'warning');
				}
				
			}
		});
	}
    function dzqq() {
        if ($("#daycollate").val() == null || $("#daycollate").val()=="") {
            $.modalAlert("Vui lòng chọn nút tạo để tạo dữ liệu đối soát！", 'warning');
            return;
        }
		$.loading(true, "Bắt đầu yêu cầu đối soát Vui lòng đợi một chút！！");

		var dzsjinput = {
			daycollate: $("#daycollate").val(), //Ngày đối soát Định dạng ngày 8 Không được để trống
			daycount: $("#daycount").val(),//Số lượng mã giao dịch trung tâm ngày đối soát Định dạng số B Không được để trống
			totalcuraccpay: $("#totalcuraccpay").val(), //Tổng số tiền tài khoản thanh toán trong năm Định dạng số A Không được để trống
			totalhisaccpay: $("#totalhisaccpay").val(), //Tổng số tiền tài khoản thanh toán các năm trước Định dạng số A Không được để trống
			totalcashpay: $("#totalcashpay").val(), //Tổng số tiền mặt tự trả Định dạng số A Không được để trống
			totaltcpay: $("#totaltcpay").val(), //Tổng số tiền thanh toán từ quỹ chung Định dạng số A Không được để trống
			totaldffjpay: $("#totaldffjpay").val(), //Tổng số tiền thanh toán bổ sung Định dạng số A Không được để trống
			totalflzf: $("#totalflzf").val(), //Tổng số tiền tự trả phân loại Định dạng số A Không được để trống
			totalfybjsfw: $("#totalfybjsfw").val(), //Tổng chi phí ngoài phạm vi quyết toán bảo hiểm y tế
			operatorId: '@(opr.rygh)',
			operatorName: '@(opr.UserName)',
			hisId: "0",
			insuplc_admdvs:"",
		};
		$.ajax({
			type: "POST",
			url: "http://127.0.0.1:33333/api/FifthPhaseYiBao/ybInterface_SL01",
			data: dzsjinput,
			dataType: "json",
			async: false,
			success: function (data) {
                var refinfo = eval('(' + data + ')');;
                console.log("Đối soát trả về：", refinfo);
                $("#dzjg").val(data);
                if (refinfo.xxfhm == "P900") {
                    $.modalAlert(refinfo.fhxx, 'warning');
                } else {
                    $.modalAlert("Đối soát thành công", 'success');
                }
			},
			error: function (ex) {
				console.log("Yêu cầu đối soát báo lỗi trả về：", ex);
				$("#dzjg").val(ex);
			}
		});
		setTimeout(function () {
			$.loading(false);
		},3000);
    }
    $("#btn_search_ls").click(function () {
        $.modalOpen({
            id: "DzrHistory",
            title: "Lịch sử đối soát",

					<input type="button" id="btn_search_td" class="btn btn-primary btn-md" style="margin-left:10px;width:50px;" value="清算撤销" />
					@*<input type="button" id="btn_search_gb" class="btn btn-primary btn-md" style="margin-left:10px;width:60px;" value="Đóng" />*@
				</td>
				<td class="formValue"></td>
			</tr>
		</table>
	</div>
	<div style="background-color: #fff;">

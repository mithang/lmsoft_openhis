	$("").click(function () {
		var seleRowid = $("").jqGrid("", "");
		if (!(seleRowid)) {
			$.modalAlert("", '');
			return;
		}

		var rowData = $("").jqGrid('', seleRowid);
		var ksrq = $("").val()+"";
		var jsrq = $("").val()+"";
		var predata = {
			hisId: "",
			operatorId: '',
			operatorName:'',
			insuplc_admdvs: "",
			stmt_begndate: ksrq,
			stmt_enddate: jsrq,
			insutype: rowData.xz,
			clr_type: rowData.qslb,
			setl_optins: "",
			medfee_sumamt: rowData.zfy,
			fund_pay_sumamt: rowData.jjzfje,
			acct_pay: rowData.grzh,
			fixmedins_setl_cnt: rowData.jsbs,
			refd_setl_flag:"",
		};

		$.ajax({
			type: "",
			url: "",
			data: predata,
			dataType: "",
			async: false,
			success: function (data) {
			    var refinfo = eval('' + data + '');
			    if (refinfo.infcode == "" || refinfo.infcode == 0)
			    {
			        var msg = refinfo.output.stmtinfo.stmt_rslt == 1 ? "" : refinfo.output.stmtinfo.stmt_rslt == 0 ? "" : "";
			        if (refinfo.output.stmtinfo.stmt_rslt == "") {
			            $("").val(rowData.ksrq +""+ rowData.jsrq + "" + rowData.xzmc + "");
			            insertsqb(rowData);
			        } else {
			            $("").val(refinfo.output.stmtinfo.stmt_rslt_dscr);
			        }
			    }else
			        $.modalAlert("" + refinfo.err_msg, '');
			},
			error: function (request, error, ex) {
			    $.modalAlert("" + ex + "", '');
			}
		});


	});


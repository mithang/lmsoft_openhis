
@{
	ViewBag.Title = "";
	Layout = "";
	var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}
<style>
	.red {
		color: red;
	}
</style>
<form name="form1">
	<div class="panel panel-default">
		<table class="form">
			<tr>
				<th class="formTitle" id="thCZRQ">Ngày quyết toán：</th>
				<td class="formValue" colspan="2">
					<input id="ksrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:130px; float:left;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
					<span style="margin-left:2%;float:left;">—</span>
					<input id="jsrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width :130px;float:left;margin-left:2%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
				</td>
				<th class="formTitle">清算类型：</th>
				<td class="formValue">
					<select class="form-control" id="jslx" style="width:140px;"></select>
				</td>
				@*<th class="formTitle">Loại hình bảo hiểm：</th>
				<td class="formValue">
					<select class="form-control" id="xzlx" style="width:140px;"></select>
				</td>*@
				<td  class="formValue">
					<input type="button" id="btn_search_tj" class="btn btn-primary btn-md"  value="Thống kê" />
					<input type="button" id="btn_search_dmx" class="btn btn-primary btn-md"  value="开始明细对账" />
				</td>
			</tr>
		</table>
	</div>



	<div class="gridPanel" style="width:98%">
		<table id="gridJSList"></table>
		<div id="gridPager"></div>
	</div>

	<div class="gridPanel" style="width:98%">
		<table id="gridJSList1"></table>
		<div id="gridPager1"></div>
	</div>


</form>

<script>
    $(function () {
        //Tải lại khi thay đổi kích thước cửa sổ trình duyệtjqGridchiều rộng của
        $(window).resize(function () {
            initLayout("");
        });
		getclrtypeList();
		//getinsutypeList();
        //Bản ghi chính quyết toán
        gridJSListData();
        gridJSListData1();
    });


	function getclrtypeList() {

		$.ajax({
			type: "",
			url: "",
			//data: { mllx: mzlx },
			dataType: "",
			async: false,
			success: function (ajaxresp) {

				$.each(ajaxresp, function () {
					var option = "" + this.value + "" + this.label + "";
					$("").append(option);
				});
			}
		});
	}

	function getinsutypeList() {

		$.ajax({
			type: "",
			url: "",
			//data: { mllx: mzlx },
			dataType: "",
			async: false,
			success: function (ajaxresp) {

				$.each(ajaxresp, function () {
					var option = "" + this.value + "" + this.label + "";
					$("").append(option);
				});
			}
		});
	}
	
    function gridJSListData() {
        var gridSort = '';
        var $gridJsList = $("");
        $gridJsList.dataGrid({
            //postData: getSearchPostData(),
			height: 300,
			caption: "",
            url: "",
            colModel: [
                { label: '', name: '', width: 180, align: '' },
                { label: '', name: '', width: 140, align: '' },
                { label: '', name: '', width: 140, align: '' },
                { label: '', name: '', width: 80, align: '' },
				{
					label: '', name: '', width: 130, align: '',
					formatter: "", formatoptions: { srcformat: '', newformat: '' } },
                { label: '', name: '', width: 80, align: '' },
				{ label: '', name: '', width: 80, align: '' },
				{ label: '', name: '', width: 80, align: '' },
				{ label: '', name: '', width: 80, align: '' },
				{ label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 120, align: '' },
                { label: '', name: '', width: 80, align: '' },
                //{ label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 80, align: '' },
                { label: '', name: '', width: 80, align: '' },
            ],
            //pager: "",
            //sortname: gridSort,
			unwritten: false,
			viewrecords: true,
			//footerrow: true,
			//userDataOnFooter: true,
			loadComplete: function () {

				var gridData = $("").jqGrid('');
				var sl = gridData.length;
				var zfy = 0.00;
				var jjzfje = 0.00;
				var grzhje = 0.00;
				var xjzfje = 0.00;
				if (sl>0) {
					$.each(gridData, function () {
						zfy += parseFloat(this.zfy);
						jjzfje += parseFloat(this.jjzfje);
						grzhje += parseFloat(this.acct_pay);
						xjzfje += parseFloat(this.psn_cash_pay);
						
					});
				}
				zfy = parseFloat(zfy).toFixed(2);
				jjzfje = parseFloat(jjzfje).toFixed(2);
				grzhje = parseFloat(grzhje).toFixed(2);
				xjzfje = parseFloat(xjzfje).toFixed(2);
				var textcaption = "" + sl + "" + zfy + "" + jjzfje + "" + grzhje + "" + xjzfje + "";
				$("").jqGrid("", textcaption);
				
				//$("").jqGrid('', '', { name: "", count: gridData.length });

			},
            onSelectRow_page: function (rowid) {
                //console.log(rowid);
            },
            gridComplete: function (gridJszbList) {
                //jszbList = null;
                //if (gridJszbList && gridJszbList.rows) {
                //    jszbList = gridJszbList.rows;
                //}
            }
        });

        //Thống kê sự kiện nhấn nút 
        $("").click(function () {
			$('').jqGrid("");//Xóa trống chi tiết trước
            $gridJsList.jqGrid('', {
				postData: { ksrq: $("").val(), jsrq: $("").val(), jslx: $("").val(), xzlx: '' },
				url: '',
                //page: 1,
            }).trigger('');
        });
    }

	$("").click(function () {

		var ksrq = $("").val() +"";
		var jsrq = $("").val() +"";
		var ts = Date.parse(jsrq) - Date.parse(ksrq)+1;
		//if (ts >= 11) {
		//	$.modalAlert("", '');
		//	return false;
		//}

		var predata = {
			hisId : "",
			operatorId : '',
		    operatorName: '',
		    orgId: '',
			insuplc_admdvs : "",
			stmt_begndate: ksrq,
			stmt_enddate: jsrq,
			insutype: '',
			clr_type: $("").val(),
			setl_optins : "",
			medfee_sumamt : 0.00,
			fund_pay_sumamt : 0.0,
			acct_pay : 0.00,
			fixmedins_setl_cnt : 0,
			fileName : ""
		};
		var refinfo;
		$.ajax({
			type: "",
			url: "",
			data: predata,
			dataType: "",
			async: false,
			success: function (data) {
			    refinfo = eval('' + data + '');
			},
			error: function (request, error, ex) {
			    $.modalAlert("" + ex + "", '');
			}
		});

		if (refinfo) {
		    if (refinfo.infcode == "" || refinfo.infcode == 0)
		    {
		        if (refinfo.result && refinfo.result.length > 0)
		        {
		            $('').jqGrid("");//Xóa trống chi tiết trước
		            $('').jqGrid('', {
		                postData: { ksrq: $("").val(), jsrq: $("").val(), jslx: $("").val(), xzlx: '' },
		                url: '',
		                //page: 1,
		            }).trigger('');
		        }
		    } else {
		        $.modalAlert("" + refinfo.err_msg, '');
		    }
		} else {
		    $.modalAlert("", '');
		}

	});

    function gridJSListData1() {
        var gridSort = '';
        var $gridJsList1 = $("");
        $gridJsList1.dataGrid({
            //postData: getSearchPostData(),
            height: 200,
            url: "",
            colModel: [
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
            ],
            //pager: "",
            //sortname: gridSort,
			viewrecords: true,
			footerrow: true,
			userDataOnFooter: true,
			loadComplete: function () {

				//var gridData = $("").jqGrid('', '');
			},
            onSelectRow_page: function (rowid) {
               // console.log(rowid);
            },
            gridComplete: function () {
				var ids = $("").jqGrid('');
				for (i = 0; i < ids.length; i++) {
					var rowData = $("").jqGrid('', ids[i]);
					if (rowData.bz.length >4) {
						$('' + ids[i] + '').addClass('');
					} 
					
				}
			},
        });

        //Sự kiện tra cứu
        $("").click(function () {
			$('').jqGrid("");//Xóa trống chi tiết trước
			$gridJsList1.jqGrid('', {
				postData: { ksrq: $("").val(), jsrq: $("").val(), jslx: $("").val(), xzlx: ''},
				url: '',
                //page: 1,
            }).trigger('');
        });
    }

</script>


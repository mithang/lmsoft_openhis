@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
}
<style>
    .newform-control {
        height: 24px;
        padding-top: 0px;
        padding-bottom: 0px;
        padding-right: 0px;
        padding-left: 5px;
        resize: none;
        border-radius: 4px;
        box-shadow: none;
        border: 1px solid #ddd;
    }

    .newformTitle {
        position: relative;
        left: 0px;
        text-align: right;
        white-space: nowrap;
        font-weight: normal;
        padding-right: 15px;
    }

    .form-control:focus {
        -webkit-box-shadow: inset 0 0px 1px rgba(0,0,0,.075) !important;
    }
</style>
<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <th class="newformTitle">Ngày quyết toán：</th>
                <td>
                    <input readonly id="kssj" type="text" class="newform-control form-control" placeholder="Ngày quyết toán lần trên" style="width: 88%;">
                </td>
                <th class="newformTitle">—</th>
                <td>
                    <input readonly id="jssj" type="text" class="newform-control form-control" placeholder="Ngày quyết toán lần quyển" style="width: 88%;" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")">
                </td>
            </tr>
        </table>
    </div>
</div>
    
<div class="gridPanel" style="margin-top:1%">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 6, 7 },
    F6Text = "",
    F7Text = ""
})
<script>
    $(function () {
        getLastDaySettTime();
        gridList();
    })

    //Lấy thời gian quyết toán ngày lần trên
    function getLastDaySettTime() {
        $.najax({
            url: "",
            dataType: "",
            data: { mzzybz: "" },
            type: "",
            success: function (data) {
                $("").val(data.data);
            }
        });
    }

    //Chi tiết quyết toán ngày
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            postData: getSearchPostData(),
            height: $(window).height() - 175,
            colModel: [
             { label: "", name: "", hidden: true, key: true },
             {
                 label: "", name: "", width: 100, align: "",
                 formatter: function (val) {
                     if (val) {
                         return val.toFixed(2);
                     } else {
                         return ""
                     }
                 }
             },
             { label: "", name: "", width: 400, align: "" },
             { label: "", name: "", width: 150, align: "" },
             { label: "", name: "", width: 150, align: "", formatter: "", formatoptions: { srcformat: '', newformat: '' } },
             { label: "", name: "", width: 150, align: "", formatter: "", formatoptions: { srcformat: '', newformat: '' } }
            ],
            pager: "",
            sortname: '',
            viewrecords: true
        });
    }

    //Điều kiện tra cứu
    function getSearchPostData() {
        return { mzzybz: "" };
    };

    //Xác nhận quyết toán ngày
    function newtouch_event_f6() {
        $.modalConfirm("", function (flag) {
            if (!flag) {
                return;
            }
            else {
                $.najax({
                    type: "",
                    url: "",
                    dataType: "",
                    success: function (data) {
                        $.modalAlert("", '');
                        $.modalClose();
                        $("").jqGrid('');  //Xóa trống bảng
                        $("").jqGrid('').trigger("");
                    },
                    errorCallback: function (err) {
                        $.modalAlert(err.message, '');
                        $.modalClose();
                    }
                });
            }
        });
    }

    //Xác nhận hoàn phí
    function newtouch_event_f7() {
        //Lấy dòng đã chọnId
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        //Bật lên cửa sổ xác nhận
        $.modalConfirm("", function (flag) {
            if (!flag) {
                return;
            }
            else {
                $.najax({
                    type: "",
                    url: "",
                    data: { Id: seleRowid },
                    dataType: "",
                    success: function (data) {
                        $.modalAlert("", '');
                        $.modalClose();
                        $("").jqGrid('');  //Xóa trống bảng
                        $("").jqGrid('').trigger("");
                    },
                    errorCallback: function (err) {
                        $.modalAlert(err.message, '');
                        $.modalClose();
                    }
                });
            }
        });
    }
</script>

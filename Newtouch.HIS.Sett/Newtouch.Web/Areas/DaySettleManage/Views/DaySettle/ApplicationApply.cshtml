
@{
	ViewBag.Title = "";
	Layout = "";
	var opr = Newtouch.Common.Operator.OperatorProvider.GetCurrent();
}

<form name="form1">
	<div class="panel panel-default">
		<table class="form">
			<tr>
				<th class="formTitle" id="thCZRQ">Ngày quyết toán：</th>
				<td class="formValue" colspan="2">
					<input id="ksrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:20%; float:left;" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
					<span style="margin-left:2%;float:left;">—</span>
					<input id="jsrq" type="text" class="form-control input-wdatepicker formClearIgnore" style="width :20%;float:left;margin-left:2%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />

					<text style="margin-left:2%">Có phải nơi khác không：</text>
					<text></text>
					<input type="radio" name="sfyd" value="Không" checked />
					<label>Cục bộ</label>
					<input type="radio" name="sfyd" value="Có" />
					<label>异地</label>
					<input type="button" id="btn_tj" class="btn btn-primary btn-md" style="margin-right:10px;width:40px;" value="Thống kê" />
					<input type="button" id="btn_sq" class="btn btn-primary btn-md" style="margin-right:10px;width:40px;" value="Đăng ký" />
					@*<input type="button" id="btn_gb" class="btn btn-primary btn-md" style="margin-right:10px;width:80px;" value="Đăng ký hủy" />*@
				</td>
				<td class="formValue"></td>
			</tr>
		</table>
	</div>



	<div style="background-color: #fff;">
		<table id="gridJSList"></table>
	</div>
	<div style="background-color: #fff; margin-top:5px;">
		<table id="gridJSMXList"></table>
	</div>
	<div class="gridPanel">
		<table id="gridJSList"></table>
		<div id="gridPager"></div>
	</div>



	@* 底部表格 *@
	<div style="background-color: #fff;">
		<table id="gridJSList1"></table>
	</div>
	<div style="background-color: #fff; margin-top:5px;">
		<table id="gridJSMXList1"></table>
	</div>
	<div class="gridPanel">
		<table id="gridJSList1"></table>
		<div id="gridPager1"></div>
	</div>



</form>


<script>
    $(function () {
        //Tải lại khi thay đổi kích thước cửa sổ trình duyệtjqGridchiều rộng của
        $(window).resize(function () {
            initLayout("");
        });

        gridJSListData();

    });

    function gridJSListData() {
        var gridSort = '';
        var $gridJsList = $("");
        $gridJsList.dataGrid({
            //postData: getSearchPostData(),
            height: 500,
            url: "",
            colModel: [
				{
					label: '', name: '', width: 100, align: '', formatter: function (val, a, b) {
						if (val == "") {
							return ""
						} else {
							return ""
						}
					} },
				{ label: '', name: '', hidden: true, align: '' },
				{ label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
				{ label: '', name: '', width: 100, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
				{ label: '', name: '', width: 100, align: '', formatter: "", formatoptions: { srcformat: '', newformat: '' } },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
				{ label: '', name: '', width: 100, align: '' },
				{ label: '', name: '', width: 100, align: '' },
				{ label: '', name: '', width: 100, align: '' },
				{ label: '', name: '', width: 100, align: '' },
				{ label: '', name: '', width: 100, align: '' },
				{ label: '', name: '', width: 100, align: '' },
				{ label: '', name: '', width: 100, align: '' },
				{ label: '', name: '', width: 100, align: '' },
				{ label: '', name: '', width: 100, align: '' },
				{ label: '', name: '', width: 100, align: '' },
            ],
            //pager: "",
            //sortname: gridSort,
			viewrecords: true,
			footerrow: true,
			userDataOnFooter: true,
			loadComplete: function () {

				var gridData = $("").jqGrid('', '');

				$("").jqGrid('', '', { name: "", count: gridData.length });

			},
            onSelectRow_page: function (rowid) {
                //console.log(rowid);
            },
            gridComplete: function (gridJszbList) {
                //jszbList = null;
                //if (gridJszbList && gridJszbList.rows) {
                //    jszbList = gridJszbList.rows;
                //}
            }
        });

        //Sự kiện tra cứu
        $("").click(function () {
			$('').jqGrid("");//Xóa trống chi tiết trước
            $gridJsList.jqGrid('', {
				postData: { ksrq: $("").val(), jsrq: $("").val(), sfyd: $('').val() },
                url: '',
                //page: 1,
            }).trigger('');
        });
	}

	$("").click(function () {

		var seleRowid = $("").jqGrid("", "");
		if (!(seleRowid)) {
			$.modalAlert("", '');
			return;
		}

		var rowData = $("").jqGrid('', seleRowid);
		var ksrq = $("").val();
		var jsrq = $("").val();

		var predata = {
			hisId: "",
			operatorId: '',
			operatorName:'',
			clr_type: rowData.qslb,
			clr_way: "",
			setlym: rowData.qsny,
			psntime: rowData.qsrc,
			medfee_sumamt: rowData.zfy,
			med_sumfee: rowData.ybrkfyze,
			fund_appy_sum: rowData.jjzfze,
			cash_payamt: rowData.xjzfze,
			acct_pay: rowData.gzzf,
			begndate: ksrq,
			enddate: jsrq,
			sfyd: rowData.sfyd
		};

		$.ajax({
			type: "",
			url: "",
			data: predata,
			dataType: "",
			async: false,
			success: function (data) {
				var refinfo = eval('' + data + '');
				console.log(refinfo);
				if (refinfo.infcode == "") {
					$.modalAlert("", '');
					$("").click();
				} else {
					$.modalAlert(refinfo.err_msg,'');
				}

			}
		});
	});



</script>
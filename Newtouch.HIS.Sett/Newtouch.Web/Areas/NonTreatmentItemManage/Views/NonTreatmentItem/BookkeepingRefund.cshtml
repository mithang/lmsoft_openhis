@using Newtouch.Common.Operator;
@{
    ViewBag.Title = "";
    Layout = "";
}

<form name="form1">
    <div class="panel panel-default" style="margin-bottom: 10px;">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle" id="th_zyh" style="display:none">Số nhập viện：</th>
                    <td class="formValue" id="td_zyh" style="display:none">
                        <input type="text" class="form-control" id="zyh" placeholder="" />
                    </td>
                    <th class="formTitle">Số bệnh án：</th>
                    <td class="formValue" colspan="2">
                        <input type="text" class="form-control" id="blh" placeholder="" style="width: 48%; float: left;" />
                        <input type="button" class="btn btn-default btn-md btn-default-color" style="width: 15%;margin-left: 2%;" title="Chọn bệnh nhân" value="Tra cứu" onclick="GetPatSerarchView($('#blh').val(), $('#kehu').val());">
                    </td>
                    <th class="formTitle">Họ tên khách hàng：</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="kehu" placeholder="" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Nhân viên bán：</th>
                    <td class="formValue">
                        <input type="text" readonly="readonly" class="form-control" id="smry" data-smryCode="@OperatorProvider.GetCurrent().rygh" data-staffId="@OperatorProvider.GetCurrent().StaffId" value=@OperatorProvider.GetCurrent().UserName />
                    </td>
                    <th class="formTitle">Hạng mục thu phí：</th>
                    <td class="formValue">
                        <input type="text" class="form-control form-an" id="keyword" placeholder="Mã Tên" />
                    </td>
                    <th class="formTitle">Ngày ghi sổ：</th>
                    <td class="formValue" colspan="3">
                        <input id="kssj" type="text" class="form-control input-wdatepicker form-an" style="width:42%; float:left;" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        <span style="margin-left:2%;float:left;">—</span>
                        <input id="jssj" type="text" class="form-control input-wdatepicker form-an" style="width :41%;float:left;margin-left:2%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    </td>
                    <td>
                        <input type="button" id="btn_search" class="btn btn-primary form-an" style="width:48%;margin-left:10%;" value="Tra cứu" />
                    </td>
                    <td></td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>
@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 4, 6 },
    F6Text = ""
})
<script>
    $(function () {
        //Tải lại khi thay đổi kích thước cửa sổ trình duyệtjqGridchiều rộng của
        $(window).resize(function () {
            initLayout("");
        });
        gridList();
    })

    //Nhấn Enter số bệnh án
    $('').keydownEnterEvent(function () {
        if (!$("").val().trim()) {
            return;
        }
        var blh = $("").val();
        $('').val(blh.toUpperCase());
        $("").trigger('');
    })

    //Công tắc số nhập viện
    var isShowZyh = '';
    if (isShowZyh == '') {
        $('').css('', '');
        $('').css('', '');
        //住院号回车
        $('').keydownEnterEvent(function () {
            if (!$("").val().trim()) {
                return;
            }
            var zyh = $("").val();
            $('').val(zyh.toUpperCase());
            $("").trigger('');
        })
    }

    //Tra cứu bệnh nhân
    function GetPatSerarchView(blh, xm) {
        if (!!!blh) {
            blh = '';
        };
        if (!!!xm) {
            xm = '';
        };
        $.modalOpen({
            id: "",
            title: "",
            url: "" + Math.random() + "" + blh + "" + xm,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid();
            }//Hàm callback xác nhận khi nhấn cửa sổ
        });
    }

    //Bệnh nhân đã chọn callback
    function getPatInfoAjax(selePatInfo) {
        $('').val(selePatInfo.blh)
        $('').attr('', selePatInfo.patId);
        $('').val(selePatInfo.xm);
    }

    //姓名回车
    $('').keydownEnterEvent(function () {
        if (!$("").val().trim()) {
            return;
        }
        $("").trigger('');
    })

    //Mặc định
    var Editing_ysList = []; //Nhân viên trong vùng chỉnh sửa
    Editing_ysList = [{ id: $('').attr(''), gh: $('').attr(''), Name: $('').val(), ks: $('').attr(''), ksmc: $('').val() }];

    //Liên kết Nhân viên Cây
    $('').click(function () {
        var initIdSelected = "";
        $.each(Editing_ysList, function () {
            initIdSelected += this.id + "";
        })
        $.modalOpen({
            id: "",
            title: "",
            url: "" + initIdSelected,
            showleftlalbel: false,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].AcceptClick(function (data) {
                    staffTreeCallback(data);
                });
            }
        });
    });

    //Cây nhân viên Chọn Callback
    function staffTreeCallback(treeSeleData) {
        Editing_ysList = [];
        $.each(treeSeleData, function () {
            Editing_ysList.push({ id: treeSeleData[0].id, gh: treeSeleData[0].value, Name: treeSeleData[0].text, ks: treeSeleData[0].Ex1, ksmc: treeSeleData[0].Ex2 });
        })
        if (treeSeleData[0]) {
            $('').attr('', treeSeleData[0].id)
                .attr('', treeSeleData[0].value)
                .val(treeSeleData[0].text);

        } else {
            $('').attr('', '')
                .attr('', '')
                .val('');
        }
    }

    //Chi tiết
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            treeGridModel: "",
            url: "" + Math.random(),
            postData: getSearchPostData(),
            height: $(window).height() - 235,
            editurl: "",
            colModel: [
            { label: "", name: "", width: 25, align: "", hidden: true },
            { label: "", name: "", width: 100, align: "", hidden: true },
            { label: "", name: "", width: 60, align: "" },
            { label: "", name: "", width: 60, align: "" },
            { label: "", name: "", width: 100, align: "" },
            { label: "", name: "", width: 100, align: "" },
            { label: "", name: "", width: 100, align: "" },
            { label: "", name: "", width: 25, align: "", hidden: true },
            { label: "", name: "", width: 75, align: "" },
            {
                label: "", name: "", width: 80, align: "",
                formatter: function (val) {
                    if (val) {
                        return val.toFixed(4);
                    } else {
                        return '';
                    }
                }
            },
            {
                label: "", name: "", width: 80, align: "",
                formatter: function (val) {
                    if (val) {
                        return val.toFixed(2);
                    } else {
                        return '';
                    }
                }
            },
            { label: "", name: "", width: 120, editable: true, editrules: { integer: true, minValue: 1 }, align: "" },
            { label: "", name: "", width: 25, align: "", hidden: true },
            { label: "", name: "", width: 100, align: "" },
            { label: "", name: "", width: 25, align: "", hidden: true },
            { label: "", name: "", width: 90, align: "" },
            { label: "", name: "", width: 25, align: "", hidden: true },
            {
                label: "", name: "", width: 150, align: "",
                formatter: "", formatoptions: { srcformat: '', newformat: '' }
            },
            { label: "", name: "", width: 25, align: "", hidden: true },
            { label: "", name: "", width: 25, align: "", hidden: true },
            { label: "", name: "", width: 25, align: "", hidden: true }
            ],
            multiselect: true,
            pager: "",
            sortname: '',
            viewrecords: true,
            onSelectRow: function (rowid) {
                $("" + $.jgrid.jqID(rowid) + "").focus();
            },
            gridComplete: function () {
                //Bật hộp chỉnh sửa trong dòng
                EnableInlineEditBox();
            }
        });
        $("").click(function () {
            if ($('').val() && $('').val() && ($('').val() > $('').val())) {
                $.modalAlert("", '');
                return;
            }
            $gridList.jqGrid('', {
                postData: getSearchPostData(),
                page: 1,
            }).trigger('');
        })
    }

    //Bật hộp chỉnh sửa trong dòng
    function EnableInlineEditBox() {
        //GridTải xong bật chỉnh sửa trong dòng   1.Lấy tất cả các dòng trướcId  2.Gọi duyệteditRowPhương thức
        var rowIds = $("").jqGrid('');
        for (var i = 0; i < rowIds.length; i++) {

            $("").jqGrid('', rowIds[i], true, null, null, null, null, function (callbackRowId) {     //true: when set to true we can use [Enter] key to save the row and [Esc] to cancel editing.
            });
        }
    }

    //Điều kiện tra cứu
    function getSearchPostData() {
        var keyword = $("").val();
        var smry = "";
        if ($("").val()) {
            smry = $("").attr('');
        }
        var zyh = $("").val();
        var blh = $("").val();
        var kehu = $("").val();
        var kssj = $("").val();
        var jssj = $("").val();
        return { zyh: zyh, blh: blh, kehu: kehu, keyword: keyword, smry: smry, kssj: kssj, jssj: jssj };
    };

    //Xác nhận hoàn phí
    function newtouch_event_f6() {
        //Lấy dòng đã chọnId
        var selRowIds = $("").jqGrid('', '');
        if (selRowIds.length == 0) {
            $.modalAlert("", '');
            return;
        }
        //Lấy tất cả các dòngId，Duyệt để hộp chỉnh sửa ở trạng thái đã lưu
        var rowIds = $("").jqGrid('');
        for (var i = 0; i < rowIds.length; i++) {
            $("").saveRow(rowIds[i], null, null, null, function (callbackRowId) {

            }, null, null);
        }

        //Đánh giá số lượng trả lại
        for (var i = 0; i < selRowIds.length; i++) {
            var rowData = $("").jqGrid('', selRowIds[i]);
            if (!rowData) {
                break;
            }
            if (rowData.tsl.replace(/(^\s*)|(\s*$)/g, "") == "") {
                $.modalAlert("" + rowData.sfxmName + "", '');
                //Bật hộp chỉnh sửa trong dòng
                EnableInlineEditBox();
                return;
            }
            if (rowData.tsl <= 0 || isNaN(rowData.tsl) || rowData.tsl == "") {
                //Bật hộp chỉnh sửa trong dòng
                EnableInlineEditBox();
                return;
            }
            if (parseFloat(rowData.tsl) > parseFloat(rowData.sl)) {
                $.loading(false);
                $.modalAlert("" + rowData.sfxmName + "", '');
                //Bật hộp chỉnh sửa trong dòng
                EnableInlineEditBox();
                return;
            }
        }

        //true:Dòng đã chọn
        var data = $("").jqGrid('', true, false);
        //setItem/getItem
        localStorage.setItem("", data);
        //弹出退费确认窗体
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.loading(true, "");
                RefundMethod();
            },
            //弹窗点“X”事件和''Sự kiện
            cancelCallBack: function (iframeId) {
                //Bật hộp chỉnh sửa trong dòng
                EnableInlineEditBox();
            }
        });
    }


    //Thực hiện lưu cụ thể
    function RefundMethod() {
        //Lấy dữ liệu dòng đã chọn tất cả
        var needRefundData = $("").jqGrid('', true);
        for (var i = 0; i < needRefundData.length; i++) {
            var je = roundingBy4she6ru5chengshuang((parseFloat(needRefundData[i].dj) * parseFloat(needRefundData[i].tsl)), 2);
            //ChoGridgán giá trị số tiền trả lại trường của trong
            $('').jqGrid('', needRefundData[i].jqRowId, '', je);
        }
        var lastdata = $("").jqGrid('', true, false);
        $.najax({
            url: "",
            dataType: "",
            data: { data: lastdata },
            type: "",
            async: false,
            success: function (data) {
                top.top.window.frames[''].$.modalClose();
                $.loading(false);
                $.modalAlert("", '');
                //Xóa trốngGrid
                $('').jqGrid("");
                $("").trigger('');
                $.loading(false);
            },
            errCallback: function (err) {
                $.loading(false);
            },
            complete: function () {
                $.loading(false);
            }
        });
    }

    //Xóa
    function newtouch_event_f4() {
        $('').jqGrid("");
        $('').val('');
        $('').val('');
    }

</script>


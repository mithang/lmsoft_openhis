@using Newtouch.Common.Operator;
@{
    ViewBag.Title = "";
    Layout = "";
}

<form name="form1">
    <div class="panel panel-default">
        <div class="panel-heading navb-bg">
            Điều kiện lọc
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle" id="th_zyh" style="display:none">Số nhập viện：</th>
                    <td class="formValue" id="td_zyh" style="display:none">
                        <input type="text" class="form-control" id="zyh" placeholder="" />
                    </td>
                    <th class="formTitle">Số bệnh án：</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="blh" placeholder="" style="width: 54%; float: left;" />
                        <input type="button" class="btn btn-default btn-md btn-default-color" style="margin-left: 2%;" title="Chọn bệnh nhân" value="Tra cứu" onclick="GetPatSerarchView($('#blh').val(), $('#kehu').val());">
                    </td>
                    <th class="formTitle">Họ tên khách hàng：</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="kehu" placeholder="" />
                    </td>
                    <th class="formTitle">Nhân viên bán：</th>
                    <td class="formValue">
                        <input type="text" readonly="readonly" class="form-control" id="smry" data-smryCode="@OperatorProvider.GetCurrent().rygh" data-staffId="@OperatorProvider.GetCurrent().StaffId" value=@OperatorProvider.GetCurrent().UserName />
                    </td>
                    <th class="formTitle">Khoa bán：</th>
                    <td class="formValue formDdlSelectorTd" style="width: 11%;">
                        <select id="smks" class="form-control">
                            <option>==Vui lòng chọn==</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">项目分类：</th>
                    <td class="formValue formDdlSelectorTd">
                        <select id="sfdl" class="form-control">
                            <option value="">==Vui lòng chọn==</option>
                        </select>
                    </td>
                    <th class="formTitle">Hạng mục thu phí：</th>
                    <td class="formValue">
                        <input type="text" class="form-control form-an" id="keyword" placeholder="Mã Tên" />
                    </td>
                    <th class="formTitle">Ngày ghi sổ：</th>
                    <td class="formValue" colspan="3">
                        <input id="kssj" type="text" class="form-control input-wdatepicker form-an" style="width:42%; float:left;" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        <span style="margin-left:1%;float:left;">—</span>
                        <input id="jssj" type="text" class="form-control input-wdatepicker form-an" style="width :42%;float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    </td>
                    <td class="formValue">
                        <input type="button" id="btn_search" class="btn btn-primary form-an" style="width:85%" value="Tra cứu" />
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <div class="gridPanel">
        <table class="form" style="width:100%;height:25px;background-color:white;">
            <tr>
                <td>
                    <label style="height:7px;width:17%; margin-left:20%;background-color:white; border:1px solid #ddd"></label>
                    <span>&nbsp;表示未退费</span>
                </td>
                <td>
                    <label style="height:7px;width:17%; background-color:#f2dede; border:1px solid #ddd"></label>
                    <span>&nbsp;表示退费</span>
                </td>
                <td colspan="2"></td>
                <td colspan="2"></td>
                <td></td>
            </tr>
        </table>
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>

<script>
    $(function () {
        initControl();

        gridList();
    });

    //Nhấn Enter số bệnh án
    $('').keydownEnterEvent(function () {
        if (!$("").val().trim()) {
            return;
        }
        var blh = $("").val();
        $('').val(blh.toUpperCase());
        $("").trigger('');
    })
    //Công tắc số nhập viện
    var isShowZyh = '';
    if (isShowZyh == '') {
        $('').css('', '');
        $('').css('', '');
        //住院号回车
        $('').keydownEnterEvent(function () {
            if (!$("").val().trim()) {
                return;
            }
            var zyh = $("").val();
            $('').val(zyh.toUpperCase());
            $("").trigger('');
        })
    }

    //Tra cứu bệnh nhân
    function GetPatSerarchView(blh, xm) {
        if (!!!blh) {
            blh = '';
        };
        if (!!!xm) {
            xm = '';
        };
        $.modalOpen({
            id: "",
            title: "",
            url: "" + Math.random() + "" + blh + "" + xm,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid();
            }//Hàm callback xác nhận khi nhấn cửa sổ
        });
    }

    //Bệnh nhân đã chọn callback
    function getPatInfoAjax(selePatInfo) {
        $('').val(selePatInfo.blh)
        $('').attr('', selePatInfo.patId);
        $('').val(selePatInfo.xm);
    }

    //姓名回车
    $('').keydownEnterEvent(function () {
        if (!$("").val().trim()) {
            return;
        }
        $("").trigger('');
    })

    function initControl() {
        //加载收费大类树
        $("").bindSelect({
            url: ""
        });
        $('').bindSelect({
            url: ""
        });
    }

    //Mặc định
    var Editing_ysList = []; //Nhân viên trong vùng chỉnh sửa
    Editing_ysList = [{ id: $('').attr(''), gh: $('').attr(''), Name: $('').val(), ks: $('').attr(''), ksmc: $('').val() }];

    //Liên kết Nhân viên Cây
    $('').click(function () {
        var initIdSelected = "";
        $.each(Editing_ysList, function () {
            initIdSelected += this.id + "";
        })
        $.modalOpen({
            id: "",
            title: "",
            url: "" + initIdSelected,
            showleftlalbel: false,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].AcceptClick(function (data) {
                    staffTreeCallback(data);
                });
            }
        });
    });

    //Cây nhân viên Chọn Callback
    function staffTreeCallback(treeSeleData) {
        Editing_ysList = [];
        $.each(treeSeleData, function () {
            Editing_ysList.push({ id: treeSeleData[0].id, gh: treeSeleData[0].value, Name: treeSeleData[0].text, ks: treeSeleData[0].Ex1, ksmc: treeSeleData[0].Ex2 });
        })
        if (treeSeleData[0]) {
            $('').attr('', treeSeleData[0].value)
                .val(treeSeleData[0].text);
            $('').attr('', treeSeleData[0].Ex1)
                .val(treeSeleData[0].Ex2);

        } else {
            $('').attr('', '')
                .val('');
            $('').attr('', '')
                .val('');

        }
    }

    //Chi tiết
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            url: "",
            postData: getSearchPostData(),
            height: $(window).height() - 220,
            colModel: [
            { label: '', name: '', width: 100, align: '' },
            { label: '', name: '', width: 100, align: '' },
            { label: '', name: '', width: 100, align: '' },
            { label: "", name: "", width: 100, align: "" },
            { label: "", name: "", width: 100, align: "" },
            { label: "", name: "", width: 75, align: "" },
            {
                label: "", name: "", width: 75, align: "",
                formatter: function (val) {
                    if (val) {
                        return val.toFixed(2);
                    } else {
                        return '';
                    }
                }
            },
            {
                label: "", name: "", width: 75, align: "",
                formatter: function (val) {
                    if (val) {
                        return val.toFixed(4);
                    } else {
                        return '';
                    }
                }
            },
            { label: "", name: "", width: 80, align: "" },
            { label: "", name: "", width: 80, align: "" },
            {
                label: "", name: "", width: 100, align: "",
                formatter: "", formatoptions: { srcformat: '', newformat: '' }
            },
            { label: "", name: "", width: 80, align: "" },
            {
                label: "", name: "", width: 133, align: "",
                formatter: "", formatoptions: { srcformat: '', newformat: '' }
            }
            ],
            pager: "",
            sortname: '',
            viewrecords: true,
            gridComplete: function () {
                afterCompleteFunction();
            },
        });
        $("").click(function () {
            if ($('').val() && $('').val() && ($('').val() > $('').val())) {
                $.modalAlert("", '');
                return;
            }
            $gridList.jqGrid('',
                {
                    postData: getSearchPostData(),
                    page: 1,
                    url: ""
                }).trigger('');
        });
    }

    //Đã trả lại 背景色为红色
    function afterCompleteFunction() {
        var ids = $("").getDataIDs();
        for (i = 0; i < ids.length; i++) {
            var rowData = $("").getRowData(ids[i]);
            if (parseFloat(rowData.sl) < 0) {
                $("" + ids[i]).find("").addClass('');
            }
        }
    }

    //Điều kiện tra cứu
    function getSearchPostData() {
        var sfdl = $("").val();
        var keyword = $("").val();
        var smry = "";
        if ($("").val()) {
            smry = $("").attr('');
        }
        var smks = $("").val();
        var kssj = $("").val();
        var jssj = $("").val();
        var kehu = $("").val();
        var zyh = $("").val();
        var blh = $("").val();
        return { sfdl: sfdl, keyword: keyword, smry: smry, smks: smks, kssj: kssj, jssj: jssj, kehu: kehu, zyh: zyh, blh: blh };
    };

</script>


@using Newtouch.Common.Operator;
@{
    ViewBag.Title = "";
    Layout = "";

    var opr = OperatorProvider.GetCurrent();
}
<form name="form1">
    <div class="panel panel-default" style="margin-bottom: -1px;">
        <div class="panel-heading navb-bg">
            Thông tin khách hàng
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle" id="th_zyh" style="display:none">Số nhập viện：</th>
                    <td class="formValue" id="td_zyh" style="display:none">
                        <input type="text" class="form-control" id="zyh" placeholder="" />
                    </td>
                    <th class="formTitle">Số bệnh án：</th>
                    <td class="formValue" colspan="2">
                        <input type="text" class="form-control" id="blh" placeholder="" style="width: 60%; float: left;"/>
                        <input type="button" class="btn btn-default btn-md btn-default-color" style="width: 20%;margin-left: 2%;" title="Chọn bệnh nhân" value="Tra cứu" onclick="GetPatSerarchView($('#blh').val(), $('#xm111').val());">
                    </td>
                    <th class="formTitle" style="visibility:hidden;">Họ tên：</th>
                    <td class="formValue" style="visibility:hidden;">
                        <input type="text" class="form-control" id="xm111" placeholder="" style="width: 124%;" />
                    </td>
                    <th class="formTitle" style="visibility:hidden;"></th>
                    <td class="formValue" style="visibility:hidden;">
                        <input type="button" id="btn_search" class="btn btn-primary" style="width:75%" value="Tra cứu" />
                    </td>
                    <th class="formTitle"></th>
                    <td class="formValue" colspan="2"></td>
                    <th class="formTitle" id="th_formTitle" style="display:table-cell;"></th>
                    <td class="formValue" id="td_formTitle" style="display:table-cell;"></td>
                </tr>
            </table>
        </div>
    </div>
    <div class="panel panel-default" style="margin-bottom: -1px;margin-top:8px;">
        <div class="panel-heading navb-bg">
            Thông tin ghi sổ
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle"><span class="required">*</span>Họ tên khách hàng：</th>
                    <td class="formValue">
                        <input type="text" class="form-control form-an" id="xm" />
                    </td>
                    <th class="formTitle">Người giới thiệu：</th>
                    <td class="formValue">
                        <input type="text" class="form-control form-an" id="tjr" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Thời gian ghi sổ：</th>
                    <td class="formValue" style="width:14%;">
                        <input id="jzrq" type="text" class="form-control formClearIgnore form-an input-wdatepicker" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle"><span class="required">*</span>Hạng mục thu phí：</th>
                    <td class="formValue">
                        <input type="text" class="form-control form-an" id="sfxmName" />
                    </td>
                    <th class="formTitle" id="thdjdw"><span class="required">*</span>Đơn giá：</th>
                    <td class="formValue">
                        <input type="text" class="form-control newtouch_Readonly" id="dj" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Số lượng：</th>
                    <td class="formValue">
                        <input type="text" class="form-control form-an" id="sl" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Nhân viên bán：</th>
                    <td class="formValue">
                        <input type="text" readonly="readonly" class="form-control formClearIgnore form-an" id="smryName" data-smry="@opr.rygh" data-staffId="@opr.StaffId" value="@opr.UserName" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Khoa bán：</th>
                    <td class="formValue">
                        <input type="text" class="form-control formClearIgnore newtouch_Readonly" id="smks" data-smksCode="@opr.DepartmentCode" value="@opr.DepartmentName" />
                        <input id="editRowId" value="" style="display:none;" />
                    </td>
                </tr>
            </table>
        </div>
    </div>

    @Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 2, 3, 6, 9 },
    F2Text = "",
    F3Text = "",
    F6Text = "",
    F9Text = "",
    F9Hidden = true
})

    <div class="gridPanel">
        <table id="gridList"></table>
    </div>
    <div class="panel panel-default" style="margin-top:10px;">
        <div class="panel-heading navb-bg">
            Phải thu
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle">Khoản phải thu：</th>
                    <td class="formValue">
                        <label style="color:red;">￥</label>
                        <label id="labysk"></label>
                    </td>
                    <th class="formTitle">Số tiền thực thu：</th>
                    <td class="formValue">
                        <input type="text" id="txtssk" class="form-control shortenWidth required" placeholder="不可为负数" />
                    </td>
                    <th class="formTitle">Tiền thừa：</th>
                    <td class="formValue">
                        <label>￥</label>
                        <label id="labzl"></label>
                    </td>
                    @*<th class="formTitle">Phương thức thanh toán：</th>
                        <td class="formValue formDdlSelectorTd">
                            <select id="ddlzffs" class="form-control"></select>
                        </td>*@
                </tr>
            </table>
        </div>
    </div>
</form>
@Html.Partial("", new Newtouch.HIS.Web.Core.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 4, 8 },
})
<script>
    $(function () {
        //Tải lại khi thay đổi kích thước cửa sổ trình duyệtjqGridchiều rộng của
        $(window).resize(function () {
            initLayout("");
        });
        $('').attr('', '');
        $('').attr('', '');

        //initZffs();

        gridList([]);
    })

    //Công tắc số nhập viện
    var isShowZyh = '';
    //Tra cứu
    $('').click(function () {
        ajaxLoadDataResult();
        //}
    });

    //Nhấn Enter số bệnh án
    $('').keydownEnterEvent(function () {
        ajaxLoadDataResult();
    })

    if (isShowZyh == '') {
        $('').css('', '');
        $('').css('', '');
        $('').css('', '');
        $('').css('', '');
        
    }
    //弹层病人查询
    function GetPatSerarchView(blh, xm) {
        if (!!!blh) {
            blh = '';
        };
        if (!!!xm) {
            xm = '';
        };
        $.modalOpen({
            id: "",
            title: "",
            url: "" + Math.random() + "" + $.trim(blh) + "" + $.trim(xm),
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid();
            }//Hàm callback xác nhận khi nhấn cửa sổ
        });
    }

    //Bệnh nhân đã chọn callback
    function getPatInfoAjax(selePatInfo) {
        $('').val(selePatInfo.blh)
        $('').attr('', selePatInfo.patId);
        $('').val(selePatInfo.xm);
    }


    //Tra cứu thông tin bệnh nhân
    function ajaxLoadDataResult() {
        if (!$("").val().trim() && !$("").val().trim() && !$("").val().trim()) {
            return;
        }
        var blh = $('').val().trim();
        var zyh = $('').val().trim();
        var xm = $('').val().trim();
        $.najax({
            url: "" + blh + "" + zyh + "" + xm + "" + Math.random(),
            dataType: "",
            async: true,
            alertbierror: false,
            success: function (data) {
                if (data.length <= 0) {
                    $.loading(false);
                    $.modalAlert("", '');
                    $('').val('');
                    $('').val('');
                    $('').val('');
                    $('').val('');
                    return;
                }
                if (data.length == 1) {
                    $('').attr('', data[0].patId);
                    $('').val(data[0].zyh);
                    $('').val(data[0].xm);
                }
                if (data.length > 1) {
                    //弹层病人查询
                    GetPatSerarchView($('').val(), $('').val());
                }
            }
        });

    }

    //Mặc định
    var Editing_ysList = []; //Nhân viên trong vùng chỉnh sửa

    Editing_ysList = [{ id: $('').attr(''), gh: $('').attr(''), Name: $('').val(), ks: $('').attr(''), ksmc: $('').val() }];

    //Liên kết Nhân viên Cây
    $('').click(function () {
        var initIdSelected = "";
        $.each(Editing_ysList, function () {
            initIdSelected += this.id + "";
        })
        $.modalOpen({
            id: "",
            title: "",
            url: "" + initIdSelected,
            showleftlalbel: false,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].AcceptClick(function (data) {
                    staffTreeCallback(data);
                });
            }
        });
    });

    //Cây nhân viên Chọn Callback
    function staffTreeCallback(treeSeleData) {
        Editing_ysList = [];
        $.each(treeSeleData, function () {
            Editing_ysList.push({ id: treeSeleData[0].id, gh: treeSeleData[0].value, Name: treeSeleData[0].text, ks: treeSeleData[0].Ex1, ksmc: treeSeleData[0].Ex2 });
        })
        if (treeSeleData[0]) {
            $('').attr('', treeSeleData[0].id)
                          .attr('', treeSeleData[0].value) //value:gh
                          .val(treeSeleData[0].text);
            $('').attr('', treeSeleData[0].Ex1)
                      .val(treeSeleData[0].Ex2);
        } else {
            $('').attr('', '')
              .attr('', '') //value:gh
              .val('');
            $('').attr('', '')
                      .val('');
        }

    }

    //Lấy hạng mục thu phí điều trị không
    $('').sfxmFloatingSelector({
        djDecimalPlaces: 4,
        searchType: "",
        ajaxparameters: function ($thisinput) {
            return "" + $thisinput.val();
        },
        itemdbclickhandler: function ($thistr) {
            $('').attr('', $thistr.attr(''))
                .attr('', $thistr.attr(''))
                .attr('', $thistr.attr(''))
                .val($thistr.attr(''));
            $('').val($thistr.attr(''));;
            $("").text("" + $('').attr('') + "")
            $('').val(1);
        },
    });

    //Chi tiết ghi sổ
    function gridList(mydata) {
        var $gridList = $("");
        $gridList.newtouchLocalDataGrid({
            height: $(window).height() - 395,
            unwritten: false,
            colModel: [
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '', hidden: true },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '', hidden: true },
                { label: '', name: '', width: 100, align: '', hidden: true },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '', hidden: true },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '', hidden: true },
                { label: '', name: '', width: 100, align: '' },
                { label: '', name: '', width: 100, align: '' },
            ],
            ondblClickRow: function (rowid) {
                gridDbclickRow(rowid);
            },
            onSelectRow: function (rowid) {
                $('').removeAttr('');
                if ($('').attr('') != "") {
                    $('').removeAttr('');
                }
            }

        }, mydata);
    }

    //双击
    function gridDbclickRow(rowid) {
        if (rowid) {
            var getRowData = $("").jqGrid('', rowid);
            if (getRowData) {
                $("").val(getRowData.sfxmName);
                $("").val(getRowData.dj);
                $("").val(getRowData.sl);
                $("").val(getRowData.blh);
                $("").val(getRowData.xm);
                $("").val(getRowData.smryName);
                $("").val(getRowData.smks);
                $("").val(getRowData.tjr);
                $("").val(getRowData.jzrq);

                $('').val(rowid);
            }

            $('').attr('', '');
            $('').attr('', '');
            $('').show();
        }
    }


    //回车加载grid
    $('').keydownEnterEvent(function () {
        if ($('').val()) {            //是修改
            newtouch_event_f3();
            //Thao tác kiểu nút
            bottomButtonsReset();
        }
        else {
            newtouch_event_f2();
        }
    });

    //Lấy chi tiết
    function getEditRowData() {
        var count = $("").getGridParam('');
        //Kiểm tra chi tiết
        if (!CheckDetailData()) {
            return false;
        }
        var data = [{
            sfxmName: $("").val(),
            sfxmCode: $("").attr(''),
            dlCode: $("").attr(''),
            dw: $("").attr(''),
            dj: $("").val(),
            sl: $("").val(),
            je: roundingBy4she6ru5chengshuang((parseFloat($("").val()) * parseFloat($("").val())), 2),
            blh: $("").val(),
            patId: $("").attr(''),
            zyh: $('').val(),
            xm: $("").val(),
            smryName: $("").val(),
            smry: $("").attr(''),
            smks: $("").val(),
            smksCode: $("").attr(''),
            tjr: $("").val(),
            jzrq: $("").val()
        }];
        return data;
    }
    //Thêm nút
    function newtouch_event_f2() {
        if ($('').attr('') == "") {
            return;
        }
        //Kiểm tra chi tiết
        if (!CheckDetailData()) {
            return false;
        }
        //Lấy chi tiết
        var data = getEditRowData();
        //Xóa trống điều khiển
        ClearInput();
        $("").newtouchLocalDataGrid(null, data);
        //刷新应收款
        RefreshYSK();
    }

    //F9Hủy sửa
    function newtouch_event_f9() {
        if ($('').attr('') == "") {
            return;
        }
        //Xóa trống điều khiển
        ClearInput();
        bottomButtonsReset();
    }

    //Nút sửa
    function newtouch_event_f3() {
        if ($('').attr('') == "") {
            return;
        }
        if ($('').val()) {
            //Kiểm tra chi tiết
            if (!CheckDetailData()) {
                return false;
            }
            //Lấy chi tiết
            var data = getEditRowData();
            $('').jqGrid("", $('').val()); //Trướcremove掉那一行
            //Xóa trống điều khiển
            ClearInput();
            $("").newtouchLocalDataGrid(null, data);
            //刷新应收款
            RefreshYSK();
            bottomButtonsReset();
            $('').val('');
        }
        else {
            $('').attr('', '');
            //LấygridDòng đang được chọn hiện tại
            var seleId = $('').jqGrid('', '');
            if (seleId) {
                //Yêu cầu sửa dòng đó
                gridDbclickRow(seleId);
            }
            else {
                return;
            }
        }
    }

    //Xóa
    function newtouch_event_f6() {
        if ($('').attr('') == "") {
            return;
        }
        var del_rowid = $("").jqGrid('', '');
        if (!del_rowid) {
            $.loading(false);
            $.modalAlert("", '');
            return;
        }
        $('').jqGrid('', del_rowid);
        //刷新应收款
        RefreshYSK();
    }

    //计算应收款
    function RefreshYSK() {
        var ysk = 0;
        var count = $("").getGridParam('');
        if (count > 0) {
            var rowIDS = $("").getDataIDs();
            for (var i = 0; i < rowIDS.length; i++) {
                var getRow_je = $("").getRowData(rowIDS[i]).je;
                ysk = parseFloat(ysk) + parseFloat(getRow_je);
            }
            //入库金额
            $("").text(ysk.toFixed(2));
            $("").val(ysk.toFixed(2));
            $("").addClass('');
            $("").trigger('');
        } else {
            $("").text('');
        }
    }

    //Làm mới tiền thừa
    $("").change(function () {
        //Xóa trống trước
        $("").text('');
        if ($("").val() == "" || isNaN($("").val()) || $("").val() <= 0) {
            $.loading(false);
            $.modalAlert("", '');
            return;
        }
        var zl = parseFloat($("").val()) - parseFloat($("").text());
        $("").text(zl.toFixed(2)); //保留小数点后两位小数
    });


    //Lưu xác nhận
    function newtouch_event_f8() {
        var data = $("").jqGrid('', undefined, false);
        if (data == "") {
            $.loading(false);
            $.modalAlert("", '');
            return;
        }
        if (!$('').val()) {
            $.loading(false);
            $.modalAlert("", '');
            return;
        }
        if ($('').val().replace(/(^\s*)|(\s*$)/g, "") == null || $('').val().replace(/(^\s*)|(\s*$)/g, "") == "") {
            $.loading(false);
            $.modalAlert("", '');
            return;
        }
        if ($("").val() == "" || isNaN($("").val()) || $("").val() <= 0) {
            $.loading(false);
            $.modalAlert("", '');
            return;
        }
        if (parseFloat($('').val()) < parseFloat($("").text())) {
            $.loading(false);
            $.modalAlert("", '');
            return;
        } else {
            var zl = parseFloat($("").val()) - parseFloat($("").text());
            //弹出结算窗体
            showBillSuccessDialog($("").text(), $("").val(), 0, zl.toFixed(2));
        }
    }

    //Cửa sổ bật lên xác nhận số tiền
    function showBillSuccessDialog(ysk, ssk, srce, zl) {
        var url = "" + ysk
            + "" + ssk
            + "" + srce
            + "" + zl;
        $.modalOpen({
            id: "",
            title: "",
            url: url,
            width: "",
            height: "",
            callBack: function (iframeId) {
                $.loading(true, "");
                $.modalClose("");   //Đóng biểu mẫu số tiền quyết toán
                SaveMethod(ysk, ssk);
            }
        });
    }

    //Thực hiện lưu cụ thể
    function SaveMethod(ysk, ssk) {
        var data = $("").jqGrid('', undefined, false);
        $.najax({
            url: "",
            dataType: "",
            data: { data: data },
            type: "",
            async: false,
            success: function (data) {
                $.loading(false);
                $.modalAlert("", '');
                newtouch_globalevent_f4();
                $("").text('');
                $("").val('');
                $("").text('');
                $('').attr('', '')
                    .attr('', '')
                    .val('');
                $('').attr('', '')
                    .val('');
                $.loading(false);
            },
            errCallback: function (err) {
                $.loading(false);
            }
        });
    }

    function bottomButtonsReset() {
        $('').removeAttr('');
        $('').attr('', '');
        $('').attr('', '');
        $('').hide();
    }


    //Kiểm tra chi tiết
    function CheckDetailData() {
        if ($("").val() == "") {
            $.modalAlert("", '');
            return false;
        }
        if ($("").val() == "") {
            $.modalAlert("", '');
            return false;
        }
        if ($("").val() == "" || $("").val() <= 0 || isNaN($("").val()) || String($("").val()).indexOf("") > -1) {
            $.modalAlert("", '');
            return false;
        }
        if ($("").val() == "") {
            $.modalAlert("", '');
            return false;
        }
        if ($("").val() == "") {
            $.modalAlert("", '');
            return false;
        }
        if ($("").val() == "") {
            $.modalAlert("", '');
            return false;
        }
        if (!$("").val()) {
            $.modalAlert("", '');
            return false;
        }
        if ($("").val() > ""yyyy-MM-dd"") {
            $.modalAlert("", '');
            return false;
        }
        return true;
    }

    //Xóa trống điều khiển
    function ClearInput() {
        $('').val('');
        $('').val('');
        $('').val('');
    }

    //f4Xóa thao tác
    function newtouch_event_f4() {
        $('').jqGrid("");
    }

</script>

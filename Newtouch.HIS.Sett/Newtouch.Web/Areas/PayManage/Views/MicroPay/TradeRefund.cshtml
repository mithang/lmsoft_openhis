
@{
    ViewBag.Title = "TradeRefund";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<form id="formRefund">
    <div>
        <table class="form">
            <tr>
                <th class="formTitle">Phần còn lại có thể hoàn trả：</th>
                <td class="formValue">
                    <input type="text" class="form-control" style="border: none;" readonly="readonly" id="maxrfd"/>
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span style="color:red">*</span>Lý do hoàn tiền：</th>
                <td class="formValue">
                    <input type="text" class="form-control"  id="Reason"/>
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span style="color:red">*</span>Số tiền hoàn lại：</th>
                <td class="formValue">
                    <input type="text" class="form-control required"  id="Amt" />
                </td>
            </tr>
        </table>
    </div>

</form>
<script>
    var keyValue = $.request('outtradeno');
    var maxrfdAmt = $.request('maxrfd'); //Phần còn lại có thể hoàn trả
    var totalAmt = $.request('total'); //Phần còn lại có thể hoàn trả

    $(function() {
        $("#maxrfd").val(maxrfdAmt + " (đồng)");
    });

    function submitForm(callback) {
        var refundAmt = $("#Amt").val();
        var reason = $("#Reason").val();
        var reg = new RegExp("^[0-9]+(.[0-9]{1,3})?$");
        if (!reg.test(refundAmt)) {
            $.modalAlert('Vui lòng nhập số tiền đúng', 'error');
            return;
        }
        else if (refundAmt > maxrfdAmt) {
            $.modalAlert('Số tiền hoàn lại không được lớn hơn số tiền còn có thể hoàn trả', 'error');
            return;
        }
        if (reason == null || reason == undefined) {
            $.modalAlert('Vui lòng nhập lý do hoàn tiền', 'error');
            return;
        }

        $.submitForm({
            url: "/PayManage/MicroPay/Opr_TradeRefund?outTradeNo=" + keyValue + "&refundAmount=" + refundAmt + "&Reason=" + reason,
            loading: "Đang yêu cầu hoàn tiền，Vui lòng chờ...",  
            success: function (ajaxresp) {
                
                //$.currentWindow().$("#gridListRefd").resetSelection();
                //$.currentWindow().$("#gridListRefd").trigger("reloadGrid");
                callback();
            }
        });
    }
</script>
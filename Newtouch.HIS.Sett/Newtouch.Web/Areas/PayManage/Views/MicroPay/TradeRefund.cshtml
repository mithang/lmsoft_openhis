
@{
    ViewBag.Title = "";
    Layout = "";
}

<form id="formRefund">
    <div>
        <table class="form">
            <tr>
                <th class="formTitle">剩余可退：</th>
                <td class="formValue">
                    <input type="text" class="form-control" style="border: none;" readonly="readonly" id="maxrfd"/>
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span style="color:red">*</span>Nguyên nhân hoàn tiền：</th>
                <td class="formValue">
                    <input type="text" class="form-control"  id="Reason"/>
                </td>
            </tr>
            <tr>
                <th class="formTitle"><span style="color:red">*</span>Số tiền hoàn lại：</th>
                <td class="formValue">
                    <input type="text" class="form-control required"  id="Amt" />
                </td>
            </tr>
        </table>
    </div>

</form>
<script>
    var keyValue = $.request('');
    var maxrfdAmt = $.request(''); //剩余可退
    var totalAmt = $.request(''); //剩余可退

    $(function() {
        $("").val(maxrfdAmt + "");
    });

    function submitForm(callback) {
        var refundAmt = $("").val();
        var reason = $("").val();
        var reg = new RegExp("");
        if (!reg.test(refundAmt)) {
            $.modalAlert('', '');
            return;
        }
        else if (refundAmt > maxrfdAmt) {
            $.modalAlert('', '');
            return;
        }
        if (reason == null || reason == undefined) {
            $.modalAlert('', '');
            return;
        }

        $.submitForm({
            url: "" + keyValue + "" + refundAmt + "" + reason,
            loading: "",  
            success: function (ajaxresp) {
                
                //$.currentWindow().$("").resetSelection();
                //$.currentWindow().$("").trigger("");
                callback();
            }
        });
    }
</script>
@using Newtouch.Infrastructure;
@{
    ViewBag.Title = "";
    Layout = "";
}
<style>
    .ui-jqgrid tr.jqgrow td {
        white-space: normal !important;
        height:auto;
        vertical-align:text-top;
        padding-top:2px;
    }
</style>

<from id="form1">
    <div>
        <table class="form">
            <tr>
                <th class="formTitle">Số đơn hàng：</th>
                <td class="formValue">
                    <input type="text" class="form-control" style="border: none;" readonly="readonly" id="OutTradeNo"/>
                </td>
                <th class="formTitle">Trạng thái giao dịch：</th>
                <td class="formValue">
                    <input type="text" class="form-control" style="border: none;" readonly="readonly" id="TradeStatus"/>
                </td>
                <th class="formTitle" ></th>
                <td class="formValue"  rowspan="2">
                    <input type="button" class="btn btn-default btn-md" style="width:100px; " value="Làm mới" id="btn_refresh" onclick="traderefresh()"  />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Tổng số tiền：</th>
                <td class="formValue">
                    <input type="text" class="form-control" style="border: none;" readonly="readonly" id="TotalAmount" />
                </td>
                <th class="formTitle">Thời gian giao dịch：</th>
                <td class="formValue">
                    <input type="text" class="form-control" style="border: none;" readonly="readonly" id="SendPayDate"/>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Đã số tiền trả lại：</th>
                <td class="formValue">
                    <input type="text" class="form-control" style="border: none;" readonly="readonly" id="ytje" />
                </td>
                <th class="formTitle"></th>
                <td class="formValue"></td>
                <th class="formTitle"></th>
                <td class="formValue">
                    <input type="button" class="btn btn-default btn-md" style="width:100px; " value="Đăng ký hoàn tiền" id="btn_refund" onclick="tradeRefund()"  />
                </td>
            </tr>
            <tr>
                <th class="formTitle">剩余可退：</th>
                <td class="formValue">
                    <input type="text" class="form-control" style="border: none;" readonly="readonly" id="maxrfd" />
                </td>
            </tr>
        </table>
    </div>
    <div style="padding-left:5px;padding-right:5px;">
        <table id="gridListRefd"></table>
        @*<div id="gridRefdPager"></div>*@
    </div>

</from>
<script>
    var keyValue = $.request('');
    var maxrfd = 0.00;
    $(function() {
        RefundGrid();
        $.najax({
            type: "",
            url: "" + keyValue,
            loading: true,
            loadingtext: "",
            success: function (ajaxresp) {
                maxrfd = (parseFloat(ajaxresp.PayAmount) - parseFloat(ajaxresp.RefundAmount)).toFixed(2);
                if (ajaxresp != null && ajaxresp != undefined) {
                    $("").val(ajaxresp.OutTradeNo);
                    $("").val(ajaxresp.PayAmount +"");
                    $("").val(ajaxresp.OrderDate.replace("",""));
                    $("").val(ajaxresp.RefundAmount.toFixed(2) + "");
                    $("").val(maxrfd + "");

                    $("").val(ajaxresp.TradeStatus);
                    var stu = "";
                    if (ajaxresp.TradeStatus == "") {
                        stu = "";
                    }
                    else if (ajaxresp.TradeStatus == "") {
                        stu = "";
                    }
                    else if (ajaxresp.TradeStatus == "") {
                        stu = "";
                    } else {
                        stu = "";
                    }
                    $("").val(stu);
                    if (maxrfd > 0 && ajaxresp.TradeStatus != "") {

                        $("").show();
                    } else {
                        $("").hide();
                    }
                };
            }
        });
    });



    function RefundGrid() {
        var $gridJsList = $("");
        $gridJsList.dataGrid({
            url: '',
            height: 200,
            postData: { outTradeNo: keyValue, tradeNo: "" },
            colModel: [
                //{ label: '', name: '', width: 60, align: '' },
                {
                    label: '',
                    name: '',
                    width: 100,
                    align: ""
                },
                {
                    label: '',
                    name: '',
                    width: 60,
                    align: '',
                    formatter: function(cellvalue) {
                        return $.enum.getDescByValue("", cellvalue);
                    }
                },
                { label: '', name: '', width: 60, align: '' },
                {
                    label: '',
                    name: '',
                    width: 80,
                    align: '',
                    formatter: function(cellvalue) {
                        return cellvalue ? cellvalue.toFixed(2) : "";
                    }
                },
                { label: '', name: '', width: 160, align: '' },
                {
                    label: '',
                    name: '',
                    width: 150,
                    formatter: "",
                    formatoptions: { srcformat: '', newformat: '' }
                },
                {
                    label: '',
                    name: '',
                    hidden: true,
                    align: ""
                },
                {
                    label: '',
                    name: '',
                    width: 60,
                    align: "",
                    formatter: function (cellvalue, option, row) {
                        
                        if (row.RefundStatus == "") {
                            return "" + option.rowId + "";
                        } else {
                            return "";
                        }

                    }
                }
            ],
            //pager: "",
            sortname: "",
            viewrecords: true,
            caption: ""
        });
    }

    function tradeRefund() {
        var total = $("").val();
        $.modalOpen({
            id: "",
            title: "",
            url: "" + keyValue + "" + maxrfd + "" + total,
            width: "",
            height: "",
            callBack: function(iframeId) {
                top.frames[iframeId].submitForm(function() {
                    setTimeout("", 100);
                    //window.location.reload();
                }); //Hàm callback xác nhận khi nhấn cửa sổ

            }
        });


    }

    function refundRetry(rowId) {
        var row = $('').jqGrid("", rowId);
        $.najax({
            type: "",
            url: "" + row.OutTradeNo + "" + row.Amount + "" + row.OutRequestNo,
            loading: true,
            loadingtext: "",
            success: function (ajaxresp) {
            }
        });
    }

    function traderefresh() {
        window.location.reload();
    }
</script>
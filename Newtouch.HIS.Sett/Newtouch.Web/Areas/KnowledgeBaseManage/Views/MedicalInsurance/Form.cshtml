@using Newtouch.Common.Operator;
@{
    ViewBag.Title = "";
    Layout = "";
}

<form id="form1">
    <div class="container" style="margin-top: 10px; margin-left: -4%; ">
        <ul class="nav nav-tabs" role="tablist" id="myTab" style="margin-left: 4%;">
            <li role="presentation"><a role="tab" data-toggle="tab">Thông tin cơ bản</a></li>
        </ul>
        <div class="tab-content">
            <div role="tabpanel" id="divPatInfo" class="tab-pane fade in active" style="padding-top: 20px; margin-right: 30px;">
                <table class="form">
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Số bệnh án：</th>
                        <td class="formValue">
                            <input type="text" class="form-control form-an" style="width:56%; float:left" id="blh" required />
                            &nbsp;&nbsp;<input type="button" class="btn btn-default btn-md btn-default-color" title="Chọn bệnh nhân" style="width: 25px;" id="btnsyy" value="Tra cứu" onclick="GetPatSerarchView($('#blh').val());">

                        </td>
                        <th class="formTitle"><span class="required">*</span>Mã nội bộ bệnh nhân：</th>
                        <td class="formValue">
                            <input type="text" class="form-control newtouch_Readonly" id="patId" required />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Họ tên：</th>
                        <td class="formValue">
                            <input type="text" class="form-control newtouch_Readonly" id="xm" required />
                        </td>
                        <th class="formTitle">Tuổi：</th>
                        <td class="formValue">
                            <input type="text" class="form-control newtouch_Readonly" id="nlshow" required />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Ngày bắt đầu：</th>
                        <td class="formValue">
                            <input id="ksrq" type="text" class="form-control input-wdatepicker form-an" value="" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" required />
                        </td>
                        <th class="formTitle"><span class="required">*</span>Ngày kết thúc：</th>
                        <td class="formValue">
                            <input id="jsrq" type="text" class="form-control input-wdatepicker form-an"value="" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" required />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Tổng số lần：</th>
                        <td class="formValue">
                            <input type="text" class="form-control form-an" id="zcs" name="zcs" required />
                        </td>
                        <th class="formTitle"><span class="required">*</span>Số lần còn lại：</th>
                        <td class="formValue">
                            <input type="text" class="form-control newtouch_Readonly" id="sycs" name="sycs" required/>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Hiệu lực</th>
                        <td class="formValue">
                            <div class="ckbox">
                                <input id="zt" type="checkbox" checked="checked" class="form-an"><label for="zt"></label>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</form>

<script>
    var ybbabId = $.request("");
    $(function () {
        if (!!ybbabId) {
            $('').attr('', '');
            $.ajax({
                url: "" + Math.random(),
                data: { ybbabId: ybbabId },
                dataType: "",
                async: false,
                success: function (data) {
                    $("").formSerialize(data);
                    //Định dạngUTCNgày
                    $("").val(new Date(data.CreateTime).format(""));
                    $("").val((data.ksrq && data.ksrq.length >= 10 ? data.ksrq.substring(0, 10) : ""));
                    $("").val((data.jsrq && data.jsrq.length >= 10 ? data.jsrq.substring(0, 10) : ""));
                }
            });
        }
    })

    //Tra cứu bệnh nhân
    function GetPatSerarchView(blh) {
        if (!!!blh) {
            blh = '';
        }
        $.modalOpen({
            id: "",
            title: "",
            width: "",
            height: "",
            url: "" + Math.random() + "" + blh + "" + "",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid();
            }//Hàm callback xác nhận khi nhấn cửa sổ
        });
    }

    //Bệnh nhân đã chọn
    function getPatInfoAjax(selePatInfo) {
        $('').val(selePatInfo.blh);
        $('').val(selePatInfo.patId);
        $('').val(selePatInfo.xm);
        $('').val(selePatInfo.nlshow);
    }

    //TheoblhLấypatId和姓名
    function ajaxLoadDataResult() {
        var blh = $("").val();
        $('').val(blh.toUpperCase());
        $.najax({
            url: "" + blh + "" + "" + "" + "" + "" + Math.random(),
            dataType: "",
            async: true,
            alertbierror: false,
            success: function (data) {
                if (data) {
                    $('').formSerialize(data);
                    $('').val(data.patId);
                } else {
                    $.modalAlert("", '');
                    return;
                }
            }
        });
    }

    //Enter
    $('').keydownEnterEvent(function () {
        ajaxLoadDataResult();
    })

    //Mặc định Số lần còn lại=Tổng số lần
    $('').change(function () {
        $('').val($('').val());
    })

    //Gửi
    function submitForm() {
        if (!$('').formValid()) {
            return false;
        }
        if ($('').val() > $('').val()) {
            $.modalAlert("", '');
            return;
        }
        var params = $("").formSerialize();
        $.submitForm({
            url: "" + ybbabId,
            param: params,
            success: function () {
                $.currentWindow().$("").trigger("");
            }
        })
    }

</script>


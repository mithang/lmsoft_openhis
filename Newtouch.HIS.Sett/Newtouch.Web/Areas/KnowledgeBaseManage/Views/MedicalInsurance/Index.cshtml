
@{
    ViewBag.Title = "";
    Layout = "";
}
<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="glyphicon glyphicon-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a id="NF-add" class="btn btn-primary dropdown-text" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a id="NF-edit" class="btn btn-primary dropdown-text" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a id="NF-delete" class="btn btn-primary dropdown-text" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Vui lòng nhập số bệnh án" style="width: 200px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>

<script>
    $(function () {
        gridList();
    })

    //Enter
    $('').keydownEnterEvent(function () {
        $("").trigger('');
    })

    //Chi tiết
    function gridList() {
        var $gridList = $("");
        $gridList.dataGrid({
            treeGridModel: "",
            url: "",
            postData: getSearchPostData(),
            height: $(window).height() - 130,
            colModel: [
            { label: "", name: "", width: 120, align: "", hidden: true },
            { label: "", name: "", width: 120, align: "" },
            { label: "", name: "", width: 120, align: "" },
            {
                label: "", name: "", width: 120, align: "", formatter: function (cellvalue, a, b) {
                    return getAgeFromBirthTime({ begin: b.csny }).text;
                }
            },
            { label: "", name: "", width: 140, align: "" },
            { label: "", name: "", width: 120, align: "", hidden: true },
            {
                label: "", name: "", width: 120, align: "",
                formatter: "", formatoptions: { srcformat: '', newformat: '' }
            },
            {
                label: "", name: "", width: 120, align: "",
                formatter: "", formatoptions: { srcformat: '', newformat: '' }
            },
            { label: "", name: "", width: 110, align: "" },
            { label: "", name: "", width: 110, align: "" }
            ],
            pager: "",
            sortname: '',
            viewrecords: true
        });
        $("").click(function () {
            $gridList.jqGrid('',
                {
                    postData: getSearchPostData(),
                    page: 1,
                }).trigger('');
        });
    }
    //Điều kiện tra cứu
    function getSearchPostData() {
        var keyword = $("").val();
        return { keyword: keyword};
    };

    //Tạo mới
    function btn_add(){
        $.modalOpen({
            id: "",
            title: "",
            url: "",
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    //Sửa
    function btn_edit() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var ybbabId = $("").jqGridRowValue().ybbabId;
        $.modalOpen({
            id: "",
            title: "",
            url: "" + ybbabId,
            width: "",
            height: "",
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }
    //Xóa
    function btn_delete() {
        var seleRowid = jQuery("").jqGrid("", "");
        if (!(seleRowid)) {
            $.modalAlert("", '');
            return;
        }
        var ybbabId = $("").jqGridRowValue().ybbabId;
        $.deleteForm({
            url: "",
            param: { ybbabId: ybbabId },
            success: function () {
                $("").trigger("");
            }
        })
    }

</script>


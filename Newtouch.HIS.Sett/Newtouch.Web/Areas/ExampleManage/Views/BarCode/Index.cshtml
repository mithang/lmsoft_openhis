<script src=""></script>
<script src=""></script>
<script>
    $(function () {
        $('').qrcode({
            render: "",
            text: "",
            width: "",
            height: ""
        });
    });
    function createqrcode() {
        if (!$('').formValid()) {
            return false;
        }
        $("").html("");
        $('').qrcode({
            render: "",
            text: $("").val(),
            width: "",
            height: ""
        });
    }
</script>
<form id="form1">
    <div class="mail-box">
        <div class="mail-header">Tạo mã QR</div>
        <div class="mail-body">
            <table class="form">
                <tr>
                    <th class="formTitle">Nội dung mã QR</th>
                    <td class="formValue">
                        <div class="input-group">
                            <input id="txt_barcod" name="txt_barcod" type="text" class="form-control required" placeholder="chuỗi của Vui lòng nhập mã QR tạo cần">
                            <span class="input-group-btn">
                                <a onclick="createqrcode()" class="btn  btn-primary" style="padding-left:10px;padding-right:10px;font-size:12px;line-height: 20px;">Tạo</a>
                            </span>
                        </div>
                    </td>
                </tr>
                <tr>
                    <th class="formTitle" valign="top" style="padding-top:25px;">二维码图像</th>
                    <td class="formValue" style="padding-top:20px;">
                        <div id="qrcodeTable"></div>
                        <div style="color: #aaaaaa;margin-top:10px;">使用微信扫一扫</div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</form>

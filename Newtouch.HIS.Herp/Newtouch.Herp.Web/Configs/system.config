<?xml version="1.0" encoding="utf-8"?>
<appSettings>
  <!-- ================== 1:Cấu hình tham số phần mềm hệ thống ================== -->
  <!-- Phiên bản phần mềm -->
  <add key="Version" value="1.00.00.0" />

  <!-- ================== 2:Cấu hình liên quan đến hệ thống phát triển ================== -->
  <!-- Thời gian duy trì trạng thái danh tính đăng nhập(Đơn vị:phút)-->
  <add key="LoginStatusKeepMinute" value="120" />
  <!-- Đá nhau đa thiết bị đầu cuối -->
  <add key="EnableMultipleLoginLimit" value="true" />
  <!-- Đá nhau đa thiết bị đầu cuối-Cùng một tài khoản,Số người trực tuyến đồng thời tối đa -->
  <add key="MultipleLoginLimit_Count" value="10" />
  <!-- Reids của bộ nhớ đệm key Tiền tố(Khi nhiều ứng dụng dùng chung một cơ sở dữ liệu,Ngăn ngừa lộn xộn bộ nhớ đệm) -->
  <add key="Reids_Cache_Prefix" value="$newtouch.herp$"/>
  <!-- Ứng dụng Id -->
  <add key="AppId" value="newtouch.herp"/>
  <add key="AppName" value="物资耗材系统"/>
  
  
  <!-- Tổ chức cấp cao nhất Id -->
  <add key="Top_OrganizeId" value="d8ee85f8-d8d1-4b5c-bd9e-1761f44242d8"/>
  <!-- Tạo người dùng mới khi Vai trò liên kết mặc định -->
  <add key="CreateUser_Default_RoleCode" value="DefaultRole"/>
  <!-- của trang tĩnh Host iis Đổi lên mạng công cộng ip-->
  <add key="SiteStaticHost" value="http://localhost:8014/"/>
  <!-- của dịch vụ nhật ký Url Bỏ đi-->
  <add key="His.Log.URL" value="http://localhost:9004/"/>
  <!-- Công tắc-Có tải cây menu bên trái không(Tải mặc định) -->
  <add key="Is_LoadNavTree" value="true"/>
  <!-- Công tắc-Có bật giám sát trang menu không(Cây menu bên trái,Nhấp chuột,Thời gian tải trang bên phải) -->
  <add key="Is_NavPageLoadMoniter" value="true"/>
 
  <!-- Trang domain(Lồng trang miền khác,Và thực hiện js Phải đặt thành cùng một miền)-->
  <add key="Document_Domain" value="localhost"/>
  <!-- API Địa chỉ-Đổi danh tính người dùng ủy quyền thống nhất settapi Địa chỉ-->
  <add key="UAUserInfoGetAPI" value="http://localhost:7002/api/UA/GetUserInfo"/>

  <!-- CIS Cấu hình địa chỉ(Cấu hình đăng nhập ủy quyền thống nhất)(CISWeb Địa chỉ mạng ngoài) -->
  <add key="CIS_UALoginAddress" value="http://127.0.0.1:8003/Login/UALogin"/> 
 

  <!-- Khi đăng nhập có hiển thị mã xác minh không -->
  <add key="Is_CheckChkCode" value="false"/>
  
  <!-- ================== 3:Cấu hình liên quan đến nghiệp vụ ================== -->
  <!-- Giới hạn kích thước hình ảnh vật tư Đơn vị M -->
  <add key="imageMaxSize" value="5"/>
  <!-- Hình ảnh vật tư urn -->
  <add key="imageUrn" value="/Upload/productImg"/>
  <add key="fileUrn" value="/Upload/licence"/>
  <add key="legalFileUploadExt" value=".jpg.bmp.png.ppt.pptx.xls.xlsx.docx.doc.pdf"/>

  <!-- Lấy ngày thực hiện điều chỉnh giá tại tjwzDaysAgo Thuốc điều chỉnh giá trong ngày -->
  <add key="tjwzDaysAgo" value="-31"/>
  
  <!-- ================== Khác ================== -->
  <add key="vs:EnableBrowserLink" value="false"/>
    <add key="OrganizeCodeSd" value="77370296000"/>
  <add key="HospitalName" value="his测试医院"/>
  <!--Tên người dùng đăng ký hệ thống dược thành phố-->
  <add key="PurchaseUser" value="QX77370296000"/>
  <!--Mật khẩu đăng nhập người dùng đăng ký hệ thống dược thành phố-->
  <add key="PurchasePwd" value="eygyeemjcg"/>

  <!-- report Địa chỉ báo cáo Mạng công cộng ip-->
  <add key="ReportUrl" value="http://127.0.0.1:8009/"/>
  <add key="ReportSystemCode" value="HERP"/>
</appSettings>
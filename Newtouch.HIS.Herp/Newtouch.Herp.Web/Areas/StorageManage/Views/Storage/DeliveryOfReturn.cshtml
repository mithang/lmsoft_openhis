    //Số lượng mất tiêu điểm,Tính tiền bán buôn Tiền bán lẻ
    function CKSL_Leave() {
        if ($("#wzmc").val() === "") {
            return false;
        }
        var minlsj = parseFloat($("#minlsj").val());
        var minjj = parseFloat($("#minjj").val());
        var zhyz = parseFloat($("#dw").find("option:selected").attr("data-zhyz"));
        var lsj = minlsj * zhyz;
        var jj = minjj * zhyz;
        $("#zhyz").val(zhyz);
        $("span[name=sp_bmdw]").html("(tệ/" + $("#dw").find("option:selected").text() + ")").attr("data-zhyz", zhyz);
        $("#lsj").val(lsj);
        //$("#bmjj").val(parseFloat($("#bmjj").val()) / yzhyz * zhyz);
        $("#bmjj").val(jj);
        if ($("#sl").val() === "") {
            return false;
        }
        if (isNaN($("#sl").val())) {
            $.modalAlert("Lỗi định dạng số lượng", 'warning');
            return false;
        }
        var sl = parseFloat($("#sl").val());
        $("#lsze").val((lsj * sl).toFixed(2));
        return true;
    }


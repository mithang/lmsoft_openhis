@using Newtouch.Herp.Infrastructure.Enum;
@using NewtouchHIS.Lib.Base.Extension
@{
    ViewBag.Title = "OutStorage";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    .req {
        color: red;
    }
</style>
<form id="form1">
    <div class="panel panel-default">
        <div class="panel-heading">Thông tin xuất kho</div>
        <div style="padding-right:10px;">
            <table class="form">
                <tr>
                    <th class="formTitle">Số phiếu xuất kho:</th>
                    <td class="formValue">
                        <input id="Pdh" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">Số phiếu giao hàng:</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="deliveryNo" placeholder="Số phiếu giao hàng" />
                    </td>
                    <th class="formTitle">Hình thức xuất kho:</th>
                    <td class="formValue">
                        <select id="crkfs" class="form-control required"></select>
                    </td>
                    <th class="formTitle"><span class="req">*</span>Tên nhà cung cấp:</th>
                    <td class="formValue">
                        <input id="rkbmName" type="text" class="form-control" />
                        <input id="rkbmId" type="hidden" value="" />
                    </td>
                </tr>
            </table>
        </div>
        <div class="panel-heading">Thông tin vật tư</div>
        <div style="padding-right:10px;">
            <table class="form">
                <tr>
                    <th class="formTitle"><span class="req">*</span>Vật tư:</th>
                    <td class="formValue">
                        <input id="wzmc" type="text" class="form-control" placeholder="Mã Tên Phiên âm Tên hàng" />
                        <input id="productId" type="hidden" value="" />
                        <input id="editRowId" type="hidden" value="" />
                        <input id="lbmc" type="hidden" value="" />
                    </td>
                    <th class="formTitle"><span class="req">*</span>Lô:</th>
                    <td class="formValue">
                        <input id="pc" type="text" class="form-control" />
                    </td>
                    <th class="formTitle" id="slDW"><span class="req">*</span>Số lượng xuất kho:</th>
                    <td class="formValue">
                        <div class="row">
                            <div class="col-md-8">
                                <input id="sl" type="text" class="form-control" onchange="CKSL_Leave()" />
                            </div>
                            <div class="col-md-4">
                                <select id="dw" class="form-control" onchange="CKSL_Leave()"></select>
                                <input id="mindwmc" value="" data-zhyz="" data-name="" type="hidden" />
                                <input id="bmdwmc" value="" data-zhyz="" data-name="" type="hidden" />
                            </div>
                        </div>
                    </td>
                    <th class="formTitle"><span class="req">*</span>Số tiền xuất kho:</th>
                    <td class="formValue">
                        <input id="zje" type="text" style="width:70%;float: left;" class="form-control" onchange="CKJE_Leave()" />
                        <span style="line-height:24px;margin-left: 10px;">(đ)</span>
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Ghi chú:</th>
                    <td class="formValue">
                        <input id="remark" type="text" class="form-control" />
                    </td>
                    <th class="formTitle">Số lô:</th>
                    <td class="formValue">
                        <input id="ph" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">Tồn kho khả dụng:</th>
                    <td class="formValue">
                        <input id="slstr" type="text" class="form-control newtouch_Readonly" />
                        <input id="kykcsl" type="text" hidden="hidden" />
                    </td>
                    <th class="formTitle" id="thJJDW">Đơn giá xuất kho:</th>
                    <td class="formValue">
                        <input id="jj" type="text" style="width: 70%;float: left;" class="form-control newtouch_Readonly" />
                        <span style="line-height:24px;margin-left: 10px;">(đ)</span>
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Quy cách:</th>
                    <td class="formValue">
                        <input id="gg" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">Giá bán lẻ:</th>
                    <td class="formValue">
                        <input id="lsj" type="text" style="width:65%;float: left;" class="form-control newtouch_Readonly" />
                        <span name="sp_bmdw" style="line-height:24px;margin-left: 10px;"></span>
                        <input id="minlsj" type="hidden" value="" />
                    </td>
                    <th class="formTitle">Tổng bán lẻ:</th>
                    <td class="formValue">
                        <input id="lsze" type="text" style="width:70%;float: left;" class="form-control newtouch_Readonly" />
                        <span style="line-height:24px;margin-left: 10px;">(đ)</span>
                    </td>
                    <th class="formTitle">Hệ số quy đổi:</th>
                    <td class="formValue">
                        <input id="zhyz" type="text" class="form-control newtouch_Readonly" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Hạn sử dụng:</th>
                    <td class="formValue">
                        <input id="yxq" type="text" class="form-control input-wdatepicker newtouch_Readonly" value="@DateTime.Now.ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                    </td>
                    <th class="formTitle">Nhà sản xuất:</th>
                    <td class="formValue">
                        <input id="sccj" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <th class="formTitle">Ngày sản xuất:</th>
                    <td class="formValue">
                        <input id="scrq" type="text" class="form-control newtouch_Readonly" />
                    </td>
                    <td colspan="2"></td>
                </tr>
            </table>
        </div>
    </div>
    <input id="fph" type="hidden" value="" />
</form>

@Html.Partial("_MiddleButtonsView", new Newtouch.Herp.Web.Models.BottomButtonViewModel
{
    ShowKeyList = new int[] { 2, 3, 6 },
    F2Text = "Thêm",
    F3Text = "Sửa",
    F6Text = "Xóa"
})

<div class="gridPanel">
    <table id="gridCKMX"></table>
    <div id="gridPager" rel="form1"></div>
</div>

@Html.Partial("_BottomButtonsView", new Newtouch.Herp.Web.Models.BottomButtonViewModel
{
    ShowKeyList = new int[] { 7, 8 },
    F7Text = "Đặt lại",
    F8Text = "Xuất kho"
})
<span style="float: left;line-height: 25px;margin: 8px 5px;">Tổng xuất kho:&nbsp;<span id="txtCKZE"></span> &nbsp;đ</span>
<script>
    $(function () {
        //Khi thay đổi kích thước cửa sổ trình duyệt thì tải lạijqGridchiều rộng
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });
        gridCKMX([]);
        initialCKFS();//TảiHình thức xuất kho
        initialDeliveryNO();//Đăng ký phiếu giao hàngLớp nổi
        initialGYS();//Khởi tạoNhà cung cấp
        newtouch_event_f7();
        $("#wzmc").change(function () {
            $("#ph").val("");
            $("#pc").val("");
            $("#slstr").val("");
            $("#kykcsl").attr('data-kcsl', "").val("");//kykcsl
            $("#productId").val("");
        });
        BackspaceGYS();
    });

    //Nhà cung cấp vật tư
    function initialGYS() {
        $("#rkbmName").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            url: '/Storage/GetSupplierList',
            height: 300,
            width: 300,
            caption: "Nhà cung cấp vật tư",
            ajaxparameters: function () {
                return "key=" + $("#rkbmName").val();
            },
            colModel: [
                { label: 'Id', name: 'Id', hidden: true },
                { label: 'Nhà cung cấp', name: 'name', widthratio: 80 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#rkbmName").val($thistr.attr('data-name'));
                $("#rkbmId").val($thistr.attr('data-Id'));
            }
        });
    }

    //XóaXóaNhà cung cấp
    function BackspaceGYS() {
        $("#rkbmName").keydown(function (e) {
            var e = window.event ? window.event : e;
            var keyCode = e.which ? e.which : e.keyCode;
            if (keyCode == 8) {//tab
                $("#rkbmName").val("");
                $("#rkbmId").val("");
            }
        });
    }

    //Xuất kho mới
    function newtouch_event_f7() {
        GetNewCkdh();//Đổi số phiếu
        EnabledSysBasicInfo();//Bật
        CleanInput();//Xóa trắng chi tiết
        $('#gridCKMX').jqGrid("clearGridData");
        $("#txtCKZE").html("");
    }

    //Lấy chi tiết
    function getEditRowData() {
        return [{
            Pdh: $("#Pdh").val(),
            deliveryNo: $("#deliveryNo").val(),
            crkfs: $("#crkfs").val(),
            rkbmName: $("#rkbmName").val(),
            rkbmId: $("#rkbmId").val(),
            lbmc: $("#lbmc").val(),
            wzmc: $("#wzmc").val(),
            gg: $("#gg").val(),
            sl: parseFloat($("#sl").val()),   //Cuối cùngLưutới cơ sở dữ liệuSố lượng
            unitName: $("#dw").find("option:selected").text(),
            zhyz: $("#dw").find("option:selected").attr("data-zhyz"),
            ph: $("#ph").val(),
            pc: $("#pc").val(),
            yxq: $("#yxq").val(),
            lsj: $("#lsj").val(),
            minlsj: $("#minlsj").val(),
            lsze: $("#lsze").val(),
            jj: $("#jj").val(),
            zje: $("#zje").val(),
            slstr: $("#slstr").val(),
            remark: $("#remark").val(),
            sccj: $("#sccj").val(),
            scrq: $("#scrq").val(),
            productId: $("#productId").val(),
            ckbmkc: $("#kykcsl").attr("data-kcsl"),
            kykcsl: $("#kykcsl").val(),
            zxdwId: $("#mindwmc").val(),
            mindwmc: $("#mindwmc").attr("data-name"),
            zxdwzhyz: $("#mindwmc").attr("data-zhyz"),
            bmdwId: $("#bmdwmc").val(),
            bmdwmc: $("#bmdwmc").attr("data-name"),
            bmdwzhyz: $("#bmdwmc").attr("data-zhyz"),
            unitId: $("#dw").val(),
            fph: $("#fph").val(),
            ckbm: $("#supplierId").val()
        }];
    }

    //Tải chi tiết
    function gridCKMX(mydata) {
        var $gridCkmx = $("#gridCKMX");
        $gridCkmx.newtouchLocalDataGrid({
            height: $(window).height() - document.getElementById('gridCKMX').offsetTop - 85,
            unwritten: false,
            colModel: [
                { label: 'Loại vật tư', name: 'lbmc', width: 70, align: 'left' },
                { label: 'Số phiếu giao hàng', name: 'deliveryNo', width: 80, align: 'left' },
                { label: 'Tên vật tư', name: 'wzmc', width: 110, align: 'left' },
                { label: 'Quy cách', name: 'gg', width: 80, align: 'left' },
                { label: 'Số lượng', name: 'sl', width: 60, align: 'left' },
                { label: 'Đơn vị', name: 'unitName', width: 50, align: 'center' },
                { label: 'Tồn kho hiện tại', name: 'slstr', width: 70, align: 'right' },
                { label: 'Đơn giá bán lẻ', name: 'lsj', width: 70, align: 'right' },
                { label: 'Tổng bán lẻ', name: 'lsze', width: 70, align: 'right' },
                { label: 'Đơn giá xuất kho', name: 'jj', width: 70, align: 'right' },
                {
                    label: 'Số tiền xuất kho', name: 'zje', width: 80, align: 'right',
                    formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(2) : "0.00";
                    }
                },
                { label: 'Hệ số quy đổi', name: 'zhyz', width: 60, align: 'center' },
                { label: 'Số lô', name: 'ph', width: 100, align: 'center' },
                { label: 'Lô', name: 'pc', width: 100, align: 'center' },
                { label: 'Hạn sử dụng', name: 'yxq', width: 70, align: 'center' },
                { label: 'Ghi chú', name: 'remark', width: 100, align: 'left' },
                { label: 'Nhà sản xuất', name: 'sccj', width: 100, align: 'left' },
                { label: 'Ngày sản xuất', name: 'scrq', width: 70, align: 'left' },
                { label: 'productId', name: 'productId', hidden: true },
                { label: "kykcsl", name: "kykcsl", hidden: true },
                { label: 'bmdwmc', name: 'bmdwmc', hidden: true },
                { label: 'ckbmkc', name: 'ckbmkc', hidden: true },
                { label: 'mindwmc', name: 'mindwmc', hidden: true },
                { label: 'zxdwId', name: 'zxdwId', hidden: true },
                { label: 'zxdwzhyz', name: 'zxdwzhyz', hidden: true },
                { label: 'bmdwId', name: 'bmdwId', hidden: true },
                { label: 'bmdwzhyz', name: 'bmdwzhyz', hidden: true },
                { label: 'unitId', name: 'unitId', hidden: true },
                { label: 'Pdh', name: 'Pdh', hidden: true },
                { label: 'crkfs', name: 'crkfs', hidden: true },
                { label: 'rkbmName', name: 'rkbmName', hidden: true },
                { label: 'minlsj', name: 'minlsj', hidden: true },
                { label: 'fph', name: 'fph', hidden: true },
                { label: 'rkbmId', name: 'rkbmId', hidden: true }

            ],
            ondblClickRow: function (rowid) {
                gridDbclickRow(rowid);
            }
        }, mydata);
    }

    //Nhấn đúp
    function gridDbclickRow(rowid) {
        if (rowid) {
            var getRowData = $("#gridCKMX").jqGrid('getRowData', rowid);
            if (getRowData) {
                $("#Pdh").val(getRowData.Pdh);
                $("#crkfs").val(getRowData.crkfs);
                $("#rkbmName").val(getRowData.rkbmName);
                $("#rkbmId").val(getRowData.rkbmId);
                $("#dw").empty();
                if (getRowData.mindwmc !== getRowData.bmdwmc) {
                    $("#dw").append("<option data-zhyz='1' value='" + getRowData.zxdwId + "'>" + getRowData.mindwmc + "</option>");   //Đơn vị xuất kho
                }
                $("#dw").append("<option data-zhyz='" + getRowData.bmdwzhyz + "' value='" + getRowData.bmdwId + "'>" + getRowData.bmdwmc + "</option>");   //Đơn vị xuất kho
                $("#mindwmc").val(getRowData.zxdwId).attr("data-zhyz", 1).attr("data-name", getRowData.mindwmc);
                $("#bmdwmc").val(getRowData.bmdwId).attr("data-zhyz", getRowData.bmdwzhyz).attr("data-name", getRowData.bmdwmc);
                $("#lbmc").val(getRowData.lbmc);
                $("#deliveryNo").val(getRowData.deliveryNo);
                $("#wzmc").val(getRowData.wzmc);
                $("#gg").val(getRowData.gg);
                $("#sl").val(getRowData.sl);
                $("#zhyz").val(getRowData.zhyz);
                $("#ph").val(getRowData.ph);
                $("#pc").val(getRowData.pc);
                $("#yxq").val(getRowData.yxq);
                $("#lsj").val(getRowData.lsj);
                $("#lsze").val(getRowData.lsze);
                $("#jj").val(getRowData.jj);
                $("#zje").val(getRowData.zje);
                $("#slstr").val(getRowData.slstr);
                $("#remark").val(getRowData.remark);
                $("#sccj").val(getRowData.sccj);
                $("#scrq").val(getRowData.scrq);
                $("#productId").val(getRowData.productId);
                $("#kykcsl").val(getRowData.kykcsl).attr("data-kcsl", getRowData.ckbmkc);
                $("#supplierId").val(getRowData.ckbm);
                $("#minlsj").val(getRowData.minlsj);
                $("#fph").val(getRowData.fph);
                $("#dw").val(getRowData.unitId).trigger("change");
                RemarkEditRowId(rowid)
            }
        }
    }

    //ThêmNút
    function newtouch_event_f2() {
        if (!DataValate()) {//Kiểm tra dữ liệu
            return false;
        }
        var data = getEditRowData();//Lấy chi tiết
        if (data === false) return false;
        //Kiểm tra mục trùng
        var isRepeatedAdd = false;
        $.each($("#gridCKMX").getDataIDs(), function () {
            var rowData = $("#gridCKMX").jqGrid('getRowData', this);
            if (rowData.productId === data[0].productId && rowData.ph === data[0].ph && rowData.pc === data[0].pc) {
                isRepeatedAdd = true;
            }
        });
        if (isRepeatedAdd) {
            $.modalAlert("Không được thêm trùng", 'warning');
            return false;
        }
        $("#gridCKMX").newtouchLocalDataGrid(null, data);
        ComputeCKZE();//Tính toánSố tiền xuất kho
        DisableControls();//Tắt
        ChangeDeliveryNo();//Xóa trắng chi tiết
        return true;
    }

    //Nút sửa
    function newtouch_event_f3() {
        if ($('#editRowId').val()) {//Kiểm tra dữ liệu
            if (!DataValate()) {
                return false;
            }
            var data = getEditRowData();//Lấy chi tiết
            $('#gridCKMX').jqGrid("delRowData", $('#editRowId').val()); //TrướcremoveDòng đó
            //Kiểm tra mục trùng
            var isRepeatedAdd = false;
            $.each($("#gridCKMX").getDataIDs(), function () {
                var rowData = $("#gridCKMX").jqGrid('getRowData', this);
                if (rowData.productId === data[0].productId && rowData.ph === data[0].ph && rowData.pc === data[0].pc) {
                    isRepeatedAdd = true;
                }
            });
            if (isRepeatedAdd) {
                $.modalAlert("Thêm trùng", 'warning');
                return false;
            }
            $("#gridCKMX").newtouchLocalDataGrid(null, data);
            ComputeCKZE();//Tính toánSố tiền xuất kho
            DisableControls();//Tắt
            ChangeDeliveryNo();//Xóa trắng chi tiết
        }
        else {//LấygridDòng đang chọn hiện tại
            var seleId = $('#gridCKMX').jqGrid('getGridParam', 'selrow');
            if (seleId) {
                gridDbclickRow(seleId);//Yêu cầu sửa dòng đó
            }
        }
    }

    //Xóa
    function newtouch_event_f6() {
        var delRowid = $("#gridCKMX").jqGrid('getGridParam', 'selrow');
        if (!delRowid) {
            $.modalAlert("Chưa chọn dòng", 'warning');
            return;
        }
        $('#gridCKMX').jqGrid('delRowData', delRowid);
        ComputeCKZE();//Tính tổng nhập kho
        ChangeDeliveryNo();//Xóa trắng chi tiết
    }

    //Xuất kho
    function newtouch_event_f8() {
        var djmx = $("#gridCKMX").jqGrid('getRowData_AllLine');
        if (djmx == null || djmx.length <= 0) {
            $.modalAlert("Vui lòng thêm thông tin xuất kho trước", 'warning');
            return;
        }
        var crkdj = Object();
        crkdj.deliveryNo = djmx[0].deliveryNo;
        crkdj.pdh = djmx[0].Pdh;
        crkdj.rkbm = djmx[0].rkbmId;
        crkdj.crkfs = djmx[0].crkfs;
        $.najax({
            url: "/StorageManage/Storage/SaveOutStorageInfo",
            dataType: "json",
            data: { crkdj: crkdj, crkdjmx: djmx },
            type: "POST",
            success: function (res) {
                if (res.state === "success") {
                    $.modalAlert("Xuất kho thành công", 'success');
                    newtouch_event_f7();//Nhập/xuất kho:Số phiếu mới Xóa trắng dữ liệu chính Xóa trắng chi tiết
                    $('#gridCKMX').jqGrid("clearGridData");//Xóa trắngGrid
                } else {
                    $.modalAlert(res.message, 'error');
                }
            }
        });
    }

    //TảiSố phiếu xuất kho
    function GetNewCkdh() {
        $.najax({
            url: "/StorageManage/Storage/GetNewCkdh?r=" + Math.random(),
            dataType: "text",
            type: "Get",
            success: function (data) {
                $("#Pdh").val(data);
            }
        });
    }

    //Hình thức xuất kho
    function initialCKFS() {
        $("#crkfs").bindSelect({
            url: "/Storage/GetStorageIOMode?crkbz=1",
            id: "Id",
            text: "crkfsmc"
        });
    }

    //Số phiếu giao hàng
    function initialDeliveryNO() {
        $("#deliveryNo").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            url: '/DeliveryManage/DeliveryQuery/OutStorageDeliveryQuery',
            height: 300,
            width: 900,
            caption: "Số phiếu giao hàng",
            ajaxparameters: function () {
                return "keyword=" + $("#deliveryNo").val();
            },
            colModel: [
                { label: 'Số phiếu giao hàng', name: 'deliveryNo', width: 150, align: "center" },
                { label: 'Số phiếu', name: 'djh', width: 180, align: "center" },
                {
                    label: 'Trạng thái duyệt', name: 'shzt', width: 80, align: 'left', formatter: function (val) {
                        switch (val) {
                        case '@((int)EnumAuditState.Temporary)':
                            return "@EnumAuditState.Temporary.GetDescription()";
                        case '@((int)EnumAuditState.Adopt)':
                            return "@EnumAuditState.Adopt.GetDescription()";
                        case '@((int)EnumAuditState.Cancelled)':
                            return "@EnumAuditState.Cancelled.GetDescription()";
                        case '@((int)EnumAuditState.Refuse)':
                            return "@EnumAuditState.Refuse.GetDescription()";
                        case '@((int)EnumAuditState.Waiting)':
                            return "@EnumAuditState.Waiting.GetDescription()";
                        default:
                            return "";
                        }
                    }
                },
                { label: 'Tên nhà cung cấp', name: 'gysmc', width: 180, align: "center" },
                { label: 'Hình thức nhập/xuất kho', name: 'crkfsmc', width: 80, align: "center" },
                { label: 'Thời gian tạo', name: 'CreateTime', width: 130, align: "center", formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Người tạo', name: 'CreatorCode', width: 80, align: "center" },
                { label: 'gysId', name: 'gysId', hidden: true },
                { label: 'crkfsId', name: 'crkfsId', hidden: true }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#deliveryNo").val($thistr.attr('data-deliveryNo'));
                $("#rkbmId").val($thistr.attr('data-gysId'));
                $("#rkbmName").val($thistr.attr('data-gysmc'));
                ChangeDeliveryNo();//Xóa trắng chi tiết
            }
        });
    }

    //Mã nhập
    $("#wzmc").newtouchBatchFloatingSelector({
        clickautotrigger: true,
        height: 300,
        width: 900,
        id: 'wzsrm',
        url: '/StorageManage/Storage/QueryStockListByGys',
        ajaxmethod: "Get",
        inputtextcheck: function () {
            if ($("#rkbmId").val().replace(/(^\s*)|(\s*$)/g, "") === "" || $("#rkbmName").val().replace(/(^\s*)|(\s*$)/g, "") === "") {   //Bỏrơikhoảng trắng hai đầu

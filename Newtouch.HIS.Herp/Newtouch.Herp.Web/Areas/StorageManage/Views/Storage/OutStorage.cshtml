        $("#rkbmName").val("");
        ChangeDeliveryNo();
    }

    //Rời khỏi ô số lượng,Tính số tiền bán sỉ Thành tiền bán lẻ
    function CKSL_Leave() {
        if ($("#wzmc").val() === "") {
            return false;
        }
        var minlsj = parseFloat($("#minlsj").val());
        var zhyz = parseFloat($("#dw").find("option:selected").attr("data-zhyz"));
        var lsj = parseFloat(minlsj * zhyz).toFixed(4);
        $("#lsj").val(lsj);
        $("#zhyz").val(zhyz);
        if ($("#sl").val() === "") {
            return false;
        }
        if (isNaN($("#sl").val())) {
            $.modalMsg("Định dạng số lượng sai", 'warning', 1500);
            return false;
        }
        var sl = parseFloat($("#sl").val());
        $("#lsze").val((minlsj * zhyz * sl).toFixed(2));
        CKJE_Leave();//Tính lạiPhiếu nhập khoGiá
        return true;
    }

    //Số tiền xuất khoMất focus,Tính đơn giá xuất kho
    function CKJE_Leave() {
        if (isNaN($("#zje").val())) {
            $.modalMsg("Định dạng tổng giá nhập sai", 'warning', 1500);
            return false;
        }
        if ($("#zje").val() === "") {
            return false;
        }
        if ($("#sl").val() === "") {
            return false;
        }
        var sl = parseFloat($("#sl").val());;
        var jjze = parseFloat($("#zje").val());
        var jj = sl === 0 ? 0 : jjze / sl;
        $("#jj").val(parseFloat(jj).toFixed(4));
        return true;
    }

    //Tính toánTổng xuất kho
    function ComputeCKZE() {
        var ckze = 0;
        var count = $("#gridCKMX").getGridParam('records');
        if (count > 0) {
            var rowIds = $("#gridCKMX").getDataIDs();
            for (var i = 0; i < rowIds.length; i++) {
                var getRowZje = $("#gridCKMX").getRowData(rowIds[i]).zje;
                ckze = parseFloat(ckze) + parseFloat(getRowZje);
            }
            $("#txtCKZE").html(ckze.toFixed(2));//Số tiền xuất kho
        } else {
            $("#txtCKZE").html('');
        }
    }

    //Kiểm tra dữ liệu
    function DataValate() {
        if ($("#wzmc").val() === "") {
            $.modalMsg("Vui lòng chọnVật tư", 'warning', 1500);
            return false;
        }
        if ($("#ph").val() === "") {
            $.modalMsg("Vui lòng chọnSố lô", 'warning', 1500);
            return false;
        }
        if ($("#sl").val() === "") {
            $.modalMsg("Số lượng nhập khoKhông được để trống", 'warning', 1500);
            return false;
        }
        if (!IsNum($("#zje").val()) || $("#zje").val() === "") {
            $.modalMsg("Số tiền xuất kholàLớntại0số", 'warning', 1500);
            return false;
        }
        var zhyz = parseFloat($("#dw").find("option:selected").attr("data-zhyz"));
        var sl = parseFloat($("#sl").val());
        var kykcsl = parseFloat($("#kykcsl").val());
        if (sl * zhyz > kykcsl) {
            $.modalMsg("Số lượng xuất khoKhông thểLớntạiTồn kho khả dụng", 'warning', 1500);
            return false;
        }
        return true;
    }

    function IsNum(value) {
        var patrn = /^(-)?\d+(\.\d+)?$/;
        if (patrn.exec(value) == null || value === "") {
            return false;
        } else {
            return true;
        }
    }

    //Tắt
    function DisableControls() {
        $("#deliveryNo").attr("disabled", "disabled").css("background-color", "rgb(238, 238, 238)");
        $("#crkfs").attr("disabled", "disabled").css("background-color", "rgb(238, 238, 238)");
        $("#rkbmName").attr("disabled", "disabled").css("background-color", "rgb(238, 238, 238)");
    }

    //Bật
    function EnabledSysBasicInfo() {
        $("#deliveryNo").removeAttr("disabled").removeAttr("style");
        $("#crkfs").removeAttr("disabled").removeAttr("style");
        $("#rkbmName").removeAttr("disabled").removeAttr("style");
    }

    //XóaLưucủaHiện tạiChọnTrongDòngID
    function cleanEditRowId() {
        $("#editRowId").val("");

    //Tính tổng lãi lỗ
    function ComputeRKZE() {
        var syze = 0;
        var count = $("#gridSYXX").getGridParam('records');
        if (count > 0) {
            var rowIds = $("#gridSYXX").getDataIDs();
            for (var i = 0; i < rowIds.length; i++) {
                var getRowLsze = $("#gridSYXX").getRowData(rowIds[i]).Lsjze;
                syze = parseFloat(syze) + parseFloat(getRowLsze);
            }
            $("#txtSYZE").html(syze.toFixed(2));//Lãi lỗSố tiền
        } else {
            $("#txtSYZE").html('');
        }
    }

    //Kiểm tra chi tiết
    function CheckDetailData() {
        if ($("#wzmc").val() === "") {
            $.modalAlert("Vật tư trống", 'warning');
            return false;
        }
        if ($("#productId").val() === "") {
            $.modalAlert("Vật tư trống", 'warning');
            return false;
        }
        if ($("#pc").val() === "") {
            $.modalAlert("Lô trống", 'warning');
            return false;
        }
        if ($("#Ph").val() === "") {
            $.modalAlert("Số lô trống", 'warning');
            return false;
        }
        if ($("#bmsl").val() === "" && $("#zxsl").val() === "") {
            $.modalAlert("Số lượng lãi lỗ trống", 'warning');
            return false;
        }
        var sysl = CalculationSysl();
        if (sysl <= 0) {
            $.modalAlert("Số lượng lãi lỗNênLớntại0", 'warning');
            return false;
        }
        if ($('#btnLossAndProfitTypeGourp .btn.active').attr('data-keywordtype') === 'Loss') {
            if (sysl > parseFloat($("#Sykc").val())) {   //Ngược lại，So sánh trực tiếpSố lượng（NhấtNhỏĐơn vịSố lượng）
                $.modalAlert("Báo hỏngSố lượngNênNhỏtạiTồn kho hiện tại", 'warning');
                return false;
            }
        }
        if ($("#syyy").val() === "") {
            $.modalAlert("Nguyên nhân lãi lỗ trống", 'warning');
            return false;
        }
        var syyy = $("#syyy").find("option:selected").text();
        if (syyy === "其他") {
            if ($("#remark").val()) {
                $.modalAlert("Ghi chú trống", 'warning');
                return false;
            }
        }
        if ($("#zrr").val() === "") {
            $.modalAlert("Người chịu trách nhiệmMã nhân viên trống", 'warning');
            return false;
        }
        if ($("#zrrmc").val() === "") {
            $.modalAlert("Tên người chịu trách nhiệm trống", 'warning');
            return false;
        }
        return true;
    }


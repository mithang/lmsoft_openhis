@using Newtouch.Herp.Infrastructure;
@{
    ViewBag.Title = "Kết chuyển tồn kho";
    Layout = "~/Views/Shared/_Index.cshtml";
    var reportUrl = Constants.GetAppConfigValue("ReportUrl");
    var reportSystemCode = Constants.GetAppConfigValue("ReportSystemCode");

}
<style>
    #btn_search {
        float: left;
        margin-left: 25px;
        margin-right: 10px;
        width: 45px;
        font-weight: bolder;
    }

    #btn_print {
        width: 45px;
        background-color: #fff;
        color: #00a9ea;
        font-weight: bolder;
        float: left;
    }
</style>
<form id="form1">
    <div class="panel panel-default">
        <div class="panel-heading">
            Kết chuyển
        </div>
        <div>
            <table class="form">
                <tr>
                    <th class="formTitle">Lịch sửKết chuyển：</th>
                    <td class="formValue">
                        <select id="lsjz" class="form-control"></select>
                    </td>
                    <th class="formTitle">Mã nhập：</th>
                    <td class="formValue">
                        <input id="txtSRM" type="text" class="form-control" placeholder="Tên vật tư/Phiên âm" />
                    </td>
                    <td class="formValue" colspan="3">
                        <input type="button" id="btn_search" class="btn btn-primary" value="Tra cứu" style="margin-left:10px;" />
                        <input type="button" id="btn_print" class="btn btn-primary" value="In báo cáo" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel">
        <table id="gridDrugsList"></table>
        <div id="gridPager" rel="form1"></div>
    </div>
    @Html.Partial("_BottomButtonsView", new Newtouch.Herp.Web.Models.BottomButtonViewModel
{
    ShowKeyList = new[] { 8 },
    F8Text = "Kết chuyển hiện tại"
})
</form>
<script>
    $(function () {
        //Khi thay đổi kích thước cửa sổ trình duyệt thì tải lạijqGridchiều rộng
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });
        GetlsjzSel();//Lấy thời gian kết chuyển lịch sử
        gridDrugsList();//Thông tin vật tư
    });

    //Gắn sự kiện phím Enter
    $(document).keyup(function (event) {
        if (event.keyCode === 13) {
            $("#btn_search").trigger("click");
        }
    });

    //Lấy thời gian kết chuyển lịch sử
    function GetlsjzSel() {
        $("#lsjz").html("");
        $("#lsjz").bindSelect({
            url: "/StorageManage/StockCarryOver/GetlsjzDateTime",
            id: "value",
            text: "text"
        });
    }

    //Thực thiDòngKết chuyển hiện tại
    function newtouch_event_f8() {
        //LấyLần cuốiKết chuyểnThời gian
        $.najax({
            type: "Get",
            url: "/StorageManage/StockCarryOver/QueryLastCarryTime?r=" + Math.random(),
            dataType: "json",
            success: function (ajaxresp) {
                if (ajaxresp != null) {
                    if (ajaxresp.state === "success") {
                        var alertMmsg = ajaxresp.data == null || ajaxresp.data === "" ? "Bạn có chắc muốn kết chuyển?？" : "Gần nhấtKết chuyểnThời gian là：" + ajaxresp.data + " ,Bạn có chắc muốn kết chuyển?？";
                        $.modalConfirm(alertMmsg,
                            function (flag) {
                                if (flag) {
                                    $.najax({
                                        url: "/StorageManage/StockCarryOver/CarryOverProduct",
                                        type: "POST",
                                        dataType: "json",
                                        success: function (ajaxresp) {
                                            if (ajaxresp.state === "success") {
                                                $.modalMsg("Kết chuyểnThành công", 'success', 1500);
                                                GetlsjzSel();//Làm mớiKết chuyểnThời gian
                                                $("#btn_search").trigger("click");
                                            }
                                            else {
                                                var msg = ajaxresp.message != null ? ajaxresp.message : "Kết chuyển thất bại";
                                                $.modalMsg(msg, "error", 1500);
                                            }
                                        }
                                    });

                                } else {
                                    return false;
                                }
                            }, true);
                    } else {
                        $.modalAlert(ajaxresp.message, "error");
                    }
                } else {
                    $.modalAlert("Lấy lần trướcKết chuyểnThời gianThất bại", "error");
                }
            }
        });
    }

    //Thông tin vật tư
    function gridDrugsList() {
        var captionCon = "Tổng cộng&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span id='yeCon'>Trang hiện tại Tổng bán lẻ：đ</span>";
        var $gridDrugsList = $("#gridDrugsList");
        $gridDrugsList.dataGrid({
            postData: getSearchPostData(),
            height: $(window).height() - document.getElementById('gridDrugsList').offsetTop - 150,
            url: "/StorageManage/StockCarryOver/SelectCarryOverDetail",
            caption: captionCon,
            colModel: [
                { label: 'Tên vật tư', name: 'wzmc', width: 120, align: 'left' },
                { label: 'Quy cách', name: 'gg', width: 80, align: 'left' },
                { label: 'Kết chuyểnSố lượng', name: 'jzsl', width: 60, align: 'left' },
                { label: 'Lô', name: 'pc', width: 120, align: 'left' },
                { label: 'Số lô', name: 'ph', width: 110, align: 'left' },
                {
                    label: 'Đơn giá bán lẻ', name: 'lsj', width: 80, align: 'right',
                    formatter: function (val) {
                        return val.toFixed(4);
                    }
                },
                { label: 'Đơn vị', name: 'bmdwmc', width: 50, align: 'center' },
                {
                    label: 'Tổng bán lẻ', name: 'lsze', width: 100, align: 'right',
                    formatter: function (val) {
                        return val.toFixed(2);
                    }
                },
                { label: 'Nhà sản xuất', name: 'supplierName', width: 120, align: 'left' },
                { label: 'Thời gian tạo', name: 'CreateTime', width: 50, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i', newformat: 'Y-m-d H:i' } },
                { label: 'Kết chuyểnTồn khoSố lượng', name: 'kcsl', hidden: true },
                { label: 'productId', name: 'productId', hidden: true }
            ],
            multiselect: false,
            pager: "#gridPager",
            sortname: 'wzmc',
            viewrecords: true,
            loadComplete: function (data) {
                ComputePjzeAndLsze();//Tính tổng giá sỉ và tổng giá bán lẻ trong thanh tiêu đề
            }
        });
        //Tra cứu
        $("#btn_search").click(function () {
            $gridDrugsList.jqGrid('setGridParam', {
                postData: getSearchPostData()
            }).trigger('reloadGrid');
        });
        //In báo cáo
        $("#btn_print").click(function () {
            if (!'@reportUrl') { $.modalAlert('Báo cáo SSRS chưa được chuyển đổi sang .NET Core, vui lòng sử dụng lưới dữ liệu trên trang.', 'warning'); return; }
            window.open('@reportUrl' + "?tempCode=1270" + "&systemCode=" + '@reportSystemCode' + "&hospitalCode=" + '@ViewBag.OrganizeId' + "&OrganizeId=@ViewBag.OrganizeId&warehouseId=@Constants.CurrentKf.currentKfId" +
               "&jzsj=" + ($("#lsjz option:selected").val()) +
               "&keyWord=" + ($('#txtSRM').val() === "" ? "" : $('#txtSRM').val()));
        });
    }

    //Điều kiện tra cứu
    function getSearchPostData() {
        var jzsj = $("#lsjz").find("option:selected").text();
        var keyWork = $("#txtSRM").val();
        return { jzsj: jzsj, keyWork: keyWork };
    };

    //Tính tổng giá sỉ và tổng giá bán lẻ trong thanh tiêu đề
    function ComputePjzeAndLsze() {
        var titleLsze = 0;
        var count = $("#gridDrugsList").getGridParam('records');
        if (count > 0) {
            var rowIds = $("#gridDrugsList").getDataIDs();
            for (var i = 0; i < rowIds.length; i++) {
                var getRowLsze = $("#gridDrugsList").getRowData(rowIds[i]).lsze;
                titleLsze += parseFloat(getRowLsze);
            }
            titleLsze = window.roundingBy4she6ru5chengshuang(titleLsze, 2);
            $("#yeCon").text("Trang hiện tại Tổng bán lẻ：" + titleLsze + "đ");
        }
    }
</script>
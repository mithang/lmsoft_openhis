@model dynamic
@using Newtouch.Herp.Infrastructure.Enum
@using Newtouch.Herp.Infrastructure;
@using NewtouchHIS.Lib.Base.Extension
@{
    ViewBag.Title = "Kế hoạch mua sắm - Theo giá trị cảnh báo tồn kho";
    Layout = "~/Views/Shared/_Index.cshtml";
     var reportUrl = Newtouch.Herp.Infrastructure.Constants.GetAppConfigValue("ReportUrl");
    var reportSystemCode = Newtouch.Herp.Infrastructure.Constants.GetAppConfigValue("ReportSystemCode");
}
<style>
    #btn_search {
        width: 45px;
        font-weight: bolder;
    }

    #btn_print {
        width: 45px;
        background-color: #fff;
        color: #00a9ea;
        font-weight: bolder;
    }

    #TabGrid {
        width: 100%;
        position: fixed;
        bottom: 10px;
        right: 0;
        z-index: 8888;
        background-color: #253443;
        filter: alpha(Opacity=95);
        -moz-opacity: 0.95;
        opacity: 0.95;
        box-shadow: 0px 2px 10px #909090;
    }

        #TabGrid > * {
            filter: alpha(Opacity=95);
            -moz-opacity: 0.95;
            opacity: 0.95;
        }

    .showbotton {
        display: none;
        position: fixed;
        bottom: 5px;
        right: 0;
        z-index: 9999;
        background-color: #ccc;
        width: 50px;
        height: 44px;
        filter: alpha(Opacity=90);
        -moz-opacity: 0.9;
        opacity: 0.9;
        cursor: pointer;
        border-radius: 100px 0 0 100px;
    }
</style>
<form id="form1">
    <div class="panel panel-default">
        <div class="panel-heading">Điều kiện lọc</div>
        <div style="padding-right:10px;">
            <table class="form">
                <tr>
                    <td class="formTitle">Tên vật tư:</td>
                    <td class="formValue" s>
                        <input type="text" id="keyWord" class="form-control" placeholder="Pinyin/Tên" />
                        <input type="hidden" id="productId" value="" />
                        <input type="hidden" id="kccg" value="1" />
                    </td>
                    <td class="formTitle">Loại:</td>
                    <td class="formValue formDdlSelectorTd">
                        <select class="form-control" id="lb">
                            <option value="">Tất cả</option>
                        </select>
                    </td>
                    <td class="formValue formDdlSelectorTd">
                        <div class="ckbox">
                            <input id="xslkc" name="xslkc" type="checkbox" class="ckbox" checked="checked" />
                            <label for="xslkc">Không hiển thị tồn kho bằng 0</label>
                        </div>
                        <input type="button" class="btn btn-primary btn-md" id="btn_search" value="Tra cứu" />
                    </td>
                    <th class="formTitle">Ghi chú mua sắm:</th>
                    <td class="formValue">
                        <input id="remark" name="remark" type="text" class="form-control " />
                    </td>
                    <td class="formTitle">
                        <input type="button" class="btn btn-primary btn-md" style="width:120px" id="btn_submit" onclick="btn_save()" value="Tạo kế hoạch mua sắm" />
                    </td>
                    <td></td>
                    <td></td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel" style="margin-top:10px">
        <table id="gridList"></table>
        <div id="gridPager" rel="form1"></div>
    </div>
</form>
<div id="TabGrid">
    <ul class="nav nav-tabs navb-bg" role="tablist" id="myTab">
        <li role="presentation" class="active">
            <a href="#dv_mx" id="linkSearch" role="tab" data-toggle="tab">Chi tiết phiếu</a>
        </li>
        <li style="float:right">
            <span class="hiding glyphicon glyphicon-chevron-right btn-lg"></span>
        </li>
    </ul>
    <div id="dv_mx">
        <table id="gridMxInfo"></table>
    </div>
</div>
<div class="showbotton">
    <span class="glyphicon glyphicon-chevron-left btn-lg"></span>
</div>
<script>
    var $gridMxList = $("#gridMxInfo");
    $(function () {
        //Tải lại chiều rộng jqGrid khi thay đổi kích thước cửa sổ trình duyệt
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });
        $(".hiding,.rows,#dv_search,.toolbar,.panel-default").click(function () {
            TabGridHide();
        });
        $(".showbotton").click(function () {
            $(".showbotton").animate({ width: 'hide' },
                "fast",
                function () {
                    $("#TabGrid").animate({ left: '0px' }, "slow");
                });
        });
        Initial();
    });

    //Gắn sự kiện phím Enter
    $(document).keyup(function (event) {
        if (event.keyCode === 13) {
            $("#btn_search").trigger("click");
        }
    });

    //Khởi tạo
    function Initial() {
        getLbSelectTree();
        gridList();
        gridMxInfo();
        TabGridHide();
    }

    //Ẩn hộp tìm kiếm và hiển thị mũi tên
    function TabGridHide() {
        var tabGridwith = $("#TabGrid").width() + 200;
        if ($(".showbotton").is(":hidden")) {
            $("#TabGrid").animate({ left: tabGridwith },
                "slow",
                function () {
                    $(".showbotton").animate({ width: 'show' }, "fast");
                });
        }
    }

    //Loại
    function getLbSelectTree() {
        $("#lb").bindSelect({
            url: "/ProductManage/ProductType/GetPatientTreeSelectJson"
        });
    }

    function getSearchPostData() {
        var posdata = $("#form1").formSerialize();
        posdata.xslkc = $("#xslkc").is(":checked") ? "0" : "1";
        return posdata;
    }
    //Thông tin bảng chính
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/StorageManage/Storage/GetWarehouseStorage",
            postData: getSearchPostData(),
            height: $(window).height() - document.getElementById('gridList').offsetTop - 70,
            colModel: [
                { label: 'Tên', name: 'wzmc', width: 180, align: 'left' },
                { label: 'Pinyin', name: 'py', width: 90, align: 'left' },
                { label: 'Loại', name: 'lb', width: 90, align: 'left' },
                { label: 'Quy cách', name: 'gg', width: 80, align: 'left' },
                { label: 'Tồn kho', name: 'slStr', width: 80, align: 'center' },
                { label: 'Số lượng mua', name: 'cgsl', width: 60, align: 'center', editable: true, editwidth: "90%" },
                 {
                     label: 'Đơn vị', name: 'unitName', width: 70, align: 'center',
                     formatter: function (cellvalue, options) {
                         return "<select name=\"dw\" id=\"sel_dw_" + options.rowId + "\" rowid=" + options.rowId + " class=\"editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" ></select>";
                     }
                 },
                 //{
                 //    label: '<span class="required">*</span>Số lượng mua sắm', name: 'cgsl', width: 80, align: 'center',
                 //    formatter: function (cellvalue, options) {
                 //        return "<input name=\"cgsl\" id=\"sel_cgsl_" + options.rowId + "\" rowid=" + options.rowId + "  class=\"scan-input editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" />";
                 //    }
                 //},
                  {
                      label: 'Nhà cung cấp', name: 'gysmc', width: 200, align: 'center',
                      formatter: function (cellvalue, options) {
                          return "<select name=\"gys\" id=\"sel_gys_" + options.rowId + "\" rowid=" + options.rowId + " class=\"editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" ></select>";
                      }
                  },
                { label: 'gysId', name: 'gysId', hidden: true },
                {
                    label: 'Đơn giá bán lẻ tối thiểu', name: 'wzlsj', width: 80, align: 'center', 
                    formatter: function (val) {
                        return val.toFixed(4);
                    }
                },
                 {
                     label: 'Đơn giá nhập tối thiểu', name: 'wzjj', width: 80, align: 'center', 
                     formatter: function (val) {
                         return val.toFixed(4);
                     }
                 },
                { label: 'Đơn vị tính đơn giá', name: 'bmdwmc', width: 60, align: 'center', hidden: true },
                {
                    label: 'Tổng giá bán lẻ', name: 'lsze', width: 80, align: 'center', hidden: true,
                    formatter: function (val) {
                        return val.toFixed(2);
                    }
                },
                {
                    label: 'Tổng giá nhập', name: 'jjze', width: 80, align: 'center',hidden: true,
                    formatter: function (val) {
                        return val.toFixed(2);
                    }
                },
                {
                    label: ' Giá trị cảnh báo tồn kho(Đơn vị nhỏ)', name: 'kcyjz', width: 110, align: 'center',formatter:function(val){
                        return val?val:0;
                    } 
                },
                { label: 'Nhãn hiệu', name: 'brand', width: 100, align: 'center' },
                { label: 'Hạn sử dụng', name: 'yxqStr', width: 70, align: 'center', hidden: true },
                { label: 'Nhà sản xuất', name: 'sccj', width: 150, align: 'left' },
                { label: "productId", name: "productId", hidden: true, key: true }
            ],
            pager: "#gridPager",
            sortname: 'wzmc asc',
            viewrecords: true,
            multiselect: true,
            gridComplete: function () {
                var ids = $gridList.getDataIDs();
                if (ids != null && ids.length > 0) {
                    for (var i = 0; i < ids.length; i++) {
                        EnableInlineEditBox(ids[i]);
                    }
                }
            },
            //ondblClickRow: function (rowid, iRow, iCol, e) {
            //    var z ="1";
            //    $gridMxList.jqGrid('setGridParam',
            //        {
            //            url: "/StorageManage/Storage/GetWarehouseStorageDetail",
            //            postData: { proId: $("#gridList").getRowData(rowid).productId, zt: z }
            //        }).trigger('reloadGrid');
            //    $(".showbotton").click();
            //}
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam',
                {
                    postData: getSearchPostData()
                }).trigger('reloadGrid');
        });
    }
    //Bật chỉnh sửa trong dòng
    function EnableInlineEditBox(rowid) {
        $("#gridList").jqGrid('editRow', rowid, false, initInlineFunc);//Mở chế độ chỉnh sửa
    }
    //Khởi tạo lớp nổi
    function initInlineFunc(rowid) {
        InitGys(rowid + "_wzmc", rowid);
        initDw(rowid);
    }
    //Khởi tạo nhà cung cấp
    function InitGys($thistr, rowid) {
        $("#sel_gys_" + rowid).bindSelect({ url: "/SupplierManage/Supplier/GetSuppliers", id: "Id", text: "name" });
        $("#sel_gys_" + rowid).change(function () {
            $("#" + rowid + "_gysId").val($(this).val());
        });
    }
    //Khởi tạo đơn vị
    function initDw(rowid) {
        $.najax({
            url: "/ProductManage/Product/ProductUnitsQuery",
            type: "Get",
            data: { keyword: rowid },
            dataType: "json",
            async: false,
            success: function (res) {
                if (res != null && res.length > 0) {
                    $("#sel_dw_" + rowid).empty();
                    $.each(res, function (index, item) {
                        $("#sel_dw_" + rowid).append("<option data-zhyz='" + item.zhyz + "' data-unitId='" + item.unitId + "' value='" + item.unitId + "'>" + item.dwmc + "</option>");
                    });
                }
            }
        });
    }
    //Thông tin chi tiết
    function gridMxInfo() {
        $gridMxList.dataGrid({
            url: "",
            postData: "",
            height: $(window).height() - document.getElementById('gridList').offsetTop - 200,
            colModel: [
                { label: 'Tên', name: 'wzmc', width: 180, align: 'left' },
                { label: 'Số lô', name: 'ph', width: 120, align: 'left' },
                { label: 'Lô', name: 'pc', width: 120, align: 'left' },
                { label: 'Số lượng tồn kho', name: 'bmkcslStr', width: 80, align: 'right' },
                { label: 'Số lượng đóng băng', name: 'bmdjslStr', width: 80, align: 'right' },
                {
                    label: 'Đơn giá nhập', name: 'jj', width: 80, align: 'right',
                    formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0.0000";
                    }
                },
                { label: 'Đơn vị tính đơn giá', name: 'bmdwmc', width: 70, align: 'center' },
                {
                    label: 'Tổng giá nhập', name: 'jjze', width: 80, align: 'right',
                    formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(2) : "0.00";
                    }
                },
                { label: 'Hạn sử dụng', name: 'yxq', width: 70, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d', newformat: 'Y-m-d' } },
                {
                    label: 'Trạng thái', name: 'zt', width: 50, align: 'center', formatter: function (val, options) {
                        return val === "1" ? "<i rowId=" + options.rowId + " onclick='operateZt(this)' class=\"fa fa-toggle-on\"></i>" : "<i rowId=" + options.rowId + " onclick='operateZt(this)' class=\"fa fa-toggle-off\"></i>";
                    }
                },
                { label: 'productId', name: 'productId', hidden: true }
            ]
        });
    }

    //Đặt tồn kho có hiệu lực hay không
    function operateZt(obj) {
        var zt = "1";
        var ph = $gridMxList.getRowData($(obj).attr("rowId")).ph;
        var pc = $gridMxList.getRowData($(obj).attr("rowId")).pc;
        var proId = $gridMxList.getRowData($(obj).attr("rowId")).productId;
        if ($(obj).hasClass("fa-toggle-off")) {
            $(obj).removeClass("fa-toggle-off").addClass("fa-toggle-on");
            zt = "1";
        } else {
            $(obj).removeClass("fa-toggle-on").addClass("fa-toggle-off");
            zt = "0";
        }

        $.najax({
            url: "/StorageManage/Storage/UpdateKcxxZt",
            type: "POST",
            data: { proId: proId, ph: ph, pc: pc, zt: zt },
            dataType: "json",
            success: function (data) {
                if (data.state === 'success') {
                    //$.modalMsg("Sửa trạng thái tồn kho thành công", "success", 1000);
                }
                else {
                    $.modalMsg(data, "error", 1000);
                }
            }
        });
    }

    //Lấyurltham số trong
    function getQueryString(name) {
        // khớp tham số đích
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
        var result = window.location.search.substr(1).match(reg); // Đối vớiquerystringkhớp tham số đích
        if (result != null) {
            return decodeURIComponent(result[2]);
        } else {
            return null;
        }
    }

    function btn_save()
    {
        debugger
        var $gridList = $("#gridList");
        var list = [];
        var validationFailedArr = [];
        $.each($gridList.find("input[type=checkbox]:checked"), function () {
            var rowid = $(this).parent().parent().parent().attr("id");
            $gridList.saveRow(rowid, null, null, null, function (callbackRowId) { }, null, null);
            var rowData = $gridList.jqGrid('getRowData', rowid);
            if (!Validately(rowData, rowid)) {
                validationFailedArr.push(rowid);
                return;
            }
            list.push(AssembleData(rowData, rowid));
        });
        if (validationFailedArr.length > 0) {
            for (var i = 0; i < validationFailedArr.length; i++) {
                $gridList.jqGrid('editRow', validationFailedArr[i], false, initInlineFunc);//Mở chế độ chỉnh sửa
            }
            return;
        }
        if (list.length === 0) {
            $.modalMsg("Vui lòng tích chọn dữ liệu cần sửa!", 'warning', 1000);
            return;
        }
        var pp = Object();
        pp.auditState = @((int)EnumAuditState.Waiting);
        pp.cgdh ="";
        pp.rkbmCode ="";
        pp.remark = $("#remark").val();
        $.najax({
            url: "/BillManage/PurchasingPlan/SubmitFillPurchasingPlan",
            type: "POST",
            alerterror: false,
            data: { pp: pp, ppmx: list },
            dataType: "json",
            success: function (res) {
                if (res.state === "success") {
                    $.modalMsg("Tạo kế hoạch mua sắm thành công", 'success', 1500);
                    $("#btn_search").trigger("click");
                } else {
                    $.modalAlert(res.message, "error");
                    var rowIds = $gridList.getDataIDs();
                    for (var i = 0; i < rowIds.length; i++) {
                        $gridList.jqGrid('editRow', rowIds[i], false, initInlineFunc);//Mở chế độ chỉnh sửa
                    }
                }
            }
        });
    }
    //Kiểm tra giá trị số
    function Validately(rowData, rowid) {
        if (rowData.wzmc === "" || rowData.productId === "") {
            $.modalMsg('Vật tư bắt buộc chọn', 'error', 1000);
            return false;
        }
        var reg = /^[1-9]\d*$/;//Lớn hơn0số nguyên
        if (!reg.test(rowData.cgsl)) {
            $.modalMsg("Số lượng phải là số nguyên lớn hơn 0!", "warning", 1500);
            return false;
        }
        return true;
    }

    //Ghép dữ liệu gửi lên
    function AssembleData(rowData, rowid) {
        var zhyz = Number($("#sel_dw_" + rowid).find("option:selected").attr("data-zhyz"));
        return {
            productId: rowData.productId,
            sl: rowData.cgsl,
            unitId: $("#sel_dw_" + rowid).find("option:selected").attr("data-unitId"),
            zhyz: zhyz,
            dwmc: $("#sel_dw_" + rowid).find("option:selected").text(),
            remark: "",
            supplierId: $("#sel_gys_" + rowid).val(),
            supplierName: $("#sel_gys_" + rowid).find("option:selected").text()
        };
    }
    //Tải số phiếu xuất kho tới khoa
    function GetNewBillNo() {
        $.najax({
            url: "/BillManage/PurchasingPlan/GetNewPurchasingPlanBillNo?r=" + Math.random(),
            dataType: "text",
            type: "Get",
            success: function (data) {
                $("#Pdh").val(data);
            }
        });
    }
</script>
@model dynamic
@using Newtouch.Herp.Infrastructure.Enum
@using NewtouchHIS.Lib.Base.Extension
@{
    ViewBag.Title = "Duyệt kế hoạch mua sắm";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    .dv-remarks {
        line-height: 25px;
        margin-top: 10px;
    }

    #remarks {
        width: 300px;
        border: 0;
        border-bottom: 1px solid #ccc;
        background-color: transparent;
        padding: 0 10px;
    }
</style>
<form id="form1">
    <div class="panel panel-default" id="dv-search">
        <div class="panel-heading">Điều kiện lọc</div>
        <div style="padding-right:10px;">
            <table class="form">
                <tr>
                    <td class="formTitle">Phiếu kế hoạch:</td>
                    <td class="formValue" s>
                        <input type="text" id="cgdh" class="form-control" placeholder="Số phiếu kế hoạch" />
                    </td>
                    <td class="formTitle">Trạng thái duyệt:</td>
                    <td class="formValue formDdlSelectorTd" style="width: 90px;">
                        @Html.DropDownList("auditState", EnumAuditState.Waiting.ToDescSelectList(), "Tất cả", new { @class = "form-control" })
                    </td>
                    <th class="formTitle"><span class="required">*</span>Thời gian gửi:</th>
                    <td class="formValue">
                        <input id="kssj" type="text" class="form-control input-wdatepicker " value="@DateTime.Now.ToString("yyyy-MM-01 00:00:00")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy HH:mm:ss' })" />
                    </td>
                    <th class="formTitle" style="width: 50px;">Đến:</th>
                    <td class="formValue">
                        <input id="jssj" type="text" class="form-control input-wdatepicker " value="@DateTime.Now.AddHours(2).ToString("dd/MM/yyyy HH:mm:ss")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy HH:mm:ss' })" />
                    </td>
                    <td class="formTitle">
                        <input type="button" class="btn btn-primary btn-md" id="btn_search" value="Tra cứu" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel">
        <table id="gridList"></table>
        <div id="gridPager" rel="form1"></div>
    </div>
    <div class="gridPanel">
        <table id="gridMxList"></table>
    </div>
    @Html.Partial("_BottomButtonsView", new Newtouch.Herp.Web.Models.BottomButtonViewModel()
    {
        ShowKeyList = new[] { 6, 7},
        F6Text = "Duyệt đạt",
        F7Text = "Không đạt"
    })
    <div class="dv-remarks"><span>Ghi chú duyệt:</span><input type="text" id="remarks" value="" /></div>
</form>
<script type="text/javascript">
    var $gridList = $("#gridList");
    var $gridMxList = $("#gridMxList");
    var gridListhigh = ($(window).height() - 65) / 2 - 70;
    var gridMxListhigh = ($(window).height() - 65) / 2 - 110;
    $(".toolbar").width(200);
    $(function () {
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });
        $('#auditState').val('@((int)EnumAuditState.Waiting)').trigger("change");
        gridList();
        gridMxList();
    });

    //Gắn sự kiện phím Enter
    $(document).keyup(function (event) {
        if (event.keyCode === 13) {
            $("#btn_search").trigger("click");
        }
    });

    //Thông tin bảng chính
    function gridList() {
        $gridList.dataGrid({
            url: "/BillManage/PurchasingPlan/GetPurchasingPlanInfo",
            postData: assembleParam(),
            height: gridListhigh,
            colModel: [
                {
                    label: 'Trạng thái duyệt', name: 'auditState', width: 100, align: 'center', formatter: function (val) {
                        switch (val) {
                        case @((int)EnumAuditState.Waiting):
                            return "@EnumAuditState.Waiting.GetDescription()";
                        case @((int)EnumAuditState.Adopt):
                            return "@EnumAuditState.Adopt.GetDescription()";
                        case @((int)EnumAuditState.Cancelled):
                            return "@EnumAuditState.Cancelled.GetDescription()";
                        case @((int)EnumAuditState.Refuse):
                            return "@EnumAuditState.Refuse.GetDescription()";
                        case @((int)EnumAuditState.Temporary):
                            return "@EnumAuditState.Temporary.GetDescription()";
                        default:
                            return "";
                        }
                    }
                },
                { label: 'Số kế hoạch mua sắm', name: 'cgdh', width: 180 },
                { label: 'Bộ phận mua sắm', name: 'rkbmmc', width: 110 },
                { label: 'Ghi chú', name: 'remark', width: 250, align: 'left' },
                { label: 'Người tạo', name: 'CreatorName', width: 150 },
                { label: 'Thời gian tạo', name: 'CreateTime', width: 150, formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'rkbmCode', name: 'rkbmCode', width: 110, hidden: true}
            ],
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                $gridMxList.jqGrid('setGridParam',
                    {
                        url: "/BillManage/PurchasingPlan/GetPurchasingPlanDetail",
                        postData: { cgdh: $gridList.getRowData(rowid).cgdh }
                    }).trigger('reloadGrid');
                $("#remarks").val( $gridList.getRowData(rowid).remark );
            },
            gridComplete: function () {
                $gridMxList.jqGrid("clearGridData");
            }
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam',
                {
                    postData: assembleParam()
                }).trigger('reloadGrid');
        });
        $("#gridPager_left").html("<span onclick='shrinkGridList(this)' style='cursor: pointer;margin-right: 250px;font-size: 1.3rem;padding: 0 20px;'><i class='fa fa-angle-up'></i></span>");
    }

    //Thu gọn thông tin chính
    function shrinkGridList(obj) {
        var t = $(".ui-jqgrid-bdiv")[0];
        if ($(t).is(':hidden')) {
            $(obj).html("<i class='fa fa-angle-up'></i>");
            $(t).show(500);
            $gridList.setGridHeight(gridListhigh);
            $gridMxList.setGridHeight(gridMxListhigh);

        } else {
            $(obj).html("<i class='fa fa-angle-down'></i>");
            $(t).hide(200);
            $gridList.setGridHeight(0);
            $gridMxList.setGridHeight(gridMxListhigh + gridListhigh);
        }
    }

    //Ghép điều kiện tìm kiếm
    function assembleParam() {
        var auditState = $("#auditState").val() === "" ? -1 : $("#auditState").val();
        return {
            cgdh: $("#cgdh").val(),
            kssj: $("#kssj").val(),
            jssj: $("#jssj").val(),
            auditState: auditState
        };
    }

    //Thông tin chi tiết
    function gridMxList() {
        $gridMxList.dataGrid({
            height: gridMxListhigh,
            colModel: [
                { label: 'Vật tư', name: 'wzmc', width: 200 },
                { label: 'Số lượng kế hoạch', name: 'slStr', width: 110 },
                { label: 'Số lượng thực tế', name: 'sjslStr', width: 110 },
                { label: 'Quy cách', name: 'gg', width: 150 },
                { label: 'Nhãn hiệu', name: 'brand', width: 200 },
                { label: 'Nhà sản xuất', name: 'sccj', width: 200 },
                { label: 'productId', name: 'productId', hidden: true}
            ],
            viewrecords: true
        });
    }

    //Đã duyệt
    function newtouch_event_f6() {
        var id = $gridList.jqGrid("getGridParam", "selrow");
        if (!id) {
            $.modalAlert("Vui lòng chọn kế hoạch mua sắm!", 'warning');
            return false;
        }
        var rowData = $gridList.jqGrid('getRowData', id);
        if (!rowData) {
            $.modalAlert("Thông tin kế hoạch mua sắm đã chọn chưa đầy đủ,Vui lòng liên hệ quản trị viên!", 'warning');
            return false;
        }
        if (rowData.auditState !== "@EnumAuditState.Waiting.GetDescription()") {
            $.modalAlert("Duyệt chỉ áp dụng cho kế hoạch mua sắm đang chờ xử lý!", 'warning');
            return false;
        }
        SubmitAuditPurchasingPlan(rowData.cgdh, @((int)EnumAuditState.Adopt));
    }

    //Không duyệt
    function newtouch_event_f7() {
        var id = $gridList.jqGrid("getGridParam", "selrow");
        if (!id) {
            $.modalAlert("Vui lòng chọn kế hoạch mua sắm!", 'warning');
            return false;
        }
        var rowData = $gridList.jqGrid('getRowData', id);
        if (!rowData) {
            $.modalAlert("Thông tin kế hoạch mua sắm đã chọn chưa đầy đủ,Vui lòng liên hệ quản trị viên!", 'warning');
            return false;
        }
        if (rowData.auditState === "@EnumAuditState.Adopt.GetDescription()") {
            $.modalAlert("Kế hoạch mua sắm đã được duyệt,không thể tiếp tục thao tác!", 'warning');
            return false;
        }
        if (rowData.auditState !== "@EnumAuditState.Waiting.GetDescription()") {
            $.modalAlert("Duyệt chỉ áp dụng cho kế hoạch mua sắm đang chờ xử lý!", 'warning');
            return false;
        }
        SubmitAuditPurchasingPlan(rowData.cgdh, @((int)EnumAuditState.Refuse));
    }

    //Gửi duyệt
    function SubmitAuditPurchasingPlan(cgdh, auditState) {
        $.najax({
            type: "POST",
            url: "/BillManage/PurchasingPlan/SubmitAuditPurchasingPlan",
            data: { cgdh: cgdh, auditState: auditState, remarks: $("#remarks").val()},
            dataType: "json",
            success: function (res) {
                if (res.state === "success") {
                    $.modalMsg('Thao tác thành công', 'success', 2000);
                    $("#btn_search").trigger("click");
                    $("#remarks").val("");
                }
            }
        });
    }

</script>

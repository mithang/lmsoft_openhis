@using Newtouch.Herp.Infrastructure;
@using Newtouch.Herp.Infrastructure.Enum;
@using NewtouchHIS.Lib.Base.Extension
@{
    ViewBag.Title = "Duyệt phiếu xuất/nhập kho";
    Layout = "~/Views/Shared/_Index.cshtml";

    var djlxItemStrs = Constants.CurrentKf.currentKfLevel != 1 ? "3,4" : "1,2,3,5";
}
<style>
    #btn_search {
        width: 45px;
        font-weight: bolder;
    }

    .showbotton {
        display: none;
        position: fixed;
        bottom: 50px;
        right: 0;
        z-index: 9999;
        background-color: #ccc;
        width: 50px;
        height: 44px;
        filter: alpha(Opacity=90);
        -moz-opacity: 0.9;
        opacity: 0.9;
        cursor: pointer;
        border-radius: 100px 0 0 100px;
    }

    #TabGrid {
        width: 100%;
        position: fixed;
        bottom: 50px;
        right: 0;
        z-index: 8888;
        background-color: #253443;
        filter: alpha(Opacity=92);
        -moz-opacity: 0.92;
        opacity: 0.92;
        box-shadow: 0 2px 10px #909090;
    }

        #TabGrid > * {
            filter: alpha(Opacity=92);
            -moz-opacity: 0.92;
            opacity: 0.92;
        }

    input[name=fph] {
        padding: 2px;
        width: 90%;
        height: 90%;
        border-radius: 4px;
        color: #555;
        border-radius: 4px;
        -webkit-box-shadow: inset 0 1px 1px rgba(0,0,0,.075);
        box-shadow: inset 0 1px 1px rgba(0,0,0,.075);
        -webkit-transition: border-color ease-in-out .15s,-webkit-box-shadow ease-in-out .15s;
        -o-transition: border-color ease-in-out .15s,box-shadow ease-in-out .15s;
        transition: border-color ease-in-out .15s,box-shadow ease-in-out .15s;
        background-color: #fff;
        background-image: none;
        border: 1px solid #ddd;
    }
</style>
<form id="form1">
    <div class="panel panel-default" id="dv_search">
        <div class="panel-heading">
            Điều kiện tra cứu
        </div>
        <div style="padding-right:10px;">
            <table class="form">
                <tr>
                    <th class="formTitle">Trạng thái duyệt：</th>
                    <td class="formValue">
                        <select class="form-control" id="ddlSHZT"></select>
                    </td>
                    <th class="formTitle">Ngày：</th>
                    <td class="formValue">
                        <input id="txtStartDate" type="text" class="form-control input-wdatepicker " value="@DateTime.Now.ToString("yyyy-MM-dd 00:00:00")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                    </td>
                    <th class="formTitle">Đến：</th>
                    <td class="formValue">
                        <input id="txtEndDate" type="text" class="form-control input-wdatepicker " value="@DateTime.Now.AddHours(1).ToString("yyyy-MM-dd HH:mm:ss")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' })" />
                    </td>
                    <th class="formTitle">Số hóa đơn：</th>
                    <td class="formValue">
                        <input id="txtFPH" type="text" class="form-control " />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Số phiếu：</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="txtPDH" />
                    </td>
                    <th class="formTitle">Loại phiếu：</th>
                    <td class="formValue">
                        @Html.DropDownList("ddlDJLX", EnumOutOrInStorageBillType.Wbrk.ToSomeDescSelectList(djlxItemStrs), "Tất cả", new { @class = "form-control" })
                    </td>
                    <th class="formTitle">Số phiếu giao hàng：</th>
                    <td class="formValue">
                        <input type="text" class="form-control" id="deliveryNo" placeholder="Số phiếu giao hàng" />
                    </td>
                    <td class="formTitle" colspan="2">
                        <input type="button" id="btn_search" class="btn btn-md btn-primary" value="Tra cứu" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</form>
<div class="gridPanel">
    <table id="gridDJMainRecords"></table>
    <div id="gridPager" rel="form1"></div>
</div>
<div id="TabGrid">
    <ul class="nav nav-tabs navb-bg" role="tablist" id="myTab">
        <li role="presentation" class="active">
            <a href="#dv_djmx" id="linkSearch" role="tab" data-toggle="tab">Chi tiết phiếu</a>
        </li>
        <li style="float:right">
            <span class="hiding glyphicon glyphicon-chevron-right btn-lg"></span>
        </li>
    </ul>
    <div id="dv_djmx">
        <table id="gridDJMXInfo"></table>
    </div>
</div>
<div class="showbotton">
    <span class="glyphicon glyphicon-chevron-left btn-lg"></span>
</div>
@Html.Partial("_BottomButtonsView", new Newtouch.Herp.Web.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 6, 7, 8, 9},
    F6Text = "Duyệt đạt",
    F7Text = "Không đạt",
    F8Text = "Hủy duyệt",
    F9Text = "Trả lại đơn"
})

<script>
    var $gridDjMainRecords = $("#gridDJMainRecords");
    $(function () {
        //Tải lại chiều rộng jqGrid khi thay đổi kích thước cửa sổ trình duyệt
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });
        Init();
        //Điều khiển ẩn/hiện hộp tìm kiếm
        $(".hiding,.rows,#dv_search,.toolbar").click(function () {
            TabGridHide();
        });
        $(".showbotton").click(function () {
            $(".showbotton").animate({ width: 'hide' }, "fast", function () {
                $("#TabGrid").animate({ left: '0px' }, "slow");
            });
        });
    });

    $(document).keyup(function (event) {
        if (event.keyCode == 13) {
            $("#btn_search").trigger("click");
        }
    });

    //Khởi tạo
    function Init() {
        initShzt();
        var djlx = getQueryString("djlx");
        if (djlx != null) {
            $("#txtStartDate").val("1970-01-01");
            $("#ddlDJLX").val(djlx);
        }
        TabGridHide();
        gridDJMainRecords();
    }

    //Khởi tạo trạng thái duyệt
    function initShzt() {
        $("#ddlSHZT").bindSelect({
            url: "/BillManage/OutOrInStorageBill/QueryCommonAuditState"
        });
        $('#ddlSHZT').val('@((int)EnumAuditState.Waiting)').trigger("change");
    }

    //Ẩn hộp tìm kiếm và hiển thị mũi tên
    function TabGridHide() {
        var tabGridwith = $("#TabGrid").width() + 200;
        if ($(".showbotton").is(":hidden")) {
            $("#TabGrid").animate({ left: tabGridwith }, "slow", function () {
                $(".showbotton").animate({ width: 'show' }, "fast");
            });
        }
    }

    //Bản ghi chính của chứng từ
    function gridDJMainRecords() {
        $gridDjMainRecords.dataGrid({
            postData: getSearchPostData(),
            height: $(window).height() - 230,
            url: "/OutOrInStorageBill/SelectReceiptMainInfo?from=approval",
            colModel: [
                {
                    label: 'Trạng thái duyệt', name: 'shzt', width: 60, align: 'left', formatter: function (val) {
                        switch (val) {
                            case '@((int)EnumAuditState.Temporary)':
                                return "@EnumAuditState.Temporary.GetDescription()";
                            case '@((int)EnumAuditState.Adopt)':
                                return "@EnumAuditState.Adopt.GetDescription()";
                            case '@((int)EnumAuditState.Cancelled)':
                                return "@EnumAuditState.Cancelled.GetDescription()";
                            case '@((int)EnumAuditState.Refuse)':
                                return "@EnumAuditState.Refuse.GetDescription()";
                            case '@((int)EnumAuditState.Waiting)':
                                return "@EnumAuditState.Waiting.GetDescription()";
                        default:
                            return "";
                        }
                    }
                },
                {
                    label: 'Loại phiếu', name: 'djlx', width: 65, align: 'left', formatter: function (val) {
                        switch (val) {
                            case @((int)EnumOutOrInStorageBillType.Nbth):
                                return "@EnumOutOrInStorageBillType.Nbth.GetDescription()";
                            case @((int)EnumOutOrInStorageBillType.Wbck):
                                return "@EnumOutOrInStorageBillType.Wbck.GetDescription()";
                            case @((int)EnumOutOrInStorageBillType.Wbrk):
                                return "@EnumOutOrInStorageBillType.Wbrk.GetDescription()";
                            case @((int)EnumOutOrInStorageBillType.Zjck):
                                return "@EnumOutOrInStorageBillType.Zjck.GetDescription()";
                            default:
                                return "";
                        }
                    }
                },
                { label: 'Số phiếu', name: 'Pdh', width: 135, align: 'center' },
                { label: 'Số phiếu giao hàng', name: 'deliveryNo', width: 100, align: 'center' },
                { label: 'Kho xuất', name: 'ckbmmc', width: 120, align: 'center' },
                { label: 'Bộ phận nhập', name: 'rkbmmc', width: 120, align: 'center' },
                { label: 'Hình thức xuất/nhập kho', name: 'crkfsmc', width: 70, align: 'center' },
                { label: 'Thời gian thao tác', name: 'czsj', width: 120, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Thời gian nhập', name: 'rksj', width: 120, align: 'center',formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Tổng giá bán lẻ', name: 'ljze', width: 70, align: 'center', formatter: function (val) { return val.toFixed(2); } },
                { label: 'Tổng giá nhập', name: 'jjze', width: 70, align: 'center', formatter: function (val) { return val.toFixed(2); }},
                { label: 'Chênh lệch giá nhập-bán', name: 'jxcj', width: 65, align: 'left', formatter: function (val) { return val.toFixed(2); }},
                { label: 'crkId', name: 'crkId', hidden: true },
                { label: 'djlx', name: 'djlx', hidden: true }
            ],
            unwritten: false,
            multiselect: false,
            pager: "#gridPager",
            sortname: 'czsj desc',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                btn_selectrow(rowid);
            }
        });

        $("#btn_search").click(function () {
            $('#gridDJMXInfo').jqGrid("clearGridData");

            $gridDjMainRecords.jqGrid('setGridParam', {
                postData: getSearchPostData()
            }).trigger('reloadGrid');
        });
    }

    //Ghép điều kiện truy vấn
    function getSearchPostData() {
        var shzt = $("#ddlSHZT").val();
        var kssj = $("#txtStartDate").val();
        var jssj = $("#txtEndDate").val();
        var pdh = $("#txtPDH").val();
        var fph = $("#txtFPH").val();
        var djlx = $("#ddlDJLX").val();
        var deliveryNo = $("#deliveryNo").val();
        return { kssj: kssj, jssj: jssj, pdh: pdh, fph: fph, djlx: djlx, shzt: shzt, deliveryNo: deliveryNo };
    };

    //Sự kiện nhấp chuột
    function btn_selectrow(rowid) {
        $('#gridDJMXInfo').jqGrid("clearGridData");//Mỗi lần nhấp chuột，Xóa trướcChi tiết sau đó tải lại tất cả các dòng đã chọnChi tiết
        $.najax({
            type: "POST",
            url: "/OutOrInStorageBill/SelectReceipDetailInfo",
            data: { crkId: $("#gridDJMainRecords").jqGrid('getRowData', rowid).crkId },
            dataType: "json",
            success: function (ajaxresp) {
                if (ajaxresp !== null) {
                    $('#gridDJMXInfo').newtouchLocalDataGrid(null, ajaxresp);
                }
                $(".showbotton").click().trigger("click");
            }
        });
    }

    //Chi tiết chứng từ
    $('#gridDJMXInfo').newtouchLocalDataGrid({
        height: $(window).height() - 240,
        unwritten: false,
        sortable: false,
        colModel: [
            { label: 'Số thứ tự chi tiết phiếu xuất/nhập kho', name: 'crkmxId', hidden: true, width: 100, align: 'left' },
            { label: 'Loại', name: 'lbmc', width: 100, align: 'left' },
            { label: 'Tên', name: 'wzmc', width: 150, align: 'left' },
            { label: 'Số lượng', name: 'slStr', width: 60, align: 'right' },
            { label: 'Số lượng', name: 'sl', hidden: true },
            { label: 'Tổng giá bán lẻ', name: 'ljze', width: 70, align: 'right', formatter: function (val) { return val.toFixed(2); } },
            { label: 'Tổng giá nhập', name: 'jjze', width: 70, align: 'right', formatter: function (val) { return val.toFixed(2); }},
            { label: 'Chênh lệch giá nhập-bán', name: 'jxcj', width: 60, align: 'right', formatter: function (val) { return val.toFixed(2); }},
            { label: 'Đơn vị', name: 'dw', hidden: true },
            { label: 'Quy cách', name: 'gg', width: 80, align: 'left' },
            { label: 'Số lô', name: 'ph', width: 120, align: 'center' },
            { label: 'Lô', name: 'pc', width: 120, align: 'center' },
            //{ label: 'số hóa đơn', name: 'fph', width: 90, align: 'left' },
            {
                label: 'Số hóa đơn', name: 'fph', width: 90, align: 'center',
                formatter: function (cellvalue, options) { return cellvalue === "" || cellvalue === null ? "<input type=\"text\" name=\"fph\" rowid=" + options.rowId + " role=\"textbox\" onblur=\"UpdateFph(this)\">" : cellvalue; }
            },
            { label: 'Nhà sản xuất', name: 'sccj', width: 150, align: 'left' }
        ]
    });

    //Bổ sung số hóa đơn
    function UpdateFph(obj) {
        var fph = $(obj).val();
        var crkmxId = $("#gridDJMXInfo").getRowData($(obj).attr("rowid")).crkmxId;
        if (fph !== "") {
            $.modalConfirm("Bạn có chắc muốn đổi số hóa đơn thành " + fph + " không?",
                function(flag) {
                    if (flag) {
                        $.najax({
                            url: "/OutOrInStorageBill/UpdateFph",
                            type: "POST",
                            data: { crkmxId: crkmxId, fph: fph },
                            dataType: "json",
                            success: function(data) {
                                if (data.state === 'success') {
                                    $.modalMsg("Sửa số hóa đơn thành công", "success", 1000);
                                } else {
                                    $.newtouchAlert(data);
                                }
                            }
                        });
                    }
                });
        }
    }

    //Duyệt
    function newtouch_event_f6() {
        submitReceiptApproval('1');
    }

    //Không đạt
    function newtouch_event_f7() {
        submitReceiptApproval('2');
    }

    //Hủy bỏ
    function newtouch_event_f8() {
        submitReceiptApproval('3');
    }

    //Trả lại đơn
    function newtouch_event_f9() {
        var selRowData = $("#gridDJMainRecords").jqGridRowValue();
        if (!selRowData || !selRowData.crkId || !selRowData.djlx) {
            $.modalMsg('Vui lòng chọn một phiếu', 'warning', 1500);
            return;
        }
        if (selRowData.shzt != "@EnumAuditState.Waiting.GetDescription()") {
            $.modalMsg('【Trả lại đơn】chỉ áp dụng cho phiếu đang chờ xử lý', 'warning', 1500);
            return;
        }
        $.najax({
            type: 'Post',
            url: "/BillManage/OutOrInStorageBill/BackToTemporary",
            data: { crkId: parseInt(selRowData.crkId) },
            dataType: 'json',
            success: function (ajaxresp) {
                if (ajaxresp.state === 'success') {
                    $.modalMsg("Thao tác thành công", 'success', 1000);
                }
                else {
                    $.modalAlert(ajaxresp.message, 'error');
                }
                return;
            },
            complete: function () {
                $("#btn_search").trigger('click');
            }
        });
    }

    //Cập nhật trạng thái duyệt chứng từ，Gửi lên máy chủ
    function submitReceiptApproval(dstnShzt) {
        var selRowData = $("#gridDJMainRecords").jqGridRowValue();
        if (!selRowData || !selRowData.crkId || !selRowData.djlx) {
            $.modalMsg('Vui lòng chọn một phiếu', 'warning', 1500);
            return;
        }
        var postData = { djId: selRowData.crkId, djlx: selRowData.djlx, shzt: dstnShzt };
        $.najax({
            url: "/BillManage/OutOrInStorageBill/SubmitReceiptApproval",
            data: postData,
            type: 'POST',
            dataType: 'json',
            success: function (ajaxresp) {
                if (ajaxresp.state === 'success') {
                    $.modalMsg("Thao tác thành công", 'success',1500);
                }
                else {
                    $.modalAlert(ajaxresp.message, 'error');
                }
                return;
            },
            complete: function () {
                $("#btn_search").trigger('click');
            }
        });
    }

    //Lấy tham số trong url
    function getQueryString(name) {
        // khớp tham số đích
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
        var result = window.location.search.substr(1).match(reg); // Đối vớiquerystringkhớp tham số đích
        if (result != null) {
            return decodeURIComponent(result[2]);
        } else {
            return null;
        }
    }
</script>
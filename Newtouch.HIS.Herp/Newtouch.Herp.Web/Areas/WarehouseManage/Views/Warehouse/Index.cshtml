@using NewtouchHIS.Lib.Framework.Operator
@{
    ViewBag.Title = "Bảo trì kho";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-default" onclick="$.reload()" aria-label="Tải lại" title="Tải lại"><span class="fa fa-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Thêm mới</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-default" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-danger" onclick="btn_delete()" style="margin-left:16px;"><i class="fa fa-trash-o"></i>Xóa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-default" onclick="btn_synce()"><i class="fa fa fa-exchange"></i>Đồng bộ vật tư</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Tên" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn btn-primary" aria-label="Tìm kiếm" title="Tìm kiếm"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
</div>
<script lang="javascript">
    $(function () {
        gridList();
    });

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/WarehouseManage/Warehouse/GetWarehouseGridJson",
            treeGrid: true,
            treeGridModel: "adjacency",
            ExpandColumn: "address",
            height: $(window).height() - 90,
            colModel: [
                { label: "Khóa chính", name: "Id", hidden: true, key: true, frozen: true },
                { label: 'Tên kho', name: 'name', width: 190, align: 'left', frozen: true },
                { label: 'Vị trí', name: 'address', width: 190, align: 'left' },
                { label: 'Cấp', name: 'level', width: 40, align: 'left' },
                { label: 'Ghi chú', name: 'remark', width: 150, align: 'left' },
                { label: 'Quản trị viên', name: 'admins', width: 190, align: 'left' },
                {
                    label: "Hiệu lực", name: "zt", width: 50, align: "center",
                    formatter: function (cellvalue) { return cellvalue === "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; }
                },
                {
                    label: "Đồng bộ mặc định", name: "isDefSyn", width: 50, align: "center",
                    formatter: function (cellvalue) { return cellvalue === "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; }
                },
                { label: 'Người tạo', name: 'CreatorCode', width: 70, align: 'left' },
                { label: 'Thời gian tạo', name: 'CreateTime', width: 110, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i', newformat: 'Y-m-d H:i' } },
                { label: 'Sửa lần cuối', name: 'LastModifierCode', hidden: true },
                { label: 'Thời gian sửa lần cuối', name: 'LastModifyTime', hidden: true },
                { label: 'OrganizeId', name: 'OrganizeId', hidden: true }
            ]
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam',
                {
                    postData: { keyWord: $("#txt_keyword").val() }
                }).trigger('reloadGrid');
        });
    }

    //Nhấn Enter để kích hoạt sự kiện Tra cứu
    $("#txt_keyword").keydownEnterEvent(function() {
        $("#btn_search").trigger("click");
    });

    //Thêm mới
    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "Thêm kho mới",
            url: "/WarehouseManage/Warehouse/Form",
            width: "750px",
            height: "550px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function() {
                    $('#gridList').jqGrid("clearGridData"); //Xóa chi tiết củagrid
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                });
            }
        });
    }

    //Sửa
    function btn_edit() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        @*var thisOrgId = $("#gridList").jqGridRowValue().OrganizeId;
        if (!!!thisOrgId && '@(!string.IsNullOrEmpty(OperatorProvider.GetCurrent().OrganizeId) && OperatorProvider.GetCurrent().OrganizeId != OperatorProvider.GetCurrent().TopOrganizeId)' === 'True') {
            $.modalAlert("Không có quyền sửa", 'warning');
            return;
        }*@
        $.modalOpen({
            id: "Form",
            title: "Sửa kho",
            url: "/WarehouseManage/Warehouse/Form?keyValue=" + keyValue,
            width: "750px",
            height: "550px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function() {
                    $('#gridList').jqGrid("clearGridData"); //Xóa chi tiết củagrid
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                });
            }
        });
    }

    //Xóa
    function btn_delete() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        @*var thisOrgId = $("#gridList").jqGridRowValue().OrganizeId;
        if (!!!thisOrgId && '@(!string.IsNullOrEmpty(OperatorProvider.GetCurrent().OrganizeId) && OperatorProvider.GetCurrent().OrganizeId != OperatorProvider.GetCurrent().TopOrganizeId)' === 'True') {
            $.modalAlert("Không có quyền sửa", 'warning');
            return;
        }*@
        $.deleteForm({
            url: "/WarehouseManage/Warehouse/DeleteForm",
            param: { keyValue: keyValue },
            success: function () {
                $('#gridList').jqGrid("clearGridData"); //Xóa chi tiết củagrid
                $("#gridList").resetSelection();
                $("#gridList").trigger("reloadGrid");
            }
        });
    }

    //Đồng bộ vật tư
    function btn_synce() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        var rowid = $("#gridList").jqGrid("getGridParam","selrow");
        var kfName = $($("#gridList").jqGrid("getRowData", rowid).name).text(); //namekfName
        var title = "Đồng bộ [" + kfName + "] vật tư";
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        @*var thisOrgId = $("#gridList").jqGridRowValue().OrganizeId;
        if (!!!thisOrgId && '@(!string.IsNullOrEmpty(OperatorProvider.GetCurrent().OrganizeId) && OperatorProvider.GetCurrent().OrganizeId != OperatorProvider.GetCurrent().TopOrganizeId)' === 'True') {
            $.modalAlert("Không có quyền sửa", 'warning');
            return;
        }*@
        $.modalOpen({
            id: "Form",
            title: title,
            url: "/WarehouseManage/Warehouse/SynceProduct?keyValue=" + keyValue,
            width: "1000px",
            height: "600px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function() {
                    $('#gridList').jqGrid("clearGridData"); //Xóa chi tiết củagrid
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                });
            }
        });
    }
</script>

<script>
// PER-APP (B) redesign: nut "Sua" chi bat khi co dong duoc chon (trang thai truc quan;
// handler btn_edit() von da chan khi chua chon - day chi la lop vo hieu truc quan).
$(function () {
    try {
        var $editBtn = $(".toolbar a[onclick=\"btn_edit()\"]");
        function rdSyncEditState() {
            var sel = $("#gridList").jqGrid("getGridParam", "selrow");
            var has = !!sel;
            $editBtn.toggleClass("disabled", !has);
            $editBtn.attr("aria-disabled", has ? "false" : "true");
        }
        $("#gridList").on("jqGridSelectRow jqGridGridComplete jqGridAfterGridComplete", rdSyncEditState);
        rdSyncEditState();
    } catch (e) { /* tang cuong giao dien: khong lam hong trang neu luoi chua khoi tao */ }
});
</script>

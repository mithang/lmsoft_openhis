
@{
    ViewBag.Title = "Lịch sử điều chỉnh giá";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<form id="form1">
    <div class="panel panel-default" >
        <div class="panel-heading">
            Điều kiện lọc
        </div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle">Từ khóa</th>
                    <td class="formValue">
                        <input type="text" id="txtINPUTCODE" class="form-control" placeholder="Phiên âm vật tư/Tên" />
                    </td>
                    <th class="formTitle">Thời gian thực hiện</th>
                    <td class="formValue">
                        <input id="txtStartTime" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.AddDays(-31).ToString("dd/MM/yyyy 00:00:00")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy HH:mm:ss' })" />
                    </td>
                    <th class="formTitle">Đến</th>
                    <td class="formValue">
                        <input id="txtEndTime" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy HH:mm:ss' })" />
                    </td>
                    <td class="formValue">
                        <input type="button" id="btn_search" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px;margin-left:30%;" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel" >
        <table id="gridYPInfoList"></table>
        <div id="gridPager" rel="form1"></div>
    </div>
</form>

<script>
    $(function () {
        gridYPInfoList();
    });

    function gridYPInfoList() {
        var $gridYpInfoList = $("#gridYPInfoList");
        $gridYpInfoList.dataGrid({
            url: "/ProductManage/PriceAdjustment/SelectAdjustPriceHistoryList",
            postData: getSearchPostData(),
            height: $(window).height() - document.getElementById('gridYPInfoList').offsetTop - 70,
            colModel: [
                { label: 'Loại', name: 'lbmc', width: 80, align: 'left' },
                { label: 'Tên vật tư', name: 'wzmc', width: 120, align: 'left' },
                { label: 'Quy cách', name: 'gg', width: 100, align: 'left' },
                {
                    label: 'Giá bán lẻ cũ', name: 'ylsj', width: 70, align: 'right',
                    formatter: function (val) {
                        return val.toFixed(4);
                    }
                },
                {
                    label: 'Giá bán lẻ mới', name: 'lsj', width: 70, align: 'right',
                    formatter: function (val) {
                        return val.toFixed(4);
                    }
                },
                { label: 'Đơn vị định giá', name: 'dwmc', width: 70, align: 'center' },
                { label: 'Hệ số chuyển đổi', name: 'zhyz', width: 70, align: 'center' },
                { label: 'Văn bản điều chỉnh', name: 'tzwj', width: 80, align: 'left' },
                { label: 'Nhà sản xuất', name: 'supplierName', width: 120, align: 'left' },
                { label: 'Người gửi', name: 'CreatorCode', width: 100, align: 'left' },
                { label: 'Thời gian thực hiện', name: 'zxsj', width: 100, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i', newformat: 'Y-m-d H:i' } },
                { label: 'productId', name: 'productId', hidden: true },
                { label: 'wztjId', name: 'wztjId', hidden: true }
            ],
            multiselect: false,
            pager: "#gridPager",
            sortname: 'zxsj desc',
            viewrecords: true
        });

        $("#btn_search").click(function () {
            if ($("#txtStartDate").val() > $("#txtEndDate").val()) {
                $.modalAlert("Ngày bắt đầu muộn hơn ngày kết thúc", 'warning');
                return;
            }

            $gridYpInfoList.jqGrid('setGridParam', {
                postData: getSearchPostData()
            }).trigger('reloadGrid');
        });
    }
    //Điều kiện tra cứu
    function getSearchPostData() {
        var inputCode = $("#txtINPUTCODE").val();
        var startTime = $("#txtStartTime").val();
        var endTime = $("#txtEndTime").val();
        return { inputCode: inputCode, startTime: startTime, endTime: endTime };
    };
</script>




@using Newtouch.Herp.Infrastructure.Enum
@{
    ViewBag.Title = "Thêm mới / Sửa";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<style>
    .formTitle span {
        color: red;
    }

    .tab-content #basicInfo table tr td {
        border: 0;
    }

    #myTab li {
        padding: 2px 2px 0 2px;
    }

    #myTab a {
        padding: 8px;
        width: 65px;
        text-align: center;
    }

    #contactsGridPanel {
        margin-left: 10px;
    }
</style>
<form id="form1">
    <div class="container" style="padding:0;">
        <ul class="nav nav-tabs" role="tablist" id="myTab">
            <li role="presentation"><a href="#basicInfo" role="tab" data-toggle="tab" style="width: 80px;">Thông tin cơ bản</a></li>
            <li role="presentation"><a href="#contacts" role="tab" data-toggle="tab" style="width: 70px;">Người liên hệ</a></li>
        </ul>
        <div class="tab-content" style="margin-top:10px;padding-right:10px;">
            <div id="basicInfo" role="tabpanel" class="tab-pane fade in active">
                <table class="form">
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Tên：</th>
                        <td class="formValue">
                            <input id="name" name="name" type="text" class="form-control required" placeholder="Vui lòng nhập tên" />
                        </td>
                        <th class="formTitle"><span class="required">*</span>Viết tắt đầu：</th>
                        <td class="formValue">
                            <input id="py" name="py" type="text" class="form-control" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Mã bưu điện：</th>
                        <td class="formValue">
                            <input id="zipCode" name="zipCode" type="text" class="form-control" />
                        </td>
                        <th class="formTitle">Điện thoại công ty：</th>
                        <td class="formValue">
                            <input id="tel" name="tel" type="text" class="form-control" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Fax：</th>
                        <td class="formValue">
                            <input id="fax" name="fax" type="text" class="form-control" />
                        </td>
                        <th class="formTitle">Địa chỉ：</th>
                        <td class="formValue">
                            <input id="address" name="address" type="text" class="form-control" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Ngân hàng：</th>
                        <td class="formValue">
                            <input id="khh" name="khh" type="text" class="form-control" />
                        </td>
                        <th class="formTitle">Số tài khoản ngân hàng：</th>
                        <td class="formValue">
                            <input id="khhzh" name="khhzh" type="text" class="form-control" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Mã số thuế：</th>
                        <td class="formValue">
                            <input id="sh" name="sh" type="text" class="form-control" />
                        </td>
                        <th class="formTitle">Chu kỳ thanh toán：</th>
                        <td class="formValue">
                            <input id="jszq" name="jszq" type="text" class="form-control" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Loại công ty：</th>
                        <td class="formValue">
                            @Html.DropDownList("supplierType", EnumSupplierType.Distributor.ToDescSelectList(), new { @class = "form-control form-an" })
                        </td>
                        <th class="formTitle" style="height: 35px;">Tùy chọn：</th>
                        <td class="formValue" style="padding-top: 1px;" colspan="3">
                            <div class="ckbox">
                                <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Hiệu lực</label>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
            <div id="contacts" role="tabpanel" class="tab-pane fade in">
                <table class="form">
                    <tr>
                        <th class="formTitle"><span class="required">*</span>Họ tên：</th>
                        <td class="formValue">
                            <input id="contactName" name="contactName" type="text" class="form-control required" placeholder="Vui lòng nhập tên" />
                            <input type="hidden" id="hdId" value="" />
                        </td>
                        <th class="formTitle"><span class="required">*</span>Di động：</th>
                        <td class="formValue">
                            <input id="telphone" name="telphone" type="text" class="form-control required" />
                        </td>
                        <th class="formTitle">Chức vụ：</th>
                        <td class="formValue">
                            <input id="duties" name="duties" type="text" class="form-control" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Điện thoại cố định：</th>
                        <td class="formValue">
                            <input id="phone" name="phone" type="text" class="form-control" />
                        </td>
                        <th class="formTitle">Email：</th>
                        <td class="formValue">
                            <input id="email" name="email" type="text" class="form-control" />
                        </td>
                        <td class="formValue" colspan="2">
                            <input type="button" id="btn_clean" class="btn btn-md btn-primary" style="width:50px; margin-left:40px;" value="Xóa trắng" />
                            <input type="button" id="btn_submit" class="btn btn-md btn-primary" style="width:50px; margin-left:10px;" value="Xác nhận" />
                        </td>
                    </tr>
                </table>
                <div id="contactsGridPanel">
                    <table id="gridList"></table>
                </div>
            </div>
        </div>
    </div>
</form>
<script lang="javascript">
    var keyWord = $.request("keyValue");
    var $gridList = $("#gridList");
    $(function () {
        initControl();
        if (!!keyWord) {
            $.najax({
                url: "/SupplierManage/Supplier/GetFormJson",
                data: { keyWord: keyWord },
                dataType: "json",
                success: function (data) {
                    $("#form1").formSerialize(data);
                    if (data.supplierType == null || data.supplierType == undefined) {
                        $("#supplierType").val(@((int)EnumSupplierType.Distributor));
                    }
                }
            });
        }
    });

    //初始化
    function initControl() {
        $('#myTab a:first').tab('show');
        $('#name').keyup(function () {
            $('#py').val($(this).toShouPin());
        });
        $("#btn_submit").click(function () {
            SubmitContact();
        });
        $("#btn_clean").click(function () {
            cleanContactInput();
        });
        GetContacts();
    }

    //clean contacts input
    function cleanContactInput() {
        $("#contactName").val("");
        $("#hdId").val("");
        $("#telphone").val("");
        $("#duties").val("");
        $("#phone").val("");
        $("#email").val("");
    }

    //get contacts grid list
    function GetContacts() {
        $gridList.dataGrid({
            url: "/SupplierManage/Supplier/GetSupplierContactsGridJson",
            height: $(window).height() - 170,
            postData: { keyWord: keyWord },
            colModel: [
                { label: "Id", name: "Id", hidden: true, key: true },
                { label: 'OrganizeId', name: 'OrganizeId', hidden: true },
                { label: 'Họ tên', name: 'contactName', width: 80, align: 'left' },
                { label: 'Chức vụ', name: 'duties', width: 100, align: 'left' },
                { label: 'Điện thoại cố định', name: 'phone', width: 120, align: 'left' },
                { label: 'Di động', name: 'telphone', width: 120, align: 'left' },
                { label: 'Email', name: 'email', width: 150, align: 'left' },
                {
                    label: 'Thao tác', name: 'thaotac', width: 100, align: 'center', formatter: function (cellvalue, options, rowObject) {
                        return "<input type=\"button\" class=\"btn btn-default btn-md\" value=\"Xóa\" onclick=\"DeleteContacts('" + rowObject.Id + "');\" />";
                    }
                }
            ],
            multiselect: false,
            rownumbers: false
        });
    }

    //load contacts grid data
    function LoadContacts() {
        $gridList.jqGrid("clearGridData"); //清除明细的grid
        $gridList.jqGrid('setGridParam',
            {
                postData: { keyWord: keyWord }
            }).trigger('reloadGrid');
        cleanContactInput();
    }

    //update contacts
    function btn_edit() {
        $("#contactName").val($("#gridList").jqGridRowValue().contactName);
        $("#hdId").val($("#gridList").jqGridRowValue().Id);
        $("#telphone").val($("#gridList").jqGridRowValue().telphone);
        $("#duties").val($("#gridList").jqGridRowValue().duties);
        $("#phone").val($("#gridList").jqGridRowValue().phone);
        $("#email").val($("#gridList").jqGridRowValue().email);
    }

    //delete contacts
    function DeleteContacts(p) {
        $.najax({
            type: "Post",
            url: "/SupplierManage/Supplier/DeleteContacts",
            data: { contactsId: p },
            dataType: "json",
            success: function (data) {
                LoadContacts();
            }
        });
    }

    //add contacts
    function SubmitContact() {
        if (keyWord === "") {
            $.modalAlert("Vui lòng lưu thông tin cơ bản của nhà cung cấp trước khi sửa thông tin người liên hệ", 'warning');
            return false;
        }
        if ($("#contactName").val() === "") {
            $.modalAlert("Họ tên người liên hệ là bắt buộc", 'warning');
            return false;
        }
        if ($("#telphone").val() === "") {
            $.modalAlert("Số di động của người liên hệ là bắt buộc", 'warning');
            return false;
        }
        var param = {
            contactName: $("#contactName").val(),
            telphone: $("#telphone").val(),
            duties: $("#duties").val(),
            phone: $("#phone").val(),
            email: $("#email").val(),
            keyWord: keyWord,
            id: $("#hdId").val()
        };
        $.najax({
            type: "Post",
            url: "/SupplierManage/Supplier/SubmitContacts",
            data: param,
            dataType: "json",
            success: function (data) {
                LoadContacts();
            }
        });
        return true;
    }

    //提交
    function AcceptClick(callback) {
        if (!DataValidate()) {
            return;
        }
        var postData = $("#form1").formSerialize();
        $.submitForm({
            url: "/SupplierManage/Supplier/SubmitForm?keyWord=" + keyWord,
            param: postData,
            success: function () {
                $.modalClose();
                callback();
            }
        });
    }

    //数据效验
    function DataValidate() {
        if ($("#name").val() === "") {
            $.modalAlert("Tên doanh nghiệp là bắt buộc", 'warning');
            return false;
        }
        if ($("#py").val() === "") {
            $.modalAlert("Mã viết tắt đầu là bắt buộc", 'warning');
            return false;
        }
        return true;
    }
</script>

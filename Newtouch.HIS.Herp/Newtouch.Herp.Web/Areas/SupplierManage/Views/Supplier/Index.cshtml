@using Newtouch.Herp.Infrastructure.Enum;
@using NewtouchHIS.Lib.Base.Extension;
@{
    ViewBag.Title = "Bảo trì nhà cung cấp";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a class="btn btn-primary" onclick="$.reload()"><span class="fa fa-refresh"></span></a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Thêm mới</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-trash-o"></i>Xóa</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Tên" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList"></table>
    <div id="gridPager"></div>
</div>
<script lang="javascript">
    $(function () {
        gridList();
    });

    //get data
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/SupplierManage/Supplier/GetSupplierGridJson",
            height: $(window).height() - 120,
            colModel: [
                { label: "Khóa chính", name: "Id", hidden: true, key: true },
                {
                    label: "Loại công ty", name: "supplierType", width: 70, align: "center",
                    formatter: function (cellvalue) {
                        switch (cellvalue) {
                            case @((int)EnumSupplierType.Other):
                                return '@EnumSupplierType.Other.GetDescription()';
                            case @((int)EnumSupplierType.Distributor):
                                return '@EnumSupplierType.Distributor.GetDescription()';
                            case @((int)EnumSupplierType.Producer):
                                return '@EnumSupplierType.Producer.GetDescription()';
                            default:
                                return "";
                        }
                    }
                },
                { label: 'Tên nhà cung cấp', name: 'name', width: 150, align: 'left' },
                { label: 'Địa chỉ', name: 'address', width: 190, align: 'left' },
                { label: 'Mã bưu điện', name: 'zipCode', width: 80, align: 'left' },
                { label: 'Điện thoại', name: 'tel', width: 80, align: 'left' },
                { label: 'Fax', name: 'fax', width: 80, align: 'left' },
                { label: 'Ngân hàng', name: 'khh', width: 110, align: 'left' },
                { label: 'Số tài khoản ngân hàng', name: 'khhzh', width: 100, align: 'left' },
                {
                    label: "Hiệu lực", name: "zt", width: 50, align: "center",
                    formatter: function (cellvalue) { return cellvalue === "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; }
                },
                { label: 'Người tạo', name: 'CreatorCode', width: 70, align: 'left' },
                { label: 'Ngày tạo', name: 'CreateTime', width: 110, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i', newformat: 'Y-m-d H:i' } },
                { label: 'Người sửa cuối', name: 'LastModifierCode', hidden: true },
                { label: 'Ngày sửa cuối', name: 'LastModifyTime', hidden: true },
                { label: 'OrganizeId', name: 'OrganizeId', hidden: true }
            ],
            pager: "#gridPager",
            sortname: 'name',
            viewrecords: true
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam',
                {
                    postData: { keyWord: $("#txt_keyword").val() }
                }).trigger('reloadGrid');
        });
    }

    //Kích hoạt sự kiện truy vấn khi nhấn Enter
    $("#txt_keyword").keydownEnterEvent(function() {
        $("#btn_search").trigger("click");
    });

    //Thêm mới
    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "Thêm nhà cung cấp mới",
            url: "/SupplierManage/Supplier/Form",
            width: "750px",
            height: "440px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function() {
                    $('#gridList').jqGrid("clearGridData"); //Xóa chi tiết củagrid
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                });
            }
        });
    }

    //Sửa
    function btn_edit() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        $.modalOpen({
            id: "Form",
            title: "Sửa nhà cung cấp",
            url: "/SupplierManage/Supplier/Form?keyValue=" + keyValue,
            width: "750px",
            height: "440px",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function() {
                    $('#gridList').jqGrid("clearGridData"); //Xóa chi tiết củagrid
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                });
            }
        });
    }

    //Xóa
    function btn_delete() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        $.deleteForm({
            url: "/SupplierManage/Supplier/DeleteForm",
            param: { keyValue: keyValue },
            success: function () {
                $('#gridList').jqGrid("clearGridData"); //Xóa chi tiết củagrid
                $("#gridList").resetSelection();
                $("#gridList").trigger("reloadGrid");
            }
        });
    }

</script>


@using Newtouch.Infrastructure
@{
    ViewBag.Title = "Lấy chi tiết mua hàng";
    Layout = "~/Views/Shared/_Index.cshtml";

}
<script src="~/Content/js/index.js"></script>

<form id="form1">
    <div class="panel panel-default" style="margin-bottom:10px;">
        <div class="panel-heading">Lấy chi tiết mua hàng</div>
        <table class="form">
            <tr>
                <th class="formTitle">Thời gian tra cứu:</th>
                <td class="formValue" style="width:10%">
                    <input id="kssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
                           onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
                           value="@DateTime.Now.ToString("yyyy-MM-01")" />
                </td>
                <td class="formValue" style="width:8px;float:left;">-</td>
                <td class="formValue" style="width:10%;float:left;">
                    <input id="jssj" type="text" class="form-control input-wdatepicker formClearIgnore" style="width:90px;float:left;"
                           onclick="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
                           onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })"
                           value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </td>
                <th class="formTitle">Loại đơn hàng:</th>
                <td class="formValue">
                    <select id="ddlx" name="ddlx" class="form-control required" data-EnumType="EnumCGDLX">
                    </select>
                </td>
                <th class="formTitle">Hình thức mua hàng:</th>
                <td class="formValue">
                    <select id="cgfs" name="cgfs" class="form-control required" data-EnumType="EnumCGFS">
                    </select>
                </td>
                <th class="formTitle"><span class="required">*</span>Bên lập chứng từ:</th>
                <td class="formValue">
                    <select id="djtxf" name="djtxf" class="form-control required" data-EnumType="EnumDJTXF">
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle ">Tên doanh nghiệp:</th>
                <td class="formValue" colspan="2">
                    <input type="text" id="qy" name="qy" class="form-control" placeholder="Vui lòng chọn doanh nghiệp" autocomplete="off" style="width:90%" />
                    <input type="hidden" id="qybm" />
                </td>

                <th class="formTitle">Loại mua hàng:</th>
                <td class="formValue">
                    <select id="cglx" name="cglx" class="form-control" data-EnumType="EnumCGLX">
                    </select>
                </td>
                <th class="formTitle">Số phiếu chi tiết mua hàng:</th>
                <td class="formValue">
                    <input id="ddmxbh" class="form-control" placeholder="Số phiếu chi tiết mua hàng" />
                </td>
                <th class="formTitle">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary" value="Tra cứu" />
                </th>
                <td></td>
            </tr>
        </table>
    </div>
    <div id="dv-detail">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>

<script type="text/javascript">

    $(function () {
        InitFloat();

        //gridList();
    });


    //Khởi tạo lớp nổi
    function InitFloat() {
        //Nhà cung cấp vật tư
        $("#qy").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            url: '/Storage/GetSupplierList',
            height: 300,
            width: 400,
            caption: "Nhà cung cấp vật tư",
            ajaxparameters: function () {
                return "key=" + $("#qy").val();
            },
            colModel: [
                { label: 'Id', name: 'Id', hidden: true },
                { label: 'Mã', name: 'py', widthratio: 45 },
                { label: 'Nhà cung cấp', name: 'name', widthratio: 55 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#qybm").val($thistr.attr('data-py'));
                $("#qy").val($thistr.attr('data-name'));
            }
        });
    }

    function getPostData() {
        return {
            QSRQ: $("#kssj").val().replace(/\-/g, ""),
            JZRQ: $("#jssj").val().replace(/\-/g, ""),
            QYBM: $("#qybm").val() ,
            DDLX: $("#ddlx").val() ,
            CGLX: $("#cglx").val() ,
            DJTXF: $("#djtxf").val() ,
            DDMXBH: $("#ddmxbh").val(),
            DDBH: '',
            CGFS: $("#cgfs").val(),
            DDMXBHCXTJ :'',
        };
    }

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/PurchaseManage/Purchase/GetGridJsonYY151",
            height: $(window).height() - 200,
            postData: getPostData(),
            colModel: [
                {
                    label: 'Loại đơn hàng', name: 'DDLX', width: 100, align: 'left', formatter: function (val) {
                        return $.enum.getDescByValue("EnumCGDLX", val);
                    }
                },
                {
                    label: 'Bên lập chứng từ', name: 'DJTXF', width: 80, align: 'left', formatter: function (val) {
                        return $.enum.getDescByValue("EnumDJTXF", val);
                    }
                },
                { label: 'Số chi tiết đơn mua hàng', name: 'DDMXBH', width: 150, align: 'left' },
                { label: 'Số đơn mua hàng', name: 'DDBH', width: 150, align: 'left' },
                { label: 'Số thứ tự', name: 'SXH', width: 80, align: 'left' },
                { label: 'Số phiếu kế hoạch bệnh viện', name: 'YYJHDH', width: 80, align: 'left' },
                { label: 'Mã doanh nghiệp', name: 'QYBM', width: 120, align: 'left' },
                { label: 'Mã điểm giao hàng', name: 'PSDBM', width: 80, align: 'left' },
                {
                    label: 'Loại mua hàng', name: 'CGLX', width: 80, align: 'left', formatter: function (val) {
                        return $.enum.getDescByValue("EnumCGLX", val);
                    }
                },
                { label: 'Mã thống nhất vật tư tiêu hao', name: 'HCTBDM', width: 80, align: 'left' },
                { label: 'Mã chi tiết vật tư tiêu hao', name: 'HCXFDM', width: 80, align: 'left' },
                { label: 'Mã nội bộ bệnh viện', name: 'YYBDDM', width: 80, align: 'left' },
                { label: 'Tên hàng', name: 'PM', width: 80, align: 'left' },
                { label: 'Quy cách', name: 'GG', width: 80, align: 'left' },
                { label: 'Mẫu mã', name: 'XH', width: 80, align: 'left' },
                { label: 'Mô tả quy cách mẫu mã', name: 'GGXHSM', width: 80, align: 'left' },
                { label: 'Đơn vị', name: 'DW', width: 80, align: 'left' },
                { label: 'Tên doanh nghiệp sản xuất', name: 'SCQY', width: 80, align: 'left' },
                { label: 'Quy cách mẫu mã mua hàng', name: 'CGGGXH', width: 80, align: 'left' },
                { label: 'Mô tả giao hàng', name: 'PSSM', width: 80, align: 'left' },
                { label: 'Số lượng mua hàng', name: 'CGSL', width: 80, align: 'left' },
                { label: 'Đơn giá mua hàng', name: 'CGDJ', width: 80, align: 'left' },
                {
                    label: 'Có gấp không', name: 'SFJJ', width: 80, align: 'left', formatter: function (val) {
                        switch (val) {
                            case "0":
                                return "Không cần gấp"
                                break;
                            case "1":
                                return "Cần gấp"
                                break;
                            default:
                                break;
                        }
                    }
                },
                {
                    label: 'Yêu cầu giao hàng', name: 'PSYQ', width: 80, align: 'left', formatter: function (val) {
                        return $.enum.getDescByValue("EnumPSYQ", val);
                    }
                 },
                { label: 'Thông tin vị trí kho', name: 'CWXX', width: 80, align: 'left' },
                {
                    label: 'Dấu hiệu giao hàng nhiều lần', name: 'DCPSBS', width: 80, align: 'left', formatter: function (val) {
                        switch (val) {
                            case "0":
                                return "Không cho phép"
                                break;
                            case "1":
                                return "Cho phép"
                                break;
                            default:
                                break;
                        }
                    }
                },
                { label: 'Mô tả ghi chú', name: 'BZSM', width: 80, align: 'left' },
                {
                    label: 'Hình thức mua hàng', name: 'CGFS', width: 80, align: 'left', formatter: function (val) {
                        return $.enum.getDescByValue("EnumCGFS", val);
                    }
                 },
                { label: 'Mã hệ thống', name: 'XTBM', width: 80, align: 'left' },
                {
                    label: 'Có bao gồm dịch vụ đi kèm không', name: 'SFHBSFW', width: 80, align: 'left', formatter: function (val) {
                        return $.enum.getDescByValue("EnumSFHBSFW", val);
                    }
                },
            ],
            multiselect: false,
            //pager: "#gridPager",
            //sortname: '',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                //btn_selectrow(rowid);
            }
        });
        $("#btn_search").click(function () {
            $('#gridList').jqGrid("clearGridData");
            $gridList.jqGrid('setGridParam', {
                postData: getPostData(),
            }).trigger('reloadGrid');
        });
    }

    //Lấy chi tiết
    $('#btn_search').click(function () {
        if ($("#djtxf").val() == "" || $("#djtxf").val() == null) {
            $.modalAlert("Vui lòng chọn bên lập chứng từ", 'warning');
            return ;
        }
        var kssj = new Date($("#kssj").val());
        var jssj = new Date($("#jssj").val());
        if (getDaysBetween(kssj,jssj) > 30) {

            $.modalAlert("Ngày không được vượt quá 30 Ngày", 'warning');
            return;
        }
        gridList();
    });
</script>




@{
    ViewBag.Title = "Quản lý mua sắm";
    Layout = "~/Views/Shared/_Index.cshtml";
}


<!DOCTYPE html>
<style>
    .showbotton {
        display: none;
        position: fixed;
        bottom: 5px;
        right: 0;
        z-index: 9999;
        background-color: #ccc;
        width: 50px;
        height: 44px;
        filter: alpha(Opacity=90);
        -moz-opacity: 0.9;
        opacity: 0.9;
        cursor: pointer;
        border-radius: 100px 0 0 100px;
    }

    #TabGrid {
        width: 100%;
        position: fixed;
        bottom: 10px;
        right: 0;
        z-index: 8888;
        background-color: #253443;
        filter: alpha(Opacity=92);
        -moz-opacity: 0.92;
        opacity: 0.92;
        box-shadow: 0px 2px 10px #909090;
    }

        #TabGrid > * {
            filter: alpha(Opacity=92);
            -moz-opacity: 0.92;
            opacity: 0.92;
        }
</style>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>PrepareMedicineApply</title>
</head>
<body>

    <form>
        <div class="panel panel-default">
            <table class="form">
                <tr>

                    <th class="formTitle">Thời gian đơn hàng:</th>
                    <td class="formValue" colspan="3">
                        <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; float:left;" value="@DateTime.Now.AddMonths(-6).ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                        <span style="margin-left:1%;float:left">—</span>
                        <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:43%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                    </td>
                    <td class="formValue title">
                        <input type="button" id="btn_search" class="btn btn-primary" style="width:36%;margin-left: 10%;" value="Tra cứu" />
                    </td>

                </tr>

            </table>
        </div>
        <div class="gridPanel">
            <table id="gridList"></table>
            <div id="gridPager"></div>
        </div>
        <div id="TabGrid">
            <ul class="nav nav-tabs navb-bg" role="tablist" id="myTab">
                <li role="presentation" class="active">
                    <a href="#dv_djmx" id="linkSearch" role="tab" data-toggle="tab">Chi tiết chứng từ</a>
                </li>
                <li style="float:right">
                    <span class="hiding glyphicon glyphicon-chevron-right btn-lg"></span>
                </li>
            </ul>
            <div id="dv_djmx" style="">
                <table id="gridDJMXInfo"></table>
            </div>
        </div>
        <div class="showbotton">
            <span class="glyphicon glyphicon-chevron-left btn-lg"></span>
        </div>
        <div class="panel panel-default">
            <input type="button" id="btn_delete" class="btn btn-danger" style="width:7%;display:inline-block;float:right;margin-left:16px;margin-top:30px;" value="Hủy" />
            @*<input type="button" id="btn_receive" class="btn btn-info" style="width:7%;display:inline-block;float:right;margin-left:20px;margin-top:30px;" value="Nghiệm thu" />*@
            <input type="button" id="btn_submit" class="btn btn-default" style="width:7%;display:inline-block;float:right;margin-left:20px;margin-top:30px;" value="Truyền báo" />
            <input type="button" id="btn_edit" class="btn btn-default" style="width:7%;display:inline-block;float:right;margin-left:20px;margin-top:30px;" value="Sửa" />
            <input type="button" id="btn_add" class="btn btn-primary" style="width:7%;display:inline-block;float:right;margin-left:20px;margin-top:30px;" value="Tạo mới" />

            <input type="button" id="btn_writeTest" class="btn btn-info" style="width:7%;display:none;float:right;margin-left:20px;margin-top:30px;" value="Kiểm thử lập báo cáo" />
            <input type="button" id="btn_sureTest" class="btn btn-info" style="width:7%;display:none;float:right;margin-left:20px;margin-top:30px;" value="Kiểm thử xác nhận" />

        </div>
    </form>
</body>
</html>


<script>

    var reportServerHOST = '@(ViewBag.ReportServerHOST)';
    var orgId = '@(ViewBag.OrgId)';
    $(function () {
        initControl();
        gridList();
        //Điều khiển ẩn/hiện hộp tìm kiếm
        $(".hiding,.rows,#dv_search,.toolbar").click(function () {
            TabGridHide();
        });
        $(".showbotton").click(function () {
            $(".showbotton").animate({ width: 'hide' }, "fast", function () {
                $("#TabGrid").animate({ left: '0px' }, "slow");
            });
        });
        TabGridHide();
    })

    //Ẩn hộp tìm kiếm và hiển thị mũi tên
    function TabGridHide() {
        var tabGridwith = $("#TabGrid").width() + 200;
        if ($(".showbotton").is(":hidden")) {
            $("#TabGrid").animate({ left: tabGridwith }, "slow", function () {
                $(".showbotton").animate({ width: 'show' }, "fast");
            });
        }
    }

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/PurchaseManage/Purchase/GetPurchaseGridJson",
            height: $(window).height() - 200,
            postData: {  kssj: $("#kssj").val(), jssj: $("#jssj").val(),ddzt:0 },
            colModel: [

                { label: 'cgId', name: 'cgId', hidden: true, frozen: true },
                { label: 'Thời gian đơn hàng', name: 'ddsj', width: 120, align: 'left', frozen: true },
                {
                    label: 'Điểm giao hàng', name: 'psdbm', width: 120, align: 'left', formatter: function (cellvalue) {
                        return "Bệnh viện Đa khoa Minh Đức";
                    }
                },
                {
                    label: 'Loại đơn hàng', name: 'ddlx', width: 120, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 1) return 'Đơn mua sắm tự thực hiện của bệnh viện';
                        else if (cellvalue == 2) return 'Đơn mua sắm kho thuốc ủy thác';
                        else return '';
                    }
                },
                { label: 'Số đơn hàng', name: 'ddbh', width: 120, align: 'left' },
                { label: 'Số kế hoạch của bệnh viện', name: 'yyjhdh', width: 120, align: 'left' },
                { label: 'Ngày giao hàng muộn nhất', name: 'zwdhrq', width: 120, align: 'left' },
                {
                    label: 'Trạng thái đơn hàng', name: 'ddzt', width: 120, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 1) return 'Đã lưu';
                        else if (cellvalue == 2) return 'Đã truyền báo';
                        else if (cellvalue == 3) return 'Đã nghiệm thu';
                        else return '';
                    }
                },
                {
                    label: 'Phương thức mua sắm', name: 'cgfs', width: 120, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 1) return 'Mua sắm ngoài hệ thống';
                        else if (cellvalue == 2) return 'Mua sắm theo hệ thống';
                        else return '';
                    }
                },
                { label: 'Mã hệ thống', name: 'xtbm', width: 120, align: 'left' },
                {
                    label: 'Có kèm dịch vụ đi kèm không', name: 'cgfs', width: 120, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 0) return 'Không';
                        else if (cellvalue == 1) return 'Có';
                        else return '';
                    }
                },
                { label: 'Số dòng chi tiết', name: 'jls', width: 120, align: 'left' },
                //{
                //    label: "Thao tác", name: "", align: "center", width: 150,
                //    formatter: function (cellvalue, options, rowobject) {
                //        return '<input type="button" id="btn_rpt" onclick="rptdjmx(\'' + rowobject.Id + '\')" class="btn btn-info" style="width:100px;display:inline-block;"  value="In chi tiết chứng từ"/>'
                //    }
                //},
                { label: 'yfbm', name: 'yfbm', hidden: true },
                { label: 'bqbm', name: 'bqbm', hidden: true },

            ],

            multiselect: true,

            pager: "#gridPager",
            sortname: 'CreateTime',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                btn_selectrow(rowid);
            }
        });
        $("#btn_search").click(function () {
            $('#gridDJMXInfo').jqGrid("clearGridData");
            $gridList.jqGrid('setGridParam', {
                postData: {  kssj: $("#kssj").val(), jssj: $("#jssj").val() },
            }).trigger('reloadGrid');
        });
    }


    //Sự kiện phím Enter
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    //Sự kiện nhấp chuột
    function btn_selectrow(rowId) {
        $('#gridDJMXInfo').jqGrid("clearGridData");//Mỗi lần nhấp chuột,Xóa chi tiết trước sau đó tải lại tất cả chi tiết của các dòng đã chọn
        $.najax({
            type: "Get",
            url: "/PurchaseManage/Purchase/QueryPurchaseDetailbyId",
            data: { cgId: $("#gridList").jqGrid('getRowData', rowId).cgId },
            dataType: "json",
            success: function (ajaxresp) {
                if (ajaxresp !== null) {
                    $('#gridDJMXInfo').newtouchLocalDataGrid(null, ajaxresp);
                }
                $(".showbotton").click().trigger("click");
            }
        });
    }
    //Chi tiết chứng từ
    $('#gridDJMXInfo').newtouchLocalDataGrid({
        height: $(window).height() - 200,
        unwritten: false,
        sortable: false,
        colModel: [
            { label: 'Số thứ tự', name: 'sxh', width: 60, align: 'left' },
            { label: 'Tên vật tư', name: 'productmc', width: 80, align: 'left' },
            { label: 'Loại mua sắm', name: 'cglxmc', width: 80, align: 'left' },
            { label: 'Mã thống nhất vật tư tiêu hao', name: 'hctbdm', width: 80, align: 'left' },
            { label: 'Mã phân loại vật tư tiêu hao', name: 'hcxfdm', width: 80, align: 'left' },
            { label: 'Mã nội bộ bệnh viện', name: 'yybddm', width: 80, align: 'left' },
            { label: 'Quy cách mẫu mã mua sắm', name: 'cgggxh', width: 80, align: 'left' },
            { label: 'Giải thích giao hàng', name: 'pssm', width: 80, align: 'left' },
            { label: 'Số lượng mua sắm', name: 'cgsl', width: 80, align: 'left' },
            { label: 'Đơn giá mua sắm', name: 'cgdj', width: 80, align: 'left' },
            { label: 'Mã doanh nghiệp', name: 'qybm', width: 80, align: 'left' },
            { label: 'Có gấp không', name: 'sfjjmc', width: 80, align: 'left' },
            { label: 'Yêu cầu giao hàng', name: 'psyqmc', width: 80, align: 'left' },
            { label: 'Dấu hiệu giao hàng nhiều lần', name: 'dcpsbsmc', width: 80, align: 'left' },
            { label: 'Thông tin vị trí kho', name: 'cwxx', width: 80, align: 'left' },
            { label: 'Giải thích ghi chú', name: 'bzsm', width: 80, align: 'left' },
        ]
    });

    function initControl() {

    }

    //Tạo mới
    $('#btn_add').click(function () {
        $.modalOpen({
            id: "Form",
            title: "Vật tư tiêu hao mua sắm",
            url: "/PurchaseManage/Purchase/Form",
            width: "98%",
            height: "95%",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                    $.modalClose("Form");
                    $('#btn_search').trigger('click');
                });
            }
        });
    });

    //Sửa
    $('#btn_edit').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');

        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn chứng từ cần sửa", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("Chỉ được chọn một chứng từ để sửa", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        if (rowData.ddzt != "Đã lưu") {
            $.modalAlert("Chứng từ đã chọn không ở trạng thái đã lưu, không thể sửa", 'warning');
            return;
        }
        $.modalOpen({
            id: "Form",
            title: "Vật tư tiêu hao mua sắm",
            url: "/PurchaseManage/Purchase/Form?keyValue=" + rowData.cgId,
            width: "95%",
            height: "95%",
            callBack: function (iframeId) {
                $.currentWindow(iframeId).AcceptClick(function () {
                    $("#gridList").resetSelection();
                    $("#gridList").trigger("reloadGrid");
                    $.modalClose("Form");
                    $('#btn_search').trigger('click');
                });
            }
        });
    });

    //Truyền báo
    $('#btn_submit').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn chứng từ cần truyền báo", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("Chỉ được chọn một chứng từ để truyền báo", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        $.najax({
            type: "POST",
            url: "/PurchaseManage/Purchase/PurchaseUpload",
            data: { cgId: rowData.cgId, ddzt: 2 },
            dataType: "json",
            success: function (res) {
                if (res.state == "success") {
                    $.modalMsg("Truyền báo chứng từ thành công!", 'success');
                    //$('#gridDJMXInfo').jqGrid("clearGridData");

                    $('#btn_search').trigger('click');
                } else {
                    $.modalMsg("Truyền báo chứng từ thất bại: " + res.message, 'warning');
                }
            }
        });
    });

    //Nghiệm thu
    $('#btn_receive').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn chứng từ cần nghiệm thu", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("Chỉ được chọn một chứng từ để nghiệm thu", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        if (rowData.ddzt != "Đã truyền báo") {
            $.modalAlert("Chứng từ đã chọn không ở trạng thái đã truyền báo, không thể nghiệm thu", 'warning');
            return;
        }
        $.najax({
            type: "POST",
            url: "/PurchaseManage/Purchase/PurchaseStateUpdate",
            data: { cgId: rowData.cgId ,ddzt:3},
            dataType: "json",
            success: function (res) {
                if (res.state == "success") {
                    $('#btn_search').trigger('click');
                    $.modalAlert("Nghiệm thu chứng từ thành công!", 'success');
                } else {
                    $.modalAlert("Nghiệm thu chứng từ thất bại: " + res.message, 'warning');
                }
            }
        });
    });

    //Hủy
    $('#btn_delete').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn chứng từ cần hủy", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("Chỉ được chọn một chứng từ để hủy", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        if (rowData.ddzt != "Đã lưu") {
            $.modalAlert("Vui lòng chọn chứng từ đã lưu để hủy", 'warning');
            return;
        }
        $.najax({
            type: "POST",
            url: "/PurchaseManage/Purchase/PurchaseDelete",
            data: { cgId: rowData.cgId },
            dataType: "json",
            success: function (res) {
                if (res) {
                    $('#btn_search').trigger('click');
                    $.modalMsg(res.message, 'success');
                }
            }
        });
    });


    //Kiểm thử lập báo cáo
    $('#btn_writeTest').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn chứng từ cần nộp", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("Chỉ được chọn một chứng từ để nộp", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        $.najax({
            type: "POST",
            url: "/PurchaseManage/Purchase/PurchaseUploadWriteTest",
            data: { cgId: rowData.cgId, ddzt: 2 },
            dataType: "json",
            success: function (res) {
                if (res.state == "success") {
                    $.modalMsg("Nộp chứng từ thành công!", 'success');
                    //$('#gridDJMXInfo').jqGrid("clearGridData");

                    $('#btn_search').trigger('click');
                } else {
                    $.modalMsg("Nộp chứng từ thất bại: " + res.message, 'warning');
                }
            }
        });
    });

    //Kiểm thử xác nhận
    $('#btn_sureTest').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn chứng từ cần nộp", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("Chỉ được chọn một chứng từ để nộp", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        $.najax({
            type: "POST",
            url: "/PurchaseManage/Purchase/PurchaseUploadSureTest",
            data: { cgId: rowData.cgId, ddzt: 2 },
            dataType: "json",
            success: function (res) {
                if (res.state == "success") {
                    $.modalMsg("Nộp chứng từ thành công!", 'success');
                    //$('#gridDJMXInfo').jqGrid("clearGridData");

                    $('#btn_search').trigger('click');
                } else {
                    $.modalMsg("Nộp chứng từ thất bại: " + res.message, 'warning');
                }
            }
        });
    });

</script>

<script>
// PER-APP (B) redesign: nut "Sua" chi bat khi co dong duoc chon (trang thai truc quan;
// handler von da chan khi chua chon - day chi la lop vo hieu truc quan).
$(function () {
    try {
        function rdSyncEditState() {
            var sel = $("#gridList").jqGrid("getGridParam", "selrow");
            var arr = $("#gridList").jqGrid("getGridParam", "selarrrow");
            var has = !!sel || (arr && arr.length > 0);
            $("#btn_edit").prop("disabled", !has);
            $("#btn_edit").attr("aria-disabled", has ? "false" : "true");
        }
        $("#gridList").on("jqGridSelectRow jqGridGridComplete jqGridAfterGridComplete", rdSyncEditState);
        rdSyncEditState();
    } catch (e) { /* tang cuong giao dien: khong lam hong trang neu luoi chua khoi tao */ }
});
</script>

        par["sfhbsfw"] = $("#sfhbsfw").val() ? '0' : $("#sfhbsfw").val();//Có kèm dịch vụ đi kèm không
        par["yqbm"] = $("#yqbm").val();//Mã doanh nghiệp dược
        par["jls"] = list.length//Số dòng
        par["yybm"] = "77370296000";//Mã bệnh viện
        par["ddbh"] = " ";//Số đơn hàng Thêm mới:空   Sửa/Thu hồi:Số đơn hàng
        par["yyjhdh"] = "test";//Số kế hoạch của bệnh viện
        par["ddzt"] = "1";//1Đã lưu 2Đã truyền báo 3Đã nghiệm thu
        par["ddsj"] = new Date();//Thời gian đơn hàng
        par["czlx"] = 1;//Loại thao tác 1Thêm mới 3Hủy


        $.najax({
            type: "POST",
            url: "/PurchaseManage/Purchase/SubmitPurchase",
            data: { cgEntity: par, cgmxList: list, keyValue: keyValue},
            dataType: "json",
            success: function (res) {
                if (res) {
                    //newtouch_event_f7();
                    $.modalMsg(res.message, 'success');
                }
            }
        });
    }

    //数值验证
    function Validately(rowData, rowid) {
        if ($("#yq").val() === "" ) {   //去掉左右两端空格
            $.modalMsg("Vui lòng chọn nhà cung cấp", "error", 1000);
            return false;
        }
        if (rowData.ypmc === "") {
            $.modalMsg('Thuốc là bắt buộc', 'error', 1000);
            return false;
        }
        //if (rowData.pc === "") {
        //    $.modalMsg('Lô hàng là bắt buộc', 'error', 1000);
        //    return false;
        //}
        var reg = /^[1-9]\d*$/;//大于0 số nguyên
        if (!reg.test(rowData.cgsl)) {
            $.modalMsg("Số lượng phải lớn hơn0 số nguyên!", "warning", 1500);
            return false;
        }
        //if ($("#sel_dw_" + rowid).val() === "") {

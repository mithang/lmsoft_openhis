<script type="text/javascript">

    var $gridList = $("#gridList");
    var keyValue = $.request("keyValue");//采购Id
    var cgId = keyValue;
    //var yfbmstr = $.request("yfbm");
    //var yfmcstr = $.request("yfmc");
    //var djId = $.request("djId");

    $(function () {
        $(window).resize(function () {
            window.initLayout("MyTabGrid");
        });
        init();
        InitFloat();

        GetTargetDept();
        //$("#fyfs").bindSelect({ url: "/DrugStorage/GetCrkfs?crkbz=1", id: "crkfsCode", text: "crkfsmc" });
        $("#btn_add").click(function () {
            $("#gridList").jqGrid("addRowData", undefined, { operate: GetOperatehtml() }, "last");
        });
        InitBackspaceKeyForRkbm();
        //var djId = keyValue;
        if (cgId != null && cgId != "") {
            $.najax({
                type: "Get",
                url: "/PurchaseManage/Purchase/QueryPurchasebyId",
                data: { cgId: cgId },
                dataType: "json",
                success: function (ajaxresp) {
                    if (ajaxresp !== null) {
                        $("#ddsj").val(ajaxresp[0].ddsj);
                        $("#czlx").val(ajaxresp[0].czlx);
                        $("#yybm").val(ajaxresp[0].yybm);
                        $("#psdbm").val(ajaxresp[0].psdbm);
                        $("#ddlx").val(ajaxresp[0].ddlx);
                        $("#ddbh").val(ajaxresp[0].ddbh);
                        $("#yyjhdh").val(ajaxresp[0].yyjhdh);
                        $("#zwdhrq").val(ajaxresp[0].zwdhrq);
                        $("#cgfs").val(ajaxresp[0].cgfs);
                        $("#xtbm").val(ajaxresp[0].xtbm);
                        $("#sfhbsfw").val(ajaxresp[0].sfhbsfw);
                    }
                }
            });
            $.najax({
                type: "Get",
                url: "/PurchaseManage/Purchase/QueryPurchaseDetailbyId",
                data: { cgId: cgId },
                dataType: "json",
                success: function (ajaxresp) {
                    if (ajaxresp !== null && ajaxresp.length!=0) {
                        //$("#yqbm").val(ajaxresp[0].productCode);
                        //$("#yq").val(ajaxresp[0].yqmc);
                        for (var i = 0; i < ajaxresp.length; i++) {
                            ajaxresp[i].operate = GetOperatehtml();
                            ajaxresp[i].dlmc = ajaxresp[i].yplb;
                            $("#gridList").jqGrid("addRowData", undefined, ajaxresp[i], "last");

                            $("#jqg" + (i + 1) + "_ypmc").val(ajaxresp[i].ypmc);
                            $("#jqg" + (i + 1) + "_ypdm").val(ajaxresp[i].ypCode);
                            $("#jqg" + (i + 1) + "_qy").val(ajaxresp[i].qymc);
                            $("#jqg" + (i + 1) + "_qybm").val(ajaxresp[i].qybm);
                            $("#jqg" + (i + 1) + "_zxspdm").val(ajaxresp[i].zxspdm);
                            $("#jqg" + (i + 1) + "_cgdj").val(ajaxresp[i].cgdj);
                            $("#jqg" + (i + 1) + "_cgsl").val(ajaxresp[i].cgsl);
                            $("#jqg" + (i + 1) + "_cgjldw").val(ajaxresp[i].cgjldw);
                            $("#jqg" + (i + 1) + "_ybgg").val(ajaxresp[i].ggbz);
                            $("#sel_dw_jqg" + (i + 1)).append('<option value="dw" data-dw="' + ajaxresp[i].dw + '" selected>' + ajaxresp[i].dw + '</option>');
                            $("#jqg" + (i + 1) + "_cglx").val(ajaxresp[i].cglxmc);
                        }
                    }
                }
            });
        } else {
            $("#gridList").jqGrid("addRowData", undefined, { operate: GetOperatehtml() }, "last");
        }
    });

    //按backspace键清楚所有
    function InitBackspaceKeyForRkbm() {
        $("#rkbmmc").keydown(function (e) {
            e = window.event ? window.event : e;
            var keyCode = e.which ? e.which : e.keyCode;
            if (keyCode === 8) {//tab
                $("#rkbmmc").val("");
                $("#rkbm").val("");
            }
        });
    }

    //初始化
    function init() {
        //NewDjh();
        InitJqGrid();
        //$("#gridList").jqGrid("addRowData", undefined, { operate: GetOperatehtml() }, "last");
    }

    //Thêm chi tiết mua sắm
    function addItem(obj) {
        var ids = $("#gridList").getDataIDs();
        var lastRowoid = ids[ids.length - 1];
        var dataRow = {
            operate: GetOperatehtml(),
        };
        $("#gridList").jqGrid("addRowData", undefined, dataRow, "after", lastRowoid);
    }

    //Xóa chi tiết mua sắm
    function deleteItem(obj) {
        var selRowId = $(obj).parent().parent().attr("id");
        if (!!selRowId) {
            $("#gridList").jqGrid("delRowData", selRowId);
        }
    }

    //获取Thao tác按钮html
    function GetOperatehtml() {
        return "<i class='fa fa-plus-square-o' style='font-size: large; color: #09a3ea;vertical-align: middle;' onclick='addItem(this);'></i>&nbsp;&nbsp;&nbsp;<i class='fa fa-minus-square-o' style='font-size: large; color: #09a3ea;vertical-align: middle;' onclick='deleteItem(this);'></i>";
    }

    //初始化Chi tiết mua sắm
    function InitJqGrid() {
        $gridList.newtouchLocalDataGrid({
            data: [],
            height: $(window).height() - document.getElementById('gridList').offsetTop - 85,
            rownumbers: true,  //CóKhông显示序号
            multiselect: true,
            editurl: "clientArray",  //行编辑不向服务器Nộp数据
            unwritten: false,
            colModel: [
                { label: 'Thao tác', name: 'operate', width: 50, align: 'center' },

                {
                    label: 'Số thứ tự', name: 'sxh', width: 51, align: 'center', formatter: function (cellvalue, options, cell) {
                        var rowId = options.rowId;
                        var sxh = rowId.replace("jqg", "");
                        return sxh;
                    }
                },
                { label: '<span class="required">*</span>Tên vật tư', name: 'productmc', width: 200, align: 'center', editable: true, editwidth: "100%" },
                { label: '<span class="required">*</span>Doanh nghiệp', name: 'qy', width: 200, align: 'center', editable: true, editwidth: "100%" },
                { label: 'cglxxxxxxx', name: 'cglxxxxxxx', editwidth: '', align: 'center', editable: true, hidden: true },
                {
                    label: '<span class="required">*</span>Loại mua sắm', name: 'cglx', width: 120, align: 'center', editable: true, editwidth: "100%", edittype: "select", editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    var $thisval = $(this).val();

                                    $("#" + rowid + "_cglxxxxxxx").val($thisval);
                                }
                            }
                        ]
                    }
                },
                { label: 'Mã thống nhất vật tư tiêu hao', name: 'hctbdm', width: 75, align: 'center', editable: true, editwidth: '100%' },
                { label: 'Mã phân loại vật tư tiêu hao', name: 'hcxfdm', width: 75, align: 'center', editable: true, editwidth: '100%' },
                { label: 'Mã nội bộ bệnh viện', name: 'yybddm', width: 75, align: 'center', editable: true, editwidth: '100%' },
                { label: 'Quy cách mẫu mã mua sắm', name: 'cgggxh', width: 75, align: 'center', editable: true, editwidth: '100%' },
                { label: 'Giải thích giao hàng', name: 'pssm', width: 75, align: 'center', editable: true, editwidth: '100%' },
                { label: 'Số lượng mua sắm', name: 'cgsl', width: 75, align: 'center', editable: true, editwidth: '100%' },
                { label: 'Đơn giá mua sắm', name: 'cgdj', width: 75, align: 'center', editable: true, editwidth: '100%' },
                { label: 'Mã doanh nghiệp', name: 'qybm', width: 75, align: 'center', editable: true, editwidth: '100%', hidden: true, },
                { label: 'sfjjjjjjjj', name: 'sfjjjjjjjj', editwidth: '', align: 'center', editable: true, hidden: true },  //不可去掉
                {
                    label: '<span class="required">*</span>Có gấp không', name: 'sfjj', width: 80, align: 'center', editable: true, editwidth: "100%", edittype: "select", editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    var $thisval = $(this).val();

                                    $("#" + rowid + "_sfjjjjjjjj").val($thisval);
                                }
                            }
                        ]
                    }
                },
                { label: 'psyqqqqqqq', name: 'psyqqqqqqq', editwidth: '', align: 'center', editable: true, hidden: true },
                {
                    label: '<span class="required">*</span>Yêu cầu giao hàng', name: 'psyq', width: 120, align: 'center', editable: true, editwidth: "100%", edittype: "select", editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    var $thisval = $(this).val();

                                    $("#" + rowid + "_psyqqqqqqq").val($thisval);
                                }
                            }
                        ]
                    }
                },
                { label: 'dcpsbsssssss', name: 'dcpsbsssssss', editwidth: '', align: 'center', editable: true, hidden: true },  //不可去掉
                {
                    label: '<span class="required">*</span>Giao hàng nhiều lần', name: 'dcpsbs', width: 60, align: 'center', editable: true, editwidth: "100%", edittype: "select", editoptions: {
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    var row = $(e.target).closest('tr.jqgrow');
                                    var rowid = row.attr('id');
                                    var $thisval = $(this).val();

                                    $("#" + rowid + "_dcpsbsssssss").val($thisval);
                                }
                            }
                        ]
                    }
                },
                { label: 'Thông tin vị trí kho', name: 'cwxx', width: 75, align: 'center', editable: true, editwidth: '100%' },
                { label: 'Giải thích ghi chú', name: 'bzsm', width: 75, align: 'center', editable: true, editwidth: '100%' },


                
                //{ label: 'Thời hạn hiệu lực', name: 'yxq', width: 50, align: 'center', editable: true, editwidth: "100%" },
                //{ label: 'Nhà sản xuất', name: 'sccj', width: 200, align: 'center', editable: true, editwidth: "100%" },
                //{ label: 'Lô hàng', name: 'pc', width: 90, align: 'center', editable: true, editwidth: "100%" },
                //{ label: 'Số lô', name: 'ph', width: 80, align: 'center', editable: true, editwidth: "100%" },
                //{ label: 'Đơn giá bán lẻ', name: 'lsjdjdw', width: 75, align: 'center', editable: true, editwidth: "100%" },
                //{ label: 'Tổng số tiền bán lẻ', name: 'lsze', width: 80, align: 'center', editable: true, editwidth: "100%" },
                { label: 'pc', name: 'pc', hidden: true },
                { label: 'ph', name: 'ph', hidden: true },
                { label: 'bzs', name: 'bzs', hidden: true, editable: true },
                { label: 'kykc', name: 'kykc', hidden: true, editable: true },
                { label: 'pfj', name: 'pfj', hidden: true, editable: true },
                { label: 'lsj', name: 'lsj', hidden: true, editable: true },
                { label: 'zxdwlsj', name: 'zxdwlsj', hidden: true, editable: true },
                { label: 'ykpfj', name: 'ykpfj', hidden: true, editable: true },
                { label: 'yklsj', name: 'yklsj', hidden: true, editable: true },
                { label: 'zxdwjj', name: 'zxdwjj', hidden: true, editable: true },
                { label: 'bzdwjj', name: 'bzdwjj', hidden: true, editable: true }
            ],
            editinputwidthborder: false,    //CóKhông需要边框 默认为true
            editinputborderradius: false,   //CóKhông需要边框圆角 默认true（有圆角）
            gridComplete: function () {
                var ids = $("#gridList").getDataIDs();
                var lastRowoid = ids[ids.length - 1];
                EnableInlineEditBox(lastRowoid);
            }
        });
    }

    //组装Nộp数据
    function AssembleDataPurchase(rowData, rowid) {
        return {
            czlx: rowData.czlx,
            //yybm: "",//Mã bệnh viện
            //psdbm: rowData.psdbm,
            //ddlx: rowData.ddlx,
            //ddbh: rowData.ddbh,
            //yyjhdh: "",//Số kế hoạch của bệnh viện
            //zwdhrq: rowData.zwdhrq,
            //jls: 0,

            sxh: rowData.sxh,
            cglx: rowData.cglxxxxxxx =="" ? '1' : rowData.cglxxxxxxx,
            hctbdm: rowData.hctbdm,
            hcxfdm: rowData.hcxfdm,
            yybddm: rowData.yybddm,
            cgggxh: rowData.cgggxh,
            pssm: rowData.pssm,
            cgsl: rowData.cgsl,
            cgdj: rowData.cgdj,
            sfjj: rowData.sfjjjjjjjj == "" ? '0' : rowData.sfjjjjjjjj,
            psyq: rowData.psyqqqqqqq == "" ? '1' : rowData.psyqqqqqqq,
            dcpsbs: rowData.dcpsbsssssss == "" ? '0' : rowData.dcpsbsssssss,
            cwxx: rowData.cwxx,
            bzsm: rowData.bzsm,
            //qybm: $("#yqbm").val(),
            qybm: rowData.qybm,
            productCode: rowData.yybddm,
            OrganizeId: '',
        }
    }

    //Bật chỉnh sửa trong dòng
    function EnableInlineEditBox(rowid) {
        $("#gridList").jqGrid('editRow', rowid, false, initInlineFunc);//Mở chế độ chỉnh sửa
        $("#jqg_gridList_" + rowid).trigger("click");
    }

    //初始化 浮层
    function initInlineFunc(rowid) {
        //部分列只读
        $("#" + rowid + "_dlmc").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_ypdm").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_slStr").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_gg").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_ph").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_yxq").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_sccj").css('background-color', '#f6f7fb').attr('readonly', 'true');
        $("#" + rowid + "_lsj").css('background-color', '#f6f7fb').attr('readonly', 'true');
        //$("#" + rowid + "_lsjdjdw").css('background-color', '#f6f7fb').attr('readonly', 'true');
        //$("#" + rowid + "_lsze").css('background-color', '#f6f7fb').attr('readonly', 'true');
        InitSrm(rowid + "_productmc", rowid)//物资浮层
        InitGys(rowid + "_qy", rowid)//Nhà cung cấp浮层
        InitTabKey("sel_dw_" + rowid, rowid);//Đơn vịtab换行

        $("#" + rowid + "_cglxxxxxxx").parent().next().children('select').append('<option value="1">Mua sắm đấu thầu</option><option value="2">Mua sắm theo số lượng</option><option value="3">Mua sắm qua mạng</option><option value="9">Khác</option>');//Loại mua sắm
        $("#" + rowid + "_sfjjjjjjjj").parent().next().children('select').append('<option value="0">Không cần gấp</option><option value="1">Cần gấp</option>');//Có gấp không
        $("#" + rowid + "_psyqqqqqqq").parent().next().children('select').append('<option value="1">Giao theo đơn</option><option value="2">Giao theo nhu cầu</option>');//Yêu cầu giao hàng
        $("#" + rowid + "_dcpsbsssssss").parent().next().children('select').append('<option value="0">Không cho phép</option><option value="1">Cho phép</option>');//Dấu hiệu giao hàng nhiều lần
    }

    //tab键出发
    function InitTabKey(id, rowid) {
        $("#" + id).keydown(function (e) {
            e = window.event ? window.event : e;
            var keyCode = e.which ? e.which : e.keyCode;
            if (keyCode === 9) {//tab
                $(this).parent().parent().find(".fa-plus-square-o").trigger("click");
            }
        });
    }
    //获取目标药房
    function GetTargetDept() {
        $("#lybm").newtouchBatchFloatingSelector({
            height: 200,
            width: 250,
            clickautotrigger: true,
            url: "/OrderAudit/GetTheLowerYfbmCodeList",
            ajaxmethod: 'POST',
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = $.trim($("#lybm").val());
                return reqData;
            },
            caption: "Khoa lĩnh thuốc",
            colModel: [
                { label: 'Mã nhà thuốc', name: 'yfbmCode', widthratio: 50 },
                { label: 'Tên nhà thuốc', name: 'yfbmmc', widthratio: 50 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#lybm").val($thistr.attr('data-yfbmmc'));
                $("#lybm").attr("data-yfbmCode", $thistr.attr('data-yfbmCode'));
                $("#yfbm").val($thistr.attr('data-yfbmCode'));
                return;
            }
        });
    }

    //初始化输入码
    function InitSrm(id, rowid) {
        $("#" + id).newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 300,
            width: 850,
            id: 'selectProduct',
            url: '/StorageManage/Storage/DepartmentStockListQuery',
            ajaxmethod: 'Get',
            inputtextcheck: function () {
                //if ($("#" + rowid + "_" + id).val().replace(" ", "") === "" || $("#supplierId").val() === "") {   //去掉左右两端空格
                //    $.modalMsg('Vui lòng chọn nhà cung cấp trong cửa sổ nổi trước', 'warning', 1500);
                //    return false;
                //}
                return true;
            },
            ajaxreqdata: function () {
                var reqData = {};
                reqData.key = $("#" + id).val();
                return reqData;
            },
            caption: "Thông tin vật tư",
            colModel: [
                { label: 'Loại', name: 'lbmc', width: 120 },
                { label: 'Tên', name: 'name', width: 200, align: "left" },
                { label: 'Tồn kho', name: 'slstr', width: 100 },
                { label: 'Quy cách', name: 'gg', width: 120 },
                {
                    label: 'Đơn giá bán lẻ', name: 'bmlsj', width: 90, align: "right",
                    formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0.00";
                    }
                },
                {
                    label: 'Giá nhập', name: 'jj', width: 90, align: "right",
                    formatter: function (cellvalue) {

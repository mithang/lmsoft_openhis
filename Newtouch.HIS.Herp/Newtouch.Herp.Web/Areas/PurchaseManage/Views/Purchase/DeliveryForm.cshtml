    //Lưu
    function SubmitForm() {
        if (!DataValidate()) {
            return;
        }
        var postData = $("#form1").formSerialize();
        postData.hctbdm = hctbdm;
        postData.scph = scph;
        postData.psl = psl;

        $.submitForm({
            url: "/PurchaseManage/Purchase/DeliveryAccept",
            param: postData,
            success: function () {
                $.modalMsg('Nghiệm thu thành công', 'success');
                $.modalClose();
                callback();
            }
        });
    }

    //Kiểm tra dữ liệu
    function DataValidate() {
        if ($("#ystgs").val() === "") {
            $.modalAlert("Số lượng nghiệm thu đạt lần này là bắt buộc", 'warning');
            return false;
        }
        if ($("#ysbgs").val() === "") {
            $.modalAlert("Số lượng nghiệm thu không đạt lần này là bắt buộc", 'warning');
            return false;
        }
        return true;
    }
    

</script>
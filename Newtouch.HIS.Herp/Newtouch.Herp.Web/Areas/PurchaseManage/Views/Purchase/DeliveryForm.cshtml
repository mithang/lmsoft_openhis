
@using Newtouch.Herp.Infrastructure.Enum
@{
    ViewBag.Title = "Nghiệm thu phiếu giao hàng";
    Layout = "~/Views/Shared/_Form.cshtml";

}

<form id="form1">
    <div class="container" style="padding:0;">
        <div class="tab-content" style="margin-top:10px;padding-right:10px;">
            <div role="tabpanel" class="tab-pane fade in active">
                <table class="form">
                    <tr>
                        <th class="formTitle">Số chi tiết phiếu giao hàng:</th>
                        <td class="formValue">
                            <input id="psmxbh" name="psmxbh" type="text" class="form-control" placeholder="" />
                        </td>
                    </tr>
                    <tr>
                        <td class="formTitle"><span class="required">*</span>Loại nghiệm thu giao hàng:</td>
                        <td class="formValue formDdlSelectorTd">
                            <select id="psyslx" name="psyslx" class="form-control required">
                                <option value="">==Vui lòng chọn==</option>
                                <option value="1">Kiểm nghiệm trước</option>
                                <option value="2">Nghiệm thu thử nghiệm</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Số lượng nghiệm thu đạt lần này:</th>
                        <td class="formValue">
                            <input id="ystgs" name="ystgs" type="text" class="form-control" placeholder="" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Số lượng nghiệm thu không đạt lần này:</th>
                        <td class="formValue">
                            <input id="ysbgs" name="ysbgs" type="text" class="form-control" placeholder="" />
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Giải thích ghi chú nghiệm thu:</th>
                        <td class="formValue">
                            <input id="ysbzsm" name="ysbzsm" type="text" class="form-control" placeholder="" />
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</form>


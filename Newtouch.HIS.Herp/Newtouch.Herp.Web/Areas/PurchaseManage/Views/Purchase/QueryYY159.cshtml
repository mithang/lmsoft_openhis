
@using Newtouch.Infrastructure
@{
    ViewBag.Title = "Lấy trạng thái chi tiết mua sắm theo đơn mua sắm vật tư tiêu hao";
    Layout = "~/Views/Shared/_Index.cshtml";

}
<script src="~/Content/js/index.js"></script>

<form id="form1">
    <div class="panel panel-default" style="margin-bottom:10px;">
        <div class="panel-heading">Lấy chi tiết mua sắm</div>
        <table class="form">
            <tr style="float:left">
                <th class="formTitle">Số đơn mua sắm:</th>
                <td class="formValue">
                    <input id="ddbh" class="form-control" placeholder="Số đơn mua sắm" />
                </td>
                <th class="formTitle">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary" value="Tra cứu" />
                </th>
            </tr>
        </table>
    </div>
    <div id="dv-detail">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>

<script type="text/javascript">

    $(function () {
        //gridList();
    });

    

    function getPostData() {
        return {
            DDBH: $("#ddbh").val(),
            DDMXBHCXTJ :'',
        };
    }

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/PurchaseManage/Purchase/GetGridJsonYY159",
            height: $(window).height() - 200,
            postData: getPostData(),
            colModel: [
                { label: 'Số chi tiết đơn mua sắm', name: 'DDMXBH', width: 180, align: 'left' },
                {
                    label: 'Trạng thái chi tiết đơn mua sắm', name: 'CGMXZT', width: 180, align: 'left', formatter: function (val) {
                        return $.enum.getDescByValue("EnumCGMXZT", val);
                    }
                },
                {
                    label: 'Tồn kho doanh nghiệp', name: 'QYKC', width: 100, align: 'left', formatter: function (val) {
                        return $.enum.getDescByValue("EnumQYKC", val);
                    }
                },
                { label: 'Ý kiến duyệt chi tiết đơn mua sắm', name: 'CGMXSHYJ', width: 120, align: 'left' },
                { label: 'Giải thích xử lý của doanh nghiệp cho đơn mua sắm', name: 'CGDCLSM', width: 80, align: 'left' },

            ],
            multiselect: false,
            //pager: "#gridPager",
            //sortname: '',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                //btn_selectrow(rowid);
            }
        });
        $("#btn_search").click(function () {
            $('#gridList').jqGrid("clearGridData");
            $gridList.jqGrid('setGridParam', {
                postData: getPostData(),
            }).trigger('reloadGrid');
        });
    }

    //Tra cứu
    $('#btn_search').click(function () {
        if ($("#ddbh").val() == "" || $("#ddbh").val() == null) {
            $.modalAlert("Vui lòng nhập số đơn mua sắm", 'warning');
            return ;
        }
        gridList();
    });
</script>



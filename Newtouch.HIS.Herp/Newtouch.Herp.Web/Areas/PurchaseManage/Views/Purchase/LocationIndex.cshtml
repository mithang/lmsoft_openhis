
@using Newtouch.Infrastructure
@{
    ViewBag.Title = "Điểm giao hàng";
    Layout = "~/Views/Shared/_Index.cshtml";

}


<form id="form1">
    <div id="dv-detail">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>

    <div class="panel panel-default">
        <input type="button" id="btn_delete" class="btn btn-info" style="width:7%;display:inline-block;float:right;margin-left:20px;margin-top:30px;" value="Hủy" />
        <input type="button" id="btn_submit" class="btn btn-info" style="width:7%;display:inline-block;float:right;margin-left:20px;margin-top:30px;" value="Truyền báo" />
        <input type="button" id="btn_edit" class="btn btn-info" style="width:7%;display:inline-block;float:right;margin-left:20px;margin-top:30px;" value="Sửa" />
        <input type="button" id="btn_add" class="btn btn-info" style="width:7%;display:inline-block;float:right;margin-left:20px;margin-top:30px;" value="Tạo mới" />
        <input type="button" id="btn_search" class="btn btn-info" style="width:7%;float:right;margin-left:20px;margin-top:30px;" value="Làm mới"  />
    </div>

</form>

<script type="text/javascript">

    $(function () {
        gridList();
    });
    
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/PurchaseManage/Purchase/GetLocationGridJson",
            height: $(window).height() - 150,
            colModel: [
                { label: 'Id', name: 'Id', width: 140, align: 'left',hidden:true },
                { label: 'Mã điểm giao hàng', name: 'psdbm', width: 140, align: 'left' },
                { label: 'Tên điểm giao hàng', name: 'psdmc', width: 140, align: 'left' },
                { label: 'Địa chỉ giao hàng', name: 'psdz', width: 140, align: 'left' },
                { label: 'Họ tên người liên hệ', name: 'lxrxm', width: 80, align: 'left' },
                { label: 'Số điện thoại liên hệ', name: 'lxdh', width: 80, align: 'left' },
                { label: 'Mã bưu chính', name: 'yzbm', width: 80, align: 'left' },
                { label: 'Thông tin ghi chú', name: 'bzxx', width: 80, align: 'left' },
                {
                    label: 'Trạng thái điểm giao hàng', name: 'psdzt', width: 120, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 1) return 'Đã lưu';
                        else if (cellvalue == 2) return 'Đã truyền báo';
                        else if (cellvalue == 3) return 'Đã hủy';
                        else return '';
                    }
                },
                { label: 'Thời gian tạo', name: 'CreateTime', width: 80, align: 'left', hidden: true},
                { label: 'Người tạo', name: 'CreateCode', width: 80, align: 'left',hidden:true },
            ],
            multiselect: true,
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                //btn_selectrow(rowid);
            },
        });
        $("#btn_search").click(function () {
            $gridList.jqGrid('setGridParam', {
                postData: { },
            }).trigger('reloadGrid');
        });
    }



    //Tạo mới
    $('#btn_add').click(function () {
        $.modalOpen({
            id: "Form",
            title: "Điểm giao hàng",
            url: "/PurchaseManage/Purchase/LocationForm",
            width: "25%",
            height: "55%",
            callBack: function (iframeId) {
                top.frames[iframeId].SubmitForm();
                //$.modalClose("Form");
                $('#btn_search').trigger('click');
            }
        });
    });

    //Sửa
    $('#btn_edit').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');

        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn điểm giao hàng cần sửa", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("Chỉ được chọn một điểm giao hàng để sửa", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        if (rowData.psdzt != "Đã lưu") {
            $.modalAlert("Điểm giao hàng đã chọn không ở trạng thái đã lưu, không thể sửa", 'warning');
            return;
        }
        $.modalOpen({
            id: "Form",
            title: "Điểm giao hàng",
            url: "/PurchaseManage/Purchase/LocationForm?keyValue=" + rowData.Id,
            width: "25%",
            height: "55%",
            callBack: function (iframeId) {
                top.frames[iframeId].SubmitForm();
                //$.modalClose("Form");
                $('#btn_search').trigger('click');
            }
        });
    });

    //Nộp
    $('#btn_submit').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn điểm giao hàng cần truyền báo", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("Chỉ được chọn một điểm giao hàng để truyền báo", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        $.najax({
            type: "POST",
            url: "/PurchaseManage/Purchase/LocationUpload",
            data: { Id: rowData.Id, psdzt: 2, czlx: "1" }, //psdzt 1Đã lưu 2Đã truyền báo 3Đã hủy //Loại thao tác: 1Thêm mới 3Hủy 
            dataType: "json",
            success: function (res) {
                if (res.state == "success") {
                    $.modalMsg("Truyền báo điểm giao hàng thành công!", 'success');
                    $('#btn_search').trigger('click');
                } else {
                    $.modalMsg("Truyền báo điểm giao hàng thất bại: " + res.message, 'warning');
                }
            }
        });
    });
    
    //Hủy
    $('#btn_delete').click(function () {
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        if (selRowIds == null || selRowIds.length == 0) {
            $.modalAlert("Vui lòng chọn điểm giao hàng cần hủy", 'warning');
            return;
        }
        if (selRowIds.length >= 2) {
            $.modalAlert("Chỉ được chọn một điểm giao hàng để hủy", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid('getRowData', selRowIds[0]);
        if (rowData.psdzt == "Đã hủy" ) {
            $.modalAlert("Điểm giao hàng này đã bị hủy", 'warning');
            return;
        }
        $.najax({
            type: "POST",
            url: "/PurchaseManage/Purchase/LocationDelete",
            data: { Id: rowData.Id, psdzt: 3,czlx:"3" }, //psdzt 1Đã lưu 2Đã truyền báo 3Đã hủy //Loại thao tác: 1Thêm mới 3Hủy 
            dataType: "json",
            success: function (res) {
                if (res.state == "success") {
                    $.modalMsg("Hủy điểm giao hàng thành công!", 'success');
                    $('#btn_search').trigger('click');
                } else {
                    $.modalMsg("Hủy điểm giao hàng thất bại: " + res.message, 'warning');
                }
            }
        });
    });


</script>



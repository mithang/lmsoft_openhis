<form id="form1">
    <div class="panel panel-default" style="margin-bottom:10px;">
        <div class="panel-heading">Thông tin phát thuốc</div>
        <table class="form">
            <tr>
                <th class="formTitle"><span class="required">*</span>Điểm trả hàng:</th>
                <td class="formValue">
                    <input type="text" id="psd" name="psd" class="form-control" placeholder="Vui lòng chọn điểm giao hàng" autocomplete="off" />
                    <input type="hidden" id="psdbm" />
                </td>
                <th class="formTitle "><span class="required">*</span>Ngày trả hàng thực tế:</th>
                <td class="formValue">
                    <input id="SJTHRQ" type="text" class="form-control input-wdatepicker" style="width:90%; float:left;" value="@DateTime.Now.ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                </td>
                @*<th class="formTitle "><span class="required">*</span>Nhà cung cấp:</th>
                <td class="formValue">
                    <input type="text" id="yq" name="yq" class="form-control" placeholder="Vui lòng chọn nhà cung cấp" autocomplete="off" />
                    <input type="hidden" id="yqbm" />
                </td>*@
                <th class="formTitle ">Số phiếu trả hàng</th>
                <td class="formValue">
                    <input type="text" id="THDBH" name="THDBH" class="form-control" placeholder="Số phiếu trả hàng" autocomplete="off" />
                </td>

            </tr>
            <tr>
                <th class="formTitle"><span class="required">*</span>Phương thức mua sắm:</th>
                <td class="formValue" id="cgfstd">
                    <select id="CGFS" name="CGFS" class="form-control required">
                        <option value="1">Mua sắm ngoài hệ thống</option>
                        <option value="2">Mua sắm theo hệ thống</option>
                    </select>
                </td>

                <th class="formTitle"><span class="required">*</span>Mã hệ thống:</th>
                <td>
                    <input id="XTBM" type="text" class="form-control" style="width:42%; float:left;height:50%;" />
                </td>
                <th class="formTitle"><span class="required">*</span>Có kèm dịch vụ đi kèm không:</th>
                <td class="formValue" id="sfhbsfwtd">
                    <select id="SFHBSFW" name="SFHBSFW" class="form-control required">
                        <option value="0">Không</option>
                        <option value="1">Có</option>
                    </select>
                </td>
                <th class="formTitle ">Số đơn mua sắm</th>
                <td class="formValue">
                    <input type="text" id="DDBH" name="DDBH" class="form-control" placeholder="Số đơn mua sắm" autocomplete="off" />
                </td>
                <th class="formTitle">
                    <input type="button" id="btn_add" class="btn btn-md btn-primary" value="Thêm" />
                </th>
                <td></td>
            </tr>
        </table>
    </div>
    <div id="dv-detail">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>

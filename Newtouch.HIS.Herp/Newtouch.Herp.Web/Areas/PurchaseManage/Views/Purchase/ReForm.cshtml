    //Kiểm tra giá trị số
    function Validately(rowData, rowid) {
        //if ($("#rkbm").val() === "" || $("#rkbmmc").val() === "") {   //Loại bỏ khoảng trắng hai đầu
        //    $.modalMsg("Vui lòng chọn khoa phát thuốc", "error", 1000);
        //    return false;
        //}
        if (rowData.WZMC === "") {
            $.modalMsg('Vui lòng chọn vật tư', 'error', 1000);
            return false;
        }
        if (rowData.HCTBDM === "") {
            $.modalMsg('Vui lòng nhập mã thống nhất vật tư tiêu hao', 'error', 1000);
            return false;
        }
        if (rowData.SCPH === "") {
            $.modalMsg('Vui lòng nhập số lô sản xuất', 'error', 1000);
            return false;
        }
        if (rowData.SCRQ === "") {
            $.modalMsg('Vui lòng nhập ngày sản xuất', 'error', 1000);
            return false;
        }
        if (rowData.YXRQ === "") {
            $.modalMsg('Vui lòng nhập ngày hiệu lực', 'error', 1000);
            return false;
        }
        if (rowData.THSL === "") {
            $.modalMsg('Vui lòng nhập số lượng trả hàng', 'error', 1000);
            return false;
        }
        if (rowData.THDJ === "") {
            $.modalMsg('Vui lòng nhập đơn giá trả hàng', 'error', 1000);
            return false;
        }
        if (rowData.QYBM === "") {
            $.modalMsg('Vui lòng nhập mã doanh nghiệp', 'error', 1000);
            return false;
        }
        //if (rowData.pc === "") {
        //    $.modalMsg('Lô hàng là bắt buộc', 'error', 1000);
        //    return false;
        //}
        var reg = /^[1-9]\d*$/;//Lớn hơn0 số nguyên
        if (!reg.test(rowData.THSL)) {
            $.modalMsg("Số lượng phải lớn hơn0 số nguyên!", "warning", 1500);
            return false;
        }
        //if ($("#sel_dw_" + rowid).val() === "") {
        //    $.modalMsg('Vui lòng chọn đơn vị', 'error', 1000);
        //    return false;
        //}
        return true;
    }

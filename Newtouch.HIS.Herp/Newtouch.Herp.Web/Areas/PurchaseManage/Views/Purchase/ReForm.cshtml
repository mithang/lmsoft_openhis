    //Lưu
    function newtouch_event_f8() {
        var list = [];
        var validationFailedArr = [];
        $.each($("#gridList").find("input[type=checkbox]:checked"), function () {
            var rowid = $(this).parent().parent().parent().attr("id");
            $("#gridList").saveRow(rowid, null, null, null, function (callbackRowId) { }, null, null);
            var rowData = $("#gridList").jqGrid('getRowData', rowid);
            if (!Validately(rowData, rowid)) {
                validationFailedArr.push(rowid);
                return;
            }
            list.push(AssembleDataPurchase(rowData, rowid));
        });
        if (validationFailedArr.length > 0) {
            for (var i = 0; i < validationFailedArr.length; i++) {
                $("#gridList").jqGrid('editRow', validationFailedArr[i], false, initInlineFunc);//Mở chế độ chỉnh sửa
            }
            return;
        }
        if (list.length === 0) {
            $.modalMsg("Vui lòng chọn dữ liệu cần chỉnh sửa!", 'warning', 1000);
            return;
        }
        debugger;
        var par = new Object();
        par["THMX"] = list; //Chi tiết trả hàng
        par["CZLX"] = "1";//1 Thêm mới: báo cáo thông tin mới tạo lên hệ thống dược thành phố. 3 Hủy: hủy thông tin cùng mã đã báo cáo lên hệ thống dược thành phố
        par["PSDBM"] = $("#psdbm").val();//Điểm giao hàng
        par["yybm"] = "77370296000";//Mã bệnh viện
        par["SJTHRQ"] = $("#SJTHRQ").val();//Ngày trả hàng thực tế
        par["THDBH"] = $("#THDBH").val() ? '' : $("#THDBH").val();//Số phiếu trả hàng
        par["CGFS"] = "1";//Phương thức mua sắm
        par["XTBM"] = $("#XTBM").val();// Mã hệ thống
        par["SFHBSFW"] = "0"; //Có kèm dịch vụ đi kèm không
        par["DDBH"] = $("#DDBH").val();//Số đơn mua sắm
        par["JLS"] = list.length//Số dòng
        //par["yqbm"] = $("#yqbm").val();//Mã doanh nghiệp dược


        $.najax({
            type: "POST",
            url: "/PurchaseManage/ReturnedMaterials/SubmitPurchase",
            data: { thEntity: par, thmxList: list, keyValue: keyValue },
            dataType: "json",
            success: function (res) {
                debugger;
                if (res) {
                    if (res.message != null) {
                        $.modalAlert("Lưu thất bại!" + res.message, 'warning');
                        return;
                    }
                    else {
                        $.modalAlert("Lưu thành công!", 'warning');
                    }
                    $("#gridList").clearGridData();
                    $.modalClose("ReForm");
                }
            }
        });
    }

    //Nhấn phím backspace để xóa tất cả
    function InitBackspaceKeyForRkbm() {
        $("#rkbmmc").keydown(function (e) {
            e = window.event ? window.event : e;
            var keyCode = e.which ? e.which : e.keyCode;
            if (keyCode === 8) {//tab
                $("#rkbmmc").val("");
                $("#rkbm").val("");
            }
        });
    }

    //Khởi tạo
    function init() {
        //NewDjh();
        InitJqGrid();
        //$("#gridList").jqGrid("addRowData", undefined, { operate: GetOperatehtml() }, "last");
    }

    //Thêm chi tiết phát thuốc
    function addItem(obj) {
        var ids = $("#gridList").getDataIDs();
        var lastRowoid = ids[ids.length - 1];
        var dataRow = {
            operate: GetOperatehtml(),
        };
        $("#gridList").jqGrid("addRowData", undefined, dataRow, "after", lastRowoid);
    }

    //Xóa chi tiết phát thuốc
    function deleteItem(obj) {
        var selRowId = $(obj).parent().parent().attr("id");
        if (!!selRowId) {
            $("#gridList").jqGrid("delRowData", selRowId);
        }
    }

    //Lấy html nút Thao tác
    function GetOperatehtml() {
        return "<i class='fa fa-plus-square-o' style='font-size: large; color: #09a3ea;vertical-align: middle;' onclick='addItem(this);'></i>&nbsp;&nbsp;&nbsp;<i class='fa fa-minus-square-o' style='font-size: large; color: #09a3ea;vertical-align: middle;' onclick='deleteItem(this);'></i>";
    }

    //Khởi tạo chi tiết xuất kho
    function InitJqGrid() {
        $gridList.newtouchLocalDataGrid({
            data: [],
            height: $(window).height() - document.getElementById('gridList').offsetTop - 85,
            rownumbers: true,  //CóKhônghiển thị số thứ tự
            multiselect: true,
            editurl: "clientArray",  //Chỉnh sửa dòng không gửi dữ liệu lên máy chủ
            unwritten: false,
            colModel: [
                { label: 'Thao tác', name: 'operate', width: 50, align: 'center' },
                {
                    label: 'Số thứ tự', name: 'SXH', width: 51, align: 'center', formatter: function (cellvalue, options, cell) {
                        var rowId = options.rowId;
                        var sxh = rowId.replace("jqg", "");
                        return sxh;
                    }
                },
                { label: '<span class="required">*</span>Tên vật tư', name: 'WZMC', width: 105, align: 'center', editable: true, editwidth: "100%" },
                { label: '<span class="required">*</span>Doanh nghiệp', name: 'qy', width: 200, align: 'center', editable: true, editwidth: "100%" },
                {
                    label: '<span class="required">*</span>Loại mua sắm', name: 'CGLX', width: 70, align: 'center',
                    formatter: function (cellvalue, options) {
                        return "<select name=\"CGLX\" id=\"CGLX_" + options.rowId + "\" rowid=" + options.rowId + " class=\"editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" ><option value = '1'> Mua sắm đấu thầu</option ><option value = '2' > Mua sắm theo số lượng</option ><option value = '3' > Mua sắm qua mạng</option ><option value = '9' > Khác</option ></select>";
                    }
                },
                {
                    label: '<span class="required">*</span>Loại trả hàng', name: 'THLX', width: 70, align: 'center',
                    formatter: function (cellvalue, options) {
                        return "<select name=\"THLX\" id=\"THLX_" + options.rowId + "\" rowid=" + options.rowId + " class=\"editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" ><option value = '1' > Trả hàng bình thường</option ><option value = '2' > Trả hàng bù chênh lệch</option ></select>";
                    }
                },
                //{ label: '<span class="required">*</span>Mã doanh nghiệp', name: 'QYMC', width: 100, align: 'center', editable: true, editwidth: "100%" },
                //{ label: '<span class="required">*</span>Mã doanh nghiệp', name: 'QYBM', width: 100, hidden: true, align: 'center', editable: true, editwidth: "100%" },
                { label: '<span class="required">*</span>Mã thống nhất vật tư tiêu hao', name: 'HCTBDM', width: 100, align: 'center', editable: true, editwidth: "100%" },
                { label: 'Mã phân loại vật tư tiêu hao', name: 'HCXFDM', width: 100, align: 'center', editable: true, editwidth: "100%" },
                { label: 'Mã nội bộ bệnh viện', name: 'YYBDDM', width: 100, align: 'center', editable: true, editwidth: "100%" },
                { label: 'Quy cách mẫu mã mua sắm', name: 'CGGGXH', width: 100, align: 'center', editable: true, editwidth: "100%" },
                { label: '<span class="required">*</span>Số lô sản xuất', name: 'SCPH', width: 100, align: 'center', editable: true, editwidth: "100%" },
                { label: '<span class="required">*</span>Ngày sản xuất', name: 'SCRQ', width: 100, align: 'center', editable: true, editwidth: "100%" },
                { label: '<span class="required">*</span>Ngày hiệu lực', name: 'YXRQ', width: 100, align: 'center', editable: true, editwidth: "100%" },
                //{ label: 'Loại mã vạch chi tiết phiếu giao hàng', name: 'PSMXTMLX', width: 100, align: 'center', editable: true, editwidth: "100%" },
                {
                    label: '<span class="required">*</span>Loại mã vạch chi tiết phiếu giao hàng', name: 'PSMXTMLX', width: 80, align: 'center',
                    formatter: function (cellvalue, options) {
                        return "<select name=\"CGLX\" id=\"PSMXTMLX_" + options.rowId + "\" rowid=" + options.rowId + " class=\"editable inline-edit-cell form-control\" style=\"padding:0; border-radius: 0px; border: 0px;\" ><option value = '01'> GS1 Mã vạch</option ><option value = '02' > HIBC Mã vạch</option ><option value = '99' > Khác</option ><option value = '9' > Khác</option ></select>";
                    }
                },
                { label: 'Mã vạch chi tiết phiếu giao hàng', name: 'PSMXTM', width: 100, align: 'center', editable: true, editwidth: "100%" },
                { label: '<span class="required">*</span>Số lượng trả hàng', name: 'THSL', width: 100, align: 'center', editable: true, editwidth: "100%" },
                { label: '<span class="required">*</span>Đơn giá trả hàng', name: 'THDJ', width: 100, align: 'center', editable: true, editwidth: "100%" },
                { label: 'Mã doanh nghiệp', name: 'qybm', width: 75, align: 'center', editable: true, editwidth: '100%', hidden: true, },
                { label: '<span class="required">*</span>Lý do trả hàng', name: 'THYY', width: 100, align: 'center', editable: true, editwidth: "100%" },
            ],
            editinputwidthborder: false,    //CóKhôngcần viền mặc định làtrue
            editinputborderradius: false,   //CóKhôngcần bo góc viền mặc địnhtrue(có bo góc)
            gridComplete: function () {
                var ids = $("#gridList").getDataIDs();
                var lastRowoid = ids[ids.length - 1];
                EnableInlineEditBox(lastRowoid);
            }
        });
    }

    //Ghép dữ liệu gửi lên
    function AssembleDataPurchase(rowData, rowid) {
        return {
            SXH: rowData.SXH,
            CGLX: $("#CGLX_" + rowid).val(),
            THLX: $("#THLX_" + rowid).val(),
            HCTBDM: rowData.HCTBDM,
            HCXFDM: rowData.HCXFDM,
            YYBDDM: rowData.YYBDDM,
            CGGGXH: rowData.CGGGXH,
            SCPH: rowData.SCPH,
            SCRQ: rowData.SCRQ,
            YXRQ: rowData.YXRQ,
            PSMXTMLX: $("#PSMXTMLX_" + rowid).val(),
            PSMXTM: rowData.PSMXTM ?'': rowData.PSMXTM,
            THSL: rowData.THSL,
            THDJ: rowData.THDJ,
            //QYBM: $("#yqbm").val(),
            qybm: rowData.qybm,
            THYY: rowData.THYY,
        }
    }

    //Bật chỉnh sửa trong dòng
    function EnableInlineEditBox(rowid) {
        $("#gridList").jqGrid('editRow', rowid, false, initInlineFunc);//Mở chế độ chỉnh sửa
        $("#jqg_gridList_" + rowid).trigger("click");
    }

    //Khởi tạo lớp nổi
    function initInlineFunc(rowid) {
        //Một số cột chỉ đọc
        InitProduct(rowid + "_WZMC", rowid);
        Inityqmc(rowid + "_QYMC", rowid);
        InitGys(rowid + "_qy", rowid)//Lớp nổi Nhà cung cấp
    }
    function Inityqmc(id, rowid) {
        $("#" + id).newtouchBatchFloatingSelector({
            height: 300,
            width: 300,
            clickautotrigger: true,
            ajaxmethod: 'Get',
            caption: "Doanh nghiệp dược",
            url: "/StorageManage/Storage/GetSupplierList",
            ajaxreqdata: function () {
                var reqData = {};
                reqData.key = $("#" + id).val();
                return reqData;
            },
            colModel: [
                { label: 'deptId', name: 'Id', hidden: true },
                { label: 'Tên doanh nghiệp dược', name: 'name', widthratio: 100 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#" + rowid + "_QYMC").val($thistr.attr('data-name'));
                $("#" + rowid + "_QYBM").val($thistr.attr('data-Id'));
                return;
            }
        });
    }
    //Phím tab kích hoạt
    function InitTabKey(id, rowid) {
        $("#" + id).keydown(function (e) {
            e = window.event ? window.event : e;
            var keyCode = e.which ? e.which : e.keyCode;
            if (keyCode === 9) {//tab
                $(this).parent().parent().find(".fa-plus-square-o").trigger("click");
            }
        });
    }
    //Lấy kho thuốc đích
    function GetTargetDept() {
        $("#lybm").newtouchBatchFloatingSelector({
            height: 200,
            width: 250,
            clickautotrigger: true,
            url: "/OrderAudit/GetTheLowerYfbmCodeList",
            ajaxmethod: 'POST',
            ajaxreqdata: function () {
                var reqData = {};
                reqData.keyword = $.trim($("#lybm").val());
                return reqData;
            },
            caption: "Khoa lĩnh thuốc",
            colModel: [
                { label: 'Mã nhà thuốc', name: 'yfbmCode', widthratio: 50 },
                { label: 'Tên nhà thuốc', name: 'yfbmmc', widthratio: 50 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#lybm").val($thistr.attr('data-yfbmmc'));
                $("#lybm").attr("data-yfbmCode", $thistr.attr('data-yfbmCode'));
                $("#yfbm").val($thistr.attr('data-yfbmCode'));
                return;
            }
        });
    }
    //Khởi tạo mã nhập
    function InitProduct(id, rowid) {
        $("#" + id).newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 300,
            width: 750,
            id: 'selectProduct',
            url: '/StorageManage/Storage/DepartmentStockListQuery',
            ajaxmethod: 'Get',
            inputtextcheck: function () {
                //if ($("#DDBH").val().replace(" ", "") === "" || $("#DDBH").val() === "") {   //Loại bỏ khoảng trắng hai đầu
                //    $.modalMsg('Vui lòng nhập số đơn mua sắm', 'warning', 1500);
                //    return false;
                //}
                //if ($("#THDBH").val().replace(" ", "") === "" || $("#THDBH").val() === "") {   //Loại bỏ khoảng trắng hai đầu
                //    $.modalMsg('Vui lòng nhập số phiếu trả hàng', 'warning', 1500);
                //    return false;
                //}
                return true;
            },
            ajaxreqdata: function () {
                var reqData = {};
                reqData.key = $("#" + id).val();
                return reqData;
            },
            caption: "Thông tin vật tư",
            colModel: [
                { label: 'Loại', name: 'lbmc', width: 120 },
                { label: 'Tên', name: 'name', width: 200, align: "left" },
                { label: 'Tồn kho', name: 'slstr', width: 100 },
                { label: 'Quy cách', name: 'gg', width: 120 },
                {
                    label: 'Đơn giá bán lẻ', name: 'bmlsj', width: 90, align: "right",
                    formatter: function (cellvalue) {
                        return cellvalue ? parseFloat(cellvalue).toFixed(4) : "0.00";
                    }
                },
                { label: 'Đơn vị', name: 'bmdwmc', width: 50 },
                { label: 'Mã thống nhất vật tư tiêu hao', name: 'gjybdm', width: 50, hidden: true },
                { label: 'Mã phân loại vật tư tiêu hao', name: 'hcgjybdm', width: 50, hidden: true },
                { label: 'Mã nội bộ bệnh viện', name: 'productCode', width: 50, hidden: true },
                { label: 'Id', name: 'Id', hidden: true },
                { label: 'kykcsl', name: 'kykcsl', hidden: true },
                { label: 'zhyz', name: 'zhyz', hidden: true },
                { label: 'bmdwzhyz', name: 'bmdwzhyz', hidden: true },
                { label: 'bmdwId', name: 'bmdwId', hidden: true },
                { label: 'zxdwId', name: 'zxdwId', hidden: true },
                { label: 'supplierName', name: 'supplierName', hidden: true },
                { label: 'minlsj', name: 'minlsj', hidden: true },
                { label: 'mindwmc', name: 'mindwmc', hidden: true }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#" + rowid + "_WZMC").val($thistr.attr('data-name'));
                $("#" + rowid + "_CGGGXH").val($thistr.attr('data-gg'));
                $("#" + rowid + "_YYBDDM").val($thistr.attr('data-productCode'));
                $("#" + rowid + "_HCTBDM").val($thistr.attr('data-gjybdm'));
                $("#" + rowid + "_HCXFDM").val($thistr.attr('data-hcgjybdm'));
            }
        });
    }


    //Khởi tạoNhà cung cấp
    function InitGys(id, rowid) { //Nhà cung cấp vật tư
        $("#" + id).newtouchBatchFloatingSelector({
            clickautotrigger: true,
            height: 200,
            width: 400,
            id: 'selectGys',
            url: '/Storage/GetSupplierList',
            ajaxmethod: 'Get',
            inputtextcheck: function () {

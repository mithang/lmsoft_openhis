<form id="form1">
    <div class="panel panel-default" style="margin-bottom:10px;">
        <div class="panel-heading">Thông tin mua sắm</div>
        <table class="form">
            <tr>
                <th class="formTitle "><span class="required">*</span>Nhà cung cấp:</th>
                <td class="formValue">
                    <input type="text" id="yq" name="yq" class="form-control" placeholder="Vui lòng chọn nhà cung cấp" autocomplete="off" style="width:60%" />
                    <input type="hidden" id="yqbm" />
                </td>

                <th class="formTitle">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary" value="Lấy chi tiết" />
                    <input type="button" id="btn_accept" class="btn btn-md btn-primary" value="Nghiệm thu chi tiết" />
                </th>
                <td></td>
            </tr>
        </table>
    </div>
    <div id="dv-detail">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>

<script type="text/javascript">

    $(function () {
        InitFloat();

        //gridList();
    });


    //Khởi tạo lớp nổi
    function InitFloat() {
        //Nhà cung cấp vật tư
        $("#yq").newtouchBatchFloatingSelector({
            clickautotrigger: true,
            url: '/Storage/GetSupplierList',
            height: 300,
            width: 400,
            caption: "Nhà cung cấp vật tư",
            ajaxparameters: function () {
                return "key=" + $("#yq").val();
            },
            colModel: [
                { label: 'Id', name: 'Id', hidden: true },
                { label: 'Mã', name: 'py', widthratio: 45 },
                { label: 'Nhà cung cấp', name: 'name', widthratio: 55 }
            ],
            itemdbclickhandler: function ($thistr) {
                $("#yqbm").val($thistr.attr('data-py'));
                $("#yq").val($thistr.attr('data-name'));
            }
        });
    }

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/PurchaseManage/Purchase/GetBillGridJson",
            height: $(window).height() - 200,
            postData: { qybm: $("#yqbm").val(), fpmxbhcxtj: '1' },
            colModel: [
                { label: 'Số hóa đơn', name: 'FPBH', width: 140, align: 'left' },
                { label: 'Số chi tiết hóa đơn', name: 'FPMXBH', width: 140, align: 'left' },
                { label: 'Mã hóa đơn', name: 'FPDM', width: 140, align: 'left' },
                { label: 'Số hóa đơn', name: 'FPH', width: 140, align: 'left' },
                { label: 'Ngày hóa đơn', name: 'FPRQ', width: 80, align: 'left' },
                { label: 'Tổng số tiền hóa đơn đã gồm thuế', name: 'FPHSZJE', width: 80, align: 'left' },
                { label: 'Mã doanh nghiệp', name: 'QYBM', width: 140, align: 'left' },
                { label: 'Mã bệnh viện', name: 'YYBM', width: 80, align: 'left' },
                { label: 'Mã điểm giao hàng', name: 'PSDBM', width: 80, align: 'left' },
                { label: 'Loại mua sắm', name: 'CGLX', width: 80, align: 'left' },
                { label: 'Ghi chú hóa đơn', name: 'FPBZ', width: 80, align: 'left' },
                { label: 'Có hóa đơn không kèm giao hàng không', name: 'SFWPSFP', width: 80, align: 'left' },
                { label: 'Giải thích hóa đơn không kèm giao hàng', name: 'WPSFPSM', width: 80, align: 'left' },
                { label: 'Có đảo đỏ không', name: 'SFCH', width: 80, align: 'left' },
                { label: 'Mã thống nhất vật tư tiêu hao', name: 'HCTBDM', width: 140, align: 'left' },
                { label: 'Mã phân loại vật tư tiêu hao', name: 'HCXFDM', width: 140, align: 'left' },
                { label: 'Mã nội bộ bệnh viện', name: 'YYBDDM', width: 80, align: 'left' },
                { label: 'Giải thích quy cách mẫu mã', name: 'GGHXSM', width: 80, align: 'left' },
                { label: 'Số chi tiết liên quan', name: 'GLMXBH', width: 120, align: 'left' },
                { label: 'Số đơn bán hàng', name: 'XSDDH', width: 80, align: 'left' },
                { label: 'Số lô sản xuất', name: 'SCPH', width: 80, align: 'left' },
                { label: 'Ngày sản xuất', name: 'SCRQ', width: 80, align: 'left' },
                { label: 'Ngày hiệu lực', name: 'YXEQ', width: 80, align: 'left' },
                { label: 'Số lượng hàng hóa', name: 'SPSL', width: 80, align: 'left' },
                { label: 'Đơn giá chưa gồm thuế', name: 'WSDJ', width: 80, align: 'left' },
                { label: 'Đơn giá đã gồm thuế', name: 'HSDJ', width: 80, align: 'left' },
                { label: 'Thuế suất', name: 'SL', width: 80, align: 'left' },
                { label: 'Số tiền thuế', name: 'SE', width: 80, align: 'left' },
                { label: 'Số tiền đã gồm thuế', name: 'HSJE', width: 80, align: 'left' },
                { label: 'Giá bán buôn', name: 'PFJ', width: 80, align: 'left' },
                { label: 'Giá bán lẻ', name: 'LSJ', width: 80, align: 'left' },
                { label: 'Số giấy chứng nhận đăng ký', name: 'ZCZH', width: 120, align: 'left' },
            ],

            multiselect: false,

            pager: "#gridPager",
            sortname: 'FPH',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                //btn_selectrow(rowid);
            }
        });
        $("#btn_search").click(function () {
            $('#gridDJMXInfo').jqGrid("clearGridData");
            $gridList.jqGrid('setGridParam', {
                postData: { kssj: $("#kssj").val(), jssj: $("#jssj").val() },
            }).trigger('reloadGrid');
        });
    }

    //Lấy chi tiết
    $('#btn_search').click(function () {
        if ($("#yq").val() == "" || $("#yq").val() == null) {
            $.modalAlert("Vui lòng chọn nhà cung cấp", 'warning');
            return ;
        }
        gridList();
    });

    //Nghiệm thu chi tiết
    $('#btn_accept').click(function () {
        var rowData = $("#gridList").jqGridRowValue();
        if (rowData == null) {
            $.modalAlert("Vui lòng chọn chứng từ cần nghiệm thu", 'warning');
            return;
        }
        //var psmxbh = rowData.PSMXBH;
        //var hctbdm = rowData.HCTBDM;
        //var scph = rowData.SCPH;
        //var pssl = rowData.PSSL
        $.modalOpen({
            id: "Form",
            title: "Nghiệm thu phiếu giao hàng",
            url: "/PurchaseManage/Purchase/BillForm?FPID=" + rowData.FPBH + "&FPDM=" + rowData.FPDM + "&FPH=" + rowData.FPH + "&QYBM=" + rowData.QYBM + "&FPYSJG=" + 1 + "&FPHSZJE=" + rowData.FPHSZJE,
            width: "350px",
            height: "150px",
            callBack: function (iframeId) {
                top.frames[iframeId].SubmitForm();
                //$.modalClose("Form");
                //$('#btn_search').trigger('click');
            }
        });
    });
    


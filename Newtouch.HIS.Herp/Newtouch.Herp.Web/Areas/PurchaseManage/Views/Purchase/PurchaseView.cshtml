
@{
    ViewBag.Title = "Tra cứu đơn mua sắm";
    Layout = "~/Views/Shared/_Form.cshtml";
    var from = (ViewBag.from as string) ?? "";
}
<style>
    .table-responsive {
        border: 0;
    }

    .ui-jqgrid .ui-jqgrid-pager .ui-pager-table {
        width: 90%;
    }
</style>

<div class="topPanel" style="border-bottom:1px solid rgb(221, 221, 221);margin-bottom: 1%;">
    <div class="search">
        <table class="form">
            <tr>
                <th class="formTitle">Số đơn hàng:</th>
                <td class="formValue">
                    <input id="txt_ddbh" name="txt_ddbh" type="text" class="form-control form-an" placeholder="Vui lòng nhập Số đơn hàng" />
                </td>
                <th class="formTitle">Thời gian đơn hàng:</th>
                <td class="formValue" colspan="3">
                    <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; margin-top:10px;float:left;" value="@DateTime.Now.AddMonths(-6).ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                    <span style="margin-left:1%;float:left">—</span>
                    <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:43%; margin-top:10px;float:left;margin-left:1%;" value="@DateTime.Now.ToString("dd/MM/yyyy")" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                </td>
                <td style="padding-left: 20px;">
                    <button type="button" id="btn_search" class="btn btn-primary btn-md">&nbsp;Tra cứu&nbsp;</button>
                </td>
            </tr>
        </table>
    </div>
</div>
<!--Thông tin bệnh nhân bao gồm số bệnh án  họ tên -->
<form id="formPatSer" style="margin:2px;margin-top:10px;">
    <div class="gridPanel">
        <table id="GridList" rel="formPatSer"></table>
        <div id="gridPager" style="padding-right:20%"></div>
    </div>
</form>

<script>
    //Đối tượng window trước đó
    var prevWindow;
    if ('@(from)' !== '') {
        prevWindow = top.top.frames['@(from)'];
    }
    else {
        prevWindow = $.currentWindow();
    }

    $(function () {

        var obj = new Object;
        //obj.ddbh = $.request("ddbh");
        var searInfo = new gridList();
        //Tải dữ liệu
        //searInfo.init(obj);



        //Tra cứu
        $("#btn_search").click(function () {
            $("#GridList").jqGrid('setGridParam', {
                postData: {
                      kssj: $("#kssj").val(), jssj: $("#jssj").val(),ddzt:2
                },
                page: 1,
                url: "/PurchaseManage/Purchase/GetPurchaseGridJson",
            }).trigger('reloadGrid');
        });
    });

    function gridList() {
        var $gridList = $("#GridList");
        $gridList.dataGrid({
            url: "/PurchaseManage/Purchase/GetPurchaseGridJson",
            height: $(window).height() - 200,
            postData: { kssj: $("#kssj").val(), jssj: $("#jssj").val(),ddzt:2 },
            colModel: [

                { label: 'cgId', name: 'cgId', hidden: true },
                { label: 'Thời gian đơn hàng', name: 'ddsj', width: 60, align: 'left' },
                {
                    label: 'Điểm giao hàng', name: 'psdbm', width: 120, align: 'left', formatter: function (cellvalue) {
                        return "Bệnh viện Đa khoa Minh Đức";
                    }
                },
                {
                    label: 'Loại đơn hàng', name: 'ddlx', width: 80, align: 'left', formatter: function (cellvalue) {
                        if (cellvalue == 1) return 'Đơn hàng tự thực hiện của bệnh viện';
                        else if (cellvalue == 2) return 'Đơn hàng kho thuốc ủy thác';
                        else if (cellvalue == 3) return 'Đơn hàng thuốc đặc biệt';
                        else return '';
                    }
                },
                { label: 'Số đơn hàng', name: 'ddbh', width: 60, align: 'left' },
                { label: 'Số kế hoạch của bệnh viện', name: 'yyjhdh', width: 60, align: 'left' },
                { label: 'Ngày giao hàng muộn nhất', name: 'zwdhrq', width: 60, align: 'left' },
                {
                    label: 'Trạng thái đơn hàng', name: 'ddzt', width: 60, align: 'left', formatter: function (cellvalue) {
                        //if (cellvalue == 1) return 'Lưu';
                        //else if (cellvalue == 3) return 'Nộp';
                        //else if (cellvalue == 5) return 'Thu hồi';
                        //else if (cellvalue == 7) return 'Hủy';

                        if (cellvalue == 1) return 'Đã lưu';
                        else if (cellvalue == 2) return 'Đã truyền báo';
                        else if (cellvalue == 3) return 'Đã nghiệm thu';
                        else return '';
                    }
                },
                { label: 'Số dòng chi tiết', name: 'jls', width: 80, align: 'left' },
                { label: 'yfbm', name: 'yfbm', hidden: true },
                { label: 'bqbm', name: 'bqbm', hidden: true },

            ],

            multiselect: false,

            pager: "#gridPager",
            sortname: 'CreateTime',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                SearchConfirm();
            }
        });
    }

    //jqGrid Nhấp đúp để chọn dòng
    function btn_edit() {
        SearchConfirm();
    }

    function PurchaseDbGrid() {
        var $gridList = $("#GridList");
        var cgId = $gridList.jqGridRowValue().cgId;
        var obj = new Object();
        obj.cgId = cgId;
        obj.ddsj = $gridList.jqGridRowValue().ddsj;
        obj.czlx = $gridList.jqGridRowValue().czlx;
        obj.yybm = $gridList.jqGridRowValue().yybm;
        obj.psdbm = $gridList.jqGridRowValue().psdbm;
        obj.ddlx = $gridList.jqGridRowValue().ddlx;
        obj.ddbh = $gridList.jqGridRowValue().ddbh;
        obj.yyjhdh = $gridList.jqGridRowValue().yyjhdh;
        obj.zwdhrq = $gridList.jqGridRowValue().zwdhrq;
        obj.jls = $gridList.jqGridRowValue().jls;
        obj.ddzt = $gridList.jqGridRowValue().ddzt;
        prevWindow.GetQueryAjax(obj);
        //Đóng cửa sổ
        ReceiptCancle();
    }
    //Xác nhận Trang chính gọi
    function SearchConfirm() {
        PurchaseDbGrid();
    }

    //Hủy bỏ
    function ReceiptCancle() {
        $.modalClose();
    }
</script>



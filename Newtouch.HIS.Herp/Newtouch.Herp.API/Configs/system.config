<?xml version="1.0" encoding="utf-8"?>
<appSettings>
  <!-- ================== 1:Cấu hình tham số phần mềm hệ thống ================== -->
  <!-- Phiên bản phần mềm -->
  <add key="Version" value="1.00.00.0" />

  <!-- ================== 2:Cấu hình liên quan đến hệ thống phát triển ================== -->
  <!-- Reids của bộ nhớ đệm key Tiền tố -->
  <add key="Reids_Cache_Prefix" value="$CI_A$"/>
  <!-- của dịch vụ nhật ký Url -->
  <add key="His.Log.URL" value="http://localhost:9004/"/>

  <!-- ================== 3:Cấu hình liên quan đến nghiệp vụ ================== -->


  <!-- ================== Khác ================== -->
  <add key="vs:EnableBrowserLink" value="false"/>
  
</appSettings>
<?xml version="1.0" encoding="utf-8"?>
<appSettings>
	<!-- ================== 1: Cấu hình tham số phần mềm hệ thống ================== -->
	<!-- Phiên bản phần mềm -->
	<add key="Version" value="1.00.00.0" />

	<!-- ================== 2: Cấu hình liên quan đến hệ thống phát triển ================== -->
	<!-- Thời gian duy trì trạng thái đăng nhập (đơn vị: phút)-->
	<add key="LoginStatusKeepMinute" value="30" />
	<!-- Đá nhau giữa nhiều thiết bị đầu cuối -->
	<add key="EnableMultipleLoginLimit" value="false" />
	<!-- Đá nhau giữa nhiều thiết bị đầu cuối - cùng một tài khoản, số lượng trực tuyến đồng thời tối đa -->
	<add key="MultipleLoginLimit_Count" value="10" />
	<!-- Tiền tố key đệm Reids (để khi nhiều ứng dụng dùng chung một cơ sở dữ liệu thì tránh đệm bị lộn xộn) -->
	<add key="Reids_Cache_Prefix" value="$emr$"/>
	<!-- Id ứng dụng -->
	<add key="AppId" value="EMR"/>
	<add key="AppName" value="电子病历系统"/>

	<!-- Địa chỉ API - đổi danh tính người dùng ủy quyền thống nhất settapi-->
	<add key="UAUserInfoGetAPI" value="http://localhost:7002/api/UA/GetUserInfo/"/>
	<!-- domain của trang (nhúng trang của miền khác và thực thi js thì phải đặt thành cùng một miền)-->
	<add key="Document_Domain" value="127.0.0.1"/>

	<!-- Id tổ chức cấp cao nhất -->
	<add key="Top_OrganizeId" value="d8ee85f8-d8d1-4b5c-bd9e-1761f44242d8"/>
	<!-- Khi tạo người dùng mới, vai trò liên kết mặc định -->
	<add key="CreateUser_Default_RoleCode" value="DefaultRole"/>
	<!-- Host của trạm tĩnh -->
  	<add key="SiteStaticHost" value="http://localhost:8014/"/>
	<!-- Host api giao diện trạm bác sĩ -->
	<add key="SiteCISAPIHost" value="http://localhost:7003/"/>
	<!-- Url của dịch vụ nhật ký (không dùng nữa)-->
	<add key="His.Log.URL" value="http://222.212.90.137:16007  /"/>
	<!-- Công tắc - có tải cây menu bên trái hay không (mặc định tải) -->
	<add key="Is_LoadNavTree" value="true"/>
	<!-- Công tắc - có bật giám sát trang menu hay không (cây menu bên trái, nhấn, thời gian tải trang bên phải) -->
	<add key="Is_NavPageLoadMoniter" value="true"/>
	<!-- Dịch vụ báo cáo cũ, trường không dùng nữa -->
	<add key="ReportServer.HOST" value="http://59.80.30.184:16015/ReportServer/"/>

	<add key="MRUploadURL" value="http://127.0.0.1:33333/"/>

	<!-- ================== 3: Cấu hình liên quan đến nghiệp vụ ================== -->
	<!-- Đường dẫn lưu tệp bệnh án -->
	<add key="BlFilePath" value="~/File/住院病历/"/>
	<!-- Đường dẫn lưu tệp sao lưu bệnh án -->
	<add key="BlBackupFilePath" value="~/File/BackupsBL/"/>
	<!-- Số ngày giữ lại lịch sử, 1 là trong ngày-->
	<add key="KeepBackupFileDays" value="1"/>
	<!-- Đường dẫn sao lưu khi xóa tệp bệnh án -->
	<add key="BlFileDelPath" value="~/File/Del/"/>
	<!-- Đường dẫn lưu mẫu bệnh án -->
	<add key="BlTemplatePath" value="~/File/Template/"/>
	<!-- Đường dẫn sao lưu khi xóa mẫu bệnh án -->
	<add key="BlTemplateDelPath" value="~/File/Template/Del/"/>
	<!-- Mã đăng ký trình soạn thảo (bản cao cấp) -->
	<add key="EditorRegCode" value="047A8882B1EFB8C62B7EAD3D6D8704C0D6324A16D3069057A45714D46C649C6732B3D69EB30B5AE4C43C263D91BC40E82E3DCD1DEBE7BAFF15C19C3E2C807BBA432A7A52E6A76FFECE00883CD3DE9724A4" />
	<!-- Có bật tách trang đầu hồ sơ bệnh án hay không -->
	<add key="EnableWebHomePage" value="true"/>
	<!-- Có kết nối hệ thống phẫu thuật hay không -->
	<add key="EnableLinkToOR" value="true"/>
	<!-- Có kết nối hệ thống hồ sơ bệnh án hay không -->
	<add key="EnableLinkToMRMS" value="true"/>
	<!-- ================== Khác ================== -->
	<add key="vs:EnableBrowserLink" value="false"/>
	<!-- Mã cơ sở y tế chỉ định -->
	<add key="YBOrgCode" value="3011679"/>

	<!--  Địa chỉ dịch vụ Reports báo cáo-->
	<add key="ReportUrl"  value="http://localhost:8000/"/>
	<add key="ReportSystemCode"  value="EMR"/>

 	 <!--  Địa chỉ dịch vụ tham chiếu tài nguyên trình soạn thảo bệnh án-->
  	<add key="EmrEdiForUrl" value="http://localhost:8020/" />
  	<!--  Địa chỉ dịch vụ trình soạn thảo ky-->
              <add key="KyEmrEdiForUrl" value="http://127.0.0.1:8012" />
  	<!-- Cấu hình trung tâm giao diện  -->
	<add key="Token_ApiManage" value="API.Manage"/>
	<add key="SiteAuthCenterHost" value="http://localhost:8015/"/>
	<add key="SiteApiManageHost" value="http://localhost:8016/"/>
</appSettings>
@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<form id="form1">
    <div style="padding-top: 20px; margin-right: 30px;">
        <table class="form">
            <tr>
                <th class="formTitle">Cấp trên:</th>
                <td class="formValue">
                    <select id="ParentId" name="ParentId" class="form-control">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <th class="formTitle"><span class="required">*</span>Tên:</th>
                <td class="formValue">
                    <input type="hidden" name="OrganizeId" id="OrganizeId" />
                    <input id="Name" name="Name" type="text" class="form-control required" placeholder="Vui lòng nhập tên" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Menu tiếng Anh:</th>
                <td class="formValue">
                    <input id="EnName" name="EnName" type="text" class="form-control" placeholder="" />
                </td>
                <th class="formTitle">Ứng dụng bên ngoài:</th>
                <td class="formValue">
                    <input id="AppId" name="AppId" type="text" class="form-control" placeholder="" />
                </td>
            </tr>
            <tr>
                <th class="formTitle">Liên kết:</th>
                <td class="formValue">
                    <input id="UrlAddress" name="UrlAddress" type="text" class="form-control" />
                </td>
                <th class="formTitle"><span class="required">*</span>Mục tiêu:</th>
                <td class="formValue">
                    <select id="Target" name="Target" class="form-control required">
                        <option value="">==Vui lòng chọn==</option>
                        <option value="expand" title="expand">Không có trang</option>
                        <option value="iframe" title="iframe">Trang khung</option>
                        <option value="open" title="open">Trang bật lên</option>
                        <option value="blank" title="blank">Cửa sổ mới</option>
                        <option value="subpage" title="subpage">Trang con</option>
                        <option value="toplocation" title="toplocation">Cửa sổ hiện tại</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Biểu tượng:</th>
                <td class="formValue">
                    <div class="input-group">
                        <input id="Icon" name="Icon" type="text" class="form-control">
                    </div>
                </td>
                <th class="formTitle">Sắp xếp:</th>
                <td class="formValue">
                    <input id="px" name="px" type="text" class="form-control" placeholder="Vui lòng nhập thứ tự sắp xếp" />
                </td>
            </tr>
            <tr>
                <th class="formTitle" style="height: 35px;">Lựa chọn:</th>
                <td class="formValue" style="padding-top: 1px;">
                    <div class="ckbox">
                        <input id="zt" name="zt" type="checkbox" checked="checked"><label for="zt">Có hiệu lực</label>
                    </div>
                </td>
            </tr>
            <tr>
                <th class="formTitle" valign="top" style="padding-top: 5px;">
                    Giới thiệu:
                </th>
                <td class="formValue" colspan="3">
                    <textarea id="Description" name="Description" class="form-control" style="height: 100px;"></textarea>
                </td>
            </tr>
        </table>
    </div>
</form>

<script>
    var keyValue = $.request("keyValue");
    $(function () {
        initControl();
        if (!!keyValue) {
            $.najax({
                url: "/SystemManage/SysModule/GetFormJson",
                data: { keyValue: keyValue },
                dataType: "json",
                success: function (data) {
                    $("#form1").formSerialize(data);
                }
            });
        }
        else {
            $('#zt').click(function () {
                return false;
            });
        }
    });

    function initControl() {
        $("#Target").select2();
        $("#ParentId").bindSelect({
            url: "/SystemManage/SysModule/GetTreeSelectJson",
        });
    }

    function AcceptClick(callBack) {
        if (!$('#form1').formValid()) {
            return false;
        }
        $.submitForm({
            url: "/SystemManage/SysModule/SubmitForm?keyValue=" + keyValue,
            param: $("#form1").formSerialize(),
            success: function () {
                callBack();
                $.modalClose();
            }
        })
    }
</script>
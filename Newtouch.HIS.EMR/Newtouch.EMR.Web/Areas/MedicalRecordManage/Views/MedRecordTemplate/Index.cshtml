@using Newtouch.Infrastructure;
@using NewtouchHIS.Lib.Framework.Operator;
@{
    Layout = "~/Views/Shared/_Index.cshtml";
    var opeator = OperatorProvider.GetCurrent();
}

<div class="topPanel">
    <div class="toolbar">
        <div class="btn-group">
            <a id="mb-add" authorize="yes" class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới</a>
        </div>
        <div class="btn-group">
            <a id="mb-edit" authorize="yes" class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa</a>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary" onclick="btn_delete()"><i class="fa fa-pencil-square-o"></i>Xóa</a>
        </div>
    </div>
    <div class="search">
        <table>
            <tr>
                <td>
                    <div class="input-group">
                        <input id="txt_keyword" type="text" class="form-control" placeholder="Mẫu tên/Mã mẫu" style="width: 180px;">
                        <span class="input-group-btn">
                            <button id="btn_search" type="button" class="btn  btn-primary"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
<div class="gridPanel">
    <table id="gridList" style="width:100%;"></table>
    <div id="gridPager"></div>
</div>


<script>
    $(function () {
        initControl();
        gridList();
    })
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            postData: { keyword: $("#txt_keyword").val(), organizeId: $("#OrganizeId").val() },
            url: "/MedicalRecordManage/MedRecordTemplate/GetGridJson",
            height: $(window).height() - 128,
            colModel: [
                { label: "Khóa chính", name: "Id", hidden: true, key: true },
                { label: "Loại bệnh án", name: "bllx", hidden: true },
                 { label: 'Mẫu tên', name: 'mbmc', width: 150, align: 'left' },
                 {
                    label: "Nguồn", name: "Memo", width: 30, align: 'left', formatter: function (val) {
                        if (val != "" && val!=null)
                        {
                            return "[Chuyển]";
                        }
                        else
                        {
                            return "";
                        }
                    }
                 },
                 { label: "Quyền mẫu", name: "mbqx", align: 'left', hidden: true },
                { label: "Loại mẫu", name: "bllxmc", width: 120, align: 'left' },
                 {
                     label: 'Quyền cấu hình', name: 'mbqxmc', width: 80, align: 'center',
                     formatter: function (val, options, rowObject) {
                         if (rowObject.mbqx== '@Html.Raw(((int)Enummbqx.prv))')
                             return "Cá nhân"
                         else if (rowObject.mbqx == '@Html.Raw(((int)Enummbqx.dept))')
                             return "Khoa"
                         else
                             return "Chung";
                     }
                 },
                 { label: 'Đường dẫn', name: 'mblj', width: 200, align: 'left' },
                 { label: 'Có để trống không', name: 'Isempty', width: 60, align: 'center',
                    formatter: function (cellvalue) { return cellvalue == "1" ? "Có" : "Không"; }
                },
                {
                    label: 'Có không tải lên bảo hiểm y tế', name: 'IsYB', width: 80, align: 'center',
                    formatter: function (cellvalue) { return cellvalue == "1" ? "Có" : "Không"; }
                },
                {
                    label: 'Loại nghiệp vụ', name: 'mzbz', width: 80, align: 'center',
                    formatter: function (cellvalue) { return cellvalue == "1" ? "Ngoại trú" : "Nội trú"; }
                },
                 { label: "Hiệu lực", name: "zt", width: 50, align: "center", formatter: function (cellvalue) { return cellvalue == "1" ? "<i class=\"fa fa-toggle-on\"></i>" : "<i class=\"fa fa-toggle-off\"></i>"; } },
                 { label: 'Người tạo', name: 'CreatorCode', width: 100, align: 'center' },
                 { label: 'Thời gian tạo', name: 'CreateTime', width: 120, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                 { label: 'Sửa đổi lần cuối', name: 'LastModifierCode', width: 100, align: 'center' },
                 { label: 'Thời gian sửa đổi lần cuối', name: 'LastModifyTime', width: 120, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } }
            ],
            pager: "#gridPager",
            sortname: 'CreateTime desc',
            viewrecords:true
        });
        $("#btn_search").click(function () {
            $("#gridList").jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword").val(), organizeId: $("#OrganizeId").val() },
            }).trigger('reloadGrid');
        });
    }

    //Sự kiện Enter
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    function operAuthCk(ysgh,mbqx)
    {
        return true;
        if ('@opeator.IsRoot' == 'False' && '@opeator.IsAdministrator' == 'False' && '@opeator.IsHospAdministrator' == 'False') {
            if (ysgh != '@opeator.rygh') {  //Chỉ mẫu cá nhân mới có thể sửa/xóa
                return false;
            }
            else {
                return true;
            }
        }
        else
            return true;
    }

    function btn_edit() {
        var seleRowid = jQuery("#gridList").jqGrid("getGridParam", "selrow");
        if (!(seleRowid)) { 
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }

        var keyValue = $("#gridList").jqGridRowValue().Id;
        var rowData = $("#gridList").jqGrid("getRowData", seleRowid);
        if (operAuthCk(rowData.CreatorCode,rowData.mbqx))
        {
            $.modalOpen({
                id: "Form",
                title: "Sửa bệnh án mẫu",
                url: "/MedicalRecordManage/MedRecordTemplate/Form?keyValue=" + keyValue + "&bllx=" + rowData.bllx,
                width: "700px",
                height: "650px",
                btn: null,
                callBack: function (iframeId) {
                    top.frames[iframeId].submitForm();
                }
            });
        }
        else
        {
            $.modalAlert("Không đủ quyền, Nếu cần vui lòng liên hệ quản trị viên", 'warning');
        }
            return;
    }

    function btn_add() {
        $.modalOpen({
            id: "Form",
            title: "Tạo mới mẫu bệnh án",
            url: "/MedicalRecordManage/MedRecordTemplate/Form",
            width: "700px",
            height: "650px",
            btn: null,
            callBack: function (iframeId) {
                top.frames[iframeId].submitForm();
            }
        });
    }


    function btn_delete() {
        var keyValue = $("#gridList").jqGridRowValue().Id;
        if (!!!keyValue) {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
        var rowData = $("#gridList").jqGrid("getRowData", keyValue);
        if (operAuthCk(rowData.CreatorCode, rowData.mbqx)) {
            $.deleteForm({
                url: "/MedicalRecordManage/MedRecordTemplate/DeleteForm",
                param: { keyValue: keyValue },
                success: function (data) {
                    if (data.state == "success") {
                        $.modalAlert('Xóa thành công', 'success');
                    }
                    else {
                        $.modalAlert(data.message, 'error');
                    }
                    $("#gridList").trigger("reloadGrid");
                }
            })
        }
        else {
            $.modalAlert("Không đủ quyền, Nếu cần vui lòng liên hệ quản trị viên", 'warning');
            
        }
    }

    function initControl() {

    }
</script>

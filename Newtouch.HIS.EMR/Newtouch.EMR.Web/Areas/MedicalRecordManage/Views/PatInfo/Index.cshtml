@model dynamic
@{
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    #div_ycq {
        display: none;
    }

    #div_my {
        display: none;
    }

    #txt_cwmc {
        margin: 7px 15px;
        height: 21px;
        width: 100px;
        padding: 0 10px;
        border: 0;
        border-bottom: 1px solid #ccc;
    }

    .li-refresh {
        background-color: #00a0e9;
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
    }

        .li-refresh span {
            margin: 10px 15px;
        }

    #div_zbq {
        overflow-y: auto;
    }

    .ul-zbq {
        width: 100%;
        height: 95%;
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .ul-zbq li {
            margin: 25px;
            display: inline;
            float: left;
            height: 130px;
            width: 170px;
            border: 1px solid #ccc;
            border-radius: 5px 5px 0 0;
            -webkit-box-shadow: #666 3px 4px 8px;
            -moz-box-shadow: #666 3px 4px 8px;
            box-shadow: #666 3px 4px 8px;
        }

    .dv-cwmc {
        background-color: #AFEEEE;
        line-height: 25px;
        text-align: center;
        padding-left: 10px;
    }

        .dv-cwmc i {
            line-height: 25px;
            float: left;
        }

    .bedmouseover {
        background-color: #00a0e9 !important;
    }

    .bedbordermouseover {
        border-color: #00a0e9 !important;
   
    }

    .bedchoose {
        background-color: #dd4b39 !important;
    }

    .bedborderchoose {
        border-color: #dd4b39 !important;
    }

    .sp-leave {
        width: 20px;
        height: 20px;
        float: right;
        margin-right: 20px;
    }

    .sp-leave-1 {
        background-color: pink;
    }

    .sp-leave-2 {
        background-color: blue;
    }

    .sp-leave-3 {
        background-color: yellow;
    }

    .dv-patxm {
        line-height: 25px;
        padding-left: 10px;
    }

        .dv-patxm i {
            line-height: 20px;
            width: 20px;
            color: #ffffff;
            text-align: center;
            margin-right: 10px;
        }

    .dv-doctorxm {
        line-height: 25px;
        padding-left: 10px;
    }

        .dv-doctorxm i {
            line-height: 20px;
            width: 20px;
            text-align: center;
            margin-right: 10px;
            border: 1px solid #ccc;
        }


    .dv-gms {
        line-height: 25px;
        padding-left: 10px;
    }

    .dv-patType {
        line-height: 25px;
        padding-left: 10px;
    }

    .footerright {
        width: 20px;
        float: left;
    }

    .ui-pg-input {
        display: inline-block;
        height: auto;
        width: auto;
        font-size: .9em;
        margin: 0;
        line-height: inherit;
        padding: 0px 0px;
        height: 20px;
        text-align: center;
        box-shadow: none;
        -webkit-box-shadow: none;
        border: 1px solid #ddd;
        border-radius: 4px;
    }
</style>
<ul class="nav nav-tabs navb-bg" role="tablist">
    <li role="presentation" id="linkzbq" class="active">
        <a href="#div_zbq" role="tab" data-toggle="tab">Đang nằm viện</a>
    </li>
    <li role="presentation" id="linkycq">
        <a href="#div_ycq" role="tab" data-toggle="tab">Ra viện</a>
    </li>
    <li role="presentation"  id="linkmy">
        <a href="#div_my" role="tab" data-toggle="tab">Của tôi</a>
    </li>
    <li>
        <table class="form" style="width:460px">
            <tr>
                <td class="formValue formDdlSelectorTd">
                    <select id="sel_inpatientArea" class="form-control" style="width:90px">
                        <option value="">==Vui lòng chọn==</option>
                    </select>
                </td>
                <td class="formValue ">
                    <input type="button" id="btn_syncPat" value="Đồng bộ bệnh nhân" class="btn btn-default" onclick="btn_SyncPatinfo()"/>
                </td>
                
                    <select id="sel_inpatienttype" class="form-control">
                        <option value="">Tất cả</option>
                        <option value="@ViewBag.ysgh">Phụ trách</option>
                    </select>

                <td>
                    <input id="txt_cwmc" placeholder="nhập số giường,Số nhập viện, Họ tên" />
                </td>
                <td style="padding-left:20px;">
                    <i class="fa fa-id-card-o" title="Chế độ thẻ giường" style="line-height:40px" hidden></i>
                    <i class="fa fa-list" title="Chế độ danh sách" style="line-height:40px"></i>
                </td>
            </tr>
        </table>
    </li>
    <li class="li-refresh" style="float: right;">
        <span class="glyphicon glyphicon-refresh" aria-hidden="true" onclick="newtouch_event_f4()"></span>
    </li>
</ul>
<div class="panel-default">
    <div id="div_zbq" class="panel">
        <ul class="ul-zbq"></ul>
        <table id="div_zbqList"></table>
        <div style="height:22px;" class="footer">
            <div class="left" style="float:left;width:230px">　Tìm thấy <span class="records"></span> Dòng bản ghi</div>
            <div class="right" style="width:292px;height:22px; float:right">
                <div class="footerright">
                    <span class="glyphicon glyphicon-step-backward"></span>
                </div>
                <div class="footerright">
                    <span class="glyphicon glyphicon-backward"></span>
                </div>
                <div class="footerright">
                    <span class="ui-separator"></span>
                </div>
                <div style="float:left; margin:auto 10px">
                    <input class="ui-pg-input" type="text" size="2" maxlength="7" value="1" role="textbox">
                    Tổng cộng<span id="sp_1_gridPager"></span>Trang
                </div>
                <div class="footerright">
                    <span class="ui-separator"></span>
                </div>
                <div class="footerright">
                    <span class="glyphicon glyphicon-forward"></span>
                </div>
                <div class="footerright">
                    <span class="glyphicon glyphicon-step-forward"></span>
                </div>
                <div class="footerright">
                </div>
            </div>
        </div>
    </div>
    <div id="div_ycq"  class="panel">
        <div cl>
            <table class="form" style="margin-left:5px;">
                <tr>
                    <th class="formTitle">Ngày bắt đầu ra khỏi khu:</th>
                    <td class="formValue">
                        <input id="txt_ksrq" type="text" class="form-control input-wdatepicker formClearIgnore" onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy'})" value="@DateTime.Now.ToString("yyyy-MM-01")" />
                    </td>
                    <th class="formTitle">Ngày kết thúc:</th>
                    <td class="formValue">
                        <input id="txt_jsrq" type="text" class="form-control input-wdatepicker formClearIgnore" onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" value="@DateTime.Now.ToString("dd/MM/yyyy")" />
                    </td>
                    <th class="formTitle" style="width:120px">Số nhập viện/Họ tên/Số thẻ:</th>
                    <td class="formValue">
                        <input type="text" id="ycq_keyword" name="ycq_keyword" class="form-control" placeholder="Ít nhất1Ký tự" />
                    </td>
                    <td class="formTitle" colspan="2" style="padding-left:20px">
                        <input type="button" id="btn_search" class="btn btn-md btn-primary" value="Tìm kiếm" style="margin-right:10px" />
                    </td>
                    <td></td>
                    <td></td>
                </tr>
            </table>
            <table id="div_ycqList"></table>
            <div id="div_ycqgridPager"></div>
        </div>

    </div>
    <div id="div_my" class="panel">
        <table class="form">
            <tr>
                
                <td class="formValue">
                    <input id="txt_myksrq" type="text" class="form-control input-wdatepicker formClearIgnore" onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy'})" value="@DateTime.Now.ToString("yyyy-MM-01")" />
                </td>
                <th class="formTitle">Ngày kết thúc:</th>
                <td class="formValue">
                    <input id="txt_myjsrq" type="text" class="form-control input-wdatepicker formClearIgnore" onclick="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" value="@DateTime.Now.ToString("dd/MM/yyyy")" />

                <th class="formTitle" style="width:120px">Số nhập viện/Họ tên/Số thẻ:</th>
                <td class="formValue">
                    <input type="text" id="my_keyword" name="my_keyword" class="form-control" placeholder="Ít nhất1Ký tự" />
                </td>
                <td class="formTitle" colspan="2" style="padding-left:20px">
                    <input type="button" id="btn_mysearch" class="btn btn-md btn-primary" value="Tìm kiếm" style="margin-right:10px" />
                </td>
                <td></td>
                <td></td>
            </tr>
        </table>
        <table id="div_myList"></table>
        <div id="div_mygridPager"></div>
    </div>
</div>
<script type="text/javascript">
    var currentobj = [];
    var currentpage;//Trang hiện tại
    var totalpage;//Tổng cộng..Trang

    $(function () {
        initinpatientList();
    });

    function initinpatientList() {
        $("#sel_inpatientArea").bindSelect({
            url: "/SystemManage/BaseData/GetAuthedWardSelectJson",
        });

        $("#sel_inpatientArea").removeAttr("style");

        var lastbqval = localStorage.getItem("lastabq");
        var selectval = "";
        if (lastbqval == typeof (undefined) || lastbqval == "" || lastbqval == null || lastbqval == 'null') {

            $('#sel_inpatientArea option:eq(1)').attr('selected', 'selected');


            selectval = $('#sel_inpatientArea ').val();

        } else {
            //Gán giá trị
            selectval = lastbqval;
        }
        if (selectval !== "") {
            $('#sel_inpatientArea').val(selectval).trigger("change", false);
        }
    }

    $('#txt_cwmc').keyup(function () {
        commonsearch();
    });

    function newtouch_event_f4()
    {
        commonsearch();
    }

    $('#sel_inpatienttype,#sel_inpatientArea').change(function () {
        if ($(this).attr("id") == "sel_inpatientArea") {
            var $thisval = $(this).val();
            var flag = false;
            $("#sel_inpatientArea option").each(function () {
                if ($thisval == $(this).val()) {
                    flag = true;
                    localStorage.removeItem("lastabq");
                    localStorage.setItem("lastabq", $(this).val());
                }
            });
            if (!flag) {//Nếu hộp thả xuống không tìm thấy tùy chọn đó thì không chọn
                $(this).val("");
            }
        }
        commonsearch();
    });

    function commonsearch() {
        $(".ul-zbq").children("li").remove();
        ajaxrequestzbq();
        ajaxrequestycq();
        ajaxrequestmy();
    }

    function validateSearch() {
        var bqval = $('#sel_inpatientArea').val();
        if (bqval == "") {
            $.modalAlert("Chưa chọn khu bệnh", 'warning');
            return false;
        }
        return true;
    }

    $('.fa-id-card-o,.fa-list').click(function () {
        clearSelectpatient();
        //Nhấn chế độ danh sách
        if ($(this).attr("Class") == "fa fa-list") {
            $('.ul-zbq,.fa-list').hide();
            $('#gbox_div_zbqList,.fa-id-card-o').show();
            $('#div_zbqList').jqGrid("clearGridData");
            $('#div_zbqList').newtouchLocalDataGrid(null, zbqPatientList);
        } else if ($(this).attr("Class") == "fa fa-id-card-o") {//Nhấn chế độ card
            $('.ul-zbq,.fa-list').show();
            $('#gbox_div_zbqList,.fa-id-card-o').hide();
        }
    });

    $('#btn_search').click(function () {
        ajaxrequestycq();
    });
    $('#btn_mysearch').click(function () {
        ajaxrequestmy();
    });
    //Xóa bệnh nhân đã chọn
    function clearSelectpatient() {
        currentPatient = {};
        //$('#currentxm').html("");
        //$('#currentsex').html("");
        //$('#currentage').html("");
        //$('#currentbrxzmc').html("");
    }
    //Chọn bệnh nhân hiện tại
    function onSelectpatient(obj) {
        currentPatient.xm = obj.xm;//Tên bệnh nhân
        currentPatient.sex = obj.sex;//Giới tính
        currentPatient.age = obj.age;//Tuổi
        currentPatient.zyh = obj.zyh;//Số nhập viện
        currentPatient.brxzmc = obj.brxzmc;//Tính chất bệnh nhân
    }
    /****Xử lý dữ liệu*****/
    //Yêu cầu thông tin bệnh nhân trong khu bệnh
    function ajaxrequestzbq() {
        if (validateSearch()) {
            $.najax({
                url: "@("GetzbqPatientList")",
                dataType: "json",
                data: { page: $('.ui-pg-input').val(), bqCode: $('#sel_inpatientArea').val(), ys: $('#sel_inpatienttype').val(), bedCode: $('#txt_cwmc').val() },
                type: "POST",
                success: function (respdata) {
                    currentpage = respdata.page;//Trang hiện tại
                    totalpage = respdata.total;//Tổng cộng..Trang
                    $('.ui-pg-input').val(respdata.page);
                    $('#sp_1_gridPager').text(respdata.total);
                    $('.records').text(respdata.records);
                    $(".ul-zbq").children("li").remove();
                    zbqPatientList = respdata.rows;//Tạo bệnh nhânli
                    $('#div_zbqList').jqGrid("clearGridData");
                    $('#div_zbqList').newtouchLocalDataGrid(null, zbqPatientList);
                    createli(respdata.rows);
                }
        });
    }
    }

    //Tạo bệnh nhânli
    function createli(respdata) {
        $.jsonWhere(respdata, function (v) {
            var li = '  <li>'
                + ' <div class="dv-cwmc">'
                + ' <i class="fa fa-bed" aria-hidden="true"></i><span style="user-select:none">' + v.cwmc + '</span>'
                + ' </div >'
                + ' <div class="dv-patxm" data-zyh=' + v.zyh + ' data-age=' + v.age + ' data-xm=' + v.xm + ' data-sex=' + v.sex + ' data-brxzmc=' + v.brxzmc + '>'
                + ' <i class="fa fa-' + ($.getGender(v.sex) == 'Nam' ? "mars" : "venus") + '" style="background-color:' + ($.getGender(v.sex) == 'Nam' ? " #00a0e9" : "pink") + '; border: 1px solid ' + ($.getGender(v.sex) == 'Nam' ? " #00a0e9" : "pink") + ';" aria-hidden="true"></i><span title="Tên bệnh nhân">' + v.xm + '</span>'
                + ' </div>'
                + ' <div class="dv-doctorxm" title="Tên bác sĩ">'
                + ' <i class="fa fa-user-md"></i><span>' + v.ysmc + '</span>'
                + ' </div>'
                + ' <div class="dv-gms" title="Tiền sử dị ứng">'
                + ' <span>' + (v.gms == null ? "Không có" : v.gms) + '</span>'
                + ' </div>'
                + ' <div class="dv-patType">'
                + ' <span title="Tính chất bệnh nhân">' + v.brxzmc + '</span>'
                + ' <span title="Nguy kịch cấp độ">' + $.enum.getDescByValue("EnumWzjb", v.wzjb) + '</span>'
                + ' <span>' + v.brzt + '</span>'
                + ' <label title="Cấp độ điều dưỡng" class="sp-leave sp-leave-' + v.hljb + '" data-hllb=' + v.hljb + ' title="Cấp độ điều dưỡng:' + v.hljb + ' cấp"></label>'
                + ' </div>'
                + ' </li >';
            $('.ul-zbq').append(li);
        });
    }
    /****Thẻ tab****/
    //Đối tượng bệnh nhân đang được chọn

    var currentPatient = {};
    var zbqPatientList;
    $(function () {
        init();
        //Chuyển đổi tab thống kê tìm kiếm
        $(".nav-tabs li").click(function () {
            clearSelectpatient();
            if ($(this)[0].id === "linkzbq") {
                $("#div_zbq").show(300);
                $("#div_ycq").hide(500);
                $("#div_my").hide(500);
                $('.ul-zbq,.fa-list').show();
                $('#gbox_div_zbqList,.fa-id-card-o').hide();
                $(".ul-zbq li").each(function () {
                    if ($(this).find(".dv-cwmc").hasClass("bedchoose")) {
                        $(this).find(".dv-cwmc").removeClass("bedchoose");
                        $(this).trigger("mouseout");
                    }
                    if ($(this).hasClass("bedborderchoose")) {
                        $(this).removeClass("bedborderchoose");
                    }
                });
                ajaxrequestzbq();
            } else if ($(this)[0].id === "linkycq") {
                $("#div_ycq").show();
                $("#div_zbq").hide();
                $("#div_my").hide();
                $('.fa-id-card-o,.fa-list').hide();
                //commonsearch();
                ajaxrequestycq();
            } else if ($(this)[0].id === "linkmy") {
                $("#div_my").show();
                $("#div_zbq").hide();
                $("#div_ycq").hide();
                $('.fa-id-card-o,.fa-list').hide();
                
                ajaxrequestmy();
            }
        });
        $(".li-refresh").click(function () {

        });
        $("#div_zbq").height($(window).height() - 55);
        $('.ul-zbq').on("mouseover", "li", function () {
            if (!$(this).find(".dv-cwmc").hasClass("bedchoose")) {
                $(this).find(".dv-cwmc").css("background-color", "#00a0e9");
                $(this).find(".dv-cwmc").css("color", "#fff");
                $(this).css("border-color", "#00a0e9");
            }
        });

        $('.ul-zbq').on("mouseout", "li", function () {
            if (!$(this).find(".dv-cwmc").hasClass("bedchoose")) {
                $(this).find(".dv-cwmc").css("background-color", "#AFEEEE");
                $(this).css("border-color", "#AFEEEE");
                $(this).find(".dv-cwmc").css("color", "black");
            }
        });
        $('.ul-zbq').on("click", "li", function () {
            $(".ul-zbq li").each(function () {
                if ($(this).find(".dv-cwmc").hasClass("bedchoose")) {
                    $(this).find(".dv-cwmc").removeClass("bedchoose");
                    $(this).trigger("mouseout");
                }
                if ($(this).hasClass("bedborderchoose")) {
                    $(this).removeClass("bedborderchoose");
                }
            });
            $(this).find(".dv-cwmc").addClass("bedchoose");
            $(this).addClass("bedborderchoose");
            currentobj = {
                "zyh": $(this).find(".dv-patxm").attr('data-zyh'),
                "xm": $(this).find(".dv-patxm").attr('data-xm'),
                "sex": $(this).find(".dv-patxm").attr('data-sex'),
                "age": $(this).find(".dv-patxm").attr('data-age'),
                "brxzmc": $(this).find(".dv-patxm").attr('data-brxzmc'),
                "RecordStu":'@((int)EnumRecordStu.wtj)'
            };
            onSelectpatient(currentobj);

        });
        $('.ul-zbq').on("dblclick", "li", function () {
            sessionStorage.setItem('currentobj', JSON.stringify(currentobj));

            top.top.$.Newtouchtab.tryCloseTab({ name: "Quản lý bệnh án", url: "/MedicalRecordManage/PatInfo/PatMedRecordList" });
            top.top.$.Newtouchtab.addTabWithOutMenu({ name: "Quản lý bệnh án", enName: "", url: "/MedicalRecordManage/PatInfo/PatMedRecordList" });
        });
    });

    function init()
    {
        initzbq();
        initycq();
        initmy();
    }

    /****Tại khu bệnh****/

    function initzbq() {
        $(".ul-zbq").children("li").remove();
        //Khởi tạojqgrid
        div_zbqList();
        $('#gbox_div_zbqList').hide();//Ẩn mặc địnhjqgrid
        //Yêu cầu thông tin bệnh nhân trong khu bệnh
        //ajaxrequestzbq();
    }



    function div_zbqList() {
        $('#div_zbqList').newtouchLocalDataGrid({
            height: $(window).height() - 120,
            autowidth: true,
            unwritten: false,
            rownumbers: true,
            colModel: [
                { label: 'Id', name: 'Id', hidden: true },
                { label: 'Số giường', name: 'cwmc', align: 'center', width: 150 },
                { label: 'Họ tên', name: 'xm', align: 'center', width: 150 },
                {
                    label: 'Giới tính', name: 'sex', align: 'center', width: 100, formatter: function (val) {
                        return $.getGender(val);
                    }
                },
                { label: 'Tuổi', name: 'age', align: 'center', width: 70 },
                { label: 'Số nhập viện', name: 'zyh', align: 'center', width: 50 },
                { label: 'Ngày nhập viện', name: 'ryrq', align: 'center', width: 140, formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d' } },
                {
                    label: 'Cấp độ điều dưỡng', name: 'hljb', align: 'center', width: 100, formatter: function (val) {
                        return $.enum.getDescByValue("EnumHljb", val);
                    }
                },
                { label: 'Chẩn đoán nhập viện', name: 'zdmc', width: 100, align: 'left' }
            ],
            onSelectRow: function (rowid) {
                var obj = $("#div_zbqList").jqGrid('getRowData', rowid);
                onSelectpatient(obj);
            }, ondblClickRow: function (rowid) {
                var obj = $("#div_zbqList").jqGrid('getRowData', rowid);
                onSelectpatient(obj);
                sessionStorage.setItem('currentobj', JSON.stringify(currentPatient));
                top.top.$.Newtouchtab.tryCloseTab({ name: "Quản lý bệnh án", url: "/MedicalRecordManage/PatInfo/PatMedRecordList" });
                top.top.$.Newtouchtab.addTabWithOutMenu({ name: "Quản lý bệnh án", enName: "", url: "/MedicalRecordManage/PatInfo/PatMedRecordList" });
            }
        });
    }

    /****Đã ra khỏi khu******/
    function initycq() {
        div_ycqList();

        $('#ycq_keyword').newtouchBatchFloatingSelector({
            width: 450,
            height: 200,
            caption: "Chọn bệnh nhân",
            url: "@Url.Action("patientFloatingSelectorSource")",
            ajaxparameters: function ($thisinput) {
                var keyword = $thisinput.val().trim();
                return "keyword=" + keyword;
            },
        itemdbclickhandler: function ($thistr, $thisinput) {
            $('#ycq_keyword').val($thistr.attr('data-zyh'));
        },
        colModel: [
            { label: 'Khóa chính', name: 'Id', hidden: true },
            { label: 'Số nhập viện', name: 'zyh', width: 100, align: 'center' },
            { label: 'Số bệnh án', name: 'blh', width: 90, align: 'center' },
            { label: 'Họ tên', name: 'xm', width: 80, align: 'center' },
            { label: 'Ngày tháng năm sinh', name: 'birth', hidden: true, width: 100, align: 'center' },
            {
                label: 'Giới tính', name: 'xb', width: 50, align: 'center', formatter: function (cellvalue) {
                    return $.getGender(cellvalue);
                }
            },
            { label: 'Tuổi', name: 'nlshow', width: 50, align: 'center' },
            { label: 'Ngày nhập viện', name: 'ryrq', hidden: true }
        ]
    });
    }

    function div_ycqList() {

    /***Đồng bộ thông tin bệnh nhân****/
    function btn_SyncPatinfo()
    {
        $.ajax({
            type: "POST",
            url: "/MedicalRecordManage/PatInfo/GetPatinfo",
            dataType: "json",
            async: false,
            success: function (ajaxresp) {
                if (ajaxresp.state == "error" || ajaxresp.state == "") {
                    setTimeout(function () {
                        $.modalMsg(ajaxresp.message, 'error');
                    }, 1000);

                }
                else {
                    setTimeout(function () {
                        $.modalMsg('Đồng bộ thành công', 'success');
                    }, 1000);

                }
                ajaxrequestycq();
                ajaxrequestzbq();
                ajaxrequestmy();
            }
        });
    }

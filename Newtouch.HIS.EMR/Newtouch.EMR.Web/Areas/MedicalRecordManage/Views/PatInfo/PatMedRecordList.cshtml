@using NewtouchHIS.Lib.Framework.Operator;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
    var opeator = OperatorProvider.GetCurrent();
    var EnableLinkToMRMS = EmrConfig.GetAppConfigValue("EnableLinkToMRMS");
}
<script src="~/Content/js/BootstrapMenu.min.js"></script>

<style>
    ul, li {
        padding: 0;
        margin: 0;
        list-style: none;
    }

        ul#allKindPat {
            width: 25px;
            float: left;
        }

            ul#allKindPat li.selectedli {
                background-color: rgba(111, 243, 173, 0.5);
                text-decoration-color: white;
            }

            ul#allKindPat li {
                background-color: rgba(215, 242, 252, 0.86);
                margin-bottom: 2px;
                text-align: center;
                vertical-align: middle;
                touch-action: manipulation;
                cursor: pointer;
                user-select: none;
                padding: 3px 6px;
                border-width: 1px;
                border-style: solid;
                border-color: transparent;
                border-image: initial;
                border-radius: 4px;
            }

    .dv-left {
        width: 40%;
        float: left;
    }

    .dv-right {
        float: left;
        margin-left: 5px;
        width: 58%;
        /*background-color:*/
    }

    #patList {
        float: left;
        background-color: #FFF;
    }

    .clearboth {
        clear: both;
    }
</style>
<div id="patList" class="gridPanel dv-left">
    <div class="topPanel">
        <div class="search">
            <table>
                <tr>
                    <td>
                        <select id="sel_inpatientArea" class="form-control" style="width:50px">
                            <option value="">==Vui lòng chọn==</option>
                        </select>
                    </td>
                    <td style="width:100%">
                        <div id="dv_tool">
                            <div class="input-group">
                                <input id="txt_keyword" type="text" class="form-control" placeholder="Tên bệnh nhân/Số nhập viện" style="width:180px;">
                                <span class="input-group-btn" style="float:left;">
                                    <button id="btn_search" type="button" class="btn btn-primary"><i class="fa fa-search"></i></button>
                                </span>
                            </div>
                        </div>
                        <div id="dv_bl_tool" style="display:none;">
                            <div style="float:left;width:30%;" id="dv_mr_RecordStu">
                                <select id="sel_RecordStu" name="sel_RecordStu" data-enumtype="EnumRecordStu">
                                    <option value="">Trạng thái bệnh án(Tất cả) </option>
                                </select>
                            </div>
                            <div class="input-group" style="width:70%;float:left;padding-top:10px;">
                                <input id="txt_cyts" type="text" class="form-control" style="width:30%;float:left;" placeholder="Số ngày ra viện" />
                                <input id="txt_keyword1" type="text" class="form-control" placeholder="Tên bệnh nhân/Số nhập viện" style="width:50%;float:left;">
                                <span class="input-group-btn" style="float:left;">
                                    <button id="btn_search1" type="button" class="btn btn-primary"><i class="fa fa-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel">
        <ul id="allKindPat" role="tablist">
            <li role="presentation">
                <a role="tab" data-toggle="tab" onclick="init(0)">Bệnh nhân của tôi</a>
            </li>
            <li role="presentation" class="selectedli">
                <a href="#div_inPatlist" role="tab" data-toggle="tab" onclick="init(1)">Bệnh nhân đang nằm viện</a>
            </li>
            <li role="presentation">
                <a href="#div_outPatlist" role="tab" data-toggle="tab" onclick="init(2)">Bệnh nhân đã ra viện</a>
            </li>
        </ul>
        <div id="div_Patlist" style="margin-left: 25px;margin-right:10px;">
            <table id="gridListPat"></table>
            <div id="gridPagerPat"></div>
        </div>
    </div>
</div>
<div id="dv_Medlist" class="gridPanel dv-right">
    <div class="topPanel">
        <div class="toolbar" style="float:left;margin-right: 5px;">
            <div id="divPatientBasicInfo" style="position: fixed;top: 10px;z-index: 100009;width: 29%;line-height: 40px;font-size: 18px;white-space: nowrap;text-overflow: ellipsis;left: 40%;text-align:left;padding-left: 18px;color:#07bbf1;">
                <input type="hidden" id="inpzyh" name="inpzyh" />
            </div>
        </div>
        <div class="toolbar" style="float:right;margin-right: 5px;">
            <div class="btn-group">
                <a class="btn btn-primary" onclick="Refresh()"><span class="fa fa-refresh"></span></a>
            </div>
            
            <a class="btn btn-primary" onclick="btn_add()"><i class="fa fa-plus"></i>Tạo mới bệnh án</a>

            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_addnew()"><i class="fa fa-plus"></i>Tạo mới bệnh án</a>
            </div>
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_edit()"><i class="fa fa-pencil-square-o"></i>Sửa bệnh án</a>
            </div>
            <div class="btn-group">
                <a class="btn btn-primary" onclick="btn_mrqc()"><i class="fa fa-pencil-square-o"></i>Kiểm soát chất lượng bệnh án</a>
            </div>
            @if (EnableLinkToMRMS == "true")
            {
                <div class="btn-group" id="dv_btn_commit">
                    <a class="btn btn-primary" onclick="btn_commit()"><i class="glyphicon glyphicon-saved"></i>Nộp bệnh án</a>
                </div>
                <div class="btn-group" id="dv_btn_return">
                    <a class="btn btn-primary" onclick="btn_return()"><i class="glyphicon glyphicon-backward"></i>Bệnh án bị trả lại</a>
                </div>
            }

        </div>
    </div>
    <table id="gridList"></table>
</div>

<script>
    var currentobj = [];
    var flag = 0; //Cờ tải lần đầu cây bệnh nhân
    var currentPatId = "";
    var curPatinfo = [];
    var zyh = "";
    var thistype = 1;
    var reportServerHOST = '@ViewBag.ReportServerHOST';
    var orgId = '@ViewBag.OrgId';
    var justshow = 0;

    $(function () {
        $(window).resize(function () {//Tải lại khi thay đổi kích thước cửa sổ trình duyệtjqGridChiều rộng của
            window.initLayout("div_Patlist");
            window.initLayout("dv_Medlist");
        });
        $("#allKindPat").children().click(function () {
            $("#allKindPat").children().removeClass("selectedli")

            $(this).addClass("selectedli")
        });
        $("#sel_inpatientArea").bindSelect({
            url: "/SystemManage/BaseData/GetAuthedWardSelectJson",
        });
        $('#sel_inpatientArea').change(function () {
            $("#gridListPat").jqGrid('setGridParam', {
                postData: { keyword: $("#txt_keyword").val(), zyh: "", bq: $("#sel_inpatientArea option:selected").val() },
                page:1
            }).trigger('reloadGrid');
        });
        if (flag == 0) {
            currentobj = JSON.parse(sessionStorage.getItem('currentobj'));

            if (currentobj != null) {
                GetPatList(currentobj);
                gridList(currentobj);


                $('#divPatientBasicInfo').html("Thông tin bệnh nhân:" + currentobj.xm
                        + '&nbsp;/&nbsp;' + $.getGender(currentobj.sex)
                        + '&nbsp;/&nbsp;' + currentobj.age + " tuổi"
                        + '&nbsp;/&nbsp;' + currentobj.brxzmc
                        + '&nbsp;/&nbsp;<span id="patzyh">' + currentobj.zyh + "</span>");
                $('#inpzyh').val(currentobj.zyh);
                curPatinfo = currentobj;
                zyh = curPatinfo.zyh;
                currentobj = null;
                //JSON.parse(sessionStorage.removeItem('currentobj'));
                sessionStorage.removeItem('currentobj');
            }
            else {
                GetPatList();
               gridList();
            }

            flag = 1;
        }
        else {
            GetPatList();
            gridList();
        }

    })

    //Cây danh sách bệnh án bệnh nhân
    function gridList(currentobj) {
        var zyh = "";
        if (currentobj != null) {
            zyh = currentobj.zyh
        }
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            treeGrid: true,
            treeGridModel: "adjacency",
            ExpandColumn: "Blzt",
            url: "/MedicalRecordManage/PatInfo/GetMedRecordTree",
            postData: { zyh: zyh },
            height: $(window).height() - 96,
            colModel: [
                { label: "Quan hệ bệnh án iD", name: "Id", hidden: true, key: true },
                { label: "Nhóm lớn bệnh án iD", name: "BllxId", hidden: true },
                { label: "Cách tải mẫu", name: "LoadWay", hidden: true },
                { label: "Đường dẫn mẫu", name: "mblj", hidden: true },
                { label: "Số nhập viện", name: "zyh", hidden: true },
                { label: "Số khám ngoại trú", name: "mzh", hidden: true },
                { label: "Bệnh án iD", name: "BlId", hidden: true },
                { label: "Ybbm", name: "Ybbm", hidden: true },
                { label: "PlanStu", name: "PlanStu", hidden: true },
                { label: "Mã định danh loại bệnh án", name: "bllx", hidden: true },
                { label: "Cờ kiểm soát quyền đọc/sửa tệp", name: "ctrlLevel", hidden: true },
                { label: "Name", name: "Name", hidden: true },
                {
                    label: 'Tên bệnh án', name: 'BLName', width: 200, align: 'left',
                    formatter: function (cellvalue, options, rowobject) {
                        if (rowobject.parentId == null) {
                            return rowobject.Name + '<i id="addCircle" class="fa fa-plus-circle plusToggleCircle" aria-hidden="true" style="margin-left: 10px; color:#6ff3ad; font-size: small;"></i>';
                        }
                        else if (rowobject.PlanStu == '@((int)EnumPlanStu.tz)'.toString()) {
                            return '<span class="glyphicon glyphicon-file" style="color:#6ff3ad; font-size: 13px;"></span><span style="color:red;"> ' + rowobject.Name+"</span>";
                        }
                        else
                            return '<span class="glyphicon glyphicon-file" style="color:#6ff3ad; font-size: 13px;"></span> ' + rowobject.Name;
                    }
                },
                {
                    label: "Trạng thái bệnh án", name: "Blzt", width: 80, align: "center",hidden:true, formatter: function (cellvalue) {
                        if (cellvalue == "1")
                            return "Đã ký";
                        else if (cellvalue == "0")
                            return "Chưa ký";
                        else
                            return "";
                    }
                },
                { label: 'doctype', name: 'doctype', width: 80, align: 'center' ,hidden:true},
                { label: 'Tên bác sĩ', name: 'Docname', width: 80, align: 'center' },
                { label: "Mã nhân viên bác sĩ", name: "Doccode", hidden: true },
                { label: 'Ngày bệnh án', name: 'Blrq', width: 130, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
                { label: 'Ngày cập nhật', name: 'LastModifierTime', width: 130, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },

            ],
            onSelectRow: function (rowid, status) {
                if (status == true) {

                    var rowData = $("#gridList").jqGrid('getRowData', rowid);
                    var patData = $("#gridListPat").jqGrid('getGridParam', 'selrow');
                    if (patData != null && patData != "undefied") {
                        if (rowData.parent == null || rowData.parent == "") {//Điều kiện vô hiệu hóa
                            btn_addnew();//btn_add();
                        }
                    }
                    else {
                        $.modalAlert("Vui lòng chọn bệnh nhân", 'warning');
                    }
                }
            },
            onRightClickRow: function (rowid, irow, icol, e) {
                debugger;
                var rowData = $("#gridList").jqGrid('getRowData', rowid);
                if (rowData.zyh != "") {
                    var patselRowId = $("#gridListPat").jqGrid('getGridParam', 'selrow');
                    var patData = $("#gridListPat").jqGrid('getRowData', patselRowId);
                    if (patData.RecordStu == '@((int)EnumRecordStu.wtj)' || patData.RecordStu == '@((int)EnumRecordStu.th)') {
                        //2020-3-16 chl Tách trang đầu bệnh án
                        if ('@ViewBag.IsEnableEditor' == "true" && rowData.bllx == '@((int)EnumBllx.basy)') {
                            initBasyrightMenu(rowData);
                        }
                        //Bản ghi diễn biến bệnh thêm menu in hợp nhất
                        else if ('@ViewBag.IsEnableEditor' == "true" && (rowData.bllx == '2019' || rowData.bllx == '2')) {
                            initBcjlrightMenu(rowData);
                        }
                        else {
                            initrightMenu(rowData);
                        }
                    }
                    else {
                        if ('@ViewBag.IsEnableEditor' == "true" && rowData.bllx == '@((int)EnumBllx.basy)') {
                            initBasyrightMenuJustShow(rowData);
                        }
                        else {
                            initrightMenuJustShow(rowData);
                        }

                    }
                }
            }


        });
    }

    //Nhấn Enter để tìm kiếm
    $('#txt_keyword').keydownEnterEvent(function () {
        $('#btn_search').trigger('click');
    })

    $("#btn_search").click(function () {
        $("#gridListPat").jqGrid('setGridParam', {
            postData: { keyword: $("#txt_keyword").val(), zyh: "", bq: $("#sel_inpatientArea option:selected").val() },
            page:1
        }).trigger('reloadGrid');
        $("#gridList").jqGrid('setGridParam', {
            postData: { zyh: "" },
        }).trigger('reloadGrid');
        $('#divPatientBasicInfo').html("");
        $('#inpzyh').val("");
    });

    $("#btn_search1").click(function () {
        if (isNaN($("#txt_keyword1").val())) {

        }
        $("#gridListPat").jqGrid('setGridParam', {
            postData: {
                keyword: $("#txt_keyword1").val(),
                zyh: "",
                cyts: $("#txt_cyts").val(),
                blzt: $("#sel_RecordStu option:selected").val()
            },
            page:1
        }).trigger('reloadGrid');
        $("#gridList").jqGrid('setGridParam', {
            postData: { zyh: "" },
        }).trigger('reloadGrid');
        $('#divPatientBasicInfo').html("");
        $('#inpzyh').val("");
    });

    function Refresh() {
        $("#gridList").jqGrid('setGridParam', {
            postData: { zyh: $('#inpzyh').val() },
        }).trigger('reloadGrid');
    }
    //Menu chuột phải
    function initrightMenu(rowData) {
        var p = '.gridPanel tr[id=' + rowData.Id + ']';
        var menu = new BootstrapMenu(p, {
            //fetchElementDataLấy siêu dữ liệu
            fetchElementData: function ($rowElem) {
                var data = rowData;
                return data;    //mục đích của return là truyền tham số cho onClick bên dưới
            },
            actions: [{
                name: '<span class="glyphicon glyphicon-open" style="color: rgb(28, 179, 173); font-size: 13px;"></span> Xem bệnh án',
                width: 300,
                onClick: function (obj) {
                    debugger;
                    if (obj.LoadWay == '@((int)EnummbqxTempLoadWay.View)' && !!obj.mblj) {
                        var menuname = obj.zyh + "-" + obj.Name + "<span class='fa fa-times-circle quit' style='display: none;padding-left:2px;' ></span>"
                        top.top.$.Newtouchtab.addTabWithOutMenu({ name: obj.Name == null ? "Thao tác bệnh án" : menuname, enName: "", url: obj.mblj + "?zyh=" + obj.zyh + "&blId=" + obj.BlId, AppId: "EMR" });

                    }
                    else {
                        var menuurl = "/MedicalRecordManage/MedicalRecord/PreView?blid=" + obj.BlId + "&bllx=" + obj.bllx + "&zyh=" + obj.zyh + "&mzh=" + obj.mzh;
                        if (obj.doctype == ".html") {
                            menuurl = "/MedicalRecordManage/MedicalRecord/MedicalRecordEditV2?blid=" + obj.BlId + "&bllx=" + obj.bllx + "&zyh=" + obj.zyh + "&mzh=" + obj.mzh + "&justshow=" + justshow + "&blxtmc_yj=" + obj.Name + "&doctype=" + obj.doctype;
                        }
                        var menuname = obj.zyh + "-" + obj.Name + "<span class='fa fa-times-circle quit' style='display: none;padding-left:2px;' ></span>"
                        top.top.$.Newtouchtab.addTabWithOutMenu({ name: obj.Name == null ? "Thao tác bệnh án" : menuname, enName: "", url: menuurl, AppId: "EMR" });
                    }
                }
            },
            {
                name: '<span class="glyphicon glyphicon-remove" style="color: rgb(28, 179, 173); font-size: 13px;"></span> Xóa bệnh án',
                width: 300,
                onClick: function (obj) {

                    if (obj.Doccode == '@opeator.rygh') {

                        $.modalConfirm("Xác nhận xóa bệnh án này?", function (flag) {
                            if (flag) {
                                $.ajax({
                                    type: "POST",
                                    url: "/MedicalRecordManage/PatInfo/UpdatePatMedRecordRel",
                                    dataType: "json",
                                    data: { blId: obj.BlId, blgxId: obj.Id , blName:obj.Name},
                                    async: false,
                                    success: function (ajaxresp) {
                                        if (ajaxresp.state == "error" || ajaxresp.state == "") {
                                            setTimeout(function () {
                                                $.modalMsg(ajaxresp.message, 'error');
                                            }, 1000);
                                        }
                                        else {
                                            setTimeout(function () {
                                                $.modalMsg('Xóa thành công', 'success');
                                            }, 1000);
                                        }
                                        $("#gridList").jqGrid('setGridParam', {
                                            postData: { zyh: obj.zyh },
                                        }).trigger('reloadGrid');
                                    }
                                });
                            }
                        });

                    }
                    else {
                        $.modalMsg("Rất tiếc, Không đủ quyền", 'error');
                    }

                }
                }, {
                name: '<span class="glyphicon glyphicon-ok-sign" style="color: rgb(28, 179, 173); font-size: 13px;"></span> Dừng/Hủy',
                    width: 300,
                    onClick: function (obj) {
                        $.ajax({
                            type: "POST",
                            url: "/MedicalRecordManage/PatInfo/UpdatePlanStu",
                            dataType: "json",
                            data: { blid: obj.BlId, stu: obj.PlanStu },
                            async: false,
                            success: function (ajaxresp) {
                                $.modalMsg(ajaxresp.message, ajaxresp.state);
                                $("#gridList").jqGrid('setGridParam', {
                                    postData: { zyh: obj.zyh },
                                }).trigger('reloadGrid');
                            }
                        });


                    }
                }, {
                name: '<span class="glyphicon glyphicon-ok-sign" style="color: rgb(28, 179, 173); font-size: 13px;"></span> Mở khóa bệnh án',
                width: 300,
                onClick: function (obj) {

                    $.ajax({
                        type: "POST",
                        url: "/MedicalRecord/LockRecord",
                        dataType: "json",
                        data: { blid: obj.BlId, bllx: obj.bllx, isToLock: 2 },
                        async: false,
                        success: function (ajaxresp) {
                            $.modalMsg(ajaxresp.message, ajaxresp.state);
                        }
                    });


                }
                },
                //{
                //    name: '<span class="glyphicon glyphicon-cloud-upload" style="color: rgb(28, 179, 173); font-size: 13px;"></span> Tải lên bảo hiểm y tế',
                //    width: 300,
                //    onClick: function (obj) {
                //        setTimeout(function () {
                //            $.modalMsg("Đang yêu cầu tải lên, Vui lòng đợi...");
                //            if (!!obj.Ybbm && obj.bllx == 5) {
                //                GetbasyData(obj.zyh, obj.Ybbm);
                //            }
                //            else if (!!obj.Ybbm) {
                //                var ret = GetblData(obj.Ybbm, obj.BlId);
                //                if (obj.Ybbm == "7100" && ret == 1) {
                //                    GetblData("7110", obj.BlId);
                //                }
                //                else if (obj.Ybbm == "7500" && ret == 1) {
                //                    GetblData("7510", obj.BlId);
                //                }
                //            }
                //            else {
                //                $.modalAlert("Bệnh án này không cần tải lên bảo hiểm y tế", "warning");
                //            }
                //        }, 1000);
                //    }
                //},
                {
                name: '<span class="glyphicon glyphicon-send" style="color: rgb(28, 179, 173); font-size: 13px;"></span> Lưu thành mẫu cá nhân',
                width: 300,
                    onClick: function (obj) {
                        if (obj.LoadWay == '@((int)EnummbqxTempLoadWay.View)') {
                            $.modalMsg("Bệnh án này không hỗ trợ chuyển đổi", 'warning');
                        }
                        else {
                            $.modalOpen({
                                id: "Form",
                                title: "Tạo mới mẫu bệnh án",
                                url: "/MedicalRecordManage/MedRecordTemplate/Form?blId=" + obj.BlId + "&bllx=" + obj.bllx + "&mbly=0",
                                width: "700px",
                                height: "600px",
                                btn: null,
                                callBack: function (iframeId, a) {
                                    top.frames[iframeId].submitForm();
                                }
                            });
                        }
                }
                },
                {
                name: '<span class="glyphicon glyphicon-open" style="color: rgb(28, 179, 173); font-size: 13px;"></span> In bệnh án',
                width: 300,
                onClick: function (obj) {
                    if (obj.LoadWay == '@((int)EnummbqxTempLoadWay.View)' && !!obj.mblj) {
                        var menuname = obj.zyh + "-" + obj.Name + "<span class='fa fa-times-circle quit' style='display: none;padding-left:2px;' ></span>"
                        top.top.$.Newtouchtab.addTabWithOutMenu({ name: obj.Name == null ? "Thao tác bệnh án" : menuname, enName: "", url: obj.mblj + "?zyh=" + obj.zyh + "&blId=" + obj.BlId+"&type=print", AppId: "EMR" });

                    }
                    else {
                        var menuurl = "/MedicalRecordManage/MedicalRecord/PrintView?blid=" + obj.BlId + "&bllx=" + obj.bllx + "&zyh=" + obj.zyh + "&mzh=" + obj.mzh + "&type=print";
                        var menuname = obj.zyh + "-" + obj.Name + "<span class='fa fa-times-circle quit' style='display: none;padding-left:2px;' ></span>"
                        top.top.$.Newtouchtab.addTabWithOutMenu({ name: obj.Name == null ? "Thao tác bệnh án" : menuname, enName: "", url: menuurl, AppId: "EMR" });
                    }
                }
            },

           ]
        });
    }

    //Bản hiển thị menu chuột phải
    function initrightMenuJustShow(rowData) {
        var p = '.gridPanel tr[id=' + rowData.Id + ']';
        var menu = new BootstrapMenu(p, {
            //fetchElementDataLấy siêu dữ liệu
            fetchElementData: function ($rowElem) {
                var data = rowData;
                return data;    //mục đích của return là truyền tham số cho onClick bên dưới
            },
            actions: [{
                name: '<span class="glyphicon glyphicon-open" style="color: rgb(28, 179, 173); font-size: 13px;"></span> Xem bệnh án',
                width: 300,
                onClick: function (obj) {
                    if (obj.LoadWay == '@((int)EnummbqxTempLoadWay.View)' && !!obj.mblj) {
                        var menuname = obj.zyh + "-" + obj.Name + "<span class='fa fa-times-circle quit' style='display: none;padding-left:2px;' ></span>"
                        top.top.$.Newtouchtab.addTabWithOutMenu({ name: obj.Name == null ? "Thao tác bệnh án" : menuname, enName: "", url: obj.mblj + "?zyh=" + obj.zyh + "&blId=" + obj.BlId, AppId: "EMR" });

                    }
                    else {
                        if (obj.doctype == ".html") {

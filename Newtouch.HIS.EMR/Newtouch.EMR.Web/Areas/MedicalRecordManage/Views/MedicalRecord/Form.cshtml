@{
    ViewBag.Title = "Trang biểu mẫu báo cáo xét nghiệm, kiểm tra";
    Layout = "~/Views/Shared/_Form.cshtml";
}

<style>
    /*#dc {
        float: right;
        background-color: #e9f6fe !important;
        height: 12px;
        width: 130px;
        padding: 10px;
        color: black;
    }*/

    .noselected {
        float: left;
        background-color: #e9f6fe !important;
        height: 12px;
        width: 130px;
        padding: 10px;
        color: black;
        border: solid 1px black;
    }

    .selected {
        float: left;
        background-color: #ffffff;
        height: 12px;
        width: 130px;
        padding: 10px;
        color: #00a0ea;
        border: solid 1px #00a0ea;
    }

    .hide {
        display: none;
    }
</style>
<form id="formPatSer" style="margin:2px;margin-top:10px;">
	<div style="background-color: #e9f6fe !important;height:36px;width:100%">
		<ul class="nav nav-tabs navb-bg" id="myTab" style="position:fixed;top:0;z-index:100009;width:99%">
			<li role="presentation"><a href="#jy" role="tab" data-toggle="tab">Xét nghiệm</a></li>
			<li role="presentation"><a href="#jc" role="tab" data-toggle="tab">Kiểm tra</a></li>
		</ul>
			@**@<input id="jy" name="jy" type="button" value="Xét nghiệm" class="selected" />
			<input id="jc" name="jc" type="button" value="Kiểm tra" class="noselected" />*@
	</div>
    <div class="gridPanel" id="jyjgmx">
        <div>
            <table class="form">
                <tr>
                    <th class="formTitle">Khoảng thời gian phiếu đề nghị:</th>
                    <td class="formValue" colspan="2">
                        <input id="jy_kssj" type="text" class="form-control input-wdatepicker" style="width:30%;  float:left;" value="@DateTime.Now.AddDays(-15).ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        <span style="margin-left:1%;float:left">—</span>
                        <input id="jy_jssj" type="text" class="form-control input-wdatepicker" style="width:30%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    </td>
                    <th class="formTitle">Tên bộ xét nghiệm:</th>
                    <td class="formValue">
                        <input id="jy_ztmc" type="text" class="form-control" placeholder="Tên bộ xét nghiệm" />
                    </td>
                    <td class="formValue">
                        &nbsp;&nbsp;
                        <input type="button" id="btn_jysearch" class="btn btn-primary" value=" Tra cứu " />
                        @**@<a href="~/File/CQLisApp.rar">CQLisApp</a>*@
                    </td>
                </tr>
            </table>
        </div>
        <div class="gridPanel">
            <table id="jyGridList"></table>
            <div id="jyGridPager" style="padding-right:20%"></div>
            <div id="tsjy" style="color:blue">Vui lòng nhấp đúp vào một dữ liệu đã hoàn thành để xem chi tiết</div>
        </div>
        <div id="jydc" style="height:50px" class="hide">
            <input type="checkbox" id="gxyc" name="gxyc" style="float:left" onclick="gxycclick(this)"  />Đánh dấu kết quả bất thường
            <input type="button" id="jgdc" name="jgdc" class="btn btn-md btn-primary" style="float:right;  margin-right:100px;" value="Nhập kết quả" class="noselected" />
            <input type="button" id="xmjgdc" name="xmjgdc" class="btn btn-md btn-primary" style="float:right; margin-right:60px;" value="Hạng mục+Nhập kết quả" class="noselected" />
        </div>
        <div class="gridPanel">
            <table id="jyMxGridList"></table>
        </div>
    </div>
    <div class="panel panel-default hide" id="jcjgmx">
        <div>
            <table class="form">
                <tr>
                    <th class="formTitle">Khoảng thời gian phiếu đề nghị:</th>
                    <td class="formValue" colspan="2">
                        <input id="jc_kssj" type="text" class="form-control input-wdatepicker" style="width:30%;  float:left;" value="@DateTime.Now.AddDays(-15).ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                        <span style="margin-left:1%;float:left">—</span>
                        <input id="jc_jssj" type="text" class="form-control input-wdatepicker" style="width:30%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                    </td>
                    <th class="formTitle">Tên bộ xét nghiệm:</th>
                    <td class="formValue">
                        <input id="jc_ztmc" type="text" class="form-control" placeholder="Tên bộ xét nghiệm" />
                    </td>
                    <td class="formTitle">
                        <input type="button" id="btn_jcsearch" class="btn btn-md btn-primary" value="Tra cứu" />
                    </td>

                </tr>
            </table>
        </div>
        <div class="gridPanel">
            <table id="jcGridList" rel="formPatSer"></table>
            <div id="jcGridPager" style="padding-right:20%"></div>
            <div id="tsjc" style="color:blue">Vui lòng nhấp đúp vào một dữ liệu đã hoàn thành để xem chi tiết</div>
        </div>
		<div style="height:50px">
			<input id="dc" class="btn btn-md btn-primary" name="dc" type="button" style="float:right; width:100px;  margin-right:100px;" value="Nhập" />
			
		</div>
		<div id="jcjgdiv">
			<label style="">Báo cáo bằng văn bản:</label>
			<textarea name="" cols="15" rows="4" id="jcjgtext" readonly style="width:95%;height:100px; border:none; resize:none"></textarea>
		</div>
        <div class="gridPanel">
            <table id="jcMxGridList"></table>
        </div>
    </div>
    @*onclick="document.getElementById('myWriterControl').DCExecuteCommand('Spechars', true, 'test');"*@
</form>

<script lang="javascript">
    var mzzyh = $.request("mzzyh");
    var type = $.request("type");
	var jyzt;
	var jlxx = null;//Tab bản ghi đã chọn
	$('#myTab a:first').trigger('click'); //Khởi tạo hiển thị tab nàotab
    $(function () {
		jyGridList();
		jlxx = $('#myTab a:first').attr('href');
		console.log("初始化：", jlxx);
    })
    //$(document).ready(function () {
    //    $("#btn_jcsearch").trigger('click');
    //});
    $("#btn_jcsearch").click(function () {
        var kssj = $('#jc_kssj').val();
        var jssj = $('#jc_jssj').val() + " 23:59:59";
        var ztmc = $('#jc_ztmc').val();
        $("#jcGridList").jqGrid('setGridParam', {
            postData: { mzzyh: mzzyh, type: type, ztmc: ztmc, kssj: kssj, jssj: jssj },
        }).trigger('reloadGrid'); //Tải lại bảng hiện tại
    });

    $('#btn_jysearch').click(function () {
        var kssj = $('#jy_kssj').val();
        var jssj = $('#jy_jssj').val() + " 23:59:59";
        var ztmc = $('#jy_ztmc').val();
        $("#jyGridList").jqGrid('setGridParam', {
            postData: { mzzyh: mzzyh, type: type, ztmc: ztmc, kssj: kssj, jssj: jssj },
        }).trigger('reloadGrid'); //Tải lại bảng hiện tại
    });

    function jyGridList() {
        var kssj = $('#jy_kssj').val();
        var jssj = $('#jy_jssj').val() + " 23:59:59";
        var ztmc = $('#jy_ztmc').val();
        var $jyGridList = $("#jyGridList");
        $jyGridList.dataGrid({
            url: "/MedicalRecord/GetLisSqdhGridJson",
            autowidth: false,
            postData: { mzzyh: mzzyh, type: type, ztmc: ztmc, kssj: kssj, jssj: jssj },
            width: $("#formPatSer").width() - 10,
            //height: $(window).height() - 170,
            height: 125,
            colModel: [
                { label: 'Họ tên', name: 'xm', align: 'center', hidden: true },
                { label: 'Số phiếu đề nghị', name: 'lissqdh', align: 'center', width: '160px' },
                { label: 'Tên bộ xét nghiệm', name: 'ztmc', align: 'center', width: '170px' },
                { label: 'Thời gian đề nghị', name: 'sqsj', align: 'center', width: '160px' },
                { label: 'Trạng thái phiếu đề nghị', name: 'syncStatus', align: 'center', width: '160px' },
                {
                    label: "Thao tác", name: "", align: "center", width: '150',
                    formatter: function (cellvalue, options, rowobject) {
                        return "<a href=\#\" onclick='jyrecall1(\"" + rowobject.lissqdh + "\",\"" + rowobject.syncStatus + "\")'' title='Báo cáo LIS' style='text-decoration: none;color: #dd4b39;cursor: pointer;'>Xem báo cáo</a>";
                    }
                }
            ],
            pager: "#jyGridPager",
            sortname: 'sqsj desc',
            viewrecords: true
        });
    }

    function jcGridList() {
        var kssj = $('#jc_kssj').val();
        var jssj = $('#jc_jssj').val() + " 23:59:59";
        var ztmc = $('#jc_ztmc').val();
        var $jcGridList = $("#jcGridList");
        $jcGridList.dataGrid({
            url: "/MedicalRecord/GetPacsSqdhGridJson",
            autowidth: false,
            postData: { mzzyh: mzzyh, type: type, ztmc: ztmc, kssj: kssj, jssj: jssj },
            width: $(window).width() - 10,
            //height: $(window).height() - 170,
            height: 175,
            colModel: [
                { label: 'Họ tên', name: 'xm', align: 'center', hidden: true },
                { label: 'Số phiếu đề nghị', name: 'lissqdh', align: 'center', width: '160px' },
                { label: 'Tên bộ xét nghiệm', name: 'ztmc', align: 'center', width: '170px' },
                { label: 'Thời gian đề nghị', name: 'sqsj', align: 'center', width: '160px' },
                { label: 'Trạng thái phiếu đề nghị', name: 'syncStatus', align: 'center', width: '160px' },
                {
                    label: "Thao tác", name: "", align: "center", width: '150',
                    formatter: function (cellvalue, options, rowobject) {
                        return "<a href=\#\" onclick='jcrecall1(\"" + rowobject.lissqdh + "\",\"" + rowobject.syncStatus + "\")'' title='Xem báo cáo' style='text-decoration: none;color: #dd4b39;cursor: pointer;'>Xem báo cáo</a>";
                    }
                }
            ],
            pager: "#jcGridPager",
            sortname: 'sqsj desc',
            viewrecords: true
        });
    }

    function jcrecall1(sqdh, syncStatus) {
        if (syncStatus != "已完成") {
            $.modalAlert("Trạng thái hiện tại không phải trạng thái đã hoàn thành nên không thể xem báo cáo", 'warning');
            return;
        }
        else {
            //$.modalOpen({
            //    id: "medicaljgForm",
            //    title: "Báo cáo kiểm tra",
            //    url: "http://116.63.189.68:8088/WebSearch.aspx?ReqNO='" + sqdh + "'",
            //    width: "1000px",
            //    height: "1000px",
            //    btn: ['', ''],
            //    btnclass: ['', ''],
            //});
			window.open('https://pacs.jidachengdu.com:18000/externalView?hosCode=jdkfyy&studyNum=' + sqdh);
        }

    }

    function jyrecall1(lissqdh, syncStatus) {
        if (syncStatus != "已完成") {
            $.modalAlert("Trạng thái hiện tại không phải trạng thái đã hoàn thành nên không thể xem báo cáo", 'warning');
            return;
        } else {
            $.ajax({
                url: "http://127.0.0.1:22228/api/CQSmartCheck/GetLisReport",//Báo cáo LIS
                dataType: "json",
                data: { type: type, brxx_id: lissqdh },
                type: "POST",
                async: true,
                success: function (ajaxdata) { }
            });
        }
    }

    //jqGrid Nhấp đúp để chọn một hàng
	function btn_edit() {

		if (jlxx == "#jy") {
            var $jyGridList = $("#jyGridList");
            if ($jyGridList.jqGridRowValue().syncStatus != "已完成") {
                $.modalAlert("Trạng thái hiện tại không phải trạng thái đã hoàn thành nên không thể xem báo cáo", 'warning');
                return;
            }
            else {
                var $mxgridList = $("#jyMxGridList");
                $("#gxyc").checked = false;
				$("#jydc").removeClass("hide");
				$("#tsjy").addClass("hide");
                jyzt = $jyGridList.jqGridRowValue().ztmc;
                $mxgridList.dataGrid({
                    url: "/MedicalRecord/GetLisSqdhMxGridJson",
                    //autowidth: false,
                    postData: { zyh: mzzyh, lissqdh: $jyGridList.jqGridRowValue().lissqdh },
                    //width: $(window).width() - 10,
                    height: 120,
                    colModel: [
                        { label: 'Tên hạng mục', name: 'xmmc', align: 'left', width: '180px' },
                        { label: 'Kết quả xét nghiệm', name: 'jyjg', align: 'left', width: '180px' },
                        { label: 'Cờ cao/thấp', name: 'gdbj', align: 'left', width: '100px' },
                        { label: 'Khoảng giá trị tham khảo', name: 'ckzfw', align: 'left', width: '120px' },
                        { label: 'Đơn vị', name: 'dw', align: 'left', width: '180px' }
                    ],
                    sortname: 'sqsj desc',
                    viewrecords: true,
                    multiselect: true
                });
                $("#jyMxGridList").jqGrid('setGridParam', {
                    postData: { zyh: mzzyh, lissqdh: $jyGridList.jqGridRowValue().lissqdh },
                }).trigger('reloadGrid');
            }
        }
        else {
            var $jcGridList = $("#jcGridList");
            if ($jcGridList.jqGridRowValue().syncStatus != "已完成") {
                $.modalAlert("Trạng thái hiện tại không phải trạng thái đã hoàn thành nên không thể xem báo cáo", 'warning');
                return;
            }
            else {
				$("#dc").removeClass("hide");
				$("#jcjgdiv").removeClass("hide");
				$("#tsjc").addClass("hide");
				//var $mxgridList = $("#jcMxGridList");
				$.ajax({
					url: "/MedicalRecord/GetPacsSqdhMxGridJson",
					dataType: "json",
					data: { sqdh: $jcGridList.jqGridRowValue().lissqdh },
					type: "POST",
					async: false,
					success: function (result) {
						console.log("申请单号查询检查结果：", result);
						var strjcjg="";
						if (result.length > 0) {
							for (var i = 0; i < result.length; i++) {
								strjcjg += "" + result[i].jcjg+"";
							}
							$("#jcjgtext").val(strjcjg);
						}
					}
				});
                //$mxgridList.dataGrid({
                //    url: "/MedicalRecord/GetPacsSqdhMxGridJson",
                //    //autowidth: false,
                //    postData: { sqdh: $jcGridList.jqGridRowValue().lissqdh },
                //    //width: $(window).width() - 10,
                //    height: 175,
                //    colModel: [
                //        { label: 'Kết quả kiểm tra', name: 'jcjg', align: 'left', width: '840px' },
                //    ],
                //    sortname: 'sqsj desc',
                //    viewrecords: true,
                //});
                //$("#jcMxGridList").jqGrid('setGridParam', {
                //    postData: { sqdh: $jcGridList.jqGridRowValue().lissqdh },
                //}).trigger('reloadGrid');
            }
        }

    }

    function gxycclick(checkbox) {
        if (checkbox.checked == true) {
            debugger
            var rowIds = jQuery("#jyMxGridList").jqGrid('getDataIDs');
            for (var k = 0; k < rowIds.length; k++) {
                var curRowData = jQuery("#jyMxGridList").jqGrid('getRowData', rowIds[k]);
                if (curRowData.gdbj != null && curRowData.gdbj != "") {
                    //$("#" + rowIds[k] + "").attr("aria-selected", "true");
                    //$("#" + rowIds[k] + "").addClass("success");
                    //var curChk = $("#" + rowIds[k] + "").find(":checkbox");
                    $("#" + rowIds[k], "#jyMxGridList").attr("aria-selected", "true");
                    $("#" + rowIds[k], "#jyMxGridList").addClass("success");
                    var curChk = $("#" + rowIds[k], "#jyMxGridList").find(":checkbox");
                    curChk.attr("checked", "true");
                };
            };
        }
        else {
            $("#jyMxGridList").trigger("reloadGrid");
        }
    };

    function getids() {
        debugger
        var rowIds = jQuery("#jyMxGridList").jqGrid('getDataIDs');
        var ids = new Array();
        for (var k = 0; k < rowIds.length; k++) {
            if ($("#" + rowIds[k], "#jyMxGridList").hasClass("success")) {
                ids.push(k);
            }
        }
        return ids;
    }


	$('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
		
		jlxx = $(this).attr('href');
		console.log("TAB：", jlxx);
		transferPage($(this).attr('href'));

	});
	 function transferPage($thishref) {
		 switch ($thishref) {
			 case "#jy":
				 $("#jcjgmx").addClass("hide");
				 $("#jyjgmx").removeClass("hide");
				 $("#jc").addClass("noselected");
				 $("#jc").removeClass("selected");
				 $("#jy").addClass("selected");
				 $("#jy").removeClass("noselected");

				 //$("#dc").addClass("hide");
				 $(function () {
					 jyGridList();

				 });
				 //$("#jyMxGridList").clearGridData();
                 //$("#jcMxGridList").dataGrid.width = 690
				 break;
			 case "#jc":
				 $("#jyjgmx").addClass("hide");
				 $("#jcjgmx").removeClass("hide");
				 $("#jc").addClass("selected");
				 $("#jc").removeClass("noselected");
				 $("#jy").addClass("noselected");
				 $("#jy").removeClass("selected");

				 $("#dc").addClass("hide");
				 $("#jcjgdiv").addClass("hide");
				 $(function () {
					 jcGridList();
				 });
				 //$("#jcMxGridList").clearGridData();
                 //$("#jcMxGridList").dataGrid.width=690
				 break;
		 }
    }


	$("#dc").click(function () {
		if ($("#jcjgtext").val() != undefined && $("#jcjgtext").val() != null && $("#jcjgtext").val()!="") {
			console.log("检查结果",$("#jcjgtext").val());
			$.currentWindow().document.getElementById('myWriterControl').DCExecuteCommand('Spechars', true, $("#jcjgtext").val());
		} else {
			$.modalAlert("Số phiếu đề nghị này không có kết quả kiểm tra hiển thị nên không thể nhập nội dung", 'warning');
			return;
		}
		
    });

    $("#jgdc").click(function () {
        //rowIds = $('#jyMxGridList').jqGrid('getGridParam', 'selarrrow');
        rowIds = getids();
        if (rowIds.length < 1) {
			//alert("Vui lòng chọn ít nhất một dòng kết quả xét nghiệm để xuất!");
			$.modalAlert("Vui lòng chọn ít nhất một dòng kết quả xét nghiệm để xuất!", 'warning');
        }
        else {
            var jg = "";
            for (var k = 0; k < rowIds.length; k++) {
                var rowData = $("#jyMxGridList").jqGrid('getRowData', rowIds[k]+1);
                jg += (rowData.xmmc == undefined ? " " : rowData.xmmc) + " " + (rowData.jyjg == undefined ? " " : rowData.jyjg) + (rowData.gdjg == undefined ? " " : rowData.gdjg) + (rowData.dw == undefined ? " " : rowData.dw) + "，";
            };
            $.currentWindow().document.getElementById('myWriterControl').DCExecuteCommand('Spechars', true, jg);
        };
    });

    $("#xmjgdc").click(function () {
        //rowIds = $('#jyMxGridList').jqGrid('getGridParam', 'selarrrow');
        rowIds = getids();
        if (rowIds.length < 1) {
			//alert("Vui lòng chọn ít nhất một dòng kết quả xét nghiệm để xuất!");
			$.modalAlert("Vui lòng chọn ít nhất một dòng kết quả xét nghiệm để xuất!", 'warning');
        }
        else {
            var jg = jyzt;
            for (var k = 0; k < rowIds.length; k++) {
                var rowData = $("#jyMxGridList").jqGrid('getRowData', rowIds[k]+1);
                jg += "： " + (rowData.xmmc == undefined ? " " : rowData.xmmc) + " " + (rowData.jyjg == undefined ? " " : rowData.jyjg) + (rowData.gdjg == undefined ? " " : rowData.gdjg) + (rowData.dw == undefined ? " " : rowData.dw) + "，";
            };
            $.currentWindow().document.getElementById('myWriterControl').DCExecuteCommand('Spechars', true, jg);
        };
    })
    //var btn_dc = document.querySelector("#dc");
    //btn_dc.onmousedown = function(event) {event.preventDefault()}
</script>

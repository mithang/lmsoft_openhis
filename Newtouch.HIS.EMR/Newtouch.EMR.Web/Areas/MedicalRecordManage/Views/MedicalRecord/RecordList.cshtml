

@{

	Layout = null;
}
@* RecordList vừa là fragment nhúng qua ViewComponent trong các trang editor
   (đã có jQuery từ layout chủ), vừa là action độc lập với Layout = null.
   Chỉ nạp jQuery khi cửa sổ hiện tại chưa có, để mở standalone không còn
   lỗi "$ is not defined" mà không nạp đè jQuery của trang editor. *@
<script>
    if (typeof jQuery === 'undefined') {
        document.write('<script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/jquery/jquery-2.1.1.min.js")"><\/script>');
    }
</script>
<script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/wdtree/tree.js")"></script>
<link href="@MvcHelper.GetStaticResourceScriptUrl("~/js/wdtree/tree.css")" rel="stylesheet" />

<style>
	#blwsDiv {
		position: fixed;
		top: 20%;
		left: 10px;
	}

	.dv-left {
		width: 160px;
		float: left;
	}

	.dv-left-tree {
		overflow-y: auto;
		border-radius: 4px;
		background: white;
	}
	.dv-left-title {
		padding: 6px 10px;
		border-bottom: 1px solid transparent;
		border-top-left-radius: 3px;
		border-top-right-radius: 3px;
		border-color: #ddd;
		background-color: white;
	}

	#BLWS {
		float: left;
		background-color: #00a0ea;
		height: 100px;
		padding: 10px;
		color: white;
		margin: 5px 0 0 0;
	}

	#JCJY {
		float: left;
		background-color: #00a0ea;
		height: 140px;
		padding: 10px;
		color: white;
		margin: 5px 0 0 0;
	}

	#YZ {
		float: left;
		background-color: #00a0ea;
		height: 50px;
		padding: 10px;
		color: white;
		margin: 5px 0 0 0;
	}

	.hide {
		display: none;
	}
</style>


<div class="dv-body" id="blwsDiv">
	<div style="float:left">
		<a class="btn  " id="BLWS">Văn bản lịch sử</a>

		<div id="jcjy" class="hide">
			<a class="btn  " id="JCJY" onclick="btn_jcjy()">Báo cáo xét nghiệm, kiểm tra</a>
		</div>
		<div id="yz" class="hide">
			<a class="btn  " id="YZ" onclick="btn_yz()">Y lệnh</a>
		</div>
	</div>
	<div class="dv-left">
		<div class="dv-left-tree" id="wsTreeList" style="background-color:white;"></div>
		
	</div>
</div>

<link href="@MvcHelper.GetStaticResourceScriptUrl("~/css/framework-ui.css")" rel="stylesheet" />
<script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/framework-ui.js")"></script>
@* RS-N01 (họ T-02, EMR): fragment này vừa chạy standalone (Layout = null, không
   có guard) vừa nhúng qua ViewComponent vào các trang editor (nơi lần nạp
   framework-ui này ghi đè guard của trang chủ). Nạp lại emr-vi.js ngay sau để
   $.modal* luôn có guard, cả khi chạy độc lập lẫn khi nhúng. *@
<script src="/js/emr-vi.js"></script>
<script type="text/javascript">

    $(function () {
        $.ajax({
            url: "/MRHomePage/MRHomePage/DiagnosticSave",
            dataType: "json",
            data: { "Code": "YXZ_EMR1001" },
            type: "POST",
            async: false,
            success: function (result) {
                if (result.length > 0) {
                    if (result[0].Value == 1) {
                        $("#jcjy").removeClass("hide");
                    }
                }
            }
        });
        $.ajax({
            url: "/MRHomePage/MRHomePage/DiagnosticSave",
            dataType: "json",
            data: { "Code": "YXZ_EMR1002" },
            type: "POST",
            async: false,
            success: function (result) {
                if (result.length>0) {
                    if (result[0].Value == 1) {
                        $("#yz").removeClass("hide");
                    }
                }
            }
        });
    });

    function btn_jcjy()
    {
        $.modalOpen({
            id: "Form",
            title: "Xét nghiệm, Báo cáo kiểm tra",
            url: "/MedicalRecordManage/MedicalRecord/Form?mzzyh=" + $.request('zyh') + "&type=zy&ryrq=" + "@ViewBag.ryrq",
            width: "900px",
            height: "600px",
            shade: 0,
            btn: ['', 'Đóng'],
            btnclass: ['', 'btn btn-danger']
        });
    }

    function btn_yz() {
        alert($.request('zyh'));
        $.modalOpen({
            id: "Form",
            title: "Y lệnh",
            url: "/MedicalRecordManage/MedicalRecord/YZForm?zyh=" + $.request('zyh') + "&type=zy" + "&doctype=" + $.request("doctype"),
            width: "1100px",
            height: "600px",
            shade: 0,
            btn: ['', 'Đóng'],
            btnclass: ['', 'btn btn-danger']
        })
    }

    $(function () {
        debugger
        getWSTreeList();
        $(".dv-left").toggle();
        $("#BLWS").click(function () {
            $(".dv-left").toggle();
        });
    });

	function GetQueryValue(queryName) {
		var query = decodeURI(window.location.search.substring(1));//chuyểnurlChuyển mã, Nếu không phải liên kết địa chỉ hiện tại, Có thể điền liên kết cần thiết tại đây
		var vars = query.split("&");//Tách chuỗi, chuyểnurlCắt thành đối tượng dạng mảng
		for (var i = 0; i < vars.length; i++) {
			var pair = vars[i].split("=");//Tách lại thành mảng
			if (pair[0] == queryName) { return pair[1]; }//Nếu khớp thì xuất kết quả

		}
		return null;

	}
    function getWSTreeList()
    {
		var blid = GetQueryValue("blid");
        //var bllx = $.request("bllx");
		var blxtmc_yj = GetQueryValue("blxtmc_yj");
		var doctype = GetQueryValue("doctype");
		var mzh = GetQueryValue("mzh");
        var zyh = GetQueryValue("zyh");
        $("#wsTreeList").treeview({
            height: 400,
            slimscroll: false,
            showcheck: true,

            //url: "/MedicalRecord/GetWSTreeListIndex?zyh=" + "@ViewBag.zyh"+"&mzh="+"@ViewBag.mzh",
            url: "/MedicalRecord/GetBFTreeListIndex?zyh=" + zyh + "&mzh=" + mzh + "&blxtmc_yj=" + blxtmc_yj + "&doctype=" + doctype,
            onnodedbclick: function (item) {
                if (item.Ex1 != 'p') {
                    $("#blid").val(item.id + "|" + blid);
                    if (doctype==".html")//Định dạng bệnh án của trình soạn thảo mới
                        loadbackBl(item.id + "|" + blid);
                    else
                        $("#history").trigger("click");
                    //top.top.$.Newtouchtab.addTabWithOutMenu({ name: "Thao tác bệnh án", enName: "", url: "/MedicalRecordManage/MedicalRecord/PreView?blid=" + item.id + "&bllx=" + item.value + "&zyh=" + "@ViewBag.zyh" + "&mzh=" + "@ViewBag.mzh" + "&jzbl=1&blid2=" + blId + "&bllx2=" + bllx + "&blxtmc_yj=" + blxtmc_yj, AppId: "EMR" });
                }
            }
        });
    }

    $(function () {

		$("#wsTreeList").css("height", "400px");
    });
</script>

@{
    ViewBag.Title = "Trang biểu mẫu";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<style>
    .tipSpan {
        color: red;
        padding-right: 8px;
    }
</style>
<form id="form1">
    
    <input id="Id" name="Id" class="form-control" type="hidden" />
    <input id="Table_Name" name="Table_Name" class="form-control" type="hidden" />
    <input id="Element_Type" name="Element_Type" class="form-control" type="hidden" />
    <input id="Element_ID" name="Element_ID" class="form-control" type="hidden" />
    <input id="ElementId" name="ElementId" class="form-control" type="hidden" />
    <input id="AreValue" name="AreValue" class="form-control" type="hidden" />
    <input id="ysmxId" name="ysmxId" class="form-control" type="hidden" />
    <div class="panel panel-default">
        <div class="panel-body" style="padding-top: 1px;">
            <table class="form">
                <tr>
                    <th class="formTitle"><span class="tipSpan">*</span>Trường:</th>
                    <td class="formValue">
                        <input id="Table_Column_Code" name="Table_Column_Code" type="text" autocomplete="off" class="form-control required" />
                    </td>
                    <th class="formTitle"><span class="tipSpan">*</span>Tên trường:</th>
                    <td class="formValue">
                        <input id="Table_Colunn_Name" name="Table_Colunn_Name" type="text" class="form-control required" />
                    </td>
                    <th class="formTitle"><span class="tipSpan">*</span>Kiểu trường:</th>
                    <td class="formValue">
                        <input id="Table_Column_Type" name="Table_Column_Type" type="text" class="form-control required" />
                        
                                <option value="varchar" selected>Chuỗi ký tự(Varchar)</option>
                                <option value="numeric">Số(Numeric)</option>
                                <option value="datetime">Thời gian(Datetime)</option>

                    </td>
                </tr>
                <tr>
                    <th class="formTitle">Thứ tự trường:</th>
                    <td class="formValue">
                        <input id="Table_Column_No" name="Table_Column_No" type="text" class="form-control required" />
                    </td>
                    <th class="formTitle"><span class="tipSpan">*</span>Tên phần tử:</th>
                    <td class="formValue">
                        <input id="Element_Name" name="Element_Name" type="text" autocomplete="off" class="form-control required" />
                    </td>
                    <th class="formTitle"><span class="tipSpan">*</span>Cờ sử dụng:</th>
                    <td class="formValue">
                        <select id="Sybz" name="Sybz" class="form-control required">
                            <option value="1" selected>Có</option>
                            <option value="0">Không</option>
                        </select>

                    </td>
                </tr>
                <tr>

                    <th class="formTitle">Giá trị:</th>
                    <td class="formValue">
                        <input id="AreValuemc" name="AreValuemc" type="text" autocomplete="off" class="form-control" />
                    </td>
                    <th></th>
                    <td></td>
                    <th></th>
                    <td></td>
                </tr>
                
                        <th class="formTitle"><span class="tipSpan">*</span>Phần tử ID:</th>
                        <td class="formValue">
                            <input id="Element_ID" name="Element_ID" type="text" class="form-control required" />
                        </td>
                        <th class="formTitle"><span class="tipSpan">*</span>Loại phần tử:</th>
                        <td class="formValue">
                            <select id="Element_Type" name="Element_Type" class="form-control required">
                                <option value="0">Văn bản(text)</option>
                                <option value="1">Danh sách thả xuống</option>
                                <option value="2">Chọn nhiều từ danh sách</option>
                                <option value="3">Ngày(dd/MM/yyyy)</option>
                                <option value="4">Thời gian(HH:mm)</option>
                                <option value="5">Ngày thời gian(dd/MM/yyyy HH:mm)</option>
                                <option value="6">Giá trị số</option>
                            </select>
                        </td>
                        <th class="formTitle">Số thứ tự phần tử:</th>
                        <td class="formValue">
                            <input id="Px" name="Px" type="text" class="form-control required" />
                        </td>

            </table>
            <div style="float:right;margin-top:0px">
                <a class="btn btn-primary" onclick="btn_edit()" id="saveoredit">Thêm mới</a>
                <a class="btn btn-primary" onclick="btn_ColumnDelete()" id="delete">Xóa</a>
                <a class="btn btn-primary" onclick="btn_clear()" id="cz">Đặt lại</a>
            </div>
        </div>
    </div>
</form>

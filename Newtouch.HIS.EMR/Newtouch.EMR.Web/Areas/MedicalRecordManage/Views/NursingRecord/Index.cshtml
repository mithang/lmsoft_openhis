@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
    var reportUrl = EmrConfig.GetAppConfigValue("ReportUrl");
}
<script src="@MvcHelper.GetStaticResourceScriptUrl("~/js/wdtree/tree.js")"></script>
<link href="@MvcHelper.GetStaticResourceScriptUrl("~/js/wdtree/tree.css")" rel="stylesheet" />
<style type="text/css">
    .ui-th-ltr, .ui-jqgrid .ui-jqgrid-htable th.ui-th-ltr {
        border: solid 1px #ddd;
    }

        .ui-th-ltr div, .ui-jqgrid .ui-jqgrid-htable th.ui-th-ltr div {
            text-align: center;
        }

    .ui-jqgrid .ui-jqgrid-btable tbody tr.jqgrow td {
        border: solid 1px #ddd;
    }

    .ui-jqgrid .table-bordered th {
        padding-top: 4px;
        padding-bottom: 4px;
    }

    .dv-left {
        width: 200px;
        float: left;
    }

    .dv-left-tree {
        overflow-y: auto;
        border-radius: 4px;
        background: white;
    }

    .dv-left-title {
        padding: 6px 10px;
        border-bottom: 1px solid transparent;
        border-top-left-radius: 3px;
        border-top-right-radius: 3px;
        border-color: #ddd;
        background-color: white;
    }

    .dv-right {
        float: left;
        margin-left: 5px;
    }

    .dv-right-order {
        width: 100%;
    }
</style>
<div class="dv-body">
    <div class="dv-left">
        <div class="panel panel-default">
            <div class="panel-heading navb-bg">
                Điều kiện lọc
            </div>
            <table class="form" style="width:95%">
                <tbody>
                    <tr>
                        <th class="formTitle">Họ tên/Số nhập viện:</th>
                        <td class="formValue">
                            <input id="keyword" type="text" onblur="getPatTreeList()" class="form-control">
                        </td>
                    </tr>
                    <tr>
                        <th class="formTitle">Đang nằm viện trạng thái:</th>
                        <td class="formValue formDdlSelectorTd">
                            <select class="form-control" id="zyzt">
                                <option value="">Tất cả</option>
                                <option value="zy" selected>Đang nằm viện</option>
                                <option value="cy">Ra viện</option>
                            </select>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="dv-left-title">
            Danh sách bệnh nhân
        </div>
        <div class="dv-left-tree" id="PatTreeList"></div>
    </div>
    <div class="dv-right">
        <form name="form1">
            <div class="panel panel-default" style="margin-bottom:5px;">

                <div style="padding: 2px 0;">
                    <table class="form">
                        <tr>
                            <th class="formTitle">Họ tên:</th>
                            <td class="formValue">
                                <label id="xm"></label>
                            </td>
                            <th class="formTitle">Giới tính:</th>
                            <td class="formValue">
                                <label id="xb"></label>
                            </td>
                            <th class="formTitle">Khu bệnh:</th>
                            <td class="formValue">
                                <label id="bq"></label>
                            </td>
                            <th class="formTitle">Tuổi:</th>
                            <td class="formValue">
                                <label id="nl"></label>
                            </td>
                        </tr>
                         <tr>
                            <td class="formValue formDdlSelectorTd">
                                <select id="hljllx" onchange="querytype()" class="form-control" style="width:100px;">
                                    <option value="0">Thông thường ghi chép điều dưỡng</option>
                                    <option value="1">Nguy kịch (nặng) Ghi chép điều dưỡng</option>
                                    <option value="2">Phẫu thuật ghi chép điều dưỡng</option>
                                </select>
                            </td>
                            <th class="formTitle">Ngày:</th>
                            <td class="formValue" colspan="4">
                                <input id="kssj" type="text" class="form-control input-wdatepicker" style="width:42%; float:left;" value="@DateTime.Now.ToString("yyyy-MM-01")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                                <span style="margin-left:1%;float:left">—</span>
                                <input id="jssj" type="text" class="form-control input-wdatepicker" style="width:43%; float:left;margin-left:1%;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                            </td>
                            <td class="formValue" hidden="hidden">
                                <input id="zyh" type="text" class="form-control" />
                            </td>
                            <th class="formTitle"></th>
                            <td class="formTitle"><input type="button" id="btn_search" style="width:100%;" class="btn btn-primary" value=" Tìm kiếm " /></td>

                            <td class="formValue" hidden="hidden">
                                <input type="button" id="btn_zyh" class="btn btn-default" value="Số nhập viện" />
                            </td>
                            
        <td class="formValue">
            <select id="WardCode" class="form-control">
                <option>
                    Tất cả
                </option>
            </select>

                            <td class="formTitle" hidden="hidden"><input onclick="showDelete()" value="0" name="isShowDelete" checked="checked" type="checkbox" />Hiển thị đã hủy</td>
                            <td class="formValue"></td>
                        </tr>
                        <tr>
                            <td class="formValue" colspan="4">
                                &nbsp;
                                <input type="button" id="btn_add" class="btn btn-primary" value=" Nhập mới " />
                                &nbsp;
                                <input type="button" id="btn_edit" class="btn btn-default" value=" Sửa " />
                                &nbsp;
                                <input type="button" id="btn_delete" class="btn btn-danger" style="margin-left:16px;" value=" Hủy hiệu lực " />
                                &nbsp;
                                <input type="button" id="btn_export" class="btn btn-default" value=" In " />
                                &nbsp;
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </form>
        <div id="gridPanel" class="gridPanel">
            <table id="gridList"></table>
        </div>
        
            <div class="gridPanel">
                <table id="gridListwz"></table>
            </div>
        </div>
        <div id="gridPanelss" class="gridPanel" style="display:none">
            <table id="gridListss"></table>

    </div>
</div>
<script>
        $(function () {
            $(window).resize(function () {//Tính lại chiều rộng và chiều cao khi cửa sổ trình duyệt thay đổi kích thước
                $(".dv-body").height($(window).height());
                $(".dv-body").width($(window).width());
            });
            var rightWidth = $(".Newtouch_iframe", parent.document).width() - $(".dv-left").width() - 30;
            $(".dv-right").width(rightWidth);
            var currentobj = JSON.parse(sessionStorage.getItem('currentpatobj'));//Danh sách bệnh nhân của y tá
            if (currentobj) {
                $('#zyh').val(currentobj.zyh);
                sessionStorage.removeItem("currentpatobj");
            }
            initControl();
            gridList();
            $("#gridList").jqGrid('setFrozenColumns');//Thiết lập cột cố định
            getPatTreeList();
            $('#zyzt').change(function () {
                getPatTreeList();
            });
    });
    function showDelete() {
        btn_search();
    }
    function initControl() {
        $('#btn_zyh').click(function () {
            $.modalOpen({
                id: "patSearch",
                title: "Tra cứu bệnh nhân nội trú",
                url: "/PatientList/InPatSearchView?allowunselected=true&zybz=1,2,3,7&t=" + Math.random() + "&zyh=" + '',
                width: "700px",
                height: "600px",
                callBack: function (iframeId) {
                    top.frames[iframeId].AcceptClick(function (patData) {
                        if (patData && patData.zyh) {
                            $('#zyh').val(patData.zyh);
                        }
                        else {
                            $('#zyh').val('');
                        }
                    });
                }
            });
        });

        $('#zyh').keyupEnterEvent(function () {
            btn_search();
		});

		//$("#WardCode").bindSelect({
		//	url: "/SystemManage/BaseData/GetAuthedWardSelectJson",
		//});
        $('#btn_search').click(function () {
            btn_search();
        });
    }
    function getPatTreeList() {
        $("#PatTreeList").treeview({
            height: $(window).height() - 150,
            slimscroll: false,
            showcheck: false,
            url: "/MedicalRecordManage/NursingRecord/GetPatWardTree?zyzt=" + $('#zyzt').val() + "&keyword=" + $('#keyword').val(),
            onnodeclick: function (item) {
                if (item.value && item.Ex1 == "c") {
                    getlistbyzyh(item.value, item.Ex2, item.Ex3);
                    $.ajax({
                        url: "/MedicalRecordManage/NursingRecord/GetPatWard",
                        data: { zyh: item.value },
                        dataType: "json",
                        async: false,
                        success: function (data) {
                            $("#xm").text(data.hzxm);
                            if (data.sex == "1") {
                                $("#xb").text("Nam");
                            }
                            else { $("#xb").text("Nữ"); }
                            $("#bq").text(data.bqmc);
                            $("#nl").text(data.nl+" tuổi");
                        }
                    });
                }
            }
        });
    }
    function getlistbyzyh(zyh,rqrq,cqrq) {
        $("#zyh").val(zyh);
        $("#kssj").val(rqrq);
        $("#jssj").val(cqrq);
        btn_search();
    }
    function querytype() {
        btn_search();
        //if ($("#hljllx").val() == "1") {
        //    $("#gridPaneltss").css("display", "none");
        //    $("#gridPanel").css("display", "none");
        //    $("#gridPanelwz").css("display", "block");
        //    gridListwz();
        //}
        //else if ($("#hljllx").val() == "2") {
        //    $("#gridPanel").css("display", "none");
        //    $("#gridPanelwz").css("display", "none");
        //    $("#gridPanelss").css("display", "block");
        //    gridListss();
        //} else {
        //    $("#gridPanelwz").css("display", "none");
        //    $("#gridPanelss").css("display", "none");
        //    $("#gridPanel").css("display", "block");
        //    gridList();
        //}
    }
    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            postData: {},
            url: "/MedicalRecordManage/NursingRecord/GetGridJson",
            postData: getSearchPostData(),
            height: $(window).height() - 150,
            colModel: [
                { label: "Id", name: "Id", hidden: true, frozen: true },
                {
                    label: "Số nhập viện", name: "zyh", width: 80, align: 'left',
                    formatter: function (cellvalue, options, rowobject) {
                        if (rowobject.zt == "0") {
                            cellvalue += '<span style="color:red;">【Hủy hiệu lực】</span>';
                        }
                        return cellvalue;
                    }, frozen: true
                },
                {
                    label: "Họ tên", name: "xm", width: 80, align: 'left', frozen: true
                },
                {
                    label: "Ngày", name: "rq", width: 110, align: 'left',
                    formatter: function (cellvalue, options, rowobject) {
                        //Trạng thái liên quan đến thời điểm ngày giờ
                        var val = $.getDate({ date: cellvalue });
                        val += " " + rowobject.sj;
                        if (rowobject.brzt) {
                            val += " " + $.enum.getDescByValue("EnumHlbrzt", rowobject.brzt);
                        }
                        return val;
                    }, frozen: true
                },
                { label: "Nhiệt độ(℃)", name: "tw", width: 70, align: 'left' },
                { label: "Mạch(Lần/min)", name: "ml", width: 70, align: 'left' },
                { label: "Tần số thở(Lần/min)", name: "hxpl", width: 70, align: 'left' },
                { label: "Huyết áp tâm thu(mm hg)", name: "ssy", width: 70, align: 'left' },
                { label: "Huyết áp tâm trương(mm hg)", name: "szy", width: 70, align: 'left' }, 
                { label: "Ý thức", name: "ys", width: 70, align: 'left' }, 
                { label: "Trái đồng tử", name: "tk_z", width: 70, align: 'left' }, 
                { label: "Phải đồng tử", name: "tk_y", width: 70, align: 'left' },
                { label: "Phản xạ ánh sáng-Trái", name: "dgfs_z", width: 70, align: 'left' }, 
                { label: "Phản xạ ánh sáng-Phải", name: "dgfs_y", width: 70, align: 'left' }, 
                { label: "Độ bão hòa oxy máu(%)", name: "xybhd", width: 70, align: 'left' },
                { label: "Thở oxy(L/min)", name: "xybhd", width: 70, align: 'left' },
                { label: "Chăm sóc da", name: "pfhl", width: 70, align: 'left' },
                { label: "Mô tả chăm sóc ống thông", name: "dghl", width: 70, align: 'left' },
                { label: "Theo dõi tình trạng bệnh và biện pháp", name: "hlgcjg", width: 70, align: 'left' },
                { label: "Thời điểm", name: "sj", width: 50, align: 'left', hidden: true },
                { label: "Cấp độ điều dưỡng", name: "hldj", width: 70, align: 'left' },
                { label: "Loại điều dưỡng", name: "hllx", width: 70, align: 'left' },
                { label: "Tiền sử dị ứng", name: "gms", width: 70, align: 'left' },
                { label: "Cân nặng(kg)", name: "tz", width: 70, align: 'left' },
                { label: "Mạch(Lần/min)", name: "ml", width: 70, align: 'left' },
                { label: "Dấu hiệu mạch động mạch mu chân", name: "zbdmbz", width: 70, align: 'left' },
                { label: "Tình hình ăn uống mã", name: "ysqk", width: 70, align: 'left' },
                { label: "Chăm sóc khí quản mã", name: "qghl", width: 70, align: 'left' },
                { label: "Chăm sóc tư thế", name: "twhl", width: 70, align: 'left' },
                { label: "Chăm sóc dinh dưỡng", name: "yyhl", width: 70, align: 'left' },
                { label: "Hướng dẫn ăn uống mã", name: "yszd", width: 70, align: 'left' },
                { label: "Chăm sóc tâm lý mã", name: "xlhl", width: 70, align: 'left' },
                { label: "Chăm sóc an toàn mã", name: "aqhl", width: 70, align: 'left' },
                { label: "Tóm tắt tình trạng bệnh", name: "jybq", width: 70, align: 'left' },
                { label: "Tên hạng mục quan sát điều dưỡng", name: "hlgcxm", width: 70, align: 'left' },
                { label: "Tên thao tác điều dưỡng", name: "hlczmc", width: 70, align: 'left' },
                { label: "Tên nhóm hạng mục thao tác điều dưỡng", name: "hlczxmmc", width: 70, align: 'left' },
                { label: "Kết quả thao tác điều dưỡng", name: "hlczjg", width: 70, align: 'left' },
                { label: "Cờ phát bảng kiểm tra an toàn phẫu thuật", name: "fcssaqb", width: 70, align: 'left' },
                { label: "Cờ thu hồi bảng kiểm tra an toàn phẫu thuật", name: "shssaqb", width: 70, align: 'left' },
                { label: "Cờ đã phát bảng đánh giá rủi ro phẫu thuật", name: "fcssfxpgb", width: 70, align: 'left' },
                { label: "Cờ đã thu hồi bảng đánh giá rủi ro phẫu thuật", name: "shssfxpgb", width: 70, align: 'left' },
                { label: "Dấu hiệu cách ly", name: "glbz", width: 70, align: 'left' },
                { label: "Loại cách ly mã", name: "glzl", width: 70, align: 'left' },
                { label: "Chữ ký điều dưỡng", name: "hsqm", width: 70, align: 'left' },
                { label: "Người nhập", name: "CreatorCode", width: 60, align: 'left' },
                { label: 'Thời gian nhập', name: 'CreateTime', width: 120, align: 'left', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
            ],
            rowNum: 10,
            //pager: "#gridPager",
            //sortname: 'rq , sj',
            viewrecords: true,
            rownumbers: false,
            ondblClickRow: function (rowid) {
                gridEditRow(rowid);
            },
            gridComplete: function () {

            }
        });
        //Menu cấp hai
        $gridList.jqGrid('setGroupHeaders', {
            useColSpanStyle: true,
            groupHeaders: [
                {
                    startColumnName: 'syl',
                    numberOfColumns: 4,
                    titleText: 'Lượng đưa vào'
                },
                {
                    startColumnName: 'otl',
                    numberOfColumns: 10,
                    titleText: 'Lượng thải ra'
                }
            ]
        });

        btn_search();
    }
    function btn_search() {
        $("#gridList").jqGrid('setGridParam', {
            postData: getSearchPostData(),
            page: 1,
        }).trigger('reloadGrid');
    }
    //Điều kiện truy vấn
    function getSearchPostData() {
        var kssj = $("#kssj").val();
        var jssj = $("#jssj").val();
        var zyh = $("#zyh").val();
        if (zyh!=null&&zyh!="") {
            zyh = zyh;
        }
		var wardCode ="";
		var isShowDelete = $("input[name='isShowDelete']")[0].checked;
        return { zyh: zyh, kssj: kssj, jssj: jssj, wardCode: wardCode, isShowDelete: isShowDelete, hllx: $("#hljllx").val()};
    };

    $("#btn_add").click(function () {
        InpatientVitalSignsForm();
    });

    $("#btn_edit").click(function () {
        var seleId = $('#gridList').jqGrid('getGridParam', 'selrow');
        if (seleId) {
            //Yêu cầu sửa dòng này
            gridEditRow(seleId);
        }
        else {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
    });

    $("#btn_delete").click(function () {
        var seleId = $('#gridList').jqGrid('getGridParam', 'selrow');
        if (seleId) {
            //Yêu cầu hủy dòng này
            gridDeleteRow(seleId);
        }
        else {
            $.modalAlert("Vui lòng chọn một bản ghi", 'warning');
            return;
        }
    });
    $("#btn_export").click(function () {
        var reportServerHOST = '@(ViewBag.ReportServerHOST)';
        var orgId = '@(ViewBag.OrgId)';
        var kssj = $("#kssj").val();
        var jssj = $("#jssj").val();
        var zyh = $('#zyh').val();
        if (!zyh) {
            $.modalAlert("Thiếu số nhập viện", "warning");
            return;
        }
        var yzlx = "hljld" +"|" +$("#hljllx").val();
        window.open("/SystemManage/YzPreView/YzPreView?zyh=" + zyh + "&orgId=" + orgId + "&yzlx=" + yzlx);
       

    });
    function gridEditRow(rowid) {
        var rowData = $("#gridList").jqGrid('getRowData', rowid);
        InpatientVitalSignsForm(rowData.Id);
    }

    function gridDeleteRow(rowid) {
        var rowData = $("#gridList").jqGrid('getRowData', rowid);
        $.deleteForm({
            prompt: "Chú ý: Bạn có chắc muốn hủy【" + "Số nhập viện:" + rowData.zyh + "<br/>Thời gian:" + rowData.rq+ "】dữ liệu này không??",
            url: "/MedicalRecordManage/NursingRecord/DeleteForm",
            param: { keyValue: rowData.Id },
            success: function () {
                $("#gridList").trigger("reloadGrid");
            }
        })
    }

    function InpatientVitalSignsForm(smtzId) {
        if ($("#zyh").val()=="") {
            $.modalAlert("Vui lòng chọn bệnh nhân!", "warning");
            return;
        }
        if ($("#hljllx").val() == "1") {
            $.modalOpen({
                id: "InpatientVitalSignsForm",
                title: "Nhập hồ sơ chăm sóc bệnh nặng",
                url: "/MedicalRecordManage/NursingRecord/WZForm?smtzId=" + smtzId + "&zyh=" + $("#zyh").val() + "&xm=" + $("#xm").text(),
                width: "900px",
                height: "750px",
                showleftlalbel: !!!smtzId,  //Hiển thị khi thêm mới 'Nút xác nhận và đóng'
                leftlalbelchecked: true,
                leftlabeltext: "Nhập liên tục",
                leftlalbelcheckedasClose: false,
                callBack: function (iframeId, isClose) {
                    var ret = top.frames[iframeId].AcceptClick(function () {
                        $("#gridList").trigger("reloadGrid");
                        if (isClose === undefined || isClose === true) {
                            top.frames[iframeId].$.modalClose();
                        }
                    });
                }
            });
        } else if ($("#hljllx").val() == "2") {
            $.modalOpen({
                id: "InpatientVitalSignsForm",
                title: "Nhập hồ sơ chăm sóc phẫu thuật",
                url: "/MedicalRecordManage/NursingRecord/SSForm?smtzId=" + smtzId + "&zyh=" + $("#zyh").val() + "&xm=" + $("#xm").text(),
                width: "900px",
                height: "750px",
                showleftlalbel: !!!smtzId,  //Hiển thị khi thêm mới 'Nút xác nhận và đóng'
                leftlalbelchecked: true,
                leftlabeltext: "Nhập liên tục",
                leftlalbelcheckedasClose: false,
                callBack: function (iframeId, isClose) {
                    var ret = top.frames[iframeId].AcceptClick(function () {
                        $("#gridList").trigger("reloadGrid");
                        if (isClose === undefined || isClose === true) {
                            top.frames[iframeId].$.modalClose();
                        }
                    });
                }
            });
        } else {
            $.modalOpen({
                id: "InpatientVitalSignsForm",
                title: "Nhập hồ sơ chăm sóc chung",
                url: "/MedicalRecordManage/NursingRecord/Form?smtzId=" + smtzId + "&zyh=" + $("#zyh").val() + "&xm=" + $("#xm").text(),
                width: "800px",
                height: "700px",
                showleftlalbel: !!!smtzId,  //Hiển thị khi thêm mới 'Nút xác nhận và đóng'
                leftlalbelchecked: true,
                leftlabeltext: "Nhập liên tục",
                leftlalbelcheckedasClose: false,
                callBack: function (iframeId, isClose) {
                    var ret = top.frames[iframeId].AcceptClick(function () {
                        $("#gridList").trigger("reloadGrid");
                        if (isClose === undefined || isClose === true) {
                            top.frames[iframeId].$.modalClose();
                        }
                    });
                }
            });
        }
        
	}


</script>

<script>
// PER-APP (B) redesign: nut "Sua" chi bat khi co dong duoc chon (trang thai truc quan;
// handler von da chan khi chua chon - day chi la lop vo hieu truc quan).
$(function () {
    try {
        function rdSyncEditState() {
            var sel = $("#gridList").jqGrid("getGridParam", "selrow");
            var has = !!sel;
            $("#btn_edit").prop("disabled", !has);
            $("#btn_edit").attr("aria-disabled", has ? "false" : "true");
        }
        $("#gridList").on("jqGridSelectRow jqGridGridComplete jqGridAfterGridComplete", rdSyncEditState);
        rdSyncEditState();
    } catch (e) { /* tang cuong giao dien: khong lam hong trang neu luoi chua khoi tao */ }
});
</script>

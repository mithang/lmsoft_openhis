
@{
    Layout = null;
}
<style>
    #dv_fee input {
        border-top: none;
        border-left: none;
        border-right: none;
        text-wrap: normal;
        border-bottom-color: #74e8b5;
    }
</style>
<div id="dv_fee">
    <table class="form">
        <tr>
            <th class="formTitle" style="font-weight:bold;">Tổng chi phí nằm viện (nhân dân tệ)</th>
            <td class="formValue">
                <input id="ZFY" name="ZFY" class="form-control" style="font-weight:bold;" attr-desc="Tổng chi phí nằm viện" readonly/>
            </td>
            <td class="formValue" colspan="4">
                <span style="float:left;padding-right:10px;padding-top: 5px;">(Trong đó: số tiền tự trả</span>
                <input id="ZFJE" name="ZFJE" class="form-control" style="width:90px;float:left;" attr-desc="Số tiền tự trả" readonly />
                <span style="float:left;padding-right:10px;padding-top: 5px;">Thanh toán khác</span>
                <input id="QTFY" name="QTFY" class="form-control" style="width:90px;float:left;" attr-desc="Thanh toán khác" readonly />
                <span style="float:left;padding-right:10px;padding-top: 5px;">）</span>
            </td>
            @*Hủy hiển thị xét duyệt theo yêu cầu của bệnh viện
          *@<th class="formTitle">Đã xét duyệt hay chưa</th>
            <td class="formValue">
                <select id="SWHZSJ" name="SWHZSJ" class="form-control" data-enumtype="EnumYorN"></select>
                <input style="height:0px;border-width:1px;" class="form-control" />
            </td>*@
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">1.Loại dịch vụ y tế tổng hợp</td>
            <th class="formTitle">(1)Phí dịch vụ y tế thông thường</th>
            <td class="formValue"><input id="YLFUF" name="YLFUF" class="form-control" attr-desc="Phí dịch vụ y tế thông thường" readonly/></td>
            <th class="formTitle">(2)Phí thủ thuật điều trị thông thường</th>
            <td class="formValue"><input id="ZLCZF" name="ZLCZF" class="form-control" attr-desc="Phí thao tác điều trị thông thường" readonly/></td>
            <th class="formTitle">(3)Phí điều dưỡng</th>
            <td class="formValue"><input id="HLF" name="HLF" class="form-control" attr-desc="Phí điều dưỡng" readonly/></td>
            <th class="formTitle">(4)Chi phí khác</th>
            <td class="formValue"><input id="QTFY" name="QTFY" class="form-control" attr-desc="Chi phí khác" readonly/></td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">2.Loại chẩn đoán</td>
            <th class="formTitle">(5)Phí chẩn đoán bệnh lý</th>
            <td class="formValue"><input id="BLZDF" name="BLZDF" class="form-control" attr-desc="Phí chẩn đoán bệnh lý" readonly/></td>
            <th class="formTitle">(6)Phí chẩn đoán xét nghiệm</th>
            <td class="formValue"><input id="SYSZDF" name="SYSZDF" class="form-control" attr-desc="Phí chẩn đoán phòng xét nghiệm" readonly/></td>
            <th class="formTitle">(7)Phí chẩn đoán hình ảnh</th>
            <td class="formValue"><input id="YXXZDF" name="YXXZDF" class="form-control" attr-desc="Phí chẩn đoán hình ảnh" readonly/></td>
            <th class="formTitle">(8)Phí hạng mục chẩn đoán lâm sàng</th>
            <td class="formValue"><input id="LCZDXMF" name="LCZDXMF" class="form-control" attr-desc="Phí hạng mục chẩn đoán lâm sàng" readonly/></td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">3.Loại điều trị</td>
            <th class="formTitle">(9)Phí hạng mục điều trị không phẫu thuật</th>
            <td class="formValue"><input id="FSSZLXMF" name="FSSZLXMF" class="form-control" attr-desc="Phí hạng mục điều trị không phẫu thuật" readonly/></td>
            <td class="formValue" colspan="3">
                <span style="float:left;padding-right:10px;padding-top: 5px;">(Trong đó: phí vật lý trị liệu lâm sàng</span>
                <input id="WLZLF" name="WLZLF" class="form-control" style="width:50%;float:left;" attr-desc="Phí vật lý trị liệu lâm sàng" readonly/>
                <span style="float:left;padding-right:10px;padding-top: 5px;">）</span>
            </td>
        </tr>
        <tr>
            <td class="formValue"></td>
            <th class="formTitle">(10)Phí điều trị phẫu thuật</th>
            <td class="formValue"><input id="SSZLF" name="SSZLF" class="form-control" attr-desc="Phí điều trị phẫu thuật" readonly/></td>
            <td class="formValue" colspan="4">
                <span style="float:left;padding-right:10px;padding-top: 5px;">(Trong đó: phí gây mê</span>
                <input id="MAF" name="MAF" class="form-control" style="width:30%;float:left;" attr-desc="Phí gây mê" readonly/>
                <span style="float:left;padding-right:10px;padding-top: 5px;">Phí phẫu thuật</span>
                <input id="SSF" name="SSF" class="form-control" style="width:30%;float:left;" attr-desc="Phí phẫu thuật" readonly/>
                <span style="float:left;padding-right:10px;padding-top: 5px;">）</span>
            </td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">4.Loại phục hồi chức năng</td>
            <th class="formTitle">(11)Phí phục hồi chức năng</th>
            <td class="formValue"><input id="KFF" name="KFF" class="form-control" attr-desc="Phí phục hồi chức năng" readonly/></td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">5.Loại Đông y</td>
            <th class="formTitle">(12)Phí điều trị Đông y</th>
            <td class="formValue"><input id="ZYZLF" name="ZYZLF" class="form-control" attr-desc="Phí điều trị Đông y" readonly/></td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">6.Loại thuốc Tây</td>
            <th class="formTitle">(13)Phí thuốc Tây</th>
            <td class="formValue"><input id="XYF" name="XYF" class="form-control" attr-desc="Phí thuốc Tây" readonly/></td>
            <td class="formValue" colspan="3">
                <span style="float:left;padding-right:10px;padding-top: 5px;">(Trong đó: chi phí thuốc kháng khuẩn</span>
                <input id="KJYWF" name="KJYWF" class="form-control" style="width:50%;float:left;" attr-desc="Chi phí thuốc kháng khuẩn" readonly/>
                <span style="float:left;padding-right:10px;padding-top: 5px;">）</span>
            </td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">7.Loại thuốc Đông y</td>
            <th class="formTitle">(14)Phí thuốc thành phẩm Đông y</th>
            <td class="formValue"><input id="ZCYF" name="ZCYF" class="form-control" attr-desc="Phí thuốc thành phẩm Đông y" readonly/></td>
            <th class="formTitle">(15)Phí thảo dược Đông y</th>
            <td class="formValue"><input id="ZCYF1" name="ZCYF1" class="form-control" attr-desc="Phí thuốc thảo dược Trung Quốc" readonly/></td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">8.Loại máu và chế phẩm máu</td>
            <th class="formTitle">(16)Phí máu</th>
            <td class="formValue"><input id="XF" name="XF" class="form-control" attr-desc="Phí máu" readonly/></td>
            <th class="formTitle" colspan="2">(17)Phí chế phẩm albumin</th>
            <td class="formValue"><input id="BDBLZPF" name="BDBLZPF" class="form-control" attr-desc="Phí chế phẩm albumin" readonly/></td>
            <th class="formTitle" colspan="2">(18)Phí chế phẩm globulin</th>
            <td class="formValue"><input id="QDBLZPF" name="QDBLZPF" class="form-control" attr-desc="Phí chế phẩm globulin" readonly/></td>
        </tr>
        <tr>
            <td class="formValue"></td>
            <th class="formTitle">(19)Phí chế phẩm yếu tố đông máu</th>
            <td class="formValue"><input id="NXYZLZPF" name="NXYZLZPF" class="form-control" attr-desc="Phí chế phẩm yếu tố đông máu" readonly/></td>
            <th class="formTitle" colspan="2">(20)Phí chế phẩm cytokine</th>
            <td class="formValue"><input id="XBYZLZPF" name="XBYZLZPF" class="form-control" attr-desc="Phí chế phẩm cytokine" readonly/></td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">9.Loại vật tư tiêu hao</td>
            <th class="formTitle">(21)Phí vật tư y tế dùng một lần cho kiểm tra</th>
            <td class="formValue"><input id="HCYYCLF" name="HCYYCLF" class="form-control" attr-desc="Phí vật liệu y tế dùng một lần cho kiểm tra" readonly/></td>
            <th class="formTitle" colspan="2">(22)Phí vật tư y tế dùng một lần cho điều trị</th>
            <td class="formValue"><input id="YYCLF" name="YYCLF" class="form-control" attr-desc="Phí vật liệu y tế dùng một lần cho điều trị" readonly/></td>
            <th class="formTitle" colspan="2">(23)Phí vật tư y tế dùng một lần cho phẫu thuật</th>
            <td class="formValue"><input id="YCXYYCLF" name="YCXYYCLF" class="form-control" attr-desc="Phí vật liệu y tế dùng một lần cho phẫu thuật" readonly/></td>
        </tr>
        <tr>
            <td class="formValue" style="font-weight:bold;">10.Loại khác</td>
            <th class="formTitle">(24)Phí khác</th>
            <td class="formValue"><input id="QTF" name="QTF" class="form-control" attr-desc="Phí khác" readonly/></td>
        </tr>
    </table>
</div>
<script>

    function FyListGrid() {
        $.ajax({
            url: "/MRHomePage/MRHomePage/GetFormJsonFee?keyValue=" + keyValue,
            data: { zyh: zyh },
            loading: "正在同步数据...",
            type: "post",
            success: function (data) {
                SyncFee(data);
            }
        });
    }
    function SyncFee(data) {
        var jsonObj = JSON.parse(data);
        for (var item in jsonObj) {
            if ($("#dv_fee input[id=" + item + "]").length > 0 && !!jsonObj[item]) {
                $("#dv_fee input[id=" + item + "]").val(parseFloat(jsonObj[item]).toFixed(2));
            }
            else {
                $("#dv_fee input[id=" + item + "]").val("");
            }
        }
    }

</script>


@{
	Layout = null;
}
<style>
	/*.ui-jqgrid .ui-jqgrid-bdiv{
		border-top:1px solid #74e8b5;
		overflow-x:auto;
	}

	.frozen-div, .frozen-bdiv{
		background-color:#fff;
	}*/
</style>
<div id="dv_edit_op">
	<div>
		<table id="gridopList"></table>
	</div>
	<div>
		@Html.Partial("MainOpEdit")
	</div>
</div>
<script>

	function OpListGrid() {
		var $gridList = $("#gridopList");
		$gridList.dataGrid({
			postData: {
				bah: $("#BAH").val(),
				zyh: $("#ZYH").val(),
			},
			url: "/MRHomePage/MRHomePage/GetOpGridList",
			height: $(window).height() - 150,
			width: $(window).width() - 120,
			colModel: [
				{ label: "Id", name: "Id", hidden: true },
				{ label: "Số hồ sơ bệnh án", name: "BAH", width: 60, align: 'left' },
				{ label: "Số nhập viện", name: "ZYH", width: 60, align: 'left' },
				{ label: "Phẫu thuật và<br />Thao tác mã", name: "SSJCZBM", width: 80, align: 'center' },
				{ label: "Phẫu thuật và<br />Thao tác ngày", name: "SSJCZRQ", width: 130, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
				{ label: "Phẫu thuật<br />Cấp độ", name: "SSJB", width: 60, align: 'center' },
				//{ label: "CYQK", name: "CYQK", hidden: true },
				{ label: "Phẫu thuật và thao tác tên", name: "SSJCZMC", width: 150, align: 'center' },
				{ label: "SZ", name: "SZ", hidden: true },
				{ label: "Bác sĩ phẫu thuật chính", name: "SZMC", width: 50, align: 'center' },
				{ label: "YZ", name: "YZ", hidden: true },
				{ label: "Trợ lý I", name: "YZMC", width: 50, align: 'center' },
				{ label: "EZ", name: "EZ", hidden: true },
				{ label: "Trợ lý II", name: "EZMC", width: 50, align: 'center' },
				{ label: "QKDJ", name: "QKDJ", hidden: true },
				{ label: "QKYHLB", name: "QKYHLB", hidden: true },
				{ label: "Mức độ<br />lành vết mổ", name: "QKYHDJ", width: 50, align: 'center' },
				//{
				//    label: "Vết mổ lành<br />cấp độ", name: "QKYHDJ", width: 50, align: 'center', formatter: function (row, option, data) {
				//        return data.QKDJ + "/" + data.QKYLB;
				//    }
				//},
				{ label: "MZYS", name: "MZYS", hidden: true },
                { label: "Bác sĩ gây mê:", name: "MZYSMC", width: 50, align: 'center' },
				{ label: "MZFS", name: "MZFS", hidden: true },
				{ label: "Phương pháp gây mê", name: "MZFSMS", width: 100, align: 'center' },
				{ label: "SSLX", name: "SSLX", hidden: true },
				{
					label: "Có không<br />Cấp cứu phẫu thuật", name: "SSLX", width: 100, align: 'center', formatter: function (row, option, data) {
						if (data.SSLX == "0") {
							return "Không";
						}
						else {
							return "Có";
						}
					}
				},
				{ label: "SSKSSJ", name: "SSKSSJ", hidden: true },
				{ label: "Phẫu thuật<br />Ngày bắt đầu", name: "SSKSSJ", width: 130, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
				{ label: "SSJSSJ", name: "SSJSSJ", hidden: true },
				{ label: "Phẫu thuật<br />Ngày kết thúc", name: "SSJSSJ", width: 130, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
				{ label: "SQZBSJT", name: "SQZBSJT", hidden: true },
				{ label: "Trước mổ<br />Số ngày chuẩn bị", name: "SQZBSJT", width: 50, align: 'center' },
				{ label: "SQYFKJGYS", name: "SQYFKJGYS", hidden: true },
				{ label: "Dự phòng trước mổ<br />Thời gian dùng kháng sinh:", name: "SQYFKJGYS", width: 130, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },

				{ label: "MZKSSJNYR", name: "MZKSSJNYR", hidden: true },
				{ label: "Thời gian bắt đầu gây mê:", name: "MZKSSJNYR", width: 130, align: 'center', formatter: "date", formatoptions: { srcformat: 'Y-m-d H:i:s', newformat: 'Y-m-d H:i:s' } },
				{ label: "MZFJ_ASA", name: "MZFJ_ASA", hidden: true },
				{ label: "ASA<br />Cấp độ gây mê:", name: "MZFJ_ASA", width: 50, align: 'center' },
				{ label: "QKBW", name: "QKBW", hidden: true },
				{ label: "Vị trí vết mổ :", name: "QKBW", width: 50, align: 'center' },
				{ label: "SSQKGR", name: "SSQKGR", hidden: true },
				{
					label: "Phẫu thuật<br />Nhiễm trùng vết mổ :", name: "SSQKGR", width: 50, align: 'center'
				},
				{ label: "SSBFZ", name: "SSBFZ", hidden: true },
				{
					label: "Phẫu thuật<br />Biến chứng", name: "SSBFZ", width: 100, align: 'center'
				},
				{ label: "SSBFZMC", name: "SSBFZMC", hidden: true },
				{ label: "Phẫu thuật<br />Tên biến chứng", name: "SSBFZMC", width: 100, align: 'center' },
				{ label: "zt", name: "zt", hidden: true },
				{
					label: "Trạng thái", name: "ztsm", width: 50, align: 'center', formatter: function (row, option, data) {
						if (data.zt == "0") {
							return "Hủy hiệu lực";
						}
						else {
							return "Bình thường";
						}
					}
				}
			],
			shrinkToFit: false,
			autoScroll: true,
			onSelectRow: function (row) {
				$(".dv-left").show();
				var rowData = $('#gridopList').jqGrid('getRowData', row);
				$("#op_ssdm").val(rowData.SSJCZMC);
				$("#op_ssdm").attr("attr-ssdm", rowData.SSJCZBM);
				$("#op_ssdm").attr("attr-ssjb", rowData.SSJB);
				$("#op_ssrq").val(rowData.SSJCZRQ);
				$("#op_ssdm").val(rowData.SSJCZMC);
				$("#op_yhdj").val(rowData.QKDJ).trigger("change");
				$("#op_yhlb").val(rowData.QKYHLB).trigger("change");
				$("#op_mzfs").val(rowData.MZFS).trigger("change");
				$("#op_zdys").val(rowData.SZMC);
				$("#op_zdys").attr("data-StaffGh", rowData.SZ);
				$("#op_sszl1").val(rowData.YZMC);
				$("#op_sszl1").attr("data-StaffGh", rowData.YZ);
				$("#op_sszl2").val(rowData.EZMC);
				$("#op_sszl2 ").attr("data-StaffGh", rowData.EZ);
				$("#op_mzys").val(rowData.MZYSMC);
				$("#op_mzys").attr("data-StaffGh", rowData.MZYS);
				var index = rowData.SSLX == "Phẫu thuật theo lịch" ? '0' : '1';
				$("#SSLX").val(index);
				$("#SSKSSJ").val(rowData.SSKSSJ);
				$("#SSJSSJ").val(rowData.SSJSSJ);
				$("#SQZBSJT").val(rowData.SQZBSJT);
				$("#SQYFKJGYS").val(rowData.SQYFKJGYS);
                $("#op_mzys").val(rowData.MZYSMC);
				$("#op_mzys").attr("data-StaffGh", rowData.MZYS);
				$("#MZFJ_ASA").val(rowData.MZFJ_ASA);
				$("#MZKSSJNYR").val(rowData.MZKSSJNYR);
				$("#QKBW").val(rowData.QKBW);
				$("#SSJB").val(rowData.SSJB);
				var tt = rowData.SSQKGR == "Có" ? 1 : 2;
				$("#SSQKGR").val(tt);
				var ff = rowData.SSBFZ == "Có" ? '1' : '2';
				$("#SSBFZ").val(ff);

				var arr = rowData.SSBFZMC.split(',')
				var obj = document.getElementsByName("SSBFZMC");
				for (var i = 0; i < arr.length; i++) {
					for (k in obj) {
						if (arr[i] == obj[k].value) {
							var id = obj[k].id
							$("#" + obj[k].id).prop("checked", true);
						}
					}
				}

				$("#op_rowid").val(row);

			},
			loadComplete: function () {

			},
			gridComplete: function () {

				$("#gridopList").closest(".ui-jqgrid-bdiv").css({ "overflow-x": "scroll" });
			},
			/*caption: "Danh sách phẫu thuật",*/

			//rowNum: 15,
			//pager: "#gridzdPager",
			viewrecords: false,
			shrinkToFit: false,
			autoScroll: true

		});
		// jQuery("#gridopList").jqGrid('navGrid', '#gridzdPager', { edit: false, add: false, del: false });
		jQuery("#gridopList").jqGrid('sortableRows');

	}

</script>
            $.modalAlert('Thông tin bệnh nhân: tuổi trẻ sơ sinh nhỏ hơn hoặc bằng 28 ngày thì phải điền 【Cân nặng lúc vào viện của trẻ sơ sinh】', 'warning');
            return false;

    function amountcheck(str) {
        //Số tiền chỉ cho phép số dương
        //var exp = /(^[1-9]([0-9]+)?(\.[0-9]{1,2})?$)|(^(0){1}$)|(^[0-9]\.[0-9]([0-9])?$)/; 
        //Số tiền cho phép số dương(+) số âm
        //var exp = /(^([+-]?)[1-9]([0-9]+)?(\.[0-9]{1,2})?$)|(^([+-]?)(0){1}$)|(^([+-]?)[0-9]\.[0-9]([0-9])?$)/; 

        //Số tiền cho phép số dương và số âm
        var exp = /(^([-]?)[1-9]([0-9]+)?(\.[0-9]{1,4})?$)|(^([-]?)(0){1}$)|(^([-]?)[0-9]\.[0-9]([0-9])?$)/;
        if (exp.test(str)) {
            return true;
        } else {
            return false;
        }
    }
    //Kiểm tra định dạng chi phí
    function amtCheck() {
        var jecheck = "";
        $("#dv_fee input[attr-desc]").each(
            function () {
                var fee = $(this).val();
                if (fee != "" && fee != undefined) {
                    if (!amountcheck(fee)) {
                        jecheck += $(this).attr('attr-desc') + "Định dạng sai;";
                    }
                }
            }
        );

        return jecheck;
    }
    //Tham số thông tin bệnh nhân
    function getfromPara() {
        var para = $("#frm_edit").formSerialize();
        savecitycode(para);
        $("input[data-code]").each(function () {
            var code = $(this).attr("data-code");
            var name = "R_" + $(this).attr("name");
            para[name] = code;
        }
        );
        $("input[data-staffgh]").each(function () {
            var code = $(this).attr("data-staffgh");
            var name = "R_" + $(this).attr("name");
            para[name] = code;
        }
        );

        return para;
    }
    function getSex() {
        var para = getfromPara();
        var idCard = para.SFZH;
        var sexStr = "";
        if (parseInt(idCard.slice(-2, -1)) % 2 == 1) {
            sexStr = "Nam";
        } else {
            sexStr = "Nữ";
        }
        return sexStr;
    };
    function getnl() {
            var para = getfromPara();
            var idCard = para.SFZH;
            var ageDate = new Date()
            var month = ageDate.getMonth() + 1
            var day = ageDate.getDate()
            var age = ageDate.getFullYear() - idCard.substring(6, 10) - 1
            if (idCard.substring(10, 12) < month || idCard.substring(10, 12) === month && idCard.substring(12, 14) <= day) {
                age++
            }
            if (age <= 0) {
                age = 1
            }
            return age
    }
    function testandverify(para){

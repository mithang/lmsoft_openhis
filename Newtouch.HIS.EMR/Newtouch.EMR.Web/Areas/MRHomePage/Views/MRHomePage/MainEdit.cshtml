                case "#linkpat":
                    $("#dv-pat").show();
                    $("#dv-op").hide();
                    $("#dv-zd").hide();
                    $("#dv-zyinfo").hide();
					$("#dv-fee").hide();
					$("#dv-fy").hide();
                    break;
                case "#linkop":
                    $("#dv-pat").hide();
                    $("#dv-op").show();
                    $("#dv-zd").hide();
                    $("#dv-zyinfo").hide();
					$("#dv-fee").hide();
					$("#dv-fy").hide();
                    OpListGrid();
                    break;
                case "#linkzd":
                    $("#dv-pat").hide();
                    $("#dv-zd").show();
                    $("#dv-op").hide();
                    $("#dv-zyinfo").hide();
					$("#dv-fee").hide();
					$("#dv-fy").hide();

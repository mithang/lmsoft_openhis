                    break;
                case "#linkzyinfo":
                    $("#dv-zyinfo").show();
                    $("#dv-op").hide();
                    $("#dv-pat").hide();
                    $("#dv-zd").hide();
					$("#dv-fee").hide();
					$("#dv-fy").hide();
                    break;
                case "#linkfee":

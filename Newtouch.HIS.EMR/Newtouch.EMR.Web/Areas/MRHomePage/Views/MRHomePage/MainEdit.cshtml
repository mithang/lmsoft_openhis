    function GetblData(jydm) {
        var ret = 0;
        if (!!jydm) {
            $.najax({
                url: "/MRHomePage/MRHomePage/HomePageUploadJS",
                data: { zyh: $("#ZYH").val(), jydm: jydm },
                dataType: "json",
                async: false,
                success: function (data) {
                    if (data != null && data != undefined) {
                        ret = Upload(data);
                    }
                    else {
                        $.modalAlert("Tải lên thất bại, Vui lòng xem nhật ký", "error");
                    }
                }
            });
        }
        return ret;
    }


    function Upload(jsondata) {
        $.ajax({
            url: "http://127.0.0.1:33333/api/QHDSmartCheck/MedicalRecordUpload",//Kiểm tra thông minh
            dataType: "json",
            data: jsondata,
            type: "POST",
            async: true,
            success: function (ajaxdata) {
                if (!!ajaxdata) {
                    var resp = JSON.parse(ajaxdata);
                    if (resp.code == "-1") {
                        $.modalAlert("Tải lên thất bại" + resp.message, "error");
                    }
                    else {
                        $.modalAlert("Tải lên thành công", "success");
                        UpdateYbUpload();
                        return 1;
                    }
                }
                else
                    $.modalAlert("Tải lên thất bại, Vui lòng xem nhật ký", "error");

            }
        });
    }


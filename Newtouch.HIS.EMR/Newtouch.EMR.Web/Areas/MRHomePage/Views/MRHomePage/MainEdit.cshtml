            $.modalAlert('Khi có lượng máu truyền thì phản ứng truyền máu không thể là chưa truyền', 'warning');
            return false;
        }
        if (xindex <= 0 && para.SXFY != 3) {
            $.modalAlert('Khi không có lượng máu truyền thì phản ứng truyền máu phải là chưa truyền', 'warning');
            return false;
        }
        if (ovpraseFloat(para.ZFY)<=0) {
            $.modalAlert('Thông tin chi phí: tổng chi phí nằm viện của bệnh nhân phải lớn hơn 0', 'warning');
            return false;
        }
        if (ovpraseFloat(para.ZFY) < ovpraseFloat(para.ZFJE)) {
            $.modalAlert('Thông tin chi phí: tổng chi phí nằm viện của bệnh nhân phải lớn hơn số tiền tự trả', 'warning');
            return false;
        }
        if (ovpraseFloat(para.FSSZLXMF) < ovpraseFloat(para.WLZLF) ) {
            $.modalAlert('Thông tin chi phí: phí hạng mục điều trị không phẫu thuật phải lớn hơn hoặc bằng phí vật lý trị liệu lâm sàng', 'warning');
            return false;
        }
        if (ovpraseFloat(para.SSZLF) < (ovpraseFloat(para.MAF) + ovpraseFloat(para.SSF))) {
            $.modalAlert('Thông tin chi phí: phí điều trị phẫu thuật phải lớn hơn hoặc bằng tổng phí gây mê và phí phẫu thuật', 'warning');
            return false;
        }
        if (ovpraseFloat(para.XYF) < ovpraseFloat(para.KJYWF)) {
            $.modalAlert('Thông tin chi phí: phí thuốc Tây phải lớn hơn hoặc bằng chi phí thuốc kháng khuẩn', 'warning');
            return false;
        }
    }
    function ovpraseFloat(val) {
        if (!val) {
            val = 0;
        }
        return parseFloat(val);
    }

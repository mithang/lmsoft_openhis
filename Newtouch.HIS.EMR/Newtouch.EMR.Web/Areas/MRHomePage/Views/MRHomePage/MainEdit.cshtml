            return false;
        }
        if (para.XSECSTZ != "" && (para.XSECSTZ < 100 || para.XSECSTZ > 9999)) {
            $.modalAlert('Thông tin bệnh nhân: khoảng cân nặng của trẻ sơ sinh là 100g-9999g', 'warning');

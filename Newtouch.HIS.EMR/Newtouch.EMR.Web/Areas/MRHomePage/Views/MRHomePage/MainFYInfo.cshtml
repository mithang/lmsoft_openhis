
@{
	Layout = null;
}
<style>
	#dv_zyinfo input {
		border-top: none;
		border-left: none;
		border-right: none;
		text-wrap: normal;
		border-bottom-color: #74e8b5;
	}

	.spanleft {
		float: left;
		padding-top: 5px;
	}

	.spanright {
		float: right;
		padding-top: 5px;
	}

	/*td span[role=combobox]
	{
		border:none;
	}*/
</style>
<div id="dv_zyinfo">
	<div>
        <table class="form">
            <tr>
                <th class="formTitle ">Tình trạng nhiễm khuẩn bệnh viện:</th>
                <td class="formValue">
                    <select id="YYGRQK" name="YYGRQK" class="form-control" data-enumtype="EnumHorN"></select>
                    <input style="height:0px;border-width:1px;" class="form-control" />
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px;">1.Có&nbsp;&nbsp;2.Không có</span>
                </td>
                <th class="formTitle " style="padding-right: 50px;padding-left: 25px;">Nhiễm khuẩn bệnh viện có liên quan đến phẫu thuật không:</th>
                <td class="formValue">
                    <select id="YYGRSSXG" name="YYGRSSXG" class="form-control" data-enumtype="EnumYorN">
                        <option>-</option>
                    </select>
                    <input style="height:0px;border-width:1px;" class="form-control" />
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px;">1.Có&nbsp;&nbsp;2.Không</span>
                </td>
                <th class="formTitle " style="padding-right:100px;padding-left: 50px;">Nhiễm khuẩn bệnh viện có liên quan đến thao tác xâm lấn không:</th>
                <td class="formValue">
                    <select id="YYGRSFQRXG" name="YYGRSFQRXG" class="form-control" data-enumtype="EnumHorN">
                        <option>-</option>
                    </select>
                    <input style="height:0px;border-width:1px;" class="form-control" />
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px;">1.Có&nbsp;&nbsp;2.Không có</span>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Tình hình sử dụng kháng sinh:</th>
                <td class="formValue">
                    <div style="width:100px; float:left;">
                        <select id="KJYWSYQK" name="KJYWSYQK" class="form-control" data-enumtype="EnumKJYWSYQK">
                            <option>-</option>
                        </select>
                        <input style="height:0px;border-width:1px;" class="form-control" />
                    </div>
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px; width:400px">1.ⅠLiên&nbsp;&nbsp;2.ⅡLiên&nbsp;&nbsp;3.ⅢLiên&nbsp;&nbsp;4.ⅣLiên&nbsp;&nbsp;5.>ⅥLiên</span>
                </td>
                <th style="height:5px; line-height:25px; float:left;margin-left:100px;">
                </th>
                <td></td>
                <th class="formTitle">Tên kháng sinh1</th>
                <td class="formValue"><input id="KJYWMC1" name="KJYWMC1" class="form-control" /></td>
                <th class="formTitle">Tên kháng sinh2</th>
                <td class="formValue"><input id="KJYWMC2" name="KJYWMC2" class="form-control" /></td>
                <th class="formTitle">Tên kháng sinh3</th>
                <td class="formValue"><input id="KJYWMC3" name="KJYWMC3" class="form-control" /></td>
            </tr>
            <tr>
                <th class="formTitle">Tên kháng sinh4</th>
                <td class="formValue"><input id="KJYWMC4" name="KJYWMC4" class="form-control" /></td>
                <th class="formTitle">Tên kháng sinh5</th>
                <td class="formValue"><input id="KJYWMC5" name="KJYWMC5" class="form-control" /></td>
                <th class="formTitle">Tên kháng sinh6</th>
                <td class="formValue"><input id="KJYWMC6" name="KJYWMC6" class="form-control" /></td>
            </tr>
            <tr>
                <th class="formTitle">Có xảy ra loét do tì đè không</th>
                <td class="formValue">
                    <select id="SFFSYC" name="SFFSYC" class="form-control" data-enumtype="EnumYorN"></select>
                    <input style="height:0px;border-width:1px;" class="form-control" />
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px;">1.Có&nbsp;&nbsp;2.Không</span>
                </td>
                <th class="formTitle">Có xảy ra trong thời gian nằm viện không</th>
                <td class="formValue">
                    <select id="SFZYQJFS" name="SFZYQJFS" class="form-control" data-enumtype="EnumYorN">
                        <option>-</option>
                    </select>
                    <input style="height:0px;border-width:1px;" class="form-control" />
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px;">1.Có&nbsp;&nbsp;2.Không</span>
                </td>
                <th class="formTitle">Giai đoạn loét do tì đè</th>
                <td class="formValue">
                    <div style="width:100px; float:left;">
                        <select id="YCFQ" name="YCFQ" class="form-control" data-enumtype="EnumYCFQ">
                            <option>-</option>
                        </select>
                        <input style="height:0px;border-width:1px;" class="form-control" />
                    </div>
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px;">1.Có&nbsp;&nbsp;2.Không có</span>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Phản ứng truyền dịch</th>
                <td class="formValue">
                    <div style="width:100px; float:left;">
                        <select id="SYFY" name="SYFY" class="form-control" data-enumtype="EnumSYFY"></select>
                        <input style="height:0px;border-width:1px;" class="form-control" />
                    </div>
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px; width:100px">0.Chưa truyền&nbsp;&nbsp;1.Không có&nbsp;&nbsp;2.Có</span>
                </td>
                <th class="formTitle">Thuốc gây phản ứng</th>
                <td class="formValue"><input id="YFFYDYW" name="YFFYDYW" class="form-control" /></td>
                <th class="formTitle">Biểu hiện lâm sàng</th>
                <td class="formValue"><input id="SYLCBX" name="SYLCBX" class="form-control" /></td>
            </tr>
            <tr>
                <th class="formTitle ">Trong thời gian nằm viện có<br />xảy ra ngã hoặc rơi khỏi giường:</th>
                <td class="formValue">
                    <select id="ZYSFDDHZC" name="ZYSFDDHZC" class="form-control" data-enumtype="EnumYorN"></select>
                    <input style="height:0px;border-width:1px;" class="form-control" />
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px;">1.Có&nbsp;&nbsp;2.Không</span>
                </td>
                <th class="formTitle ">Mức độ tổn thương do ngã hoặc rơi khỏi giường trong thời gian nằm viện:</th>
                <td class="formValue">
                    <div style="width:100px; float:left;">
                        <select id="ZYDDHZCDCD" name="ZYDDHZCDCD" class="form-control" data-enumtype="EnumZYDD_SHCD">
                            <option>-</option>
                        </select>
                        <input style="height:0px;border-width:1px;" class="form-control" />
                    </div>
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px; width:800px">1.Cấp I&nbsp;&nbsp;2.Cấp II&nbsp;&nbsp;3.Cấp III&nbsp;&nbsp;4.Không gây tổn thương</span>
                </td>
            </tr>
            <tr>
                <th class="formTitle " style="height:25px; line-height:25px; float:left;margin-left:5px;">Nguyên nhân ngã hoặc rơi khỏi giường :</th>
                <td class="formValue">
                    <div style="width:120px; float:left;">
                        <select id="DDHZCDYY" name="DDHZCDYY" class="form-control" data-enumtype="EnumZYDD_YY">
                            <option>-</option>
                        </select>
                        <input style="height:0px;border-width:1px;" class="form-control" />
                    </div>
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:25px; width:800px">1.Nguyên nhân sức khỏe&nbsp;&nbsp;2.Điều trị, Thuốc, Nguyên nhân gây mê&nbsp;&nbsp;3.Yếu tố môi trường&nbsp;&nbsp;4.Nguyên nhân khác</span>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Cố định cơ thể trong thời gian nằm viện</th>
                <td class="formValue">
                    <select id="ZYQJSTYY" name="ZYQJSTYY" class="form-control" data-enumtype="EnumHorN"></select>
                    <input style="height:0px;border-width:1px;" class="form-control" />
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px;">1.Có&nbsp;&nbsp;2.Không có</span>
                </td>
                <th class="formTitle">Giá trị nitơ urê thẩm tách lúc rời viện</th>
                <td class="formValue">
                    <input id="LYTXNSDZ" name="LYTXNSDZ" class="form-control"  
                          onkeyup="value=value.replace(/[^\d.]/g,'')"/>
                </td>
            </tr>
            
                <th class="formTitle">Người phụ trách đơn vị</th>
                <td class="formValue"><input id="DWFZR" name="DWFZR" class="form-control" /></td>
                <th class="formTitle">Người phụ trách thống kê</th>
                <td class="formValue"><input id="TJFZR" name="TJFZR" class="form-control" /></td>
                <th class="formTitle">Người lập biểu</th>
                <td class="formValue"><input id="TBR" name="TBR" class="form-control" /></td>
                <th class="formTitle">Điện thoại liên hệ</th>
                <td class="formValue"><input id="LXDH" name="LXDH" class="form-control" /></td>

            
                <th class="formTitle">Di động</th>
                <td class="formValue"><input id="SJ" name="SJ" class="form-control" /></td>
                <th class="formTitle">Ngày báo cáo</th>
                <td class="formValue">
                    <input id="BCRQ" name="BCRQ" type="text" class="form-control input-wdatepicker formClearIgnore" onfocus="WdatePicker({ dateFmt: 'dd/MM/yyyy' })" />
                </td>

            
            <th class="formTitle">Hướng dẫn lập biểu</th>
            <td class="formValue" colspan="5"><input id="TBSM" name="TBSM" attr-zddm="" attr-ICD10="" class="form-control" /></td>

        </table>
		<hr />
	</div>
</div>
<script>
    /*Đặt giá trị mặc định */
    $(function () {
        //Phản ứng truyền dịch
        $('#select2-SYFY-container').each(function () {
            var myvalue = 'Không có';
            $(this).html(myvalue);
        });
        $('#select2-SYFY-container').attr('title', 'Không có');
        $('#SYFY option').filter(function () { return $(this).text() == 'Không có'; }).attr('selected', true);
    });
</script>

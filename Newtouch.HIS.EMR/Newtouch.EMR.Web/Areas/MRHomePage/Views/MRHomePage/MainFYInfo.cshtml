
@{
	Layout = null;
}
<style>
	#dv_zyinfo input {
		border-top: none;
		border-left: none;
		border-right: none;
		text-wrap: normal;
		border-bottom-color: #74e8b5;
	}

	.spanleft {
		float: left;
		padding-top: 5px;
	}

	.spanright {
		float: right;
		padding-top: 5px;
	}

	/*td span[role=combobox]
	{
		border:none;
	}*/
</style>
<div id="dv_zyinfo">
	<div>
        <table class="form">
            <tr>
                <th class="formTitle ">Tình hình nhiễm trùng bệnh viện:</th>
                <td class="formValue">
                    <select id="YYGRQK" name="YYGRQK" class="form-control" data-enumtype="EnumHorN"></select>
                    <input style="height:0px;border-width:1px;" class="form-control" />
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px;">1. Có&nbsp;&nbsp;2. Không có</span>
                </td>
                <th class="formTitle " style="padding-right: 50px;padding-left: 25px;">Nhiễm trùng bệnh viện có liên quan đến phẫu thuật hay không:</th>
                <td class="formValue">
                    <select id="YYGRSSXG" name="YYGRSSXG" class="form-control" data-enumtype="EnumYorN">
                        <option>-</option>
                    </select>
                    <input style="height:0px;border-width:1px;" class="form-control" />
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px;">1. Có&nbsp;&nbsp;2. Không</span>
                </td>
                <th class="formTitle " style="padding-right:100px;padding-left: 50px;">Nhiễm trùng bệnh viện có liên quan đến thủ thuật xâm lấn hay không:</th>
                <td class="formValue">
                    <select id="YYGRSFQRXG" name="YYGRSFQRXG" class="form-control" data-enumtype="EnumHorN">
                        <option>-</option>
                    </select>
                    <input style="height:0px;border-width:1px;" class="form-control" />
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px;">1. Có&nbsp;&nbsp;2. Không có</span>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Tình hình sử dụng thuốc kháng khuẩn:</th>
                <td class="formValue">
                    <div style="width:100px; float:left;">
                        <select id="KJYWSYQK" name="KJYWSYQK" class="form-control" data-enumtype="EnumKJYWSYQK">
                            <option>-</option>
                        </select>
                        <input style="height:0px;border-width:1px;" class="form-control" />
                    </div>
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px; width:400px">1.Ⅰ联&nbsp;&nbsp;2.Ⅱ联&nbsp;&nbsp;3.Ⅲ联&nbsp;&nbsp;4.Ⅳ联&nbsp;&nbsp;5.>Ⅵ联</span>
                </td>
                <th style="height:5px; line-height:25px; float:left;margin-left:100px;">
                </th>
                <td></td>
                <th class="formTitle">Tên thuốc kháng khuẩn 1</th>
                <td class="formValue"><input id="KJYWMC1" name="KJYWMC1" class="form-control" /></td>
                <th class="formTitle">Tên thuốc kháng khuẩn 2</th>
                <td class="formValue"><input id="KJYWMC2" name="KJYWMC2" class="form-control" /></td>
                <th class="formTitle">Tên thuốc kháng khuẩn 3</th>
                <td class="formValue"><input id="KJYWMC3" name="KJYWMC3" class="form-control" /></td>
            </tr>
            <tr>
                <th class="formTitle">Tên thuốc kháng khuẩn 4</th>
                <td class="formValue"><input id="KJYWMC4" name="KJYWMC4" class="form-control" /></td>
                <th class="formTitle">Tên thuốc kháng khuẩn 5</th>
                <td class="formValue"><input id="KJYWMC5" name="KJYWMC5" class="form-control" /></td>
                <th class="formTitle">Tên thuốc kháng khuẩn 6</th>
                <td class="formValue"><input id="KJYWMC6" name="KJYWMC6" class="form-control" /></td>
            </tr>
            <tr>
                <th class="formTitle">Có xảy ra loét do tì đè hay không</th>
                <td class="formValue">
                    <select id="SFFSYC" name="SFFSYC" class="form-control" data-enumtype="EnumYorN"></select>
                    <input style="height:0px;border-width:1px;" class="form-control" />
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px;">1. Có&nbsp;&nbsp;2. Không</span>
                </td>
                <th class="formTitle">Có xảy ra trong thời gian nằm viện hay không</th>
                <td class="formValue">
                    <select id="SFZYQJFS" name="SFZYQJFS" class="form-control" data-enumtype="EnumYorN">
                        <option>-</option>
                    </select>
                    <input style="height:0px;border-width:1px;" class="form-control" />
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px;">1. Có&nbsp;&nbsp;2. Không</span>
                </td>
                <th class="formTitle">Phân giai đoạn loét do tì đè</th>
                <td class="formValue">
                    <div style="width:100px; float:left;">
                        <select id="YCFQ" name="YCFQ" class="form-control" data-enumtype="EnumYCFQ">
                            <option>-</option>
                        </select>
                        <input style="height:0px;border-width:1px;" class="form-control" />
                    </div>
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px;">1. Có&nbsp;&nbsp;2. Không có</span>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Phản ứng truyền dịch</th>
                <td class="formValue">
                    <div style="width:100px; float:left;">
                        <select id="SYFY" name="SYFY" class="form-control" data-enumtype="EnumSYFY"></select>
                        <input style="height:0px;border-width:1px;" class="form-control" />
                    </div>
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px; width:100px">0.Chưa truyền&nbsp;&nbsp;1.Không&nbsp;&nbsp;2.Có</span>
                </td>
                <th class="formTitle">Thuốc gây ra phản ứng</th>
                <td class="formValue"><input id="YFFYDYW" name="YFFYDYW" class="form-control" /></td>
                <th class="formTitle">Biểu hiện lâm sàng</th>
                <td class="formValue"><input id="SYLCBX" name="SYLCBX" class="form-control" /></td>
            </tr>
            <tr>
                <th class="formTitle ">Có hay không trong thời gian nội trú<br />bị ngã hoặc rơi khỏi giường:</th>
                <td class="formValue">
                    <select id="ZYSFDDHZC" name="ZYSFDDHZC" class="form-control" data-enumtype="EnumYorN"></select>
                    <input style="height:0px;border-width:1px;" class="form-control" />
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px;">1. Có&nbsp;&nbsp;2. Không</span>
                </td>
                <th class="formTitle ">Mức độ tổn thương do ngã hoặc rơi khỏi giường trong thời gian nằm viện:</th>
                <td class="formValue">
                    <div style="width:100px; float:left;">
                        <select id="ZYDDHZCDCD" name="ZYDDHZCDCD" class="form-control" data-enumtype="EnumZYDD_SHCD">
                            <option>-</option>
                        </select>
                        <input style="height:0px;border-width:1px;" class="form-control" />
                    </div>
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px; width:800px">1.Cấp một&nbsp;&nbsp;2.Cấp hai&nbsp;&nbsp;3.Cấp ba&nbsp;&nbsp;4.Chưa gây tổn thương</span>
                </td>
            </tr>
            <tr>
                <th class="formTitle " style="height:25px; line-height:25px; float:left;margin-left:5px;">Nguyên nhân ngã hoặc rơi khỏi giường:</th>
                <td class="formValue">
                    <div style="width:120px; float:left;">
                        <select id="DDHZCDYY" name="DDHZCDYY" class="form-control" data-enumtype="EnumZYDD_YY">
                            <option>-</option>
                        </select>
                        <input style="height:0px;border-width:1px;" class="form-control" />
                    </div>
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:25px; width:800px">1.Nguyên nhân sức khỏe&nbsp;&nbsp;2.Nguyên nhân điều trị, thuốc, gây mê&nbsp;&nbsp;3.Yếu tố môi trường&nbsp;&nbsp;4.Nguyên nhân khác</span>
                </td>
            </tr>
            <tr>
                <th class="formTitle">Hạn chế cơ thể trong thời gian nằm viện</th>
                <td class="formValue">
                    <select id="ZYQJSTYY" name="ZYQJSTYY" class="form-control" data-enumtype="EnumHorN"></select>
                    <input style="height:0px;border-width:1px;" class="form-control" />
                </td>
                <td class="formValue" style="white-space:normal; float:left;">
                    <span class="formValue" style="height:25px; line-height:25px; float:left;margin-left:5px;">1. Có&nbsp;&nbsp;2. Không có</span>
                </td>
                <th class="formTitle">Giá trị nitơ urê khi rời viện sau lọc máu</th>
                <td class="formValue">
                    <input id="LYTXNSDZ" name="LYTXNSDZ" class="form-control"  
                          onkeyup="value=value.replace(/[^\d.]/g,'')"/>
                </td>
            </tr>
            @**@<tr>
                <th class="formTitle">Người phụ trách đơn vị</th>
                <td class="formValue"><input id="DWFZR" name="DWFZR" class="form-control" /></td>
                <th class="formTitle">Người phụ trách thống kê</th>
                <td class="formValue"><input id="TJFZR" name="TJFZR" class="form-control" /></td>
                <th class="formTitle">Người điền bảng</th>
                <td class="formValue"><input id="TBR" name="TBR" class="form-control" /></td>
                <th class="formTitle">Số điện thoại liên hệ</th>
                <td class="formValue"><input id="LXDH" name="LXDH" class="form-control" /></td>
            </tr>*@
            @**@<tr>
                <th class="formTitle">Điện thoại di động</th>
                <td class="formValue"><input id="SJ" name="SJ" class="form-control" /></td>
                <th class="formTitle">Ngày báo cáo</th>
                <td class="formValue">
                    <input id="BCRQ" name="BCRQ" type="text" class="form-control input-wdatepicker formClearIgnore" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" />
                </td>
            </tr>*@
            @**@<tr>
            <th class="formTitle">Hướng dẫn điền bảng</th>
            <td class="formValue" colspan="5"><input id="TBSM" name="TBSM" attr-zddm="" attr-ICD10="" class="form-control" /></td>
        </tr>*@
        </table>
		<hr />
	</div>
</div>
<script>
    /*Cài đặtGiá trị mặc định */
    $(function () {
        //Phản ứng truyền dịch
        $('#select2-SYFY-container').each(function () {
            var myvalue = '无';
            $(this).html(myvalue);
        });
        $('#select2-SYFY-container').attr('title', '无');
        $('#SYFY option').filter(function () { return $(this).text() == '无'; }).attr('selected', true);
    });
</script>

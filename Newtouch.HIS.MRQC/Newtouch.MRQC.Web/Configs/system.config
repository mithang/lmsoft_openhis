<?xml version="1.0" encoding="utf-8"?>
<appSettings>
	<!-- ================== 1：Cấu hình liên quan đến hệ thống phát triển ================== -->
	<!-- Thời gian duy trì trạng thái đăng nhập（đơn vị：phút）-->
	<add key="LoginStatusKeepMinute" value="30" />
	<!-- Đăng xuất lẫn nhau trên nhiều thiết bị -->
	<add key="EnableMultipleLoginLimit" value="false" />
	<!-- Đăng xuất lẫn nhau trên nhiều thiết bị-cùng một tài khoản，số lượng trực tuyến đồng thời tối đa -->
	<add key="MultipleLoginLimit_Count" value="10" />

	<!--BậtIPlọc（Sau khi bật BậtIPchính sách hạn chế truy cập（chỉ mở cho một phần hoặc hạn chế truy cập một phần）） -->
	<add key="Is_IPFilter" value="false" />

	<!--Bật liên kết khoa dược của người dùng（khoa dược mà người dùng sẽ thao tác sau khi đăng nhập） -->
	<add key="Is_UserYfbmRelated" value="true" />

	<!-- của menutitlecó hiển thị hay khôngDescription（giá trị，chỉ khitrue'sẽ hiển thị） -->
	<add key="IS_ShowDescToMenuTitle" value="true" />


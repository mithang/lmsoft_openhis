<?xml version="1.0" encoding="utf-8"?>

<!-- Về việc sử dụng web.config thông tin chi tiết về phép chuyển đổi，vui lòng truy cập http://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Trong ví dụ dưới đây，“SetAttributes”phép chuyển đổi sẽ thay đổi 
    “connectionString”giá trị，chỉ khi“Match”bộ định vị 
    tìm thấy giá trị“MyDB”thuộc tính“name”thì sử dụng“ReleaseSQLServer”。
    
    <connectionStrings>
      <add name="MyDB" 
        connectionString="Data Source=ReleaseSQLServer;Initial Catalog=MyReleaseDB;Integrated Security=True" 
        xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
    </connectionStrings>
  -->
  <system.web>
    <!--
      
      Trong ví dụ dưới đây，“Replace”phép chuyển đổi sẽ thay thế 
      web.config toàn bộ tệp <customErrors> mục。
      Lưu ý，do 
      tại <system.web> chỉ có một nút con customErrors mục，nên không cần dùng“xdt:Locator”thuộc tính。
      
      <customErrors defaultRedirect="GenericError.htm"
        mode="RemoteOnly" xdt:Transform="Replace">
        <error statusCode="500" redirect="InternalError.htm"/>
      </customErrors>
    -->
  </system.web>
</configuration>
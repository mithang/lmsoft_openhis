    function GetLeaveChart(data) {
        //var randomScalingFactor = function () { return Math.round(Math.random() * 100) };
        //biểu đồ tròn lấy số người khám
        var array = [];
        var title = "thống kê loại khám";
        var $thisval = $("#sel_Duty").val();
        if ($thisval == "tollman") {
            title = "thống kê loại khám";
            $.each(data, function (e) {
                if (this.brxz != "Tổng cộng") {
                    array.push([this.brxz, this.ghrc]);
                }
            });
        }
        else if ($thisval == "Doctor") {
            $.each(data, function (e) {
                if (this.brxz != "Tổng cộng") {
                    array.push([this.brxz, this.jzrc]);
                }
            });
        }
        else if ($thisval == "Nurse") {
            $.each(data, function (e) {
                if (this.brxz != "Tổng cộng") {
                    array.push([this.brxz, this.jrwcqrc]);
                }
            });
        }
        if (array.length == 0) {
            array.push(["lượt người", 0]);
        }

        $('#leavechart').highcharts({
            chart: {
                type: 'pie'
            },
            colors: ['#999EFF', '#FFBC75', '#80ced6', '#EE4B2B', '#AFE1AF', '#FFDB58', '#CCCCFF', '#40B5AD', '#F2D2BD'],
            title: {
                text: title
            },
            tooltip: {
                headerFormat: '',
                pointFormat: '{point.name}: <b>{point.y}người</b>'
            },
            plotOptions: {
                pie: {
                    allowPointSelect: true,
                    cursor: 'pointer',
                    dataLabels: {
                        enabled: true,
                        format: '<b>{point.name}</b>: {point.y}người',
                        style: {
                            color: (Highcharts.theme && Highcharts.theme.contrastTextColor) || 'black'
                        }
                    }
                }
            },
            series: [{
                type: 'pie',
                //data: [
                //    ['tự chi trả', 100],
                //    ['công nhân viên thành thị', 109],
                //    ['dân cư', 27]
                //]
                data: array
            }]
        });

    }

    function LoadMonthChart() {
        $.ajax({
            url: "/Home/GetWeekNum?r=" + Math.random(),
            dataType: "json",
            async: false,
            success: function (data) {
                if (data != null && data.data != null
                    && data.data.OutpatientList != null
                    && data.data.InpatientList != null) {
                    GetMonthNumChart(data.data);
                }
            }
        });
    }

    function GetMonthNumChart(data) {
        var rtnobj = {};
        rtnobj.str = [];
        rtnobj.dataoutpatient = [];
        rtnobj.datainpatient = [];
        $.ajax({
            url: "/Home/GetLastWeek?r=" + Math.random(),
            dataType: "json",
            async: false,
            success: function (lastdata) {
                if (lastdata != null) {
                    for (var i = 0; i < lastdata.length; i++) {
                        rtnobj.str.push(lastdata[i].wbegin.substring(5, 10) + "đến" + (lastdata[i].wend).substring(5, 10));
                        var isOutpatientPush = false;
                        $.each(data.OutpatientList, function (ii, v) {
                            if (v.wbegin == lastdata[i].wbegin && v.wend == lastdata[i].wend) {
                                rtnobj.dataoutpatient.push(v.num);
                                isOutpatientPush = true;
                            }
                        });
                        if (!isOutpatientPush) {
                            rtnobj.dataoutpatient.push(0);
                        }
                    }
                    $.each(data.InpatientList, function (i, v) {
                        if (v.wbegin == lastdata[i].wbegin && v.wend == lastdata[i].wend) {
                            rtnobj.datainpatient.push(v.num);
                        }
                    });
                    loadmonthcharts(rtnobj);
                }
            }
        });
    }

    function loadmonthcharts(rtnobj) {
        $('#monthcntchart').highcharts({
            chart: {
                zoomType: 'none'
            },
            title: {
                text: 'số lượng người khám/số người đang nằm viện'
            },
            subtitle: {
                text: "Thống kê số người 10 tuần gần nhất năm " + new Date().getFullYear(),
            },
            xAxis: {
                categories: rtnobj.str,
                labels: {
                    rotation: 10, //góc nghiêng
                }
            },
            yAxis: {
                title: {
                    text: 'đơn vị (người)'
                }
            },
            tooltip: {
                headerFormat: '<span style="font-size:10px">{point.key}</span><table>',
                pointFormat: '<tr><td style="color:{series.color};padding:0">{series.name}: </td>' +
                    '<td style="padding:0"><b>{point.y}người</b></td></tr>',
                footerFormat: '</table>',
                shared: true,
                useHTML: true
            },
            plotOptions: {
                column: {
                    pointPadding: 0.2,
                    borderWidth: 0
                }
            },
            series: [{
                name: "ngoại trú",
                color: '#999EFF',
                data: rtnobj.dataoutpatient
            }, {
                name: "nằm viện",
                color: '#FFBC75',
                data: rtnobj.datainpatient
            }
            ]
        });
    }
</script>
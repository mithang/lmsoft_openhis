    function tabtol() {
        //$("#tabtype").val(tabtypeName);
        var $table = $('#table');
        $table.bootstrapTable({
            url: "/Home/GetDutyTotalList", //địa chỉ URL máy chủ trả về dữ liệu
            method: 'POST',                      //phương thức yêu cầu dữ liệu
            contentType: "application/x-www-form-urlencoded",
            height: '100%',
            queryParams: {
                dutycode: $("#sel_Duty").val(),
                tjrq: $("#tjrq").val()
            },
            classes: "table table-bordered table-striped table-hover",
            theadClasses: "table-light",//đặt kiểu tiêu đề bảng
            idField: 'Id',
            showColumns: false,
            columns: columns,
            uniqueId: 'Id',
            rowStyle: function (row, index) {
                if (row.brxz == "Tổng cộng") {
                    return {
                        css: {
                            "background-color": "#d5f4e6",
                            "font-wight": "bold"
                        }
                    }
                }
                return {};
            },
            onLoadSuccess: function (data) {
                GetLeaveChart(data);
            },
            formatLoadingMessage: function () {
                return "<span class='table-loading-text'>đang tải,vui lòng chờ</span>";
            },
            formatNoMatches: function () {
                return "chưa có dữ liệu";
            }
        });
    }

    function init() {
        $.najax({
            url: "/Home/GetShortcutMenuList",
            dataType: "json",
            data: { keyword: $("#txt_keyword").val() },
            type: "POST",
            success: function (respdata) {
                var j = 12;
                if (respdata.length > 0 && respdata.length < 12) {
                    j = 12 - respdata.length;
                }
                else if (respdata.length > 12) {
                    j = -1;
                }
                for (var i = 0; i < j; i++) {
                    respdata.push({ Id: null });
                }
                createli(respdata);
            }
        })
        $("#dv_table").height($(window).height() - 430);
    }
    function createli(respdata) {
        $.jsonWhere(respdata, function (v) {
            var labelcss = !v.AppId ? 'text-success' : '';
            if (!!v && v.Id != null) {
                var li = '  <li>'
                    + ' <div class="dv-data" data-appId=' + v.AppId + ' data-MenuUrl=' + v.MenuUrl + ' data-MenuName=' + v.MenuName + ' title="tên chức năng:' + v.MenuName + '">'
                    + ' </div>'
                    + ' <span class="' + labelcss + '" title="" style="cursor:pointer;font-size:16px"><i class="fa fa-hand-o-right icon-theme-info"></i> ' + v.MenuName + '</span>'
                    + ' </li >';
                $('.ul-ConvenientMenu').append(li);
            }
            else {
                var li = '  <li>'
                    + ' <div class="dv-data" style="border:2px dotted #eb9316;border-radius:4px;text-align:center;"'
                    + ' </div>'
                    + ' <span title="" style="cursor:pointer;color:#ffffff;"><i class="fa fa-star-o"></i></span>'
                    + ' </li >';
                $('.ul-ConvenientMenu').append(li);
            }
        })
    }

    function tableRefresh() {
        $(".ul-ConvenientMenu").children("li").remove();
        init();
    }

    function appdomain(sysApp) {
        // Mở tab đích NGAY trong cú click (giữ chuỗi user-gesture) để trình duyệt
        // không chặn popup; địa chỉ thật lấy sau qua AJAX rồi gán vào tab đó.
        // Trước đây window.open nằm trong callback AJAX (mất chuỗi gesture) nên
        // trình duyệt chặn lặng lẽ, bấm thẻ không có gì xảy ra.
        var win = window.open('about:blank', '_blank');
        $.ajax({
            url: "/Login/GetUALoginAddres",
            data: { appId: sysApp },
            type: "post",
            dataType: "json",
            success: function (data) {
                if (data.state == "success" && data.data) {
                    var url = data.data + "&returnUrl=" + encodeURIComponent("/Home/Index");
                    if (win) {
                        win.location = url;
                    } else {
                        // Popup bị chặn: mở cùng tab thay vì không làm gì.
                        window.location.href = url;
                    }
                } else {
                    if (win) { win.close(); }
                    $.modalAlert("không lấy được địa chỉ hệ thống [" + sysApp + "], vui lòng thử đăng nhập lại", 'error');
                }
            },
            error: function (request, error, ex) {
                if (win) { win.close(); }
                $.modalAlert("dịch vụ không thể truy cập:[" + ex + "]", 'error');
            }
        });
    }

    /**********************************thống kê dữ liệu**********************************/
    function GetSalaryChart(data) {
        //var randomScalingFactor = function () { return Math.round(Math.random() * 100) };
        var OutpatientList = [];
        var InpatientList = [];
        //biểu đồ đường lấy số người khám
        if (data) {
            OutpatientList = data.OutpatientList;
            InpatientList = data.InpatientList
        } else {
            for (var i = 0; i < 12; i++) {
                OutpatientList.push([0]);
                InpatientList.push([0]);
            }
        }
        $('#personcntchart').highcharts({
            chart: {
                zoomType: 'none'

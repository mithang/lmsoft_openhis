<?xml version="1.0" encoding="utf-8"?>
<log4net>
	<!-- ghi nhật ký vào tệp dưới dạng tệp cuộn -->
	<!-- tách tệp nhật ký theo ngày，và lấy ngày làm tên tệp nhật ký -->
	<appender name="RollingFileAppenderNameByDate" type="log4net.Appender.RollingFileAppender">
		<!-- vị trí lưu tệp nhật ký，có thể là đường dẫn tuyệt đối hoặc đường dẫn tương đối -->
		<file value="LogFile\info\" />
		<!-- thêm thông tin nhật ký vào tệp nhật ký hiện có-->
		<appendToFile value="true" />
		<!-- chế độ khóa tối thiểu，để cho phép nhiều tiến trình cùng ghi vào một tệp -->
		<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
		<!-- chỉ định tách tệp nhật ký theo ngày -->
		<rollingStyle value="Date" />
		<!-- quy tắc đặt tên tệp nhật ký -->
		<!--<datePattern value="&quot;Logs_&quot;yyyyMMdd&quot;.log&quot;"/>-->
		<datePattern value="yyyyMM/yyyyMMdd&quot;.log&quot;" />
		<!-- khi lấy ngày làm tên tệp nhật ký，phảistaticLogFileNameđặt giá trị của thànhfalse -->
		<staticLogFileName value="false" />
		<maxSizeRollBackups value="5" />
		<maximumFileSize value="10MB" />
		<!-- mẫu hiển thị nhật ký -->
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="【%level】【执行时间】：%date %newline%thread %logger %newline%message%newline--------------------------------------------------------------------%newline" />
		</layout>
	</appender>
	<appender name="ErrorFileAppenderNameByDate" type="log4net.Appender.RollingFileAppender">
		<!-- vị trí lưu tệp nhật ký，có thể là đường dẫn tuyệt đối hoặc đường dẫn tương đối -->
		<file value="LogFile\error\" />
		<!-- thêm thông tin nhật ký vào tệp nhật ký hiện có-->
		<appendToFile value="true" />
		<!-- chế độ khóa tối thiểu，để cho phép nhiều tiến trình cùng ghi vào một tệp -->
		<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
		<!-- chỉ định tách tệp nhật ký theo ngày -->
		<rollingStyle value="Date" />
		<!-- quy tắc đặt tên tệp nhật ký -->
		<!--<datePattern value="&quot;Logs_&quot;yyyyMMdd&quot;.log&quot;"/>-->
		<datePattern value="yyyyMM/yyyyMMdd&quot;.log&quot;" />
		<!-- khi lấy ngày làm tên tệp nhật ký，phảistaticLogFileNameđặt giá trị của thànhfalse -->
		<staticLogFileName value="false" />
		<maxSizeRollBackups value="5" />
		<maximumFileSize value="10MB" />
		<!-- mẫu hiển thị nhật ký -->
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="【%level】【异常时间】：%date %newline %thread %logger %newline%message%newline--------------------------------------------------------------------%newline" />
		</layout>
		<filter type="log4net.Filter.LevelRangeFilter,log4net">
			<levelMin value="ERROR" />
			<levelMax value="FATAL" />
		</filter>
	</appender>

	<root>
		<!-- mức kiểm soát，từ thấp đến cao：ALL|DEBUG|INFO|WARN|ERROR|FATAL|OFF -->
		<!-- ví dụ định nghĩa mức làINFO，thìINFOcác mức thấp hơn mức đó，ví dụDEBUGnhật ký sẽ không được ghi lại -->
		<!-- nếu chưa được định nghĩaLEVELgiá trị của，thì mặc định làDEBUG -->
		<level value="ALL" />
		<!-- tách tệp nhật ký theo ngày，và lấy ngày làm tên tệp nhật ký -->
		<appender-ref ref="RollingFileAppenderNameByDate" />
		<appender-ref ref="ErrorFileAppenderNameByDate" />
	</root>
</log4net>

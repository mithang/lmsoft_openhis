<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
	</configSections>
	<log4net>
		<!--Log lỗi：：：GhiLog lỗi-->
		<!--Cắt file log theo ngày mỗi ngày một file-->
		<!-- appender Định nghĩa cách xuất log   Ghi log dưới dạng file cuộn。-->
		<appender name="ErrorAppender" type="log4net.Appender.RollingFileAppender">
			<!--Đường dẫn lưu：đường dẫn dưới đây khi khởi động dự án sẽ tự động tạo trongCổ đĩalog、logErrorfile-->
			<file value="LogFile/error/error_" />
			<!-- Nếu muốn thêm đường dẫn trong dự án này，thì bỏ trực tiếpC:\\  chỉ đặtlog\\LogError   khi khởi động dự án sẽ tạo file mặc định -->
			<appendToFile value="true"/>
			<!--theocách nào để tạo nhiều file Log(Ngày[Date],Kích thước file[Size],Hỗn hợp[Composite])-->
			<rollingStyle value="Date"/>
			<!--Đây là thư mục tạo theo ngày-->
			<datePattern value="yyyy-MM-dd'.log'"/>
			<!--Có chỉ ghi vào một file không-->
			<staticLogFileName value="false"/>
			<!--Số lượng giữ lạifile log sau khi vượt quá số này tự động xóa các file trước   hình như chỉ khi theoSizecắt mới có hiệu lực Giá trị đặtvalue="－1" là không giới hạn số file-->
			<param name="MaxSizeRollBackups" value="100"/>
			<!--Kích thước mỗi file. Chỉ dùng khi ở chế độ hỗn hợp và chế độ kích thước file. Sau khi vượt kích thước sẽ tự động thêm số nguyên dương vào sau tên file để đổi tên, số lớn nhất được ghi sớm nhất. Đơn vị có thể dùng: KB|MB|GB. Không dùng số thập phân, nếu không sẽ luôn ghi vào Log hiện tại.-->
			<maximumFileSize value="10MB" />
			<!-- layout Điều khiểnAppenderđịnh dạng xuất，cũng có thể làxml  một Appender chỉ có thể là một layout-->
			<layout type="log4net.Layout.PatternLayout">
				<!--Chú thích ở cuối mỗi dòng log-->
				<!--Định dạng xuất Mẫu-->
				<!-- <param name="ConversionPattern"  value="Thời gian ghi：%date LuồngID:[%thread] Mức độ log：%-5level Lớp ghi：%logger   
        Người thao tácID：%property{Operator} Loại thao tác：%property{Action}%n  Tên máy hiện tại:%property%nTên máy hiện tại và người dùng đăng nhập:%username %n  
        Vị trí ghi： %logger Thuộc tính[%property{NDC}] Mô tả thông báo：%property{Message}%n   Ngoại lệ：%exception%n Thông báo：%message%newline%n%n" />-->

				<!--Ví dụ：2008-03-26 13:42:32,111 [10] INFO  Log4NetDemo.MainClass [(null)] - info-->
				<!--<conversionPattern value="%newline %nThời gian ghi：%date %nLuồngID:[%thread] %nMức độ log： %-5level %nMô tả lỗi：%message%newline %n"/>-->
				<conversionPattern value="%n＝＝＝＝＝＝＝＝＝＝
                                  %n【Mức độ log】%-5level
                                  %n【Thời gian ghi】%date[%property{Operator}]
                                  %n【Thời gian thực thi】[%r]Mili giây
                                  %n【Loại thao tác】%property{Action}
                                  %n【Mô tả yêu cầu】%message
                                  %n【Chi tiết lỗi】%exception%n"/>
			</layout>
			<filter type="log4net.Filter.LevelRangeFilter,log4net">
				<levelMin value="ERROR" />
				<levelMax value="FATAL" />
			</filter>
		</appender>

		<!--DEBUG：：：GhiDEBUGLog-->
		<!--Cắt file log theo ngày mỗi ngày một file-->
		<!-- appender Định nghĩa cách xuất log   Ghi log dưới dạng file cuộn。-->
		<appender name="DebugAppender" type="log4net.Appender.RollingFileAppender">
			<!--Đường dẫn lưu：đường dẫn dưới đây khi khởi động dự án sẽ tự động tạo trongCổ đĩalog、logErrorfile-->
			<file value="LogFile/debug/debug_" />
			<!-- Nếu muốn thêm đường dẫn trong dự án này，thì bỏ trực tiếpC:\\  chỉ đặtlog\\LogError   khi khởi động dự án sẽ tạo file mặc định -->
			<appendToFile value="true"/>
			<!--theocách nào để tạo nhiều file Log(Ngày[Date],Kích thước file[Size],Hỗn hợp[Composite])-->
			<rollingStyle value="Date"/>
			<!--Đây là thư mục tạo theo ngày-->
			<datePattern value="yyyy-MM-dd'.log'"/>
			<!--Có chỉ ghi vào một file không-->
			<staticLogFileName value="false"/>
			<!--Số lượng giữ lạifile log sau khi vượt quá số này tự động xóa các file trước   hình như chỉ khi theoSizecắt mới có hiệu lực Giá trị đặtvalue="－1" là không giới hạn số file-->
			<param name="MaxSizeRollBackups" value="100"/>
			<!--Kích thước mỗi file. Chỉ dùng khi ở chế độ hỗn hợp và chế độ kích thước file. Sau khi vượt kích thước sẽ tự động thêm số nguyên dương vào sau tên file để đổi tên, số lớn nhất được ghi sớm nhất. Đơn vị có thể dùng: KB|MB|GB. Không dùng số thập phân, nếu không sẽ luôn ghi vào Log hiện tại.-->
			<maximumFileSize value="10MB" />
			<!-- layout Điều khiểnAppenderđịnh dạng xuất，cũng có thể làxml  một Appender chỉ có thể là một layout-->
			<layout type="log4net.Layout.PatternLayout">
				<!--Chú thích ở cuối mỗi dòng log-->
				<!--Định dạng xuất Mẫu-->
				<!-- <param name="ConversionPattern"  value="Thời gian ghi：%date LuồngID:[%thread] Mức độ log：%-5level Lớp ghi：%logger   
        Người thao tácID：%property{Operator} Loại thao tác：%property{Action}%n  Tên máy hiện tại:%property%nTên máy hiện tại và người dùng đăng nhập:%username %n  
        Vị trí ghi：%location%n Mô tả thông báo：%property{Message}%n   Ngoại lệ：%exception%n Thông báo：%message%newline%n%n" />-->

				<!--Ví dụ：2008-03-26 13:42:32,111 [10] INFO  Log4NetDemo.MainClass [(null)] - info-->
				<!--<conversionPattern value="%newline %nThời gian ghi：%date %nLuồngID:[%thread] %nMức độ log： %-5level %nMô tả lỗi：%message%newline %n"/>-->
				<conversionPattern value="%n＝＝＝＝＝＝＝＝＝＝
                                  %n【Mức độ log】%-2level
                                  %n【Thời gian ghi】%date
                                  %n【Thời gian thực thi】[%r]Mili giây
                                  %n【debugVị trí】%logger Thuộc tính[%property{NDC}]
                                  %n【debugMô tả】%message"/>
			</layout>
			<filter type="log4net.Filter.LevelRangeFilter,log4net">
				<levelMin value="ALL" />
				<levelMax value="WARN" />
			</filter>
		</appender>
		<!-- Ghi log dưới dạng file cuộn -->
		<!-- Cắt file log theo ngày，và dùng ngày làm tên file log -->
		<appender name="InfoAppender" type="log4net.Appender.RollingFileAppender">
			<!-- Vị trí lưu file log，có thể là đường dẫn tuyệt đối hoặc tương đối -->
			<file value="LogFile/info/info_" />
			<!-- Ghi nối thông tin log vào file log đã có-->
			<appendToFile value="true" />
			<!-- Chế độ khóa tối thiểu，để nhiều tiến trình có thể ghi cùng một file -->
			<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
			<!-- Chỉ địnhCắt file log theo ngày -->
			<rollingStyle value="Date" />
			<!-- Quy tắc đặt tên file log -->
			<!--<datePattern value="&quot;Logs_&quot;yyyyMMdd&quot;.log&quot;"/>-->
			<datePattern value="yyyy-MM-dd'.log'"/>
			<!-- Khi dùng ngày làm tên file log，bắt buộc phải đặtstaticLogFileNamegiá trị thànhfalse -->
			<staticLogFileName value="false" />
			<maxSizeRollBackups value="5" />
			<maximumFileSize value="10MB" />
			<!-- Mẫu hiển thị log -->
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%n＝＝＝＝＝＝＝＝＝＝
                                  %n【Mức độ log】%-2level
                                  %n【Thời gian ghi】%date
                                  %n【Thời gian thực thi】[%r]Mili giây
                                  %n【debugVị trí】%logger Thuộc tính[%property{NDC}]
                                  %n【debugMô tả】%message"/>
			</layout>
			<filter type="log4net.Filter.LevelRangeFilter,log4net">
				<levelMin value="ALL" />
				<levelMax value="OFF" />
			</filter>
		</appender>
		<!--Set root logger level to DEBUG and its only appender to A1-->
		<root>
			<!--Mức độ kiểm soát，từ thấp đến cao: ALL|DEBUG|INFO|WARN|ERROR|FATAL|OFF-->
			<level value="ALL" />
			<appender-ref ref="DebugAppender" />
			<appender-ref ref="ErrorAppender" />
			<appender-ref ref="InfoAppender" />
		</root>
	</log4net>
</configuration>
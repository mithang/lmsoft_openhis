
@using Newtouch.Infrastructure
@{
    ViewBag.Title = "Lấy trạng thái phiếu giao hàng vật tư tiêu hao";
    Layout = "~/Views/Shared/_Index.cshtml";

}
<script src="~/Content/js/index.js"></script>

<form id="form1">
    <div class="panel panel-default" style="margin-bottom:10px;">
        <div class="panel-heading">Lấy trạng thái phiếu giao hàng vật tư tiêu hao</div>
        <table class="form">
            <tr style="float:left">
                <th class="formTitle">Số phiếu giao hàng:</th>
                <td class="formValue">
                    <input id="psdbh" class="form-control" placeholder="Số phiếu giao hàng" />
                </td>
                <th class="formTitle">
                    <input type="button" id="btn_search" class="btn btn-md btn-primary" value="Tra cứu" />
                </th>
            </tr>
        </table>
    </div>
    <div id="dv-detail">
        <table id="gridList"></table>
        <div id="gridPager"></div>
    </div>
</form>

<script type="text/javascript">

    $(function () {
        //gridList();
    });



    function getPostData() {
        return {
            PSDBH: $("#psdbh").val(),
            PSMXBHCXTJ :'',
        };
    }

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            url: "/PurchaseManage/Purchase/GetGridJsonYY161",
            height: $(window).height() - 200,
            postData: getPostData(),
            colModel: [
                { label: 'Số chi tiết phiếu giao hàng', name: 'PSMXBH', width: 180, align: 'left' },
                {
                    label: 'Trạng thái chi tiết phiếu giao hàng', name: 'PSMXZT', width: 180, align: 'left', formatter: function (val) {
                        return $.enum.getDescByValue("EnumPSMXZT", val);
                    }
                },
                { label: 'Số lượng đã kiểm nghiệm trước đạt', name: 'YYYTGS', width: 80, align: 'left' },
                { label: 'Số lượng đã kiểm nghiệm trước không đạt', name: 'YYYBGS', width: 80, align: 'left' },
                { label: 'Số lượng đã thử nghiệm đạt', name: 'YSYTGS', width: 80, align: 'left' },
                { label: 'Số lượng đã thử nghiệm không đạt', name: 'YSYBGS', width: 80, align: 'left' },

            ],
            multiselect: false,
            //pager: "#gridPager",
            //sortname: '',
            viewrecords: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                //btn_selectrow(rowid);
            }
        });
        $("#btn_search").click(function () {
            $('#gridList').jqGrid("clearGridData");
            $gridList.jqGrid('setGridParam', {
                postData: getPostData(),
            }).trigger('reloadGrid');
        });
    }

    //Tra cứu
    $('#btn_search').click(function () {
        if ($("#psdbh").val() == "" || $("#psdbh").val() == null) {
            $.modalAlert("Vui lòng nhập số phiếu giao hàng", 'warning');
            return ;
        }
        gridList();
    });
</script>



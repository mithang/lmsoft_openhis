
@{
    ViewBag.Title = "Đơn xin điều chỉnh giá";
    Layout = "~/Views/Shared/_Index.cshtml";
}

<form id="form1">
    <div class="panel panel-default">
        <div class="panel-heading">Điều kiện lọc</div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle">Từ khóa</th>
                    <td class="formValue">
                        <input type="text" id="wzmc" class="form-control" placeholder="Tên vật tư/Phiên âm" />
                    </td>
                    <td class="formValue" colspan="3">
                        <input type="button" id="btn_search" class="btn btn-primary btn-md" value="Tra cứu" style="width:55px" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div class="gridPanel">
        <div class="gridPanel">
            <table id="gridYPInfoList"></table>
            <div id="gridPager" rel="form1"></div>
        </div>
    </div>
    <div class="panel panel-default" style="margin-top:10px; margin-bottom:0;">
        <div class="panel-heading">Chi tiết điều chỉnh giá</div>
        <div style="padding: 2px;padding-right:20px;">
            <table class="form">
                <tr>
                    <th class="formTitle"><span class="required">*</span>Giá bán lẻ</th>
                    <td class="formValue">
                        <input type="text" id="txtLSJ" class="form-control" style="width:65%;float: left;" />
                        <span name="sp_bmdw" style="line-height:24px;margin-left: 10px;">(đồng/)</span>
                        <input type="hidden" id="dwmc" class="form-control" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Văn bản thực hiện</th>
                    <td class="formValue">
                        <input type="text" id="txtZXWJ" class="form-control" />
                    </td>
                    <th class="formTitle"><span class="required">*</span>Thời gian thực hiện</th>
                    <td class="formValue">
                        <input id="txtZXSJ" type="text" class="form-control input-wdatepicker" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" onfocus="WdatePicker({ minDate: '%y-%M-#{%d+1}' })" />
                    </td>
                    <th class="formTitle">Giá bán lẻ cũ</th>
                    <td class="formValue">
                        <input type="text" id="txtYLSJ" class="form-control newtouch_Readonly" style="width:65%;float: left;" />
                        <span name="sp_bmdw" style="line-height:24px;margin-left: 10px;">(đồng/)</span>
                        <input type="hidden" id="productId" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</form>

@Html.Partial("_BottomButtonsView", new Newtouch.Herp.Web.Models.BottomButtonViewModel
{
    ShowKeyList = new[] { 6 },
    F6Text = "Đơn xin"
})

<script>
    var $gridYpInfoList;
    $(function () {
        gridYPInfoList();
        $("#btn_search").click(function () {
            $gridYpInfoList.jqGrid('setGridParam',
                {
                    postData: getSearchPostData()
                }).trigger('reloadGrid');
        });
        $("#wzmc").bind("keyup", function () {
            if (event.keyCode === 13) {
                $("#btn_search").trigger("click");
            }
        });
    });

    function gridYPInfoList() {
        $gridYpInfoList = $("#gridYPInfoList");
        $gridYpInfoList.dataGrid({
            postData: getSearchPostData(),
            url: "/StorageManage/Storage/DepartmentStockListQueryByPage",
            height: $(window).height() - document.getElementById('gridYPInfoList').offsetTop - 195,
            colModel: [
                { label: 'Loại', name: 'lbmc', width: 150, align: 'left' },
                { label: 'Vật tư', name: 'name', width: 150, align: 'left' },
                { label: 'Quy cách', name: 'gg', width: 120, align: 'left' },
                {
                    label: 'Giá bán lẻ', name: 'bmlsj', width: 100, align: 'right',
                    formatter: function (val) {
                        return val.toFixed(4);
                    }
                },
                { label: 'Đơn vị bán lẻ', name: 'bmdwmc', width: 80, align: 'center' },
                { label: 'Hệ số chuyển đổi', name: 'zhyz', width: 80, align: 'left' },
                { label: 'Đơn vị nhỏ nhất', name: 'mindwmc', width: 80, align: 'left' },
                { label: 'Nhà sản xuất', name: 'supplierName', width: 150, align: 'left' },
                { label: "Id", name: "Id", hidden: true }
            ],
            multiselect: false,
            pager: "#gridPager",
            sortname: 'name desc',
            viewrecords: true,
            onSelectRow_page: function (rowid) {
                if (rowid) {
                    $("#txtLSJ").val("");
                    var getRowData = $("#gridYPInfoList").jqGrid('getRowData', rowid);
                    if (getRowData) {
                        $("#txtYLSJ").val(getRowData.bmlsj);
                        $("#productId").val(getRowData.Id);
                        $("span[name=sp_bmdw]").html("(đồng/" + getRowData.bmdwmc + ")").attr("data-zhyz", getRowData.zhyz);
                        $("#dwmc").val(getRowData.bmdwmc);
                    }
                }
            }
        });
    }

    //Điều kiện tra cứu
    function getSearchPostData() {
        return { key: $("#wzmc").val() };
    };

    //Gửi đơn
    function newtouch_event_f6() {
        if (!CheckData()) {//Kiểm tra dữ liệu
            return false;
        }
        var yzhyz = isNaN($("[name=sp_bmdw]").attr("data-zhyz")) ? 1 : parseFloat($("[name=sp_bmdw]").attr("data-zhyz"));
        $.najax({
            url: "/ProductManage/PriceAdjustment/SubmitPriceAdjustmentRequest",
            dataType: "json",
            data: {
                productId: $("#productId").val(),
                lsj: parseFloat($("#txtLSJ").val()),
                zhyz: yzhyz,
                ylsj: parseFloat($("#txtYLSJ").val()),
                tzwj: $("#txtZXWJ").val(),
                zxsj: $("#txtZXSJ").val(),
                dwmc: $("#dwmc").val()
            },
            type: "POST",
            async: "false",
            success: function (data) {
                if (data.state === "success") {
                    $.modalAlert("Gửi đơn thành công", 'success');
                    $("#txtLSJ").val("");
                    $("#txtZXWJ").val("");
                    $("#txtZXSJ").val("");
                    $("#txtYLSJ").val("");
                    $("#dwmc").val("");
                    $("span[name=sp_bmdw]").html("(đồng/)").attr("data-zhyz", "");
                } else {
                    $.modalAlert(data.message, 'error');
                }
            }
        });
    }


    //Kiểm tra dữ liệu
    function CheckData() {
        if ($("#txtYLSJ").val() === "") {
            $.modalAlert("Vui lòng chọn vật tư！", 'warning');
            return false;
        }
        if ($("#txtLSJ").val() === "") {
            $.modalAlert("Giá bán lẻ không được để trống！", 'warning');
            return false;
        }
        if (isNaN($("#txtLSJ").val())) {
            $.modalAlert("Định dạng giá bán lẻ sai,Vui lòng nhập số！", 'warning');
            return false;
        }
        if ($("#txtZXWJ").val() === "") {
            $.modalAlert("Văn bản thực hiện không được để trống！", 'warning');
            return false;
        }
        if ($("#txtZXSJ").val() === "") {
            $.modalAlert("Thời gian thực hiện không được để trống！", 'warning');
            return false;
        }
        if ($("#txtLSJ").val() === $("#txtYLSJ").val()) {
            $.modalAlert("Giá bán buôn không được giống giá gốc！", "warning");
            return false;
        }
        return true;
    }
</script>

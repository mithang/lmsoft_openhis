@Html.Partial("_BottomButtonsView", new Newtouch.Sett.Web.Models.BottomButtonViewModel()
{
    ShowKeyList = new int[] { 4, 6 },
    F6Text = "Hoàn phí"
})

<script>
    var openYbSett = '@openYbSett' === 'True'; //cấu hình công tắc：bệnh nhân BHYT có dùng quy trình giao dịch BHYT không
    var openXnhSett = '@openXnhSett' === 'True'; //cấu hình công tắc：có dùng quy trình giao dịch hợp tác nông thôn mới không
    var medicalInsurance = '@medicalInsurance';
    var orgId = '@(opr.OrganizeId)';
    var cardInfo;
    var currejlsx;
    var sfqt = true; //có hoàn toàn bộ không
    var tjscfh = [];
    var tjsypcfh = [];
    $(function() {
        gridList();

    });

    //ngủ
    function sleep(numberMillis) {
        var now = new Date();
        var exitTime = now.getTime() + numberMillis;
        while (true) {
            now = new Date();
            if (now.getTime() > exitTime)
                return;
        }
    }
    //nhập taythẻ BHXHsố
    //function GetPatSbkh() {
    //    $.modalOpen({
    //        id: "sbkhInput",
    //        title: "số thẻnhập",
    //        url: "/OutpatientManage/OutpatientReg/OutPatientSbkhInput?t=" + Math.random(),
    //        width: "300px",
    //        height: "150px",
    //        callBack: function (iframeId) {
    //            top.frames[iframeId].PatSbkhData();
    //        }
    //    });
    //}

    //tra cứu bệnh nhân
    function GetPatSerarchView(mzh) {
        var blh = $('#query_blh').val();
        var mzh = $('#query_mzh').val();
        if (!!!blh) {
            blh = '';
        };
        if (!!!mzh) {
            mzh = '';
        };
        $.modalOpen({
            id: "patSearch",
            title: "Tra cứu bệnh nhân",
            url: "/OutpatientManage/OutpatientRefund/SysPatEntitiesReView?t=" + Math.random() + "&blh=" + blh + "&mzh=" + mzh,
            width: "700px",
            height: "600px",
            callBack: function (iframeId) {
                top.frames[iframeId].PatDbGrid();
            }//hàm gọi lại khi nhấn xác nhận trên cửa sổ
        });
    }

    //quyết toánbảng chínhList
    var jszbList = [];
    var thisJszb = null;

    //
    var patModel = null;

    //chọncủabệnh nhân callback
    function GetQueryFphAjax(obj) {
        patModel = null;
        $.loading(true, "Đang yêu cầu thông tin bệnh nhân，Vui lòng chờ...");
        $.ajax({
            type: "POST",
            url: "/OutpatientManage/OutpatCharge/GetpatientAccountInfo",
            data: obj,
            dataType: "json",
            cache: false,
            async: true,
            success: function (ajaxresp) {
                if (ajaxresp.state === 'success' && ajaxresp.data && ajaxresp.data.OutpatAccInfoDto) {
                    if (ajaxresp.data.OutpatAccListDto != null && ajaxresp.data.OutpatAccListDto.length > 1) {
                        sessionStorage.setItem('OutpatAccListDto', JSON.stringify(ajaxresp.data.OutpatAccListDto));
                        $.modalOpen({
                            id: "patSearch",
                            title: "Tra cứu bản ghi khám",
                            url: "/OutpatientManage/OutpatCharge/OutpatAccListView?kh=" + obj.kh +"&zjh="+obj.zjh+ "&cardType=" + obj.cardType,
                            width: "750px",
                            height: "500px",
                            callBack: function (iframeId) {
                                //hàm gọi lại khi nhấn xác nhận trên cửa sổ
                                top.frames[iframeId].PatDbGrid();
                            }
                        });
                    } else {
                        chooseOneMzjl(ajaxresp.data.OutpatAccInfoDto);
                    }
                }
                else if (ajaxresp.state === 'error') {
                    $.modalAlert("Không lấy được bản ghi khám có thể hoàn", 'warning');
                }
            },
            complete: function () {
                $.loading(false);
            }
        });
    }

    //chọn mộtngoại trúbản ghi khám
    function chooseOneMzjl(outpatAccInfoDto) {
        if (outpatAccInfoDto && !!!outpatAccInfoDto.brxz) {
            $.modalAlert("Thông tin bệnh nhân bất thường，Thiếu tính chất chi phí", 'warning');
            return false;
        }
        if (outpatAccInfoDto && !!!outpatAccInfoDto.CardTypeName) {
            $.modalAlert("Loại thẻ bệnh nhân bất thường", 'warning');
            return false;
        }
        //gán thông tin cơ bản cá nhân
        patModel = outpatAccInfoDto;
        setPatInfoModel(outpatAccInfoDto);
        $('#btn_search').trigger('click');
    }

    //khởi tạo thông tin bệnh nhân
    function setPatInfoModel(patModel) {
        //
        $('#query_blh').val(patModel.blh);
        $('#query_mzh').val(patModel.mzh);
        //
        $('#blh').html(patModel.blh);
        $('#xm').html(patModel.xm);
        $('#xb').html($.getGender(patModel.xb));
        $("#nlshow").html(getAgeFromBirthTime({ begin: patModel.csny }).text);
        $('#mzh').html(patModel.mzh);
        $('#brxzmc').html(patModel.brxzmc);
    }

    //kế hoạch trị liệu chưa thực hiện có thể hoàn toàn bộ
    var zljhwzxkqt;
    //chi tiết tính phí

    var checkTrigger = false;
    var list = new Array();
    var liststu = false;
    var j = 0;

    function gridList() {
        var $gridList = $("#gridList");
        $gridList.dataGrid({
            height: $(window).height() - 290,
            unwritten: false,
            postData: {},
            editurl: "clientArray",
            url: "/OutpatientManage/OutpatientRefund/RefundableDetailQuery",
            colModel: [
                { label: "jsmxnm", name: "jsmxnm", key: true, hidden: true },
                {
                    label: "Loại", name: "feeType", width: 40, align: "left",
                    formatter: function (val) {
                        if (val) {
                            if (val === 1) {
                                return "Thuốc";
                            }
                            else if (val === 2) {
                                return "Khoản mục";
                            }
                        } else {
                            return '';
                        }
                    }
                },
                { label: "Số đơn thuốc", name: "cfh", width: 150, align: "left" },
                { label: "Tên loại đơn thuốc", name: "cflxmc", width: 150, align: "left", hidden: true  },
                { label: "Trạng thái đơn đề nghị", name: "sqdzt", width: 150, align: "left", hidden: true  },
                { label: "Loại chi phí", name: "dlmc", width: 70, align: "left" },
                { label: "Tên", name: "mc", width: 180, align: "left" },
                { label: "Nhóm thuốc", name: "czh", width: 60, align: "left" },
                {
                    label: "Đơn giá", name: "dj", width: 60, align: "left",
                    formatter: function (val) {
                        if (val || val === 0) {
                            return val.toFixed(4);
                        } else {
                            return '';
                        }
                    }
                },
                { label: "ztId", name: "ztId", width: 50, align: "left", hidden: true },
                { label: "cfnm", name: "cfnm", width: 50, align: "left" , hidden: true },
                { label: "Số lượng", name: "sl", width: 50, align: "left" },
                { label: "Số lượng có thể hoàn", name: "ktsl", width: 50, align: "left" },
                { label: "Số lượng hoàn", name: "tsl", width: 80, editable: '@(Outpatient_PreRefund_Partreturn)' == 'False' ? false:true, editrules: { integer: true, minValue: 1 }, align: "left"},
                { label: "Đơn vị", name: "dw", width: 50, align: "left" },
                {
                    label: "Số tiền", name: "jsmxje", width: 80, align: "left",
                    formatter: function (val) {
                        if (val || val === 0) {
                            return val.toFixed(2);
                        } else {
                            return '';
                        }
                    }
                },
                { label: "Loại quyết toán", name: "jslx", width: 40, align: "left", hidden: true }
            ],
            multiselect: true,
            viewrecords: true,
            onSelectRow: function (rowId,s) {
                if ('@(Outpatient_PreRefund_Partreturn)' === 'False') {
                    debugger
                    if (!checkTrigger) {
                        var len = 0;
                        var rowData = $("#gridList").jqGrid('getRowData', rowId);
                        var ids = $("#gridList").jqGrid('getRowData_AllLine');

                        liststu = s; //trạng thái đồng bộ
                        for (var i = 0; i < ids.length; i++) {
                            if (ids[i].cfh === rowData.cfh && ids[i].cfh !== "") {
                                if (s === true) {
                                    if (rowId !== ids[i].jsmxnm) {
                                        list[len] = ids[i].jsmxnm;
                                        len += 1;
                                    }
                                }
                                else {
                                    if (rowId !== ids[i].jsmxnm) {
                                        list[len] = ids[i].jsmxnm;
                                        len += 1;
                                    }
                                }
                            }
                            if(ids[i].jslx==rowData.jslx && ids[i].jslx=="0")
                            {
                                if (s === true) {
                                    if (rowId !== ids[i].jsmxnm) {
                                        list[len] = ids[i].jsmxnm;
                                        len += 1;
                                    }
                                }
                                else {
                                    if (rowId !== ids[i].jsmxnm) {
                                        list[len] = ids[i].jsmxnm;
                                        len += 1;
                                    }
                                }
                            }
                        }
                        checkTrigger = true;
                    }

                    if (list.length > 0) {
                        for (j = j; j < list.length; j++) {
                            if (liststu) //chọn cùng nhóm
                            {
                                j = j + 1;
                                $("#gridList").jqGrid("setSelection", list[j - 1], true);

                            }
                            else { //hủy chọn cùng nhóm
                                //j = j + 1;
                                $("#gridList").jqGrid("setSelection", list[j], false);      //hủy không kích hoạtonselectrow
                            }
                        }
                    }

                    j = 0;
                    checkTrigger = false;
                    list = new Array();
                    liststu = false;
                } else {
                    EnableInlineEditBox(rowId); //bật sửa trước
                    $("#" + $.jgrid.jqID(rowId) + "_tsl").focus();
                }
            },
            gridComplete: function (gridData) {
                zljhwzxkqt = false;
                $('#tblShowJhKqtTip').hide();
                if (gridData && gridData.length > 0) {
                    zljhwzxkqt = true;
                    $.each(gridData, function () {
                        if (this.feeType == "1") {
                            //1thuốc
                            zljhwzxkqt = false;
                        }
                        else if (!(this.zljhwzx === true)) {
                            zljhwzxkqt = false;
                        }
                    });
                }
                if (zljhwzxkqt == true) {
                    $('#tblShowJhKqtTip').show();
                }
                var ids = $gridList.getDataIDs();
                for (i = 0; i < ids.length; i++) {
                    var rowData = $gridList.getRowData(ids[i]);
                    if (rowData && rowData.feeType) {
                        //tô màu
                        if (rowData.feeType == "Thuốc") {
                            $gridList.find('tr[id="' + ids[i] + '"]').addClass('warning');
                        }
                        if (rowData.feeType == "Khoản mục") {
                            $gridList.find('tr[id="' + ids[i] + '"]').addClass('info');
                        }
                    }
                }
                //bật khung sửa trong dòng
                EnableInlineEditBox();
            },
            loadComplete: function (data) {
                if (!(data && data.length)) {
                    $.modalAlert('Tạm thời không có chi tiết có thể hoàn', 'warning');
                    return;
                }
            }
        });

        $("#btn_search").click(function () {
            newtouch_event_f4();

            var mzh = $('#mzh').html();
            if (!mzh) {
                mzh = $('#query_mzh').val();
            }
            var kssj = $('#kssj').val();
            var jssj = $('#jssj').val();
            if (!!!mzh) {
                $.modalAlert("Vui lòng chọn bệnh nhân", 'warning');
                return;
            }
            if (kssj && jssj && (kssj > jssj)) {
                $.modalAlert("Ngày bắt đầu không được lớn hơn ngày kết thúc", 'warning');
                return;
            }
            debugger;
            //var strurl = "/OutpatientManage/OutpatientRefund/RefundableJsQuery";    //dùng chung
		    strurl = "/OutpatientManage/OutpatientRefund/RefundableChongQingQuery";
            //tra cứujsnm
            $.najax({
                type: "GET",
                url: strurl,
                data: { mzh: mzh, kssj: kssj, jssj: jssj },
                success: function (data) {
                    if (data && data.length) {
                        jszbList = data;
                        if (data.length > 1) {
                            //bật chọnquyết toán
                            sessionStorage.setItem("jsdata", JSON.stringify(data));
                            $.modalOpen({
                                id: "FormQueJsList2018",
                                title: "Chọn quyết toán",
                                url: "/OutpatientManage/OutpatientRefund/QueJsList2018",
                                width: "700px",
                                height: "350px",
                                callBack: function (iframeId) {
                                    $.currentWindow(iframeId).AcceptClick(function (jsnm) {
                                        reloadGrid(jsnm);
                                    });
                                }
                            });
                        }
                        else {
                            reloadGrid(data[0].jsnm);
                        }
                    }
                    else {
                        $.modalAlert("Không có quyết toán liên quan", 'warning');
                        return;
                    }
                }
            });
        })
    }

    function reloadGrid(jsnm) {
        debugger;
        if (thisJszb === null && !!jsnm) {
            var matchedJszbList = $.jsonWhere(jszbList, function (v) {
                return v.jsnm == jsnm;
            });
            if (matchedJszbList.length == 1) {
                thisJszb = matchedJszbList[0];
            }
        }
        if (thisJszb) {
            if (!(thisJszb.jszje && thisJszb.jszje > 0)) {
                $.modalMsg("ĐãKhông cócó thểSố tiền hoàn", "warning");
                return;
            }
            //ngàykỳ thông tin số tiền
            $('#settTime').html($.getTime({ date: thisJszb.CreateTime, second: false }));
            $('#zje').html(thisJszb.jszje ? ovpraseFloat(thisJszb.jszje).toFixed(2) : '0.00');
            $('#xjzf').html(thisJszb.jsxjzf ? ovpraseFloat(thisJszb.jsxjzf).toFixed(2) : '0.00');
            $('#sfrq').html($.getDate({ date: thisJszb.sfrq }));
            $('#fph').html(thisJszb.fph);
            $('#xjzffsmc').html(thisJszb.xjzffsmc);
            //grid
            $("#gridList").jqGrid('setGridParam', {
                postData: { jsnm: thisJszb.jsnm }
            }).trigger('reloadGrid');
        }
    }

    //bật khung sửa trong dòng
    function EnableInlineEditBox(rowId) {
        if (rowId) {
            $("#gridList").jqGrid('editRow', rowId, true, null, null, null, null, function (callbackRowId) {
                ;
            });
        }
        else {
            var rowIds = $("#gridList").jqGrid('getDataIDs');
            for (var i = 0; i < rowIds.length; i++) {
                EnableInlineEditBox(rowIds[i]);
            }
        }
    }

    //tạogridđiều kiện tra cứu
    function getSearchPostData() {
        return {};
    };

    //f4
    function newtouch_event_f4() {
        $('#gridList').jqGrid("clearGridData");
        jszbList = [];
        tjscfh = [];
        tjsypcfh = [];
        thisJszb = null;
        //quyết toánthông tin
        $('#settTime').html('');
        $('#zje').html('');
        $('#xjzf').html('');
        $('#fph').html('');
        $('#sfrq').html('');
        $('#xjzffsmc').html('');
    }

    //xác nhận hoàn phí
    function newtouch_event_f6() {
        currejlsx=$("#gridList").jqGrid('getRowData_AllLine')[0].jslx;

        //lấydòng đã chọnId
        var selRowIds = $("#gridList").jqGrid('getGridParam', 'selarrrow');
        if (selRowIds.length === 0) {
            if (zljhwzxkqt === true) {
                $.modalConfirm("Kế hoạch chưa thực hiện，Xác nhận hoàn toàn bộ và hủy kế hoạch", function (flag) {
                    if (flag) {
                        setTimeout('jhqttf();', 50);
                    }
                });
                return;
            }
            else {
                $.modalAlert("Vui lòng chọn trước thông tin cần hoàn phí", 'warning');
